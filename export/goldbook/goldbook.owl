    <!-- http://dx.doi.org/10.1351/goldbook.11259 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11259">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at \(\ce{C-10}\) and \(\ce{C-13}\), and often an alkyl group at \(\ce{C-17}\). By extension, one or more bond scissions, ring expansions, and/or ring contractions of the skeleton may have occurred.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Natural steroids are derived in biogenesis from triterpenoids; they play important roles as hormones (sex hormones), membrane components (cholesterol) and emulsifying agents (bile acids).</rdfs:comment>
        <rdfs:label>steroid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11260 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11260">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member (EC 1.14.14.16) of the cytochrome P450 family of enzymes required for the synthesis of some steroid hormones including aldosterone and cortisol.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>21-hydroxylase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>steroid 21-monooxygenase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11261 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11261">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which the effect of a test substance on steroid synthesis is studied, usually in a human adrenocortical carcinoma cell line.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This assay is part of the OECD framework for the &quot;Testing and Assessment of Endocrine Disrupting Chemicals&quot;.</rdfs:comment>
        <rdfs:label>steroidogenesis assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11262 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11262">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Birth of a baby without any signs of life, at a time variously taken as \(\pu{20\!{-}\! 28 weeks}\) of pregnancy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The baby may have died during pregnancy (called intrauterine death), labor, or birth.</rdfs:comment>
        <rdfs:label>stillbirth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11263 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11263">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Signaling events induced when normal cell function or development is disrupted by environmental (physical or chemical) factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Induction of stress pathways may lead to cellular repair and counteraction of stress effects, or to adverse effects.</rdfs:comment>
        <rdfs:label>stress-response pathway</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11264 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11264">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell producing the connective tissue framework of an organ or other anatomical structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>stromal cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10556"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11071"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11265 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11265">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the diencephalon, of which the major part is the subthalamic nucleus, and which connects to the globus pallidus, part of the telencephalon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>prethalamus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral thalamus</oboInOwl:hasRelatedSynonym>
        <rdfs:label>subthalamus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10606"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11283"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11266 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11266">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any long, narrow groove, furrow or shallow depression, specifically referring to one of the fissures on the surface of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>sulcus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11267 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11267">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fertilization of two or more ova released in the same period of ovulation, either by different males or by the same male in separate acts of intercourse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>If there are two or more different fathers, the state may be called heteropaternal superfecundation. Rare in humans, heteropaternal superfecundation is common in some species, such as cats and dogs.</rdfs:comment>
        <rdfs:label>superfecundation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11268 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11268">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of two fetuses in the uterus at different stages of development, resulting from fertilization of ova released in two successive periods of ovulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>superfetation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11059"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11269 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11269">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exceeding the usual number; thus, in anatomy, anomalies such as a sixth finger on one hand or a third nipple (in a human).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>supernumerary</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11270 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11270">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface-active layer of phospholipids and proteins coating the pulmonary alveoli that increases lung compliance, facilitates lung expansion, and stabilizes alveolar volume.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Lack of pulmonary surfactant is more common following premature birth and is a cause of infant respiratory distress syndrome.</rdfs:comment>
        <rdfs:label>pulmonary surfactant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10359"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11118"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11277"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11271 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11271">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Point-wise pairing of homologous chromosomes during the prophase of meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>syndesis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>synapsis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11143"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11272 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11272">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure of filamentous proteins that forms between homologous chromosomes when they pair during meiosis; it may contribute to synapsis and genetic recombination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>synaptonemal complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11273 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11273">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conjoined twins with two bodies and a fused head.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>monocephalus</oboInOwl:hasRelatedSynonym>
        <rdfs:label>syncephalus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11274 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11274">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer syncytial layer of trophoblast cells that invades the endometrium during implantation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The syncytiotrophoblast is the site of synthesis of human chorionic gonadotropin and is involved in implantation.</rdfs:comment>
        <rdfs:label>syncytiotrophoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10517"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11275"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11275 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11275">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to a large multinucleated mass of cellular contents that arises from the fusion of originally individual cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>syncytium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11276 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11276">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital occurrence of fusion or webbing of the fingers or toes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>syndactyly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11277 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11277">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of signs and symptoms occurring together, having a common cause and defining a disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11278 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11278">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital fusion of the orbits in the midline, which then contains one eyeball.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>cyclopia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>monophthalmos</oboInOwl:hasRelatedSynonym>
        <rdfs:label>synophthalmia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11046"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11279 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11279">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital malformation characterized by the union or approximation of the ears in front of the neck, often accompanied by the absence or defective development of the lower jaw.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>synotia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10352"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10910"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11054"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11280 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11280">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In the vertebrate embryo, mass of proliferating cells at the caudal end that arises from the primitive node.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tail bud</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11129"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11281 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11281">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autosomal recessive inheritance of hexosaminidase A deficiency leading to a lysosomal storage disease characterized by central and peripheral neuronal involvement and early death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>infantile GM2 gangliosidosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Tay–Sachs disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10326"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10448"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10907"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11012"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11282 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11282">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Floor of the midbrain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In the embryo this term refers more generally to the anterior portion of the neural tube.</rdfs:comment>
        <rdfs:comment>The tegmentum is the site of the nuclei of several cranial nerves.</rdfs:comment>
        <rdfs:label>tegmentum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11283 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11283">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic structure that develops into the cerebrum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>telencephalon</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11284 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11284">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Final phase of both meiosis and mitosis in which distinct nuclei form in each daughter cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>telophase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11285 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11285">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malignant teratoma, occurring most often in the testis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>teratocarcinoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10915"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11286 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11286">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical, physical, or biological agent that, when administered to a parent either prior to conception or before birth of the child, induces permanent structural malformations or birth defects in the offspring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Teratogens may act at vulnerable points in the development of gametes in parents or of organ development in the embryo and fetus.</rdfs:comment>
        <rdfs:comment>Their modes of action include mimicry of morphogens (thus interference with morphogenesis), modulation of genes and gene expression, and direct alterations in protein function.</rdfs:comment>
        <rdfs:label>teratogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10972"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11287 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11287">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of development of malformations or birth defects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>teratogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11288 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11288">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of how genes and teratogens interact to cause birth defects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>teratogenetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11289 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11289">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mortality of eggs expressed as a lethal concentration divided by the threshold concentration for production of abnormal embryos with nonheritable permanent structural malformations or defects following exposure to a teratogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>TI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The TI is thought to reflect the developmental hazard of a contaminant.</rdfs:comment>
        <rdfs:label>teratogenic index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11289"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11290 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11290">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inherent ability to act as a teratogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>teratogenicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11291 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11291">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the causes, mechanisms, and manifestations of developmental deviation of either structure or function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>teratology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11292 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11292">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Benign germ cell-derived tumor containing embryonic elements of the three primary germ layers, such as skin, hair, and muscle, occurring most frequently in the ovary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>dermoid cyst</oboInOwl:hasRelatedSynonym>
        <rdfs:label>teratoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10762"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10763"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11285"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11330"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11293 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11293">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Classification of bony and soft tissue facial clefts based on their anatomic location.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>They are numbered from \(\pu{0\!{-}\! 14}\), with \(\pu{0}\) and \(\pu{14}\) being in the midline.</rdfs:comment>
        <rdfs:label>Tessier classification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10704"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11294 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11294">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of male pseudohermaphroditism in which the individual has a male karyotype and testes present within the abdominal cavity, but develops external female genitalia and female secondary sexual characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Clinical presentation is usually as a phenotypic female with primary amenorrhea.</rdfs:comment>
        <rdfs:comment>Testicular feminization is due to an androgen receptormutation, causing the target tissues to be insensitive to the masculinizing effects of androgens.</rdfs:comment>
        <rdfs:label>testicular feminization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10365"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10755"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10872"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11149"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11295 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11295">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gonad of a male animal, involved in the secretion of androgens and the site of sperm production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>testicle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>testis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11296 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11296">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Androgenic steroid hormone produced primarily in the testis, responsible for the development of the male sexual organs and male secondary sexual characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The ovary also secretes testosterone, but circulating levels in the female are much lower than in the male.</rdfs:comment>
        <rdfs:label>testosterone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11259"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11297 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11297">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of four congenital cardiac defects involving an opening in the wall that should separate the right and left ventricles (ventricular septal defect), allowing the aorta to receive venous as well as arterial blood: including stenosis of the pulmonary artery, hypertrophy of the right ventricle, and displacement of the aorta. Right ventricular hypertrophy is the fourth part of the tetralogy, although it may also be a consequence of the other defects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The constellation of anatomical defects is understandable in terms of a flaw in the ordered sequence of events in the normal development of the heart and associated vessels.</rdfs:comment>
        <rdfs:comment>These anatomical defects are the most common cardiac cause of cyanosis in infants.</rdfs:comment>
        <rdfs:label>tetralogy of Fallot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10489"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10579"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11157"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11256"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11365"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11298 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11298">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Either of two masses of grey matter, the largest part of the diencephalon, lying between the cerebral hemispheres on either side of the third ventricle, relaying sensory information and acting as a centre for pain perception.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>thalamus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10504"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10606"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11299 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11299">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Teratogenic indole-based drug with sedative and anti-angiogenic properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Currently, it is used successfully to treat and prevent the moderate to severe skin lesions caused by leprosy, and is used together with dexamethasone to treat multiple myeloma.</rdfs:comment>
        <rdfs:comment>The introduction of thalidomide for alleviating nausea in pregnancy in some countries in 1957 was soon linked to severe birth defects in the infant, with phocomelia being highly characteristic.</rdfs:comment>
        <rdfs:label>thalidomide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11089"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11300 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11300">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bilayer covering of the ovarian follicle (thus theca interna and externa), of which the theca interna is involved in production of androstenedione.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>theca</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10387"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11056"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11301 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11301">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Largest of the lymphatic vessels; it conducts lymph from its origin in the abdomen to the venous circulation at the junction of the left subclavian and jugular veins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>thoracic duct</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10904"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11302 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11302">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low concentration of platelets (thrombocytes) in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Thromocytopenia is an unwanted effect of some drugs and carries an increased risk of spontaneous bleeding.</rdfs:comment>
        <rdfs:label>thrombocytopenia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11303 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11303">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pyramid-shaped organ in the thoracic or cervical region of mammals, composed of lymphatic tissue in which minute concentric bodies (thymic corpuscles, the remnants of epithelial structures) are found.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>If a newborn’s thymus is removed, not enough T cells are produced, the spleen and lymph nodes have little tissue, and the immune system fails, causing a gradual, fatal wasting disease. Thymus removal in adults has little effect.</rdfs:comment>
        <rdfs:comment>Stem cells in the outer cortex of thymus develop into different kinds of T cells. Some migrate to the inner medulla and enter the bloodstream; those that do not may be destroyed to prevent autoimmune reactions.</rdfs:comment>
        <rdfs:comment>This organ is necessary for the development of thymus-derived lymphocytes (T cells) and is the source of several hormones involved in T-cell maturation, for example, thymosin, thymopoietin, thymulin, and thymocyte humoral factor.</rdfs:comment>
        <rdfs:label>thymus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10904"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11304 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11304">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Connection in the embryo between the site of initiation of development of the thyroid gland and its final location in the neck.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>thyroglossal duct</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11305"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11305 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11305">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bilobar endocrine gland, located below the prominence of cartilage surrounding the larynx (the Adam’s apple), that produces and secretes the hormones triiodothyronine (T3), thyroxin (T4), and calcitonin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>thyroid gland</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10657"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10884"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11306 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11306">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ectopic thyroid tissue arising from remnants of the thyroglossal duct.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>accessory thyroid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10633"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11304"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11307 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11307">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pituitary hormone that stimulates the thyroid gland to produce thyroxine (T4), and then triiodothyronine (T3).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>TSH</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thyroid stimulating hormone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11305"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11307"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TSH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11308 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11308">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small, rounded mass of tissue, especially of lymphoid tissue; generally used to designate one of the paired palatine tonsils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tonsil</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11062"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11309 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11309">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Infection with the parasite Toxoplasma gondii that, when acquired by the fetus, can lead to a variety of congenital abnormalities that may include hydrocephalus or microcephaly, mental retardation, and problems with vision and hearing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Infection of the fetus is from the mother who may acquire it from contact with feces of the domestic cat or from undercooked meat.</rdfs:comment>
        <rdfs:label>toxoplasmosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10815"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11310 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11310">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thin-walled, cartilaginous tube descending from the larynx to the bronchi and carrying air to the lungs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>trachea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10884"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11311 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11311">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>DNA-binding protein that is involved in regulating gene expression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>transcription factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11312 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11312">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing an organism that is genetically changed by the addition or deletion of genetic material or whose existing genes are altered by gene targeting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>transgenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10753"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11313 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11313">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rearrangement involving transfer or exchange of genetic material between non-homologous chromosomes that may occur during gametogenesis or in somatic cells, potentially leading to birth defects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>chromosomal translocation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11166"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11188"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11226"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11314 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11314">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that crosses the placenta and subsequently causes cancer in the child or young adult.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>transplacental carcinogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10485"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11315 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11315">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital cardiovascular malformation in which the position of the chief blood vessels of the heart (aorta and pulmonary artery) is reversed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>transposition of the great vessels</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Survival then depends on a crossflow of blood between the right and left sides of the heart, as through a ventricular septal defect.</rdfs:comment>
        <rdfs:label>transposition of the great arteries</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11157"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11365"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11316 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11316">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital deformity characterized by structural abnormalities of the head and face.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Treacher Collins–Franceschetti syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mandibulofacial dysostosis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autosomal dominant mutations have been identified in several genes involved in early development of bone and the tissues of the face, the most frequently implicated being TCOF1.</rdfs:comment>
        <rdfs:label>Treacher Collins syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10449"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10565"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11317 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11317">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disc-like embryonic stage in which differentiation into three layers (endoderm, mesoderm, and ectoderm) has occurred.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>trilaminary blastoderm</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the human embryo this occurs in the third week, following the onset of gastrulation.</rdfs:comment>
        <rdfs:label>trilaminar embryo</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11318 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11318">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In pregnancy, one of three equal timed divisions of the normal human gestation period, each lasting approximately three months.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>trimester</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10765"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11319 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11319">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement of maternal serum levels of alpha-fetoprotein, human chorionic gonadotropin, and estriol, usually in the second trimester of pregnancy, that can serve as an indicator of risk for certain fetal chromosomal abnormalities and neural tube defects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>triple test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>triple screen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10358"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10517"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10524"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10679"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11318"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11320 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11320">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of three haploid sets of chromosomes in the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The condition is fatal in fetal or early neonatal life.</rdfs:comment>
        <rdfs:label>triploidy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10608"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10687"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10786"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10997"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11321 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11321">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of having three homologous chromosomes in each somatic cell instead of the normal pair.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>trisomy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10807"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11226"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11322 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11322">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of an extra chromosome 8.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Warkany syndrome 2</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Complete trisomy 8 is lethal, but most affected individuals show mosaicism with craniofacial abnormalities, a short wide neck, multiple joint defects, and deep creases in the palms and soles.</rdfs:comment>
        <rdfs:label>trisomy 8</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10565"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11321"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11323 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11323">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of part or all of an extra chromosome 13 from nondisjunction during meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Patau syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trisomy D</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Patau syndrome can also occur with an extra partial chromosome 13 resulting from a Robertsonian translocation.</rdfs:comment>
        <rdfs:comment>This leads to multiple congenital abnormalities and mental retardation, and is usually fatal in early childhood.</rdfs:comment>
        <rdfs:label>trisomy 13</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11188"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11324 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11324">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of part or all of an extra chromosome 18 from nondisjunction during meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Edwards syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This leads to multiple congenital abnormalities and mental retardation, and is usually fatal in early childhood.</rdfs:comment>
        <rdfs:label>trisomy 18</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11325 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11325">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of an extra chromosome 21.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Down syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The formerly used terms mongoloid and mongolism are now considered offensive.</rdfs:comment>
        <rdfs:comment>This produces a characteristic constellation of physical abnormalities with delayed growth and mental development, but is compatible with life into adulthood.</rdfs:comment>
        <rdfs:label>trisomy 21</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10348"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11326 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11326">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer layer of the blastocyst that contacts the endometrium, establishes nutrition for the embryo, and differentiates into the trophoblast.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>trophectoderm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11327"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11327 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11327">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer layer of the blastocyst that invades the endometrium and establishes nutrition for the embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Trophoblast cells do not form part of the embryo, but contribute to the development of the placenta.</rdfs:comment>
        <rdfs:label>trophoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11328 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11328">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Arterial trunk, opening from the fetal heart and developing into the aorta and pulmonary artery.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>truncus arteriosus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11329 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11329">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of dopaminergic neurons in the hypothalamus involved in regulating prolactin secretion from the anterior pituitary gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tuberoinfundibular pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11139"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11330 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11330">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any abnormal swelling or growth of tissue, whether benign or malignant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>tumour</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tumor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10915"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10998"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11331 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11331">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dense, collagenous fibrous coat surrounding an anatomical structure, and in particular surrounding the ovaries, testicles, and corpora cavernosa of the penis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tunica albuginea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10544"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11332 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11332">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membranous sheath, derived from the peritoneum, surrounding the testis and epididymis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tunica vaginalis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10668"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11333 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11333">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenotypic female lacking one X chromosome, the genotype being designated XO.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>Ullrich–Turner syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This results in a number of developmental abnormalities including short stature, webbed neck, sexual immaturity, and sterility.</rdfs:comment>
        <rdfs:label>turner syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11378"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11385"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11334 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11334">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in rodents wherein parents (P0 generation) and their offspring (F1 generation) are both exposed to a test substance and the second generation (F2) is examined for possible toxic effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>two-generation reprotox study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10703"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11039"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11335 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11335">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In anatomy, relating to the resonant cavity and membrane of the inner ear.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>tympanic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11336 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11336">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Imaging technique that creates a picture of internal body structures from differentially reflected ultrasound waves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>By using this technique, the human embryo can be observed in utero as early as \(\pu{5 1\!{/}\! 2 weeks}\) of gestation: fetal monitoring by this technique (obstetric ultrasound) is standard.</rdfs:comment>
        <rdfs:label>ultrasonography</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10764"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11337"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11337 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11337">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sound waves of frequency higher than the range audible to the human ear. Imaging technique that uses such sound waves to create a picture of internal body structures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ultrasound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11336"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11338 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11338">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paired artery that, in the fetus, returns deoxygenated blood from each half of the fetal body to the placenta, via the umbilical cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>In the adult, part of the umbilical artery remains open as a branch of the internal iliac artery, and part ceases to be an artery and becomes the medial umbilical ligament.</rdfs:comment>
        <rdfs:label>umbilical artery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10839"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11339"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11339 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11339">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cord-like structure connecting the fetus with the placenta and housing the umbilical artery and umbilical vein that carry nutrients from the mother and remove wastes from the fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>umbilical cord</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11341"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11340 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11340">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protrusion of bowel or omentum through the abdominal wall at the umbilicus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>umbilical hernia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11034"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11341 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11341">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vessel within the umbilical cord, entering the fetus at the umbilicus and carrying oxygenated blood from the placenta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>left umbilical vein</oboInOwl:hasRelatedSynonym>
        <rdfs:label>umbilical vein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11339"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11342 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11342">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Testis that has failed to descend completely from its developmental origin in the lower abdominal cavity into the scrotum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>cryptorchid testis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cryptorchidism</oboInOwl:hasRelatedSynonym>
        <rdfs:label>undescended testis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11197"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11343 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11343">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Duct by which urine is conveyed out of the body from the bladder, and which in male vertebrates also conveys semen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>urethra</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11202"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11344 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11344">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concerning the urinary and genital organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>genitourinary</oboInOwl:hasRelatedSynonym>
        <rdfs:label>urogenital</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11345 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11345">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic structure that forms in the ventral part of the cloaca when it separates from the anal canal to give rise to the genitourinary organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>A rare urogenital sinus anomaly occurs as a birth defect in the female when the urethra and vagina open into a common channel.</rdfs:comment>
        <rdfs:label>urogenital sinus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10537"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11343"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11346 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11346">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chamber on the interior surface of the uterus that serves as a site of embryo homing and implantation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>uterine crypt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11347 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11347">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regular, periodic changes that occur in the uterus and, together with the ovarian cycle constitute the menstrual cycle necessary for female fertility.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The three phases of the uterine cycle correspond to the three phases of the ovarian cycle.</rdfs:comment>
        <rdfs:comment>The uterine cycle consists of three phases: i) menstruation, ii) a proliferative phase in which the uterine wall thickens under the influence of estrogen, and iii) a secretory phase in which the corpus luteum is producing progesterone and the endometrium becomes receptive to implantation of the blastocyst.</rdfs:comment>
        <rdfs:label>uterine cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10462"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11055"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11136"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11348 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11348">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having an effect on the uterus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>uterotropic</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This usually refers to estrogen-like effects of uterine cell proliferation caused by some drugs and other substances with weak estrogen-mimetic properties.</rdfs:comment>
        <rdfs:label>uterotrophic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11349 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11349">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which immature female rodents are treated for three days with a test substance. A resultant increase in uterine wet weight suggests an estrogenic activity of the substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>uterotrophic assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11350 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11350">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hollow muscular organ of the female reproductive system that receives the fertilized ovum (see implantation) and supports the subsequent development of the fetus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>womb</oboInOwl:hasRelatedSynonym>
        <rdfs:label>uterus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11351 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11351">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Muscular projection from the posterior edge of the soft palate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>palatine uvula</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The uvula contributes to the gag reflex and is involved in shaping some sounds of human speech.</rdfs:comment>
        <rdfs:label>uvula</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11062"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11352 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11352">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibromuscular canal passing between the uterine cervix and the opening to the vulva.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The vagina permits sexual intercourse and delivery of babies.</rdfs:comment>
        <rdfs:label>vagina</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10507"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11353 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11353">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conversion of the normal epithelium of the vagina to a keratinized squamous (flattened) epithelium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The appearance of keratinized (&quot;cornified&quot;) epithelial cells in a vaginal smear is an indication of increased estrogen levels.</rdfs:comment>
        <rdfs:label>vaginal cornification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11354 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11354">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to the opening of the vagina that usually occurs at sexual maturity and is maintained by hormonal influences pre-menopausally.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vaginal patency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10935"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11216"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11355 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11355">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Examination by light microscopy of a sample of a vaginal discharge, used in the diagnosis of a vaginal infection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Not to be confused with a Papanicolaou smear.</rdfs:comment>
        <rdfs:label>vaginal smear</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11064"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11356 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11356">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anatomical deviation that is not life-threatening.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>developmental variation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11357 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11357">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>De novo development of blood vessel endothelium in absence of preexisting vessels, e.g., during fetal development or in connection with tissue repair, initiated by migration of mesodermal precursor cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vasculogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10429"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10661"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10944"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11358 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11358">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secretory duct of the testis running between the epididymis and the ejaculatory duct.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ductus deferens</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>spermatic duct</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vas deferens</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10642"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10668"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11295"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11359 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11359">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surgical removal of all or part of each vas deferens, typically as a means of sterilization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vasectomy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11258"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11358"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11360 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11360">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pituitary hormone that acts to promote the retention of water by the kidneys and to increase blood pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>antidiuretic hormone</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vasopressin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10810"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11094"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11361 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11361">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability to achieve closure of the velopharyngeal sphincter (closure of the muscle of the soft palate) during speech, owing to muscular dysfunction, cleft palate, or other disorders.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>velopharyngeal incompetence</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This insufficiency often causes speech problems by allowing air to escape through the nose instead of the mouth.</rdfs:comment>
        <rdfs:label>velopharyngeal insufficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10534"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11247"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11362 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11362">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large vein returning deoxygenated blood to the right heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The vena cava has two branches in humans, the inferior vena cava (carrying blood from the lower body) and the superior vena cava (carrying blood from the head, arms, and upper body).</rdfs:comment>
        <rdfs:label>vena cava</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11363 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11363">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Situated to the anterior side of the trunk; in humans, to the front of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ventral</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10615"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11364 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11364">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dividing wall between the two lower chambers (ventricles) of the heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>ventricular septum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11365 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11365">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital defect with an opening in the wall separating the right and left ventricles of the heart (see ventricular septum).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>VSD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This cardiac anomaly allows reflux of blood back to the right ventricle during left ventricular contraction, producing varying degrees of cyanosis.</rdfs:comment>
        <rdfs:label>ventricular septal defect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11364"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11365"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VSD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11366 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11366">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the bony segments that together make up the bony column surrounding the spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vertebra</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11367 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11367">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Denoting an animal that has as part of its nervous system a spinal cord that is surrounded by a bony vertebral column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vertebrate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11368 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11368">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small fluid-filled sac, bladder-like structure, or blister.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This term may refer to an anatomic structure, a subcellular organelle, or a liposome-related particle.</rdfs:comment>
        <rdfs:label>vesicle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11369 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11369">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In anatomy, pertaining to a remnant of an embryonic or fetal structure persisting in the adult.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vestigial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11370 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11370">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to continue living.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Fetal viability refers to the ability of the fetus to survive outside the uterus.</rdfs:comment>
        <rdfs:label>viability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11371 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11371">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Projection from the surface, typically of a mucous membrane. Elongated projection of the dermis into an epidermal space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>villus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10978"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11372 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11372">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intermediate filament protein that is expressed in mesenchymal cells, e.g., fibroblasts, leukocytes, and blood vessel endothelial cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Vimentin filaments support cell membranes, keep some organelles in a fixed place within the cytoplasm, and transmit membrane receptor signals to the nucleus.</rdfs:comment>
        <rdfs:label>vimentin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10661"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10942"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11373 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11373">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Possession or acquisition of characteristics of a male body, especially by a female or prepubescent male.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>virilization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11123"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11374 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11374">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Soft and hollow organs of the body, in vertebrates particularly those found in the thoracic and abdominal cavities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>This gives rise to the distinction of the visceral and parietal serous membranes, located closest to the organ or to the body wall, respectively. For examples, see pericardium, peritoneal cavity and pleura.</rdfs:comment>
        <rdfs:label>viscera</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10318"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11078"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11081"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11101"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11207"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11375 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11375">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein that forms part of the yolk of egg-laying vertebrates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>VTG</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Its expression in male fish is used in ecotoxicology as an indicator of exposure to environmental estrogenic endocrine disruptors.</rdfs:comment>
        <rdfs:label>vitellogenin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10658"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11367"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11375"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VTG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11376 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11376">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>External genitalia of the female.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>vulva</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10698"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11377 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11377">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Accustomize a young mammal to independence from its mother’s milk as a source of nutrition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>wean</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11378 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11378">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue or membrane present between adjacent structures where it is not usually found, e.g., between fingers or toes, or between the neck and shoulder, representing a congenital abnormality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>webbing</oboInOwl:hasRelatedSynonym>
        <rdfs:label>web</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10554"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11379 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11379">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gelatinous substance that embeds the vessels of the umbilical cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The jelly consists mainly of hydrated glycosaminoglycans such as hyaluronic acid and chondroitin sulfate.</rdfs:comment>
        <rdfs:label>Wharton’s jelly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11339"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11380 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11380">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of the brain and spinal cord consisting mainly of myelinated axons (see myelination) and glial cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>substantia alba</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Neurons of the white matter transmit signals between areas of grey matter within the cerebrum, to lower brain centers, and up and down the superficial aspect of the spinal cord.</rdfs:comment>
        <rdfs:label>white matter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10781"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10985"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11381 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11381">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique, used prior to embryo transfer during in vitro fertilization, in which embryos undergoing organogenesis are maintained in formulated medium outside the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>Whole embryo culture is a useful procedure for testing the teratogenic effects of a substance on organogenesis in rodent or chick embryos.</rdfs:comment>
        <rdfs:label>whole embryo culture</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10866"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11048"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11382 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11382">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of an allele or phenotype, the naturally occurring, unaltered, or most frequent; if several alleles occur, the most frequent one is considered to be the wild type.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>wild type</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11383 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11383">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital disorder with characteristic facies (described as elf-like), short stature, outgoing personality and mild mental retardation; associated with contiguous gene deletions on chromosome 7.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>elfin facies syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Williams syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10705"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11384 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11384">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Family of genes important in development, the proteins they encode, or the signal transduction pathways they determine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>The proteins signal by binding to cell-surface G-protein coupled receptors of the Frizzled family that signal to members of the Dishevelled (Dsh) family of cytoplasmic phosphoproteins.</rdfs:comment>
        <rdfs:comment>Wnt is derived from Wingless-related integration site, originally identified in Drosophila.</rdfs:comment>
        <rdfs:comment>Wnt pathways are involved throughout embryonic development, regulating such processes as cytoskeletal dynamics, cell polarity, proliferation, migration, and body axis patterning.</rdfs:comment>
        <rdfs:label>Wnt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11385 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11385">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromosome determining female sex in the absence of a Y chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>X chromosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11211"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11387"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11386 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11386">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Carried by a gene located on the X chromosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>X-linked</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11385"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11387 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11387">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromosome determining male sex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>Y chromosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11211"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11388 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11388">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nutritive material stored in the ovum for the nourishment of the embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>vitellus</oboInOwl:hasRelatedSynonym>
        <rdfs:label>yolk</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11389 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11389">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fluid-filled, membrane-bound pouch on the ventral side of the early embryo that provides nourishment until the circulatory system develops.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>yolk sac</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11363"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11390 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11390">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrow tubular support that connects the yolk sac to the middle of the digestive tract of an embryo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>yolk stalk</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11389"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11391 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11391">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small tertiary protein structure in which parts of the protein, typically with cysteine and histidine residues, link to a divalent zinc ion, forming a loop or &apos;finger&apos; that attaches proteins to DNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:comment>A zinc finger is present in many proteins, such as nucleases or transcription factors that regulate expression of eukaryotic genes.</rdfs:comment>
        <rdfs:label>zinc finger</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11311"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11392 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11392">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acellular glycoprotein-rich membrane surrounding the mature ovum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>zona pellucida</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11393 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11393">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sexual union of two cells with fusion of their nuclei.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>zygosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11394 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11394">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Introduction of a zygote fertilized in vitro into one of the Fallopian tubes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <oboInOwl:hasRelatedSynonym>ZIFT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tubal embryo transfer</oboInOwl:hasRelatedSynonym>
        <rdfs:label>zygote intrafallopian transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10713"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10746"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10866"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11394"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ZIFT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11395 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11395">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An observed or calculated property of the whole molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>1D property descriptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11396 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11396">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The structure of a molecule encoded into a string such as SMILES or InChI.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>1D structure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11456"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11514"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11397 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11397">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A molecular property that is calculated from the structure diagram of the molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>2D property</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11520"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11525"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11526"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11398 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11398">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The structure of a molecule presented as a drawing or a file that contains a description of the topology, stereochemistry, and atomic symbol of its atoms and the bonds connecting them, but no explicit information about its three-dimensional structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>2D structure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11399 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11399">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computational model of the quantitative relationship between the observed independent 1D property of a set of compounds and their dependent 1D properties or 2D properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>2D-QSAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>two-dimensional quantitative structure-activity relationships</oboInOwl:hasRelatedSynonym>
        <rdfs:label>2D quantitative structure-activity relationships</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11395"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11397"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11399"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>2D-QSAR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11400 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11400">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A property that is observed or calculated from a 3D representation of a molecule, which may depend on one or more conformations of the molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>3D property</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11490"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11401 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11401">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A virtual screening method that processes a chemical database to discover those compounds that match a query that either contains a 3D pharmacophore, a molecular shape or field, the 3D structure, or a combination of these.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>3D searching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11402"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11485"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11533"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11402 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11402">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The structure of the conformation of a molecule presented as a drawing or a file that describes atomic symbols of its atoms and the bonds connecting them as well as their coordinates in three-dimensional space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>3D structure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11403 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11403">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method to generate one or more 3D structures, conformations, of a molecule from its topological molecular graph.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>3D structure generation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11402"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11404 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11404">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computational model of the quantitative relationship between the target observed independent 1D properties for a set of compounds and the 3D properties of  several of their conformations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>4D-QSAR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>4D quantitative structure-activity relationships</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11395"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11400"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11404"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>4D-QSAR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11405 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11405">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A step-by-step procedure for solving a problem or performing a function, usually by a computer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11406 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11406">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The property or structure space for which the predictions of a computational model are considered to be reliable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>applicability domain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11407 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11407">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The area under a graph curve, such as the number of actives identified by an algorithm as a function of the number of compounds tested, commonly used as a  measure of the discriminating ability of an algorithm to correctly classify a test molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>AUC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In pharmacokinetics AUC is the area under the plot of plasma concentration versus time, which is used to evaluate drug exposure.</rdfs:comment>
        <rdfs:label>area under the curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11502"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11407"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AUC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11408 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11408">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A vector that describes a molecular structure in which each element corresponds to a distance (number of bonds in a 2D structure or a binned interatomic  distance in a 3D structure) between atoms of a particular type and the count of the number of times that distance is found in the structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>autocorrelation vector</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11398"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11409 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11409">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An artifactual increase in calculated stability of the supersystem (the system formed by noncovalent interaction between two or more molecular entities, e.g. hydrogen bond system) resulting from the basis set of the supersystem being larger than for the component subsystems. The BSSE arises from a lowering of the quantum mechanical energy when the electron density of each subsystem spreads into the basis functions provided by the other subsystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>BSSE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>basis set superposition error</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11409"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BSSE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11410 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11410">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A feed-forward neural network that uses Bayesian statistics to optimize the complexity and predictive power of the model.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Bayesian regularized neural network</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11411"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11411 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11411">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A branch of statistics in which the evidence of the state of a system is expressed in terms of degrees of belief (probabilities).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Bayesian statistics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11412 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11412">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method for calculating prior probability estimates of an event that can be revised in accordance with new observations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Bayes’s theorem</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11496"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11413 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11413">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method to combine probability estimate states that given two or more probabilities \(P_{i}\) that a particular event is true, the combined probability of the event is given by: \[P = 1 - \Pi (1 - {P_{i}})\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>belief theory</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11414 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11414">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A QSAR equation that describes the non-linear dependence of the relative biological potency (\(\log 1/C\)) of a molecule on log P by the following form: \[log(1/{C_i}) = a\log P_{i} - b \log (\beta P_{i} + 1) + c\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>bilinear equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11452"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11415 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11415">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A description of a molecule in a fixed length vector, each element of which is set from corresponding structural keys or calculated by hashing a molecular  fingerprint.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>bitmap</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bit string</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11519"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11416 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11416">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A generalization of the area under the ROC curve to weight more heavily the early recognition of active compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Boltzmann enhanced discrimination of receiver operating characteristic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11502"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11417 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11417">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from many models developed using sample sets that contain the same number of observations as the original set, but for which certain observations are randomly omitted and other observations are included more than once.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>bootstrap resampling</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11418 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11418">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The calculated molar refractivity of a molecule or substituent used as a measure of size and polarizability in 2D-QSAR.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>CMR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>calculated molar refractivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11399"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11418"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CMR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11419 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11419">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A unique representation of the chemical structure of a molecule that is independent of the sequence in which the atoms were ordered in the original input file  but is dependent on the algorithm used for the canonicalization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>At least one canonicalization algorithm exists for any type of structure file that is the basis of a structure search system.</rdfs:comment>
        <rdfs:comment>This representation is used to ensure the uniqueness of molecules in a database and to assist identification of molecules in internet searches.</rdfs:comment>
        <rdfs:label>canonical structure representation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11405"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11420 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11420">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An artificial correlation that can arise when too many properties are screened relative to the number of available observations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>chance correlation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11421 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11421">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The science of handling, indexing, archiving, searching, and evaluating information that is specific to chemical structures and is used in data mining,  information retrieval, information extraction, and machine learning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>chemoinformatics</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cheminformatics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11470"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11422 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11422">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hashed molecular fingerprints that describe, either by atom type or properties, each atom in the molecule; the atoms connected to it (for path length 2); the  atoms connected to them (for path length 4); and the atoms connected to them (for path length 6); etc..</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>circular fingerprints</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11483"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11519"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11423 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11423">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated log of the octan-1-ol/water partition coefficient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>clog P</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11424 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11424">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The geometric center of a cluster, often exemplified as the object that is closest to the center.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>cluster centroid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11425 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11425">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A linear relationship between two or more of the descriptors in a model, which can lead to difficulties in interpreting the relative importance of these  descriptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>collinearity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11426 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11426">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A 3D-QSAR method similar to CoMFA that instead uses Gaussian-type functions to calculate the 3D properties of the molecules by the similarity of each molecule  to each probe at each lattice position surrounding the molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>CoMSIA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>comparative molecular similarity analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11400"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11426"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CoMSIA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11427 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11427">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The ability of a two-group classification model to correctly classify all molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>concordance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11428 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11428">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A table layout that shows the results of a two-class/binary classifier in which columns correspond to the predicted classifications from the model and rows correspond to the observed classifications.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>A confusion matrix highlights the numbers of true positives TP (positives classified as positive), true negatives TN (negatives classified as negative), false positives FP (negatives classified as positive) and false negatives FN (positives classified as negatives).</rdfs:comment>
        <rdfs:label>confusion matrix</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11444"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11445"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11527"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11528"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11429 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11429">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The computational representation of a solvent as a continuous medium instead of individual explicit solvent molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>continuum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11489"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11430 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11430">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method to correct for basis set superposition error.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>counterpoise correction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11409"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11431 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11431">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The extraction of useful information from large sets of observations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>data mining</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11432 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11432">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Path fingerprints that are generated from a structure where atoms are described by atomic number and aromaticity; bonds are described as single, double,  triple, or aromatic; and the results are hashed into a bit string of fixed length.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Although these fingerprints were originally described by Daylight CIS, many other investigators have also implemented them.</rdfs:comment>
        <rdfs:label>Daylight fingerprints</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11483"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11433 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11433">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The process whereby a computer algorithm designs new molecules to meet certain single or multiple criteria, defined by an objective function, for example predicted affinity for a binding site or predicted affinity plus appropriate lipophilicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>de novo design</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11405"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11434 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11434">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The result of a recursive partitioning classification method that shows at each branching point the value of the property responsible for the split and the resulting classifications after the split.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>decision tree</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11503"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11435 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11435">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A quantum mechanical modeling method used to investigate the electronic structure of molecules using functionals that describe the spatially dependent electron density, rather than the wavefunction as in ab initio and semi-empirical quantum chemical methods.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>density functional theory</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11436 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11436">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A qualitative or quantitative property of a molecule or a part of a molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11437 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11437">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Computational methods that optimize the placement of a ligand in a macromolecular binding site of known or proposed 3D structure and provide a score as to the quality of the fit.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Docking programs differ as to whether conformational and chemical (tautomer, protomer) changes in the binding site are allowed and if only precalculated conformations of the ligand are used or if ligand flexibility is part of the docking.</rdfs:comment>
        <rdfs:label>docking</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11495"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11438 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11438">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An estimate of the probability that a chemical structure is similar to known drugs based on chemical or physical properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>drug-likeness</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11439 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11439">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The energy of the highest energy level in the ground state of a molecule that contains electrons, sometimes used as a measure of nucleophilicity in QSAR  models.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>energy of the highest occupied molecular orbital</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11440 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11440">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The energy of the lowest energy level of a molecule that contains no electrons in the ground state, sometimes used as a measure of electrophilicity in QSAR  models.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Also known as the energy of the lowest empty molecular orbital, \(E_{\rm{LEMO}}\).</rdfs:comment>
        <rdfs:label>energy of the lowest unoccupied molecular orbital</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11441 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11441">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A system that predicts properties or activities of chemicals from rules devised by domain experts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>expert system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11442 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11442">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Individual solvent molecules that are included in a computation, in contrast to those implied by a continuum approximation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>explicit solvent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11429"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11443 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11443">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hashed circular fingerprints that encode each atom according to its atomic symbol and hybridization for path length 2, ECFP2; path length 4, ECFP4; and path  length 6, ECFP6.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>ECFP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ECFP fingerprints</oboInOwl:hasRelatedSynonym>
        <rdfs:label>extended connectivity fingerprints</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11422"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11443"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ECFP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11444 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11444">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A model prediction of a negative result, such as no biological activity, when the true result is positive, i.e. activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>FN</oboInOwl:hasRelatedSynonym>
        <rdfs:label>false negative</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11428"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11444"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11445 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11445">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A model prediction of a positive result, such as biological activity, when the true result is negative, i.e. inactivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>FP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>false positive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11428"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11445"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11446 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11446">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A set of mathematical functions and their associated parameters used in a molecular mechanics or dynamics calculation of conformations, flexibility, and interactions of molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Within the molecular mechanics approach, a set of potential functions defining bond stretch, bond angle (both valence and dihedral) distortion energy of a molecule as compared with its nonstrained conformation (that characterized by standard values of bond lengths and angles). A set of transferable empirical force constants is preassigned and the harmonic approximation is usually employed. Some force fields may contain terms for interactions between non-bonded atoms, electrostatic, hydrogen bond and other structural effects as well as account for anharmonicity effects. In vibrational spectroscopy, the inverse problem is solved of determining a set of force constants and other parameters of a chosen potential energy functions which would match with experimentally observed vibrational frequencies of a given series of congeneric molecules.</rdfs:comment>
        <rdfs:label>force field</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11447 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11447">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Description of the structure of a molecule as the presence or absence of each of a pre-determined set of molecular substructures, usually associated with a  particular location in a bit string.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>fragment keys</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11457"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11448 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11448">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method that uses molecular dynamics or Metropolis Monte Carlo simulations to compute the relative free energy differences between two conditions, typically the solution and bound states of a ligand-protein system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>free energy perturbation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11449 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11449">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hashed circular fingerprints that encode each atom according to its property (hydrophobic, hydrogen bond donor, hydrogen bond acceptor, negatively charged, or  positively charged) for path length 2, FCFP2; path length 4, FCFP4; and path length 6, FCFP6.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>FCFP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>functional class fingerprints</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11422"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11449"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FCFP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11450 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11450">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computational model designed to cover all of chemistry space although it typically includes a measure of if the molecule for which the properties are to be  predicted is within or outside the applicability domain of the model.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>global model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11406"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11451 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11451">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computational method that converts the problem to be solved into a graph characterized by the character of the objects, such the atoms of a molecule or molecules in a database, and the distances between them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>graph-based method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11452 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11452">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A QSAR equation that describes the relationship between the logarithm of the relative biological potency of a molecule (\(\log (1/C_{i})\)) and its electronic and hydrophobic properties: \[\log (1/C_{i}) = \rho \sigma_{i} + b\,\log P_{i} - c\,(\log P_{i})^{2}\] in which fitting to the square term provides a parabola with an associated optimum log P.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Hansch equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11453 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11453">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A constant that describes the contribution of a substituent to the octan-1-ol-water log P of a compound.]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Hansch–Fujita π-constant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11454 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11454">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An algorithm that maps data of variable length, such as the raw descriptors of path or circular fingerprints or InChIs, to a smaller fixed length vector.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Hashed InChIs are named InChIKeys.</rdfs:comment>
        <rdfs:label>hashing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11455"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11483"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11455 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11455">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A fixed length (character) condensed digital representation of the InChI that is not human-understandable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>This is sometimes referred to as a hashed InChI.</rdfs:comment>
        <rdfs:label>InChIKey</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11456"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11456 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11456">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A non-proprietary canonical identifier of chemical substances that can be used in printed and electronic data sources to enable easier linking of diverse data  compilations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>InChI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>International Chemical Identifier</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11456"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>InChI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11457 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11457">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predefined fragment keys that are used in 2D substructure and similarity searching with the ISIS software but are also generated by many other software  programs and used for 2D-QSAR or cluster analysis of molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>ISIS keys</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11447"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11512"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11521"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11458 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11458">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from models developed by leaving out one or more observations at a time from the sample set.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>jackknifing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11417"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11459 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11459">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A type of topological index.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>kappa shape descriptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11525"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11460 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11460">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Algorithms for pattern analysis that use functions such as Gaussians to enable them to operate in a high-dimensional descriptor space without ever computing  the coordinates of the data in that space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>The support vector machine (SVM) is the most widely used kernel method.</rdfs:comment>
        <rdfs:label>kernel method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11405"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11461 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11461">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A form of cross-validation in which more than one observation is left out at each run. Typically many runs with random samplings are performed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>LSO</oboInOwl:hasRelatedSynonym>
        <rdfs:label>leave-some-out cross-validation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11461"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LSO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11462 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11462">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The influence of an observation on the coefficients of a fitted equation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>An observation with high leverage may be an outlier or in poorly explored property space.</rdfs:comment>
        <rdfs:label>leverage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11463 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11463">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of the free energy of binding per heavy atom count (i.e. non-hydrogen) of a molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>LE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An LE value of \(\pu{1.25 kJ mol-1}\) per non-hydrogen atom is the minimum requirement of a good lead or fragment.</rdfs:comment>
        <rdfs:comment>It is used to rank the quality of molecules in drug discovery, particularly in fragment-based lead discovery.</rdfs:comment>
        <rdfs:label>ligand efficiency</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11463"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11464 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11464">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method that forecasts ligand binding free energies using force field estimations of the receptor-ligand interactions and thermal conformational sampling .</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>LIE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>linear interaction energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11446"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11464"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LIE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11465 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11465">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A measure of the efficiency of ligand binding that is corrected for binding driven by lipophilicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>LLE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is calculated as; \[LLE = \pu{p}K_{i} - \log P\] values of seven or greater are considered characteristic of a good clinical candidate.</rdfs:comment>
        <rdfs:label>lipophilic ligand efficiency</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11465"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11466 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11466">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The contribution of the property to a principal component or partial least squares latent variable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>loading of a property</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11467 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11467">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computational model that applies to only a subset of molecules, typically a closely related series.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>local model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11450"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11468 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11468">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The logarithm of the ratio of the total concentration (neutral and charged species) of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in water at a given \(\pu{pH}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>log &lt;em&gt;D&lt;/em&gt;</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11469 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11469">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The logarithm of the ratio of the concentration of the uncharged form of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in  water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Common algorithms to calculate \(\log P\) are CLOGP and ALOGP.</rdfs:comment>
        <rdfs:label>log &lt;em&gt;P&lt;/em&gt;</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11470 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11470">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computer algorithm that generates empirical models, such as a model of biological potency as a function of the properties of the molecules, that is derived  from the analysis of a training set for which all the necessary data are available.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>machine learning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11503"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11471 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11471">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A file that describes in detail the features of a macromolecular structure and the X‑ray diffraction experiment that was used to derive that structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>mmCIF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>macromolecular crystallographic information file</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>mmCIF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11472 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11472">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A structure diagram that describes a set of related molecules with the structure of the common core and the structures of the substituents at each position.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Markush structures are commonly used in patent claims.</rdfs:comment>
        <rdfs:label>Markush structure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11520"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11473 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11473">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A measure of the spread of various properties or chemotypes within a set of compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>molecular diversity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11474 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11474">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Descriptions of the structure of a molecule calculated from the properties of each of its atoms and bonds that are then usually condensed into a fixed-length string by a hashing algorithm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>molecular fingerprints</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11443"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11449"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11483"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11475 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11475">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The degree to which two molecules resemble one another as calculated from their respective 2D or 3D properties, molecular fingerprints, fragment keys, or superimposed 3D structures that usually ranges from 1 (identical) to 0 (dissimilar).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Tanimoto or Tversky similarities for 2D structures and Carbo or Hodgkin for 3D structures.</rdfs:comment>
        <rdfs:label>molecular similarity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11400"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11402"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11447"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11523"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11529"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11476 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11476">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A visualization method that converts a dataset of distances between molecules in property space into coordinates in lower dimension space with emphasis on  preserving the relative distances between dissimilar molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>MDS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>multidimensional scaling</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11476"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11477 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11477">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The search for those combinations of properties that produces the best compromise between the various objectives of the search, for example properties of  compounds that are the best trade-off between potency, bioavailability, and selectivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>MOO</oboInOwl:hasRelatedSynonym>
        <rdfs:label>multiobjective optimization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11480"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11481"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MOO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11478 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11478">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A preprocessing method for partial least squares calculations that filters out variation that is not correlated to the property to be fit and so results in  improved interpretability of a PLS model while maintaining its predictivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>O-PLS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>orthogonal projections to latent structures</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11478"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>O-PLS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11479 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11479">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Training a machine learning model for so long that the original input data is memorized with the result that model predictivity is degraded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>overtraining</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11480 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11480">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The various combinations of predictor properties that lead to optimum predicted compromises in multiple target properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Pareto front</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11481 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11481">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The search for solutions to functions that provide a compromise between several desirable outcomes, such as potency, lack of toxicity, and good absorption, distribution, metabolism, and excretion (ADME) properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Pareto optimization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11482 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11482">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Charges assigned to atoms, arising from the uneven distribution of electrons in bonds, that are used to calculate intermolecular interaction energy or to  characterize the charge distribution of a molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>The charges can be derived from quantum chemical population analyses, fitted dipole moments or electrostatic potentials, spectroscopic data, or from partitioning electron density.</rdfs:comment>
        <rdfs:comment>There is no firm theoretical basis for the assignment of partial atomic charges, hence there is no &quot;correct&quot; one.</rdfs:comment>
        <rdfs:label>partial atomic charges</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11483 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11483">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vectors of Boolean arrays generated from the properties of the atoms and bonds in linear paths, typically two to seven bonds long, hashed into an integer of  fixed determined length.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>path fingerprints</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11519"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11484 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11484">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A text file that stores the atomic coordinates of a macromolecule, usually a protein or nucleic acid with associated ligands, solvent molecules and ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>PDB file</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The documentation for the file format is at https://files.wwpdb.org/pub/pdb/doc/format_descriptions/Format_v33_Letter.pdf.</rdfs:comment>
        <rdfs:label>protein data bank file</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11485 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11485">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A proposal for the ensemble of steric and electronic features that define the optimal supermolecular intermolecular interaction of a ligand with a specific  biological target structure with the result that it triggers or blocks its biological response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>pharmacophore</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11486 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11486">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Visual programming of the computational execution of sequential operations on a dataset, with each node specifying an operation with options, and the nodes processed sequentially.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>pipelining programs</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11487 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11487">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the vectors of a linear combination of the input descriptors that a partial least squares calculation extracts from a dataset.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>PLS latent variable</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11488 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11488">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The contribution of a particular property to a PLS latent variable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>PLS loading</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11487"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11489 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11489">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A differential equation that uses a mean-field, continuum model to describe the electrostatic interactions in ionic solutions where both ions and solvent are  treated implicitly, resulting in less computational effort to describe biomolecules in ionic aqueous solutions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Poisson–Boltzmann equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11429"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11490 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11490">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface area over all polar atoms (usually oxygen and nitrogen), including any attached hydrogen atoms, of a molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>PSA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Polar surface area is a commonly used metric (c.f. molecular descriptor) for the optimisation of cell permeability. Molecules with a PSA of greater than \(\pu{1.4 nm2}\) are usually poor at permeating cell membranes. For molecules to penetrate the blood-brain barrier, the polar surface area should normally be smaller than \(\pu{0.6 nm2}\), although values up to \(\pu{0.9 nm2}\) can be tolerated.</rdfs:comment>
        <rdfs:comment>Sometimes sulfur atoms are included in the definition.</rdfs:comment>
        <rdfs:comment>The value of PSA depends on the conformation of the molecule and also the algorithm and atomic radii used in the calculation.</rdfs:comment>
        <rdfs:label>polar surface area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11436"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11526"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11490"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PSA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11491 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11491">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A 2D diagram that shows the interactions between a ligand and a protein in the 3D structure of the complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>pose diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11492 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11492">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The conditional probability that is assigned to a quantity after relevant evidence is taken into account. The prior and posterior probabilities are linked by  the (normalized) likelihood function (Bayes&apos;s theorem).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>posterior probability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11412"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11496"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11493 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11493">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecules that have been set aside from model development to test the reliability of the derived model.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>prediction set</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11524"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11494 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11494">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The contribution, scaled between \(\pu{-1.0}\) and \(\pu{1.0}\), of an original variable to a particular principal component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>principal component loading</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11495 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11495">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A property of a molecule calculated from a principal components analysis of the original properties and the value of these properties for the molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>principal component score</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11496 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11496">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The conditional probability that is assigned to a quantity before relevant evidence is taken into account, for example, the prior probability of an active  compound would be the fraction of the compounds in the dataset that are active.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>The prior and posterior probabilities are linked by the (normalized) likelihood function (Bayes theorem).</rdfs:comment>
        <rdfs:label>prior probability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11412"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11492"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11497 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11497">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An archive of freely available macromolecular structural data of proteins, nucleic acids, and complex assemblies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>PDB</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The PDB is maintained by the Worldwide Protein Data Bank (wwPDB) with members RSCB PDB (USA), PDBe (Europe), PDBj (Japan), and BMRB (USA) that act as centers for deposition, data processing and distribution of PDB data.</rdfs:comment>
        <rdfs:comment>The URL for the organization is https://www.wwpdb.org.</rdfs:comment>
        <rdfs:label>protein data bank</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11497"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PDB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11498 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11498">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The square of the leave-one-out cross-validation regression coefficient calculated from the variance of the observed versus predicted values of the target  property, usually potency, of each compound when eliminated during cross-validation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>This is related to r2, which is calculated as the fit of the observed to calculated for the whole dataset.</rdfs:comment>
        <rdfs:label>q2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11499 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11499">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The ratio of the sum of squares explained by a regression model (SSR) to the &apos;total&apos; sum of squares around the mean (SST), or, because SST equals SSR plus the sum of squares of the error or residuals from the fit (SSE): \[R^{2} = \frac{{\rm{SSR}}}{{\rm{SST}}} = 1 - \frac{{\rm{SSE}}}{{\rm{SST}}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>$R^{2}$</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Except for the comparison of different models for the same dataset, \(R^{2}\) values are not a good indica- tion of fit of a model because the calculation depends on SST, which is larger if there is more spread in the observed values.</rdfs:comment>
        <rdfs:comment>\(R_{2}\) values can range between \(\pu{0.0}\) and \(\pu{1.0}\).</rdfs:comment>
        <rdfs:label>r2</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11500 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11500">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A classification method that produces many recursive partitioning models, each with a random selection of predictor properties, and then combines the models  for predictions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>random forest method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11503"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11501 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11501">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The fraction of the total number of actives, in the top-scoring docking hits, such as the fraction of true actives that are retrieved in the top \(\pu{1\%}\) scoring molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>recall</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11516"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11502 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11502">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A plot that shows the result of a test of the performance of a binary classifier by plotting the fraction of true positives identified versus the fraction of  false positives as the discrimination threshold is varied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>ROC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ROC curve</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>ROC curves are frequently used to compare different docking/scoring combinations or virtual screening protocols by the retrieval results from seeding a database of inactive molecules with known actives.</rdfs:comment>
        <rdfs:comment>The area under the ROC curve (AUC) provides a measure of the superiority of the model over random predictions: If the value for the AUC for a ROC curve has the value of \(\pu{0.9\!-\! 1.0}\), the fit is considered excellent, whereas an AUC of \(\pu{0.5}\) suggests that the algorithm has no discriminatory power.</rdfs:comment>
        <rdfs:comment>This is an example of using area under the curve as a measure of model performance.</rdfs:comment>
        <rdfs:label>receiver-operator characteristic curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11407"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11416"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11445"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11528"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11502"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ROC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11503 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11503">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A classification method that uses predictor properties to successively divide the data set into subsets such that each resulting subset is enriched in  molecules that are in one class.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>recursive partitioning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11504 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11504">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Introducing additional information in order to solve an ill-posed problem or to prevent overfitting, usually taking the form of a penalty for complexity of the  model.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>regularization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11505 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11505">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evaluation of the robustness of a QSAR or classification model by repeatedly randomizing the target property of compounds, developing models based on this  randomized property, and comparing the statistics of fit of the scrambled models with those of the true model, which should be superior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>response scrambling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11506 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11506">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The process whereby the molecules in a dataset are partitioned into the core (&apos;scaffold&apos;), usually user-specified, and the specific substituents (&apos;R-groups&apos;)  found at each specific position.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>R-group decomposition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11507 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11507">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The rule of five states that molecules that violate two or more of the following rules are likely to have permeability problems; (1) CLOGP calculated octan-1-ol-water log P greater than 5.0; (2) molecular weight greater than 500; (3) more than five hydrogen bond donors; and (4) the sum of oxygen and nitrogen atoms is greater than 10.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Natural products, peptides and other substrates for biological transporters are exceptions.</rdfs:comment>
        <rdfs:comment>The original authors also noted that one can calculate the octan-1-ol-water log P with the program MLOGP for which the cut-off is \(\pu{4.15}\). Users often use log P’s calculated with other programs or measured values.</rdfs:comment>
        <rdfs:label>rule of five</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11508 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11508">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A mathematical formula that estimates the binding affinity of a ligand to a macromolecular target based on the structure of the complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Scoring is used to select poses and to rank compounds in docking.</rdfs:comment>
        <rdfs:label>scoring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11437"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11509 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11509">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A computer text file that follows a specified format in which each molecule is described by 2D or 3D coordinates, atom type, and connectivity to other atoms  and also specific user-definable fields that contain other information such as name and biological or chemical properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>SDF file</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SDfile</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The format of the files is described in the following document: https://discover.3ds.com/sites/default/files/2020-08/biovia_ctfileformats_2020.pdf (link updated).</rdfs:comment>
        <rdfs:label>structure-data format file</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11510 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11510">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Analysis, often by finding approximate derivatives of the output with respect to each input, that determines which of the descriptors in a model has the  greatest influence on the output.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>sensitivity analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11436"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11511 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11511">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A method that predicts the probability that a molecule or set of molecules will be active against a particular target by considering its pairwise similarities  to all known ligands for that target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>SEA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>similarity ensemble approach</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11511"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SEA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11512 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11512">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A virtual screening method that calculates the molecular similarity of an input 2D or 3D structure to each of the molecules in a database to identify a  requested number of most similar molecules or those above some similarity threshold.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>similarity searching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11475"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11523"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11529"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11533"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11513 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11513">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An expansion of the SMILES language that describes a particular specific or generalized substructure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>SMARTS</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11514"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11515 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11515">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A derivative of the SMILES language that describes the transformation in a chemical reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>SMIRKS</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11514"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11516 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11516">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The ability of a two-class model to detect known inactive or non-toxic molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>specificity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11501"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11517 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11517">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The standard error of the errors or residuals, observed minus calculated, from a computational model: \[{\rm{SEE}} = \sqrt \frac{\sum (Y_{o} - Y_{c})^{2}}{n}\] in which \(Y_{o}\) is the observed value of \(Y\), \(Y_{c}\) is the calculated value of \(Y\), and \(n\) is the number of observations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Sometimes also labeled root mean square deviation (RMSD).</rdfs:comment>
        <rdfs:label>standard error of estimates</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11518"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11518 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11518">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The standard deviation of the errors or residuals, observed minus calculated, from a computational model: \[{\rm{SEP}} = \sqrt \frac{\sum (Y_{o} - Y_{p})^{2}}{n - k}\] in which \(Y_{o}\) is the observed value of \(Y\), \(Y_{p}\) is the predicted value of \(Y\), \(n\) is the number of observations, and \(k\) is the number of terms in the model.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Sometimes also labeled root mean square error of predication (RMSEP).</rdfs:comment>
        <rdfs:label>standard error of prediction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11517"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11519 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11519">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A pre-established set of substructures the presence or absence of which are used to describe a molecule and are used during substructure searching as a filter  to eliminate molecules that cannot match a query, for clustering or similarity searching, or for developing classification or regression models.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>structural keys</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11512"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11521"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11520 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11520">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A 2D drawing that shows the atoms of a molecular structure and the bonds that connect them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>structure diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11521 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11521">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A virtual screening method that uses a graph-based method to discover which molecules in a chemical structure database contain the substructure specified in  the query.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>substructure searching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11451"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11533"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11522 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11522">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A machine learning method that aims to discover a relationship between the predictor and the response values, such as exists in a QSAR or recursive  partitioning model.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>supervised learning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11503"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11523 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11523">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A scale that ranges from \(\pu{0.0}\) to \(\pu{1.0}\) when calculated as the ratio of the fingerprint bits or structural keys that both molecules have set divided by the number of bits or keys set in both molecules plus those set either molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>In set theory terms the Tanimoto similarity is equal to the ratio of the intersection set to the union set.</rdfs:comment>
        <rdfs:comment>The Tanimoto similarity can also be calculated for molecules described by continuous variables. The similarities in this case range from \(\pu{-1\!{/}\! 3}\) to \(\pu{1.0}\).</rdfs:comment>
        <rdfs:comment>The value of a Tanimoto similarity of a pair of molecules depends on the molecular fingerprint or structural keys used in the calculation.</rdfs:comment>
        <rdfs:label>Tanimoto similarity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11529"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11524 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11524">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The set of molecules not used in any way to devise a computational model but instead are used to test its predictivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>A test set differs from a prediction set in that the molecules and their associated activities may be derived from a source other than that from which the model was derived, for example, compounds tested after the model was developed.</rdfs:comment>
        <rdfs:label>test set</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11493"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11525 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11525">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A numerical value associated with chemical constitution for correlation of chemical structure with various physical properties, chemical reactivity or biological activity. The numerical basis for topological indices is provided (depending on how a molecular graph is converted into a numerical value) by either the adjacency matrix or the topological distance matrix. In the latter the topological distance between two vertices is the number of edges in the shortest path between these.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>topological index</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11526 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11526">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An approximation to polar surface area that is calculated from the 2D structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>TPSA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>topological polar surface area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11398"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11490"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11526"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TPSA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11527 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11527">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A model prediction of a negative result, such as no biological activity, when the true result is also negative.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>TN</oboInOwl:hasRelatedSynonym>
        <rdfs:label>true negative</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11428"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11527"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11528 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11528">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A model prediction of a positive result, such as biological activity, when the true result is also positive.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <oboInOwl:hasRelatedSynonym>TP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>true positive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11428"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11528"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11529 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11529">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An asymmetric measure in which a target structure is compared to a reference structure with user-selectable weighting of the relative importance of the fingerprint bits or structural keys that are present only in the reference versus the fingerprint bits or structural keys that are only in the target, weightings for which the Tanimoto coefficient uses \(\pu{1.0}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>Tversky similarity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11519"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11523"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11530 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11530">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A system in which the number of descriptors is much larger than the number of observations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>underdetermined system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11531 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11531">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The molecules not used to devise a computational model but instead are used during model development to test for possible over-fitting as seen when additional  properties are added to a model but the predicted potencies of the validation set become less accurate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>validation set</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11532 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11532">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The computer encoding of a possible chemical reaction between two explicit or Markush structures or substructures, often with a mapping between the atoms in  the starting material and those in the product.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>virtual reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11472"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11515"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11533 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11533">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Computational methods that rank the molecules in a database by their forecast continuous or categorical biological or chemical properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:comment>Virtual screening is often used to predict the ability of molecules to bind to a macromolecular target of known 3D structure, to fit a ligand-based hypothesis of bioactivity, for their similarity to known actives, or to be mutagenic.</rdfs:comment>
        <rdfs:label>virtual screening</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11534 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11534">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The sequence of steps used to perform a certain task.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-1204"/>
        <rdfs:label>workflow</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11535 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11535">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monomer which from the name of a polymer appears to have been used in the synthesis of the latter when it has actually been prepared from different precursor(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0702"/>
        <rdfs:comment>The term replaces both of the formerly used terms &quot;hypothetical monomer&quot; and &quot;implicit monomer&quot;, which are now deemed to be obsolete.</rdfs:comment>
        <rdfs:label>apparent monomer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11536 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11536">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Homopolymer that is composed of macromolecules comprising blocks that have at least one constitutional or configurational feature which is not present in the adjacent portions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0702"/>
        <rdfs:label>block homopolymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11537 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11537">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Homopolymer composed of macromolecules with one or more species of block connected to the main chain as side chains, these side chains having constitutional or configurational features that differ from those in the main chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0702"/>
        <rdfs:label>graft homopolymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11538 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11538">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement of the concentration of a component of a solution with a reference measurement standard for the preparation of a secondary measurement standard</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2023-0903"/>
        <rdfs:comment>Quantities that denote relative composition include mass concentration, number concentration, amount of substance concentration, molality, mass fraction, amount of substance fraction, and volume fraction.</rdfs:comment>
        <rdfs:comment>Standardization is commonly performed by titration. It may be done by other means such as gravimetric analysis, e.g., standardize \(\ce{AgNO3}\) by precipitating \(\ce{AgCl}\).</rdfs:comment>
        <rdfs:label>standardization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09043"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11539 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11539">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detection principle for a chemically modified electrode (CME) in which an analyte or reagent accumulated at a CME undergoes quantitative release (egress, stripping, expulsion, or microdosing) to the test solution, under electrochemical or chemical control.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2018-0109"/>
        <rdfs:comment>Different mechanisms are involved in controlled release from the CME depending on the nature of the analyte or reagent and the method of accumulation. In the case of accumulation by covalent bonding, the anchoring bond is cleaved (ruptured) electrochemically. In the case of ion-exchange accumulation, an ionic (redox or acid-base) analyte or reagent is released by neutralizing its charge or the charge of the ion-exchanging redox polymer film or conducting polymer film.</rdfs:comment>
        <rdfs:label>controlled release</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11540 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11540">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion-selective electrode in which the ion-selective membrane contacts the electronic conductor without internal electrolyte solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2018-0109"/>
        <oboInOwl:hasRelatedSynonym>metal contact ion-selective electrode</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Charge transfer is accomplished in the membrane by both ionic and electronic conductivities (mixed conductors).</rdfs:comment>
        <rdfs:comment>The inner reference electrode is replaced by an electronic conductor, e.g., a bromide sensor film of \(\ce{AgBr}\) is reversibly contacted with \(\ce{Ag}\), or an anion sensor based on cation radical salts is contacted with \(\ce{Pt}\).</rdfs:comment>
        <rdfs:label>all-solid-state ion-selective electrode</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09119"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11541 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11541">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Film, one molecule thick, in an ordered assembly on a surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0404"/>
        <oboInOwl:hasRelatedSynonym>SAM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>self-assembled monolayer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11541"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11542 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11542">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion formed by the association of a cation with a molecule \(\ce{M}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0404"/>
        <rdfs:comment>Cationization with, for instance, \(\ce{Ag}\), leads to high yields of some positive ion fragments or molecular ions. Each ion has a mass given by the sum of the mass of the parent molecule or fragment and the mass of the added metal atom or atoms. The \(\ce{Ag}\) can be used either as the substrate upon which the molecules are deposited or in the form of a sub-monolayer sputtered onto the molecules already on a surface.</rdfs:comment>
        <rdfs:comment>\(\ce{NH4^{+}}\) can be used as well as metals to cationize molecules.</rdfs:comment>
        <rdfs:label>cationized molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11543 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11543">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of a molecular ion or molecule calculated using the isotope mass of the most abundant constituent element isotope of each element rounded to the nearest integer value and multiplied by the number of atoms of each element.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0404"/>
        <rdfs:label>nominal mass</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11544 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11544">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of a time-of-flight mass spectrometer that uses a static electric field to reverse the direction of travel of the ions and improves mass resolution by assuring that ions of the same m/z but different translational energy arrive at the detector at the same time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2019-0404"/>
        <rdfs:label>reflectron</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11545 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11545">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attachment of interfaces between phases or components that is maintained by intermolecular forces, chain entanglements, or both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2018-1215"/>
        <oboInOwl:hasRelatedSynonym>tack</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Adhesive strength (recommended symbol: \(F_{\rm{a}}\), unit: \(\pu{N m^{-2}}\)) is the force required to separate one condensed phase domain from another at the interface between the two phase domains divided by the area of the interface.</rdfs:comment>
        <rdfs:comment>Interfacial adhesion is also referred to as tack.</rdfs:comment>
        <rdfs:comment>Interfacial tension (recommended symbol: \(\upgamma\), unit: \(\pu{N m^{-1}}\), \(\pu{J m^{-2}}\)) is the change in Gibbs energy per unit change in interfacial area for substances in physical contact.</rdfs:comment>
        <rdfs:label>adhesion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11546 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11546">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The relationship between the initial rate (velocity) of an enzyme-catalysed reaction \(v_{0}\) and the initial substrate concentration \([\ce{S}]_{0}\) in the form \[v_{0} = V[\ce{S}]_{0}/(K_{\rm{M}} + [\ce{S}]_{0})\] where \(V\) (the limiting rate) and \(K_{\rm{M}}\) (the Michaelis constant) are independent of the initial substrate concentration and constant at a given temperature and a given enzyme concentration. The reaction is then said to display Michaelis–Menten kinetics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2016-1120"/>
        <rdfs:comment>The symbol \(V_{\rm{max}}\) and the names &quot;maximum rate&quot; and &quot;maximum velocity&quot; are also in widespread use, although in general and under normal circumstances there is no finite substrate concentration at which \(v_{0} = V\). Hence, there is no maximum in the mathematical sense. The alternative name Michaelis concentration for \(K_{\rm{M}}\) may also be used and has the advantage of emphasizing that the quantity concerned has the dimension of a concentration and is not, in general, an equilibrium constant. The Michaelis constant is the substrate concentration at which \(v_{0} = V/2\).</rdfs:comment>
        <rdfs:comment>The term ‘hyperbolic kinetics’ is also sometimes used, because a plot of \(v_{0}\) against \([\ce{S}]_{0}\) has the form of a rectangular hyperbola through the origin with asymptotes \(v_{0} = V\) and \([\ce{S}]_{0} = -K_{\rm{M}}\). This term, and others that imply the use of particular kinds of plot, should be used with care to avoid ambiguity, as they can be misleading if used out of context.</rdfs:comment>
        <rdfs:label>Michaelis–Menten equation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11547 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11547">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of the primary structure of a protein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2016-1120"/>
        <rdfs:label>protein sequencing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11548 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11548">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>pH of the solute zone in pH-zone-refining counter-current chromatography. \[{\rm{pH}}_{\rm{zone}} = \pu{p}K_{\rm{a}} + \log[(K_{\rm{DS}}/K_{\rm{S}}) - 1]\], where \(K_{\rm{DS}}\) is the partition ratio of solute $\ce{S}$ (an indicator for solute hydrophobicity) and \(K_{\rm{S}}\), the dissociation constant of the solute.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:comment>According to theoretical analysis two solutes that differ their zone \(\pu{pH}\) values by \(\pu{0.2}\) or greater can be resolved in \(\pu{pH}\)-zone-refining CCC.</rdfs:comment>
        <rdfs:label>zone pH</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09947"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11549 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11549">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of the mobile phase within the pores of the particles in the stationary phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <oboInOwl:hasRelatedSynonym>intrastitial volume of the column</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>stationary mobile-phase volume</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The retention time equivalent to \(V_{\rm{i}}\) is \(t_{\rm{i}}\) \[t_{\rm{i}} = \frac{V_{\rm{i}}}{F_{\rm{c}}}\]</rdfs:comment>
        <rdfs:label>intraparticle volume of the column</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11550 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11550">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fraction of the intraparticle volume (the volume of the pores) available to the molecules of a particular sample component for diffusion: \[K_{0} = \frac{V_{\rm{R}} - V_0}{V_{\rm{i}}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2017-0111"/>
        <rdfs:comment>In exclusion chromatography, \(K_{0}\) is related to the retention volume of a sample component and the inter- and intraparticle volumes of the column (\(V_{0}\) and \(V_{\rm{i}}\), respectively) in a manner analogous to the relationship in general liquid chromatography: \[V_{\rm{R}} = V_{0} + K_{0}V_{\rm{i}}\]</rdfs:comment>
        <rdfs:comment>The value of \(K_{0}\) varies between zero and unity. For an unretained compound, \(V_{\rm{R}} = V_{0}\) and thus, \(K_{0} = 0\). On the other hand, for a compound the molecules of which are smaller than the smallest pores, \(V_{\rm{R}} = V_{\rm{t}}\) and thus, \(K_{0} = 1\).</rdfs:comment>
        <rdfs:label>distribution constant (exclusion)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.09961"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11551 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11551">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calibration for extraction when close to equilibrium conditions, using a known for the distribution constant for the analyte.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0903"/>
        <rdfs:label>distribution constant calibration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11552 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11552">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extraction method characterized by a low phase ratio, so that at equilibrium the fraction extracted is low (i.e. the extraction is not exhaustive).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0903"/>
        <rdfs:label>microextraction (methology)</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11553 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11553">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extraction technique in which the volume (mass) of the extraction phase (liquid or solid) is substantially smaller than the sample volume (mass).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0903"/>
        <rdfs:comment>The volume of extraction phase is typically \(\pu{\lt 100 \upmu L}\) or (mass \(\lt \pu{10 mg}\)) and the sample volume is \(\gt \pu{1 mL}\).</rdfs:comment>
        <rdfs:label>microextraction (technique)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11554 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11554">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid-phase extraction using a syringe with a short sorbent bed located between the plunger and the needle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0903"/>
        <oboInOwl:hasRelatedSynonym>MEPS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The MEPS syringe facilitates low-dead volume sample processing by vertical movement of the plunger.</rdfs:comment>
        <rdfs:comment>Typically based on a \(\pu{100 \upmu L}\) or \(\pu{250 \upmu L}\) volume syringe with a packed bed containing \(\pu{1\!{–}\! 2 mg}\) of sorbent.</rdfs:comment>
        <rdfs:label>microextraction (packed sorbent)</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10255"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11554"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MEPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11556 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11556">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjustment, physiologically and (or) behaviorally, of an organism to its environment or circumstances, e.g., thermoregulation, psychological adjustment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>acclimatization</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In biology, acclimation refers to allowing this adjustment prior to initiating experimental observations, whereas the term acclimatization refers to adaptation or selection of an organism or population in its natural environment.</rdfs:comment>
        <rdfs:label>acclimation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11557 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11557">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that functions as a neurotransmitter between nerve cells and between nerves and muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>2-acetoxy-N,N,N-trimethylethanaminium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ACh</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acetylcholine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ACh</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11558 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11558">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that hydrolyzes acetylcholine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>AChE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acetylcholine hydrolase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cholinesterase inhibitor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acetylcholinesterase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11558"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AChE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11559 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11559">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Integral membrane protein that allows the cell to respond to the binding of acetylcholine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>acetylcholine receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11560 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11560">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-malignant intracranial tumor of the eighth cranial nerve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>acoustic neurinoma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vestibular Schwannoma</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The eighth cranial (vestibulocochlear) nerve is involved in both hearing and balance.</rdfs:comment>
        <rdfs:comment>This tumor arises from the Schwann cells.</rdfs:comment>
        <rdfs:label>acoustic neuroma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12064"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11561 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11561">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal feeling of numbness, tingling, or burning of the skin, typically in the extremities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>acroparesthesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Brief, spike-like depolarization associated with the passage of an impulse without decrement along the membrane of a muscle cell or nerve cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Action potentials also occur in many endocrine cells.</rdfs:comment>
        <rdfs:comment>It is used for rapid signaling over a distance.</rdfs:comment>
        <rdfs:label>action potential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11563 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11563">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fear-motivated associative avoidance test based on presentation of an adverse stimulus (e.g., an electric current) as a source of discomfort, to create an environment from which the animal or subject would prefer to escape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In this test, a mouse or rat learns to associate the occurrence of an aversive event with the presentation of a specific stimulus, and to avoid the event by actively moving to a different location. The number of avoidances (moving to the other location during the stimulus signal), number of non-responses or errors (failing to move to the other location during the trial), and response latency (time between signal onset and response), are used as an index of learning.</rdfs:comment>
        <rdfs:label>active avoidance test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compulsive, uncontrolled reward-seeking behavior, especially referring to substance use.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>physical dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>psychological dependence</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An addiction may be psychological, referring to a craving or felt need for a behavior that produces a desired mental state without a known physiological basis, or it may be a physical (physiological) dependence in which discontinued use of a substance leads to symptoms of withdrawal.</rdfs:comment>
        <rdfs:label>addiction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11798"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Benign tumor arising from epithelial cells in glandular tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>adenoma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of four types of purinergic receptors that respond to the nucleoside, adenosine, two of which are involved in release of the neurotransmitters, dopamine and glutamate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The stimulatory effects of caffeine are thought to be due to caffeine’s blockade of adenosine receptors.</rdfs:comment>
        <rdfs:label>adenosine receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11723"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Catecholamine hormone secreted by the adrenal glands that increases heart rate, breathing rate, blood pressure, and carbohydrate metabolism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>(R)-4-(1-hydroxy-2-(methylamino)ethyl)benzene-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>2-diol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>adrenaline</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>epinephrine</oboInOwl:hasRelatedSynonym>
        <rdfs:label>adrenalin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11568 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11568">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or denoting secretion of and (or) response to adrenalin, noradrenalin or related substances; in particular referring to sympathetic nerve fibers. Relating to or denoting an agent that mimics the activity of adrenalin, noradrenalin or related substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>adrenergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11567"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12107"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12108"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11569 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11569">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of adrenergicreceptor mainly functioning in vasoconstriction and modulation of glandular secretions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>α-adrenergic receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11568"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11570 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11570">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a class of G protein-coupled receptors that are targets of the catecholamines, especially adrenalin, noradrenalin, and related substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>adrenergic receptor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>adrenoceptor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>β-adrenergic receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11567"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11571 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11571">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflowing. Of nerves, those that conduct impulses toward the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>afferent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11741"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11572 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11572">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Impaired ability to recognize or comprehend the meaning of various sensations, not attributable to faulty sensory input or general intellect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Involvement of several senses are distinguished, such as auditory (acoustic), gustatory, olfactory, tactile, and visual agnosias.</rdfs:comment>
        <rdfs:label>agnosia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11573 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11573">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein abundant in the human brain, thought to regulate the release of dopamine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>alpha-synuclein</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11574 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Common and progressive neurodegenerative disease leading to loss of memory, orientation, and judgment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Alzheimer disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11575 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11575">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Major neurotransmitter at inhibitory synapses in the central nervous system of mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>4-aminobutanoic acid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GABA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is often referred to as an &quot;inhibitory neurotransmitter.&quot;</rdfs:comment>
        <rdfs:label>γ-aminobutyric acid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11575"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GABA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11576 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11576">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transmembrane receptor protein that binds and responds to the inhibitory neurotransmitter $\ce{\upgamma\!\mbox{-}aminobutyric acid}$.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>GABA Receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>GABA receptors are found in different parts of the central nervous system.</rdfs:comment>
        <rdfs:comment>There are two different receptor types with different signal transduction pathways:GABA-A receptors are ion channels.GABA-B receptors are G-protein-coupled signal transducers.</rdfs:comment>
        <rdfs:label>γ-aminobutyric acid receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11575"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11577 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11577">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glutamate receptor in the central nervous system activated by the synthetic glutamate analog, AMPA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>AMPA Receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11578 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11578">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Partial or total, transient or permanent loss of memory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>amnesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11579 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11579">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human illness caused by consumption of the marine toxin domoic acid that may lead to dizziness, confusion, motor weakness and seizures, with permanent cognitive impairment and short term memory loss.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ASP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Domoic acid is produced by marine diatoms belonging to the genus Pseudo-nitzschia and the species Nitzschia navis-varingica. Domoic acid is passed on to humans by consumption of bivalve shellfish (mollusks) such as mussels, oysters, and clams that have accumulated it during filter feeding.</rdfs:comment>
        <rdfs:comment>Often characterized by excitotoxicity and loss of hippocampal neurons.</rdfs:comment>
        <rdfs:label>amnesic shellfish poisoning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11722"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11766"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11579"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ASP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11580 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11580">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Brain nucleus located in the median temporal lobe that is part of the limbic system and plays an important role in emotional responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>amygdala</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11852"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12125"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11581 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11581">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extracellular aggregate of misfolded fibrous proteins, typically with cross-linked $\ce{\upbeta\!\mbox{-}sheet}$ structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>amyloid</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Amyloid occurs naturally with aging, but it is found in increased amounts in a number of tissue pathologies including Alzheimer disease.</rdfs:comment>
        <rdfs:label>β-amyloid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11582"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11878"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11582 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11582">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure representing extracellular deposition of $\ce{\upbeta\!\mbox{-}amyloid protein}$ in the gray matter of the brain that occurs with aging and in increased amount in Alzheimer disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neuritic plaque</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>senile plaque</oboInOwl:hasRelatedSynonym>
        <rdfs:label>amyloid plaque</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11581"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11583 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11583">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Debilitating degenerative disease of the motor neurons characterized by progressive muscle weakness, muscle atrophy and fasciculations, muscle spasticity, difficulty speaking (dysarthria), difficulty swallowing (dysphagia), and difficulty breathing (dyspnea).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Lou Gehrig’s disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>motor neuron disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>amyotrophic lateral sclerosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11731"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11737"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11769"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12083"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11584 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11584">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anything tending to reduce libido.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>anaphrodisiac</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11850"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11585 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11585">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that reduces the experience of pain with or without loss of consciousness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>anaesthetic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>anesthetic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11586 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11586">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiography of blood or lymph vessels, following the introduction of a radio-opaque substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Arteriography</oboInOwl:hasRelatedSynonym>
        <rdfs:label>angiography</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11587 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11587">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tough outer ring of an intervertebral disc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>annulus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11720"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11588 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11588">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Eating disorder characterized by self-imposed food restriction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>anorexia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11589"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11589 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11589">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Eating disorder characterized by obsessive desire to lose weight by reducing food intake or by repeated vomiting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>anorexia nervosa</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11588"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11590 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11590">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of the sense of smell, either total or selective.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>anosmia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11591 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11591">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to prevent or reduce the severity of convulsions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>anticonvulsant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11592 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11592">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to alleviate depression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>antidepressant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11711"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11593 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11593">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to prevent nausea and vomiting (emesis).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>antiemetic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11750"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11594 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11594">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to alleviate the pain of neuralgia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>antineuralgic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11595 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11595">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Blockage of the perception of pain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>antinociception</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11963"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11596 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11596">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Psychoactive substance used to manage psychotic behavior or psychotic ideation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>antipsychotic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12027"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12029"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11597 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11597">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to prevent muscle spasms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>antispasmodic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11598 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11598">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that reduces anxiety without causing excessive sedation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Most, if not all, anxiolytics show at least some degree of sedation.</rdfs:comment>
        <rdfs:label>anxiolytic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11599 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11599">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty with, or loss of the use of language in reading, writing or speaking owing to specific lesions in the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>aphasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11600"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11738"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11600 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11600">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of the voice.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>aphonia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11601 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11601">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anything that stimulates libido.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>aphrodisiac</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11850"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11602 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11602">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal breathing pattern consisting of a pause at full inspiration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>apneustic respiration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A prolonged inspiratory cramp is caused by a lesion in the brainstem.</rdfs:comment>
        <rdfs:label>apneusis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11699"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11603 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11603">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurological condition characterized by loss of the ability to perform skilled or purposeful movement that a person is nevertheless physically able and willing to do.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>apraxia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11604 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11604">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the arachnoid membrane, often characterized by perception of burning pain in the legs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>arachnoiditis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11605 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11605">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Terminal branching of a neuron into a treelike structure of the dendrites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>arborization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11606 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11606">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which there is an irregular or abnormal heart beat.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>arrhythmia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11607 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11607">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Communication in which blood is shunted from arterioles to venules without passing through capillaries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>arteriolovenular anastomosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11609"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11608 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11608">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to both arteries and veins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>AV</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Arteriovenous also refers to relations between arteries and veins, e.g., arteriovenous malformation, arteriovenous fistula, etc.</rdfs:comment>
        <rdfs:label>arteriovenous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11610"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11611"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11608"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11609 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11609">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Communication between an artery and a vein by collateral channels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>As the connection is generally between arterioles and venules, the term arteriolovenular anastomosis is preferred.</rdfs:comment>
        <rdfs:label>arteriovenous anastomosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11607"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11610 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11610">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal communication between an artery and a vein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>arteriovenous fistula</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11611 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11611">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Web of blood vessels with one or more abnormal communications between arteries and veins that bypass the capillary system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>AVM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>They may cause hemorrhage, seizures, headaches, paralysis or loss of speech, memory or vision.</rdfs:comment>
        <rdfs:label>arteriovenous malformation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11806"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11611"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AVM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11612 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11612">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Avoidance test in which the test animal has learned to develop an association between the stimulus and the delivery of an aversive event.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>associative avoidance test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11613 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11613">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which a new behavior arises as a consequence of association with a particular stimulus, sometimes restricted to learning through classical conditioning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>associative learning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11687"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11614 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11614">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glial cell of ectodermal origin in the central nervous system, characterized by filamentous protoplasmic extensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>astrocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11615 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11615">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Astrocyte that, after injury or excessive neural activity, undergoes morphological (including extension of pseudopodia) and biochemical (notably increased synthesis of glial fibrillary acidic protein) changes and participates in astrocytic scar formation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>reactive astrocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11616"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11787"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11616 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11616">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clustering of reactive astrocytes separating a localized brain injury from surrounding uninjured tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>glial scar</oboInOwl:hasRelatedSynonym>
        <rdfs:label>astrocytic scar</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11617 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11617">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tumor within the substance of the brain or spinal cord made up of astrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Astrocytomas are classified from Grade I (least aggressive) to Grade IV (most aggressive).</rdfs:comment>
        <rdfs:comment>This type of tumor does not usually spread outside the brain and spinal cord and it does not usually affect other organs.</rdfs:comment>
        <rdfs:label>astrocytoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11618 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11618">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Localized site of reactive astrocytes, distinct from an astrocytic scar.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>astrogliosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11616"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11619 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11619">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of muscular coordination (see motor coordination) resulting in abnormal clumsiness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ataxia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11884"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11620 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11620">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which inappropriate muscle contraction causes involuntary writhing movements.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>athetosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11621 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11621">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lacking muscular tone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>atony</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11622 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11622">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuropsychiatric disorder of childhood characterized by decreased attention span, impulsiveness and hyperactivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ADHD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hyperkinetic disorder</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Both genetic and environmental factors (such as lead exposure) are implicated in increased risk.</rdfs:comment>
        <rdfs:label>attention deficit hyperactivity disorder</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11622"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADHD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11623 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11623">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Constellation of symptoms experienced before a migraine headache or seizure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It may consist of flashing light, blurred vision, an odor, numbness, weakness, difficulty in speaking, or the feeling of a wind blowing.</rdfs:comment>
        <rdfs:label>aura</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11874"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11624 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11624">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurodevelopmental disorder, present from early childhood, characterized by great difficulty in communicating and forming relationships with other people and in using abstract concepts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is now considered part of a range of conditions (autism spectrum disorders) that includes Asperger syndrome, Rett syndrome, and childhood disintegrative disorder.</rdfs:comment>
        <rdfs:label>autism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11625 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11625">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the peripheral nervous system controlling the bodily functions that are not consciously directed, e.g., breathing, heart rate, and digestive processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ANS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autonomic nervous system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11625"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ANS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11626 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11626">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Associative learning pairing an adverse event with a non-specific stimulus such that the animal learns to respond in a manner to avoid the adverse event.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>avoidance test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11613"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11627 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11627">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Long thread-like process of a neuron along which impulses are conducted from the cell body to the nerve ending.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>axon</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11628 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11628">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progressive loss of structure and function of an axon, typically in a peripheral-to-central direction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>axonal degeneration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11629 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11629">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of organelles and biomolecules to (retrograde) and from (anterograde) a neuron’s cell body, within the cytoplasm of its axon (the axoplasm).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>axoplasmic transport</oboInOwl:hasRelatedSynonym>
        <rdfs:label>axonal transport</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11630 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11630">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Damage (peripheral neuropathy) to multiple nerves in roughly the same areas on both sides of the body, causing weakness, numbness, and paresthesia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This often occurs as a symmetrical polyneuropathy involving nerves in roughly the same areas on both sides of the body.</rdfs:comment>
        <rdfs:label>axonopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12014"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11631 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11631">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for catalepsy in which a mouse is placed on a bar oriented parallel to and approximately \(\pu{2.5 cm}\) off the ground. Typically, if the mouse remains immobile on the bar for more than 20 seconds, it is considered to be cataleptic.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The test can also be used for evaluating motor coordination.</rdfs:comment>
        <rdfs:label>bar test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12132"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11632 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11632">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Circular platform equipped with some 20 equidistant holes near the outer rim, one of which is marked by visual cues and is an escape hole for a rodent that is placed near the middle of the platform and subjected to an adverse stimulus, e.g., bright light.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Measured parameters include latency to escape, path length, number of errors, and velocity.</rdfs:comment>
        <rdfs:comment>The test is used to evaluate cognitive deficits.</rdfs:comment>
        <rdfs:label>Barnes maze</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11702"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11859"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11633 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11633">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Range of scores on play tasks performed by infants age 0–3 years, intended to assess development of motor, cognitive, and language skills against norms for age-matched normal child development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Bayley scales of infant development (BSID)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Bayley scale</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11634 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11634">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Focal bead-like swellings in dendrites and axons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neuritic beading</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These swellings can be an early neuropathological sign in neuronal injury, e.g., in epilepsy, trauma, ischemia, aging, and neurodegenerative diseases.</rdfs:comment>
        <rdfs:label>beading</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11635 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11635">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assessment of the ability of an animal to remain upright and to walk on an elevated and relatively narrow beam.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Unilateral brain injury tends to induce a hemiparesis-like effect which can cause the animal to slip to one side, usually that which is contralateral to the injury site.</rdfs:comment>
        <rdfs:label>beam walking test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11995"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11636 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11636">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which patterns on cards are memorized by a test subject who then attempts to recognize them on other cards presented subsequently.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Benton visual memory test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Test conditions have repeatedly been modified, and variations such as asking the subject to redraw the pattern are in use.</rdfs:comment>
        <rdfs:comment>The test measures short-term visual memory.</rdfs:comment>
        <rdfs:label>Benton test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11637 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11637">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A water labyrinth, described by Biel (1940), where rodents are forced to swim until they find a small underwater platform that allows them to escape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The Cincinnati water maze is related to the Biel water maze.</rdfs:comment>
        <rdfs:comment>Used to study possible neurotoxic effects on spatial learning, memory and others.</rdfs:comment>
        <rdfs:label>Biel water maze</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11638 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11638">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Psychiatric illness characterized by mood shifts with periods of severe depressive illness and one or more episodes of exaggerated activity levels (manic behavior).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>manic-depressive disorder</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bipolar disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11639 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11639">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a class of drugs that targets the $\ce{\upbeta\!\mbox{-}adrenergic receptor}$, interferes with binding of adrenalin and other related substances to the receptor, and weakens their effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>β-adrenergic antagonist</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-adrenergic blocking agent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-adrenergic receptor antagonist</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-adrenoreceptor antagonist</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-antagonist</oboInOwl:hasRelatedSynonym>
        <rdfs:label>β-blocker</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11567"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11570"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11640 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11640">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Selectively permeable structure that restricts the exit of blood cells and many substances from the brain capillaries into the extracellular space of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It consists of a layer of tightly packed cells (chiefly endothelial cells and astrocytes) and basement membrane, continuous along the brain capillaries.</rdfs:comment>
        <rdfs:label>blood–brain barrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11641 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11641">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Functional restriction by cells of the choroid plexus of transit of substances from the cerebrospinal fluid into the extracellular space of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>blood–cerebrospinal fluid barrier</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11642 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11642">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Functional restriction of transit of substances from the blood to the retina by non-fenestrated endothelial cells with tight junctions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>blood–retinal barrier</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11643 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11643">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which 60 pictures are shown to a subject who has to name them quickly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>BNT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The BNT is a neuropsychological test and is used to study brain function and learning disabilities in children.</rdfs:comment>
        <rdfs:label>Boston naming test</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11643"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BNT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11644 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11644">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bundle of nerve fibers that begins in the spine at the base of the neck, travels through the axilla (armpit region), and into the arm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Damage to these motor and sensory nerves affects muscle function and sensation in the arm and chest.</rdfs:comment>
        <rdfs:label>brachial plexus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11912"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11645 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11645">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally slow heart rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>bradycardia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12117"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11646 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11646">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally slow body movement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>hypokinesia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bradykinesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11647 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11647">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>That part of the central nervous system contained within the cranium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>brain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11648 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11648">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein secreted by the brain that acts on neurons in the central and peripheral nervous systems; a member of the neurotrophin family of growth factors, related to the nerve growth factor (NGF).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>BDNF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is also secreted by contracting skeletal muscle and can be classified as a myokine.</rdfs:comment>
        <rdfs:label>brain-derived neurotrophic factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11648"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BDNF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11649 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11649">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of part of the brain across structures within the skull such as a shift across such structures as the falx cerebri, the tentorium cerebelli, and even sometimes through the foramen magnum in the base of the skull (through which the spinal cord connects with the brain).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This is caused by high intracranial pressure and may have fatal results.</rdfs:comment>
        <rdfs:label>brain herniation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11768"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11650 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11650">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slice of brain tissue immersed in artificial cerebrospinal fluid, used in electrophysiology experiments to allow study of a synapse or neural circuit in isolation from the rest of the brain, and in metabolic studies, under controlled physiological conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>brain slice</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11651 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11651">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unpaired subdivision of the brain, continuous with the spinal cord, that includes the thalamus, hypothalamus, pons, medulla oblongata, and the mesencephalon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>brainstem</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11652 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11652">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region in the frontal lobe of one of the hemispheres (the speech-dominant hemisphere, usually the left) of the hominid brain that is involved in motor functions of speech production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Broca speech area</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Destruction of the Broca area results in a characteristic type of aphasia.</rdfs:comment>
        <rdfs:label>Broca area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11599"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11653 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11653">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary habitual grinding of the teeth, frequently during sleep.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>bruxism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11654 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11654">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Medical intervention in which a hole is drilled or scraped into the human skull, exposing the dura mater, to gain access during surgery, to relieve intracranial pressure, to evacuate a subdural hematoma, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>trepanning</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trephination</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trephining</oboInOwl:hasRelatedSynonym>
        <rdfs:label>burr hole surgery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11727"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11655 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11655">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme, found mainly in the liver, that hydrolyzes choline esters; it is non-specific and distinct from acetylcholinesterase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>plasma cholinesterase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pseudocholinesterase</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Measurement of plasma cholinesterase activity mainly reflects butyrylcholinesterase activity, although the inhibitory action of many neurotoxic substances on the two enzymes acetyl- and butyrylcholinesterase, is correlated.</rdfs:comment>
        <rdfs:label>butyrylcholinesterase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11558"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11656 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11656">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pyramidal neuron located in the cornu ammonis area 1, in the hippocampus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>CA1-pyramidal cells provide an output pathway from the hippocampus involved in long-term learning and memory.</rdfs:comment>
        <rdfs:comment>They are more susceptible to ischemia and hypoxia than the neighbouring CA3-pyramidal cells.</rdfs:comment>
        <rdfs:label>CA1-pyramidal cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11657"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11694"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11657 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11657">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pyramidal neuron located in the cornu ammonis area 3, in the hippocampus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It receives information from neurons of the dentate gyrus and sends information to the CA1-pyramidal cells.</rdfs:comment>
        <rdfs:label>CA3-pyramidal cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11656"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11694"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11658 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11658">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nematode with a well defined small neural network and homologues of human neurotransmitters, used as a model organism for studying normal development as well as neurotoxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Neurotoxic endpoints studied in Caenorhabditis elegans include locomotion, reaction to touch and temperature-sensitivity.</rdfs:comment>
        <rdfs:label>&lt;i&gt;Caenorhabditis elegans&lt;/i&gt;</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11659 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11659">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which some common words are read aloud and the test subject is asked to recall as many of these as possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This neuropsychological test is used to assess the verbal memory.</rdfs:comment>
        <rdfs:label>california verbal learning test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11660 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11660">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malignant tumor of an epithelial cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11661 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11661">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of two paired large arteries on either side of the neck that supplies most of the cerebralhemisphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>carotid artery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11662 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11662">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Median nerve entrapment neuropathy that causes paresthesia, pain, and numbness due to compression of the nerve at the wrist in the carpal tunnel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>CTS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>carpel tunnel syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11967"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11662"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CTS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11663 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11663">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epidemic paralytic disease, mainly affecting women and children, occurring in remote rural areas of African and Latin American countries, where cassava root is an important food.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>konzo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mantakassa</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is associated with many weeks of consumption of &quot;bitter&quot; (high cyanide) cassava that has not been adequately treated to remove the cyanide.</rdfs:comment>
        <rdfs:label>cassavism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11664 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11664">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bundle of long spinal nerve roots arising from the end of the spinal cord and filling the lower part of the spinal canal (from approximately the thoraco-lumbar junction downwards).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>These nerves contribute to the innervation of the pelvic organs and lower limbs to include motor innervation of the hips, knees, ankles, feet, and internal and external anal sphincter. In addition, the cauda equina extends to sensory innervation of the perineum and, partially, parasympathetic innervation of the bladder.</rdfs:comment>
        <rdfs:label>cauda equina</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11915"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11665 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11665">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crescent-shaped mass of gray matter forming part of the corpus striatum and part of the basal ganglia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>caudatum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>caudate nucleus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11698"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11666 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11666">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In or relating to the head.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cephalic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11667 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11667">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Family of lipid molecules, each one composed of sphingosine and a fatty acid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Ceramides are lipids making up sphingomyelin, one of the major components of the lipid bilayer.</rdfs:comment>
        <rdfs:label>ceramide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12085"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12086"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11668 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11668">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal protrusion of a portion of the cerebellum through the foramen magnum of the skull.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cerebellar tonsillar herniation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11669 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11669">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lower part of the brain that is beneath the posterior portion of the cerebrum, regulating the unconscious coordination of movement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cerebellum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11829"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11670 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11670">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a group of glycosphingolipids called monoglycosylceramides which are important components in animal nerve and muscle cell membranes and the myelin sheath.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cerebroside</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11671 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11671">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Principal part of the brain in vertebrates, located frontwards in the skull, consisting of the two hemispheres of the cerebral cortex separated by a fissure, and certain subcortical structures such as the hippocampus, basal ganglia, and the olfactory bulb.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cerebrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11672 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11672">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the spine immediately inferior to the skull and connecting to the thoracic spine, made up of seven vertebrae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cervical spine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12136"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11673 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11673">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of seven vertebrae that provide strength and structure to the cervical spine and support the head, allowing for its rotation and flexion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cervical vertebra</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11672"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11674 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11674">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to or denoting a nerve that liberates acetylcholine at a synapse upon receiving an appropriate nerve impulse; in particular referring to parasympathetic nerve fibers. Relating to or denoting an agent that mimics or enhances the activity of acetylcholine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cholinergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11568"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11675 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11675">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having an action similar to acetylcholine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cholinomimetic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11994"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11676 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11676">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurological disorder characterized by rapid, jerky involuntary movements affecting especially the limbs or facial muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>choreia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chorea</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11677 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11677">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence of involuntary movements in a combination of chorea and athetosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>choreoathetosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11676"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11678 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11678">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disintegration of nuclear chromatin. Disintegration of Nissl bodies following neuronal injury.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>chromatolysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11962"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11679 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11679">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Constellation of neurological symptoms that may include polyneuropathies, encephalopathy, memory loss, attention deficit and dementia following long-term exposure, often occupational, to organic solvents found in paints, glues, and other industrial products.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>CSE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>organic solvent syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>toxic solvent syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chronic solvent-induced encephalopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11752"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11943"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11679"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CSE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11680 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11680">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Food-borne illness caused by ingesting fish containing ciguatera toxins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Ciguatera toxins tend to accumulate in predator fish, such as the barracuda and other carnivorous reef fish, after eating other fish that consume toxin-producing algae (dinoflagellates) living in coral reef waters. Ciguatera toxins are harmless to fish but poisonous to humans.</rdfs:comment>
        <rdfs:comment>The toxins are heat-resistant, and cooking does not destroy them.</rdfs:comment>
        <rdfs:label>ciguatera poisoning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11681 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11681">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intrinsic smooth muscle of the eye that contracts to cause the lens to thicken, allowing accommodation to near vision.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ciliary muscle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11682 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11682">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polypeptide hormone and nerve growth factor that promotes neurotransmitter synthesis and neurite outgrowth in certain neural populations including astrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ciliary neurotrophic factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11922"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11683 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11683">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Alternate involuntary muscular contraction and relaxation in rapid succession. Continuous rhythmic reflex tremor initiated by the spinal cord below an area of spinal cord injury, set in motion by reflex testing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>clonus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11684 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11684">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sum of the mental processes by which sensory input is stored, recovered, and used by the consciousbrain, including attention, memory, language usage, learning, reasoning, problem solving, and decision making.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It usually refers to human information processing, but is sometimes used to describe learning and memory in rodents.</rdfs:comment>
        <rdfs:label>cognition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11685 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11685">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of profound unconsciousness lasting more than several hours in which one cannot respond to stimuli and from which one cannot be roused.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>coma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11686 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11686">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental procedure in which an adverse effect (e.g., foot shock, drug withdrawal) is delivered to rats or mice after presentation of a cue (e.g., light or sound); the rodents are trained to avoid rather than escape the shock after the start of its delivery.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>CAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAR Test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>conditioned avoidance response test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11702"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11687 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11687">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Learning in which a behavior comes to be elicited as a reflex response by association with a neutral antecedent stimulus through repetition of the stimulus-response pairing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Pavlovian conditioning</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>respondent conditioning</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The neutral antecedent stimulus such as the ringing of a bell is repetitively paired with an unconditioned stimulus such as food to elicit a response such as salivation.</rdfs:comment>
        <rdfs:label>classical conditioning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12095"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12096"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11688 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11688">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Learning in which appropriate behavior is rewarded, or inappropriate behavior is punished; behavior is modified by learned association with antecedents and consequences.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>instrumental conditioning</oboInOwl:hasRelatedSynonym>
        <rdfs:label>operant conditioning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12046"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11689 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11689">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mental state of bewilderment or disorientation in which reactions to environmental stimuli may be inappropriate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>confusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11690 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11690">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aware of and responding to one’s surroundings.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>conscious</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11691 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11691">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of several available neuropsychological procedures that measure a person’s sustained attention.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>CPT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An example of a CPT is the computer-administered Conners’ test, where, in one version, the test subject is asked to click the spacebar when presented any letter except the letter &quot;X&quot; with 360 presentations over a 14-minute period.</rdfs:comment>
        <rdfs:comment>Continuous performance tests are often used in evaluating children with suspected attention deficit hyperactivity disorder.</rdfs:comment>
        <rdfs:label>continuous performance test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11622"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11691"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CPT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11692 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11692">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Persistent shortening and tightening of muscle, tendon, or other tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>contraction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>contracture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11693 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11693">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any material (usually opaque to X-rays) employed to delineate or define a structure during a radiologic procedure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>contrast medium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11694 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11694">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the hippocampus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cornu ammonis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11695 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11695">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vertical (longitudinal) plane dividing the body into ventral and dorsal (front and back) sections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>coronal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11696 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11696">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transverse junction in the skull separating the frontal bone from the parietal bones.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>coronal suture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11697 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11697">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bundle of myelin-enriched neural fibers beneath the cortex connecting the two hemispheres of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>corpus callosum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11698 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11698">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Striatum together with the globus pallidus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>corpus striatum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12097"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11699 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11699">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Painful muscle spasm caused by prolonged tetanic contraction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cramp</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11700 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11700">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Each of 12 pairs of nerves that arise directly from the brain, not from the spinal cord, and pass through separate apertures in the skull.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cranial nerve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11701 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11701">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital tumor arising from the pituitary gland in the embryonic tissue between the brain and pharynx.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>As the specific cells from which the tumor arises also contribute to tooth formation, the tumor will often show calcium deposits visible on X-rays.</rdfs:comment>
        <rdfs:label>craniopharyngioma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11702 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11702">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stimulus or associated feature of a stimulus that evokes a response or alerts the subject to a particular behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>cue</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11703 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11703">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of severe confusion, characterized by restlessness, hallucinations and hyperactivity, during which the person affected may be isolated from normal communication.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Delirium can result from drug or alcohol toxicity or withdrawal, infection, brain tumor, head injury, metabolic disturbances, etc.</rdfs:comment>
        <rdfs:label>delirium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11689"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11799"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11704 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11704">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serious loss of brain function in a previously unimpaired person, affecting memory, thinking, and behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It may be static as a result of brain injury, or progressive with long-term decline due to damage of disease.</rdfs:comment>
        <rdfs:label>dementia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11705 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11705">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dementia, often of the Alzheimer type (see Alzheimer disease) developing at or before age 65.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>presenile dementia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11706 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11706">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dementia, often of the Alzheimer type (see Alzheimer disease) developing after the age of 65.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>senile dementia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11707 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11707">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Destruction of the protective myelin sheath that surrounds nerve fibers, resulting in diminished function and decreased action potential in those nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>demyelinization</oboInOwl:hasRelatedSynonym>
        <rdfs:label>demyelination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11708 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11708">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrow strip of cerebral cortex associated with the hippocampus that continues forward to the uncus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is thought to contribute to the formation of new episodic memories, the spontaneous exploration of novel environments, and other functions.</rdfs:comment>
        <rdfs:label>dentate gyrus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12154"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11709 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11709">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Craving for or addiction to a substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>drug addiction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chemical dependency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11564"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11710 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11710">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relative reduction in the resting membrane potential of an excitable cell, generally making the inside less negative, or even positive with respect to the outside.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>depolarization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11764"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11711 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11711">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reduction in the activity of the central nervous system. Mental state or disorder characterized by feelings of sadness and despair.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>depression</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11712 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11712">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects of toxic substances on the development of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>developmental neurotoxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11713 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11713">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any examination that allows detection of substance-induced changes in the structural or functional integrity of the nervous system of a developing organism, fetus or child.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>DNT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>developmental neurotoxicity testing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11713"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DNT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11714 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11714">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n. Substance inducing perspiration. adj. Of a human, sweating heavily.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>sudorific</oboInOwl:hasRelatedSynonym>
        <rdfs:label>diaphoretic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11715 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11715">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serious illness characterized primarily by diarrhea with rapid onset and resolution after \(\pu{24 h}\) that is a consequence of consumption of bivalve shellfish (mollusks) such as mussels, oysters, and clams that have ingested, by filter feeding, large quantities of dinoflagellates containing a group of high-molecular-weight structures with multiple ether linkages, such as okadaic acid, dinophysis toxins, pectenotoxins, and yessotoxin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>DSP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>diarrhetic shellfish poisoning (DSP)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>diarrheal shellfish poisoning</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11715"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11716 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11716">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a cell is committed to a lineage and becomes more specialized in structure and function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>differentiation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11717 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11717">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test of memory in which numbers (series of digits) are presented orally or on a computer screen to a test subject who is asked to repeat each number from memory; the numbers increase in length until mistakes are made.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>digit span task</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the backward digit span task the presented numbers must be recalled in reverse order.</rdfs:comment>
        <rdfs:label>digit span test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11718 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11718">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuropsychological assessment in which the top two rows of a test sheet function as a key, displaying numbers 1–9 (upper row) matched to &apos;non-sense&apos; symbols (lower row). There follow pairs of rows where the numbers 1–9 appear in irregular sequence and the test subject must match the correct symbol from the key to each number, as quickly as possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>DSST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>digit symbol test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is a subtest of some intelligence tests.</rdfs:comment>
        <rdfs:comment>The test is used to assess brain damage, dementia and depression.</rdfs:comment>
        <rdfs:label>digit symbol substitution test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11711"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11835"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11718"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DSST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11719 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11719">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simultaneous perception of two images of a single object.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>double vision</oboInOwl:hasRelatedSynonym>
        <rdfs:label>diplopia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11720 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11720">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Flat circular structure, consisting of a tough, fibrous exterior and a gelatinous core, interposed between adjacent vertebrae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>spinal disc</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intervertebral disc</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11721 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11721">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of sense of direction. In clinical assessment, lack of awareness of one’s identity, present location, or the current day and time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>disorientation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11722 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11722">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurotoxickainic acid analog produced by some algal blooms that causes amnesic shellfish poisoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>(2S,3S,4S)-4-[(2Z,4E,6R)-6-carboxy-6-methylhexa-2,4-dien-2-yl]-3-(carboxymethyl)pyrrolidine-2-carboxylic acid</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Domoic acid is produced by the red alga called doumoi in Japan (Chondria armatasome), diatoms of the genus Pseudo-nitzschia, and by some strains of the diatom species Nitzschia navis-varingica.</rdfs:comment>
        <rdfs:comment>Filter-feeding shellfish become contaminated from trapping and eating these algae.</rdfs:comment>
        <rdfs:label>domoic acid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11579"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11842"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11723 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11723">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring substance functioning as a neurotransmitter in the sympathetic nervous system, and a metabolic precursor of other substances including adrenalin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>4-(2-aminoethyl)benzene-1,2-diol</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It has an inhibitory effect on movement and its depletion in the brain produces the symptoms of rigidity, tremors, and bradykinesia that are characteristic of Parkinson disease.</rdfs:comment>
        <rdfs:label>dopamine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11567"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11646"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12107"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12149"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11724 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11724">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to a nerve that releases or responds to dopamine as a neurotransmitter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dopaminergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11723"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11725 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11725">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outgrowth of a spinal nerve that carries sensory signals to an appropriate integration center in the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>posterior root of spinal nerve</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dorsal root</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11726 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11726">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nodule on a dorsal root of the spine that consists of afferent sensory neuronal cell bodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dorsal root ganglion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11571"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11725"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11727 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11727">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outermost and most fibrous of the three membranes of the meninges (see meninx) covering the brain and the spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dura mater</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11728 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11728">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein associated with motile structures that exhibits adenosine triphosphatase activity; it forms &apos;arms&apos; on the outer microtubules of cilia and flagella and functions as a molecular motor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Dyneins are involved in axonal transport and are targets of various neurotoxic substances.</rdfs:comment>
        <rdfs:label>dynein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11629"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11729 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11729">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a class of opioid peptides that arise from the precursor protein prodynorphin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Depolarization of a neuron containing prodynorphin stimulates PC2 processing, which occurs within synaptic vesicles in the presynaptic terminal.</rdfs:comment>
        <rdfs:comment>When prodynorphin is cleaved during processing by proprotein convertase 2 (PC2), multiple active peptides are released: dynorphin A, dynorphin B, and α/β-neo-endorphin.</rdfs:comment>
        <rdfs:label>dynorphin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11730 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11730">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Impairment of the sense of touch.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dysaphia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11731 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11731">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty in speech owing to disturbances of muscular control resulting from central or peripheral nervous system damage or emotional stress.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dysarthria</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11732 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11732">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which a disagreeable sensation, especially of touch, is produced following damage to peripheral or central sensory pathways. Abnormal sensation experienced in the absence of stimulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dysesthesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11733 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11733">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty in writing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dysgraphia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11734 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11734">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty or abnormality in voluntary movement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dyskinesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11735 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11735">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary, repetitive body movement of slow onset.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>May be induced by drugs such as chlorpromazine.</rdfs:comment>
        <rdfs:label>tardive dyskinesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11736 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11736">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Impairment in appreciation of spatial relations, often leading to difficulty in reading.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dyslexia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11737 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11737">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty in swallowing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dysphagia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11738 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11738">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difficulty in the use of language owing to a brain lesion, without mental impairment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dysphasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11599"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11739 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11739">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Over-activity of the autonomic nervous system causing an abrupt onset of excessively high blood pressure, tachycardia, and constriction of peripheral blood vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>AD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autonomic dysreflexia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11819"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12117"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11740 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11740">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of abnormal (either hypo- or hypertonic) muscle tone resulting in impairment of voluntary movement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>dystonia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11741 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11741">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Carrying outward; of nerves, those that conduct impulses outward from the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>efferent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11571"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11742 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11742">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Therapeutic intervention in which seizures are electrically induced in patients with the aim of providing relief from a specific mental illness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ECT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>electroshock therapy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electroconvulsive therapy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11742"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ECT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11743 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11743">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test or record of brain electrical activity detected by electroencephalography.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>electroencephalogram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11744"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11744 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11744">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recording of electrical activity from different parts of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>EEG</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electroencephalography</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11744"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EEG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11745 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11745">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recording of the electrical activity of muscle, or its representation as a visual display or audible signal, using electrodes attached to the skin or inserted into a muscle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>EMG</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electromyography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11745"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EMG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11746 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11746">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-invasive method used to examine the integrity and conductivity of a peripheral nerve, in which a brief electrical stimulation is given to the nerve at one point, while at the same time the induced electrical activity (compound action potentials) is recorded at another point of the nerve’s distribution and the interval is displayed on a video monitor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>electroneurography</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11747 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11747">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the electrical properties of cells and tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>electrophysiology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11748 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11748">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recording, with electrodes placed on the cornea or nearby skin, of the electrical activity of photoreceptors and other retinal cells in response to standardized, patterned stimuli with light and colour.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ERG</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electroretinogram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12009"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11748"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ERG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11749 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11749">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stage with four orthogonal side arms elevated above the floor, where two opposite arms have sidewalls and the other two arms have no walls; used as research tool for anxiety.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Rodents normally preferentially avoid the arms without walls, but during anxiolytic treatment they tend to spend more time on them, or enter them more often.</rdfs:comment>
        <rdfs:label>elevated plus maze</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11598"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11750 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11750">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vomiting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>emesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11751 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11751">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n. Substance that produces vomiting. adj. Producing vomiting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>emetic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11752 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11752">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any disorder of the brain that affects its functioning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Common causes include trauma, infection, liver failure, anoxia, kidney failure, or exposure to a neurotoxin.</rdfs:comment>
        <rdfs:label>encephalopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11952"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11753 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11753">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exogenous chemical that alters function(s) of the endocrine system and consequently causes adverse health effects in an intact organism, its progeny, or (sub)populations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>endocrine modifier</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Adverse effects include those on neurodevelopment.</rdfs:comment>
        <rdfs:label>endocrine disruptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11754 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11754">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several peptides (including the enkephalins) that activates the body’s opiate receptors, causing an analgesic effect; literally, endogenous morphine-like substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>endorphin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11755"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11974"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11755 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11755">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Either of two endogenous pentapeptides with opiate-like effects that are especially involved in modulating pain responses in the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>enkephalin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11756 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11756">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glial cells that line the cavities within the brain’sventricles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ependymal tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11757 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11757">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Growth in the brain or spinal cord arising from ependymal tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Because cerebrospinal fluid normally flows through the ependymal tissue-lined ventricles, blockage due to an ependymoma can cause build up of fluid, increased intracranial pressure, and hydrocephalus.</rdfs:comment>
        <rdfs:label>ependymoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11756"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11758 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11758">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immediately outside the dura mater.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>extradural</oboInOwl:hasRelatedSynonym>
        <rdfs:label>epidural</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11759 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11759">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dorsal part of the diencephalon, including the pineal gland and adjacent structures in the roof of the third ventricle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>epithalamus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11760 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11760">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Poisoning produced by eating food affected by ergot (ergotamine alkaloids), substances produced by the fungus Claviceps purpurea that contaminate rye and wheat.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>St Anthony’s fire</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ignis infernalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ignis sacer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Ergotism typically results in hallucinations, headache, vomiting, diarrhea, a painful burning sensation in the limbs and extremities, and gangrene of the fingers and toes.</rdfs:comment>
        <rdfs:label>ergotism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11799"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11761 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11761">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characterized by or feeling intense excitement and happiness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>euphoria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11762 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11762">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrical potential that is triggered by presentation of a stimulus (somatosensory, auditory, visual) and measured with electrodes near the nerve or near the brain region in which the signal is processed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Speed, amplitude and location of the evoked potential provide information about the intactness of the response.</rdfs:comment>
        <rdfs:label>evoked potential</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11763 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11763">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrical potential recorded from the nervous system following exposure to a stimulus, as distinct from spontaneous potentials detected by electroencephalography, electromyography, or other electrophysiological recording methods.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>evoked response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11744"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11762"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11764 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11764">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell that can be stimulated to create an electric current; muscle fibers and nerve cells are excitable (see excitation).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>excitable cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11765 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11765">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to a more positive membrane potential at the postsynaptic side of the synaptic cleft that renders the postsynaptic neuron more likely to generate an action potential.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>EPSP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>EPSP’s are commonly produced by excitatory neurotransmitters such as glutamate.</rdfs:comment>
        <rdfs:comment>Postsynaptic electrical activity is in part a function of the balance of EPSP’s and inhibitory post-synaptic potentials.</rdfs:comment>
        <rdfs:label>excitatory post-synaptic potential</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12110"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11765"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EPSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11766 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11766">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological process by which neurons are damaged and killed by the overactivation of receptors for the excitatory neurotransmitter glutamate, such as the N-methyl-D-aspartic acid (NMDA) receptor and the 2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid (AMPA) receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Excitotoxins like NMDA and kainic acid bind to glutamate receptors, and can cause excitotoxicity by allowing high levels of calcium ions to enter cells, activating enzymes such as phospholipases, endonucleases, and proteases such as calpain, which damage cell structures, including the cytoskeleton, membranes, and DNA.</rdfs:comment>
        <rdfs:label>excitotoxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11577"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11842"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11869"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11767 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11767">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neural facilitation: Increase in postsynaptic excitation as a result of very rapid firing of action potentials by a presynaptic neuron. Presynaptic facilitation: Increase of presynaptic excitation when an excited neuron receives additional excitatory impulses from other neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>facilitation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11768 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11768">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Continuation of dura mater between the right and left hemispheres of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>falx cerebri</oboInOwl:hasRelatedSynonym>
        <rdfs:label>falx</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11769 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11769">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary contractions, or twitchings, of groups (fasciculi) of muscle fibers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This is a coarser form of repetitive muscular contraction than fibrillation.</rdfs:comment>
        <rdfs:label>fasciculation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11770"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11770 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11770">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rapid contractions or twitching of muscle fibrils, but not of the muscle as a whole.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The term is commonly used for atrial fibrillation, where the muscles of the cardiac atrium show the phenomenon, leading to loss of normal rhythmic contraction, and also for loss of synchronized contraction of the ventricles, i.e., ventricular fibrillation.</rdfs:comment>
        <rdfs:label>fibrillation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11769"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11771 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11771">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a test subject is asked to tap a finger at maximal rate on a surface, a higher rate of tapping indicating better neuromuscular function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>tapping test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>finger tapping test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11772 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11772">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relaxed, flabby, or without tone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Curare causes flaccid paralysis by binding to acetylcholine receptors and inhibiting their action.</rdfs:comment>
        <rdfs:comment>Flaccid paralysis is a condition where one or more muscles are without tone. It is often caused by the lack of motor nerve impulses due to nerve trauma, disease or specific pharmaceuticals.</rdfs:comment>
        <rdfs:label>flaccid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11773 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11773">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Most anterior of the four major lobes of each cerebral hemisphere, containing the primary motor cortex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>frontal lobe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11854"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11885"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurodegenerative disease characterized by progressive neuronal defects in the frontal and temporal lobes of the brain, leading to dementia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>FTD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>frontotemporal lobular degeneration (FTLD)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>frontotemporal dementia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12125"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11774"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FTD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In the brain, referring to the concept that discrete regions are involved in specific aspects of cognitive function, thus giving rise to modularity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>A competing theory, distributive processing, holds that cognition involves more interaction of brain regions.</rdfs:comment>
        <rdfs:label>functional domain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structured set of tests to examine changes in neuromuscular, arousal, autonomic and sensory functions that assesses the presence, absence or severity of specific neurological signs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Usually performed in rodents after exposing them to potentially neurotoxic substances.</rdfs:comment>
        <rdfs:label>functional observational battery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11777 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11777">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nuclear DNA- and RNA-binding protein involved in transcription, splicing, and RNA-transport.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>FUS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FUS transcription factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mutation in the FUS gene is believed to have a role in several neurodegenerative diseases.</rdfs:comment>
        <rdfs:label>fused in sarcoma transcription factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11777"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FUS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the action of $\ce{\upgamma\!\mbox{-}aminobutyric acid}$ or to neural or metabolic pathways in which it functions as a neurotransmitter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>GABAergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11575"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cluster of nerve cell bodies located outside the brain and spinal cord, i.e., in the peripheral nervous system.Note: Ganglia interconnect to form a complex network known as a plexus and serve as relay stations where different neurons can modulate the signals of each other. Compare: basal ganglion. Fibrous cyst usually attached to a tendon sheath.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ganglion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11780 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11780">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuron located in a ganglion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Included are cells in the ganglion cell layer of the retina, cells of the sympathetic nervous system in the adrenal medulla, cells in sympathetic and parasympathetic ganglia, and cells in the spiral (cochlear) ganglion involved in hearing.</rdfs:comment>
        <rdfs:label>ganglion cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12107"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11781 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11781">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glycosphingolipid chemically similar to cerebrosides but containing one or more sialic (N-acetylneuraminic or N-glycolylneuraminic) acid residues, found principally in nerve tissue, spleen, and thymus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Accumulation can be associated with disease. Ganglioside GM1 accumulates in generalized gangliosidosis; GM2 accumulates in Tay–Sachs disease.</rdfs:comment>
        <rdfs:label>ganglioside</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11670"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11782 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11782">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Very large axon (typically \(\pu{0.5 mm}\) in diameter) that functions in the propulsion system of the squid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>squid giant axon</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The large size of the axon has facilitated studies on the mechanism of the action potential.</rdfs:comment>
        <rdfs:label>giant axon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11783 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11783">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare human genetic neurological disorder in which the neurofilaments become disordered, resulting in abnormal size and shape of neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>giant axonal neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11931"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11784 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11784">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-neuronal cellular elements of the central and peripheral nervous system having metabolic and support functions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neuroglia</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the central nervous system, the glia include oligodendroglia, astrocytes, ependymal cells, and microglia cells. In the peripheral nervous system they include ganglion satellite cells and Schwann cells.</rdfs:comment>
        <rdfs:label>glia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11756"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11872"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12064"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11785 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11785">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cellular component of the glia, including oligodendroglial cells, astrocytes, ependymal cells and microglial cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>glial cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11756"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11784"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11872"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11786 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11786">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein that promotes and guides the growth of neurons and facilitates the survival of mature neurons by suppressing cell death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>GDNF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>glial-derived neurotrophic factor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11786"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GDNF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11787 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11787">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytoskeletal intermediate filament protein found in mature fibrillary astrocytes and in neural progenitor cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>GFAP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>GFAP staining does not reveal the full distal arborization of the cell.</rdfs:comment>
        <rdfs:comment>Stains for GFAP are frequently used in the differential diagnosis of neurologic lesions.</rdfs:comment>
        <rdfs:label>glial fibrillary acidic protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11605"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11787"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GFAP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11788 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11788">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glioma consisting chiefly of undifferentiated anaplastic cells of astrocytic origin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>glioblastoma multiforme</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These neoplasms grow rapidly, invade extensively, and occur most frequently in the cerebrum of adults.</rdfs:comment>
        <rdfs:label>glioblastoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11616"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11789"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11789 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11789">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neoplasm originating from any of the glia cells in the brain and spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is the predominant form of malignant brain tumor.</rdfs:comment>
        <rdfs:label>glioma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11790 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11790">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Damage-induced proliferation, enlargement and overgrowth of glial cells, often astrocytes in the central nervous system, resulting in an astrocytic scar.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>reactive gliosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11616"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11791 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11791">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glycosphingolipid, specifically a ceramide tetrasaccharide (tetraglycosylceramide), isolated from kidney and erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It accumulates in people with Sandhoff disease.</rdfs:comment>
        <rdfs:label>globoside</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11667"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11792 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11792">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Salt of glutamic acid (2-aminopentanedioic acid).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Glutamate is a major excitatory neurotransmitter in the vertebrate nervous system.</rdfs:comment>
        <rdfs:comment>Monosodium glutamate (MSG) is commonly used in the food industry as a flavor enhancer, and at high doses has given rise to reported feelings of headache and discomfort.</rdfs:comment>
        <rdfs:label>glutamate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11793 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11793">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of excitotoxicity where excess glutamate release in synapses (glutamatergic storm) leads to overstimulation, followed by excess cellular calcium uptake, cytotoxicity and apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Excitotoxicity may occur after acute neuronalischemia and damage. It is believed to be a factor in chronic diseases of the nervous system, and in some withdrawal phenomena.</rdfs:comment>
        <rdfs:comment>N-methyl-D-aspartic acid, kainic acid, and other ligands of the glutamate receptor induce this effect.</rdfs:comment>
        <rdfs:label>glutamate-induced excitotoxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11842"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11869"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11794 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11794">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of silver staining of histological sections of tissue from the nervous system, in which a limited number of neurons stain in their entirety upon formation of microcrystals of silver chromate, thus allowing visualization in the light microscope of some individual neurons in densely packed tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Golgi’s method</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Golgi staining</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12075"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11795 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11795">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Seven-transmembrane-domain receptor that interacts with guanosine triphosphate/diphosphate (GTP/GDP) binding proteins to initiate signal transduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>GPCR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>G protein-coupled receptor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11795"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GPCR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11796 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11796">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several types of neurons with small cell bodies, involved in neural networks in several regions of the brain, including the cerebellum, hippocampus, and cerebral cortex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Not to be confused with granular cells of the kidney.</rdfs:comment>
        <rdfs:comment>They give rise to the name granular layer within these regions.</rdfs:comment>
        <rdfs:label>granule cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11797 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11797">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of idiopathic polyneuritis in which autoimmunity to peripheral nerve, myelin leads to a condition characterized by chronic demyelination of the spinal roots (see spinal cord), peripheral nerves, and cranial nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>GBS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Guillain–Barré syndrome is often preceded by a respiratory or gastrointestinal infection and shows gradual but complete recovery in most cases.</rdfs:comment>
        <rdfs:label>Guillain–Barré syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11707"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12013"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11797"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GBS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11798 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11798">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease or cessation of a response to a stimulus after its repeated presentation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>habituation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11799 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11799">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The apparent, often strong, subjective perception of an external object or event when no such stimulus or situation is present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Hallucinations may be visual, auditory, olfactory, gustatory, or tactile.</rdfs:comment>
        <rdfs:label>hallucination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11800 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11800">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pain in one or more parts of the cranium, not confined to the area of distribution of any nerve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>headache</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11801 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11801">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Headache caused by stopping analgesics following their overuse to relieve headaches.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>rebound headache</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11802 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11802">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Headache associated with anxiety or other states of distress, associated with chronic contraction of the scalp muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tension headache</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11803 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11803">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of bleeding into a tissue or organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Hematoma of the brain is a common cause of stroke and is accompanied by potentially lethal increase of intracranial pressure and neuronal damage.</rdfs:comment>
        <rdfs:comment>Often a result of trauma, defective blood clotting or drugs that suppress blood clotting.</rdfs:comment>
        <rdfs:label>hematoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11804 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11804">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paralysis of one side of the body, including the arm, trunk and leg.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hemiplegia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11805 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11805">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cerebralhemisphere containing the representation of speech and controlling arm and leg preference in skilled movements.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Usually the left hemisphere.</rdfs:comment>
        <rdfs:label>dominant hemisphere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11806 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11806">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Copious escape of blood from a disrupted blood vessel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>When occurring in the brain, this is a hemorrhagic stroke.</rdfs:comment>
        <rdfs:label>hemorrhage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11807 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11807">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure using birds to study acute and delayed neurotoxicity, notably of organophosphates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>After exposure to the substance, the birds are closely observed with regard to motor activity, gait changes, motor coordination, and related parameters.</rdfs:comment>
        <rdfs:label>hen test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11883"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11884"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11979"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11808 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11808">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maintenance in vitro of fresh prepared slices of the hippocampus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Useful for many types of brain research including electrophysiological, biochemical and morphological measurements in studies of neurotoxicity.</rdfs:comment>
        <rdfs:comment>Vital cultures can be kept for weeks and maintain structure and neuronal functions (&quot;organotypic&quot;).</rdfs:comment>
        <rdfs:label>hippocampal slice culture</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11650"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11809 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11809">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bioactive metabolite produced in living organisms by deamination of the amino acid histidine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>2-(1H-imidazol-4-yl)ethanamine</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Histamine acts as a neurotransmitter in the brain. It also serves as a mediator in the regulation of various body functions such as gastric secretion, bronchial constriction, vasorelaxation, and local inflammation.</rdfs:comment>
        <rdfs:label>histamine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11830"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12066"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12160"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11810 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11810">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the action of histamine or to neural pathways in which it functions as a neurotransmitter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>histaminergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11809"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11811 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11811">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetic autosomal dominant neurodegenerative disease resulting from a mutation in the Huntingtin gene and resulting notably in decline of cognitive function and a characteristic chorea.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Huntington disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11676"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11812 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11812">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hydrocephalus where flow of cerebrospinal fluid is not blocked but there is failure of its reabsorption.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>communicating hydrocephalus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11813 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11813">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hydrocephalus where flow of the cerebrospinal fluid is blocked.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>obstructive hydrocephalus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11814 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11814">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological dilation of the spinal cord due to expansion of the cerebrospinal fluid-filled central canal of the cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hydromyelia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11815 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11815">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurotransmitter found in the digestive tract, platelets and central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>3-(2-aminoethyl)-1H-indol-5-ol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>5-HT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>serotonin</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the central nervous system, it influences mood, appetite and sleep.</rdfs:comment>
        <rdfs:label>5-hydroxytryptamine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11815"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>5-HT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11816 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11816">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally increased carbon dioxide concentration in the blood resulting in a increased rate and depth of breathing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Hypercapnia may result either from insufficient pulmonary respiration or from increased levels of carbon dioxide in the ambient air.</rdfs:comment>
        <rdfs:label>hypercapnia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11817 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11817">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excessive sensitivity to touch, pain, or other sensory stimuli.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hyperesthesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11818 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11818">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transient increase in membrane polarization of nerve cells or muscle cells; the opposite of depolarization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hyperpolarization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11861"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11819 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11819">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increased or exaggerated reflex response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hyperreflexia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11820 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11820">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extreme tension of the muscles or arteries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This is often a result of an upper motor neuron lesion in the brain, which is accompanied by decreased synaptic inhibition and increased excitability of muscle.</rdfs:comment>
        <rdfs:label>hypertonia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12111"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12155"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11821 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11821">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that may reduce anxiety and induces sleep.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hypnotic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12079"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11822 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11822">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally decreased carbon dioxide concentration in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>An increased respiratory rate during normal metabolic activity may cause hypocapnia that may be associated with spasms.</rdfs:comment>
        <rdfs:label>hypocapnia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11823 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11823">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surgical removal of the pituitary gland (hypophysis).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hypophysectomy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11824 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11824">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diminished reflex response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hyporeflexia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11825 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11825">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subnormal arterial blood pressure.Note: Hypotension can be a cause of dizziness, weakness and fainting. Lower than normal pressure or tension of any kind (used less commonly).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hypotension</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11826 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11826">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which there is a diminution or loss of muscle tone. Relaxation of the arteries. Lower than normal tension in any part, as in intraocular pressure of the eyeball.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>hypotonia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11827 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11827">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sudden attack, stroke or seizure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ictus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11828 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11828">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle in a cell, detectable under the light microscope.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Inclusion bodies often consist of aggregates of misfolded proteins and are often found in neurodegenerative diseases, such as the β-amyloid plaques in Alzheimer disease.</rdfs:comment>
        <rdfs:label>inclusion body</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11581"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11878"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11829 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11829">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the cerebellum that is important for a number of motor functions, including balance, position sensing and coordination of movement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>inferior cerebellar peduncle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11884"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11830 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11830">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction of the body to injury or to infectious, allergic, or chemical irritation; characterized by redness, swelling, heat, and pain resulting from dilation of the blood vessels accompanied by loss of plasma and leukocytes into the tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This process differs in the brain, where lymphocytic invasion requires compromise of the blood–brain barrier, although T-cells can enter the brain for surveillance.</rdfs:comment>
        <rdfs:label>inflammation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11936"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11831 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11831">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Below the tentorium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>infratentorial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11832 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11832">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to a more negative membrane potential at the postsynaptic side of the synaptic cleft that renders the postsynaptic neuron less likely to generate an action potential.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>IPSP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>IPSPs are commonly produced by inhibitory neurotransmitters such as γ-aminobutyric acid (GABA) and glycine.</rdfs:comment>
        <rdfs:comment>Postsynaptic electrical activity is in part a function of the balance of IPSPs and excitatory post-synaptic potentials (EPSPs).</rdfs:comment>
        <rdfs:label>inhibitory post-synaptic potential</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11575"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11765"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12110"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IPSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11833 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11833">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill insects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Insecticides commonly target the nervous system of insects.</rdfs:comment>
        <rdfs:label>insecticide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11834 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11834">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability to sleep during the period when sleep should normally occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>insomnia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11835 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11835">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Numeric measure of a person’s cognitive function based on one of several standardized tests of a problem-solving nature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>IQ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IQ test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Historically, test results have been prone to misuse in drawing invalid conclusions about differences in intelligence based on genetic background, gender or race, ignoring potentially confounding factors such as education, socioeconomic status and other environmental influences on test performance.</rdfs:comment>
        <rdfs:comment>The quotient is expressed as a ratio of the individual’s score to the median raw score of a sufficiently large reference population, the latter score taken as 100.</rdfs:comment>
        <rdfs:comment>The tests and numeric value are age-specific.</rdfs:comment>
        <rdfs:label>intelligence quotient</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11835"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IQ</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11836 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11836">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pressure within the cranial cavity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ICP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Even minor increases in ICP, e.g., due to intracranial bleeding, may cause serious damage to the brain.</rdfs:comment>
        <rdfs:comment>Increased ICP may result from increased volume of the cerebrospinal fluid.</rdfs:comment>
        <rdfs:label>intracranial pressure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11837 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11837">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Within a sheath, as within either the subarachnoid or the subdural space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>intrathecal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12100"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12102"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11838 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11838">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pore-forming transmembrane protein that can gate the transmembrane flux of small ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Both voltage-gated and ligand-gated channels promote electrical signals in neurons and muscle cells.</rdfs:comment>
        <rdfs:comment>Ion channels are generally involved in regulation of the electrical membrane potential and cell volume.</rdfs:comment>
        <rdfs:comment>Many of the known channels are susceptible to inhibition by specific neurotoxins.</rdfs:comment>
        <rdfs:label>ion channel</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11952"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11839 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11839">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuromuscular disease resulting from a genetic defect in an ion channel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Documented ion channelopathies include those arising from mutations in channels for \(\ce{Na+}\), \(\ce{K+}\), \(\ce{Cl-}\), and \(\ce{Ca^{2+}}\).</rdfs:comment>
        <rdfs:label>ion channelopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11840 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11840">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein that is expressed in several tissues, but in brain is a specific immunomarker for microglia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Iba-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>allograft inflammatory factor 1 (AIF-1)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Expression of Iba-1 is up-regulated upon activation of microglia, thus allowing identification of areas of brain injury or inflammation.</rdfs:comment>
        <rdfs:label>ionized calcium-binding adapter molecule 1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11830"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11872"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11840"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Iba-1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11841 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11841">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of neurobehavioral tests, including observations of behavior in novel environments, of reactions, and of motor functions; used in various modifications and resembling the functional observational battery.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Irwin battery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11776"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11842 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11842">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Natural amino acid produced by some seaweeds that activates a subclass of glutamate receptors (&apos;kainate receptors&apos;) to produce excitotoxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>(2S,3S,4S)-3-(carboxymethyl)-4-(prop-1-en-2-yl)pyrrolidine-2-carboxylic acid</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Kainic acid is used experimentally to induce focal seizures and model epilepsy.</rdfs:comment>
        <rdfs:label>kainic acid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11843 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11843">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase of epileptogenic activities as a result of repeated, longer-lasting subthreshold brain stimulation, e.g., with electrical stimuli.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Kindling is used in models to study the development of seizures and epilepsy, and also for studying withdrawal phenomena.</rdfs:comment>
        <rdfs:label>kindling</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11844 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11844">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secretion and discharge of tears.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>lacrimation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11845 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11845">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test of color vision using 15 distinct color chips with low color saturation that have to be arranged in a correct order.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Lanthony D-15 desaturated hue panel</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The low color saturation makes this test more difficult than the Farnsworth dichotomous test (D-15) and thus it can detect more subtle color vision deficiencies.</rdfs:comment>
        <rdfs:label>Lanthony D-15 color test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11846 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11846">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Not yet manifest; dormant but potentially discernible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>latent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11847 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11847">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease characterised by spastic paralysis of the legs and lower part of the body, pain, hyperesthesia, and paresthesia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>grass pea poisoning</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Lathyrism is due to excessive ingestion of seeds of plants of the genus Lathyrus, which includes many kinds of pea, including Lathyrus sativa (grass pea). These seeds contain the glutamate analog and neurotoxicant oxalyldiaminopropionic acid (3-[(carboxycarbonyl)amino]alanine)).</rdfs:comment>
        <rdfs:label>lathyrism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11817"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11949"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relatively mild impairment of consciousness resulting in reduced alertness and awareness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Lethargy has many causes but reflects a generalized suppression of brain activity.</rdfs:comment>
        <rdfs:label>lethargy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11849 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11849">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Levorotatory isomer of norepinephrine, having greater pressor activity than the natural dextrorotatory isomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>2-diol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4-[(1S)-2-amino-1-hydroxyethyl]benzene-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>S-noradrenaline</oboInOwl:hasRelatedSynonym>
        <rdfs:label>levarterenol</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conscious or unconscious sexual desire; passionate interest in life force.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>libido</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion channel that opens upon binding an activating ligand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ligand-gated ion channel</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of interconnected neurons lying underneath the cerebrum on either side of the thalamus, related more by anatomical location than as a single functional entity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often termed the paleobrain, and considered to consist of primitive structures.</rdfs:comment>
        <rdfs:comment>Various structures of the limbic system, including the cingulate gyrus, the isthmus, the hippocampus, the uncus, and the amygdala are associated with various emotions and feelings such as anger, fear, sexual arousal, pleasure, and sadness.</rdfs:comment>
        <rdfs:label>limbic system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11580"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12154"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11853 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11853">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Benign tumor of the adipose tissue, often visible under the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Lipoma of the corpus callosum is a rare congenital condition that can be asymptomatic or can present with headache, hemiplegia, dementia and epilepsy.</rdfs:comment>
        <rdfs:label>lipoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11697"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11804"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the four main regions of the cerebral cortex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>lobe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11969"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12125"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11855 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11855">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuron that receives impulses from an upper motor neuron and whose axons innervate the skeletal muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>lower motor neuron</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12155"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of the vertebral column of the lower back between the thoracic spine and sacrum, in humans consisting of five vertebrae designated L1 to L5.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>lumbar spine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12136"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Noninvasive method based on nuclear spin alignment that allows localization of levels and measurement of kinetics of an injected labeled substances in living tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In neurology, the method is used to localize the brain areas where increased metabolic activity occurs upon stimulation; it is also used to study activity and location of neurotransmitters.</rdfs:comment>
        <rdfs:label>magnetic resonance spectroscopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of manganese poisoning, usually after chronic inhalation exposure to manganese fumes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Low environmental exposures are reported to impair brain development and to reduce performance on neuropsychological tests.</rdfs:comment>
        <rdfs:comment>Manganism is characterized by neurological and psychiatric disorders including reduced reaction time, lethargy, tremors, and a mask-like face. Impotence and loss of libido have also been reported.</rdfs:comment>
        <rdfs:label>manganism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11850"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12149"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Labyrinthine system, in which the ability of an animal (usually a rodent) to find a direct route from a starting point to a specific location is observed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Different mazes are available for psychological and neurotoxicity testing. Maze tests suitable for studying spatial navigation, learning, memory, cognition, anxiety and other behaviours have been developed.</rdfs:comment>
        <rdfs:label>maze</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11637"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12116"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly malignant, invasive brain tumor of embryonal origin, arising in the posterior fossa, usually from the cerebellum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is the most common malignant brain tumor in children.</rdfs:comment>
        <rdfs:label>medulloblastoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12015"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence of a potential difference across a biological membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>A cell at its resting potential is said to be polarized.</rdfs:comment>
        <rdfs:label>membrane polarization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11862 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11862">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plural of meninx.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>meninges</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Firm, often vascular, tumor arising from the meninges of the brain or spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Meningiomas are slowly growing benign tumors and quite common.</rdfs:comment>
        <rdfs:label>meningioma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11864 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11864">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation or infection of the meninges.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Although bacterial and viral infections are the most common causes, there are also non-infectious causes including cancers, autoimmune disease and head injury.</rdfs:comment>
        <rdfs:comment>Several common drugs may cause aseptic meningitis.</rdfs:comment>
        <rdfs:label>meningitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11865 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11865">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the brain and meninges.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>cerebromeningitis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>encephalomeningitis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>meningoencephalitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protrusion of both the meninges and brain tissue through a defect in the skull.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often due to a congenital defect.</rdfs:comment>
        <rdfs:label>meningoencephalocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11867 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11867">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formerly used term to describe intellectual disability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>mental retardation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11868 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11868">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mental activity, conscious or unconscious, but especially referring to thinking and reasoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>mentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excitotoxic non-essential amino acid used experimentally to identify a specific subset of glutamatereceptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>NMDA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>&lt;em&gt;N&lt;/em&gt;-methyl-D-aspartate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11869"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NMDA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the various types of receptors of the neurotransmitterglutamate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>NMDA-type glutamate receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is believed to be involved in memory and learning.</rdfs:comment>
        <rdfs:comment>It is both a ligand-gated and voltage-gated cation channel.</rdfs:comment>
        <rdfs:label>&lt;em&gt;N&lt;/em&gt;-methyl-D-aspartate-type glutamate receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11577"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11869"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic substance causing parkinsonism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>MPTP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Originally a toxic by-product in the illicit manufacture of the synthetic opioid meperidine, thus with neurotoxicity first detected in drug abusers, it is used as a model substance for studying the pathogenesis of parkinsonism.</rdfs:comment>
        <rdfs:label>1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11871"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPTP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small glial cell; resident macrophage derived as a mononuclear phagocyte that populates the brain in early development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Microglia represent about \(\pu{15\%}\) of all cells in the brain parenchyma and spinal cord and function in areas of neural damage or inflammation. They clear debris and misfolded proteins, assist in synaptic stripping, and contribute to immune surveillance.</rdfs:comment>
        <rdfs:label>microglial cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11830"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11878"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Morphological response of microglia to injury, characterized by hypertrophy and amoeboid morphology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Microgliosis can arise from resident microglia or from infiltrating blood-borne macrophages.</rdfs:comment>
        <rdfs:label>microgliosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11872"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recurrent syndrome usually characterized by unilateral head pain accompanied by symptoms including nausea and vomiting, vertigo, photophobia and other visual phenomena.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Migraine can be classified as classic migraine, common migraine, cluster headache, hemiplegic migraine, and ophthalm(opleg)ic migraine.</rdfs:comment>
        <rdfs:label>migraine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11623"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12008"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12019"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12170"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11875 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11875">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stroke that occurs in connection with a migraine attack.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>migrainous infarction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11876 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11876">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Questionnaire type of psychological test for ages 18 and older. The RF version has 338 true–false statements with seven validity and ten personality scales that may be used in either an individual or group format.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>MMPI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MMPI-2-RF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This test has been used outside clinical psychology in legal cases, to screen applicants for certain jobs, and to evaluate treatments for substance abuse.</rdfs:comment>
        <rdfs:label>Minnesota multiphasic personality inventory</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11876"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MMPI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal contraction of the pupil of the eye to less than \(\pu{2 mm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Miosis may indicate organophosphate poisoning or opiate intake.</rdfs:comment>
        <rdfs:label>miosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein that has the same amino acid sequence as the normal, functional protein but exhibits a deviant tertiary structure and lacks normal function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Common neurodegenerative diseases (e.g., Alzheimer disease) are associated with the formation, aggregation and deposition of misfolded proteins in neurons.</rdfs:comment>
        <rdfs:label>misfolded protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11879 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11879">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane potential across the inner membrane of the mitochondrion generated by the electron transport chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Δψm</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Changes in this potential are associated with exposure to some neurotoxicants.</rdfs:comment>
        <rdfs:label>mitochondrial membrane potential</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11949"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11879"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Δψm</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dysfunction or degeneration of both motor and sensory nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>mixed neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that the intracranial volume is unchangeable and therefore a constant intracranial pressure requires that the sum of the volumes of the three compartments blood, brain tissue and cerebrospinal fluid remains constant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Monro doctrine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Monro–Kellie doctrine</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Monro–Kellie hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The major phenanthrene alkaloid of opium, used as an analgesic, sedative, and anxiolytic.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>(5α,6α)-7,8-didehydro-4,5-epoxy-17-methylmorphinan-3,6-diol</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Morphine and its analogues exert their action by binding to morphine receptors in the brain and nervous tissues. The natural ligands of these receptors are peptide neurotransmitters such as endorphin.</rdfs:comment>
        <rdfs:comment>While chronic consumption of morphine leads to the development of tolerance and physical dependence, the artificial morphine derivative heroin can cause severe addiction after only few doses.</rdfs:comment>
        <rdfs:label>morphine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11564"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11598"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physical activity and performance of an animal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In performance tests, locomotor or ambulatory activity refers to the linear movement of an animal, whereas ambulatory and rearing movements together are referred to as total activity.</rdfs:comment>
        <rdfs:label>motor activity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12042"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cooperation of the motor neurons and the involved muscles to perform a body movement precisely according to spatiotemporal requirements.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Impaired coordination results in ataxia.</rdfs:comment>
        <rdfs:comment>Motor coordination involves signals from the organ of equilibrium, the visual system and the cerebellum as well as other neural inputs.</rdfs:comment>
        <rdfs:label>motor coordination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11887"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of the cerebral cortex, located primarily in the frontal lobe, involved in coordinating motor activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>motor cortex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11883"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11886 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11886">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complex structure by which the axon of a motor neuron establishes synaptic contact with a skeletal muscle fiber.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>motor endplate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11887 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11887">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nerve cell in the spinal cord having an axon that leaves the central nervous system to establish a functional connection with an effector (muscle or glandular) tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>motor neuron</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11888 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11888">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generic term for a heterogeneous group of disorders, all affecting motor neurons in the brain, spinal cord, or both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>MND</oboInOwl:hasRelatedSynonym>
        <rdfs:label>motor neuron disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11583"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11887"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11888"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MND</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the central nervous system responsible for control of movement, consisting of the pyramidal system controlling voluntary movement and the extrapyramidal system coordinating involuntary movement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>motor system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11890 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11890">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intolerance condition attributed to extreme sensitivity of individuals to various environmental chemicals, found in air, food, water, building materials, or fabrics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>MCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>environmental illness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>idiopathic environmental intolerance</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Several theories have been advanced to explain the cause of multiple chemical sensitivity, including allergy, toxic effects, and neurobiological sensitization. There is insufficient scientific evidence to confirm a relationship between any of these possible causes and symptoms.</rdfs:comment>
        <rdfs:comment>This syndrome is characterized by the patient’s belief that his or her symptoms are caused by very low-level exposure to environmental chemicals. The term &quot;chemical&quot; is used to refer broadly to many natural and man-made substances, some of which have several chemical constituents.</rdfs:comment>
        <rdfs:label>multiple chemical sensitivity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11890"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Common demyelinating (see demyelination) disorder of the central nervous system, causing patches of sclerosis (plaques) in the brain and spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>MS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoantibodies targeting myelin basic protein are believed to play an important role.</rdfs:comment>
        <rdfs:label>multiple sclerosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11707"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11891"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11892 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11892">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to agents that stimulate the postganglionicparasympatheticreceptor, named after the prototypical mushroom alkaloid, muscarine [2,5-anhydro-1,4,6-trideoxy-6-(trimethylammonio)-D-ribo-hexitol].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Drugs that bind with muscarinic cholinergic receptors but do not activate them, thus preventing access to acetylcholine, include atropine and scopolamine.</rdfs:comment>
        <rdfs:comment>Muscarinic receptors are distinguished from nicotinic receptors, thus allowing classification of cholinergic receptors as muscarinic and nicotinic.</rdfs:comment>
        <rdfs:comment>The muscarinic receptor has a recognition site for acetylcholine.</rdfs:comment>
        <rdfs:label>muscarinic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11960"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11893 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11893">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the two main classes of acetylcholine receptors that responds to muscarinic agents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>muscarinic receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11892"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11960"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sensory organ in the body of a striated muscle containing afferent and efferentnerve fibers that detect passive muscle stretch and convey information to the central nervous system to cause reflex resistance to this stretch.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neuromuscular spindle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>muscle spindle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11571"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11741"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11912"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dilation of the pupil.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Mydriasis can be a physiological response to light, a sign of brain trauma, or caused by drugs such as atropine.</rdfs:comment>
        <rdfs:label>mydriasis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrically insulating lipoprotein layers that are produced by glial cells and surround the axons of the neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is produced by oligodendrocytes in the central nervous system and by Schwann cells in the peripheral nervous system.</rdfs:comment>
        <rdfs:label>myelin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12064"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Major component of myelin, that helps organizing the correct assembly of the lipids and proteins in myelin sheets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Absence of myelin basic protein in animals results in seizures.</rdfs:comment>
        <rdfs:comment>Myelin basic protein levels in the cerebrospinal fluid are elevated in various demyelinizing disorders, including multiple sclerosis where autoantibodies against myelin basic protein are believed to play a role.</rdfs:comment>
        <rdfs:label>myelin basic protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11707"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11896"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transmembrane glycoprotein that plays an important role in the interaction between axons and myelin and affects myelination during nerve regeneration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>myelin-associated glycoprotein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentric layers of myelin surrounding the axons of some neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The myelin sheath increases the conduction velocity of electrical impulses.</rdfs:comment>
        <rdfs:label>myelin sheath</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11896"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11900 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11900">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>X-ray of the spinal canal following injection of a contrast material into the surrounding cerebrospinal fluid spaces.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>myelogram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11901 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11901">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protrusion of the spinal cord and its coverings through a defect in the vertebral column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>myelomeningocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any functional or pathologic disturbance in the spinal cord. Disorder of the myelopoietic tissues of the bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>myelopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any disease of muscle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>myopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prolonged contraction or delayed relaxation of a muscle after mechanical or brief electrical stimulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Myotonia is indicative of an abnormality of ion channels of the muscle membrane, and is often an example of an ion channelopathy.</rdfs:comment>
        <rdfs:label>myotonia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11839"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11905 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11905">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glial cell of the central nervous system, distinct from an oligodendrocyte or astrocyte, that may serve as a precursor of oligodendrocytes, and that takes its name from expression of proteoglycan NG2.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>polydendrocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:label>NG2 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonspecific, reversible depression of central nervous system function, marked by stupor or unconsciousness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>narcosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12099"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonspecific usage – an agent that produces insensibility or stupor. Specific usage – any natural or synthetic substance that has morphine-like actions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>narcotic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11882"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12099"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer layer of the cerebral cortex that supports higher brain functions, especially cognitive function and language in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It includes most of the cerebral cortex except for the hippocampus.</rdfs:comment>
        <rdfs:label>neocortex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ensheathed bundle of nerve fibers that conveys information between the central nervous system and other regions of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nerve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11912"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of the functional integrity of a nerve with a stimulating electrode, placed on the skin over the nerve, and a more distal recording electrode, to determine the velocity of the impulse that passes along the nerve between the electrodes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nerve conduction study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11911 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11911">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of progression of a nerve impulse in a peripheral nerve or in its largest component nerve fibers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is measured to provide information on the intactness of the nerve.</rdfs:comment>
        <rdfs:label>nerve conduction velocity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11912"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11912 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11912">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Axon with its surrounding myelin sheath.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nerve fiber</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11899"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11913 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11913">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volatile chemical with neurotoxic features intended for use in warfare to disable or kill the organism rapidly after inhalation or skin contact, and classified as a prohibited weapon of mass destruction by The Chemical Weapons Convention (CWC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>nerve agent</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nerve gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11979"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a family of proteins known as neurotropins that function as signaling molecules to induce axon growth, branching, elongation and survival of neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>NGF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nerve growth factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11914"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NGF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proximal end of a spinal nerve nearest its attachment to the spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nerve root</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11916 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11916">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The entire neuronal apparatus, composed of both the central nervous system and the peripheral nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nervous system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metabolic and electrical activity of neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Brain regions active during task performance can be studied with implanted electrodes or with non-invasive methods such as electroencephalography and functional magnetic resonance imaging.</rdfs:comment>
        <rdfs:label>neural activity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11744"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11918 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11918">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paroxysmal pain extending along the course of one or more nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neuralgia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11919 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11919">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A functionally interconnected set of neurons, generally in the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neuronal network</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In computer science, the term refers to an interconnected set of electronic components designed to mimic or exploit functional aspects of the human brain.</rdfs:comment>
        <rdfs:label>neural network</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11920 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11920">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multipotent cell, with mitotic potential, that may serve as a precursor for neuroprogenitor cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Adult neural stem cell refers to a cell localized in specific niches of the adult central nervous system, capable of generating new neurons.</rdfs:comment>
        <rdfs:label>neural stem cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11945"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11921 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11921">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excision of a nerve or part of a nerve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurectomy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outgrowth or projection of either an axon or a dendrite from the neuron cell body that is the structural basis of the neural network.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11923 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11923">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenomenon in which neurons tend to send out neurites to make contact with other nerve cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>These outgrowths can be induced by electrical stimulation, neurotropic factors, and other stimuli.</rdfs:comment>
        <rdfs:label>neurite outgrowth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11922"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11956"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11924 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11924">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of a nerve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Neuritis may also be used to denote non-inflammatory nerve lesions of the peripheral nervous system.</rdfs:comment>
        <rdfs:label>neuritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11925 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11925">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A set of seven tests, recommended by the World Health Organization (WHO) in 1983, to detect neurotoxicity in human populations</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>NCTB</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The battery consists of digit symbol, digit span, pursuit aiming, Benton visual memory, simple reaction time, Santa Ana dexterity, and profile of mood states tests.</rdfs:comment>
        <rdfs:label>neurobehavior core test battery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11636"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11717"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12021"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12061"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12076"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NCTB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11926 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11926">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of the brain and (or) peripheral nervous system with progressive loss of neuronal function, accompanied by changes in morphology and subcellular organization of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurodegenerative disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11927 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11927">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effect of a substance that disrupts developmental processes of the nervous system. Toxicity in which the developing nervous system shows heightened sensitivity compared with the adult nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurodevelopmental toxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of a filamentous structure found in the cell body, axons, dendrites, and sometimes synaptic endings of neurons, consisting of bundles of neurofilaments and neurotubules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurofibril</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11931"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11957"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11929 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11929">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracellular accumulation of aggregates of hyperphosphorylated tau protein or paired helical filaments consisting of the tau protein, a microtubule-associated protein that normally stabilizes the cytoskeleton.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Neurofibrillary tangles are characteristically found in neurons of the cerebral cortex of patients with Alzheimer disease.</rdfs:comment>
        <rdfs:label>neurofibrillary tangle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11986"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12122"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tumor of the peripheral nervous system representing an abnormal collection of Schwann cells and connective tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurofibroma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12064"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of intermediate filament of the neuronal cytoskeleton, providing support for the axon and dendrites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurofilament</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11932 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11932">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of nerve cells or of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurogenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Originating in, starting from, or caused by, the nervous system or nerve impulses. Relating to neurogenesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurogenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of decreased blood pressure, slow heart rate and insufficient perfusion of the body with blood, caused by loss of autonomic control following acute trauma to the brain or spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurogenic shock</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11935 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11935">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of producing images of the structure or activity of the brain or other parts of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Current neuroimaging techniques include magnetic resonance imaging and computerized tomography.</rdfs:comment>
        <rdfs:label>neuroimaging</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complex series of local immune responses within the nervous system to deal with a threat to the neural environment from infection, injury, or trauma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In the brain, the process is initiated by microglial release of cytokines, often leading to increased blood–brain barrier permeability and a secondary lymphocyte-mediated inflammation.</rdfs:comment>
        <rdfs:label>neuroinflammation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11830"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11872"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a class of psychotropic drugs used to treat psychosis, particularly schizophrenia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neuroleptic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12029"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12031"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Breakdown of nervous tissue from disease or injury. Therapeutic destruction of a nerve or nerves to treat intractable pain. Surgical freeing of a nerve from adhesions of the neural sheath.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurolysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tumor made up largely of nerve cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neuroma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11940 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11940">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder involving destruction of the cell bodies of neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neuronopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11941 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11941">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme of glucose metabolism, normally found in nervous tissue, that catalyzes the dehydration of 2-phosphoglycerate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Elevated concentrations in the blood are associated with various disease, including neuroblastoma and non-neuronal tumors.</rdfs:comment>
        <rdfs:label>neuron-specific enolase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11942 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11942">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of gross and histopathologic methods to study toxic changes in the morphology and histology of the nervous tissues and the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This can be a very detailed part of neurotoxicity evaluation that may reveal mechanisms of action.</rdfs:comment>
        <rdfs:label>neuropathological examination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11943 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11943">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological change in the peripheral nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It may occur as a localized lesion, or secondary to systemic toxicity (e.g., from alcohol consumption) or a generalized medical condition (e.g., diabetes).</rdfs:comment>
        <rdfs:label>neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11944 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11944">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that is phosphorylated by organophosphate compounds and is believed to be involved in the delayed neuropathy of organophosphates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>NTE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>neurotoxic esterase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>neuropathy target esterase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11979"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11944"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NTE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11945 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11945">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precursor cell that is capable of differentiating into specific cell types of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The renewal potential of neuroprogenitor cells is typically reduced relative to neural stem cells.</rdfs:comment>
        <rdfs:comment>The term typically refers to a cell that has further committed beyond an early neural stem cell, either by being located in a particular region of the nervous system or destined for a particular type of neuron.</rdfs:comment>
        <rdfs:label>neuroprogenitor cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11920"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11946 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11946">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent or property of an agent that protects neurons from damage and (or) from the process of aging or degeneration of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neuroprotective</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11947 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11947">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assessment, under standardized conditions, of an individual’s brain function as it impacts upon cognitive function, thought processes, behavior and personality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>An initial training period may be required so that each individual starts the testing at an optimized performance level, although most neuropsychological assessments compare an individual’s raw score to a normative sample score of the population.</rdfs:comment>
        <rdfs:comment>Such tests are designed to measure a psychological function known to be linked to a particular brain structure or pathway and often measure reaction times, motor performance or cognitive association.</rdfs:comment>
        <rdfs:label>neuropsychological testing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11883"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11948 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11948">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Poisonous to structures and (or) functions of the brain and nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurotoxic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11949 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11949">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that can produce functional or structural damage to the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurotoxicant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11950 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11950">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Discipline applying principles of both neuroscience and toxicology to study the ability of certain substances to alter nervous system structure or function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurotoxicology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11951 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11951">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxic shellfish poisoning characterized by nausea, vomiting, and mild neurological symptoms such as dysarthria, paresthesia, ataxia, and vertigo caused by ingestion of shellfish (specifically, bivalve molluscs) contaminated with the polyether brevetoxin and its derivatives produced by the dinoflagellate Karenia brevis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>NSP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>neurotoxic shellfish poisoning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11731"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12170"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11951"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11952 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11952">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any substance that has the potential to damage the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In the narrower sense, neurotoxins are of biological origin, like toxins in general. However, the term neurotoxin is also in general use for non-biological substances.</rdfs:comment>
        <rdfs:label>neurotoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11953 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11953">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a presynaptic cell, upon excitation, releases a specific agent (a neurotransmitter) that crosses the synapse to stimulate or inhibit the postsynaptic cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurotransmission</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11954"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11954 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11954">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurotransmission wherein a neurotransmitter is sent from the postsynaptic to the presynaptic membrane in order to modify a signal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>retrograde neurotransmission</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11955 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11955">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biochemical that is released upon excitation from a presynaptic membrane, crosses the synaptic space and binds to a receptor on the postsynaptic membrane, where it induces a signal that may be either stimulatory or inhibitory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurotransmitter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11956 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11956">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having an affinity for nerve cells or tissues of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neurotrophic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>neurotropic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11957 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11957">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microtubule found in neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurotubule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11958 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11958">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to both the nervous system and the vascular system. Relating to the vasomotor nerves that supply the walls of the blood vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>neurovascular</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11959 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11959">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to a substance or effect that mimics acetylcholine at the neuromuscular junction, at autonomic ganglia and at other locations in the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The prototype substance is the parasympathomimetic alkaloid, nicotine [(S)-3-[1-methylpyrrolidin-2-yl]pyridine].</rdfs:comment>
        <rdfs:comment>These substances bind to a specific class of cholinergic receptors denoted nicotinic acetylcholine receptors.</rdfs:comment>
        <rdfs:label>nicotinic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11886"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11892"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11994"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11960 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11960">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the two main classes of acetylcholine receptors, ligand-gated ion channels that open upon binding nicotine as well as acetylcholine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nicotinic receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11557"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11893"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11961 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11961">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Behavioral test based on the five-choice serial reaction time task, which allows the study of attention based on a test animal learning from which hole (typically one of five open holes in an arc of nine) a visual (light) cue was given, with a food pellet reward for nose-poking the correct hole.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>5–9 hole attention box test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nine-hole box test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11966"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11962 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11962">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Granular structure consisting of rough endoplasmic reticulum, found in neurons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Nissl granule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nissl substance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Nissl body</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11678"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11963 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11963">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physiological response to harmful stimuli by specialized nerve endings that transmit a signal perceived as pain by the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nociception</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11595"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11964 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11964">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Short interval in the myelin sheath of a nerve fiber where the axon is invested only by scant cytoplasmic processes of the neighboring Schwann cells or, in the central nervous system, of oligodendroglia cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>At the nodes the axonal membrane is not insulated and contains a high density of voltage-gated \(\ce{Na+}\) channels that generate action potentials.</rdfs:comment>
        <rdfs:label>node of Ranvier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12064"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11966 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11966">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test allowing study of attention deficit based on noting the success of a test animal in gaining a food pellet reward for nosing the correct hole in a box.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nose-poke test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11961"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11967 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11967">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Imprecise term for absent or reduced touch perception, as well as paresthesia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>numbness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11968 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11968">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary rhythmic oscillation of the eyeballs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>nystagmus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11969 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11969">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the four major lobes of each cerebral hemisphere, situated within the occiput, containing most of the neural apparatus of visual processing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>occipital lobe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11854"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11970 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11970">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detection of odors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>olfaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11971 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11971">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of glial cell that produces the myelin sheath in the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>oligodendroglial cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Schwann cells perform a comparable function in the peripheral nervous system.</rdfs:comment>
        <rdfs:label>oligodendrocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12064"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11972 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11972">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glioma arising from the oligodendrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Usually a slow-growing, well-circumscribed tumor.</rdfs:comment>
        <rdfs:label>oligodendroglioma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11789"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11973 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11973">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure to observe changes in motor activity and rearing, in which a rodent is placed on a surface and distance and patterns of movement are recorded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Automated procedures include video capture methods using photocell devices to measure activity as photocell beam breaks.</rdfs:comment>
        <rdfs:comment>Typically the animal is placed within a circular enclosed arena with grid lines marking the floor and the number of line crossing and rearing events are counted within a defined period of time.</rdfs:comment>
        <rdfs:label>open field test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11883"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12042"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11974 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11974">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a group of G-protein-coupled receptors that bind morphine and endogenous substances that have morphine-like effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Such endogenous substances include endorphins and enkephalins.</rdfs:comment>
        <rdfs:label>opiate receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11755"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11882"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11975 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11975">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic narcotic having properties consistent with binding to opiate receptors, but not derived from opium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>opioid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11907"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11976"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11976 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11976">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extract of the opium poppy, Papaver somniferum, containing morphine as a major psychoactive component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Papaver somniferum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>opium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11882"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12027"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11977 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11977">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to perception by a sensory organ. Involving the use of sensory organs, e.g., organoleptic tests.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>organoleptic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11978 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11978">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound having covalent bonds between one or more metal atoms and one or more carbon atoms of an organyl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Organification of metals such as \(\ce{Mn}\), \(\ce{Pb}\), \(\ce{Sn}\) and \(\ce{Hg}\) often enhances their neurotoxicity.</rdfs:comment>
        <rdfs:label>organometallic compound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11979 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11979">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organic ester of phosphoric acid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>These are often acetylcholinesterase inhibitors used as pesticides or prohibited agents in chemical warfare.</rdfs:comment>
        <rdfs:label>organophosphate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11558"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11980 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11980">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder, typically with symptoms of pain and weakness in the extremities, resulting from neuronal death associated with organophosphate poisoning (either chronic or a late effect of acute poisoning).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>OPIDN</oboInOwl:hasRelatedSynonym>
        <rdfs:label>organophosphate-induced delayed neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11979"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11980"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>OPIDN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11981 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11981">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Morbid fear of odors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>olfactophobia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>osmophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11982 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11982">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects occurring when the generation of reactive oxygen species (ROS) in a system exceeds the system’s ability to neutralize and eliminate them; excess ROS can damage a cell’s lipids, protein, and DNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>oxidative stress</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11983 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11983">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conscious awareness of an unpleasant sensation mediated by nerve conduction of a stimulus from a site of tissue injury to the brain. Note 1: Chemical mediators of pain include histamine, bradykinins, and prostaglandins. Note 2: The sensation may occur or persist when the injured tissue is no longer present, as in phantom pain. Sensation one feels when hurt in body or mind.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>pain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11984 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11984">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pain initiated by nerve injury, not mediated by nociception.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>neuropathic pain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>neuropathic pain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11985 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11985">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sensation that an amputated limb is still present, often associated with pain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>phantom limb pain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>phantom pain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11986 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11986">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing the aggregation of hyperphosphorylated tau protein into neurofibrillary tangles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>PHF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>paired helical filament</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11929"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12122"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PHF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11987 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11987">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unduly rapid or throbbing heartbeat that is noted by a patient; it may be regular or irregular. Undue awareness by a patient of a heartbeat that is otherwise normal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>palpitation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11988 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11988">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Edema of the region of the head of the optic nerve in the retina (the optic disc).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often caused by increased intracranial pressure.</rdfs:comment>
        <rdfs:label>papilledema</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11989 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11989">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total or partial loss of motor function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Paralysis may occur as a consequence of disease or injury to the muscle, or impairment of its nerve supply.</rdfs:comment>
        <rdfs:label>paralysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11990 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11990">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Illness that is a consequence of consumption of bivalve molluscs such as mussels, oysters, and clams that have ingested large quantities of microalgae containing saxitoxin or its derivatives.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>PSP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Initially there is tingling, numbness, and burning of the tongue and lips, which spreads to the face, neck, arms, fingertips, legs, and toes; this is followed by weakness of the upper and lower limbs, loss of motor coordination, and, in severe cases, paralysis.</rdfs:comment>
        <rdfs:label>paralytic shellfish poisoning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.11990"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11991 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11991">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of several related enzymes that hydrolyze aryl esters and lactones, notably organophosphate pesticides including the acetylcholinesterase inhibitor, paraoxon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The most studied, PON1, is associated with high density lipoprotein and is considered to have beneficial antioxidant, including antiatherosclerotic, properties.</rdfs:comment>
        <rdfs:label>paraoxonase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11558"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11979"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11992 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11992">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paralysis of both lower limbs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>paraplegia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11993 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11993">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Division of the autonomic nervous system involved in stimulating digestive secretions, slowing heart rate, constricting the pupils of the eyes, and dilating blood vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>parasympathetic nervous system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12107"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11994 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11994">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n., Substance that produces effects resembling those of impulses transmitted by the postganglionic fibers of the parasympathetic nervous system. adj., Producing effects resembling those of impulses transmitted by the postganglionic fibers of the parasympathetic nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>cholinomimetic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>parasympathomimetic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11995 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11995">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slight or incomplete paralysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>paresis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11996 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11996">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal or unexplained tingling, pricking, or burning sensation on the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>paraesthesia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>paresthesia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11997 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11997">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the four major lobes of each cerebral hemisphere situated between the frontal and occipital lobes, above the temporal lobe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>parietal lobe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11854"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11969"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12125"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11998 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11998">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degenerative disorder of the central nervous system resulting from decreased production of the neurotransmitterdopamine in the basal ganglia (notably the substantia nigra).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>idiopathic parkinsonism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primary parkinsonism</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Characterized by rhythmic muscle tremor, rigidity of movement, and a mask-like face.</rdfs:comment>
        <rdfs:comment>Usually idiopathic, although inherited cases occur.</rdfs:comment>
        <rdfs:label>Parkinson disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11723"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12103"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12149"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.11999 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.11999">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurological syndrome resembling Parkinson disease and often resulting from decreased dopamine production as a consequence of neurodegenerative changes in the substantia nigra.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>There are a number of known causes for secondary parkinsonism, including exposure to a number of neurotoxic substances.</rdfs:comment>
        <rdfs:label>secondary parkinsonism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11723"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12103"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12000 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12000">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fear-motivated test in which rodents learn to avoid an otherwise preferred environment in which they are exposed to an aversive stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The latency to avoid the aversive stimulus indicates changes of learning and (or) memory.</rdfs:comment>
        <rdfs:label>passive avoidance test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12001 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12001">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test used to reveal motor deficits, usually of central origin, exhibited on the contralateral side by reduced ability of a test animal to extend the forelimb.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>staircase test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Often used to assess traumatic brain injury deficits or recovery.</rdfs:comment>
        <rdfs:comment>Typically performed with rodents in an apparatus resembling a staircase on which reward food pellets are placed on steps of increasing distance, or with larger animals reaching under a barrier for a reward.</rdfs:comment>
        <rdfs:label>paw-reaching test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12002 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12002">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell of an established line originally derived from a pheochromocytoma of the rat adrenal medulla.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>PC-12 cells dividing in culture will terminally differentiate into neuron-like cells under an appropriate stimulus (e.g., nerve growth factor), making them a common model for studying neuronal differentiation and properties in culture.</rdfs:comment>
        <rdfs:label>PC-12 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12006"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12003 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12003">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the two major divisions of the nervous system, made up of the nerves and ganglia lying outside the brain and spinal cord that transmit sensory and motor signals to and from the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>PNS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peripheral nervous system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11916"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PNS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12004 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12004">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuropathy affecting nerves of the peripheral nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>peripheral neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12005 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12005">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progression of a wave of smooth muscle contraction followed by relaxation along the length of a muscular tube.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Typically occurring in the gastrointestinal tract and ureter.</rdfs:comment>
        <rdfs:label>peristalsis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12006 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12006">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tumor of the chromaffin cells of the adrenal medulla that results in excessive secretion of norepinephrine and other catecholamines.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>pheochromocytoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12007 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12007">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal fear of loud sound, or occasionally of voices.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>phonophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12008 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12008">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal visual intolerance of light.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>photophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12009 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12009">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specialized neuron found in the retina, involved in detecting light and transducing the signals of vision</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The two main types of photoreceptor cells are rod cells, responsible for vision at low light intensities, and cone cells, responsible for colour and high acuity vision at higher light intensities.</rdfs:comment>
        <rdfs:label>photoreceptor cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12010 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12010">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Innermost of three membranous layers, together composing the meninges, that surrounds and adheres to the brain and spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>pia mater</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12011 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12011">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Network of interconnecting nerves, blood vessels or lymphatic vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>plexus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12012 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12012">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neural network in the brainstem involved in regulating respiration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>pontine respiratory group</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pneumotaxic center</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12013 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12013">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of several peripheral nerves simultaneously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>polyneuritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12014 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12014">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuropathy (distal axonopathy) of the peripheral nervous system, often affecting the extremities in a bilateral distribution, and characterized by numbness, tingling, and paresthesia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It may be caused by infections or toxic substances (notably alcohol abuse), may be associated with chronic diseases such as diabetes, or may be idiopathic.</rdfs:comment>
        <rdfs:label>polyneuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11630"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12015 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12015">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pocket in the back of the skull that accommodates the cerebellum and the midbrain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>posterior fossa</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12016 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12016">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Event or structure at the distal side of a synaptic cleft.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>postsynaptic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12110"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12017 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12017">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Potentiation lasting up to several months.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Considered to be a major mechanism involved in learning and memory.</rdfs:comment>
        <rdfs:label>long-term potentiation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12018 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12018">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Event or structure at the proximal (transmitting) side of a synaptic cleft.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>presynaptic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12110"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12019 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12019">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phase before the onset of full-blown disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often referring to visual disturbances and (or) mood changes before the further development of a migraine headache or epileptic seizure.</rdfs:comment>
        <rdfs:label>prodromal stage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12020"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12020 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12020">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Symptom(s) heralding impending onset of a disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>prodrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12019"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12021 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12021">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a test subject is asked to indicate his/her mood during the past week, by quickly marking specified emotional words on a scale between &apos;not at all&apos; and &apos;extremely.&apos;</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>POMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>POMS test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Tested moods typically include tension, anxiety, depression, hostility, vigor, fatigue and confusion.</rdfs:comment>
        <rdfs:label>profile of mood state test</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12021"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>POMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12022 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12022">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sense of the movement or position of the body independent of vision.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often gained from input from nerve terminals in the muscles, tendons, and joint capsules.</rdfs:comment>
        <rdfs:label>proprioception</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12023"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12023 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12023">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sensory organ in a muscle, tendon or joint capsule that senses position or state of contraction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>proprioceptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12024 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12024">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary emotional outburst (typically crying or laughing).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>PBA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>PBA is a result of neurological injury or disease, but the precise mechanism is unknown.</rdfs:comment>
        <rdfs:label>pseudobulbar affect</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PBA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12025 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12025">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the cerebrospinal fluid that, in contrast to a meningocele, is not surrounded by dura.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>pseudomeningocele</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12026 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12026">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder with increased intracranial pressure, cerebral edema, and frequently papilledema, symptoms that resemble the effects of a tumor but without the occurrence of one.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>idiopathic intracranial hypertension</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pseudotumor cerebri</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11988"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12027 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12027">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having the ability to alter mood, behavior, cognitive function or mental state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Usually referring to a pharmacologic agent.</rdfs:comment>
        <rdfs:label>psychoactive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12031"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12028 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12028">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of links between the brain and the immune system, recognizing an interaction between psychological states and the outcome of immune responses to disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>PNI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>psychoneuroimmunology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12028"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PNI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12029 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12029">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disordered thought processes that may include changes in cognitive function, perception, belief, behavior and personality; altered awareness of reality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>psychosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12030 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12030">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Psychosis with a known physical (anatomic, disease-related or toxic) cause.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>organic brain syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>organic psychosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12029"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12031 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12031">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capable of affecting the mind, emotions and behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often referring to drugs used to treat mental illness.</rdfs:comment>
        <rdfs:label>psychotropic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12027"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12032 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12032">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Marine fish of the order Tetraodontiformes and family Tetraodontidae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>puffer fish</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12133"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12033 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12033">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large neuron forming part of a layer of cells in the cerebellum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>By releasing γ-aminobutyric acid, these inhibitory GABAergic neurons regulate and coordinate motor activity.</rdfs:comment>
        <rdfs:label>Purkinje cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11575"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11778"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11883"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12034 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12034">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a subject is instructed to place a dot in defined sites (such as a number of circles), as quickly as possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The test provides information about eye-to-hand coordination.</rdfs:comment>
        <rdfs:label>pursuit aiming test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12035 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12035">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the basal ganglia that plays a role in coordinating movement and learning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is involved in neurodegenerative diseases such as Parkinson disease.</rdfs:comment>
        <rdfs:label>putamen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12036 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12036">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clumping of nuclear chromatin and shrinkage of the cell nucleus during cell degeneration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>pyknosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12037 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12037">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large neuron of the cerebral cortex having a triangular cell body in histological section with several dendrites at the base and one large apical axon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Pyramidal cells are also found in other brain areas such as the hippocampus.</rdfs:comment>
        <rdfs:comment>They are thought to play a role in cognitive function.</rdfs:comment>
        <rdfs:label>pyramidal cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12038 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12038">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic molecule with structural similarity to the natural pyrethrins found in plants of the genus Chrysanthemum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>They are a major class of insecticide and cause paralysis by blocking closure of axonal sodium ion channels, thus depolarizing neurons.</rdfs:comment>
        <rdfs:label>pyrethroid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12039 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12039">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paralysis of both upper and both lower limbs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>quadriplegia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12040 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12040">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus with a central platform and equidistant arms (usually eight), at the end of which is a reward (e.g., a food pellet).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>A rodent placed in the center is observed seeking the shortest way to the reward, as an indicator of spatial learning and memory.</rdfs:comment>
        <rdfs:label>radial arm maze</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12041 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12041">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the spinal nerve roots leading to pain and hyperesthesia radiating along the nerve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>radiculitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11817"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12042 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12042">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of a rodent or other animal raising itself on its hind legs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>rearing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12043 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12043">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reappearance of original symptom(s), often exacerbated, following cessation of treatment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>rebound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11801"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12044 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12044">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involuntary reaction in response to a stimulus applied to the periphery following its transmission to the nervous centers in the brain or spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often contraction of a muscle due to a stimulus applied to its proprioceptors.</rdfs:comment>
        <rdfs:label>reflex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12023"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12045 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12045">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diffuse persistent pain usually in an extremity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>RSD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Often associated with vasomotor disturbances, interruption of the nerve supply, and limitation of joint movement, frequently following local injury.</rdfs:comment>
        <rdfs:label>reflex sympathetic dystrophy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RSD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12046 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12046">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of a stimulus in operant conditioning to increase the likelihood that a particular behavior will occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In contrast to reinforcement, use of stimuli to decrease a behavior is called punishment.</rdfs:comment>
        <rdfs:comment>Reinforcement may be positive (using a desirable stimulus) or negative (removing or withholding an adverse stimulus).</rdfs:comment>
        <rdfs:label>reinforcement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11688"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12047 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12047">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that reduces muscle tension.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>relaxant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12048 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12048">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Restoration of the blood supply to an organ or tissue following a period of ischemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Reperfusion itself may cause further injury to the tissue (ischemia-reperfusion injury), for instance due to production of reactive oxygen species or excessive \(\ce{Ca^{2+}}\) influx.</rdfs:comment>
        <rdfs:label>reperfusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12049 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12049">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Returning of a cell’s membrane potential to its resting potential following depolarization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>repolarization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12050 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12050">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Return to a sexually unexcited state following orgasm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>resolution phase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12051 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12051">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Baseline membrane potential.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>resting potential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12052 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12052">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transport of material from the nerve ending back to the cell body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>retrograde axonal transport</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11629"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12053 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12053">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transporter-dependent resequestration of a neurotransmitter by a presynapticneuron, terminating synaptic transmission.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>reuptake</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12114"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12054 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12054">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which the test subject first copies a complicated drawing and then is asked to draw it from memory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ROCF Test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This tests several aspects of cognitive ability, including visuospatial perception and memory.</rdfs:comment>
        <rdfs:label>Rey–Osterrieth complex figure test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12055 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12055">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reflex that restores the correct orientation of the body when taken out of the upright position.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>righting reflex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12056 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12056">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental measurement of an animal’s (usually a rodent’s) ability to land in an upright position at the end of a fall.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>aerial righting test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Imprecise measure of proprioception and motor coordination.</rdfs:comment>
        <rdfs:label>righting test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11884"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12022"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12055"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12057 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12057">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test animal is placed on its back and the time to retain an uprate position with four paws in contact with the surface is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This may be used to study development.</rdfs:comment>
        <rdfs:label>surface righting test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12058 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12058">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental observation of an animal’s (usually a rodent’s) ability to stay on a rotating rod without falling off.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Maintaining an upright position on the rod involves the righting reflex.</rdfs:comment>
        <rdfs:comment>The length of time the animal stays on the rod is a relative measure of motor coordination, balance and resistance to fatigue.</rdfs:comment>
        <rdfs:label>rotarod test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11884"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12055"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12059 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12059">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rapid or jerky movement of the eyes from one line of sight to another, as in reading or correction of a jerky nystagmus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>saccadic eye movement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11968"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12060 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12060">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to inflammatory conditions of the skin such as erysipelas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Saint Anthony fire</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11760"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12061 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12061">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a test subject stands in front of a plate with 48 square holes and an equal number of fitted pegs, each having a cylindrical upper part and square base, and is asked to fit the pegs into the holes as quickly as possible by turning them 180 degrees, first with one hand and in a subsequent trial with the other hand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The test measures eye-to-hand coordination and gives information about right/left-handedness.</rdfs:comment>
        <rdfs:label>Santa Ana dexterity test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12062 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12062">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental procedure in which operant behavior is assessed following a conditioning stimulus delivered at a pre-determined duration and frequency (&apos;schedule of reinforcement&apos;), thus allowing comparison of the effects of magnitude, frequency and duration of the stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>SCOB</oboInOwl:hasRelatedSynonym>
        <rdfs:label>schedule-controlled operant behaviour</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11688"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12063"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12062"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCOB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12063 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12063">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Frequency, duration, dose, and (or) intensity of a conditioning stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>schedule of reinforcement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12062"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12064 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12064">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glial cell in the peripheral nervous system that produces myelin for the axons of the peripheral nerves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Schwann cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11785"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12065 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12065">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hardening of an organ or tissue, especially that due to excessive growth of fibrous tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>sclerosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12066 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12066">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Constellation of symptoms resembling an allergic reaction, caused by eating the meat of decaying fish that has high levels of histamine (in this context sometimes referred to as scombrotoxin).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Typically but not exclusively caused by fish of the Scombridae family, such as tuna, albacore and mackerel.</rdfs:comment>
        <rdfs:label>Scombroid poisoning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11809"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12067 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12067">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that exerts a soothing or tranquillizing effect, or describing the effect itself.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>sedative</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12144"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12068 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12068">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug in a subclass of substances that interfere with the resequestration of serotonin by the presynaptic membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>SSRI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This particular subclass is used in the treatment of clinical depression.</rdfs:comment>
        <rdfs:label>selective serotonin reuptake inhibitor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11711"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11815"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12068"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SSRI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12069 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12069">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristics typically associated with old age, especially relating to memory loss and other mental impairment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>senility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12070 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12070">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nerve cell specialized for detecting and transducing signals from external or somatic stimuli.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>sensory neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12071 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12071">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to a nerve that releases or responds to serotonin as a neurotransmitter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>serotoninergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11815"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12072 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12072">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Illness associated with consumption of seafood contaminated with toxins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Four syndromes with overlapping features are recognized. These are amnesic shellfish poisoning, diarrheal shellfish poisoning, neurotoxic shellfish poisoning, and paralytic shellfish poisoning.</rdfs:comment>
        <rdfs:comment>These are primarily associated with consumption of bivalve molluscs such as mussels, clams, oysters and scallops that accumulate toxins produced by microscopic algae such as dinoflagellates and diatoms, and cyanobacteria.</rdfs:comment>
        <rdfs:label>shellfish poisoning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11579"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11715"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11951"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11990"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12073 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12073">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n. Fistula or prosthetic device that diverts fluid from one system to another. vb. To bypass or divert.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>shunt</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12074 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12074">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Health effects or loss of a sense of well-being associated, by those who experience it, with time spent in a certain building or room.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Neurological symptoms include headache, irritability, and fatigue.</rdfs:comment>
        <rdfs:comment>Potential causes include poor ventilation and indoor air quality, outgassing of volatile substances from building materials, molds, and ozone build-up from office machines. Psychological factors may play a role.</rdfs:comment>
        <rdfs:label>sick building syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11800"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12075 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12075">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for visualization of macromolecules such as nucleic acids and proteins, typically in electrophoretic gels or formalin-fixed histological sections, based on the reduction of silver salts to metallic silver or formation of crystalline silver compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>silver staining</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11794"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12076 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12076">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure to assess psychomotor speed in which a test subject is presented at irregular intervals with a visual stimulus, such as a coloured dot on a screen, and is asked to press a button immediately after noticing the stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Many variations of the test exist.</rdfs:comment>
        <rdfs:comment>Premature or untimely late reactions should be minimized during an initial practise phase.</rdfs:comment>
        <rdfs:label>simple reaction time test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11925"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12077 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12077">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acronym for the constellation of signs salivation, lacrymation, urination, defecation, dyspnea/gastrointestinal upset, and emesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>SLUDGE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Sometimes used as an acronym to remember functions of the parasympathetic nervous system.</rdfs:comment>
        <rdfs:comment>These are consequences of stimulation of the parasympathetic nervous system by some poisons such as mushroom toxins, nerve gases, or organophosphateinsecticides.</rdfs:comment>
        <rdfs:label>SLUDDE</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11750"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11979"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12077"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SLUDGE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12078 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12078">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Behavioral test wherein a rodent stranger is placed in the cage of a domestic rodent and intensities and duration of interactions (e.g., sniffing, aggression, avoidance) between the socially unacquainted animals are observed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>social interaction test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12079 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12079">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance producing sleep.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>soporific</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12080 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12080">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sudden involuntary contraction of one or more muscles; includes cramps and contractures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>spasm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11692"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11699"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12081 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12081">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that relieves smooth muscle spasms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>spasmolytic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12082 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12082">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to spasticity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>spastic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12083"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12083 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12083">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increased muscle tone at rest, characterized by resistance to passive stretch.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Increased deep tendon reflexes and clonus are additional manifestations.</rdfs:comment>
        <rdfs:label>spasticity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12084 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12084">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a class of lipids containing the aliphatic amino alcohol sphingosine, or related structures, thus including ceramide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Abnormal sphingolipid metabolism is associated with lipid storage diseases such as Tay–Sachs and Niemann–Pick diseases.</rdfs:comment>
        <rdfs:label>sphingolipid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11667"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12086"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12085 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12085">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a family of phospholipids found especially in the central nervous system, containing 1-phosphocholine bound to a ceramide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>sphingomyelin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11667"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12086 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12086">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Major lipid component of cell membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>2-aminooctadec-4-ene-1,3-diol</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sphingosine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12084"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12085"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12087 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12087">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rapid physiological and psychological response to a sudden, unexpected stimulus that includes muscle contraction and avoidance posturing, with an increase in heart rate, respiration, skin conductance, and a negative affect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>startle part</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>startle response</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the startle response test, types and intensities of reactions (e.g., motor activity) are evaluated.</rdfs:comment>
        <rdfs:label>startle reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11692"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12088 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12088">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The earliest brainstem-mediated part of the reflex reaction to a stimulus perceived as threatening.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The Moro reflex in the newborn is a distinct but related response to a fear of falling, usually characterized by spreading of the arms and crying.</rdfs:comment>
        <rdfs:label>startle reflex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12044"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12089 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12089">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurophysiological examination in which an animal is exposed to a brief (e.g., \(\pu{40 ms}\)) acoustic stimulus, followed by measurement of the animal’s motor reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>acoustic startle response test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11883"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12087"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12090 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12090">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Repeated or prolonged seizure lasting more than \(\pu{30 min}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>status epilepticus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12091 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12091">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Three dimensional interpretation of two dimensional cross sections of tissue and other materials.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often used for estimating the number of neurons or neuronal cell bodies in a volume of tissue.</rdfs:comment>
        <rdfs:comment>Stereology is different from tomography; the latter requires a complete set of planes to reconstruct the internal structure whereas stereology uses statistical methods to reconstruct the image from representative plane sections.</rdfs:comment>
        <rdfs:label>stereology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12092 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12092">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stereological method that uses systematic analysis of defined spatial fractions of a sample to estimate numbers of neuronal nuclei independent of changes in size and shape that may occur during tissue processing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>unbiased stereology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12091"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12093 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12093">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that rouses or increases mental or physical activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>stimulant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12094 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12094">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anything that produces a reaction in an organism. That which causes a response in an excitable tissue such as a nerve, muscle or gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>stimulus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12095 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12095">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stimulus that comes to evoke a response after repetitive pairing with another stimulus that automatically elicits that response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>conditioned stimulus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11687"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12096"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12096 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12096">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stimulus that automatically elicits a paired response, such as food eliciting salivation in a hungry animal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>unconditioned stimulus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12094"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12097 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12097">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subcortical structure of striations of gray matter and white matter in the forebrain that serves as the major input to the basal ganglia, specifically the caudate nucleus, the putamen and the striated structure linking them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>striatum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11665"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11698"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12035"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12098 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12098">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute impairment of circulation to a part of the brain, lasting more than \(\pu{24 h}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>stroke</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12099 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12099">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of impaired consciousness showing diminution in response to environmental stimulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>stupor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12100 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12100">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Underneath the arachnoid membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>subarachnoid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12101 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12101">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of blood into the space between the arachnoid membrane and the pia mater.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>subarachnoid hemorrhage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12010"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12102 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12102">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Between the dura mater and the arachnoid membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>subdural</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12103 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12103">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of the basal ganglia involved in production of the neurotransmitterdopamine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>substantia nigra</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11723"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12104 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12104">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracranial contents located above the tentorium of the cerebellum, notably the white matter of the cerebrum, often describing functional symptoms of diseases of the white matter that lead to physical and mental disability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>supratentorial</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12105 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12105">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal protrusion of brain structures into compartments above the tentorium, or over the edge of the tentorium, due to increased intracranial pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>supratentorial herniation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12106 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12106">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a test animal (rodent) is forced to swim to avoid drowning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Porsolt forced swimming test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>behavioral despair test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>forced swimming test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Interpretation is controversial, as cessation of swimming could be a learned response to hasten removal by the investigator.</rdfs:comment>
        <rdfs:comment>Most often used to test antidepressants, which increase the time the animal spends in escape-directed swimming behavior.</rdfs:comment>
        <rdfs:label>swimming test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11592"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12120"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12107 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12107">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the autonomic nervous system originating in the thoracic and lumbar regions of the spinal cord that tends to inhibit or oppose the physiological effects of the parasympathetic nervous system, as in tending to reduce digestive secretions, increase the heart rate, and contract blood vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>sympathetic nervous system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11856"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12108 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12108">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n., Substance that produces effects resembling those of impulses transmitted by the postganglionic fibers of the sympathetic nervous system. adj., Having the property of producing such effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>adrenergic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sympathomimetic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11779"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12107"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12109 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12109">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Functional junction between two neurons, where a nerve impulse is transmitted from one neuron to another, by neurotransmitters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>synapse</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12110 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12110">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrow gap between the presynaptic and postsynaptic regions of two communicating neurons, into which neurotransmitters are secreted.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>synaptic cleft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12111 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12111">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Suppression of synaptic transmission.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This may occur presynaptically or postsynaptically, result from electrical or chemical effects, and be deliberately produced or part of a physiological process.</rdfs:comment>
        <rdfs:label>synaptic inhibition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12114"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12112 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12112">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of synapses to form and reform continually, including to allow learning. Malleability of signal strength arising at the level of synaptic transmission.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>synaptic plasticity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12017"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12114"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12113 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12113">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Removal of dysfunctional synapses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>synaptic stripping</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11872"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12114 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12114">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurotransmitter release, diffusion, and receptor binding, propagating an impulse across a synapse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>synaptic transmission</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12115 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12115">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cyst occurring within the spinal cord as a result of accumulation of cerebrospinal fluid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>syrinx</oboInOwl:hasRelatedSynonym>
        <rdfs:label>syringomyelia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12116 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12116">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simple type of test apparatus with three arms shaped like the letter &apos;T.&apos; After placing a rodent in the middle, it is recorded how often the animal enters each arm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Rewards can be used for motivation, or the inborn trend for alternation can be tested.</rdfs:comment>
        <rdfs:comment>The Y-maze is a variation of the T-maze where the apparatus is &quot;Y&quot;-shaped.</rdfs:comment>
        <rdfs:label>T-maze</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11859"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12117 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12117">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally fast heartbeat.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tachycardia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12118 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12118">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which the tail of a rodent is heated and the time taken for the animal to flick its tail (latency) is taken as a measure of the relative degree of antinociception.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tail flick test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11595"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12119"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12119 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12119">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which the tail of a rodent is placed in a hot water bath (typically between \(\pu{54^{\circ}C}\) and \(\pu{58^{\circ}C}\)) and the time it takes the animal to remove the tail from the water is interpreted as a measurement of the relative degree of antinociception.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tail immersion test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11595"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12118"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12120 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12120">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a mouse is suspended by its tail and the time spent attempting to right itself is observed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Both the tail suspension test and the swimming test are sometimes referred to as behavioral despair tests.</rdfs:comment>
        <rdfs:comment>Most often used to test antidepressants, which usually increase the time the animal spends in escape-directed righting behavior.</rdfs:comment>
        <rdfs:label>tail suspension test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11592"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12106"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12121 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12121">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a class of neurodegenerative diseases, including Alzheimer disease, associated with abnormal aggregation of tau proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tauopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11986"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12122"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12179"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a class of proteins that stabilizes microtubules, particularly in neurons, astrocytes, and oligodendrocytes of the central nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Defective tau proteins are associated with dementias such as Alzheimer disease.</rdfs:comment>
        <rdfs:comment>The various tau proteins are splice variants of the single gene microtubule-associated protein tau (MAPT).</rdfs:comment>
        <rdfs:label>tau protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11971"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cleavage product (\(\pu{43 kDa}\)) of the transactive response (TAR) DNA binding protein (TARDBP) that targets TAR DNA and transcriptionally represses HIV-1.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Pathological accumulation of the misfolded protein cleavage product has been associated with frontotemporal dementia and amyotrophic lateral sclerosis.</rdfs:comment>
        <rdfs:label>TDP-43 transcription factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11583"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11774"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11878"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12124">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse responsiveness to heat or cold. Note: It is associated with a number of medical conditions, some physiologically well-defined (as in cold intolerance in hypothyroidism) and others less so (as in reported chronic fatigue syndrome). Phenotype arising from engineered or selected gene mutations in experimental organisms characterized by an altered temperature permissive for optimal growth or survival.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>temperature sensitivity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12125 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the four major lobes of each cerebral hemisphere, situated at the base of the brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It is involved in memory, language comprehension, emotion, and processing sensory input.</rdfs:comment>
        <rdfs:label>temporal lobe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11854"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12126 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12126">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fold of the dura mater separating the cerebrum from the cerebellum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>tentorium cerebelli</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tentorium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12127 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to tetanus, characterized by tonic muscle spasm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tetanic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12128"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sustained muscle contraction. Disease caused by tetanus toxin and characterized by painful, sustained muscle contraction with spasticity and paralysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tetanus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11989"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12083"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12129"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurotoxin produced by the bacterium Clostridium tetani growing in anaerobic conditions, producing the disease tetanus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>tetanospasmin</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Its action is in major part due to suppression of release of the inhibitory neurotransmitter, γ-aminobutyric acid.</rdfs:comment>
        <rdfs:label>tetanus toxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11575"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11952"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12128"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12130 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12130">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ganglioside that binds tetanus toxin, facilitating its internalization at the presynapticneuronal membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tetanus toxin-binding ganglioside</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11781"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12129"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12131 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12131">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurological syndrome characterized by muscle twitches, cramps, and spasms; and in severe forms, by spasm of the muscles of the larynx (laryngospasm) and seizures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often reflecting irritability of the central and peripheral nervous systems resulting from a low concentration of ionized calcium in the serum.</rdfs:comment>
        <rdfs:label>tetany</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11699"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12132 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12132">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Battery of tests typically for the effects of cannabinoids in rodents that includes hypomotility assessed by an open field test, catalepsy assessed by the bar test, hypothermia measured by rectal temperature, and analgesia measured by avoidance of heat, e.g., in the tail immersion test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tetrad test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11631"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12119"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12133 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12133">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurotoxin that inhibits action potentials by blocking sodium ion channels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>4R,4aR,5R,6S,7S,8S,8aR,10S,12S)-2-azaniumylidene-4,6,8,12-tetrahydroxy-6-(hydroxymethyl)-2,3,4,4a,5,6,7,8-octahydro-1H-8a,10-methano-5,7-(epoxymethanooxy)quinazolin-10-olate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TTX</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is produced by bacteria living in symbiosis with fish of the order Tetraodontiformes, including trigger fish and puffer fish.</rdfs:comment>
        <rdfs:label>tetrodotoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11952"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12133"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TTX</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12134 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12134">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Denoting a class of sodium ion channels, found mainly in the heart, that is not blocked by tetrodotoxin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>TTX-insensitive</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Their significance lies in experimental characterization of channel subtypes in neuromuscular physiology, development, and drug design.</rdfs:comment>
        <rdfs:label>tetrodotoxin-insensitive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12133"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12135 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12135">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of an organism toward or away from a mechanical stimulus, physical contact, or spatial discontinuity, as in movement away from touch by a physical stimulus or exploring close to a wall.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>thigmotaxis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12136 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12136">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of the vertebral column of the upper back, between the cervical spine and lumbar spine, in humans consisting of 12 vertebrae designated T1 to T12.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>thoracic spine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11672"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11856"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12169"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12137 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12137">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Level of depolarization that must be reached to trigger an action potential in an excitable cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>threshold potential</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11764"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11818"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12138 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12138">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clot in the cardiovasculature formed from components of the blood, which may be attached to the vessel wall and (or) occlusive.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>thrombus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12139 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12139">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pricking type of paresthesia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tingling</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11996"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12140 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12140">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Continual noise in an ear, such as ringing, buzzing, roaring, or clicking.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>tinnitus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12141 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12141">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Construction of an image of a three-dimensional structure from a series of planar sections obtained with penetrating waves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Wave sources include light (optical tomography), X-rays, an electron beam producing X-rays (electron beam tomography; EBT), and γ-rays (positron emission tomography; PET),</rdfs:comment>
        <rdfs:label>tomography</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12142 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12142">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spasmodic contraction of neck muscles drawing the head to one side with the chin pointing to the other side.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>wry neck</oboInOwl:hasRelatedSynonym>
        <rdfs:label>torticollis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12080"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12143 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12143">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance causing injury to living organisms as a result of physicochemical interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>toxic substance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12144 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12144">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug that calms and pacifies with minimal sedating or depressant effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>A tranquilizer decreases anxiety (i.e., has anxiolytic properties) or agitation without necessarily decreasing awareness or wakefulness. Tranquilizers at higher dose may induce sleep.</rdfs:comment>
        <rdfs:comment>Minor tranquilizers are sedatives, examples of which include benzodiazepines, antihistamines, alcohol, cannabis, and chloral hydrate. Major tranquilizers include antipsychotic drugs and neuroleptics.</rdfs:comment>
        <rdfs:label>tranquilizer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11596"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11598"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12145 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12145">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrical stimulus applied across the skin to excite nerves for therapeutic purposes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>TENS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most often used to control pain.</rdfs:comment>
        <rdfs:label>transcutaneous electronic nerve stimulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12094"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12145"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TENS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12146 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12146">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to an event, such as transmission of a nerve impulse, across a synapse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>transsynaptic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12109"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12147 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12147">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bulging of brain tissue from the cerebrum through the notch of the tentorium, caused by increased intracranial pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>transtentorial herniation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11836"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12148 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12148">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure used to assess limb function and strength, often to evaluate models of peripheral neuropathy, in which a rodent is placed in an enclosed lane upon a surface that can be made to move at variable speed in a retrograde manner, thus allowing observation of the animal’s gait dimension during sustained attempt at forward motion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>A treadmill test with humans is commonly used in a medical setting for assessment of cardiac performance and pulmonary function.</rdfs:comment>
        <rdfs:comment>The test can be modified to provide a test of endurance in the animal, or to test motor coordination and gait.</rdfs:comment>
        <rdfs:label>treadmill test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11884"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12149 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12149">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Repetitive, often regular and usually involuntary oscillatory movement caused by alternating contractions of opposing muscle groups.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>A characteristic tremor originating in cerebellar pathways upon intentional fine movement (&quot;intention tremor&quot;) can occur during alcohol withdrawal.</rdfs:comment>
        <rdfs:comment>A coarse rhythmic (\(\pu{3\!-\! 5 Hz}\)) tremor of the hands and forearms that appears when the muscles are relaxed (&quot;resting tremor&quot;) is characteristic of Parkinson disease.</rdfs:comment>
        <rdfs:comment>There are many causes of tremor, some of them benign.</rdfs:comment>
        <rdfs:label>tremor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12150 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12150">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fifth cranial nerve, supplying sensation to the face and controlling motor activity of mastication.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>trigeminal nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12151 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12151">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Severe, paroxysmal bursts of pain in one or more branches of the trigeminal nerve, often induced by touching trigger points in or about the mouth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>tic douloureux</oboInOwl:hasRelatedSynonym>
        <rdfs:label>trigeminal neuralgia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12150"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12152 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12152">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a class of drugs based on tryptamine that act as serotonin receptor agonists.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Used for pain relief in the treatment of migraine headache.</rdfs:comment>
        <rdfs:label>triptan</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11815"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11983"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12153 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12153">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Not in a conscious state. In psychoanalytic theory, describing feelings and motivations of which one is unaware that nevertheless shape behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>unconscious</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12154 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12154">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anterior projection of the gray matter surrounding the hippocampus, covered by a region of the temporal lobe, involved in olfaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>Often a source of seizures accompanied by hallucinations and a sense of unpleasant odors.</rdfs:comment>
        <rdfs:comment>The uncus may herniate over the notch of the tentorium and compress the third cranial nerve.</rdfs:comment>
        <rdfs:label>uncus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11799"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11970"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12125"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12155 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12155">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neuron whose cell body lies in the cerebral cortex or brainstem and whose axon carries impulses to a lower motor neuron.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>upper motor neuron</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11627"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11855"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12156 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12156">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tenth cranial nerve, arising from the medulla oblongata.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>It carries parasympathetic and motor impulses to the larynx and pharynx, thoracic organs and abdominal viscera, as well as containing afferent fibers that supply information about the state of the organs to the central nervous system.</rdfs:comment>
        <rdfs:label>vagus nerve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11571"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11993"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12157 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12157">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in the diameter of the lumen of a blood vessel (especially in the arteries and arterioles) as a result of contraction of smooth muscles in the vessel walls.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>This results in an increase in vascular resistance followed by an increase in blood pressure.</rdfs:comment>
        <rdfs:label>vasoconstriction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12160"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12158 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12158">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that induces vasorelaxation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>vasodilator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12160"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12159 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12159">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent that induces vasoconstriction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>pressor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vasoconstrictor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vasopressor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12160 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12160">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the diameter of the lumen of the blood vessels as a result of relaxation of smooth muscles in the vessel walls.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>vasodilatation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vasodilation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This results in a decrease in vascular resistance followed by a decrease of blood pressure.</rdfs:comment>
        <rdfs:label>vasorelaxation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12161 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12161">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Contraction of the muscular wall of blood vessels with sustained vasoconstriction possibly leading to tissue ischemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>angiospasm</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vasospasm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12162 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12162">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal toxin generally used for self-defense or predation and usually delivered by a bite or sting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>venom</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12163 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12163">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Normal cavity within an organ, as in the brain or heart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>In the brain there are two lateral ventricles and two midline (called the third and fourth) ventricles.</rdfs:comment>
        <rdfs:comment>The ventricles in the brain are filled with, and produce most of, the cerebrospinal fluid, and play a critical role in its circulation.</rdfs:comment>
        <rdfs:label>ventricle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12164 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12164">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surgical shunt draining cerebrospinal fluid into a cardiac atrium, to relieve pressure in hydrocephalus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ventriculo-atrial shunt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12073"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12165 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12165">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiographic image of the cerebralventricles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ventriculogram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12166 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12166">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enlargement of the cerebralventricles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ventriculomegaly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11671"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12167 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12167">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surgical shunt draining cerebrospinal fluid into the peritoneum of the abdominal cavity, to relieve pressure in hydrocephalus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>ventriculo-peritoneal shunt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12073"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12168 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12168">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrow central part of the cerebellum between the two cerebellar hemispheres.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>vermis cerebelli</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vermis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12169 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12169">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bony structure consisting of the vertebrae and enclosing the spinal cord.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>spine</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vertebral column</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12163"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12170 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12170">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dizziness; an illusion of movement as if the external world were revolving around one’s self or as if one’s self were revolving in space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>vertigo</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12171 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12171">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to maintain concentration or sustain attention over prolonged periods of time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>vigilance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12172 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12172">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decreased vigilance measured as a decline in the ability to maintain an accurate voluntary response to signals with time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>vigilance decrement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12171"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12173 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12173">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the cerebral cortex located in the occipital lobe, responsible for processing the images of sight.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>visual cortex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11969"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12174 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12174">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion channel that opens and closes in response to changes in membrane potential.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>voltage-gated ion channel</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11851"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12175 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12175">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which a rat or mouse is placed in a pool of water and observed to swim, using visual environmental clues, to an invisible submerged platform that allows escape from the water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Morris water maze test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>water navigation test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is intended to test spatial memory and learning.</rdfs:comment>
        <rdfs:label>water maze test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11637"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11859"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12176 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12176">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of aphasia associated with damage to Wernicke’s area or alternatively the medial temporal lobe of the brain, characterized by preservation of speech but with loss of meaningful language and language comprehension.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>fluent aphasia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>receptive aphasia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sensory aphasia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Wernicke aphasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11599"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11647"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12125"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12177"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12177 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12177">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of the brain in superior temporal gyrus of the dominant hemisphere, associated with comprehension of written and spoken language.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Wernicke’s area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11805"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12178 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12178">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Co-existence of Wernicke encephalopathy (with gait, ocular and mental disturbances) and Korsakoff psychosis (severe memory loss, often with aphasia, apraxia or agnosia) caused by vitamin B1 deficiency in the context of chronic alcohol abuse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>alcoholic encephalopathy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Wernicke–Korsakoff syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11572"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11599"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11603"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11752"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12029"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12179 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12179">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neurodegenerative disease observed in the islands of Guam, Indonesia, Japan and Papua New Guinea, showing combinations of characteristics of amyotrophic lateral sclerosis, atypical parkinsonism with dementia, or dementia alone that may present sequentially during life.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>ALS-PDC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Neurotoxins of the cycad plant, such as β-N-methylamino-L-alanine (L-BMAA) produced by symbiotic cyanobacteria, and methylazoxymethanol (MAM), are suspected causative agents.</rdfs:comment>
        <rdfs:comment>Polyproteinopathy, notably tauopathy, is a common causative feature underlying the different clinical manifestations.</rdfs:comment>
        <rdfs:label>Western Pacific amyotrophic lateral sclerosis and parkinsonism–dementia complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11704"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11926"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11952"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11998"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12121"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12179"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ALS-PDC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12180 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12180">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which cards, depicting different arrangements, numbers, and colors of symbols, are presented to the test subject, who is asked to make the most appropriate match of a test card without further instructions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>WCST</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Performance requires integration of higher level cognitive functions and the procedure is sometimes referred to as a frontal lobe test.</rdfs:comment>
        <rdfs:label>Wisconsin card sorting test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11773"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12180"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WCST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12181 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12181">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cessation of exposure to a substance, being characterized by adverse symptoms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:comment>The symptoms may be physiological or psychological in origin.</rdfs:comment>
        <rdfs:label>withdrawal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11564"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12182 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12182">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse event following withdrawal from a person or animal of a drug to which they have been chronically exposed or on which they have become dependent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>withdrawal effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12181"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12183 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12183">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acidic proteolipid protein component of central nervous systemmyelin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <rdfs:label>Wolfgram protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11896"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12184 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12184">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability to extend the wrist as a result of peripheral nerve damage, causing drooping of the hand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Teleky’s sign</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>radial nerve palsy</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>When associated with the effects of lead poisoning on the radial nerve, it is called Teleky’s sign.</rdfs:comment>
        <rdfs:label>wrist drop</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12185 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12185">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tropical fish (Danio rerio) about \(\pu{4 cm}\) long, commonly used as a model organism in developmental biology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-0103"/>
        <oboInOwl:hasRelatedSynonym>Danio rerio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The zebrafish has been used in studies of neurodevelopment, neuronal networks and the blood–brain barrier.</rdfs:comment>
        <rdfs:comment>The zebrafish is also used for alternative toxicity testing; multiple endpoints for developmental neurotoxicity are known.</rdfs:comment>
        <rdfs:label>zebrafish</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.11948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12186 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12186">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of contiguous skeletal atoms in a chain, including their side groups, if any, such that the chain itself can be represented as a chain of segments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>segment</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chain segment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12187 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12187">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rotamer defined by a relative rotation about a skeletal bond of a single-strand chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>bond-conformational state (in polymer science)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A rotational isomeric state is conventionally defined over a sequence of three contiguous skeletal bonds with reference to the dihedral (or torsion) angle (\(\phi\)) between the planes defined by the first two bonds and the second two bonds. For example, for a chain composed of single \(\ce{C-C}\) skeletal bonds, \(\phi \approx 0^{\circ}\) can be used to define the (planar) trans (\(t\)) rotational isomeric state, and \(\phi \approx \pm 120^{\circ}\) to define the gauche\(\pm\) (\(g_{\pm}\)) rotational isomeric states.</rdfs:comment>
        <rdfs:comment>Alternative notations exist. For example, \(\phi = 180°, \pm 60^{\circ}\), respectively, can be used to denote the \(t\) and \(g_{\pm}\) states, which can also be given the symbols \(\rm{T}\), \(\rm{G}^{+}\), and \(\rm{G}^{-}\). The trans and gauche states or conformers are also known as the &quot;antiperiplanar conformers&quot; and &quot;synclinal conformers&quot;. The notation used in Note 1 is that introduced by Flory and co-workers and is now the one most frequently used in polymer science.</rdfs:comment>
        <rdfs:comment>The energies of rotational isomeric states are determined by short-range intramolecular interactions.</rdfs:comment>
        <rdfs:label>rotational isomeric state</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12188 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12188">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conformation of a chain as defined by its sequence of bond-conformational states.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>If no ambiguity results, the word &quot;chain&quot; can be omitted.</rdfs:comment>
        <rdfs:label>chain conformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12189 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12189">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain conformation corresponding to unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>unperturbed conformational state</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12190 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12190">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radius of gyration of a macromolecule in an unperturbed conformational state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>unperturbed radius of gyration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12189"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12191 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12191">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a flexible macromolecule composed of \(n\) mass elements, of masses \(m_{i}\), \(i = 1, 2, \ldots, n\), located at statistical-mechanical mean-square distances \(\lt\!s_{i}^{2}\!\gt\) from the centre of mass, the root-mean-square radius of gyration is the square-root of the mass average of \(\lt\!s_{i}^{2}\!\gt\) over all mass elements, i.e., \[\lt\!s^{2}\!\gt^{1/2}\;= \left(\sum\limits_{i=1}^{n} m_{i} \lt\!s_{i}^{2}\!\gt\!/\sum\limits_{i=1}^{n} m_{i} \right)^{1/2}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The mass elements are usually taken as the masses of the skeletal groups constituting the macromolecule, e.g., \(\ce{-CH2-}\) in poly(methylene).</rdfs:comment>
        <rdfs:comment>The radius of gyration is a parameter characterizing the size of a macromolecule as a time-averaged spherical domain in laboratory coordinates.</rdfs:comment>
        <rdfs:comment>\(\lt\!s_{i}^{2}\!\gt\) is the statistical mechanical average of \(s_{i}^{2}\) over all chain conformations.</rdfs:comment>
        <rdfs:label>root-mean-square radius of gyration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12192 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12192">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a flexible macromolecule composed of \(n\) mass elements, of masses \(m_{i}\) , \(i = 1, 2, \ldots, n\), located at statistical-mechanical mean-square distances \(\lt\!s_{i}^{2}\!\gt\) from the centre of mass, the mean-square radius of gyration is the mass average of \(\lt\!s_{i}^{2}\!\gt\) over all mass elements, i.e., \[\lt\!s^{2}\!\gt = \left(\sum\limits_{i=1}^{n} m_{i} \lt\!s_{i}^{2}\!\gt\!/\sum\limits_{i=1}^{n} m_{i} \right)\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>mean-square radius of gyration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12193 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12193">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Root-mean-square radius of gyration of a macromolecule having unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The traditionally used symbol \(\lt\!s^{2}\!\gt_{\rm{o}}^{1/2}\) is not recommended as it signifies the square root of the unperturbed average, namely, \(\lt \; \gt_{\rm{o}}^{1/2}\) of \(s^{2}\) rather than the root-mean-square, namely, \(\lt \; \gt^{1/2}\) of the unperturbed squared radius, \(s_{\rm{o}}^{2}\).</rdfs:comment>
        <rdfs:label>root-mean-square unperturbed radius of gyration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12191"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12194 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12194">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean-square radius of gyration of a macromolecule having unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>mean-square unperturbed radius of gyration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12192"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12195 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12195">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vector connecting the two ends of a linear chain in a particular conformation, with the chain having unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>unperturbed end-to-end vector</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12188"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12196 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12196">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Magnitude of the unperturbed end-to-end vector.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>unperturbed end-to-end distance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12195"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12197 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12197">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statistical-mechanical mean-square end-to-end distance of a linear chain averaged over all chain conformations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>mean-square end-to-end distance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12188"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12198 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12198">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Root-mean-square end-to-end distance of a chain having unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>If no ambiguity results, the term &quot;unperturbed end-to-end distance&quot; can be used.</rdfs:comment>
        <rdfs:label>root-mean-square unperturbed end-to-end distance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12199 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12199">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean-square end-to-end distance of a chain having unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>\(\lt\!r_{\rm{o}}^{2}\! \gt\) of a hypothetical, sufficiently long, linear chain of identical single skeletal bonds having rotational isomeric states that are independent of each other is given by the equation \[\lt\!r_{\rm{o}}^{2}\!\gt = nl^{2} \frac{(1 + \cos\theta)}{(1 - \cos \theta)} {\cdot} \frac{(1 + \lt\!\cos \phi\!\gt )}{(1 - \lt\!\cos \phi\!\gt)}\] where \(n\) is the number of skeletal bonds of length \(l\) and valence-angle supplement \(\theta\), and \(\lt\!\cos \phi\!\gt\) is the average of the cosine of the dihedral angles \(\phi\) defined over sequences of three contiguous skeletal bonds. This equation is useful for understanding the significance of characteristic ratio, steric factor, and effective bond-length.</rdfs:comment>
        <rdfs:label>mean-square unperturbed end-to-end distance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12187"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12202"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12200 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12200">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Root-mean-square end-to-end distance of a linear freely rotating chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>If no ambiguity results, the term &quot;freely rotating end-to-end distance&quot; can be used.</rdfs:comment>
        <rdfs:label>root-mean-square end-to-end distance of a freely rotating chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12201 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12201">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean-square end-to-end distance of a linear freely rotating chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>\(\lt\!r_{\rm{o,f}}^2\!\gt\) of a hypothetical, sufficiently long, linear freely rotating chain of identical single skeletal bonds is given by the equation \[\lt\!r_{\rm{o,f}}^{2}\!\gt = nl^{2}\frac{(1 + \cos \theta)}{(1 - \cos \theta)}\] where \(n\) is the number of skeletal bonds of length \(l\) and valence-angle supplement \(\theta\).</rdfs:comment>
        <rdfs:label>mean-square end-to-end distance of a freely rotating chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12202 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12202">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Square root of the ratio of the unperturbed mean-square end-to-end distance of a linear chain to its number of skeletal bonds, i.e., \[b = (\lt\!r_{\rm{o}}^{2}\!\gt\!/n)^{1/2}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The effective bond length is a type of characteristic ratio relating to chain structure, cf., characteristic ratio.</rdfs:comment>
        <rdfs:comment>\(b^{2}\) is the unperturbed mean-square end-to-end distance per skeletal bond. For a hypothetical, sufficiently long chain of identical single skeletal bonds having rotational isomeric states that are independent of each other, the equation in mean-square unperturbed end-to-end distance shows that the value of \(b\) depends on the values of \(l\), \(\cos \theta\) and \(\lt\!\cos \phi\!\gt\). In general, for actual chains, the value of \(b\) is still characteristic of the values of the lengths and valence angles of the skeletal bonds and of the dihedral bond-conformational angles, although it may be difficult to write an analytical expression for \(b\).</rdfs:comment>
        <rdfs:label>effective bond length</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12187"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12199"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12203 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12203">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothetical freely jointed chain with the same mean-square end-to-end distance and contour length as an actual linear chain having unperturbed dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The number of links, \(m\), and their length, \(l^{\prime}\), are evaluated from the mean-square end-to-end distance, \(\lt\!r_{\rm{o}}^{2}\!\gt\), and contour length, \(r_{\rm{max}}\), of the actual chain using the equations in freely jointed chain and contour length, with \[m = \frac{r_{\max}^{2}}{\lt\!r_{\rm{o}}^{2}\!\gt} \quad {\rm{and}} \quad l^{\prime} = \frac{\lt\!r_{\rm{o}}^{2}\!\gt}{r_{\max}}\] For example, for polymethylene at room temperature, one freely jointed link is equivalent to about 10 actual \(\ce{C-C}\) skeletal bonds.</rdfs:comment>
        <rdfs:label>equivalent freely jointed chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12197"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12204 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12204">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Segment or link of an equivalent freely jointed chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>equivalent freely jointed link</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>statistical segment</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Kuhn segment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12186"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12203"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12205 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12205">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Length of a Kuhn segment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>freely jointed link length</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>statistical segment length</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Kuhn segment length</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12204"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12206 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12206">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Freely jointed chain subject to the condition that the segments cannot intersect one another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>In the model of a self-avoiding chain, segments are considered to have a finite volume such that two or more cannot occupy the same volume simultaneously.</rdfs:comment>
        <rdfs:comment>The self-avoiding random-walk chain model is used to represent a polymer chain with excluded volume.</rdfs:comment>
        <rdfs:label>self-avoiding random-walk chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12207 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12207">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Depiction of a macromolecule in which its segments are distributed about some point in space.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The point in space is usually chosen as the molecular centre of mass or a chain end.</rdfs:comment>
        <rdfs:label>macromolecular coil</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12186"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12209 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12209">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parameter describing the end-to-end distance of a linear, single-strand macromolecular chain having unperturbed dimensions relative to that of a model macromolecular chain not subject to short-range interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The steric factor, \(\sigma\), Kuhn segment length, \(l^{\prime}\), and persistence length, \(a\), are all measures of chain stiffness.</rdfs:comment>
        <rdfs:label>chain stiffness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12205"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12212 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12212">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the mean-square radius of gyration of a branched molecule, \(\lt\!s_{\rm{b}}^{2}\!\gt\), to that of an otherwise identical linear molecule, \(\lt\!s_{\rm{l}}^{2}\!\gt\), of the same relative molecular mass in the same solvent at the same temperature, i.e., \(g = \lt\!s_{\rm{b}}^{2}\!\gt\!/\!\lt\!s_{\rm{l}}^{2}\!\gt\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>contraction factor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>geometric contraction factor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>radius of gyration contraction factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The \(g\mbox{-}\rm{factor}\) is a quantity characterizing the effects of long-chain branches on the size of a branched molecule.</rdfs:comment>
        <rdfs:label>&lt;i&gt;g&lt;/i&gt;-factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12192"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12211"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12213"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12213 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12213">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the intrinsic viscosity of a branched molecule, \([\eta_{\rm{b}}]\), to that of an otherwise identical linear molecule, \([\eta_{\rm{l}}]\), of the same relative molecular mass in the same solvent at the same temperature, i.e., \(g^{\prime} = [\eta_{\rm{b}}]/[\eta_{\rm{l}}]\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>hydrodynamic contraction factor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>viscosity contraction factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The \(g^{\prime}\mbox{-}\rm{factor}\) is a quantity characterizing the effects of long-chain branches on the size of a branched molecule.</rdfs:comment>
        <rdfs:label>&lt;i&gt;g&lt;/i&gt;′-factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12211"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12212"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12214 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12214">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass divided by amount of substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>If the unit \(\pu{g mol-1}\) unit is used, the numerical values of molar mass, relative molecular mass and relative molar mass are equal.</rdfs:comment>
        <rdfs:comment>In the present context, &quot;amount of substance&quot; is the number of molecules divided by the Avogadro constant, \(N_{\rm{A}} [= \pu{6.02214179(30)E23 mol-1}]\).</rdfs:comment>
        <rdfs:comment>The term &quot;molar&quot; may also be used for entities consisting of more than one molecule, such as complexes, aggregates, micelles, etc.</rdfs:comment>
        <rdfs:label>molar mass</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12215 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12215">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any average of the molar mass, molecular weight, relative molar mass, or relative molecular mass for a non-uniform polymer, with the symbol \(\rm{k}\) specifying the type of average.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>An infinite number of molar-mass averages can in principle be defined, but only a few types of averages are directly accessible experimentally. The most important averages are defined in terms of simple moments of the distribution functions and are obtained by methods applied to systems in thermodynamic equilibrium, such as osmometry, static light scattering, and sedimentation equilibrium. Hydrodynamic methods, as a rule, yield more complex molar-mass averages.</rdfs:comment>
        <rdfs:comment>Any molar-mass average can be defined in terms of mass fractions or mole fractions. In this document, the most important molar-mass averages are defined in terms of the mass fraction, \(w_{\rm{M}}\), of the species of molar mass \(M\). These definitions are most closely related to experimental determinations of molar-mass averages.</rdfs:comment>
        <rdfs:comment>Quantities molecular-weight average, relative-molar-mass average, and relative-molecular-mass average (\(M_{\rm{r,k}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:comment>The various symbols that \(\rm{k}\) can be are given in the terms number-average molar mass, mass-average molar mass, z-average molar mass, (z+1)-average molar mass, and viscosity-average molar mass. For example, with \(\rm{k} \equiv n\), number-average quantities are defined.</rdfs:comment>
        <rdfs:label>molar-mass average</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12214"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12216"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12217"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12218"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12220"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12216 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12216">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The equation for number-average molar mass is \[M_{\rm{n}} = \frac{1}{\sum\limits_{M} (w_{M}/M)}\] The equation for number-average molecular weight  is \[M_{\rm{r,n}} = \frac{1}{\sum\limits_{M_{\rm{r}}}(w_{M_{\rm{r}}}/M_{\rm{r}})}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For definition of the symbols, see molar-mass average.</rdfs:comment>
        <rdfs:comment>Quantities number-average molecular weight, number-average relative molar mass, and number-average relative molecular mass (\(M_{\rm{r,n}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:label>number-average molar mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12215"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12217 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12217">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The equation for mass-average molar mass is \[M_{\rm{m}} \equiv M_{\rm{w}} = \sum\limits_{M} w_{M}M\] The equation for mass-average molecular weight  is \[M_{\rm{r,m}} \equiv {M_{\rm{r,w}}} = \sum\limits_{M_{\rm{r}}} w_{M_{\rm{r}}} M_{\rm{r}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For definition of the symbols, see molar-mass average.</rdfs:comment>
        <rdfs:comment>Quantities mass-average molecular weight, mass-average relative molar mass, and mass-average relative molecular mass (\(M_{\rm{r,m}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:label>mass-average molar mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12215"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12218 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12218">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The equation for z-average molar mass is \[M_{\rm{z}} = \frac{\sum\limits_{M} w_{M}M^{2}}{\sum\limits_{M} w_{M}M}\] The equation for z-average molecular weight is \[M_{\rm{r,z}} = \frac{\sum\limits_{M_{\rm{r}}} w_{M_{\rm{r}}}M_{\rm{r}}^{2}}{\sum\limits_{M_{\rm{r}}} w_{M_{\rm{r}}}M_{\rm{r}}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For definition of the symbols, see molar-mass average.</rdfs:comment>
        <rdfs:comment>Quantities z-average molecular weight, z-average relative molar mass, and z-average relative molecular mass, (\(M_{\rm{r,z}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:label>z-average molar mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12215"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12219 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12219">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The equation for (z + 1)-average molar mass is \[M_{\rm{z+1}} = \frac{\sum\limits_{M} w_{M}M^{3}}{\sum\limits_M w_{M}M^{2}}\] The equation for (z + 1)-average molecular weight is \[M_{\rm{r,z+1}} = \frac{\sum\limits_{M_{\rm{r}}} w_{M_{\rm{r}}}M^{3}}{\sum\limits_{M_{\rm{r}}} w_{M_{\rm{r}}}M^{2}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For definition of the symbols, see molar-mass average.</rdfs:comment>
        <rdfs:comment>Quantities (z + 1)-average molecular weight, (z + 1)-average relative molar mass, and (z + 1)-average relative molecular mass (\(M_{\rm{r,z+1}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:label>(z + 1)-average molar mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12215"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12220 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12220">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The equation for viscosity-average molar mass is \[M_{\rm{v}} = \left[\sum\limits_{M} w_{M}M^{a} \right]^{1/a}\] The equation for viscosity-average molecular weight is \[M_{\rm{r,v}} = \left[\sum\limits_{M_{\rm{r}}} w_{M_{\rm{r}}}M_{\rm{r}}^{a} \right]^{1/a}\] where \(a\) is the exponent in the Mark–Houwink equation, \([\eta] = KM^{a}\)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For definition of the symbols, see molar-mass average.</rdfs:comment>
        <rdfs:comment>Quantities viscosity-average molecular weight, viscosity-average relative molar mass, and viscosity-average relative molecular mass (\(M_{\rm{r,v}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:comment>The exponent \(a\) is different from the adjustable parameter of some of the distribution functions and from the persistence length.</rdfs:comment>
        <rdfs:label>viscosity-average molar mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12215"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12221 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12221">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molar mass, molecular weight, relative molar mass, or relative molecular mass calculated from experimental data without the application of appropriate corrections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>Examples of corrections are those for finite polymer concentration, association, preferential sorption, compositional heterogeneity, constitutional heterogeneity, and also from experimental data obtained from an instrument (often an SEC instrument) calibrated using standard samples of known molar masses of a polymer constitutionally different from that being analysed.</rdfs:comment>
        <rdfs:comment>Quantities apparent molecular weight, apparent relative molar mass, and apparent relative molecular mass (\(M_{\rm{r,app}}\)) are synonyms. These quantities are dimensionless (pure numbers) and are not associated with any units.</rdfs:comment>
        <rdfs:label>apparent molar mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12214"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12222 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12222">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cumulative distribution function in which the relative amount of a portion of a substance with values of the random variable or variables less than or equal to a given value or given values is expressed in terms of mole fraction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>cumulative number distribution</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>integral number distribution</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>integral number-distribution function</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cumulative number-distribution function</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12223 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12223">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cumulative distribution function in which the relative amount of a portion of a substance with values of the random variable or variables less than or equal to a given value or given values is expressed in terms of mass fraction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>cumulative mass distribution</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>integral mass distribution</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>integral mass-distribution function</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is the differential and cumulative mass-distribution functions that are usually determined experimentally.</rdfs:comment>
        <rdfs:label>cumulative mass-distribution function</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12224 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12224">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the mass-average molar mass, \(M_{\rm{m}}\), molecular weight, relative molar mass, or relative molecular mass, \(M_{\rm{r,m}}\), to the number-average molar mass, \(M_{\rm{n}}\), molecular weight, relative molar mass, or relative molecular mass, \(M_{\rm{r,n}}\). \[Ð\!_{\rm{M}} = M_{\rm{m}}/M_{\rm{n}} = M_{\rm{r,m}}/M_{\rm{r,n}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>molecular-weight dispersity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>relative-molar-mass dispersity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>relative-molecular-mass dispersity</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Use of the term &quot;polydispersity index&quot;, or other terms involving the word &quot;polydispersity&quot;, for \(M_{\rm{m}}/M_{\rm{n}}\), \(M_{\rm{r,m}}/M_{\rm{r,n}}\) is strongly discouraged.</rdfs:comment>
        <rdfs:label>molar-mass dispersity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12217"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12225 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12225">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the mass-average degree of polymerisation, \(X_{\rm{m}}\), to the number-average degree of polymerisation, \(X_{\rm{n}}\). \[Ð\!_{\rm{X}} = X_{\rm{m}}/X_{\rm{n}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>Use of the term &quot;polydispersity index&quot;, or other terms involving the word &quot;polydispersity&quot;, for \(X_{\rm{m}}/X_{\rm{n}}\) is strongly discouraged.</rdfs:comment>
        <rdfs:label>degree-of-polymerisation dispersity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12226 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12226">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of \(M_{\rm{m}}\) to \(M_{\rm{n}}\), or the ratio of \(X_{\rm{m}}\) to \(X_{\rm{n}}\) for a homopolymer or an alternating copolymer of sufficiently large molar mass, such that the effects of the distinct structures of the end-groups of the constituent macromolecules can be neglected, giving \(X_{\rm{n}}\) directly proportional to \(M_{\rm{n}}\), \(X_{\rm{m}}\) directly proportional to \(M_{\rm{m}}\) and \(Ð\!_{\rm{M}} = Ð\!_{\rm{X}} = Ð\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>Dispersity is a measure of the dispersion (or spread) of a molar mass, molecular weight, relative molar mass, relative molecular mass, or degree-of-polymerisation distribution function. For a uniform polymer, \(Ð = 1\); for a polymer of sufficiently high \(X_{\rm{n}}\) having a Poisson distribution of molar masses, molecular weights, relative-molar-masses, or relative-molecular-masses, \(Ð \cong 1\); and for a polymer of sufficiently high \(X_{\rm{n}}\) having a most probable distribution of molar masses, molecular weights, relative-molar-masses, or relative-molecular-masses, \(Ð \cong 2\).</rdfs:comment>
        <rdfs:comment>For a copolymer that is not an alternating copolymer \(X_{\rm{n}}\) cannot be considered to be directly proportional to \(M_{\rm{n}}\), nor \(X_{\rm{w}}\) directly proportional to \(M_{\rm{w}}\). It is then necessary to state whether \(Ð\!_{\rm{M}}\) or \(Ð\!_{\rm{X}}\) is being used.</rdfs:comment>
        <rdfs:label>dispersity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12214"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12228 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12228">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer solution in the concentration range at which the domains occupied by the dissolved macromolecules or entities start to overlap.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The semi-dilute solution behaviour sets in at concentrations larger than the overlap concentration, \(c^{\ast}\).</rdfs:comment>
        <rdfs:label>semi-dilute solution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12229 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12229">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer solution in the concentration range at which the domains occupied by the dissolved macromolecules or entities overlap to such an extent that it is not possible to distinguish the individual domains from one another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The limiting maximum mass concentration is the density of the bulk amorphous polymer.</rdfs:comment>
        <rdfs:label>concentrated solution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12230 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12230">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Entanglement, involving one or more macromolecular chains, of duration at least equal to the period of observation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>A volume element, in which the chains of two or more macromolecules are entangled, acts as a temporary junction point of a transient polymer network, such as can occur in a semi-dilute solution or a concentrated solution.</rdfs:comment>
        <rdfs:label>entanglement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12228"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12229"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12231 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12231">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average distance between two adjacent entanglements on a given macromolecule in a semi-dilute solution, a concentrated solution, or bulk amorphous polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>mesh size</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12228"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12229"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12232 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12232">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothetical spherical volume element occupied by a subchain of a macromolecule between two neighbouring entanglements on the same macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>It is assumed that the behaviours of portions of a macromolecule separated by more than the size of a blob are not correlated with each other.</rdfs:comment>
        <rdfs:comment>The size of a blob is a scaling function of concentration and temperature.</rdfs:comment>
        <rdfs:label>blob</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12233 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12233">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation of the type \(y = k x^{a}\), relating two physical quantities, \(x\) and \(y\ (\rm{g})\), in which the value of the exponent \(a\) can be predicted by theory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>It has been shown that scaling laws are particularly useful in the description of semi-dilute polymer solutions.</rdfs:comment>
        <rdfs:comment>The constant \(k\) cannot be predicted from theory and must be determined experimentally.</rdfs:comment>
        <rdfs:label>scaling law</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12234 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12234">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference between specific volume of an amorphous polymer and that of its perfect crystalline form.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>free volume</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12235 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12235">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory reducing the difficult exact evaluation of interactions in a multi-body system to a simpler but approximate evaluation of an average effective interaction of one body with its surroundings.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>mean-field theory</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12236 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12236">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in solubility of a polymer in a solvent comprising more than one component, each component of which by itself is a solvent for the polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>Poly(N-isopropylacrylamide) in water/methanol and poly(vinyl alcohol) in dimethylsulfoxide/water are examples of systems in which co-nonsolvency occurs.</rdfs:comment>
        <rdfs:label>co-nonsolvency</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12237 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12237">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for measuring osmotic pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>osmometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12238 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12238">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement of the osmotic pressure of a solution using an osmometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The osmometry of a dilute solution of polymer is an absolute method for determining the number-average molar mass of the polymer and the osmotic virial coefficients of the solution.</rdfs:comment>
        <rdfs:label>osmometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12216"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12227"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12237"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12239 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12239">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coefficient in the expansion of the chemical potential of the solvent, \(\mu_{\rm{s}}\), in powers of the mass concentration, \(c\), of the solute, i.e., \[\mu_{\rm{s}} - \mu_{\rm{s}}^{\circ} = -\mathit{\Pi} V_{s}^{\prime} = -RT V_{s}^{\prime} (A_{1}c + A_{2}c^{2} + A_{3}c^{3} + \ldots)\] where \(\mu_{\rm{s}}^{\circ}\) is the chemical potential of the solvent in the reference state at the temperature of the system and ambient pressure, \(\mathit{\Pi}\) is the osmotic pressure and \(V_{s}^{\prime}\) is the partial molar volume of the solvent. In solvents comprising more than one component, the definition applies to any solvent component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>virial coefficient of the chemical potential</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The factor \(RT\) is sometimes included in the virial coefficients, to give \[\mu_{\rm{s}} - \mu_{\rm{s}}^{\circ} = -\mathit{\Pi}V_{s}^{\prime} = -V_{s}^{\prime}(A_{1}^{\prime}c + A_{2}^{\prime}c^{2} + A_{3}^{\prime}c^{3} + \dots),\quad {\rm{where}}\ A_{i}^{\prime} = RT A_{i}\]</rdfs:comment>
        <rdfs:comment>The first osmotic virial coefficient is the reciprocal number-average molar mass, i.e., \(A_{1} = 1/M_{\rm{n}}\). The values of the second and higher virial coefficients, \(A_{2}, A_{3}, \dots\), respectively, are characteristic of polymer-solvent and polymer-polymer interactions.</rdfs:comment>
        <rdfs:comment>To evaluate \(M_{\rm{n}}\) and \(A_{2}\), \(\mathit{\Pi}/c\) is often plotted versus \(c\), so that \[\frac{\mathit{\Pi}}{c} = \left({\frac{\mathit{\Pi}}{c}} \right)_{\circ}(1 + \mathit{\Gamma}_{2}c + \mathit{\Gamma}_{3}c^{2} + \ldots),\ {\rm{where}}\ \left(\frac{\mathit{\Pi}}{c} \right)_{\circ} = \frac{RT}{M_{\rm{n}}}\ {\rm{and,}}\ \mathit{\Gamma}_{i} = M_{\rm{n}}A_{i}\]</rdfs:comment>
        <rdfs:label>osmotic virial coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12216"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12240 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12240">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Curve in the isobaric temperature-composition plane for a mixture defining the region of composition and temperature across which a transition occurs from miscibility of the components to conditions where single-phase mixtures are metastable or unstable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>binodal curve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>coexistence curve</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Binodal compositions are defined by pairs of points on the curve defining the dependence of Gibbs energy of mixing on composition that have common tangents, corresponding to compositions of equal chemical potentials of each of the two components in two phases.</rdfs:comment>
        <rdfs:label>binodal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12241 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12241">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Point in the isobaric temperature-composition plane of a binary or multicomponent mixture at which a decrease in transparency is observed due to the turbidity caused by phase separation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>A cloud point can be induced by varying temperature or composition.</rdfs:comment>
        <rdfs:comment>A cloud point induced by varying temperature is heating-rate or cooling-rate dependent.</rdfs:comment>
        <rdfs:comment>A cloud point is characterized by the first appearance of turbidity or cloudiness.</rdfs:comment>
        <rdfs:label>cloud point</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12242 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12242">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Curve of temperature vs. composition defined by the cloud points over range of compositions of two substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>cloud-point curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12243 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12243">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at a cloud point.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>cloud-point temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12244 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12244">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Critical temperature below which a mixture is miscible at any composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>LCST</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An LCST exists for mixtures in which solubility decreases with temperature.</rdfs:comment>
        <rdfs:comment>For a mixture containing or consisting of polymeric components, these may be different polymers or species of different molar mass of the same polymer.</rdfs:comment>
        <rdfs:comment>The LCST depends upon pressure and the molar-mass distribution functions of the constituent polymer(s).</rdfs:comment>
        <rdfs:comment>The LCST occurs near the minimum on the cloud point curve.</rdfs:comment>
        <rdfs:comment>The occurrence of an LSCT is less common than that of an upper critical solution temperature. It cannot be explained by simple polymer solution theories, such as the Flory–Huggins theory. However, it occurs for several polymer/solvent pairs and frequently for polymer blends.</rdfs:comment>
        <rdfs:label>lower critical solution temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12214"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12241"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12244"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LCST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12245 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12245">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which the equilibrium statistical distribution of positions of molecules or entities in space is maintained or restored due to their translational Brownian motion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>translational diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12246 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12246">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Frictional force, \(F\), per unit velocity, \(u\), experienced by an isolated spherical body moving unidirectionally in a viscous isotropic fluid, i.e., \(F = fu\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>frictional coefficient (in polymer science)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>More generally, \(\boldsymbol{f}\) is defined as the tensor that correlates the vectorial frictional force, \(\boldsymbol{F}\), on a body in a viscous fluid and the vectorial velocity, \(\boldsymbol{u}\) , with \(\boldsymbol{F} = \boldsymbol{f}\boldsymbol{u}\). However, the more general definition is not needed in polymer science as experimental determinations of the translational frictional coefficient all employ situations in which \(\boldsymbol{F}\) and \(\boldsymbol{u}\) are collinear and \(F = fu\).</rdfs:comment>
        <rdfs:comment>\(f\) is related to the translational diffusion coefficient, \(D\), of an isolated body by the Einstein equation \(D = kT/f\), where \(k\) is the Boltzmann constant and \(T\) the thermodynamic temperature.</rdfs:comment>
        <rdfs:label>translational frictional coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12247"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12247 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12247">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportionality constant relating the flux per unit area, \(J_{n}\), in unidirectional flow of amount, \(n\), of entities \(\ce{B}\) to their concentration gradient in the direction (\(x\)) of flow, \({\rm{d}}c_{\ce{B}}/{\rm{d}}x\), i.e., \(J_{n} = -D{\rm{d}} c_{\ce{B}}/{\rm{d}}x\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>diffusion coefficient (in polymer science)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>More generally, \(D\) is defined using vectorial flow as the proportionality constant, relating the flux per unit area, \(\boldsymbol{J_{n}}\) , of amount, \(n\), of entities \(\ce{B}\) to their concentration gradient, \(\boldsymbol{\nabla} c_{\ce{B}}\), i.e., \(J_{n} = -D \boldsymbol{\nabla} c_{\ce{B}}\). However, the more general definition is not needed in polymer science as experimental determinations of the translational diffusion coefficient all employ unidirectional flow.</rdfs:comment>
        <rdfs:label>translational diffusion coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12248 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12248">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Torque, \(T\), per unit angular velocity, \(\omega\), required for rotation of a body about a given axis in a viscous isotropic fluid, i.e., \(T = \zeta\omega\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>A body whose shape is described by principal axes, \(\rm{a}\), \(\rm{b}\), and \(\rm{c}\), of different lengths has three different rotational frictional coefficients denoted by \(\zeta_{\rm{a}}\), \(\zeta_{\rm{b}}\), and \(\zeta_{\rm{c}}\), relating to rotation about the axes \(\rm{a}\), \(\rm{b}\), and \(\rm{c}\), respectively, and three different rotational diffusion coefficients, \(\mathit{\Theta}_{\rm{a}}\), \(\mathit{\Theta}_{\rm{b}}\), and \(\mathit{\Theta}_{\rm{c}}\), where, for an isolated body in a viscous isotropic fluid, \(\mathit{\Theta}_{\rm{a}} = kT/\zeta_{\rm{a}}\), \(\mathit{\Theta}_{\rm{b}} = kT/\zeta_{\rm{b}}\), and \(\mathit{\Theta}_{\rm{c}} = kT/\zeta_{\rm{c}}\).</rdfs:comment>
        <rdfs:comment>\(\zeta\) is related to the rotational diffusion coefficient, \(\mathit{\Theta}\), of an isolated body in a viscous isotropic fluid by the equation \(\mathit{\Theta} = kT/\zeta\), where \(k\) is the Boltzmann constant and \(T\) the absolute temperature.</rdfs:comment>
        <rdfs:label>rotational frictional coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12249 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12249">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental method by which the distribution of the concentration of the solute or dispersed component in a dilute solution or dispersion along the centrifuge cell is measured at sedimentation equilibrium, and the results are interpreted in terms of the molar masses of the solute species or their distribution functions, or both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>sedimentation-equilibrium method</oboInOwl:hasRelatedSynonym>
        <rdfs:label>equilibrium sedimentation method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12214"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12250 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12250">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equilibrium sedimentation method using a multicomponent solvent forming a density gradient in a centrifugal field.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>sedimentation equilibrium in a density gradient</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Equilibrium sedimentation in a density gradient can be used to determine the compositional heterogeneity of copolymers.</rdfs:comment>
        <rdfs:label>equilibrium sedimentation in a density gradient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12249"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12251 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12251">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation describing the dependence of the inherent viscosity, \(\eta_{\rm{inh}}\), of a dilute solution on the mass concentration of the solute, \(c\), with \[\eta_{\rm{inh}} = (\ln \eta_{\rm{r}})/c = [\eta] + k_{\rm{K}}[\eta]^{2} c\] where \(k_{\rm{K}}\) is the Kraemer coefficient and \([\eta]\) is the intrinsic viscosity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>Kraemer equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12252 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12252">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parameter in the Kraemer equation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>Kraemer coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12251"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12253 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12253">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a solution or dispersion, the perturbation of the flow of the solvent continuum or dispersing medium continuum around a solute molecule, a segment of a dissolved macromolecule or dispersed entity caused by the presence of the other solute molecules, segments, or dispersed entities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>hydrodynamic interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12254 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12254">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjective describing the undisturbed flow of solvent through the domain of a dissolved macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>freely draining</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Free-draining flow occurs in the limit of zero hydrodynamic interaction.</rdfs:comment>
        <rdfs:label>free-draining</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12253"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12255 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12255">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjective describing the flow behaviour of a macromolecule in solution or a dispersed entity when, due to hydrodynamic interaction, the solvent or dispersion medium within the domain of the macromolecule or dispersed entity is essentially immobilised and moves with the dissolved macromolecule or dispersed entity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>non-free-draining</oboInOwl:hasRelatedSynonym>
        <rdfs:label>impermeable</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12253"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12256 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12256">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjective describing the flow behaviour of a macromolecule in solution or a dispersed entity when, due to hydrodynamic interaction, the solvent within the domain of the macromolecule or a dispersed entity becomes progressively more immobilised with respect to the macromolecule or a dispersed entity in the direction from its outer fringes inward.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>partially draining</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Free-draining and impermeable behaviour are two extremes of the concept of partial free-draining behaviour.</rdfs:comment>
        <rdfs:label>partial free-draining</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12253"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12254"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12255"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12257 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12257">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of the hydrodynamically equivalent sphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The molar equivalent hydrodynamic volume determined using measurements of intrinsic viscosity, \([\eta]\), is \(V_{\eta}\), where \(V_{\eta} = [\eta]M/N_{\rm{A}}\), with \(M\) the molar mass and \(N_{\rm{A}}\) the Avogadro constant.</rdfs:comment>
        <rdfs:label>equivalent hydrodynamic volume</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12258 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12258">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radius of the hydrodynamically equivalent sphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>equivalent hydrodynamic radius</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12259 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12259">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an isolated dissolved molecule or dispersed entity, an equation relating the translational frictional coefficient, \(f\), to the equivalent hydrodynamic radius in translational diffusive flow, \(r_{D}\), and to the viscosity of the solvent continuum or the dispersion medium continuum, \(η_{0}\), with \[f = 6\uppi \eta_{0}r_{D}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>Stokes equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12246"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12258"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12260 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12260">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an isolated dissolved molecule or dispersed entity, an equation relating the translational diffusion coefficient, \(D\), to the equivalent hydrodynamic radius in translational diffusive flow, \(r_{D}\) , and to the viscosity of the solvent continuum or the dispersion medium continuum, \(\eta_{0}\), with \[D = kT/(6\uppi \eta_{0}r_{D})\] where \(k\) is the Boltzmann constant, and \(T\) the thermodynamic temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The Stokes–Einstein equation is derived by combining the Stokes equation with the Einstein equation \(D = kT/f\).</rdfs:comment>
        <rdfs:label>Stokes–Einstein equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12246"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12247"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12258"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12261 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12261">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an isolated dissolved molecule or dispersed entity, an equation relating the rotational diffusion coefficient, \(\mathit{\Theta}\), to the equivalent hydrodynamic radius in rotational diffusive flow, \(r_{\mathit{\Theta}}\), and to the viscosity of the solvent continuum or the dispersion medium continuum, \(\eta_{0}\), with \[D = kT/(6\pi \eta_{\rm{0}} r_{\mathit{\Theta}}^3)\] where \(k\) is the Boltzmann constant and \(T\) the thermodynamic temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>Perrin equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12258"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12262 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12262">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model describing the flow behaviour of a dissolved chain macromolecule in terms of a freely jointed sequence of beads, each of which offers hydrodynamic resistance to the flow of the surrounding solvent continuum and is connected to the next bead by a rigid rod that offers no hydrodynamic resistance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>bead-rod model</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pearl-necklace model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12263 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12263">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory, based on the pearl-necklace model, that describes the translational diffusive and viscous flows of an isolated linear macromolecule in solution in the theta state and accounts for the gradual change from free-draining behaviour at lower molecular weights to impermeable behaviour at higher molecular weights.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The Kirkwood–Riseman theory is usually applied in the impermeable limit when it essentially relates the equivalent hydrodynamic radius to the root-mean-square unperturbed radius of gyration, \(\lt\!s_{\circ}^{2}\!\gt\), with \[r_{D} = 0.675 \lt\!s_{\circ}^{2}\!\gt^{1/2}\] and \[r_{\eta} = 0.256 \lt\!s_{\circ}^{2}\!\gt^{1/2}\] where \(r_{D}\) and \(r_{\eta}\) are the equivalent hydrodynamic radii in translational diffusive flow and viscous flow.</rdfs:comment>
        <rdfs:label>Kirkwood–Riseman theory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12254"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12255"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12258"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12262"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12264 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12264">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assumption that the Kirkwood–Riseman theory can be applied to linear isolated macromolecules in solution, independent of whether they are in the theta state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The Kirkwood–Riseman relationships between \(r_{D}\) and \(r_{\eta}\) and the root-mean-square radius of gyration, \(\lt\!s^{2}\!\gt\), are then \[r_{D} = 0.675 \lt\!s^{2}\!\gt^{1/2} = 0.675 \lt\!s_{\circ}^{2}\!\gt^{1/2} \alpha_{D}\] and \[r_{\eta} = 0.256 \lt\!s^{2}\!\gt^{1/2} = 0.256 \lt\!s_{\circ}^{2}\!\gt^{1/2} \alpha_{\eta}\] where \(r_{D}\) and \(r_{\eta}\) are the equivalent hydrodynamic radii in translational diffusive flow and viscous flow, and \(\alpha_{D}\) and \(\alpha_{\eta}\) are the corresponding expansion factors.</rdfs:comment>
        <rdfs:label>Flory–Fox assumption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12191"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12258"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12263"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12265 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12265">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation relating intrinsic viscosity, \(\eta\), and molar mass, \(M\), to the mean-square radius of gyration, with \[[\eta]M = \mathit{\Phi}^{\prime}\!\lt\!s^{2}\!\gt^{3/2}\] where \(\mathit{\Phi}^{\prime}\) is a parameter the value of which depends on the molar-mass distribution, macromolecular constitution, and chain expansion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For a solution in the theta state, \(\mathit{\Phi}^{\prime}\) is denoted \(\mathit{\Phi}_{\uptheta}^{\prime}\) and its value is given by the Kirkwood–Riseman theory, with \(\mathit{\Phi}_{\uptheta}^{\prime} = \pu{4.22E22 mol-1}\).</rdfs:comment>
        <rdfs:comment>The Flory–Fox equation is sometimes written in terms of \(\lt\!r^{2}\!\gt\), the mean-square end-to-end distance, instead of \(\lt\!s^{2}\!\gt\), with \[[\eta]M = \mathit{\Phi} \lt\!r^{2}\!\gt^{3/2}\] where \(\mathit{\Phi} = \mathit{\Phi}^{\prime}/6^{3/2}\). The latter equality assumes that \(\lt\!r^{2}\!\gt = 6\!\lt\!s^{2}\!\gt\), which is only exactly true in the theta state. In this case, \[[\eta]M = \mathit{\Phi}_{\theta}\!\lt\!r^{2}\!\gt^{3/2}\] where \(\mathit{\Phi}_{\theta} = \mathit{\Phi}_{\theta}/6^{3/2} = \pu{2.87E21 mol-1}\).</rdfs:comment>
        <rdfs:comment>\([\eta]M/N_{\rm{A}}\), where \(N_{\rm{A}}\) is the Avogadro constant, is the equivalent hydrodynamic volume in viscous flow, \(V_{\eta}\), with \(V_{\eta} = 4\uppi r_{\eta}^{3}/3\), Hence, the Flory–Fox equation is consistent with the Kirkwood–Riseman theory and the Flory–Fox assumption. (See Notes to Kirkwood–Riseman theory and Flory–Fox assumption.)</rdfs:comment>
        <rdfs:comment>\(\mathit{\Phi}\) is known as the viscosity function or the Flory function.</rdfs:comment>
        <rdfs:label>Flory–Fox equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12192"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12197"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12263"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12264"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12266 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12266">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecular theory for treating polymer chain dynamics based on the bead-spring model assuming the beads (segments) have zero excluded volume and there is no hydrodynamic interaction between the beads.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>Rouse theory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12253"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12267 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12267">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothetical polymer chain satisfying the assumptions made in the Rouse theory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>Rouse chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12266"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12268 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12268">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Snake-like movement of a polymer chain in a semi-dilute or concentrated solution or bulk amorphous polymer through the hypothetical tube created by neighbouring chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>reptation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12228"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12229"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12269 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12269">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model to describe the motion of a polymer chain confined in the hypothetical tube created by neighbouring chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>In the tube model, the polymer chain moves along the hypothetical tube defined by the neighbouring polymer chains. The tube is continually undergoing tube renewal.</rdfs:comment>
        <rdfs:comment>The tube model is an essential concept for reptation.</rdfs:comment>
        <rdfs:label>tube model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12268"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12270 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12270">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dynamic renewal of tubes by the disentanglement and re-entanglement of polymer chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>tube renewal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12271 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12271">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer chain allowed to undergo reptation along the tube created by neighbouring chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The chain can be depicted as a connected sequence of blobs.</rdfs:comment>
        <rdfs:label>primitive chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12232"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12272 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12272">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion of particles of identical size, shape, and constitution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>uniform dispersion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12273 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12273">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion of particles not identical with respect to size, shape, or constitution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>non-uniform dispersion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12274 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12274">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental method based on the measurement of the time-averaged intensity of light scattered from a polymer solutions or a dispersion of particles at various angles with respect to the incident beam.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>SLS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Measurement of the angular dependence of the time-averaged intensity of light scattered from a dilute solution of macromolecules or a dilute dispersion of particles that are not negligibly small with respect to the wavelength of the incident light can be used to evaluate an average radius of gyration of the solute macromolecules or dispersed particles.</rdfs:comment>
        <rdfs:comment>Measurement of the concentration dependence of the intensity of light scattered from a dilute solution of macromolecules or a dilute dispersion of particles yields information on the thermodynamic interaction between the solute and solvent or dispersed particles and dispersion medium in terms of the second osmotic virial coefficient and, less frequently, higher virial coefficients.</rdfs:comment>
        <rdfs:comment>SLS is an absolute method, i.e., one not requiring calibration, for the determination of the molar mass of a macromolecular substance or dispersion of particles.</rdfs:comment>
        <rdfs:label>static light scattering</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12214"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12227"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12239"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12274"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SLS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12275 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12275">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental method based on the measurement of the time autocorrelation function of the intensity of light scattered from a polymer solution or a dispersion of particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <oboInOwl:hasRelatedSynonym>DLS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>photon-correlation spectroscopy (PCS)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>quasi-elastic light scattering (QELS)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The basic information that can be obtained from the time autocorrelation function of a polymer solution or a dispersion is: (i) for a uniform polymer or a uniform dispersion, the diffusion coefficient of the macromolecules or the dispersed particles; (ii) for a non-uniform polymer or a non-uniform dispersion, the distribution function of diffusion coefficients of the macromolecules or the dispersed particles.</rdfs:comment>
        <rdfs:label>dynamic light scattering</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12273"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12275"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DLS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12276 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12276">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule much smaller than the wavelength of the radiation in the solvent used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>For a molecule to be considered to be small, the lengths of all of its dimensions must be less than about one-twentieth of the wavelength employed.</rdfs:comment>
        <rdfs:label>small molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12277 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12277">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule of size similar to or larger than the wavelength of the radiation in the solvent used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>A molecule is treated as large if the length of its largest dimension exceeds about one-twentieth of the wavelength employed.</rdfs:comment>
        <rdfs:label>large molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12278 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12278">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference between the scattering intensity for a dilute solution or a dilute dispersion and that for the pure solvent or the dispersion medium at the same scattering angle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>excess scattering</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12279 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12279">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Function describing the dependence of relative scattering intensity on the magnitude of the scattering vector, \(q\), for a polymer solution or a dispersion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The static structure factor accounts for interference of the scattered radiation within individual macromolecules or individual dispersed particles, described by the form factor, as well as interference of the scattered radiation from different macromolecules or dispersed particles, reflecting the ordering of the positions of the scattering entities.</rdfs:comment>
        <rdfs:label>static structure factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12280 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12280">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Function describing the temporal dependence of relative scattering intensity on the magnitude of the scattering vector, \(q\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:comment>The value of the dynamic structure factor is characteristic of the various modes of motions of the polymer molecules or the dispersed particles and their parts and is also characteristic of the time-dependent interference of scattering, reflecting ordering of the positions of the scattering entities in time. In dynamic light scattering, it can be derived from the time autocorrelation function.</rdfs:comment>
        <rdfs:label>dynamic structure factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12275"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12281 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12281">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time elapsed from the injection of the sample into a chromatography bed to the recording of a specified signal of the detector due to the sample having passed through the bed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>elution time</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12282 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12282">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume of solvent that has passed through a chromatography bed from the injection of the sample to the recording of a specified signal of the detector due to the sample having passed through the bed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2013-0201"/>
        <rdfs:label>elution volume</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12283 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12283">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The anodic transfer coefficient \(\alpha_{\rm{a}}\) and the cathodic transfer coefficient \(\alpha_{\rm{c}}\) are defined by the following equations: \[\alpha_{\rm{a}} = (RT/F)({\rm{d}}\ln\! j_{\rm{a}}/{\rm{d}}E); \quad \alpha_{\rm{c}} = -(RT/F)({\rm{d}}\ln\!\vert {j_{\rm{c}}} \vert /{\rm{d}}E)\] In these equations, \(j_{\rm{a}}\) and \(j_{\rm{c}}\) are the anodic and cathodic current densities, respectively, corrected for any changes in the reactant concentration at the electrode surface with respect to its bulk value; incidentally, the symbols \(\ln\! j_{\rm{a}}\) and \(\ln\!\vert j_{\rm{c}}\vert\) imply that the argument of the logarithm is of dimension one, obtained by division with the corresponding unit, e.g., \(\ln\! j_{\rm{a}}\) meaning \(\ln(j_{\rm{a}}/\pu{A m^{-2}})\), and similarly for the other quantities \(\vert j_{\rm{c}}\vert\), \(k_{\rm{a}}\) and \(k_{\rm{c}}\). \(E\) is the applied electric potential, \(R\) is the gas constant, \(T\) is the thermodynamic temperature, and \(F\) is the Faraday constant. In practice, \(\alpha_{\rm{a}}\) and \(\alpha_{\rm{c}}\) are defined as the reciprocal of the corresponding Tafel slopes, \({\rm{d}}E/{\rm{d}}\ln\! j_{\rm{a}}\) and \(-{\rm{d}}E/{\rm{d}} \ln\! \vert j_{\rm{c}} \vert\), made dimensionless by the multiplying factor \(RT/F\). Both the transfer coefficient and the Tafel slope are determined at constant temperature and pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2014-5025"/>
        <rdfs:label>transfer coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12284 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12284">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of two or more techniques to different samples at the same time. This can include thermal and nonthermal analytical techniques.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>combined technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12306"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12285 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12285">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sample-controlled method where the feedback used to control the heating is the rate of transformation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>CRTA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>controlled-rate thermal analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRTA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12286 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12286">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature history imposed on the sample during the course of the thermal analysis experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>controlled temperature program</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12287 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12287">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental result of measuring the temperature of the sample as a function of time during cooling. Heating curves are obtained for temperature-time experiments during heating.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>cooling curve</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12288 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12288">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the \(1^{\rm{st}}\) derivative (mathematical) of any curve with respect to temperature or time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>derivative technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12289 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12289">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique where dielectric properties are measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>DEA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dielectric thermal analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12289"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DEA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12290 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12290">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to a difference in measured or measurable quantities usually between a sample and a reference or standard material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>differential technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12291 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12291">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique where the difference between the heat-flow rates into a sample and a reference material is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>DSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>heat-flow DSC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heat-flow differential scanning calorimetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12291"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12292 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12292">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique where the difference between the electrical powers into a sample and a reference material is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>DSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>power compensation DSC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>power compensation differential scanning calorimetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12292"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12293 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12293">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates, especially in the mechanical analysis of materials, that a parameter changes continuously during the experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>dynamic technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12294 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12294">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique where storage and loss viscoelastic moduli are determined with the help of a periodical stress.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>DMA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dynamic mechanical analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12294"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12295 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12295">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Passage of gas from one part of the system to another. The gas may be either inert (carrier gas) or reactive, either introduced into the system or evolving from the sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>gas flow</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12296 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12296">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applied to a technique to indicate that the temperature is maintained constant throughout the experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>isothermal technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12297 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12297">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The substance which is studied and from which the sample is taken.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>material</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12298 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12298">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prefix used to denote that the technique measures small quantities, either with respect to the amount of sample studied, or with respect to the change in the properties measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:comment>Mathematically, micro = \(\upmu\) = \(\pu{E-6}\).</rdfs:comment>
        <rdfs:comment>The opposite prefix, macro-, is also occasionally used.</rdfs:comment>
        <rdfs:comment>This prefix has been applied to many thermal methods, and the equipment associated with them, for example, microbalance, microreactor, microcalorimeter and also to the technique itself: microthermal, microscopic, and the property studied: microstructural.</rdfs:comment>
        <rdfs:label>micro- technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12299 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12299">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates that a parameter changes in a periodic manner during the experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>modulated technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12300 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12300">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applied to the technique name to indicate that a temperature modulation has been applied to the temperature program.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>MT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The prefix TM is occasionally used instead, but not recommended.</rdfs:comment>
        <rdfs:label>modulated temperature technique</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12300"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12301 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12301">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates that the experiment involves the illumination of the sample or measures the amount of light emitted from a sample. Where possible, the wavelength range of the light should be specified.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>photo- technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12302 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12302">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applied to the technique to indicate that a property of the sample is used either continuously or discontinuously to control the sample heating. Without this term, it is assumed that the experiment is following a controlled-temperature program.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:comment>The generic term for all TA techniques making use of such feedback is sample-controlled TA (SCTA), whereas specific names will be of the form sample-controlled TGA (SC-TGA), etc.</rdfs:comment>
        <rdfs:label>sample controlled technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12303 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12303">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A term used to describe the data produced from a thermal analysis experiment. More correct usage is a thermal analysis curve, or, for a specific technique thermogravimetric curve, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>thermal analysis curve</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This term is discouraged.</rdfs:comment>
        <rdfs:label>scan</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12304 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12304">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates that a specified experimental parameter, if not temperature, is changed in a controlled manner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>scanning technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12305 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12305">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Techniques where heat is measured as a function of temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>scanning calorimetry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12306 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12306">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates the measurement of two or more properties of a single sample at the same time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:comment>A hyphen is used to separate the abbreviations of the techniques; for example, simultaneous measurement of mass and heat flow rate (thermogravimetric analysis and differential scanning calorimetry) would be TGA-DSC.</rdfs:comment>
        <rdfs:label>simultaneous technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12284"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12307 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12307">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates, especially in the mechanical analysis of materials, a constant parameter during the experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>static technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12293"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12308 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12308">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicates discrete, discontinuous changes in an experimental parameter, e.g., force, temperature, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>stepwise technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12309 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12309">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The dimensionless ratio of energy lost to energy returned during one cycle of a periodic process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>tan $\delta$</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12294"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12310 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12310">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>EGA using an inert atmosphere or vacuum, in the absence of sample decomposition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>TPD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>temperature-programmed desorption</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12310"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TPD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12311 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12311">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experiment using an oxidising atmosphere, usually oxygen. Oxidation is monitored by any appropriate technique (EGA, TGA, gas sorption, etc.).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>TPO</oboInOwl:hasRelatedSynonym>
        <rdfs:label>temperature-programmed oxidation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12311"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TPO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12312 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12312">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experiment using a reducing atmosphere, usually hydrogen. Reduction is monitored by any appropriate technique (EGA, TGA, gas sorption, etc.).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>TPR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>temperature-programmed reduction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12312"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TPR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12313 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12313">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any graph of any combination of property, time, temperature derived from a thermal analysis technique.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>thermoanalytical curve</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Thermal curve is a loose abbreviation of the more correct term thermoanalytical curve.</rdfs:comment>
        <rdfs:comment>This term is discouraged.</rdfs:comment>
        <rdfs:label>thermal curve</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12314 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12314">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrical current observed during heating and caused by the thermally initiated relaxation of the frozen-in electrical polarization of a sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>TSC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>By extension, the same name and abbreviation (TSC) are given to the thermal analysis technique based on the measurement of this current.</rdfs:comment>
        <rdfs:label>thermally stimulated current</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12315"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12314"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12315 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12315">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relaxation of frozen-in electrical polarization caused by a temperature increase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:comment>The effect is measured through the thermally stimulated current.</rdfs:comment>
        <rdfs:label>thermally stimulated depolarisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12314"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12316 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12316">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Indicating the use of changing temperature during the experiment, when in the name of a thermal analysis technique.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>thermo- technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12317 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12317">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, or pertaining to, thermal analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>thermoanalytical</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12318 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12318">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A technique where the X-ray diffraction of the sample is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>thermodiffractometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12319 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12319">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A technique where the mass of the sample is measured, also known as thermogravimetry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>TGA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thermogravimetry (TG)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thermogravimetric analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12319"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TGA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12320 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12320">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A technique where the gas pressure is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>thermomanometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12321 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12321">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A technique where the deformation of the sample is measured under constant load.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <oboInOwl:hasRelatedSynonym>TMA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thermomechanical analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12321"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12322 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12322">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A technique where the optical properties of the sample are observed and measured through a microscope.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>thermomicroscopy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12323 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12323">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A group of techniques where a spectrum of the sample is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2012-0609"/>
        <rdfs:label>thermospectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12324 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12324">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for absolute quantitation of proteins via measurements on constituent proteolytic peptides using chemically synthesized isotope-labeled peptides as surrogate internal standards for mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>AQUA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>absolute quantitation of proteins</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12589"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12324"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AQUA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12325 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12325">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrical potential difference used to impart translational energy to ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Accelerating voltage is often used as a synonym, but the terms are equivalent only in the case of a static accelerating potential.</rdfs:comment>
        <rdfs:label>accelerating potential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12326 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12326">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimentally determined mass of an ion of known charge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Accurate mass and exact mass are not synonymous. Accurate mass refers to a measured mass, and exact mass refers to a calculated mass.</rdfs:comment>
        <rdfs:comment>Can be used to determine elemental composition to within limits defined by both the accuracy and precision of the measurement.</rdfs:comment>
        <rdfs:label>accurate mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12407"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12327 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12327">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value of the mass of a peptide from a protein that has been chemically or enzymatically cleaved into fragments. The mass is recorded with sufficiently high accuracy and precision that it can be used in identification of the protein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>accurate mass tag</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12522"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12328 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12328">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion containing the peptide \(\ce{N}\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \(\ce{C-C}\) bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>a-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12329 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12329">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Even-electron positively charged saturated hydrocarbon ion containing no aromatic groups, a special case of carbenium ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>alkyl cation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12330 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12330">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>All-glass inlet system for ion sources operating under vacuum that can be heated to about \(\pu{500^{\circ}C}\) and allows low vapor pressure materials to be introduced into the mass spectrometer without breaking vacuum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>AGHIS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>all-glass heated inlet system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12330"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AGHIS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12331 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12331">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Even-electron ion formulated as \(\ce{R^{1}R^{2}C=CR^{3}C+R^{4}R^{5}}\) and its resonance forms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>allyl cation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12332 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12332">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Desorption of molecules and formation of ions outside the mass spectrometer directly from samples in their native environment with no or minimal sample preparation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>&quot;Direct analysis in real time&quot; is a proprietary term indicating the formation of ions from a solid or liquid sample at atmospheric pressure through the interaction of a gas stream containing internally excited atoms or molecules with the surface. The excited-state species are typically formed in a glow discharge in helium or nitrogen. The term should only be used to describe the commercial product.</rdfs:comment>
        <rdfs:label>ambient ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12333 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12333">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometry analysis performed using an ambient ionization technique.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ambient mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12332"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12334 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12334">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used to investigate details of the collisional excitation process by studying trends relating scattering angle of the precursor ion, internal energy transferred, and the masses of the ion and its collision partner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>angle resolved mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12335 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12335">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion formed by the association of an anion with a molecule, \(\ce{M}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>The terms quasi-molecular ion and pseudo-molecular ion are deprecated and should not be used in place of anionized molecule.</rdfs:comment>
        <rdfs:label>anionized molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12336 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12336">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical ionization of a sample that is a gas or nebulized liquid, using an atmospheric pressure corona discharge or beta emitter such as \(\ce{^{63}Ni}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>APCI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>atmospheric pressure chemical ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12373"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APCI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12337 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12337">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Matrix-assisted laser desorption/ionization in which the sample target is at atmospheric pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>AP MALDI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>atmospheric pressure matrix-assisted laser desorption/ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12337"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AP MALDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12338 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12338">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Direct ionization of molecules at atmospheric pressure by electron detachment induced by photons forming \(\ce{M^{+.}}\), or atmospheric pressure chemical ionization in which the reactant ions are generated by photoionization of suitable dopant species and subsequent ion/molecule reactions of their molecular ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>APPI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>atmospheric pressure photoionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12336"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12338"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APPI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12339 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12339">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process whereby a negative ion in a discrete state with energy greater than the detachment threshold loses an electron spontaneously without further interaction with an energy source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>autodetachment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12340 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12340">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gas used in a spray ion source in addition to the nebulizing gas to aid in solvent removal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>auxiliary gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12365"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12341 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12341">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of an ion or molecule weighted for its isotopic composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>average mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12495"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12342 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12342">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ejection of an ion from an ion trap in a direction parallel to the longitudinal axis of the trap.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>axial ejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12343 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12343">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used in Fourier-transform ion cyclotron resonance mass spectrometers to limit the translational motion of the trapped ions so that they occupy a small volume near the trap center, thus optimizing performance criteria including resolving power.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>axialization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12344 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12344">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromatogram obtained by plotting the signal of the ions represented by the base peak detected in each of a series of mass spectra recorded as a function of retention time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>BPC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>base peak ion chromatogram</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This term should be used for samples introduced following a chromatographic separation.</rdfs:comment>
        <rdfs:label>base peak chromatogram</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12344"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BPC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12345 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12345">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer in which an ion beam accelerated from the ion source is transmitted through a m/z analyzer, or analyzers, to the detector.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>beam mass spectrometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12346 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12346">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Even-electron ion \(\ce{C7H7^{+}}\) with the same carbon skeleton as toluene that has lost a hydrogen atom from the methyl side-chain that carries the positive charge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>benzyl ion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12597"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12347 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12347">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion containing the peptide \(\ce{N}\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \(\ce{C-N}\) bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>b-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12348 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12348">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Special case of infrared multiphoton dissociation wherein excitation of the reactant ion is caused by absorption of infrared photons radiating from heated blackbody surroundings, which are usually the walls of a vacuum chamber.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>BIRD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>blackbody infrared radiative dissociation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12433"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12348"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BIRD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12349 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12349">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Additional set of four short, cylindrical electrodes, mounted co-linearly with a transmission quadrupole mass spectrometer that is excited with some fraction of the AC potential but not the DC potential applied to the main quadrupole. The Brubaker lens thus acts as a high-pass filter for ion m/z, but the resulting delay in application of the DC potential component also results in a reduction in defocusing by fringe fields and thus significantly improves overall ion transmission efficiency at a given mass resolution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>Brubaker pre-filter</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Brubaker lens</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12420"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12601"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12350 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12350">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inert gas used for collisional reduction of the internal or translational energy of ions, such as in ion traps.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>bath gas</oboInOwl:hasRelatedSynonym>
        <rdfs:label>buffer gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12362"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12351 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12351">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure of recording mass spectra in which an automated computer-based system detects peaks, calculates the centroid based on the average m/z value weighted by the intensity, and assigns m/z values based on a calibration file. Only the centroid m/z value and the peak magnitude are stored.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>centroid acquisition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12536"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12352 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12352">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theoretical model for production of highly charged macromolecules by electrospray ionization in which the excess charges on electrosprayed droplets are transferred to and remain on molecules enclosed within the droplets after solvent evaporation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>charged residue model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12438"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12353 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12353">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction of an ion with a neutral, surface, or ion of opposite polarity, in which the charge on the product ion is reversed in sign with respect to the reactant ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>charge inversion reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12354 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12354">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragmentation of an ion in which the cleavage of one of its bonds is induced by the charge site. The cleaved bond is adjacent to the apparent charge site, and its cleavage involves movement of the electron pair forming that bond to the original charge site and thus migration of the charge to the released fragment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>heterolytic fragmentation; inductive cleavage</oboInOwl:hasRelatedSynonym>
        <rdfs:label>charge-mediated fragmentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12355"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12355 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12355">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragmentation of an ion in which the cleaved bond is isolated from the apparent charge site by a distance of several bond lengths.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>CRF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>charge remote fragmentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12354"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12355"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12356 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12356">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical derivatization of molecules to introduce a fixed charge site, thus improving ionization efficiency by electrospray ionization or matrix-assisted laser desorption/ionization and directing subsequent ion fragmentation in a manner that facilitates structure identification.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>charge site derivatization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12357 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12357">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion containing the peptide \(\ce{N}\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \(\ce{N-C}\) bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>c-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12358 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12358">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reflectron that is arranged such that its main axis is coaxial with the ion source and first stage of the time-of-flight analyzer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>coaxial reflectron</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12359 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12359">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slit installed in a magnetic sector mass spectrometer to allow only those m/z separated ions with a specific m/z into the detector system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>collector slit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12360 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12360">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Effect where collisions with a buffer gas in a radio-frequency ion trap or transmission quadrupole causes ions to lose translational energy and concentrate at the center of the trap or axis of the linear quadrupole. The effect increases with gas pressure up to a point where ion scattering becomes the dominant process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>collisional focusing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12361 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12361">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chamber in the ion path between m/z separation elements, or between ion source acceleration region and the first analyzer, in tandem mass spectrometry in space configurations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>collision cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12364"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12362 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12362">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inert gas used for collisional excitation or a reactive gas used for ion/molecule reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>collision gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12363 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12363">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transmission quadrupole to which an oscillating radio frequency potential is applied so as to focus a beam of ions through a collision gas or buffer gas with no m/z separation other than low m/z cut-off.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Higher-order multipoles can also be used in this manner.</rdfs:comment>
        <rdfs:label>collision quadrupole</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12362"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12364 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12364">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collision cell for removal of interfering ions by ion/neutral reactions in inductively coupled plasma mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>CRC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>collision reaction cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12361"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12364"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12365 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12365">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pneumatic nebulizer in which the liquid flows through a central capillary and dispersion gas flows through a surrounding outer tube.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>concentric nebulizer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12366 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12366">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multiple-stage mass spectrometry experiment with three or more stages of m/z separation in which products of sequential fragmentation or bimolecular reactions are selected for detection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>CRM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>consecutive reaction monitoring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12500"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12501"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12366"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12367 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12367">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spectrum formed of all precursor ions that have undergone a selected m/z increase corresponding to the mass of a particular neutral species divided by the charge number of the precursor. The ions detected are the product ions produced by gain of a preselected neutral species mass following ion/molecule reactions of the precursor ions with a reactant gas in a collision cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>fixed neutral gain spectrum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fixed neutral mass gain spectrum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>constant neutral mass gain spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12368"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12368 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12368">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spectrum of all precursor ions that have undergone a selected m/z decrement corresponding to the mass of a particular neutral divided by the charge number of the precursor. The ions detected are the product ions produced by loss of a preselected neutral mass following collision-induced dissociation of the precursor ions in a collision cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>fixed neutral loss spectrum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fixed neutral mass loss spectrum</oboInOwl:hasRelatedSynonym>
        <rdfs:label>constant neutral mass loss spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12369 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12369">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion-to-electron detector in which the ion strikes the inner surface of a continuous tube device and induces the production of secondary electrons that, in turn, impinge on the inner surfaces of the device to produce more secondary electrons. This avalanche effect produces an increase in the final measured current pulse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>channel electron multiplier</oboInOwl:hasRelatedSynonym>
        <rdfs:label>continuous dynode particle multiplier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12395"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12370 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12370">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variant of fast atom bombardment in which the mixture of analyte and liquid matrix is continuously supplied to the sample probe tip.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>CF-FAB</oboInOwl:hasRelatedSynonym>
        <rdfs:label>continuous-flow fast atom bombardment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12370"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CF-FAB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12371 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12371">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variant of matrix-assisted laser desorption/ionization in which the analyte is dissolved in a liquid matrix that is continuously supplied to the sample probe tip.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>CF-MALDI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>continuous-flow matrix-assisted laser desorption/ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12371"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CF-MALDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12372 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12372">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface that is held at high potential so that ions striking the surface produce secondary charged particles that are subsequently detected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>For positive ions, the potential is negative and the secondary particles are electrons and negative ions. For negative ions, the potential is positive and the secondary particles are positive ions.</rdfs:comment>
        <rdfs:label>conversion dynode</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12373 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12373">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electric discharge generated in a gas, usually at atmospheric pressure, surrounding a conductor carrying a sufficiently high potential that the electric field around it ionizes the gas so as to form a plasma in the immediate vicinity of the conductor without causing complete electric breakdown or arcing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>A corona discharge can also be sustained in a liquid.</rdfs:comment>
        <rdfs:label>corona discharge</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12422"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12374 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12374">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of ions in a corona discharge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>corona discharge ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12373"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12375 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12375">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stream of inert gas, often heated, that is used in an electrospray or other spray ionization source to aid in the evaporation of solvent from the sprayed particles. The flow of the gas is in the direction opposite to that of the spray.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Curtain gas is a proprietary term used to indicate a flow of counter-current gas emanating from between two closely spaced plates each with a central orifice along the axis of a spray ionization source. The term should only be used to describe the commercial device.</rdfs:comment>
        <rdfs:label>counter-current gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12398"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12579"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12376 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12376">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Counter electrode in an electrospray ionization ion source is one of two electrodes between which the high electric potential is applied, the other electrode being the electrospray needle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>counter electrode</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12404"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12377 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12377">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pneumatic nebulizer in which the dispersion gas flows at an angle, usually \(\pu{90\!^{\circ}}\), with respect to the column of liquid emerging from a capillary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>cross-flow nebulizer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12378 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12378">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reflectron designed to provide a decelerating field strength that varies with depth of ion penetration and thus with ion translational energy, permitting energy focusing of ions with a range of translational energies such as those formed as product ions from post-source decay of metastable ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>curved field reflectron</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12530"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12379 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12379">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Circular motion of a charged particle moving perpendicularly to the direction of a magnetic field that results from the Lorentz force.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>cyclotron motion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12380 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12380">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detector consisting of an off-axis conversion dynode, scintillator, and photomultiplier. The dynode at high potential emits secondary electrons when ions impinge on the surface. The secondary electrons are accelerated onto the scintillator that produces light that is then detected by the photomultiplier detector, which can be outside the vacuum system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>Daly detector</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12372"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12446"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12381 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12381">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mode of data collection in tandem mass spectrometry in which a fixed number of precursor ions whose m/z values were recorded in a survey scan are selected using predetermined rules and are subjected to a second stage of mass selection in an MS/MS analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>data-dependent acquisition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12485"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12382 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12382">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrum processed with an algorithm designed to extract a desired signal or signals from raw experimental data in which the desired signals have been complicated (convolved) by some interferences or in some other way.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Examples of deconvoluted mass spectra include mass spectra corrected for instrumental mass bias, or extraction of spectra for pure components from the spectrum of a mixture, or a mass (not m/z) spectrum of a biopolymer from an electrospray ionization spectrum containing peaks corresponding to several charge states.</rdfs:comment>
        <rdfs:label>deconvoluted mass spectrum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12383 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12383">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of the accelerating voltage pulse after a time delay in desorption ionization from a surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>DE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The extraction delay can produce energy focusing in a time-of-flight mass spectrometer.</rdfs:comment>
        <rdfs:label>delayed extraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12596"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12383"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12384 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12384">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion formed by the removal of a proton from a molecule \(\ce{M}\) to produce an anion represented as \(\ce{[M - H]^{-}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>deprotonated molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12385 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12385">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of gas-phase ions by chemical ionization of gaseous molecules produced by the rapid heating and desorption of a solid or low vapour pressure liquid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>DCI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>desorption chemical ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12385"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DCI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12386 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12386">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of gas phase ions from a solid or liquid sample surface upon activation by heat, strong electric field, particles, droplets, or photon bombardment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>desorption ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12387 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12387">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Soft ionization alternative to matrix-assisted desorption/ionization involving laser desorption ionization of a sample deposited on a porous silicon surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>DIOS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>desorption ionization on silicon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12575"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12387"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DIOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12388 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12388">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Product ion whose formation reveals structural or compositional information about its precursor ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>For example, the phenyl cation in an electron ionization mass spectrum is a diagnostic ion for benzene and derivatives.</rdfs:comment>
        <rdfs:label>diagnostic ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12389 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12389">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Atmospheric pressure chemical ionization in which the low-temperature plasma is not generated by a corona discharge but by a device consisting of two electrodes with at least one dielectric layer that separates the electrode from the plasma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>dielectric barrier discharge ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12373"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12390 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12390">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-energy fragment ion of a protonated peptide, formally equivalent to a fragment ion formed by homolytic cleavage of a peptide \(\ce{C-N}\) bond together with the part of the \(\ce{C}\)-terminal side-chain starting at the \(\ce{\upgamma\mbox{-}carbon}\) (if any).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>d-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12391 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12391">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device based on a modification of a direct insertion probe for exposing an involatile sample directly to the electron beam (in an electron ionization source) or to a chemical ionization plasma as in desorption chemical ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>DEP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The sample can be deposited on an inert surface or on a heater filament for rapid heating.</rdfs:comment>
        <rdfs:label>direct exposure probe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12385"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12393"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12391"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DEP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12392 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12392">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of liquid sample introduction in which the sample is continuously flowed into a mass spectrometer ion source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>direct infusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12393 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12393">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device for introducing a single sample of a solid or liquid, usually contained in a quartz or other nonreactive sample holder, into a mass spectrometer ion source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>DIP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>direct insertion probe</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12391"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12393"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DIP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12394 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12394">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Direct delivery of a liquid sample at a low solvent flow rate into the chemical ionization ion source of a mass spectrometer. The solvent vapour can act as the reagent gas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>DLI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>direct liquid introduction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12546"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12394"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DLI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12395 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12395">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion-to-electron detector in which the ion strikes the surface of an electrode and induces the production of secondary electrons. In turn, these impinge in sequence on dynodes at a more positive electric potential to produce more secondary electrons. This avalanche effect produces an amplification of several orders of magnitude in the final measured current pulse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>discrete dynode particle multiplier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12369"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12396 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12396">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ionization mechanism in which capture of a low-energy electron by a molecule leads directly to a dissociative state of the nascent anion, an example of dissociative ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>dissociative electron capture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12397 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12397">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cylindrical chamber containing a buffer gas. Ions introduced at one end are caused to move to the other end by either a flow of the buffer gas or by a uniform longitudinal electric field.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>drift tube</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12350"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12398 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12398">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inert gas that is used to promote the removal of solvent from aerosol particles in spray ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>drying gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12375"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12579"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12399 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12399">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Software method used to minimize repeat selections of identical precursor ions for collision-induced dissociation in replicate chromatography-tandem mass spectrometry analyses of complex mixtures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>dynamic exclusion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12381"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12400 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12400">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Three-element charged particle lens in which the first and third elements are maintained at the same electric potential. Such a lens produces focusing without changing the translational energy of the particle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>einzel lens</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12401 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12401">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ionization process that produces charged droplets and gas-phase ions from a liquid under vacuum with the application of an electric field.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>The process is formally equivalent to sub-ambient pressure electrospray ionization.</rdfs:comment>
        <rdfs:label>electrohydrodynamic ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12402 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12402">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which multiply protonated molecules interact with low-energy electrons followed by fragmentation. The capture of an electron by the even-electron cation \(\ce{[M + nH]^{n+}}\) liberates energy and reduces its charge state, thus producing the corresponding \(\ce{[M + nH]^{(n - 1)+.}}\) odd-electron ion, which readily fragments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ECD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electron capture dissociation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12402"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ECD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12403 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12403">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ionization of a gas-phase atom or molecule by attachment of a free electron to form molecular ions of the \(\ce{M^{-.}}\) type.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ECI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>electron capture negative ionization</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electron capture ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12403"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ECI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12404 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12404">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Narrow bore tube from which highly charged droplets are emitted in electrospray ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>electrospray emitter</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electrospray needle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12405 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12405">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device consisting of pairs of parallel conducting plates, concentric cylinders, or concentric spheres that separate charged particles according to their ratio of translational energy to charge by means of a potential difference applied between the pair.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ESA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>electric sector</oboInOwl:hasRelatedSynonym>
        <rdfs:label>electrostatic energy analyser</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12405"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ESA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12406 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12406">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rule that states that even-electron ions tend to form even-electron fragment ions whereas odd-electron ions tend to dissociate to form either odd- or even-electron ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>even-electron rule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12407 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12407">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated mass of an ion or molecule with specified isotopic composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>exact mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12326"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12408 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12408">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromatogram created by plotting the intensity of the signal observed at a chosen m/z value or set of values in a series of mass spectra recorded as a function of retention time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>mass chromatogram</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>reconstructed ion chromatogram</oboInOwl:hasRelatedSynonym>
        <rdfs:label>extracted ion chromatogram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12409 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12409">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electropherogram created by plotting the intensity of the signal observed at a chosen m/z value or set of values in a series of mass spectra recorded as a function of electrophoresis time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>extracted ion electrophorogram</oboInOwl:hasRelatedSynonym>
        <rdfs:label>extracted ion electropherogram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12410 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12410">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any plot of signal intensity observed at a chosen m/z value or set of values in a series of mass spectra recorded as a function of time, including extracted ion chromatogram, extracted ion electropherogram, or from flow injection analysis or any other time-dependent sampling.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>extracted ion profile</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12408"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12409"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12600"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12411 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12411">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ionization of any species by the interaction of a focused beam of ions, with a translational energy of several thousand \(\pu{eV}\), with a solid or liquid sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>FIB</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For a liquid sample, fast ion bombardment is the same as liquid secondary ionization.</rdfs:comment>
        <rdfs:label>fast ion bombardment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12469"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12411"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FIB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12412 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12412">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Section of a mass spectrometer in which there are no electric or magnetic fields.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>FFR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>field-free region</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12412"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FFR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12413 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12413">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stability region of a Mathieu stability diagram closest to the origin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Ions within this region can traverse the full length of a transmission quadrupole or can be trapped in a Paul ion trap.</rdfs:comment>
        <rdfs:label>first stability region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12486"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12414 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12414">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spectrum obtained when data are acquired that determine the m/z values of product ions produced by the reaction of a selected precursor ion with a user-specified m/z value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>fixed precursor ion spectrum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12415 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12415">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of flow injection analysis in which an aliquot of sample is injected, without chromatographic separation, into a liquid carrier stream for on-line mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>flow injection analysis mass spectrometry</oboInOwl:hasRelatedSynonym>
        <rdfs:label>flow injection mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12416 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12416">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detector for m/z spatially dispersed ion beams in which all ions simultaneously impinge on the detector plane to produce spatially defined signals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>focal plane detector</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12417 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12417">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Double-focusing mass spectrometer configuration in which the ion beam traverses the electric sector before the magnetic sector.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>normal geometry</oboInOwl:hasRelatedSynonym>
        <rdfs:label>forward geometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12558"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12418 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12418">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure of comparing a mass spectrum of an unknown compound with a mass spectral library so that the unknown spectrum is compared in turn with the library spectra, considering only the m/z peaks that have intensities greater than a specific threshold in the unknown.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>In a forward library search, a higher similarity index indicates the extent to which the library spectrum resembles the unknown spectrum.</rdfs:comment>
        <rdfs:label>forward library search</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12484"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12559"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12419 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12419">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometry technique in which m/z values are represented by frequencies of ion motion and mass spectra are generated by Fourier transform mathematical operations from time domain transients produced by image current detection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Fourier transform mass spectrometry is typically carried out using Fourier transform-ion cyclotron resonance-mass spectrometers or Kingdon traps.</rdfs:comment>
        <rdfs:label>Fourier-transform mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12460"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12420 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12420">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electric or magnetic field that extends from the edge of an electric sector, magnetic sector, lens, or other ion optics element.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>fringe field</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12444"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12421 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12421">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique by which a mixture is separated into individual components by gas chromatography, followed by detection with a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>GC-MS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gas chromatography/mass spectrometry (GC/MS)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Either a hyphen or slash can be used to indicate combined instruments.</rdfs:comment>
        <rdfs:comment>The mass spectrum is typically obtained on a time scale that allows resolution of the component in a single chromatographic peak.</rdfs:comment>
        <rdfs:label>gas chromatography-mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12466"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12585"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12595"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12421"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GC-MS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12422 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12422">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of ions from gaseous atoms or molecules or from the vapor of a solid sample at the cathode by applying a potential difference between two electrodes immersed in a low-pressure inert gas environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>glow discharge ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12423 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12423">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reflectron design in which the decelerating/accelerating field is produced without the use of wire-mesh grids.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This design improves ion transmission but at the cost of a less homogeneous field and thus reduced resolution.</rdfs:comment>
        <rdfs:label>gridless reflectron</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12424 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12424">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of gas-phase ions accompanied by extensive fragmentation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>hard ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12575"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12425 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12425">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Separation of ions at atmospheric pressure between two electrodes due to simultaneous application of a high potential asymmetric waveform, whereby ions migrate towards one of the two electrodes depending on the ratio of the high- to low-field mobility of the ion. A variable compensating DC potential is used to selectively transmit ions of interest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>FAIMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RF-DC ion mobility spectrometry</oboInOwl:hasRelatedSynonym>
        <rdfs:label>high-field asymmetric waveform ion mobility spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FAIMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12426 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12426">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer that combines m/z analyzers of different types to perform tandem mass spectrometry or higher-order \({\rm{MS}}^{n}\) experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>hybrid mass spectrometer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12427 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12427">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exchange of hydrogen atoms with deuterium atoms in a chemical species in solution prior to introduction into a mass spectrometer, or by ion/molecule reaction with a neutral gas inside a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>HDX</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hydrogen/deuterium exchange</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12427"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HDX</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12428 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12428">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sigmatropic reactions of ions in which the \(\ce{\upsigma\mbox{-}bonds}\) broken and formed involve hydrogen atoms, and are subject to the Woodward–Hofmann rules resulting from orbital symmetry considerations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>hydrogen shifts</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12429 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12429">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Analytical technique in which mass spectrometry is interfaced with a pretreatment step, most often chromatographic separation but many other combinations are possible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Despite the use of the term &quot;hyphenated&quot; in the name of the general category, a slash separator as in gas chromatography/mass spectrometry may also be used.</rdfs:comment>
        <rdfs:label>hyphenated mass spectrometry technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12421"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12430 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12430">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of ion detection by measuring the current that results from the image charge induced by a coherent motion of ions passing near a conductor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>In Fourier transform mass spectrometers or Kingdon traps, the coherent orbital motion of ions between a pair of electrodes induces a radio frequency image charge in the electrodes and an alternating image current in the detection circuit connecting to the electrodes.</rdfs:comment>
        <rdfs:label>image current detection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12419"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12460"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12431 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12431">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure used to form chemically selective images of an object based on the mass spectrometric detection of ions desorbed from its surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>imaging mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12432 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12432">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cation with the structure \(\ce{R2C=N^{+}R2}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>alkylideneaminylium ion</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The terms imonium ion and immonium ion are irregularly formed and should not be used.</rdfs:comment>
        <rdfs:label>iminium ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12433 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12433">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dissociation of a reactant ion as a result of the absorption of multiple infrared photons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>IRMPD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>infrared multiphoton dissociation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12348"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IRMPD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12434 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12434">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dissociation of an ion as a result of collisional excitation during ion transfer from an atmospheric pressure ion source to the vacuum chamber of the mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>in-source collisionally activated dissociation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Terms such as cone voltage dissociation and capillary exit fragmentation are design specific versions of this term, and are deprecated.</rdfs:comment>
        <rdfs:comment>This process is similar to ion desolvation but uses higher collision energy.</rdfs:comment>
        <rdfs:label>in-source collision-induced dissociation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12436"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12435 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12435">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion of a peptide ion precursor formed by a double backbone cleavage that contains neither the original \(\ce{C}\)- or \(\ce{N}\)-terminal residues. Typically a combination of b- and y-type cleavages or occasionally an a- and y-type combination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>internal fragment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12436 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12436">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Removal of solvent molecules clustered around a gas-phase ion by means of heating and/or collisions with gas molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ion desolvation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12437 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12437">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenomenon in which the ionization efficiency of a compound is increased by the presence of another compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ionization enhancement</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The effect is most significant in electrospray ionization but is also observed in atmospheric pressure chemical ionization and to a lesser extent in other ionization methods.</rdfs:comment>
        <rdfs:label>ion enhancement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12445"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12438 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12438">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mechanism for production of gas-phase ions from highly charged fine liquid droplets as in electrospray ionization that involves direct ejection of the ions from the droplet surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This mechanism is thought to be dominant for smaller molecules.</rdfs:comment>
        <rdfs:label>ion evaporation model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12439 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12439">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Series of stacked ring electrodes with progressively decreasing inner diameter to which a combined radio frequency and fixed potential is applied. The resulting field focuses ions travelling along the central axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ion funnel</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12440 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12440">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of plates or grid of wires in an ion mobility spectrometer, time-of-flight mass spectrometer, or other mass spectrometer that is used to apply a pulsed electric field with the purpose of selectively deflecting charged particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ion gate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12480"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12441 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12441">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction between two ions, generally of opposite polarity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ion-ion reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The hyphenated term ion-ion reaction is superseded.</rdfs:comment>
        <rdfs:label>ion/ion reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12442 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12442">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Separation of ions according to their velocity through a buffer gas under the influence of an electric field.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>IMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ion mobility spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12425"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12442"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12443 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12443">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Weakly bound species formed from an ion and neutral.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>In the context of some unimolecular ion dissociations, these complexes are particular types of transition states or local energy minima that lie between precursor ions and product ions on the reaction coordinate.</rdfs:comment>
        <rdfs:comment>The hyphenated formulation of this term, ion-neutral complex, is deprecated; the hyphen suggests a reaction of a species that is both an ion and a molecule and is not the intended meaning.</rdfs:comment>
        <rdfs:label>ion/neutral complex</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12444 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12444">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Devices designed to control the formation, focusing, and deflection of charged particle beams in a vacuum under the influence of electric and magnetic fields.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ion optics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12445 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12445">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenomenon in which the ionization efficiency of a species is lowered by the presence of a different species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ionization suppression</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The effect is most significant in electrospray ionization but is also observed in atmospheric pressure chemical ionization and to a lesser extent in other ionization methods.</rdfs:comment>
        <rdfs:label>ion suppression</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12437"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12446 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12446">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detector in which ions strike a conversion dynode to produce electrons that in turn strike a phosphor and the resulting photons are detected by a photomultiplier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ion-to-photon detector</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12372"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12380"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12447 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12447">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device for spatially confining ions using electric and magnetic fields alone or in combination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>IT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ion trap</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12448 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12448">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical labeling reagents used for relative or absolute quantitation in proteomics, based on covalent labeling of the \(\ce{N}\)-terminus and side-chain amines of peptides from protein digestions with tags of varying mass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>iTRAQ</oboInOwl:hasRelatedSynonym>
        <rdfs:label>isobaric tag for relative and absolute quantitation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12448"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>iTRAQ</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12449 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12449">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of peaks representing ions of the same elemental composition, but different isotopic compositions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>isotope cluster</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12450 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12450">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical labeling reagents used for relative quantitation in proteomics, consisting of a reactive group capable of labeling a defined amino acid side-chain, an isotopically coded linker, and a tag for the affinity isolation of labeled proteins and peptides.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>ICAT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>isotope coded affinity tag</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICAT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12451 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12451">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative mass spectrometry technique in which an isotopically enriched compound is used as a surrogate internal standard.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>IDMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>isotope dilution mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12589"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12451"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IDMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12452 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12452">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the number of atoms of one isotope to the number of atoms of another isotope of the same chemical element in the same system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>isotope–number ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Usually the minor, less abundant isotope to the major, most abundant isotope, for example, \(\ce{^{13}C}/\ce{^{12}C}\).</rdfs:comment>
        <rdfs:label>isotope ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12453 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12453">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement and study of the relative abundances of the different isotopes of an element in a material using a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>IRMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>stable isotope mass spectrometry</oboInOwl:hasRelatedSynonym>
        <rdfs:label>isotope ratio mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12453"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IRMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12454 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12454">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ions that differ only in the isotopic composition of one or more of the constituent atoms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>isotopic homolog ions</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Isotopolog is an abbreviation of isotopic homolog.</rdfs:comment>
        <rdfs:label>isotopolog ions</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12449"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12455 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12455">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isomeric ions having the same numbers of each isotopic atom but differing in their positions within the ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Isotopomer is an abbreviation of isotopic isomer.</rdfs:comment>
        <rdfs:comment>Isotopomeric ions can be either configurational isomers in which two atomic isotopes exchange positions or isotopic stereoisomers.</rdfs:comment>
        <rdfs:label>isotopomeric ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12456 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12456">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gas chromatograph-to-mass spectrometer interface where the gas chromatography effluent expands into a lower-pressure region and then through a downstream orifice. The low mass carrier gas molecules diffuse from the jet axis, leaving the sample stream enriched in the heavier analyte molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>jet separator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12493"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12457 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12457">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Translational energy of fragments resulting from dissociation of a metastable ion measured relative to the center-of-mass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>KER</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In this context, kinetic energy is interpreted as translational, rather than vibrational or rotational, kinetic energy.</rdfs:comment>
        <rdfs:label>kinetic energy release</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12458"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12457"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KER</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12458 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12458">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distribution of values of translational energies in the center-of-mass reference for an ensemble of metastable ions undergoing a specific dissociation reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>KERD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In this context, kinetic energy is interpreted as translational, rather than vibrational or rotational, kinetic energy.</rdfs:comment>
        <rdfs:label>kinetic energy release distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12476"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12458"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KERD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12459 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12459">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excess energy above the thermochemical threshold required to observe dissociation of a precursor ion within the timeframe of a particular mass spectrometry experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Kinetic shifts are important when thermochemical quantities are deduced from appearance energy measurements.</rdfs:comment>
        <rdfs:label>kinetic shift</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12460 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12460">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion trapping device that consists of an outer barrel-like electrode and a coaxial inner spindle-like electrode that form an electrostatic field with a quadro-logarithmic potential distribution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>The frequency of harmonic oscillations of the orbitally trapped ions along the axis of the electrostatic field is independent of the ion velocity and is inversely proportional to the square root of m/z so that the trap can be operated as a mass analyzer using image current detection and Fourier transformation of the time domain signal.</rdfs:comment>
        <rdfs:comment>The trademarked term &quot;Orbitrap&quot; has been used to describe a Kingdon trap used as a mass spectrometer.</rdfs:comment>
        <rdfs:label>Kingdon trap</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12461 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12461">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for determining the concentration of proteins through a combination of protein digestion and liquid chromatography-mass spectrometry (LC-MS) without relying on stable isotope labeling. Protein quantification is achieved by measuring the signal intensity of peptide ions corresponding to a protein or by counting and comparing the number of fragment mass spectra identifying peptides of a given protein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>label-free quantitation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12466"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12462 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12462">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of gas-phase species from a solid or liquid sample surface upon activation using a short pulse of photons from a laser.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>LD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>laser desorption</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12462"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12463 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12463">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of gas-phase ions by the interaction of a laser with a solid or liquid material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>LDI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>laser desorption ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12463"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12464 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12464">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Laser desorption ionization mass spectrometry, particularly emphasizing spatially resolved composition information.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>LMMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>laser microprobe mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12463"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12464"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LMMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12465 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12465">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two-dimensional Paul ion trap in which ions are confined in the axial dimension by means of a static electric potential.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>LIT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>linear ion trap</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12465"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LIT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12466 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12466">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique by which a mixture of analytes is separated into individual components by liquid chromatography (typically high-performance liquid chromatography), followed by detection with a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>LC-MS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>liquid chromatography/mass spectrometry (LC/MS)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Either a hyphen or slash can be used to indicate combined instruments.</rdfs:comment>
        <rdfs:label>liquid chromatography-mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12466"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LC-MS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12467 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12467">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spray ionization interface in which droplets are dispersed from a pneumatic nebulizer toward a high potential electrode that produces a static charge on the droplets leading to ion formation after solvent evaporation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>liquid ion evaporation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12579"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12468 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12468">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Means of coupling capillary electrophoresis to a mass spectrometer in which a liquid reservoir surrounds the separation capillary and transfer capillary to the mass spectrometer and provides electric contact for the capillary electrophoresis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>liquid junction interface</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12469 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12469">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ionization of any species by the interaction of a focused beam of ions or atoms with a sample that is dissolved in a solvent matrix.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>LSI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>liquid secondary ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LSI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12470 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12470">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Flow of make-up liquid in a sheath flow interface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>liquid sheath</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12570"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12471 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12471">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of an ion of known m/z value, derived from a suitable standard compound introduced into an ion source together with the sample to be analyzed, which permits real-time recalibration by correction of m/z shifts arising from instrumental drift.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>lock mass</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12472 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12472">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collision-induced dissociation process wherein the precursor ion has laboratory-frame translational energy lower than a given value, often taken to be \(\pu{1 keV}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This process can be carried out under single collision conditions but typically requires multiple collisions and the collisional excitation is cumulative.</rdfs:comment>
        <rdfs:label>low-energy collision-induced dissociation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12473 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12473">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device that produces a magnetic field perpendicular to a charged particle beam that deflects the beam to an extent that is proportional to the ratio of particle momentum and charge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>For a mono-energetic beam, the deflection is proportional to m/z.</rdfs:comment>
        <rdfs:label>magnetic sector</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12474 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12474">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Slow rotation of the center of cyclotron motion around the central axis of a Penning ion trap that results from a drift of the cyclotron centre along the electric equipotential lines perpendicular to the magnetic field direction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>The characteristic frequency of this motion is called the magnetron frequency.</rdfs:comment>
        <rdfs:label>magnetron motion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12521"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12475 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12475">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solvent that is mixed with the sample flow in a liquid introduction mass spectrometry interface in order to adjust the flow rate or solvent characteristics of the system, for example, to promote ionization efficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>make-up liquid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12476 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12476">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure by which translational energy spectra are obtained from a sector mass spectrometer that incorporates at least one magnetic sector plus one electric sector in reverse geometry (a magnetic sector followed by an electric sector).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MIKES</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In this context, kinetic energy is interpreted as translational rather than vibrational or rotational kinetic energy.</rdfs:comment>
        <rdfs:comment>The accelerating potential, \(V\), and the magnetic flux density, \(B\), are set at fixed values to m/z select the precursor ions, which are then allowed to dissociate or to react in a field-free region between the two sectors. The translational energy-to-charge ratios of the various product ions are analyzed by scanning the electric sector field \(E\). The width of a product ion spectral peak is related to the kinetic energy release distribution for the dissociation process.</rdfs:comment>
        <rdfs:label>mass-analyzed ion kinetic energy spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12412"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12458"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12558"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12566"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12476"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MIKES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12477 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12477">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Means of determining m/z values of ions from experimentally detected signals using a theoretical or empirical relational equation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Most commonly this is accomplished using a computer-based data system and a calibration file obtained from a mass spectrum of a compound that produces ions of known m/z values.</rdfs:comment>
        <rdfs:label>mass calibration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12478 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12478">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference between the nominal mass and the monoisotopic mass of an atom, molecule, or ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Mass defect can be a positive or negative value dependent upon the elemental composition.</rdfs:comment>
        <rdfs:label>mass defect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12495"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12479 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12479">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Differences in overall detection sensitivities for ions of different m/z values in a mass spectrum, caused by variations in ionization efficiency, transmission efficiency through the interface between the ion source and the analyzer vacuum system, analyzer, and detector response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>mass discrimination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12601"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12480 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12480">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion gate used to transmit ions in a given m/z range.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>mass gate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12440"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12481 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12481">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value of m/z above or below which ions cannot be detected in a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>mass limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12482 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12482">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of mass selective instability to eject ions of selected m/z values from an ion trap along the trap axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>mass selective axial ejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12483"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12483 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12483">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unstable trajectories in an ion trap for ions within a particular range of m/z values caused by an appropriate combination of oscillating electric fields.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MSI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mass selective instability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12482"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12483"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12484 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12484">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of mass spectra of different compounds, usually represented as arrays of signal intensity vs. the m/z values.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>mass spectral library</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12485 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12485">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acquisition and study of the spectra of the product ions or precursor ions of m/z selected ions, or of precursor ions of a selected neutral mass loss.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MS/MS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tandem mass spectrometry</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MS/MS can be accomplished using instruments incorporating more than one analyzer (tandem mass spectrometry in space) or in trap instruments (tandem mass spectrometry in time).</rdfs:comment>
        <rdfs:label>mass spectrometry/mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12592"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12485"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MS/MS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12486 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12486">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graphical representation expressed in terms of dimensionless reduced coordinates that describes the stability or instability of charged particle motion in a transmission quadrupole mass spectrometer or Paul ion trap, based on an appropriate form of the Mathieu differential equation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>stability diagram</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Mathieu stability diagram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12487 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12487">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometry measurement that uses a semi-permeable membrane separator that permits the passage of analytes directly from solutions or ambient air to the mass spectrometer ion source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MIMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>membrane inlet mass spectrometry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>membrane interface mass spectrometry</oboInOwl:hasRelatedSynonym>
        <rdfs:label>membrane introduction mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12487"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MIMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12488 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12488">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>GC-MS interface with a polymer membrane that selectively passes analyte molecules in preference to the carrier gas thereby enriching the analyte in the gas stream.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>membrane separator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12421"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12489 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12489">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thin plate that contains a closely spaced array of channels each of which acts as a continuous dynode particle multiplier. A fast charged or neutral particle, or a photon, that strikes the plate causes a cascade of secondary electrons that ultimately exits the opposite side of the plate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MCP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>channel electron multiplier array</oboInOwl:hasRelatedSynonym>
        <rdfs:label>microchannel plate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12369"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12489"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MCP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12490 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12490">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrospray ionization at a low solvent flow rate, typically several microliters per minute (\(\pu{\upmu L min-1}\)) or lower, where a pump is used to provide the sample flow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>microelectrospray</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12502"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12491 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12491">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometry measurement in which the sample is introduced into the ion source of the mass spectrometer as a collimated beam of molecules with a narrow velocity distribution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>molecular beam mass spectrometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12492 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12492">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>GC-MS interface that subjects the GC effluent to effusive flow through a porous glass tube. The lighter carrier gas passes out of the tube, leaving the gas within the tube enriched in analyte.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>molecular effusion separator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12421"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12493 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12493">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer interface to inlets including chromatography and spray-based ion sources that enriches the sample by selecting the central part of the effluent or spray using an orifice or skimmer. Particles with a higher forward momentum diverge less from the spray axis for a given radial momentum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>momentum separator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12456"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12494 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12494">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle beam interface that incorporates a monodisperse aerosol generator.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MAGIC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>monodisperse aerosol generating interface for chromatography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12494"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAGIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12495 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12495">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exact mass of an ion or molecule calculated using the mass of the most abundant isotope of each element.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>monoisotopic mass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12326"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12407"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12496 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12496">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Liquid sample mass spectrometer interface that uses two or more pulleys and a continuous loop of material. Samples are sprayed or deposited from solution onto the belt where they are transported into the vacuum system for vaporization or desorption and ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>moving belt interface</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12497 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12497">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrum obtained using tandem mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>MS/MS spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12498 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12498">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Symbol for multiple-stage mass spectrometry experiments designed to record product ion spectra where \(n\) is the number of product ion stages (nth-generation product ions).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>MS&lt;sup&gt;&lt;i&gt;n&lt;/i&gt;&lt;/sup&gt;</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12501"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12511"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12535"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12499 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12499">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrograph based on a double-focusing magnetic analyzer that spatially disperses ions of different m/z values on to an array of Faraday cup detectors, generally used with inductively coupled plasma ion sources for isotopic composition measurements.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>multicollector mass spectrometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12500 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12500">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of selected reaction monitoring to multiple product ions from one or more precursor ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>MRM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This term should not be confused with consecutive reaction monitoring, which involves the serial application of three or more stages of selected reaction monitoring.</rdfs:comment>
        <rdfs:label>multiple reaction monitoring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12568"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12500"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MRM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12501 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12501">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multiple stages of precursor ion m/z selection followed by product ion detection for successive nth-generation product ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>multiple-stage mass spectrometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12511"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12502 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12502">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrospray ionization at a very low solvent flow rate, typically hundreds of nanoliters per minute of sample solution or lower, often without the use of an external solvent delivery system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Nanospray should only be used to describe the commercial product.</rdfs:comment>
        <rdfs:label>nanoelectrospray</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12490"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12503 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12503">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical ionization that results in the formation of negative ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>NICI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>negative ion chemical ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12503"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NICI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12504 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12504">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure by which neutral species are formed from m/z selected ions by charge transfer to a collision gas or by dissociation. The neutral species are separated from the remaining ions and ionized through collisions with a second gas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>NRMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>neutralization-reionization mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12504"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NRMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12505 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12505">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of an uncharged species from an ion during dissociation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>neutral loss</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12506 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12506">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scan used to generate a constant neutral loss spectrum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>neutral loss scan</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12368"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12507 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12507">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rule stating that a neutral organic molecule containing one or more atoms of the elements \(\ce{C}\), \(\ce{H}\), \(\ce{O}\), \(\ce{N}\), \(\ce{S}\), \(\ce{P}\), or any halogen has an odd nominal mass if it contains an odd number of nitrogen atoms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>nitrogen rule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12508 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12508">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collisionally activated dissociation that is caused by collisions in the region between the nozzle and skimmer of an atmospheric pressure ionization source such as electrospray or atmospheric pressure chemical ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>in-source collision-induced dissociation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The process can be induced by a higher than typical nozzle-skimmer voltage.</rdfs:comment>
        <rdfs:label>nozzle-skimmer dissociation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12509"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12509 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12509">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electric potential difference applied between the electrospray needle and the skimmer, which is typically held at the same potential as the counter electrode.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>needle voltage</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nozzle-skimmer voltage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12404"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12574"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12510 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12510">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serial product ions from dissociation or bimolecular reaction of selected precursor ions where \(n\) refers to the number of stages of dissociation or bimolecular reaction in a series of consecutive reactions that involve successive product ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Given the sequential fragmentation scheme: \[\ce{M1^{+} -&gt; M2^{+} -&gt; M3^{+} -&gt; M4^{+} -&gt; M5^{+}}\] \(\ce{M4^{+}}\) is the precursor ion of \(\ce{M5^{+}}\), a 1st-generation product ion of \(\ce{M3^{+}}\), a 2nd-generation product ion of \(\ce{M2^{+}}\), and a 3rd-generation product ion of \(\ce{M1^{+}}\).</rdfs:comment>
        <rdfs:label>&lt;i&gt;n&lt;/i&gt;&lt;sup&gt;th&lt;/sup&gt;-generation product ion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12511"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12511 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12511">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrum recorded from any mass spectrometer in which the appropriate scan function can be set to record the appropriate generation product ion or ions of m/z selected precursor ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>&lt;i&gt;n&lt;/i&gt;&lt;sup&gt;th&lt;/sup&gt;-generation product ion spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12512 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12512">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Configuration for electrospray ionization in which the axis of the spray is at a right angle to the axis of the sampling cone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>orthogonal electrospray</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12563"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12513 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12513">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pulsed acceleration of ions perpendicular to their original direction of travel into a mass spectrometer, typically time-of-flight.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>orthogonal acceleration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Ions may be extracted from a directional ion source, drift tube, or m/z separation stage.</rdfs:comment>
        <rdfs:label>orthogonal extraction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12514 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12514">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Partial random mixing of isotopes among specified atom positions in an ion or neutral species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>In mass spectrometry, this term usually refers to the partial random mixing of isotopes in isolated ions that were formed with a fixed isotopic composition.</rdfs:comment>
        <rdfs:label>partial isotopic scrambling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12515 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12515">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for coupling liquid chromatography to mass spectrometry in which the effluent is passed through a heated capillary to form an expanding jet of vapour and aerosol particles. After passing through a skimmer that acts as a momentum separator, the beam impinges on a heated surface to form ions through chemical ionization at the surface or ionization of the resulting vapour in a chemical ionization or electron ionization source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>particle beam interface</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12516 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12516">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion trapping device that depends on the application of radio frequency potentials between a ring electrode and two end-cap electrodes to confine the ion motion to a cyclic path described by an appropriate form of the Mathieu equation. The choice of these potentials determines the m/z value below which ions are not trapped.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>quadrupole ion storage trap</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>quadrupole ion trap</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Paul ion trap</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12517 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12517">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure for measuring the accurate mass of an ion using scanning mass spectrometers, in which the peak corresponding to the unknown ion and that for a reference ion of known m/z are displayed alternately and caused to overlap by adjusting appropriate electric fields.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>peak matching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12326"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12550"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12518 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12518">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method used to extend the amount of time available for mass spectrometric analysis of the components in a narrow chromatographic peak. The eluent flow rate is reduced to an ultra-low level at the leading edge of the peak and held at this low flow rate for the duration of compound elution, thus enabling collection of sufficient data for reliable statistical analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>peak parking</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12519 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12519">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Data analysis technique used in elemental mass spectrometry to correct the intensity of an unresolved multiplet peak monitored for a specific element for contributions from a multi-isotopic contaminant. The correction is calculated from the measured intensity of a different isotopic peak of the contaminant and the known natural isotopic abundance ratio.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>peak stripping</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12520 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12520">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ionization via electron removal that occurs through the energy transfer from a neutral species \(\ce{N}\) internally excited to a metastable state (such as a high Rydberg state) to a neutral species \(\ce{M}\) with lower ionization energy, as represented by the following reaction: \(\ce{N^{\ast} + M -&gt; N + M^{+.} + \textit{e}^{-}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Penning ionization differs from chemi-ionization in that no chemical change is involved.</rdfs:comment>
        <rdfs:label>Penning ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12521 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12521">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion trapping device using a static magnetic field and a static electric potential well. The magnetic field confines the ion motion to circular orbits around the magnetic force line direction, which aligns with the direction of the trap axis, whereas the electric potential well confines the ion motion axially.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This device is used for the mass analyzer of Fourier transform-ion cyclotron resonance-mass spectrometers.</rdfs:comment>
        <rdfs:label>Penning ion trap</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12522 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12522">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for protein analysis where an unknown protein is chemically or enzymatically cleaved into peptide fragments whose masses are determined by mass spectrometry. The peptide masses are compared to peptide masses calculated for known proteins in a database and analyzed statistically to determine the best match.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>PMF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mass mapping</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peptide mass fingerprinting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12327"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12522"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PMF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12523 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12523">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of peptide ion fragment masses that can be used to aid in the identification of the amino acid sequence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Sequence tags are often obtained in tandem mass spectrometry analysis of peptides from an unknown protein that has been chemically or enzymatically cleaved into peptide fragments.</rdfs:comment>
        <rdfs:label>peptide sequence tag</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12524 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12524">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process wherein the reactant ion or molecule is dissociated as a result of absorption of one or more photons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>photodissociation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12525 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12525">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recording of ion currents by allowing them to strike a photographic plate, which is subsequently developed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This technique is typically associated with ion-beams that have been spatially separated by m/z and focused across a focal plane as in a Mattauch–Herzog geometry magnetic sector instrument.</rdfs:comment>
        <rdfs:label>photographic plate recording</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12526 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12526">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Arrangement in which an ion beam is deflected magnetically through \(\pi/n\ \rm{rad}\), where \(n \gt 1\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>180º/&lt;em&gt;n&lt;/em&gt; magnetic sector</oboInOwl:hasRelatedSynonym>
        <rdfs:label>$\boldsymbol{\pi}$/n rad magnetic sector</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12527 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12527">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrospray ionization in which the nebulization of the liquid stream is assisted by a concentric stream of gas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Ionspray should only be used to describe the commercial product.</rdfs:comment>
        <rdfs:label>pneumatically assisted electrospray ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12528 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12528">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detector in which the ion beam is focused onto a small area, for example, defined by a collector slit, rather than dispersed by m/z spatially across a focal plane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>point detector</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12359"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12529 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12529">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detector in which a high potential is applied after m/z separation to accelerate the ions and produce an improved signal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>PAD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>post-acceleration detector</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12372"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12529"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PAD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12530 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12530">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique specific to reflectron time-of-flight mass spectrometers where product ions of metastable transitions or collision-induced dissociations generated in the flight tube prior to entering the reflectron are separated according to m/z to yield product ion spectra.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>PSD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>post-source decay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12535"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12530"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PSD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12531 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12531">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrum in which the appropriate m/z separation function records the precursor ions of selected product ions or specified neutral loss.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>The ion current recorded by the detector is that from the product ion but the m/z values corresponding to the peaks in the resulting spectrum are those of precursor ions that fragmented in the fashion specified by the m/z separation function of the tandem mass spectrometer.</rdfs:comment>
        <rdfs:label>precursor ion spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12535"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12532 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12532">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electronic state capable of undergoing autoionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>pre-ionization state</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12533 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12533">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Automated system for computer examination of the mass spectrum of an unknown mixture for the presence of a specific compound for which a standard spectrum is available in a library. The probability that the compound is present is given by a confidence index \(K\) such that \(2^{K}\) is the average number of randomly selected compounds whose mass spectra would have to be examined to find data which match the target spectrum to the same degree as does the unknown.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>probability-based matching</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12534 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12534">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process whereby a precursor ion of a particular m/z is selected by m/z, fragmentation is induced, and the mass spectrum of the resulting product ions is recorded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>product ion analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12535 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12535">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrum in which the appropriate m/z separation analysis function is set to record the product ions of a selected precursor ion selected by m/z.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>product ion spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12536 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12536">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for acquiring a mass spectrum where each peak is displayed as a curve, with the data points defining the curve corresponding to the signal intensities at each particular m/z value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>profile mode</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12351"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12537 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12537">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dimeric ion consisting of two similar or dissimilar molecules bound together by hydrogen bonding with a shared proton.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>proton-bound dimer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12538 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12538">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometry technique in which the sample is heated to the point of decomposition and the gas-phase decomposition products are characterized by mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>PYMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pyrolysis mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12538"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PYMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12539 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12539">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reflectron in which the electric field varies with the square of the distance from the entrance and compensates for kinetic energy spread to all orders.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>quadratic field reflectron</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12540 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12540">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique for axialization in Fourier transform-ion cyclotron resonance-mass spectrometers in which magnetron motion is converted into cyclotron motion by subjecting the trapped ions to a quadrupolar excitation field while they undergo collisions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>quadrupolar axialization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12343"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12541 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12541">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hybrid mass spectrometer consisting of a transmission quadrupole mass spectrometer coupled to an orthogonal acceleration time-of-flight mass spectrometer. A collision quadrupole is typically inserted between the two mass spectrometers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>QTOF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>quadrupole time-of-flight</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12363"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12426"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12513"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12541"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>QTOF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12542 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12542">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for absolute quantitation of a protein or proteins in a multiplexed fashion using isotope-labeled peptides as surrogate internal standards. The labeled peptides are produced by synthesizing a gene coding for all desired peptides, expressing this gene in E. coli culture containing appropriately labeled substrate, and digesting with trypsin the expressed protein composed of the desired concatenated peptides.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>QCAT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>quantitation by concatenated tryptic peptides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12589"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12542"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>QCAT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12543 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12543">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statistical theory of unimolecular reaction rates (isomerization or fragmentation) of molecular species that assumes that reaction occurs from the ground electronic state of the reactant regardless of its mode of formation, at a rate determined by the free statistical redistribution of internal energy into those vibrational and rotational modes that must be activated sufficiently to reach the appropriate transition state for the specified reaction to occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>QET</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The QET applies to isolated molecular species in the absence of collisions, as for ion fragmentations in a mass spectrometer. Early formulations assumed the reactant contained \(s\) identical harmonic oscillators of frequency \(\nu\), with a transition state corresponding to just one critical oscillator containing at least \(m\) quanta corresponding to the critical energy for reaction \(\varepsilon^{\ast} = m\nu\). A further assumption that \(m \gg s\) leads to an ultra-simple expression for the unimolecular rate constant at total internal energy \(\varepsilon\): \(k(\varepsilon) = \nu[(\varepsilon - \varepsilon^{\ast})/\varepsilon]^{(s-1)}\). Elimination of most of these simplifying assumptions followed development of the Rice–Ramsperger–Kassel–Marcus (RRKM) theory.</rdfs:comment>
        <rdfs:label>quasi-equilibrium theory</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>QET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12544 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12544">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ejection of an ion from an ion trap in a direction perpendicular to the longitudinal axis of the trap.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>radial ejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12545 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12545">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Limiting droplet size at which self-fragmentation will occur for charged droplets generated in electrospray or other ionization processes. Self-fragmentation occurs when the electrostatic repulsion force generated by the excess charge exceeds the surface tension that maintains the integrity of the droplet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>Rayleigh limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12546 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12546">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gas that reacts with ions to produce product ions through ion/molecule reactions; for example, a gas such as methane, ammonia, or isobutane used in chemical ionization to create reagent ions or a gas used in ion traps or collision cells to perform gas-phase ion/molecule reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>reagent gas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12547"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12547 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12547">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion that reacts with a neutral to produce an ionized form of such species through an ion/molecule reaction, for example, as in chemical ionization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>reagent ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12548 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12548">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Energy released when an electron is added to an ionized molecule or atom.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This is the energy required for the reverse process of vertical ionization.</rdfs:comment>
        <rdfs:label>recombination energy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12549 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12549">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quadrupole ion trap whose electrodes form a rectilinear polygon, the simplest form of which consists of two pairs of rectangular electrodes supplied with radio frequency (RF) potentials and a pair of electrodes to which a DC potential is applied. Slits or apertures in the electrodes allow injection and ejection of charged particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>rectilinear ion trap</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12550 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12550">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stable ion whose structure or elemental formula is known with certainty. These ions are formed by direct ionization of a molecule of known structure or elemental formula, and are used to verify by comparison the structure or thermochemistry of an unknown ion or to calibrate the m/z scale of the mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>reference ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12551 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12551">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of an isotope ratio in a sample of interest relative to a reference defined by the relation \[\delta = (R_{\rm{sample}} - R_{\rm{standard}})/R_{\rm{standard}}\] where \(R\) is the isotope ratio of the element.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>delta notation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>isotope delta</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>relative difference of isotope ratios</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Relative isotope ratio differences are usually small and are therefore often expressed in units of parts per mil with symbol ‰.</rdfs:comment>
        <rdfs:comment>The reference is often an international measurement standard.</rdfs:comment>
        <rdfs:comment>The same relative differences are used to calculate delta values from the abundance of isotopomers and isotopologs, ion currents, frequencies, or optical extinctions.</rdfs:comment>
        <rdfs:comment>Units of parts per thousand (\(\pu{ppt}\), \(\pu{E-3}\)) or parts per million (\(\pu{ppm}\), \(\pu{E-6}\)) are deprecated.</rdfs:comment>
        <rdfs:label>relative isotope-ratio difference</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12452"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12455"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12552 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12552">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer used to measure the composition and pressure of gases in an evacuated chamber and to test for leaks in pressurized systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>RGA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>residual gas analyser</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12552"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RGA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12553 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12553">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value of \((m/z)/\Delta(m/z)\) measured for two peaks of equal height in a mass spectrum at m/z and \(m/z \pm \Delta(m/z)\) that are separated by a valley which at its lowest point is \(\pu{10\%}\) of the height of either peak. For peaks of similar height separated by a valley, let the height of the valley at its lowest point be \(\pu{10\%}\) of the lower peak. Then the resolution (\(\pu{10\%}\) valley definition) is \((m/z)/\Delta(m/z)\) and should be given for a number of values of m/z.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>resolution: 10 per cent valley definition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12554"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12554 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12554">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a single peak corresponding to singly charged ions at mass \(m\) in a mass spectrum, the resolution may be expressed as \((m/z)/\Delta(m/z)\), where \(\Delta(m/z)\) is the width of the peak at a height which is a specified fraction of the maximum peak height. It is recommended that one of three values 50, 5, or \(\pu{0.5\%}\) should always be used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>For an isolated symmetrical peak recorded with a system which is linear in the range between \(\pu{5\%}\) and \(\pu{10\%}\) levels of the peak, the \(\pu{5\%}\) peak width definition is equivalent to the \(\pu{10\%}\) valley definition. A common standard is the definition of resolution based upon \(\Delta m\) being full width of the peak at half its maximum (FWHM) height.</rdfs:comment>
        <rdfs:label>resolution: peak width definition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12553"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12555 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12555">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multiphoton ionization in which the ionization cross section is significantly enhanced because the energy of the incident photons is resonant with an intermediate excited state of the neutral.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>REMPI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>resonance ionization</oboInOwl:hasRelatedSynonym>
        <rdfs:label>resonance-enhanced multiphoton ionization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12555"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REMPI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12556 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12556">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mode of ion ejection in an ion trap that relies on an auxiliary radio frequency potential that is applied to the end-cap or trapping electrodes. The potential is tuned to the classical oscillation frequency of a particular ion to eject it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>resonance ion ejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12557 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12557">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion fragmentation mechanism in which the molecular ion \(\ce{M^{+.}}\) of a cyclic alkene fragments to form a neutral diene and an alkene radical cation or a diene radical cation and an alkene. The reaction is the reverse of the Diels–Alder reaction of organic synthesis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>retro Diels–Alder reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12558 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12558">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Double-focusing mass spectrometer configuration in which the ion beam traverses the magnetic sector prior to the electric sector.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>reverse geometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12417"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12559 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12559">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of comparing a subset of the peaks in the mass spectrum of an unknown compound with peaks present in the library mass spectrum. Any peaks in the mass spectrum of the unknown compound that are not in the library spectrum are disregarded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>A reverse library search measures the extent to which the peaks in a reference spectrum are present in the unknown spectrum and is more effective than a forward library search when peaks arising from two or more components are present in the unknown spectrum</rdfs:comment>
        <rdfs:label>reverse library search</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12418"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12560 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12560">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transmission quadrupole device in which a sinusoidal radio frequency (RF) potential is applied between the connected pairs of opposite rod electrodes in a linear quadrupole, providing a transmission device for all ions with m/z values above a cut-off value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Higher-order multipoles can also be used in this manner.</rdfs:comment>
        <rdfs:label>RF-only quadrupole</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12363"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12561 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12561">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conventional measure of the degree of unsaturation of an organic molecule given by \(X - Y/2 + Z/2 + 1\) where \(X\) is the number of carbon atoms, \(Y\) is the number of hydrogen or halogen atoms and \(Z\) is the number of nitrogen and phosphorus atoms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>ring and double bond equivalent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compact ion and fast atom sources for use when small size and high beam intensity are required, as in fast atom bombardment mass spectrometry. The discharge is produced by electrons oscillating between two cold cathodes in an electric field that possesses a single saddle point. To produce and intensify the plasma the electrons must have long path lengths, achieved by allowing the electrons to have an oscillatory motion in the saddle-shaped electric field between the cathodes separated by the anode.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>saddle field gun</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12411"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12563 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12563">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of a spray ionization interface that consists of a cone with a small orifice through which the spray passes into a differentially pumped chamber</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>A capillary can also be used in place of a cone.</rdfs:comment>
        <rdfs:comment>In interfaces that have both a sampling cone and skimmer, the spray passes first through the sampling cone and then through the skimmer.</rdfs:comment>
        <rdfs:label>sampling cone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12574"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12579"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time required to obtain a mass spectrum (or other mass spectrometric data quantity) such as in a separation coupled to mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>scan cycle time</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometry technique in which neutral species ejected from a sample surface as a result of bombardment by a primary beam of atoms or ions are ionized, most often by photoionization, prior to analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SNMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>secondary neutral mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12565"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SNMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer consisting of one or more magnetic sectors for recording a mass spectrum of a monoenergetic beam of ions. Such instruments may also have one or more electric sectors for energy dispersion that can be arranged for velocity-focusing by compensating for dispersion by the magnetic sector if the beam is not truly monoenergetic. Such a combination provides double focusing of ions of the same m/z, i.e., focusing with respect to both direction and speed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>sector mass spectrometer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device in which m/z selected ions are entrained in an inert carrier gas and subsequently undergo ion/molecule reactions with molecules introduced into the gas flow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SIFT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>selected ion flow tube</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12397"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12567"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SIFT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12568 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12568">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Data acquired from one or more specific product ions corresponding to m/z selected precursor ions recorded via two or more stages of mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SRM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Selected reaction monitoring applied to multiple product ions from one or more precursor ions is known as multiple reaction monitoring.</rdfs:comment>
        <rdfs:comment>Selected reaction monitoring in multiple-stage mass spectrometry is known as consecutive reaction monitoring.</rdfs:comment>
        <rdfs:label>selected reaction monitoring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12568"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SRM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12569 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12569">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical ionization of an analyte where the reagent ion is an ionized form of the analyte or one of its product ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>self-CI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>self-chemical ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12547"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12569"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>self-CI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12570 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12570">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capillary electrophoresis to electrospray ionization interface that uses a coaxial flow of make-up liquid that is introduced through a tube that is concentric with the separation capillary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>sheath flow interface</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12475"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12571 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12571">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gas introduced through a tube that is coaxial with the electrospray emitter to pneumatically assist the formation of the sprayed droplets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>sheath gas</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12572 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12572">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Make-up liquid in a sheath flow interface</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>sheath liquid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12475"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12570"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12573 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12573">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein identification using a combination of high-performance liquid chromatography and mass spectrometry in which the proteins in a mixture are digested, usually by a specific enzyme, and the resulting peptides are separated by liquid chromatography and identified by tandem mass spectrometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>shotgun proteomics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12591"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12574 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cone with a central orifice that intercepts the center of a spray or jet expansion to sample the central portion of the expansion, for example, as in a momentum separator.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>skimmer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12493"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12575 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12575">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of gas-phase ions without extensive fragmentation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>soft ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12424"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12576 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12576">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which both anions and cations are produced at atmospheric pressure from an ionic solution due to a statistically unbalanced charge distribution in the minute droplets formed by the action of a sonic atomizer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SSI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sonic spray ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12579"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12576"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SSI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12577 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12577">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Result of mutual repulsion of particles of like charge (ions, electrons, etc.) that can limit the current in a charged-particle beam and can also cause some motion of ions in a beam or packet in addition to that caused by external fields.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Space charge effects on ion trajectories are most noticeable in ion trap instruments that confine large numbers of ions in a small volume.</rdfs:comment>
        <rdfs:label>space charge effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12447"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12578 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12578">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deviation of the peak intensities in a mass spectrum from their expected values that occurs when the relative concentration of the various analytes change during acquisition of the mass spectrum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>spectral skewing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12579 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12579">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General term used to describe a range of ionization techniques for analytes in solution that involve dispersing the liquid into fine droplets as a component step.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Most of these techniques are examples of atmospheric pressure ionization.</rdfs:comment>
        <rdfs:label>spray ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12580 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12580">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proteomics technique that detects differences in protein abundance between cultured cell samples using stable isotopic labeling achieved with labeled amino acids in one cell culture and unlabeled ones in a separate culture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SILAC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>stable isotope ratio analysis of amino acids in cell culture</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12580"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SILAC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12581 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12581">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for absolute quantitation of a protein or proteins in a multiplexed fashion using isotope-labeled peptides as surrogate internal standards. The labeled peptides are produced by synthesizing a gene coding for each desired peptide, cell-free transcription, and translation of this gene in a medium containing \(\ce{^{13}C6}\)-labeled lysine, and digesting with trypsin the expressed protein composed of the desired concatenated peptides. For low-abundance proteins the sensitivity is increased by selective enrichment of the target peptides by antibody capture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SISCAPA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>stable isotope standards and capture by anti-peptide antibodies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12589"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12581"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SISCAPA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12582 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12582">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electric or magnetic field that does not change in time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>static field</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12583 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12583">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rule stating that in competing fragmentations the product ion formed from its neutral species counterpart with the lower ionization energy will usually be the more abundant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>The original version of this rule referred to reliability of determination of thermochemical data obtained for an ion produced by fragmentation of a single \(\ce{\upsigma\mbox{-}bond}\) in an odd-electron ion \(\ce{X{-}Y^{+.}}\), but was later extended to the version in more common use since then.</rdfs:comment>
        <rdfs:label>Stevenson’s rule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12584 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12584">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique to create excitation waveforms for ions in Fourier transform-ion cyclotron resonance-mass spectrometers or Paul ion traps. An excitation waveform in the time-domain is generated by taking the inverse Fourier transform of an appropriate frequency-domain programmed excitation spectrum, in which the resonance frequencies of ions to be excited are included.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SWIFT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This procedure may be used for selection of precursor ions in MSn experiments.</rdfs:comment>
        <rdfs:label>stored waveform inverse fourier transform</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12584"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SWIFT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12585 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12585">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Combined technique in which a mixture of analytes is separated into solutions of individual components by chromatography that uses a supercritical fluid as mobile phase, followed by the ionization of the separation effluent in the ion source of a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SFC-MS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>supercritical fluid chromatography/mass spectrometry (SFC/MS)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>supercritical fluid chromatography-mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12585"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SFC-MS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12586 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12586">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variant of matrix-assisted laser desorption/ionization (MALDI) in which the matrix is replaced by a surface coating of a chromatographic stationary phase designed to selectively retain different subsets of proteins or peptides from a mixture depending on their physico-chemical properties or biochemical affinity characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SELDI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Originally this technique was named surface-enhanced affinity capture (SEAC) to distinguish it from surface-enhanced neat desorption (SEND) where the surface coating is designed to increase the efficiency of laser desorption.</rdfs:comment>
        <rdfs:label>surface-enhanced laser desorption/ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12462"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12586"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SELDI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12587 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12587">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragmentation that results from the collision of an ion with a surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SID</oboInOwl:hasRelatedSynonym>
        <rdfs:label>surface-induced dissociation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12587"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SID</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12588 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12588">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process wherein a reactant ion interacts with a surface to produce either chemically different species or a change in the internal energy of the reactant ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SIR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>surface-induced reaction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12588"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SIR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12589 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12589">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound added in accurately known amounts to a sample to be analyzed for a specified analyte. The surrogate internal standard is chemically similar to the analyte so that losses in the analytical procedure are the same for both and thus the analyte concentration can be determined relative to that of the standard.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>internal standard</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In quantitative mass spectrometry the preferred type is an isotope-labeled version of the analyte.</rdfs:comment>
        <rdfs:comment>The abbreviated term &quot;internal standard&quot; is often used.</rdfs:comment>
        <rdfs:label>surrogate internal standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12608"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12590 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12590">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure associated with Fourier transform-ion cyclotron resonance-mass spectrometers to facilitate ion/neutral reactions such as low-energy collision-induced dissociation in which a radio-frequency electric field, slightly off-resonance with respect to the cyclotron frequency of the reactant ion, cyclically accelerates and decelerates the reactant ion that is confined in the Penning ion trap. As a consequence, the orbit does not exceed the dimensions of the ion trap but maintains a high average translational energy for an extended time that activates an ion/neutral process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>SORI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sustained off-resonance irradiation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12472"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12521"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SORI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12591 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12591">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tandem mass spectrometry procedure in which product ion spectra are recorded for ion beams in m/z analyzers separated in space. Specific m/z separation functions are designed so that in one section of the instrument ions are selected, dissociated in an intermediate region, and the product ions are then transmitted to another analyzer for m/z separation and data acquisition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>tandem mass spectrometry in space</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12535"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12592 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12592">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tandem mass spectrometry procedure in which product ion spectra are recorded in a single m/z analyzer (such as a Paul ion trap, linear ion trap, or Fourier transform-ion cyclotron resonance-mass spectrometer) in discrete steps over time. Ions in a specific m/z range are selected, dissociated, and the product ions analyzed sequentially in time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>Mass spectrometers that can perform tandem mass spectrometry in time can also perform MSn.</rdfs:comment>
        <rdfs:label>tandem mass spectrometry in time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12535"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12593 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12593">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conical shape of the liquid emanating from a capillary under high potential, as in electrospray or other electrohydrodynamic spray processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>Taylor cone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12594 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12594">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spray ionization in which a liquid is flowed through a heated capillary to produce a spray of droplets and solvent vapor. Ions are formed due to the statistical imbalance of charges in the droplets or by a heated filament.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>thermospray ionization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12579"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12595 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12595">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique by which a mixture of analytes is separated into individual components by liquid chromatography, followed by the ionization of the separated species by an ion source of a mass spectrometer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>TLC-MS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thin layer chromatography/mass spectrometry (TLC/MS)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thin layer chromatography-mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLC-MS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12596 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12596">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Energy focusing of ions formed in the gas phase in a time-of-flight mass spectrometer that is accomplished by introducing a time delay between the formation of the ions and the application of the accelerating potential pulse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>TLF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>time-lag focusing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12383"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12597 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12597">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Even-electron \(\ce{C7H7^{+}}\) ion with the same carbon skeleton as toluene that has lost a hydrogen atom from one of the ring carbons that carries the positive charge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>tolyl ion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12346"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12598 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12598">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion trapping device based on the three-dimensional structure formed by rotating the cross-section of a quadrupole ion trap about the edge perpendicular to the plane of the ring electrode. The resulting trapping region is toroidal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>toroidal ion trap</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12599 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12599">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plot of the total ion current in each of a series of mass spectra that are recorded as a function of electrophoresis time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>total ion current electrophorogram</oboInOwl:hasRelatedSynonym>
        <rdfs:label>total ion current electropherogram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12600 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12600">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any plot of total ion current in a series of mass spectra recorded as a function of time, including total ion current chromatogram, total ion current electropherogram, flow injection mass spectrometry, or any other time dependent sampling.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>total ion current profile</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12410"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12599"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12601 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12601">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the number of ions leaving a region of a mass spectrometer to the number entering that region.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>transmission efficiency</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12602 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12602">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer that consists of an array of four parallel rod electrodes whose centers form the corners of a square and whose opposing electrode pairs are connected. The electric potential applied between the connected pairs of rods is a superposition of a static potential and a sinusoidal radio frequency potential. The motion of an ion in the \(x\mbox{-}y\) plane perpendicular to the length direction of the rod electrodes is described by the Mathieu equation whose solutions show that ions in a particular m/z range can be transmitted along the \(z\mbox{-}\rm{axis}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <oboInOwl:hasRelatedSynonym>quadrupole mass analyzer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>quadrupole mass filter</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>quadrupole mass spectrometer</oboInOwl:hasRelatedSynonym>
        <rdfs:label>transmission quadrupole mass spectrometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12603 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12603">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region in a mass spectrometer in which an ion beam is transported from the ion source to the ion optics or from one ion optical element to the next.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>transport region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12444"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12604 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12604">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tandem mass spectrometer comprising two transmission quadrupole mass spectrometers in series, with a (non-selecting) RF-only quadrupole (or other multipole) between them to act as a collision cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>triple quadrupole mass spectrometer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12605 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12605">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragmentation reaction in which the molecularity of the reaction system is unity. The dissociation may arise from the extra energy acquired by a metastable ion produced in the ion source or that provided by collisional excitation of a stable ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>unimolecular dissociation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12606 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12606">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass resolution such that it is possible to clearly distinguish a peak corresponding to a singly charged ion from its neighbors \(\pu{1 u}\) away, usually with no more than \(\pu{5\!-\! 10\%}\) overlap.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>This term is most frequently used to describe resolution obtained using a Paul ion trap or a transmission quadrupole mass spectrometer.</rdfs:comment>
        <rdfs:label>unit mass resolution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12607 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12607">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-energy product ion of a protonated peptide formally equivalent to a y-ion with the ionizing proton on the \(\ce{N}\)-terminus, but with elimination of \(\ce{HR}\) from the \(\ce{N}\)-terminus where \(\ce{R}\) is the side-chain on the \(\ce{C}\)-atom of the \(\ce{N}\)-terminal residue, to give a (\(\ce{H2N^{+}=CH-CO\bond{-}}\)) structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>v-ion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12613"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12608 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12608">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound added in a fixed reproducible amount to a solution to be analyzed by gas chromatography to permit corrections for uncontrolled variations in injected volumes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>volumetric internal standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12589"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12609 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12609">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diagram illustrating the relative contributions in unimolecular dissociation of an ion, for example, by homolytic cleavage of a single bond, and fragmentation following rearrangement. The diagram is in two parts with a common horizontal axis representing the internal energy of the ion. The vertical axis in one part of the diagram shows the two types of rate constant on a logarithmic scale, and that for the other portion of the diagram indicates the distribution function for internal energy of the ion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>Wahrhaftig diagram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12605"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12610 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12610">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass spectrometer in which m/z separation is achieved using crossed electric and magnetic fields.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:comment>It can also be operated as a charged particle energy analyzer or monochromator.</rdfs:comment>
        <rdfs:label>Wien filter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12611 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12611">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-energy product ion of a protonated peptide formally equivalent to a z-ion that has lost the part of the \(\ce{N}\)-terminal side-chain starting at the \(\ce{\upgamma\mbox{-}carbon}\) (if any).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>w-ion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12614"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12612 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12612">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion containing the peptide \(\ce{C}\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \(\ce{C-C}\) bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>x-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12613 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12613">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion containing the peptide \(\ce{C}\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \(\ce{C-N}\) bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>y-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12614 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12614">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragment ion containing the peptide \(\ce{C}\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \(\ce{N-C}\) bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-06-04-06"/>
        <rdfs:label>z-ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12615 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12615">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acronym referring to the absorption, distribution, metabolism, excretion, and toxicity profile or processes for a xenobiotic upon its administration in vivo.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>ADME is also used to delineate these selected parameters within the context of a xenobiotic’s pharmacokinetic profile. Because any of the five characteristics may become hurdles during drug development, ADMET behaviour is typically studied and optimized among efficacious analogues during the early drug discovery stage by using in vitro models that attempt to predict such behaviours in clinical studies.</rdfs:comment>
        <rdfs:label>ADMET</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12646"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12616 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12616">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that binds to a receptor at a site separate from, but actively coupled to, that of the endogenous agonist to reduce actively receptor signals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>The terms &quot;allosteric antagonist&quot; and &quot;noncompetitive antagonist&quot; are often synonymous but not necessarily so.</rdfs:comment>
        <rdfs:label>allosteric antagonist</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12694"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12617 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12617">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secondary 3D structure of a protein or peptide containing a right-handed coiled or spiral conformation, in which every backbone \(\ce{N-H}\) group donates a hydrogen bond to the backbone \(\ce{C=O}\) group of the amino acid four residues earlier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>alpha-helix</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12618 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12618">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical compound having structural similarity to a reference compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>analog</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Despite the structural similarity, an analogue may display different chemical and/or biological properties, as is often intentionally the case during design and synthesis to optimize either efficacy or ADMET properties within a given series.</rdfs:comment>
        <rdfs:label>analogue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12615"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12658"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12619 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12619">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Strategy for drug discovery and/or optimization in which structural modification of an existing drug provides a new drug with improved chemical and/or biological properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>analog-based drug discovery</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Within the context of analogue-based drug discovery, three categories of drug analogues are recognized: Compounds possessing structural, chemical, and pharmacological similarities, termed &quot;direct analogues&quot; and sometimes referred to as &quot;me-too&quot; drugs; compounds possessing structural and often chemical but not pharmacological similarities, termed &quot;structural analogues&quot;; and structurally different compounds displaying similar pharmacological properties, termed &quot;pharmacological analogues&quot;.</rdfs:comment>
        <rdfs:label>analogue-based drug discovery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12679"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12681"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12620 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12620">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large gene family of transporter proteins that bind ATP and use the energy to transport substrates (e.g., sugars, amino acids, metal ions, peptides, proteins, and a large number of hydrophobic compounds and metabolites) across lipid membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>ABC protein</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These proteins have an important role in limiting oral absorption and brain penetration of xenobiotics.</rdfs:comment>
        <rdfs:label>ATP binding cassette protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12653"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12704"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12621 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12621">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of loss of drug candidates during progression through the optimisation and developmental stages while on route to the marketplace.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>It has been estimated that for every \(\pu{10000}\) compounds examined during the early stages of biological testing just one reaches the market.</rdfs:comment>
        <rdfs:label>attrition rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12622 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12622">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capacity of a drug to induce enzymes that mediate its own metabolism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>This often results in lower, often sub-therapeutic, drug exposure on prolonged or multiple dosing.</rdfs:comment>
        <rdfs:label>autoinduction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12623 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12623">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule selected as a replacement for the lead drug candidate should this subsequently fail during further preclinical evaluation or in clinical studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Ideally, a back-up should be pharmacologically equivalent to the lead drug but have significant structural differences. Possession of a distinct core scaffold is optimal.</rdfs:comment>
        <rdfs:label>back-up compound</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12624 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12624">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug acting on a specific molecular target that provides the best balance between efficacy and adverse effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>best-in-class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12625 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12625">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secondary 3D protein structure containing a large beta-sheet that twists and coils to form a closed structure in which the first-strand hydrogen bonds to the last.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>beta-barrel</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12626 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12626">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secondary 3D structure of a protein that takes on a flat, pleated appearance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Other common protein structural motifs are the alpha-helix and beta-barrel.</rdfs:comment>
        <rdfs:label>beta-sheet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12617"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12625"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12627 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12627">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that on binding to a protein disrupts beta-sheet formation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>beta-sheet breaker</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12628 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12628">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biopolymer-based pharmaceutical, such as a protein, applicable to the prevention, treatment, or cure of diseases or injuries to man.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Biological agents may be any virus, therapeutic serum, toxin, antitoxin, vaccine, blood component or derivative, allergenic product, or analogous products.</rdfs:comment>
        <rdfs:label>biological agent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12629 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12629">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug that generates annual sales of USD 1 billion (\(\$\pu{E9}\)) or more.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>blockbuster drug</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12630 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12630">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent (chemical, physical, or biological) that is capable of increasing the incidence of malignant neoplasms, thus causing cancer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>carcinogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12631 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12631">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of chemistry to the study of molecular events in biological systems, often using tool compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Distinguished from medicinal chemistry, which is focused on the design and optimisation of compounds for specific molecular targets.</rdfs:comment>
        <rdfs:label>chemical biology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12632 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12632">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific electronic repository for storage and retrieval of chemical information.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>A free database of chemical structures of small organic molecules and information on their biological activities is available from PubChem.</rdfs:comment>
        <rdfs:comment>Chemical structural information is sometimes stored in string notation such as the InChI or SMILES notations.</rdfs:comment>
        <rdfs:comment>Such databases can be searched to retrieve structural information and data on specific or related molecules.</rdfs:comment>
        <rdfs:label>chemical database</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12671"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12633 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12633">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of samples (e.g., chemical compounds, natural products, over-expression library of a microbe) available for biological screening. Set of compounds produced through combinatorial chemistry or other means that expands around a single core structure or scaffold.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>compound collection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>compound library</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chemical library</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12634 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12634">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of all possible stable molecules based on a specific chemical entity that interacts at one or more specific molecular targets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>chemical space</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12635 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12635">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systematic screening of chemical libraries of congeneric compounds against members of a target family of proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>chemical genomics</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chemogenomics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12633"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12636 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12636">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a superfamily of proteins with the primary function to control leukocyte activity and trafficking through tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>chemokine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12637 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12637">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two chemically linked synergistic drugs designed to improve the drug delivery properties of one or both drugs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>mutual prodrug [1]</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The constituent drugs are indicated for the same disease, but may exert different therapeutic effects via disparate mechanisms of action.</rdfs:comment>
        <rdfs:label>co-drug</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12638 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12638">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor or enzymatic function displayed in the absence of an agonist or activator.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>constitutive activity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12639 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12639">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Commercial organisation that can be engaged to undertake specifically defined chemical, biological, safety, or clinical studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>CRO</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Typically, such studies are subject to confidentially agreements.</rdfs:comment>
        <rdfs:label>contract research organisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12639"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12640 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12640">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand that binds irreversibly to its molecular target through the formation of a new chemical bond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>covalent drug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12641 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12641">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compounds conceived and synthesised to act on two or more molecular targets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>designed multiple ligands</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12642 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12642">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unrelatedness of a set of molecules (e.g., building blocks or members of a compound library), as measured by properties such as atom connectivity, physical properties, or computationally generated descriptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>diversity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12643 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12643">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Efficient production of a range of structures and templates with skeletal and stereochemical diversity as opposed to the synthesis of a specific target molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>DOS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>diversity-oriented synthesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12643"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12644 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12644">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>­(in drug therapy) Administration of two or more distinct pharmacological agents to achieve a combination of their individual effects. Note 1: The combined effect may be additive, synergistic, or designed to reduce side-effects. Note 2: This term is often used synonymously with that of &apos;drug combination&apos; but is preferred in order to avoid confusion with medications in which different drugs are included in a single formulation. (in drug testing) Administration of two or more distinct compounds to test simultaneously their individual behaviours (e.g., pharmacological effects in high-throughput screens or drug metabolism).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>drug combination</oboInOwl:hasRelatedSynonym>
        <rdfs:label>drug cocktail</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12645 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12645">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a drug is administered to its intended recipient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>drug delivery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12646"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12732"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12646 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12646">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measured amounts of an administered compound in various parts of the organism to which it is given.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>drug distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12647 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12647">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capacity of a molecular target to be modulated in a favourable manner by a small-molecule drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>It is estimated that only around \(\pu{10\%}\) of the human genome affords druggable targets.</rdfs:comment>
        <rdfs:label>druggability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12648 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12648">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Strategy that seeks to discover new applications for an existing drug that were not previously referenced and not currently prescribed or investigated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>drug repositioning</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>drug reprofiling</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Various additional synonymous terms have been used to describe the process of drug repurposing. All appear to be used interchangeably.</rdfs:comment>
        <rdfs:label>drug repurposing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12649 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12649">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assessment of the nontolerable biological effects of a drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Because the nontolerable effects of a drug are directly related to its concentration or dose, safety is generally ranked relative to the dose required to obtain the desirable effect.</rdfs:comment>
        <rdfs:label>drug safety</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12735"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12650 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12650">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of two distinct ligand binding sites on the same molecular target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>dual binding site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12651 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12651">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance that produces a defined magnitude of response in a given system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>EC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>EC50 is the median dose that causes \(\pu{50\%}\) of the maximal response.</rdfs:comment>
        <rdfs:comment>The term usually refers to an agonist in a receptor system effect and could represent either an increase or a decrease in a biological function.</rdfs:comment>
        <rdfs:label>effective concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12652"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12669"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12651"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12652 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12652">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose of a substance that causes a defined magnitude of response in a given system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>ED</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>ED50 is the median dose that causes \(\pu{50\%}\) of the maximal response.</rdfs:comment>
        <rdfs:label>effective dose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12669"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12652"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ED</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12653 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12653">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transporter protein located in the membrane of cells that utilizes active transport to move a compound from the internal to the external environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>efflux pump</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12704"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12654 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12654">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Analytical composition of a mixture or solution that is saturated with one of the components in the designated mixture or solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Solubility may be expressed in any units corresponding to quantities that denote relative composition, such as mass, amount concentration, molality, etc.</rdfs:comment>
        <rdfs:comment>The mixture or solution may involve any physical state: solid, liquid, gas, vapour, supercritical fluid.</rdfs:comment>
        <rdfs:comment>The term &quot;solubility&quot; is also often used in a more general sense to refer to processes and phenomena related to dissolution.</rdfs:comment>
        <rdfs:label>equilibrium solubility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12672"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12676"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12730"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12655 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12655">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound selected as a rapid successor to a lead drug candidate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Fast followers usually possess a marked increase in one or more pharmacological/pharmaceutical characteristics such as potency, efficacy, therapeutic index, or physicochemical parameters (e.g., solubility).</rdfs:comment>
        <rdfs:label>fast follower</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12656 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12656">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Representation of a compound or chemical library by attributes (descriptors) such as atom connectivities, 3D structure, or physical properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>fingerprint</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12633"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12657 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12657">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First drug acting on a hitherto unaddressed molecular target to reach the market.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>first-in-class</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12658 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12658">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug having a similar mechanism of action to an existing drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Compounds may be of the same or different chemical class. A therapeutic advantage over first-in-class drugs must be demonstrated for regulatory approval.</rdfs:comment>
        <rdfs:label>follow-on drug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12618"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12657"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12659 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12659">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Low-molar-mass ligand (typically smaller than \(\pu{200 Da}\)) that binds to a target with low affinity but high ligand efficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Typically fragments have affinities in a concentration interval from \(\pu{0.1 mm}\) to \(\pu{1.0 mM}\).</rdfs:comment>
        <rdfs:label>fragment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12660 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12660">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Screening libraries of low-molar-mass compounds (typically \(\pu{120\!{-}\! 250 Da}\)) using sensitive biophysical techniques capable of detecting weakly binding lead compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>X-ray structures are frequently used to drive the optimisation of fragment hits to leads.</rdfs:comment>
        <rdfs:label>fragment-based lead discovery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12677"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12661 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12661">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural feature that regularly results in a positive response in a variety of high-throughput or primary screens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Such compounds often exert their actions through nonspecific mechanisms and are therefore unreliable leads.</rdfs:comment>
        <rdfs:label>frequent hitter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12662 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12662">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a family of membrane-associated proteins which on activation by cellular receptors lead to signal transduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>guanine binding protein</oboInOwl:hasRelatedSynonym>
        <rdfs:label>G protein</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12663 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12663">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Invention, design, and application of chemical products and processes to reduce or eliminate the use and generation of hazardous substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>green chemistry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12664 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12664">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule that produces reproducible activity above a defined threshold in a biological assay and whose structural identity has been established.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Hits typically derive from high-throughput screening initiatives or other relatively extensive primary assays and do not become true hits until fully validated.</rdfs:comment>
        <rdfs:label>hit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12665 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12665">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generation of additional compound sets that contain chemical motifs and scaffolds that have activity in the primary screen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>This methodology permits the identification of additional hits and new scaffolds and develops structure-activity relationships around existing hits.</rdfs:comment>
        <rdfs:label>hit expansion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12666 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12666">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a proven molecule or series derived from high-throughput screening or primary screens is chemically optimised to a viable lead or series.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>hit-to-lead chemistry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12677"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12667 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12667">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Computational representation of a protein built from the 3D structure of a similar protein or proteins using alignment techniques and homology arguments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>homology model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12668 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12668">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Representation of the lipophilicity contribution of a constituent part of a structure to the total lipophilicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>hydrophobic fragmental constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12669 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12669">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The concentration of an enzyme inhibitor or receptor antagonist that reduces the enzyme activity or agonist response by \(\pu{50\%}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>\(\rm{IC}_{50}\) values are influenced by experimental conditions (e.g., substrate or agonist concentration, which should be specified).</rdfs:comment>
        <rdfs:label>inhibitory concentration at 50%</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12670"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12670 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12670">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equilibrium dissociation constant of an enzyme-inhibitor complex: \(K_{\rm{i}} = [\ce{E}][\ce{I}]/[\ce{EI}]\). The equilibrium dissociation constant of a receptor-ligand complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>This value is usually obtained through competition binding experiments, where the \(K_{\rm{i}}\) is determined after the IC50 obtained in a competition assay performed in the presence of a known concentration of labeled reference ligand.</rdfs:comment>
        <rdfs:label>inhibition constant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12672 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12672">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equilibrium solubility of the uncharged form of an ionisable compound at a pH where it is fully unionised. \[\ce{HA(s)  HA(aq)} \quad (1)\] \[\ce{HA(aq)  H^{+}(aq) + A^{-}(aq)} \quad (2)\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>The intrinsic solubility can be determined from the analytical composition at a \(\pu{pH}\) where \([\ce{HA}]\) is very much greater than \([\ce{A^{-}}]\).</rdfs:comment>
        <rdfs:label>intrinsic solubility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12654"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12676"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12730"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12673 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12673">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug not yet approved for general use by the national authority, such as the Food and Drug Administration of the United States of America, but undergoing clinical investigation to assess its safety and efficacy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>IND</oboInOwl:hasRelatedSynonym>
        <rdfs:label>investigational new drug</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IND</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12674 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12674">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transmembrane ion channel that opens or closes in response to the binding of a ligand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>ionotropic receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12675 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12675">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that transfers a phosphate group from high-energy donor molecules, such as ATP, to specific target molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>phosphotransferase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>kinase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12676 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12676">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Composition of a solution with respect to a compound when its induced precipitate first appears.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>turbidimetric solubility</oboInOwl:hasRelatedSynonym>
        <rdfs:label>kinetic solubility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12654"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12672"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12730"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12677 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12677">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound (or compound series) that satisfies predefined minimum criteria for further structure and activity optimization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Typically, a lead will demonstrate appropriate activity, selectivity, tractable structure-activity relationship and have confirmed activity in a relevant cell-based assay.</rdfs:comment>
        <rdfs:label>lead</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12678"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12678 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12678">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a lead compound is authenticated by the confirmation of its expected pharmacological properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Usually, a cluster of structurally similar compounds showing discernable structure-activity relationships will support the validation process.</rdfs:comment>
        <rdfs:label>lead validation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12677"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12679 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12679">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of drug discovery and/or optimization in which the pursuit of new structures and/or structural modifications is based upon one or more ligands known to interact with the molecular target of interest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>This approach is applicable even when no structural detail of the target is known. In such cases a series of analogues is usually prepared and tested to produce structure-activity relationship data that can be extrapolated to indirectly derive a topographical map of the biological surface.</rdfs:comment>
        <rdfs:label>ligand-based drug design</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12618"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12680 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12680">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor that modulates electric potential-gated channels via G-proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>The interaction can occur entirely within the membrane or by the generation of diffusible second messengers. The involvement of G-proteins causes the activation of these receptors to last tens of seconds to minutes, in contrast with the brief effect of ionotropic receptors.</rdfs:comment>
        <rdfs:label>metabotropic receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12662"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12674"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12681 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12681">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term applied to drug analogues that offer no significant advantage over the prototype compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Continued use of this term is not recommended.</rdfs:comment>
        <rdfs:label>me-too drug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12618"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12658"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12682 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12682">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small single-stranded RNA molecules that play a significant role in the post-transcriptional regulation of gene expression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>miRNA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MicroRNA usually comprises approximately 22 nucleotides.</rdfs:comment>
        <rdfs:label>microRNA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12682"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>miRNA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12683 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12683">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parameter that characterizes a specific structural or physicochemical aspect of a molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>molecular descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12684 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12684">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein (e.g., receptor, enzyme, or ion channel), RNA, or DNA that is implicated in a clinical disorder or the propagation of any untoward event.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Usually, biochemical, pharmacological, or genomic information supporting the role of such a target in disease will be available.</rdfs:comment>
        <rdfs:label>molecular target</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12685 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12685">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristic of cells that confers resistance to the effects of several different classes of drugs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>MDR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>There are several forms of drug resistance. Each is determined by genes that govern how cells will respond to chemical agents. One type of multidrug resistance involves the ability to eject several drugs out of cells (e.g., efflux pumps such as P-glycoprotein).</rdfs:comment>
        <rdfs:label>multidrug resistance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12653"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12704"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12685"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MDR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12686 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12686">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug-likeness penetrability algorithm derived from CLOGP, clogD, molar mass, topological polar surface area, number of hydrogen-bond donors, and \(\pu{p}K_{\rm{a}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>MPO</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The MPO desirability score is larger or equal to 4 on a scale of 0 to 6.</rdfs:comment>
        <rdfs:label>multiparameter optimisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12687 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12687">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand acting on more than one distinct molecular target. Targets may be of the same or different mechanistic classes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>MTDL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>multitarget drug</oboInOwl:hasRelatedSynonym>
        <rdfs:label>multitarget-directed ligand</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12687"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MTDL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12688 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12688">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deliberate design of compounds that act on more than one molecular target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>MTDD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>multitarget drug discovery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12688"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MTDD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12689 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12689">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Core scaffold of a molecule that remains after all chain substituents that do not terminate in a ring are removed. Single atoms connected by a double bond are typically also retained.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>Murcko assembly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12690 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12690">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term used to emphasise an imbalance between therapeutic needs and resource allocation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Different groups define neglected diseases differently, but typically they include diseases such as schistosomiasis, Chagas disease, tuberculosis, and malaria, as well as other parasitic and vector-borne diseases.</rdfs:comment>
        <rdfs:comment>The terms &quot;tropical disease&quot; and &quot;neglected disease&quot; are sometimes indistinguishable or used interchangeably.</rdfs:comment>
        <rdfs:label>neglected disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12698"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12691 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12691">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand that blocks the responses of a receptor to both agonists and inverse agonists with the same intensity. It binds to the receptor without evoking any change of conformation or change to the ratio of activated to inactivated conformations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Perfect neutral antagonism is difficult to achieve.</rdfs:comment>
        <rdfs:label>neutral antagonist</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12692 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12692">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug that contains no active moiety previously approved for use by the national authority, such as the U.S. Food and Drug Administration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>new chemical entity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12693"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12693 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12693">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Active ingredient that has never before been approved in any form by the national authority, such as the U.S. Food and Drug Administration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>new molecular entity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12692"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12694 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12694">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Functional antagonist that either binds irreversibly to a receptor or to a site distinct from that of the natural agonist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>noncompetitive antagonist</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12616"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12695 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12695">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand-activated transcription factor that regulates gene expression by interacting with specific DNA sequences upstream of its target gene(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>nuclear receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nuclear hormone receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12696 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12696">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term associated with intellectual property wherein the latter’s patentability is assessed relative to the combination of more than one item of &apos;prior art&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>To be patentable within the context of medicinal chemistry, a given compound must be: (i) novel, in that its specific arrangement of atoms has never been previously disclosed; (ii) non-obvious, in that its specific arrangement of atoms is not readily suggested to be of benefit by a person having ordinary skill in the art upon considering two or more other, previously disclosed structures; and, (iii) useful, in that it should have some benefit, the disclosure of the latter encompassing a valid &quot;reduction to practice&quot;.</rdfs:comment>
        <rdfs:label>obviousness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12702"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12697 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12697">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pharmacological action induced by any molecule at molecular/biological sites distinct from that for which it was designed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Such effects are dose-dependent and may be beneficial, adverse, or neutral.</rdfs:comment>
        <rdfs:label>off-target effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12698 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12698">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease for which drug research, development, and marketing is economically unfavourable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Sometimes the term &quot;rare disease&quot; is used synonymously with orphan disease, although there is a slight difference. For example, a rare disease is so uncommon that there is no drug development effort.</rdfs:comment>
        <rdfs:comment>The poor commercial environment could be due to a lack of economic incentives or a lack of understanding of the diseases or a combination of both.</rdfs:comment>
        <rdfs:comment>Which diseases are classified as orphan depends strongly on the country that classifies it. In the United States, for example, any disease affecting less than \(\pu{200000}\) people is considered an orphan or rare disease. Europe and countries such as Japan, Australia, and Singapore have a different definition.</rdfs:comment>
        <rdfs:label>orphan disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12699"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12699 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12699">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pharmaceutical agent that has been approved specifically to treat a rare and commercially unfavourable medical condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>orphan drug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12698"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12700 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12700">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor for which an endogenous ligand has yet to be identified.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>orphan receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12701 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12701">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simultaneous preparation of sets of discrete compounds in arrays of physically separate reaction vessels or microcompartments without interchange of intermediates during the assembly process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>parallel synthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12702 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12702">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of criteria that must be satisfied in order to achieve commercial exclusivity for an invention.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>These criteria are essentially the same in all major countries and include: suitability, novelty, inventiveness, utility, and the provision of an adequate description.</rdfs:comment>
        <rdfs:label>patentability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12696"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12703 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12703">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Peptide-like oligomer consisting of repeating \(N\)-substituted glycine units  where \(\ce{R1}\) to \(\ce{R4}\) are typically alkyl or aryl and may be the same or different.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>peptoid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12704 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12704">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>ATP-binding cassette transporter responsible for the efflux of small molecules from cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>Pgp</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>P-glycoproteins can play a major role in limiting brain penetration and restricting the intestinal absorption of drugs. Their over-expression in cancer cells becomes a common mechanism of multidrug resistance.</rdfs:comment>
        <rdfs:label>P-glycoprotein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12653"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12685"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12704"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Pgp</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12705 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12705">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of inherited differences (variation) in drug metabolism and response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>pharmacogenetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12706"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12706 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12706">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General study of all of the many different genes that determine drug behaviour.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>The distinction between the terms pharmacogenetics and pharmacogenomics has blurred with time. and they are now frequently used interchangeably.</rdfs:comment>
        <rdfs:label>pharmacogenomics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12705"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12707 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12707">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exploratory first-in-human trials that involve microdosing of drug to allow the assessment of pharmacokinetic parameters with limited drug exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>exploratory investigational new drug</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These trials have no therapeutic or diagnostic intent but are designed to assist decision making by providing bioavailability, metabolism, and other limited data from a small number of patients.</rdfs:comment>
        <rdfs:label>phase 0 clinical studies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12711"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12708 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12708">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initial introduction of an investigational new drug into humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>These studies are designed to determine the metabolic and pharmacologic actions of the drug in humans, the side-effects associated with increasing doses, and, if possible, to gain early evidence on effectiveness.</rdfs:comment>
        <rdfs:label>phase I clinical studies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12673"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12711"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12709 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12709">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Controlled clinical studies conducted in a limited number of individuals to obtain some preliminary data on the effectiveness of an investigational new drug for a particular indication or indications in patients with the disease or condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Phase II clinical trials have two subclasses, IIa and IIb. Phase IIa trials are essentially pilot clinical trials designed to evaluate efficacy (and safety) in selected populations of patients with the disease or condition to be treated, diagnosed, or prevented. Phase IIb trials extend those of Phase IIa to well-controlled trials that evaluate the same parameters in similar patient populations.</rdfs:comment>
        <rdfs:label>phase II clinical studies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12673"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12707"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12711"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12710 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12710">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expanded controlled and uncontrolled trials in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>These trials are performed after preliminary evidence suggesting effectiveness of the drug has been obtained in phase II, and are intended to gather the additional information about effectiveness and safety that is needed to evaluate the overall benefit/risk relationship of the drug.</rdfs:comment>
        <rdfs:label>phase III clinical studies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12707"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12711"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12711 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12711">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extended post-marketing studies in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>These trials are designed to broaden information concerning treatment risks, benefits, and optimal drug use.</rdfs:comment>
        <rdfs:label>phase IV clinical studies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12707"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12712 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12712">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evaluation of compounds (small molecules, peptides, siRNA, etc.) in cells, tissues, or organisms for their ability to modify the system in a measurable manner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Phenotypic screening differs from target-based screens in that it assesses the overall response of the compound under investigation rather than its specific response on a purified molecular target. Advances in molecular biology resulted in a marked shift away from phenotypic screening, although the latter is now regaining popularity.</rdfs:comment>
        <rdfs:label>phenotypic screening</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12713 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12713">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Discovery and development compound portfolio of a pharmaceutical company or research organization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>pipeline</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12714 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12714">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experiment that provides strong support for or against the drug or molecular target under investigation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>pivotal study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12715 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12715">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Confirmed or suspected presence of one or more known genotoxic materials in an active pharmaceutical ingredient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Typically, such impurities arise from reactive intermediates involved in the synthetic pathway and have the potential to adversely affect subsequent genotoxicity tests.</rdfs:comment>
        <rdfs:label>potential genotoxic impurity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12716 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12716">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Optimised lead compound successfully passing key screening, selectivity, and physicochemical criteria sufficient to warrant further detailed pharmacological and pharmacokinetic evaluation in animal models.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>PCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>safety assessment candidate</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Critical studies usually include bioavailability, therapeutic efficacy in an appropriate disease model, and side-effect profiling.</rdfs:comment>
        <rdfs:label>preclinical candidate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12677"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12716"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PCC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12717 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12717">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substructural feature that confers desirable (often drug-like) properties on compounds containing that feature. They often consist of a semi-rigid scaffold that presents multiple hydrophobic residues without undergoing hydrophobic collapse.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>For example, diazepam (below) in which the diphenylmethane moiety prevents association of the aromatic rings. </rdfs:comment>
        <rdfs:comment>Such structures are commonly found to confer activity against different targets belonging to the same receptor family.</rdfs:comment>
        <rdfs:label>privileged structure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12718 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12718">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure by which a specific therapeutic mechanism or treatment/diagnostic paradigm is shown to be beneficial.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Similar to, and often simultaneously associated with, that for a new drug candidate. This process usually involves an early supporting step prior to clinical testing and final validation within human studies.</rdfs:comment>
        <rdfs:label>proof of concept</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12678"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12719 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12719">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that catalyses the hydrolysis of proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>protease</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Usually, several proteolytic enzymes are necessary for the complete breakdown of polypeptides to their amino acids.</rdfs:comment>
        <rdfs:label>proteinase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12720 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12720">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Early compound that has biological properties suitable for target validation but may not necessarily be adequate for clinical studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>prototype drug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12721 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12721">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time between the start of the Q wave and the end of the T wave in the heart’s electrical cycle. When corrected for individual heart rate it becomes known as the corrected QT, or QTc interval.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Significant prolongation of the QTc interval by pharmaceutical agents can induce life-threatening ventricular arrhythmia (Torsades de Pointes), typically by interacting with the hERG channel.</rdfs:comment>
        <rdfs:label>QTc interval</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12722 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12722">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of conceptually deconstructing complex molecules into simpler fragments capable of chemical manipulation to reform the parent compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>retrosynthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12723 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12723">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of molecular descriptors used to assess the quality of hit or lead molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Most commonly applied to fragments that ideally are characterized by a mass of less than \(\pu{300 Da}\) less than or equal to three hydrogen bond donors, less than or equal to three hydrogen bond acceptors, and a CLOGP of less than or equal to three. In addition, the number of rotatable bonds should average or be less than three and the polar surface area about \(\pu{0.6 nm2}\).</rdfs:comment>
        <rdfs:comment>Often used to distinguish &quot;lead-like&quot; from &quot;drug-like&quot; molecules.</rdfs:comment>
        <rdfs:label>rule of three</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12659"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12677"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12683"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12724 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12724">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Core portion of a molecule common to all members of a chemical library or compound series.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>template</oboInOwl:hasRelatedSynonym>
        <rdfs:label>scaffold</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12633"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12725 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12725">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exchange of one scaffold for another while maintaining molecular features that are important for biological properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>scaffold hopping</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12726 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12726">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecular biology technique in which mutations are created at one or more defined sites in a DNA molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Typically used in molecular target validation and to determine whether specific amino acids are involved at ligand or substrate interaction sites.</rdfs:comment>
        <rdfs:label>site-directed mutagenesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12727 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12727">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small RNA fragments that can combine with specific genes to silence their expression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>siRNA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>small interfering double-stranded RNA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>siRNAs are powerful tools that are often used for manipulating gene expression during molecular target validation.</rdfs:comment>
        <rdfs:label>small inhibitory double-stranded RNA</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12727"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>siRNA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12728 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12728">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Residual binding site still available to an endogenous ligand after sufficient sites have already been filled to elicit the maximal response possible for that particular biological system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>receptor reserve</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Xenobiotics such as drugs may similarly interact with such receptors, but by definition, their identification and quantification occurs via use of the natural ligand.</rdfs:comment>
        <rdfs:label>spare receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12729 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12729">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical features present in a hit or lead molecule indicative of potential toxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Typically, such features include chemically reactive functionality and components known to metabolise to chemically reactive entities.</rdfs:comment>
        <rdfs:label>structural alert</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12677"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12730 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12730">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solution that has a greater composition of a solute than one that is in equilibrium with undissolved solute at specified values of temperature and pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>supersaturated solution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12654"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12672"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12676"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12731 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12731">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Integration of high-throughput biology measurements with computational models that study the projection of the mechanistic characteristics of metabolic and signalling pathways onto physiological and pathological phenotypes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>systems biology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12732 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12732">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to target a drug to a specific tissue or molecular target using a prodrug or antibody recognition systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>targeted drug delivery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12733 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12733">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a protein, RNA, or DNA is implicated in a biological pathway thought to be of relevance to a disease or adverse pathology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>Typically, validation will involve location of the molecular target in relevant cells, organs, or tissues, evidence for its up-regulation/activation in the disorder, and the ability to attenuate adverse responses by agents known to interfere with the target.</rdfs:comment>
        <rdfs:label>target validation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12684"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12734 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12734">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural isomer that can readily convert to another form that differs only by the attachment position of a hydrogen atom and the location of double bond(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>In most cases, these isomers are formed by a proton shift to or from heteroatoms such as \(\ce{O}\), \(\ce{N}\), or \(\ce{S}\) as typified by the enol and keto forms of carbonyl compounds. Tautomers rapidly interconvert by proton transfer and are usually in equilibrium with one another.</rdfs:comment>
        <rdfs:label>tautomer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12735 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12735">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the exposure/concentration of a therapeutic agent that causes beneficial effects to that which causes the first observed adverse effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <oboInOwl:hasRelatedSynonym>therapeutic ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A commonly used measure of therapeutic index is the toxic dose of a drug for \(\pu{50\%}\) of a population divided by the minimum effective dose for \(\pu{50\%}\) of a population.</rdfs:comment>
        <rdfs:label>therapeutic index</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12736 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12736">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term used for diseases or other disorders for which no optimal therapeutic options exist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>unmet medical need</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12737 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12737">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of chemical structures constructed solely in electronic form or on paper.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:comment>The building blocks required for such a library may not exist, and the chemical steps for such a library may not have been tested. These libraries are used in the design and evaluation of possible libraries.</rdfs:comment>
        <rdfs:label>virtual chemical library</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12738 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12738">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparent (hypothetical) volume of fluid required to contain the total amount of a substance in the body at the same concentration as that present in the plasma assuming equilibrium has been attained.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>volume of distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12739 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12739">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor that occurs naturally in human and other species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-23"/>
        <rdfs:label>wild-type receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12740 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12740">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highest-temperature or lowest-frequency relaxation in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>α-relaxation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For some partially crystalline polymers, for example, polyethylene or polyoxymethylene, the \(\upalpha\)-relaxation originates from motions within the crystalline regions (the so-called &quot;crystalline relaxation&quot;). In such cases, the β-relaxation usually corresponds to the glass transition.</rdfs:comment>
        <rdfs:comment>The \(\upalpha\)-relaxation is commonly related to cooperative conformational changes in macromolecules. These changes typically involve \(\pu{10\!-\! 20}\) main-chain atoms. For a polymer in a glassy state, the \(\upalpha\)-relaxation is characteristic of the glass transition.</rdfs:comment>
        <rdfs:label>alpha relaxation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12744"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12774"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12741 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12741">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highest-temperature peak or lowest-frequency peak in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>alpha loss peak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>α-loss peak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>α-relaxation peak</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Secondary relaxation peaks occurring successively at lower temperatures or higher frequencies are termed the beta (β-), gamma (γ-), relaxation or loss peaks.</rdfs:comment>
        <rdfs:label>alpha relaxation peak</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12772"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12799"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12800"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12742 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12742">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer in the amorphous state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>amorphous polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12743"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12743 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12743">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of matter characterised by the absence of long-range molecular order.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>In the absence of stress, the structure and properties of the amorphous state are generally isotropic at a large-enough scale, as in liquids.</rdfs:comment>
        <rdfs:comment>Some degree of local order about \(\pu{1 nm}\) in length may exist in the amorphous state.</rdfs:comment>
        <rdfs:label>amorphous state</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12744 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12744">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Second-highest-temperature or second-lowest-frequency relaxation in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>β-relaxation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For an amorphous polymer, the \(\upbeta\)-relaxation is generally related to localised motions involving only a few atoms of a polymer chain or is due to side-group motion.</rdfs:comment>
        <rdfs:comment>In some partially crystalline polymers, the \(\upbeta\)-relaxation corresponds to the glass-transition temperature (see Note 2 of definition alpha relaxation).</rdfs:comment>
        <rdfs:label>beta relaxation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12740"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12742"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12745 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12745">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Second-highest-temperature or second-lowest-frequency peak in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>beta loss peak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-loss peak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-relaxation peak</oboInOwl:hasRelatedSynonym>
        <rdfs:label>beta relaxation peak</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12746 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12746">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperatures obtained from a differential scanning calorimeter (DSC) experiment or a differential thermal analysis (DTA) experiment that characterise the physical processes occurring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Alternative methods for evaluating the glass-transition temperature, \(T_{\rm{g}}\), from DSC or DTA curves exist, for example, evaluation of the temperature of equal specific enthalpy of the glass and the melt.</rdfs:comment>
        <rdfs:comment>In a symmetrical curve, the point of inflection is at \(½\) of the height of the step of the curve (the mid-point temperature).</rdfs:comment>
        <rdfs:comment>The glass transition is usually near the point of inflection of the function \(c_{p}(T)\).</rdfs:comment>
        <rdfs:comment>The physical processes frequently studied in polymer science are crystallisation, melting, and the glass transition. See the figures below, which illustrate the corresponding characteristic temperatures. The ordinate used in the figures is specific heat capacity \(c_{p}/\pu{J K-1 g-1}\). When using DSC, the quantity measured is the specific heat flow rate/\(\pu{W g-1}\), and when using DTA, the quantity measured is the temperature difference between sample and reference. Both quantities can be converted to \(c_{p}\) by calibration. Figure 1: Characteristic temperatures found from a DSC or DTA cooling experiment involving crystallisation. In a heating experiment, the subscripts for &quot;initial&quot; and &quot;final&quot; are interchanged. Cold crystallisation can sometimes be observed in a heating experiment.
\(T_{\rm{i,cr}}\) = initial (onset) crystallisation temperature (at which crystallisation starts).
\(T_{\rm{ei,cr}}\) = extrapolated initial (onset) crystallisation temperature.
\(T_{\rm{p,cr}}\) = peak crystallisation temperature (at which the maximum rate of crystallisation occurs).
\(T_{\rm{ef,cr}}\) = extrapolated final (end) crystallisation temperature.
\(T_{\rm{f,cr}}\) = final (end) crystallisation temperature (at which crystallisation stops).
\(\Delta_{\rm{cr}} h\) = specific enthalpy of crystallisation, unit: \(\pu{J g-1}\).
\(c_{p}\) = specific heat capacity, unit: \(\pu{J K-1 g-1}\). Figure 2: Characteristic temperatures found from a DSC or DTA heating experiment involving melting (fusion).
_028101_ = initial (onset) melting temperature (at which melting starts).
_028102_ = extrapolated initial (onset) melting temperature.
_028103_ = peak melting temperature (at which the maximum rate of melting occurs).
_028104_ = extrapolated final (end) melting temperature.
_028105_ = final (end) melting temperature (at which melting stops).
_028106_ = specific enthalpy of fusion, unit: \(\pu{J g-1}\).
\(c_{p}\) = specific heat capacity, unit: \(\pu{J K-1 g-1}\). Figure 3: Characteristic temperatures found from a DSC or DTA experiment involving a glass transition. The experiment is often carried out by cooling the polymer melt rather than heating the polymer glass because of the small variation of the transition temperature with the cooling rate in contrast to the more complex situation in a heating experiment; see enthalpy relaxation.
_028107_ = initial (onset) temperature of the glass transition.
_028108_ = extrapolated initial (onset) temperature of the glass transition.
_014497_ = mid-point temperature, equated to the glass-transition temperature.
_028109_ = extrapolated final (end) temperature of the glass transition.
_028110_ = final (end) temperature of the glass transition.
\(c_{p}\) = specific heat capacity, unit: \(\pu{J K-1 g-1}\).
_028111_ = change in specific heat capacity, unit: \(\pu{J K-1 g-1}\).</rdfs:comment>
        <rdfs:label>characteristic temperatures</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12748"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12758"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12765"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12788"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12793"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12794"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12747 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12747">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at which the transition between the mesophase with the highest temperature range and the isotropic phase occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>clearing point</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The clearing temperature of a mesophase is a special case of the more general isotropisation temperature.</rdfs:comment>
        <rdfs:label>clearing temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12776"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12748 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12748">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer crystallisation brought about from a glass, from a liquid-crystalline state, or a state displaying a low degree of crystallinity at temperatures a little above the glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Cold crystallisation is frequently observed if crystallisation was not completed before sample vitrification.</rdfs:comment>
        <rdfs:label>cold crystallisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12818"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12749 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12749">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enthalpy change associated with conformational changes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>In polymers, conformational changes can be associated with conformational melting.</rdfs:comment>
        <rdfs:label>conformational enthalpy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12751"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12750 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12750">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Entropy change associated with conformational changes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>In polymers, conformational changes can be associated with conformational melting.</rdfs:comment>
        <rdfs:label>conformational entropy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12751"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12751 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12751">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Step-like increase in the conformational entropy of macromolecules, or parts of macromolecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Conformational melting normally occurs along with crystalline melting in a partially crystalline polymer.</rdfs:comment>
        <rdfs:comment>This melting can be caused by a temperature change or by interaction with a solvent.</rdfs:comment>
        <rdfs:label>conformational melting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12750"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12752 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12752">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transition between two conformational states.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Conformational melting is a type of conformational transition.</rdfs:comment>
        <rdfs:comment>Conformational transitions are relevant in biopolymers, for example, nucleic acids and proteins or complex systems like lipid membranes, where a number of neighbouring local minima in the profile of the Gibbs energy are possible. A conformational transition can result in important biological action.</rdfs:comment>
        <rdfs:label>conformational transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12751"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12753 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12753">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Forced-resonance method to determine the viscoelastic properties of a material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Indirect measurement of the energy that has to be added to a material sample to compensate the damping of the oscillation by determination of the change of the resonance frequency of a material sample.</rdfs:comment>
        <rdfs:label>constant oscillation-amplitude method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12754 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12754">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of matter ideally characterised by three-dimensional, long-range order on an atomic scale.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>One- or two-dimensional order leads to a mesophase structure.</rdfs:comment>
        <rdfs:label>crystalline state</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12755 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12755">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer that is able to partially crystallise.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>crystallisable polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12756 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12756">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in the deformation amplitude of a material specimen plotted vs. time when the specimen is subjected to a free oscillation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>loss curve</oboInOwl:hasRelatedSynonym>
        <rdfs:label>damping curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12770"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12780"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12814"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12757 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12757">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of a polymer melt from a polymer glass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Devitrification is usually brought about by heating or exposure to a solvent as liquid or vapour.</rdfs:comment>
        <rdfs:label>devitrification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12758 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12758">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for conducting a differential scanning calorimetry (DSC) experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>DSC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is common to use the same abbreviation (DSC) for both differential scanning calorimetry and the apparatus.</rdfs:comment>
        <rdfs:label>differential scanning calorimeter</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12758"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12759 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12759">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for conducting a differential thermal analysis experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>DTA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is common to use the same abbreviation (DTA) for both differential thermal analysis and the apparatus.</rdfs:comment>
        <rdfs:label>differential thermal analyser</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12759"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DTA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12760 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12760">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for conducting a dilatometry experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>dilatometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12761 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12761">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The measurement of changes with time in the volume, length, width, or thickness of a material sample caused by temperature changes under negligible load or by chemical reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A polymerisation reaction is an example of a chemical reaction that can be studied using a dilatometer.</rdfs:comment>
        <rdfs:comment>Measurement of an applied hydrostatic pressure allows the determination of pressure–volume–temperature (\(p,V,T\)) diagrams.</rdfs:comment>
        <rdfs:comment>One-dimensional changes are often measured using mechanical displacement detection. Volume changes are often determined using an inert confining liquid, for example, mercury.</rdfs:comment>
        <rdfs:label>dilatometry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12760"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12762 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12762">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thermomechanical analysis carried out using a sinusoidal stress.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>DLTMA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dynamic-load thermomechanical analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DLTMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12763 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12763">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for conducting a dynamic mechanical analysis experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>DMA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is common to use the same abbreviation (DMA) for both dynamic mechanical analysis and the apparatus.</rdfs:comment>
        <rdfs:label>dynamic mechanical analyser</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12763"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12764 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12764">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus that uses a forced, non-resonance method to determine the viscoelastic properties of a material sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A sinusoidal displacement is applied to one end of a strip-like sample, and the response of the material is measured at the opposite end, allowing the angle between the stress and the strain, the phase angle, \(\delta\), to be obtained directly.</rdfs:comment>
        <rdfs:label>dynamic viscometer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12765 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12765">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enthalpy change observed near the glass transition when a sample is heated at a rate different from that at which it was cooled down, or observed after annealing in the glassy state below the glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Enthalpy relaxation can be described by the Kohlrausch–Williams–Watts equation.</rdfs:comment>
        <rdfs:comment>Enthalpy relaxation is caused by the transformation of a glassy material to a more stable glass.</rdfs:comment>
        <rdfs:comment>Enthalpy relaxation reflects physical aging.</rdfs:comment>
        <rdfs:comment>Moduli, stress–strain behaviour, and molecular motions are affected by enthalpy relaxation.</rdfs:comment>
        <rdfs:label>enthalpy relaxation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12774"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12778"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12766 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12766">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at which perfect polymer crystals of infinite thickness melt under equilibrium conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>The equilibrium melting temperature can be determined, for example, from a Hoffman–Weeks plot.</rdfs:comment>
        <rdfs:comment>The transition occurring at the equilibrium melting temperature is a first-order phase transition.</rdfs:comment>
        <rdfs:label>equilibrium melting temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12775"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12788"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12767 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12767">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deformation of a material by the application of a small sinusoidal strain (\(\gamma\)) such that \[\gamma = \gamma_{0} \cos \omega t\] where \(\gamma_{0}\) and \(\omega\) are positive constants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>forced oscillation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sinusoidal oscillation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For linear viscoelastic behaviour, a sinusoidal stress (\(\sigma\)) results from the sinusoidal strain with \(\sigma = \sigma_{0} \cos (\omega t + \delta) = \sigma_{0} \cos \delta \cos \omega t - \sigma_{0} \sin \delta \sin \omega t\).</rdfs:comment>
        <rdfs:comment>\(\gamma\) may be in simple shear or uniaxial deformation.</rdfs:comment>
        <rdfs:comment>\(\gamma_{0}\) is the strain amplitude.</rdfs:comment>
        <rdfs:comment>\(\omega\) is the angular velocity of the circular motion equivalent to a sinusoidal frequency \(v\) with \(\omega = 2\uppi \nu\). The unit of \(\omega\) is \(\pu{rad s-1}\).</rdfs:comment>
        <rdfs:label>forced sinusoidal oscillation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12770"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12768 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12768">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glass characterised by a large value of the fragility index (m).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A fragile glass has a markedly non-Arrhenius-type temperature dependence of the viscosity and relaxation time.</rdfs:comment>
        <rdfs:comment>A very fragile glass has \(m \approx 250\).</rdfs:comment>
        <rdfs:comment>The Vogel–Fulcher–Tammann equation can be used to describe the relaxation-time behaviour of a fragile glass.</rdfs:comment>
        <rdfs:label>fragile glass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12769"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12804"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12819"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12769 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12769">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity characterising the fragility or the strength of a glass at a given temperature \[m = \left (\frac{\rm{d} \log_{10} \tau}{{\rm{d}} (T_{\rm{g}}/T)} \right)_{T = T_{\rm{g}}}\] \(\tau\) = relaxation time [\(\pu{s}\)]; \(T_{\rm{g}}\) = glass-transition temperature [\(\pu{K}\)]; \(T\) = temperature [\(\pu{K}\)].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>The value of the fragility index depends on the thermal history of the glass.</rdfs:comment>
        <rdfs:comment>The values of \(m\) range from \(m \approx 16\) for a very strong glass to \(m \approx 250\) for a very fragile glass.</rdfs:comment>
        <rdfs:label>fragility index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12768"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12773"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12804"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12770 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12770">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oscillatory deformation of a material specimen with the motion generated without the continuous application of an external force.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>free sinusoidal oscillation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For any real sample of material, the resulting oscillatory deformation is one of decaying amplitudes.</rdfs:comment>
        <rdfs:label>free oscillation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12771 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12771">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Third-highest-temperature or third-lowest-frequency relaxation in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>γ-relaxation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gamma relaxation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12772 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12772">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Third-highest-temperature or third-lowest-frequency peak in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>gamma loss peak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>γ-loss peak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>γ-relaxation peak</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The \(\gamma\)-peak is typically related to localised motions involving side groups or a few atoms of a polymer chain.</rdfs:comment>
        <rdfs:label>gamma relaxation peak</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12773 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12773">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amorphous matter in the glassy state, i.e., below its glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A glass is usually described as a solid, as most physical properties vary in a manner similar to those in the crystalline state. However, considering the ongoing debate about the nature of the glass transition, and the ability of some glasses to flow, some authors prefer to consider glasses in the context of the liquid state.</rdfs:comment>
        <rdfs:comment>The creep compliance of a glass is less than \(\pu{E-9 N-1 m2}\), and the dynamic viscosity larger than \(\pu{E4 Pa s}\).</rdfs:comment>
        <rdfs:label>glass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12774"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of amorphous matter below its glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>glassy state</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plot of melting temperature, \(T_{\rm{m}}\), vs. crystallisation temperature, \(T_{\rm{cr}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A Hoffman–Weeks plot is used to determine the equilibrium melting temperature, \(T_{\rm{m}}^{0}\).</rdfs:comment>
        <rdfs:comment>\(T_{\rm{m}}^{0}\) is determined as the intersection of the straight line that describes \(T_{\rm{cr}} = T_{\rm{m}}\) with the extrapolated curve that is drawn through the experimental data points (\(T_{\rm{cr}}\), \(T_{\rm{m}}\)).</rdfs:comment>
        <rdfs:label>Hoffman–Weeks plot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12766"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at which a transition from any anisotropic state to an isotropic liquid occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>In mesomorphic systems, the isotropisation temperature is usually called clearing temperature.</rdfs:comment>
        <rdfs:label>isotropisation temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12747"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12777 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12777">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at which the extrapolation of the entropy of a super-cooled liquid is equal to the entropy of its crystalline state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>Kauzmann temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation describing the enthalpy relaxation, \(\Delta H\) which is observed during the annealing of polymers in the glassy state at a temperature, \(T_{\rm{a}}\), lower than \(T_{\rm{g}}\) \[\Delta H(t_{\rm{a}}) = \Delta c_{p}(T_{\rm{g}} - T_{\rm{a}}) \exp\!\left[- \left (\frac{t_{\rm{a}}}{\tau} \right)^{\beta} \right]\] \(\Delta H\) = difference of the enthalpy in the initial, glassy state, and the enthalpy of the glassy state after annealing; \(t_{\rm{a}}\) = time of annealing; \(\Delta c_{p}\) = difference in heat capacity at the glass-transition temperature, \(T_{\rm{g}}\), and the starting temperature of the annealing process, \(T_{\rm{a}}\); \(\tau\) = relaxation time at \(T_{\rm{a}}\); \(\beta\) = exponential factor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>KWW Equation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Moduli, stress-strain behaviour, and molecular motions are affected by enthalpy relaxation, which reflects physical aging.</rdfs:comment>
        <rdfs:comment>The exponential factor \(\beta\) has a value between 0 and 1, and characterises the asymmetry of the distribution of relaxation times.</rdfs:comment>
        <rdfs:label>Kohlrausch–Williams–Watts equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12765"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12774"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique in which one dimension of a substance under negligible load is measured as a function of temperature while the substance is subjected to a controlled temperature program.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>linear thermodilatometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12780 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12780">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Natural logarithm of the ratio of the displacement of a damping curve separated by one period of the displacement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>If equals the \(n^{th}\) displacement of the damping curve and equals the \((n + 1)^{th}\) displacement (\(n = 1, 2, 3, \dots\)), then \(\mathit{\Lambda} = \ln(A_{n}/A_{n + 1})\).</rdfs:comment>
        <rdfs:label>logarithmic decrement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12756"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12781 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12781">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plot of loss tangent (\(\tan \delta\)) vs. the temperature or the frequency of the forced sinusoidal oscillation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>loss curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12783"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12782 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12782">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the amplitude of the stress \(\pu{90\!^{\circ}}\) out of phase with the strain (\(\sigma_{0} \sin \delta\)) to the amplitude of the strain (\(\gamma_{0}\)) in the forced sinusoidal oscillation of a material. \[M^{\prime\prime} = \frac{\sigma_{0} \sin \delta}{\gamma_{0}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>For the definitions of the symbols used, see forced sinusoidal oscillation.</rdfs:comment>
        <rdfs:comment>In a linear viscoelastic material, the strain \(\gamma = \gamma_{0} \cos \omega t\) produces a stress \(\sigma = \sigma_{0} \cos (\omega t + \delta) = \sigma_{0} \cos \delta \cos \omega t - \sigma_{0} \sin \delta \sin \omega t\).</rdfs:comment>
        <rdfs:comment>The loss modulus characterises the viscous response of a material.</rdfs:comment>
        <rdfs:label>loss modulus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12783 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12783">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tangent of the phase angle (\(\delta\)) between stress and strain during a forced sinusoidal oscillation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>loss factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>\(\tan \delta\) is also equal to the ratio of loss modulus to storage modulus.</rdfs:comment>
        <rdfs:label>loss tangent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12767"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12802"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12784 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12784">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Viscoelastic spectrum of a polymer or polymer material constructed using the time–temperature superposition (TTS) principle, so that the spectrum covers a wide range of lengths of time or frequencies of measurement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A master curve is usually constructed by superimposing a sequence of isothermal measurements of a viscoelastic property vs. time.</rdfs:comment>
        <rdfs:label>master curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12813"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12817"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12821"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12785 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12785">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mechanically induced transition of matter in the crystalline or glassy state to its melt.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>mechanical melting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12754"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12774"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12786"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12786 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12786">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Matter in the amorphous state above its glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A melt has the physical properties of a liquid.</rdfs:comment>
        <rdfs:label>melt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12794"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12787 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12787">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of a polymer in grams that flows through a calibrated orifice at constant temperature under a specified load over a \(\pu{10\!{-}min}\) period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>MFI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MFR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>melt flow rate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>melt mass flow rate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>melt volume flow</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Specified loads are mandated for specific polymers.</rdfs:comment>
        <rdfs:comment>Standard procedures for determining MFI are available from ISO and ASTM.</rdfs:comment>
        <rdfs:comment>The values of MFI as a function of load can give information on the molar mass distribution.</rdfs:comment>
        <rdfs:comment>There is no suitable SI unit for MFI.</rdfs:comment>
        <rdfs:label>melt flow index</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12787"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MFI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12788 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12788">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at which the last trace of crystallinity disappears upon heating.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>melting point</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An experimentally determined melting temperature is not necessarily identical with the equilibrium melting temperature. See equilibrium melting temperature and Hoffman–Weeks plot.</rdfs:comment>
        <rdfs:comment>Experimentally determined values of the melting temperature may depend on the method and the experimental conditions, for example, sample mass, heating rate, etc.</rdfs:comment>
        <rdfs:comment>If \(T_{\rm{m}}\) is determined using DSC or DTA, then the characteristic temperature (Figure 2) used should be stated.</rdfs:comment>
        <rdfs:comment>This temperature usually refers to the highest temperature of the melting range, i.e., when the last and therefore the most perfectly ordered crystals or the largest crystals melt.</rdfs:comment>
        <rdfs:label>melting temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12746"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12775"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12789 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12789">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heat flow in a modulated-temperature DSC experiment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>MHF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>modulated heat flow</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12790"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12789"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MHF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12790 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12790">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>DSC experiment in which a small sinusoidal modulation overlays the change in temperature with time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>MTDSC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The resulting DSC data can be separated, by Fourier analysis, into components in-phase with the modulation (reversing heat flow) and out-of-phase with the modulation (nonreversing heat flow). \[\underbrace {{\left({\frac{{\partial H}}{{\partial t}}} \right)}_{p}}_{\rm{total\ heat\ flow}} = \frac{{\rm{d}}Q}{{\rm{d}}t} = \underbrace {C_{p}\frac{{\rm{d}}T}{{\rm{d}}t}}_{\rm{reversing\ heat\ flow}} + \underbrace {f\left({T,t}\right)}_{\rm{non\mbox{-}reversing\ heat\ flow}}\] The total heat flow is the average value calculated from the measured signals during the modulated heat flow (MHF). \(C_{p}\) is the heat capacity of the sample, \(\frac{{\rm{d}}T}{{\rm{d}}t}\) is the heating rate.</rdfs:comment>
        <rdfs:comment>Use of the terms &quot;oscillating DSC (ODSC)&quot; and &quot;modulated DSC (MDSC)&quot; is discouraged.</rdfs:comment>
        <rdfs:label>modulated-temperature DSC</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12789"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12797"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12790"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MTDSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12791 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12791">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used in dynamic mechanical analysis in which a specimen is subjected to the superposition of a number of forced sinusoidal oscillations of different frequencies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>In one experiment, this technique delivers the frequency dependence of the mechanical properties at all the frequencies covered by the forced sinusoidal oscillations.</rdfs:comment>
        <rdfs:label>multiplexing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12792 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12792">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In modulated-temperature DSC, the component of the total heat flow that is out-of-phase with the temperature modulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>The out-of-phase component of the total heat flow relates to kinetic processes like crystallisation, melting, evaporation, or condensation.</rdfs:comment>
        <rdfs:comment>The term &quot;non-reversing&quot; must not be confused with &quot;irreversible&quot;.</rdfs:comment>
        <rdfs:label>non-reversing heat flow</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12790"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12793 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12793">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amorphous polymer at temperatures below its glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>glassy polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:label>polymer glass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12742"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12794 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12794">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer in the amorphous state above its glass-transition temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A polymer melt has the physical properties of a viscoelastic liquid.</rdfs:comment>
        <rdfs:comment>The term applies both to crystallisable polymers and to polymers that are unable to crystallise. In the latter case, no specifications are needed. In the former case, in the range between the glass-transition temperature and the equilibrium melting temperature, the polymer melt is metastable, and, as long as crystallisation does not occur (see Note 3), the term supercooled polymer melt can be used to define more accurately the thermodynamic state of the system.</rdfs:comment>
        <rdfs:comment>When a crystallisable polymer undergoes crystallisation, the remaining amorphous component cannot be considered a polymer melt. Flow is inhibited by polymer crystallites, which physically cross-link the amorphous component or constrain it at the surface of polymer crystals.</rdfs:comment>
        <rdfs:label>polymer melt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12755"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12805"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12795 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12795">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plot of the logarithm of the relaxation time vs. the reciprocal temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>relaxation map</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12796 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12796">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Range of relaxation times describing stress relaxation in a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>spectrum of relaxation times</oboInOwl:hasRelatedSynonym>
        <rdfs:label>relaxation spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12803"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12797 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12797">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In modulated-temperature DSC the heat-capacity component of the total heat flow that is in-phase with the temperature modulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>The reversing-heat-flow component contains the changes in the heat capacity, \(C_{p}\), of the specimen, in particular during the glass transition.</rdfs:comment>
        <rdfs:comment>The term &quot;reversing&quot; must not be confused with &quot;reversible&quot;.</rdfs:comment>
        <rdfs:label>reversing heat flow</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12790"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12798 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12798">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Second-, third-, fourth-, … highest-temperature or second-, third-, fourth-, … lowest-frequency relaxation in the loss curve of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>secondary relaxation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12744"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12771"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12799 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12799">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any peak in a loss curve either at a lower temperature than the temperature of the alpha relaxation peak or at a higher frequency than the frequency of the alpha relaxation peak.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>secondary loss peak</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The use of the term &quot;secondary relaxation transition peak&quot; is discouraged.</rdfs:comment>
        <rdfs:label>secondary relaxation peak</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12741"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12745"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12772"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12781"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12800 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12800">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature characterising a secondary relaxation peak identified as the temperature at which the loss modulus (or loss tangent), measured by DMA or DETA, exhibits a maximum at the measurement frequency, due to the occurrence of localised motions involving only short segments of the polymer chains, or side groups of the polymer chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>secondary relaxation temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12783"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12801 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12801">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multiplier used to change the interval of time or the range frequencies of measurement of a viscoelastic property at a given temperature, \(T_{1}\), so that the values of the property superimpose on the values measured at a reference temperature, \(T_{0}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>The shift factor is temperature dependent but independent of the time or frequency.</rdfs:comment>
        <rdfs:label>shift factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12821"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12802 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12802">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the amplitude of the stress in phase with the strain (\(\sigma_{0} \cos \delta\)) to the amplitude of the strain (\(\gamma_{0}\)) in the forced sinusoidal oscillation of a material. \[M^{\prime} = \frac{\sigma_{0} \cos \delta}{\gamma_{0}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Definition taken, with &quot;forced sinusoidal oscillation&quot; replacing &quot;forced oscillation&quot;.</rdfs:comment>
        <rdfs:comment>For the definitions of the symbols used, see forced sinusoidal oscillation. In a linear viscoelastic material, the strain \(\gamma = \gamma_{0} \cos \omega t\) produces a stress. \[\sigma = \sigma_{0} \cos (\omega t + \delta) = \sigma_{0} \cos \delta \cos \omega t - \sigma_{0} \sin \delta \sin \omega t\]</rdfs:comment>
        <rdfs:comment>The storage modulus characterises the elastic response of a material.</rdfs:comment>
        <rdfs:label>storage modulus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12767"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12803 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12803">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in stress with time after the instantaneous application of a constant strain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>stress relaxation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12804 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12804">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glass characterised by a small value of the fragility index (\(m\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A strong glass has an approximately Arrhenius-type temperature dependence of the viscosity and relaxation time.</rdfs:comment>
        <rdfs:comment>A very strong glass has \(m \approx 16\).</rdfs:comment>
        <rdfs:label>strong glass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12768"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12769"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12805 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12805">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metastable melt of a crystallisable polymer at temperatures below its equilibrium melting temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>supercooled polymer melt</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12766"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12786"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12806 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12806">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Empirical rule that states that in a partially crystalline polymer the glass-transition temperature can be reasonably approximated by a value equal to two-thirds of the melting temperature, \(T_{\rm{m}}\)/\(\pu{K}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>Tammann’s 2/3rd rule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12788"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12807 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12807">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thermal treatment a polymer material has experienced before its characterisation or measurement of its properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Thermal history affects many physical properties. Its influence can be modified or removed by annealing.</rdfs:comment>
        <rdfs:label>thermal history</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12808 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12808">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delay of the response of a system to a change in temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>thermal lag</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12809 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12809">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for conducting thermogravimetric analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>TGA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thermobalance</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is common to use the same abbreviation (TGA) for both thermogravimetric analysis and the apparatus.</rdfs:comment>
        <rdfs:label>thermogravimetric analyser</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12809"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TGA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12810 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12810">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique that monitors the light that is emitted from a sample against time or temperature while the temperature of the sample, in a specified atmosphere, is heated in a controlled manner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>TLA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thermoluminescence analysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12810"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12811 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12811">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparatus for conducting thermomechanical analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>TMA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is common to use the same abbreviation (TMA) for both thermomechanical analysis and the apparatus.</rdfs:comment>
        <rdfs:label>thermomechanical analyser</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12811"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12812 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12812">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The temperature dependence of deformability or mechanical properties of a polymer sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>thermomechanical properties</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12813 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12813">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Principle stating that the value of a viscoelastic property measured at a given temperature, after a given length of time or at a given frequency, is equal to the value of the property at a different temperature after a length of time or at a frequency equal to the given length of time or given frequency multiplied by a shift factor, \(a_{T}\) , with the value of the shift factor being independent of length of the time or frequency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>TTS Principle</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The Williams–Landel–Ferry (WLF) equation provides a semi-empirical relation between the shift factor \(a_{T}\) and the temperature, at temperatures near the glass-transition temperature, \(T_{\rm{g}}\).</rdfs:comment>
        <rdfs:label>time–temperature superposition principle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12801"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12821"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12814 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12814">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device consisting of a disc or other body of large moment of inertia mounted on one end of a torsionally flexible elastic rod or wire, the other end of which is fixed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>When the disc is displaced by a (small) angle around its primary rotational axis it will undergo a simple harmonic oscillation after it is released as long as the torque of the rod or the wire is proportional to the torsion angle.</rdfs:comment>
        <rdfs:label>torsion pendulum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12815 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12815">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dynamic mechanical analysis performed using a torsion pendulum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>A strip-shaped polymer sample is mounted on a torsion pendulum and subjected to a small torque. The decay in the amplitude of the free sinusoidal oscillation is observed over a range of temperatures.</rdfs:comment>
        <rdfs:comment>Storage (shear) modulus G&apos;, loss (shear) modulus G&apos;&apos;, and the loss-tangent can be calculated from the logarithmic decrement, \(\mathit{\Lambda}\).</rdfs:comment>
        <rdfs:label>torsional pendulum analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12770"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12780"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12783"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12802"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12816 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12816">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature at which a thermoplastic polymer reaches a specific degree of softness as measured by a standard test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>Vicat hardness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vicat softening point</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>softening point</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For an amorphous polymer, the softening temperature is close to the glass-transition temperature, and for a crystalline polymer the softening temperature is close to but lower than the melting temperature.</rdfs:comment>
        <rdfs:comment>Usually this temperature is determined using standardised methods, such as indentation tests, or the ring-ball method that characterise the dimensional stability of a polymer to heating. These standardised methods are often polymer specific.</rdfs:comment>
        <rdfs:label>Vicat softening temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12788"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12817 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12817">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Double logarithmic plot of a viscoelastic property vs. frequency of measurement or interval of time of measurement at constant temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>viscoelastic spectrum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12818 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12818">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of a polymer glass from a polymer melt.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:comment>Vitrification is usually brought about by cooling.</rdfs:comment>
        <rdfs:label>vitrification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12793"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12794"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12819 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12819">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation describing the time-dependence of a relaxation time that deviates from an Arrhenius-type temperature dependence. \[\tau = \tau_{0} \exp\!\left({\frac{B}{T - T_{0}}}\right)\] \(\tau\)/\(\pu{s}\) = relaxation time; \(\tau_{0}\)/\(\pu{s}\) = relaxation time at the Kauzmann temperature, \(B\)/\(\pu{K}\) = constant; \(T\)/\(\pu{K}\) = temperature; \(T_{0}\)/\(\pu{K}\) = Kauzmann temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>VFT Equation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Vogel–Fulcher–Tammann equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12768"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12777"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12820 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12820">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique in which the volume of a substance under negligible load is measured as a function of temperature while the substance is heated or cooled in a controlled programme.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <rdfs:label>volume thermodilatometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12821 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12821">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation describing the temperature dependence of the shift factor, \(a_{T}\), for time–temperature superposition \[\log_{10}a_{\rm{T}} = \frac{-C_{1}(T_{1} - T_{0})}{C_{2} + (T_{1} - T_{0})}\] \(C_{1}\) and \(C_{2}\) are empirical constants, \(T\) is the temperature of measurement, and \(T_{0}\) is the reference temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-02"/>
        <oboInOwl:hasRelatedSynonym>WLF Equation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The WLF equation is usually applied with the reference temperature, \(T_{0}\), equal to the glass-transition temperature, \(T_{\rm{g}}\). The values of the constants \(C_{1}\) and \(C_{2}\) depend on the type of polymer and are valid over a limited range of temperature, from \(T_{\rm{g}}\) to about \(T_{\rm{g}}\) + \(\pu{50 K}\).</rdfs:comment>
        <rdfs:label>Williams–Landel–Ferry equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12801"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12813"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12822 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12822">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A coordination compound with repeating coordination entities extending in 1, 2, or 3 dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-20"/>
        <rdfs:comment>Coordination polymers do not need to be crystalline; therefore, the more appropriate terms (for crystalline states) 1-periodic, 2-periodic, and 3-periodic cannot be used throughout. These compounds may in some cases, such as those being composed of mainly carboxylates, even be regarded as salts. The prefix 1D-, 2D-, or 3D- is acceptable for the indicating the degree of extension of the coordination polymer.</rdfs:comment>
        <rdfs:label>coordination polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12823 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12823">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A coordination compound extending, through repeating coordination entities, in one dimension, but with cross-links between two or more individual chains, loops, or spiro-links, or a coordination compound extending through repeating coordination entities in two or three dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-20"/>
        <rdfs:comment>The preferred and most widely understood term will likely be: &quot;coordination polymer&quot;. However, IUPAC endorses also the use of the term &quot;coordination network&quot;, even though it should be clear that these two terms are not synonymous and that coordination network is in fact a subset of coordination polymer.</rdfs:comment>
        <rdfs:label>coordination network</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12824 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12824">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A metal-organic framework, abbreviated to MOF, is a coordination network with organic ligands containing potential voids.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-11-20"/>
        <oboInOwl:hasRelatedSynonym>MOF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This wording accounts for the fact that many systems are dynamic, and changes in structure and thus corresponding changes in potential porosity or solvent and/or guest filled voids may occur depending on temperature, pressure, or other external stimuli. For these reasons it is also not required that an MOF be crystalline. Arguments based on both theory and experiment can be used, suggesting that some of these coordination polymers (i.e., those that can be described as salts) with direct anion-cation binding are more prone to form structures with open frameworks exhibiting permanent porosity than those forming positively charged networks. However, the grey zone between these extremes is large and increasing so that a definition based on such a charge distinction would be too restrictive.</rdfs:comment>
        <rdfs:label>metal-organic framework</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12824"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MOF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12825 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12825">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-cell receptor (TCR) consisting of a heterodimer of two different glycoprotein chains, designated \(\upalpha\) and \(\upbeta\), assembled into an \(\upalpha{:}\upbeta\) heterodimer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>α:β T-cell receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12826 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12826">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte whose T-cell receptor (TCR) is a heterodimer of an \(\upalpha\) chain and a \(\upbeta\) chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>\(\upalpha{:}\upbeta\) T cells represent the majority of thymocytes in the thymus and T cells in the periphery.</rdfs:comment>
        <rdfs:label>α:β T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12825"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13598"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12827 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12827">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene resulting from a chromosomal translocation (9;22) that fuses sequences from the BCR (breakpoint cluster region) gene with the ABL gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BCR-ABL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The fusion protein encoded by BCR-ABL possesses unregulated tyrosine kinase activity.</rdfs:comment>
        <rdfs:comment>The term ABL derives from the Abelson murine leukemia virus, from which the gene was first isolated.</rdfs:comment>
        <rdfs:comment>This translocation creates the Philadelphia chromosome, found in most human patients with chronic myelogenous leukemia (CML).</rdfs:comment>
        <rdfs:label>ABL oncogene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13008"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13565"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13766"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12828 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12828">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System of antigens expressed on erythrocytes and used for typing human blood for transfusion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Individuals who do not express A or B antigens on their erythrocytes naturally form antibodies against them.</rdfs:comment>
        <rdfs:label>ABO blood group system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13753"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12829 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12829">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody or antibody construct with catalytic activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>abzyme</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12830 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12830">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell that assists in the adaptive immune response but does not directly mediate specific antigen recognition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Such cells include phagocytes, mast cells, dendritic cells, and NK cells.</rdfs:comment>
        <rdfs:comment>The term is often used to describe antigen-presenting cells (APCs).</rdfs:comment>
        <rdfs:label>accessory cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12843"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12831 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12831">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule other than immunoglobulin (Ig), T-cell receptor (TCR), or major histocompatibility complex (MHC) molecule that participates in T lymphocyte recognition and response to antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>accessory molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12832 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12832">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of protection against pathogen-induced injury, with rapid immune elimination of pathogenic invaders owing to previous immunization or vaccination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>acquired immunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13260"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13771"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12833 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12833">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease caused by infection with the human immunodeficiency virus (HIV), assuming clinical relevance when an infected patient has lost most of his/her CD4+ T cells, so that infections with opportunistic pathogens occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AIDS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acquired immunodeficiency syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13228"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12833"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AIDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12834 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12834">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which immune responses end in the death of most of the responding lymphocytes, leaving only a small number of resting memory cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>activation-induced cell death</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13452"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12835 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12835">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunization with antigen, as distinct from the transfer of antibody to an unimmunized individual, which is called passive immunization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>active immunization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13540"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12836 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12836">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for determining whether a drug can cause anaphylactic reactions in an animal following immunization with the drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ASA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ASA test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>active systemic anaphylaxis test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12871"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12836"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ASA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12837 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12837">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly aggressive, undifferentiated form of lymphoid malignancy derived from a progenitor cell that is thought to be able to give rise to both T- and B-cell lineages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ALL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Acute Lymphocytic Leukemia</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most of these leukemias show partial differentiation toward the B-cell lineage (so-called B-ALL) whereas a minority show features of T cells (T-ALL).</rdfs:comment>
        <rdfs:label>acute lymphoblastic leukemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12837"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ALL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12838 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12838">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cancer characterized by rapid growth of abnormal granulocytes that accumulate in the bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AML</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acute myelogenous leukemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12838"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AML</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12839 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12839">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serum protein, mostly produced in the liver, which rapidly changes in concentration (some acute-phase proteins increase, some decrease) during the initiation of an inflammatory response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>acute-phase protein</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12840 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12840">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physiological response stimulated by cytokines including interleukin-1, interleukin-6, interferons, and tumor necrosis factor (TNF), characterized by increased vascular permeability, fever, and increased levels of proteins (thus called acute-phase proteins) such as C-reactive protein (CRP), occurring within a few hours of initiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>APR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Infection, inflammation, tissue injury, and occasionally neoplasms may trigger the APR.</rdfs:comment>
        <rdfs:label>acute-phase response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12839"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12982"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12840"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12841 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12841">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rejection of a tissue or organ graft from a genetically unrelated donor, typically occurring within 10 to 13 days of transplantation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>acute rejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12842 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12842">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute lung failure characterized by alveolar and interstitial edema, perivascular pulmonary edema, and hyaline membrane formation, resulting from a variety of underlying diseases that result in increased pulmonary vascular permeability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ARDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>adult respiratory distress syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acute respiratory distress syndrome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12842"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ARDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12843 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12843">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response based on the principle of clonal recognition, such that upon first exposure to an antigen, primed lymphocytes either differentiate into immune effector cells or form an expanded pool of memory cells that respond to secondary exposure to the same antigen by mounting an amplified and more rapid response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The response may be classified as cellular (T cell-mediated) or humoral (antibody-dependent).</rdfs:comment>
        <rdfs:label>adaptive immune response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13234"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13452"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12844 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12844">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the immune system responsible for the adaptive immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>adaptive immune system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12843"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12845 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12845">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adrenocortical hypofunction characterized by hypotension, weight loss, anorexia, and weakness. The most common form is idiopathic Addison disease, mediated by autoimmune mechanisms. Autoantibodies specific to the adrenal cortex are specific diagnostic markers of this form.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Addison autoimmune disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Addison&apos;s autoimmune disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Addison&apos;s disease</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>21-Hydroxylase, a cytochrome P450 steroidogenic enzyme, is one of the major targets of adrenal autoantibodies in idiopathic Addison disease as well as in Addison disease in the context of autoimmune polyglandular syndromes (polyendocrinopathies, autoimmune). Hypofunction or failure of the adrenal gland may also be a manifestation of antiphospholipid syndrome due to thrombosis of the blood vessels of the adrenal glands.</rdfs:comment>
        <rdfs:label>Addison disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13587"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12846 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12846">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extracellular protein of the venular endothelium serving as a ligand to a homing receptor for lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Addressins are glycoproteins recognized by L-selectin.</rdfs:comment>
        <rdfs:label>addressin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10661"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13222"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13369"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12847 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12847">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lack of the enzyme adenosine deaminase (ADA), which catalyzes the deamination of adenosine and deoxyadenosine to produce inosine and deoxyinosine, respectively. Affected individuals have a form of severe combined immunodeficiency (SCID).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ADA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADA Deficiency</oboInOwl:hasRelatedSynonym>
        <rdfs:label>adenosine deaminase deficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13674"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12847"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule belonging mainly to the immunoglobulins, integrin superfamily (e.g., LFA-1, ICAM-1) or selectins, expressed on the cell membrane of various cells including those of the immune system. Interaction of adhesion molecules with each other as receptor and corresponding ligand facilitates cooperation (cross-talk) of cells, signal transduction, and information transfer between cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>adhesion molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13667"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13700"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12849 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12849">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental model of immunopathology with features of rheumatoid arthritis (RA), induced in rats by injection with bacterial products, which may be used to study anti-inflammatory therapies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>adjuvant arthritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13306"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transfer, by transplantation of immunocompetent cells, of the capacity to mount an immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>adoptive transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13277"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Appreciably harmful or unpleasant reaction resulting from an intervention related to the administration of a pharmaceutical product.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>adverse drug reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen-non-specific, inappropriate, or unintended activation of a component of the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The distinction from pseudoallergy is subtle.</rdfs:comment>
        <rdfs:label>adverse immunostimulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13621"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12853 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12853">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any airborne particle, such as a pollen grain or spore, that triggers an allergic reaction in sensitive individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>aeroallergen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in antibody affinity for an antigen observed as the humoral immune response progresses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>affinity maturation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13235"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12855 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12855">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of the bone marrow to make sufficient granulocytes, especially neutrophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This is normally identified by a neutrophil count less than \(\pu{0.5E9}\) per litre of blood.</rdfs:comment>
        <rdfs:label>agranulocytosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenomenon whereby, following successful rearrangement of one allele of an antigen receptor gene, rearrangement of the other parental allele is suppressed, thereby ensuring each lymphocyte expresses only a single specificity of antigen receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This does not occur for \(\upalpha\) chains in T lymphocytes.</rdfs:comment>
        <rdfs:label>allelic exclusion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunostimulant antigenic substance that may or may not cause a clinically significant effect but which is capable of producing an immune reaction, often immediate-type hypersensitivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>allergen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13255"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13318"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunologically hypersensitive.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>allergic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Symptoms or signs occurring in sensitized individuals following exposure to a previously encountered substance (allergen) that would otherwise not cause such symptoms or signs in non-sensitized individuals. The most common forms of allergy are rhinitis, urticaria, asthma, and contact dermatitis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Except in the case of contact allergens, it is often an immunoglobulin E (IgE)-mediated hypersensitivity, e.g., asthma, eczema, hay fever, or food allergy.</rdfs:comment>
        <rdfs:label>allergy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13107"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13196"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13291"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13653"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody produced against an antigen from another member of the same species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>alloantibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12861"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen, present in some but not all individuals of a particular species, that arises from polymorphisms at the major histocompatibility complex (MHC) loci and stimulates intense reactions to allograft tissues from other individuals of the same species that do not produce it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>isoantigen</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The human ABO blood group system antigens and Rhesus (Rh) factor are important examples of alloantigens.</rdfs:comment>
        <rdfs:label>alloantigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12863"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13649"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12862 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12862">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetically different, referring to individuals of the same species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>allogenic</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In immunotoxicology this generally refers to the use of genetically dissimilar cells to elicit a cell-mediated immune response in in vitro assays.</rdfs:comment>
        <rdfs:label>allogeneic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12994"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13325"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue or organ graft between allogeneic individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>allograft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12862"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12864 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12864">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Allelic variant of an antigen that, because it is not present in all individuals, may be immunogenic in members of the same species that have a different version of the allele.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>allotype</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12865 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12865">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reactivity of an antibody with an alloantigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>alloreactivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12861"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Activation pathway involving complement components C3, Factor B, Factor D, and properdin that, in the presence of a stabilizing activator surface such as microbial polysaccharide, generates the alternative pathway C3 convertase C3bBb.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>alternative pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13612"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12867 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12867">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macrophage found in the lung alveoli; it may remove and sometimes retain inhaled particulate matter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>alveolar macrophage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12868 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12868">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Inflammation of alveoli. 2) Inflammation of a tooth socket.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>alveolitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibrous protein secreted into the extracellular space where it forms amorphous deposits in multiple organs in some pathological states.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Amyloid beta (\({\rm{A}}\upbeta\)) is found in neuronal plaques in the brain in Alzheimer disease.</rdfs:comment>
        <rdfs:label>amyloid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing immunological memory that gives rise to a rapid increase in immunological response after reexposure to antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Literally, &quot;does not forget&quot;.</rdfs:comment>
        <rdfs:label>anamnestic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13300"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immediate overreaction of the immune system to a drug or other agent in an individual who has previously encountered the agent and has produced antibodies to that agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The major manifestation of anaphylactic shock is angioedema, which leads to hypovalemia, obstruction of the airway, and bronchospasm; these in turn may lead to coma or death.</rdfs:comment>
        <rdfs:label>anaphylactic shock</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of or resembling anaphylaxis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>anaphylactoid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12874"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complement-derived protein fragment (e.g., C3a, C4a, or C5a) capable of directly triggering mast cell degranulation, chemotaxis, smooth muscle contraction, and inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>anaphylatoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13000"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13084"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Life-threatening type I hypersensitivity allergic reaction occurring in a person or animal exposed to an antigen or hapten to which they have previously been sensitized.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Consequences of the reaction may include angioedema, vascular collapse, shock, and respiratory distress.</rdfs:comment>
        <rdfs:label>anaphylaxis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12871"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13255"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12875 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12875">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lack of an immune response, usually taken as lack of response to common recall antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The failure of B or T cells to proliferate in response to defined autoantigens (clonal anergy) is a primary mechanism of self-tolerance.</rdfs:comment>
        <rdfs:label>anergy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13012"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13636"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12876 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12876">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Swelling that occurs in the tissue just below the surface of the skin, most often around the lips and eyes, the mucous membranes and occasionally the viscera.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>angioneurotic edema</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Angioedema is often associated with dermatographism, urticaria, erythema, and purpura. It may sometimes be a sign of a condition such as leukemia or Hodgkin disease.</rdfs:comment>
        <rdfs:comment>Angioedema is similar to hives, but hives involve itchy red welts on the surface of the skin, whereas angioedema is a deeper swelling under the skin.</rdfs:comment>
        <rdfs:comment>Angioedema may take from minutes to hours to develop. Severe angioedema can compromise the airway, and can be life-threatening.</rdfs:comment>
        <rdfs:comment>It may be genetic, when it is referred to as hereditary angioedema (HAE), but is more usually caused by an allergic reaction to either food or medication, and is then called acquired angioedema (AAE).</rdfs:comment>
        <rdfs:label>angioedema</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13125"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13220"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13625"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic inflammatory disease affecting the spine, sacroiliac joints, and large peripheral joints, having a major genetic predisposition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>ankylosing spondylitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody administered with the aim of treating a disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>therapeutic antibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12879 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12879">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytotoxic reaction in which an antibody-coated target cell is directly killed by an Fc receptor-bearing leukocyte, e.g., NK cell, macrophage, neutrophil, or eosinophil.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ADCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>antibody-dependent cell-mediated cytotoxicity</oboInOwl:hasRelatedSynonym>
        <rdfs:label>antibody-dependent cellular cytotoxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12879"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADCC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay that measures the humoral immune response mediated by the concerted actions of antigen-presenting cells, T lymphocytes, and B lymphocytes, generally by determination of murine primary IgM or IgG antibodies directed against the T-cell-dependent sheep red blood cell (SRBC) surface antigens after in vivo sensitization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AFC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AFC assay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerne plaque assay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hemolytic plaque assay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>plaque-forming cell (PFC) assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Due to involvement of multiple cell populations in mounting an antibody response, the AFC assay actually evaluates several immune parameters simultaneously. It is considered to be one of the most sensitive indicator systems for immunotoxicology studies.</rdfs:comment>
        <rdfs:label>antibody-forming cell assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13289"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12880"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AFC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of an antibody to target specific cells (often tumor cells) or signal transduction pathways (often via chemokines/cytokines) in the treatment of disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The main objectives are stimulation of the patient’s immune system to attack malignant tumor cells and the prevention of tumor growth by blockage of specific cell receptors.</rdfs:comment>
        <rdfs:label>antibody therapy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoantibody that binds to phospholipids and/or proteins of the cell membrane in systemic lupus erythematosus (SLE), and can interfere with blood clotting and tests of clotting function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>antibody</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lupus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lupus antibody</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lupus anticoagulant</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lupus anticoagulant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody directed against single-stranded or double-stranded DNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>anti-DNA antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12898"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody against molecules of the red blood cell, usually against membrane proteins, causing lysis of the red blood cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Maternal IgG antibodies specific for the Rhesus (Rh) factor blood group antigen expressed against the erythrocytes of the fetus may lead to hemolytic disease of the newborn.</rdfs:comment>
        <rdfs:label>anti-erythrocyte antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12956"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13202"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13649"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capable of stimulating lymphocytes to produce antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>antigenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12886 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12886">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of an antigen to bind to a specific antibody or T-cell receptor (TCR); often a measure of its ability to produce immunity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>antigenicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12887 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12887">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Display of antigen as peptide fragments bound to major histocompatibility complex (MHC) molecules on the surface of a cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>T cells recognize antigen only when it is presented in this way.</rdfs:comment>
        <rdfs:label>antigen presentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12888 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12888">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell, such as a dendritic cell or macrophage, that is responsible for making antigens accessible to lymphocytes and other immune effector and regulatory cells, making possible specific recognition by receptors on the cell surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>APC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In a more restricted way, used to describe major histocompatibility complex (MHC) class II-positive cells (accessory cells) that internalize and degrade an antigen (generally by phagocytosis), before a fragment of the antigen molecule is presented on the APC cell surface in association with an MHC molecule. This complex is recognized by either B cells via surface-bound immunoglobulin (Ig) molecules, or by T cells via the T-cell receptor (TCR) for the antigen. Induction of a specific immune response then proceeds.</rdfs:comment>
        <rdfs:label>antigen-presenting cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12830"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Pocket in a major histocompatibility complex (MHC) molecule that binds antigen for antigen presentation. 2) Hydrophobic binding region in the CD1 protein that anchors lipid-containing antigens causing exposure of the peptide or carbohydrate moiety in a position enabling T-cell receptor (TCR) contact.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>antigen-binding groove</oboInOwl:hasRelatedSynonym>
        <rdfs:label>antigen-presenting groove</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12890 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12890">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cleavage of protein antigens in antigen-presenting cells (APCs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The immunogenic peptides interact with the binding sites of major histocompatibility complex (MHC) class II products (exogenous antigens) or with those in MHC class I products (endogenous antigens, including viruses). The processed antigen-MHC complex is recognized by the antigen receptor complex of T lymphocytes.</rdfs:comment>
        <rdfs:label>antigen processing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific antigen-binding receptor on T or B lymphocytes that is transcribed and translated following rearrangements and translocation of V, D, and J genes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>antigen receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12892 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12892">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of highly specialized proteins of the immune system to recognize antigens and specifically bind to them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Types of antigen recognition include that by antibodies, T-cell receptors (TCRs), and toll-like receptors (TLRs).</rdfs:comment>
        <rdfs:label>antigen recognition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13747"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12893 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12893">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody raised against antigenic determinants unique to the variable region of a single antibody.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>anti-idiotypic antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13252"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13253"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody against universal features of a given constant (C) region isotype (such as $\upgamma\!$ or $\upmu\!$) of one species that is made by immunizing a member of another species with that isotype.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Such antibodies will bind any antibody of that isotype, and are thus useful for detecting bound antibody molecules in immunoassays and other applications.</rdfs:comment>
        <rdfs:label>anti-isotypic antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13039"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoantibody producing a mitochondrial staining pattern on sections of various tissues and on tumor cell monolayers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AMA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>According to the fluorescence pattern, different subtypes can be differentiated. Antimitochondrial antibodies of the subtype 2 (AMA-M2) are directed against antigens of three related 2-oxo acid dehydrogenase complexes (e.g., the E2 subunit of the pyruvate dehydrogenase complex, PDC-E2) localized to the inner mitochondrial membrane. AMA-M2 is a specific marker of primary biliary cirrhosis (PBC).</rdfs:comment>
        <rdfs:label>antimitochondrial antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13600"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12895"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody against antigens in the cytoplasm of neutrophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ANCA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>antineutrophil cytoplasmic autoantibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12897"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12896"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ANCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a group of autoimmune systemic vasculitides associated with antineutrophil cytoplasmic autoantibodies (ANCAs), e.g., Wegener granulomatosis (WG), microscopic polyangiitis, and Churg–Strauss syndrome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ANCA-associated vasculitis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>antineutrophil cytoplasmic autoantibody associated vasculitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13782"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody, detectable in the blood, that has the capability of binding to a substance, e.g., DNA, within the nucleus of the cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ANA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>antinuclear factor (ANF)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>ANAs are found in patients whose immune system may be predisposed to cause inflammation against their own body tissues. ANAs indicate the possible presence of autoimmunity and are an indication of autoimmune disease, such as rheumatoid arthritis (RA), scleroderma, Sjögren syndrome, systemic lupus erythematosus (SLE), and mixed connective tissue disease (MCTD).</rdfs:comment>
        <rdfs:label>antinuclear antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12898"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ANA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the most common autoimmune diseases, characterized by thrombosis, recurrent spontaneous abortions, and the presence of antiphospholipid antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>APS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Antiphospholipid syndrome may occur as an isolated disease (primary APS) or in combination with another autoimmune disease, especially systemic lupus erythematosus (SLE) (secondary APS).</rdfs:comment>
        <rdfs:label>antiphospholipid syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12899"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12900 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12900">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test to determine T-cell-dependent antibody response, usually by enzyme-linked immunosorbent assay (ELISA). Sheep red blood cells (SRBCs) are used as an antigen. Often referred to as the plaque assay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SRBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SRBC Assay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>plaque assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A similar test is often performed with the tetanus toxoid as the antigen.</rdfs:comment>
        <rdfs:label>anti-sheep red blood cell IgM response assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13115"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13729"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12900"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SRBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12901 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12901">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody specific for exotoxins produced by certain microorganisms such as the causative agents of diphtheria and tetanus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>antitoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13132"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Greatly decreased formation of erythrocytes and hemoglobin, usually associated with pronounced granulocytopenia and thrombocytopenia, as a result of hypoplastic or aplastic bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The diagnosis requires bone marrow biopsy to demonstrate replacement of blood cell precursors with fat cells and rule out other causes of pancytopenia such as neoplastic infiltration.</rdfs:comment>
        <rdfs:label>aplastic anemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13184"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13532"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of a joint or joints.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>arthritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Local antibody-mediated hypersensitivity reaction in which antigen-antibody complexes which fix complement are deposited in the walls of small vessels, often in the skin, causing acute inflammation with an infiltration of neutrophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Gell and Coombs Type III reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Arthus reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13167"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12905 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12905">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic respiratory disease characterized by bronchoconstriction, excessive mucus secretion, and edema of the pulmonary alveoli, resulting in difficulty in exhaling, wheezing, and cough.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>asthma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease characterized by staggering gait, multiple disorganized blood vessels, and an immunodeficiency, associated with a protein called ataxia telangiectasia-mutated (ATM), a protein kinase thought to be important in detection of double-stranded DNA breaks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ataxia telangiectasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12906"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoglobulin E (IgE)-mediated hypersensitivity, including asthma, eczema, hay fever, and food allergy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>atopic allergy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12910"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13107"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13196"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13291"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the skin in atopic individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The term is broader than atopic eczema.</rdfs:comment>
        <rdfs:label>atopic dermatitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12910"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic skin disease, often localized on flexural surfaces, in individuals with propensity to develop immunoglobulin E (IgE)-mediated allergy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The term describes eczema occurring in atopic individuals and does not imply mechanisms.</rdfs:comment>
        <rdfs:label>atopic eczema</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12910"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13107"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, relating to, or caused by a hereditary predisposition toward developing certain hypersensitivity reactions, such as hay fever, asthma, or chronic urticaria, upon exposure to specific antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>atopy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13196"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12911 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12911">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vaccine made from a live organism that targets cells of the immune system but has been engineered or weakened so as not to cause disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>attenuated vaccine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13327"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13391"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12912 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12912">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute or chronic respiratory distress in cattle, in the absence of toxemia or other systemic signs that are characteristic of other pneumonias.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>exogen allergic alveolitis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Also called bovine pulmonary emphysema, enzootic bovine adenomatosis, pulmonary adenomatosis, mold hypersensitivity, fog fever, and panters.</rdfs:comment>
        <rdfs:comment>The causes are unknown, but may include allergic reactions or toxicity due to conversion of tryptophan to toxic 3-methylindole by gut flora.</rdfs:comment>
        <rdfs:label>atypical interstitial pneumonia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13756"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12913 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12913">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoglobulin (Ig) antibody that is directed against the organism’s own antigen(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autoantibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigenic component of an individual’s tissues which may be a target of autoimmune responses by autoreactive B cells (autoantibodies) or T cells, including proteins (e.g., enzymes, structural proteins), glycoproteins (e.g., 2-glycoprotein I), nucleic acids, (e.g., double-stranded DNA), phospholipids (e.g., cardiolipin), and glycosphingolipids (e.g., gangliosides).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autoantigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12989"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to self.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autochthonous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12916 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12916">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of signaling in which a cell secretes a chemical messenger that binds to receptors on the same cell, leading to changes in the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autocrine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue transplant from one site to another in an individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autograft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12918 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12918">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of or relating to an immune response by the body against one of its own cells or tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autoimmune</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12919 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12919">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathological condition resulting when an organism produces antibodies or specific cells that bind to constituents of its own tissues (autoantigens) and cause tissue injury.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autoimmune disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13481"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12920 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12920">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease in which antibodies initiate complement lysis of erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Autoimmune hemolytic anemia may be idiopathic, secondary to lymphoproliferative, autoimmune [e.g., systemic lupus erythematosus (SLE)], or chronic inflammatory disorders, postinfectious or drug-induced.</rdfs:comment>
        <rdfs:label>autoimmune hemolytic anemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12921 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12921">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic autoimmune-mediated hepatic inflammation usually characterized by antinuclear (ANA), smooth muscle (SMA)/anti-F-actin, liver-kidney microsomal (LKM), and/or soluble liver antigen (SLA) antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AIH</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autoimmune hepatitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12898"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13392"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12921"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AIH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease characterized by lymphadenopathy, hepatosplenomegaly, autoimmune cytopenias, and hypergammaglobulinemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ALPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canale–Smith syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autoimmune lymphoproliferative syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13070"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13237"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13393"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12922"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ALPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12923 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12923">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heterogeneous group of rare diseases characterized by autoimmune activity against more than one endocrine organ, although non-endocrine organs can also be affected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>APS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoimmune polyendocrine syndrome, type 1 is known as the candidiasis-hypoparathyroidism-Addison disease syndrome after its main features: A mild immune deficiency, leading to persistent mucosal and cutaneous infections with Candida yeasts. There is also decreased function of the spleen (asplenism).Autoimmune dysfunction of the parathyroid gland (leading to hypocalcemia) and the adrenal gland (Addison disease).</rdfs:comment>
        <rdfs:comment>Autoimmune polyendocrine syndrome, type 2 (also known as Schmidt syndrome) is more heterogeneous, occurs more often and has not been linked to one gene. Features of this syndrome are Addison disease, hypothyroidism (Hashimoto thyroiditis), and diabetes mellitus type 1. Patients are at a higher risk when they carry a particular human leukocyte antigen (HLA) genotype (e.g., DQ2, DQ8, and DRB1*0404).</rdfs:comment>
        <rdfs:label>autoimmune polyendocrine syndrome type 1 or 2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12845"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12986"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13195"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13230"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12923"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12924 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12924">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>DNA-binding protein involved in immunoregulation (probably in the establishment and maintenance of tolerance).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>AIRE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autoimmune regulator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12924"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AIRE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12925 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12925">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response to &apos;self&apos; tissues or components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Such an immune response may have pathological consequences leading to autoimmune diseases.</rdfs:comment>
        <rdfs:label>autoimmunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12926 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12926">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unregulated inflammation without significant levels of autoantibodies or autoactivated T cells, or evidence of infection, but rather caused by genetic disturbance of the mechanisms that initiate and control inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autoinflammatory disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12927 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12927">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>From the same individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autologous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody derived from a specific individual, acting within that individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autologous antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13206"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12929 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12929">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Digestion and breakdown in lysosomes of a cell’s own proteins and/or organelles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It may be one route by which proteins can be processed for antigen presentation.</rdfs:comment>
        <rdfs:label>autophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13208"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13423"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13456"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13558"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response directed at self-antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>autoreactivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small (\(\pu{12 kDa}\)) protein forming part of the structure of major histocompatibility complex (MHC) class I-encoded molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The presence of \(\upbeta_{2}\)-microglobulin in urine is a common indicator of renal tubular dysfunction.</rdfs:comment>
        <rdfs:label>β2-microglobulin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12932 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12932">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two major subpopulations of B lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>B-1/B-2 lymphocytes</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>B-1 cells bear high levels of surface immunoglobulin M (IgM), show lower levels of surface immunoglobulin D (IgD), are CD43+/CD23-, and most express the cell surface antigen CD5. They are self-renewing, and frequently secrete high levels of antibody that binds to a range of antigens (&quot;polyspecificity&quot;) with a relatively low affinity.</rdfs:comment>
        <rdfs:comment>The majority of B cells are B-2 which express low levels of surface IgM, higher levels of surface IgD, do not express CD5, and are CD43-, CD23+; they are directly generated from precursors in the bone marrow, and secrete highly specific antibody.</rdfs:comment>
        <rdfs:label>B-1/B-2 cells</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12979"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13287"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Co-stimulatory molecule on the surface of T-cell-activating antigen-presenting cells (APCs), allowing full activation of T cells that are bound to major histocompatibility complex (MHC)-peptide complexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Whereas binding of B7 molecules to CD28 is stimulatory, binding to cytotoxic T-lymphocyte antigen-4 (CTLA-4) decreases T-cell activity and participates in tolerance.</rdfs:comment>
        <rdfs:label>B7 molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13051"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13073"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adaptor protein operating in B cells that, upon phosphorylation, recruits signaling molecules to membrane lipid rafts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BLNK</oboInOwl:hasRelatedSynonym>
        <rdfs:label>B-cell linker protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13390"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12934"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BLNK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12935 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12935">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generic name given to B-cell-specific growth and differentiation factors involved in the T-cell-dependent activation of B cells. Many are now identified as specific interleukins (ILs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BSF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>B-cell stimulatory factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12935"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BSF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor on the surface of a B cell consisting of transmembrane immunoglobulin (Ig) that recognizes a specific antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BCR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>B-cell receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12936"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BCR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bone marrow-derived lymphocyte, expressing an antigen-receptor complex composed of membrane-bound immunoglobulin (Ig) and associated molecular chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>B cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>B-cell receptors (BCRs) interact with epitopes directly [no major histocompatibility complex (MHC) restriction]. Mature activated B lymphocytes (plasma cells) produce antibody and are efficient antigen-presenting cells (APCs).</rdfs:comment>
        <rdfs:label>B lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemokine that attracts B cells and activated T cells into the follicles of peripheral lymphoid tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CXCL13</oboInOwl:hasRelatedSynonym>
        <rdfs:label>B-lymphocyte chemokine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12938"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CXCL13</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transcriptional repressor in B cells, that switches off genes required for B cell proliferation in the germinal center, and for class switching and affinity maturation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BLIMP-1</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>B cells in which BLIMP-1 is induced become plasma cells.</rdfs:comment>
        <rdfs:label>B-lymphocyte-induced maturation protein 1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12854"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13010"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13172"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12939"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BLIMP-1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12940 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12940">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attenuated Mycobacterium tuberculosis used both as a specific vaccine for tuberculosis and as an adjuvant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BCG</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Also used as an immunostimulant in cancer therapy (e.g., in bladder cancer).</rdfs:comment>
        <rdfs:label>bacille Calmette–Guérin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13318"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12940"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BCG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12941 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12941">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inbred albino mouse strain, substrains of which produce plasmacytomas on injection with mineral oil, useful for the production of monoclonal antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>BALB/c mouse</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13578"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12942 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12942">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare, recessive genetic condition in which the products of one or more genes required to switch on major histocompatibility complex (MHC) class I or MHC class II genes are defective or absent. As a consequence, MHC class I (BLS1) or MHC class II (BLS2) genes are not expressed, leading to severe immunodeficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BLS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bare lymphocyte syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12942"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BLS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12943 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12943">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of granulocyte found in the blood and resembling the tissue mast cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>basophil</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12944 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12944">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of granules in basophilic cells, associated with the release of active substances from the cells, characteristic of type I immediate hypersensitivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>basophilic degranulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13255"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12945 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12945">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of the Bcl protein family that protects cells from apoptosis by binding to the mitochondrial membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It is encoded by the bcl-2 gene, which was discovered at the breakpoint of an oncogenic chromosomal translocation in B-cell leukemia.</rdfs:comment>
        <rdfs:label>Bcl-2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12946 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12946">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic vasculitis of unknown origin, characterized by ulcerations and skin rash and treated by immunosuppression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Behcet disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13776"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12947 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12947">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excess circulating kappa ($\kappa$)-light chain found in the urine of patients with multiple myeloma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Bence–Jones protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13358"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13477"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12948 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12948">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonmalignant overproduction of $\ce{\upgamma\!\mbox{-}globulin}$ by a single clone of lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>benign monoclonal gammopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13165"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12949 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12949">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of small particles, e.g., colloidal gold, as a vehicle for carrying agents (drugs, nucleic acid, etc.) into a cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Following coating with the desired agent(s), the particles are fired into the dermis of the recipient using a helium-powered gun.</rdfs:comment>
        <rdfs:label>biolistics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12950 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12950">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique for selection of peptides with high affinity binding to a chosen target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>biopanning</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12951 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12951">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Artificially produced hybrid antibody in which each of the two antigen-binding arms is specific for a different antigenic epitope. Such antibodies, which can be produced either by chemical cross-linkage or by recombinant DNA techniques, can be used to link together two different antigens or cells, e.g., a cytotoxic T lymphocyte and a tumor cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bispecific antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12952 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12952">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immature stage in cell development, before the appearance of the definitive characteristics of the cell; used also as a word termination, as in erythroblast, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>blast</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12953 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12953">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare familial inflammatory disease characterized by arthritis, dermatitis, and uveitis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Blau syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13089"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12954 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12954">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody that prevents other antibodies from combining with a specific antigen but does not itself produce an immunological response when combined with that antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>blocking antibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12955 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12955">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of abnormal material in the blood, usually applied to diseases affecting blood cells or platelets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>dyscrasia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>blood dyscrasia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12956 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12956">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface antigen on erythrocytes, detectable with a specific antibody from other individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The major blood group antigens ABO and Rh (Rhesus) are used in routine blood banking to type blood, but there are many other blood group antigens that can also be detected in cross-matching.</rdfs:comment>
        <rdfs:label>blood group antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13054"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13649"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12957 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12957">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physiological interface between maternal and fetal blood circulations that filters out some substances that could harm the fetus while favoring the passage of others such as nutrients.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Immunoglobulin G (IgG) antibodies are specifically transported across the barrier and reach the same levels in the newborn, as in the mother.</rdfs:comment>
        <rdfs:comment>Many fat-soluble substances such as alcohol are not filtered out, and several types of virus can also cross this barrier.</rdfs:comment>
        <rdfs:comment>The effectiveness of the interface as a barrier varies with species and different forms of placentation.</rdfs:comment>
        <rdfs:label>blood–placenta barrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12958 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12958">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease caused by mutations in a DNA helicase and characterized by low T cell numbers, reduced antibody levels, and an increased susceptibility to respiratory infections, cancer, and radiation damage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Bloom syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12959 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12959">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Soft fatty vascular substance in the cavity of bone where blood cells are formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bone marrow</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12960 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12960">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transfer of bone marrow from a donor to a recipient whose bone marrow has been ablated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Bone marrow transplantation is used to treat both non-neoplastic and neoplastic conditions not amenable to other forms of therapy.</rdfs:comment>
        <rdfs:comment>It has been used especially in cases of aplastic anemia, acute lymphoblastic (lymphocytic) leukemia (ALL), and acute myelogenous leukemia (AML).</rdfs:comment>
        <rdfs:label>bone marrow transplantation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12837"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12902"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12961 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12961">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of an immunizing agent given at a later time to stimulate the effects of a previous dose of the same agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>booster</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12962 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12962">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vasoactive peptide and inflammatory mediator produced at sites of tissue damage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bradykinin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12963 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12963">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test of alteration of lung function induced by inhalation of an allergen or airway-constricting agent, providing information on bronchial responsiveness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bronchial provocation test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12964 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12964">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin sensitization test for contact allergic dermatitis in which a test substance is applied to the shaved flank of a guinea pig in an occlusive patch for 6 h at 0, 1, and 2 weeks, followed by challenge of the untreated flank at 4 weeks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>BA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Buehler test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Buehler assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13682"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12964"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12965 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12965">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of several autoimmune diseases characterized by intraepidermal or subepidermal blisters (e.g., pemphigus vulgaris, bullous pemphigoid) and highly specific autoantibodies against components of the desmosome or hemidesmosome (e.g., desmoglein 3, BP180).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune bullous skin disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autoimmune bullous skin disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12966 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12966">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphoma caused by Epstein–Barr virus (EBV), occurring mainly in sub-Saharan Africa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Burkitt lymphoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13122"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13417"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12967 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12967">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Primary lymphoid organ in avian species, located at the cloacal-hind gut junction; it is the site of B-cell maturation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bursa of Fabricius</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13447"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12968 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12968">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Positive or negative effect on the immune system seen after exposure to certain drugs, radiation, and other agents, induced by non-immune mechanisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bystander effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12969"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12969 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12969">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Suppression of an immune response to an antigen due to tolerance to an unrelated (hence bystander) antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>bystander suppression</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13701"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12970 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12970">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plasma glycoprotein secreted primarily by the liver and acting as a serine proteinase inhibitor (serpin), inhibiting C1 components of the complement system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>C1 esterase inhibitor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It also inhibits coagulation factors XI and XII and kallikrein.</rdfs:comment>
        <rdfs:comment>Patients with C1 inhibitor deficiency may manifest systemic lupus erythematosus (SLE), glomerulonephritis, or pyrogenic infections.</rdfs:comment>
        <rdfs:label>C1 inhibitor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13204"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13356"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12971 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12971">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface protein of antigen-presenting cells (APCs) involved in presentation of lipopeptide or glycolipid antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12889"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12972 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12972">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule composed of five polypeptide chains associated with the heterodimer T-cell receptor (TCR), forming the T-cell receptor complex (TCR/CD3); CD3 transduces the activating signals when antigen binds to the TCR.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD3</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12973 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12973">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface antigen belonging to the immunoglobulin (Ig) superfamily of molecules and a marker of T helper cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>As an adhesion molecule, it interacts with the non-polymorphic part of major histocompatibility complex (MHC) class II gene product.</rdfs:comment>
        <rdfs:label>CD4</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13700"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12974 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12974">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subtype of CD4+ regulatory T cell (Treg) with potential role in the regulation of immune homeostasis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Activated T cells may also have this phenotype. Treg cells may be further distinguished by positivity for a protein marker Foxp3.</rdfs:comment>
        <rdfs:comment>These cells seem to be important in preventing the development of autoimmune diseases (depletion leads to the spontaneous development of various autoimmune diseases in genetically susceptible animals; transfer prevents the development of organ-specific autoimmunity).</rdfs:comment>
        <rdfs:label>CD4+/CD25+ T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13141"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12975 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12975">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte of type B-1a, which is predominant in fetal lymphoid organs and in neonatal cord blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>In adults, these cells range from \(\pu{2}\) to \(\pu{6\%}\) of total mononuclear cells in peripheral blood. They utilize an immunoglobulin (Ig) variable (V) gene repertoire different from that of CD5– B cells and they produce natural autoantibodies.</rdfs:comment>
        <rdfs:comment>The expansion of autoreactive B1-a cells has been reported in peripheral blood of patients with autoimmune diseases [e.g., rheumatoid arthritis (RA), Sjögren syndrome, antiphospholipid syndrome (APS)]. In RA these cells can account for up to \(\pu{20\%}\) of circulating B cells and may produce rheumatoid factor.</rdfs:comment>
        <rdfs:label>CD5+ B lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12899"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13497"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13652"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12976 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12976">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface molecule belonging to the immunoglobulin (Ig) superfamily of molecules found, among others, on cytotoxic T cells, which binds to major histocompatibility complex (MHC) class I molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD8</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13700"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12977 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12977">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outdated term for CD8+ cytotoxic T lymphocyte (CTL, Tc). The term &apos;suppressor T cell&apos; is nowadays reserved for regulatory T cell (Treg).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD8+ T suppressor cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13702"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12978 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12978">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Low-affinity $\ce{Fc\mbox{-}\upgamma\! receptor}$ ($\ce{Fc\mbox{-}\upgamma\!\mbox{-}RIII}$) expressed mainly on natural killer (NK) cells, granulocytes, and macrophages, mediating antibody-dependent cellular cytotoxicity (ADCC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD16</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12879"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12979 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12979">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Low-affinity ${\rm{Fc\mbox{-}}}\upvarepsilon\!$ receptor induced by interleukin-4 (IL-4) and expressed on see activated B cells and macrophages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD23</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12980 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12980">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>\(\ce{\upalpha\mbox{-}chain}\) of the interleukin-2 (IL-2) receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>CD25</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12981 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12981">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Essential molecule for normal switching signaling through binding to CD40 on B cells. The interaction of CD40L and CD40 is also critical for optimal T cell function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD40L</oboInOwl:hasRelatedSynonym>
        <rdfs:label>CD40 ligand</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12981"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CD40L</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12982 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12982">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Serum protein produced by liver cells as part of the acute-phase response, which acts as a stimulus of the classical pathway of complement activation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CRP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>CRP binds to the phosphorylcholine component of the C-polysaccharide, a component of the surface of many bacteria and fungi, resulting in opsonization for enhanced phagocytosis.</rdfs:comment>
        <rdfs:label>C-reactive protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12840"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13526"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12982"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12983 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12983">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a large family of \(\ce{Ca^{2+}}\)-dependent lectins; members of this family share primary structural homology in their carbohydrate-recognition domains and include many endocytic receptors, many proteoglycans, and all known collectins and selectins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The C-type lectins are involved in many immune system functions, such as inflammation and immunity to tumor and virally infected cells, whereas the collectins are involved in innate immunity.</rdfs:comment>
        <rdfs:label>C-type lectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13023"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13335"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13667"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12984 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12984">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calcium-dependent, transmembrane glycoprotein occurring in cell-cell contacts (desmosomes) and functioning as an adhesion molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Cadherins may mediate lymphocyte homing and are also important elements in cellular signal transduction.</rdfs:comment>
        <rdfs:label>cadherin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13403"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12985 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12985">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a group of immunomodulating drugs that bind to the cytosolic protein cyclophilin of T lymphocytes, thus inhibiting the phosphatase calcineurin, an inducer of interleukin-2 (IL-2) formation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Calcineurin inhibitors include potent immunomodulating drugs, such as cyclosporin, tacrolimus, pimecrolimus, and voclosporin (see Annex II).</rdfs:comment>
        <rdfs:label>calcineurin inhibitor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13305"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12986 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12986">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Infection with a fungus of the genus Candida, especially C. albicans, that usually occurs in the skin and mucous membranes of the mouth, respiratory tract, or vagina but may invade the bloodstream, especially in immunocompromised individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>candidosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>moniliasis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>candidiasis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13278"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13733"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12987 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12987">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Active process whereby cross-linking of cell surface molecules (e.g., by antibody) leads to aggregation and subsequent migration of the molecules to one pole of the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>capping</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12988 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12988">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Membrane glycoprotein epitope normally present in the fetal gastrointestinal tract and elevated in many patients with various carcinomas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CEA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>carcinoembryonic antigen</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12988"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CEA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12989 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12989">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1,3-Bis(sn-3-phosphatidyl)-sn-glycerol, the main target of antiphospholipid antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cardiolipin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12899"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12990 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12990">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of intracellular cysteine proteinases that cleave proteins at specific aspartic acid residues to initiate or promote apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>caspase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12991 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12991">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Invagination on the cell surface (plasma membrane), enriched in caveolin proteins, cholesterol, and glycosphingolipids, important in various processes including pinocytosis and signal transduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>A type of lipid raft.</rdfs:comment>
        <rdfs:label>caveola</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13390"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12992 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12992">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disorder occurring in genetically predisposed individuals, characterized by immune intolerance to the \(\ce{\upalpha\mbox{-}gliadin}\) component of gluten, a protein found in wheat, barley, and rye. Resultant inflammation of the mucosa of the upper small intestine is associated with malabsorption of nutrients and a wasting illness follows from this.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>gluten enteropathy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gluten intolerance</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>non-tropical sprue</oboInOwl:hasRelatedSynonym>
        <rdfs:label>celiac disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13340"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12993 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12993">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lysis of a target cell initiated by a T lymphocyte binding to surface antibodies or antigen-bound major histocompatibility complex (MHC) molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cell-mediated cytotoxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12994 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12994">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific immune response in which T lymphocytes mediate the effects, either through the release of cytokines or through cytotoxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>cell-mediated response</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cell-mediated immune response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12995 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12995">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response mediated by antigen-specific T lymphocytes, either through the release of cytokines or through cytotoxicity, in contrast with humoral immunity, which is antibody-mediated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CMI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cellular immunity</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Cell-mediated immunity may be expressed as immune regulatory activity (primarily mediated by CD4+ helper T lymphocytes (Th), possibly important in preventing autoimmune diseases) or immune effector activity (mediated largely by CD8+ cytotoxic T cells).</rdfs:comment>
        <rdfs:label>cell-mediated immunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12977"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13236"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13266"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12995"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CMI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12996 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12996">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific immunological tolerance due to the induction of lymphocyte apoptosis or anergy within the primary lymphoid organs (bone marrow in the case of B cell tolerance and the thymus for T cells).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>central tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12875"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12997 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12997">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Induction or evaluation of an immune response in an organism by administration of a specific antigen to which it has been sensitized.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>challenge</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12998 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12998">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of autophagy targeting only those proteins that are recognized by the binding of an hsc70-containing chaperone/co-chaperone complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CMA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chaperone-mediated autophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12929"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.12998"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.12999 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.12999">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biologically active substance, such as a chemokine or anaphylatoxin, that induces a concentration gradient-dependent movement of cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>chemotactic factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12873"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13000"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13000 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13000">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) General. Movement of an organism or cell along a concentration gradient of a chemical. 2) In immunology. Movement of cells up a concentration gradient of a chemical attractant (chemotactic factor), such as a chemokine or other cytokine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>chemotaxis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12999"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13001 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13001">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Character of a plant or microorganism based on a metabolite distinct from that found in other members of the same species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>chemovar</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chemotype</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13002 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13002">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acne-like eruption caused by exposure to certain chlorinated organic substances such as polychlorinated biphenyls or 2,3,7,8-tetrachlorodibenzo[1,4]dioxin [2,3,7,8-tetrachlorooxanthrene] and other polychlorinated dibenzodioxins and furans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The lesions are most frequently found on the cheeks, behind the ears, in the armpits and groin region.</rdfs:comment>
        <rdfs:label>chloracne</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13003 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13003">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method used in immunotoxicology to quantify the toxic effect of a substance on leukocytes by measuring uptake of \(\ce{^{51}Cr{-}labeled}\) chromate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>chromate uptake assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13004 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13004">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunotoxicity assay that can be used to assess either natural killer (NK) cell or cytotoxic T cell activity or macrophage activity. When incubated with \(\ce{^{51}Cr{-}labeled}\) chicken red blood cells (cRBCs), NK and cytotoxic T cells lyse the cRBC and thus induce the release of \(\ce{^{51}Cr}\) into the medium. In contrast, macrophages phagocytose cRBC, and are then lysed to assess the amount of \(\ce{^{51}Cr}\) they have taken up.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>&lt;sup&gt;51&lt;/sup&gt;Cr release assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The assay is usually applied to measure parameters of innate immunity.</rdfs:comment>
        <rdfs:label>chromium release assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13323"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13005 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13005">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of airways, skin, eyes and other organs, resulting from repeated or continuous exposure to an allergen and involving immunoglobulin E (IgE) formation, IgE-induced histamine-release from mast cells, liberation of mediators such as cytokines and prostaglandins, and local inflammation characterized by infiltrating leucocytes; it results in augmented susceptibility to the allergen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>chronic allergic inflammation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13006 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13006">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunodeficiency disease in which multiple granulomas form as a result of defective elimination of bacteria by phagocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It is caused by deficiency of the NADPH oxidase system of enzymes that generates superoxide involved in bacterial killing.</rdfs:comment>
        <rdfs:label>chronic granulomatous disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13646"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13007 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13007">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>B cell tumor found in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CLL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The great majority of these tumors express CD5 and unmutated variable (V) genes and are therefore thought to arise from B-1 cells.</rdfs:comment>
        <rdfs:label>chronic lymphocytic leukemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CLL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13008 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13008">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cancer characterized by overgrowth of the bone marrow with malignant white blood cells, usually exhibiting a chromosomal abnormality (Philadelphia chromosome), which causes uncontrolled proliferation of cells that are released into peripheral blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CML</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chronic myelogenous leukemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13008"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CML</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13009 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13009">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunologically triggered reaction occurring in a transplanted organ or tissue, leading to progressive destruction and finally failure of the transplanted organ occurring two months to many years after transplantation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>chronic graft rejection</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In contrast, hyperacute rejection caused by preformed antibodies starts within minutes after organ transplantation, and acute rejection occurs within 2 to 60 days.</rdfs:comment>
        <rdfs:label>chronic rejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13010 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13010">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a B cell changes the class but not specificity of a given antibody it produces, e.g., switching from an immunoglobulin M (IgM) to an immunoglobulin G (IgG) antibody.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>class switching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13011 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13011">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Activation pathway involving complement components C1, C2, and C4 which, following fixation of C1q, e.g., by antigen-antibody complexes, produces the classical pathway C3 convertase C4b2a.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>classical pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12866"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13012 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13012">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of self-tolerance developing as a consequence of negative selection during thymic selection processes. Clones of thymocytes whose antigen receptors [T-cell receptors (TCRs)] bind with high affinity to self-antigens in association with major histocompatibility complex (MHC) molecules are inactivated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>clonal anergy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13598"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13734"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13013 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13013">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which contact with antigen (e.g., self-antigen) at an early stage of lymphocyte differentiation leads to cell death by apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>clonal deletion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13014 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13014">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proliferation of B lymphocytes and T lymphocytes activated by clonal selection in order to produce a clone of identical cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Clonal expansion enables the body to have sufficient numbers of antigen-specific lymphocytes to mount an effective immune response.</rdfs:comment>
        <rdfs:label>clonal expansion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13016"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13015 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13015">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Failure of B or T cells expressing anti-self-receptors to interact with antigen (e.g., by low valency, low concentration, or sequestration of antigens; low receptor avidity; or lack of co-stimulatory molecules).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>clonal ignorance</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This is the primary mechanism involved in the induction and maintenance of self-tolerance.</rdfs:comment>
        <rdfs:label>clonal indifference</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13016 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13016">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Selection and activation by antigen of a lymphocyte, bearing a complementary receptor, which then proliferates to form an expanded clone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>selection theory (in immunology)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>clonal selection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13017 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13017">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cluster of antigens representing a cell surface marker with which antibodies react. Not to be confused with cluster of differentiation (CD) antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cluster determinant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13018"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13018 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13018">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a family of molecular markers on cell surfaces that may be used operationally to define phenotype, origin, and activation state of the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The CD antigens expressed by a T cell vary with its stage of development and thus with its role in the immune response.</rdfs:comment>
        <rdfs:label>cluster of differentiation antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13018"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13019 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13019">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proteolytic cascade of plasma enzymes that triggers blood clotting when blood vessels are damaged.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>coagulation system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13020 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13020">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th) primed by the same antigen as the B cell to which it gives help.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cognate T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13021 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13021">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoantibody that reacts optimally at low temperatures (\(\pu{{0}{-}{5} ^{\circ}C}\)) with surface antigens of erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It mediates autoimmune hemolytic anemia by either cold agglutinins (cold hemagglutinin disease) or cold hemolysins (paroxysmal cold hemoglobinuria).</rdfs:comment>
        <rdfs:label>cold autoantibody type</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12920"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13022 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13022">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune model of rheumatoid arthritis (RA), arising from combined cellular immunity and humoral immunity against collagen type II, and characterized by rapid and severe erosions of cartilage and bone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>collagen arthritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12995"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13236"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13023 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13023">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a structurally related family of calcium-dependent carbohydrate-binding proteins or lectins containing collagen-like sequences, e.g., mannose-binding lectin (MBL).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>collectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13438"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13024 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13024">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Factor that permits the proliferation and differentiation of hematopoietic cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CSF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>colony-stimulating factor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CSF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13025 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13025">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of antibody and T-cell receptor (TCR) diversity that is generated by the recombination of variable (V), diversity (\(D\), for immunoglobulin heavy chains, and for TCR \(\upbeta\) and \(\ce{\updelta\ chains}\)), and joining (J) gene segments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>combinatorial diversity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13026 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13026">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Merging of DNA segments generating new genetic information.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>combinatorial joining</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13027 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13027">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relatively common deficiency in antibody production, of unknown pathogenesis but strongly associated with genes mapping within the major histocompatibility complex (MHC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Characterized by reduced γ globulin levels, generally affecting all the antibody classes, but sometimes only immunoglobulin G (IgG).</rdfs:comment>
        <rdfs:comment>Most patients have normal or near-normal numbers of B cells, which however do not differentiate into plasma cells.</rdfs:comment>
        <rdfs:label>common variable immunodeficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13165"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13028 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13028">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of measuring an antigen in a sample using a labeled species of the antigen as a competitive inhibitor of its binding in a specific antigen–antibody reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>competitive inhibition assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13029 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13029">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypervariable amino acid sequence within antibody and T-cell receptor (TCR) variable (V) regions, which interacts with complementary amino acids on the antigen or major histocompatibility complex (MHC)–peptide complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CDR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>complementarity-determining region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13245"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13029"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CDR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13030 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13030">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Congenital deficiency in any of the various components of the complement system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Rheumatic disorders [mainly systemic lupus erythematosus (SLE)] are associated with deficiencies of the early components of the classical pathway. More than \(\pu{30\%}\) of individuals with C2 deficiency and nearly \(\pu{80\%}\) with either C3 or C4 deficiency have an autoimmune manifestation.</rdfs:comment>
        <rdfs:label>complement deficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13031 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13031">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physiological reaction to the presence of a foreign microorganism in which a cascade of enzymatic reactions, triggered by molecular features of the microorganism, result in lysis or phagocytosis of the foreign material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>complement reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13032 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13032">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-surface protein that recognizes and binds complement proteins that have bound an antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Complement receptors on phagocytes allow them to identify pathogens coated with complement proteins for uptake and destruction. Complement receptors include CR1, CR2, CR3, CR4, and the receptor for Clq.</rdfs:comment>
        <rdfs:label>complement receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13032"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13033 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13033">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of serum proteins with the capacity to interact with each other when activated in a chain reaction which results in formation of a lytic complex and the release of several biologically active peptides of low relative molecular mass (anaphylatoxins).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The system can be activated by antigen–antibody complexes (classical pathway) and by other components, e.g., bacteria (alternative pathway). As an effector mechanism of the humoral immune response, the activated complement system facilitates opsonization, phagocytosis, and lysis of cellular antigens.</rdfs:comment>
        <rdfs:label>complement system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12866"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12873"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13235"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13526"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13034 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13034">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hemagglutinin, isolated from jack bean (Canavalia ensiformis) meal, which reacts with polyglucosans in the blood of mammals, causing agglutination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>conA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Concanavalin A has been used to activate T cells in vitro.</rdfs:comment>
        <rdfs:label>concanavalin A</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13200"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13034"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>conA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13035 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13035">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epitope on a protein antigen formed from several separate regions in the primary sequence of a protein brought together by protein folding.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>discontinuous epitope</oboInOwl:hasRelatedSynonym>
        <rdfs:label>conformational epitope</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13036 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13036">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Differing at a single genetic locus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>congenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13037 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13037">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irritation of the ocular conjunctiva, resulting from the activation of conjunctival mast cells by airborne allergens such as pollens or house dust.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>allergic conjunctivitis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>allergic conjunctivitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13038 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13038">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene that encodes the constant (C) region of immunoglobulin (Ig) chains or T-cell receptor (TCR) chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>C gene</oboInOwl:hasRelatedSynonym>
        <rdfs:label>constant gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13039"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13039 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13039">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of an immunoglobulin (Ig) or T-cell receptor (TCR) that is relatively constant in amino acid sequence among different Ig or TCR molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>C region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>constant (C) region</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In an antibody molecule the constant regions of each chain are composed of up to four C domains. The constant region of an antibody determines its general type of interaction.</rdfs:comment>
        <rdfs:label>constant region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13040 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13040">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that causes a skin hypersensitivity reaction by direct contact.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>contact allergen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13041 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13041">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin inflammation that occurs when the skin’s surface comes in contact with a substance originating outside the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>There are two kinds of contact dermatitis, irritant and allergic.</rdfs:comment>
        <rdfs:label>contact dermatitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13042 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13042">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response following skin contact with an antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>contact hypersensitivity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13043 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13043">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of immunological sensitization in which an eczematous epidermal reaction may occur when a hapten is applied to the skin of a sensitized individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>contact sensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13107"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13044 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13044">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Urticaria provoked by contact with inducing agents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>contact urticaria</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13045 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13045">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predominant type of dendritic cell active in antigen presentation to and activation of naïve T cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>conventional dendritic cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13496"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13046 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13046">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Independent evolution of similarity between molecules or between species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>convergent evolution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13047 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13047">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme activity that converts complement protein into its reactive form by cleaving it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Generation of the C3/C5 convertase is the pivotal event in complement activation.</rdfs:comment>
        <rdfs:label>convertase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13048 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13048">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diagnostic test using anti-immunoglobulin (Ig) to agglutinate antibody-coated erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>direct Coombs test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>direct antiglobulin test (DAT)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>indirect Coombs test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>indirect antiglobulin test (IAT)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The direct Coombs test, or direct antiglobulin test (DAT) refers to agglutination of a blood sample due to antibodies present on the erythrocyte surface. In the indirect Coombs test, or indirect antiglobulin test (IAT) antibodies free in the subject’s serum are tested for their availability to agglutinate erythrocytes of known antigenicity.</rdfs:comment>
        <rdfs:label>Coombs test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12886"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13049 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13049">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface protein receptor that recognizes a substance bound to a primary receptor, and binds to a signaling molecule that thereby enhances the activity of another receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>B-cell receptors (BCRs) require the contributions of several coreceptors, notably CD19, CD21, and CD81 proteins, for full activation of intracellular signaling pathways.</rdfs:comment>
        <rdfs:comment>Optimal T cell activation in an immune response depends on the involvement of relevant coreceptors occurring in a cluster with the T-cell receptors (TCRs). The coreceptors are CD4 or CD8 proteins, which lie alongside the T-cell receptor in the plasma membrane. Only when both coreceptor and receptor bind the major histocompatibility complex (MHC) molecule-antigen complex simultaneously is the full set of intracellular effector molecules recruited and the signal pathway inside the cell maximally activated.</rdfs:comment>
        <rdfs:label>coreceptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12936"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13050 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13050">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the family of steroid molecules that are produced in the adrenal cortex, or their synthetic analogs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Corticosteroids can induce apoptotic cell death in lymphocytes, especially developing thymocytes. Therefore, they are useful anti-inflammatory, anti-lymphoid tumor, and immunosuppressive agents.</rdfs:comment>
        <rdfs:label>corticosteroid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13320"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13598"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13051 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13051">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delivery of a second signal, in addition to that of antigen binding or antigen presentation, that is required for lymphocyte proliferation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>B cells may receive co-stimulatory signals from common pathogen components such as lipopolysaccharide (LPS), from complement fragments, or from CD40 ligand (CD40L) expressed on the surface of an activated antigen-specific helper T lymphocyte (Th).</rdfs:comment>
        <rdfs:comment>Co-stimulatory signals are delivered to T cells by the co-stimulatory molecules, B7.1 and B7.2, related molecules (see B7 molecule) that are expressed on the surface of the antigen-presenting cell (APC), and which bind the T-cell surface molecule CD28.</rdfs:comment>
        <rdfs:label>co-stimulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12933"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12981"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13052 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13052">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that all types of infection early in childhood may protect against the development of atopy by driving the production of cytokines such as interleukin-10 (IL-10) and transforming growth factor $\ce{\upbeta\!}$ ($\ce{TGF\mbox{-}\upbeta\!}$), which downregulate both Th1 and Th2 responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>counter-regulation hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12910"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13719"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13752"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13053 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13053">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic inflammatory bowel disease (IBD) thought to result from an abnormal overresponsiveness to commensal gut flora.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Crohn&apos;s disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Crohn disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13334"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13054 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13054">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Test for determining the compatibility between the blood of a donor and that of a recipient before transfusion; the clumping of erythrocytes indicates incompatibility. 2) Test for determining tissue compatibility between a transplant donor and the recipient before transplantation, in which the recipient’s serum is tested for antibodies that may react with the lymphocytes or other cells of the donor. 3) Process of performing one of these tests.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cross-matching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13753"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13055 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13055">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Activation of CD8+ lymphocytes by the presentation of exogenous antigens in association with major histocompatibility complex (MHC) class I molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>cross-priming</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Cross-presentation can lead to different outcomes, tolerance or immunity.</rdfs:comment>
        <rdfs:comment>The cells that cross-present antigens are the bone marrow-derived antigen-presenting cells (APCs). The form of antigen they monitor from tissues is predominantly cellular protein, acquired though phagocytosis and macropinocytosis and presented through two distinct pathways. In one pathway, antigen is transferred into the cytosol where it is degraded by proteasomes, and in the other, the antigen is hydrolyzed in the endocytic compartment</rdfs:comment>
        <rdfs:comment>This is in contrast to normal activation of these lymphocytes (direct-priming) that results from presentation of endogenous antigens.</rdfs:comment>
        <rdfs:label>cross-presentation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13428"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13613"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13056 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13056">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody that is able to react with an antigen that did not specifically stimulate its production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Cross-reactions are usually weaker than the reaction of the antibody with the antigen that caused its production.</rdfs:comment>
        <rdfs:label>cross-reacting antibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13057 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13057">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that is able to react with an antibody induced by a different antigen. Note: The two antigens may share the same antigenic determinants or carry determinants that are sufficiently alike stereochemically to enable the antibody to react with both. Antigen that has an identical structure in two strains of microorganism, so that antibody raised against one strain will react with the other strain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cross-reacting antigen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13058 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13058">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of immunological hypersensitivity to one substance that predisposes an individual to sensitivity to other substances that are related in chemical structure (cross-reacting antigens).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cross sensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13059 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13059">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of immunological tolerance to one substance produced by priming an animal with another substance that bears a cross-reacting antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cross-tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13060 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13060">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoglobulin (Ig) that forms insoluble aggregates at temperatures below body temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Many cryoglobulins function as autoantibodies (e.g., rheumatoid factor). Cryoglobulins are found in lymphoproliferative (see lymphoproliferation) diseases, a number of autoimmune diseases, as well as chronic infections. They can cause vasculitic and secondary thrombotic manifestations (cryoglobulinemic vasculitis, glomerulonephritis).</rdfs:comment>
        <rdfs:label>cryoglobulin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13061"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13419"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13652"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13061 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13061">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cutaneous or systemic vasculitis caused by cold-labile proteins (cryoglobulins, cryofibrinogen) that leads to increased viscosity, protein precipitation or gelatinification, complement activation, and endothelial cell damage, especially in the cold.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Frequently associated with chronic hepatitis C or B infection, but can also be induced by other infections and malignancies.</rdfs:comment>
        <rdfs:label>cryoglobulinemic vasculitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13776"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13062 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13062">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epitope that cannot be recognized by a lymphocyte receptor until the antigen has been broken down and processed or modified by hapten binding.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cryptic epitope</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13063 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13063">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-surface molecule that is involved in lymphocyte homing to the skin in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CLA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cutaneous lymphocyte antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13403"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CLA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13064 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13064">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Malignant growth of T cells that home to the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mycosis fungoides</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cutaneous T-cell lymphoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13065 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13065">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of soluble small proteins released from a variety of cells, typically of the immune system, that affect cell behavior in an autocrine or paracrine fashion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Cytokines produced by lymphocytes are known as lymphokines; those produced by monocytes are called monokines. Other types of cytokines include chemokines, growth factors, colony-stimulating factors (CSFs), transforming growth factors, interferons, interleukins, and tumor necrosis factors.</rdfs:comment>
        <rdfs:label>cytokine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13024"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13752"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13066 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13066">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method to detect cytokine release by injecting an animal with a neutralizing biotinylated antibody to the cytokine, which inhibits its utilization and allows its accumulation in the blood. Recovered cytokineantibody complexes are then measured in an enzyme-linked immunosorbent assay (ELISA) with an antibody to a second epitope on the cytokine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>&lt;i&gt;in vivo&lt;/i&gt; cytokine capture assay (IVCCA)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cytokine capture assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13115"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13067 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13067">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristic pattern of cytokine production associated with a defined immunological state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cytokine profile</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13068 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13068">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of quantifying cytokines released by viable cells, using cytokine-specific antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CRA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cytokine release assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13068"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13069 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13069">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Cell lysis caused by a lesion produced by the action of complement proteins on the antibody-coated plasma membrane of a cell. 2) Cell lysis following plasma membrane reaction with perforins released by natural killer (NK) cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immune cytolysis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune cytolysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13070 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13070">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in the number of one or more types of blood cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cytopenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13532"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13071 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13071">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Causing damage to cell structure or function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>cytotoxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13072 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13072">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a subset of T lymphocytes bearing the CD8 surface marker and able to kill target cells [infected somatic or tumor cells, recognized by the antigen receptor complex (TCR/CD3)] after induction of a specific immune response to the antigens bound to major histocompatibility complex (MHC) class I molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD8+ T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cytolytic T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cytotoxic T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>killer T cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>CD4+ T cells may also become cytotoxic.</rdfs:comment>
        <rdfs:label>cytotoxic T lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12972"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13073 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13073">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High affinity receptor for B7 molecules expressed on T cells, binding of which inhibits T cell activation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD152</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CTLA-4</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mutations in the gene encoding CTLA-4 have been associated with various autoimmune diseases.</rdfs:comment>
        <rdfs:label>cytotoxic T lymphocyte antigen 4</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12933"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13073"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CTLA-4</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13074 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13074">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay based on quantitation of cell death caused by sensitized lymphocytes or splenocytes cultured with a fixed number of tumor or other target cells that have been prelabeled with \(\ce{^{51}Cr}\). The \(\ce{^{51}Cr}\) is taken up and reversibly binds to cytosolic proteins. When these target cells are incubated with sensitized lymphocytes, the target cells are killed and the \(\ce{^{51}Cr}\) is released.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CTL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cytotoxic T lymphocyte assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13074"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CTL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13075 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13075">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance with a specific toxic effect on certain cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Major cytotoxins made by cytotoxic T lymphocytes (CTL, Tc) and natural killer (NK) cells that participate in the destruction of target cells include perforins, granzymes, and granulolysins.</rdfs:comment>
        <rdfs:label>cytotoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13186"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13076 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13076">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface antigen characteristic of dendritic cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD205</oboInOwl:hasRelatedSynonym>
        <rdfs:label>DEC-205</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13077 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13077">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Injection of DNA into muscle, followed by its transcription and translation into a protein or proteins that elicit antibody and T-cell responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>DNA immunization</oboInOwl:hasRelatedSynonym>
        <rdfs:label>DNA vaccination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13771"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13078 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13078">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Major histocompatibility complex (MHC) class II molecules occurring on human B lymphocytes and antigen-presenting cells (APCs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>DP, DQ, and DR molecules</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13079 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13079">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that suggests it is not foreignness of a molecule per se but rather its ability to cause cell damage or stress that induces an immune response. Often implicated in causation of idiosyncratic drug reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>danger hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13251"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13080 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13080">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-surface receptor whose binding to extracellular ligands stimulates apoptosis in the receptor-bearing cell through the extrinsic pathway.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>death ligand receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>death receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13081 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13081">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein-interaction domain originally discovered in proteins involved in programmed cell death or apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>death domain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13082 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13082">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-surface molecule that protects cells from lysis by complement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD55</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DAF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The decay-accelerating factor binds to C3 convertases of both the alternative pathway and classical pathway of complement activation and, by displacing Bb and C2b respectively, prevents their action. Its absence causes the disease paroxysmal nocturnal hemoglobinuria.</rdfs:comment>
        <rdfs:label>decay-accelerating factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12866"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13047"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DAF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13083 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13083">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of oligopeptides made within the body, notably by neutrophils and macrophages, and having potent antimicrobial properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Defensins play important roles against invading microbes. They act against bacteria, fungi, and viruses by binding to their membranes and increasing membrane permeability.</rdfs:comment>
        <rdfs:comment>Human defensins are classified into the \(\ce{\upalpha\mbox{-}defensins}\) and \(\ce{\upbeta\mbox{-}defensins}\) on the basis of their sequence homology and their cysteine residues.</rdfs:comment>
        <rdfs:label>defensin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13084 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13084">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell reaction that releases antimicrobial cytotoxic molecules and other substances (e.g., histamine) from secretory vesicles called granules found inside some cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mast cell degranulation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Degranulation occurs in several different cells involved in the immune system, including granulocytes (neutrophils, basophils, and eosinophils), mast cells, and certain lymphocytes such as natural killer (NK) cells and cytotoxic T cells.</rdfs:comment>
        <rdfs:label>degranulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13085 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13085">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of T cell-mediated immunity in which the ultimate effector cell is the activated mononuclear phagocyte (macrophage); the response of DTH appears fully over \(\pu{24}\) to \(\pu{48 h}\). Previous exposure is required.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>DTH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gell and Coombs Type IV reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Examples include response to Mycobacterium tuberculosis (tuberculin test) and contact dermatitis.</rdfs:comment>
        <rdfs:label>delayed-type hypersensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13758"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DTH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13086 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13086">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In vivo assay of cell-mediated immune response, elicited by antigen in the skin and mediated by CD4+ Th1 cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>DTH assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>DTH reactions are often divided into two phases which should be assessed in the assay: the sensitization phase, referring to the initial immunization with specific antigen, and the efferent or challenge phase of the DTH response, which usually follows 6 to 14 days after sensitization.</rdfs:comment>
        <rdfs:label>delayed-type hypersensitivity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12994"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13087 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13087">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ameboid cell that is major histocompatibility complex (MHC) class II-positive, Fc receptor-negative, and presents processed antigens to T cells in the T-cell areas of secondary lymphoid tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>interdigitating dendritic cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>interdigitating reticular cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Dendritic cells are potent stimulators of T-cell responses. Nonlymphoid tissues also contain dendritic cells, but these are not able to stimulate T-cell responses until they are activated.</rdfs:comment>
        <rdfs:comment>Some authors also distinguish myeloid and lymphoid dendritic cells based on lineage.</rdfs:comment>
        <rdfs:comment>Some confusion in the classification of dendritic cells may arise from systems based on function, morphology, or lineage, and possibly species differences.</rdfs:comment>
        <rdfs:comment>There are three major subclasses of dendritic cells, conventional dendritic cells, Langerhans cells, and plasmacytoid dendritic cells.</rdfs:comment>
        <rdfs:comment>This is a different cell type from the follicular dendritic cell, which is Fc receptor-positive.</rdfs:comment>
        <rdfs:label>dendritic cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13045"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13373"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13577"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13663"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13088 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13088">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precipitation of immune complex in organs and tissues, often causing local inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Immune complex deposition is a prominent feature of systemic lupus erythematosus (SLE), cryoglobulinemia, rheumatoid arthritis (RA), scleroderma, and Sjögren syndrome.</rdfs:comment>
        <rdfs:label>immune complex deposition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13060"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13089 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13089">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the skin showing redness, swelling, infiltration, scaling, and sometimes vesicles and blisters: contact dermatitis is due to local exposure and may be caused by irritation, allergy, or photocontact dermatitis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>dermatitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13569"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13090 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13090">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease characterized by the presence of inflammation of the skin and muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Its cause is unknown, but it may be associated with a viral infection or some autoimmune reaction and may present also as paraneoplastic phenomena (see paraneoplastic autoimmune syndrome).</rdfs:comment>
        <rdfs:label>dermatomyositis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13535"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13091 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13091">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generally transient state of specific non-reactivity in a previously sensitized individual, resulting from repeated antigen exposures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>desensitization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13092 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13092">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease in which the \(\ce{\upbeta\ cells}\) of the pancreatic islets of Langerhans are destroyed with the result that no insulin is produced.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>diabetes mellitus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>insulin-dependent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>insulin-dependent diabetes mellitus (IDDM)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>type 1 diabetes mellitus</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The disease is believed to result from an autoimmune attack on the \(\ce{\upbeta\ cells}\). It is also known as insulin-dependent diabetes mellitus (IDDM), as the symptoms can be ameliorated by injections of insulin.</rdfs:comment>
        <rdfs:label>diabetes mellitus type 1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13093 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13093">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of blood cells, particularly leukocytes, from the blood across blood vessel walls into tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>diapedesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13094 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13094">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reported blood count that distinguishes the percentages of the different blood cells present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>differential</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13095 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13095">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Utilization and splicing of different exons from a primary RNA transcript in order to generate different mRNA sequences.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>differential splicing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13096 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13096">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface molecule expressed at a particular stage of development or on cells of a given lineage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>differentiation antigen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13097 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13097">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of the ADAM (A Disintegrin And Metalloproteinase domain) family of transmembrane proteins, possibly related to asthma susceptibility.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ADAM33</oboInOwl:hasRelatedSynonym>
        <rdfs:label>disintegrin and metalloproteinase domain-containing protein 33</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12905"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13097"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADAM33</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13098 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13098">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small segment of immunoglobulin (Ig) heavy-chain or T-cell receptor DNA between the variable (V) gene and joining (J) gene segments, coding for the third hypervariable region of the receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>D gene</oboInOwl:hasRelatedSynonym>
        <rdfs:label>diversity gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13099 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13099">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural element of a polypeptide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>domain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13100 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13100">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two-dimensional graphical representation of individual data points.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Often used to visualize the fluorescence and light scattering intensities acquired during flow cytometry.</rdfs:comment>
        <rdfs:label>dot plot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13101 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13101">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immature T cell in the thymus that lacks expression of the two coreceptors, CD4 and CD8.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>In a normal thymus, double-negative cells represent about 5 % of thymocytes.</rdfs:comment>
        <rdfs:label>double-negative cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13049"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13254"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13598"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13102 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13102">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immature T cell in the thymus that is characterized by expression of both CD4 and CD8 coreceptor proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>In a normal thymus, double-positive cells represent the majority (\(\pu{80\%}\)) of thymocytes.</rdfs:comment>
        <rdfs:label>double-positive cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13049"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13254"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13598"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13103 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13103">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymph node that is downstream of a site of infection and thus receives antigens and microbes from the site via the lymphatic system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Draining lymph nodes often enlarge enormously during an immune response and can be palpated; they were originally called swollen glands.</rdfs:comment>
        <rdfs:label>draining lymph node</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13395"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13104 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13104">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Context: ocular; Test for potential to cause irritation to the eye in which the test substance is applied directly to the eye of restrained rabbits. Note: Widely criticized as unethical. Now often replaced with an acute eye irritation test using cadaveric chicken eyes. Context: skin; Test for the potential of a material to cause irritation or corrosion following local dermal application. Generally performed with rabbits.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Draize test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13105 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13105">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune-mediated idiosyncratic drug reaction against self-antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>drug-induced autoimmunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13251"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13106 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13106">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Idiosyncratic drug reaction similar in character to systemic lupus erythematosus (SLE) and having antinuclear antibodies (ANA), but generally milder in nature and resolving when drug exposure is discontinued.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>lupus-like syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>drug-induced lupus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12898"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13251"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13107 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13107">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute or chronic skin inflammation with erythema, papules, vesicles, pustules, scales, crusts, or scabs, alone or in combination, of varied etiology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>eczema</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13108 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13108">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell that carries out an immune function, e.g., cytokine release, cytotoxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>effector cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13109 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13109">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production of a cell-mediated or antibody-mediated allergic response by exposure of a sensitized individual to an allergen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>elicitation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12994"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13110 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13110">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Produced within or caused by factors within an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>endogenous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13111 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13111">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracellular smooth surfaced vesicle in which endocytosed material passes on its way to the lysosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>endosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13112 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13112">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathogenic cell wall-associated lipopolysaccharides of Gram-negative bacteria.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>endotoxin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13113 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13113">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody that binds to an antibody-antigen complex or idiotypic-anti-idiotypic antibody complex and strengthens the interaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>enhancing antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12893"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13114 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13114">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxin affecting intestinal cells and thus causing food poisoning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Enterotoxins stimulate many types of T cells by binding to major histocompatibility complex (MHC) class II molecules and the Vb domain of certain T-cell receptors (TCRs). Enterotoxins have thus been referred to as superantigens.</rdfs:comment>
        <rdfs:label>enterotoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13699"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13115 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13115">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure for detection or quantitation of an antibody or antigen using a ligand (e.g., an anti-immunoglobulin) conjugated to an enzyme that changes the color of a substrate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ELISA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>With a fixed amount of immobilized antigen, the amount of labeled antibody bound decreases as the concentration of unlabeled antigen is increased, allowing quantification of unlabeled antigen (competitive ELISA).</rdfs:comment>
        <rdfs:comment>With a fixed amount of one immobilized antibody, the binding of a second, labeled antibody increases as the concentration of antigen increases, allowing quantification of antigen (sandwich ELISA).</rdfs:comment>
        <rdfs:label>enzyme-linked immunosorbent assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13116"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13115"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ELISA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13116 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13116">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adaptation of enzyme-linked immunosorbent assay (ELISA) in which cells are placed over antibodies or antigens attached to a plastic surface. The antigen or antibody traps the cells’ secreted products, which can then be detected using an enzyme-coupled antibody that cleaves a colorless substrate to make a localized colored spot. This allows quantitation of the number of cells producing a given product such as a cytokine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ELISPOT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ELISPOT assay</oboInOwl:hasRelatedSynonym>
        <rdfs:label>enzyme-linked immunospot assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13115"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13116"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ELISPOT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13117 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13117">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Circulating granular leukocyte (granulocyte) having prominent granules that stain specifically by eosin and containing numerous lysosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Eosinophils are also abundant at sites of immediate-type hypersensitivity reactions.</rdfs:comment>
        <rdfs:comment>Eosinophils are important effector cells in immune reactions to antigens that induce high levels of immunoglobulin E (IgE) antibodies (e.g., parasites).</rdfs:comment>
        <rdfs:label>eosinophil</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13255"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13118 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13118">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytokine that facilitates anaphylaxis and attracts eosinophils during substrate release by mast cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ECF-A</oboInOwl:hasRelatedSynonym>
        <rdfs:label>eosinophil chemotactic factor of anaphylaxis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13118"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ECF-A</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13119 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13119">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>CC chemokine that acts predominantly on eosinophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CCL11</oboInOwl:hasRelatedSynonym>
        <rdfs:label>eotaxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13120 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13120">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Treatment of denatured antigen with heat or other agents in order to regenerate (unmask) lost antibody-binding capacity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>antigen retrieval</oboInOwl:hasRelatedSynonym>
        <rdfs:label>epitope retrieval</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13121 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13121">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the number of epitopes targeted by autoantibodies and/or T cells. The epitopes may be on the same autoantigen (intramolecular epitope spreading) and/or on other autoantigens (intermolecular epitope spreading).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This is a characteristic sign of progression of autoimmune disease from initial activation to a chronic state.</rdfs:comment>
        <rdfs:label>epitope spreading</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Virus responsible for infectious mononucleosis and Burkitt’s lymphoma. This virus is used to immortalize human B lymphocytes in vitro.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>EBV</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Epstein–Barr virus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13122"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EBV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of antibody to antigen at which immunoprecipitation of the reactants is virtually complete.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>equivalence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13124">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Range of concentrations of antigen and antibody in which neither is in significant excess in a precipitin reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>equivalence zone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13597"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13125 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Redness of the skin produced by congestion of the capillaries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>erythema</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13126 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13126">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two potentially disabling or fatal blood disorders in infants: Rhesus (Rh) factor incompatibility disease and ABO blood group incompatibility disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The disorders are caused by incompatibility between a mother’s blood and her unborn baby’s blood, causing the mother’s immune system to launch an immune response against the baby’s erythrocytes.</rdfs:comment>
        <rdfs:label>erythroblastosis fetalis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13649"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13127 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Red blood cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>erythrocyte</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Erythrocyte production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>erythropoiesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glycoprotein hormone that stimulates the production of erythrocytes by stem cells in bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It is produced mainly by the kidneys and is released in response to decreased levels of oxygen in body tissue.</rdfs:comment>
        <rdfs:label>erythropoietin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13130 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13130">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a class of proteins insoluble in water but soluble in saline solutions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>euglobulin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13131 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13131">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release of the content of an intracellular vesicle to the exterior of the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The vesicles make their way to the plasma membrane, with which they fuse to permit the contents to be released to the external environment.</rdfs:comment>
        <rdfs:label>exocytosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13132 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13132">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pathogenic protein secreted by bacteria.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>exotoxin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13133 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13133">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of cells or fluid from within blood vessels to the surrounding tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>extravasation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13134 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13134">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extravascular fluid containing proteins and cellular debris that accumulates during inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>exudate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13135 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13135">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monovalent antigen-binding (‘ab’) fragment obtained following papain digestion of immunoglobulin (Ig). It consists of an intact light chain and the N-terminal VH and C H1 domains of the heavy chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Fab fragment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13136 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13136">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bivalent antigen-binding fragment obtained following pepsin digestion of immunoglobulin. Consists of both light chains and the N-terminal part of both heavy chains linked by disulfide bonds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Because it lacks the Fc fragment it does not bind the Fc-receptor, e.g., in flow cytometry.</rdfs:comment>
        <rdfs:label>F(ab&apos;)2 fragment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13137 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13137">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystallizable, non-antigen-binding fragment of an immunoglobulin (Ig) molecule obtained following papain digestion. Consists of the C-terminal portion of both heavy chains, responsible for binding to Fc receptors and complement factor C1q.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Fc region</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Fc fragment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13138 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13138">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptors expressed on a wide range of cells, interacting with the Fc portion of immunoglobulins (Ig) belonging to various isotypes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Membrane-bound Fc receptors mediate different effector functions [e.g., endocytosis, antibody-dependent-cellular cytotoxicity (ADCC)] and induce mediator release. Both the membrane-bound and soluble forms of Fc receptors regulate antibody production by B lymphocytes.</rdfs:comment>
        <rdfs:label>Fc receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12879"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13139 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13139">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heavy chain portion of an immunoglobulin (Ig) N-terminal to the papain hydrolysis site, after reduction and separation of the light chain portion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Fd fragment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13135"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13140 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13140">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formyl-methionyl-leucyl-phenylalanine, a chemoattractant (see chemotactic factor, chemotaxis) derived from degradation of bacterial or mitochondrial proteins. It causes neutrophil activation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>fMLP peptide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12999"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13000"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13511"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13141 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13141">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transcription repressor that is specifically expressed in CD4+CD25+ T cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Mutations in the FOXP3 gene may lead to an autoimmune syndrome called IPEX (immunodysregulation–polyendocrinopathy–enteropathy, X-linked).</rdfs:comment>
        <rdfs:label>Foxp3</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13283"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13142 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13142">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variable (V) region fragment of an antibody heavy chain or light chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Fv fragment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13143 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13143">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Episodic autoinflammatory disease, induced by exposure to cold, and caused by mutations in the gene CSA1, encoding cryopyrin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>FCAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>familial cold autoinflammatory syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12926"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13492"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13143"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FCAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13144 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13144">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progressive and potentially lethal inflammatory disease caused by an inherited deficiency of perforin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>FHL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Large numbers of polyclonal CD8+ T cells accumulate in lymphoid tissue and other organs, and this is associated with activated macrophages that phagocytose blood cells, including erythrocytes and leukocytes.</rdfs:comment>
        <rdfs:label>familial hemophagocytic lymphohistiocytosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12977"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13144"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FHL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13145 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13145">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypersensitivity disease caused by the interaction of immunoglobulin G (IgG) antibodies with large amounts of an inhaled allergen in the alveolar wall of the lung, causing alveolar wall inflammation and compromising gas exchange.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>farmer’s lung</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13146 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13146">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of the tumor necrosis factor (TNF) receptor gene family. Engagement of Fas on the surface of the cell by the Fas ligand (CD178) present on cytotoxic cells can trigger apoptosis in the Fas-bearing target cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD95</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Fas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13147 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13147">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human cancer cell antigens, which cross-react serologically with antigens normally expressed by embryonic tissue, e.g., carcinoembryonic antigen (CEA), or $\ce{\upalpha\!\mbox{-}fetoprotein}$ (AFP).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>fetal antigens</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10358"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12988"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13672"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13148 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13148">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lack of rejection of a fetal allograft carrying paternal major histocompatibility complex (MHC) and minor histocompatibility antigens that differ from those of the mother.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>fetal tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12863"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13460"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13149 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13149">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzymatic lysis of a fibrin clot.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>fibrinolysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13150 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13150">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to, characterized by, or causing the breakdown of fibrin (fibrinolysis), usually by the action of plasmin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>fibrinolytic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13149"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13151 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13151">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface tissues, notably the skin, respiratory tract, and gastrointestinal tract.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Internal organs may also have a first line of defense, e.g., the microglia have been considered as a first line of defense against brain infections.</rdfs:comment>
        <rdfs:comment>These tissues are rich in immunocompetent cells that form a first line of defense by recognizing pathogens, destroying them with secretory antibodies, or preventing their intrusion into the organism.</rdfs:comment>
        <rdfs:label>first line of defence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13277"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13152 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13152">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of sorting and measuring types of cells by fluorescent labeling of markers on the surface of the cells. It is sometimes referred to as fluorescence-assisted (or activated) cell sorting (FACS) analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>flow cytometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13153 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13153">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Green fluorescent dye used to &apos;tag&apos; antibodies for use in immunofluorescence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>FITC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fluorescein isothiocyanate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13285"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13153"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FITC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13154 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13154">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fluorescence-assisted cell sorting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>FACS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fluorescence-activated cell sorting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13152"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13154"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FACS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13155 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13155">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody conjugated to a fluorescent dye such as fluorescein isothiocyanate (FITC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>fluorescent antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13156 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13156">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Major histocompatibility complex (MHC) class II-negative Fc receptor-positive dendritic cell which bears immune complexes on its surface and is probably involved in the generation of antibody-secreting cells and maintenance of B-cell memory (see memory cell) in germinal centers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This is a different cell type from the dendritic cell.</rdfs:comment>
        <rdfs:label>follicular dendritic cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13172"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13452"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13157 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13157">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for allergic contact dermatitis in which the test substance is injected into the front footpad of a guinea pig and challenge is performed seven days later.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>footpad test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13158 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13158">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glycolipid heterophile antigen (globopentosylceramide) expressed on cell surfaces during embryonic and adult life in rodents and other mammals, and found in many pathogens, but probably not in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Anti-Forssman antibodies directed against the terminal sugar moiety are commonly found in plasma and may be involved in Guillain–Barré syndrome (GBS).</rdfs:comment>
        <rdfs:comment>Anti-Forssman antibodies reportedly disrupt tight junction formation, apical-basal polarization, and cell adhesion.</rdfs:comment>
        <rdfs:label>Forssman antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13210"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13159 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13159">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several relatively conserved amino acid sequences that flank the hypervariable regions in immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions and maintain a common overall structure for all V region domains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>framework region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13245"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13160 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13160">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete Freund’s adjuvant is an emulsion of aqueous antigen in mineral oil that contains heat-killed Mycobacteria.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Incomplete Freund’s adjuvant lacks the Mycobacteria.</rdfs:comment>
        <rdfs:comment>It can cause painful local inflammation and should be used with care.</rdfs:comment>
        <rdfs:label>Freund’s adjuvant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13161 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13161">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte whose T-cell receptor (TCR) is a heterodimer of a \(\ce{\upgamma\mbox{-}chain}\) and a \(\ce{\updelta\mbox{-}chain}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>γ:δ T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13162"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13162 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13162">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-cell receptor (TCR) composed of two different glycoprotein chains, designated \(\upgamma\) and \(\updelta\), assembled in a \(\ce{\upgamma\mbox{:}\updelta\ heterodimer}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Cells bearing these receptors are called γ:δ T cells. The group of γ:δ T cells is much less common than α:β T cells, and usually found in the gut mucosa, in a population of lymphocytes known as intra-epithelial lymphocytes (IELs).</rdfs:comment>
        <rdfs:label>γ:δ T-cell receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12826"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13342"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13163 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13163">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a group of cytokines, the interferons, which has as its primary action the activation of macrophages and can induce cells to resist viral replication.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IFN-γ</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>γ-interferon is a product of CD4+ Th1 cells, CD8+ T cells, and natural killer (NK) cells.</rdfs:comment>
        <rdfs:label>γ-interferon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12977"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IFN-γ</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13164 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13164">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Viral glycoprotein, non-covalently associated with gp41 in the viral envelope of human immunodeficiency virus (HIV).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The gp120 portion of the glycoprotein complex binds with high affinity to the cell-surface molecule CD4. Before fusion and entry of the virus, gp120 must bind to a coreceptor in the membrane of the host cell, for instance chemokine receptors (mainly CCR5).</rdfs:comment>
        <rdfs:label>gp120</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13049"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13228"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13165 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13165">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of a group of serum proteins, mostly immunoglobulins (Ig), which have the greatest mobility towards the cathode during electrophoresis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>gammaglobulin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13166 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13166">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune-mediated destruction of the gastric mucosa that may result in the development of pernicious anemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Autoimmune gastritis is associated with autoantibodies to \(\ce{H^{+}}/\ce{K^{+}}\)-ATPase of gastric parietal cells as well as autoantibodies to the intrinsic factor produced by these cells.</rdfs:comment>
        <rdfs:label>autoimmune gastritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13557"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13167 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13167">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Classification of immune mechanisms of tissue injury into four types: type I, immediate-type hypersensitivity reactions, mediated by interaction of immunoglobulin E (IgE) antibody and antigen causing the release of histamine and other mediators; type II, antibody-mediated hypersensitivity reactions, due to antibody–antigen interactions on cell surfaces; type III, immune complex, local or general inflammatory responses due to formation of circulating immune complexes and their deposition in tissues; and type IV cell-mediated hypersensitivity reactions, initiated by sensitized T lymphocytes either by release of lymphokines or by T-cell-mediated cytotoxicity [see cytotoxic T lymphocyte (CTL)].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Gell and Coombs classification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13255"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13168 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13168">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of disabling a specific gene by homologous recombination with an introduced DNA construct designed for that purpose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>gene targeting</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gene knockout</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13365"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13169 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13169">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural alteration in a chromosome that changes the order of its genetic loci, occurring by DNA recombination, e.g., during development or in some cancers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>In immunology, it refers to recombination of gene segments in immunoglobulin (Ig) and T-cell receptor (TCR) loci to produce a functional variable (V) region sequence.</rdfs:comment>
        <rdfs:label>gene rearrangement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13303"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13170 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13170">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Descriptor applied to animals (usually mice) raised in the complete absence of intestinal and other microorganisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>gnotobiotic</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Such mice have very depleted immune systems, but they can respond normally to any specific antigen, provided it is mixed with a strong adjuvant.</rdfs:comment>
        <rdfs:label>germ-free</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13171 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13171">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to genes in their unrearranged state rather than those rearranged for production of immunoglobulin (Ig) or T-cell receptor (TCR) molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>in immunology</oboInOwl:hasRelatedSynonym>
        <rdfs:label>germ line</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13172 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13172">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Discrete area within lymph nodes and spleen where B-cell maturation and memory development occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>germinal center</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13447"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13451"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13173 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13173">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large multinucleate cell derived from fused macrophages and often present in granulomas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>giant cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13174 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13174">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of kidney diseases involving inflammation of the renal glomeruli, often as a result of antibody–antigen complexes that localize in the kidney.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Acute nephritis is marked by blood in the urine.</rdfs:comment>
        <rdfs:label>glomerulonephritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13506"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13175 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13175">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of the renal glomeruli, which may show either thickening of the glomerular basement membrane due to the accretion of proteins or a minimal change disease, in which there is functional damage but little structural change by light microscopy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>glomerulopathy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>glomerulonephropathy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13176 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13176">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Main autoantigen in diabetes mellitus type 1 and stiff-person syndrome (a neurological autoimmune disease).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>GAD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>GAD is localized in pancreatic \(\ce{\upbeta\ cells}\) and γ-aminobutyric acid-responsive (GABAergic) neurons.</rdfs:comment>
        <rdfs:label>glutamic acid decarboxylase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13176"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GAD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13177 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13177">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Any of the prolamins found in cereal grains, especially the prolamins in wheat, rye, barley, and possibly oats, which cause digestive disorders, notably celiac disease. 2) In wheat, mixture of water-insoluble proteins, including gliadins, that give wheat dough its elastic texture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>gluten</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12992"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13178 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13178">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease of humans in which glomerulonephritis and pulmonary hemorrhage are produced by complement-mediated tissue damage caused by antibodies directed against the renal glomerular and alveolar basement membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Goodpasture disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Goodpasture syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13179 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13179">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Destruction of grafted tissue by host lymphocytes following an adaptive immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>graft rejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12843"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13180 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13180">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease that occurs following bone marrow transplantation between genetically non-identical people and in which mature T cells in the transplanted bone marrow attack and destroy the recipients tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>GVHD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>graft-versus-host disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12960"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13181"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13180"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GVHD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13181 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13181">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction occurring when T lymphocytes present in a graft recognize and attack host cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>GVH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GVH reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>graft-versus-host reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13181"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GVH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13182 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13182">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hematopoietic (see hematopoiesis) factor augmenting the production of neutrophils in the bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>G-CSF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>granulocyte colony-stimulating factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13182"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>G-CSF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13183 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13183">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytokine that stimulates production of granulocytes and monocytes from stem cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>GM-CSF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>granulocyte–macrophage colony-stimulating factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13183"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GM-CSF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13184 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13184">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decreased circulating granulocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>granulocytopenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12855"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13185 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13185">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass or nodule of granulation tissue, with actively growing fibroblasts and capillary buds, characterized by the presence of aggregates of modified macrophages resembling epithelial cells (epithelioid histiocytes), and lymphocytes, surrounded by a rim of giant multinucleate cells, either of the Langerhans or foreign body type.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Granuloma is due to a chronic inflammatory process associated with infectious disease, such as tuberculosis, syphilis, sarcoidosis, leprosy, lymphogranuloma, etc., or with invasion by a foreign body.</rdfs:comment>
        <rdfs:label>granuloma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13373"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13658"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13186 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13186">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a family of serine esterases present in the granules of cytotoxic T lymphocytes and natural killer (NK) cells. They induce apoptosis in the target cell that they enter through perforin channels inserted into the target cell membrane by the cytotoxic lymphocyte.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>granzyme</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13187 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13187">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hyperthyroidism associated with diffuse hyperplastic goitre resulting from production of a thyroid-stimulating hormone receptor (TSHR)-binding autoantibody.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Graves disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13742"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13188 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13188">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin sensitization test for allergic contact dermatitis in which shaved guinea pig skin is exposed to intradermal injections of a test agent together with complete Freund’s adjuvant, followed by an occlusive patch for boosting for \(\pu{48 h}\) beginning on day 7, and challenged on day 21.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>GPMT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>guinea pig maximization test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12961"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13160"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13682"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13188"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GPMT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13189 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13189">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphoid cells and tissues lining the mucosa that seem to serve as the first point of antigen contact via this route, including Peyer’s patches, the appendix, tonsils, adenoids, and mesenteric lymph nodes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>GALT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Large aggregates of GALT have distinct B-cell follicles and T-cell areas. Antigen-presenting accessory cells are also present.</rdfs:comment>
        <rdfs:label>gut-associated lymphoid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13559"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13189"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GALT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13190 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13190">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of mouse chromosome 17 coding the major histocompatibility complex (MHC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>H-2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13191 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13191">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mouse major histocompatibility complex (MHC) coded by H-2.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>H-2 complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13190"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13192 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13192">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>B-cell neoplasm, usually occurring during middle age, constituting about \(\pu{2\%}\) of all leukemias and responding well to chemotherapy. The neoplastic cells have fine, hairlike surfaces.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hairy cell leukemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13193 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13193">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of allelic variants present at a given genetic region.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>haplotype</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13194 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13194">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Able to act as a hapten.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>haptenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13195 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13195">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease where the body’s own antibodies attack the cells of the thyroid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>chronic lymphocytic thyroiditis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Hashimoto thyroiditis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13196 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13196">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Allergic condition affecting the mucous membranes of the upper respiratory tract and the eyes, characterized by nasal discharge, sneezing, and itchy, watery eyes; and usually caused by an abnormal sensitivity to airborne pollen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>pollenosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hay fever</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13653"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13197 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13197">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evolutionarily conserved proteins, found in many organisms, that are induced upon exposure of cells to various types of stress, including heat, oxidative or hypoxic stress, and deprivation of nutrients or essential ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>heat shock proteins</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13198 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13198">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Larger of the two types of polypeptide chain found in immunoglobulin (Ig) molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>H-chain</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Each heavy chain is linked by disulfide bonds to a light chain and to another, identical heavy chain. Each heavy chain consists of an Fc fragment and an Fd fragment. Heavy chains carry the antigenic determinants that differentiate the various immunoglobulin classes.</rdfs:comment>
        <rdfs:label>heavy chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13139"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13199 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13199">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a subclass of T lymphocytes that provides help (in the form of cytokines and/or cognate interactions) necessary for the expression of effector function by other cells in the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>T helper cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Th</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>helper T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>helper cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Helper T cells recognize antigen in association with major histocompatibility complex (MHC) class II gene products. Depending on their capacity to produce various cytokines, one can functionally differentiate Th1 [interleukin-2- (IL-2-) and IFN-γ-producing] and Th2 (interleukins IL-3-, IL-4-, and IL-6-producing) cells.</rdfs:comment>
        <rdfs:label>helper T lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13719"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Th</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13200 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13200">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any molecule that agglutinates erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hemagglutinin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13201 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13201">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Self-renewing stem cell that is capable of giving rise to all of the formed elements of the blood (i.e., leukocytes, erythrocytes, and platelets).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hematopoietic stem cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13202 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13202">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anemia resulting from the lysis of erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hemolytic anemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13203 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13203">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Most frequent antibody-mediated drug-induced thrombocytopenia, which occurs in \(\pu{1-}\pu{2\%}\) of patients treated with heparin intravenously for longer than four days.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HIT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This disease is mediated by antibodies to complexes formed between heparin and the endogenous platelet factor 4 (PF4).</rdfs:comment>
        <rdfs:label>heparin-induced thrombocytopenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13203"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HIT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13204 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13204">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clinical name for a genetic deficiency of the C1 inhibitor of the complement system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>In the absence of C1 inhibitor, spontaneous activation of the complement system can cause diffuse fluid leakage from blood vessels, the most serious consequence of which is epiglottal swelling leading to suffocation.</rdfs:comment>
        <rdfs:label>hereditary angioneurotic edema</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12970"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13205 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13205">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Identical or similar cross-reacting antigen shared by several species (e.g., Forssman antigen).Antibodies produced against one of these antigens will also react with the other antigens of the set even though these are derived from a different species; such antibodies are also called heterophile antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>heterogenetic antigen</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heteroantigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13158"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13209"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13206 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13206">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody derived from another individual of the same species or another species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>heterologous antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13207 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13207">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that reacts with an antibody other than the one whose formation it induced.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>heterologous antigen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13208 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13208">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Digestion of exogenous material taken up by a cell by phagocytosis or pinocytosis, following fusion of the phagocytic or pinocytic vacuole with a lysosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>heterophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13209 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13209">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody raised against an antigen from one species, which also reacts against antigens from other species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>heterophilic antibody</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Heterophile antibodies are usually of low affinity and are a common cause of problems with immunoassays.</rdfs:comment>
        <rdfs:comment>Heterophile antibodies commonly arise from viral infection.</rdfs:comment>
        <rdfs:comment>The existence of such antibodies explains observations of the presence of antibody against antigens from a variety of species without immunization.</rdfs:comment>
        <rdfs:label>heterophile antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13158"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13210 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13210">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that stimulates production in a vertebrate of antibodies capable of reacting with tissue components having related antigens in a wide range of other species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>heterophilic antigen</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heterophile antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13158"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13211 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13211">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Possessing different alleles at a given locus on the two homologous chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>heterozygous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13212 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13212">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specialized venule in lymphoid tissues that has walls permeable to migrating lymphocytes, allowing them to move from blood into the lymphoid tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HEV</oboInOwl:hasRelatedSynonym>
        <rdfs:label>high endothelial venule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13212"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HEV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13213 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13213">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to the treatment of acquired immune deficiency syndrome (AIDS) patients involving a combination of nucleoside analogs, which prevent reverse transcription, with drugs that inhibit responses to the virus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HAART</oboInOwl:hasRelatedSynonym>
        <rdfs:label>highly active antiretroviral therapy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12833"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HAART</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13214 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13214">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of universal sensors of nucleic acids, required for the induction of transmembrane and cytoplasmic receptor-mediated innate immune responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HMGB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HMGB Protein</oboInOwl:hasRelatedSynonym>
        <rdfs:label>high-mobility group box protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13335"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HMGB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13215 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13215">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amino acids between the Fab and Fc regions of immunoglobulin (Ig) that permit flexibility of the molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hinge region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13135"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13216 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13216">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Histamine intolerance, which may contribute to food intolerance as part of a pseudoallergic reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>histaminosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13340"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13621"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13217 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13217">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relationship between a tissue or organ donor and a recipient who have sufficient similarity in major histocompatibility complex (MHC) antigens to avoid rejection of a graft.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>histocompatibility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13218 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13218">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relationship between a tissue or organ donor and a recipient who have sufficient differences in major histocompatibility complex (MHC) antigens to cause rejection of a graft.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>histoincompatibility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13219 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13219">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vascular reaction pattern of the skin marked by the transient appearance of smooth, slightly elevated patches (wheals) that are either more red or more pale than the surrounding skin and are accompanied by severe itching.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>nettle rash</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>urticaria</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>They are usually, but not always, caused by an allergic reaction to food or to a drug, but can also be induced by physical stimuli such as cold or exercise.</rdfs:comment>
        <rdfs:label>hives</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13783"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13220 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13220">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune system tumor characterized by large cells called Reed–Sternberg cells that derive from mutated B-lineage cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Hodgkin lymphoma</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Hodgkin disease exists in at least two forms, Hodgkin lymphoma and nodular sclerosis.</rdfs:comment>
        <rdfs:label>Hodgkin disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13641"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13221 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13221">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of leukocytes to specific locations in the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>homing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13222 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13222">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface molecule that directs leukocytes to specific locations in the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>homing receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13223 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13223">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody that binds preferentially to cells from the same species rather than to cells from other species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>homocytotropic antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12928"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13206"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13209"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13224 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13224">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Possessing the same allele at a given locus on the two homologous chromosomes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>homozygous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13225 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13225">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term (Latin: dread of self-poisoning) to describe the body’s innate aversion to immunological self destruction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Introduced by Paul Ehrlich (1902).</rdfs:comment>
        <rdfs:label>horror autotoxicus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13226 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13226">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of an individual to resist invasion by opportunistic agents and production of disease associated with exposure to microorganisms, foreign tissue, and particulates, as well as certain types of neoplasia. Host defense may be either nonspecific (innate or natural immunity) or specific (adaptive or acquired immunity) in nature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Immunological defense may involve chemotaxis, phagocytosis, reaction with immunoglobulins (Ig) and/or with complement, and T-cell cytotoxicity.</rdfs:comment>
        <rdfs:label>host defense</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12843"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12993"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13000"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13335"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13227 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13227">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evaluation of host resistance in rodents to in vivo challenge with an infectious organism under normal conditions and after pharmacological and nutritional alterations of the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>host-resistance assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13228 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13228">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Causative agent of acquired immune deficiency syndrome (AIDS).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HIV</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>HIV is a retrovirus of the lentivirus family that selectively infects macrophages and CD4+ T cells, leading to their slow depletion, eventually resulting in immunodeficiency.</rdfs:comment>
        <rdfs:comment>There are two major strains of the virus, HIV-1 and HIV-2, of which HIV-1 causes most disease worldwide. HIV-2 is endemic to West Africa but is spreading.</rdfs:comment>
        <rdfs:label>human immunodeficiency virus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12833"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13228"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HIV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13229 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13229">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetically engineered monoclonal antibody of non-human origin in which all but the antigen-binding complementarity-determining region (CDR) sequences have been replaced with sequences derived from human antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This procedure is carried out to minimize the immunogenicity of therapeutic, monoclonal antibodies.</rdfs:comment>
        <rdfs:label>humanized antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12878"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13029"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13230 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13230">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen coded by genes of the human major histocompatibility complex (MHC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HLA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Human HLA-A, -B and -C (resembling mouse H-2K, D and L) are MHC class I molecules, whereas HLA-DP, -DQ and -DR (resembling mouse I-A and I-E) are MHC class II molecules.</rdfs:comment>
        <rdfs:comment>The genes for HLAs are situated on chromosome 6.</rdfs:comment>
        <rdfs:label>human leukocyte antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13230"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HLA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13231 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13231">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Discontinuous genetic variation in the major histocompatibility complex (MHC) that results in the occurrence of several different forms of MHC molecules among people.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HLA Polymorphism</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Specific HLA polymorphisms are associated with a number of diseases, e.g., HLA-B27 is associated with ankylosing spondylitis, psoriatic arthritis, rheumatoid arthritis (RA), etc., and some chemical sensitivities.</rdfs:comment>
        <rdfs:label>human leukocyte antigen polymorphism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13232 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13232">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecules that enable the body to recognize infected cells and tumor cells and destroy them with cytotoxic T lymphocytes (CTLs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HLA Type I</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>HLA type I molecules are made by all nucleated cells in the body, possess a deep groove (see peptide-binding groove) that can bind peptide epitopes, typically 8-11 amino acids long, from endogenous antigens; and present HLA type I/peptide complexes to CD8+ lymphocytes that have a complementary shaped T-cell receptor (TCR).</rdfs:comment>
        <rdfs:label>human leukocyte antigen type I</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12977"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13548"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13233 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13233">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecules that enable CD4+ lymphocytes to recognize epitopes of exogenous antigens and discriminate self from non-self.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HLA Type II</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>HLA type II molecules are made by antigen-presenting cells (APCs), such as dendritic cells, macrophages, and B lymphocytes, possess a deep groove (see peptide-binding groove) that can bind peptide epitopes, typically 10–30 amino acids long but with an optimum length of 12–16 amino acids, from exogenous antigens; and present HLA type II/peptide complexes to CD4+ lymphocytes that have a complementary shaped T-cell receptor (TCR).</rdfs:comment>
        <rdfs:label>human leukocyte antigen type II</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13548"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13234 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13234">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to extracellular fluid such as plasma and lymph.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The term humoral immunity is used to denote antibody-mediated immune responses such as phagocytosis and activation of the complement system.</rdfs:comment>
        <rdfs:label>humoral</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13236"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13235 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13235">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response in which specific antibodies induce the effector functions (such as phagocytosis and activation of the complement system).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>humoral immune response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13236 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13236">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific immune response that is mediated primarily by humoral factors circulating in solution in the blood plasma and lymph (i.e., antibodies and complement).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>humorally mediated immunity (HMI)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The induction of the humoral immune response generally requires the cooperation of cellular immune mechanisms.</rdfs:comment>
        <rdfs:label>humoral immunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13235"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13237 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13237">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase of gammaglobulins in the blood by paraproteinemia or increased production of immunoglobulins (Ig).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hypergammaglobulinemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13165"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13238 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13238">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare primary immunodeficiency syndrome characterized by recurrent severe staphylococcal skin abscesses (hence Job syndrome), lung infections, and markedly elevated serum immunoglobulin E (IgE) levels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Job syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hyperimmunoglobulin E syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13239 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13239">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Primary T cell defect due to mutations in the CD40 ligand (CD40L), characterized by recurrent (opportunistic) infections and very low levels of immunoglobulin G (IgG) and immunoglobulin A (IgA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HIGM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoimmune manifestations (e.g., cytopenia, arthritis, sclerosing cholangitis) are often seen.</rdfs:comment>
        <rdfs:label>hyperimmunoglobulin M syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12981"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13070"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13239"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HIGM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13240 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13240">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally increased response to a stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hyperreactivity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13241 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13241">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State in which an individual reacts with allergic effects following exposure to a certain substance (allergen) after having been exposed previously to the same substance. It is sometimes used loosely for any increased response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Four types of hypersensitivity are recognized. Most common chemically induced allergies are type I [immunoglobulin E- (IgE-) mediated] and type IV (cell-mediated) hypersensitivity.</rdfs:comment>
        <rdfs:label>hypersensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13167"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13242 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13242">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune-mediated inflammatory disease of the lung parenchyma caused by exposure to an inhaled chemical allergen or organic dust.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>HPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>extrinsic allergic alveolitis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hypersensitivity pneumonitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13242"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13243 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13243">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Development of excessive immune reactivity to an antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hypersensitization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13244 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13244">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse immunological effects in an individual occurring under conditions of exposure to an allergen that result in no effects in the great majority of the population, or an individual exhibiting exaggerated effects in comparison with the great majority of those showing some adverse effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hypersusceptibility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13245 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13245">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amino acid sequence within the immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions that shows the greatest variability and contributes most to the antigen or peptide-major histocompatibility complex (MHC) molecule binding site.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hypervariable region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13246 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13246">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunodeficiency state marked by abnormally low levels of all classes of immunoglobulins (Ig), associated with increased susceptibility to infectious diseases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It may be primary (inherited), or secondary (acquired), or it may occur physiologically in normal neonates.</rdfs:comment>
        <rdfs:label>hypogammaglobulinemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13247 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13247">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dermal application of a selected allergen to an allergic person in stepwise increasing dosage, with the aim of reducing the immune system’s tendency for the corresponding allergic reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>hyposensitization therapy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13248 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13248">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isoantigen encoded by the Ia region of the mouse major histocompatibility complex (H-2 complex).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>I region-associated antigen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>immune response-associated antigen</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Ia antigens are defined by serological methods and are found predominantly on B lymphocytes and macrophages.</rdfs:comment>
        <rdfs:comment>This term is also used as a generic term for any major histocompatibility complex (MHC) class II antigen.</rdfs:comment>
        <rdfs:label>Ia antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12861"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13191"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13268"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13672"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13249 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13249">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term that describes a &apos;primary&apos; symptom or disease in which no underlying cause or associated disorder can be found.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immune thrombocytopenic purpura</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In many cases, autoimmune processes are involved in the pathogenesis [e.g., idiopathic Addison disease, idiopathic thrombocytopenic purpura (ITP)].</rdfs:comment>
        <rdfs:label>idiopathic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12845"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13250 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13250">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thrombocytopenia of unknown cause, probably related to the production of anti-platelet antibodies, and leading to bruising (purpura).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ITP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>immune thrombocytopenic purpura</oboInOwl:hasRelatedSynonym>
        <rdfs:label>idiopathic thrombocytopenic purpura</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13625"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13250"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ITP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13251 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13251">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare and unpredictable adverse drug reaction occurring only in susceptible individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IDR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A dose–response relationship may not be apparent within the dose range used clinically.</rdfs:comment>
        <rdfs:label>idiosyncratic drug reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12851"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IDR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13252 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13252">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The combined antigenic determinants (idiotopes) expressed in the variable (V) region of immunoglobulins (Ig) of an individual that determine antibody specificity to a particular antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>idiotype</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12893"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13253 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13253">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regulatory network based on interactions of anti-idiotypic antibodies and idiotypes present on antibodies and T-cell receptors (TCRs), resulting in feedback inhibition of ongoing B cell or T cell responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>idiotypic network</oboInOwl:hasRelatedSynonym>
        <rdfs:label>idiotype network</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12893"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13252"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13254 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13254">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing cells that are not fully developed and unable to participate immediately in an immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Immature B cells and T cells migrate from their primary lymphoid sites (bone marrow and thymus) through the vascular and lymphatic systems to secondary lymphoid sites. These sites include the spleen, lymph nodes, tonsils, and Peyer’s patches in the intestine and appendix. The immature B cells and T cells mature only after they encounter an antigen.</rdfs:comment>
        <rdfs:label>immature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13395"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13604"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13663"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13255 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13255">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction provoked by re-exposure to an antigen (allergen) that causes plasma cells to secrete immunoglobulin E (IgE) which binds to Fc receptors on the surface of tissue mast cells and blood basophils, sensitizing them, so that later exposure to the same allergen cross-links the bound IgE, leading to degranulation and the secretion of pharmacologically active mediators such as histamine, leukotriene, and prostaglandin that act immediately on the surrounding tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immediate-type allergy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>type I hypersensitivity</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The principal effects of these products are vasodilation and smooth-muscle contraction. The reaction may be either local or systemic. Symptoms vary from mild irritation to sudden death from anaphylactic shock.</rdfs:comment>
        <rdfs:label>immediate-type hypersensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12871"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13084"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13256 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13256">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attachment of particulate antigen coated with C3b (see complement) to cells expressing C3b receptors, which results in enhanced phagocytosis of bacteria by macrophages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune adherence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13257 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13257">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Product of an antigen–antibody reaction, which may also contain components of the complement system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13258 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13258">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Illness resulting from deposition of antigen–antibody complexes in tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune complex disease</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13259 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13259">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regulatory mechanism of the preferential activation of one aspect (cellular or humoral) of the adaptive immune system at the expense of the other.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Although not a form of true tolerance, this regulatory mechanism may be involved in the induction and maintenance of self-tolerance.</rdfs:comment>
        <rdfs:label>immune deviation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12844"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13260 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13260">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Removal of pathogens or tumor cells by the immune system; the first step of immunoediting of tumors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune elimination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13284"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13261 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13261">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Therapeutic stimulation of the immune response, especially in tumor therapy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>enhancement (in immunology)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune enhancement</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13262 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13262">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State in carcinogenesis where there is an equilibrium between elimination of tumor cells by the immune system and growth of non-immunogenic tumor cells; the second step in immunoediting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune equilibrium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13284"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13263 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13263">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological feature of an infectious agent or of a tumor cell that prevents its elimination by the immune system. Such a feature can be acquired by a selection process. Immune escape is the third step in immunoediting of tumors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune escape</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13284"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13264 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13264">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Property of a pathogen that results in avoidance of attack by the immune system, e.g., because of reduced phagocytosis, lack of recognition by the innate immune system, or suppression of the immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immune evasion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13335"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13701"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13265 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13265">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Alteration of the immune response to alleviate harmful effects of the immune system or to promote its activity by changes in regulatory factors; often part of deliberate therapeutic intervention.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immunomodulation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune modulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13266 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13266">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capacity of the immune system to regulate itself so that an immune response does not become excessive and cause tissue damage, autoimmune reactions, or allergic reactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immunoregulation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune regulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13267 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13267">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that the immune response involves multiple redundancies that are capable of compensating for acute reductions in certain immune functions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Such a reserve might prevent a serious reduction in host resistance after temporary immunosuppression of selected parameters [e.g., natural killer (NK) cell function].</rdfs:comment>
        <rdfs:label>immune reserve hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13268 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13268">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein found in antigen-presenting cells (APCs) and B lymphocytes in mice.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Ia protein</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune response-associated protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13248"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13269 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13269">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genes, including those within the major histocompatibility complex (MHC), that together determine the overall level of immune response to a given antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ir genes</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune response genes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13270 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13270">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recognition, and in some cases elimination, of tumor cells by the immune system before they become clinically detectable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immunosurveillance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immune surveillance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13271 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13271">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Integrated network of organs, glands, and tissues that has evolved to protect the body from foreign substances, including bacteria, viruses, and other infection-causing parasites and pathogens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The immune system may produce hypersensitivity reactions that, in the extreme, can be fatal. If the immune system misidentifies normal body components as foreign, this leads to autoimmune disorders, such as systemic lupus erythematosus (SLE), in which the body destroys its own constituents.</rdfs:comment>
        <rdfs:label>immune system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13272 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13272">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inherited, acquired, or induced resistance to infection by a specific pathogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13273 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13273">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Activation of the immune system as a whole to react more rapidly to antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoactivation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13274 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13274">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that activates the immune system as a whole to react more rapidly to antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoactivator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13275 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13275">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for removal of antibody or antigen by allowing it to bind to a corresponding antigen or antibody immobilized in the solid phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoadsorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13276 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13276">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Supporting substrate [often a nitrocellulose, nylon, or poly(vinylidene fluoride) membrane] onto which proteins that have been separated by gel electrophoresis are transferred and then identified by the binding of specific antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoblot</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13277 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13277">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having the ability to exhibit an immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunocompetence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13278 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13278">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unable to mount a full or effective immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunocompromised</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13279 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13279">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody or antibody fragment to which a functional molecule, such as a drug, has been chemically linked.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>antibody conjugate</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunoconjugate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13280"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13280 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13280">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody or antibody fragment to which a cytokine has been chemically linked.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Such a construct may be used to direct a cytokine to its target cell.</rdfs:comment>
        <rdfs:label>immunocytokine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13281 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13281">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability to produce a normal repertoire of antibodies or immunologically sensitized T lymphocytes, especially in response to specific antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Acquired or secondary immunodeficiencies develop as a consequence of malnutrition, malignancies, immunosuppressive compounds, radiation or infection of immunocompetent T lymphocytes with human immunodeficiency virus (HIV).</rdfs:comment>
        <rdfs:comment>Congenital or primary immunodeficiencies are genetic or due to developmental disorders, such as congenital thymic aplasia (see also thymic atrophy).</rdfs:comment>
        <rdfs:comment>Defects in natural immunity may also result in immunodeficiency.</rdfs:comment>
        <rdfs:comment>Defects in one or more components of the immune system result in the inability to eliminate or neutralize antigens.</rdfs:comment>
        <rdfs:label>immunodeficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13228"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13277"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13320"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13734"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13735"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13282 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13282">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epitope in an antigen that is preferentially recognized by T cells, which then come to dominate the immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunodominant epitope</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13283 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13283">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>X-linked syndrome characterized by immunodysregulation, polyendocrinopathy (diabetes mellitus type 1, thyroiditis), hemolytic anemia, thrombocytopenia, dermatitis, and enteropathy, caused by mutations in the gene encoding Foxp3.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IPEX syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunodysregulation–polyendocrinopathy–enteropathy, X-linked</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13089"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13141"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13202"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13741"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13284 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13284">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of continuing immunosuppression of immunogenic tumor cells, which may finally result in the selection of non-immunogenic tumor cells. It consists of the steps immune elimination, immune equilibrium, and immune escape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoediting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13260"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13262"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13263"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13285 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13285">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique for detection of cell- or tissue-associated antigens by the use of a fluorescently tagged ligand, e.g., an anti-immunoglobulin (Ig) conjugated to fluorescein isothiocyanate (FITC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunofluorescence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13153"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13286 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13286">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of immunoglobulin (Ig) characterized by $\ce{\upalpha\!}$ heavy chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>IgA antibodies are secreted mainly by mucosal lymphoid tissues, and in the dimeric form are present in mucosal secretions. IgA in the monomeric form is present in blood.</rdfs:comment>
        <rdfs:label>immunoglobulin A</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13287 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13287">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of immunoglobulin (Ig) characterized by $\updelta\!$ heavy chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It appears as a surface immunoglobulin on mature naïve B cells (see naïve lymphocyte) but its function is unknown.</rdfs:comment>
        <rdfs:label>immunoglobulin D</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13496"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13287"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13288 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13288">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of immunoglobulin (Ig) characterized by $\upvarepsilon\!$ heavy chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is involved in the defense against parasite infections and in allergic reactions.</rdfs:comment>
        <rdfs:label>immunoglobulin E</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13289 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13289">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoglobulin (Ig) found in chickens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgY</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunoglobulin Y</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13289"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13290 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13290">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-affinity IgE-binding ${\rm{Fc\mbox{-}}}\upvarepsilon\!{\rm{\mbox{-}R}}$ type I receptors are expressed on mast cells and basophils and interact with IgE antibodies with high affinity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgE-binding FC receptors</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The cross-linking of these receptors results in release of mediators such as histamine.</rdfs:comment>
        <rdfs:comment>The low-affinity IgE binding Fc receptor (CD23) is expressed on B cells, and its soluble (truncated) form is generated by proteolytic cleavage and regulates IgE production by B cells.</rdfs:comment>
        <rdfs:comment>The receptors are composed of \(\upalpha\), \(\upbeta\), and \(\upgamma\) chains; the α chain contains the IgE binding site, while the \(\ce{\upgamma\ chain}\) is responsible for signal transduction.</rdfs:comment>
        <rdfs:label>immunoglobulin E-binding Fc receptors</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12979"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13291 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13291">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State in which an individual reacts with allergic effects caused fundamentally by the reaction of antigen-specific immunoglobulin E (IgE) following exposure to a certain substance (allergen) after having been exposed previously to the same substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgE-Mediated Hypersensitivity</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunoglobulin E-mediated hypersensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13292 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13292">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of immunoglobulin (Ig) characterized by \(\upgamma\) heavy chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgG</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is the most abundant class of immunoglobulin found in the plasma.</rdfs:comment>
        <rdfs:label>immunoglobulin G</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13293 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13293">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of immunoglobulin (Ig) characterized by \(\upmu\) heavy chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is the first immunoglobulin to appear on the surface of B cells and the first to be secreted.</rdfs:comment>
        <rdfs:comment>Unlike other immunoglobulins that exist in the monomeric (IgA, IgD, IgE, and IgG) or dimeric (IgA) state, IgM is found in the blood as a pentamer.</rdfs:comment>
        <rdfs:label>immunoglobulin M</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13287"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13294 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13294">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genes encoding proteins containing one or more immunoglobulin (Ig) domains (homology units) that are homologous to either Ig variable (V) region or constant (C) region domains. Cell surface and soluble molecules mediating recognition, adhesion, or binding functions in and outside the immune system, derived from the same precursor, belong to this family of molecules (e.g., immunoglobulin, T-cell receptor (TCR), major histocompatibility complex (MHC) class I and class II molecules, CD4, CD8, and $\ce{Fc\upgamma\!R}$).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoglobulin gene superfamily</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13039"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13099"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13295 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13295">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large family of proteins characterized by possession of &apos;immunoglobulin-type&apos; domains of approximately 110 amino acids folded into two \(\ce{\upbeta\mbox{-}pleated sheets}\). Members include immunoglobulins \(A\), \(E\), \(G\), \(M\) (IgA, IgE, IgG, and IgM), T-cell receptors (TCRs), and human leukocyte antigen (HLA) major histocompatibility complex (MHC) molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoglobulin superfamily</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13230"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13296 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13296">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detection of cell-associated molecules in the light microscope with antibodies labeled with enzymes that change a substrate into a colored precipitate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immunocytochemistry</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunohistochemistry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13297 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13297">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absence of a pathogenic autoimmune response in spite of the concomitant presence in the host of the autoantigen and T cells bearing the specific autoreactive T-cell receptor (TCR).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunological ignorance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13298 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13298">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability of the immune system to function in a normal fashion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunological incompetence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13299 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13299">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of various sites in the body where foreign tissue grafts do not induce an immune reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>privileged site</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Such sites include the eye, brain, testis, and unborn fetus. Although antigens do migrate from these privileged sites, they either induce immunological tolerance or a nondestructive response.</rdfs:comment>
        <rdfs:label>immunologically privileged site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13300 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13300">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of the immune system to respond faster and more effectively to subsequent exposures to an antigen following a primary immune response to the same antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immunological anamnesis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Typically, memory T cells appear five days following initial immunization, whereas memory B cells may take about a month to reach maximum levels. Populations of such cells may persist for the lifetime of the individual.</rdfs:comment>
        <rdfs:label>immunological memory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13451"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13452"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13601"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13301 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13301">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Contact point between the T cell and antigen-presenting cell (APC) that is generated by reorganization and clustering of cell surface molecules in lipid rafts. The synapse facilitates interactions between T-cell receptor (TCR) and major histocompatibility complex (MHC) molecules, and between adhesion molecules, thereby potentiating a TCR-mediated activation signal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunological synapse</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13390"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13302 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13302">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Persistent specific immunological unresponsiveness toward a substance that would normally be expected to elicit an immune response, resulting from previous non-sensitizing exposure to an antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>tolerance</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Tolerance to specific foreign antigens can be induced by the exposure to the foreign antigens during embryonic or neonatal life (depending upon species). In adults, tolerance (usually of shorter duration) can be induced by using particular routes of administration for the antigens or administration of agents that are particularly effective against cells proliferating in response to antigen. Mechanisms may include deletion of potentially reactive lymphocytes or their &quot;inactivation&quot; by immunological suppression.</rdfs:comment>
        <rdfs:label>immunological tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13701"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13303 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13303">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science that deals with the immune system including cell-mediated immunity (CMI) and humoral aspects of immunity and immune responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12995"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13234"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13304 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13304">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of separating specific cell types or macromolecules with the aid of cell-specific antibodies coupled to paramagnetic beads.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunomagnetic separation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13305 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13305">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Modification of the functioning of the immune system by the action of a substance that increases or reduces the ability to produce an immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunomodulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13306 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13306">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Study of diseases of the immune system. 2) The occurrence of such diseases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunopathology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13307 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13307">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease of the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13306"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13308 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13308">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Study of the immune system using drugs as diagnostic tools. 2) Use of pharmaceutical molecules to support and stimulate the immune system in patients with immunodeficiency, or to suppress or specifically influence the reactivity of the immune system in order to control a pathological immune reaction or disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunopharmacology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13309 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13309">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of a panel of antibodies to determine a subset of proteins expressed on the surface of a cell or heterogeneous group of cells, often for diagnostic purposes, e.g., identifying the presence of leukemia cells in a population of lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunophenotyping</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13310 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13310">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of cytoplasmic proteins in T cells that are targets of the immunosuppressant drugs cyclosporin A, tacrolimus (fujimycin), rapamycin, and related compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunophilin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13319"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13311 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13311">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enhancement of the capacity of the immune system to produce an effective response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunopotentiation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13312 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13312">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precipitate formed in an antigen–antibody reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunoprecipitate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13313 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13313">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consensus sequence for src-family tyrosine kinases, found in the cytoplasmic domains of several signaling molecules including the signal transduction units of lymphocyte antigen receptors and of Fc receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ITAM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunoreceptor tyrosine-based activation motif</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13766"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13313"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ITAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13314 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13314">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consensus sequence present in the cytoplasmic domains of certain cell surface molecules [e.g., Fc \(\upgamma\) RIIB, inhibitory natural killer (NK) cell receptors] and which mediates inhibitory signals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ITIM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>immunoreceptor tyrosine-based inhibitory motif</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13314"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ITIM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13315 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13315">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reactivity to antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunosensitivity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13316 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13316">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that makes the immune system more reactive to antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunosensitizer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13317 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13317">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunological adjuvant composed of saponin, cholesterol, phospholipid, and an immunogen, usually protein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ISCOM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The adjuvant was originally designed to form a vaccine delivery system that combined certain aspects of virus particles such as their size and orientation of surface proteins, with the powerful immunostimulatory activity of saponins.</rdfs:comment>
        <rdfs:label>immunostimulating complex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ISCOM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13318 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13318">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in immune function, e.g., by use of bacille Calmette–Guérin (BCG) vaccine or drugs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Immunostimulation may be beneficial (e.g., restoration of a depressed immune response) or detrimental (e.g., induction by drugs of allergy, hypersensitivity, or autoimmunity).</rdfs:comment>
        <rdfs:label>immunostimulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12940"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13319 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13319">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that depresses the function of the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunosuppressant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13320 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13320">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Causing depression of the normal function of the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunosuppressive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13321 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13321">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mechanisms by which the immune system is able to recognize and destroy malignant cells before the formation of an overt tumor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunosurveillance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13322 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13322">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Treatment or prevention of a disease using agents that can modify the immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Immunotherapy is largely an experimental approach, applied most widely in the treatment of leukemias, melanoma, and hypernephroma.</rdfs:comment>
        <rdfs:comment>Immunotherapy may involve active or passive immunization, immunopotentiation or immunosuppression, hyposensitization, bone marrow transplantation, or thymus implantation.</rdfs:comment>
        <rdfs:label>immunotherapy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12835"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12960"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13247"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13311"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13540"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13323 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13323">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Harmful to the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunotoxic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13324 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13324">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that is harmful to the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunotoxicant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13325 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13325">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Discipline applying cardinal principals of both immunology and toxicology to study the ability of certain substances to alter the immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunotoxicology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13303"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13326 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13326">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biochemical conjugate, or recombinant fusion protein, consisting of an immune targeting molecule such as an antibody or antibody fragment together with a cytotoxic molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>immunotoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13327 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13327">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vaccine formulated from the whole microorganism that has been rendered unable to reproduce or cause disease, often by mutation or heat denaturation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>inactivated vaccine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12911"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13328 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13328">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of visualizing an antigen in which an unlabeled antibody against the antigen is reacted with it first, and then is detected by staining with a second fluorescently tagged immunoglobulin G (IgG) directed against the first antibody.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>indirect immunofluorescence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13329 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13329">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme catalyzing the initial rate-limiting step of tryptophan degradation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IDO</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Tryptophan is required for T-cell proliferation. Local degradation of tryptophan thus modulates T-cell activity.</rdfs:comment>
        <rdfs:label>indolamine-2,3-dioxygenase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13756"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13329"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IDO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13330 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13330">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly specific receptor for the protein B7H/B7RP-1 that is expressed on the surface of B cells and macrophages, and also appears on the surface of T cells during the process of T-cell activation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ICOS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Stimulation of the B cell and subsequent antibody production takes place after the ICOS receptor attaches to its partner B7RP-1 molecule. Thus, the co-stimulatory molecules, ICOS and B7H/B7RP-1, provide specificity for the immune system activation process.</rdfs:comment>
        <rdfs:label>inducible co-stimulatory protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13330"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13331 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13331">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Continuing state of tolerance that can be transferred by T lymphocytes from a tolerant animal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Maintenance of transplantation tolerance involves the induction of antigen-specific CD4+ regulatory T cells (Treg).</rdfs:comment>
        <rdfs:label>infectious tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13332 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13332">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Infertility caused by sperm antibodies, autoimmune ovarian inflammation (oophoritis), or autoimmune orchitis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune infertility</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This disease may be part of a polyendocrinopathy.</rdfs:comment>
        <rdfs:label>autoimmune infertility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13333 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13333">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-molecular-weight complex that activates inflammatory caspases and the cytokines interleukin-1$\ce{\upbeta\!}$ ($\ce{IL\mbox{-}1\upbeta\!}$) and IL-18.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>There appear to be at least three types of inflammasomes. Those identified initially were the NALP1 inflammasome, the NALP3 (cryopyrin) inflammasome, and the interleukin-(IL-)1β converting enzyme (ICE) protease-activating factor (IPAF) inflammasome.</rdfs:comment>
        <rdfs:label>inflammasome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12990"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13492"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13334 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13334">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of chronic inflammatory conditions resulting in the inappropriate and persistent activation of the mucosal immune system of the bowel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IBD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoantibodies against proteins of neutrophil granulocytes, pancreatic acinus, intestinal goblet, and colonic epithelial cells are detectable.</rdfs:comment>
        <rdfs:comment>Crohn disease and ulcerative colitis are two variants of IBD with overlapping clinical manifestations and probable autoimmune origins. Crohn disease is immunologically characterized by antibody to Saccharomyces cerevisiae and Th1 cell-dominated responses.</rdfs:comment>
        <rdfs:comment>Idiopathic IBD is a set of chronic conditions probably driven by the presence of normal intestinal flora.</rdfs:comment>
        <rdfs:label>inflammatory bowel disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13053"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IBD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13335 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13335">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunity that is not intrinsically affected by prior contact with antigen, i.e., all aspects of immunity not directly mediated by lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>innate immunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13336 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13336">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of the immunoglobulin superfamily that interacts with integrins and is found on the surface of several cell types, including antigen-presenting cells (APCs) and T cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ICAM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intercellular adhesion molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13295"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13337 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13337">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process which favors survival of foreign-specific lymphocytes at the expense of self-specific lymphocytes and is a secondary mechanism involved in the induction and maintenance of self-tolerance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>interclonal competition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13338 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13338">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a group of immunoregulatory glycoproteins, also called lymphokines, monokines, or cytokines.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IL</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>General features are low molecular mass (about \(\pu{80 kDa}\)) and frequent glycosylation; regulation of immune cell function and inflammation by binding to specific cell surface receptors; transient and local production; action in paracrine, autocrine, or endocrine manner, with stimulatory or blocking effect on growth/differentiation; very potent, function at picomolar concentrations.</rdfs:comment>
        <rdfs:comment>Interleukins represent an extensive series of mediators with a wide range of overlapping functions. Other mediators in this series are c-kit ligand, interferons (IFNs), tumor necrosis factor (TNF), transforming growth factor β (TGF-β), and a family of low relative molecular mass mediators, called chemokines.</rdfs:comment>
        <rdfs:label>interleukin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12916"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13752"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13339 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13339">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epitope on an anti-idiotype that binds in a way that structurally and functionally mimics the antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>internal image</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13252"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13340 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13340">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extreme sensitivity or allergy to a drug, food, or other substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>intolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13341 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13341">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diagnostic test for a possible cause of hypersensitivity in an individual in which a small drop of antigen is placed on a scarified skin surface or injected intradermally.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Production of an immune response in the treated skin represents a positive result.</rdfs:comment>
        <rdfs:label>intradermal test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13342 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13342">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte found in the epithelial layer of mammalian mucosal linings, such as those of the gastrointestinal and reproductive tracts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IEL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intra-epithelial lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13342"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13343 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13343">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein (\(\pu{31 kDa}\)) of the endoplasmic reticulum lumen that binds to newly formed major histocompatibility complex (MHC) heterodimeric proteins, preventing binding of endogenous peptides to their groove.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD74</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This protein acts as a chaperone for these molecules until they leave the Golgi apparatus and enter the endosome pathway. It is degraded proteolytically but leaves a fragment (called CLIP) bound within the groove of the major histocompatibility complex (MHC) class III molecules. In acid vesicles, after leaving the Golgi apparatus, CLIP exchanges with peptides derived from exogenous antigens.</rdfs:comment>
        <rdfs:label>invariant chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13111"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13433"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13344 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13344">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoantibodies reacting with endocrine (pancreatic islet) cells and detectable by indirect immunofluorescence on pancreatic cryostat sections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ICA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Islet cell antibodies are diagnostic markers of diabetes mellitus type 1.</rdfs:comment>
        <rdfs:label>islet cell antibodies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13328"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13344"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13345 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13345">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue transplanted (see graft) between two genetically identical individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>syngraft</oboInOwl:hasRelatedSynonym>
        <rdfs:label>isograft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13346 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13346">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring immunoglobulin M (IgM) antibody specific for the erythrocyte antigens of the ABO blood groups, thought to result from immunization by bacteria in the gastrointestinal and respiratory tracts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>isohemagglutinin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13347 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13347">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of antibody that differs from others in the constant region of the heavy chain (Fc portion).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>isotype</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13039"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13348 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13348">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody exhibiting the non-specific characteristics of the antibody-isotype but lacking any specificity for the antigen in question; used as a negative control in antibody-antigen detection assays, notably in flow cytometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>isotype control</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13152"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13349 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13349">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which a B cell switches from making antibody of one isotype to another without altering the specificity of the antibody, producing an isotype with the same variable (V) regions but a different heavy chain constant (C) region.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>isotype switch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13039"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13350 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13350">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mechanism that transmits information from chemical signals outside the cell to gene promoters on the DNA in the cell nucleus. The mechanism is activated by the binding of Janus-family tyrosine kinase (JAK) to the nonpolypeptide portion of occupied receptors for some interleukins (IL). JAK phosphorylates signal transducer and activator of transcription (STAT) proteins apart from STAT 5a and 5b.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>JAK2 is activated after it binds occupied receptors for somatotropin, several cytokines, and leptin. It then phosphorylates STAT proteins, which dimerize and enter the nucleus to activate transcription of specific genes.</rdfs:comment>
        <rdfs:label>JAK/STAT signaling pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13352"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13351 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13351">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method which uses labeled nucleotide precursors to estimate DNA fragmentation during cell-mediated cytotoxicity or apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>JAM test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12993"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13352 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13352">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tyrosine kinase activated by cytokines binding to cell receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>JAK</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Janus-family tyrosine kinase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13350"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13766"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13352"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>JAK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13353 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13353">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polypeptide that forms part of the polymeric structure of pentameric immunoglobulin M (IgM) and dimeric immunoglobulin A (IgA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>J chain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>joining chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13354 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13354">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene coding for a joining segment that connects variable (V) regions and constant (C) regions of immunoglobulin (Ig) or T-cell receptor (TCR) chains that, upon gene rearrangement, encodes part of the third hypervariable region of the antigen receptors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>J gene</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In Ig light chains and TCR, a variable (V) gene segment rearranges to a joining (J) gene segment; in Ig heavy chains and TCR, a diversity (D) gene segment rearranges to a joining (J) gene segment.</rdfs:comment>
        <rdfs:label>joining gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13039"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13245"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13355 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13355">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diversity of the splice junctions in the recombined variable (V) gene, diversity (D) gene [for immunoglobulin (Ig) heavy chains, and for TCR b and d chains], and joining (J) gene segments of antibody and T-cell receptor (TCR) genes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>junctional diversity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13356 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13356">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of enzymes found in the blood and body fluids that acts on certain plasma globulins to produce bradykinins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>kallikrein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12962"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13357 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13357">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of skin cancer that can involve internal organs. It is most often found in patients with acquired immunodeficiency syndrome (AIDS) and can be fatal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>KS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Kaposi sarcoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12833"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13358 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13358">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Smaller of the two types of light chain found in human immunoglobulins (Ig), the other type being a lambda ($\uplambda\!$)-light chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>κ-light chain</oboInOwl:hasRelatedSynonym>
        <rdfs:label>kappa-light chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12947"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13372"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13359 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13359">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epidermal cell that produces keratin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>keratinocyte</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13360 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13360">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor found on natural killer (NK) cells, and some $\ce{\upgamma\!{:}\updelta\!}$ and $\ce{\upalpha\!{:}\upbeta\! T cells}$.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>KAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>killer cell immunoglobulin-like receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>KARs recognize major histocompatibility complex (MHC) class I molecules and, like the C-type lectin receptors also found in these cells, can either inhibit or activate the killer cells. If immunoreceptor tyrosine-based inhibitory motif (ITIM) sequences are present in their cytoplasmic domain they are inhibitory.</rdfs:comment>
        <rdfs:comment>Killer cell immunoglobulin-like receptors (KIRs) lacking ITIMs can associate with immunoreceptor tyrosine-based activation motif (ITAM)-containing adaptor molecules in which case they can activate the killer cell.</rdfs:comment>
        <rdfs:label>killer activatory receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12826"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13313"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13314"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13362"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13360"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KAR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13361 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13361">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell that displays cell-mediated cytotoxicity, including cytotoxic T lymphocytes (CTL, Tc), natural killer (NK) cells, and natural killer T (NKT) cells. Some also consider activated macrophages, monocytes, and interferon (IFN)-activated neutrophils to be killer cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>K cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>killer cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12993"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13501"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13362 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13362">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor expressed on natural killer (NK) cells that binds to major histocompatibility complex (MHC) class I molecules on target cells; binding MHC class I inhibits the signaling that would otherwise lead to target cell killing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>KIR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>killer inhibitory receptor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>If immunoreceptor tyrosine-based inhibitory motif (ITIM) sequences are present in the KIR cytoplasmic domain, MHC class I molecule binding is inhibitory to the killer cell. KIRs lacking ITIMs can associate with immunoreceptor tyrosine-based activation motif (ITAM)-containing adaptor molecules, in which case binding of MHC class I molecules can activate the killer cell.</rdfs:comment>
        <rdfs:label>killer cell immunoglobulin-like receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13313"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13314"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13362"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KIR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13363 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13363">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Killer cell receptor that binds to major histocompatibility complex (MHC) class I molecules and, like the C-type lectin receptors also found on these cells, can either inhibit or activate the killer cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>KLR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>killer lectin-like receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12983"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13363"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KLR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13364 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13364">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a family of polypeptides that is released during inflammatory responses and that increases vascular permeability and smooth muscle contraction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>kinin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13365 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13365">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of homologous genetic recombination in embryonic stem cells to replace a functional gene with a defective copy of the gene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The animals that are produced by this technique can be bred to homozygosity, thus allowing the generation of a null phenotype for that gene product.</rdfs:comment>
        <rdfs:label>knockout</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13366 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13366">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mouse produced from embryonic cells containing DNA that has been genetically engineered so that it does not express a particular gene or group of genes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>knockout mouse</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13367 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13367">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fixed tissue macrophage found lining the blood sinuses in the liver.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Kupffer cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13425"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13368 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13368">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for sarcoidosis, eliciting a granuloma at the site of intrradermal injection of a lymph node extract from a person with active disease. Generally considered non-specific.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Kveim reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13658"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13369 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13369">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of leukocyte surface adhesion molecules; they are classed as CD62 in the cluster of differentiation (CD) antigen marker system. All have lectin family carbohydrate binding domains and epidermal growth factor (EGF) repeats.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>L-selectins are expressed on the surface of platelets and endothelial cells as well as leukocytes.</rdfs:comment>
        <rdfs:label>L-selectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13370 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13370">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Family of multi-gene-encoded, small, generally glycosylphosphatidyl inositol-anchored membrane proteins thought to be involved in cell adhesion and signaling, and in antigen-independent activation of lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Ly-6</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13614"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13371 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13371">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paraneoplastic neurological disorder associated with small-cell lung cancer and caused by autoantibodies against voltage-gated calcium channels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LEMS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Lambert–Eaton myasthenic syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13535"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13371"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LEMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13372 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13372">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the two types of light chain of human immunoglobulins (Ig), the other type being the kappa ($\kappa$)-light chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lambda (λ)-light chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13358"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13373 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13373">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immature, phagocytic dendritic cell of the mammalian skin, characterized by the presence of Fc receptors, major histocompatibility (MHC) class II molecules, and epidermal dendritic cell marker CD1. It contains a cytoplasmic organelle called the Birbeck granule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Langerhans cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12971"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13374 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13374">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte of greater than normal size that contains cytoplasmic granules and functions as a natural killer (NK) cell or killer (K) cell. Activated CD8+ cytotoxic T lymphocytes (CTL, Tc) also assume an LGL morphology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LGL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>large granular lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13374"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LGL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13375 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13375">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoglobulin E (IgE)-mediated immune response occurring \(\pu{5}\) to \(\pu{8 h}\) after exposure to antigen, after the &apos;wheal and flare&apos; reaction of immediate hypersensitivity has diminished, with inflammation peaking around \(\pu{24 h}\), and then subsiding.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>late phase reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13291"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13783"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13376 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13376">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of latex beads coated with antibodies to detect antigen in biological samples.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>latex fixation test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>latex agglutination test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13377 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13377">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Allergen found in natural rubber latex (NRL).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Major NRL-specific allergens are Hev b 1, Hev b 3, Hev b 5, and Hev b 6.02. These four major allergens account for the allergenic potential of NRL products like gloves, condoms, teats, balloons, etc.</rdfs:comment>
        <rdfs:label>latex allergen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13378 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13378">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progressive, malignant disease of the blood-forming organs, characterized by excessive proliferation and development of leucocytes and their precursors in the bone marrow and blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>leukemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13379 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13379">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>White blood cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>There are different types of leukocytes including neutrophils, basophils, eosinophils, lymphocytes, and monocytes.</rdfs:comment>
        <rdfs:label>leukocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13380 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13380">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen common to both T lymphocytes and B lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD45</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LCA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>leukocyte common antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13380"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13381 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13381">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a group of cell-surface antigens involved in intercellular adhesion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LFA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>leukocyte functional antigen</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13381"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LFA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13382 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13382">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of leukocytes below normal values that is a characteristic feature of systemic autoimmune diseases [e.g., Felty syndrome, systemic lupus erythematosus (SLE), Sjögren syndrome, mixed connective tissue disease (MCTD)].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>leukopenia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>leukocytopenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13383 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13383">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal increase in the number of leukocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>leukocytosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13384 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13384">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metabolic product of arachidonic acid that promotes inflammatory processes (e.g., chemotaxis, increased vascular permeability) and is produced by a variety of cell types including mast cells, basophils, and macrophages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>leukotriene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13000"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13385 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13385">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein involved, after binding to inducible co-stimulatory protein (ICOS), in several harmful immune responses, such as autoimmunity, allergy, or graft-versus-host (GVH) reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Prolonged ICOS and ICOSL expression at chronic inflammatory sites seems to give rise to pathology.</rdfs:comment>
        <rdfs:label>ligand of inducible co-stimulatory protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13181"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13330"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13386 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13386">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small polypeptide subunit of an antibody or immunoglobulin (Ig).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>A typical antibody is composed of two immunoglobulin (Ig) heavy chains and two Ig light chains.</rdfs:comment>
        <rdfs:label>light chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13387 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13387">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of detecting bacterial endotoxins based on gelation of a blood cell lysate from the horseshoe crab, Limulus polyphemus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Limulus test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13112"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13388 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13388">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigenic determinant that is contiguous in the amino acid sequence of a protein and therefore does not require the protein to be folded into its native conformation for antibody to bind.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>continuous epitope</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The epitopes detected by T cells are continuous.</rdfs:comment>
        <rdfs:label>linear epitope</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13389 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13389">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Requirement for a helper T lymphocyte (Th) and B lymphocyte to interact with separate but physically linked epitopes in the same antigen, in order for an immune response to a thymus-dependent (TD) antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>linked recognition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13738"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13390 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13390">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cholesterol- and glycosphingolipid-rich membrane subdomain in which molecules involved in cellular activation become concentrated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lipid raft</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12991"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13391 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13391">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vaccine prepared from living attenuated organisms or from viruses that have been attenuated but can still replicate in the cells of the host organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The live attenuated vaccine contains a version of living bacteria or viruses that have been weakened (attenuated) so they can no longer cause disease. Since they are very close to the actual infection, they can cause strong cell and antibody responses.</rdfs:comment>
        <rdfs:label>live attenuated vaccine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12911"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13392 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13392">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoantibodies directed against cytochrome P450 and uridine diphosphate (UDP)-glucuronosyltransferase (UGT) antigens typically found in patients with immune-mediated hepatitis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LKM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LKM antibodies</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These include LKM-1 antibodies (cytochrome P4502D6) in patients with autoimmune hepatitis type 2 (AIH-2) and autoimmunity associated with hepatitis C; LKM-2 (cytochrome P4502C9) in patients with drug-induced hepatitis caused by tienilic acid; and LKM-3 (UGT-1) in patients with chronic hepatitis D and AIH-2.</rdfs:comment>
        <rdfs:label>liver-kidney microsomal antibodies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13392"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LKM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13393 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13393">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enlarged lymph nodes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphadenopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13394 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13394">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Morphological or functional unit of lymphatic vessels consisting of the region between adjacent lymphatic valves.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphangion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13395 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13395">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing vessels whose special function is the collection of lymph and its ultimate conveyance to the blood circulation and thoracic duct.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>lymphatic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphatic system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13396 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13396">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue involved in the collection, production, and handling of lymph, including the lymphatic vessels and lymph nodes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphatic tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13397 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13397">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the small rounded gland-like structures of the lymphatic system, which occur along the lymphatic vessels and which are responsible for removing bacteria, viruses, and foreign molecules from the lymph stream and for producing lymphocytes and antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>lymph gland</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymph node</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13395"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13398 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13398">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormal cell with a large nucleus and scanty cytoplasm, thought to be the precursor of the lymphocyte, found in blood and blood-forming organs in patients with lymphoblastic leukemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphoblast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13378"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13399 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13399">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small leucocyte found in the blood, lymph, and lymphoid tissues that has a single round nucleus and little or no granulation in the cytoplasm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Lymphocytes constitute about a quarter of the total leucocytes in the blood stream but occur in large numbers in the lymph nodes and other lymphatic tissue.</rdfs:comment>
        <rdfs:comment>Lymphocytes may be either B cells, which produce humoral immunity, or T cells, which produce cell-mediated immunity (CMI).</rdfs:comment>
        <rdfs:label>lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12995"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13236"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13396"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13400 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13400">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interleukin-1 (IL-1)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphocyte-activating factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13401 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13401">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sum of the biochemical processes necessary to stimulate a resting lymphocyte to become an immune effector cell, requiring antigen and co-stimulatory molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>activation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphocyte activation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13402 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13402">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adhesion molecule found on lymphocytes, macrophages, and neutrophils, involved in adhesion of lymphocytes to antigen-presenting cells (APCs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LFA-1</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphocyte function-associated antigen-1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13402"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LFA-1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13403 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13403">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process that directs lymphocyte subsets to specialized microenvironments that control their differentiation, regulate their survival, and target immune effector cells to sites of antigenic or microbial invasion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphocyte homing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13222"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13404 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13404">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface glycoprotein on lymphocytes and other leukocytes that mediates adhesion to specialized blood vessels, the high endothelial venules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Several different classes of lymphocyte homing receptors have been identified, and they appear to bind to different surface molecules (addressins) on high endothelial venules in different tissues.</rdfs:comment>
        <rdfs:label>lymphocyte homing receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12846"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13212"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13405 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13405">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test of immune sensitization in which white blood cells are exposed in vitro to an antigen and multiply if already sensitized to that antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LPT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphocyte proliferation test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13408"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13405"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LPT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13406 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13406">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Profile of immunoglobulins (Ig) or T-cell receptors (TCRs) available within a specified group of cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>T-Cell Receptor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>immunoglobulin lymphocyte repertoire</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Each profile is characterized by the antigen specificities of the immunoglobulins or TCRs present.</rdfs:comment>
        <rdfs:label>immunoglobulin or T-cell receptor lymphocyte repertoire</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13407 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13407">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Population forming part of the whole population of lymphocytes, usually characterized by sensitivity to a given antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphocyte subpopulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13408 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13408">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for increased DNA synthesis followed by cell division and differentiation of lymphocytes in response to antigens or mitogens; an in vitro test of lymphocyte function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LTT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>blastogenesis assay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lymphocyte blastogenesis assay (LBA)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphocyte transformation test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13408"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LTT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13409 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13409">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deficiency of lymphocytes in the blood compared with normal values.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>lymphopenia</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This is a characteristic feature of systemic autoimmune diseases [e.g., systemic lupus erythematosus (SLE), Sjögren syndrome, mixed connective tissue disease (MCTD)].</rdfs:comment>
        <rdfs:label>lymphocytopenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13410 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13410">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition characterized by an abnormal increase in the number of lymphocytes in blood, usually a result of infection or inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphocytosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13411 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13411">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capability of lysing lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Lymphocytes having a specific cell surface antigen are lysed when incubated with antiserum and complement or when attacked by primed histoincompatible T lymphocytes.</rdfs:comment>
        <rdfs:label>lymphocytotoxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13218"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13412 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13412">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of clustered B cells, allowing the selection of antigen-binding B cells by dendritic cells during adaptive immune responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphoid follicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12843"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13413 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13413">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stem cell giving rise to the lineage of lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphoid stem cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13414 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13414">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vertebrate tissue that is made up predominantly of lymphocytes, e.g., lymph, lymph nodes, spleen, thymus, Peyer’s patches, adenoids, pharyngeal tonsils, and, in birds, bursa of Fabricius and cecal tonsils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphoid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12967"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13415 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13415">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytokine produced by lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphokine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13416 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13416">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Killer (K) cell or natural killer (NK) cell activated in vitro by interleukin (IL)-2 to give enhanced killing of target cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LAK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LAK cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lymphocyte-activated killer cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphokine-activated killer cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13416"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LAK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13417 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13417">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Neoplasm, usually malignant, of the lymphatic tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13396"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13418 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13418">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production of lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphopoiesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13419 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13419">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proliferation of lymphocytes in response to stimulation with cellular activators, including antigens or mitogens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lymphoproliferation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13420 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13420">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sum of B cells + T cells + natural killer (NK) cells determined separately (by flow cytometry), compared to the total number of lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Used as a check on accuracy in counting the proportion of cell types, e.g., a value of \(\pu{(100 \pm 10)\%}\) being acceptable and reflecting the uncertainty of the method.</rdfs:comment>
        <rdfs:label>lymphosum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13152"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13421 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13421">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-cell-derived cytokine that is cytotoxic for certain tumor cells and also has immunoregulatory functions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tumor necrosis factor β (TNF-β).</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphotoxin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13421"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13422 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13422">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytoplasmic granule containing hydrolytic enzymes involved in the digestion of phagocytosed material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>lysosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13423 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13423">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequestration and breakdown of organelles and long-lived proteins in a double-membrane vesicle, called an autophagosome or autophagic vacuole, inside the cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>non-specific autophagy</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Macroautophagy is the major inducible pathway for the general turnover of cytoplasmic constituents in eukaryotic cells. It is also responsible for the degradation of active cytoplasmic enzymes and organelles during nutrient starvation.</rdfs:comment>
        <rdfs:comment>The outer membrane of the autophagosome fuses in the cytoplasm with a lysosome to form an autolysosome or autophagolysosome where their contents are degraded by acidic lysosomal hydrolases.</rdfs:comment>
        <rdfs:label>macroautophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12929"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13563"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13424 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13424">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large (\(\pu{10\!{-}\! 20 \upmu m}\) diameter) ameboid and phagocytic cell found in many tissues, especially in areas of inflammation, derived from blood monocytes and playing an important role in host defense mechanisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Two main functions are recognized: phagocytosis and antigen presentation.</rdfs:comment>
        <rdfs:label>macrophage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13226"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13425 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13425">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macrophage stationed at a point where microbial invasion or accumulation of dust is likely to occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fixed macrophage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>resident macrophage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>residential macrophage</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Each type of macrophage, determined by its location, has a specific name:</rdfs:comment>
        <rdfs:label>residential macrophage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IAL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13426 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13426">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any assay suitable to characterize the effect of substances on macrophage function in in vivo or in vitro.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Common macrophage function tests are the chromium release assay and the chromate uptake assay.</rdfs:comment>
        <rdfs:label>macrophage function test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13427 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13427">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor involved in pathogen recognition, in clearance of endogenous serum glycoproteins, and in antigen presentation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MMR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Clusters of lectin domains bind mannose residues on microbial and fungal surfaces in a \(\ce{Ca^{2+}}\)-dependent manner.</rdfs:comment>
        <rdfs:comment>The receptor activates the C3 component of complement.</rdfs:comment>
        <rdfs:label>macrophage mannose receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13427"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MMR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13428 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13428">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>&apos;High-volume&apos; pinocytosis by which dendritic cells engulf relatively large volumes of fluid from their surroundings, enabling them to take in many antigens nonspecifically.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>macropinocytosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13429 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13429">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small basic arginine-rich peptide (\(\pu{pI 10.9}\), molecular mass of \(\pu{13.8 kDa}\)) in the granules of eosinophils that kills helminths and protozoa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>major basic protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13430 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13430">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cluster of genes encoding cell surface molecules involved in antigen presentation to T cells. In humans, they are found on chromosome 6 and in mice on chromosome 17. They are polymorphic and code for antigens that lead to rapid graft rejection between members of a single species that differ at these loci.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MHC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Several classes of protein such as MHC class I and II molecules are gene products encoded in this region. The MHC-encoded molecules are also known as human leukocyte antigens (HLA).</rdfs:comment>
        <rdfs:label>major histocompatibility complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13179"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13190"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13191"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13230"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MHC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13431 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13431">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface protein encoded by the major histocompatibility complex (MHC) expressed on all nucleated cells, presenting antigen-derived peptides.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MHC class I molecule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>class I MHC gene product</oboInOwl:hasRelatedSynonym>
        <rdfs:label>major histocompatibility complex class I molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13432 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13432">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface protein encoded by the major histocompatibility complex (MHC) expressed on antigen-presenting cells (APCs), presenting antigen-derived peptides.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MHC class II molecule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>class II MHC gene product</oboInOwl:hasRelatedSynonym>
        <rdfs:label>major histocompatibility complex class II molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12887"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13433 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13433">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen encoded by the major histocompatibility complex (MHC) including several complement factors, tumor necrosis factor (TNF) $\ce{\upalpha\!}$, and lymphotoxin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MHC class III molecule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>class III MHC gene product</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The genes are found on the short arm of chromosome 6 between class I and class II genes, and although the gene products share no common function with the major histocompatibility complex (MHC) class I and MHC class II molecules, they are often discussed together.</rdfs:comment>
        <rdfs:label>major histocompatibility complex class III molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13421"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13434 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13434">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the cell-surface glycoprotein alloantigens encoded by the major histocompatibility complex (MHC) that are involved in the regulation of immune responses and can cause the rejection of grafted tissues, cells, and tumors bearing them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MHC molecule</oboInOwl:hasRelatedSynonym>
        <rdfs:label>major histocompatibility complex molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12861"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13435 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13435">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Necessity that T cells recognize processed antigen only when presented by major histocompatibility complex (MHC) molecules of the original haplotype associated with T-cell priming.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MHC restriction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>restriction (in immunology)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>major histocompatibility complex restriction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13436 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13436">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracellular signaling molecule (phosphoinositide-3-kinase) involved in control of cell growth, whose activity is negatively influenced by the immunosuppressive drug rapamycin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mTOR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mammalian target of rapamycin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13320"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13436"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>mTOR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13437 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13437">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complement-dependent bactericidal factors that bind to the Ra and R2 polysaccharides expressed by certain enterobacterium strains, such as Ra chemotype strains of Salmonella.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mannose-binding protein-associated serine protease (MASP)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Alternate splicing of the genes results in multiple transcript variants encoding two Ra-reactive factors (RARF) that are involved in the mannose-binding lectin (MBL) pathway of complement activation.</rdfs:comment>
        <rdfs:comment>They are serine proteases that share about \(\pu{40\%}\) sequence identity with complement components C1r and C1s.</rdfs:comment>
        <rdfs:label>mannan-binding lectin-associated serine peptidase-1 and -2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13001"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13438"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13438 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13438">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of the collectin family of calcium-dependent lectins, and an acute-phase protein.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MBP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mannose-binding lectin (MBL)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This lectin functions as a stimulator of the classical pathway of complement activation, and as an opsonin for phagocytosis by binding to mannose, a sugar residue usually found in an exposed form only on the surface of microorganisms.</rdfs:comment>
        <rdfs:label>mannose-binding protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12839"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13023"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13438"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MBP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13439 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13439">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer ring of small lymphocytes surrounding the center of a lymphatic nodule (lymphoid follicle). It contains transient lymphocytes and is the location of the lymphoma in mantle cell lymphoma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>corona</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mantle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mantle zone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13412"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13417"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13440 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13440">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outer area of the splenic periarteriolar lymphoid sheath (PALS) that is rich in B cells, particularly those responding to thymus-independent antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>marginal zone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13691"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13441 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13441">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Leukocyte adhesion to the endothelium of blood vessels in the early phase of an acute inflammatory response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>margination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13442 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13442">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large connective tissue cell that contains inflammatory substances such as histamine, proteases (including tryptases, chymases, and carboxypeptidase A), heparin and chondroitin sulfate proteoglycans, and eicosanoid lipid mediators (the precursors of leukotrienes and prostaglandins). These substances are released in allergic reactions or in response to injury or inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mastocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mast cells are bound within tissues that interface with the external world such as the skin, respiratory or intestinal tract, as well as in other areas such as heart, synovium, and uterus. Mast cells do not circulate. The mast cell has binding sites on its surface for immunoglobulin E (IgE).</rdfs:comment>
        <rdfs:label>mast cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13384"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13443 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13443">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder or syndrome in which there is evidence of systemic, inappropriate release of mast cell mediators.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mast cell activation syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>While people with MCAD/MCAS have a normal or near-normal tryptase level and a bone marrow biopsy that contains a normal number of mast cells, they experience most of the same symptoms as someone with mastocytosis.</rdfs:comment>
        <rdfs:label>mast cell activation disorder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13446"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13444 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13444">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-steroidal medication that reduces the release of substances from mast cells, e.g., sodium cromoglycate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mast cell stabilizer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13445 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13445">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nodule of mast cells that can involve the skin, subcutaneous tissue, and sometimes muscle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>mast cell tumor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mastocytomas are rare and are mostly seen in infants within the first three months of life.</rdfs:comment>
        <rdfs:label>mastocytoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13446 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13446">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare disease characterized by the presence of too many mast cells in various organs and tissues. The condition can be a chronic, long-term illness or it can develop suddenly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Mastocytosis may be systemic, involving a variety of organs, or cutaneous, involving only the skin, also referred to as urticaria pigmentosa.</rdfs:comment>
        <rdfs:label>mastocytosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13447 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13447">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which B cells produce antibodies with increased affinity for antigen during the course of an immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>maturation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13448 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13448">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>B cell with immunoglobulin M (IgM) and immunoglobulin D (IgD) on its surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mature B cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13287"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13449 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13449">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Bone marrow precursor of platelets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>megakaryocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13450 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13450">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complex of complement components C5b–C9 that inserts as a pore into the membrane of target cells leading to cell lysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MAC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>membrane attack complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13451 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13451">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristic of the acquired immune response (see acquired immunity) of lymphocytes whereby a second encounter with a given antigen produces a secondary immune response that is faster, greater, and longer lasting than the primary immune response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>immunological memory</oboInOwl:hasRelatedSynonym>
        <rdfs:label>memory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13601"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13452 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13452">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clonally expanded T cell or B cell produced during a primary immune response and which is primed to mediate a secondary immune response to the original antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>memory cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13601"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13662"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13453 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13453">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Patented modification of the lymphocyte transformation test (LTT) based on the enzyme-linked immunosorbent assay (ELISA) principle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MELISA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>memory lymphocyte immunostimulation assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13115"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13408"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13453"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MELISA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13454 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13454">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymph node lying between layers of the mesentery.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mesenteric lymph node</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13455 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13455">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of one or more chemically reactive intermediate(s) as a result of modification of a molecule by the xenobiotic-metabolizing enzymes of liver and other organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The reactive intermediate can also act as a hapten.</rdfs:comment>
        <rdfs:comment>This may lead to acute cell damage and recognition of the damaged cell by the immune system as non-self.</rdfs:comment>
        <rdfs:label>metabolic activation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13516"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13456 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13456">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which lysosomes directly engulf cytoplasm by invagination, protrusion, and/or septation of the lysosomal limiting membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>microautophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12929"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13457 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13457">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell found in the follicle-associated epithelium of the Peyer’s patch that has the unique ability to sample antigen from the lumen of the small intestine and deliver it via transcytosis to antigen-presenting cells (APCs) and lymphocytes located in a unique pocket-like structure on their basolateral side.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>M cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>microfold cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13751"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13458 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13458">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any small globular protein found on the surface of many cells, including lymphocytes, and in the blood plasma distinct from albumin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>microglobulin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13459 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13459">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>ANCA-associated necrotizing, pauci-immune vasculitis of the small vessels (capillaries, venules, arterioles) frequently associated with rapidly progressive glomerulonephritis and/or hemorrhagic alveolitis as well as autoantibodies against myeloperoxidase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MPA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>microscopic polyangiitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12868"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13488"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13544"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13776"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13459"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13460 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13460">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-major histocompatibility complex (MHC)-encoded cell surface processed peptide which, in association with MHC-encoded molecules, contributes to graft rejection, albeit not usually as severe as that due to MHC mismatch.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>minor histocompatibility antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13179"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13461 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13461">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that induces lymphocyte transformation or, more generally, mitosis and cell proliferation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Mitogens most commonly employed in immunotoxicology assays include the T-cell mitogens concanavalin A (ConA) and phytohemagglutinin (PHA). Mitogens routinely used for assessing B-cell proliferation include pokeweed mitogen (PWM), which can also act on T cells, and Escherichia coil lipopolysaccharide (LPS).</rdfs:comment>
        <rdfs:label>mitogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13572"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13584"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13462 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13462">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a kinase network in which &apos;upstream&apos; kinases activate &apos;downstream&apos; kinases that, in response to phosphorylation, translocate to the nucleus and activate transcription factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MAPK</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>These include the extracellular regulated kinases (Erk), stress-activated protein kinase (SAPK or p38), and the kinase of the c-jun oncoprotein (JNK).</rdfs:comment>
        <rdfs:label>mitogen-activated protein kinase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13462"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAPK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13463 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13463">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autophagy-related pathway specific for mitochondria; it can be subdivided into macromitophagy and micromitophagy depending upon the degree of mitophagy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mitophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12929"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13464 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13464">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-cell-proliferative response induced by cells expressing allogeneic major histocompatibility complex (MHC) molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MLR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mixed lymphocyte response</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mixed lymphocyte response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13464"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MLR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13465 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13465">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Human autoimmune disease in which the immune system attacks the body, producing symptoms that combine features of polymyositis, systemic lupus erythematosus (SLE), and systemic scleroderma, and thus being considered as an overlap syndrome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MCTD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sharp’s syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Distinguishing laboratory characteristics are a positive, speckled anti-nuclear antibody (ANA) and an anti-U1-RNP antibody.</rdfs:comment>
        <rdfs:comment>MCTD commonly causes joint pain/swelling, Raynaud phenomenon, muscle inflammation, and scarring of the skin of the hand. It does not typically cause kidney disease or seizures.</rdfs:comment>
        <rdfs:label>mixed connective tissue disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12898"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MCTD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13466 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13466">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concept that identity or similarity of epitopes expressed by a pathogen and by a self molecule may lead to production of antibodies reacting to the self-antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This may explain how some autoimmune diseases develop.</rdfs:comment>
        <rdfs:label>molecular mimicry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13467 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13467">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mononuclear phagocyte found in blood and which is the precursor of the tissue macrophage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Formed in the bone marrow from the promonocyte, monocytes are transported to tissues, as of the lung and liver, where they develop into macrophages.</rdfs:comment>
        <rdfs:comment>Formerly called large mononuclear leukocyte and hyaline or transitional leukocyte.</rdfs:comment>
        <rdfs:label>monocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13468 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13468">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Alternative name for a cytokine produced by monocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>monokine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13469 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13469">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Network of phagocytic cells throughout the body. System comprising blood monocytes and tissue macrophages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>reticuloendothelial system (RES)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mononuclear phagocyte system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13469"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13470 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13470">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure in which serum immunoglobulin E (IgE) levels are measured in mice following topical exposure to a test substance. Substances that cause a significant increase in IgE are considered to be potential respiratory allergens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MIGET</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mouse IgE test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13470"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MIGET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13471 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13471">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for sensitization in which the test substance is applied topically to the ear of a mouse for three consecutive days. The change in ear thickness is then measured following challenge on day 8.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MEST</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mouse ear-swelling test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MEST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13472 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13472">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to or affecting the mucous membranes and/or the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mucocutaneous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13473 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13473">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Moist tissue that lines some organs and body cavities, including the nose, mouth, lungs, and digestive tract.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mucosa</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13474 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13474">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secondary lymphoid tissue present in the surface mucosa of the respiratory tract and bronchus (BALT), gastrointestinal tract (GALT), nasal passages (NALT), larynx (LALT), conjunctiva (CALT), and genitourinary tract, and in the skin sub-epidermis (SALT).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MALT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bronchus-associated lymphoid tissue (BALT)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nasal-associated lymphoid tissue (NALT)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MALT plays an important part in limiting entry of pathogens through the mucosal surfaces.</rdfs:comment>
        <rdfs:label>mucosa-associated lymphoid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13189"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13663"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13474"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MALT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13475 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13475">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein involved in trafficking of lymphocytes to mucosal endothelium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MAdCAM-1</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Expression of MAdCAM-1 is induced in the murine endothelial cell line bEnd.3 by tumor necrosis factor α (TNF-α), interleukin (IL)-1, and bacterial lipopolysaccharide (LPS).</rdfs:comment>
        <rdfs:label>mucosal addressin cell adhesion molecule-1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13475"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAdCAM-1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13476 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13476">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of lymphocyte hyporesponsiveness to protein antigens applied across mucosal surfaces by oral or nasal instillation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>mucosal tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13477 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13477">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plasma cell malignancy resulting in high levels of monoclonal immunoglobulin (Ig) in serum and of free light chains (Bence–Jones protein) in urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>multiple myeloma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12947"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13483"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13478 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13478">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of particle immunoassay employing sets of microspheres with various physicochemical features, each labeled with a different antibody. The method allows detection in a single measurement of an array of 100 or more proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>multiplex immunoassay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13537"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13479 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13479">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Undifferentiated stem cell, obtained from adult bone marrow or other non-embryonic tissue sources, that possesses the ability to differentiate into a variety of cell types, especially into cells of a closely related family of cells that are expanded in vitro and deposited in master cell banks for &apos;off-the-shelf&apos; use, with potential hematopoiesis-inducing and immunomodulating activities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Allogeneic multipotent adult progenitor cells (MAPCs) are non-immunogenic due to the lack of major histocompatibility complex (MHC) molecule expression, and so elicit no immune response upon administration.</rdfs:comment>
        <rdfs:comment>In vivo, bone marrow-derived adult stem cells are capable of maturing into a broad range of cell types and may help to restore the immune system by producing multiple therapeutic molecules in response to inflammation and tissue damage.</rdfs:comment>
        <rdfs:label>multipotent progenitor cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12862"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13480 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13480">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predictive test of sensitization in which a test substance is applied topically to the skin of mice (usually three times at daily intervals) and the weight of the local draining lymph nodes is measured at six days. Usually lymphoproliferation in the nodes is measured following injection of [\(\ce{^{3}H}\)]thymidine or bromodeoxyuridine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>LLNA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>local lymph node assay (LLNA)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>murine local lymph node assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13103"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13419"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13480"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LLNA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13481 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13481">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease characterized by muscle weakness usually affecting ocular and oropharyngeal muscles due to an autoimmune attack against components of the neuromuscular junction (e.g., the nicotinic acetylcholine receptor).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>acquired myasthenia gravis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This disease may be idiopathic, paraneoplastic [thymic tumor or lung (Lambert–Eaton myasthenic syndrome) tumor, etc.], or drug-induced (e.g., D-penicillamine).</rdfs:comment>
        <rdfs:label>acquired myasthenia gravis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13371"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13734"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13482 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13482">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diverse collection of hematological conditions united by ineffective production (or dysplasia) of myeloid blood cells and risk of transformation to acute myelogenous leukemia (AML). Anemia requiring chronic blood transfusion is frequently present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myelodysplastic syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13484"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13753"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13483 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13483">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tumor composed of cells derived from hematopoietic cells (see hematopoiesis) of the bone marrow, or from mast cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myeloma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12947"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13477"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13484 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13484">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to the nonlymphocytic groups of white blood cells, including granulocytes, monocytes, and platelets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>myelogenous</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Acute myelogenous leukemia (AML) is also known as acute myeloid leukemia.</rdfs:comment>
        <rdfs:label>myeloid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13485 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13485">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of two groups of stem cells produced in the bone marrow. Myeloid stem cells may mature into several types of blood cells, including acidic basophils, eosinophils, erythrocytes, macrophages, megakaryocytes, and neutrophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myeloid stem cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13449"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13486 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13486">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue within red bone marrow that produces the blood cells. It is found around the blood vessels and contains various cell types that are precursors of the blood cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myeloid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13487 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13487">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monoclonal antibody secreted by myeloma cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myeloma protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13483"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13488 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13488">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme found in azurophilic granules of neutrophils, the major target of antineutrophil cytoplasmic autoantibody (ANCA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>MPO</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MPO autoantibodies are also found in patients exposed to silica or drugs (e.g., hydralazine, propylthiouracil, D-penicillamine) as well as in some patients with Wegener granulomatosis (WG) and other autoimmune diseases.</rdfs:comment>
        <rdfs:comment>MPO autoantibodies are diagnostic markers for microscopic polyangiitis, rapidly progressive glomerulonephritis, and Goodpasture disease or syndrome.</rdfs:comment>
        <rdfs:label>myeloperoxidase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13178"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13782"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13488"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13489 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13489">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of formation and development of myeloid blood cells in the bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myelopoiesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13484"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13490 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13490">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in myeloid cells, including pancytopenia, anemia, leukopenia, lymphopenia, thrombocytopenia, and other blood dyscrasias.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>myelosuppression</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12955"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13382"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13409"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13484"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13532"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13491 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13491">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare systemic inflammatory myopathy, including primary polymyositis, primary dermatomyositis, myositis associated with malignancy, childhood dermatomyositis, and myositis with multisystem autoimmune disease [e.g., mixed connective tissue disease (MCTD), systemic sclerosis (SSc)].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune myositis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoantibodies against aminoacyl-tRNA synthetases (e.g., anti-Jo-1), signal recognition particles (e.g., anti-SRP54), nuclear helicase (anti-Mi-2), tRNA and tRNA–protein complexes (e.g., anti-Mas), and translation factor (anti-KJ) have been described as myositis-specific.</rdfs:comment>
        <rdfs:label>autoimmune myositis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13492 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13492">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>NOD-like receptor (NLR), found in certain inflammasomes, that binds to aggregated proteins and the peptides that compose them. Its activation leads to the generation of inflammatory cytokines, such as interleukin (IL)-1, and neurotoxic factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>cryopyrin</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mutations in NALP3 are responsible for the autoinflammatory diseases familial cold autoinflammatory syndrome, Muckle–Wells syndrome and neonatal onset multisystem inflammatory disease.</rdfs:comment>
        <rdfs:label>NACHT domain-, leucine-rich repeat (LRR)-, and pyrin (N-terminal homology) domain (PYD)-containing protein 3</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13333"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13494"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13493 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13493">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-templated nucleotides added to the junctions between antibody and T-cell receptor (TCR) variable (V) gene, diversity (D) gene, and joining (J) gene segments during gene rearrangement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>N-nucleotides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13494 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13494">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a large family of cytoplasmic proteins containing a nucleotide-binding domain and leucine-rich repeats (LRRs), involved in regulation of inflammation and apoptosis; many family members are thought to function as pattern recognition receptors (PRRs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NLR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>NOD-like receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13492"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13543"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13494"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NLR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13495 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13495">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly variable region on the H-chain of immunoglobulins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>N-region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13496 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13496">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mature T cell or B cell that has not yet been activated (see lymphocyte activation) by encounter with antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>naïve lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13497 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13497">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the naturally occurring repertoire of polyreactive antibodies that bind to autoantigens with low affinity. They are mainly of immunoglobulin M (IgM) isotype and produced by CD5+ B lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NAA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In contrast, natural autoantibodies may become pathogenic in clonal B cell disorders, e.g., monoclonal anti-I antibodies in cold agglutinin disease cause autoimmune hemolytic anemia.</rdfs:comment>
        <rdfs:comment>Natural antibodies and their producing cells may have a physiological role in the following processes: (i) first line of protection against external invaders, (ii) elimination of degraded autoantigens and senescent cells, and (iii) tolerization (see tolerance) of T cells by presenting autoantigens, thereby in protecting from development of pathological autoimmunity.</rdfs:comment>
        <rdfs:label>natural autoantibodies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12920"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13347"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13497"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NAA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13498 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13498">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Host defense mechanisms that do not require prior exposure to antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Nonimmunological defense may involve the actions of macrophages and natural killer (NK) cells, mucocutaneous or integumental barriers, the action of cilia or microvilli, or physiological processes, e.g., urinary outflow, vascular perfusion of tissues, or the presence of native flora, which &quot;outcompete&quot; pathogens.</rdfs:comment>
        <rdfs:label>natural immunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13226"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13499 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13499">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large granular lymphocyte which does not rearrange nor express either immunoglobulin or T-cell receptor (TCR) genes but is able to recognize and destroy certain tumor and virally infected cells in a major histocompatibility complex (MHC) molecule- and antibody-independent manner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NK cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>natural killer cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13500 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13500">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunotoxicity test in which lymphoid tissue or blood that has been treated with a test compound is co-incubated with target cells. The cytotoxic effect on target cells is measured, e.g., with the chromium release assay. It is used under circumstances where differences from untreated cells are attributed to natural killer (NK) cell activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>natural killer cell activity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13501 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13501">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphoid cells with a morphology and granule content intermediate between T cells and natural killer (NK) cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NKT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NKT cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>NKT cells express low levels of \(\upalpha{:}\upbeta\) T-cell receptor with an invariant α chain and very restricted \(\ce{\upbeta\ chain}\) specificity, recognize lipid and glycolipid antigens presented by the nonclassical MHC-like molecule CD1d, and are potent producers of interleukin (IL)-4 and IFN-γ.</rdfs:comment>
        <rdfs:label>natural killer T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12825"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13501"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NKT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13502 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13502">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Iron transporter that plays a critical role in macrophage activation and differentiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NRAMP-1</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Allele 3 of the NRAMP-1 promoter is associated with autoimmune disorders [e.g., rheumatoid arthritis (RA), juvenile rheumatoid arthritis, diabetes mellitus type 1, multiple sclerosis].</rdfs:comment>
        <rdfs:label>natural resistance-associated macrophage protein</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13502"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NRAMP-1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13503 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13503">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deletion by apoptosis in the thymus of T cells that recognize self-peptides presented by self-major histocompatibility complex (MHC) molecules, thus preventing the development of autoimmune T cells. Negative selection of developing B cells is also thought to occur if they encounter high levels of self-antigen in the bone marrow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>negative selection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13504 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13504">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen newly expressed on a tumor or virally infected cell, or arising after macromolecule-hapten binding.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>neoantigen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13505 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13505">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tolerance to specific foreign antigens induced by the exposure of a bird or mammal to the foreign antigens during embryonic or neonatal life, depending upon species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>neonatal tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13506 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13506">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the kidney due to immunological reaction to renal antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune nephritis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Common examples are anti-glomerular basement membrane disease (Goodpasture disease or syndrome), autoimmune tubulointerstitial nephritis with antibody to tubular basement membrane, or occurring as part of systemic autoimmune diseases independent of renal autoantigens [lupus nephritis in systemic lupus erythematosus (SLE), interstitial nephritis in Sjögren syndrome, nephritis in ANCA-associated vasculitis, cryoglobulinemic vasculitis, or hypocomplementemic urticarial vasculitis syndrome].</rdfs:comment>
        <rdfs:label>autoimmune nephritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12897"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13061"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13178"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13507 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13507">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease of the nervous system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune neuropathy</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoimmune neuropathies may be manifested at the neuromuscular junction, as central nervous system diseases (e.g., multiple sclerosis, paraneoplastic autoimmune syndromes, stiff-person syndrome, as well as manifestations of systemic autoimmune diseases), and diseases of the peripheral nerves (e.g., various forms of acute and chronic demyelinating neuropathies).</rdfs:comment>
        <rdfs:comment>More and more neuropathies are described as autoimmune or possibly autoimmune in nature. Little is known about xenobiotics in the pathogenesis, but infections may play an important role in the initiation of some diseases.</rdfs:comment>
        <rdfs:label>autoimmune neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13535"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13508 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13508">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Blocking by an antibody of the effects of a virus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>neutralization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13509 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13509">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abnormally low concentration of neutrophils in the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Neutropenia is associated with an increased risk of infection.</rdfs:comment>
        <rdfs:label>neutropenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13510 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13510">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Granular leukocyte, the major circulating phagocytic polymorphonuclear granulocyte, having a nucleus with three to five lobes and fine cytoplasmic granules stainable by neutral dyes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>polymorphonuclear leucocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The cells are involved in a variety of inflammatory processes including late-phase allergic reactions and are also able to mediate antibody-dependent cellular cytotoxicity (ADCC).</rdfs:comment>
        <rdfs:comment>The cells have properties of chemotaxis, adherence to immune complexes, and phagocytosis.</rdfs:comment>
        <rdfs:label>neutrophil</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12879"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13000"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13511 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13511">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in morphology and behavior of a neutrophil resulting from exposure to a cytokine, chemokine, cellular ligand, or soluble factor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>neutrophil activation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13512 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13512">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generic term for nitrogen monoxide species, including nitrosonium ion, nitric oxide radical, etc., that can function in a cell-signaling capacity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>nitric oxide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13513 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13513">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface antibody that does not provoke attack by killer cells and thus does not provoke depletion of a group of cells in the body, usually referring to B cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>nondepleting antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13514 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13514">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of various malignant lymphomas characterized by the absence of Reed–Sternberg cells and producing symptoms similar to those of Hodgkin disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>non-Hodgkin lymphoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13220"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13417"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13641"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13515 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13515">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetically modified mouse with a susceptibility to spontaneous development of automimmune diabetes mellitus type I.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NOD mouse</oboInOwl:hasRelatedSynonym>
        <rdfs:label>non-obese diabetic mouse</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13515"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NOD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13516 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13516">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, relating to, or designating a cell or tissue that has not been produced by the individual organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Non-self molecules are identified by the immune system as foreign or abnormal, thus provoking an immune response.</rdfs:comment>
        <rdfs:label>non-self</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13517 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13517">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transcription factor involved in rapid cell response to stress, such as injury or invading pathogens, and in cell proliferation and survival.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NFAT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>nuclear factor of activated T cells</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13517"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NFAT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13518 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13518">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein complex that controls the transcription of genes involved in cytokine production, cellular adhesion, inflammation, and apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NFκB</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>NFκB is found in almost all animal cell types and is involved in cellular responses to stimuli such as stress, cytokines, free radicals, ultraviolet irradiation, oxidized low-density lipoprotein (LDL), and bacterial or viral antigens.</rdfs:comment>
        <rdfs:label>nuclear factor kappa-light-chain-enhancer of activated B cells</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13336"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13518"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NFκB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13519 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13519">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Members of a family of human intracellular proteins involved in the detection of invasive bacteria and activation of the $\ce{NF\kappa B}$ transcription factor pathway.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>In epithelial cells, NOD1 is essential for sensing intracellular Gram-negative bacteria through a tripeptide motif in the bacterial peptidoglycan.</rdfs:comment>
        <rdfs:label>nucleotide-binding oligomerization domain-containing protein 1, 2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13518"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13520 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13520">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytosolic protein that contains a central nucleotide-binding oligomerization domain, an N-terminal effector-binding domain and C-terminal leucine-rich repeats (LRRs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NLR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NOD-like receptor protein (NLRP)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Genetic associations of polymorphisms in NOD-like receptor genes with complex chronic inflammatory barrier diseases, such as Crohn disease and asthma, and with rare auto-inflammatory syndromes including familial cold urticaria, Muckle–Wells syndrome and Blau syndrome have been described.</rdfs:comment>
        <rdfs:comment>NOD-like receptors have been implicated as mediators of protective immune responses against intracellular pathogens.</rdfs:comment>
        <rdfs:label>nucleotide-binding oligomerization domain-containing protein-like receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12953"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13053"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13492"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13520"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NLR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13521 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13521">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mouse that is T-cell-deficient due to a homozygous gene defect (\(nu/nu\)) resulting in the absence of a thymus (and also lack of body hair).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>nude mouse</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13522 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13522">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte with neither T- nor B-cell differentiation antigens on its surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>null cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13096"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13523 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13523">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Brand name for muromonab-CD3, an immunosuppressant drug given intravenously to reverse acute rejection of transplanted organs, including the heart, kidneys, and liver.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>OKT3 was the first monoclonal antibody used to treat patients.</rdfs:comment>
        <rdfs:label>OKT3</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12881"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13319"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13524 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13524">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having a few different clones, or the product of a few different clones.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>oligoclonal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13525 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13525">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen whose expression is normally restricted to the fetus but which may be expressed during malignancy in adults.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>oncofetal antigen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13526 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13526">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coating of antigen with an opsonin to enhance phagocytosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The interaction of opsonized complexes with Fc receptors or complement receptors facilitates their uptake by the receptor-bearing phagocytic cells.</rdfs:comment>
        <rdfs:label>opsonization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13138"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13527 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13527">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Orally induced and immune-mediated non-responsiveness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>oral tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13528 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13528">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunization against a pathogen with a vaccine administered by mouth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>oral vaccination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13529 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13529">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Double-radial immunodiffusion procedure for the detection of precipitating antibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Ouchterlony double diffusion assay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>double diffusion</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Method of high diagnostic specificity but low sensitivity.</rdfs:comment>
        <rdfs:label>Ouchterlony technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13596"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13530 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13530">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Palindromic nucleotide sequences generated at the junctions between antibody and T-cell receptor (TCR) variable (V), diversity (D), and joining (J) gene segments during gene rearrangement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>P-nucleotides</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13531 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13531">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell adhesion molecule expressed on the surface of activated endothelial cells and platelets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>P-selectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13532 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13532">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in the number of red blood cells, white blood cells, and platelets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pancytopenia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13533 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13533">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of a lymph node enriched in T lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>paracortex</oboInOwl:hasRelatedSynonym>
        <rdfs:label>paracortical area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13534 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13534">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Paracrine agonist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>paramone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13535 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13535">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of several autoimmune diseases that are caused by tumor-induced perturbations of the immune system with damaging effects on various organ systems (e.g. cancer-associated retinopathy, paraneoplastic neurological syndromes, paraneoplastic cutaneous syndromes). In most cases, autoantibodies generated by antitumor immunity are responsible for the tissue injury.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>paraneoplastic autoimmune syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13371"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13536 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13536">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Site in the variable region of an antibody or T-cell receptor (TCR) that binds to an epitope of an antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>paratope</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13537 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13537">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoassay in which antibody is bound to the surface of microspheres. After incubation with the antigen-containing biological fluid, and subsequent manipulation, detection is usually performed by flow cytometry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>particle immunoassay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13538 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13538">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay for allergenicity in which an antibody is injected intradermally into a test animal followed at a later time (anywhere from \(\pu{3}\) to \(\pu{48 h}\)) with an intravenous injection of a mixture of a test antigen and a dye (typically Evans blue). Increased vascular permeability at the site of antigen-antibody reaction is visualized by extravasation of the dye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PCA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PCA test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>passive cutaneous anaphylaxis test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13538"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13539 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13539">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of measuring antibody titer, in which antigen-coated erythrocytes are agglutinated by adding antibody specific for the antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>passive hemagglutination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13540 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13540">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunization of an individual by the transfer of antibody synthesized in another individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>passive immunization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13541 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13541">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for allergy that is performed by placing the suspected allergen in direct contact with the skin or mucosa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>patch test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13542 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13542">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing repetitive motifs of molecules such as lipopolysaccharide (LPS), peptidoglycan, lipoteichoic acids, and mannans, which are widely expressed by microbial pathogens but are not present on host tissues. They are therefore utilized by the pattern recognition receptors (PRRs) of the immune system to distinguish pathogens from self-antigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PAMP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pathogen-associated molecular pattern</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13543"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13542"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PAMP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13543 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13543">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor found on many different cell types in the immune system that enables them to recognize pathogen-associated molecular patterns (PAMPs). Amongst the large number of different PRRs are the mannose receptor (CD206), macrophage scavenger receptor (CD204), and the toll-like receptors (TLRs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PRR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Many of the NOD-like receptors (NLRs) are thought to serve as PRRs.</rdfs:comment>
        <rdfs:label>pattern recognition receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13494"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13542"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13747"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PRR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13544 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13544">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Referring to vasculitis characterized by relatively little deposition of immunoglobulin (Ig) and complement factors, usually describing a form of glomerulonephritis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pauci-immune</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13776"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13545 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13545">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare, serious autoimmune disease marked by successive outbreaks of blisters, which appear suddenly and disappear, leaving pigmented spots.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>pemphigus vulgaris</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Other mucous membranes, as well as the skin, are usually affected and the disease may be fatal.</rdfs:comment>
        <rdfs:label>pemphigus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13546 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13546">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure consisting of four identical major histocompatibility complex (MHC)-encoded peptides, presenting four binding sites for biotin attached to the tail of the MHC molecule, and held together by fluorescent streptavidin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>peptide tetramer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13430"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13547 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13547">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Preparation of an immunologically active peptide found in a disease-causing organism or substance, or any of their products, which is specially treated for use in vaccination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>peptide vaccine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13771"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13548 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13548">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural feature found in major histocompatibility complex (MHC) class I and class II heterodimeric proteins that can bind endogenous peptides.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>peptide-binding groove</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12889"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13549 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13549">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule produced by cytotoxic T cells and natural killer (NK) cells that, like complement component C9, polymerizes to form a pore in the membrane of the target cell leading to cell death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>perforin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13727"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13550 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13550">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphoid tissue that forms the white pulp of the spleen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PALS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>periarteriolar lymphoid sheath</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13785"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13550"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PALS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13551 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13551">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammatory reaction of the tissues surrounding a tooth (periodontium), usually resulting from the extension of gingival inflammation (gingivitis) into the periodontium, and involving inflammation and infection of the ligaments and bones that support the teeth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>periodontitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13552 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13552">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Leukocyte derived from the peripheral circulatory system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PBL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peripheral blood leukocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13552"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PBL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13553 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13553">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monocyte produced by the bone marrow from hematopoietic stem cell precursors, circulating in the bloodstream for about one to three days before moving into tissues throughout the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PBMC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>PBMCs constitute between \(\pu{3}\) to \(\pu{8\%}\) of the leukocytes in the blood. In the tissues monocytes mature into different types of macrophages at different anatomical locations [see macrophage, resident(ial)].</rdfs:comment>
        <rdfs:label>peripheral blood mononuclear cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13201"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13425"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13553"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PBMC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13554 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13554">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of the lymphoid organs (see lymphoid tissue) other than the thymus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>peripheral lymphoid organ</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13555 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13555">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute or chronic inflammatory neuropathy leading to demyelination and axonal damage of nerves and nerve roots associated with high-titeredautoantibodies against gangliosides [e.g., Guillain–Barré syndrome (GBS), Miller–Fisher syndrome, acute sensory ataxic neuropathy].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune peripheral neuropathy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>autoimmune peripheral neuropathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13556 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13556">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific immunological tolerance occurring outside of the primary lymphoid organs (see lymphoid tissue).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>peripheral tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13557 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13557">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease in which the erythrocytes are abnormally formed, due to an inability to absorb vitamin \({\rm{B}}_{12}\). True pernicious anemia refers specifically to a disorder of atrophied parietal cells leading to absent intrinsic factor, resulting in an inability to absorb \({\rm{B}}_{12}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This disease is associated with a variety of autoimmune endocrine diseases (e.g., Hashimoto thyroiditis, Addison disease, and autoimmune myasthenic syndromes).</rdfs:comment>
        <rdfs:comment>This is the end stage of \(\pu{10}\) to \(\pu{15\%}\) of autoimmune gastritis.</rdfs:comment>
        <rdfs:label>pernicious anemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12845"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13195"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13558 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13558">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autophagy selective for degradation of peroxisomes, which can be separated into macropexophagy and micropexophagy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pexophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12929"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13559 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13559">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the gut-associated lymphoid tissue (GALT) and found as a distinct lymphoid nodule, mainly in the small intestine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Peyer’s patch</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13189"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13560 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13560">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell, especially of monocyte/macrophage or neutrophil lineage, that is specialized for the engulfment of cellular and particulate matter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>phagocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13561 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13561">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of quantifying phagocytosis in which yeast cells, stained with May–Grünwald stain, are incubated with macrophages, and subsequently, after a fixed time, yeast cells engulfed in the macrophages are counted.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>phagocytosis assay</oboInOwl:hasRelatedSynonym>
        <rdfs:label>phagocytic activity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which particulate material is endocytosed by a cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>phagocytosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13563 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13563">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracellular vacuole where killing and digestion of phagocytosed material occurs following the fusion of a phagosome with a lysosome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>phagolysosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13564"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intracellular vacuole produced following invagination of the cell membrane around phagocytosed material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>phagosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13562"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chromosome resulting from a reciprocal translocation between human chromosomes 9 and 22, most commonly associated with chronic myelogenous leukemia (CML).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Philadelphia chromosome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12827"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13008"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mitogenic phorbol ester that directly stimulates protein kinase C (PKC) and acts as a tumor promoter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tetradecanoyl phorbol acetate (TPA)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>phorbol 12-myristate 13-acetate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13619"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13566"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that cleaves phosphatidylinositol bisphosphate into diacylglycerol and inositol trisphosphate, leading to the activation of two major cell signaling pathways.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PLC-γ</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>One consequence of the signaling is B- and T-lymphocyte activation.</rdfs:comment>
        <rdfs:label>phospholipase Cγ</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13567"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PLC-γ</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13568 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13568">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type IV hypersensitivity reaction in which photoactivation of a substance produces a hapten that then acts as a sensitizer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>photoallergy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13167"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13569 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13569">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of contact dermatitis arising when substances are transformed into either irritants or allergens upon exposure to light.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Aftershave lotions, sunscreens, and certain topical sulfa drugs may be changed into allergens, while coal tar and certain oils used in manufacturing may become irritants after exposure to sunlight.</rdfs:comment>
        <rdfs:label>photocontact dermatitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13570 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13570">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin reddening due to an abnormal reaction to sunlight, characteristic of systemic autoimmune diseases [e.g., systemic lupus erythematosus (SLE), mixed connective tissue disease (MCTD)], and cutaneous and subacute cutaneous lupus erythematosus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>photosensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13709"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13571 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13571">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure used to identify the phototoxic potential of a test substance. The substance is administered either systemically or topically on the skin, and light is subsequently shone on the skin to photoexcite the substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>There is also an in vitro test using photoexposure of treated Balb c/3T3 cells followed by viability testing.</rdfs:comment>
        <rdfs:label>phototoxicity test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13572 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13572">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plant lectin that acts as a T-cell mitogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PHA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>phytohemagglutinin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13572"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PHA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13573 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13573">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal antibody (or fragment thereof), expressed in a genetically modified plant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>plantibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13574 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody-secreting plasma cell detected in vitro by its ability to produce a &apos;plaque&apos; of lysed antigen-sensitized erythrocytes in the presence of complement.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PFC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>plaque-forming cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12900"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13574"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PFC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13575 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13575">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly proliferative cell that is a developmental intermediate between small B lymphocytes and immunoglobulin (Ig)-secreting mature plasma cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>plasmablast</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13576 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13576">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Terminally differentiated B lymphocyte, with little or no capacity for mitotic division, that actively secretes large amounts of antibody.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Plasma cells have eccentric nuclei, abundant cytoplasm, and distinct perinuclear haloes. The cytoplasm contains dense rough endoplasmic reticulum and a large Golgi complex.</rdfs:comment>
        <rdfs:label>plasma cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13577 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13577">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dendritic cell of distinct lineage, found in blood and peripheral lymphoid tissue, which secretes large amounts of interferon (IFN) upon activation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>plasmacytoid dendritic cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13578 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13578">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of neoplastic monoclonal plasma cells growing in bone or soft tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>plasmacytoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13576"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13579 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13579">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique of extracorporeal separation of blood cells from plasma, with return of the cells to the patient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>plasma exchange</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Frequently used to remove antibodies in autoimmune disease.</rdfs:comment>
        <rdfs:label>plasmapheresis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13580 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13580">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small irregular or disc-shaped cell found in large numbers in mammalian blood, essential for blood clotting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>thrombocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:label>platelet</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13581 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13581">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Alkyl phospholipid released by a variety of cell types including mast cells and basophils, which has immunoregulatory effects on lymphocytes and monocytes/macrophages, as well as causing platelet aggregation and degranulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PAF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>platelet-activating factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13084"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13581"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PAF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13582 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13582">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein synthesized by platelets that is released into the serum during blood clotting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PDGF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>PDGF represents the major growth factor in human serum and is a potent mitogen for connective tissue and glial cells.</rdfs:comment>
        <rdfs:label>platelet-derived growth factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13582"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PDGF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13583 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13583">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Self-replicating cell capable of developing into cells and tissues of the three primary embryonic germ layers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pluripotent stem cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13584 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13584">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plant lectin which is a T-cell-dependent B-cell mitogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PWM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pokeweed mitogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13584"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PWM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13585 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13585">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systemic disease characterized by widespread inflammation of small and medium-sized arteries in which many of the foci are nodular.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>disseminated necrotizing periarteritis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>panarteritis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>periarteritis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>periarteritis nodosa</oboInOwl:hasRelatedSynonym>
        <rdfs:label>polyarteritis nodosa</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13586 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13586">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that induces activation of multiple clones of B lymphocytes or T lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>polyclonal activator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13587 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13587">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease affecting multiple endocrine organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>APECED syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>autoimmune polyendocrinopathy</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>(i) The autoimmune polyglandular syndrome type 1 is characterized by mucocutaneous candidiasis in association with endocrine manifestation (also called APECED syndrome, autoimmune polyendocrinopathy-candidiasis-ectodermal dystrophy). (ii) The autoimmune polyglandular syndrome type 2 exhibits any combination of adrenal insufficiency (see Addison disease), diabetes mellitus type 1, lymphocytic thyroiditis (see thyroiditis, autoimmune), hypoparathyroidism, and gonadal failure.</rdfs:comment>
        <rdfs:comment>In both types, organ-specific autoantibodies against a variety of endocrine glands are detectable.</rdfs:comment>
        <rdfs:label>autoimmune polyendocrinopathy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12845"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13741"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13588 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13588">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polyinosinic:polycytidylic acid, a synthetic immunostimulant mimicking viral double-stranded RNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>poly I:C</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13589 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13589">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polyinosinic:polycytidylic acid, poly-ʟ-lysine, and carboxymethylcellulose (letter roots of the acronym underlined), a synthetic immunostimulant mimicking viral double-stranded RNA.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>poly ICLC</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13590 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13590">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor molecule that specifically binds J chain-containing polymeric immunoglobulin (Ig), i.e., dimeric secretory immunoglobulin A (IgA) and pentameric immunoglobulin M (IgM), and transports it across mucosal epithelium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>poly-Ig receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13353"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13591 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13591">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mature leukocyte with granular cytoplasm and a segmented and irregularly shaped nucleus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It is the predominating leukocyte in the blood and is found in the tissues during acute inflammatory processes and in the superficial surface aspects of a lesion during subacute or chronic inflammation.</rdfs:comment>
        <rdfs:comment>There are three major types: neutrophils, eosinophils, and basophils.</rdfs:comment>
        <rdfs:label>polymorphonuclear leukocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13592 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13592">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disorder characterized by inflammation and degeneration of skeletal muscle, causing pain, weakness, and wasting in affected (usually proximal) muscles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>polymyositis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13593 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13593">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for immunosensitization measuring popliteal lymph node hyperplasia after subcutaneous injection of a test substance into the footpad of the hindpaw of a rodent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PLNA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>popliteal lymph node assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13593"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PLNA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13594 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13594">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Selection of those developing T cells in the thymus that are able to recognize self-major histocompatibility complex (MHC) molecules. This occurs by preventing apoptosis in these cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>positive selection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13595 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13595">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell in the B-lymphocyte lineage that has rearranged heavy chain but not light chain genes; it expresses surrogate light chains and \(\upmu\) heavy chain at its surface in conjunction with immunoglobulins Ig _012643_ and Ig _012644_. All these molecules comprise the pre-B-cell receptor (pre-BCR).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pre-B cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13596 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13596">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody that is capable of reacting with a soluble antigen with the formation of an insoluble antigenantibody complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>precipitating antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13597"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13597 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13597">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precipitate of antibody and multivalent antigen due to the formation of high-molecular-weight complexes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>precipitin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13598 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13598">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell differentiating into a T lymphocyte in the thymus gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>single-positive cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thymocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>During maturation thymocytes express on their surface a precursor T-cell receptor (TCR) called a pre-T-cell receptor, and both CD8 and CD4 proteins (double-positive cells). At the same time they slowly migrate from the outer cortex of the thymus to the inner medullary region. Only the \(\pu{2\%}\) of cells capable of distinguishing self-antigen survive to maturity in the medulla. Here they become single-positive cells, expressing exclusively CD4 or CD8 surface proteins, and are exported from the thymus in the bloodstream to become helper T cells (Th) and cytotoxic T cells, respectively.</rdfs:comment>
        <rdfs:label>pre-T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13102"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13599 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13599">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test carried out by placing a drop of a suspected allergenic extract on the skin of the forearm and gently pricking it into the upper layer of skin. Sensitivity to a substance is indicated if the spot swells slightly and becomes red within about \(\pu{15 min}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>A positive result is far from conclusive and, at best, gives a vague indication of allergenicity. The prick test is inappropriate as a test for food allergens.</rdfs:comment>
        <rdfs:label>prick test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13600 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13600">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune liver disease that results in the destruction of bile ducts, leading to fibrosis and cirrhosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PBC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Primary biliary cirrhosis-specific antibodies are antimitochondrial antibodies (AMAs) directed against proteins of the pyruvate dehydrogenase complex (mainly the E2 subunit).</rdfs:comment>
        <rdfs:label>primary biliary cirrhosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12895"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13600"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13601 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13601">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response to the first encounter with an antigen, characterized by slow production of antibody molecules and the priming of lymphoid tissue in readiness for the production of a secondary immune response on subsequent challenge with the same antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>primary response</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The primary response is generally weak, has a long induction phase or lag period, consists primarily of the release of immunoglobulin M (IgM) antibodies, and generates immunologic memory.</rdfs:comment>
        <rdfs:label>primary immune response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13414"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13451"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13662"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13602 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13602">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First introduction of a vaccine into the body for the purposes of inducing immunity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>primary immunization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13601"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13603 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13603">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of a secondary lymphoid organ containing predominantly unstimulated B lymphocytes that develops into a germinal center following antigen stimulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>primary lymphoid follicle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13172"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13412"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13663"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13604 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13604">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Site at which immunocompetent lymphocytes develop, i.e., bone marrow and thymus in mammals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>primary lymphoid organ</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13277"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13605 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13605">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Atrophic form of diffuse autoimmune thyroiditis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>primary myxedema</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13741"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13606 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13606">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic, non-bacterial, inflammatory narrowing of the bile ducts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PSC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Often associated with ulcerative colitis [see inflammatory bowel disease (IBD)].</rdfs:comment>
        <rdfs:label>primary sclerosing cholangitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13334"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13607 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13607">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of giving an initial sensitization to antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>priming</oboInOwl:hasRelatedSynonym>
        <rdfs:label>prime</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13608 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13608">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly efficient antigen-presenting cell (APC), generally referring to dendritic cells, B cells, or macrophages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Other cells, e.g., fibroblasts and endothelial cells, that do not constitutively express major histocompatibility complex (MHC) class II molecules may be induced to do so by certain cytokines and are sometimes referred to as nonprofessional antigen-presenting cells.</rdfs:comment>
        <rdfs:label>professional antigen-presenting cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13432"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13609 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13609">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systemic autoimmune disease marked by formation of hyalinized and thickened collagenous fibrous tissue, with thickening and adhesion of skin to underlying tissues, especially of the hands and face and vascular alterations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>progressive systemic sclerosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13660"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13709"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13610 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13610">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytokine that initiates or enhances inflammation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>proinflammatory cytokine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13611 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13611">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any test that determines the effect on increase in cell number of a test agent such as a cytokine or mitogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>proliferation assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13612 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13612">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relatively heat-labile, normal serum protein (a euglobulin) that, in the presence of complement component C3 and magnesium ions, is involved in the alternative pathway of complement activation, and acts nonspecifically against Gram-negative bacteria and viruses and may contribute to the lysis of erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It migrates as a β3-globulin and, although not an antibody, may act in conjunction with complement-fixing antibody.</rdfs:comment>
        <rdfs:label>properdin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12866"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13130"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13613 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13613">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cytoplasmic and nuclear multiprotein proteolytic complex involved in degradation of excess, damaged, or misfolded proteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Cytoplasmic proteasome is important in antigen processing and presentation by major histocompatibility complex (MHC) molecules.</rdfs:comment>
        <rdfs:label>proteasome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13614 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13614">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of the Ly-6 family of cell surface molecules that prevents insertion of the membrane attack complex (MAC) into the membrane, thereby protecting cells from complement-induced lysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD59</oboInOwl:hasRelatedSynonym>
        <rdfs:label>protectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13370"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13450"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13615 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13615">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protection against infectious agents conferred by vaccination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>protective immunity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13771"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13616 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13616">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Staphylococcus aureus cell wall protein that binds to the Fc region of immunoglobulin G (IgG).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>protein A</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13617 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13617">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multifunctional enzyme of azurophilic granules of neutrophils and monocytes and the major target of antineutrophil cytoplasmic autoantibodies (ANCA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PR3</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>PR3 autoantibodies are diagnostic markers for Wegener granulomatosis (WG) and are involved in the pathogenesis of this disease. They are also found in patients with other autoimmune systemic vasculitic diseases.</rdfs:comment>
        <rdfs:label>proteinase 3</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12896"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13782"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13617"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PR3</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13618 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13618">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Streptococcal cell wall protein that binds to the Fc region of immunoglobulin G (IgG), with a wider species specificity than protein A.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>protein G</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13616"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13619 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13619">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a kinase family with broad substrate specificity, activated by calcium, diacylglycerol, and (or) phorbol 12-myristate 13-acetate (PMA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PKC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is activated during B-lymphocyte and T-lymphocyte activation.</rdfs:comment>
        <rdfs:label>protein kinase C</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13566"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13619"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PKC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13620 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13620">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of immunoprecipitation or agglutination that occurs when antibody concentration is increased to an extent that the antibody is in such excess that it is no longer able to effectively cross-link the antigen. A similar phenomenon may occur in antigen excess.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>prozone effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13621 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13621">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammatory or anaphylactic reaction with symptoms similar to an allergy but not involving an antigen-specific immune response, e.g., salicylate intolerance, reaction to contrast reagents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>pseudoallergic reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Causes include direct histamine release and/or complement activation.</rdfs:comment>
        <rdfs:label>pseudoallergy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12871"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13622 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13622">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin disorder that has a hereditary component and is characterized by erythematous patches covered with silvery scales, especially on the elbows, knees, and scalp.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Psoriasis is associated with excessively rapid proliferation of keratinocytes which mature in less than a week.</rdfs:comment>
        <rdfs:label>psoriasis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13359"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13623 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13623">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, relating to, or associated with psoriasis; affected with psoriasis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>psoriatic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13622"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13624 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13624">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Partially purified derivative of tuberculin used in the Mantoux test for tuberculosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>PPD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>purified protein derivative</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13757"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13624"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PPD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13625 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13625">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Purple discoloration occurring in patches on the skin, mucus membranes, or organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>purpura</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13250"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13626 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13626">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any substance that produces fever.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pyrogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13627 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13627">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of various tests used to determine whether an agent, usually an infusion or injection fluid, is free of pyrogens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>pyrogen test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13112"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13387"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13628 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13628">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>&apos;Non-classical&apos; major histocompatibility complex (MHC) class I molecule in mice.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Qa antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13629 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13629">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for quantifying an antigen by measuring the diameters of circular precipitates around an antigen-spiked cavity in an antibody-containing agar gel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Mancini immunodiffusion</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radial immunodiffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13630 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13630">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid-phase radioimmunoassay (RIA) for detecting immunoglobulin E (IgE) antibody specific for a particular antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>RAST</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radioallergosorbent test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13630"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RAST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13631 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13631">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biochemical conjugate consisting of an immune-targeting molecule such as an antibody or antibody fragment together with a cytotoxic radionuclide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>radioimmunoconjugate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13632 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13632">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intermittent bilateral attacks of vasospasm and ischemia of the fingers or toes and sometimes of the ears and nose, marked by a severe pallor and often accompanied by paresthesia and pain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It is brought on characteristically by cold or emotional stimuli and relieved by heat, and may be due to an underlying disease or anatomic abnormality.</rdfs:comment>
        <rdfs:comment>The phenomenon is more common in women than men and occurs in most patients with progressive systemic sclerosis (SSc), mixed connective tissue disease (MCTD), and polymyositis/scleroderma overlap syndrome.</rdfs:comment>
        <rdfs:comment>When the condition is idiopathic or primary, it is termed Raynaud disease.</rdfs:comment>
        <rdfs:label>Raynaud phenomenon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13249"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13465"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13609"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13633 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13633">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Syndrome characterized by reversible airflow limitation and complicating bronchial hyperresponsiveness induced by acute exposure to high concentrations of non-sensitizer irritant gases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>RADS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>reactive airways dysfunction syndrome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13633"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RADS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13634 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13634">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intermediates in the reduction of molecular dioxygen, \(\ce{O2}\), to water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>ROS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>reactive oxygen intermediate (ROI)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>reactive oxygen species</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13634"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ROS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13635 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13635">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Historic term for antibodies of the immunoglobulin E (IgE) class.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>reagin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13288"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13636 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13636">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance recognized by memory cells that stimulates rapid (secondary) immune responses, often associated with hypersensitivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>recall antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13452"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13662"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13637 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13637">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody fragment manufactured by use of genetically modified microorganisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>recombinant antibody</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13638 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13638">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene whose products are involved in V(D)J recombination in B cells and T cells. Two such genes that have been identified are RAG-1 and RAG-2.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>RAG</oboInOwl:hasRelatedSynonym>
        <rdfs:label>recombination-activating gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13638"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RAG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13639 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13639">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any conserved heptamer (7-nucleotide)-nonamer (9-nucleotide) sequence, separated by a 12 or 23 base spacer, which occurs 3′ of variable gene segments, 5′ and 3′ of diversity gene segments, and 5′ of joining gene segments, in both immunoglobulin (Ig) and T-cell receptor (TCR) genes. It functions as a recognition sequence for the recombinase enzymes that mediate the gene rearrangement process involved in the generation of lymphocyte antigen receptor diversity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>RSS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>recombination signal sequence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12891"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13639"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RSS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13640 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13640">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parenchymal tissue of the spleen consisting of cords of cells and sinuses infiltrated with erythrocytes and responsible for removal of aged or damaged erythrocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>splenic pulp</oboInOwl:hasRelatedSynonym>
        <rdfs:label>red pulp</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13785"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13641 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13641">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large transformed lymphocyte, often binucleate, considered pathognomonic of Hodgkin lymphoma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Reed–Sternberg cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13220"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13642 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13642">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemokine secreted by T cells and macrophages upon stimulation by mitogens, which acts as a chemoattractant and stimulates eosinophils and basophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>RANTES</oboInOwl:hasRelatedSynonym>
        <rdfs:label>regulated upon activation normal T cell expressed and secreted</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13461"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RANTES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13643 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13643">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antibody or T-cell receptor (TCR) idiotope capable of regulating immune responses via interaction with lymphocytes bearing complementary idiotopes (anti-idiotopes).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>regulatory idiotope</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13644 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13644">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T cell that controls the maintenance of normal immune homeostasis. Treg cells are involved in controlling (anergizing or counter-regulating) autoreactive cells that escaped from thymic negative selection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Treg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>natural regulatory T cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>regulatory T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12977"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13503"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13734"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13644"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Treg</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13645 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13645">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immune response leading to destruction of a transplanted organ or tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>transplant rejection</oboInOwl:hasRelatedSynonym>
        <rdfs:label>rejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13009"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13179"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13646 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13646">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generation of cytotoxic superoxide from dioxygen due to increased NADPH oxidase activity, typically occurring in activated neutrophils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>NADPH oxidase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oxidative burst</oboInOwl:hasRelatedSynonym>
        <rdfs:label>respiratory burst</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13071"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13510"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13511"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13647 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13647">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test of the ability of a substance to induce hyperreactivity in the airways, typically measured as an increase in the rate of respiration of guinea pigs during inhalation of the substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>respiratory hypersensitivity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13240"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13648 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13648">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-throughput procedure where information on potential immunogenic tumor proteins is gained from the amino acid sequences of gene products specifically expressed by the tumor, followed by predicted fitting of putative antigenic peptides to a peptide-binding groove, and finally experimental verification.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>reverse immunology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13548"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13650 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13650">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammatory disease that may develop following a streptococcal infection such as strep throat, and may affect the heart, joints, skin, and brain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>rheumatic fever</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13651 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13651">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Episodic inflammatory systemic disease with autoimmune pathogenetic mechanisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>RA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It primarily affects the joints, causing symmetrical lesions and severe damage to the affected joints. RA is the most common form of inflammatory joint disease (prevalence about \(\pu{0.5}\) to \(\pu{1\%}\)).</rdfs:comment>
        <rdfs:label>rheumatoid arthritis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13652 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13652">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunoglobulins IgM, IgG, and IgA autoantibodies to the Fc region of IgG.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Although detectable in various diseases, rheumatoid factor is used as a classification criterion of rheumatoid arthritis (RA).</rdfs:comment>
        <rdfs:label>rheumatoid factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13137"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13292"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13293"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13497"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13653 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13653">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the mucous membrane of the nose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>rhinitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13654 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13654">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nasal discharge resulting from an allergic response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>allergic rhinitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13655 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13655">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique in which a test antigen is electrophoretically driven through an antibody-containing gel. The rocket-shaped tails of precipitation give information on the antigen concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>rocket electrophoresis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13656 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13656">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particles or cells bound to the surface of a lymphocyte (e.g., sheep erythrocytes around a human T cell).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>rosette</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13657 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13657">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Single-chain molecule composed of the variable (V) regions of an antibody heavy and light chain joined together by a flexible linker.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>scFv</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13658 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13658">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic, progressive, generalized granulomatous reticulosis of unknown etiology, involving almost any organ or tissue, including the skin, lungs, lymph nodes, liver, spleen, eyes, and small bones of the hands and feet. It is characterized histologically by the presence in all affected organs or tissues of noncaseating epithelioid cell tubercles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>sarcoid</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>There is usually diminished or absent reactivity to tuberculin, and in most active cases, a positive Kveim reaction.</rdfs:comment>
        <rdfs:label>sarcoidosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13659 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13659">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell surface receptor, for example on phagocytes, which recognizes cells or molecules that require clearance from the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>scavenger receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13660 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13660">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic progressive autoimmune disease characterized by systemic fibrosis and vascular changes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>There are two types: progressive systemic sclerosis, and a more limited and less rapidly progressive form known as CREST syndrome, referring to Calcinosis, Raynaud phenomenon, Esophageal dysfunction, Sclerodactyly, and Telangiectasias.</rdfs:comment>
        <rdfs:label>scleroderma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13609"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13632"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13661 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13661">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Second exposure of primed lymphocytes to a given antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>secondary challenge</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13662"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13662 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13662">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualitatively and quantitatively improved immune response that occurs upon the second encounter of primed lymphocytes with a given antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>secondary immune response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13663 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13663">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue (organ) in which antigen-driven proliferation and differentiation of mature B and T lymphocytes take place following antigen recognition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>secondary lymphoid organ</oboInOwl:hasRelatedSynonym>
        <rdfs:label>secondary lymphoid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13448"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13474"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13664 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13664">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Accelerated rejection of an allograft in a primed recipient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>second set rejection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12863"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13607"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13665 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13665">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proteolytic cleavage product of the poly-Ig receptor which remains associated with dimeric immunoglobulin A (IgA) in sero-mucus secretions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>secretory component</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13666 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13666">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dimeric immunoglobulin A (IgA) found in sero-mucus secretions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>IgA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>secretory immunoglobulin A</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13666"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IgA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13667 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13667">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of cell-surface adhesion molecules found on leukocytes and endothelial cells and that bind to sugars on glycoproteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>selectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13668 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13668">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Most common form of primary immunodeficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SIgAD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Autoimmunity is the most prevalent manifestation of this deficiency. Individuals with SIgAD have an increased risk of developing systemic [e.g., systemic lupus erythematosus (SLE), rheumatoid arthritis (RA)] and organ-specific (e.g., celiac disease) autoimmune disorders.</rdfs:comment>
        <rdfs:label>selective IgA deficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12992"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SIgAD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13669 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13669">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific immunological unresponsiveness to a defined autoantigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Breaking self-tolerance may lead to pathological autoimmunity and development of autoimmune disease.</rdfs:comment>
        <rdfs:comment>Primary (clonal deletion, anergy, clonal indifference) and secondary or regulatory (interclonal competition, suppression, immune deviation, vetoing, feedback regulation by the idiotypic network) mechanisms are involved in the induction and maintenance of self-tolerance.</rdfs:comment>
        <rdfs:label>self-tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12875"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13013"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13015"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13253"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13259"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13780"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13670 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13670">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spread of bacteria or bacterial products throughout the blood, eliciting a life-threatening, systemic inflammatory reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>sepsis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13671 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13671">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The appearance in the blood serum of detectable antibodies against a specific infectious agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>seroconversion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13672 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13672">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of serum, especially blood serum, frequently used to detect antibodies to microorganisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>serology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13673 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13673">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypersensitive reaction to the administration of a foreign serum, characterized by fever, swelling, skin rash, and enlargement of the lymph nodes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>serum sickness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13397"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13674 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13674">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunodeficiency affecting both T and B lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SCID</oboInOwl:hasRelatedSynonym>
        <rdfs:label>severe combined immunodeficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13674"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCID</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13675 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13675">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-cell-dependent target antigen often used in hemolytic plaque assays of immune responsiveness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SRBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SRBC antigen</oboInOwl:hasRelatedSynonym>
        <rdfs:label>sheep red blood cell antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13675"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SRBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13676 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13676">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a large family of lectins that bind sialylated glycans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SIGLEC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most are associated with cells of the immune system.</rdfs:comment>
        <rdfs:label>signaling lectin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13676"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SIGLEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13677 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13677">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any sequence of amino acid residues that, when linked to a newly synthesized protein, identifies it to transport mechanisms that guide the protein to a specific location among the organelles of a eukaryotic cell, or from the cytoplasm to the periplasmic space of prokaryotic cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>signal sequence</oboInOwl:hasRelatedSynonym>
        <rdfs:label>signal peptide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13678 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13678">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of cytoplasmic proteins that act as second messengers to activate gene transcription in response to cytokines and growth factors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>STAT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>signal transducer and activator of transcription</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13350"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13678"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STAT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13679 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13679">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small antibody construct in which the variable fragment (Fv) [see variable (V) region] of a heavy chain is linked via a synthetic peptide to the variable fragment of a light chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SCA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>single-chain antibody</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13142"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13679"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13680 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13680">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic inflammation of the lachrymal and salivary glands, often accompanied by rheumatoid arthritis (RA) and the presence of autoantibodies in the blood, occurring chiefly among women.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Two types of Sjögren syndrome are distinguished: a primary (isolated) type and a secondary type associated with another underlying autoimmune disease [e.g., RA, systemic lupus erythematosus (SLE), systemic sclerosis (SSc), primary biliary cirrhosis (PBC), autoimmune hepatitis (AIH), multiple sclerosis, autoimmune thyroiditis, etc.]. Ro/SS-A and La/SS-B autoantibodies are used as classification criteria.</rdfs:comment>
        <rdfs:label>Sjögren syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12921"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13600"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13741"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13681 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13681">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Skin-associated cells that participate in an immune response, including Langerhans cells, dendritic cells, and keratinocytes (mainly responsible for production of cytokines).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SIS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>skin immune system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13087"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13359"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13373"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13681"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SIS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13682 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13682">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any test used to study skin hypersensitivity such as the guinea pig maximization test or the Buehler test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>skin sensitization test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12964"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13188"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13683 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13683">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure for evaluating immunity status, involving the introduction of a reagent into or under the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>skin test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13684 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13684">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of leukotrienes released by mast cells during anaphylaxis, which induces a prolonged contraction of smooth muscle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SRS-A</oboInOwl:hasRelatedSynonym>
        <rdfs:label>slow-reacting substance of anaphylaxis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12874"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13384"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13684"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SRS-A</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13685 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13685">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of monomeric G proteins, with molecular mass typically \(\pu{20\!{-}\! 40 kDa}\), that also bind guanine nucleotides and are involved in signal transduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>small G protein</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13686 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13686">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein from the shell of the bacteriophage T4, commonly used in construction of phage antibody libraries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SOC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SOC protein</oboInOwl:hasRelatedSynonym>
        <rdfs:label>small outer capsid protein</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13686"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SOC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13687 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13687">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that very few immunoglobulins (Ig) are inherited, but that extensive antibody diversity arises from mutations in non-reproductive cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>somatic diversification theory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13689"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13688 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13688">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonreciprocal exchange of nucleic acid sequences between genes in which part of the donor gene or genes is &apos;copied&apos; into an acceptor gene, but only the acceptor gene is altered.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>This exchange is a mechanism for generating a diverse immunoglobulin (Ig) repertoire in many non-human species.</rdfs:comment>
        <rdfs:label>somatic gene conversion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13689 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13689">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process giving rise to increased antibody diversity by cutting and splicing immunoglobulin (Ig) genes during lymphocyte differentiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>somatic recombination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13025"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13690 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13690">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Largest of the secondary lymphoid organs, composed of white pulp, rich in lymphoid cells, and red pulp, which contains many erythrocytes and macrophages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The spleen traps damaged erythrocytes carried in the blood.</rdfs:comment>
        <rdfs:label>spleen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13663"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13785"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13691 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13691">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of, pertaining to, connected with, or situated in the spleen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>splenic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13692 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13692">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any splenic cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>splenocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13691"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13693 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13693">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for allergic contact dermatitis in which guinea pig skin is exposed to repeated applications of a test substance and intradermal injections of complete Freund’s adjuvant are administered separately.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>split adjuvant technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13041"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13160"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13694 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13694">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammation of the vertebral column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>spondylitis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13695 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13695">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune thyroiditis (see thyroiditis, autoimmune) that develops spontaneously (without any apparent cause or manipulation) in certain strains of mice and rats (e.g., NOD mice, BB and BUF rats) as well as in other animals (e.g., OS chickens, marmoset monkeys, beagles).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SAT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>spontaneous autoimmune thyroiditis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13515"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13741"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13695"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13696 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13696">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Allergic reaction, often to a medication (see adverse drug reaction) or infection, characterized by blistering of the skin and ulceration of mucosal membranes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>bullous erythema multiforme</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Stevens–Johnson syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13697 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13697">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Supporting tissue of an organ.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>stroma</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13698 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13698">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic remitting form of dermatitis characterized by severe photosensitivity and Ro/SS-A and La/SS-B autoantibodies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SCLE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>subacute cutaneous lupus erythematosus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13089"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13698"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13699 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13699">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen which reacts with all the T cells belonging to a particular T-cell receptor (TCR) variable (V) region family, and which therefore stimulates (or deletes) a much larger number of cells than does conventional antigen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>superantigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13700 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13700">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large group of proteins related by structural homology and function. The term also refers to the genes that encode them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>superfamily</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13701 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13701">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dominant immunological tolerance, a phenomenon that plays an active role in regulating T-cell and B-cell responses to both foreign antigens and autoantigens.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>The downregulation of responses to autoantigens is a major regulatory mechanism involved in the induction and maintenance of self-tolerance.</rdfs:comment>
        <rdfs:label>suppression</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13669"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13702 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13702">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T cell that suppresses the immune response of B cells and other T cells to an antigen. In more current usage classified as a regulatory T cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>suppressor T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>suppressor T lymphocyte</oboInOwl:hasRelatedSynonym>
        <rdfs:label>suppressor cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13703 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13703">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of molecules forming at the contact point of a T cell and an antigen-presenting cell (APC), enriched in T-cell receptor (TCR), adhesion molecules, and signaling molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SMAC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>supramolecular adhesion complex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12888"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13703"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SMAC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13704 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13704">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Light chain-like structure formed when the proteins encoded by the \({\rm{V}}_{\rm{preB}}\) and \(\uplambda_{5}\) genes associate with each other. It can form immunoglobulin (Ig)-like complexes which are expressed on the surface of pre-B cells at different stages of development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>surrogate light chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13595"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13705 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13705">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly conserved repetitive sequence that mediates class switching in the immunoglobulin (Ig) heavy chain gene locus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>switch region</oboInOwl:hasRelatedSynonym>
        <rdfs:label>switch sequence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13010"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13706 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13706">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune injury to one eye that occurs after penetrating injury or surgery to the other eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>sympathetic ophthalmia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12918"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13707 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13707">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Genetically identical, e.g., a fully inbred strain of mice.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>A practical consequence is that cells can be transferred to other syngeneic animals without rejection.</rdfs:comment>
        <rdfs:label>syngeneic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13708 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13708">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>1) Relating to the body as a whole. 2) Occurring at a site in the body remote from the point of contact with a substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>systemic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13709 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13709">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoimmune disease affecting a number of organs or tissues, or the whole body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>systemic autoimmune disease</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13710 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13710">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chronic autoimmune disease that is potentially debilitating and sometimes fatal as the immune system attacks the body’s cells and tissues, with inflammation and tissue damage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SLE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lupus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lupus erythematosus</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>SLE can affect any part of the body, but most often harms the heart, joints, skin, lungs, blood vessels, liver, kidneys, and nervous system. The course of the disease is unpredictable, with periods of illness (called flares) alternating with remission. SLE can occur at any age, and is most common in women, particularly of non-European descent.</rdfs:comment>
        <rdfs:comment>The disease is very heterogeneous in clinical expression and serological factors. Autoantibodies directed against nuclear components [antinuclear antibodies (ANA)] are typically detected. Anti-dsDNA, anti-Sm, and antiphospholipid antibodies are used as classification criteria.</rdfs:comment>
        <rdfs:label>systemic lupus erythematosus</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12898"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13710"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13711 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13711">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fibrosing disease of unclear etiology that affects multiple organ systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>SSc</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Anticentromere antibodies (ACA) as well as autoantibodies against DNA topoisomerase I (scl-70) and various nucleolar antigens are diagnostic and prognostic markers and are often detectable years before disease manifestation. They are also detectable in quartz dust-exposed individuals.</rdfs:comment>
        <rdfs:comment>The skin (&quot;scleroderma&quot;) and blood vessels (arteries, small vessels) are most commonly affected, but involvement of the lungs and gastrointestinal tract (esophagus) may also be observed.</rdfs:comment>
        <rdfs:label>systemic sclerosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13660"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13711"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SSc</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13712 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13712">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-memory cell that is specific for a drug allergen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>drug-specific T cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>drug-specific T cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12857"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13452"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13713 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13713">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunotoxicity test that evaluates the ability of animals to produce antibodies to a T-dependent antigen [e.g., sheep red blood cells (SRBCs) or keyhole limpet hemocyanin (KLH)].</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TDAR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>T-cell-dependent antibody response</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13323"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13675"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13715"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13713"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TDAR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13714 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13714">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen-specific receptor on T cells composed of one set of heterodimeric chains. Two types of TCR heterodimers are known (\(\upalpha/\upbeta\) and \(\upgamma/\updelta\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TCR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Functional binding for TCR requires a complex of major histocompatibility complex (MHC) molecule, antigenic peptide, and TCR.</rdfs:comment>
        <rdfs:label>T-cell receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TCR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13715 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13715">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that requires helper T lymphocytes (Th) in order to elicit an antibody response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>T-dependent antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13716 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13716">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for detecting apoptotic cells in situ based on characteristic DNA fragmentation. It is based on the ability of terminal deoxynucleotidyl transferase (TdT) to transfer a labeled deoxyuridine triphosphate to the terminal ends arising from DNA cleavage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TUNEL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TUNEL assay</oboInOwl:hasRelatedSynonym>
        <rdfs:label>TdT-dependent dUTP-biotin nick end labeling assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13728"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13716"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TUNEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13717 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13717">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th) with a less restricted cytokine profile than Th1 and Th2 cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Th0-like responses are observed in patients with rheumatoid arthritis (RA), Sjögren syndrome, and Graves disease.</rdfs:comment>
        <rdfs:label>Th0 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13187"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13651"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13680"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13719"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13718 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13718">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th) producing mainly interleukin-2 (IL-2), interferon (IFN-$\ce{\upgamma\!}$), and tumor necrosis factor $\ce{\upbeta\!}$ ($\ce{TNF\mbox{-}\upbeta\!}$), and thereby responsible for phagocyte-dependent host responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Th1-dominated responses are seen in autoimmune diseases in which cytotoxic T cells and macrophages play a major role, e.g., multiple sclerosis, diabetes mellitus type 1, Hashimoto thyroiditis, and Crohn disease. Switching from Th1 to Th2 response can prevent Th1-mediated tissue destruction in animal models.</rdfs:comment>
        <rdfs:label>Th1 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13053"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13092"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13195"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13421"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13560"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13719"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13719 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13719">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th) in mice producing interleukins IL-4, IL-5, IL-6, IL-9, IL-10, and IL-13.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Besides other effects, they provide optimal help for antibody responses. Th2 responses should also be regarded as an important downregulatory mechanism for exaggerated Th1 responses. Predominant Th2 cytokine profile is observed in patients with atopic disorders and graft-versus-host disease (GVHD).</rdfs:comment>
        <rdfs:label>Th2 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12910"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13180"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13720 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13720">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th) producing and responding to transforming growth factor $\ce{\upbeta\!}$ ($\ce{TGF\mbox{-}\upbeta\!}$) and helping immunoglobulin A (IgA) antibody responses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Th3 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13286"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13752"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13721 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13721">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th) producing interleukin IL-9, which stimulates mast cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Th9 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13442"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13722 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13722">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helper T lymphocyte (Th), distinct from Th1 and Th2 cells, that secretes the interleukin IL-17.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>T17</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>T17 lymphocytes are thought to play an important role in autoimmune disease.</rdfs:comment>
        <rdfs:label>Th17 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13199"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13338"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13719"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13722"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>T17</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13723 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13723">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that is able to elicit an antibody response in the absence of T cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>T-independent antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13724 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13724">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lymphocyte that matures in the thymus and has the ability to recognize specific peptide antigens through the receptors on its cell surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>T cell</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>T-cell receptor (TCR) molecules are specific for complexes comprising short peptides bound to and presented by major histocompatibility complex (MHC) molecules.</rdfs:comment>
        <rdfs:label>T lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13725 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13725">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T lymphocyte that regulates Th1 cell responses. It resembles the regulatory T cell (Treg) and is possibly related to the Th3 cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>It is abundant in the intestine and may be involved in tolerance to dietary antigens.</rdfs:comment>
        <rdfs:label>Tr1 cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13644"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13720"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13726 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13726">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecular construct with two fluorochromes where the first excites the second by its emission.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Used in flow cytometry analysis.</rdfs:comment>
        <rdfs:label>tandem conjugate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13727 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13727">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell killed by one of the body’s killer cells, such as a cytotoxic T lymphocyte or natural killer (NK) cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>target cell</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13072"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13728 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13728">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that inserts non-coded nucleotides at the junctions of V, D, and J gene segments of immunoglobulin (Ig) and T-cell receptor (TCR) locus DNA, thus increasing the diversity of antigen-specific recognition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TDT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>terminal deoxynucleotidyl transferase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13728"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TDT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13729 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13729">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detoxified tetanus toxin used to produce active immunity (see active immune response) against tetanus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>tetanus toxoid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12835"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13730 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13730">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique used for selective staining of antigen-specific T lymphocytes in vitro or in situ. The antigen is presented to T cells by peptide tetramer constructs of major histocompatibility (MHC) class I molecules. It is also used to isolate antigen-specific T-cell populations for clonal expansion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>tetramer staining</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13014"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13546"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13731 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13731">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ectopic lymphoid aggregates that accumulate during the process of chronic immune stimulation, and exhibit characteristics usually associated with the secondary lymphoid organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Tertiary Lymphoid Organ</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tertiary lymphoid tissue</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13663"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13732 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13732">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of several substances (predominantly thromboxanes A2 and B2) synthesized by platelets from arachidonic acid precursor, that cause vasoconstriction of vascular and bronchial smooth muscle and facilitates platelet aggregation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>thromboxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13580"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13733 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13733">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oral infection with Candida albicans, often in patients with immunosuppression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>thrush</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13734 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13734">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the thymus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>thymic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13735 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13735">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Involution of the thymus gland leading to a diminished capacity to generate new T cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>thymic atrophy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13736 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13736">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which T cells, developing in the thymus, are screened for potentially harmful self-reactive T cells (which are removed), while potentially beneficial T cells are promoted.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>thymic education</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13737 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13737">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rare, usually benign, tumor arising from tissue of the thymus gland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Thymoma is often associated with myasthenia gravis.</rdfs:comment>
        <rdfs:label>thymoma</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13481"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13738 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13738">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that requires the participation of T lymphocytes to elicit an immune response in B lymphocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TD antigen</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thymus-dependent antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13738"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13739 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13739">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen that does not require the participation of T lymphocytes to elicit an immune response in B cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>thymus-independent antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13740 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13740">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Glycoprotein secreted by thyroid follicular cells that is a major autoantigen in autoimmune diseases of the thyroid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TG</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Thyroglobulin autoantibodies are found in patients with autoimmune thyroiditis, and Graves disease.</rdfs:comment>
        <rdfs:label>thyroglobulin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13187"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13741"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13740"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13741 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13741">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inflammatory destruction of the thyroid gland (ranging from a mild focal thyroiditis to extensive lymphocytic infiltration and scarring) often associated with goiter and hypothyroidism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>autoimmune thyroiditis</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The most common types of autoimmune thyroiditis are Hashimoto thyroiditis and atrophic thyroiditis.</rdfs:comment>
        <rdfs:label>autoimmune thyroiditis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13195"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13742 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13742">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Main autoantigenic target in patients with Graves disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TSHR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most TSHR autoantibodies are stimulatory, acting as agonists of thyroid-stimulating hormone, but receptor-blocking antibodies are also found.</rdfs:comment>
        <rdfs:label>thyroid-stimulating hormone receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13187"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13742"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TSHR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13743 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13743">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thyroid enzyme that is a major autoantigen in autoimmune diseases of the thyroid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TPO</oboInOwl:hasRelatedSynonym>
        <rdfs:label>thyroid peroxidase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12919"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13743"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TPO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13744 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13744">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Main target of autoantibodies in celiac disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TTG</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tissue transglutaminase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12992"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13744"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TTG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13745 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13745">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reciprocal of the highest dilution of a titration of an antigen with an antibody that gives a measurable effect (e.g., agglutination), and thus an empirical measure of the avidity of an antibody.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>titer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13746 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13746">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen used to induce tolerance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Induction depends strongly on the circumstances of administration (e.g., route and concentration) in addition to any inherent property of the molecule.</rdfs:comment>
        <rdfs:label>tolerogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13747 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13747">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a family of pattern recognition receptors involved in the detection of structures associated with pathogens or damaged host tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TLR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toll-like receptor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13543"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13747"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TLR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13748 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13748">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A severe form of Stevens–Johnson syndrome with extensive detachment of the skin, often as a result of an allergic adverse drug reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Lyell syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TEN</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxic epidermal necrolysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12851"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13696"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13748"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TEN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13749 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13749">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systemic reaction produced by the toxin derived from the bacterium Staphylococcus aureus; the toxin acts as a superantigen, which activates a high proportion of CD4+ T lymphocytes to produce cytokines.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>toxic shock syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13699"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13750 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13750">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemically or physically modified toxin that is no longer harmful but retains immunogenicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>toxoid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13751 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13751">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vesicular transport of macromolecules from one side of a cell to the other, through the cell’s interior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>transcytosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13752 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13752">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Secreted member of the protein superfamily of the same name that functions in controlling the cell cycle and apoptosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TGF-β</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>TGF-β is involved in several aspects of regulation of the immune system and blocks activation of lymphocytes and macrophages.</rdfs:comment>
        <rdfs:label>transforming growth factor β</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13424"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13700"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13752"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TGF-β</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13753 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13753">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transference of blood or blood-based products from one individual into the circulation of another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>blood transfusion</oboInOwl:hasRelatedSynonym>
        <rdfs:label>blood transfusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13754 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13754">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Grafting solid tissue (e.g., cornea) or organ (e.g., kidney or heart), or cells (particularly bone marrow), from one individual to another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>transplantation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12863"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12959"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13790"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13755 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13755">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecules that carry antigenic peptides from the cytoplasm into the lumen of the endoplasmic reticulum for incorporation into major histocompatibility (MHC) class I molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>transporters associated with antigen processing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13431"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13756 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13756">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Essential amino acid for humans, and required for T-cell proliferation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>(2S)-2-amino-3-(1H-indol-3-yl)propanoic acid</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tryptophan</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13329"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13757 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13757">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen found in extracts of Mycobacteria, used in a skin test for tuberculosis (Mantoux test).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>tuberculin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13683"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13758"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13758 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13758">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diagnostic test in which antigens derived from the organism causing tuberculosis (Mycobacterium tuberculosis) are injected subcutaneously; individuals who have been exposed to the organism develop a delayed-type hypersensitivity (DTH) response at the injection site \(\pu{24}\) to \(\pu{48 h}\) later.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Mantoux test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Those who have been previously vaccinated with bacille Calmette–Guérin (BCG) also show a positive response.</rdfs:comment>
        <rdfs:label>tuberculin test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12940"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13085"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13759 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13759">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen whose expression is associated with tumor cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>tumor antigen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13760 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13760">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of immunology to understanding tumor biology, immune system avoidance by tumors, and immunotherapy directed against tumors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>tumor immunology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13303"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13322"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13761 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13761">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mononuclear lymphocyte derived from the inflammatory infiltrate of a solid tumor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TIL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tumor-infiltrating lymphocyte</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13761"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TIL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13762 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13762">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Protein produced and secreted by several of the body’s cell types, including leukocytes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TNF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TNF-α</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cachectin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cachexin</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Activation of the \(\ce{TNF\mbox{-}\upalpha}\) receptor may trigger apoptosis through the extrinsic pathway.</rdfs:comment>
        <rdfs:comment>It promotes the destruction of some types of cancer cells and is a cytokine involved in systemic inflammation.</rdfs:comment>
        <rdfs:label>tumor necrosis factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13065"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13708"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TNF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13763 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13763">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Family of proteins involved in regulating inflammation and apoptosis through interaction with the tumor necrosis factor receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>tumor necrosis factor receptor-associated factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13762"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13764 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13764">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen present specifically on a tumor cell that may target it for destruction by the immune system or for antibody therapy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TRA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tumor rejection antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12881"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13764"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TRA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13765 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13765">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Antigen, present only on a tumor cell, and targetable by the immune system or by antibody therapy in order to destroy the tumor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>TSTA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tumor-specific transplantation antigen</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13765"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TSTA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13766 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13766">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any member of a family of enzymes that phosphorylates target proteins on tyrosine residues, thus playing a crucial role in signal transduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>protein tyrosine kinase</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Tyrosine kinases play a key role in lymphocyte activation. Major tyrosine kinases involved in T lymphocyte activation are Lck, Fyn, and ZAP-70; those involved in B lymphocyte activation are Blk, Fyn, Lyn, and Syk.</rdfs:comment>
        <rdfs:label>tyrosine kinase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13792"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13767 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13767">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highly conserved 76 amino acid peptide abundant in eukaryotic cells. Its covalent attachment to a protein by a ubiquitin ligase complex targets that protein for destruction by the proteasome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>ubiquitin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13613"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13768 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13768">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inability to respond to an antigenic stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Unresponsiveness may be specific for a particular antigen (see tolerance), or broadly nonspecific as a result of damage to the entire immune system, for example, after whole-body irradiation.</rdfs:comment>
        <rdfs:label>unresponsiveness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12885"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13271"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13302"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13769 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13769">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Preferential partnering of \(\ce{J\upalpha\ gene}\) segments with \(\ce{V\upalpha\ gene}\) segments during rearrangement in the T-cell receptor (TCR) gene, possibly following deletion of the \(\ce{V\updelta\ gene}\) region.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Vα-Jα rearrangement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13770 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13770">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mechanism for generating antigen-specific receptors of T cells and B cells; it involves the joining of V, D, and J gene segments, mediated by the enzyme complex V(D)J recombinase, and products of the recombination-activating genes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Recombination occurs only once in a cell’s lifetime.</rdfs:comment>
        <rdfs:comment>The conventional syntax V(D)J indicates that V and J genes code the light chain and all three genes code the heavy chain, the processes being VJ and VDJ recombination, respectively.</rdfs:comment>
        <rdfs:label>V(D)J recombination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13386"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13638"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13689"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13771 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13771">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Immunization with a vaccine against a pathogen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>vaccination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13772 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13772">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gene, segment(s) of which rearrange together with diversity (D) gene and joining (J) gene segments in order to encode the variable (V) region amino acid sequences of immunoglobulins (Ig) and T-cell receptors (TCRs).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>V Gene</oboInOwl:hasRelatedSynonym>
        <rdfs:label>variable gene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13098"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13773"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13773 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13773">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>N-terminal portion of an immunoglobulin (Ig) or T-cell receptor (TCR) that contains the antigen-binding region of the molecule. V regions are formed by the recombination of V(D) and J gene segments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>V domain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>V region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>variable domain</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The V region consists of two V domains, \({\rm{V}}_{\rm{L}}\) and \({\rm{V}}_{\rm{H}}\).</rdfs:comment>
        <rdfs:label>variable region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13354"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13689"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13714"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13770"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell adhesion molecule present on the luminal surface of blood and lymph vessel endothelium, recognized by homing molecules that direct leukocytes to tissues with the appropriate &apos;address&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>vascular addressin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13379"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule, expressed on the surface of endothelial cells that functions in the adhesion of lymphocytes, monocytes, eosinophils, and basophils to vascular endothelium to the vascular surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD106</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VCAM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>vascular cell adhesion molecule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12848"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12943"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13117"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13467"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13775"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VCAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of disorders that share a common underlying problem of inflammation of a blood vessel or vessels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:comment>Vasculitis can lead to necrosis, fibrosis, or thrombosis. Autoimmunity plays an important role in some vasculitides (e.g., ANCA-associated vasculitis, Goodpasture syndrome, cryoglobulinemic vasculitis).</rdfs:comment>
        <rdfs:label>vasculitis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12897"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12925"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13061"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13178"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13777 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13777">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance containing amino group(s) that increases vascular permeability and smooth muscle contraction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>vasoactive amine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific antigen expressed on lymphocytes very soon after activation by phorbol myristate acetate (PMA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>CD69</oboInOwl:hasRelatedSynonym>
        <rdfs:label>very early activating antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13566"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-cell surface antigen, named for its delayed appearance after T-cell activation; a member of the integrin superfamily involved in cell adhesion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>VLA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>very late activation antigen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13779"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VLA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13780 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13780">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Elimination by apoptosis of a self-peptide-major histocompatibility complex (MHC) molecule recognizing lymphocyte by a self-peptide-presenting (veto) cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>vetoing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13434"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13781 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13781">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autoantibodies that react optimally at higher temperatures (\(\pu{37^{\circ}C}\)) with surface antigens of erythrocytes. They mediate autoimmune hemolytic anemia.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>warm autoantibody type</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12920"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13127"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13782 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13782">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Granulomatous inflammation involving the respiratory tract, and necrotizing vasculitis affecting small to medium-sized vessels (e.g., capillaries, venules, arterioles, and arteries).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>WG</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Necrotizing glomerulonephritis is common in WG.</rdfs:comment>
        <rdfs:label>Wegener granulomatosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13174"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13776"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13782"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13783 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13783">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Circumscribed papule or plaque of edema of the skin, occurring as an urticarial lesion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>wheal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13784 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13784">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dermatological reaction at a skin site where an antigen is injected into an allergic individual. The reaction is characterized by a &apos;flare&apos; of erythema and a wheal produced by serum exuding into tissue, causing local edema.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>wheal and flare</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12858"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13125"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13783"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13785 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13785">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collections of lymphocytes in the spleen, responsible for its immune function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>white pulp</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13272"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13399"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13640"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13690"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13786 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13786">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition characterized by chronic eczema, chronic suppurative otitis media, anemia, and thrombocytopenic purpura (accompanied by bloody diarrhea); it is an immunodeficiency syndrome transmitted as an X-linked recessive trait, in which there is poor antibody response to polysaccharide antigens and dysfunction of cell-mediated immunity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>eczema-thrombocytopenia-immunodeficiency syndrome</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Wiskott–Aldrich syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12995"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13107"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13250"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13281"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13787 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13787">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sex-linked impairment of the ability to produce mature B cells, thus characterized by recurrent infections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>Bruton agammaglobulinemia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bruton syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>agammaglobulinemia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>X-linked agammaglobulinemia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13448"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13788 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13788">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sex-linked trait carried on the X-chromosome of severe combined immunodeficiency syndrome resulting from nonfunctional B lymphocytes and lack of T lymphocytes and natural killer (NK) lymphocytes, leading to recurrent, persistent, and severe infections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <oboInOwl:hasRelatedSynonym>combined immunodeficiency</oboInOwl:hasRelatedSynonym>
        <rdfs:label>X-linked severe combined immunodeficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13674"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13789 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13789">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exhibiting genetic differences between species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>xenogeneic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13790 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13790">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue or organ graft between individuals of different species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>xenograft</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13791 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13791">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Autophagy selective for degradation of intracellular bacteria and viruses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>xenophagy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12929"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13792 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13792">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>T-lymphocyte-specific tyrosine kinase involved in T-lymphocyte activation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>Zeta chain-associated protein kinase-70 kDa</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13401"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13724"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13766"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13793 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13793">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crude preparation of yeast cell walls, consisting chiefly of polysaccharide, activating the alternative pathway of the complement system in the presence of properdin and used in the immunoassay of this compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-06-03"/>
        <rdfs:label>zymosan</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.12866"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13033"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13612"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13795 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13795">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance made up of molecules containing groups that are solvophilic and other groups that are solvophobic with respect to a given solvent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Depending upon the nature of the solvent, the solvophilic and solvophobic parts of the molecule may be ionic or non-ionic moieties.</rdfs:comment>
        <rdfs:comment>The term is most commonly applied to molecules in aqueous media within which the existence of distinct polar (hydrophilic) and nonpolar (hydrophobic) regions in the molecule promotes the formation of micelles, vesicles, or aggregates.</rdfs:comment>
        <rdfs:label>amphiphile</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13831"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13865"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13866"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13796 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13796">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amphiphile, the constituent molecules of which have solvophilic groups at each end of a solvophobic chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>boloamphiphile</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13865"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13866"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13797 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13797">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mesophase formed by varying the pressure at constant temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>barotropic mesophase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13798 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13798">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having a rod- or lath-like shape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>calamitic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13799 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13799">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Host-guest complex formed by a carcerand and a completely entrapped guest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>carceplex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13800"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13826"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13800 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13800">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Host molecule that completely entraps a guest molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>carcerand</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13827"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13801 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13801">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Self-assembly of two or more self-assembling species that might or might not incorporate a non-assembling component into an ordered structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>co-assembly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13802 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13802">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in conformation of a macromolecular chain in solution from that of a coil to a relatively compact structure in which the chain has collapsed upon itself in response to an external stimulus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>A coil-to-globule transition is the reverse of a globule-to-coil transition.</rdfs:comment>
        <rdfs:comment>Typical external stimuli may be temperature, \(\pu{pH}\), electrolyte concentration, or solvent composition.</rdfs:comment>
        <rdfs:label>coil-to-globule transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13825"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13803 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13803">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two- or three-dimensional ordered array of molecules or nanoparticles having a dimension roughly between \(\pu{1 nm}\) and \(\pu{1 \upmu m}\) in at least one direction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>colloidal crystal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13804 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13804">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cylindrical assembly of molecules within a distinct series of layers in which the axes of the molecules lie in the planes of the layers and are identically aligned and oriented in adjacent layers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>A columnar assembly of discotic molecules, called a columnar mesophase, a columnar discotic mesophase, or a columnar discotic, is one of the class of liquid crystal mesophases.</rdfs:comment>
        <rdfs:label>columnar phase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13811"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13805 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13805">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Core-shell structure formed by self-assembly of amphiphiles and subsequently covalently crosslinked through functionalities in the core.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Such structures are used, for example, for drug delivery and dye or adulterant encapsulation.</rdfs:comment>
        <rdfs:comment>The amphiphiles are often amphiphilic block copolymers</rdfs:comment>
        <rdfs:label>core-crosslinked micelle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13806"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13857"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13806 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13806">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecular entity of spherical, elliptical, or cylindrical symmetry in which the constitution of the interior, the core, differs from that of the external surface, the shell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>core-shell structure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13807 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13807">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interruption to the regular pattern of atomic arrangement in crystal lattices.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>crystallographic defect</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In this context, the terms are commonly shortened to &quot;defect&quot;.</rdfs:comment>
        <rdfs:label>crystal lattice defect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13808 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13808">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to assemblies of atoms, molecules, or ions with an overall three-dimensional order of cubic symmetry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>cubic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13809 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13809">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mesophase with an overall three-dimensional order of cubic symmetry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>cubic mesophase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13808"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13810 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13810">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Local symmetry axis for the singlet, orientational distribution of the molecules of a mesophase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>In uniaxial nematics, formed by compounds consisting of either rod- or disc-like molecules, the mean direction of the effective molecular symmetry axis coincides with the director.</rdfs:comment>
        <rdfs:comment>The director also coincides with a local symmetry axis of any directional property of the mesophase, such as the refractive index or magnetic susceptibility.</rdfs:comment>
        <rdfs:comment>The director is defined as a unit vector, but directions \(\boldsymbol{+n}\) and \(\boldsymbol{-n}\) are arbitrary.</rdfs:comment>
        <rdfs:label>director</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13811 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13811">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Having a disc-like shape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>discoid</oboInOwl:hasRelatedSynonym>
        <rdfs:label>discotic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13812 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13812">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mesogen composed of relatively flat, disc- or sheet-shaped molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>The adjective &quot;discotic&quot; is also employed to describe the nematic mesophases formed by discotic mesogens. The mesophases formed by a columnar stacking of disc-like molecules are described as columnar mesophases.</rdfs:comment>
        <rdfs:label>discotic mesogen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13813 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13813">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assembly or supramolecular assembly, the components of which are linked through reversible bondings that enable structural reassembly by reshuffling in response to changes in the chemical or physical environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>dynamer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13814 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13814">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer with constitutional units that are susceptible to a change in orientation under the influence of an electric field that causes the system to have induced polarity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>electroclinic polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13815 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13815">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Confinement of microscopic particles with a host.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>micro-encapsulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13816 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13816">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Confinement of an individual molecule within a larger molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>molecular encapsulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13817 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13817">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Field surrounding a molecular or ionic species emanating from a source external to that species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Fields include electromagnetic, hydrodynamic, mechanical, etc.</rdfs:comment>
        <rdfs:label>external field</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13818 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13818">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier indicating attraction to fluorous compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>fluorophilic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13822"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13819 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13819">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attractive interaction of fluorous structures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>fluorophilic interaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13822"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13820 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13820">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier indicating repulsion by fluorous compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>fluorophobic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13822"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13821 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13821">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Repulsive interaction of fluorous and non-fluorous structures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>fluorophobic interaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13822"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13822 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13822">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the presence of a sufficient number of carbon-fluorine bonds as to cause a substance to be insoluble in water or common organic solvents but soluble in fluorocarbons.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>fluorous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13823 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13823">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer or oligomer molecule that adopts a secondary structure stabilized by noncovalent interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>A helix, \(\ce{\upbeta\mbox{-}sheet}\), or globule are typical secondary structures.</rdfs:comment>
        <rdfs:label>foldamer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13824"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13824 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13824">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conformation of a macromolecule in which the constitutional units collectively arrange into a compact ovoid or spherical shape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>globule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13825 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13825">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reverse of a coil-to-globule transition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>globule-to-coil transition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13802"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13826 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13826">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complex formed by a hemicarcerand and an entrapped guest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>hemicarceplex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13799"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13827"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13827 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13827">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Host molecule that allows guest molecules to enter and exit its cavities in accordance with a change in the equilibrium conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>hemicarcerand</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13800"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13828 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13828">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Columnar mesophase characterized by a hexagonal packing of the molecular column.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>hexagonal mesophase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13804"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13829 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13829">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hexagonal array of holes in a polymer film.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>honeycomb polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A method that utilizes the condensation of micrometer-size water droplets on the surface of solutions of block copolymers for the preparation of ordered micrometer-size honeycomb structures has led to the use of the extended term, honeycomb polymer from breath figures.</rdfs:comment>
        <rdfs:comment>The cross-sectional dimensions of the holes of a hexagonal array are usually less than \(\pu{1 mm}\).</rdfs:comment>
        <rdfs:label>honeycomb polymer film</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13830 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13830">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attractive interaction between hydrophilic groups, molecules, or substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>hydrophilic interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13831 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13831">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier indicating capacity of a molecular entity or of a substituent to interact repulsively with polar molecules, in particular with water or with polar groups.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Literally translated as &quot;water hating&quot;.</rdfs:comment>
        <rdfs:label>hydrophobic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13832 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13832">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Colloidal crystal of spherical voids with a periodic structure within a solid polymer continuum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>An inverse opal is usually produced by assembling spheres, filling the interstitial spaces with solid, and removing the spheres.</rdfs:comment>
        <rdfs:label>inverse opal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13803"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13833 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13833">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organized structure extended in two dimensions and of uniform thickness resembling a thin layer, a plate, or a membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>lamella</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13834 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13834">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assembly of block copolymer molecules in which like blocks are segregated in lamella.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Individual lamellae are usually of a thickness of \(\pu{5\!-\! 100 nm}\).</rdfs:comment>
        <rdfs:label>lamellar block copolymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13833"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13835 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13835">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process whereby multilayered structures of molecules or particles of a substance are assembled on a solid substrate by sequential adsorption of monolayers held together by noncovalent interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Layer-by-layer assembly is often used to alternately transfer polyelectrolytes that are positively and negatively charged.</rdfs:comment>
        <rdfs:comment>The material at the liquid surface need not necessarily be present as a solid monolayer.</rdfs:comment>
        <rdfs:label>layer-by-layer assembly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13837 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13837">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Supramolecular structure in which molecules are linked only as a consequence of their topology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>mechanically interlocked molecular architecture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13838 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13838">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mesogen composed of molecules incorporating one or more metal atoms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>metallomesogen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13798"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13812"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13839 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13839">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rod-like mesogens with the capacity to form micellar aggregates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>micellar rod</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13840 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13840">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structure of material in which at least one of the features repeats over distances of the order of micrometers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>microstructure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13841 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13841">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technique to create templated cavities in polymer matrices with memory of the template molecules to be used in molecular recognition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>molecular imprinting</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13842 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13842">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region of a self-assembled entity with an equivalent diameter of approximately \(\pu{(1\!-\! 100) nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>nanodomain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13843 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13843">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer film that has lateral dimensions in the range of \(\pu{(1\!-\! 100) nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>nanoscopic polymer film</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13844 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13844">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier indicating tendency of a molecular entity or of a pendent group thereof to interact favourably with nonpolar organic solvents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>The term is especially used of colloids that form solvates in organic solvents and thereby swell.</rdfs:comment>
        <rdfs:label>organophilic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13845 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13845">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attractive interaction between organophilic molecules or materials.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>organophilic interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13846 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13846">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Order parameter applied to macroscopic assemblies of ordered materials, such as crystal assemblies in fibers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>orientation parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13847 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13847">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Oligomeric or polymeric offshoot from a macromolecular chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>branch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>side-chain</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A polymeric branch may be termed a &quot;ong-chain branch&quot;.</rdfs:comment>
        <rdfs:comment>An oligomeric branch may be termed a &quot;short-chain branch&quot;.</rdfs:comment>
        <rdfs:label>pendent chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vesicle with radius ranging from \(\pu{50 nm}\) to greater than \(\pu{5 \upmu m}\) constructed from an amphiphilic synthetic block copolymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Most reported polymersomes serve as hosts for an aqueous solution and are useful for the accommodation or temporary trapping of molecules such as drugs, enzymes, and other proteins and peptides in in vivo applications.</rdfs:comment>
        <rdfs:label>polymersome</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13849 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13849">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consisting of many molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>polymolecular</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer comprising mechanically interlocked molecular architectures typically of a macromolecule threaded through one or more macrocycles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>A polyrotaxane may also be composed of macromolecules comprising one or more macrocyclic main-chain or side-chain units threaded with linear chains.</rdfs:comment>
        <rdfs:comment>The macrocycle(s) may be threaded onto the polymer backbone or side-chains.</rdfs:comment>
        <rdfs:label>polyrotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13837"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13847"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Receptor with two binding sites.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Ditopic receptors can be either homotopic or heterotopic according to whether or not the binding sites are the same (typically, self-complementary binding sites) or different.</rdfs:comment>
        <rdfs:label>ditopic receptor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Copolymer the molecules of which consist of rigid and flexible blocks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>rod-coil copolymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13853 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13853">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation used to calculate the association constant, \(K_{\rm{a}}\), of a ligand with a protein molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>The Scatchard equation is \[\frac{r}{c} = -K_{\rm{a}} r + K_{\rm{a}} n\] in which \(r\) is the ratio of the concentration of bound ligand to the concentration of available protein binding sites, \(c\) is the concentration of free ligand, and \(n\) is the number of binding sites per protein molecule.</rdfs:comment>
        <rdfs:comment>The association constant, \(K_{\rm{a}}\), has units of reciprocal concentration.</rdfs:comment>
        <rdfs:label>Scatchard equation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Linear plot of \(r/c\) against \(r\) in accordance with the Scatchard equation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>Scatchard plot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13853"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13855 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13855">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inter- or intra-molecular self-assembly of constitutional units within the backbones of polymer molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>main-chain self-assembly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inter- or intra-molecular self-assembly of side-chains or constitutional units of polymer molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>side-chain self-assembly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Core-shell structure formed by self-assembly of amphiphiles and subsequently covalently crosslinked through functionalities in the shell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>knedel</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Such structures are used, e.g., in drug delivery and dye encapsulation.</rdfs:comment>
        <rdfs:comment>The amphiphiles are often amphiphilic block copolymers.</rdfs:comment>
        <rdfs:label>shell-crosslinked micelle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13795"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13805"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13806"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the arrangement and orientation of molecules in a smectic mesophase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>smectic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13859"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mesophase that has the molecules arranged in layers with a well-defined layer spacing or periodicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>Although the total number of smectic mesophases cannot be specified, the following types have been defined: \(SmA\), \(SmB\), \(SmC\), \(SmF\), and \(SmI\). The alphabetical order of suffixes merely indicates an order of discovery.</rdfs:comment>
        <rdfs:comment>Smectic mesophases are amongst the class of liquid-crystal mesophases.</rdfs:comment>
        <rdfs:comment>There are several types of smectic mesophases, characterised by a variety of molecular arrangements within the layers.</rdfs:comment>
        <rdfs:label>smectic mesophase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macrocyclic compound capable of completely enveloping a cation, having donor atoms (\(\ce{O}\), \(\ce{N}\), \(\ce{S}\)) arranged such that they provide a solvation sphere to the encapsulated cation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>spherand</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inter- or intra-molecular alignment of aromatic groups within molecules induced by the interactional overlap of their \(\ce{\uppi\mbox{-}orbitals}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>pi-pi stacking</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>\(\ce{\uppi\mbox{-}\uppi}\) Interactions become stronger as the number of \(\ce{\uppi\mbox{-}electrons}\) increases.</rdfs:comment>
        <rdfs:label>π-π stacking</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13862 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13862">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Orthogonal alignment of constitutional units within molecules that lead to favourable interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>edge-face interaction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>T-stacking is often seen in proteins where the partially positively charged hydrogen atom of one aromatic system points to the centre of the aromatic plane of another aromatic system.</rdfs:comment>
        <rdfs:label>T-stacking</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Self-assembly at equilibrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>static self-assembly</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13864 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13864">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer that responds reversibly to external stimulus or stimuli.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:comment>The external stimuli might be temperature, incident radiation, \(\pu{pH}\), etc., and responses would be manifest as changes in a physical property such as conformation, aggregation, liquid-crystalline state, absorption spectrum, emission spectrum, etc.</rdfs:comment>
        <rdfs:label>stimuli-responsive polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13794"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13865 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13865">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier indicating an affinity for solvents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>solvophilic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier indicating a lack of affinity for solvents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>solvophobic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13867 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13867">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Self-assembly involving reversible, noncovalent, directional interactions of molecules that result in a high-molecular-mass entity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>Lehn association</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Use of the term &quot;supramolecular polymerization&quot; is discouraged.</rdfs:comment>
        <rdfs:label>supramolecular association</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13868 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13868">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization of monomer molecules adsorbed and oriented (a) on a surface, (b) in a polymer lattice, (c) on polymer molecules in solution, or (d) round a metal ion whereby the structure of the polymer chains formed is controlled by the orientation of the monomer molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <rdfs:label>template polymerization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vesicle constructed from a lipid bilayer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-12-03-12"/>
        <oboInOwl:hasRelatedSynonym>liposome</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Liposomes have potential use in drug delivery.</rdfs:comment>
        <rdfs:label>lipid vesicle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier for something that is made by human activity, rather than occurring naturally.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>artificial</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Man-made polymer that is not a biopolymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Artificial polymer should also be used in the case of chemically modified biopolymers.</rdfs:comment>
        <rdfs:comment>Biochemists are now capable of synthesizing copies of biopolymers that should be named synthetic biopolymers to make a distinction with true biopolymers.</rdfs:comment>
        <rdfs:comment>Genetic engineering is now capable of generating non-natural analogues of biopolymers that should be referred to as artificial biopolymers, e.g., artificial protein, artificial polynucleotide, etc.</rdfs:comment>
        <rdfs:label>artificial polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13907"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier for a substance that provokes any response from a living system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>This definition is derived from &quot;material which has been designed to induce specific biological activity&quot; and is limited to material made bioactive on purpose. However, the concept of bioactivity does not imply beneficial action only, although the term is often used positively, i.e., to reflect a beneficial action.</rdfs:comment>
        <rdfs:label>bioactive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13873"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capability of a substance, such as a drug or a vaccine, to provoke a response from a living matter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>biological activity</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Stealth is often used to reflect the absence of recognition by defense proteins of the complement, and more generally opsonins that serve as binding enhancers for the process of phagocytosis.</rdfs:comment>
        <rdfs:comment>There is no polymer (solid or in solution) that is inert in contact with a living system, because of adsorption and/or physical-chemical interactions with life elements (biopolymers, cells, and tissues).</rdfs:comment>
        <rdfs:label>bioactivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13945"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adhesion of cells or tissues to the surface of a material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>bioattachment</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Assessing of adhesion is made after washing to eliminate unattached cells.</rdfs:comment>
        <rdfs:comment>Cell adhesion is generally followed by proliferation as a biofilm or as a tissue.</rdfs:comment>
        <rdfs:comment>The use of the term &quot;bioattachment&quot; is discouraged.</rdfs:comment>
        <rdfs:label>bioadhesion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13879"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13875 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13875">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-mediated chemical modification without main chain scission.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>bioalteration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capability of being degraded by biological activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>In vitro activity of isolated enzymes cannot be considered as biological activity.</rdfs:comment>
        <rdfs:label>biodegradability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13873"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13905"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disintegration resulting from the action of cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>biodisintegration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13903"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13879 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13879">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aggregate of microorganisms in which cells that are frequently embedded within a self-produced matrix of extracellular polymeric substance (EPS) adhere to each other and/or to a surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A biofilm is a fixed system that can be adapted internally to environmental conditions by its inhabitants.</rdfs:comment>
        <rdfs:comment>The self-produced matrix of EPS, which is also referred to as slime, is a polymeric conglomeration generally composed of extracellular biopolymers in various structural forms.</rdfs:comment>
        <rdfs:label>biofilm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragmentation resulting from the action of cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>biofragmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Material exploited in contact with living tissues, organisms, or microorganisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The definition &quot;non-viable material used in a medical device, intended to interact with biological systems&quot; recommended in cannot be extended to the environmental field where people mean &quot;material of natural origin&quot;.</rdfs:comment>
        <rdfs:comment>The notion of exploitation includes utility for applications and for fundamental research to understand reciprocal perturbations as well.</rdfs:comment>
        <rdfs:comment>This general term should not be confused with the terms biopolymer or biomacromolecule. The use of &quot;polymeric biomaterial&quot; is recommended when one deals with polymer or polymer device of therapeutic or biological interest.</rdfs:comment>
        <rdfs:label>biomaterial</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mineralization caused by cell-mediated phenomena.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Biomineralization is a process generally concomitant to biodegradation.</rdfs:comment>
        <rdfs:label>biomineralization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13912"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Resistance to the deleterious action of living systems that allows preservation of the initial characteristics of a substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>If the substance is involved in an application, the term has to be related to a desired duration of performance, because almost any material ages in contact with living systems and biochemical processes regardless of the domain.</rdfs:comment>
        <rdfs:label>biostability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to, or produced by, living cells or organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>biotic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Homogeneous degradation affecting the volume of a sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Generally, degradation is faster inside because of autocatalysis by entrapped degradation byproducts or by the presence of a chain-cleaving reagent entrapped within the matrix.</rdfs:comment>
        <rdfs:comment>The molar mass of the whole sample decreases progressively as opposed to the constancy observed in the case of erosion and bioerosion.</rdfs:comment>
        <rdfs:comment>This expression is often used when degradation is faster inside than at the surface. This is not appropriate. Nevertheless, it should be adopted specifically in opposition to erosion. In this case, the molar mass distribution becomes rapidly bimodal.</rdfs:comment>
        <rdfs:label>bulk degradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13906"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13886 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13886">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Supply of a substance according to desired rate and amount over time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>If only a delayed or prolonged release is obtained without matching a desired release profile, the expression sustained delivery is to be used.</rdfs:comment>
        <rdfs:label>controlled delivery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13920"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13887 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13887">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capability of undergoing degradation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degradability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13888 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13888">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecule that is able to undergo chain scissions under specific conditions, resulting in a decrease of molar mass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degradable macromolecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer in which macromolecules are able to undergo chain scissions, resulting in a decrease of molar mass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degradable polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13890 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13890">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progressive loss of the performance or of the characteristics of a substance or a device.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The process of degradation may be specified by a prefix or an adjective preceding the term &quot;degradation&quot;. For example, degradation caused by the action of water is termed &quot;hydrodegradation&quot; or hydrolysis; by visible or ultraviolet light is termed &quot;photodegradation&quot;; by the action of oxygen or by the combined action of light and oxygen is termed &quot;oxidative degradation&quot; or &quot;photooxidative degradation&quot;, respectively; by the action of heat or by the combined effect of chemical agents and heat is termed &quot;thermal degradation&quot; or &quot;thermochemical degradation&quot;, respectively; by the combined action of heat and oxygen is termed &quot;thermooxidative degradation&quot;.</rdfs:comment>
        <rdfs:label>degradation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degradation that results in desired changes in the values of in-use properties of the material because of macromolecule cleavage and molar mass decrease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Adapted where the definition is general. For biorelated polymers, the definition is purposely and specifically limited to the chemical degradation of macromolecules in order to make a clear distinction with the physical degradation of the material.</rdfs:comment>
        <rdfs:comment>Degradation can result from the action of enzymes (see enzymatic degradation), or from the action of cells, organisms, and/or microorganisms.</rdfs:comment>
        <rdfs:comment>In any condition, degradation must be used instead of biodegradation when the mechanism of chain scission is not known or demonstrated as cell-mediated.</rdfs:comment>
        <rdfs:label>degradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13903"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13905"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13892 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13892">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a substance that is bioassimilated.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of bioassimilation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13893 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13893">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a substance that is biodegraded under specified conditions as measured through specified phenomena or techniques sensitive to mineral and biomass formations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Expressions like degree of biodegradability, extent of biodegradability, etc., are improper because a property reflected by the suffix &quot;ity&quot; cannot be quantified contrary to a deed reflected by &quot;tion&quot;.</rdfs:comment>
        <rdfs:label>degree of biodegradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a biodisintegrated substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of biodisintegration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of the original material that is biofragmented.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of biofragmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a substance that is biomineralized.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of biomineralization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a polymer that is degraded under specified conditions as measured through a specified phenomenon sensitive to molecular dimensions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of degradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of the particles of defined size issued from a fragmented substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The size is generally defined by sieving. It is a practical characteristic in composting.</rdfs:comment>
        <rdfs:label>degree of disintegration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a substance that is fragmented.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of fragmentation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13900 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13900">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of a substance that is mineralized.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>degree of mineralization</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13901 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13901">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme that is able to catalyse the depolymerization of a biomacromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A depolymerase does not necessarily convert all the macromolecules to monomer molecules, occasionally, a specific oligomer is the end-product, depending on the mechanism.</rdfs:comment>
        <rdfs:comment>This term is generally used in the case of macromolecules produced by bacteria, because bacteria have the potential to degrade the biopolymers they synthesized.</rdfs:comment>
        <rdfs:label>depolymerase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deleterious alteration of a material in quality, serviceability, or vigor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Deterioration can result from physical and/or chemical phenomena.</rdfs:comment>
        <rdfs:comment>Deterioration is connected to a loss of performances and thus to the function, whereas degradation is connected with a loss of properties.</rdfs:comment>
        <rdfs:comment>Polymer deterioration is more general than polymer degradation, which reflects loss of properties resulting from chemical cleavage of macromolecules only.</rdfs:comment>
        <rdfs:label>deterioration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fragmentation to particles of a defined size.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The limiting size is generally defined according to sieving conditions.</rdfs:comment>
        <rdfs:label>disintegration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a material to retain the values of its properties under specified conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>durability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13905 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13905">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degradation caused by the catalytic action of enzymes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>enzymatic decomposition</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Degradation caused by enzymes can be observed under biotic or abiotic conditions but only degradation due to cell bioactivity can be called biodegradation, otherwise enzymatic degradation is to be used, especially in the case of in vitro abiotic conditions.</rdfs:comment>
        <rdfs:comment>Sometimes called enzymic degradation.</rdfs:comment>
        <rdfs:label>enzymatic degradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13873"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13884"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degradation that occurs at the surface and progresses from it into the bulk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Erosion can also result from chemical degradation when the degrading reagent reacts faster than it diffuses inside. There is a risk of confusion that can be eliminated after careful and detailed investigation of the degradation mechanism. (See bioerosion.)</rdfs:comment>
        <rdfs:comment>See enzymatic degradation. In the case of polymers, water-soluble enzymes can hardly diffuse into the macromolecular network, except, maybe, in some hydrogels. They adhere to surfaces to cause erosion.</rdfs:comment>
        <rdfs:comment>The wording bulk erosion is incorrect and its use therefore discouraged.</rdfs:comment>
        <rdfs:label>erosion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13905"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of inserting new genetic information into existing cells in order to modify a specific organism for the purpose of changing its characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>genetic engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Greater value of the degree of biodegradation that can be reached under selected experimental conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Not to be confused with ultimate degradation.</rdfs:comment>
        <rdfs:comment>This expression reflects the fact that some biodegradable parts of a biodegradable material may not be accessible to biodegradation.</rdfs:comment>
        <rdfs:label>maximum degree of biodegradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13923"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hollow microparticle composed of a solid shell surrounding a core-forming space available to permanently or temporarily entrapped substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The substances can be drugs, pesticides, dyes, etc.</rdfs:comment>
        <rdfs:label>microcapsule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13910"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle with dimensions between \(\pu{1E-7}\) and \(\pu{1E-4 m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The lower limit between micro- and nano-sizing is still a matter of debate. (See nanoparticle.)</rdfs:comment>
        <rdfs:comment>To be consistent with the prefix &quot;micro&quot; and the range imposed by the definition, dimensions of microparticles should be expressed in \(\pu{\upmu\!m}\).</rdfs:comment>
        <rdfs:label>microparticle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13911 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13911">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microparticle of spherical shape without membrane or any distinct outer layer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The absence of outer layer forming a distinct phase is important to distinguish microspheres from microcapsules because it leads to first-order diffusion phenomena, whereas diffusion is zero order in the case of microcapsules.</rdfs:comment>
        <rdfs:label>microsphere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13912 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13912">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process through which an organic substance becomes impregnated by or turned into inorganic substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A particular case is the process by which living organisms produce and structure minerals often to harden or stiffen existing tissues. (See biomineralization.)</rdfs:comment>
        <rdfs:comment>In the case of polymer biodegradation, this term is used to reflect conversion to _015233_ and \(\ce{H2O}\) and other inorganics. \(\ce{CH4}\) can be considered as part of the mineralization process because it comes up in parallel to the minerals in anaerobic composting, also called methanization.</rdfs:comment>
        <rdfs:label>mineralization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13882"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13913 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13913">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hollow nanoparticle composed of a solid shell that surrounds a core-forming space available to entrap substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>nanocapsule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nanoparticle of spherical shape without membrane or any distinct outer layer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A nanosphere is composed of a matrix where substances can be permanently or temporarily embedded, dissolved, or covalently bound.</rdfs:comment>
        <rdfs:label>nanosphere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13911"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generic term used in the case of polymeric material that may contain other substances to improve performance and/or reduce costs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The use of this term instead of polymer is a source of confusion and thus is not recommended.</rdfs:comment>
        <rdfs:comment>This term is used in polymer engineering for materials often compounded that can be processed by flow.</rdfs:comment>
        <rdfs:label>plastic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid multiphasic mixture with at least one polymer component dominating.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>solid dispersion polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In pharmaceutical preparations, incompatible polymer-drug mixtures are generally solid dispersions.</rdfs:comment>
        <rdfs:comment>Solid dispersion is commonly prepared by three different methods, namely, solventbased, fusion-melt, and hybrid fusion-solvent methods.</rdfs:comment>
        <rdfs:comment>The dispersed compounds can be in clusters of particles.</rdfs:comment>
        <rdfs:comment>The nonpolymeric components can act as fillers.</rdfs:comment>
        <rdfs:label>solid dispersion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13919 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13919">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer that responds or that is designed to respond to a stimulus like pH, light, heat, etc. change, and provides a predetermined action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>smart polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The generated action can be unique or cyclic. It generally results from cooperative phenomena.</rdfs:comment>
        <rdfs:comment>The stimulus can affect macromolecules or macromolecule assemblies forming the polymer.</rdfs:comment>
        <rdfs:label>stimulus-responsive polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13920 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13920">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Supply of a substance from a container where it is temporarily entrapped for the sake of achieving a prolonged action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>prolonged delivery</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In some cases, the container is a polymer processed as implant, film, microparticle, or nanoparticle, auto-assembly of molecules, or a macromolecule.</rdfs:comment>
        <rdfs:comment>In the case of sustained delivery according to required specifications, the use of controlled delivery is recommended.</rdfs:comment>
        <rdfs:comment>The substance can be temporarily embedded, dissolved, or covalently bound.</rdfs:comment>
        <rdfs:comment>The term is relevant to the release of substances like pesticides, dyes, drugs, etc.</rdfs:comment>
        <rdfs:label>sustained delivery</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13886"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13910"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13936"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13921 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13921">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Copy of a biopolymer man-made using abiotic chemical routes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>synthetic biopolymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13870"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degree of biodegradation that corresponds to conversion of all the organic matter present in an original polymer-based item to minerals and biomass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>This expression is used as reference to assess biodegradable components that are not accessible to biodegradation from those that are bioavailable.</rdfs:comment>
        <rdfs:label>theoretical degree of biodegradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13876"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13893"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13923 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13923">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete breakdown of a compound to either fully oxidized or reduced simple molecules (such as carbon dioxide/methane, nitrate/ammonium, and water).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The use of this expression is not recommended.</rdfs:comment>
        <rdfs:comment>This term reflects the end-products of biodegradation. As such, it differs from the theoretical degree of biodegradation, which depends on the presence of non-biodegradable components.</rdfs:comment>
        <rdfs:label>ultimate biodegradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13922"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13924 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13924">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Medical device that replaces, in part or in whole, the function of one of the organs of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>artificial organ</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13925 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13925">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier for a domain grouping scientific and practical activities related to therapy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The term is relevant to therapy in surgery, medicine, pharmacology, dentistry, etc.</rdfs:comment>
        <rdfs:label>biomedical</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13926 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13926">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Implantable prosthesis that consists totally or substantially of nonviable, treated donor tissue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>bioprosthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13927 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13927">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to be eliminated from an animal or human body through natural pathways.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Bioassimilation with formation of novel biomass is a particular means of elimination often combined with the other pathways.</rdfs:comment>
        <rdfs:comment>Natural pathways are kidneys through glomerular filtration and lungs after metabolization.</rdfs:comment>
        <rdfs:label>bioresorbability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disappearance of a substance from an organism by processes of metabolism, secretion, or excretion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Bioresorption is now considered as pertinent and should be used specifically only when foreign material and residues have been shown assimilated or eliminated from the living host, regardless of the followed route, namely, lungs or kidneys or insertion in biochemical processes.</rdfs:comment>
        <rdfs:comment>In the case of polymers or high-molar-mass macromolecules that are retained in parenteral compartments, degradation or biodegradation is necessary prior to bioresorption.</rdfs:comment>
        <rdfs:comment>This concept does not apply to the environment as everything, including degradation by-products issued from outdoor degradation or biodegradation can only be stored or chemically transformed on Earth, so far.</rdfs:comment>
        <rdfs:label>bioresorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13890"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13929 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13929">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic, self-curing organic or inorganic material used to fill up a cavity or to create a mechanical fixation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>In dentistry, polymer-based cements are also used as fillers of cavities. They are generally cured photochemically using UV radiation in contrast to bone cements.</rdfs:comment>
        <rdfs:comment>In situ self-curing can be the source of released reagents that can cause local and/or systemic toxicity as in the case of the monomer released from methacrylics-based bone cement used in orthopedic surgery.</rdfs:comment>
        <rdfs:label>bone cement</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability or tendency to produce cancer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>In general, polymers are not known as carcinogens or mutagens, however, residual monomers or additives can cause genetic mutations.</rdfs:comment>
        <rdfs:label>carcinogenicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecule or polymer used to transport a pharmacologically active compound to be released later on due to an abiotic or biotic process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A complementary property of a polymeric drug carrier is targeting, which can be obtained by specific interactions with a receptor if bearing a specific ligand or by selection depending on other factors such as permeation through membranes or capillaries.</rdfs:comment>
        <rdfs:label>drug carrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13884"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13886"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13920"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13941"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13946"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13932 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13932">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cellular response of the inflammatory and wound healing processes following introduction of a foreign object in a human or animal body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>The foreign body reaction results in more or less intense events such as fibrous tissue formation, macrophage activation, giant cells formation, etc.</rdfs:comment>
        <rdfs:comment>The foreign object can be a medical device, a prosthesis, a particle or any compound introduced accidentally.</rdfs:comment>
        <rdfs:label>foreign body reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13944"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction of a living system to the presence of a substance or a material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>host response</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Artificial organ that is a combination of viable cells and one or more biomaterials.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>hybrid artificial organ</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13881"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13935 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13935">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a material or substance to elicit a cellular immune response and/or antibody production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>immunogenicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Medical device made from one or more biomaterials that is intentionally placed within the body, either totally or partially buried beneath an epithelial surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>There are also other devices implanted that are not medical devices, e.g., for cosmetic, cultural, or aesthetic purposes.</rdfs:comment>
        <rdfs:label>implant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13881"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Prodrug in which the temporary chemical entity is a macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>In this particular case of prodrug, the macromolecule carries several drug molecules generally. These molecules are linked to the carrier through cleavable bonds.</rdfs:comment>
        <rdfs:label>macromolecular prodrug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13943"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Instrument, apparatus, implement, machine, contrivance, in vitro reagent, or other similar or related article, including any component, part of accessory, which is intended for use in the diagnosis of disease or other conditions, or in the cure, mitigation, treatment, or prevention of disease in man.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>medical device</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier for substances or systems, including polymers, exploited by the pharmaceutical industry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A pharmaceutical substance can be exploited for its bioactivity or as an excipient.</rdfs:comment>
        <rdfs:comment>The term &quot;pharmaceutical&quot; is also used as short form for a pharmaceutical substance.</rdfs:comment>
        <rdfs:label>pharmaceutical</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13873"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13940 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13940">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifiers for substances, including macromolecules or polymers, and actions involved in pharmacology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>pharmacologic</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A pharmacological polymer can be bioactive by itself or because it is used as a temporary carrier of a bioactive substance of interest in pharmacology.</rdfs:comment>
        <rdfs:label>pharmacological</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13872"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13937"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13942"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13941 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13941">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier for a substance that exhibits bioactivity of pharmacological interest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>pharmacologically active</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13873"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13940"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13942 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13942">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science of drugs including their origin, composition, pharmacokinetics, pharmacodynamics, therapeutic use, and toxicology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>pharmacology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13943 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13943">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that undergoes biotransformation before exhibiting pharmacological effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Prodrugs can thus be viewed as drugs containing specialized nontoxic protective groups used in a transient manner to alter or to eliminate undesirable properties in the parent molecule.</rdfs:comment>
        <rdfs:label>prodrug</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13940"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13944 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13944">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device that replaces a limb, organ, or tissue of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>prosthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13945 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13945">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifier for a macromolecule, a surface, or a device that is not detected by defense proteins of the complement and the Mononuclear Phagocyte System, especially macrophages, after introduction in parental compartments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>stealth biomedical polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Detection by natural defenses generally leads to the destruction of the device or of the surrounding tissues.</rdfs:comment>
        <rdfs:comment>Surfaces are often decorated by chemical entities aimed at suppressing the activation of the natural defense processes.</rdfs:comment>
        <rdfs:label>stealth</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13946 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13946">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exploitation of specific or nonspecific interactions to target a particular part of a living system, or a particular type of cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>targeting</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13947 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13947">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer aimed at helping therapists in treating diseases or trauma.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>therapeutic polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13948 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13948">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Property of a material (or substance) that induces and/or promotes the formation of a thrombus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>thrombogenicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13949 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13949">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of a combination of cells, engineering and materials methods, and suitable biochemical and physico-chemical factors to improve or replace biological functions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>While most definitions of tissue engineering cover a broad range of applications, in practice the term is closely associated with applications that repair or replace portions of or whole tissues (i.e., bone, cartilage, blood vessels, bladder, skin, etc.).</rdfs:comment>
        <rdfs:label>tissue engineering</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13950 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13950">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete structure, such as an organ that is transferred from a site in a donor to a site in a recipient for the purpose of the reconstruction of the recipient site.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>transplant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13951 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13951">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biodegradation in the presence of molecular oxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Oxygen is generally supplied by the atmosphere.</rdfs:comment>
        <rdfs:label>aerobic biodegradation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13952 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13952">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biodegradation in the absence of oxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>anaerobic biodegradation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13912"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13953 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13953">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biobased polymer derived from the biomass or issued from monomers derived from the biomass and which, at some stage in its processing into finished products, can be shaped by flow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A biobased polymer similar to a petrobased one does not imply any superiority with respect to the environment unless the comparison of respective life cycle assessments is favourable.</rdfs:comment>
        <rdfs:comment>Bioplastic is generally used as the opposite of polymer derived from fossil resources.</rdfs:comment>
        <rdfs:comment>Bioplastic is misleading because it suggests that any polymer derived from the biomass is environmentally friendly.</rdfs:comment>
        <rdfs:comment>The use of the term &quot;bioplastic&quot; is discouraged. Use the expression &quot;biobased polymer&quot;.</rdfs:comment>
        <rdfs:label>bioplastic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13958"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13960"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13954 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13954">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid product resulting from the decomposition of organic wastes by fermentation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>A compost is generally processed in personal composters or industrially to be used as fertilizer. In the latter case, specifications in structure and quality are to be provided.</rdfs:comment>
        <rdfs:label>compost</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13955 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13955">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Film that is rapidly formed on the surface of a solid in contact with a biological system (in the widest sense) that conditions the surface for subsequent interaction with constituents of the biological system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Frequently, the conditioning film consists of proteins that prepare almost any surface for subsequent colonization by microorganisms or cells.</rdfs:comment>
        <rdfs:comment>Not to be confused with biofilm, which implies the presence of cells or microorganisms.</rdfs:comment>
        <rdfs:comment>Not to be confused with conditioning film in packaging.</rdfs:comment>
        <rdfs:comment>The term can be applied to the surface of any material that is in contact with blood or body fluids because the very first event is coverage by more or less denaturized adhering proteins.</rdfs:comment>
        <rdfs:label>conditioning film</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13879"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13956 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13956">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consequence of adverse effects caused by a substance on the environment and on organisms living in it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>If only living organisms (animals, plants, microorganisms) are concerned, the use of toxicity is recommended.</rdfs:comment>
        <rdfs:comment>Using the term is recommended when adverse effects concern water, air, sediments, etc.</rdfs:comment>
        <rdfs:label>ecotoxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13957 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13957">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer that can be degraded by the action of the environment, through, for example, air, light, heat, or microorganisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>When it is to be a source of material, such a polymer must be designed to degrade into products at a predictable rate compatible with the application. Such products are usually of lower molar mass than the original polymer.</rdfs:comment>
        <rdfs:label>environmentally degradable polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13958 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13958">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Qualifiers for a substance, device, or process that has minimal deleterious impact on the environment, which is air, water, minerals, living systems, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <oboInOwl:hasRelatedSynonym>ecocompatible</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Ecocompatible is introduced to complement biocompatible, whose meaning is limited to living systems.</rdfs:comment>
        <rdfs:comment>The assignment of these qualifiers to a polymer must be based on a consistent life cycle assessment.</rdfs:comment>
        <rdfs:label>environmentally friendly</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13960"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13959 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13959">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer that conforms to the concept of green chemistry.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Green polymer does not necessarily mean environmentally friendly polymer or biobased polymer although the confusion is often made in the literature.</rdfs:comment>
        <rdfs:label>green polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13958"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13960 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13960">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Investigation and valuation of the environmental impacts of a given product or service caused or necessitated by its existence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Also known as life cycle analysis, LCA, ecobalance, and cradle-to-grave analysis.</rdfs:comment>
        <rdfs:comment>Assessing the life cycle of a polymer or a plastic must take into account all the factors that can be identified from the up-stage raw material to the waste management.</rdfs:comment>
        <rdfs:label>life cycle assessment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13915"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13964"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13961 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13961">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer film aimed at covering seeded area in order to protect the growing plants from weeds and cold and preserve humidity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Such film acts as a mobile green house.</rdfs:comment>
        <rdfs:label>mulching film</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13962 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13962">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Developments that meet the needs of the present without compromising the ability of future generations to meet their needs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Other definitions are not recommended in the context of biorelated polymers.</rdfs:comment>
        <rdfs:label>sustainability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13963 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13963">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Residue left when a compound or a product reaches the end of its initial usefulness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:comment>Also referred to as rubbish, trash, garbage, or junk depending upon the type of material and the regional terminology.</rdfs:comment>
        <rdfs:comment>In living organisms, waste relates to unwanted substances or toxins that are expelled from them.</rdfs:comment>
        <rdfs:label>waste</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13964 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13964">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Control of the collection, treatment and disposal of wastes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-12-04"/>
        <rdfs:label>waste management</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13965 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13965">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule that has at least one ring (cycle) large enough to allow it to be threaded onto a linear subchain of another molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>MC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In a macromolecular rotaxane, a macrocyclic component can be a discrete macrocyclic molecule or a macromolecule that includes one or more threadable ring(s). Examples and structure representations of both are shown: </rdfs:comment>
        <rdfs:comment>The literature on rotaxanes frequently cites the word &quot;macrocycle&quot; as a contraction of (and an abbreviation for) macrocyclic component. A use of the word &quot;macrocycle&quot; in rotaxane terminology is incompatible with the IUPAC definition of a macrocycle, which is &quot;a cyclic macromolecule or a macromolecular cyclic portion of a macromolecule&quot;:  Such a macrocycle is virtually never used as a macrocyclic component in a rotaxane assembly. Therefore, since the term &quot;macrocycle&quot; is ambiguous, its use should be avoided in the macromolecular rotaxane literature.</rdfs:comment>
        <rdfs:comment>To thread a simple hydrocarbon chain such as a polyethylene chain, at least a 24-membered ring is needed.</rdfs:comment>
        <rdfs:label>macrocyclic component</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13984"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13966 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13966">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecule that is part of a rotaxane assembly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>A macromolecular component can be a macrocyclic component or a threading component of a rotaxane or both.</rdfs:comment>
        <rdfs:label>macromolecular component</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13967 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13967">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pseudorotaxane, at least one component of which is a macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>A macromolecular pseudorotaxane in which only one end of a threading component is capped with a stopper is sometimes called a &quot;macromolecular semirotaxane&quot;.</rdfs:comment>
        <rdfs:comment>Structural differences between macromolecular pseudorotaxanes and macromolecular rotaxanes are neither substantial nor always obvious; macromolecular rotaxanes from which macromolecular component(s) can be dethreaded (i.e., the macromolecular rotaxane becomes a macromolecular pseudorotaxane) under some specific conditions are known. Therefore, the overwhelming majority of definitions concerning macromolecular rotaxanes are fully applicable also to macromolecular pseudorotaxanes after replacing the word &quot;rotaxane&quot; with the word &quot;pseudorotaxane&quot;; also, nomenclature rules are the same for both of these compound classes.</rdfs:comment>
        <rdfs:label>macromolecular pseudorotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13972"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13968 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13968">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rotaxane, at least one component of which is a macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>A macromolecular rotaxane is composed of a macromolecular chain with either at least one cyclic molecule threaded onto its linear section or at least one linear molecule threaded through its threadable cycle.</rdfs:comment>
        <rdfs:comment>Rotaxane constitutional unit(s) may be located within a specific part of a macromolecular rotaxane: (i) within end-group(s); (ii) within a main chain (see main-chain macromolecular rotaxane); (iii) within side chains (see side-chain macromolecular rotaxane).</rdfs:comment>
        <rdfs:label>macromolecular rotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13969"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13974"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13981"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13969 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13969">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecular rotaxane in which rotaxane constitutional units are exclusively located within the main macromolecular chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>Structure representations of basic constitutional units of main-chain macromolecular rotaxanes are as follows:  where \(\ce{R^{1}}\) and \(\ce{R^{2}}\) are end-groups of a threading component.</rdfs:comment>
        <rdfs:label>main-chain macromolecular rotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13981"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13970 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13970">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecular assemblies that are main-chain macromolecular rotaxanes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>main-chain polyrotaxane</oboInOwl:hasRelatedSynonym>
        <rdfs:label>main-chain rotaxane polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13969"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13980"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13971 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13971">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rotaxane or pseudorotaxane comprising a threading component upon which is threaded a macrocyclic component that, depending on the conditions, can reside at either a specific recognition site on the threading component or away from any recognition site.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>Rotaxane polymers composed of molecules that contain units of the molecular shuttle type are a special class of functional polymers.</rdfs:comment>
        <rdfs:label>molecular shuttle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13972"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13980"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13972 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13972">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rotaxane-like molecular assembly in which the threading component(s) has(have) ends small enough to permit threading or dethreading of the macrocyclic component(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>Pseudorotaxanes in which only one end of a threading component is capped with a stopper are sometimes called &quot;semirotaxanes&quot; or &quot;half-capped pseudorotaxanes&quot;.</rdfs:comment>
        <rdfs:comment>The stability of a pseudorotaxane may arise not only from spatially hindered dethreading of its components, but also from interaction between threading and macrocyclic components, e.g., donor-acceptor or electrostatic or coordination (see recognition site).</rdfs:comment>
        <rdfs:label>pseudorotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13973 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13973">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules that are macromolecular pseudorotaxanes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>polypseudorotaxane</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A narrower definition of pseudorotaxane polymer as &quot;a rotaxane polymer without bulky end-groups preventing dethreading of cyclic molecules&quot; has also been published.</rdfs:comment>
        <rdfs:comment>A pseudorotaxane polymer in the molecule of which only one end of a threading component is capped with a stopper is sometimes called &quot;semirotaxane polymer&quot; or &quot;polysemirotaxane&quot;.</rdfs:comment>
        <rdfs:comment>Pseudorotaxane polymers are sometimes referred to in the literature as &quot;pseudopolyrotaxanes&quot;. Use of this term is strongly discouraged owing to possible misinterpretation as &quot;pseudopolymeric&quot; or &quot;pseudomacromolecular&quot; rotaxane.</rdfs:comment>
        <rdfs:comment>Though the synonym &quot;polypseudorotaxane&quot; currently appears in the literature, its use is discouraged. This term, from a purely semantic point of view, implies many threaded rings, a polymer formed from a pseudorotaxane, while a molecule of a pseudorotaxane polymer can comprise a single threaded ring.</rdfs:comment>
        <rdfs:label>pseudorotaxane polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13967"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13972"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13980"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13974 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13974">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecular rotaxane, the structure of which essentially comprises the repetition of a single constitutional unit of the rotaxane type, referred to as the rotaxane constitutional repeating unit, rot-CRU, with all units connected identically with respect to directional sense.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>Structure representations of typical regular macromolecular rotaxanes are: </rdfs:comment>
        <rdfs:label>regular macromolecular rotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13975"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13975 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13975">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Constitutional repeating unit (CRU) that has a rotaxane structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>&lt;em&gt;rot&lt;/em&gt;-CRU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rotaxane CRU</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Constitutional repeating unit is the smallest constitutional unit the repetition of which constitutes a regular macromolecule, a regular oligomer molecule, a regular block, or a regular chain.</rdfs:comment>
        <rdfs:label>rotaxane constitutional repeating unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13975"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>&lt;em&gt;rot&lt;/em&gt;-CRU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13976 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13976">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Constitutional unit (CU) that has a rotaxane structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>&lt;em&gt;rot&lt;/em&gt;-CU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rotaxane CU</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Constitutional unit is an atom or group of atoms (with pendant atoms or groups, if any) comprising a part of the essential structure of a macromolecule, an oligomer molecule, a block, or a chain.</rdfs:comment>
        <rdfs:label>rotaxane constitutional unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13976"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>&lt;em&gt;rot&lt;/em&gt;-CU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13977 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13977">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Constitutional unit of a macromolecular rotaxane consisting of an end-group of its macromolecular component and a complementary threading or macrocyclic component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>&lt;em&gt;rot&lt;/em&gt;-EU</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>End-group is a constitutional unit that is an extremity of a macromolecule or oligomer molecule. An end-group is attached to only one constitutional unit of a macromolecule or oligomer molecule.</rdfs:comment>
        <rdfs:label>rotaxane end-unit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13977"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>&lt;em&gt;rot&lt;/em&gt;-EU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13978 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13978">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monomer that is a rotaxane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:label>rotaxane monomer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13979 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13979">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monomeric unit (monomer unit, mer) that has a rotaxane structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>&lt;em&gt;rot&lt;/em&gt;-MU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rotaxane MU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rotaxane monomer unit</oboInOwl:hasRelatedSynonym>
        <rdfs:label>rotaxane monomeric unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13979"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>&lt;em&gt;rot&lt;/em&gt;-MU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13980 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13980">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules that are macromolecular rotaxanes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>polymeric rotaxane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polyrotaxane</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A narrower definition of rotaxane polymer: &quot;Polymer composed of macromolecules consisting of cyclic molecules threaded by a linear macromolecule that is eventually capped with bulky end-units preventing dethreading of cyclic molecules&quot; has previously been published.</rdfs:comment>
        <rdfs:comment>Though the synonym &quot;polyrotaxane&quot; currently appears in the literature, its use is discouraged. This term, from a purely semantic point of view, namely, implies many threaded rings, i.e., a polymer formed from a rotaxane, while a molecule of a rotaxane polymer can comprise a single threaded ring.</rdfs:comment>
        <rdfs:label>rotaxane polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13981 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13981">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecular rotaxane in which rotaxane constitutional units are located exclusively in side chains of the macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>Typical structure representations of the most common side-chain rotaxane constitutional units are as follows:  where \(\ce{R^{1}}\) and \(\ce{R^{2}}\) are end-groups of a threading component and \(\ce{R}\) is a capping group of a side chain.</rdfs:comment>
        <rdfs:label>side-chain macromolecular rotaxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13976"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13982 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13982">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecular assemblies that are side-chain macromolecular rotaxanes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>side-chain polyrotaxane</oboInOwl:hasRelatedSynonym>
        <rdfs:label>side-chain rotaxane polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13973"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13980"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13981"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13983 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13983">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group bulky enough to prevent dethreading of a given macrocyclic component from a threading component or its translocation to another linear section of the threading component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <rdfs:comment>A more complex threading component may contain several linear sections due to the presence of branch points or internal large groups that prevent movement of macrocyclic components from one linear section to another.</rdfs:comment>
        <rdfs:comment>A stopper can be positioned at the end of the whole chain: end-group stopper, or along it: internal stopper. The latter is often a part of a rotaxane constitutional repeating unit.</rdfs:comment>
        <rdfs:comment>Whether a group functions as a stopper or not depends on the size of the macrocyclic component. Accordingly, when stoppers are mentioned, the macrocyclic component should also be mentioned. Examples of stoppers for \(\upbeta\)-cyclodextrin macrocyclic component are \(\ce{-CPh3}\) end-groups or \(\ce{-CPh2\bond{-}}\) groups included in constitutional repeating units: </rdfs:comment>
        <rdfs:label>stopper</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13975"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13984 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13984">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Key part of a macrocyclic component: molecular ring (cycle) large enough to be threaded onto a linear subchain of a threading component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>threadable cycle</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A threadable ring (cycle) should be distinguished from other smaller, non-threadable rings within a complex macrocyclic component, such as benzene, cyclooctane, or similar rings.</rdfs:comment>
        <rdfs:label>threadable ring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13985 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13985">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule with at least one linear section onto which at least one macrocyclic component is threaded.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-11-10-15"/>
        <oboInOwl:hasRelatedSynonym>TC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For a rotaxane, the word &quot;linear&quot; is to be interpreted broadly. The linear section of a threading component can be either an unbranched chain or a linear subchain of a branched chain or a network chain, or it can be a linear chain or subchain that includes small cyclic parts that do not prevent threading through a macrocyclic component.</rdfs:comment>
        <rdfs:comment>In the context of macromolecular rotaxanes, a threading component may be either a macromolecular chain with a linear section or a linear low-M molecule if a macromolecular component includes threadable ring(s).</rdfs:comment>
        <rdfs:label>threading component</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13965"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13968"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13984"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13985"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13986 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13986">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Local value of the spectral photon radiance, or spectral photon flux density, defined for a three-dimensional space, often in terms of napierian properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>local spectral photon density absorption rate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>local volumetric rate of photon absorption</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Also called local volumetric rate of photon absorption, LVRPA [either \(e_{\lambda}^{\rm{a}}(x,t)\) for one-dimensional or \(e_{\lambda}^{\rm{a}}(\boldsymbol{x},t)\) for three-dimensional absorbed photon flux densities, respectively] in.</rdfs:comment>
        <rdfs:comment>For a divergent beam, the mathematical definition is: \[L_{\rm{p},\lambda}^{\rm{a}} (\boldsymbol{x},t) = \alpha_{\lambda}(\boldsymbol{x},t) L_{\rm{p},\lambda,o} (\boldsymbol{x},t)\], with \(\boldsymbol{x}\) a position vector in a three-dimensional space. Units are the same as above. In this case: \[E_{\rm{p},\lambda,o} (\boldsymbol{x},t) = \int_{4\uppi} L_{\rm{p},\lambda}(\boldsymbol{x},t) {\rm{d}}\mathit{\Omega}\]. In a three-dimensional space, units of \(L_{\rm{p},\lambda}(\boldsymbol{x},t)\) are \(\pu{mol s-1 m-3 sr-1}\). Thus, the integral over the solid angle \(\mathit{\Omega}\) is needed to obtain \(L_{\rm{p},\lambda}\) in units \(\pu{mol s-1 m-4}\).</rdfs:comment>
        <rdfs:comment>In practice, for polychromatic radiation, the quantity is integrated in the wavelength range used.</rdfs:comment>
        <rdfs:comment>Mathematical expression for one spatial dimension is \[L_{\rm{p},\lambda}^{\rm{a}} (x,t) = \alpha_{\lambda}(\boldsymbol{x},t) L_{\rm{p},\lambda} (x,t)\] where \(L_{\rm{p},\lambda}^{\rm{a}} (x,t)\) is the time-dependent spectral photon radiance incident from one direction at a point defined by the space coordinate \(x\). \(\alpha_{\lambda}(\boldsymbol{x},t)\) is the linear napierian absorption coefficient. SI unit is \(\pu{s-1 m-4}\) in photon number basis and \(\pu{mol s-1 m-4}\) in chemical amount basis. Common unit is \(\pu{s-1 cm-3 nm-1}\) and \(\pu{einstein s-1 cm-3 nm-1}\), respectively. The above equation is valid for a collimated beam of radiation. In this case, \[E_{\rm{p},\lambda,o} = L_{\rm{p,}\lambda}(\boldsymbol{x},t)\] with the subindex &apos;o&apos; (the letter o) indicating radiation from all directions.</rdfs:comment>
        <rdfs:comment>Rigorously speaking, the general definition should be written in terms of \(E_{\rm{p},\lambda,o}\). However, for a collimated beam of radiation, it is clearer to write it directly in terms of \(L_{\rm{p},\lambda}\).</rdfs:comment>
        <rdfs:label>absorbed local spectral photon flux density</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13987 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13987">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Local value of the spectral radiance, or energy density absorption rate, defined for a three-dimensional space, often in terms of napierian properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>local volumetric rate of energy absorption</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Also called local volumetric rate of energy absorption, LVREA, [either \(e_{\lambda}^{\rm{a}}(x,t)\) for one spatial dimension or \(e_{\lambda}^{\rm{a}}(\boldsymbol{x},t)\) for three dimensions].</rdfs:comment>
        <rdfs:comment>For a divergent beam, the mathematical definition is: \[L_{\lambda}^{\rm{a}} (\boldsymbol{x},t) = \alpha_{\lambda} (\boldsymbol{x},t) E_{\lambda,o} (\boldsymbol{x},t)\]. In this case, \(\boldsymbol{x}\) is a position vector in a three-dimensional space. Units are the same as above.</rdfs:comment>
        <rdfs:comment>In practice, for polychromatic irradiation, the quantity is integrated in the wavelength range used.</rdfs:comment>
        <rdfs:comment>Mathematical expression for one spatial dimension is \[L_{\lambda}^{\rm{a}} (x,t) = \alpha_{\lambda} (\boldsymbol{x},t) L_{\lambda} (x,t)\] where \(L_{\lambda}(x,t)\) is the time-dependent spectral radiance incident from one direction at a point \(x\) defined in the space coordinates, \(\alpha_{\lambda}(\boldsymbol{x},t)\) is the space- and time-dependent linear napierian absorption coefficient. SI unit is \(\pu{W m-4}\). Common unit is \(\pu{W cm-3 nm-1}\).The equation above is valid for a collimated beam of radiation, for which \(E_{\lambda,{\rm{o}}}(\boldsymbol{x},t) = L_{\lambda}(\boldsymbol{x},t)\).</rdfs:comment>
        <rdfs:comment>Rigorously speaking, the general definition should be written in terms of \(E_{\lambda,o}\). However, for a collimated beam of radiation, it is clearer to write it directly in terms of \(L_{\lambda}\).</rdfs:comment>
        <rdfs:label>absorbed local spectral radiance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13988 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13988">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monochromatic radiant energy, per time interval (spectral radiance) coming from all directions and absorbed by a system integrated over the whole volume and averaged per volume \(V\), \(\langle L_{\lambda}^{\rm{a}}\left(t \right) \rangle_{V}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>absorbed spectral radiant density</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In practice, for polychromatic irradiation, the quantity is integrated in the wavelength range used.</rdfs:comment>
        <rdfs:comment>Mathematical expression: \[\langle L_{\lambda}^{\rm{a}} \left(t \right) \rangle_{V} = \frac{1}{V} \int_{V} L_{\lambda}^{\rm{a}} (\boldsymbol{x},t) {\rm{d}}V = \frac{1}{V}\int_{V} \alpha_{\lambda}(\boldsymbol{x},t) E_{\lambda,o} (\boldsymbol{x},t) {\rm{d}}V\] over the absorption volume \(V\), with \(\boldsymbol{x}\) a position vector in a three-dimensional space, \(\alpha (\boldsymbol{x},t)\) the space- and time-dependent linear napierian absorption coefficient (absorption coefficients are always spectral and the subscript \(\lambda\) may be omitted), and \(E_{\lambda,o} (\boldsymbol{x},t)\) the incident from all directions space- and time-dependent spectral fluence rate. SI unit is \(\pu{W m-4}\). Common unit is \(\pu{W cm-3 nm-1}\).</rdfs:comment>
        <rdfs:label>absorbed radiant density</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14092"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13989 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13989">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subsurface space where the majority carriers accumulate near the surface of a semiconductor because of band bending caused by the surface potential.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>The surface charge is of opposite sign to that of the majority charge carriers in the semiconductor. This leads to accumulation of the majority charge carriers in a subsurface layer.</rdfs:comment>
        <rdfs:label>accumulation layer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14004"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14027"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13990 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13990">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier that interacts with species at the solid/liquid, liquid/liquid, solid/gas, or liquid/gas interfaces with formation of, e.g., chemisorbed species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>active state</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14035"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13991 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13991">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier or reactive intermediate that interacts with molecular entities at an interface with the formation of reaction products or intermediates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>active state</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14043"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13992 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13992">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantities expressed in terms of &apos;per area&apos; are denoted as area-related parameters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>areal parameters</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In photocatalysis, the area-related parameters do not characterise the catalyst as they do in heterogeneous dark catalysis. In general, the properties of a photocatalyst are not directly proportional to its area, especially in view of the fact that light may not equally reach every part of the surface of a particle. The light may not enter the pores of a porous surface and in this case only the outer area behaves as catalyst. A similar situation may occur when particles are aggregated.</rdfs:comment>
        <rdfs:comment>When the surface area that is accessed by the light cannot be established, it is recommended to use the total surface area in terms of the \(\rm{BET}(\ce{N2})\) area. This implies that most probably a lower limit of the quantity is obtained, because the surface determined by \(\ce{N2}\) adsorption will be larger than that reached by the radiation.</rdfs:comment>
        <rdfs:label>area-related parameters</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13997"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13993 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13993">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photocatalytic production of substances from simple compounds (e.g., \(\ce{H2}\) and \(\ce{O2}\) from water, \(\ce{H2}\) from hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation absorbed by chromophoric systems, often included in microheterogeneous media, mimicking the action of antennae and reaction centres in natural photosynthetic organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Antennae (also called light-harvesting centres) are molecular structures enhancing the wavelength range and sensitivity of the photosynthetic units, due to an increase in light absorption.</rdfs:comment>
        <rdfs:label>artificial photosynthesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14029"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13994 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13994">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recombination of charge carriers occurring via a one-step electron transition from the conduction band to the valence band in a semiconductor or insulator.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>band-to-band recombination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13995 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13995">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Idealised object absorbing all incident radiant power, regardless of wavelength and transforming it all into heat. No electromagnetic radiation passes through it and none is reflected. A black body is a perfect absorber of radiant energy. Therefore, it is also a perfect emitter of radiation. The wavelength distribution of the radiation of a black body depends only on its temperature and not on its internal nature or structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>black body</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13996 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13996">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reactor used to determine quantum yields of photoadsorption and photocatalysed reactions when the catalyst is in the form of a powdered layer (or powder dispersion). The incident photons are (nearly) all absorbed by the catalyst, provided that the dispersion layer is sufficiently thick (or the dispersion is sufficiently concentrated).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>To use the black-body-like photocatalytic reactor for the determination of quantum yields, the radiation arriving at the device should be monochromatic (\(\lambda + {\rm{d}}\lambda\)) and the temperature well controlled.</rdfs:comment>
        <rdfs:label>black-body-like photocatalytic reactor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13997 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13997">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific surface area (\(\pu{m2 kg-1}\)) determined from the adsorption isotherm of a gas with the help of the Brunauer, Emmett, and Teller model using the conventional value for the molecular cross-section.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>BET</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The area-related parameters do not characterise the catalyst in photocatalysis as they do in heterogeneous dark catalysis. The properties of a photocatalyst are not directly proportional to their area, in view of the fact that light does not equally reach every part of the surface area or particle.</rdfs:comment>
        <rdfs:comment>The most common gas used is \(\ce{N2}\) with the conventional molecular cross-section of \(\pu{0.162 nm2}\). With nitrogen, the total area is measured; this area includes the area in pores (that may not be reached by light). In this case, the expression \(\rm{BET}(\ce{N2})\) is used.</rdfs:comment>
        <rdfs:label>Brunauer–Emmett–Teller surface area</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13992"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.13997"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13998 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13998">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generation or alteration of the catalytic activity (selectivity) of a substance after its interaction with light.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>catalyst photomodification</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Typically, the term refers to catalytic activity (selectivity) occurring in the dark after irradiation has terminated.</rdfs:comment>
        <rdfs:label>catalyst photoactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.13999 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.13999">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Site at which catalysed chemical transformations take place.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>If the assumption can be made that the active sites are distributed over the entire (photo)catalyst surface, then the heterogeneous reactions are described &quot;per area&quot;. The generally accepted \(\rm{BET}(\ce{N2})\) surface area is used. In spite of the fact that there is no direct correlation between the number of active sites and the \(\rm{BET}(\ce{N2})\) area, the use of the latter may help when no alternative exists.</rdfs:comment>
        <rdfs:comment>Quantities expressed in terms of &quot;per \(\rm{BET}(\ce{N2})\) area&quot; should be denoted as area-related, which also implies that a lower limit of the quantity is given, because the surface determined by \(\ce{N2}\) adsorption will be larger than that reached by the radiation.</rdfs:comment>
        <rdfs:comment>The area-related parameters do not characterise the catalyst in heterogeneous photocatalysis as they do in heterogeneous dark catalysis, inasmuch as the density and concentration of active sites are often unknown. Thus, the properties of a photocatalyst are not directly proportional to their area, in view of the fact that light does not equally reach every part of the surface or particle. Note also that photocatalysts may include several phases, in which case the overall area is physically not meaningful.</rdfs:comment>
        <rdfs:label>catalytic site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13992"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13997"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14000 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14000">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enhancement (alteration) of efficiency of photochemical reactions upon direct excitation of photoactive reactants via an intermediate interaction of these reactants with certain compounds that act as catalysts (promoters) of the appropriate chemical transformations of the reactants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Sometimes this process can be identical with photocatalysis.</rdfs:comment>
        <rdfs:label>catalysed photochemical reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14001 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14001">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adsorption at the surface of a pre-irradiated adsorbent (the photocatalyst) occurring in the dark, after the irradiation in the presence of the photoadsorbate entities is terminated, i.e., after preliminary photoadsorption.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>Coekelbergs–Solonitsyn effect</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Coekelbergs effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14087"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14002 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14002">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lattice defects (typically vacancies) that trap one or more electrons or holes in ionic crystals. They constitute a long-lived deep trap with a low efficiency of trapping of a carrier of the opposite sign.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Colour centres accumulate in irradiated solids and give rise to photoinduced extrinsic absorption bands (photoinduced colour) in semiconductors and insulators. The dominant decay pathway of colour centres upon irradiation at moderate temperatures is photoionisation with the formation of free carriers and empty traps.</rdfs:comment>
        <rdfs:comment>Monitoring the photocolouration of a metal oxide during a surface photochemical reaction probes whether the reaction is photocatalytic.</rdfs:comment>
        <rdfs:comment>The surface F (anion vacancies occupied by electrons) and V centres (trapped holes) in semiconductors and insulators are also colour centres with the distinction that they act as metastable active states of photocatalytic centres.</rdfs:comment>
        <rdfs:label>colour centres</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14003"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14010"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14014"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14043"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14003 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14003">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Trap defined by an energy level (of trapped carriers) within the bandgap energy of a semiconductor or insulator with an energy difference between it and the conduction band (for electrons) or valence band (for holes) much greater than the energy of thermal excitation of the solid at a given temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Some active states of a photocatalytic centre are called a deep trap (as in solid-state physics).</rdfs:comment>
        <rdfs:comment>The dominant decay pathway of the trap is either by trapping of carriers of the opposite sign (see recombination centre) or by photoionisation (see colour centres).</rdfs:comment>
        <rdfs:label>deep energy trap</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13991"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14002"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14081"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14004 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14004">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subsurface space where the majority carriers are forced away owing to band bending caused by the surface potential. (i) The subsurface layer of an n-type semiconductor becomes depleted of electrons, which are the majority carriers, as a consequence of upward band bending. (ii) The subsurface layer of a p-type semiconductor becomes enriched by electrons (depleted of holes) as a consequence of downward band bending.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>The surface charge sign is identical to the sign of the majority charge carriers. The surface charge (surface potential) in semiconductors is produced as a result of adsorption or contact with the medium (an electrolyte or another surface).</rdfs:comment>
        <rdfs:label>depletion layer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14027"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14005 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14005">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semiconductor or dielectric materials whose first band-to-band transition occurs from the highest level in the valence band to the lowest level in the conduction band possessing the same electron momentum, i.e., \(\boldsymbol{p}_{\rm{max}} = \boldsymbol{p}_{\rm{min}}\), with \(\boldsymbol{p}_{\rm{max}}\) and \(\boldsymbol{p}_{\rm{min}}\) the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>On photoexcitation, the electrons change their energy owing to the absorption of photons and maintain the same momentum.</rdfs:comment>
        <rdfs:label>direct bandgap semiconductor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14022"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14006 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14006">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simultaneous (or synchronous) formation of adsorbed species (adsorbate) via photoadsorption and detachment by photodesorption to yield the same species, both processes occurring under photoexcitation of the solid photocatalyst (adsorbent).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>dynamic photoadsorption process</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14048"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14007 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14007">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of product entities (atoms, molecules, or radicals) generated by each \(\pu{100 eV}\) of radiation incident on the system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>In SI units, it refers to the amount of substance in \(\pu{\upmu mol}\) generated for each joule of radiation incident on the system. SI unit is \(\pu{\upmu mol J-1}\).</rdfs:comment>
        <rdfs:comment>It is convenient to use the amount of substance \(\ce{B}\) in \(\pu{E-7 mol}\) of \(\ce{B}\), generated for each joule of radiation incident on the system. By choosing this (submultiple of) SI unit, a number almost identical to the _009683_ value (within \(\pu{4\%}\)) in the obsolete unit \(\pu{(100 eV)-1}\) is obtained, as \(\pu{(100 eV)-1} = \pu{1.036E-7 mol J-1}\).</rdfs:comment>
        <rdfs:label>effective radiation-catalytic activity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14069"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14008 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14008">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Array of charged species and oriented dipoles existing at a solid-solution interface. The solid may be a metal or a semiconductor. Double refers to the fact that the surface charge and its counter charge at the solution side are included.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Often the solution side is considered to be composed of a thin inner layer of (hydrated) ions in contact with the surface and a diffuse layer further out in solution.</rdfs:comment>
        <rdfs:label>electrical double layer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14009 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14009">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absorption of ultraviolet, visible, or infrared radiation yielding optical information on the excitons in solids. Exciton absorption bands in a spectrum of a semiconductor or insulator are located on the long wavelength side of the fundamental absorption edge.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>exciton absorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14017"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14010 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14010">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators corresponding to optical transitions of electrons from defect energy levels (within the bandgap energy) to conduction band levels, or holes to valence band levels (photoionisation of defects), or from the ground state level to excited levels of a given intrinsic defect of any sort.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Doping of a catalyst creates an extrinsic defect.</rdfs:comment>
        <rdfs:comment>Typically, extrinsic absorption bands are a few tenths to a few \(\pu{eV}\) distant from the fundamental absorption edge in semiconductors and insulators. The red limits of photocatalytic reactions are determined by photoexcitation of photocatalysts in the extrinsic absorption bands.</rdfs:comment>
        <rdfs:label>extrinsic absorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14017"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14026"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14011 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14011">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Imperfection in a solid semiconductor (or insulator) connected with surface defects of any sort involving extrinsic chemical units in relation to the chemical formula of the solid, particularly adsorbed species of any sort.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>extrinsic surface defect</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Doping of a catalyst creates an extrinsic defect.</rdfs:comment>
        <rdfs:comment>These extrinsic surface defects play an essential role in heterogeneous photocatalysis. For example, they can serve as photocatalytic centres (sites). Surface defects, as well as bulk defects located in the near-surface region, can serve as entities that absorb ultraviolet, visible, or infrared radiation and generate free charge carriers. Surface defects can trap charge carriers and serve as recombination centres, thereby influencing the concentration of photocarriers at the surface of photocatalyst particles.</rdfs:comment>
        <rdfs:label>extrinsic defect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14043"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14081"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14012 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14012">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Anion vacancies occupied by electrons in semiconductors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>F centres</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14002"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14013 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14013">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Splitting of the Fermi level in irradiated semiconductors and insulators into two Fermi quasi-levels for electrons \(E_{\rm{F}}^{\rm{e}}\) and for holes \(E_{\rm{F}}^{\rm{h}}\), displaced toward the bottom of the conduction band and toward the top of the valence band, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>The larger the radiant power of the radiation, the larger is the Fermi level energy splitting, \(\Delta {\rm{F}} = E_{\rm{F}}^{\rm{e}} - E_{\rm{F}}^{\rm{h}}\).</rdfs:comment>
        <rdfs:comment>The positions of the Fermi quasi-levels within the bandgap energy determine the concentration of free thermalised photocarriers in irradiated solid photocatalysts.</rdfs:comment>
        <rdfs:label>Fermi level splitting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14040"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14014 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14014">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applies to free electrons or free holes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>free charge carriers</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14015"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14015 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14015">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photoexcited electrons from the valence band into the conduction band in semiconductors and insulators.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>The expression &quot;free electron carrier&quot; is redundant and not recommended.</rdfs:comment>
        <rdfs:comment>Thermoexcitation or doping with certain impurities also leads to formation of free electrons in the conduction band of semiconductors. In metals and n-type semiconductors free electrons exist originally.</rdfs:comment>
        <rdfs:label>free electrons</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14016 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14016">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators inducing optical transitions of electrons originating exclusively from the valence band to the conduction band to yield free electron-hole pairs and/or exciton absorption bands.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>intrinsic absorption</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fundamental absorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14010"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14017 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14017">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High wavelength limit of the fundamental absorption band in the spectrum of semiconductors and of insulators.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>fundamental absorption threshold</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fundamental absorption edge</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14016"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14018 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14018">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photocatalysis taking place at the interfacial boundary between two phases (solid/liquid, solid/gas, liquid/gas).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>heterogeneous photocatalysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14019 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14019">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiation catalysis taking place in heterogeneous systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>heterogeneous radiation catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14020 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14020">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photocatalysis taking place in homogeneous systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>homogeneous photocatalysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14021 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14021">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiation catalysis taking place in homogeneous systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>homogeneous radiation catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14022 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14022">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semiconductor or dielectric materials with a first band-to-band transition from the highest level in the valence band to the lowest level in the conduction band requiring the change of electron momentum, that is \(\boldsymbol{p}_{\rm{max}}  eq \boldsymbol{p}_{\rm{min}}\), where \(\boldsymbol{p}_{\rm{max}}\) and \(\boldsymbol{p}_{\rm{min}}\) are the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Direct band-to-band electronic transitions between two bands of different momentum (e.g., \(\boldsymbol{p}_{\rm{max}} \neq \boldsymbol{p}_{\rm{min}}\)) are forbidden because momentum must be conserved. Upon excitation, such changes occur owing to interaction of the electronic subsystem with the phonons.</rdfs:comment>
        <rdfs:label>indirect bandgap semiconductor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14005"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14023 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14023">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physical phenomenon considering scattered radiative energy from rays in any direction \(\mathit{\Omega}&apos;\) into the direction \(\mathit{\Omega}\) of the rays considered in the radiative transfer equation (RTE).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>scattering in (into the beam under consideration)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mathematical definition: \[{\rm{Sc}}_{\rm{in}} = \frac{\sigma_{\lambda} (\boldsymbol{x},t)}{4\pi} \int_{4\pi} B_{\lambda} (\mathit{\Omega}&apos; \rightarrow \mathit{\Omega}) L_{\mathit{\Omega},\lambda} (\boldsymbol{x},t)\ {\rm{d}}\mathit{\Omega}&apos;\] where \(\boldsymbol{x}\) is the spatial coordinate in a three-dimensional space along the propagation of the beam, \(t\) is the time coordinate, \(\sigma_{\lambda} (\boldsymbol{x},t)\) is the space- and time-dependent napierian linear scattering coefficient, \(L_{\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) is the incident time- and space-dependent radiance and \(B_{\lambda}\) is the phase function, i.e., a distribution function acting as a source of photons from any direction \(\mathit{\Omega}&apos;\) into the direction \(\mathit{\Omega}\) under consideration. SI unit is \(\pu{W sr-1 m-4}\). Common unit is \(\pu{W sr-1 cm-3 nm-1}\).</rdfs:comment>
        <rdfs:comment>Mathematical expression in photon terms: \[{\rm{Sc}}_{\rm{in}} = \frac{\sigma_{\lambda}(\boldsymbol{x},t)}{4\pi} \int_{4\pi} B_{\lambda} (\mathit{\Omega}&apos; \rightarrow \mathit{\Omega}) L_{\rm{p},\mathit{\Omega},\lambda} (\boldsymbol{x},t)\ {\rm{d}}\mathit{\Omega}&apos;\] with \(L_{\rm{p},\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) the incident spectral photon radiance. SI unit is \(\pu{s-1 sr-1 m-4}\) in photon number basis and \(\pu{mol s-1 sr-1 m-4}\) in chemical amount basis. Common unit is \(\pu{s-1 sr-1 cm-3 nm-1}\) in photon number basis and \(\pu{einstein s-1 sr-1 cm-3 nm-1}\) in chemical amount basis.</rdfs:comment>
        <rdfs:label>in-scattering</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14030"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14024 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14024">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electron transfer taking place from a photoexcited semiconductor onto another semiconductor (or insulator) in its ground state leading to vectorial (irreversible) charge transfer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>IPET</oboInOwl:hasRelatedSynonym>
        <rdfs:label>interparticle electron transfer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IPET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14025 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14025">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Band-to-band recombination of electrons and holes (or exciton decay) in a semiconductor or insulator leading to luminescence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>intrinsic emission</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14026 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14026">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Imperfections connected with surface point defects (zero-dimensional), linear defects (one-dimensional), or square defects (two-dimensional) not including extrinsic chemical units in relation to the chemical formula of the solid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>intrinsic surface defects</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Surface vacancies, anionic vacancies (in n-type semiconductors), cationic vacancies (in p-type semiconductors), interstitial cations, edges, corners and kinks are some examples of intrinsic surface defects.</rdfs:comment>
        <rdfs:label>intrinsic defects</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14011"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14027 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14027">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Layer formed when band bending places the Fermi level on the surface close to the band of the bulk minority charge carriers. This leads to a higher concentration of the minority charge carriers on the surface relative to the concentration of the majority charge carriers, an opposite situation to that in the bulk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>inversion layer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13989"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14004"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14028 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14028">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Absorption term in the radiative transfer equation (RTE). Mathematical expression is \[\alpha_{\lambda} (\boldsymbol{x},t) L_{\mathit{\Omega},\lambda} (\boldsymbol{x}/t)\] with \(\alpha_{\lambda} (\boldsymbol{x},t)\) the space- and time-dependent linear napierian absorption coefficient and \(L_{\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) the spectral radiance arriving at position \(x\) and time \(t\) from every possible angular directions \(\mathit{\Omega}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>local differential absorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14029 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14029">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production of complex organic substances by higher plants, algae and photosynthesising bacteria from simple compounds (e.g., carbon dioxide and water, hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation energy absorbed by, e.g., chlorophyll, chlorophyll-protein complexes, and natural chromoproteins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>natural photosynthesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13993"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14030 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14030">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Physical process by which the incoming electromagnetic radiation is forced to deviate from a straight trajectory by non-uniformities in the medium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>scattering out (out of the beam under consideration)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mathematical definition: \({\rm{Sc}}_{\rm{out}} = \sigma_{\lambda} (\boldsymbol{x},t) L_{\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) where \(\boldsymbol{x}\) is the coordinate in a three-dimensional space in the path of the beam, \(t\) is the time coordinate, \(\sigma_{\lambda} (\boldsymbol{x},t)\) is the space- and time-dependent linear napierian scattering coefficient, \(L_{\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) is the incident space- and time-dependent radiance in the direction \(\mathit{\Omega}\). SI unit is \(\pu{W sr-1 m-4}\). Common unit is \(\pu{W sr-1 cm-3 nm-1}\).</rdfs:comment>
        <rdfs:comment>Physical phenomenon taking into account scattered radiative energy from the rays in the direction \(\mathit{\Omega}\) considered in the radiative transfer equation (RTE) into any direction \(\mathit{\Omega}&apos;\).</rdfs:comment>
        <rdfs:comment>The mathematical definition in photon terms is: \({\rm{Sc}}_{\rm{out}} = \sigma_{\lambda} (\boldsymbol{x},t) L_{\rm{p},\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) with \(L_{\rm{p},\mathit{\Omega},\lambda} (\boldsymbol{x},t)\) the incident space- and time-dependent photon radiance. SI unit is \(\pu{s-1 sr-1 m-4}\) in photon number basis and \(\pu{mol s-1 sr-1 m-4}\) in chemical amount basis. Common unit in photon number basis is \(\pu{s-1 sr-1 cm-3 nm-1}\) and \(\pu{einstein s-1 sr-1 cm-3 nm-1}\) in chemical amount basis.</rdfs:comment>
        <rdfs:label>out-scattering</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14023"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14031 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14031">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distribution function representing the fraction of photons scattered from any direction \(\mathit{\Omega}&apos;\) into the direction \(\mathit{\Omega}\) under consideration in the radiative transfer equation (RTE). Dimension one.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>phase function</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14032 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14032">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Entity (molecule, atom, or ion) bound to the surface of a solid (semiconductor or insulator) particle (typically to a photoadsorption centre) as the result of photoexcitation of either the solid or the entity (molecule, atom, or ion).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>photoadsorbed species</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>When photoadsorption is a step in a photocatalytic reaction, the photoadsorbed entity may be considered an intermediate in the given reaction.</rdfs:comment>
        <rdfs:label>photoadsorbate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14033 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14033">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum amount of substance photoadsorbed per area on the uniformly irradiated surface of an adsorbent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Mathematical expression, \(\gamma^{\rm{s}} = N_{\rm{max}}/S\), where \(N_{\rm{max}}\) is the maximal number of entities or moles photoadsorbed and \(S\) the total surface area. Experimental values of \(\gamma^{\rm{s}}\) in entities are in the range \(\pu{E10 - E12 cm-2}\).</rdfs:comment>
        <rdfs:comment>Photoadsorption area number should be preferred to photoadsorption capacity (the original name given to this term), since the latter term is reserved for the fractional number, referring to the number of regular sites available for photoadsorption.</rdfs:comment>
        <rdfs:comment>The quantity \(N_{\rm{max}}\) can be obtained by approximation from photoadsorption kinetics \(N(t)\) on a uniformly irradiated surface provided that(i) the powdered sample is uniformly irradiated. Then, the area of the irradiated surface is \(S = m a^{\rm{s}}\), where \(m\) is the mass of the sample and \(a^{\rm{s}}\) is the specific surface area (\(\pu{m2 kg-1}\)) of a given adsorbent, or(ii) the efficiency of desorption of the adsorbed species (via a physical process) is negligible. Then the number of photocatalytic centres can be estimated from the photoadsorption area number, \(\gamma^{\rm{s}}\), to determine TON and TOF for a given photocatalytic reaction.</rdfs:comment>
        <rdfs:label>photoadsorption area number</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14032"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14037"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14034 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14034">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximal number of entities (molecules, atoms, or ions) per regular surface site that can be photoadsorbed at a uniformly irradiated surface of an adsorbent, \(\theta_{\rm{max}} = N_{\rm{max}}/N^{\rm{ss}}\) where \(N_{\rm{max}}\) is the maximal number of entities photoadsorbed and \(N^{\rm{ss}}\) is the number of surface sites (mainly regular surface sites, i.e., regular lattice ions or atoms; typically, \(N^{\rm{ss}}\) ca. \(\pu{E15 cm-2}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>This term has been often called maximal photoadsorption capacity. This denomination is redundant, because capacity already refers to the maximal possible value of a property.</rdfs:comment>
        <rdfs:comment>\(\theta_{\rm{max}}\) is a quantity of dimension one (a fractional number). \(\theta_{\rm{max}}\) is about \(\pu{E-5 - E-3}\).</rdfs:comment>
        <rdfs:label>photoadsorption capacity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14006"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14032"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14037"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14083"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14101"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14035 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14035">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface site or defect in its active state after photoexcitation capable of photoadsorbing species by a chemical interaction with the adsorbate entities (molecules, atoms, or ions).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photoadsorption centre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13990"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14036 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14036">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the maximal (typically the initial) rate of photoadsorption of entities \(\ce{B}\) (molecules, atoms, or ions) to the integrated incident (superscript 0, zero) photon flux, \(\int_{\lambda_{1}}^{\lambda_{2}} q_{\rm{p},\lambda}^{0}{\rm{d}}\lambda = q_{\rm{p}}^{0} = {\rm{d}}N_{\rm{p}}^{0}/{\rm{d}}t\), in the wavelength range \(\lambda_{1}{-}\lambda_{2}\). Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>For \(P_{\rm{AE}}\) determined under first-order conditions on photon flux and zero-order on concentration (or pressure), it corresponds to the efficiency of formation of the active photoadsorption centre.</rdfs:comment>
        <rdfs:comment>Mathematical expression: \[P_{\rm{AE}} = \frac{{\rm{d}}N_{\ce{B}}/{\rm{d}}t}{\int_{\lambda_{1}}^{\lambda_{2}} q_{\rm{p},\lambda}^{0}{\rm{d}}\lambda} \ {\rm{for}}\ t \to 0\] where \({\rm{d}}N_{\ce{B}}/{\rm{d}}t\) is the rate of adsorption of entities (the initial quasi-stationary rate of photoadsorption).</rdfs:comment>
        <rdfs:comment>The initial rate of photoadsorption in SI units is \({\rm{d}}p/{\rm{d}}t\) (\(\pu{Pa s-1}\)) for gas/solid systems, with \(p\) the pressure and in SI-coherent units \({\rm{d}}c/{\rm{d}}t\) (\(\pu{mol L-3 s-1}\)) for liquid/solid systems, with \(c\) the amount concentration of the adsorbate in solution.</rdfs:comment>
        <rdfs:label>photoadsorption efficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14035"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14037 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14037">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of entities (atoms, molecules or ions) photoadsorbed per regular surface site at a uniformly irradiated surface of an adsorbent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Mathematical expression: \(\theta_{\rm{ph}} = N/N^{\rm{ss}}\) with \(N\) the number of entities photoadsorbed and \(N^{\rm{ss}}\) the number of surface sites (mainly regular surface sites, i.e., regular lattice ions or atoms; typically, \(N^{\rm{ss}}\) ca. \(\pu{E15 cm-2}\)). \(\theta_{\rm{ph}}\) is a quantity of dimension one (it is a fractional number).</rdfs:comment>
        <rdfs:comment>The photoadsorption fraction, \(\theta_{\rm{ph}}\), is smaller than the photoadsorption capacity, \(\theta_{\rm{max}}\) (i.e., \(\theta_{\rm{ph}} \lt \theta_{\rm{max}}\)).</rdfs:comment>
        <rdfs:comment>\(\theta_{\rm{ph}}\) has been called photoadsorption number; fraction is preferred. It should not be called capacity, since the term capacity should be reserved for the maximal adsorption number.</rdfs:comment>
        <rdfs:label>photoadsorption fraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14032"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14033"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14034"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14083"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14038 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14038">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the maximal (typically the initial) rate of photoadsorption of entities \(\ce{B}\) (molecules, atoms, or ions) on a surface to the incident (superscript 0, zero) photon flux, \(q_{\rm{p},\lambda}^{0} = {\rm{d}}N_{\rm{p},\lambda}^{0}/{\rm{d}}t\) at a given wavelength. Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Mathematical expression: \(\frac{{\rm{d}}N_{\ce{B}}/{\rm{d}}t}{q_{\rm{p},\lambda}^{0}} \ \ {\rm{for}}\ t \to 0\)</rdfs:comment>
        <rdfs:comment>Yield refers to the use of monochromatic irradiation, whereas efficiency is reserved for irradiation within a wavelength range. Photonic refers to incident radiation.</rdfs:comment>
        <rdfs:label>photoadsorption photonic yield</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14036"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14039"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14039 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14039">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the number of photoadsorbed entities \(\ce{B}\) (molecules, atoms, or ions) on a surface to the number of photons of ultraviolet, visible, or infrared radiation (at a given wavelength \(\lambda\)) absorbed by the system (typically by the adsorbent) during the initial stage of irradiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Mathematical expression: \(\mathit{\Phi}_{\rm{ads}} = \frac{{\rm{d}}N_{\ce{B}}/{\rm{d}}t}{{\rm{d}}N_{\rm{p},\lambda}/{\rm{d}}t}\), for \(t \to 0\), i.e., the ratio of the initial rates of photoadsorption and monochromatic photons absorbed, with \(N_{\ce{B}}\) the number of entities adsorbed and \(N_{\rm{p},\lambda}\) the number of photons of wavelength \(\lambda\) absorbed. The photoadsorption quantum yield has been called \(K_{\rm{a}}\).</rdfs:comment>
        <rdfs:label>photoadsorption quantum yield</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14032"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14036"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14038"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14040 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14040">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonequilibrium free electron or free hole generated in a solid by ultraviolet, visible, or infrared absorption and occupying energy levels in the conduction band or the valence band, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Electrons occupying energy levels near the bottom of the conduction band and holes occupying energy levels near the top of the valence band (thermalised carriers) are considered as quasi-chemical intermediates. Nonthermalised (hot) carriers can also be involved in photocatalysed reactions.</rdfs:comment>
        <rdfs:label>photocarrier</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14041 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14041">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface centre, i.e., either a surface defect or a regular surface site, at which a chemical transformation takes place after converting the centre into an active state by a photophysical process, e.g., by photoexcitation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>The number of photoactive centres is very often difficult to establish, particularly on solid surfaces and in suspended particles.</rdfs:comment>
        <rdfs:comment>The photophysical process may include one or several processes such as direct excitation of the photocatalytic centre via absorption of ultraviolet, visible, or infrared radiation, via photocarrier trapping, via interaction with excitons, or via energy and/or electron transfer from a photoexcited reagent or intermediate.</rdfs:comment>
        <rdfs:comment>When the density of the active centres is unknown, the reaction rates may be related to the \(\rm{BET}(\ce{N2})\) area with the understanding that the parameter or property of the system will be a lower limit of the actual value, because the surface determined by \(\ce{N2}\) adsorption will be larger than that reached by the radiation. See Note 2 under the definition of Brunauer–Emmett–Teller (BET) surface area.</rdfs:comment>
        <rdfs:label>photocatalytic active centre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13997"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13999"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14040"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14042 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14042">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of entities (product) formed in a photocatalytic process (alternatively the number of reactant entities disappearing) divided by the number of photons absorbed by the photocatalyst at one single wavelength or within a defined wavelength range. For one wavelength it has the same meaning as quantum yield, whereas within a defined wavelength range it has the same meaning as quantum efficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>PCA</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This quantity has a well-defined meaning only when the reaction conditions are also stated and the results reported in terms of the initial conditions.</rdfs:comment>
        <rdfs:label>photocatalytic activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14042"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14043 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14043">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface centre, i.e., a surface defect or a regular surface site, in an active or electronically excited state at which a chemical transformation takes place.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photocatalytic centre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13999"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14041"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14044 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14044">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of entities (product) formed (alternatively the number of reactant entities disappearing) divided by the number of ultraviolet, visible, or infrared photons incident (prior to absorption) on the system and in a wavelength range \(\lambda_{1}{-}\lambda_{2}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Quantity relevant in applications of photocatalysis where the interest is to assess an engineering efficiency of energy out vs. energy in. In this context, the quantity has a well-defined meaning only when the operating conditions are also stated and results reported in terms of the initial conditions.</rdfs:comment>
        <rdfs:comment>When using photon flux (number basis or chemical amount basis) the term photonic efficiency is preferred, as efficiency refers to excitation within a wavelength range, whereas for monochromatic irradiation (and incident photons) the term photonic yield should be used.</rdfs:comment>
        <rdfs:label>photocatalytic efficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14058"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14045 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14045">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Commonly used to describe the oxidation of pollutants by the action of ultraviolet, visible, or infrared radiation and a catalyst.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>PCO</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Often used to describe the oxidation of organic pollutants at low concentrations by UV-light irradiation of \(\ce{TiO2}\).</rdfs:comment>
        <rdfs:label>photocatalytic oxidation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PCO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14046 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14046">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decomposition of the photocatalyst or of the electrodes as a result of a photoinduced reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Photocorrosion is one of the factors limiting the turnover number in heterogeneous photocatalysis.</rdfs:comment>
        <rdfs:comment>Process taking place during photoelectrochemical etching.</rdfs:comment>
        <rdfs:label>photocorrosion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14101"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14047 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14047">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photogeneration and movement of charge between two electrodes in a photovoltaic cell or a photoelectrochemical cell as a result of photoprocesses induced by light absorption.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photocurrent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14048 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14048">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Desorption induced by the absorption of ultraviolet, visible, or infrared radiation either by the adsorbate or by the adsorbent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Photodesorption can be a step in the overall mechanism in heterogeneous photocatalysis.</rdfs:comment>
        <rdfs:comment>Photodesorption is the inverse process of photoadsorption. For a particular system, both processes (or reactions) are induced by ultraviolet, visible, or infrared radiation of the same wavelength region.</rdfs:comment>
        <rdfs:label>photodesorption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14006"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14018"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14049 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14049">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of entities evolving into the medium from a surface divided by the number of photons absorbed at a given wavelength by a solid or by an adsorbed entity treated as a surface extrinsic defect (centre).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>In practice, for polychromatic irradiation, integration is performed in the wavelength range used and the quantity should be called photodesorption quantum efficiency.</rdfs:comment>
        <rdfs:comment>Mathematical expression of the integral photodesorption quantum yield: \[\mathit{\Phi}_{\rm{des}} = \frac{N_{\rm{des}}}{N_{\rm{p},\lambda}}\] where \(N_{\rm{des}}\) is the number of species desorbed and \(N_{\rm{p},\lambda}\) the number of photons of a particular wavelength absorbed during a given irradiation time.</rdfs:comment>
        <rdfs:comment>Should photoexcitation of a system be due to absorption by pre-adsorbed species (see extrinsic absorption), \(\phi_{\rm{des}}\) would not depend on the concentration of pre-adsorbed species.</rdfs:comment>
        <rdfs:comment>The differential expression is: \[\mathit{\Phi}_{\rm{des}} = \frac{{\rm{d}}N_{\rm{des}}/{\rm{d}}t}{q_{\rm{p},\lambda}}\] where \({\rm{d}}N_{\rm{des}}/{\rm{d}}t\) is the initial (quasistationary) or maximal photodesorption rate and \(q_{\rm{p},\lambda} = {\rm{d}}N_{\rm{p},\lambda}/{\rm{d}}t\) is the spectral photon flux absorbed by a solid or by an adsorbed entity treated as a surface extrinsic defect (centre).</rdfs:comment>
        <rdfs:label>photodesorption quantum yield</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14010"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14011"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14048"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14050 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14050">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrochemically assisted photocatalysis. The role of the photocatalyst is played by a photoelectrode, often a semiconductor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>In photoelectrocatalytic transformations it is possible to identify an electrode and an electrolyte combination in the system along with an explicit, generally macroscopic, electrical circuit for the charge transfer and/or for applying an additional electric potential to the system. This is not so in photocatalysis by colloids or fine dispersions of semiconductors.</rdfs:comment>
        <rdfs:label>photoelectrocatalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14051 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14051">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Electrode capable of initiating electrochemical transformations after absorbing ultraviolet, visible, or infrared radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photoelectrode</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14052 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14052">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which ultraviolet, visible, or infrared radiation is absorbed by a semiconductor, electron transfer occurs at the interface between the semiconductor and a liquid and the output is chemical energy, i.e., radiant energy is stored as chemical energy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photoelectrosynthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14053 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14053">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initiation of chemical transformations through the photochemical formation of molecular species, which (once formed) are catalytically active even without the action of ultraviolet, visible, or infrared radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photogenerated catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13999"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14054 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14054">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Charge carrying entity, especially an electron or a hole, in a semiconductor, produced by the absorption of ultraviolet, visible, or infrared radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photogenerated charge carrier</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14055 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14055">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent initiating certain chemical transformations under the action of ultraviolet, visible, or infrared radiation and consumed therewith.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>A photocatalyst can also act as a photoinitiator that, however, will not be consumed.</rdfs:comment>
        <rdfs:label>photoinitiator</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14056 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14056">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complete photodegradation of an organic compound into carbon dioxide and water, and other simple inorganic compounds (depending on the hetero-atom in the compound) upon absorption of ultraviolet, visible, or infrared radiation by the photocatalyst or by the adsorbate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photomineralisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14057 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14057">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons within a defined wavelength interval inside the irradiation window of the reactor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>FQE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>formal quantum efficiency</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A quantity called formal quantum efficiency (FQE) is sometimes used as synonymous for photonic efficiency and calculated from the known spectral distribution of the excitation source and the known absorption spectrum of the reaction system. It is calculated as the ratio between the rate of reaction and the incident photon flux.</rdfs:comment>
        <rdfs:comment>Mathematical definition: \[\xi = \frac{{\rm{d}}n/{\rm{d}}t}{\int_{\lambda_{1}}^{\lambda_{2}} q_{n,\rm{p},\lambda}^{0}{\rm{d}}\lambda}\] when using the incident spectral photon flux, chemical amount basis, \(q_{n,\rm{p},\lambda}^{0}\) with \(n\) (mol) the amount of substance produced or consumed, and \[\xi = \frac{{\rm{d}}N/{\rm{d}}t}{\int_{\lambda_{1}}^{\lambda_{2}} q_{\rm{p},\lambda}^{0} {\rm{d}}\lambda}\] when using the incident spectral photon flux, number basis, \(q_{\rm{p},\lambda}^{0}\) with \(N\) the number of entities produced or consumed. The superscript 0 (zero) emphasises the fact that the incident number of photons (prior to absorption) is used.</rdfs:comment>
        <rdfs:comment>When monochromatic radiation is used, formal quantum efficiency is \(\xi\); otherwise formal quantum efficiency \(\neq \xi\).</rdfs:comment>
        <rdfs:label>photonic efficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14044"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14058"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14084"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14057"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FQE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14058 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14058">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons of monochromatic light inside the irradiation window of the reactor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Mathematical definition: \[\frac{{\rm{d}}n/{\rm{d}}t}{q_{n,\rm{p},\lambda}^{0}}\] when using the incident spectral photon flux, chemical amount basis, \(q_{n,\rm{p},\lambda}^{0}\), with \(n\) (mol) the amount of substance produced or consumed, and \[\frac{{\rm{d}}N/{\rm{d}}t}{q_{\rm{p},\lambda}^{0}}\] when using the incident spectral photon flux, number basis, \(q_{\rm{p},\lambda}^{0}\), with \(N\) the number of entities produced or consumed. The superscript 0 (zero) emphasises the fact that the incident number of photons (prior to absorption) is used.</rdfs:comment>
        <rdfs:label>photonic yield</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14057"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14059 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14059">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plot of the photonic yield of a given photoprocess, measured at the same photon flux of incident (prior to absorption) light, as a function of a measure of the energy of the photons, i.e., for monochromatic irradiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>In practice, the photonic yield spectrum is obtained by normalising the rate of the given process to a certain number of incident photons provided that the photoresponse is linear on the incident photon fluence.</rdfs:comment>
        <rdfs:comment>Note that in photocatalysis the term yield is reserved for monochromatic irradiation, whereas the term efficiency is used for irradiation within a wavelength range. This is different from the use of efficiency as defined by IUPAC in photochemistry.</rdfs:comment>
        <rdfs:comment>Should the fluence dependence of the photoresponse be nonlinear (as is often the case in catalysed photoresponses), a plot of the photoresponse vs. fluence should be made at several wavelengths and a standard response should be chosen (e.g., two-lg reduction). A plot of the inverse of the &quot;standard response&quot; level as a function of wavelength is then the action spectrum of the photoresponse.</rdfs:comment>
        <rdfs:label>photonic yield spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14058"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14060 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14060">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiation catalysis under conditions not allowing a distinction between the effect of ultraviolet, visible, or infrared and of ionising radiation as well as the case in which the ionising radiation alone generates emission of chemically active light (e.g., the &apos;Cherenkov&apos; light emission).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photoradiation catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14061 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14061">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction initiated by photosensitisation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>photosensitised reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14000"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14062 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14062">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Catalysis occurring by the combined action of electronic excitation due to absorption of ultraviolet or visible radiation and thermal energy (infrared radiation or exothermic reactions) including catalytic phenomena.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>This often occurs upon exposure of a heterogeneous photocatalyst to infrared-light, laser emission, or solar radiation.</rdfs:comment>
        <rdfs:label>photothermocatalysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14063 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14063">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of physical processes leading to the relaxation of the electronically excited system without chemical transformations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Examples are radiative and nonradiative relaxations in molecules and surface complexes from the excited state to the ground state, recombination and trapping of free charge carriers and recombination decay of trapped carriers (particularly, recombination decay of carriers trapped by surface-active centres).</rdfs:comment>
        <rdfs:label>physical pathway</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14064 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14064">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiant energy (\(Q\), SI unit is \(\pu{J}\)) or amount of photons (in \(\pu{mol}\) or the non-SI unit einstein) absorbed per area or volume by an object irradiated during a given exposure time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>radiant dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14065 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14065">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increasing of catalytic activity or alteration of selectivity of a substance after its exposure to high-energy radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radioactivation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radiation-activation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.13999"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14066 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14066">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The word combination may be misleading. Usually radiation is absorbed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radiation-induced adsorption</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>radioadsorption</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radiation adsorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14067 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14067">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in the rate of a chemical reaction under the action of ionising radiation in the presence of a radiation catalyst.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>When using ionising radiation, from vacuum ultraviolet to higher energy, the phenomenon of photocatalysis cannot be distinguished from the phenomenon of radiation catalysis. Due to the nonselective absorption of ionising radiation, excitation of all reaction partners (both the reactants and the reaction catalysts) is possible. Thus, the phenomena globally designated as radiation catalysis include both direct radiation-induced and catalysed processes.</rdfs:comment>
        <rdfs:label>radiation catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14068"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14068 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14068">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance absorbing ionising radiation and able to produce chemical transformations of the reaction partners, repeatedly producing intermediate transformations and regenerating its chemical composition after each cycle of such interactions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>radiation catalyst</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14069 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14069">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of entities of a product formed (alternatively, the number of entities of a reactant disappearing) generated per \(\pu{100 eV}\) of energy absorbed from ionising radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>G value</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In SI units it refers to the amount of substance in \(\pu{\upmu mol}\) generated for each joule of radiation absorbed by the system. SI unit is \(\pu{\upmu mol J-1}\).</rdfs:comment>
        <rdfs:comment>It is convenient to use the amount of substance  \(\ce{B}\) in \(\pu{E-7 mol}\) of \(\ce{B}\), generated for each joule of radiation absorbed on the system. By choosing this (submultiple of) SI coherent unit, a number almost identical to the \(G\) value (within \(\pu{4\%}\)) in the obsolete unit \(\pu{(100 eV)-1}\) is obtained, as \(\pu{(100 eV)-1} = \pu{1.036E-7 mol J-1}\).</rdfs:comment>
        <rdfs:comment>Mathematical expression: \(G = 100 (N_{\ce{B}}/Q)\) where \(N_{\ce{B}}\) is the number of entities \(\ce{B}\) formed (or disappeared) and \(Q\) is the absorbed radiation energy in \(\pu{eV}\). Unit is \(\pu{(100 eV)-1}\).</rdfs:comment>
        <rdfs:comment>When the energy absorbed by the radiation catalyst cannot be calculated (as is often the case in radiation catalysis), the radiation chemical yield is calculated in terms of the energy absorbed by the system. In this case, it is an apparent yield.</rdfs:comment>
        <rdfs:label>radiation-chemical yield</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14007"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14068"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14070 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14070">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Desorption from solid or liquid interfaces induced by absorption of radiation by the solid or liquid adsorbent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>radiation desorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14071 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14071">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initiation of chemical transformations through the formation, by absorption of high-energy radiation, of substances that are catalytically active even in the absence of the radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>radiation-generated catalysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14067"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14072 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14072">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adsorption of a molecular entity at solid or liquid interfaces induced by absorption of high-energy radiation by the solid or the liquid adsorbent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radiation adsorption</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>radioadsorption</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The word combination radiation adsorption is misleading. Usually, radiation is absorbed.</rdfs:comment>
        <rdfs:label>radiation-induced adsorption</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14073 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14073">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical change or physical process occurring in one entity (e.g., biological molecules, cells, and living organisms) as a result of initial absorption of high-energy radiation by the medium in the presence of another entity called the radiation sensitiser.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radiosensitisation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>High-energy radiation is absorbed usually nonspecifically in the medium (e.g., solvent) and all chemical reactions arise from the products of this primary energy absorption.</rdfs:comment>
        <rdfs:label>radiation sensitisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14074"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14074 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14074">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical substance that increases the radiation sensitivity of, in particular, biological molecules, cells and biological organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radiosensitiser</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radiation sensitiser</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14073"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14075 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14075">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase of diffusion of an adsorbate under the action of ionising radiation absorbed by either the adsorbent and/or the adsorbate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radiostimulated diffusion</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radiation-stimulated diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14076 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14076">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radiation catalysis under the action of large radiation fluxes that simultaneously heat the system as a consequence of absorption of energy from radiationless deactivation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>radiothermal catalysis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>radiation thermal catalysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14077 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14077">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>When a photon beam of radiance \(L_{\lambda}\) and angular distribution \(\mathit{\Omega}\) passes along a single direction of propagation through a medium, which is totally absorbing and/or scattering, i.e., the processes occurring are described by the following equation: \[\begin{array} \\ \frac{{\rm{d}}L_{\Omega,\lambda}(\boldsymbol{x},t)}{{\rm{d}}s} + \underbrace{\alpha_{\lambda}(\boldsymbol{x},t) L_{\mathit{\Omega},\lambda}(\boldsymbol{x},t)}_{\rm{adsorption}} + \underbrace{\sigma_{\lambda}(\boldsymbol{x},t) L_{\mathit{\Omega},\lambda}(\boldsymbol{x},t)}_{\rm{out\mbox{-}scattering}} = \\ \underbrace{j_{\lambda}(\boldsymbol{x},t)}_{\rm{emission}} + \underbrace{\frac{\sigma_{\lambda}(\boldsymbol{x},t)}{4\pi}B_{\lambda}(\mathit{\Omega}&apos; \to \mathit{\Omega}) L_{\mathit{\Omega},\lambda}(\boldsymbol{x},t){\rm{d}}\mathit{\Omega}&apos;}_{\rm{in\mbox{-}scattering}} \end{array}\] where \(\frac{{\rm{d}}L_{\Omega,\lambda}(\boldsymbol{x},t)}{{\rm{d}}s}\) is the directional derivative along the direction \(s\) at a point \(\boldsymbol{x}\) in the reaction space of the incident radiance, \(\alpha_{\lambda}(\boldsymbol{x},t)\) is the space- and time-dependent spectral linear napierian absorption coefficient, \(\sigma_{\lambda}(\boldsymbol{x},t)\) is the space- and time-dependent spectral linear napierian scattering coefficient, \(j_{\lambda}(\boldsymbol{x},t)\) represents the spontaneous and/or induced emission, and \(B_{\lambda}\) is the phase function. All quantities are a function of time. The RTE is written for the direction \(s\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>RTE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Absorption and out-scattering reduce the radiance along the axis of propagation, whereas in-scattering and emission, increases it. Normally, emission can be safely neglected in photocatalysis.</rdfs:comment>
        <rdfs:comment>Back scattering and forward scattering are global effects derived from the integration of absorption, in-scattering, out-scattering, and emission.</rdfs:comment>
        <rdfs:comment>The RTE is a representation of the (radiation) energy conservation law and its solution in cases with complex geometry and in the presence of scattering remains a challenging issue.</rdfs:comment>
        <rdfs:label>radiative transfer equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14023"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14028"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14030"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14031"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14077"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RTE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14078 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14078">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of carriers (or electron-hole pairs, or excitons) produced per time interval and per volume of a solid photocatalyst particle due to the absorption of light.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>rate of photogeneration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In kinetic studies of photocatalysed reactions, the rate of generation is typically considered as a constant \(g = \alpha(\lambda)\ E_{\rm{p}, \lambda}^{0}\) (uniform generation), which corresponds to the so-called weak light absorption case [\(\alpha(\lambda) x \ll 1\)].</rdfs:comment>
        <rdfs:comment>The rate of photogeneration in the bulk of optical uniform photocatalyst particles depends on the distance (\(x\)) from the irradiated surface.</rdfs:comment>
        <rdfs:comment>The rate of photogeneration of carriers, \(g(x)\), has the general mathematical expression: \[g(x) = \alpha(\lambda)\ E_{\rm{p},\lambda}^{0}\ (1 - \rho) \exp[-\alpha(\lambda)x]\] where \(\alpha(\lambda)\) is the napierian (spectral) absorption coefficient, \(E_{\rm{p},\lambda}^{0}\) is the incident (superscript 0) spectral photon irradiance and \(\rho\) the reflectance. SI unit of \(g(x)\) is \(\pu{m-3 s-1}\) for \(q_{n,\rm{p},\lambda}^{0}\) in photon number basis and \(\pu{mol m-3 s-1}\) for \(q_{\rm{p},\lambda}^{0}\) in chemical amount basis.</rdfs:comment>
        <rdfs:comment>\(g(x)\) is related to the number of photogenerated electrons (\(N_{\rm{e}}\)) and holes (\(N_{\rm{h}}\)) as \(N_{\rm{e}} = g(x) \tau_{\rm{e}}\) and \(N_{\rm{h}} = g(x) \tau_{\rm{h}}\), where \(\tau_{\rm{e}}\) and \(\tau_{\rm{h}}\) are the lifetimes of the free electrons and holes, respectively.</rdfs:comment>
        <rdfs:label>rate of generation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14094"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14079 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14079">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decay of carriers at the surface of a solid or interface between different phases, e.g., at the crystal surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Inverse of the lifetime of free carriers in the bulk of the particle. The greater \(s\) is, the smaller is the stationary concentration of photocarriers at the surface (and vice versa). SI unit is \(\pu{s-1}\).</rdfs:comment>
        <rdfs:label>rate of surface recombination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14014"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14080 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14080">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two-step transition of an electron from the conduction band to a defect centre and then further to the valence band, or from the defect centre to the valence band (first step) and a subsequent transition of the conduction band electron to the defect centre (second step).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>recombination of photocarriers via defects</oboInOwl:hasRelatedSynonym>
        <rdfs:label>recombination of photocarriers</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14081"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14081 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14081">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defect in semiconductors and insulators capable of sequential capture of free charge carriers of both signs with high efficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Provides a path for the recombination of free electrons and holes at high rates. Typically, in imperfect wide-bandgap energy solids, the rate of photoinduced carrier recombination through recombination centres at moderate photon irradiance is larger than the rate of band-to-band recombination.</rdfs:comment>
        <rdfs:label>recombination centre</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14082 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14082">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Perfect surface of a solid without heterogeneity or defect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Rigorously speaking, this is a theoretical notion. In practice, however, this term is used to refer to local space regions of real relaxed and reconstructed surfaces if the perturbations caused by the nearest adjacent (surface) defects can be neglected.</rdfs:comment>
        <rdfs:label>regular surface</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14083 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14083">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Zero-dimension site (atom, ion, or interstitial position) at a regular surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>It can be a photocatalytic centre (site) in the ground (not active) state in some particular cases of heterogeneous photocatalysis as, e.g., in the case when pre-physisorbed entities trap photocarriers in the course of the photocatalysed reaction.</rdfs:comment>
        <rdfs:label>regular surface site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14043"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14082"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14084 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14084">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the photonic efficiency (\(\xi\)) of a chemical process to the corresponding photonic efficiency of a standard process under otherwise identical conditions in the same reactor configuration and operation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>For measurements carried out at constant photon flux, \(\xi_{\rm{rel}}\) can be estimated as the ratio of the corresponding reaction initial rates (for \(t \to 0\)), determined under identical conditions.</rdfs:comment>
        <rdfs:comment>Protocols for the determination of \(\xi_{\rm{rel}}\) have been reported.</rdfs:comment>
        <rdfs:comment>See the restrictions about the determination of quantum yields in photocatalysis mentioned in the Introduction of the source IUPAC Recommendation.</rdfs:comment>
        <rdfs:label>relative photonic efficiency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14057"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14085 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14085">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Efficiency of scattering, i.e., ratio of scattering coefficient, \(\sigma(\lambda_{\rm{i}})\), to the total attenuance coefficient, \(\beta(\lambda_{\rm{i}})\), at a particular wavelength \(\lambda_{\rm{i}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>A scattering albedo of 1 indicates total scattering, whereas a scattering albedo of 0 indicates that all attenuance is due to absorption.</rdfs:comment>
        <rdfs:comment>Mathematical expression: \(\sigma(\lambda_{\rm{i}})/\beta(\lambda_{\rm{i}})\). Dimension one.</rdfs:comment>
        <rdfs:label>scattering albedo</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14086 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14086">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Energy level (of trapped carrier) within the bandgap energy, near the bottom of the conduction band (electron shallow trap) and near the top of the valence band (hole shallow band) at an energy such that \(E_{\rm{trap}} \approx kT\), with \(k\) the Boltzmann constant and \(T\) the thermodynamic temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>shallow energy trap</oboInOwl:hasRelatedSynonym>
        <rdfs:label>shallow trap</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14087 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14087">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adsorption (or reaction) after preliminary irradiation of a photocatalyst in vacuum (or in the absence of reagent).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>post-adsorption</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Solonitsyn effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14001"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14088 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14088">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reactor in which a hybrid technique combining &apos;sonochemical&apos; and photocatalytic reactions is used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>This type of reactor has been proposed for the treatment of wastewaters.</rdfs:comment>
        <rdfs:label>sonophotocatalytic reactor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14089 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14089">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Region formed within a semiconductor in contact with another phase in which there is a band bending that can be upward or downward.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>space charge region</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14004"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14090 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14090">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum number of entities (molecules, atoms or radicals) adsorbed as a result of irradiation divided by the surface area and by the mass of adsorbent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>This definition, per area and per mass, is misleading. It is included for historical reasons and was originally called specific photoadsorption capacity.</rdfs:comment>
        <rdfs:label>specific photoadsorption number</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14034"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14091 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14091">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Linear napierian, \(\alpha_{\lambda}^{\ast}\), or linear decadic, \(a_{\lambda}^{\ast}\), absorption coefficient divided by the mass concentration, \(\rho\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>specific linear Napierian spectral absorption coefficient</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>specific linear decadic spectral absorption coefficient</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>specific spectral absorption coefficient</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Absorption coefficient is always a spectral property; the subscript \(\lambda\) may be omitted but the wavelength should be specified.</rdfs:comment>
        <rdfs:comment>For reacting systems with mass fluctuations and high scattering, space- and time-dependent specific, napierian and decadic, absorption coefficients are necessary, i.e., \(\alpha_{\lambda}^{\ast}(\boldsymbol{x},t)\) and \(a_{\lambda}^{\ast}(\boldsymbol{x},t)\), respectively; \(\boldsymbol{x}\) defines the position in a three-dimensional space.</rdfs:comment>
        <rdfs:comment>Mathematical definition: \[\alpha_{\lambda}^{\ast} = \frac{\alpha_{\lambda}}{\rho} \quad {\rm{or}} \quad a_{\lambda}^{\ast} = \frac{a_{\lambda}}{\rho}\] SI unit is \(\pu{m kg-1}\) , common unit is \(\pu{m g-1}\) or \(\pu{cm2 g-1 nm-1}\).</rdfs:comment>
        <rdfs:comment>The asterisk as superscript indicates that it is a specific property.</rdfs:comment>
        <rdfs:label>specific absorption coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14092 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14092">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attenuance (napierian), \(D_{\rm{e}}\), divided by the absorption pathlength, \(l\), and the mass concentration, \(\rho\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>specific Napierian extinction coefficient</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>specific Napierian spectral extinction coefficient</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>specific spectral Napierian attenuance coefficient</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In common use for \(l\) in \(\pu{cm}\) and \(\rho\) in (\(\pu{g cm-3}\)), \(\beta_{\lambda}^{\ast}\) is in \(\pu{cm2 g-1}\).</rdfs:comment>
        <rdfs:comment>Mathematical expression: \[\beta_{\lambda}^{\ast} = \left(\frac{1}{\rho\,l}\right) \ln \left(\frac{P_{\lambda}^{0}}{P_{\lambda}}\right) = \frac{D_{\rm{e},\lambda}}{\rho\,l}\] where \(P_{\lambda}^{0}\) and \(P_{\lambda}\) are, respectively, the incident and transmitted spectral radiant power or the incident and transmitted spectral photon flux.</rdfs:comment>
        <rdfs:comment>Sometimes called mass napierian (spectral) attenuance coefficient.</rdfs:comment>
        <rdfs:comment>Strictly speaking, the spectral quantity should be used, which is the derivative of the specific napierian attenuance coefficient with respect to \(\lambda\), i.e., \({\rm{d}}\beta\!\ast\!(\lambda)/{\rm{d}}\lambda\) in common units \(\pu{cm2 g-1 nm-1}\) or in \(\pu{cm g-1}\). In practice, the subscript is omitted and the respective unit is not taken into account. The wavelength should be specified.</rdfs:comment>
        <rdfs:comment>The specific napierian attenuance coefficient reduces to specific napierian absorption coefficient for a non-reflecting and non-scattering sample.</rdfs:comment>
        <rdfs:label>specific napierian attenuance coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14093 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14093">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fraction of attenuance (napierian) not due to absorbance, divided by the pathlength, \(l\), within the scattering medium and the mass concentration, \(\rho\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>specific spectral napierian scattering coefficient</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Mathematical expression: \[\sigma_{\lambda}^{\ast} = \sigma_{\lambda}/\rho = [D_{\rm{e},\lambda} - A_{\rm{e},\lambda}]/(l\,\rho)\], where \(\rho\) is the mass concentration. The absorbance should be subtracted from the total attenuance for the calculation of \(\rho_{\lambda}\) and \(\rho_{\lambda}^{\ast}\).</rdfs:comment>
        <rdfs:comment>Sometimes called mass napierian (spectral) scattering coefficient.</rdfs:comment>
        <rdfs:comment>Strictly speaking, the spectral quantity should be used, which is the derivative of the specific napierian scattering coefficient with respect to \(\lambda\), i.e., \({\rm{d}}\sigma\!\ast\!(\lambda)/{\rm{d}}\lambda\) in common units \(\pu{cm2 g-1 nm-1}\) or in \(\pu{cm g-1}\). In practice, the subscript is omitted and the respective unit is not taken into account. The wavelength should be specified.</rdfs:comment>
        <rdfs:comment>The superscript asterisk indicates that it is a specific property.</rdfs:comment>
        <rdfs:label>specific napierian scattering coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14094 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14094">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Derivative of photon irradiance, \(E_{\rm{p}}\), with respect to wavelength, \(\lambda\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>All spectral terms may also be defined as derivatives with respect to frequency, \(\nu\), or wavenumber, \(\tilde{\nu}\) and are referred to, when necessary, as in terms of wavelength, or frequency or wavenumber, respectively.</rdfs:comment>
        <rdfs:comment>Mathematical expression: \(E_{\rm{p},\lambda} = {\rm{d}}E_{\rm{p}}/{\rm{d}}\lambda\). SI unit is \(\pu{s-1 m-3}\); common unit is \(\pu{s-1 m-2 nm-1}\).</rdfs:comment>
        <rdfs:comment>This quantity can be expressed on a chemical amount basis by dividing \(E_{p,\lambda}\) by the Avogadro constant, the name then being &quot;spectral photon irradiance, amount basis&quot;, the symbol \(E_{n,{\rm{p}},\lambda}\) and the SI unit \(\pu{mol s-1 m-3}\); common unit is \(\pu{einstein s-1 m-2 nm-1}\).</rdfs:comment>
        <rdfs:label>spectral photon irradiance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14095 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14095">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dependence of the photonic yield on the photon energy (wavelength, frequency, or wavenumber) of the radiation for a given photoreaction obtained at a certain incident (prior to absorption) photon irradiance in a given spectral range.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>In practice, it is normalised to a certain spectral photon flux provided that photoresponse scales linearly with it.</rdfs:comment>
        <rdfs:comment>Information concerning the photoexcitation of a solid photocatalyst can be obtained from a comparison of the spectral quantum yield with the spectral photonic efficiency.</rdfs:comment>
        <rdfs:label>spectral photonic yield</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14057"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14058"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14096"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14096 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14096">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dependence of the quantum yield on the photon energy (wavelength, frequency or wavenumber) of the radiation absorbed by the reactant for a given photoreaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>To obtain information on the spectral variation of activity of a photocatalyst, the measured photoresponse must scale linearly with the photon flux at all wavelengths.</rdfs:comment>
        <rdfs:label>spectral quantum yield</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14097 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14097">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface regular or defect site that can initiate the chemical transformation of reagents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>surface-active centre</oboInOwl:hasRelatedSynonym>
        <rdfs:label>surface-active site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14012"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14102"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14098 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14098">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recombination of charge carriers at a solid surface or at an interface between different phases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>In theoretical models of heterogeneous photocatalysis, the photocarriers exchange between the solid and the reactants yielding products that may be considered as a specific type of surface recombination products.</rdfs:comment>
        <rdfs:label>surface recombination</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14040"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14079"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14099 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14099">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of absorption by the colour centres because of heating of the solid semiconductor or insulator.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>thermal bleaching</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14002"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14100 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14100">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A photocatalytic phenomenon occurring when the system is also heated by the ultraviolet, visible, or infrared radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>light-initiated thermocatalytic phenomena</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In case of high photon flux, thermochemical processes may take place as a result of radiationless deactivation of excited species, in addition to photochemical processes. This often occurs upon exposure of a heterogeneous photocatalyst to pulsed IR-light or pulsed laser emission.</rdfs:comment>
        <rdfs:label>thermophotocatalysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14101 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14101">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of times, \(n\), that the overall reaction (the photochemical transformation) goes through a photocatalytic cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <oboInOwl:hasRelatedSynonym>TON</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In heterogeneous photocatalysis it is the ratio of the number of photoinduced transformations for a given period of time to the number of active sites or photocatalytic centres in their ground state. Should the number of active sites be known, TON could be expressed per number of sites.</rdfs:comment>
        <rdfs:comment>In homogeneous photocatalysis it is the ratio of the number of photoinduced transformations for a given period to the number of ground state photocatalyst entities.</rdfs:comment>
        <rdfs:comment>It can be equally applied to homogeneous and heterogeneous systems.</rdfs:comment>
        <rdfs:comment>TON is a number, whereas in traditional catalysis, e.g., enzyme kinetics, it is defined per certain time period.</rdfs:comment>
        <rdfs:comment>TON is a quantity of dimension one attributed in photocatalysis to the overall system that contains the photocatalyst, even if, in heterogeneous photocatalysis, part of the photocatalyst active centres appears to be not irradiated.</rdfs:comment>
        <rdfs:label>turnover number</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14018"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14020"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14101"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TON</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14102 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14102">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Trapped holes in semiconductors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:label>V centres</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14002"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14103 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14103">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term commonly used to designate organic gas-phase pollutants frequently degraded by photocatalytic procedures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-09-36"/>
        <rdfs:comment>Often used for any organic compound with a vapor pressure higher than \(\pu{10 Pa}\) at \(\pu{T} = \pu{293 K}\).</rdfs:comment>
        <rdfs:label>volatile organic chemical/compounds</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14104 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14104">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which response is determined by the detection of light absorption by an assay component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>optical density assay (obsolete)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The concentration of the absorbing species can be quantified using the Beer–Lambert law (or Beer–Lambert–Bouguer law) \[A = \varepsilon cl = \lg\left(\frac{P_{0}}{P}\right)\] where \(\varepsilon\) is the molar absorption coefficient of the absorbing species, \(l\) is the absorption path length, and \(c\) the amount concentration. A sample is irradiated with a specific wavelength of light, typically in the ultraviolet or visible spectral region; the spectral radiant power of incident light on the sample (\(P_{0}\)) and transmitted radiation after passing through the sample (\(P\)) are used to calculate absorbance (\(A\)).</rdfs:comment>
        <rdfs:label>absorbance assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14105 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14105">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sample that produces a response or signal above a defined threshold at a tested concentration in a single assay or screen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>When the properties and identity of an active or hit are confirmed by subsequent experiment it becomes a confirmed hit.</rdfs:comment>
        <rdfs:label>active</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14123"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14150"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14189"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14106 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14106">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graphical representation of the number of samples present in each activity range.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Often shown as a frequency distribution graph, it provides an overview of the screening results and typically allows the determination of the overall background signal and threshold for selection of actives.</rdfs:comment>
        <rdfs:label>activity distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14105"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14107 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14107">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Binding site on a protein, distinct from the site recognized by an endogenous agonist (i.e., the orthosteric site) in the case of a receptor, or substrate in the case of an enzyme, that when occupied by a ligand effects a conformational change in the protein, thus altering its signaling, catalytic properties, or its capability to interact with other macromolecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>allosteric site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14173"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14108 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14108">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Observation, effect, or result that is inaccurate because it is produced by the methodology used in scientific investigation or by experimental error.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>artefact</oboInOwl:hasRelatedSynonym>
        <rdfs:label>artifact</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14109 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14109">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experiments conducted to verify that the output measurements of the assay are consistently reflective of the activity against the target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Results are compared internally over multiple runs and externally (when available) to existing literature parameters such as \(K_{\rm{d}}\), \(K_{\rm{i}}\), \(K_{\rm{m}}\), or \(\pu{EC_{50}}\).</rdfs:comment>
        <rdfs:label>assay validation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14110 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14110">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device that performs one or more functions without human intervention by means of direct control or by programmed operations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Often referred to as a peripheral or peripheral device when it is an instrument incorporated into a module, a workstation, or a fully automated system.</rdfs:comment>
        <rdfs:label>automated device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14164"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14202"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14111 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14111">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the specific physical association or interaction between two molecules (e.g., ligand–receptor, antibody–antigen, protein–protein, ligand–transport protein) is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The assay can be homogeneous or heterogeneous, competitive or noncompetitive, and may be run at equilibrium or in kinetic mode. Appropriate assay controls and/or standard reagents are often needed to determine the specific binding in contrast to nonspecific adsorption processes.</rdfs:comment>
        <rdfs:label>binding assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14112 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14112">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graphical representation of the relationship between the amount of ligand that is specifically bound to a receptor per mass of binding material and the amount of free ligand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A Scatchard plot was formerly used to determine \(B_{\rm{max}}\) and \(K_{\rm{d}}\). It is now more common to determine these parameters by nonlinear least-squares fitting to the binding equation given above.</rdfs:comment>
        <rdfs:comment>For a system containing a single binding site and lacking cooperative interactions, the binding isotherm is described by \[B = B_{\max}[\ce{L}]/(K_{\rm{d}} + [\ce{L}])\] where \(\ce{B}\) is the amount of ligand specifically bound, \([\ce{L}]\) is the amount concentration of free ligand, \(K_{\rm{d}}\) is the equilibrium dissociation constant of the ligand, and \(B_{\rm{max}}\) is the maximal specific binding of a ligand. The equation describes a hyperbola with \(B_{\rm{max}}\) as the asymptote. \(B_{\rm{max}}\) is defined quantitatively as the amount of ligand bound per mass of binding material, with units, e.g., \(\pu{pmol mg-1}\).</rdfs:comment>
        <rdfs:comment>The total number of receptors or binding sites in the system is proportional to \(B_{\rm{max}}\).</rdfs:comment>
        <rdfs:label>binding isotherm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14113 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14113">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the response of live cells to a test sample is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Assay parameters are controlled with respect to conditions such as \(\ce{CO2}\), \(\ce{O2}\), temperature, and \(\pu{pH}\).</rdfs:comment>
        <rdfs:comment>The type of cells, parameters measured, and detection systems used vary widely.</rdfs:comment>
        <rdfs:label>cell-based assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14119"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14125"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14141"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14114 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14114">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Preparation from tissue or cells, in which the membranous elements, generally the cell membrane, are enriched in relation to other cellular constituents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Cell membrane preparations are the standard biological material for receptor binding assays. Cell membranes are typically lipid-rich.</rdfs:comment>
        <rdfs:comment>These are obtained by disruption of the cells and differential centrifugation or other techniques to isolate the desired components.</rdfs:comment>
        <rdfs:label>cell membrane preparation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14115 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14115">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of counted dead cells to the total number of observed cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Dead cells are often counted using apoptosis or nuclear markers.</rdfs:comment>
        <rdfs:label>cell mortality</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14116 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14116">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of counted live cells to the total number of observed cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Live cells are often counted using nuclear, membrane, or metabolic markers.</rdfs:comment>
        <rdfs:label>cell viability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14117 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14117">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that reduces or eliminates the conductance of an ion channel by impeding the movement of ions through that channel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Dihydropyridine antagonists such as nifedipine, which also block the conductance of some L-type calcium channels, are not classified as channel blockers since their action is to inhibit channel gating.</rdfs:comment>
        <rdfs:label>channel blocker</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14118 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14118">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound that increases the conductance of an ion channel by a mechanism other than alteration of membrane potential or activation of the cognate receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>channel activator</oboInOwl:hasRelatedSynonym>
        <rdfs:label>channel opener</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14119 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14119">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-based assay in which the rate and/or direction of cell migration is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Typically, the response to a test sample is detected by means of a fluorescent probe or with label-free methods. Classical chemotaxis assays utilized the Boyden chamber and required manual counting of migrating cells under the microscope.</rdfs:comment>
        <rdfs:label>chemotaxis assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14120 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14120">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of compounds prepared by combinatorial chemistry. It may consist of a collection of pools, or sublibraries. Its composition may be described by the chemset notation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>combinatorial library</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14121 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14121">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of chemicals that has been assembled and annotated for easy storage and retrieval and that is available for screening.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>compound deck</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>compound library</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Generally consists of compounds synthesized by combinatorial or standard synthetic methods or purchased from commercial sources, or of natural products as pure samples. Compounds may be stored in dry powder form, or dissolved at a fixed concentration in a solvent, such as dimethylsulfoxide.</rdfs:comment>
        <rdfs:label>compound collection</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Association between compound concentration and the resultant magnitude of the continuously graded change produced, in an assay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>concentration–response relationship</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14132"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sample that produces activity above the hit threshold in an assay and whose structural identity has been confirmed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>confirmed hit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14124">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Screen in which test samples are assessed against a target for unwanted activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>This target may or may not be structurally or functionally related to the intended target.</rdfs:comment>
        <rdfs:label>counter-screen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14125 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-based assay in which damage to cell structure or function caused by a test sample is determined.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>cytotoxicity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14115"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14116"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14126 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14126">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extent to which a compound activates a receptor to produce a response in an assay under saturating conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Due to the common overexpression of receptors in screening assays, it is not always possible to detect differences in efficacy among full agonists. A more accurate assessment of relative efficacy may require systems with lower receptor expression where it is often found that one agonist may show partial agonist character.</rdfs:comment>
        <rdfs:comment>Usually compared to results with the positive and negative assay controls. When the compound produces a maximal signal that is \(\pu{100\%}\) of that of the positive control, it is said to be a full agonist and has high efficacy. When the effect plateaus with increasing concentration to reach an intermediary level of activity, the compound is said to be a partial agonist with lower efficacy.</rdfs:comment>
        <rdfs:label>efficacy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14127 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which light emitted by electrogenerated luminescence is detected and used to quantify a label, e.g., ruthenium(II) tris-(bipyridine), on one of the two assay binding components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>electrochemiluminescence assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Kinetic assay run for a set constant incubation time. Typically, at the end of the set incubation time, a reagent that stops the reaction is added to allow postponed measurement of the signal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>end-point assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14130"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Identification and localization of the specific regions of protein molecules that are recognized by the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>epitope mapping</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14130 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14130">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which there is sufficient incubation time for the plateau phase of the signal to be reached and equilibrium has been established between the reactants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>At this point, the signal is time-independent.</rdfs:comment>
        <rdfs:label>equilibrium assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14128"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14152"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14131 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14131">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio, at equilibrium, of \([\ce{AB}]/[\ce{A}][\ce{B}]\) for the reversible binding interaction of \(\ce{A}\) and \(\ce{B}\) to yield the complex \(\ce{AB}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Equal to \(1/K_{\rm{d}}\), or \(k_{\rm{on}}/k_{\rm{off}}\).</rdfs:comment>
        <rdfs:label>equilibrium association constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14132 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14132">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio, at equilibrium, of \([\ce{A}][\ce{B}]/[\ce{AB}]\), for the reversible binding interaction of \(\ce{A}\) and \(\ce{B}\) to yield the complex \(\ce{AB}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Reciprocal of \(K_{\rm{a}}\) (\(K_{\rm{d}} = 1/K_{\rm{a}}\)), equal to \(k_{\rm{off}}/k_{\rm{on}}\).</rdfs:comment>
        <rdfs:label>equilibrium dissociation constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14133 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14133">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cell-based assay in which the response is dependent on the detection of the phenotype of cells as determined through the light-scattering properties of each cell, and, typically, the fluorescence intensity of a relevant probe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Flow cytometry has been adapted to fluorescently labeled bead-based assays.</rdfs:comment>
        <rdfs:comment>In fluorescence-activated cell sorting, single cells are rapidly passed through a channel where they are optically analyzed and separated based on the specific light-scattering and fluorescent characteristics of each individual cell.</rdfs:comment>
        <rdfs:label>flow cytometry assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14134 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14134">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which fluctuations in fluorescence intensity are detected and used to characterize a species that is labeled with a fluorescent probe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The fluctuations are measured for a small volume of the total assay sample and are attributed to local diffusion of the probe in the detected volume or interactions that change the quantum yield of fluorescence.</rdfs:comment>
        <rdfs:label>fluorescence correlation assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14135 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14135">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dimensionless value determined from the fluorescence intensities (\(I\)) measured parallel (\(I_{\Vert}\)) and perpendicular (\(I_{\perp}\)) to the excitation plane: \[p = \frac{I_{\Vert} - I_{\perp}}{I_{\Vert} + I_{\perp}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Fluorescence anisotropy (\(r\)) differs only in normalization and is determined from \[r = (I_{\Vert} - I_{\perp})/(I_{\Vert} + 2I_{\perp})\]</rdfs:comment>
        <rdfs:label>fluorescence polarisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14136 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14136">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the association between an intrinsically fluorescent ligand, or a ligand linked to a fluorescent probe, and a larger macromolecule is detected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The degree to which the labeled ligand depolarizes plane-polarized light is directly proportional to the rate at which it tumbles in solution. Tumbling will be slower when the ligand is associated with the larger macromolecule as compared to free in solution, consequently resulting in a lower degree of depolarization.</rdfs:comment>
        <rdfs:label>fluorescence polarisation assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14135"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14147"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14137 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14137">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay based on the nonradiative energy transfer that occurs when the emission spectrum of a fluorescent donor molecule overlaps with the absorption spectrum of an energy acceptor molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>FRET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FRET assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The donor and the acceptor fluorophores are linked directly or indirectly to two binding partners, and energy transfer occurs when the fluorophores are in close proximity with proper alignment of donor and acceptor electronic dipoles, i.e., when the binding partners interact.</rdfs:comment>
        <rdfs:comment>The fluorophores can be either of small molecule or protein nature.</rdfs:comment>
        <rdfs:comment>Use of a donor with a long fluorescence lifetime allows time-delayed (or time-resolved) fluorescence measurement (TR-FRET), providing conditions where other fluorophores in the assay medium are not detected.</rdfs:comment>
        <rdfs:label>fluorescence resonance energy transfer assay</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14137"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FRET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14138 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14138">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the biological or physiological activity of the target is measured.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>functional assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14139 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14139">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the response is detected only after the physical separation by methods such as filtration or centrifugation of one or more assay components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>heterogeneous assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14140"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14146"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14140 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14140">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which one binding component is immobilized to a surface (e.g., cellular membrane, glass, gold, bead, or biopolymer layer) while its binding partner is freely diffusible.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The extent of interaction between the binding partners is determined after their physical separation, which is usually achieved by filtration, centrifugation, magnetic field, or chromatography.</rdfs:comment>
        <rdfs:comment>Used to qualitatively discriminate specific and non-specific interaction or quantitatively determine the concentration of a component part of a mixture.</rdfs:comment>
        <rdfs:label>heterogeneous binding assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14141 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14141">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A cell-based assay that produces multiple biological readouts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Most commonly used in relation to the mathematical (quantitative) analysis of an image acquired using an automated microscope. Analysis algorithms are used to quantify cellular parameters (e.g., number, motility, neurite outgrowth, size, shape) and subcellular events (e.g., receptor internalization, protein translocation, protein expression nuclei shape).</rdfs:comment>
        <rdfs:label>high-content screening assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14142 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14142">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which response is determined after the physical separation of assay components using high-performance liquid chromatography (HPLC) with concurrent detection, usually by monitoring absorbance at an appropriate wavelength.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>HPLC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HPLC Assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Changes in the concentration of assay components at one or more times over the course of the assay can be determined by the relative area under the detection peaks as compared to assay controls and standards.</rdfs:comment>
        <rdfs:label>high-performance liquid chromatography assay</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14142"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HPLC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14143 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14143">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relative term, applied to the generation of a large number of results in a short timeframe (e.g., \(\pu{E5}\) in a week or a month).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Usually achieved by employing some degree of automation.</rdfs:comment>
        <rdfs:label>high throughput</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14200"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14144 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14144">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion of hits from a screen that displays confirmed activity beyond a minimum defined level, the hit threshold. It is expressed as a percentage of the number of samples screened.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>hit rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14145"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14145 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14145">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minimum activity that defines actives in a primary screen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A widely used hit threshold is \(\pu{50\%}\) inhibition. A more statistically meaningful and equally common threshold is three standard deviations from the mean.</rdfs:comment>
        <rdfs:comment>It is usually expressed as percentage of inhibition or stimulation relative to assay controls.</rdfs:comment>
        <rdfs:label>hit threshold</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14105"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14184"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14146 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14146">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which all reagents and reactants are of a uniform phase (typically, liquid phase) and assay response is detected without the need for physical separation of assay components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>homogeneous assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14139"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14147 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14147">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Single-phase system used to qualitatively discriminate between specific and nonspecific interactions or quantitatively determine the concentration of a component part of a mixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>homogeneous binding assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14148 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14148">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which image analysis algorithms that determine the compartmentalization of fluorescent probes give topological as well as quantitative information.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The use of automated cellular imaging for screening has been made possible by the development of digital imaging technology.</rdfs:comment>
        <rdfs:label>image-based assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14141"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14149 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14149">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the interaction between nanoparticles coated with triply charged metal ions and phosphate groups on a substrate that carries a fluorescent tag is detected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>IMAP™</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMAP™ assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The phosphorylated fluorescent substrate bound to the nanoparticle will exhibit high fluorescence polarization relative to the unbound (unphosphorylated) peptide substrate.</rdfs:comment>
        <rdfs:comment>Used for kinase assays where a phosphate group is added to a peptide substrate or for phosphatase assays where the phosphate is removed from a peptide substrate.</rdfs:comment>
        <rdfs:label>immobilised metal ion affinity-based fluorescence polarisation assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14135"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14149"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IMAP™</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14150 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14150">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sample that, at the tested concentration, does not produce a response above the hit threshold in an assay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A sample may also be designated as inactive when attempts to confirm an active fail.</rdfs:comment>
        <rdfs:label>inactive</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14105"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14108"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14151 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14151">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand that decreases signaling through a receptor below the level of constitutive activity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Several receptors, especially when expressed at high levels, exhibit constitutively active signaling. Demonstrating an inverse agonist effect is dependent upon the constitutive activity of the particular receptor which is manifested in the absence of a conventional agonist. Upwards of \(\pu{85\%}\) of antagonists identified in screens of GPCRs are actually inverse agonists.</rdfs:comment>
        <rdfs:label>inverse agonist</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14174"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14152 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14152">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the time dependence of the signal intensity is measured. Signal values are typically acquired at several time intervals in order to calculate kinetic parameters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Kinetic assays are generally designed such that the change in signal with time is linear throughout the experiment.</rdfs:comment>
        <rdfs:label>kinetic assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14128"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14130"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14153 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14153">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which there is no requirement to modify one of the interacting components in order to facilitate signal detection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Used to monitor macromolecule/macromolecule or small-molecule/macromolecule binding, as well as cell adhesion or cell signaling.</rdfs:comment>
        <rdfs:label>label-free assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14154 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14154">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Direct detection of compound activity on a target without the requirement for a labeled reagent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>label-free detection</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14155 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14155">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process that is targeted toward the generation of at least one compound series that meets the requirements for progression to lead optimization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Typically, it encompasses the steps from the detection of initial activity (via high-throughput screening and other lead-finding activities) through hit confirmation and hit-to-lead activities.</rdfs:comment>
        <rdfs:label>lead identification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14156 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14156">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which the drug-like properties of an initial lead or lead series are improved.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Typically, biological activity will be enhanced, in vivo efficacy will be demonstrated, and compounds with a physicochemical, pharmacological, and toxicological profile consistent with progression to the clinic will be identified.</rdfs:comment>
        <rdfs:label>lead optimisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14157 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14157">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Collection of samples (e.g., chemical compounds, natural products, over-expression library of a microbe) available for screening. Set of compounds produced through combinatorial chemistry or other means that expands around a single core structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>library</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14158 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14158">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any ion channel that is gated (i.e., opened or closed) by a ligand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Distinct from voltage-gated or stretch-activated ion channels.</rdfs:comment>
        <rdfs:label>ligand-activated channel</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14201"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14159 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14159">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Automated device that accurately and precisely delivers programmed, predefined quantities of liquid to a microplate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>liquid handling machine</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It may be free-standing or incorporated as a workstation into a fully automated system.</rdfs:comment>
        <rdfs:label>liquid handler</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14110"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14202"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14160 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14160">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which response is measured by the detection of light of a nonradiative origin, such as bioluminescence or chemiluminescence.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>luminescence assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14161 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14161">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a number of plates containing a series of wells which may be used for storage or to perform individual assays.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Typically, these plates are constructed of a variety of clear and opaque plastics, and can contain from 6 to 3456 individual wells.</rdfs:comment>
        <rdfs:comment>White plates are typically used for luminescence, assay black plates for fluorescence assays, and clear plates for absorbance assays.</rdfs:comment>
        <rdfs:label>microplate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14162"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14176"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14162 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14162">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defined footprint, height, flanges, and well positions for 96-, 384-, and 1536-well microplates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>These standards have been established by the Society for Biomolecular Sciences (SBS) and the American National Standards Institute (ANSI) and accredited by ANSI. They are numbered as ANSI-SBS-1 (2004) – Microplate footprint; ANSI-SBS-2 (2004) – Microplate Height; ANSI-SBS-3 (2004) – Microplate Flange; and ANSI-SBS-4 (2004) – Microplate Well Positions.</rdfs:comment>
        <rdfs:label>microplate standards</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14161"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14163 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14163">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental design aimed at decreasing the reaction volume of an assay and consequently the amount and cost of reagents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>miniaturisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14164 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14164">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Individual automated device within a fully automated assay system that usually performs a complete single assay step or procedure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A fully enclosed module may allow for the control of temperature, humidity, and the gaseous environment.</rdfs:comment>
        <rdfs:label>module</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14165 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14165">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Synthetic polymers in which well-defined volume cavities (imprints) created by template molecules mimic a biomolecular specific ligand–receptor interaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>MIPs</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MIPs have found uses as stationary phases in chromatography, as recognition elements in chemosensors, and as enzyme mimics in catalysis.</rdfs:comment>
        <rdfs:comment>These artificially generated recognition sites have shapes, sizes, and functionalities complementary to the template molecule, and are capable of rebinding the template molecule in preference to other closely related structures.</rdfs:comment>
        <rdfs:label>molecular imprinted polymers</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14165"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MIPs</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14166 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14166">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the activity of a single sample against more than one target is measured in a single test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>multiplex assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14167 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14167">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Complex mixture derived from natural (biological) sources used in screening as a resource for identification of lead compounds. Pure compound of natural (biological) origin (whether obtained by purification of natural mixtures or by laboratory synthesis), as opposed to compounds originating from synthetic chemistry.Note: Typical origins include extracts from microbes and higher organisms from terrestrial or marine environments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>natural product</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14168 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14168">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental conditions designed to produce the signal reflective of the absence of the process under investigation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>low control</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For a binding or an activation mechanism, it is typically the signal measured in the absence of a test compound and is often relevant to the determination of the background signal. For an inhibitory or antagonist mechanism, it is the maximal signal, obtained in the absence of the reference inhibitor.</rdfs:comment>
        <rdfs:label>negative assay control</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14169 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14169">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the interaction of a ligand with a receptor is measured without a requirement for added competing agents. It can be homogeneous or heterogeneous.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>indirect binding assay</oboInOwl:hasRelatedSynonym>
        <rdfs:label>noncompetitive binding assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14170 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14170">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method used to determine the presence or quantify the amount of specific target nucleotide sequences.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>nuclease assay</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14171 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14171">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of dissociation of the enzyme-substrate (\(\ce{ES}\)) complex to enzyme (\(\ce{E}\)) and substrate (\(\ce{S}\)) or of ligand–receptor (\(\ce{LR}\)) to receptor (\(\ce{R}\)) and ligand (\(\ce{L}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>off-rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14172 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14172">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of formation of the enzyme-substrate (\(\ce{ES}\)) or ligand–receptor (\(\ce{LR}\)) complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>on-rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14173 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14173">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Binding site recognized by the endogenous agonist of a receptor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>orthosteric site</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14107"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14174 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14174">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agonist that is unable to induce a maximal receptor response in a given biological assay, regardless of the amount applied.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>partial agonist</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14175 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14175">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Device that aspirates and dispenses liquid (\(\pu{nL}\) to \(\pu{mL}\) range) for the purposes of transferring from a source to destination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The device may be fully manual, electronic, single-channel, multi-channel (typically 8- or 12-channel), or part of a liquid handler.</rdfs:comment>
        <rdfs:label>pipettor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14159"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14176 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14176">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number and configuration of wells on a microplate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The most widely used formats are arrays of 96 wells (8 by 12) or 384 wells (16 by 24) or 1536 wells (32 by 48).</rdfs:comment>
        <rdfs:label>plate format</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14162"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14177 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14177">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Handling device that positions microplates on a workstation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A plate gripper may also be used to move microplates between independent modules of an automated platform. Often used in combination with plate stackers, washers, and readers.</rdfs:comment>
        <rdfs:label>plate gripper</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14161"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14178 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14178">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Layout of samples and controls configured on a plate during an assay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>For a primary screen in 384-well plates, columns 1, 2, and/or 23 and 24 are controls, and the remaining columns are for individual test compounds. For secondary screening, more complex layouts are used and each row may contain a single compound at varying concentrations.</rdfs:comment>
        <rdfs:label>plate map</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14179 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14179">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Automated device that uses optical and/or computer vision techniques to detect biological, chemical, or physical events in samples stored in microplates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>An absorbance plate reader measures color intensity in each well.</rdfs:comment>
        <rdfs:comment>Often used in conjunction with a plate stacker.</rdfs:comment>
        <rdfs:comment>Use of plate readers reduces or eliminates human subjectivity in the evaluation of plate contents.</rdfs:comment>
        <rdfs:label>plate reader</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14110"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14180"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14180 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14180">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Automated device that loads, unloads, and restacks microplates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The device is usually part of system that integrates a plate reader, a liquid handler, or other device to minimize manual microplate handling.</rdfs:comment>
        <rdfs:label>plate stacker</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14110"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14181 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14181">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Automated device used to wash the wells of microplates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The device usually has functions that allow precise height adjustment for minimized residual volume, and digitally controlled aspiration or dispensing pumps to provide high accuracy and flow control.</rdfs:comment>
        <rdfs:label>plate washer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14182 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14182">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental conditions designed to produce the signal reflective of maximum biological effect in an assay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>high control</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For a binding or an activation mechanism, it is typically the signal measured in the presence of a test compound. For an inhibitory or antagonist mechanism, it is the minimum signal, obtained in the absence of the reference inhibitor.</rdfs:comment>
        <rdfs:label>positive assay control</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14183 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14183">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose of drug required to produce a specific effect of given intensity as compared to a standard reference.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>More potent compounds have lower \(\pu{IC_{50}}\) or \(\pu{EC_{50}}\) values implying that less is needed for an effect.</rdfs:comment>
        <rdfs:comment>Potency is a comparative rather than an absolute expression of drug activity. Drug potency depends on both affinity and efficacy. Thus, two agonists can be equipotent, but have different intrinsic efficacies with compensating differences in affinity.</rdfs:comment>
        <rdfs:label>potency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14126"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14184 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14184">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initial screen applied to assess the activity of a collection of compounds and identify hits or actives against a biological target of interest.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>This screen identifies hits or actives from a library.</rdfs:comment>
        <rdfs:label>primary screen</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14105"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14157"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14191"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14185 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14185">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ligand into which a radioisotope has been incorporated as a label.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>radioligand</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14186 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14186">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Automated device that performs tasks (i.e., screen functions) that would normally be performed by a human.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A robot in laboratory automation is usually used to move microplates in an automated assay procedure and usually consists of either a robotic arm with at least three degrees of freedom or a plate gripper.</rdfs:comment>
        <rdfs:label>robot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14177"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14189"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14187 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14187">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Computer program used to organize the chronological sequence of experimental methods to be followed to execute an automated high-throughput screening campaign.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Based on the experimental needs of the campaign and constraints imposed by the programmer, this software uses an iterative process to determine the optimal order of the use of robots, liquid handlers, and modules to minimize screening time.</rdfs:comment>
        <rdfs:label>scheduling software</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14188 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14188">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Homogeneous assay in which beads incorporated with scintillant emit light in the presence of radiolabeled molecules within the proximity of the bead’s scintillant detection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>SPA™</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An alternative form of the assay incorporates the scintillant into the base of a microplate instead of a bead (FlashPlate™).</rdfs:comment>
        <rdfs:label>scintillation proximity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14146"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14188"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SPA™</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14189 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14189">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Execution, analysis, and interpretation of a large number of assays to evaluate the activity of a collection of samples against a target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A screen will often employ automation.</rdfs:comment>
        <rdfs:label>screen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14190 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14190">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay conditions, as determined by assay validation, are performed in the chosen plate format with an acceptable signal to background ratio as described by the Z′ factor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>Validation typically requires testing a number of samples a minimum of three times and allows for the estimation of false positives, false negatives, and the selection of statistically significant thresholds.</rdfs:comment>
        <rdfs:label>screen validation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14109"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14176"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14191 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14191">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Screen applied to independently confirm actives from the primary screen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A secondary screen may employ an assay that differs in type from the primary screen (e.g., biochemical assay vs. cell-based assay) or it may be of the same type with different readout.</rdfs:comment>
        <rdfs:label>secondary screen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14192 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14192">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay used to determine the relative potency of active or lead compounds toward an alternative target.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>A selectivity assay (or panel of assays) may include targets of the same family or unrelated targets.</rdfs:comment>
        <rdfs:label>selectivity assay</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14124"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14193 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14193">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Eukaryotic cells into which recombinant DNA has been introduced and incorporated into the genome, so that the cells replicate the new DNA in a stable fashion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The biological material thus obtained is expected to show low variability and therefore increase assay reproducibility.</rdfs:comment>
        <rdfs:label>stably transfected cells</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14194 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14194">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sample standard deviation divided by the square root of the sample size.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>SEM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>standard error of the mean</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14194"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SEM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14195 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14195">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of a library that is grouped or selected based on similarity of structure or biological effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>sublibrary</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14157"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14196 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14196">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assay in which the binding of a ligand to a target immobilized on the gold surface of a chip is detected by changes in the angle of the light reflected from the surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>SPR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SPR Assay</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This assay type is not usually used for high-throughput screening but has been expanded to multiple simultaneous detection channels and has improved sensitivity to detect low-molecular-weight binding molecules.</rdfs:comment>
        <rdfs:label>surface plasmon resonance assay</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14196"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SPR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14197 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14197">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Library designed, on the basis of preexisting information, to generate enhanced activity or hit rate against a particular biological target or target class.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>targeted library</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14198 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14198">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spectroscopic technique that discriminates between labeled molecules in the homogeneous phase and those interacting with binding partners immobilized at a surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <oboInOwl:hasRelatedSynonym>TIRF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>TIRF measurements are restricted to a thin layer and are achieved by exciting the fluorophore with an evanescent wave, created by total internal reflection at the glass/aqueous interface of the wave guide. The goal of using TIRF in biological applications is to study events close to the interface of two different media.</rdfs:comment>
        <rdfs:label>total internal reflection fluorescence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14198"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TIRF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14199 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14199">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Eukaryotic cells into which recombinant DNA has been introduced and expressed by cellular transcription, but without incorporation into the stable genome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>transiently transfected cells</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14200 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14200">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relative term, currently applied to the screening of \(\pu{E5}\) test samples in a \(\pu{24\!\mbox{-}h}\) period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>ultra-high throughput</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14143"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14201 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14201">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion channel that is specifically activated, or gated, by the surrounding potential difference across the cell membrane near the channel (or near the cell, neuron, or synapse).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>voltage-activated channel</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14202 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14202">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Programmable device used to automate a single operation (such as liquid handling) on a microplate supplied to the device by a robot (automated stacker system or a robotic manipulator).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>workstation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14186"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14203 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14203">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dimensionless statistical parameter that provides a practical assessment of assay performance in the presence of test compounds. \[Z = 1 - 3(\sigma_{\rm{s}} + \sigma_{\rm{c}})/\vert\mu_{\rm{s}} - \mu_{\rm{c}}\vert\] where \(\mu_{\rm{s}}\) denotes the mean of the library sample signal, \(\mu_{\rm{c}}\) the mean of the control signal and \(\sigma_{\rm{s}}\), \(\sigma_{\rm{c}}\) the corresponding standard deviations. \(1 \gt Z \ge 0.5\) generally categorizes an excellent assay.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:label>Z factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14204 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14204">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dimensionless statistical parameter used extensively in biomolecular screening, and a characteristic of an assay without the intervention of test compounds. It provides a practical index of the quality and reliability of the assay, and can be used as a guide to assay development and optimization. \[Z&apos; = 1 - 3(\sigma_{\rm{c^{+}}} + \sigma_{\rm{c^{-}}})/(\vert\mu_{\rm{c^{+}}} - \mu_{\rm{c^{-}}}\vert)\] where \(\sigma_{\rm{c^{+}}}\) and \(\sigma_{\rm{c^{-}}}\) are the standard deviations of the high and low controls and \(\mu_{\rm{c^{+}}}\) and \(\mu_{\rm{c^{-}}}\) are the means of the high and low controls, respectively. A graphical illustration of the parameters used in the calculation of \(Z&apos;\) is provided below.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-05-03"/>
        <rdfs:comment>The useful range of \(Z&apos;\) values is from 0 (very poor) to +1 (excellent). In most cases, a \(Z&apos;\) factor greater than \(\pu{0.5}\) is required for an assay to be accepted for high-throughput screening.</rdfs:comment>
        <rdfs:label>Z′ factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14205 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14205">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model based on the assumption that the polymer sample consists only of domains of a crystalline phase and of an amorphous phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>two-phase model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14206 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14206">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Projected length of a constitutional repeating unit (CRU) on the chain axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>unit height</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The axial advancement per CRU is characteristic of the conformation of a polymer chain. A large axial advancement per CRU is said to define a more extended conformation and a small axial advancement per CRU is said to define a more contracted conformation.</rdfs:comment>
        <rdfs:comment>The value of \(h\) is obtained from the equation \[h = \frac{c}{M_{\rm{R}}}\] where \(c\) is the chain identity period and \(M_{\rm{R}}\) is the number of CRUs in \(c\). In cases where the equivalence postulate does not apply, \(h\) is an average value.</rdfs:comment>
        <rdfs:label>axial advancement per constitutional repeating unit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14207 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14207">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer chain that may be oriented in two distinguishable, opposite directions along the chain axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The two possible chain orientations can be mutually interconverted through a rotation around a twofold axis orthogonal to the chain axis.</rdfs:comment>
        <rdfs:label>directional chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14208 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14208">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stem of a directional chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>directional stem</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14207"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14209 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14209">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distance between successive helical windings projected on the chain axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The value of \(p\) is obtained from the equation \[p = \frac{c}{N}\] where \(c\) is the chain identity period and \(N\) is the number of helical windings in \(c\).</rdfs:comment>
        <rdfs:label>helix pitch</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14210 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14210">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minimum energy conformation of an isolated polymer chain constructed according to the equivalence postulate and approximating the conformation found in a crystalline phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>If the symmetry elements present in the crystal do not correspond with those that characterize the ideal crystalline chain conformation, the chain conformation may be distorted in the crystal.</rdfs:comment>
        <rdfs:comment>Symmetry elements characterizing the ideal crystalline chain conformation may be noncrystallographic (see rod group), i.e., they may not apply to the packing in certain crystal polymorphs. For example, the ideal crystalline chain conformation of isotactic polypropylene is \(3_{1}\) helix but, while the \(\ce{\upbeta\mbox{-}phase}\) crystal structure allows for the helical \(3_{1}\) symmetry operator, the \(\ce{\upalpha\mbox{-}}\) or the \(\ce{\upgamma\mbox{-}phase}\) of this polymer do not.</rdfs:comment>
        <rdfs:label>ideal crystalline chain conformation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14214"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14211 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14211">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds clockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>In compliance with prevailing stereochemical terminology conventions the descriptor \(M\) (minus) is recommended rather than \(L\), presently widely used in polymer literature.</rdfs:comment>
        <rdfs:label>left-handed helix</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14213"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14212 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14212">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helical arrangement comprising two or more intertwined helical chains sharing the same axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The intertwined helical chains are usually identical and displaced along the chain axis direction by \(c/n\), where \(c\) is the chain identity period of the single helix and \(n\) the number of helices in the multiple helix.</rdfs:comment>
        <rdfs:label>multiple helix</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14213 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14213">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds anticlockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>In compliance with prevailing stereochemical terminology conventions, the descriptor \(P\) (plus) is recommended rather than \(R\), presently widely used in polymer literature.</rdfs:comment>
        <rdfs:label>right-handed helix</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14211"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14214 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14214">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Symmetry group of a three-dimensional array of atoms, regularly repeating along one direction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>line repetition group</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Details concerning the symbols used are explained in crystallographic literature can be found in the recommendation.</rdfs:comment>
        <rdfs:comment>For reasons related to space filling, in the case of crystallographic rod groups, only two-, three-, four-, and sixfold screw axes are taken into consideration. Such limitations do not exist in the case of isolated chains for which any helical symmetry may, in principle, be acceptable. In other words, rod groups in are a subset of those applicable to ideal crystalline chain conformations.</rdfs:comment>
        <rdfs:comment>The symmetry of isolated polymer chains, with translational periodicity along the chain axis direction, may be described by either the rod group, or the equivalent line-repetition-group approach. Whereas the line-repetition-group description has been developed in the polymer science community, rod groups originate in the crystallographic community and are more systematic. Table 1 shows the symmetry group symbols of some linear polymers according to both the rod-group and the line-repetitiongroup description.</rdfs:comment>
        <rdfs:label>rod group</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14210"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14215 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14215">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Angle of rotation about the chain axis per helix residue.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>unit twist</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The value of \(t\) is obtained from the equation \[t = \frac{2\pi N}{M}\] where \(N\) is the number of helix turns in a chain identity period \(c\) and \(M\) is the number of helix residues in \(c\). In cases where the equivalence postulate does not apply, \(t\) is an average value.</rdfs:comment>
        <rdfs:label>rotation per helix residue</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14216 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14216">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Smallest structural unit of a polymer chain that is repeated by translation in the crystal lattice along the chain axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>fiber repeat unit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>physical repeating unit</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The translational chain repeating unit may differ for different crystal polymorphs of a given crystalline polymer.</rdfs:comment>
        <rdfs:label>translational chain repeating unit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14217 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14217">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stems in a crystal having opposite side-group orientations with respect to the chain axis (see (a) in figure).(a) Pairs of anticlined stems and (b) pairs of isoclined stems of regioregular poly(3-butylthiophene), i.e., poly(3-n-butylthiophene-2,5-diyl). Since regioregular poly(3-n-butylthiophene-2,5-diyl) is also a directional chain, (a) is an example of antidirectional packing of two chains, while (b) is an example of isodirectional packing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Anticlined stems occur in crystalline poly-α-olefins, and also in regioregular poly(3-alkylthiophenes), polyphosphazenes, and polysiloxanes.</rdfs:comment>
        <rdfs:label>anticlined stems</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14207"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14218"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14222"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14223"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14218 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14218">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a parallel-chain crystal, the crystalline packing of directional stems with opposite chain axis orientations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>antiparallel packing</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Usually, stems of opposite orientations occur in equal numbers in parallel-chain crystals.</rdfs:comment>
        <rdfs:label>antidirectional packing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14208"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14219 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14219">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of the different crystalline phases in which a given substance is able to crystallize.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>crystal modification</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>crystalline form</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A given polymer in its different crystal polymorphs may display the same conformation and the same chain identity period, but possibly involve packing of isochiral only or of enantiomeric helices (e.g., isotactic polypropylene in its \(\ce{\upalpha\mbox{-}form}\), \(\ce{\upbeta\mbox{-}form}\), and \(\ce{\upgamma\mbox{-}form}\); syndiotactic polypropylene, forms I and II. Polymorphs are, in such cases, isoconformational, and polymorphism is determined only by different modes of packing.</rdfs:comment>
        <rdfs:comment>Different polymer crystal polymorphs are characterized by different crystal lattices and different packing of stems.</rdfs:comment>
        <rdfs:comment>In other cases, along with the packing, the local conformations of chains are different in its different crystal polymorphs. The chain identity period and the symmetry will also differ (e.g., isotactic poly(but-1-ene), crystal forms I, II, and III; syndiotactic polypropylene, crystalline forms I, III, and IV).</rdfs:comment>
        <rdfs:label>crystal polymorph</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14220 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14220">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feature of crystalline packing characterized by different crystalline arrangements of chain stems at two (or more) sites that would be expected to be equivalent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The term &quot;frustration&quot; signifies that some chains can achieve the minimum energycconformation or an optimal packing arrangement, while others cannot.</rdfs:comment>
        <rdfs:label>frustration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14221 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14221">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystalline packing of stems having the same helicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The term is applicable to macromolecules that are chiral or adopt a chiral conformation in the crystal (e.g., a helical conformation).</rdfs:comment>
        <rdfs:label>isochiral stem packing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14222 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14222">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stems in a crystal having the same side-group orientation with respect to the chain axis (see figure (b) in anticlined stems).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Isoclined stems occur, for example, in crystalline poly-α-olefins, regioregular poly(3-alkylthiophenes), polyphosphazenes, and polysiloxanes.</rdfs:comment>
        <rdfs:label>isoclined stems</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14217"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14223 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14223">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a parallel-chain crystal, the crystalline packing of directional stems with the same chain axis orientation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>parallel packing</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Crystal packings in which all chains are isodirectional are very unlikely in the case of synthetic polymers except in as-polymerized systems, provided a directional extendedchain crystallization process immediately follows polymerization.</rdfs:comment>
        <rdfs:comment>The term &quot;isodirectional packing&quot; is less ambiguous than the more common &quot;parallel packing&quot;. The latter is often used in the description of crystalline polymorphs of natural polymers (e.g., cellulose I).</rdfs:comment>
        <rdfs:label>isodirectional packing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14208"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14224 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14224">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spatial arrangement of polymer chain stems in a polymer crystal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Crystals require tridimensional translational periodicity in their packing.</rdfs:comment>
        <rdfs:comment>The mode of packing is influenced by the kinetics and thermodynamics of the crystallization process. In some cases, pre-existing structural organization and chain folding may also play a role.</rdfs:comment>
        <rdfs:label>packing of chain stems</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14225 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14225">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer crystal formed by domains of different crystal polymorphs of the same polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Isotactic polypropylene has been shown to form crystals containing \(\ce{\upalpha\mbox{-}}\) and \(\ce{\upgamma\mbox{-}phase}\) domains in which well-defined relationships between the lattices of the two phases in different domains are preserved.</rdfs:comment>
        <rdfs:label>polymorphic polymer crystal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14226 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14226">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Packing in a polymer crystal in which stems of opposite helicity coexist in equal numbers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Applicable to macromolecules that are chiral or adopt chiral conformations in the crystal. One example of the former case is the crystal structure in which poly(ʟ-lactide) and poly(ᴅ-lactide) stems coexist in equal numbers, i.e., the so-called polylactide stereocomplex. The second case is much more frequent: it applies to most isotactic vinyl polymer crystal polymorphs where the polymer chains are not intrinsically chiral but adopt helical, and thus chiral conformations. Left-handed helices and right-handed helices are, however, isoenergetic and equiprobable and coexist in equal numbers, often giving rise to centrosymmetric crystals.</rdfs:comment>
        <rdfs:label>racemic packing</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14211"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14213"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14227 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14227">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vanishing, in a specific crystal polymorph, of selected symmetry elements present in other crystal polymorphs, or in selected minimum energy conformations of isolated molecules of a given substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Crystal polymorphs affected by symmetry breaking are usually stable at low temperature under conditions that optimize packing energy.</rdfs:comment>
        <rdfs:comment>The symmetry elements that vanish are frequently intramolecular. Symmetry breaking in polymers in such cases leads to deviations from the ideal crystalline chain conformation and from the equivalence postulate.</rdfs:comment>
        <rdfs:label>symmetry breaking</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14210"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14228 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14228">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural disorder at given crystallographic positions, resulting from the statistical coexistence within crystals of directional stems with opposite orientations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>A typical example is provided by the statistical coexistence of chains with opposite orientations at each crystallographic position in the crystal structures of poly-α-olefins, for example, in the \(\ce{\upalpha\mbox{-}form}\) of polypropylene.</rdfs:comment>
        <rdfs:label>orientational disorder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14208"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14229 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14229">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystal model characterized by lattice distortions and hence by limited order along given lattice directions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>paracrystal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14230 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14230">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural disorder in a paracrystal, resulting from uncorrelated displacements of the atoms around their average positions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>uncorrelated paracrystalline disorder</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Displacements are generally due to thermal vibrations.</rdfs:comment>
        <rdfs:label>paracrystalline disorder of the first kind</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14229"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14231 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14231">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structural disorder in a paracrystal, resulting from permanent atomic displacements from the ordered crystallographic positions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>correlated paracrystalline disorder</oboInOwl:hasRelatedSynonym>
        <rdfs:label>paracrystalline disorder of the second kind</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14229"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14232 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14232">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the statistical fluctuation \(\Delta a_{ik}\) of a lattice vector \(a_{i}\) along the direction \(a_{k}\) \[g_{ik} = \frac{\Delta a_{ik}}{a_{k}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Values of \(g\) range from \(\pu{0}\) (distortion-free crystal) to \(\pu{0.03}\) (typical bulk polymer), to \(\pu{0.12}\) (\(\ce{SiO2}\) glass) to \(\pu{1}\) (Boltzmann gas).</rdfs:comment>
        <rdfs:comment>\(g\) can be determined from measurements of the integral breadth of successive orders of Bragg reflections [18b].</rdfs:comment>
        <rdfs:label>paracrystalline distortion factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14233 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14233">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystal comprising a polymer guest within a low-molar-mass host.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>A number of different crystalline polymer-inclusion complexes may be obtained, for example, by the crystallization of polyethylene, 1,4-polybutadiene, and other polymers within urea, perhydrotriphenylene, or cyclotriphosphazene crystals.</rdfs:comment>
        <rdfs:comment>The stems in polymer inclusion complexes are generally isolated. They are often not conformationally ordered.</rdfs:comment>
        <rdfs:label>crystalline polymer-inclusion complex</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14234 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14234">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystalline molecular complex between different polymers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Very few examples of polymer complexes are known. The best characterized is the complex of isotactic and syndiotactic poly(methyl methacrylate).</rdfs:comment>
        <rdfs:label>crystalline-polymer molecular complex</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14235 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14235">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystal consisting of two or more structurally different polymers, resulting in macromolecular isomorphism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>isomorphous polymer co-crystal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14236 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14236">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecular isomorphism involving copolymers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>copolymer isomorphism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14237 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14237">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecular isomorphism involving two homopolymers with different constitutional repeating units.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>homopolymer isomorphism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14235"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14238 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14238">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer crystal presenting empty volume elements that can host low-molar-mass guest species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>A nanoporous polymer crystal is often obtained (e.g., in the case of syndiotactic polystyrene) by removing the low-molar-mass guest species from a polymer clathrate.</rdfs:comment>
        <rdfs:label>nanoporous polymer crystal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14239 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14239">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer co-crystal in which low-molar-mass guest species are hosted in molecular-sized cages or cavities containing more than one guest molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Guest molecules are often packed isolated from each other or in columns.</rdfs:comment>
        <rdfs:comment>Polymer clathrates are formed by many polymers with low-molar-mass compounds, particularly water. Examples are frequent among biological polymers (e.g., amylose) but also some synthetic polymers give polymer clathrates (e.g., poly(ethylene oxide) with various inorganic and organic species).</rdfs:comment>
        <rdfs:label>polymer clathrate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14240"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14240 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14240">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystal structure in which at least two substances coexist, one of which is a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>polymer mixed crystal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polymer-based crystalline molecular complex</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Types of polymer co-crystals are: (1) polymer clathrate, (2) isomorphous polymer co-crystal, (3) crystalline polymer-inclusion complex. Examples are provided under each separate entry.</rdfs:comment>
        <rdfs:label>polymer co-crystal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14233"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14235"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14271"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14241 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14241">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjacent re-entry model in which the fold period can vary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>irregular adjacent re-entry model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14244"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14242 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14242">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Idealized adjacent re-entry model in which the fold periods are assumed to have all the same length.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>This model is probably only approached for isothermal growth at small supercooling from dilute solution.</rdfs:comment>
        <rdfs:label>regular adjacent re-entry model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14244"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14273"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14243 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14243">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Folded-chain crystal in which each macromolecule makes one, or, at most, a few folds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>chain-extended crystal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14244 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14244">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Thickness of a lamellar parallel-chain crystal in the direction of its stems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>fold length</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For lamellar crystals with chains whose axes are not normal to the lamellar surface, the fold period is longer than the long period.</rdfs:comment>
        <rdfs:comment>In melt-crystallized polymers, consisting of lamellar crystals with the chain axis perpendicular to the lamellar surface, the fold period is shorter than the long period because the amorphous layer includes not only the folds but other non-crystallized components.</rdfs:comment>
        <rdfs:comment>The fold period corresponds to the long period in the case of solution crystallized stacked lamellar crystals with the chain axis perpendicular to the lamellar surface.</rdfs:comment>
        <rdfs:comment>The fold period is controlled by the crystallization temperature.</rdfs:comment>
        <rdfs:label>fold period</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14251"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14245 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14245">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer crystal in which the stems are aligned along two or more different crystallographic directions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>So far, the only example of non-parallel-chain polymer crystal is the \(\ce{\upgamma\mbox{-}polymorph}\) of isotactic polypropylene, where double-layers of parallel chains alternate with identical double-layers rotated by approximately \(\pu{80\!^{\circ}}\).</rdfs:comment>
        <rdfs:label>non-parallel-chain crystal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14246 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14246">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model of crystalline polymer formed by lamellar crystallization from the melt, in which some stems of a macromolecule belong to one crystal, whilst other stems of the same macromolecule are in different crystals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>solidification model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14247 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14247">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phase domain consisting of matter in the amorphous state.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The linear dimensions of amorphous domains in crystalline polymers range from \(\pu{1 nm}\) upwards.</rdfs:comment>
        <rdfs:label>amorphous domain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14248 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14248">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystal in which the chains predominantly extend from the crystal surface, resulting in a fringed-micelle model morphology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>bundle crystal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14249 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14249">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polyhedral aggregate of lamellar crystals resulting in a morphology that resembles that of a polymer single crystal, at least from one viewing direction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>A hedrite is a type of axialite.</rdfs:comment>
        <rdfs:label>hedrite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14255"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14250 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14250">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of a lamellar crystal, often bounded by a well-defined crystal face.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>For some crystal morphologies, the fold surfaces of a sector make an angular discontinuity with the fold surfaces of contiguous sectors.</rdfs:comment>
        <rdfs:comment>Lamellar crystal sectors in folded-chain crystals correspond to fold domains.</rdfs:comment>
        <rdfs:comment>The fold plane prevailing in a sector is normally assumed to correspond to the crystal face bounding the sector.</rdfs:comment>
        <rdfs:comment>The term generally applies to solution-crystallized lamellar crystals. Sectors are described using the indexing of the crystal face bounding it.</rdfs:comment>
        <rdfs:label>lamellar crystal sector</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14251 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14251">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average periodicity (repeating distance) of the layers of lamellar crystals in a stacked assembly.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>long spacing</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The long period is usually measured by SAXS (small-angle X-ray scattering), SANS (small-angle neutron scattering), atomic force microscopy (AFM), or transmission electron microscopy (TEM), and is the sum of the average thickness of the lamellar crystals and the average thickness of the amorphous inter-lamellar region.</rdfs:comment>
        <rdfs:label>long period</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14252 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14252">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystalline polymer in which a large number of polymer crystallites coexist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Polymer crystallites and amorphous domains in a specimen may be organized randomly or with some degree of order.</rdfs:comment>
        <rdfs:label>polycrystalline polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14247"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14253"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14253 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14253">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Uniaxially oriented polymer filament with macroscopic cylindrical symmetry, in which the average direction of the polymer chain axis coincides with the cylindrical symmetry axis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>A crystalline polymer fiber generally consists of lamellar crystals or fringed micelle-type crystals (see fringed micelle model) with an interconnecting amorphous phase, or, rarely, of extended-chain crystals.</rdfs:comment>
        <rdfs:comment>The cylindrical symmetry shown by crystalline polymer fibers is not at the molecular scale but results from the random orientation of crystallites around the axis of the fiber.</rdfs:comment>
        <rdfs:label>polymer fibre</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14254 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14254">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small diameter polymer fiber consisting of a small number of polymer chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>polymer fibril</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14253"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14255 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14255">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Individually distinct polymer crystal whose lattice, at crystallization, is characterized by a single orientation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Polymer single crystals obtained from dilute solutions are comparatively large, i.e, they have lateral dimensions typically of a few micrometers, which can reach tens of micrometers in some instances. They are normally delimited by well-defined boundary surfaces and may, in rare instances, be manipulated individually.</rdfs:comment>
        <rdfs:comment>The thickness of individual polymer single crystals (inclusive of the fold surfaces thickness) is now measured by AFM (atomic force microscopy) along with transmission electron microscopy, while average values are derived using SAXS (small-angle X-ray scattering) and SANS (small-angle neutron scattering).</rdfs:comment>
        <rdfs:label>polymer single crystal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14260"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14256 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14256">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polycrystalline polymer morphology resulting from nucleation of polymer lamellar crystals by multiple fibrillar structures or by macroscopic linear objects such as fibers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Row structures result frequently by heteroepitaxy.</rdfs:comment>
        <rdfs:comment>Shish-kebab structures are the simplest form of row structures.</rdfs:comment>
        <rdfs:label>row structure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14252"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14264"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14257 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14257">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lamellar crystals radiating from the center of the spherulite which, by splaying, constitute the initial skeleton of the spherulite.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Crystallization of dominant lamellae is largely associated with primary crystallization.</rdfs:comment>
        <rdfs:comment>In the isothermal crystallization of crystalline polymers there is normally a single population of dominant lamellae, characterized by a single thickness.</rdfs:comment>
        <rdfs:comment>The thickness and perfection of dominant lamellae is greater than for subsidiary lamellae, especially in non-isothermal crystallization.</rdfs:comment>
        <rdfs:label>dominant lamellae</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14258"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14266"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14267"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14258 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14258">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lamellar crystals nucleated either epitaxially or incoherently on dominant lamellae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>infilling lamellae</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Crystallization of subsidiary lamellae is generally associated with secondary crystallization, but may start before dominant lamellae meet at spherulite boundaries.</rdfs:comment>
        <rdfs:comment>In typical crystalline polymers there may be populations of subsidiary lamellae characterized by bimodal thickness distributions.</rdfs:comment>
        <rdfs:comment>Subsidiary lamellae can appear as pockets of lamellae in different locations within a spherulite, with no well-defined relation to dominant lamellae.</rdfs:comment>
        <rdfs:comment>The thickness and perfection of subsidiary lamellae is reduced as compared to dominant lamellae, especially in non-isothermal crystallization.</rdfs:comment>
        <rdfs:label>subsidiary lamellae</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14267"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14259 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14259">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polycrystalline layer nucleated and shaped by a pre-existing planar surface within or in contact with a polymer melt.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>In growth from oriented melts, as in injection-molding, two transcrystalline layers may result. The first is the skin layer and is formed by individual lamellae, while the second consists of spherulites. Both grow preferentially in the direction perpendicular to the flow direction and the external surface of the molded articles.</rdfs:comment>
        <rdfs:comment>In growth from unoriented melts, as in compression-molding, the transcrystalline layer consists of closely spaced, highly asymmetric spherulites, nucleated on the surface and elongated in the direction normal to the surface of the molded articles.</rdfs:comment>
        <rdfs:label>transcrystalline layer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14256"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14260 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14260">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer crystal in which two or more single crystalline domains of the same crystal polymorph, with different lattice orientations, coexist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>Some of the lattice directions, very often the chain axis directions, remain parallel in the different domains of twinned crystals.</rdfs:comment>
        <rdfs:comment>The lattice orientations in the different domains of twinned crystals are generally symmetry-related.</rdfs:comment>
        <rdfs:label>twinned polymer crystal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14255"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14261 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14261">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Division of the growth front of individual or groups of dominant lamellae into divergent &apos;cells&apos;, with the impurities and the less crystallizable molecules segregated between the cells and at the spherulite boundaries.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>cellulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14257"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14262 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14262">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer crystallization occurring inside elongated cavities, spheres, galleries, or layers formed by a host material different from the polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>At least one dimension of the cavities must be of the order of a few nanometers, i.e., close to typical dimensions of a polymer crystallite and, in particular, to lamellar thickness.</rdfs:comment>
        <rdfs:comment>Morphology and polymorphism may be significantly affected by confined crystallization.</rdfs:comment>
        <rdfs:comment>Spherical structures may result from the crystallization of one of the two components in a heterogeneous polymer blend (e.g., in a polyethylene-polycarbonate blend) while lamellar, hexagonally packed cylindrical and inverse cylindrical morphologies are frequent in block copolymers with a crystallizable block (e.g., in poly(ethylene oxide)-block-polystyrene)).</rdfs:comment>
        <rdfs:comment>Stems may aggregate in small, disordered bundle crystals or in relatively large lamellar crystals, typically within layered inorganic materials.</rdfs:comment>
        <rdfs:comment>Stems may be isolated in the cavities of the frequently nonpolymeric host material, as in the cases of zeolites and the fully trans-form of perhydrotriphenylene in the crystalline state. In such cases, the polymer stems are usually highly disordered.</rdfs:comment>
        <rdfs:label>confined-spaces crystallisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14248"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14263 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14263">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature difference between the equilibrium melting temperature and the temperature of a supercooled melt.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>degree of undercooling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>degree of supercooling</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14272"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14264 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14264">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epitaxy between crystals of different substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>For some polymers, heteroepitaxy may be used to favor by nucleation the development of a crystalline phase that is not obtained normally.</rdfs:comment>
        <rdfs:comment>Heteroepitaxy is often used to enhance nucleation and reduce spherulites’ size in commercial processes.</rdfs:comment>
        <rdfs:comment>Heteroepitaxy may occur between crystals of different polymers. However, the heteroepitaxy of low-molecular-weight systems (e.g., alkanes) on polymer crystals (e.g., polyethylene), and of polymer crystals on crystals of low-molecular-weight substances can also occur. Heteroepitaxy has also been observed for polymer crystals on ionic substances and minerals like clay and mica.</rdfs:comment>
        <rdfs:comment>Polymer crystals with unusual orientations with respect to the substrate may be obtained by epitaxial crystallization involving heteroepitaxy.</rdfs:comment>
        <rdfs:label>heteroepitaxy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14265 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14265">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Epitaxy between crystals of the same substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>A less frequent homoepitaxy may occur, as for the \(\ce{\upalpha\mbox{-}polymorph}\) of isotactic polypropylene, between crystals of the same crystal polymorph and morphology but with a different, well-defined orientation of the crystal lattice.</rdfs:comment>
        <rdfs:comment>A new crystal layer, initiated by secondary nucleation, or the formation of a twinned polymer crystal, can be seen as a form of homoepitaxy.</rdfs:comment>
        <rdfs:comment>Homoepitaxy may allow the development of crystals of the same polymer but in two distinct crystal polymorphs with well-defined mutual orientations, as in the case of \(\ce{\upgamma\mbox{-}isotactic}\) polypropylene grown on \(\ce{\upalpha\mbox{-}isotactic}\) polypropylene.</rdfs:comment>
        <rdfs:comment>Homoepitaxy may occur between crystals of the same crystal polymorph but different morphology as in the crystallization of chain-folded crystals on fibril-like extended-chain crystals in shish-kebabs. Similarly, in non-isothermal crystallization, lamellar crystals of lower thickness are often nucleated on thicker crystals, preserving a unique orientation of the crystal lattice.</rdfs:comment>
        <rdfs:label>homoepitaxy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14219"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14260"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14267"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14266 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14266">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystallization taking place at constant temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>isothermal crystallisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14267 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14267">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystallization taking place under varying temperature conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>non-isothermal crystallisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14268 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14268">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The smallest crystalline entity, the further growth of which is thermodynamically favored.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>primary nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14269 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14269">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nucleation of a new molecular layer on a growing crystal face.Note: Secondary nucleation refers to the further growth of an already-existing crystal.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:label>secondary nucleation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14270 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14270">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heterogeneous nucleation by crystals of the same polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>self-seeding</oboInOwl:hasRelatedSynonym>
        <rdfs:label>self-nucleation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14271 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14271">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystallization, within the same crystal, of a polymer and at least one other component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The following possibilities need to be considered: (1) a polymer and a low-molar-mass species forming a polymer clathrate; (2) a molecular complex of different polymers (see polymer co-crystal); and (3) different polymers displaying some degree of isomorphism (isomorphous polymer co-crystal).</rdfs:comment>
        <rdfs:label>polymer co-crystallisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14235"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14240"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14272 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14272">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metastable melt of a crystallizable polymer at temperatures below its equilibrium melting temperature \(T^{\circ}_{\rm{m}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <rdfs:comment>The term is not applicable to the amorphous component of a crystalline polymer, i.e., after crystallization has occurred.</rdfs:comment>
        <rdfs:label>supercooled melt</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14273 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14273">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The process of cooling a melt to a temperature below its equilibrium melting point, without crystallization occurring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-11-13"/>
        <oboInOwl:hasRelatedSynonym>undercooling</oboInOwl:hasRelatedSynonym>
        <rdfs:label>supercooling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14274 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14274">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle of polymer of any shape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>For the description of a particle, the expression &quot;size&quot; is often used. However, because this expression does not have a sufficiently precise meaning its usage is not recommended.</rdfs:comment>
        <rdfs:label>polymer particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14275 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14275">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sphere of polymer, usually with a diameter in the range from one-tenth to a few millimeters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer bead</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14276 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14276">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle of polymer of any shape with an equivalent diameter from approximately \(\pu{0.1 \upmu m}\) to \(\pu{100 \upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer microparticle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14290"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14277 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14277">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer microparticle of spherical shape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer microsphere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14276"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14278 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14278">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle of polymer of any shape and an equivalent diameter from approximately \(\pu{1 nm}\) to \(\pu{100 nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer nanoparticle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14290"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14279 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14279">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer nanoparticle of spherical shape.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer nanosphere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14278"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14280 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14280">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle of gel in which the network component is a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer gel particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14281 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14281">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle of gel of any shape with an equivalent diameter of approximately \(\pu{0.1 \upmu m}\) to \(\pu{100 \upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>microgel</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gel microparticle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14290"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14282 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14282">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle of gel particle of any shape and an equivalent diameter of approximately \(\pu{1 nm}\) to \(\pu{100 nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>nanogel</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gel nanoparticle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14290"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14283 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14283">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle having any shape and composed of a polymer network and possibly species of finite molar mass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer network particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14284 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14284">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Latex obtained by emulsification of a polymer or oligomer solution in a liquid or by emulsification of a liquid polymer or liquid oligomer in a liquid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>artificial latex</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14285 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14285">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Latex comprising a polymer of relatively high molar mass and an oligomer or an alkyd resin, in which there is usually chemical bonding between the two components, formed either during latex synthesis or subsequently after formation of a film from the latex. Latex comprising multicomponent particles that contain both organic and inorganic material phases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>hybrid latex</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14286 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14286">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonaqueous latex in which the dispersed phase comprises hydrophilic polymer usually swollen with water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>An inverse latex is usually formed by inverse emulsion, inverse micro-emulsion, or inverse mini-emulsion polymerizations in which water-soluble monomer(s) dissolved in the dispersed phase is (are) polymerized.</rdfs:comment>
        <rdfs:label>inverse latex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14335"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14287 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14287">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer particle that is present in a latex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>latex particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14288 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14288">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Latex, the dispersed phase of which is obtained from various plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Many plants when wounded produce a milky, sticky sap that is referred to as a latex.</rdfs:comment>
        <rdfs:comment>The dispersed phase is often polyisoprene (2-methyl-1,3-butadiene).Example: Latex from the rubber tree, Hevea brasiliensis.</rdfs:comment>
        <rdfs:label>natural latex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14289 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14289">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Latex obtained as a product of an emulsion, mini-emulsion, micro-emulsion, or dispersion polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>synthetic latex</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14317"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14348"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14290 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14290">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diameter of a hypothetical spherical particle of the same composition that, using a given particle-size determination method, would give the same diameter as a substance composed of spherical or nonspherical particles at the same concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Although the equivalent particle diameter is not a precisely defined quantity, as its value depends on the experimental method used for its determination, it is useful for particle characterization.</rdfs:comment>
        <rdfs:label>equivalent particle diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14291 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14291">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated using the following equation: \[\left\langle d_{\rm{N}} \right\rangle = \bar d_{\rm{N}} = \frac{\Sigma N_{i} d_{i}}{\Sigma N_{i}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \(z\mbox{-}\rm{average}\) diameter is the fifth momentum over the fourth one).</rdfs:comment>
        <rdfs:comment>Averages may be denoted by \(\left\langle ~ \right\rangle\) or by \(\bar{~}\).</rdfs:comment>
        <rdfs:comment>In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages.</rdfs:comment>
        <rdfs:comment>In the formulae, \(N_{i}\) denotes the number of particles of diameter \(d_{i}\).</rdfs:comment>
        <rdfs:label>number-average particle diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14292 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14292">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated using the following equation: \[\left\langle {d_{\rm{s}}} \right\rangle = \bar d_{\rm{s}} = \frac{\Sigma {N_{i}} {d_{i}^{3}}}{\Sigma {N_{i}} {d_{i}^{2}}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \(z\mbox{-}\rm{average}\) diameter is the fifth momentum over the fourth one).</rdfs:comment>
        <rdfs:comment>Averages may be denoted by \(\left\langle ~ \right\rangle\) or by \(\bar{~}\).</rdfs:comment>
        <rdfs:comment>In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages.</rdfs:comment>
        <rdfs:comment>In the formulae, \(N_{i}\) denotes the number of particles of diameter \(d_{i}\).</rdfs:comment>
        <rdfs:label>surface-average particle diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14293 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14293">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated using the following equation: \[\left\langle d_{\rm{m}} \right\rangle = \bar d_{\rm{m}} = \frac{\Sigma {N_{i}} {d_{i}^{4}}}{\Sigma {N_{i}} {d_{i}^{3}}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \(z\mbox{-}\rm{average}\) diameter is the fifth momentum over the fourth one).</rdfs:comment>
        <rdfs:comment>Averages may be denoted by \(\left\langle ~ \right\rangle\) or by \(\bar{~}\).</rdfs:comment>
        <rdfs:comment>In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages.</rdfs:comment>
        <rdfs:comment>In the formulae, \(N_{i}\) denotes the number of particles of diameter \(d_{i}\).</rdfs:comment>
        <rdfs:comment>The definition of mass-average diameter is meaningful only for latexes where the particles all have the same density.</rdfs:comment>
        <rdfs:label>mass-average particle diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14294 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14294">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated using the following equation: \[\left\langle d_{\rm{z}} \right\rangle = \bar d_{\rm{z}} = \frac{\Sigma N_{i} d_{i}^{5}}{\Sigma N_{i}d_{i}^{4}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \(z\mbox{-}\rm{average}\) diameter is the fifth momentum over the fourth one).</rdfs:comment>
        <rdfs:comment>Averages may be denoted by \(\left\langle ~ \right\rangle\) or by \(\bar{~}\).</rdfs:comment>
        <rdfs:comment>In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages.</rdfs:comment>
        <rdfs:comment>In the formulae, \(N_{i}\) denotes the number of particles of diameter \(d_{i}\).</rdfs:comment>
        <rdfs:comment>The definition of the \(z\mbox{-}\rm{average}\) diameter is meaningful only for latexes where the particles all have the same density and refractive index</rdfs:comment>
        <rdfs:label>z-average particle diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14295 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14295">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated using the following equation: \[\left\langle d_{\rm{v}} \right\rangle = \bar d_{\rm{v}} = \left(\frac{\Sigma N_{i} d_{i}^{3}}{\Sigma N_{i}}\right)^{1/3}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Average diameters are defined and calculated by using relations or ratios between the main momentums of a representative statistical distribution that is the particle diameter distribution (e.g., \(z\mbox{-}\rm{average}\) diameter is the fifth momentum over the fourth one).</rdfs:comment>
        <rdfs:comment>Averages may be denoted by \(\left\langle ~ \right\rangle\) or by \(\bar{~}\).</rdfs:comment>
        <rdfs:comment>In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages.</rdfs:comment>
        <rdfs:comment>In the formulae, \(N_{i}\) denotes the number of particles of diameter \(d_{i}\).</rdfs:comment>
        <rdfs:label>volume-average particle diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14296 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14296">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated using the following equation: \[Ɖ_{\rm{d}} = \left\langle d_{\rm{m}} \right\rangle /\!\left\langle d_{\rm{N}} \right\rangle = \bar d_{\rm{m}}/\bar d_{\rm{N}} = \frac{\Sigma N_{i}\Sigma N_{i} d_{i}^{4}}{\Sigma N_{i} d_{i} \Sigma N_{i} d_{i}^{3}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Averages may be denoted by \(\left\langle ~ \right\rangle\) or by \(\bar{~}\).</rdfs:comment>
        <rdfs:comment>For &quot;particle-diameter dispersity&quot;, the term &quot;diameter-polydispersity index&quot; is not recommended as &quot;polydispersity&quot; is an undefined quantity. The term &quot;non-uniformity factor&quot; is also not recommended.</rdfs:comment>
        <rdfs:comment>In principle, any method suitable for measuring the diameters of single particles (e.g., electron microscopy) could be used for the determination of all the averages given in the table. However, some experimental methods allow determination only of particular diameter averages.</rdfs:comment>
        <rdfs:comment>In the formulae, \(N_{i}\) denotes the number of particles of diameter \(d_{i}\).</rdfs:comment>
        <rdfs:comment>The term &quot;particle-diameter dispersity&quot; and the symbol \(Ɖ_{\rm{d}}\) are an extension of the terms molar-mass dispersity (\(Ɖ_{\rm{m}}\)) and degree-of-polymerization dispersity (\(Ɖ_{\rm{X}}\)), where \(Ɖ_{\rm{m}} = \bar M_{\rm{m}}/\bar M_{\rm{n}}\) and \(Ɖ_{\rm{X}} = \bar X_{\rm{m}}/\bar X_{\rm{n}}\).</rdfs:comment>
        <rdfs:label>particle-diameter dispersity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14297 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14297">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle that is spatially uniform with respect to chemical composition of the constituent polymer(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>A particle that is chemically homogeneous but has a radial distribution function of composition that is not step-like is not a homogeneous particle. Similarly, a block-copolymer micelle is not a homogeneous particle, although all constituent copolymer molecules can have identical compositions.</rdfs:comment>
        <rdfs:label>homogeneous particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14298 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14298">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inhomogeneous particle consisting of two or more immiscible components.Examples of two-phase particle morphology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>composite particle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>structured particle</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Multicomponent particles are often obtained by sequential polymerizations of different monomers or monomer mixtures.</rdfs:comment>
        <rdfs:comment>The components can be solid, liquid, or gaseous.</rdfs:comment>
        <rdfs:label>multicomponent particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14299 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14299">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer particle comprising at least two phase domains, one of which (the core) lies within the other(s) that form the polymeric outer layer(s) (the shell(s)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Core-shell particles in which polymer synthesized in the second stage is located within one single domain, and the particles and polymer constituting the initial seed are located in the shell are usually called inverted core-shell particles.</rdfs:comment>
        <rdfs:comment>Core-shell particles may be obtained by seeded emulsion polymerization in which the seed particles form the cores of the new particles, and polymer produced in the second stage and subsequent stages, if any, forms the shell.</rdfs:comment>
        <rdfs:comment>Examples of core-shell particles are shown in multicomponent particle. A core may be composed of one single-phase domain of one type of polymer or copolymer block in a shell of a different type of polymer (or copolymer block).</rdfs:comment>
        <rdfs:label>core-shell particle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14298"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14300"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14300 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14300">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Core-shell particle in which polymer synthesized in the second stage is located in the core of the particle and polymer constituting the initial seed is located in the shell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>inverted core-shell particle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14298"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14301 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14301">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multicomponent particle made of at least two different polymers, with an inner core of one polymer and with at least two layers of different polymers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>multilayered particle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14298"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14302 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14302">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multicomponent particle in which one polymer forms more than one phase domain within a matrix of another polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The number and size of the domains can vary, and their spatial distribution within the particles is often not uniform.</rdfs:comment>
        <rdfs:comment>This type of particle is also referred to as having microdomain morphology.</rdfs:comment>
        <rdfs:label>occluded particle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14298"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14303 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14303">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multicomponent particle in which one or more polymer(s) cover(s) most, but not all, of the particle surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The degree of coverage may vary when neither polymer is preferentially covering the other one. The morphology is commonly referred to as a hemisphere.</rdfs:comment>
        <rdfs:label>partially engulfed particle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14298"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14304 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14304">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle containing pores of diameters exceeding about \(\pu{50 nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>macroporous particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14305 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14305">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle containing pores of diameters between approximately \(\pu{2 \upmu m}\) and \(\pu{50 \upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>mesoporous particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14306 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14306">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle containing pores of diameters not exceeding \(\pu{2 nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>microporous particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14307 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14307">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phase constituted of particles of any size and of any nature dispersed in a continuous phase of a different composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>dispersed phase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14308 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14308">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phase not interrupted in space</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The continuous phase may be gaseous, liquid, or solid.</rdfs:comment>
        <rdfs:label>continuous phase</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14309 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14309">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Matrix for the dispersed phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>If the continuous phase is a gas, the dispersion is called an aerosol.</rdfs:comment>
        <rdfs:comment>The dispersion medium is the continuous phase of the dispersion.</rdfs:comment>
        <rdfs:label>dispersion medium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14310 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14310">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion in which the continuous phase is nonaqueous.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>nonaqueous dispersion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14311 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14311">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion in which the dispersed phase consists of a polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer dispersion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14312 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14312">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compound increasing stability of a colloid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>A colloid stabilizer may be added to a colloid or synthesized during colloid preparation.</rdfs:comment>
        <rdfs:label>colloid stabiliser</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14313 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14313">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Colloidal dispersion in which at least one of the phases is a polymer, either organic, or inorganic or some combination of the two.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Particles of a liquid or a gas dispersed in a polymer, particles comprising &quot;empty&quot; shells made of polymers, and aerosols of polymer particles are all known examples.</rdfs:comment>
        <rdfs:comment>The term &quot;polymer colloid&quot; is more general than latex. In a latex the dispersed phase is always a polymer, whereas in a polymer colloid this need not be so.</rdfs:comment>
        <rdfs:label>polymer colloid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14314 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14314">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion in which the dispersed phase is a liquid polymer or a polymer solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The dispersing phase may be a low-molecular-weight liquid or a solution of another polymer.</rdfs:comment>
        <rdfs:label>polymer emulsion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14315 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14315">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion in which the particles of the dispersed phase have diameters from approximately \(\pu{1 \upmu m}\) to \(\pu{100 \upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Macro-emulsions comprise large droplets and thus are &quot;unstable&quot; in the sense that the droplets sediment or float, depending on the densities of the dispersed phase and dispersion medium. Separation of the dispersed and continuous phases usually occurs within time periods from a few seconds to a few hours, depending upon the viscosity of the fluid medium and the size and density of the droplets.</rdfs:comment>
        <rdfs:comment>Macro-emulsions usually contain low-molecular-weight or polymeric surfactants that decrease the rates of coalescence of dispersed droplets. Droplets of the dispersed phase may be also stabilized by adsorption of solid particles onto their surface (so-called Pickering stabilization).</rdfs:comment>
        <rdfs:label>macro-emulsion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14316 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14316">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion in which the particles of the dispersed phase have diameters in the range from approximately \(\pu{50 nm}\) to \(\pu{1 \upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Mini-emulsions are usually stabilized against diffusion degradation (Ostwald ripening) by a compound insoluble in the continuous phase.</rdfs:comment>
        <rdfs:comment>The dispersed phase contains mixed stabilizers, e.g., an ionic surfactant, such as sodium dodecyl sulfate (n-dodecyl sulfate sodium) and a short aliphatic chain alcohol (&quot;co-surfactant&quot;) for colloidal stability, or a water-insoluble compound, such as a hydrocarbon (&quot;co-stabilizer&quot; frequently and improperly called a &quot;co-surfactant&quot;) limiting diffusion degradation. Mini-emulsions are usually stable for at least several days.</rdfs:comment>
        <rdfs:label>mini-emulsion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14317 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14317">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion made of water, oil, and surfactant(s) that is an isotropic and thermodynamically stable system with dispersed domain diameter varying approximately from \(\pu{1 nm}\) to \(\pu{100 nm}\), usually \(\pu{10 nm}\) to \(\pu{50 nm}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>In a micro-emulsion the domains of the dispersed phase are either globular or interconnected (to give a bicontinuous micro-emulsion).</rdfs:comment>
        <rdfs:comment>The average diameter of droplets in macro-emulsion (usually referred to as an &quot;emulsion&quot;) is close to one millimeter (i.e., \(\pu{E-3 m}\)). Therefore, since micro- means \(\pu{E-6 m}\) and emulsion implies that droplets of the dispersed phase have diameters close to \(\pu{E-3 m}\), the micro-emulsion denotes a system with the size range of the dispersed phase in the \(\pu{E-6} \times \pu{E-3 m} = \pu{E-9 m}\) range.</rdfs:comment>
        <rdfs:comment>The term &quot;micro-emulsion&quot; has come to take on special meaning. Entities of the dispersed phase are usually stabilized by surfactant and/or surfactant-cosurfactant (e.g., aliphatic alcohol) systems.</rdfs:comment>
        <rdfs:comment>The term &quot;oil&quot; refers to any water-insoluble liquid.</rdfs:comment>
        <rdfs:label>micro-emulsion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14318 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14318">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of micelle that exists in relatively small numbers below the critical micelle concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>hemi-micelle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14319 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14319">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surfactant bilayer formed on a charged adsorbing surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Ad-micelles are usually formed on inorganic particles.</rdfs:comment>
        <rdfs:comment>In the case of particles with charged surfaces the surfactant molecules are oriented with their charged head-groups toward the particle surfaces. In the case of further addition of surfactant, a surface bilayer may form, which is termed an ad-micelle (adsorbed micelle).</rdfs:comment>
        <rdfs:label>ad-micelle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14320 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14320">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of molecules constituting a micelle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>micellar degree of association</oboInOwl:hasRelatedSynonym>
        <rdfs:label>micellar aggregation number</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14321 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14321">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Combined charge of the surfactant ions and counterions tightly bound to a micelle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Micelle with tightly bound ions behaves as a unit carrying the net charge.</rdfs:comment>
        <rdfs:label>micellar charge</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14322 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14322">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of a mole of micelles divided by the molar mass constant. The relative molar mass of micelles (mic) is thus \(M_{\rm{r,mic}} = M_{\rm{mic}}/M_{\rm{u}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>micellar molecular weight</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>1/12 of the molar mass of \(\ce{^{12}C}\) is termed &quot;molar mass constant&quot; with symbol \(M_{\rm{u}} = M(\ce{^{12}C})/12 = N_{\rm{A}} m_{\rm{u}}\) and unit \(\pu{g mol-1}\) where \(m_{\rm{u}}\) is the &quot;atomic mass constant&quot; with unit \(\pu{u}\) or \(\pu{Da}\), and \(N_{\rm{A}}\) is the Avogadro constant.</rdfs:comment>
        <rdfs:comment>The micellar relative molar mass refers to a neutral micelle and thus includes the mass of counterions that compensate the charge of surfactant molecules in micelles.</rdfs:comment>
        <rdfs:label>micellar relative molar mass</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14323 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14323">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of particles per volume of suspending medium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>particle number concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14324 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14324">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of nonvolatile material in a polymer dispersion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>solids content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14311"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14325 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14325">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of polymer in a polymer dispersion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14311"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14326 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14326">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount concentration of a species within the dispersed phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>dispersed-phase amount concentration</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>particle-phase amount concentration</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>particle-phase concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>If the dispersed phase depends on quantities such as radius, \(r\), time, \(t\), etc., the recommended symbols are \([\ce{A}]_{\rm{p}}(r,t,\ldots)\) and \([\ce{M}]_{\rm{p}}(r,t,\ldots)\).</rdfs:comment>
        <rdfs:label>dispersed-phase concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14327 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14327">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of species within the continuous phase of a dispersion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>continuous-phase amount concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>If the continuous phase is water, the symbols \([\ce{A}]_{\rm{w}}\) and \([\ce{M}]_{\rm{w}}\) are usually used.</rdfs:comment>
        <rdfs:comment>If the continuous-phase concentration depends on quantities such as time \(t\), etc., the recommended symbols are \([\ce{A}]_{\rm{cont}}(t,\ldots)\) and \([\ce{M}]_{\rm{cont}}(t,\ldots)\).</rdfs:comment>
        <rdfs:label>continuous-phase concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14328 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14328">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass fraction of polymer within the dispersed phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>polymer mass fraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14329 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14329">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization whereby monomer(s), initiator, dispersion medium, and possibly colloid stabilizer constitute initially an inhomogeneous system resulting in particles of colloidal dimensions containing the formed polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>With the exception of mini-emulsion polymerization, the term &quot;emulsion polymerization&quot; does not mean that polymerization occurs in the droplets of a monomer emulsion.</rdfs:comment>
        <rdfs:label>emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14345"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14330 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14330">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which no seed particles are added.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>ab initio emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14331 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14331">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which all the ingredients are placed in a reactor prior to reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>batch emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14332 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14332">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which all the ingredients are added continuously and the product latex is removed continuously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>continuous emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14333 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14333">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization carried out without the addition of a colloid stabilizer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>In an emulsifier-free emulsion polymerization, a colloid stabilizer is produced in situ (e.g., the polymerization of styrene initiated with potassium persulfate yields macromolecules with anionic end groups providing ionic stabilization of the colloidal polystyrene particles).</rdfs:comment>
        <rdfs:comment>Other names, such as emulsifier-less, soap-less, soap-free, surfactant-less, and surfactant-free emulsion polymerization, that are sometimes used, are not recommended.</rdfs:comment>
        <rdfs:label>emulsifier-free emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14334 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14334">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization leading to the encapsulation of a solid within polymer particles or liquid polymer droplets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>An encapsulating emulsion polymerization is often performed inside ad-micelles.</rdfs:comment>
        <rdfs:label>encapsulating emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14319"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14335 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14335">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in a nonaqueous medium in which the dispersed phase is usually an aqueous solution, initially of monomer(s), and finally of polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>inverse emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14336 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14336">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semi-continuous emulsion polymerization in which the monomer(s) is(are) fed to the reactor at a rate that exceeds the rate of polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>A monomer-flooded emulsion polymerization refers to a state where the monomer concentration in the polymer particles is at or greater than its equilibrium swelling value and therefore droplets may be formed.</rdfs:comment>
        <rdfs:label>monomer-flooded emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14340"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14337 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14337">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semi-continuous emulsion polymerization in which the polymerization rate is controlled by the feed rate(s) of monomer(s), in such a way that, for most of the process, the polymerization rate equals the monomer(s) feed rate(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Usually a monomer-starved emulsion polymerization refers to a state where the monomer concentration in the polymer particles is less than its equilibrium swelling value.</rdfs:comment>
        <rdfs:label>monomer-starved emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14340"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14338 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14338">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semi-continuous emulsion copolymerization in which the instantaneous composition of the formed copolymer is the same as that of the added monomer mixture(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>A power-feed emulsion polymerization is normally achieved by feeding to the reactor monomer mixture(s) from one or more reservoirs under monomer-starved conditions. In the simplest case, reservoirs I and II are initially filled with monomers \(\ce{A}\) and \(\ce{B}\), respectively. During polymerization the contents of reservoir I are continuously pumped into the reactor and the contents of reservoir II are continuously pumped into reservoir I at definite rates.</rdfs:comment>
        <rdfs:label>power-feed emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14340"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14339 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14339">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization with seed particles are formed in situ or added initially to the polymerizing mixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Under certain conditions the seed particles capture enough radical species from the aqueous phase so that no new particles are formed. In such polymerization, the number of growing particles is equal to the number of seed particles.</rdfs:comment>
        <rdfs:label>seeded emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14340 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14340">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which some of the ingredients are initially placed in a reactor and the remaining ingredients are added during the polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>semi-batch emulsion polymerization</oboInOwl:hasRelatedSynonym>
        <rdfs:label>semi-continuous emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14341 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14341">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization inside the bilayer of a vesicle leading to formation of polymer inside the bilayer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>In the case of reactive copolymerizing surfactants (i.e., surfmers) hollow spherical entities can sometimes be obtained with a homogeneous distribution of polymer in the bilayer.</rdfs:comment>
        <rdfs:comment>The bilayer may contain polymerizable and non-polymerizable molecules.</rdfs:comment>
        <rdfs:comment>The morphology of such entities is called &quot;parachute&quot; morphology, owing to similarity of their shape to the shape of parachute canopy.</rdfs:comment>
        <rdfs:comment>Usually phase separation occurs leading to entities with inhomogeneously distributed polymer (e.g., entities that contain a latex particle inside the vesicle’s bilayer).</rdfs:comment>
        <rdfs:label>vesicle polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14377"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14342 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14342">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which the starting system is a micro-emulsion and the final latex comprises colloidal particles of polymer dispersed in an aqueous medium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Diameters of polymer particles formed in the micro-emulsion polymerization usually are between \(\pu{10 nm}\) and \(\pu{50 nm}\).</rdfs:comment>
        <rdfs:label>micro-emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14317"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14343 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14343">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which the starting system is a micro-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>inverse micro-emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14317"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14344 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14344">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization of a polymerizable surfactant in solution above its critical micelle concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The initial micellar structure usually is not preserved during the polymerization.</rdfs:comment>
        <rdfs:label>micellar polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14345 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14345">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization of a mini-emulsion of monomer in which all of the polymerization occurs within preexisting monomer particles without the formation of new particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>mini-emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14316"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14346 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14346">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Emulsion polymerization in which the starting system is a mini-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>inverse mini-emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14347 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14347">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization in which monomer(s), initiator(s) and colloid stabilizer(s) are dissolved in a solvent and this continuous phase that is a nonsolvent for the formed polymer beyond a critical molecular weight.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>precipitation polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14348 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14348">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precipitation polymerization in which monomer(s), initiator(s), and colloid stabilizer(s) are dissolved in a solvent forming initially a homogeneous system that produces polymer and results in the formation of polymer particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The process usually results in polymer particles of colloidal dimensions.</rdfs:comment>
        <rdfs:label>dispersion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14349 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14349">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion polymerization in which seed particles are formed in situ or added prior to initiation of the polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>seeded dispersion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14348"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14350 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14350">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precipitation polymerization proceeding by polycondensation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>precipitation polycondensation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14351 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14351">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion polymerization proceeding by polycondensation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>dispersion polycondensation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14348"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14352 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14352">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Precipitation polymerization proceeding by polyaddition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>precipitation polyaddition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14347"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14353 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14353">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dispersion polymerization proceeding by polyaddition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>dispersion polyaddition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14348"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14354 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14354">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization in which polymer is formed in monomer, or monomer-solvent droplets in a continuous phase that is a nonsolvent for both the monomer and the formed polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>In suspension polymerization, the initiator is located mainly in the monomer phase.</rdfs:comment>
        <rdfs:comment>Monomer or monomer-solvent droplets in suspension polymerization have diameters usually exceeding \(\pu{10 \upmu m}\).</rdfs:comment>
        <rdfs:label>suspension polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14355 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14355">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Suspension polymerization in which the diameter of the monomer droplets is of the order of a few \(\pu{\upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>micro-suspension polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14354"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14356 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14356">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the total number of radicals in particles to the number of particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>average number of radicals per particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14357 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14357">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lowest degree of polymerization of aqueous-phase oligomer-radicals needed for irreversible capture by colloidal particles, micelles, or both during a polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>critical oligomer degree of polymerisation for irreversible entry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14358 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14358">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lowest degree of polymerization of oligomer-radicals that precipitate from the continuous phase during a polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>\(j_{\rm{crit}}\) is usually equal to the degree of polymerization at which oligomer-radicals undergo a coil-to-globule transition.</rdfs:comment>
        <rdfs:label>critical oligomer degree of polymerisation for precipitation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14359 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14359">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Periods in an emulsion polymerization defined by the formation of polymer particles, and the presence or absence of monomer droplets in the polymerizing mixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>In naming particular intervals, the word &quot;interval&quot; is always written with a capital I.</rdfs:comment>
        <rdfs:label>intervals in emulsion polymerisations</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14360 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14360">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period in a batch ab initio emulsion polymerization during which the formation of particles takes place.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>interval 1 in emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14330"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14331"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14361 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14361">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period in an emulsion polymerization during which no new particles are formed and monomer droplets are present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>This interval is associated with an approximately constant value of the average number of radicals per particle, an approximately constant value of monomer concentration in the particles, and, thus, an approximately constant rate of polymerization.</rdfs:comment>
        <rdfs:label>interval 2 in emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14362 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14362">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Period in an emulsion polymerization during which no new particles are formed and no monomer droplets are present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>interval 3 in emulsion polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14329"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14363 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14363">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Limiting behaviour in an emulsion, mini-emulsion, or micro-emulsion polymerization during which the entry of a radical into a particle that contains a growing radical results in termination before significant propagation has occurred.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The value of the average number of radicals per particle (\(\bar N\)) for a zero-one system can never exceed \(\pu{0.5}\).</rdfs:comment>
        <rdfs:comment>This type of behaviour commonly occurs for small particles, the size of which depends on the type of monomer and on polymerization conditions.</rdfs:comment>
        <rdfs:label>zero-one behaviour</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14342"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14356"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14364 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14364">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Zero-one behaviour wherein radicals are isolated, each being located within a different latex particle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>compartmentalisation behaviour</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14363"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14365 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14365">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Behaviour in an emulsion, mini-emulsion, micro-emulsion, suspension, or dispersion polymerization wherein the kinetics are such that the rate equations are the same as those for polymerization in bulk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Common extreme cases are (i) when the value of \(\bar N\) is so high that each particle effectively behaves as a micro-reactor, and (ii) when the value of \(\bar N\) is low, exit is very rapid and the exited radical re-enters another particle, may grow to a significant degree of polymerization, and so on before any termination event.</rdfs:comment>
        <rdfs:comment>In a pseudo-bulk system, the average number of radicals per particle, \(\bar N\), can take any value.</rdfs:comment>
        <rdfs:label>pseudo-bulk behaviour</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14317"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14348"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14356"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14366 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14366">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of primary particles as a result of micelle formation from surface-active oligomer radicals formed in a polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The surface-active oligomer radicals are usually formed by polymerization with initiators providing ionic end-groups.</rdfs:comment>
        <rdfs:label>homogeneous micellisation nucleation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14374"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14367 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14367">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of primary particles as a result of polymerization within monomer-swollen micelles initiated by the capture of primary radicals or oligomer-radicals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>micellar nucleation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14375"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14368 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14368">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A process combining nucleation by any mechanism with subsequent coagulation being a significant event in formation of colloidally stable particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>The term &quot;coagulative nucleation&quot; does not mean that nucleation is caused by coagulation.</rdfs:comment>
        <rdfs:label>coagulative nucleation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14369 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14369">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transport of any species (radical, monomer, chain-transfer agent, etc.) from the continuous to the discrete phase and vice-versa.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>phase-transfer event in a dispersed system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14370 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14370">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irreversible transport of a radical from the continuous to the dispersed phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>This type of transport frequently involves a radical arising directly from initiator. An example is the sulfate radical anion \(\ce{SO4^{.-}}\), with the systematic name tetraoxidosulfate (\(•1-\)) (where the part in parentheses is pronounced &quot;dot one minus&quot;), propagating with monomer in the aqueous phase until the resulting oligomeric species enters a particle irreversibly.</rdfs:comment>
        <rdfs:label>radical entry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14371 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14371">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average number of entry events per particle per unit interval of time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>entry frequency</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The term &quot;entry rate coefficient&quot; is incorrect and is not recommended.</rdfs:comment>
        <rdfs:label>radical entry frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14372 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14372">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reversible or irreversible transport of a radical from the dispersed to the continuous phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>radical desorption</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This type of transport is frequently through transfer of the radical activity at the end of a macroradical within a particle to a smaller species which may then diffuse irreversibly out of the parent particle into the continuous phase.</rdfs:comment>
        <rdfs:label>radical exit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14373 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14373">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average number of exit events per particle per unit interval of time per radical.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>exit frequency</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The term &quot;exit rate coefficient&quot; is incorrect and is not recommended.</rdfs:comment>
        <rdfs:label>radical exit frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14375 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14375">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radicals formed from an initiator molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>&quot;Primary radical&quot; describes the radical before it reacts with any molecule of monomer.</rdfs:comment>
        <rdfs:label>primary radical</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14376 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14376">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle in a polymer colloid that is the locus of subsequent polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>A seed particle is either added to a polymerization mixture before the polymerization begins, or is formed in situ.</rdfs:comment>
        <rdfs:label>seed particle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14313"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14377 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14377">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monomer with the properties of a surfactant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>surfmer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14378 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14378">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initiator with the properties of a surfactant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>inisurf</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14379 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14379">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain-transfer agent with the properties of a surfactant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>transurf</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14380 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14380">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of a system with separate macrophases from an emulsion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>breaking of an emulsion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14381 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14381">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minimum concentration of electrolyte at and above which rapid coagulation occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>critical coagulation amount concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>As the value of the \({\rm{c}}_{\rm{cc}}\) depends to some extent on the experimental circumstances (method of mixing, time between mixing and determining the state of coagulation, criterion for measuring degree of coagulation, etc.), these should be clearly stated.</rdfs:comment>
        <rdfs:comment>Rapid coagulation occurs when the only forces between the particles are the attractive van der Waals forces, all other forces being negligible.</rdfs:comment>
        <rdfs:label>critical coagulation concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14384"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14382 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14382">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coagulation of particles of different kinds or sizes, or both.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>heterocoagulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14383 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14383">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coagulation of colloidal particles of the same size and kind.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>homocoagulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14384 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14384">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of coagulation in the absence of any repulsive barrier between particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>rapid coagulation rate</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The fast coagulation rate is usually measured by adding electrolyte at an increasing concentration, until the observed coagulation rate becomes independent of the electrolyte concentration.</rdfs:comment>
        <rdfs:label>fast coagulation rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14385 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14385">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate coefficient for fast coagulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>fast coagulation rate coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14387 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14387">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate coefficient for flocculation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>flocculation rate coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14386"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14388 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14388">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which surface-active molecules or ions aggregate into micelles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>micellisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14389 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14389">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coagulation due to collisions of particles induced by hydrodynamic motion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Orthokinetic coagulation occurs when shear-induced collisions dominate over collisions due to Brownian motion.</rdfs:comment>
        <rdfs:label>orthokinetic coagulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14390 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14390">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monolayer of particles deposited at an interface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>A monolayer of regularly deposited particles is called a two-dimensional colloidal crystal.</rdfs:comment>
        <rdfs:label>particle monolayer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14391 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14391">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coagulation due to collisions of particles caused by their Brownian motion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:comment>Perikinetic coagulation occurs in the absence of mixing or under conditions where shear-induced collisions are negligible compared to diffusion-induced collisions.</rdfs:comment>
        <rdfs:label>perikinetic coagulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14392 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14392">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of coagulation in presence of repulsive barriers between particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>slow coagulation rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14393 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14393">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate coefficient for slow coagulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>slow coagulation rate coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14394 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14394">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio \(W = k_{\rm{fast}}/k_{\rm{slow}}\) or \(W = k_{\rm{fast}}/k_{\rm{floc}}\), for coagulation or flocculation, respectively, with \(k_{\rm{fast}}\), \(k_{\rm{slow}}\), and \(k_{\rm{floc}}\) measured under the same mixing (or hydrodynamic) conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <oboInOwl:hasRelatedSynonym>Fuchs stability ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>When comparing \(W\) with theory, the fast coagulation rates are often approximated by the Smoluchowski rates of coagulation.</rdfs:comment>
        <rdfs:label>stability ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14395 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14395">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System in which the particles essentially do not aggregate or sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>colloidally stable system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14396 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14396">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stabilization of a colloid resulting from the mutual repulsion of the electrical double layers surrounding its particles.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>electrostatic stabilisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14397 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14397">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stabilization of a colloid that has both steric and electrostatic stabilization characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>electrosteric stabilisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14396"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14398 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14398">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Stabilization of a colloid resulting from covering particles with a layer of molecules solvated by the continuous medium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-10-06-03"/>
        <rdfs:label>steric stabilisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14399 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14399">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the toxic effects of chemical and physical agents on all living organisms, especially on populations and communities within defined ecosystems; it includes transfer pathways of these agents and their interactions with the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>ecotoxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14400 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14400">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a physical, chemical, or biological agent to induce (or generate) heritable changes (mutations) in the genotype in a cell as a consequence of alterations or loss of genes or chromosomes (or parts thereof).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>mutagenicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14401 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14401">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Particle in air of aerodynamic diameter \(\pu{\lt 0.1 \upmu m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:comment>The fraction of the air particulates referred to as ultrafines is often referred to as the \(\pu{PM_{0.1}}\) fraction.</rdfs:comment>
        <rdfs:label>ultrafine particle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14402 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14402">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the influence of hereditary factors on the effects of potentially toxic substances on individual organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>toxicogenetics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14403 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14403">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a physical, chemical, or biological agent to induce adverse effects in the reproductive system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>reproductive toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14404 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14404">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the non-heritable adverse effects of substances on male and female reproductive function or capacity and on resultant progeny.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>reproductive toxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14405 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14405">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Global term for the whole process from hazard identification to risk management.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>risk assessment management process</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14406 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14406">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decision-making process involving considerations of political, social, economic, and engineering factors with relevant risk assessments relating to a potential hazard so as to develop, analyze, and compare regulatory options and to select the optimal regulatory response for safety from that hazard.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:comment>Essentially risk management is the combination of three steps: risk evaluation; emission and exposure control; risk monitoring.</rdfs:comment>
        <rdfs:label>risk management</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14407 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14407">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reciprocal of risk: practical certainty that injury will not result from a hazard under defined conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:comment>Safety (toxicological): The high probability that injury will not result from exposure to a substance under defined conditions of quantity and manner of use, ideally controlled to minimize exposure.</rdfs:comment>
        <rdfs:comment>Safety of a drug or other substance in the context of human health: the extent to which a substance may be used in the amount necessary for the intended therapeutic purpose with a minimum risk of adverse health effects.</rdfs:comment>
        <rdfs:label>safety</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14408 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14408">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Single page giving toxicological and other safety advice, usually associated with a particular preparation, substance, process, use pattern, or exposure scenario.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>safety data sheet</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14409 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14409">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a physical, chemical, or biological agent to induce adverse effects in the immune system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-09-03-01"/>
        <rdfs:label>immunotoxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14410 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14410">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temporarily deactivated chain carrier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-04-03"/>
        <rdfs:label>dormant polymer chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14411 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14411">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deactivation of a chain carrier in a chain polymerisation, reversibly converting the active center into an inactive one and then, within the lifetime of a growing macromolecule, regenerating an active center on the same original chain carrier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-04-03"/>
        <rdfs:label>reversible chain deactivation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14412 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14412">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Controlled reversible-deactivation radical polymerization in which the deactivation of the radicals involves degenerative transfer (DT) of a group (or atom).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-04-03"/>
        <oboInOwl:hasRelatedSynonym>DTRP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>degenerate-transfer radical polymerisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14412"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DTRP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14413 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14413">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that enters and is retained inside a solid or semisolid matrix (absorbent).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>absorbate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14414"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14414 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14414">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid or semisolid matrix that is able to accommodate and retain an absorbate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>absorbent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14413"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15040"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14415 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14415">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total number of individual organisms in a population, seen over a defined period of time in a certain place.Note: For fish, an estimate of total weight may replace number. Total number of organisms per unit of habitat space seen over a defined period. Amount of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all elements in a given medium (e.g., the Earth’s crust). Amount of an isotope of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all isotopes of the element.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>abundance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14416 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14416">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Element which is of common occurrence in the Earth’s crust.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>abundant metal</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Abundance may be defined in terms of occurrence in other regions, e.g., oceans, &quot;freshwater&quot;.</rdfs:comment>
        <rdfs:label>abundant element</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14415"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14417 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14417">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capable of being entered or reached; easy of access; such as one can go to, come into the presence of, reach, or lay hold of; get-at-able.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>accessible</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14418 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14418">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Processes, including selection and adaptation, by which a population of microorganisms develops the ability to degrade a substance, or develops a tolerance to it. In experimental systems, allowing an organism to adjust to its environment prior to undertaking a study. Modification of biological processes or structures in the maintenance of homeostasis in response to change in some environmental quality such as temperature, salinity, light, radiation, or toxicant concentration. Note: It is an expression of phenotypic plasticity of individuals in response to a sublethal change in some environmental factor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>acclimatation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acclimation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acclimatisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14711"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14744"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14419 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14419">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rain, fog, snow, sleet, or other particulate matter from the atmosphere with a _000078_ below \(\pu{5.6}\) deposited from the air.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Rain under clean air conditions has a _000078_ slightly under \(\pu{6}\). This natural acidity is caused by dissolved carbon dioxide dissociating to form carbonate and hydrogencarbonate ions. &quot;Acid rain&quot; is caused by sulfur in fossil fuels, and nitrogen from the air combining with oxygen to form sulfur oxides and nitrogen oxides during combustion.</rdfs:comment>
        <rdfs:label>acid precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14420 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14420">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Soil- and sediment-associated solid-phase sulfides extractable with cold hydrochloric acid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>AVS</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>AVS may be chemically available by acid extraction without being bioavailable. Thus, AVS can reduce metal toxicity by binding metals in anoxic soils or sediments, thereby rendering them unavailable to most living organisms.</rdfs:comment>
        <rdfs:label>acid-volatile sulfide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14473"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14420"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AVS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14421 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14421">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of short duration, in relation to exposure or effect; the effect usually shows a rapid onset. Note 1: In regulatory toxicology, &apos;acute&apos; refers to studies where dosing is either single or limited to one day although the total study duration may extend to two weeks to permit appearance of toxicity in susceptible organ systems. Note 2: In aquatic ecotoxicology, exposure of the test organisms is typically continuous and of four days or less. In clinical medicine, sudden and severe, having a rapid onset.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>acute</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14524"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14422 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14422">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Numerical dimensionless quantity that is the ratio of an acute toxicity test result (e.g., \(\pu{LC_{50}}\)) to a chronic toxicity test result (e.g., maximum acceptable toxicant concentration, MATC) where both are expressed in the same units (e.g., \(\pu{mg L-1}\)). Ideally, the data are for the same chemical species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ACR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>It is in principle the inverse of an application factor and is used in a similar manner. The ACR is commonly used for estimating chronic toxicity of a chemical on the basis of its acute toxicity. The ACR should be greater than one because the ratio compares an acute to a chronic value.</rdfs:comment>
        <rdfs:label>acute-to-chronic toxicity ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14421"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14524"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15121"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14422"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ACR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14423 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14423">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consequence that follows exposure to two or more physicochemical agents that act jointly but do not interact: the total effect is the simple sum of the effects of separate exposures to the agents under the same conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>additive effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14424 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14424">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantification of the joint action of toxicants in mixture by adding measures of their toxicity calculated in relation to the toxicity of a reference toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>additive index</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14425 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14425">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Index reflecting the balance of energy transfer between catabolic and anabolic processes, calculated from the equation \[\rm{AEC} = ([\ce{ATP}] + ½[\ce{ADP})/([\ce{ATP}] + [\ce{ADP}] + [\ce{AMP}])\] where \(\ce{ATP}\), \(\ce{ADP}\), and \(\ce{AMP}\) are the amount concentrations of adenosine tri-, di-, and monophosphate, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>AEC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>adenylate energy charge</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14426 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14426">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the amount of substance adsorbed at the interface of a condensed layer and a liquid or gaseous phase to the total amount of the substance available for adsorption.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>adsorption factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14427 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14427">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of organisms of the same age within a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>age class</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14428 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14428">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distribution of organisms among the various age classes present in the population. The sum of the number of individuals in all age classes equals the population size.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>age composition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14429 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14429">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Composition of a population in terms of how its abundance is distributed across age classes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>age distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14427"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14430 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14430">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean number of deaths as tabulated for a life table interval or for a specific age class in a given year, expressed per \(\pu{1000}\) in that interval or age class.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>age-specific mortality</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>age-specific number of individuals dying</oboInOwl:hasRelatedSynonym>
        <rdfs:label>age-specific death rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14427"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14431 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14431">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Error in Bayesian probability analysis of model systems resulting from the use of a single set of parameters to represent a collection of distinct entities, such as individuals, in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>aggregation error</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14463"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14432 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14432">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Empirical index used to assess the tolerance of individual plants to contaminated air. The numerical value of \(T_{\rm{I}}\) is obtained by combining various quantities according to the recipe \([A (T + P) + R]/10\), where \(A\) is the mass of ascorbic acid divided by the dry mass of a leaf, expressed as \(\pu{mg/g}\), \(T\) is the total mass of chlorophyll divided by the fresh mass, expressed as \(\pu{mg/g}\), \(P\) is the pH of a leaf extract, and \(R\) is the mass of water in the leaf divided by the wet mass, expressed as percent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>APTI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In common usage, the equation is not formulated as a coherent equation, but requires the given units.</rdfs:comment>
        <rdfs:label>air pollution tolerance index</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14432"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>APTI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14433 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14433">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of various chiefly aquatic, eukaryotic, photosynthetic organisms, ranging in size from single-celled forms to the giant kelp.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Algae of various species, often unicells, are used for toxicity testing in ecotoxicology. They are an important component of aquatic food webs.</rdfs:comment>
        <rdfs:label>alga</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14434 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14434">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rapid increase in the abundance of phytoplankton or benthic algae in a given area, often as a result of an increased availability of nutrients or light, or increase in temperature (e.g., the spring bloom).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>algal bloom</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14918"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14435 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14435">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill algae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>algicide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14436 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14436">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inhibiting algal population growth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>algistatic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14435"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14437 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14437">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequential appearance of species driven by external influences that alter local conditions; e.g., silt deposits changing a marshland to woodland.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>allogenic succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14438 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14438">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surrounding (applied to environmental media such as air, water, sediment, or soil).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ambient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14439 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14439">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Continuous or repeated measurement of agents in the environment to evaluate ambient exposure and health risk by comparison with appropriate reference values based on knowledge of the probable relationship between exposure and resultant adverse health effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ambient monitoring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14438"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14440 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14440">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Showing anadromy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>anadromous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14441"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14441 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14441">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Life-history pattern that is characterized by egg incubation and early juvenile development in freshwater, migration to seawater for adult development, and a return to freshwater for spawning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Obligatory anadromy is the term applied where migration to seawater is required for survival.</rdfs:comment>
        <rdfs:label>anadromy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14516"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14797"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14442 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14442">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scheme that defines the exact format and design of the assessment, explicitly states the data needed, and describes the methods and design for analyzing these data.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>analysis plan</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14443 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14443">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Caused by or influenced by human activities. Describing a conversion factor used to calculate a dose or concentration affecting a human that has been derived from data obtained with another species, e.g., the rat.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>anthropogenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14444 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14444">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quality of a population of bilaterally symmetrical individuals in which the difference in measurement of a trait made from the right and left sides of individuals from that population produces a bimodal distribution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>antisymmetry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14696"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14445 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14445">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>\(\arcsin \sqrt{P}\), where \(P\) is the value of a measured effect, e.g., the proportion of exposed organisms in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This transformation of effects data often fulfills an assumption of homogeneous variances for proportions of exposed individuals responding to a stimulus.</rdfs:comment>
        <rdfs:label>arcsine square root transformation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14446 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14446">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by adding the earthworms to an artificial soil made of sand, clay mineral, and peat, containing the substance of concern.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>artificial soil test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14447 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14447">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by placing the worms in an artificial substrate consisting of silica, water, and glass balls, containing the substance of concern.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>In the artisol test, the earthworms ingest the silica paste as they do soil.</rdfs:comment>
        <rdfs:label>artisol test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14448 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14448">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enzyme activity attributed to cytochrome P-450 monooxygenase isoforms and often measured in units of benzo[a]pyrene hydroxylation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>AHH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unspecific mono-oxygenase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>aryl hydrocarbon hydroxylase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14448"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AHH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14449 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14449">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing the situation in which everything practicable is done to reduce risks to the minimum with the approval of the regulatory authorities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ALARA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>as low as reasonably achievable</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14943"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14449"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ALARA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14450 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14450">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of coexisting populations defined by phylogeny, location, or life style. Assemblages are intermediate between populations and communities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>An operational definition is &quot;species located in the same place at the same time&quot;.</rdfs:comment>
        <rdfs:label>assemblage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14451 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14451">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ecological property that is to be protected and the precise parameter to be measured for this property.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>assessment endpoint</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14836"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14452 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14452">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Commercially available test kit, certified by AFNOR as valid and equivalent to a standardized method.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>AFNOR test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Association Française de Normalisation test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14453 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14453">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a chemical at which some percentage of a population of test organisms is in a state of approximate homeostasis for a prolonged period of time (\(\pu{48 h}\) or more).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ATCN</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The asymptotic \(\pu{LC_{50}}\) is the concentration at which the \(\pu{LC_{50}}\) remains constant no matter how long exposure continues, i.e., there is no evidence of significantly increasing effects due to a longer exposure time.</rdfs:comment>
        <rdfs:comment>This can be demonstrated as the concentration at which the toxicity curve is approximately asymptotic (parallel) to the time axis.</rdfs:comment>
        <rdfs:label>asymptotic threshold concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14744"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14453"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ATCN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14454 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14454">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process that transfers a chemical from the atmosphere to the Earth’s surface (land, water, or vegetation) by either dry impingement or by transport in rain or snow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>deposition</oboInOwl:hasRelatedSynonym>
        <rdfs:label>atmospheric deposition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15135"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14456 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14456">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Floral and (or) or faunal communities attached to submerged surfaces in aquatic ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>aufwuchs</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14907"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14457 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14457">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequential appearance of species driven by processes operating within the community environment (compare allogenic succession), e.g., primary and secondary successions that occur on newly exposed land.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>autogenic succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14437"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14458 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14458">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that is independent of outside sources for organic food materials and manufactures its own organic material from inorganic sources.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>autotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14459 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14459">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequential appearance of species in a location principally involving plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>autotrophic succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14460 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14460">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Growth of organisms of a single species in the absence of cells or living organisms of any other species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>axenic culture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14461 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14461">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General, nonspecific, reversible mode of toxic action that can be produced in most living organisms by the presence of sufficient amounts of many organic chemicals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Effects result from the general disruption of cellular activity. The mechanism producing disruption is unknown, with the main theories being binding to proteins in cell membranes and &quot;swelling&quot; of the lipid portion of cell membranes resulting from the presence of organic chemicals.</rdfs:comment>
        <rdfs:comment>Hydrophobicity dominates the expression of baseline toxicity.</rdfs:comment>
        <rdfs:label>baseline toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14462 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14462">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Attributed to Thomas Bayes (1702–1761), English mathematician. The term is used to designate concepts relating to inverse probability, especially Bayes’ theorem, a theorem expressing the probability of one of a number of mutually exclusive events \(H_{\rm{i}}\), given some other event \(E\), in terms of the probabilities of all the \(H_{\rm{i}}\) independently of \(E\) and the probabilities of \(E\) given each \(H_{\rm{i}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Bayesian</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14463 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14463">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subjective or objective concept of probability as a &apos;measure of the state of knowledge&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Assessment of probability in Bayesian theory can be approached as, e.g., odds for one or the other result of a stochastic outcome. Modern machine learning methods are frequently based on Bayesian theory.</rdfs:comment>
        <rdfs:label>Bayesian probability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14464 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14464">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of behavioral abnormalities in otherwise apparently normal individuals after exposure in the embryonic state to a substance or physical agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>behavioural teratology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14465 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14465">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of abnormal behavior produced by exposure to a substance or physical agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>behavioural toxicology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14466 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14466">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Non-essential metal which in some form (chemical species) at an appropriate dose can improve health of defined organisms, commonly human beings.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>beneficial metal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14467 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14467">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Advantage to, or improvement in condition of, an individual, a population, a species, an assemblage, a community, or an ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>For risk/benefit comparisons, the probability of benefit is the appropriate comparator.</rdfs:comment>
        <rdfs:label>benefit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14450"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14544"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14468 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14468">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Living on the bottom of an aquatic system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>benthic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14469 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14469">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Able to come in contact with a living organism and perhaps interact with it with the possibility of absorption into the organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Contact with a living organism may not result in any interaction of the substance with, and absorption by, the organism. In other words, bioaccessibility is a necessary precursor of bioavailability but not, on its own, sufficient for bioavailability to occur.</rdfs:comment>
        <rdfs:label>bioaccessible</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14470 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14470">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Progressive increase in the amount of a substance in an organism or part of an organism that occurs because the rate of intake from all contributing sources and by all possible routes exceeds the organism’s ability to eliminate the substance from its body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>accumulation in biology</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Bioaccumulation of organic molecules usually correlates with lipophilicity. Bioaccumulation of metal ions tends to correlate with strong binding to biomolecules or incorporation into bone and teeth.</rdfs:comment>
        <rdfs:label>bioaccumulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14476"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14484"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14471 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14471">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of tissue chemical residue to chemical concentration in an external environmental phase (e.g., sediment, water, soil, air, or food). BAF is measured at a steady state in situations where organisms are exposed to multiple sources (e.g., water, sediment, food), unless noted otherwise.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>accumulation factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In relation to uptake from food, the concentration in the organism is typically expressed per unit body mass or per gram of lipid and the concentration in food is expressed per gram dry weight of food.</rdfs:comment>
        <rdfs:comment>The compound may have entered the organism by any available route and from any component of the water or sediment.</rdfs:comment>
        <rdfs:comment>The concentration in sediment may be expressed per gram dry weight of sediment or per gram of organic carbon and may be referred to as the biota-sediment accumulation factor (BSAF).</rdfs:comment>
        <rdfs:comment>The concentration in the organism is typically expressed per unit body mass or per gram of lipid (bioaccumulation factor, lipid-based).</rdfs:comment>
        <rdfs:label>bioaccumulation factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14472 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14472">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metabolic conversion of a xenobiotic to a more toxic derivative or to one that has more of an effect on living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>activation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bioactivation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14473 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14473">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Able to be absorbed by living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>available</oboInOwl:hasRelatedSynonym>
        <rdfs:label>bioavailable</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14469"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14474 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14474">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>All the interacting organisms living together in a specified habitat.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>biocoenosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>biological community</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>biotic community</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ecological community</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The area occupied by a biocenosis is defined by a characteristic assembly of species.</rdfs:comment>
        <rdfs:label>biocenosis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14450"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14475 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14475">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill living organisms. Nonagricultural pesticide used to control the severity and incidence of pests or diseases, e.g., algicide, slimicide, or disinfectant for the control of algal, fungal, or bacterial growth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biocide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14476 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14476">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process leading to a higher concentration of a substance in an organism than in environmental media to which it is exposed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Usually applied to uptake by aquatic organisms directly from water.</rdfs:comment>
        <rdfs:label>bioconcentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14470"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14477 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14477">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of the tendency for a substance in water to accumulate in aquatic organisms defined as the ratio of the concentration of the substance of concern in the organism to the concentration in water at equilibrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>BCF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The equilibrium concentration of a substance in an aquatic organism can be estimated by multiplying its concentration in the surrounding water by its BCF in that organism.</rdfs:comment>
        <rdfs:comment>This parameter is an important determinant for human intake of contaminants from water by ingestion of aquatic food.</rdfs:comment>
        <rdfs:label>bioconcentration factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BCF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14478 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14478">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the concentration of the substance of concern in the lipid fraction of the test organism to the concentration in the ambient water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lipid-based bioconcentration factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14438"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14479 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14479">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence of a number of species within a given ecosystem or biome, or the presence of a number of community types in a given area.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Biodiversity can be measured on many biological levels, but the term most commonly refers to the number of different species in a defined area (species richness) and is quantified by calculating a diversity index which takes into account the relative abundance of individuals of each species.</rdfs:comment>
        <rdfs:comment>Biodiversity is often a measure of the health of biological systems.</rdfs:comment>
        <rdfs:comment>In special cases, biodiversity may include a degree of genetic variation within a single species.</rdfs:comment>
        <rdfs:label>biodiversity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14489"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14599"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14480 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14480">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Internationally recognized program designed to protect and restore biological systems containing threatened species and habitats.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>BAP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The original impetus for these plans derives from the 1992 Convention on Biological Diversity (CBD).</rdfs:comment>
        <rdfs:comment>The principal elements of a BAP typically include: (a) preparing inventories of biological information for selected species or habitats; (b) assessing the conservation status of species within specified ecosystems; (c) creation of targets for conservation and restoration; and (d) establishing budgets, timelines, and institutional partnerships for implementing the BAP.</rdfs:comment>
        <rdfs:label>biodiversity action plan</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14480"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BAP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14481 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14481">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of elements or molecules among organisms and nonliving compartments of the atmosphere, lithosphere, and hydrosphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Examples of biogeochemical cycles are the carbon, nitrogen, phosphorus, and sulfur cycles. These are defined as the global flow of \(\ce{C}\), \(\ce{N}\), \(\ce{P}\), and \(\ce{S}\) atoms, respectively, from plants through animals to the atmosphere, soil, water, and back to plants.</rdfs:comment>
        <rdfs:comment>The water cycle refers to the global flow of water from surface and ground water sources to soil, plants, animals, and the atmosphere, and back to soil and surface water.</rdfs:comment>
        <rdfs:label>biogeochemical cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14482 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14482">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any biological species or group of species whose performance, abundance, or population status is used to determine the health of an environment or ecosystem by systematic monitoring of chemical, physiological, or behavioral changes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>bioindicator</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>indicator species</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Bioindicator is commonly misused as a synonym for the term biomarker. Such use is to be deprecated.</rdfs:comment>
        <rdfs:comment>Deviation of bioindicator performance indicates some adverse effect. In a wider sense, the number and abundance of different indicator species (biodiversity, species richness) is used to calculate biotic indices.</rdfs:comment>
        <rdfs:label>biological indicator</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14479"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14499"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14483 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14483">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Property of living organisms that affects human or environmental health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Biological determinants may be either endogenous or exogenous. Endogenous biological determinants include genetic characteristics and physiological state. Exogenous biological determinants are other living organisms with which the organisms of concern interact, e.g., beneficial or harmful microorganisms.</rdfs:comment>
        <rdfs:label>biological determinant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14484 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14484">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of processes by which higher concentrations of a substance are attained in organisms at higher trophic levels. Result of these processes of bioconcentration and bioaccumulation by which tissue concentrations of bioaccumulated chemicals increase as the chemical passes up through two or more trophic levels. Note: Biomagnification occurs in a food chain as a consequence of efficient transfer of a substance from food to consumer accompanied by the lack of, or very slow, excretion or degradation of the substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>bioamplification</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ecological magnification</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trophic enrichment</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biomagnification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14485 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14485">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of concentrations of a compound at two consecutive trophic levels at steady state. It can also be expressed in terms of a rate constant-based bioaccumulation model \[B = C_{n}/C_{n-1} = \alpha f/k_{\rm{e}}\] where \(\alpha\) is assimilation efficiency, \(f\) is feeding rate, and \(k_{\rm{e}}\) is the first-order elimination constant. \(B\) can be calculated from field data on assumed trophic relations or from laboratory feeding experiments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomagnification factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14484"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14486 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14486">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biomarker that, depending upon the magnitude, can be recognized as associated with an established or possible health impairment or disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>effect biomarker</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biomarker of effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14487 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14487">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biomarker that relates exposure to a xenobiotic to the levels of the substance or its metabolite, or of the product of an interaction between the substance and some target molecule or cell, that can be measured in a compartment within an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>exposure biomarker</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biomarker of exposure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14537"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14488 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14488">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biomarker of an inherent or acquired ability of an organism to respond to exposure to a specific substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>susceptibility biomarker</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biomarker of susceptibility</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14489 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14489">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of plants and animals that occupy a certain geographic area.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The term is usually applied to large areas occupied by climax communities arising as a result of interactions between biotic and abiotic factors,</rdfs:comment>
        <rdfs:label>biome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14528"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14490 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14490">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Alteration of the chemical or physical properties of a substance by the action of living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomodification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14491 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14491">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n. Organism that provides quantitative information on the quality of the environment around it.Note: The ideal substance biomonitor would indicate the presence of a specific pollutant and provide additional information about the amount present. v. To use organisms to monitor pollutants and to deduce possible effects on biota or routes of toxicant exposure to humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomonitor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14492 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14492">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of community changes along a gradient or among sites differing in levels of pollution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomonitoring type 1</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14493 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14493">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of bioaccumulation in organisms among sites notionally varying in the level of contamination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomonitoring type 2</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14470"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14494 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14494">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of effects on organisms using tools such as biochemical markers in sentinel species or some measure of diminished fitness or condition of individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomonitoring type 3</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14495 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14495">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of genetically based resistance in populations of contaminated areas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biomonitoring type 4</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14496 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14496">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological agent with pesticidal activity, e.g., the bacterium Bacillus thuringiensis when used to kill insects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biopesticide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14497 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14497">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of biological organisms such as plants or microbes to aid in removing hazardous substances from an area.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>bioremediation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14498 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14498">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of lipid-normalized tissue chemical residue to carbon-normalized sediment substance concentration (units of mass lipid/mass organic carbon).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>BSAF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>accumulation factor (AF)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bioavailability index (BI)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>biota-sediment factor (BSF)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>biota-sediment accumulation factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14471"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14498"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BSAF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14499 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14499">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One of several ranking systems calculated from the presence or abundance of sensitive species relative to tolerant species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Biotic indices measure decreased environmental quality from effects on especially sensitive species and should not be compared to diversity indices, which measure community structure.</rdfs:comment>
        <rdfs:label>biotic index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14536"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14599"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14500 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14500">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of a living organism to which an ion or other substance in aqueous solution can bind, usually with subsequent beneficial or harmful effect on the physiology of the organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biotic ligand</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14501 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14501">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model that integrates the interactions of metals with ligands in water to calculate the speciation (based on hardness, salinity, and presence of other metals) and the concentration of ionic species producing toxicity. The BLM chemically and mathematically models the organism’s target site as ligand(s) competing with nonbiotic ligands, based on the concept that toxicity occurs when a metal-(biotic ligand) complex reaches a critical concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>BLM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For fish, the biotic ligand for metal ions is either known or suspected to be the ion channel proteins in the gill surface that regulate the ionic composition of the blood. For other organisms, it is hypothesized that a biotic ligand exists and that mortality can be modeled in a similar way.</rdfs:comment>
        <rdfs:comment>The BLM is a development of the free ion activity model (FIAM) for calculating free metal ions in relation to water-borne ligands and the Windermere humic aqueous model (WHAM) for calculating metal speciation in relation to organic species in water.</rdfs:comment>
        <rdfs:comment>The model is a generalization of the FIAM. The difference between the BLM and the FIAM is the consideration of competitive binding at the biotic ligand, which models the protective effects of other metal cations, and the direct influence of \(\rm{pH}\).</rdfs:comment>
        <rdfs:label>biotic ligand model</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14501"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BLM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14502 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14502">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Weighted measurement of organisms present—the weighted part is determined by each group’s pollution tolerance or intolerance. As pollution increases in a stream, the biotic score value tends to increase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biotic score</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14503 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14503">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Habitat shared by many species, most often an area that is uniform in environmental conditions and in its distribution of animal and plant life.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biotope</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14504 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14504">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of processes whereby organisms affect the structure of sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Bioturbation consists of two processes, particle mixing and irrigation, mainly executed by infaunal organisms but also by epifaunal organisms and bottom-feeding fish.</rdfs:comment>
        <rdfs:label>bioturbation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14505 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14505">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model of adverse effect vs. dose relationship that, owing to hormesis, dips down from the control level before increasing with the dose; individuals exposed to low, but nontoxic concentrations are healthier than individuals not exposed to the chemical.Note: Biphasic dose–effect curves occur for any nutrient. Hormesis is a phenomenon associated with compounds that have no nutrient properties. Model of adverse effect vs. dose relationship that changes slope owing to a change in the mechanism of toxic action.Note: This may, e.g., be due to saturation of a transport or metabolic system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>biphasic dose–effect model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14601"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14745"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14506 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14506">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>(in demography) Number of live births in a defined administrative jurisdiction in a calendar year divided by a midyear population of the jurisdiction, with the customary multiplier of \(\pu{1000}\) to produce a whole number rather than a decimal or a fraction. Note: An alternative statistic is total fertility rate, the average number of children born to each woman over the course of her life. In general, the total fertility rate is a better indicator of fertility rates because, unlike the crude birth rate, it is not affected by the age distribution of the population. (in ecology) Number of births, \(B\), in a population of a defined size, \(N\), during a specified time interval \(\Delta t\). The rate is calculated from the formula \[B = \Delta N/\Delta t\] where \(\Delta N\) is the change in the number of births in a limited time period \(\Delta t\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>birth rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14904"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14507 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14507">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delayed damage from earlier environmental contamination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Sometimes stated as &quot;what you throw away can come back to hurt you&quot;.</rdfs:comment>
        <rdfs:label>boomerang effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14508 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14508">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metal ions intermediate in properties between class a and class b metal ions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>borderline metal ions</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14509 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14509">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at the suborganismal (cellular and biochemical) levels of organization rather than via the community and (or) ecosystem levels of organization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>bottom-up ecotoxicological study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15098"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14510 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14510">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative value for community species diversity calculated as \[H_{\rm{B}} = (\ln N! - \sum \ln n_{i}!)/N\] where \(N\) is the total number of individuals and \(n_{i}\) is the number of individuals in the \(i^{\rm{th}}\) species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Evenness for the Brillouin index is estimated as \(E = H_{\rm{B}}/H_{\rm{Bmax}}\) where \(H_{\rm{Bmax}}\) is the maximum possible Brillouin diversity which occurs when all species are equally abundant.</rdfs:comment>
        <rdfs:comment>When a subsample is taken from a given area, the Brillouin index provides a better estimate of diversity than the Shannon–Wiener index for samples of the same size. It also corresponds to situations of sampling without replacement, whereas the Shannon–Wiener index is appropriate for sampling with replacement.</rdfs:comment>
        <rdfs:label>Brillouin index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14599"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15031"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14511 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14511">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adult fish producing either eggs or sperm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>broodstock</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14512 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14512">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any pathological condition characterized by the deposition of calcium salts in tissues.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>calcinosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14513 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14513">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tissue such as arthropod cuticle, bivalve shell, or vertebrate bone that renders calcium or elements with similar biological behavior (such as lead or cadmium) less bioavailable during trophic interactions, thus providing a mechanism for trophic dilution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>calcium sink</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14514 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14514">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum population size expressed as total number of individuals, biomass, or population density that a given unit of habitat is capable of sustaining.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>carrying capacity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14515 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14515">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing a species exhibiting catadromy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>catadromous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14516"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14516 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14516">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Life-history pattern that is characterized by egg incubation and early juvenile development in seawater, migration to freshwater for adult development, and return to seawater for spawning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Obligatory catadromy is the term applied where migration to freshwater is required for survival.</rdfs:comment>
        <rdfs:label>catadromy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14441"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14517 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14517">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Long-term geochemical alteration to organic matter, involving high temperatures and pressures deep below the surface of the Earth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>catagenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14518 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14518">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Whales, dolphins, and porpoises, in the order Cetacea.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>cetaceans</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14519 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14519">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Series of reactions by which ozone is formed in the stratosphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Chapman mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14520 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14520">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance or substances in a component of the environment which are not currently bioavailable but which may become bioavailable at an unknown time in the future with harmful consequences.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>chemical time bomb</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14473"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14521 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14521">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specialized cell with a role in ion regulation, characterized by large numbers of mitochondria, an extensive intracellular tubular network and a high concentration of \(\ce{Na+}\)/\(\ce{K+}\) ATPase. This cell is found in salt-secreting glands like the rectal gland of elasmobranchs, the nasal gland of seabirds, and the gills of both seawater and freshwater fish, mainly on the primary lamellae but also on the secondary lamellae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>chloride cell</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14522 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14522">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion by mass of dissolved chloride ions in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>chlorinity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14523 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14523">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Carbon-based chemical containing chlorine and fluorine, responsible for ozone depletion in the stratosphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>CFC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Formerly commonly used as aerosol propellants and refrigeration coolants, but now prohibited in many countries.</rdfs:comment>
        <rdfs:label>chlorofluorocarbon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14863"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14523"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CFC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14524 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14524">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consequence that develops slowly and (or) has a long-lasting course: may be applied to an effect which develops rapidly and is long lasting.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>long-term effect</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chronic effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14421"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14525 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14525">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of green color in plants owing to the lack of production or the destruction of chlorophyll.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>chlorosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14526 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14526">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systematic classification of groups of organisms on the basis of shared characteristics thought to derive from a common ancestor. Also, the study of the branching of evolutionary lines of descent and the relationship between branches.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>cladistics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14527 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14527">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dendrogram illustrating the supposed evolutionary relationships between clades; a diagram showing cladistic relationships.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>evolutionary tree</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>phylogenetic tree</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Cladograms are often based on such information as the number of differences in amino acids or nucleic acid bases in common proteins or genes, respectively. From estimated mutation rates, the evolutionary time can be estimated. Accordingly, cladograms have two components, branching order (showing group relationships) and branch length (showing extent of evolution).</rdfs:comment>
        <rdfs:label>cladogram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14528 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14528">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Community of plants and animals in a steady state due to ecological succession resulting in a composition of the community best adapted to average conditions in the area. The term is sometimes applied to soil development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>climax community</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14529 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14529">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that pollutants with high vapor pressure, e.g., mercury or persistent organic pollutants (POPs), in the air will condense onto soil, water, and biota at cool temperatures. Consequently, the ratios for POP concentrations in the air and on condensed phases decrease as one moves from warmer to cooler climates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>cold condensation theory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14530 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14530">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microbial transformation of a compound (that is normally unable to support cell replication) in the requisite presence of a transformable cosubstrate that supports cell replication.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The mechanisms of cometabolism considered likely in most cases involve an enzyme or enzymes that change the substrate to a product or products not further transformed by other enzymes (dead-end metabolites).</rdfs:comment>
        <rdfs:label>cometabolism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14552"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14565"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15022"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14531 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14531">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assembly of populations of different species of living organisms, usually interdependent on and interacting with each other, within a specified location in space and time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>biocommunity</oboInOwl:hasRelatedSynonym>
        <rdfs:label>community</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14532 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14532">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that ecological communities retain information about events in their history and will not return to their original state after perturbation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This hypothesis was derived from the concept of nonequilibrium community ecology and was developed as a framework for understanding the persistence of dose-related responses in multispecies toxicity tests.</rdfs:comment>
        <rdfs:label>community conditioning hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14533 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14533">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tendency of a community to return to its original state after a disturbance (competition, temporarily changing environment, etc.).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>community stability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14534 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14534">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a community to return to its former state after perturbation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ecological resilience</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A community with high resilience will return to its original state faster than one with low resilience.</rdfs:comment>
        <rdfs:label>community resilience</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14535 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14535">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a community to avoid displacement from its present state by a disturbance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>community resistance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14536 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14536">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Species present in a community and their relative abundances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>community structure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14537 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14537">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Conceptualized part of the body (organs, tissues, cells, or fluids) considered as an independent system for purposes of modeling and assessment of distribution and clearance of a substance. Part of an ecosystem considered as an independent system for purposes of assessment of uptake, distribution, and dissipation of a substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>compartment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14538 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14538">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outcompetition from a niche of one species by another that uses the available resources of the niche more efficiently, eventually resulting in the exclusion of the outcompeted species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>competitive exclusion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14539 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14539">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Niches where coexisting species occupy a similar position along one niche dimension, e.g., altitude, but differ along another, e.g., diet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>complimentary niches</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14540 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14540">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graph of the relation between exposure concentration and the proportion of individuals in a population responding with a defined effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>exposure–response curve</oboInOwl:hasRelatedSynonym>
        <rdfs:label>concentration–response curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14541 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14541">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Linkage and interrelationship of assessment endpoint(s) and stressors.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Conceptual models include hypotheses of risk and a diagram of the conceptual model.</rdfs:comment>
        <rdfs:comment>Establishing this includes evaluation of potential exposure pathways, effects, and ecological receptors.</rdfs:comment>
        <rdfs:label>conceptual model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14542 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14542">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Figure showing pathways of exposure of organisms and illustrating areas of uncertainty or concern.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>conceptual model diagram</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14543 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14543">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Integration of information on contaminants of potential concern (COPCs), ecological resources, evaluated exposure routes, fate and transport mechanisms, evaluated COPC toxicity, identified assessment endpoints, and risk questions and hypotheses, into a description of all that is known and (or) expected about a contaminated site.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>CSM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>conceptual site model</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14543"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CSM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14544 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14544">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of health determining potential for reproduction and growth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Mainly used in fish, mussel, and oyster ecology.</rdfs:comment>
        <rdfs:label>condition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14545 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14545">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parameter used to describe growth in fish. It reflects real growth and nutritional status better than simple measurement of body mass.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The condition factor, \(K\), is calculated from the following equation: \[K = m/l^{3}\] with mass, \(m\) and length \(l\) of the fish. The usual units are \(\pu{g cm-3}\).</rdfs:comment>
        <rdfs:label>condition factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14546 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14546">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any quantitative measure of the condition in relation to a defined baseline.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>In mussels, various shell indexes (volume/length, mass/length), glycogen concentration (w/bw), or relative organ mass are used.</rdfs:comment>
        <rdfs:label>condition index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14544"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14547 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14547">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science applied to the conservation of genes, populations, species, and ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This science is concerned with the phenomena that affect the maintenance, loss, and restoration of biological diversity.</rdfs:comment>
        <rdfs:label>conservation biology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14548 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14548">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science of analyzing and protecting the Earth’s biological diversity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Conservation ecology is based on the biological, physical, and social sciences, economics, and the practice of natural-resource management. It concentrates on population dynamics issues associated with the small population sizes of rare species (e.g., minimum viable populations).</rdfs:comment>
        <rdfs:label>conservation ecology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14859"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14936"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14549 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14549">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minor impurity present in a substance. Extraneous material inadvertently added to a sample prior to or during chemical or biological analysis. In some contexts, as in relation to gas cleaning equipment, used as a synonym for &apos;pollutant&apos;, especially on a small scale. Unintended component in food that may pose a hazard to the consumer. Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium, even without adverse effects being observed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>contaminant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14550 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14550">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change that can be measured on a continuum from zero (or even a negative value) to positive values such as growth and reproduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>continuous effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14551 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14551">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Treatment in a toxicity test that duplicates all the conditions of the exposure treatments but contains no test material, in order to determine the absence of toxicity under basic test conditions (e.g., health of test organisms, quality of dilution water).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>control</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14552 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14552">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cometabolism whereby growing microorganisms oxidize a compound without using either carbon or energy derived from the oxidation of that compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>cooxidation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14530"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14553 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14553">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minute marine or freshwater crustacean, usually having six pairs of limbs on the thorax; some are abundant in plankton and others are parasitic on fish, marine mammals, and macro-invertebrates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>copepod</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14554 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14554">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n. Substance having the capability or tendency to cause slow destruction. adj. Gradually destructive; steadily harmful.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>corrosive</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14555 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14555">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure for determining the relationship of the expected benefits of a proposed action to the expected costs in order to decide whether the action provides the best option for the investment of limited resources.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>CBA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cost–benefit analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14556"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14555"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CBA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14556 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14556">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Procedure for determining whether the expected beneficial effects of a defined course of action justify the cost when selecting among competing options for the use of limited resources.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Mainly used for comparing the relative value of various clinical strategies.</rdfs:comment>
        <rdfs:label>cost-effectiveness analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14555"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14557 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14557">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abrupt, periodic reversal of water flow over the gills that dislodges and eliminates excess mucus from the gills’ surfaces.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>gill purge</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cough</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14558 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14558">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Whole-body concentration of a chemical that is associated with a given adverse biological response.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>CBR</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This assumes each organism is a single compartment, rather than multiple compartments as in reality. It has utility as a first approximation of dose.</rdfs:comment>
        <rdfs:label>critical body residue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14558"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CBR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14559 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14559">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxicity testing focused on the species life stage thought to be the most sensitive to the toxicant, such as newly hatched individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>critical life-stage testing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14560 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14560">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition in which enhanced tolerance to one toxicant also enhances tolerance to another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>cotolerance</oboInOwl:hasRelatedSynonym>
        <rdfs:label>cross-resistance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14561 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14561">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>n. Stock of healthy cells, tissue, microorganisms, or plants raised under well-defined and controlled conditions. v. To maintain a stock of healthy organisms under well-defined and controlled conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>culture</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total dose resulting from repeated exposures or continuous exposure over a defined time to a substance or to radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>cumulative dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14563 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14563">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total exposure resulting from repeated and continuous exposure over a defined time to a substance or to radiation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>cumulative exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14564 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14564">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small, mostly planktonic, crustaceans, between \(\pu{0.2 mm}\) and \(\pu{5 mm}\) in length.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Daphnia are members of the order Cladocera, and are one of the several small aquatic crustaceans commonly called water fleas because of their saltatory swimming style (although fleas are insects and thus only very distantly related). Daphnia spp. live in various aquatic environments ranging from acidic swamps to freshwater lakes, ponds, streams, and rivers.</rdfs:comment>
        <rdfs:comment>Toxicity tests on Daphnia are required by most regulatory authorities. The results are often interpreted as applicable by extrapolation to the protection of all crustaceans.</rdfs:comment>
        <rdfs:label>Daphnia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14565 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14565">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance formed by a microbe’s metabolism of a substrate (most often during cometabolism) that cannot be further metabolized by that organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Dead-end metabolites may be further metabolized by coexisting organisms.</rdfs:comment>
        <rdfs:label>dead-end metabolite</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14530"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14566 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14566">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In assessing population ecology, death of an individual is loss of the ability to reproduce.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>death</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14760"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14567 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14567">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Irreversible cessation of all vital functions of an organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>death</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14568 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14568">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of deaths \(D\) in a closed population of size \(N\) during a specified time interval, \(\Delta t\). The rate is calculated from the formula \[D = -\Delta N/\Delta t\] where \(\Delta N\) is the change in number of deaths over a specified time period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>death rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14569 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14569">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chlorinated water (usually municipal drinking water) that has been treated to remove chlorine and chlorinated compounds from solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dechlorinated water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14570 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14570">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that breaks down dead matter or wastes of other organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>decomposer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14571 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14571">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used for removal of leaves by its toxic action on living plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>defoliant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14572 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14572">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variability in population growth rates arising from random differences among individuals in survival and reproduction within a season.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Such variability is important only in populations that are fairly small.</rdfs:comment>
        <rdfs:label>demographic stochasticity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14573 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14573">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of populations, especially their age structure and growth rates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>demography</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14574 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14574">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variation in characteristics of individuals or of a population produced by changes in the density of the population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Density dependence may be seen in mortality rate, birth rate, fítness, sensitivity to environmental toxins, transmission of pathogens, and parasites, etc.</rdfs:comment>
        <rdfs:label>density dependence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14575 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14575">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal that feeds on particles of matter in the soil or sediment, usually the top soil or sediment where it is filled with organic matter. Feeding takes place either by ingesting soil or sediment or by trapping particles as they fall.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>deposit feeder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14576 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14576">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of a substance from an organism owing to elimination and degradation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>depuration time</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The rate of depuration is expressed by its half life or the time needed to eliminate \(\pu{50\%}\) of the substance in a noncontaminated medium. This term is often referred to as the depuration time (\(\pu{DT_{50}}\)).</rdfs:comment>
        <rdfs:label>depuration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14577 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14577">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Predicted property of a substance that is dependent upon, or is an approximation of, a fundamental property and the prevailing environmental conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>derived characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14578 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14578">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term applied to effects, of which the extent varies with the dose and for which a threshold is believed to exist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>deterministic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14579 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14579">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Detailed study in which all population and environmental parameters are assumed to be constant and accurately specified.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>deterministic analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14580 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14580">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mathematical model that is fully specified and does not include a stochastic component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>deterministic model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14581 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14581">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organic debris from decomposing plants and animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>detritus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14582 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14582">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing an organism that survives by eating detritus.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>detrivorous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14581"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14583 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14583">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reference dose determined for developmental consequences of a single, maternal exposure during development.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>developmental reference dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14584 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14584">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Potential of an organism to develop into a consistent phenotype in an environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>developmental stability</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14585 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14585">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Member of a major group of eukaryotic algae, among the most common types of phytoplankton. Unicellular, some form chains or simple colonies. Diatom cells are encased in a frustule, of widely diverse form, made of silica (hydrated silicon dioxide).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>diatom</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14586 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14586">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release into the environment from multiple sources covering a wide area as opposed to point source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>diffuse source</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14927"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14587 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14587">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Belief that pollution is alleviated by dilution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Sometimes stated as &quot;The solution to pollution is dilution.&quot;</rdfs:comment>
        <rdfs:label>dilution paradigm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14588 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14588">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water used to dilute the test material in an aquatic toxicity test in order to prepare either different concentrations of a test chemical or different percentages of an effluent for the various test treatments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>diluent</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The water (negative) control in a test is prepared with dilution water only.</rdfs:comment>
        <rdfs:label>dilution water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14589 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14589">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Effect where a stressor acts immediately on an ecological component of interest and not through the consequences of effects on other components of the ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>direct ecological effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14590 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14590">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deviation within a population from a mean of zero for the difference between a trait measured from the right and left sides of bilaterally symmetrical individuals from that population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>directional asymmetry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14444"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14696"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14591 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14591">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxicity that results from, and is readily attributable to, substances acting at the sites of toxic action in and (or) on the exposed organisms that are exhibiting the adverse biological response in question.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>direct toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14592 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14592">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release of any waste into the environment from a point source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Usually applied to release of liquid waste into water but may be applied to release to air.</rdfs:comment>
        <rdfs:label>discharge</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14593 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14593">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio measuring the degree of isotopic discrimination, with a ratio of 1 indicating no discrimination.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>discrimination factor</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In the context of discrimination between elements such as cesium and potassium in a trophic exchange, a discrimination factor or ratio is expressed as \([\ce{Cs}]_{\rm{food}}/[\ce{K}]_{\rm{food}}\) divided by \([\ce{Cs}]_{\rm{body}}/[\ce{K}]_{\rm{body}}\).</rdfs:comment>
        <rdfs:label>discrimination ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14777"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14594 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14594">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance used to disperse liquid spills, e.g., oil spills in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dispersant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14595 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14595">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount concentration of carbon found dissolved in water samples from aquatic systems, measured as total elemental carbon.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>DOC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>DOC is important in the transport and bioavailability of pollutants in aquatic systems.</rdfs:comment>
        <rdfs:comment>Metals may form strong complexes with DOC, increasing metal solubility and concentration in water, while also reducing metal bioavailability.</rdfs:comment>
        <rdfs:comment>The &quot;dissolved&quot; fraction of organic carbon is an operational classification. Operationally, DOC is defined as the organic matter that is able to pass through a defined filter (filters generally range in size between \(\pu{0.7 \upmu m}\) and \(\pu{0.22 \upmu m}\)). Conversely, particulate organic carbon (POC) in water is that carbon that is too large and is filtered out of a sample.</rdfs:comment>
        <rdfs:comment>The DOC in marine and freshwater systems is part of the greatest cycled reservoir of organic matter on Earth and consists mostly of humic substances.</rdfs:comment>
        <rdfs:label>dissolved organic carbon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14597"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DOC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14596 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14596">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount concentration of oxygen dissolved in water at a particular temperature and pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>DOC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This can be a limiting factor on the growth of aquatic populations.</rdfs:comment>
        <rdfs:label>dissolved oxygen content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DOC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14597 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14597">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Analogous to dissolved organic carbon, but refers to the entire organic pool dissolved in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>DOM</oboInOwl:hasRelatedSynonym>
        <rdfs:label>dissolved organic matter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14595"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DOM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14598 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14598">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Event that introduces, removes, or redistributes organisms, changing the colonization potential of a given environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>disturbance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14599 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14599">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mathematical descriptor of species variation within a community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>All diversity indices are based on the relative abundance of a species, i.e., the sum of all individuals of that species divided by the sum of all individuals in the community of interest.</rdfs:comment>
        <rdfs:label>diversity index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14510"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15031"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15034"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14600 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14600">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relation between dose and the magnitude of a measured biological change.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dose–effect</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14601 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14601">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graph of the relation between dose and the magnitude of the biological change produced measured in appropriate units.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dose–effect curve</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14602 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14602">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Association between dose and the resulting magnitude of a continuously graded change, either in an individual or in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dose–effect relationship</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14603 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14603">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graph of the relation between dose and the proportion of individuals in a population responding with a defined biological effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dose–response curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14604 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14604">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Association between dose and the incidence of a defined biological effect in an exposed population usually expressed as percentage.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dose–response relationship</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14605 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14605">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of land where water from rain or snow melt drains downhill into a body of water, such as a river, lake, dam, estuary, wetland, sea, or ocean.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>catchment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>catchment area</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>catchment basin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>drainage area</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>river basin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>water basin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>watershed</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A drainage basin acts like a funnel, collecting all the water within the area covered by the basin and channeling it into a waterway. Each drainage basin is separated topographically from adjacent basins by a ridge, hill, or mountain, which is known as a water divide.</rdfs:comment>
        <rdfs:comment>A drainage basin includes the streams and rivers that convey the water as well as the land surfaces from which water drains into those channels, separated from adjacent basins by a drainage divide.</rdfs:comment>
        <rdfs:label>drainage basin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14661"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15136"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14606 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14606">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that simple quantitative rules may be applied to define the organization of metabolism of individual organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>DEB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DEB theory</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>&quot;Dynamic&quot; refers to changes in energy budgets in relation to individual life cycle. The theory includes stoichiometric constraints and mass balance equations, allometric relationships, organizational uncoupling of metabolic modules, strong and weak homeostasis, and partionability of reserve kinetics.</rdfs:comment>
        <rdfs:comment>In relation to ecotoxicology, effects of toxicants on energy allocation have been modeled by Kooijman and Bedaux.</rdfs:comment>
        <rdfs:label>dynamic energy budget theory</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DEB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14607 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14607">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Community that is stable for only a very limited range of environmental characteristics, e.g., a stable and predictable environment with respect to predator–prey ratios or disturbances caused by humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dynamically fragile community</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14608 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14608">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Community that is stable within a wide range of conditions, e.g., in very variable and unpredictable environments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dynamically robust community</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14609 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14609">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that long food chains are less stable than short food chains.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>dynamic stability hypothesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14610 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14610">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Branch of biology that studies the interactions between living organisms and all factors (including other organisms) in their environment. Such interactions encompass environmental factors that determine the distributions of living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14611 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14611">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sum of biological, physical, and chemical components of an ecosystem and their interactions that maintain the ecosystem and its products, functions, and attributes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecological character</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14612 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14612">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the flow of energy within an ecological system from the time the energy enters the living system until it is irretrievably lost from the system as heat.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>It is also referred to as production ecology, because ecologists use the word &quot;production&quot; to describe the process of energy input and storage in ecosystems.</rdfs:comment>
        <rdfs:label>ecological energetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14613 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14613">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Application of epidemiological methods to determine the cause, incidence, prevalence, and distribution of adverse effects in nonhuman species inhabiting contaminated sites; it is frequently associated with retrospective ecological risk assessment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecological epidemiology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14995"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14614 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14614">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in any biological, physical, or chemical components of an ecosystem, or in their interactions, which result in change in ecological character and its functions and attributes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecological imbalance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15050"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14615 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14615">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxicant-related diminution of fitness of an individual functioning within an ecosystem that is of a magnitude sufficient to be equivalent to somatic death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ecological death</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This concept implies that an individual organism may be so incapacitated by an environmental change that, though still alive, its contribution to the ecosystem becomes negligible.</rdfs:comment>
        <rdfs:label>ecological mortality</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14616 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14616">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurable variable whose value is a determinant of the characteristics of an ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecological parameter</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14617 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14617">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of physiology and tolerance limits of species that enhances understanding of their distribution in relation to abiotic conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecophysiology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14618 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14618">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any of a number of regions into which a continent, country, etc., can be divided according to their distinct environmental conditions and habitat types. Large area of land or water with a characteristic, geographically distinct assemblage of natural communities and species comprising a recurring pattern of ecosystems associated with characteristic combinations of soil and landform.Note: The biodiversity of ecosystems in an ecoregion is often distinct from that of other ecoregions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>bioregion</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ecoregion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14479"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14619 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14619">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Grouping of organisms (microorganisms, plants, animals) interacting together, with and through their physical and chemical environments, to form a functional entity within a defined environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14620 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14620">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of gradual transition between two or more ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>ecotone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14624"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14621 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14621">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a pesticide (active ingredient, formulations, and relevant metabolites) that is likely to affect a determinable ecological characteristic of an exposed system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ERC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>environmentally relevant concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ecotoxicologically relevant concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14621"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ERC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14622 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14622">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to the soil.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>edaphic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14623 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14623">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement in a current of water or air, that is contrary to the direction of the main current, especially in a circular motion, leading to irregularity in the motion of molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>eddy motion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14624 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14624">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Influence of the closeness of contrasting environments on an ecosystem, seen at boundaries between natural habitats, especially forests, and disturbed or developed land.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Ecotones often have species assemblages with high species richness (\(S\)) and high abundance of individuals relative to those of the adjacent communities.</rdfs:comment>
        <rdfs:comment>Edge effects lead to changes in species richness and population size at the boundary between two communities, most pronounced in small habitat fragments where they may extend throughout the patch.</rdfs:comment>
        <rdfs:label>edge effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14625 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14625">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time taken for a substance to produce a precisely defined effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ET</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>\(\pu{ET_{50}}\) is the median time it takes for a toxicant to produce a precisely defined effect in \(\pu{50\%}\) of a population.</rdfs:comment>
        <rdfs:label>effect time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14625"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14626 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14626">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of risk assessment concerned with quantifying the manner in which the frequency and intensity of effects increase with increasing exposure to a contaminant or other source of stress (also known as dose–response assessment or toxicity assessment).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>effects assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14627 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14627">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a community to return to its prestressed condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>community elasticity</oboInOwl:hasRelatedSynonym>
        <rdfs:label>elasticity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14628 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14628">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aqueous solution obtained after adding water to a solid substance (e.g., sediment, tailings, drilling mud, or dredging spoil), shaking the mixture, then centrifuging or filtering it or decanting the supernatant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>An operational definition is water collected from vigorous shaking (\(\pu{15 min}\) to \(\pu{30 min}\)) of one part sediment with four parts water. This mixture is allowed to settle, and the liquid phase is centrifuged and may be filtered.</rdfs:comment>
        <rdfs:label>elutriate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14629 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14629">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test in which a nonbenthic species, such as Daphnia magna, is exposed to an elutriate produced by mixing test sediment with water and then centrifuging the mixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The elutriate test was developed for evaluating the potential effects of disposing of dredged material in open water. Analyses of elutriate samples measure the water-soluble constituents potentially released from sediment to the water column during dredge disposal operations</rdfs:comment>
        <rdfs:label>elutriate test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14630 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14630">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>New properties emerging with upward steps in hierarchical systems, such as ecological communities or ecosystems, that cannot be predicted solely from our limited understanding of the system’s parts or components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Such properties arise during the self-organization of complex systems and are the product of the evolution of these systems.</rdfs:comment>
        <rdfs:label>emergent properties</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14631 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14631">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative limit on the emission or discharge of a substance from a source, usually expressed in terms of a time-weighted average concentration or a ceiling value.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>emission standard</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14632 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14632">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pertaining to a species found in a discrete geographical unit, such as an island, habitat type, or other defined area or zone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>endemic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14633 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14633">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ecological state of being unique to a place.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>There are two subcategories of endemism-paleoendemism and neoendemism. Paleoendemism refers to a species that was formerly widespread but is now restricted to a smaller area. Neoendemism refers to a species that has recently arisen, e.g., by hybridization (see  and is now classified as a separate species. This is a common process in plants especially those that exhibit polyploidy.</rdfs:comment>
        <rdfs:label>endemism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14634 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14634">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>&apos;Warm-blooded organism&apos; that regulates its body temperature to be (almost) constant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>endotherm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14635 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14635">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Objective of measurement of a toxicity test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Endpoints vary with the level of biological organization being examined and may include changes in biochemical markers or enzyme activities, mortality or survival, growth, reproduction, primary production, and changes in structure, abundance, and function in a community. Endpoints are used as criteria for toxicity.</rdfs:comment>
        <rdfs:label>endpoint</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14636 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14636">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative or quantifiable expression of the environmental value considered to be at risk in a risk analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>endpoint assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14637 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14637">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Short, preliminary assessment of potential environmental harm used to determine if a full environmental impact statement (EIS) is required.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>environmental assessment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14643"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14637"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14638 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14638">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of the total amount of a substance present in the environment that is involved in a particular process and is subject to physicochemical and biological modifying influences.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental availability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14639"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14639 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14639">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of uptake clearance to the rate at which an organism encounters a given contaminant in an environmental medium (e.g., soil, sediment, water, food) being processed by the organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This is a measure of an organism’s extraction efficiency, via respiratory, dietary, and surface absorption processes, from the environmentally available (bioaccessible) portion of a material.</rdfs:comment>
        <rdfs:label>environmental bioavailability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14469"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14640 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14640">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Subdiscipline of human epidemiology concerned with diseases caused by chemical or physical agents in the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental epidemiology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14641 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14641">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Destiny of a chemical or biological pollutant after release into the natural environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental fate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14642 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14642">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Appraisal of the possible environmental consequences of a past, ongoing, or planned action, resulting in the production of an environmental impact statement or &apos;finding of no significant impact&apos; (FONSI).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EIA</oboInOwl:hasRelatedSynonym>
        <rdfs:label>environmental impact assessment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14642"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EIA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14643 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14643">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Report resulting from an environmental impact assessment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EIS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>environmental impact statement</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14642"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14643"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EIS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14644 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14644">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Overall state to be aimed for in a particular aspect of the natural environment, for example, &apos;water in an estuary such that shellfish populations survive in good health&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EQO</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Unlike an environmental quality standard, the EQO is usually expressed in qualitative and not quantitative terms.</rdfs:comment>
        <rdfs:label>environmental quality objective</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14644"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EQO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14645 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14645">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount concentration or mass concentration of a substance that should not be exceeded in an environmental system, often expressed as a time-weighted average measurement over a defined period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EQS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ambient standard</oboInOwl:hasRelatedSynonym>
        <rdfs:label>environmental quality standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14800"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14645"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EQS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14646 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14646">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of the probability of adverse effects on humans and other biota resulting from an environmental hazard (a chemical, physical, or biological agent occurring in or mediated by the environment).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental risk analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14647 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14647">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the probability that harm will result from a defined exposure to a substance in an environmental medium. The estimate is valid only for a given species and set of conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental risk assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14648 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14648">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>United Nations concept, defined as the relative stability of Earth’s natural ecosystems against human activity, most notably  global climate change caused by human release of greenhouse gas; deforestation caused by so-called &apos;clearing&apos; of lands; or soil depletion and desertification caused by intensive monoculture techniques.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental security</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14649 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14649">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical transformation of a substance resulting from interactions in the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental transformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14650 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14650">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of contaminants from their point of release through the various compartments to locations where exposure is assumed to occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>environmental transport</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14537"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14651 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14651">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Present in a community or among a group of animals; term applied to a disease prevailing continually in a region.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>enzootic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14652 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14652">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Living on the bed of an aquatic system, normally on sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>epibenthic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14653 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14653">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animals that live on the surface of soil or of the bed of an aquatic system, normally on sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>epifauna</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14765"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14654 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14654">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Discontinuous.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>episodic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14655 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14655">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outbreak of disease in a population or in a large number of individuals of a species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>epizootic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14656 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14656">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of a system in which the macroscopic properties of the system become uniform and independent of time. If the temperature is uniform throughout the system, a state of thermal equilibrium has been reached; if the pressure is uniform, a state of hydrostatic equilibrium has been reached; and if the chemical potential of each component is uniform, a state of chemical equilibrium has been reached. If all these quantities become uniform, the system is said to be in a state of complete thermodynamic equilibrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Complete thermodynamic equilibrium can be expressed in many ways, depending on which variables are of interest. For solubility purposes, the important variables are \(T\), \(p\) and the chemical potentials \(\mu_{i}\) of the \(C\) components. Equilibrium conditions involving these variables may be obtained by the condition that the variation of the Gibbs energy, expressed in terms of \(T\), \(p\) and the amount of substance \(n_{i}\) of the \(C\) components, is zero, \(\updelta G(T,p,n_{i}) = 0\), i.e., the Gibbs energy is a minimum. If the variation is negative, an irreversible change of the system can occur.</rdfs:comment>
        <rdfs:comment>Solubility equilibrium is an example of a state of complete thermodynamic equilibrium. For example, a saturated solution of a solid in a liquid at a fixed temperature and pressure is in a state of complete thermodynamic equilibrium. If the system is subjected to a small increase in temperature, a small portion of solid will dissolve to restore the equilibrium (if the solubility increases with temperature), while if there is a small decrease in temperature, a small portion of solid will precipitate. This is the basis for determining accurate values of solubility by approaching the equilibrium solubility from both supersaturation and undersaturation directions.</rdfs:comment>
        <rdfs:label>equilibrium</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14657 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14657">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tendency for a substance to achieve the same fugacity (chemical activity) in different compartments of a complex system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EqP</oboInOwl:hasRelatedSynonym>
        <rdfs:label>equilibrium partitioning</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14657"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EqP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14658 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14658">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to estimating the fate of chemicals in the aquatic environment that is based on equilibrium partitioning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>EqP approach</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The EqP approach is often exploited (primarily for organics), for interpretation and extrapolation purposes, by normalizing chemical concentrations based on the lipid content of the aquatic organisms and the organic carbon content of the sediments. These normalized biota-sediment accumulation factor (BSAF) values are considered to be independent of particular sediments and species.</rdfs:comment>
        <rdfs:label>equilibrium partitioning approach</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14498"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14657"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14659 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14659">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that is absolutely required for the normal growth and development of a defined organism throughout a complete life cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>essential element</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>essential metal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nutrient</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>According to criteria of essentiality suggested by Arnon and Stout, a nutrient can be called essential if: (i) its deficiency makes it impossible for an organism to complete its life cycle; (ii) its deficiency is specific to the element in question and can be corrected only by supplying this element; and (iii) the nutrient is directly involved in the organism’s nutrition.</rdfs:comment>
        <rdfs:comment>It has been suggested that an element should be considered essential if its addition enhances growth or if it can substitute for one of the elements that satisfy the criteria of Arnon and Stout. It has also been suggested that three other elements, which do not satisfy the criteria for many plant species but contribute indirectly to their survival, should be classified as essential. These elements are nickel (urea transformations), cobalt (\(\ce{N2}\) fixation), and silicon.</rdfs:comment>
        <rdfs:comment>Related terms are &quot;essential element&quot; and &quot;essential metal&quot;, which may be given the same definition, simply by substituting &quot;element&quot; or &quot;metal&quot; for nutrient.</rdfs:comment>
        <rdfs:comment>The term is often used misleadingly since it is meaningless unless accompanied by a statement of which organisms show a requirement for the nutrient.</rdfs:comment>
        <rdfs:label>essential nutrient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14660 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14660">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Belonging to an estuary.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>estuarine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14661"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14661 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14661">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>(general) Tidal opening, an inlet, or creek through which the tide enters; an arm of the sea indenting the land. Rare in modern use. (specific) Tidal mouth of a great river, where the tide meets the current of freshwater. Note 1: An estuary is a semi-enclosed coastal body of water with a free connection to the open sea made up of brackish water, typically the tidal mouth of rivers, often associated with sedimentation of material from terrestrial runoff. Note 2: An estuary is often associated with a high rate of biological productivity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>estuary</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14662 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14662">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Factor contributing to the cause of a disease.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>etiological agent</oboInOwl:hasRelatedSynonym>
        <rdfs:label>etiologic agent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14663 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14663">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation used to estimate the intrinsic rate of increase from life-table data.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Euler–Lotka equation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14664 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14664">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing an environment having a high concentration of nutrients. Note: The term is usually used to describe nutrient-rich bodies of water or soil having a high or excessive rate of biological production. In medicine, tending to promote nutrition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>eutrophic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14893"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14665 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14665">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process producing a high concentration of nutrient salts and a high or excessive rate of biological production in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Usually involves depletion of the oxygen content caused by decay of organic matter resulting from high primary production as a result of enhanced input of nutrients.</rdfs:comment>
        <rdfs:label>eutrophication</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14666 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14666">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of being eutrophic. (in medicine) Good nutrition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>eutrophy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14894"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14667 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14667">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transformation of animals, plants, and other living organisms into different forms by the accumulation of changes over successive generations. Transmutation of species. Origination or transformation of an organism, organ, physiological process, biological molecule, etc., by a series of changes. Note: The theory of evolution (in general) is the proposition that all living organisms have undergone a process of alteration and diversification from simple primordial forms during the Earth’s history; (in particular) it is a scientific theory proposing a mechanism for this process, now especially that based on Darwin’s theory of the natural selection of genetically inherited and adaptive variation (see neo-Darwinism)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>evolution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14874"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14668 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14668">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diffusion across a membrane by means of a carrier molecule that requires no energy and involves the exchange of two ions across the membrane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exchange diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14669 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14669">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average length of time an organism can be expected to survive, or a substance can be expected to persist.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>expected life span</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14670 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14670">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Manmade construction intended to simulate a natural environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>experimental ecosystem</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14802"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14808"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14846"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14852"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14671 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14671">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interspecies competition in which species compete for some limiting resource such as food.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exploitation competition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14672 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14672">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Growth of cells, organisms, or populations in which the number or mass increases exponentially and growth at any time is proportional to the number or mass present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The mathematical relationship is of the same form as that for exponential decay.</rdfs:comment>
        <rdfs:label>exponential growth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14725"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14673 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14673">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of measuring or estimating concentration (or intensity), duration, and frequency of exposures to an agent present in the environment or, if estimating hypothetical exposures, that might arise from the release of a substance, or radionuclide, into the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exposure assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14674 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14674">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Description of the presence and characteristics of contact between the contaminant and the ecological entity of concern, and a summary of this information in an exposure profile.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exposure characterisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14675 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14675">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Route by which an individual is exposed to a contaminant, including the source and point of contact.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exposure pathway</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14676 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14676">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outline of the magnitude and spatio-temporal pattern of exposure developed during the process of ecological risk assessment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exposure profile</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14677 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14677">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model of the likely exposure of selected populations following release of a substance into a natural environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>exposure scenario</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14678 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14678">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability that a population will eventually become extinct. Probability that a population will become extinct within a specified interval of time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Very small populations are likely to go extinct just by chance due to demographic stochasticity.</rdfs:comment>
        <rdfs:label>extinction probability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14572"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14679 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14679">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculation, based on quantitative observations in exposed test species or in vitro test systems, of predicted dose–effect and dose–response relationships for a substance in the same species at other doses or in humans and other species at similar doses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The term may also be used for qualitative information applied to species or conditions that are different from the ones in which the original investigations were carried out.</rdfs:comment>
        <rdfs:comment>The term may be applied to predictions of such relationships in susceptible groups from knowledge of a group used for testing.</rdfs:comment>
        <rdfs:label>extrapolation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14600"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14604"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14680 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14680">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity used in effect and exposure assessments to adjust estimated exposures or concentrations/doses for uncertainties, to make corrections in the data, or to improve safety.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>extrapolation factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14626"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14681 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14681">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Passive diffusion down a gradient, not requiring energy, but occurring at a rate faster than expected by simple diffusion alone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>facilitated transport</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Facilitated diffusion may involve a membrane channel or a carrier molecule, often a protein. In the latter case, it may be referred to as facilitated transport. Both processes exhibit ligand specificity and saturation kinetics.</rdfs:comment>
        <rdfs:label>facilitated diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14682 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14682">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disposition of a material in various environmental compartments (e.g., soil or sediment, water, air, biota) as a result of transport, partitioning, transformation, and degradation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14537"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14683 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14683">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of a remedial investigation that compares the various options available for remediation and identifies those that are practicable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>FS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>feasibility study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14989"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14683"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14684 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14684">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of the life cycle of an individual in which natural selection can occur, involving the production of more offspring by matings of certain genotype pairs than are produced by other genotype pairs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fecundity selection</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14685 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14685">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enhanced growth of plants as a result of exposure to low levels of pollutants such as nitrogen and sulfur oxides in acid precipitation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fertilisation effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14686 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14686">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance applied to soil or hydroponic systems for improving the root nutrition of plants with the aim of increasing crop yields and (or) controlling production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fertiliser</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14687 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14687">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the concentration of a substance corresponding to a cumulative probability of \(\pu{0.05}\) in the acute toxicity values for all species for which acceptable acute tests have been conducted on the material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>FAV</oboInOwl:hasRelatedSynonym>
        <rdfs:label>final acute value</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14687"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FAV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14688 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14688">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the concentration of a substance corresponding to a cumulative probability of \(\pu{0.05}\) in the chronic toxicity values for all genera for which acceptable chronic tests have been conducted on the material.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>FCV</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The FCV can also be calculated by dividing the final acute value (FAV) by the final acute-to-chronic toxicity ratio (ACR).</rdfs:comment>
        <rdfs:label>final chronic value</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14422"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14687"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14688"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FCV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14689 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14689">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statement of no significant impact of a major federal action concluded after an environmental assessment (EA).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>FONSI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>finding of no significant impact</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14637"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14689"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FONSI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14690 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14690">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of increase of population size measured over set intervals, such as between age classes of a life table or generations of a population with nonoverlapping generations, e.g., an annual plant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>multiplicative growth factor per generation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>finite rate of increase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14691 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14691">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Behavioral, physiological, and biochemical responses of fish used to classify chemicals by mode of action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>FATS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>fish acute toxicity syndromes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14691"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FATS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14692 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14692">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increased relative fitness of a resistant genotype in a polluted environment compared to a nonresistant genotype.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fitness advantage</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14693 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14693">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reduced relative fitness of a resistant genotype in an unpolluted environment compared to a nonresistant genotype.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fitness cost</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14694 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14694">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exposure system for aquatic toxicity tests in which the test material solutions and control water flow into and out of test chambers on a once-through basis either intermittently or continuously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>flow-through system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14695 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14695">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aquatic toxicity test performed in a flow-through system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>continuous flow test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>flow-through test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14694"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14696 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14696">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deviation from perfect bilateral symmetry for a population of a bilaterally symmetrical species that is thought to reflect developmental instability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>A trait is measured from the right and left sides of each individual, and the variance in the difference (right–left) for the population is a measure of fluctuating asymmetry.</rdfs:comment>
        <rdfs:label>fluctuating asymmetry</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14444"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14590"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14697 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14697">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that feeds on the fluids of other animals or of plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fluid feeder</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14698 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14698">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hierarchical sequence of transfer of substances from prey organism to predator organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Interconnected food chains combine to form a food web in which most organisms consume or are consumed by more than one other type of organism.</rdfs:comment>
        <rdfs:label>food chain</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14699 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14699">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal that feeds on the body parts of other animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>food-mass feeder</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14700 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14700">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mineralized or otherwise preserved remnant or trace (such as a footprint) of an animal, plant, and other organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fossil</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14701 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14701">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model for acute metal toxicity to aquatic organisms based on the idea that toxicity occurs when the concentration of the free metal cation in solution reaches a certain level.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>FIAM</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This model has been developed into the biotic ligand model.</rdfs:comment>
        <rdfs:label>free ion activity model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14501"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14701"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FIAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14702 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14702">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Empirical equation that describes the adsorption of a contaminant to soil. The equation is \[x/m = (K_{\rm{f}} C_{\rm{e}}) \exp (1/n)\] where \(x/m\) is the mass ratio of concentrations of adsorbed substance at equilibrium divided by the concentration of the contaminant in soil, \(C_{\rm{e}}\) is the contaminant concentration in the aqueous phase at equilibrium, \(K_{\rm{f}}\) is the equilibrium constant (the Freundlich adsorption constant), and \(1/n\) is a contaminant specific exponent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Freundlich adsorption isotherm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14703 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14703">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Humic substance that is soluble at all \(\rm{pH}\)s.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Most of the humic substance in natural water is fulvic acid.</rdfs:comment>
        <rdfs:label>fulvic acid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14746"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14704 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14704">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Apparently unaltered maintenance of community function despite changes in structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>functional redundancy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14705 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14705">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in some predator function, such as prey consumption rate, in response to changes in prey density.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>functional response</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14706 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14706">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Environmental conditions under which a species can thrive.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>fundamental niche</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14707 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14707">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis proposed by James Lovelock that the Earth’s temperature, albedo, and surface chemistry are homeostatically regulated by the sum of all the biota of the Earth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Gaia hypothesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14708 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14708">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Natural selection resulting from differential success of gametes produced by heterozygotes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>gametic selection</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14709 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14709">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Excretion through the intestinal mucosa by active or passive processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Some chemical species of metallic elements such as cadmium and mercury can experience significant levels of gastrointestinal excretion.</rdfs:comment>
        <rdfs:comment>This may involve loss by normal cell sloughing of the intestine wall.</rdfs:comment>
        <rdfs:label>gastrointestinal excretion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14710 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14710">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific syndrome associated with Selyean stress composed of three phases: the alarm reaction, adaptation or resistance, and exhaustion; adaptation in all phases of the GAS results in restoration of homeostasis or reduced deviation from homeostasis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>GAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>general adaptation syndrome</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15025"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14710"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14711 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14711">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Result of random genetic variation due to mutation and (or) to changes in allele frequencies, causing variation in the survival and reproductive success of individuals and hence of groups of organisms, with the consequence that those best adjusted to their environment flourish.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>adaptation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>evolutionary adaptation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This process underlies the concept of natural selection leading to Darwinian evolution.</rdfs:comment>
        <rdfs:label>genetic adaptation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14871"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14712 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14712">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evolutionary process of change in the allele frequencies in a population due to random changes in the frequency by which different alleles are transferred to the next generation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>In small populations, genetic drift may result in extinction of some alleles leading to evolutionary change over time.</rdfs:comment>
        <rdfs:label>genetic drift</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14713 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14713">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Situation in which a scored locus is acting only as a marker for a closely linked gene that is actually responsible for the difference in tolerance among genotypes. More generally, it is the condition &apos;in which a given allele changes in frequency as a result of linkage or gametic phase disequilibrium with another selected locus&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>genetic hitchhiking</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14714 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14714">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Risk to the progeny of an exposed individual of an adverse effect associated with heritable genetic damage, e.g., damage to germ cells leading to a nonviable fetus or an offspring with a birth defect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>genetic risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14716 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14716">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Low-level taxonomic rank used in the classification of living and fossil organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Like almost all other taxonomic units, genera may sometimes be divided into subgenera, singular: subgenus. The largest main taxonomic unit below the genus is the species.</rdfs:comment>
        <rdfs:label>genus</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14717 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14717">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Computerized system to handle spatial data at a reasonable cost; most allow one to archive, organize, integrate, statistically analyze, and display many kinds of spatial information using a common coordinate system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>GIS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>geographic information system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14717"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GIS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14718 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14718">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which persistent and relatively volatile organochlorine compounds are distilled from warmer regions of use to cooler regions of the globe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>global distillation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14719 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14719">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which some persistent organic pollutants (POPs) move more rapidly than others toward the polar regions. Because POPs differ in their individual rates of degradation, vapor pressure, and lipophilicity, a fractionation occurs. The net result is a redistribution of the different POPs from the equator or site of origin toward the cold polar regions of the Earth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>global fractionation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14720 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14720">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heating up of the Earth’s climate thought to result from the increased atmospheric carbon dioxide (\(\ce{CO2}\)) concentrations from fossil fuel burning, release of other greenhouse gases, and the worldwide destruction of forests.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>global warming</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14721 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14721">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fundamental rules incorporated in Organization for Economic Cooperation and Development (OECD) guidelines and national regulations concerned with the process of effective organization and the conditions under which laboratory studies are properly planned, performed, monitored, recorded, and reported.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>GLP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GLP principles</oboInOwl:hasRelatedSynonym>
        <rdfs:label>good laboratory practice principles</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14721"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GLP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14722 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14722">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consequence that can be measured on a graded scale of intensity or severity and its magnitude related directly to the dose or concentration of the substance producing it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>graded effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14723 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14723">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Global distillation of persistent organic pollutants (POPs) involving seasonal cycling of temperatures such that movement toward the higher latitudes occurs in annual pulses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>grasshopper effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14718"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14909"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14724 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14724">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Atmospheric gases that are relatively transparent to sunlight entering the atmosphere but absorb infrared radiation generated at the Earth’s surface. They include water vapor, carbon dioxide (\(\ce{CO2}\)), methane, dinitrogen oxide (nitrous oxide), chlorofluorocarbons (CFCs), chloroethane (methylchloroform), carbon tetrachloride, and the fire retardant, halon. Ozone in the troposphere can also act as a greenhouse gas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>greenhouse gases</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14725 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14725">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in size.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>growth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14672"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14774"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14811"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14726 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14726">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in contaminant concentration in a growing organism because the amount of tissue in which the contaminant is distributed is increasing.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>growth dilution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14727 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14727">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of functionally similar species whose members interact strongly with one another but weakly with the remainder of the community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>guild</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14728 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14728">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Spatial area (geographical area) where a particular species population lives, large enough to comprise a breeding population. Note: A microhabitat or microenvironment is the immediate surroundings and other physical factors of an individual plant or animal within its habitat. Physical conditions that surround a species, or species population, or assemblage of species, or community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>habitat</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14729 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14729">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of all metallic cations, except those of the alkali metals, present in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>In general, the concentration of calcium and magnesium ions in water, frequently expressed as \(\pu{mg L-1}\) calcium carbonate or equivalent, is used as a measure of hardness.</rdfs:comment>
        <rdfs:label>hardness</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14730 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14730">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water that contains mineral salts of divalent cations, commonly calcium and magnesium and sometimes iron(II) (ferrous) ions, principally as hydrogencarbonates, chlorides, and sulfates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Hardness caused by calcium hydrogencarbonate is known as temporary, because boiling converts the hydrogencarbonate to calcium carbonate (\(\ce{CaCO3}\)), which has a very low solubility; hardness from the other salts is called permanent.</rdfs:comment>
        <rdfs:label>hard water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14731 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14731">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of a population if the frequencies of different alleles of all genes in the genome remain constant between generations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>genetic equilibrium</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The Hardy–Weinberg equilibrium is a very rare situation in natural populations. Deviation from the Hardy–Weinberg equilibrium is the basis for microevolution.</rdfs:comment>
        <rdfs:comment>The Hardy–Weinberg equilibrium requires the following conditions: (1) the population is large (&quot;infinite&quot;), (2) mating is random, (3) there is no selection, (4) the net mutation rate is zero, and (5) there is no migration.</rdfs:comment>
        <rdfs:label>Hardy–Weinberg equilibrium</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14853"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14732 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14732">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effect to an ecosystem, community, population, species, individual organism, organ, tissue, or cell.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>damage</oboInOwl:hasRelatedSynonym>
        <rdfs:label>harm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14733 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14733">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of factors controlling the likely effects of a hazard such as the dose–effect and dose–response relationships, variations in target susceptibility, bioaccumulation potential, persistence, and mechanism of toxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hazard assessment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14470"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14600"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14604"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15085"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14734 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14734">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Identification and assessment of the potential adverse effects that could result from manufacture, use, and disposal of a material in a specified quantity and manner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hazard evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14735 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14735">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Determination of substances of concern, their adverse effects, target populations, and conditions of exposure, taking into account toxicity data and knowledge of effects on human health, other organisms, and their environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hazard identification</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14736 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14736">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sum of the hazard quotients for substances that affect the same target organ or organ system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>HI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Ideally, hazard quotients should be combined for pollutants that cause adverse effects by the same mechanism. Aggregate exposures below an HI of \(\pu{1.0}\) are unlikely to result in adverse health effects over a lifetime of exposure. An HI greater than \(\pu{1.0}\) does not necessarily suggest a likelihood of adverse effects. The HI cannot be translated to a probability that adverse effects will occur, and is not likely to be proportional to risk.</rdfs:comment>
        <rdfs:label>hazard index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14737"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14736"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14737 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14737">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of toxicant exposure (estimated or measured) to a reference value regarded as corresponding to a threshold of toxicity; often this is determined as the predicted environmental concentration (PEC) divided by the predicted no-effect concentration (PNEC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>HQ</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>If the hazard quotient exceeds unity, the toxicant may produce an adverse effect, but normally this will require an HQ of several times unity; an HQ of less than one indicates that no adverse effects are likely over a lifetime of exposure.</rdfs:comment>
        <rdfs:label>hazard quotient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14945"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14737"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HQ</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14738 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14738">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance producing a defined effect on \(\pu{\textit{p} \%}\) (usually \(\pu{5\%}\)) of species of concern, derived by means of a statistical extrapolation procedure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hazardous concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15052"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14739 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14739">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term used commonly but erroneously when referring to metal toxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The term is deprecated as it has no generally agreed meaning and sometimes is even applied to nonmetals. It is a source of confusion to be avoided. The term &quot;metal&quot; is often adequate.</rdfs:comment>
        <rdfs:label>heavy metal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14740 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14740">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal that partially regulates body temperature, sometimes maintaining its body temperature at a certain level, e.g., when active, but at other times allowing it to fluctuate with the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>heterotherm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14741 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14741">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism obtaining organic food by eating other organisms or their excreta.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Animals, fungi, and most bacteria are heterotrophs.</rdfs:comment>
        <rdfs:label>heterotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14742 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14742">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temporal sequential appearance of different heterotrophic species at a location, most often decomposer organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>heterotrophic succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14743 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14743">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Greater Darwinian fitness (reproductive output) from heterozygous than from homozygous individuals of a species. This tends to preserve variation in the population gene pool.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>heterosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label>heterozygote advantage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14744 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14744">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Totality of processes occurring in an open system or a closed system, especially a living organism, enabling it to regulate its internal environment to maintain stable, constant conditions or the outcome of these processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>homeostasis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14745 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14745">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unexpected and unexplained but favorable biological response to low-level exposure to a substance or physical agent generally considered to be harmful.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hormesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14746 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14746">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonvolatile organic anionic polyelectrolytes, of biological origin, in the molecular mass range \(\pu{500\!{-}\! 5000}\), which have complex structures and are variable in composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Humic substances occur naturally as deposits on sediment and soil particles and constitute \(\pu{30\!{-}\! 50 \%}\) of the dissolved organic carbon (DOC) in natural waters. Humic substances are classified according to solubility and may contain humic acid, fulvic acid, and humin.</rdfs:comment>
        <rdfs:label>humic substances</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14595"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14703"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14747 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14747">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Intersection of ranges of tolerances for sets of resources utilized by organisms, represented mathematically by a multidimensional hypervolume whose dimensions correspond to environmental variables. Any species is considered unimodally distributed, i.e., confined to a habitat in the niche.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This niche concept is quantifiable and therefore particularly useful to ecologists. Hutchinson’s niche is the most accepted concept of the niche in use today. In practice, it is impossible to identify and quantify all the resources utilized by an organism. Thus, typically the limiting factors receive most attention.</rdfs:comment>
        <rdfs:comment>Two aspects of the niche can be visualized: A realized niche for a species is the sum of niche dimensions unique to that particular species. A fundamental niche is the total sum of the species niche dimensions including parts shared with other species and parts unshared.</rdfs:comment>
        <rdfs:label>Hutchinsonian niche</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14877"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14973"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14748 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14748">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Result of interbreeding between two animals or plants of different taxa.Note: Hybrids between different species within the same genus are sometimes known as interspecific hybrids or crosses. Hybrids between different subspecies within a species are known as intra-specific hybrids. Hybrids between different genera are sometimes known as intergeneric hybrids. Cross-breed between populations, breeds, or cultivars within a single species.Note: Hybridization is often used in plant and animal breeding to obtain desirable characteristics not found or inconsistently present in the parent individuals or populations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hybrid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14716"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14749 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14749">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deficient oxygenation of the blood.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hypoxemia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14750 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14750">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dioxygen-deficient</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>hypoxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14751 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14751">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a chemical which is lethal to \(\pu{50\%}\) of the test organisms as a result of exposure for periods long enough for acute lethal action to cease; in other words, the concentration below which \(\pu{50\%}\) of individuals will have a normal lifespan despite the previous exposure to a toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>incipient LC&lt;sub&gt;50&lt;/sub&gt;</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14752 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14752">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an air pollutant, the additional lifetime cancer risk occurring in a hypothetical population in which all individuals are exposed continuously from birth throughout their lifetimes to a concentration of \(\pu{1 \upmu g m-3}\) of the pollutant in the air they breathe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>incremental unit risk estimate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14753 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14753">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Production of an effect by each toxicant in a given exposure that is independent of the others and occurs by a different mode of action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>independent joint action</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14754 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14754">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Composite index combining 12 qualities of fish communities of warm-water, low-gradient streams to determine the level of stream degradation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This index has been modified and widely used in the United States.</rdfs:comment>
        <rdfs:label>index of biological integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14755 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14755">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Species whose presence shows the occurrence of defined environmental conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>indicator species</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14756 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14756">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Native to a given region or ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>&quot;Indigenous&quot; is not synonymous with &quot;endemic&quot;. In ecology, endemic means exclusively native to the biota of a specific place, whereas an indigenous species may occur in two or more different habitats.</rdfs:comment>
        <rdfs:comment>The term is applied to a native species to distinguish it from species introduced as a result of human activity.</rdfs:comment>
        <rdfs:label>indigenous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14632"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14757 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14757">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Effect resulting from imposed biotic or abiotic factors which alter ecosystem properties that in turn favor or disfavor an ecological component of importance (e.g., a species) and thus indirectly lead to improved or reduced fitness of that species. Result of imposed biotic or abiotic factors allowing indigenous or new species to dominate, thereby affecting ecosystem composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>indirect ecological effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14756"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14758 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14758">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degradation of a contaminant through interaction with other molecules in solution that have absorbed light energy. This can occur through energy transfer or by chemical reaction with short-lived reactive species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Dissolved humic and fulvic acids are good examples of photoactive compounds that can increase the degradation of contaminants through indirect photolysis.</rdfs:comment>
        <rdfs:label>indirect photolysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14703"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14759 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14759">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adverse effects that result from agent(s) acting on and producing changes in the chemical, physical, and (or) biological environment external to the organisms under study (e.g., decrease in food for predatory species due to direct toxicity from a chemical to prey may produce adverse effects in the predator species due to starvation rather than inducing any direct chemical toxicity in predator organisms).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>indirect toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14760 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14760">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One whole organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Individuals have size, shape, and health or condition. They grow, reproduce, and die over time.</rdfs:comment>
        <rdfs:label>individual</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14761 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14761">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concept forming the basis for most dose–response models, which holds that there exists a smallest dose needed to kill any particular individual. The IED is a characteristic of an individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>IED</oboInOwl:hasRelatedSynonym>
        <rdfs:label>individual effective dose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14604"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14761"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IED</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14762 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14762">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the flows of materials and energy in the industrial environment and the effects of these flows on natural systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>industrial ecology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14763 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14763">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gradual increase to predominance of melanic forms in populations from industrialized regions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>industrial melanism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14764 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14764">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Community’s ability to resist change.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>inertia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14765 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14765">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animals living in the sediment of aquatic systems but not on the surface.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>infauna</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14653"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14766 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14766">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific action that results in a risk being incurred.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>initiating event</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14767 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14767">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>USEPA database containing reference doses, slope factors, and drinking-water health advisories (one-day, ten-day, longer-term, and lifetime advisories), and associated information.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>IRIS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>integrated risk information system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14767"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IRIS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14768 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14768">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interspecies competition in which one species interferes with another, as might occur with territoriality or aggressive behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>interference competition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14769 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14769">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interference with or inhibition of one species by another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>interspecies competition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14770 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14770">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Competition by different species for the same (limited) resources.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>interspecific competition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14771 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14771">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relations between different species in a community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>interspecific interaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14772 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14772">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water in sediment or soil that surrounds the solid particles. The amount of interstitial water is calculated and expressed as the percentage ratio of the mass of water in the sediment to the mass of the wet sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>pore water</oboInOwl:hasRelatedSynonym>
        <rdfs:label>interstitial water</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14773 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14773">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Competition by individuals of the same species (population) for the same (limited) resources.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>intraspecific competition</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14774 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14774">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>\(r = ({\rm{natality}} + {\rm{immigration}}) - ({\rm{mortality}} + {\rm{emigration}})\)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>intrinsic rate of growth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14725"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14775 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14775">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of increase in the size of a population growing under no constraints.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>Malthusian rate of increase</oboInOwl:hasRelatedSynonym>
        <rdfs:label>intrinsic rate of increase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14828"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14776 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14776">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach used to visualize or quantify joint action of chemical mixtures by plotting a graph (isobologram) of equally effective dose pairs (isoboles) for a single effect level. A particular effect level is selected, such as \(\pu{50\%}\) of the maximum, and doses of drugs \(\ce{A}\) and \(\ce{B}\) (each alone) that give this effect are plotted as axial points in a Cartesian plot. The straight line connecting \(\ce{A}\) and \(\ce{B}\) is the locus of points (dose pairs) that will produce this effect in a simply additive combination. This line of additivity allows a comparison with the actual dose pair that produces this effect level experimentally.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>isobole approach</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14777 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14777">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The differential behavior of isotopes occurring if the rate or extent of participation in some biological or chemical process depends significantly on the mass of the isotope. Also called the isotope effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>isotopic discrimination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14778 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14778">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Species that reproduces more than once.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>iteroparous species</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14779 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14779">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any agent will be teratogenic if it is present at concentrations or intensities producing cell toxicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Kamofsky’s law</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14780 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14780">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>High-quality habitat patch essential to maintaining the vitality of the metapopulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>keystone habitat</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14850"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14781 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14781">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Species, usually a top predator, that influences the ecological community by its activity or role, not its numerical dominance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>keystone species</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14782 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14782">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equilibrium strategy for species involving effective interactions with each other in the community, allowing coexistence of many species. Equilibrium species are more effective competitors than opportunistic species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>k-strategy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14783 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14783">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Recently hatched insect, fish, or other organism that has different physical characteristics than those seen in the adult, requiring metamorphosis to reach the adult body structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>larva</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14784 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14784">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>According to this &apos;law&apos;, there are comparatively many rare (low abundance) species, and possibly comparatively many common (high abundance) species, but relatively few in the middle (of medium abundance).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Thus, if one collects data on species presence/absence in a set of quadrants, one tends to find a J-shaped pattern in the distribution of species frequencies.</rdfs:comment>
        <rdfs:label>law of frequence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14785 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14785">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>With reference to a soluble chemical or mineral, drain away from soil, ash, or similar material by the action of percolating liquid, especially rainwater.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>leach</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14786 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14786">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water or waste-water that has percolated through a column of soil or solid waste in the environment, carrying with it substances dissolved from the soil or waste.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>leachate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14787 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14787">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Related to standing water riparian-wetland areas such as lakes, ponds, seeps, bogs, and meadows.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lentic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14997"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14788 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14788">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonflowing or still inland water; e.g., lakes, ponds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lentic water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14789 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14789">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Square matrix used in population biology to predict population growth. The top row of the matrix is the fecundity for each age class of mothers, and a subdiagonal is constructed from the number of individuals surviving from age class \(x\) to \(x + 1\). Multiplied by the population vector of the number of female offspring in each age class \(x\) at time \(t\), it predicts the age distribution of the population at the next time step \(t + 1\), corresponding to the age class interval \(x + 1\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Leslie matrix</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14790 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14790">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deadly; fatal; causing death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lethal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14791 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14791">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total body uptake of a substance that is associated with mortality in short-term exposures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LBB</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lethal body burden</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14791"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LBB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14792 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14792">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time taken for a defined percentage, usually \(\pu{50\%}\), of a test population to die.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LT</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The median lethal time (MLT) for \(\pu{50\%}\) of the test population is referred to as the \(\pu{MLT_{50}}\).</rdfs:comment>
        <rdfs:label>lethal time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14838"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14792"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14793 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14793">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability to cause death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lethality</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14794 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14794">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Observation that a population’s size (number of individuals or biomass) is limited by some essential factor in the environment that is scarce relative to the amount of other essential factors, e.g., phosphorus-limited algal growth in a lake.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Liebig&apos;s law of the minimum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14795 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14795">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Series of stages, from a given point in one generation to the same point in next generation, e.g., egglarva-adult-egg (hyphenated when used as an adjective, e.g., life-cycle strategy).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>life cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14796"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14797"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14796 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14796">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Comprehensive study to determine the impact of a substance or mixture on the survival, growth, reproduction, development, or other important qualities at all stages of a species life cycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>life-cycle study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14797 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14797">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Description of life-cycle events through which an organism passes, with particular reference to those events that influence survival and reproduction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>life history</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14795"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14798 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14798">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statistical table that follows a hypothetical cohort of \(\pu{100000}\) persons born at the same time as they progress through successive ages, with the cohort reduced from one age to the next according to a set of death rates by age until all persons eventually die.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>In ecology, fertility for each age class is normally included in the tables.</rdfs:comment>
        <rdfs:comment>The life table is used mainly to indicate expectation of life at various ages. However, it also provides information on numbers of individuals who survive to various ages, median age at death, age-specific death rates, and the probability of dying at certain ages.</rdfs:comment>
        <rdfs:label>life table</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14430"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14568"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14610"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14799 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14799">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Retrospective comparison of two or more populations in which the response variable is a life table or a complete set of stage-specific vital rates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LTRE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>life-table response experiment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14799"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LTRE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14800 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14800">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Limit concentration at or below which Member States of the European Community must set their environmental quality standard and emission standard for a particular substance according to Community Directives.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LV</oboInOwl:hasRelatedSynonym>
        <rdfs:label>limit value</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14631"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14645"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14800"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14801 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14801">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model based on the assumption that the maximum life span of an individual organism is an inherent, genetically defined property of that organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>limited life-span paradigm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14802 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14802">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Artificial enclosures placed in the pelagic region of ponds, lakes, or marine environments. These systems vary in size from as little as \(\pu{2 L}\) to over \(\pu{2.5E6 L}\); however, most of these systems have a volume between \(\pu{1000 L}\) and \(\pu{E4 L}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>These systems may or may not be in contact with the profundal region. Fish are generally excluded from these test systems.</rdfs:comment>
        <rdfs:label>limnocorrals</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14903"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14803 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14803">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study incorporating the study of all aspects of inland freshwater habitats including lakes, ponds, rivers, streams, swamps, wetlands, groundwaters, and reservoirs that make up inland water systems</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>limnology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14804 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14804">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>An empirical relationship in which numerical parameters are associated with small perturbations in a parent molecule and are subsequently correlated with the change in the Gibbs energy of a certain reaction of the parent molecule vs. the perturbed molecules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LFER</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A classical example is the well-known Hammett equation, in which sigma (\(\upsigma\)) values are constructed for specific substituents on a benzoic acid parent molecule. The linear correlation is then between the (summed) sigma values for a set of compounds and the \(\pu{p}K_{\rm{a}}\) (free energy of acid dissociation) of those compounds.</rdfs:comment>
        <rdfs:label>linear free energy relationship</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14804"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LFER</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14805 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14805">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Simple, semigraphical method for analyzing survival time data and estimating \(\pu{LT_{50}}\) values.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Litchfield method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14806 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14806">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semigraphical method for estimating a median lethal concentration (\(\pu{LC_{50}}\)), median lethal dose (\(\pu{LD_{50}}\)), or median effective concentration (\(\pu{EC_{50}}\)). Although very easy to perform, it is the most subjective method for such estimations because it involves fitting a line to data by eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Litchfield–Wilcoxon method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14807 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14807">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Belonging to the shore of a lake, river, pond, or especially the sea. Intertidal zone, sometimes referring specifically to the shallow well-lit region along the shore.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>littoral</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14808 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14808">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isolated shore regions of freshwater ponds separated from the main body of water by plastic dividers used for ecotoxicological testing. These test systems generally have a volume of \(\pu{1000 L}\) to \(\pu{5E4 L}\) and a maximum depth of \(\pu{2 m}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>littoral enclosures</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14809 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14809">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of animal biomass to the volume of test solution in an exposure chamber.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>loading</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14810 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14810">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Function, often applied to growth curves, fitting the general equation \[y = k/(1 + e^{a+bt})\] where \(t\) represents time, \(y\) the body weight or population size, \(k\) the rate of growth, and \(a\) and \(b \gt 0\) are constants. In the logistic equation the percentage rate of increase decreases linearly as size increases. The resulting curve continually rises, slowly at first, more rapidly in the middle phase, and slowly again near the end of growth.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>logistic curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14811 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14811">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Growth of a population under environmental constraints that set a maximum population size, giving an S-shaped curve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>logistic growth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14514"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14725"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14812 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14812">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In competitive binding assays, the logit-log dose relationship, in which the response is defined by \[R = {\rm{logit}}\,(y) = \ln [y/(1 - y)]\] where \(y = b/b_{0}\), \(b\) is fraction of tracer bound and \(b_{0}\) is the value of \(b\) with no unlabelled ligand in the system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Logit-transformed assay data frequently yield straight-line dose-response data, amenable to statistical analysis. More generally in toxicology, the transformation is applied to dose-response data where \(b_{0}\) denotes the maximum response in the absence of a toxic substance.</rdfs:comment>
        <rdfs:label>logit transformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14813 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14813">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transformation of data with a logarithmic function that results in a normal distribution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>log-normal transformation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14814 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14814">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delusion of selfless motivation in environmental stewardship or advocacy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The Lorax is a character in a popular children’s book by Dr. Seuss who &quot;speaks for the trees, for the trees have no tongues&quot;.</rdfs:comment>
        <rdfs:label>Lorax incongruity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14815 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14815">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculated estimate of loss in lifetime associated with a risk factor; it is estimated as the simple difference between life expectancy without the risk factor and life expectancy with the risk factor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LLE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>loss of life expectancy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14815"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14816 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14816">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Related to flowing continental waters, such as rivers and streams.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lotic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14817 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14817">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Streams of various sizes used to evaluate the effects of substances. Unlike lentic systems, no standardized design has been developed for flowing-water test systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>lotic microcosms</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lotic mesocosms</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14787"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14818 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14818">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Flowing continental waters, such as rivers and streams.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>lotic water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14819 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14819">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lowest dose of a chemical inducing a specified effect in a specified fraction of exposed individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LED</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lowest effective dose</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14819"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LED</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14820 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14820">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lowest concentration of a material used in an aquatic toxicity test that has a statistically significant adverse effect on the exposed population of test organisms compared with controls.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>LOEC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>When derived from a life cycle or partial life cycle test, it is numerically the same as the upper limit of the maximum acceptable toxicant concentration (MATC). Also called lowest-observed-adverse-effect level (LOAEL).</rdfs:comment>
        <rdfs:label>lowest-observed-effect concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14820"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LOEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14821 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14821">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Life table that summarizes mortality data for populations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>&quot;\({\rm{l}}x\)&quot; is the number of individuals in a cohort alive at age or stage class, \(x\).</rdfs:comment>
        <rdfs:label>l&lt;i&gt;x&lt;/i&gt; life table or schedule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14822 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14822">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Life table that summarizes both mortality and natality data for populations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>&quot;\({\rm{l}}x\)&quot; is the actual number or the proportion (as a decimal or percentage) of survivors at the beginning of age interval \(x\). Since several samples are often averaged together, the \({\rm{l}}x\) values may not always be whole numbers. &quot;\({\rm{m}}x\)&quot; is the number of female births to each age group of &quot;mothers&quot;; the number of eggs or young which are female (in a species with a 1:1 sex ratio, this is \({\rm{m}}x/2\) where \({\rm{m}}x\) is the total eggs or young produced per female at age \(x\)). Since, for most organisms, one male can fertilize a number of females, the size of the population is more dependent on the number of females present, and the calculations are usually done using only females.</rdfs:comment>
        <rdfs:label>l&lt;i&gt;x&lt;/i&gt;m&lt;i&gt;x&lt;/i&gt; life table</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14823 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14823">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model of island colonization giving the mathematical relationship \[S(t) = S_{\rm{EQ}}(1 - e^{-Gt})\] where \(S(t)\) is the number of species present at time \(t\), \(S_{\rm{EQ}}\) is the equilibrium number of species for the island, and \(G\) is the rate constant for colonization of the island.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>MacArthur–Wilson model</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14824 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14824">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Large multi-species test system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>macrocosm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14846"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14852"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14825 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14825">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Imprecise term referring to a nutrient required for survival, or present in biological fluids or compartments at a level easily measured by existing analytical techniques.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>macronutrient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14659"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14826 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14826">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aquatic plant large enough to be seen easily with the naked eye (as distinct from phytoplankton and small algae).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The term &quot;aquatic macrophyte&quot; has no taxonomic significance.</rdfs:comment>
        <rdfs:label>macrophyte</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14827 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14827">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Disease or birth defects produced by a father’s exposure to a physical or chemical agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>male-mediated toxicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14828 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14828">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model, developed by Thomas R. Malthus (1766–1834), implying that, unchecked by environmental or social constraints, human populations would double every 25 years, regardless of the initial population size. Thus, if \(X_{i}\) denotes the population size during time period \(i\) and \(r\) the population growth rate, the Malthusian population model gives the relationship \[X(I + 1) = (1 + r)X_{i}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Malthusian theory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14829 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14829">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation that expresses the total mass of a chemical in terms of all the various forms and concentrations in different environmental compartments (including biota) in which it occurs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>mass balance equation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14830 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14830">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Index for pollution based on the proportions of species in a soil nematode community that fall into various categories ranging from colonizers (\(r\mbox{-}\rm{strategists}\)) to persisters (\(k\mbox{-}\rm{strategists}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>maturity index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14782"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15005"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14831 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14831">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assignment of ecological or biological significance of a contaminant’s effect based primarily on statements of statistical significance but contrary to biological probability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>maulstick incongruity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14832 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14832">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Geometric mean of the lowest exposure concentration that causes a statistically significant adverse effect (lowest-observed-effect concentration, LOEC) and the highest exposure concentration where no effect is observed (no-observed-effect concentration, NOEC) in a life-cycle (full chronic) or partial lifecycle (partial chronic) test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>MATC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Calculation of an MATC requires quantitative life-cycle toxicity data on the effects of a material on survival, growth, and reproduction.</rdfs:comment>
        <rdfs:label>maximum acceptable toxicant concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14820"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14885"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14832"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MATC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14833 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14833">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parametric method used to fit dose- or concentration-effect data to the log-normal, log-logistic, or other models.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>MLE</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Probit and logit approaches are most often applied with MLE methods.</rdfs:comment>
        <rdfs:label>maximum likelihood estimation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14953"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14833"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14834 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14834">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mean time required for absorption of a drug or contaminant calculated as the difference in mean residence time (MRT) of the material introduced by the (noninstantaneous) route of interest and the MRT for the same material injected intravenously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>MAT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mean absorption time</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14834"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14835 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14835">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average time interval required for a bacterial cell to divide or for the population to double under a defined set of conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>mean generation time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14836 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14836">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurable response to a stressor (e.g., fledglings produced per nest each year) that is related to the valued qualities of the assessment endpoint (e.g., reproductive success of bald eagles).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>measurement endpoint</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14837 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14837">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For sublethal or ambiguously lethal effects, the median time until \(\pu{50\%}\) of the exposed individuals respond.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>median effective time</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14838 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14838">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time required for a toxicant to inhibit a specified process in \(\pu{50\%}\) of a population under test conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>inhibitory time (IT)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>median inhibitory time</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14625"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14792"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14839 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14839">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Median time resulting in death for \(\pu{50\%}\) of the exposed organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>MTTD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>median time to death</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14839"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MTTD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14840 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14840">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance in air, water, sediment, or soil at which \(\pu{50\%}\) of the test organisms survive after a specified time of exposure. The \(\pu{TL_{50}}\) (equivalent to the \(\pu{TL_{m}}\)) is usually expressed as a time-dependent value (e.g., \(\pu{24\!\mbox{-}h}\) or \(\pu{96\!\mbox{-}h}\) \(\pu{TL_{50}}\); the estimated concentration at which \(\pu{50\%}\) of test organisms survive after \(\pu{24 h}\) or \(\pu{96 h}\) of exposure).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Unlike lethal concentration and lethal dose, the term &quot;tolerance limit&quot; is applicable in designating the level of any measurable lethal condition (e.g., extremes in \(\rm{pH}\), temperature, dissolved oxygen). \(\pu{TL_{m}}\) and \(\pu{TL_{50}}\) have been replaced by median lethal concentration (\(\pu{LC_{50}}\)) and median effective concentration (\(\pu{EC_{50}}\)).</rdfs:comment>
        <rdfs:label>median tolerance limit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14841 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14841">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small benthic invertebrates living in interstices of soil or sediment or in aquatic systems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The term loosely defines a group of organisms by their size, larger than microfauna but smaller than macrofauna. In practice, these are usually organisms that can pass through a \(\pu{1 mm}\) mesh but will be retained by a \(\pu{45 \upmu m}\) mesh, but the exact dimensions vary from researcher to researcher. Whether an organism will pass through a \(\pu{1\!\mbox{-}mm}\) mesh may depend upon whether it is alive or dead at the time of sorting.</rdfs:comment>
        <rdfs:label>meiofauna</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14842 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14842">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any process that causes some alleles to be over-represented in the gametes which are formed during meiosis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>With normal Mendelian segregation at a genetic locus, on average half of an organism’s offspring inherit one of the alleles and the other half the other allele. This term refers to rare cases in which Mendel’s laws are broken, and one of the alleles is consistently found in more than half the offspring.</rdfs:comment>
        <rdfs:label>meiotic drive</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14843 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14843">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Individuals or subspecies with increased dark pigmentation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>melanic forms</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14844 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14844">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increased black or nearly black pigmentation of skin, feathers, or hair of an organism, resulting from (increased) synthesis of melanin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>melanism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14763"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14845 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14845">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fundamental principles of inheritance (especially the laws of segregation and independent assortment and the existence of dominant and recessive characters), propounded originally by Gregor Mendel (1822–1884) and forming the basis for the science of classical genetics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Mendelism</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14846 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14846">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Enclosed and essentially self-sufficient (but not necessarily isolated) experimental environment or ecosystem that is on a larger scale than a laboratory microcosm.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>A mesocosm is normally used outdoors or, in some manner, incorporated intimately with the ecosystem that it is designed to reflect.</rdfs:comment>
        <rdfs:label>mesocosm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14824"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14852"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14847 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14847">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of using statistical methods to combine the results of different studies. In the biomedical sciences, the systematic evaluation of a problem using information (commonly in the form of statistical tables and other data) from a number of independent studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>A common application is the pooling of results from a number of small randomized controlled trials, none in itself large enough to demonstrate statistically significant differences, but capable of doing so in aggregate.</rdfs:comment>
        <rdfs:comment>Meta-analysis has a qualitative component, i.e., application of predetermined quality criteria (e.g., completeness of data, absence of bias) and a quantitative component, i.e., integration of numerical information.</rdfs:comment>
        <rdfs:comment>Meta-analysis includes overview and data pooling aspects, but implies more than either of these processes. Meta-analysis carries the risk of several biases reinforcing each other. Because of such problems inherent in the pooling of data from different studies, interpretation of the results of meta-analysis must be very cautious.</rdfs:comment>
        <rdfs:label>meta-analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14848 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14848">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Poorly characterized, cysteine-rich metal-binding proteins or proteins not conforming precisely to the classic properties of metallothioneins.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>metallothionein-like proteins</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14849 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14849">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement or a transformation of a measurement used in the analysis of biological tests, e.g., the probit metameter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>metameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14850 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14850">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Set of local populations which interact via dispersing individuals among local populations; though not all local populations in a metapopulation need interact directly with every other local population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>A metapopulation is generally considered to consist of several distinct populations together with areas of suitable habitat which are currently unoccupied. Each population cycles in relative independence of the other populations and eventually goes extinct as a consequence of demographic stochasticity.</rdfs:comment>
        <rdfs:comment>Individuals may immigrate to a small metapopulation and rescue that population from extinction.</rdfs:comment>
        <rdfs:label>metapopulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14572"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14992"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14851 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14851">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method proposed to reduce precipitate explanation by considering all plausible hypotheses simultaneously in testing so that equal amounts of effort and attention are provided to each.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>method of multiple working hypotheses</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14852 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14852">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Artificial multi-species test system that simulates major characteristics of the natural environment for the purposes of ecotoxicological effects and risk assessment; such systems are normally terrestrial or aquatic and may contain plants, animals (vertebrates and invertebrates), and microorganisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The terms mesocosm and macrocosm are used to refer to larger and more complex systems than microcosms, but the distinction is often not clearly defined.</rdfs:comment>
        <rdfs:label>microcosm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14824"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14846"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14853 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14853">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evolutionary change below the species level; a small change in the genetic make-up of a population from generation to generation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>microevolution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14854 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14854">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plant of microscopic size.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>microphyte</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14855 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14855">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test involving luminescent marine bacteria of the Vibrio sp. [e.g., V. (Photobacterium) phosphoreum, V. fischeri, V. harveyi]. A decrease in bioluminescence is thought to reflect toxic action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Microtox® test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14856 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14856">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring substance, usually crystalline, which has a particular chemical composition and specific physical properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>mineral</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14857 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14857">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference between groups (in tests with, e.g., salmonid fish, the difference in average weights or average mortality) that would have to occur before it could be concluded that there was a significant difference between the groups.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>MSD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The MSD is provided by Dunnett’s multiple range test.</rdfs:comment>
        <rdfs:label>minimum significant difference</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14857"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14858 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14858">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minimum time required to get an effect or response. Regardless of the toxicant concentration, the effect, or response, cannot occur any faster than this minimum time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>minimal time to effect or response</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14859 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14859">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Smallest population size of a species allowing survival in the wild.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>MVP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>MVP is used in the fields of biology, ecology, and conservation biology/ecology.</rdfs:comment>
        <rdfs:comment>More specifically, MVP is the smallest possible size at which a biological population can exist without facing extinction from natural disasters or demographic or environmental changes, or genetic drift.</rdfs:comment>
        <rdfs:label>minimum viable population</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14859"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MVP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14860 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14860">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area where an effluent discharge undergoes initial dilution and is extended to cover the secondary mixing in the ambient water body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>A mixing zone is an allocated impact zone where water quality criteria can be exceeded as long as acutely toxic conditions are prevented.</rdfs:comment>
        <rdfs:label>mixing zone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14861 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14861">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Elements of uncertainty associated with the discrepancy between the model and the real world.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>model error</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14862 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14862">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test designed to be applied on a routine basis, with some degree of control, to ensure that the quality of an environmental compartment, biological endpoint, or effluent has not exceeded some prescribed criteria range. In a biomonitoring test, organisms are used as &apos;sensors&apos; to detect changes in the quality of water or effluent. A monitoring test implies generation of information, on a continuous or other regular basis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>monitoring test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14537"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14863 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14863">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Officially the Protocol on Substances That Deplete the Ozone Layer, a treaty signed on 16 September 1987, in Montreal by 25 nations; there are now 168 subscribing nations. The protocol sets limits on the production of chlorofluorocarbons (CFCs), halons, and related substances that release chlorine or bromine to the ozone layer of the atmosphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Montreal protocol</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14523"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14864 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14864">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the interaction and adjustment of the seafloor topography and fluid hydrodynamic processes, seafloor morphologies, and sequences of change dynamics involving the motion of sediment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>morphodynamics</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14865 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14865">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Death rate, the number of dead individuals per unit time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Natality and mortality graphs together form a life table.</rdfs:comment>
        <rdfs:label>mortality</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14514"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14866 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14866">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ecotoxicological approach in which results for the most sensitive of all tested species are used as an indicator of the toxicant concentration below which the entire community is protected from adverse effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>most-sensitive-species approach</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14867 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14867">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of estimating \(\pu{LC_{50}}\), \(\pu{EC_{50}}\), or \(\pu{LD_{50}}\). It can be implemented with straightforward equations if the toxicant concentrations are set in a geometric series and there are equal numbers of individuals exposed in each treatment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>moving average method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14868 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14868">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Higher fitness of an individual as a composite or summed effect of heterozygote superiority (heterosis) at each of a series of loci.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>multiple heterosis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14869 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14869">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interaction between two or more species, giving fitness benefit to all the involved species, e.g., increased carrying capacity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Similar interactions within one species are called cooperation.</rdfs:comment>
        <rdfs:comment>Symbiosis is the form of mutualism leading to the closest spatial or physical association. The process may be obligate, meaning the involved species cannot survive alone. Examples include cleaner fish, pollination and seed dispersal, gut flora, and nitrogen fixation by fungi.</rdfs:comment>
        <rdfs:label>mutualism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14514"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14870 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14870">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model for risk assessment with four components—hazard identification, exposure assessment, dose–response assessment, and risk characterization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>NAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NAS paradigm of risk assessment</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This model is used for both human and ecological risk assessments.</rdfs:comment>
        <rdfs:label>National Academy of Sciences paradigm of risk assessment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14673"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14735"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14870"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14871 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14871">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Evolutionary theory, originally proposed by Darwin, of the preferential survival and reproduction of organisms better adapted to their environment as a result of genetic adaptation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>natural selection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14711"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14872 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14872">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Cosmic radiation emitted from stars and long-lived terrestrial radionuclides that are ubiquitously present in the Earth’s soils.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>natural radiation background</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14873 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14873">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aggregate of actively swimming animals in a body of water ranging from microscopic organisms to whales.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>nekton</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14874 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14874">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory of biological evolution (widely accepted since the 1920s) based on Darwin’s theory of natural selection but incorporating the theories of later biologists regarding genes, inheritance, and mutation, particularly those of Weismann and Mendel.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>neo-Darwinism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14845"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15134"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14875 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14875">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plant found newly in an area where it had not been recorded previously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>neophyte</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14876 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14876">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expected number of females to be produced during the lifetime of a newborn female as estimated with a life table.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>net reproductive rate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14877 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14877">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Group of conditions and resources, facilitating but limiting survival, growth, and reproduction of a defined group of organisms or species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The abiotic or physical environment is part of the niche because it influences how populations affect, and are affected by, resources and enemies.</rdfs:comment>
        <rdfs:comment>The niche influences how a population responds to the abundance of its resources and enemies.</rdfs:comment>
        <rdfs:comment>The niche is influenced by its inhabiting populations.</rdfs:comment>
        <rdfs:label>niche</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14539"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14706"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14878"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14973"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14878 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14878">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rapid use and preemption of resources by a species that exploits them to the exclusion or severe disadvantage of another species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>niche preemption</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14879 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14879">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term referring to the area which a species could physically inhabit.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This area is defined by suitable climate and available food sources appropriate to that species as well as other factors such as temperature and air or water pressure levels. The niche width often differs from the realized niche.</rdfs:comment>
        <rdfs:label>niche width</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14973"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14880 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14880">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Public acceptance of necessary provisions (e.g., waste incinerators) provided they do not affect the individual’s quality of life.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>NIMBY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIMBY principle</oboInOwl:hasRelatedSynonym>
        <rdfs:label>not in my backyard principle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14880"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NIMBY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14881 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14881">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nine aspects of evidence, defined by Bradford-Hill (1965), fostering the accuracy of linkage between a risk factor and disease: strength of association, consistency of association, specificity of association, temporal association, biological gradient (dose-response) in the association, biological plausibility, coherence of the association, experimental support of association, and analogy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>nine aspects of disease association</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14882 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14882">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scenario in which one assesses if the contaminants at the waste site pose, or will pose in the future, a risk if left alone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>&quot;no action&quot; alternative</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14883 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14883">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Effects that are dependent on the magnitude of the dose in excess of a threshold.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>nonstochastic health effects</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14884 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14884">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organisms that are not the intended targets of a particular use of a pesticide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>nontarget organisms</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14885 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14885">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Special case of the no-observed-effect level (NOEL), commonly used in aquatic toxicology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>NOEC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>When derived from a life-cycle or partial life-cycle test, it is numerically the same as the lower limit of the maximum acceptable toxicant concentration (MATC).</rdfs:comment>
        <rdfs:label>no-observed-effect concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14832"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14885"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NOEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14886 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14886">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum dose of a substance at which no specified response is observed in a defined population and under defined conditions of exposure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>NRL</oboInOwl:hasRelatedSynonym>
        <rdfs:label>no-response level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14886"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NRL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14887 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14887">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metameter equal to the normal equivalent deviation (NED). The resulting analysis of dose– or concentration-effect data with the normit metameter is often called normit analysis and is essentially equivalent to probit analysis.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>normit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15140"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14888 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14888">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in predator or grazer number through increased reproductive output, decreased mortality, or increased immigration in response to changes in prey or food densities.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>numerical response</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14889 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14889">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Partition coefficient for a compound between octanol and air. Like \(K_{\rm{ow}}\), it is a measure of lipophilicity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>octanol-air partition coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14890 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14890">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the solubility of a chemical in octanol to its solubility in water at equilibrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Measure of lipophilicity, used in the assessment of both the uptake and physiological distribution of organic chemicals and prediction of their environmental fate.</rdfs:comment>
        <rdfs:label>octanol-water partition coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14891 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14891">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Log2 classes (e.g., 1–2, 2–4, 4–8, 8–16, 16–32,... individuals) used in species-abundance curves and representing doubling of the numbers of individuals in a species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>octaves</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14892 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14892">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring nuclear reactors arising through biogeochemical processes approximately 1.8 billion years ago in Oklo (Gabon, Africa).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Oklo natural reactors</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14893 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14893">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing an environment having a low concentration of nutrients.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The term is usually used to describe bodies of water or soils with very low nutrient levels and low rates of biological production.</rdfs:comment>
        <rdfs:label>oligotrophic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14664"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14894 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14894">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of being oligotrophic. Obligate or facultative capacity to live in low-nutrient habitats.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>oligotrophy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14666"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14895 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14895">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that the ideal forager will obtain a maximum net rate of energy gain by optimally allocating its time and energy to the various components of foraging.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>optimal-foraging theory</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14896 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14896">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Optimal stress response involves a shift in the balance in energy allocation between somatic growth rate and longevity (survival) to optimize Darwinian fitness under stressful conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>optimal stress response</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14897 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14897">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the Earth’s atmosphere, mainly located in the lower portion of the stratosphere, approximately \(\pu{15\!-\! 35 km}\) above the Earth&apos;s surface, containing relatively high concentrations (a few micromoles per litre) of ozone (\(\ce{O3}\)) which is higher than concentrations in the lower atmosphere. The thickness varies seasonally and geographically.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ozonosphere</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ozone layer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14898 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14898">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Branch of science that deals with extinct and fossil humans, animals, and plants, or more generally with evidence of organic life during the geological past.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>palaeontology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14899 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14899">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Model or template. Body of concepts that, in a particular branch of science, has withstood rigorous testing, and is generally accepted by scientists working in that field as offering true explanations of fact and observation.Note: This usage is derived from the work of the philosopher T. S. Kuhn (1922–1996).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>paradigm</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14900 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14900">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Treatment in a toxicity test in which some, but not all, exposed individuals are killed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>partial kill</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14901 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14901">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequence of enzymatic or other reactions by which one biological material is converted to another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>pathway</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14902 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14902">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of the Earth made up of soils and where important soil processes are occurring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>pedosphere</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14903 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14903">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Of or relating to the open sea, as distinguished from the shallow water near the coast; dwelling on or near the surface of the open sea or ocean; oceanic. Now chiefly: (Ecology) designating, relating to, or inhabiting that region of the sea which consists of open water of any depth, away from or independent of both the shore and the sea floor (and so contrasted with the littoral and benthic regions).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>pelagic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14610"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14904 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14904">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average number of offspring per population member per time unit. Calculated from birth rate \(B\) and population size \(N\) as \[b = B/N\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>per capita birth rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14906"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14939"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14905 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14905">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Average number of deaths per population member per time unit. Calculated from death rate \(D\) and population size \(N\) as \[m = D/N\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>per capita death rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14906"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14939"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14906 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14906">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relative increase, \(r\), in the population per unit of time expressed per capita. \[r = b - m\] where \(b\) is per capita birth rate and \(m\) is per capita death rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>per capita rate of increase</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14904"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14907 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14907">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Matrix of algae, microbes, and detritus attached to submerged surfaces in aquatic ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>periphyton</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14456"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14581"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14908 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14908">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Inorganic substance that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>PIP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Some inorganic chemicals, like crocidolite asbestos, are persistent in almost all circumstances, but others, like metal sulfides, are persistent only in unreactive environments; sulfides can generate hydrogen sulfide in a reducing environment or sulfates and sulfuric acid in oxidizing environments. As with organic substances, persistence is often a function of environmental properties.</rdfs:comment>
        <rdfs:label>persistent inorganic pollutant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14908"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PIP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14909 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14909">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organic chemical that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>POP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bioaccumulative chemicals of concern (BCC)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>persistent organic pollutant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14470"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14909"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>POP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14910 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14910">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Life history.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>phenology</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14911 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14911">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The duration of illumination and darkness over a \(\pu{24\!\mbox{-}h}\) day.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>photoperiod</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14912 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14912">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that bioavailability is governed by the diffusion of the unionized form of an ionizable substance through the gastrointestinal lumen, as determined by \(\pu{p}K_{\rm{a}}\) and \(\rm{pH}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>pH-partition hypothesis</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14913 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14913">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Branch of biology that deals with phylogeny, especially with the deduction of the historical relationships between groups of organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>phylogenetics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14526"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14914"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15088"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14914 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14914">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pattern of historical relationships between species or other groups resulting from divergence during evolution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Palaeontology is important for understanding phylogeny. Without the fossils of the many groups of organisms now extinct, it could not be understood how present life forms are interrelated.</rdfs:comment>
        <rdfs:comment>Phylogenetic relationships are shown in diagrams (cladograms, phylogenetic trees, evolutionary trees).</rdfs:comment>
        <rdfs:comment>Phylogenetics, the science of phylogeny, is part of the larger field of systematics, also including taxonomy.</rdfs:comment>
        <rdfs:label>phylogeny</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14527"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14700"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14898"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15090"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14915 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14915">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Taxonomic rank at the level below Kingdom and above Class</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Formally, a phylum can be used for any biological domain, but traditionally it was always used for animals, whereas &quot;division&quot; was traditionally often used for plants, fungi, etc.</rdfs:comment>
        <rdfs:label>phylum</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14916 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14916">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in an organism, in response to changing conditions of the environment, which takes place without any irreversible disruptions of the given biological system and without exceeding normal (homeostatic) capacities of its response. Process by which an organism stabilizes its physiological condition after an environmental change.Note: If this process exceeds the homeostatic range, it becomes pathological and results in symptoms of disease (adverse effects).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>physiological adaptation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14917 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14917">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of cysteine-rich peptides in plants that are induced by and bind to metals. They can function in the regulation and detoxification of metals by plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>phytochelatin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14848"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14918 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14918">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Photosynthesizing organisms found in the plankton.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>phytoplankton</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14924"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14919 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14919">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Toxic to plants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>phytotoxic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14920 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14920">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measure of species evenness for a sample from a community. It is calculated from the following equation: \[{\rm{Pielouߴs}}\ J = \frac{H&apos;}{\log S}\] where \(H&apos;\) is the Shannon–Wiener diversity measure and \(S\) is the average species richness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Pielou’s &lt;i&gt;J&lt;/i&gt;</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15031"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15049"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14921 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14921">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Seals, sea lions, and walruses.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>pinnipeds</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14922 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14922">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feeding on fish.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>piscivorous</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14923 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14923">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feeding on plankton.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>planktivorous</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14924"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14924 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14924">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organisms living suspended in the water column and incapable of moving against water currents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>plankton</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14925 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14925">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Planktonic-dispersing larva that derives its nourishment by feeding in the plankton.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>planktotrophic larva</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14924"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14926 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14926">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>&apos;Cold-blooded organism&apos; (such as an amphibian, reptile, or fish) with a body temperature varying with, but usually slightly higher than, the temperature of its environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>ectotherm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>exotherm</oboInOwl:hasRelatedSynonym>
        <rdfs:label>poikilotherm</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14634"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14927 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14927">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Single emission source in a defined location.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>point source</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14928 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14928">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium and causing adverse effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>&quot;Undesirability&quot;, like toxicity, is concentration-dependent, low concentrations of most substances being tolerable or even essential in many cases.</rdfs:comment>
        <rdfs:comment>A primary pollutant is one emitted into the atmosphere, water, sediments, or soil from an identifiable source.</rdfs:comment>
        <rdfs:comment>A secondary pollutant is a pollutant formed by chemical reaction in the atmosphere, water, sediments, or soil.</rdfs:comment>
        <rdfs:comment>Pollutant should be distinguished from contaminant; the latter implies presence above background due to human activities; the former implies that the substance also is causing adverse effects.</rdfs:comment>
        <rdfs:label>pollutant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14929 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14929">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in tolerance to pollution resulting from species composition shifts in the community, acclimatization of individuals, and genetic changes in populations in the community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>PICT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pollution-induced community tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14418"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14929"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PICT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14930 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14930">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Means of measuring environmental quality, usually water quality, by determining the presence of indicator species, classified into three groups—sensitive, facultative, and tolerant. Each group is assigned an index value 1, 2, and 3, with the sensitive group having the highest index value. The number of species present from the list included in each group is identified in a representative environmental sample and the group index multiplied by the number of species in the group. The scores for each group are finally added to give the PTI for the environmental medium under consideration. The environmental quality is directly proportional to the value of the index.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>PTI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pollution tolerance index</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14930"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PTI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14931 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14931">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Control of a phenotypic trait by several genes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>polygenic control</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14932 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14932">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In ecology, any group of interacting and interbreeding organisms of the same species occupying a given area at the same time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14933 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14933">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total mass or weight of organisms in a population, given by the sum of the masses (or weights) of all the individual members of the population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population biomass</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14934 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14934">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Changes in the numbers of individuals in a population that repeatedly oscillate between periods of high and low density.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population cycle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14935 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14935">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of individuals divided by area (\(\pu{m-2}\)) or volume (\(\pu{m-3}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>PD</oboInOwl:hasRelatedSynonym>
        <rdfs:label>population density</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14935"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14936 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14936">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variations in time and space in the sizes and densities of populations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population dynamics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14937 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14937">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the variations in time and space in the sizes and densities of populations, and of the factors causing these variations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population ecology</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14938 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14938">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Variations over time in the size of a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population fluctuation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14939 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14939">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in population size \(\Delta N\) during a specified time period \(\Delta t\) \[\Delta N/\Delta t = (b - d)N\] where \(N\) is population size, \(b\) is per capita birth rate, and \(d\) is per capita death rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population growth rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14904"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14905"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14906"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14940 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14940">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diagrammatic illustration of the age structure of a population by depicting the youngest age class at the base and stacking successive age classes above it.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population pyramid</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14941 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14941">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total number of organisms in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>population size</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14942 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14942">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biodegradation test that simulates the continuous activated sludge (sewage treatment) system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>porous pot test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14943 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14943">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to risk management that can be applied in circumstances of scientific uncertainty, reflecting a perceived need to take action in the face of a potentially serious risk without waiting for definitive results of scientific research.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>precautionary principle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14944 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14944">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance likely to be found in an environmental compartment calculated from estimates of quantities released, discharge patterns, and inherent disposition of the substance (fate and distribution) as well as the nature of the specific receiving ecosystems.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>PEC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>estimated environmental concentration (EEC)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>expected environmental concentration (EEC)</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>EEC models for pesticides assume a maximum number of applications per growing season at the maximum rate of application according to the application methods stated on the product label.</rdfs:comment>
        <rdfs:label>predicted environmental concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14537"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14944"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14945 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14945">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration that is expected to cause no adverse effect to any naturally occurring population in an environment at risk from exposure to a given substance.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>PNEC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>predicted no-effect concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14945"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PNEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14946 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14946">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Risk assessment performed for a proposed future action, such as the use of a new chemical or the release of a new effluent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>prospective risk assessment</oboInOwl:hasRelatedSynonym>
        <rdfs:label>predictive risk assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14947 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14947">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of instances of existing cases of a given disease or other condition in a given population at a designated time; sometimes used to mean prevalence rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>When used without qualification, refers usually to the situation at a specified time (point prevalence).</rdfs:comment>
        <rdfs:label>prevalence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14948"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14948 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14948">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total number of individuals who have an attribute or disease at a particular time (or during a particular period) divided by the population at risk of having the attribute or disease at this point in time or midway through the period.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>prevalence ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:label>prevalence rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14949 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14949">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Gill structures extending outward at right angles from the branchial arches.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>filaments</oboInOwl:hasRelatedSynonym>
        <rdfs:label>primary lamellae</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14950 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14950">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism capable of using the energy derived from light or a chemical substance in order to manufacture energy-rich organic compounds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>primary producer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14951 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14951">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequential colonization by species which begin to colonize the bare ground and modify the environmental conditions after a region is completely denuded; e.g., behind a retreating glacier, early colonizing organisms provide the soils needed by succeeding organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>primary succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14952 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14952">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concept that there exists a cost or trade-off to every allocation of energy resources. Energy spent by an individual organism on one function, process, or structure cannot be spent on another. Optimal allocation of resources enhances Darwinian fitness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>concept of strategy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>principle of allocation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14953 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14953">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability unit obtained by adding 5 to the normal deviates of a standardized normal distribution of results from a dose-response study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>A plot of probit against the logarithm of dose or concentration gives a linear plot if the response follows a logarithmic normal distribution. Estimates of the \(\pu{LD_{50}}\) and \(\pu{ED_{50}}\)) (or \(\pu{LC_{50}}\) and \(\pu{EC_{50}}\)) can be obtained from this plot.</rdfs:comment>
        <rdfs:comment>Addition of 5 removes the complication of handling negative values.</rdfs:comment>
        <rdfs:label>probit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14954"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14954 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14954">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability unit obtained from the standardized normal distribution plotted against the logarithm of the concentration or dose of a substance when a quantal or graded response has been measured. A linear plot provides evidence that the distribution is log-normal. Estimates of the \(\pu{L(E)C_{50}}\) and \(\pu{L(E)D_{50}}\), as well as the standard deviation for the distribution, can then be made.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>probit log transform</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14722"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14965"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14955 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14955">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Planning and scoping phase that establishes the framework around which the risk assessment is done.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>problem formulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14956 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14956">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonparametric method for analyzing time-to-death or survival-time data that does not require a specific model for the survival curve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>Kaplan–Meier method</oboInOwl:hasRelatedSynonym>
        <rdfs:label>product-limit method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14957 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14957">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Multiplication, i.e., an increase by frequent and repeated reproduction or growth by cell division.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>proliferation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14958 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14958">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of a plant, fungus, etc., that is capable, when detached, of giving rise to a new individual by asexual reproduction (e.g., a cutting, leaf bud, bulbil, seed, or spore). Less commonly, any of the products of asexual reproduction in certain invertebrates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>propagule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14959 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14959">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relative to metapopulation dynamics, the presence of a seed bank or dormant stage for a species that continually introduces individuals to the patch regardless of the density of occupancy in the surrounding patches. This propagule rain increases the likelihood of population reappearance and decreases the likelihood of patch extinction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>propagule rain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14850"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14960 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14960">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>False assertion that any particular level of biological organization holds a more central or important role than any other in the science of ecotoxicology.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Ptolemaic incongruity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14961 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14961">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing anything that causes fire. Describing products of fire; e.g., organic compounds produced by the high-temperature combustion of complex organic substances are pyrogenic compounds.Examples: Polycyclic aromatic hydrocarbons (PAHs) are examples of pyrogenic compounds. Describing a substance that produces fever.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>pyrogenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14962 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14962">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quality guidelines based on the evaluation of scientific data.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>quality criteria</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14963"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14963 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14963">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Numerical limits or text statements established to support and maintain designated uses of the environment or to protect human health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>quality guidelines</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14964 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14964">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fixed upper limits for exposure to certain chemicals recognized under law by one or more levels of government. Well-known examples include the air, water, and soil quality standards, as well as threshold limit values for air pollutants in the workplace.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>quality standards</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14965 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14965">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition that can be expressed only as &apos;occurring&apos; or &apos;not occurring&apos;, such as death or occurrence of a tumor.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>all-or-none effect</oboInOwl:hasRelatedSynonym>
        <rdfs:label>quantal effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14722"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14966 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14966">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative association between the physicochemical and (or) the structural properties of a substance and its metabolic behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>QSMR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>quantitative structure–metabolism relationship</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14966"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>QSMR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14967 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14967">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Calculation of the quotient of the measured or predicted environmental concentration (PEC) of a contaminant and the predicted no-effect level (PNEC), used as an expression of hazard or risk. Higher quotients constitute greater evidence of a hazard or a greater risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>quotient method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14737"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14945"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14968 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14968">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Removal of pollutants from air by incorporation into developing rain droplets of rain clouds.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>rain-out</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14969 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14969">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of species richness (\(S\)) expressed relative to that of a sample having a standard number of individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>rarefaction estimate of richness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14970 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14970">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Compartment model that employs rate constants to quantify the rate of change in concentration or amount of toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>rate constant-based model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14537"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14971 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14971">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that the total metabolic expenditure of a genotype is generally fixed, and longevity depends on the rate of energy expenditure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>rate-of-living theory of aging</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14972 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14972">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Value obtained by dividing the rate in an exposed population by the rate in an unexposed population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>RR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>rate ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14972"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14973 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14973">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of a species’ fundamental niche that it actually occupies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The realized niche is narrower than the fundamental niche due to pressure from, and interactions with, other organisms (e.g., superior competitors).</rdfs:comment>
        <rdfs:label>realised niche</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14747"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14877"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14974 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14974">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semiquantitative term referring to the lower portion of the high end of the exposure, dose, or risk distribution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>reasonable worst case</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14975 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14975">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Highest exposure that is reasonably expected to occur.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>RME</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Typically, the \(\pu{95\%}\) upper confidence limit of the toxicant distribution is used: if only a few data points (\(\pu{6\!{-}\! 10}\)) are available, the maximum detected concentration is used.</rdfs:comment>
        <rdfs:label>reasonable maximum exposure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14975"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RME</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14976 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14976">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Surface water (e.g., in a stream, river, or lake) that has received, or is about to receive, a discharged waste (i.e., the surface water immediately around the discharge point).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>receiving water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14977 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14977">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum concentration of a potentially toxic substance that is expected to be safe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Such limits are rarely defined as legal limits to be enforced. They are analogous to guidelines, which have only advisory status.</rdfs:comment>
        <rdfs:label>recommended limit</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14978 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14978">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>De-ionized or glass-distilled water to which reagent-grade chemicals have been added. The resultant synthetic freshwater is expected to be free from contaminants and have the desired \(\rm{pH}\) and hardness characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>reconstituted water</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14979 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14979">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that many species are redundant, and their loss will not influence the community function as long as crucial (e.g., keystone and dominant) species populations are maintained.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>redundancy hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14980 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14980">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generalized description of the environment into which contaminants will be released and in which organisms will be exposed. Reference environments are used when there is no specific site at risk.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>reference environment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14981 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14981">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Whole sediment near an area of concern used to assess sediment conditions in the absence of substances of concern.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Such sediment is collected near a site of concern and should represent the background conditions.</rdfs:comment>
        <rdfs:label>reference sediment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14982 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14982">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relatively unpolluted site used for comparison with polluted sites in environmental monitoring studies, often incorrectly referred to as a control site.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>reference site</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14983 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14983">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical used in an aquatic toxicity test as a positive control in contrast to the negative control provided by exposure water without the test chemical. Information collected is used to determine the general health and viability of the test organisms and assess consistency in testing protocol implementation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>In this definition, the term &quot;positive control&quot; is used to describe a procedure that is very similar to the actual experimental test and that is known from previous experience to give a positive result.</rdfs:comment>
        <rdfs:label>reference toxicant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14984 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14984">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test conducted in conjunction with sediment tests to determine possible changes in condition of the test species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Deviations from an established normal range indicate a change in the condition of the test organism population. Reference toxicant tests are most often acute lethality tests performed in the absence of sediment.</rdfs:comment>
        <rdfs:comment>Sediment spiked with a toxicant might also be included as a positive control for the sediment toxicity test.</rdfs:comment>
        <rdfs:label>reference toxicity test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14985 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14985">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of the Earth’s surface differentiated by its specific characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>region</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14986 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14986">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the risk of disease or death among the exposed to the risk among the unexposed. Ratio of the cumulative incidence rate in the exposed to the cumulative incidence rate in the unexposed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>RR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>risk ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:label>relative risk</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14986"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14987 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14987">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study that has three parts: characterization or the type and degree of the contamination, human risk assessment, and ecological risk assessment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>RI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>remedial investigation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14987"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14988 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14988">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an EPA Superfund site, a study that has as its goal the implementation of &apos;remedies that reduce, control, or eliminate risks to human health and the environment&apos; or, more specifically, the accumulation of &apos;information sufficient to support an informed risk management decision regarding which remedy appears to be most appropriate for a given site&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>RI/FS</oboInOwl:hasRelatedSynonym>
        <rdfs:label>remedial investigation and feasibility study</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.14988"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RI/FS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14989 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14989">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Giving a remedy. Removal of pollution or contaminants from environmental media such as soil, groundwater, sediment, or surface water for the general protection of human health and the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>remediation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14990 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14990">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technologies that allow the acquisition and analysis of data without requiring physical contact with the land or water surface being studied. Most determine qualities or characteristics of areas of interest based on measurements of visible light, infrared radiation, or radio energy coming from them.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>remote sensing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14991 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14991">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expected contribution of offspring during the life of an individual of an age class \(x\) in a life table.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>reproductive value</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14798"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14992 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14992">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increased probability of a vacated-patch reoccupation in a metapopulation as the number of nearby, occupied patches increases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>rescue effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14850"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14993 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14993">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a community to maintain its structure and function in the face of disturbance, and to reorganize following disturbance-driven change.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>resilience</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14994 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14994">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Observed effect of the properties of persistent organic pollutants (POPs) with high lipophilicity which causes them to be bound more firmly than less lipophilic POPs in solid phases such as soil and vegetation; consequently, they spend less time in the atmosphere and are less available for transport in that medium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>retention effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14909"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14995 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14995">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Risk assessment dealing with an existing condition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>retroactive risk assessment</oboInOwl:hasRelatedSynonym>
        <rdfs:label>retrospective risk assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14996 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14996">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Part of an external quality assurance program for assessment of an analytical method or test. A reference institute sends identical samples, which have to be analyzed or tested for specified parameters, to a number of different laboratories. The laboratory has a deadline before which to provide results. Statistical evaluation and interpretation of the results permits assessment of the reliability of the methods used and a comparison of the laboratories’ proficiency.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>round-robin test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>For accreditation of laboratories, regular participation in ring tests is obligatory, but accreditation is not essential for participation in the tests.</rdfs:comment>
        <rdfs:label>ring test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14997 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14997">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interface between land and a flowing body of surface water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Plant communities along river margins are called riparian vegetation.</rdfs:comment>
        <rdfs:label>riparian</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14998 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14998">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process for controlling situations where an organism, system, or subpopulation could be exposed to a hazard.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The risk analysis process consists of three components: risk assessment, risk management, and risk communication.</rdfs:comment>
        <rdfs:comment>The term is misleading since &quot;analysis&quot; has the fundamental meaning &quot;resolution or breaking up of anything complex into its various simple elements, the opposite process to synthesis; the exact determination of the elements or components of anything complex (with or without their physical separation)&quot;. The usage defined here originates with the WHO Joint Expert Committee on Food Additives and has been accepted in this context in spite of objections from terminologists.</rdfs:comment>
        <rdfs:label>risk analysis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.14999 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.14999">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Outcome of hazard identification and risk estimation applied to a specific use of a substance or occurrence of an environmental health hazard.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Risk characterization requires quantitative data on the exposure of organisms or people at risk in the specific situation. The end product is a quantitative statement about the proportion of organisms or people affected in a target population.</rdfs:comment>
        <rdfs:label>risk characterisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14735"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15000 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15000">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clear statements of postulated or predicted adverse effects of a toxicant on an assessment endpoint.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>risk hypotheses</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14451"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15001 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15001">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Agent, medium, process, procedure, or site with the potential to cause an adverse effect or effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>risk source</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15002 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15002">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of predicted exposure concentration (PEC) to predicted no-effect concentration (PNEC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The higher this value is above one, the greater the risk. If the value is below one, there should be no risk as a result of the predicted exposure.</rdfs:comment>
        <rdfs:label>risk quotient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14944"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14945"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15003 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15003">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Taking measures to protect humans or the environment against identified risks.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>risk reduction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15004 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15004">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that each species in a community contributes to its proper functioning.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Derived from the metaphor that the species can be compared to rivets that hold an airplane together, and the loss of each rivet weakens the structure.</rdfs:comment>
        <rdfs:label>rivet popper hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15005 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15005">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Opportunistic strategy favoring species that establish themselves quickly, grow quickly to exploit as many resources as possible, and produce many offspring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>r-strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15006 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15006">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fox’s rules of practical causal inference that are used in ecotoxicology (environmental epidemiology) to infer causality for toxicant exposure/effect scenarios.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The rules apply the following criteria for objectively evaluating the relationship between a suspect cause and a chronic effect: (1) probability, (2) time order, (3) strength of association, (4) specificity, (5) consistency on replication, (6) predictive performance, and (7) coherence.</rdfs:comment>
        <rdfs:label>rules of practical causal inference</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15007 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15007">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Portion of the wet precipitation on the land that ultimately reaches streams and, eventually, the sea.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>run-off</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15008 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15008">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance to which prolonged exposure will cause no adverse effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>safe concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15009 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15009">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of dissolved salts in seawater, brackish water, brine, or other saline solution divided by the mass of the solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Before 1978, the usual unit for \(S\) expressed as a mass fraction was permil (no longer recommended), now usually in units \(\pu{g kg-1}\) or expressed as \(\pu{g kg-1}\) without the units given explicitly.</rdfs:comment>
        <rdfs:comment>In oceanography, where precise and reproducible determination of seawater density is of interest, practical salinity, \(S\), is defined in terms of the ratio \(k_{15}\) of the electrical conductivity of the seawater sample at \(\pu{15^{\circ}C}\) and \(\pu{1 atm}\) (\(\pu{1.01325 kPa}\)) to that of a potassium chloride (\(\ce{KCl}\)) solution, in which the mass fraction of \(\ce{KCl}\) is \(\pu{32.4536E-3}\) at the same temperature and pressure.</rdfs:comment>
        <rdfs:comment>In practice, this quantity cannot be measured directly in seawater or other natural waters because of the difficulty of drying the salts from these waters. Salinity is usually calculated from another property (e.g., chlorinity, electrical conductivity) whose relationship to salinity is well known.</rdfs:comment>
        <rdfs:label>salinity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14522"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15010 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15010">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quotient calculated as total plant (shoot + root) dry mass at different salt concentrations compared to the total plant dry mass obtained for the controls, as indicated below: \[S_{\rm{T}} = m_{\rm{d}}({\rm{x}})/m_{\rm{d}}({\rm{i}})\] where \(m_{\rm{d}}\) is the total dry mass, and \(x\), \(i\) refer to a control treatment and a defined salt treatment, respectively.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>STI</oboInOwl:hasRelatedSynonym>
        <rdfs:label>salt tolerance index</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15010"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15011 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15011">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Living in or being an environment rich in organic matter but lacking oxygen.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>saprobic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15012 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15012">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Means of classifying the saprobic state of running waters, covering the full range from unpolluted to extremely polluted waters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>saprobic index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15011"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15013 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15013">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biological classification of water quality according to five categories: oligosaprobic: clear, with no or only slight pollution and high dissolved oxygen (DO) content; p-mesosaprobic: moderately polluted with still high DO content; x-mesosaprobic: polluted with not very high DO content; polysaprobic: strongly polluted, with negligible DO content; and antisaprobic: so polluted that no living organism is capable of living in the water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>saprobic water classification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15014 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15014">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristic change in community composition at different distances below the discharge of putrescible organic waste to a river or stream.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>saprobien spectrum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15015 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15015">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organisms or groups of organisms treated in a similar fashion to those in standard toxicity tests for the purpose of special additional studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>satellite groups</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15016 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15016">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Index (\(P\) = production) calculated as the amount of energy taken into the organism in its food (\(A\)) minus the energy used for respiration (\(R\)) and excretion (\(U\)): \[P = A - R - U\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>It is an indicator of the amount of energy available for growth or production of offspring.</rdfs:comment>
        <rdfs:label>scope for growth</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15017 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15017">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference between the rates of oxygen consumption of an organism under maximal and minimal activity levels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>It reflects the respiratory capacity available for the diverse demands on and activities of an organism.</rdfs:comment>
        <rdfs:label>scope of activity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15018 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15018">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decision limit or cut-off point at which a screening test is regarded as positive.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>screening level</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15019 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15019">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test conducted to estimate the concentrations to be used for a definitive test. Acute test used early in a testing program to evaluate the potential of a substance to produce a given adverse effect (e.g., mortality).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>preliminary test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>range-finding test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>screening test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14865"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15020 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15020">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Parallel rows of projections on the dorsal and ventral sides of each primary lamella of the fish gill. They are the primary sites of gas exchange of the gills.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>respiratory lamellae</oboInOwl:hasRelatedSynonym>
        <rdfs:label>secondary lamellae</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15021 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15021">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Poisoning of a predator as a result of eating prey that has accumulated a toxicant as a result of biomagnification through its food chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>secondary poisoning</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14484"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15022 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15022">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Microbial growth on a nutrient substrate while transforming another substrate without gaining energetic benefit.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Although it must occur, secondary substance metabolism is very difficult to demonstrate in nature, but it can be demonstrated in pure cultures.</rdfs:comment>
        <rdfs:label>secondary substrate metabolism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14530"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15023 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15023">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sequential appearance of species following major changes to an established ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Catastrophic weather events, fire, or human activities all disturb the environment. After such an event on land, well-developed soil remains, giving pioneer species an easy foothold; similar changes occur in abandoned agricultural areas.</rdfs:comment>
        <rdfs:label>secondary succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15077"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15024 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15024">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Components of the life cycle of an individual upon which natural selection can act. They are viability selection, sexual selection, meiotic drive, gametic selection, and fecundity selection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>selection components</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14708"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14842"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15030"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15124"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15025 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15025">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Syndrome named for Hans Selye (1907–1982) that consists of all the nonspecifically induced changes within a biological system following and during environmental stress.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Selyean stress</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15026 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15026">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Species that reproduces once.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>semelparous species</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15027 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15027">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test for inherent biodegradability of organic substances in activated sludge by measurement of the decrease in dissolved oxygen content (DOC) in the test system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>SCAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCAS test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>semi-continuous activated sludge test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14596"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15028 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15028">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Feral, caged, or endemic species used in measuring and indicating the level of contamination or effect during a biomonitoring exercise.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>sentinel species</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15029 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15029">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Minute living organisms and particles of nonliving matter that float in water and contribute to turbidity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>seston</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15030 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15030">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Natural selection involving differential mating success of individuals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>sexual selection</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15031 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15031">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Index based on the assumption that all species are represented in the sample studied and that the sample was obtained randomly, giving the following mathematical relationship: \[H = -\sum \limits_{i=1}^S p_{i} \log p_{i}\] where \(p_{i}\) is the fraction of individuals belonging to the \(i\)-th species and \(S\) is the number of species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The Shannon index is affected by both the number of species and their equitability, or evenness. Both a greater number of species and a more even distribution increase diversity as measured by \(H\).</rdfs:comment>
        <rdfs:comment>The most important source of error in this index is failure of sampling to include all species from the community of interest.</rdfs:comment>
        <rdfs:label>Shannon–Wiener diversity index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14599"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15032 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15032">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Species’ tolerance(s) along an environmental gradient (or series of environmental gradients) will determine its population distribution and size in the environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Shelford’s law of tolerance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15033 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15033">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sediment particles with a grain size between \(\pu{0.004 mm}\) and \(\pu{0.062 mm}\), i.e., coarser than clay particles but finer than sand.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>silt</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15034 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15034">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dominance index weighted toward the abundance of the most common species, giving the probability of any two individuals drawn at random from an infinitely large community belonging to different species. The bias corrected mathematical form of Simpson’s index is \[D = \sum \limits_{i=1}^{S} p_{i}^{2}\] where \(p_{i}\) is the fraction of all organisms which belong to the \(i\)-th species and \(S\) is the number of species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Since \(D\) and diversity are negatively related, Simpson’s index is usually expressed as either a reciprocal or a complementary form (\(1/D\) or \(1 - D\)) so that as the index goes up, so does measure of diversity.</rdfs:comment>
        <rdfs:label>Simpson’s diversity index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14599"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15035 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15035">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental ecosystem that should be: physically confined; self-maintaining; multitrophic; have a duration time exceeding the generation time of the penultimate trophic level present; and of size sufficient to enable pertinent sampling and measurements to be made without seriously influencing the structure and dynamics of the system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>simulated field studies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15036 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15036">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Naturally occurring, unconsolidated mineral and (or) organic material at the surface of the Earth that is capable of supporting plant growth. It extends from the surface to \(\pu{15 cm}\) below the depth at which properties produced by soil-forming processes can be detected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Soil formation results from an interaction between climate, living organisms, and surface relief acting on soil parent material.</rdfs:comment>
        <rdfs:comment>Unconsolidated material includes material cemented or compacted by soil-forming processes. Soil may have water covering its surface to a depth of \(\pu{60 cm}\) (or less in the driest part of the year).</rdfs:comment>
        <rdfs:label>soil</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15037 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15037">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Movement of a solute (e.g., a contaminant) along with the bulk movement of the solvent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>solvent drag</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15038 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15038">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Death of an individual organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>somatic death</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15039 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15039">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Risk of an adverse effect to the exposed individual associated with genetic damage to somatic cells, e.g., damage leading to cancer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>somatic risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15040 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15040">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Noncommittal term used instead of adsorbate or absorbate when the sorption process is undefined.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>sorbate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14413"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15041 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15041">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantity describing the distribution of a substance between a solvent and a sorbent, typically water and sediment, at equilibrium, e.g., \[K_{\rm{d}} = [\pu{C(sediment)}]/[\pu{C(water)}]\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>sorption constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15042 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15042">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Estimate of the total amount released, or the temporal pattern of the rate of release, of a pollutant from a source.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>source term</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15043 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15043">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Nonparametric method to estimate the \(\pu{LC_{50}}\), \(\pu{EC_{50}}\), or \(\pu{LD_{50}}\) when it is difficult or unnecessary to assume a specific model for the dose- or concentration effect data.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Spearman–Karber method</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15044 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15044">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Common pattern in which the number of species on islands decreases as island area decreases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species–area relationship</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15045 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15045">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Operationally defined subset of the entire community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species assemblage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15046 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15046">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tendency in a model community for the remaining species to remain at locally stable equilibria after a species is made extinct.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species–deletion stability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15047 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15047">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative or qualitative differences of response to the action(s) of a potentially toxic substance on various species of living organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species differences in sensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15048 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15048">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heterogeneity of an ecological community, considering both species richness (\(S\)) and species evenness.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species diversity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15049"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15051"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15049 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15049">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Degree to which the individuals in the community are evenly or uniformly distributed among species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species evenness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15050 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15050">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in the species numbers or diversity in an ecosystem, or in their interactions, which results in change in ecological character and its functions and attributes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species imbalance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14614"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15051 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15051">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total number of species in an ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This index makes no use of relative abundances.</rdfs:comment>
        <rdfs:label>species richness</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14479"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15052 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15052">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Statistical relationship between exposure concentration and a defined effect derived from a combination of single-species test data to predict concentrations affecting only a certain percentage of the total number of species in a defined community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>SSD</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Single-species data [e.g., median lethal concentration (\(\pu{LC_{50}}\)) or no-observed-effect concentration (NOEC) values] for many species are fitted to a distribution relationship such as the log-normal or log-logistic curve. From this distribution of species sensitivities, a hazardous concentration (\(\pu{HC_{\textit{p}}}\)) is identified at which a certain percentage (\(p\)) of all species is likely to be affected. The most conservative form of this approach uses the lower \(\pu{95\%}\) tolerance limit of the estimated percentage to ensure that the specified level of protection is achieved</rdfs:comment>
        <rdfs:label>species sensitivity distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14738"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14885"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15052"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SSD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15053 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15053">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative and qualitative features of response to the action(s) of a potentially toxic substance that are characteristic for a particular species of living organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>species-specific sensitivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15054 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15054">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Assumption made in radiotracer usage concerning specificity of action of a radionuclide used to trace or quantify the movement of a stable nuclide (e.g., \(\ce{^{14}C}\) for stable \(\ce{C}\)), implying that the radionuclide behaves identically in chemical and biological processes to its nonradioactive analog (e.g., stable \(\ce{C}\)).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>specific activity concept</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Sometimes confusingly called the &quot;specific activity concept&quot;.</rdfs:comment>
        <rdfs:label>specific action concept</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15055 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15055">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sediment toxicity test method to generate a concentration response model for effects to individuals placed in sediments spiked with different amounts of toxicant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>SB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SB approach</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The method may also be used to test hypotheses regarding the mechanism of production of previously observed effects.</rdfs:comment>
        <rdfs:label>spiked bioassay approach</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15055"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15056 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15056">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Hypothesis that toxic effects of metals will begin to occur after the metal concentration exceeds the capacity of the amount of metallothionein present to bind the metal. The unbound metals then &apos;spill over&apos; to interact at sites of adverse action. This is based on the assumption that binding by metallothionein sequesters toxic metals away from sites of action.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>spillover hypothesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15057 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15057">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Abundance of relative age classes that a population approaches if it is allowed to grow exponentially.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stable age distribution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14415"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15058 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15058">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Population with a constant distribution of individuals among the various age classes and a zero growth rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Stable populations do not change in size over time if environmental conditions do not change.</rdfs:comment>
        <rdfs:label>stable population</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15059 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15059">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>That which is established as a measure or model to which others of a similar nature should conform.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14645"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15060 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15060">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technical specification, usually in the form of a document available to the public, drawn up with the consensus or general approval of all interests affected by it, based on the consolidated results of science, technology, and experience, aimed at the promotion of optimum community benefits and approved by a body recognized on the national, regional, or international level.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>technical directive</oboInOwl:hasRelatedSynonym>
        <rdfs:label>standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15061 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15061">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Modified static aquatic toxicity test in which solutions are completely or partially replaced with new solutions at set periods during exposures or in which organisms are periodically transferred to new solutions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>batch-replacement test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>renewal test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>renewed static test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>semi-static test</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>static-replacement test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>static-renewal test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15062 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15062">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aquatic toxicity test in which the exposure water is not changed during the test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>static-toxicity test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15063 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15063">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which materials form or are deposited in layers, as in sedimentary rocks and some igneous rocks. The atmosphere and the ocean also exhibit stratification, with the warmer air or water occupying the upper layers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stratification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15064 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15064">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sampling of individual subgroups (strata) of a population after its division into homogeneous strata.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stratified sampling</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15065 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15065">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any condition that results in reduced growth of an organism or that prevents an organism from realizing its &apos;genetic potential&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stress</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15066 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15066">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Any physical, chemical, or biological factor causing an adverse response on any component of an ecosystem.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stressor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15067 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15067">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proposed use of the patterns of stress-protein induction seen in the field to suggest the particular toxicant inducing the response, after patterns from organisms sampled in the field are compared with those obtained with single-candidate toxicants in the laboratory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stress-protein fingerprinting</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15068 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15068">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Several classes of proteins coded by genes transcriptionally activated by acute stresses, generally serving a protective or adaptive function.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Stressors include physical agents such as heat and radiation, infection and inflammation, oxidative stress and hypoxia, desiccation and starvation, metals, xenobiotics, etc.</rdfs:comment>
        <rdfs:comment>These proteins include chaperones such as the heat shock proteins, enzymes protective against oxidative stress, metallothioneins, etc.</rdfs:comment>
        <rdfs:label>stress proteins</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15069 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15069">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that stress shortens longevity by accelerating energy expenditure. Selection takes place for resistance to stress, and as an epiphenomenon, individuals resistant to stress will predominate in extreme age classes of a population. The diminution of homeostasis under stress with age should be slowest in individuals with highest longevity.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stress theory of aging</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14744"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14971"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15070 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15070">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Range of types of physical structure in a community that may provide habitats for species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>structural diversity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14728"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15071 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15071">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Association between the physicochemical and (or) the structural properties of a substance and its metabolic behavior.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>SMR</oboInOwl:hasRelatedSynonym>
        <rdfs:label>structure–metabolism relationship</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15071"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SMR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15072 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15072">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Biodegradation test based on the measurement of \(\ce{CO2}\) production.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Sturm test</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15073 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15073">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that lives only in groundwater.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stygobiont</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15074 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15074">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organism that lives in groundwater and in surface water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>stygophile</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15075 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15075">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term applied to a substance that is a liquid at a temperature lower than the saturation temperature for the existing pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Sometimes such a substance is described as a &quot;compressed&quot; liquid since the existing pressure is greater than the saturation pressure for the given temperature.</rdfs:comment>
        <rdfs:label>subcooled</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15076 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15076">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Vapor pressure of a subcooled liquid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>This physicochemical property is an important factor in determining the fate of chemicals in the environment and in allowing for the effects of environmental temperature variability.</rdfs:comment>
        <rdfs:label>subcooled liquid vapour pressure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15075"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15077 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15077">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Orderly sequential progression of changes in community composition that occurs during development of new populations in any area, from initial colonization to the attainment of the climax typical of a particular geographic area.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>succession</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14437"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14457"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14459"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14528"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14742"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14951"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15023"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15078 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15078">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term describing a substance that persists as a liquid at a temperature below its freezing point without solidification or crystallization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>supercooled</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15079 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15079">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Test organism, or population that is cultured under laboratory conditions to serve as a substitute in toxicity testing for indigenous organisms, communities, or populations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>surrogate organism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15080 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15080">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relatively well-studied substance whose properties are assumed to apply to an entire chemically and toxicologically related class.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>surrogate toxicant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15081 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15081">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systematic ongoing collection, collation, and analysis of data and the timely dissemination of information to those who need to know in order that action can be taken to initiate investigative or control measures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>surveillance</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15082 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15082">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time interval between initial exposure of an organism to a harmful substance and death.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>survival time</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15083 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15083">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion of animals surviving between two specified ages.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>survivorship</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15084 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15084">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graph showing how survivorship from birth varies with age.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>survivorship curve</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15085 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15085">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Condition of an organism or ecological system that makes it more vulnerable to a given exposure than the majority of the population or group of ecological systems to which it belongs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Susceptibility is inversely proportional to the magnitude of the exposure required to cause a toxic effect.</rdfs:comment>
        <rdfs:label>susceptibility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15086 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15086">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal that feeds by straining suspended matter and food particles from water, typically by passing the water over a specialized structure, such as the baleen of baleen whales.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>filter feeder</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Other types of feeder are deposit feeder, fluid feeder, and food-mass feeder.</rdfs:comment>
        <rdfs:comment>Some animals that use this method of feeding are clams, barnacles, krill, mysids, sponges, whale sharks, and flamingoes.</rdfs:comment>
        <rdfs:label>suspension feeder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14575"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14697"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14699"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15087 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15087">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Describing mineral deposits formed at the same time as the enclosing rocks; characterized by or pertaining to a formation contemporaneous with the enclosing or surrounding rock.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>syngenetic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15088 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15088">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study of the diversity of past and present life forms and of relationships among them through time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>taxonomy</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Relationships are visualized in cladograms (evolutionary trees, phylogenetic tree phylogenies). Systematics is used to understand the evolutionary history of life on Earth.</rdfs:comment>
        <rdfs:label>systematics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14527"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14667"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14913"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15089 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15089">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Taxonomically defined subset of an entire community.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>taxocene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15090"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15090 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15090">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science applied to the allocation of biological names and the rules of naming.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Classification (systematics) is the process of rank ordering of taxa according to presumptive evolutionary (phylogenetic) relationships.</rdfs:comment>
        <rdfs:label>taxonomy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14913"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15088"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15091 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15091">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capable of causing nonheritable permanent structural malformations or defects in the offspring of an exposed parent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>teratogenic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15092 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15092">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to land, as distinct from water or air.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>terrestrial</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15093 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15093">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration calculated as the geometric mean of no-observed-effect concentration (NOEC) and lowest-observed-effect concentration (LOEC).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TEC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>&quot;Chronic&quot; or &quot;subchronic&quot; may be added as qualifiers dependent on the duration of exposure in the test.</rdfs:comment>
        <rdfs:comment>The TEC is equivalent to the maximum acceptable toxicant concentration (MATC) used in some countries.</rdfs:comment>
        <rdfs:label>threshold-effect concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14820"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14832"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14885"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15093"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15094 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15094">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory that, for a given substance, no toxic effect can occur below a defined low dose.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>threshold theory</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15095 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15095">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Structured approach to assessment of the fate and effects of substances, where a tier of relatively simple tests is used initially to select substances of concern and to define their toxicity. If the information from these tests is inadequate for regulatory decisions, further more complex tests (higher tier tests) may be required. For example, under a tiered structure, testing might progress from acute studies to chronic laboratory studies to field studies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>tiered testing</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15096 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15096">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acute toxicity test with no predetermined temporal endpoint.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TI test</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This type of test, sometimes referred to as a &quot;threshold&quot; or &quot;incipient&quot; lethality test, is allowed to continue until acute toxicity (mortality or a defined sublethal effect) has ceased or nearly ceased and the toxicity curve (median survival time vs. test material concentration) indicates a threshold or incipient concentration. With most test materials, this point is reached within \(\pu{7\!-\! 10 d}\), but it may not be reached within \(\pu{21 d}\). Practical or economic reasons may dictate that the test be stopped at this point and a test be designed for longer duration.</rdfs:comment>
        <rdfs:label>time-independent test</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15096"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15097 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15097">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quotient of an adequate parameter acquired under treated and control environments, multiplied by \(\pu{100}\), thus: \[\rm{TI} = (\rm{parameter\ treated}/\rm{parameter\ control}) \times 100\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TI</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>This index was originally defined in terms of root growth.</rdfs:comment>
        <rdfs:label>tolerance index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14432"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14930"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15010"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15097"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15098 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15098">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at community and ecosystem levels of organization rather than the suborganismal levels of organization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>top-down ecotoxicological study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14509"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15099 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15099">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organic matter content of soil, sediment, or water determined by measurement of organic carbon as the ratio of mass of organic carbon/mass of solid or of water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TOC</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Most of the organic carbon in water is dissolved organic carbon (DOC), with the remainder referred to as particulate organic carbon. In natural waters, TOC is composed primarily of nonspecific humic materials.</rdfs:comment>
        <rdfs:comment>TOC is determined by oxidation of the organic matter into carbon dioxide (\(\ce{CO2}\)) after removal of inorganic carbon such as carbonate or hydrogencarbonate. TOC includes all the carbon atoms covalently bonded in organic molecules.</rdfs:comment>
        <rdfs:label>total organic carbon</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14595"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14746"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15099"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TOC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15100 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15100">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Able to cause injury to living organisms as a result of physicochemical interaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>toxic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15101 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15101">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose or concentration of a toxicant expressed in units of lethality such as units of \(\pu{LD_{50}}\) or \(\pu{LC_{50}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>toxicity unit</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxic unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15101"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15102 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15102">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Curve obtained by plotting the median survival times of a group of test organisms against the concentration of a substance on a logarithmic scale.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>toxicity curve</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15103 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15103">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio of the toxicity of a chemical to that of another structurally related chemical (or index compound) chosen as a reference. In risk assessment, ratio of the toxicity of a chemical to that of another structurally related chemical (or index compound) chosen as a reference. Factor used to estimate the toxicity of a complex mixture, commonly a mixture of chlorinated dibenzo-p-dioxins [oxanthrenes], furans, and biphenyls: in this case, TEF is based on relative toxicity to 2,3,7,8-tetrachlorodibenzo-p-dioxin [2,3,7,8-tetrachlorooxanthrene] for which the \(f = 1\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TEF</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxicity equivalency factor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15103"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TEF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15104 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15104">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Contribution of a specified component (or components) to the toxicity of a mixture of related substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TEQ</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The amount-of-substance (or substance) concentration of total toxicity equivalent is the sum of that for the components \(\ce{B, C … N}\).</rdfs:comment>
        <rdfs:comment>Toxicity equivalent is most commonly used in relation to the reference toxicant 2,3,7,8-tetrachlorodibenzo-p-dioxin [2,3,7,8-tetrachlorooxanthrene] by means of the toxicity equivalency factor (TEF, \(f\)) that is 1 for the reference substance. Hence, where \(\pu{c}\) is the amount-of-substance concentration: \[T_{\rm{xe}} = \sum \limits_{i=B}^{N} f_{1} \pu{c}_{i}\]</rdfs:comment>
        <rdfs:label>toxicity equivalent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15103"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15104"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TEQ</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15105 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15105">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Systematic pretreatment (e.g., \(\rm{pH}\) change, filtration, or aeration) of a sample to obtain defined fractions that are subsequently tested for their toxicity. This fractionation is designed to separate out defined substances and thus to identify the agent(s) primarily responsible for lethal or sublethal toxicity of a complex mixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>TIE</oboInOwl:hasRelatedSynonym>
        <rdfs:label>toxicity identification and evaluation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15105"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TIE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15106 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15106">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Factor used to estimate risk. It may be a reference dose or it may be calculated from the following equation: \[T_{\rm{x}} = m\ C\] where \(m\) is the slope of a published dose-effect relationship and \(C\) is the toxicant concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>toxicity value</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14602"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15107 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15107">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance required in very small quantities by a defined organism to maintain health.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>micronutrient</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The quantities required for health and the species must be stated before application of this term has any meaning.</rdfs:comment>
        <rdfs:comment>Use of the term is often misleading since it is meaningless unless accompanied by a statement of which organisms show a requirement for the nutrient and the amount required.</rdfs:comment>
        <rdfs:label>trace nutrient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15108 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15108">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exchange of one advantageous character for another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>trade-off</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15109 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15109">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Criteria applied to results from tests (for fate or effects) which prompt further studies, e.g., moving to the next tier of tests, which are generally more complex.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>trigger values</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15095"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15110 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15110">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relating to nutrition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>trophic</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15111 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15111">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Situation arising when predators in a food chain suppress the abundance of their prey, thereby releasing the next lower trophic level from predation (or herbivory if the intermediate trophic level is an herbivore).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>For example, if the abundance of large piscivorous fish is increased in a lake, the abundance of their prey, zooplanktivorous fish, should decrease, large zooplankton abundance should increase, and phytoplankton biomass should decrease.</rdfs:comment>
        <rdfs:comment>Trophic cascades may also be important for understanding the effects of removing top predators from food webs, as humans have done in many places through hunting and fishing activities.</rdfs:comment>
        <rdfs:label>trophic cascade</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14698"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14922"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14923"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15113"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15139"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15112 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15112">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Decrease in contaminant concentration as trophic level increases; this results from a net balance of ingestion rate, uptake from food, internal transformation, and elimination processes favoring loss of contaminant that enters the organism via food.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>biominification</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bioreduction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>trophic dilution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14549"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15113 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15113">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Position in a food chain, assessed by the number of energy-transfer steps to reach that level.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>trophic position</oboInOwl:hasRelatedSynonym>
        <rdfs:label>trophic level</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14612"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14698"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15114 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15114">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organization of an ecological community described in terms of energy flow through its various trophic levels.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>trophic structure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14531"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15115 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15115">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transfer of a substance from one trophic level to another.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>trophic transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15113"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15116 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15116">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ratio between the concentration of a compound in a predator and in its prey.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>trophic transfer factor</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15117 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15117">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Extent to which the clarity of water is reduced by the presence of suspended or other matter that causes light to be scattered and absorbed rather than transmitted (in straight lines) through the sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>turbidity of water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15118 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15118">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental method for evaluating assimilation that introduces simultaneously a radiotracer of the substance being assimilated and an inert tracer that will not be assimilated, thus providing a basis for evaluating the assimilation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>twin-tracer technique</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15119 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15119">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal or plant living in contact with sediments but unable to ingest particulates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The classification implies that such organisms take up substances from interstitial water but not from sediment-associated particulates; examples of such organisms are rooted macrophytes and benthic algae.</rdfs:comment>
        <rdfs:label>type A organism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14433"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14468"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14772"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14826"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15120"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15120 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15120">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Animal or plant living in contact with sediments and capable of ingesting particulates.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The classification implies that such organisms take up substances from both interstitial water and from sediment-associated particulates.</rdfs:comment>
        <rdfs:label>type B organism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14772"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15119"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15121 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15121">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In assay methodology, confidence interval or fiducial limit used to assess the probable precision of an estimate. In toxicology, value used in extrapolation from experimental animals to humans (assuming that humans may be more sensitive) or from selected individuals to the general population.Example: A value applied to the no-observed-effect-level (NOEL) or no-observed-adverse-effect-level (NOAEL) to derive an acceptable daily intake (ADI) or tolerable daily intake (TDI).Note: The NOEL or NOAEL is divided by the value to calculate the ADI or TDI.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>UF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>application factor (AF)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>assessment factor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>modifying factor (MF)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>safety factor</oboInOwl:hasRelatedSynonym>
        <rdfs:label>uncertainty factor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15121"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Water in a rivulet, river, or lake that is situated above a defined point, in a direction opposite to that of the current flow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>Upstream water is not influenced by incoming effluent at or below the defined point because the effluent is carried away by the flow.</rdfs:comment>
        <rdfs:label>upstream water</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15123 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15123">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>First-order one-compartment constant to describe the uptake of a substance by an organism from water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>uptake rate constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15124 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15124">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of the life cycle of an individual in which natural selection can occur through the differential survival of individuals. It begins at the formation of the zygote and continues throughout the life of the individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>viability selection</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14795"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15125 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15125">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measures of how fast vital statistics change in a population (usually expressed per \(\pu{1000}\) individuals).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>There are two categories within vital rates, crude rates referring to change in the whole population (e.g., overall change in births and deaths per \(\pu{1000}\)) and refined rates referring to change in a specific demographic such as age, sex, race, etc.</rdfs:comment>
        <rdfs:label>vital rates</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15126 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15126">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Susceptibility to harm by toxicants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>vulnerability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14732"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15085"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15127 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15127">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Net deficit of heterozygotes when two populations, each in Hardy–Weinberg equilibrium but with different allele frequencies, are mixed and the genotype frequencies quantified in a combined population sample.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Wahlund effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14731"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15128 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15128">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Widespread and substantial decline in growth and the change in behavior of many softwood and hardwood forest ecosystems in central Europe.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>waldsterben</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14619"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15129 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15129">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>General term describing effluents, leachate, and elutriates which enter the natural environment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>waste-water</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14628"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14786"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15130 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15130">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Questionable extension of the critical life-stage concept (see critical life-stage testing) that protection of the most sensitive life stage will ensure protection of all life stages; it assumes that exposure of field populations to concentrations identified in laboratory testing as causing significant mortality at a critical stage of life will result in significant impact on the field population</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>weakest-link incongruity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14559"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15131 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15131">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose–response model of the form \[P(d) = \gamma + (1 - \gamma)(1 - e^{-\beta d^{\alpha}})\] where \(P(d)\) is the probability of a tumor (or other response) from lifetime, continuous exposure at dose \(d\) until age \(t\) (when tumor is fatal), \(\alpha\) is a fitted dose parameter (sometimes called the Weibull parameter), \(\beta\) is a fitted dose parameter, and \(\gamma\) is the background response rate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Weibull model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14604"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15132 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15132">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Distribution of organisms among the various weight classes present in a population.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>The sum of individual weights over all weight classes equals the population biomass.</rdfs:comment>
        <rdfs:label>weight composition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14932"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14933"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15133 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15133">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>(in general) Quantitative, semiquantitative, or qualitative estimate of the degree to which the evidence supports or undermines a given conclusion. (in toxicology) Estimate of the extent to which the available biomedical data support the hypothesis that a substance causes a defined toxic effect such as cancer in humans.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>weight of evidence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15134 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15134">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory of evolution and heredity propounded by the German biologist, August Weismann, especially in regard to the continuity of the germ-plasm and the nontransmission of acquired characteristics.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>Weismannism</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14667"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15135 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15135">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transfer of chemicals from the atmosphere to the Earth’s surface in atmospheric water precipitation (atmospheric deposition), e.g., rain, snow, or hail, of pollutants that occur in the precipitation, e.g., as a result of Brownian capture, nucleation, dissolution, or impaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>wet deposition</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14454"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14928"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15136 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15136">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Area of land consisting of soil that is saturated with moisture, such as a swamp, marsh, or bog.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:comment>As defined in terms of physical geography, a wetland is an environment &quot;at the interface between truly terrestrial ecosystems and aquatic systems making them inherently different from each other yet highly dependent on both&quot;.</rdfs:comment>
        <rdfs:comment>In many locations such as the United Kingdom and United States, wetlands are the subject of conservation efforts and biodiversity action plans (BAPs).</rdfs:comment>
        <rdfs:comment>Wetlands are ecotones. Wetlands often host considerable biodiversity and endemism.</rdfs:comment>
        <rdfs:label>wetland</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14479"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14480"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14547"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14548"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14620"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14633"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15036"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15137 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15137">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Total toxic effect of an effluent measured directly with aquatic organisms in a toxicity test.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>WET</oboInOwl:hasRelatedSynonym>
        <rdfs:label>whole-effluent toxicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15100"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15137"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15138 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15138">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sediment and associated interstitial water that have had minimal manipulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>whole sediment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14772"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15139 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15139">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small floating or weakly swimming animals that drift with water currents and which, with phytoplankton, make up the planktonic food supply upon which almost all oceanic organisms ultimately depend.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <rdfs:label>zooplankton</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14918"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.14924"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15140 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15140">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Proportion dying in a toxicity test expressed in terms of standard deviations from the mean of a normal curve.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-07-09"/>
        <oboInOwl:hasRelatedSynonym>NED</oboInOwl:hasRelatedSynonym>
        <rdfs:label>normal equivalent deviation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15140"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NED</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15141 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15141">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fraction of the administered dose of a drug from a dosage form absorbed intact into the systemic circulation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>absolute bioavailability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15142 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15142">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Carriage of a solute across a biological membrane, which requires a suitable carrier and the expenditure of energy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>active transport of drugs</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15143 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15143">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Introduction of a substance to an organism by a defined route.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>administration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15144 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15144">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Administration of drugs through the eye.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Drugs used to treat eye disorders can be administered as liquid or semi-solid dosage forms. Solid inserts, which release the drug in slow-release pattern, are also available.</rdfs:comment>
        <rdfs:comment>Ocular drugs are almost always used for their local effects. Some drugs produce a local effect after they are absorbed through the cornea and conjunctiva. Some of these drugs then enter the bloodstream and may have unwanted or wanted systemic effects.</rdfs:comment>
        <rdfs:label>administration of drugs ocular route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15145 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15145">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Administration of drugs through the mouth to swallow.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>It differs from intraoral administration.</rdfs:comment>
        <rdfs:comment>Per-oral products can be powders, granules, uncoated or coated tablets, capsules, and liquids (solutions, emulsions, and suspensions). Liquids for oral use may contain antimicrobial preservatives and are supplied in multi- or single-dose containers.</rdfs:comment>
        <rdfs:comment>This is the most convenient and popular administration route.</rdfs:comment>
        <rdfs:label>administration of drugs oral route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15146 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15146">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method of introducing substances into an organism, avoiding the gastrointestinal tract.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Parenteral administration includes some conventional (intravenous, intramuscular, subcutaneous) and some special (intradermal, intraventricular, etc.) routes.</rdfs:comment>
        <rdfs:comment>Parenteral products can be solutions, suspensions, and emulsions. They are presented as sterile products. It is commonly used to imply administration by injection or infusion.</rdfs:comment>
        <rdfs:comment>Parenteral routes may be employed whenever enteral routes are contraindicated or inadequate.</rdfs:comment>
        <rdfs:label>administration of drugs parenteral route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15201"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15147 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15147">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Administration of drugs into the rectal cavity or through the rectum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Products may be solid (suppositories) or liquid unit dosage preparations, or creams, ointments, and gels.</rdfs:comment>
        <rdfs:comment>The rectal route has several drawbacks. These can be, in addition to psychological aversion, slow and incomplete absorption, and inadequacy where rapid absorption and high plasma levels are required.</rdfs:comment>
        <rdfs:comment>This is an important way of administering a medicinal product that may not be tolerated orally, especially in pediatrics and geriatrics or when the patient has an infection of the gastrointestinal tract; or when the drug is less suited for oral administration because of side effects, bad taste, or enzymatic degradation.</rdfs:comment>
        <rdfs:label>administration of drugs rectal route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15184"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15217"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15238"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15148 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15148">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delivery to the lower respiratory tract in order to obtain a local or systemic effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>introduction of drugs by inhalation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Products usually deliver the active substance in the form of aerosol droplets or solid particles (powders).</rdfs:comment>
        <rdfs:label>administration of drugs respiratory route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15200"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15149 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15149">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Administration of drugs on surfaces of the body.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Topical products usually produce pharmacological effects at or near the point of application, such as the skin, eyes, nose, throat, ears, and vagina, etc., but sometimes may also have systemic effects.</rdfs:comment>
        <rdfs:label>administration of drugs topical route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15150 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15150">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Introduction of products through unbroken skin by means of a specific drug delivery system (such as a patch containing a semi-solid formulation of the drug) for systemic and/or prolonged drug effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>diadermic administration</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>percutaneous administration</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>transcutaneous administration</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>transdermic administration</oboInOwl:hasRelatedSynonym>
        <rdfs:label>administration of drugs transdermal route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15177"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15188"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15151 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15151">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Introduction of products into the vagina normally for local effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Vaginal preparations may be liquid dispersions (solutions, foams), semi-solid (gels, creams, ointments), and solids (tablets, capsules, pessaries, tampons, sponges).</rdfs:comment>
        <rdfs:label>administration of drugs vaginal route</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15217"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15152 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15152">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristic angle of slope formed with the horizontal by the side of a static conical mound of powder.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>A measure of cohesiveness in powders. The smaller the angle of repose the greater the ability of the powder to flow. A particle will begin to slide on a slope when the angle of inclination is sufficiently large to overcome the frictional forces, and conversely the particle will not move when the angle is below that required to overcome cohesion and adhesion.</rdfs:comment>
        <rdfs:comment>Angle of repose is determined by a balance of gravitational force and the frictional forces caused by interparticulate interactions.</rdfs:comment>
        <rdfs:comment>The angle of repose depends on the method of measurement.</rdfs:comment>
        <rdfs:label>angle of repose</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15153 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15153">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which food is rendered free from pathogenic, toxigenic, and spoilage organisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>A term used in the food industry.</rdfs:comment>
        <rdfs:comment>Appertization will not necessarily kill thermophilic spores, and thus products subjected to the process may not be sterile.</rdfs:comment>
        <rdfs:label>appertisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15154 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15154">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relationship between two preparations of the same drug in the same dosage form that have a similar bioavailability. Dosage forms containing the same drug are said to be bioequivalent if they do not differ significantly in the bioavailability (e.g., AUC, \(c_{\rm{max}}\), \(t_{\rm{max}}\)) of the active constituent/ingredient, when administered in the same dose under similar experimental conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>bioequivalence</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15155 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15155">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Virus, therapeutic serum, toxin, antitoxin, or analogous product applicable to the prevention, treatment, or cure of diseases or injuries in humans and/or animals.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>The term &quot;analogous product&quot; may include essentially all biotechnology-derived products and procedures including gene therapy, transgenics, and somatic cell therapy.</rdfs:comment>
        <rdfs:label>biological product</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15191"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15156 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15156">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Branch of pharmaceutical science that deals with the fate of drugs in the living system; particularly the release of the drug from its dosage form into a biological medium, its passage across membranes into the systemic circulation, metabolism, and elimination, and the application of this knowledge to obtain the desired therapeutic effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>biopharmaceutics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15157 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15157">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Usually a small, flat, and soft tablet, which is designed to be placed inside the cheek to be directly absorbed through the mucosa for systemic effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>buccal tablet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15158 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15158">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Characteristic of a powder rather than of individual particles given by the mass of powder occupying a known volume.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>A powder can have only one true density, but it can have many different bulk densities, depending on how tightly the particles are packed.</rdfs:comment>
        <rdfs:comment>Characteristics of importance in tablet production.</rdfs:comment>
        <rdfs:comment>The bulk density is always lower than the true density of its component particles.</rdfs:comment>
        <rdfs:label>bulk density</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15159 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15159">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Small edible package made usually from gelatin or other materials that can be filled with drugs (solids or liquids) to produce a unit dose, mainly for oral use. Hard capsules consist of two pieces that fit one inside the other which are produced empty and filled in a separate operation, and soft, liquid-filled capsules, which are manufactured and filled in one operation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>capsule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15145"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15160 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15160">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Transfer of a drug across a membrane by a transporter (often a protein) constituent of the cytosol membrane. Also known as active transport as opposed to passive diffusion/absorption.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>carrier-mediated drug transport</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15142"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15171"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15161 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15161">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technological process consisting of the application of a substance, which forms a layer (e.g., to protect the drug and/or the tablet, to mask taste, to control the rate of drug release (e.g., film coating, sugar coating).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Sugar coating is used to mask bad taste without altering release profile.</rdfs:comment>
        <rdfs:label>coating</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15162 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15162">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A solid dosage form prepared to a desired shape, usually in large-scale production, by means of high pressure in a punch and die.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Most compressed tablets consist of the active ingredient and a diluent (filler), binder, disintegrator, and lubricant.</rdfs:comment>
        <rdfs:label>compressed tablet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15163 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15163">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Medication, which due to its special technological construction provides for drug release having predefined kinetics (zero order, \(t^{1/2}\), first order, etc.) at a sufficient rate to maintain the desired therapeutic level over an extended period of time.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Also used to denote sustained-release products with zero-order release kinetics.</rdfs:comment>
        <rdfs:label>controlled-release dosage form</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15164 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15164">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A stage in the drying of solids, above which the drying rate (derived from the plot of the loss of moisture content against time) is linear, at which the drying rate ceases to be linear, until it reaches the equilibrium moisture content.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>critical moisture content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15186"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15165 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15165">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Type of comparative bioavailability study designed in such a way as to take into account differences in bioavailability arising from differences between patients suffering from disease, participating in the study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>The differences between the subjects may be in age, stage or severity of the disease, and prior drug treatment that some may have received. In such a crossover study, the patients are divided into two equal size groups, uniform with respect to age, body weight, sex, etc. The first group is given a specific dose of the product studied, while the second group is given a second product of proven clinical efficacy, containing the same active ingredient. After taking an appropriate number of blood samples from each individual and a washout period, the groups are reversed and the first group is given the product of proven clinical efficacy and the second is given the product being studied. This way each patient serves as his or her own control.</rdfs:comment>
        <rdfs:label>crossover study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15166 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15166">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Term that describes a solid of regular shape and the presence of three-dimensional order on the level of atomic dimensions, for a given molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Crystalline forms are often preferred, over amorphous forms, in pharmaceutical dosage forms, due to uniformity, reproducibility, and sometimes lack of hygroscopicity.</rdfs:comment>
        <rdfs:comment>Crystallinity may be detected by diffraction techniques, heat-of-fusion measurements, etc.</rdfs:comment>
        <rdfs:label>crystalline</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15167 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15167">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pharmaceutical preparation that releases the drug(s) at a time other than promptly after administration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Typically, this is related to enteric coated tablets.</rdfs:comment>
        <rdfs:label>delayed-release dosage form</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15185"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15168 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15168">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that absorbs sufficient moisture from the atmosphere to dissolve itself.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>deliquescent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15169 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15169">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deposit of a drug in a body created by injection or by a similar mode of introduction to form a source of slow release.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>depot</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15170 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15170">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Property, which serves as basis for the process whereby surfactants are used for the removal of foreign matter from surfaces (including dirt from clothes or body surfaces).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>detergency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15233"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15171 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15171">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Obstacle such as coating or embedding, which acts as a factor controlling the rate of drug release.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Body fluids or membranes can also act as barriers.</rdfs:comment>
        <rdfs:label>diffusion barrier</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15183"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15172 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15172">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dosage form in which the active ingredient is insoluble in the carrier; includes aerosols (solids or liquids in gas), suspensions (solids in liquids), emulsions (liquids in liquids), and foams (gas in liquid), or ointments/creams (solid in solid or in semi-solid, or liquid in solid).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>These systems are thermodynamically unstable and need to be stabilized by suspensifying or emulsifying agents.</rdfs:comment>
        <rdfs:label>disperse system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15217"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15173 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15173">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formulation in which individual doses of a granulated dosage form are separated (e.g., gelatin capsules).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>divided granule</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15188"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15194"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15174 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15174">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Powder formulation in which individual doses of a powdered dosage form are separately wrapped (e.g., sachets, envelopes, or gelatin capsules).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>divided powder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15175 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15175">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formulated preparation of molecules/drugs that are rarely if ever suitable for administration to patients without additives.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>They can be designed for administration by all possible administration routes to achieve the desired therapeutic response.</rdfs:comment>
        <rdfs:label>dosage form</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15188"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15238"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15240"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15176 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15176">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dose and dosing interval of a drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>dosage regimen</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15177 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15177">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sophisticated dosage form, which, by its construction, is able to modify/control the availability of the drug substance to the body by temporal or spatial considerations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>drug delivery system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15167"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15169"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15183"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15187"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15212"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15178 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15178">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Refers to a stent with an active drug that is intended to produce a therapeutic effect (e.g., reduction of restenosis).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>drug-eluting stent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15236"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15179 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15179">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Usually intended for external use.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Examples are antibacterial and antifungal products.</rdfs:comment>
        <rdfs:comment>Normally dispensed in containers with perforated lids.</rdfs:comment>
        <rdfs:comment>The powder must flow well so that it can be dusted over the required area.</rdfs:comment>
        <rdfs:comment>Usually contains ingredients used for therapeutic, prophylactic, or lubricant purposes.</rdfs:comment>
        <rdfs:label>dusting powder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15180 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15180">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid preparation that on contact with water breaks apart by the effect of gas (usually \(\ce{CO2}\)) evolution, resulting commonly from the reaction of hydrogen carbonate with citric or tartaric acid, in order to facilitate dissolution or dispersion of the active ingredient before ingestion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>effervescent tablet</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15181 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15181">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that loses water to form a lower hydrate or becomes anhydrous spontaneously.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>efflorescent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15182 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15182">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Sweet (often colored) dilute alcohol-based, &apos;hydroalcoholic&apos;, liquid used in the compounding of drugs to be taken by mouth in order to improve palatability.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Elixirs are among the most common types of medicinal preparations taken orally in liquid form.</rdfs:comment>
        <rdfs:label>elixir</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15183 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15183">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Technological process, which consists of mixing or inclusion of the therapeutic substance with an excipient or their mixtures, typically as a matrix dosage form, in order to change the rate of release.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>embedding</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15207"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15184 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15184">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solutions (aqueous or oily), emulsions, or suspensions for rectal administration of medicaments for cleansing, diagnostic, or therapeutic purposes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>enemas</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15147"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15185 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15185">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Used on tablets, granules, pellets, and capsules to make them resistant to gastric fluids but designed to disintegrate, disrupt, or dissolve when the preparation enters the duodenum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Enteric coating is used for one of the following reasons: To protect the drug from degradation by the acid in the stomach (e.g., erythromycin).To protect the stomach from the irritant effect of the drug (e.g., aspirin).To facilitate absorption of a drug distally to the stomach.</rdfs:comment>
        <rdfs:label>enteric coating</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15167"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15186 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15186">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Final stage reached after drying of a solid, beyond the critical moisture content.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>EMC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>equilibrium moisture content</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15186"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EMC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15187 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15187">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>A tablet formulation intended for a rapid release of its active agent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>fast-dissolving tablet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15198"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15188 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15188">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Summary of operations carried out to convert a pharmacologically active compound into a dosage form suitable for administration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>formulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15177"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15233"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15189 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15189">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Aqueous solution used for the prevention and treatment of mouth and throat infections.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>mouthwash</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>May contain antiseptics, antibacterials, analgesics, and/or astringents.</rdfs:comment>
        <rdfs:comment>Usually diluted with water before use.</rdfs:comment>
        <rdfs:label>gargle</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15190 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15190">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pace at which a drug along with the stomach content leaves and enters the duodenum.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Gastric emptying rate (or time) is expressed typically in units of time or \(t_{1/2}\). It is also expressed as the amount of a given substance emptied per the total mass in the stomach, at a given time; or as the amount emptied, at a given time, of a given substance.</rdfs:comment>
        <rdfs:comment>Often, gastric emptying rate is also expressed as gastric emptying time.</rdfs:comment>
        <rdfs:comment>Since most drugs are optimally absorbed from the small intestine, the onset of drug action depends on the gastric emptying rate. Thus, the rate of gastric emptying determines the timing but not the extent of oral drug absorption.</rdfs:comment>
        <rdfs:comment>The gastric emptying rate depends on several factors, e.g., stomach calorie content, \(\rm{pH}\), hunger, anxiety, the nature of the drugs and body posture. High-calorie foods (e.g., fats) usually retard gastric emptying and delay drug absorption.</rdfs:comment>
        <rdfs:label>gastric emptying rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15145"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15191 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15191">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Use of products containing genetic material (e.g., pDNA, antisense DNA, siRNA) to treat a disease or condition, or to modify or manipulate the expression of genetic material or to alter the biological properties of living cells.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>gene therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15192 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15192">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Drug(s) or formulation(s) of drug(s) or dosage forms, which no longer have patent protection.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>generics</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Generic or nonproprietary drugs that may enter the market after the expiry of the basic patent covering the original drugs.</rdfs:comment>
        <rdfs:comment>Generic products may themselves bear brand names.</rdfs:comment>
        <rdfs:comment>Nonproprietary drugs are required to meet the same bioequivalency test as the original brand name drugs.</rdfs:comment>
        <rdfs:label>generic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15193 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15193">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Powder particles, which have been aggregated to form larger irregular particles, usually of \(\pu{0.5\!{-}\! 2 mm}\) diameter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Granules are also used as intermediates in tableting. These are typically of smaller sizes.</rdfs:comment>
        <rdfs:comment>May also be used rarely as independent dosage form for oral administrations.</rdfs:comment>
        <rdfs:label>granules</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15145"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15194 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15194">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which powder particles are made to aggregate to larger particles called granules.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Granulation is preceded by mixing the necessary powdered ingredients to assure their uniform distribution in the granules.</rdfs:comment>
        <rdfs:comment>Granulation may be carried out by two methods: wet granulations which utilize nontoxic volatile liquids, like water or low alcohols; or dry methods in which high pressure is applied.</rdfs:comment>
        <rdfs:comment>In the majority of cases, granulation is required in the production of tablets or capsules, when granules are made as an intermediate product.</rdfs:comment>
        <rdfs:label>granulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15195 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15195">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystalline form of a compound in which water molecules are part of the crystal structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Association of water molecule(s) in a crystal can be of different strength.</rdfs:comment>
        <rdfs:comment>The term &quot;hydrate&quot; may mean different things in different contexts. Common to all contexts is the content of water, which may be part of crystal structure or part of a molecule to which water has been added reversibly (e.g., chloral hydrate) or the elements of water incorporated covalently (e.g., carbohydrates).</rdfs:comment>
        <rdfs:label>hydrate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15166"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15234"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15196 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15196">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Empirical scale (of \(0\!-\!20\)) used to classify surfactants and emulsifying agents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>HLB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HLB System</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An HLB value of \(0\) corresponds to a completely hydrophobic molecule, while a value of \(20\) corresponds to a molecule made up completely of hydrophilic components.</rdfs:comment>
        <rdfs:comment>The more hydrophilic the surfactant the more it favors the formation of o/w over w/o emulsions.</rdfs:comment>
        <rdfs:comment>The numerical value is determined by the expression (\({\rm{HLB}} = 20 M_{\rm{h}}/M\)) where \(M_{\rm{h}}\) is the molecular mass of the hydrophilic portion of the molecule, and \(M\) is the molecular mass of the whole molecule, giving a result on an arbitrary scale of \(0\!-\!20\).</rdfs:comment>
        <rdfs:label>hydrophile-lipophile balance system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15196"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HLB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15197 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15197">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tendency of a substance to absorb water from the atmosphere.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>A substance that absorbs moisture from the atmosphere is called hygroscopic.</rdfs:comment>
        <rdfs:label>hygroscopicity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15198 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15198">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dosage form that releases the drug immediately.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>immediate-release tablet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15187"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15199 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15199">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number that expresses the reduction in the numbers of a microorganism, brought about by a sterilization process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>IF</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The IF value is specific for a microorganism and a sterilization process.</rdfs:comment>
        <rdfs:label>inactivation factor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15199"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15200 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15200">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Administration of drugs directly to the respiratory tract, mostly by aerosols.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Since a drug is delivered directly to the site of action, lower dose is needed by this route than by other routes, e.g., the gastrointestinal or parenteral routes.</rdfs:comment>
        <rdfs:comment>The incidence and the intensity of side effects are generally lower when this route is used as compared to other routes of drug administration.</rdfs:comment>
        <rdfs:label>inhalation therapy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15146"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15201 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15201">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Delivery of a generally sterile liquid medication into the body, or a vessel, tissue, or organ via syringe and needle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Epidural injections are given into the epidural space of the spinal cord.</rdfs:comment>
        <rdfs:comment>Intra-articular injections are made into the synovial fluid, which lubricates the articulating ends of bones in a joint.</rdfs:comment>
        <rdfs:comment>Intrabursal injections are given into the bursae, which are small sacks of fluids between the tendons and bones.</rdfs:comment>
        <rdfs:comment>Intracardial injections are given directly into the heart in emergencies.</rdfs:comment>
        <rdfs:comment>Intracutaneous or intradermal injections are made into the skin between the inner layer (dermis) and the outer layer (epidermis).</rdfs:comment>
        <rdfs:comment>Intramuscular injections are made by inserting the needle across the skin, subcutaneous tissue, and membrane enclosing the muscle.</rdfs:comment>
        <rdfs:comment>Intraspinal injections are made into or around the spinal cord.</rdfs:comment>
        <rdfs:comment>Intrathecal injection is the introduction of material for diffusion throughout the subarachnoid space by means of lumbar puncture.</rdfs:comment>
        <rdfs:comment>Intravascular injections (intra-arterial and -venous) are made directly into the blood stream for rapid effect.</rdfs:comment>
        <rdfs:comment>Ophthalmic injections include a variety of sites within the eye.</rdfs:comment>
        <rdfs:comment>Subcutaneous or hypodermic injections are made under the skin into the subcutaneous tissue.</rdfs:comment>
        <rdfs:comment>The same formulation cannot be used for all routes.</rdfs:comment>
        <rdfs:label>injection</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15202 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15202">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Liquid intended for massaging into the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>liniment</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15203 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15203">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Initial, typically larger than the maintenance dose of a drug given to a patient at the start of pharmacotherapy.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>The objective is to reach quickly the therapeutically beneficial plasma level. This is followed by smaller (maintenance) doses in order to maintain the plasma concentration.</rdfs:comment>
        <rdfs:label>loading dose</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15204 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15204">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solution, emulsion, or suspension to be applied to the skin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>lotion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15205 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15205">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tablet, which does not contain a disintegrant and which is sucked to dissolve in the mouth to produce either a local (e.g., antiseptic) or systemic (e.g., vitamins) effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Lozenges must be palatable and slowly soluble.</rdfs:comment>
        <rdfs:label>lozenge</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15206 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15206">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Used as processing aid in tablet and capsule manufacturing, to facilitate the movement of the formulation into the dye and punch and to reduce the energy of compression.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>lubricant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15207 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15207">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Specific case of drug embedding in insoluble excipients (typically in a polymer) in order to achieve extended release.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Matrices can be monolithic or heterogeneous, dissolved or dispersed, or both.</rdfs:comment>
        <rdfs:comment>This term also applies to a matrix made of hydrophilic substances, which, in contact with water, form a gel of high viscosity.</rdfs:comment>
        <rdfs:label>matrix formulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15183"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15208 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15208">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Maximum concentration of a drug, which will form a clear solution with a given concentration of surfactant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>maximum additive concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15209 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15209">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a drug in the plasma, above which side effects are likely to occur in a patient.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>maximum safe concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15210 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15210">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a drug that must be achieved in the plasma before any desired therapeutic or pharmacological effect can be obtained.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>minimum therapeutic plasma concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:label>minimum effective plasma concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15211 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15211">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Lowest concentration of an antibacterial drug necessary to inhibit the growth of a microorganism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>MIC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>minimum inhibitory concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15212 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15212">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Release of a drug from a dosage form that it is not immediate (e.g., sustained release, retarded release, delayed-action preparations, controlled release, extended release, etc.).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>modified release</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15167"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15213 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15213">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Usually water or low-molecular-weight alcohols or compounds, used in topical applications and in wet granulation, for the production of tablets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>moistening agents</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15149"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15194"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15214 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15214">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dosage form (capsule, tablet) comprising several elements (e.g., microspheres or coated pellets) differing in the rate of drug release.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>multicompartment formulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15161"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15215 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15215">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Consists of several different layers that are compressed on top of each other, to form a single tablet composed of two or more layers.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Mainly used for incompatible substances and for sustained release.</rdfs:comment>
        <rdfs:label>multilayer tablet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15216 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15216">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Formation of nanoparticles encapsulating a drug.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>nanoencapsulation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15217 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15217">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Greasy, semi-solid preparation for external application, often anhydrous, containing dissolved or dispersed medicaments.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>ointment</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15172"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15218 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15218">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Kinetic model, where the whole body is thought of as a single compartment in which a substance is distributed rapidly, achieving an equilibrium between blood and tissue immediately.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>In pharmacokinetics, the substance is a drug component which is assumed to be released from a dosage form and distributed instantly after absorption to reach an equilibrium between blood and tissues.</rdfs:comment>
        <rdfs:label>one-compartment model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15219 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15219">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Time required to achieve the minimum effective plasma concentration following administration of the dosage form.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>onset of drug action</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15210"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15220 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15220">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ointment containing \(\gt \pu{0\%}\) of powder, dispersed in a fatty base.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>paste</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15172"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15217"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15221 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15221">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Very small tablet or pilule. Implantable polymeric matrix. Spherical granule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>pellet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15207"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15222 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15222">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of agglomeration that converts fine powders or granules of bulk drugs and excipients into small, free-flowing, spherical, or semi-spherical units, referred to as pellets.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Pellets range typically between \(\pu{0.5 mm}\) and \(\pu{1.5 mm}\) in diameter.</rdfs:comment>
        <rdfs:comment>The most widely used pelletization processes in the pharmaceutical industry are extrusion/spheronization, solution/suspension layering, and powder layering.</rdfs:comment>
        <rdfs:label>pelletisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15193"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15223 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15223">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>To be pharmaceutically equivalent, the generic and proprietary formulations must (1) contain the same amount of active ingredient; (2) contain the same active ingredient in the same dosage form; (3) be intended for the same route of administration; and (4) generally be labeled for the same conditions of use.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>It is not usually required that the generic and the reference drug contain the same excipients, or that the mechanism by which the active drug substance is released from the formulation be the same. But, the regulation authority approves the generic equivalent on the basis of certain in vitro and in vivo data.</rdfs:comment>
        <rdfs:label>pharmaceutical equivalence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15154"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15188"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15192"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15224 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15224">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Science of preparation of drugs, dosage forms, and drug delivery systems taking into account the pharmacokinetics and pharmacodynamics of the drug as well as its physical and chemical properties.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>pharmaceutics</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15225 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15225">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid material that exists at least in two different molecular arrangements, i.e., distinctly different crystal species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>Solubility, melting point, density, crystal shape, crystal structure, and some other physical properties often differ from one polymorph to the other.</rdfs:comment>
        <rdfs:comment>The differences between polymorphs disappear in solution or in the vapor phase.</rdfs:comment>
        <rdfs:label>polymorph</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15166"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15226 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15226">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Defined for powders used pharmaceutically, according to particle sizes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>It is required that when the fineness of a powder is described by a number, all particles must pass through a sieve with aperture diameter in microns equal to that number.</rdfs:comment>
        <rdfs:label>powder grades</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15227 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15227">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dry solid material consisting of many, usually free flowing, fine particles. Conventionally, the title &apos;powder&apos; should be restricted to powder mixes for internal use and alternative terms are used for other powdered formulations presented in this way, e.g., dusting powders, which are for external use.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>powders</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The term &quot;powder&quot;, when used to describe a dosage form, however, describes a formulation in which a drug powder has been mixed with other powdered excipients to produce the final product.</rdfs:comment>
        <rdfs:label>powder</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15179"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15188"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15228 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15228">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Exploratory activity that begins early in pharmaceutics, involving studies designed to determine the compatibility of excipients with the active substance for a biopharmaceutical; physicochemical and bioanalytical investigation in support of promising experimental formulations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>preformulation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15156"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15188"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15224"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15229 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15229">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Different crystalline form(s) of a solvated compound that differ in the identity and/or the stoichiometry of the solvating molecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>pseudopolymorphs</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pseudopolymorph</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15166"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15234"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15230 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15230">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Tablet or capsule distinguished from a sustained-release dosage form, by the fact that it releases the medicinal agent, or part of it, at any time other than promptly after administration as opposed to a slow, controlled manner.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>A repeat action tablet contains usually two doses of the drug, the first being released immediately following per-oral administration. The second dose is released later, when the layer of enteric coating is dissolved.</rdfs:comment>
        <rdfs:label>repeat action dosage form</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15145"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15159"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15231 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15231">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process that differentiates or separates solid particles according to their size using a meshed or perforated device.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>sieving</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15232 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15232">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method by which powder particles are compressed into a large tablet, called a slug, which is subsequently dry-screened and compressed into a tablet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>slugging</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15227"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15233 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15233">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Additives making a substance soluble or more soluble, especially in water.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>solubilising agents</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15234 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15234">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Crystalline form of a compound in which one or more solvent molecules are part of the crystal structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>solvate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15166"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15195"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15235 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15235">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process of making dense, spherical pellets by means of special spheronizing or pelletizing equipment.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>spheronisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15221"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15236 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15236">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scaffold placed into narrowed, diseased vessels (mainly coronary arteries) or a device implanted in a vessel used to help keep it open.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>stent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15237 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15237">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Usually small, flat, and soft tablets, which are designed to be placed under the tongue to allow direct absorption of the active ingredient through the mucosa for systemic effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>sublingual tablets</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15241"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15238 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15238">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dosage form, semi-solid, used for the administration of drugs via the rectal route, for systemic or local effect. When application is via other routes (e.g., the vaginal route), suppositories are termed differently, inserts, pessaries, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>An important requirement for suppositories is a melting point (or disintegration/dissolution) at around \(\pu{{36}{-}{37} ^{\circ}C}\) so as to discharge the drug in the rectum.</rdfs:comment>
        <rdfs:comment>The vehicles used in suppositories are of two types, i.e., fatty bases and water-soluble ones.</rdfs:comment>
        <rdfs:label>suppositories</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15143"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15151"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15239 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15239">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dosage form designed to release the drug contained therein at a continuous and controlled rate for a longer period of time that can normally be achieved with its conventional, nonsustained counterpart.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>extended release</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gradual release</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>long acting</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prolonged action</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>slow release</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Other terms used to describe the same concept include: &quot;controlled release&quot;, &quot;extended release&quot;, &quot;long-acting&quot;, &quot;gradual release&quot;, &quot;modified release&quot;, &quot;prolonged action&quot;, and &quot;slow release&quot;.</rdfs:comment>
        <rdfs:comment>Per-oral administration of a single dose of a sustained-release product increases the duration of therapeutic action of the drug, beyond that achieved normally with a single dose of the corresponding non-sustained conventional counterpart.</rdfs:comment>
        <rdfs:comment>Sustained-release injectables are also available.</rdfs:comment>
        <rdfs:label>sustained release</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15175"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15240 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15240">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Liquid preparation of high sugar concentration with or without medicinal and additional flavoring substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:comment>It is often required to add a cosolvent or water to the medicated syrup in order to dissolve the drug.</rdfs:comment>
        <rdfs:comment>Syrup is a highly concentrated solution of sugar. Other polyols, such as glycerol or sorbitol, may be present to retard crystallization of sucrose or to increase the solubility of added ingredients.</rdfs:comment>
        <rdfs:comment>When the syrup contains a medicinal substance, it is termed &quot;medicated syrup&quot;; and the syrup is diluted since USP syrup is close to a saturated solution. Although syrup tends (due to its very high [approximately \(\pu{85\%}\)] sucrose content) to resist mold or bacterial contamination, syrup may contain antimicrobial agents to prevent bacterial and mold growth.</rdfs:comment>
        <rdfs:label>syrup</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15241 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15241">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid dosage form compressed into a specific shape containing medicinal substances with or without suitable diluents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <oboInOwl:hasRelatedSynonym>pastille</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pellet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pill</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>troche</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Tablets may vary in shape, size, color and weight, and may be classified according to the method of manufacture, as molded tablet and compressed tablet.</rdfs:comment>
        <rdfs:label>tablet</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15157"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15162"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15185"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15205"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15221"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15237"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15239"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15243"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15242 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15242">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid layers based typically on cellulose derivatives and may include plasticizers and pigments. They are usually employed for one or more of the following reasons:  Protection of the ingredients (from light or moisture). Masking the bad taste of the drug. Masking possible batchwise differences in the appearance of raw materials and hence allaying possible patient concern over tablets of differing appearance. Coating confers mechanical strength and facilitates handling. Colored coating aids in the rapid identification of a product. Functional film coating is used to impart enteric or controlled-release properties to the tablet.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>tablet coating</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15163"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15185"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15243 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15243">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Applied to compressed lozenges. In lay language, lozenge and troche are used interchangeably.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-04-10-14"/>
        <rdfs:label>troche</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15205"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15244 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15244">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from acrylic acid or a derivative of acrylic acid.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>acrylate polymer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acrylic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polyacrylic</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An acrylic polymer formed from methacrylic acid and related monomers is often referred to as a methacrylic polymer or a polymethacrylic or a methacrylate polymer. Methacrylic polymers are a subclass of acrylic polymers.</rdfs:comment>
        <rdfs:comment>The macromolecule of a regular acrylic homopolymer can be described by a constitutional repeating unit of general formula: \(\ce{-CR(X)-CH2\bond{-}}\), where \(\ce{R}\) is \(\ce{COOH}\), \(\ce{COOR^1}\), \(\ce{CN}\), or \(\ce{CONR^1R^2}\) and \(\ce{X}\) is \(\ce{H}\), alkyl, aryl, heteroaryl, or \(\ce{CN}\).</rdfs:comment>
        <rdfs:label>acrylic polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15245 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15245">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared by polycondensation of an amino component such as amine or amide with an aldehyde, or by curing reactive oligomers prepared from an amino component and an aldehyde.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>amide-aldehyde polymer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>amine-aldehyde polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A mixture of the reactive oligomers prepared by the condensation of an amino component with an aldehyde is, in a public (popular) use and technological practice, usually referred to as an amino resin, e.g., melamine-formaldehyde resin or urea-formaldehyde resin. Examples of the oligomers present in melamine-formaldehyde and ureaformaldehyde resins are: </rdfs:comment>
        <rdfs:comment>An amino polymer is usually a network polymer. To form the polymer, polycondensation takes place at the hydroxymethyl groups of an amino resin. Examples of the network-structure motifs of that form are: </rdfs:comment>
        <rdfs:comment>Formaldehyde is commonly used as the aldehyde and (a) melamine or (b) urea as the amino component. The resulting polymer is named (a) melamine polymer or melamineformaldehyde polymer, (b) urea polymer or urea-formaldehyde polymer.</rdfs:comment>
        <rdfs:comment>Melamine polymers can be regarded as a subclass of polytriazines.</rdfs:comment>
        <rdfs:comment>Use of the term &quot;resin&quot; for cured reactive oligomers is discouraged; the cured resin should be named as an amino polymer.</rdfs:comment>
        <rdfs:label>amino polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15246 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15246">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a mixture containing 1-benzofuran (formerly coumarone) and indene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>1-benzofuran-indene polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A coumarone-indene polymer contains structural units such as: </rdfs:comment>
        <rdfs:comment>A mixture of coal-tar and gas-tar distillates is commonly used to prepare a coumaroneindene polymer.</rdfs:comment>
        <rdfs:comment>Coumarone-indene polymers are film-forming materials.</rdfs:comment>
        <rdfs:comment>Coumarone-indene polymers are sometimes, particularly in a public (popular) use and technological practice, called coumarone resins or coumarone-indene resins. Use of these terms is discouraged.</rdfs:comment>
        <rdfs:label>coumarone-indene polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15247 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15247">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared by reaction of compounds carrying two or more epoxy groups (reactive epoxides) with curing agents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A reactive epoxide or a mixture of reactive epoxides, and also its admixture with curing agent or agents, is usually referred to as an epoxy resin, particularly in a public (popular) use and technological practice. Use of the term &quot;epoxy resin&quot; for a cured epoxide is discouraged; it should be named &quot;epoxy polymer&quot;.</rdfs:comment>
        <rdfs:comment>The reactive epoxide is cured by reactions with a di- or higher-functional amine, carboxylic acid, anhydride, or dicyandiamide (i.e., cyanoguanidine).</rdfs:comment>
        <rdfs:comment>The reactive epoxides are commonly prepared by condensation of (chloromethyl)oxirane (commonly called epichlorohydrin) with a di- or multi-functional acid, alcohol, amine, or phenol, most often with 4,4′-(propane-2,2-diyl)diphenol (bisphenol A) to give in this case: </rdfs:comment>
        <rdfs:label>epoxy polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15248 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15248">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from furan or a furan derivative.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Branching and network formation can occur through the condensation of methylene groups with terminal \(\ce{-CH2OH}\) groups.</rdfs:comment>
        <rdfs:comment>Comonomers such as phenols, aldehydes, and ketones are often used in preparation of furan polymers.</rdfs:comment>
        <rdfs:comment>Furan polymers prepared from furan-2-carbaldehyde (formerly furfural), such as poly(furan-2,5-diylcarbonyl), are usually referred to as furfural polymers, and they are conjugated polymers. </rdfs:comment>
        <rdfs:comment>The most widely used furan polymers are linear, branched, and network polymers prepared from (2-furyl)methanol, such as poly(furan-2,5-diylmethylene).</rdfs:comment>
        <rdfs:comment>Use of the terms &quot;furan resin&quot; or &quot;furfural resin&quot; for &quot;furan polymer&quot; or &quot;furfural polymer&quot;, respectively, is discouraged.</rdfs:comment>
        <rdfs:label>furan polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15249 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15249">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared by the polycondensation of phenols and aldehydes or by curing reactive oligomers prepared from phenols and aldehydes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>phenol-aldehyde polymer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A mixture of the reactive oligomers prepared by the condensation of a phenol and aldehyde, and also its admixture with a curing agent is, in a public (popular) use and technological practice, usually referred to as a phenolic resin or a phenol-aldehyde resin.</rdfs:comment>
        <rdfs:comment>A phenol-formaldehyde polymer prepared under acidic conditions with a formaldehyde-to-phenol molar ratio less then 1 is known as a novolak. A novolak can be cured with formaldehyde or a multifunctional reagent such as 1,3,5,7-tetraazaadamantane (hexamethylenetetramine) to give a network, phenol-formaldehyde polymer. </rdfs:comment>
        <rdfs:comment>A phenol-formaldehyde polymer prepared under alkaline conditions with an aldehydeto-phenol mole ratio between 1.5 and 3 is known as a resol. A resol spontaneously undergoes polycondensation at hydroxymethyl groups, to give a network, phenolformaldehyde polymer known as a resit. </rdfs:comment>
        <rdfs:comment>A phenolic polymer is usually a network polymer.</rdfs:comment>
        <rdfs:comment>Formaldehyde is commonly used as the aldehyde and (a) phenol itself, or (b) a cresol is used as the phenol. Phenol-formaldehyde polymer is a phenolic polymer resulting from the reaction of phenol with formaldehyde.</rdfs:comment>
        <rdfs:comment>Use of the term &quot;phenolic resin&quot; for cured reactive oligomers is discouraged; they should be called &quot;phenolic polymers&quot;.</rdfs:comment>
        <rdfs:label>phenolic polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15250 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15250">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a bismaleimide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polybismaleimide is usually a branched polymer or, upon curing, a network polymer.</rdfs:comment>
        <rdfs:comment>Bismaleimides are usually copolymerized with diamines, dicyanates, or aromatic diallyl derivatives.</rdfs:comment>
        <rdfs:label>polybismaleimide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15251 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15251">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a carborane.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polycarborane is usually an ionic polymer.</rdfs:comment>
        <rdfs:label>polycarborane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15252 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15252">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a diene, or a substituted diene, or both in admixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polydiene prepared from propadiene (allene) or a substituted propadiene (e.g., buta-1,2,-diene) is usually referred to as a polyallene or a polypropadiene (see the last two examples).</rdfs:comment>
        <rdfs:comment>Commercially widely spread polydienes, namely, polybutadienes and polyisoprenes, are commonly named with a use of numerical prefixes based on the addition mode taking place during the transformation of a monomer molecule into monomeric unit. The names are, for example: 1,2-polybutadiene for poly(1-vinylethylene) since the addition takes place at only one double bond located between carbon atoms \(\ce{C^1}\) and \(\ce{C^2}\) of a buta-1,3-diene molecule and 1,4-polybutadiene for poly(but-1-ene-1,4-diyl) since the conjugative addition resulting in enchainment of a buta-1,3-diene molecule via carbon atoms \(\ce{C^1}\) and \(\ce{C^4}\) takes place in the polymerization process. Use of these names is discouraged because a nomenclature locant should always refer to a molecule structure feature and not to a process of the molecule formation.</rdfs:comment>
        <rdfs:label>polydiene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15253 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15253">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from an isocyanate.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>An isocyanate monomer can be transformed into polymers belonging to various structure-based classes, such as a polyisocyanurate (by cyclopolymerization), polycarbodiimide (by decarboxylation), polyurea (by reaction with water), or polycarbamate (by reaction with a diol or a polyol).</rdfs:comment>
        <rdfs:label>polyisocyanate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15273"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15274"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15285"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15308"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15254 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15254">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from an isocyanide.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Isocyanide monomers are also polymerized by cyclopolymerization to give polytriazines.</rdfs:comment>
        <rdfs:comment>The class name polyisocyanide is preferably used for polymers in which every isocyanide monomeric unit contributes only one atom to a macromolecule backbone; the majority of these polymers are helical polymers.</rdfs:comment>
        <rdfs:label>polyisocyanide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15255 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15255">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from an olefin.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A typical polyolefin macromolecule is derived from an alkene and is described by the monomeric unit: \(\ce{-CR^1R^2\bond{-}CH2\bond{-}}\), where \(\ce{R^1}\) and \(\ce{R^2}\) are hydrogen, alkyl, or cycloalkyl. Polyolefins with 1,2-disubstituted monomeric units \(\ce{-CHR^1\bond{-}CHR^2\bond{-}}\) are rather rare, owing to low thermodynamic stability of their main chains caused by steric effects of the substituents.</rdfs:comment>
        <rdfs:comment>The structure-based name of a polyolefin prepared from an alkene is a polyalkylene.</rdfs:comment>
        <rdfs:label>polyolefin</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15265"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15256 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15256">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared by acetalization of poly(vinyl alcohol) with an aldehyde.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A common polyvinyl acetal does not have the ideal structure shown above but it also contains a low fraction of unreacted hydroxy groups.  </rdfs:comment>
        <rdfs:comment>The name &quot;polyvinyl acetal&quot; is derived using both source- and structure-based principles: &quot;polyvinyl&quot; comes from the source polymer: poly(vinyl alcohol), and &quot;acetal&quot; indicates the structure of constitutional units that are present in the resulting modified polymer. This approach is reflected in commonly used trivial names of polyvinyl acetals given in the above examples below systematic names.</rdfs:comment>
        <rdfs:label>polyvinyl acetal</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15257 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15257">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a vinyl ester.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A molecule of a regular polyvinyl ester is described by the constitutional repeating unit:  where \(\ce{R}\) is alkyl, aryl, or heteroaryl or substituted alkyl, substituted aryl, or substituted heteroaryl.</rdfs:comment>
        <rdfs:comment>Polyvinyl esters are a subclass of vinyl polymers.</rdfs:comment>
        <rdfs:label>polyvinyl ester</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15262"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15258 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15258">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a vinyl ether.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A molecule of a regular polyvinyl ether is described by the constitutional repeating unit:  where \(\ce{R}\) is alkyl, aryl, or heteroaryl or substituted alkyl, substituted aryl, or substituted heteroaryl.</rdfs:comment>
        <rdfs:comment>Polyvinyl ethers are a subclass of vinyl polymers.</rdfs:comment>
        <rdfs:label>polyvinyl ether</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15262"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15259 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15259">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a vinyl halide (monohalogenoethene).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A molecule of a regular polyvinyl halide is described by the constitutional repeating unit: \[\ce{-[-CHX-CH2\bond{-}]_{n}\bond{-}}\] where \(\ce{X}\) is \(\ce{F}\), \(\ce{Cl}\), \(\ce{Br}\), or \(\ce{I}\).</rdfs:comment>
        <rdfs:comment>Polyvinyl halides are a subclass of vinyl polymers.</rdfs:comment>
        <rdfs:label>polyvinyl halide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15262"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15260 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15260">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a vinyl ketone.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A molecule of a regular polyvinyl ketone is described by the constitutional repeating unit:  where \(\ce{R}\) is alkyl, aryl, or heteroaryl or substituted alkyl, substituted aryl, or substituted heteroaryl.</rdfs:comment>
        <rdfs:comment>Polyvinyl ketones are a subclass of vinyl polymers.</rdfs:comment>
        <rdfs:label>polyvinyl ketone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15262"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15261 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15261">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from styrene, or a substituted styrene, or both in admixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polystyrene</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In common usage, &quot;polystyrene&quot; means a polymer prepared from pure styrene, frequently cross-linked with 1,4-divinylbenzene, rather than a styrene polymer.</rdfs:comment>
        <rdfs:comment>Macromolecule of a regular styrene homopolymer is described by the constitutional repeating unit:  where \(\ce{R^{\upalpha}}\) and \(\ce{R^1}\) to \(\ce{R^5}\) are each \(\ce{H}\), alkyl, aryl, or heteroaryl.</rdfs:comment>
        <rdfs:comment>Styrene polymers are a subclass of vinyl polymers.</rdfs:comment>
        <rdfs:label>styrene polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15262"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15262 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15262">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a monomer containing the vinyl group \(\ce{-CH=CH2}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Acrylic polymers, polyolefins, polyvinyl acetals, polyvinyl esters, polyvinyl ethers, polyvinyl halides, polyvinyl ketones, and styrene polymers, with \(\ce{R^{\upalpha} = \ce{H}}\) are subclasses of vinyl polymers.</rdfs:comment>
        <rdfs:comment>Macromolecule of a regular vinyl homopolymer is described by the constitutional repeating unit: \(\ce{-CHR-CH2\bond{-}}\), where \(\ce{R}\) is alkyl, aryl, heteroaryl, halogen, or a heteroatom containing pendent group.</rdfs:comment>
        <rdfs:label>vinyl polymer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15244"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15255"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15256"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15257"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15258"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15259"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15260"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15261"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15263 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15263">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer prepared from a monomer containing the ethene-1,1-diyl group \(\gt\!\ce{C=CH2}\), formerly called vinylidene.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A macromolecule of a regular vinylidene polymer is described by the constitutional repeating unit: \(\ce{-CR^1R^2\bond{-}CH2\bond{-}}\), where \(\ce{R^1}\) and \(\ce{R^2}\) are each alkyl, aryl, heteroaryl, or halogen, such as by the units: </rdfs:comment>
        <rdfs:comment>Vinylidene is correctly defined as ethenylidene only, meaning a divalent attachment to the same atom of a senior group, i.e., it is the correct name for the group \(\ce{=C=CH2}\) but not for the group \(\gt\!\ce{C=CH2}\).</rdfs:comment>
        <rdfs:label>vinylidene polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15264 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15264">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively alkene-α,ω-diyl (formerly alkenylene) constitutional repeating units: \[\ce{-[-CH=CH-[CH2]_{m}\bond{-}]_{n}\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polyalkenylenes are sometimes referred to as polyalkenamers; use of this term is discouraged.</rdfs:comment>
        <rdfs:comment>Polyvinylenes (\(m = 0\)) are excluded.</rdfs:comment>
        <rdfs:label>polyalkenylene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15265 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15265">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively alkane-α,ω-diyl (formerly alkylene) constitutional repeating units: \[\ce{-[-CR^{1}R^{2}\bond{-}]_{n}\bond{-}}\] where \(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen, alkyl, or cycloalkyl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polyolefins are the most common polyalkylenes.</rdfs:comment>
        <rdfs:label>polyalkylene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15255"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15266 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15266">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively alkyne-α,ω-diyl (formerly alkynylene) constitutional repeating units: \[\ce{-[-C#C-[CH2]_m\bond{-}]_n\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyalkynylene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15267 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15267">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carboxamide groups as linkages in the backbone: \[\ce{-NR-CO\bond{-}}\] where \(\ce{R}\) is hydrogen, alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polyamide containing pendent carboxy groups is a polyamide acid commonly referred to as a polyamic acid.</rdfs:comment>
        <rdfs:comment>A polyamide containing, besides \(\ce{-NR-CO\bond{-}}\) linkages, exclusively aliphatic constitutional units is an aliphatic polyamide; examples are:  Trivial names of the type: polyamide \(m\) and polyamide \(m,n\) are only used for aliphatic polyamides. Polyamide \(m\) stands for a homopolymeric polyamide derived from an amino acid or a lactam comprising \(m\) carbon atoms; polyamide \(m,n\) stands for a copolymeric polyamide derived from an alkane-1,m-diamine containing \(m\) carbon atoms and an alkanedioic acid containing \(n\) carbon atoms (including those in \(\ce{CO}\) groups).</rdfs:comment>
        <rdfs:comment>A polyamide containing, besides \(\ce{-NR-CO\bond{-}}\) linkages, exclusively aromatic constitutional units is an aromatic polyamide commonly referred to as an aramide; example is: </rdfs:comment>
        <rdfs:comment>A polymer containing only pendent amide groups is excluded, e.g., polyacrylamide.</rdfs:comment>
        <rdfs:label>polyamide</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15268 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15268">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polyamide containing pendent carboxy groups:   where \(\ce{R}\) is a constitutional unit with a connectivity three or higher.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polyamic acid</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A polyamide acid is mostly prepared as a processable precursor giving a polyimide upon thermal curing. The polyamide acid prepared from benzene-1,2:4,5-tetracarboxylic dianhydride (formerly pyromellitic anhydride) and hexane-1,6-diamine (formerly hexamethylenediamine) is an example of such a precursor: </rdfs:comment>
        <rdfs:label>polyamide acid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15269 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15269">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing imino groups as linkages in the backbone: \[\ce{-NR\bond{-}}\] where \(\ce{R}\) is hydrogen, alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polymer containing only pendent amino groups is excluded. However, in organic chemistry, low-molecular-weight compounds containing three or more amino groups are also called polyamines.</rdfs:comment>
        <rdfs:comment>Quaternized polyamines have iminio linkages, \(\ce{-N^{+}R^{1}R^{2}\bond{-}}\), in the backbone (\(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen, or an alkyl, aryl, or heteroaryl group) and they are a structure-based subclass of ionenes.</rdfs:comment>
        <rdfs:label>polyamine</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15270 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15270">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carboxylic anhydride groupings as linkages in the backbone: \[\ce{-CO-O-CO\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyanhydride</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15271 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15271">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing benzothiazole groups in the backbone, such as the groups:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polybenzothiazole</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15272 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15272">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing benzoxazole linkages in the backbone, such as the linkages:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polybenzoxazole</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15273 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15273">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carbamate (formerly urethane) or N-substituted carbamate linkages in the backbone: \[\ce{-NR-CO-O\bond{-}}\] where \(\ce{R}\) is hydrogen, alkyl, aryl, heteroaryl, substituted alkyl, substituted aryl, or substituted heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polyurethane</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A polymer containing only pendent carbamate (urethane) groups is excluded.</rdfs:comment>
        <rdfs:comment>The commonly used class name polyurethane has been derived from the historic name urethane for ethyl carbamate.</rdfs:comment>
        <rdfs:label>polycarbamate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15274 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15274">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carbodiimide linkages in the backbone: \[\ce{-N=C=N\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polymer containing only pendent carbodiimide linkages is excluded.</rdfs:comment>
        <rdfs:label>polycarbodiimide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15275 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15275">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carbonate linkages in the backbone: \[\ce{-O-CO-O\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polymer containing only pendent carbonate linkages is excluded.</rdfs:comment>
        <rdfs:label>polycarbonate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15276 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15276">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carbon-silicon linkages in the backbone: \[\ce{-SiR^{1}R^{2}\bond{-}CR^{3}R^{4}\bond{-}}\] where \(\ce{R^1}\), \(\ce{R^2}\), \(\ce{R^3}\), and \(\ce{R^4}\) are each hydrogen, alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polycarbosilane containing, in addition to silanediyl groups, exclusively alkanediyl (formerly alkylene) or substituted alkanediyl constitutional repeating units is referred to as a polysilalkylene, whereas that involving exclusively arenediyl (formerly arylene) constitutional repeating units is referred to as a polysilarylene.</rdfs:comment>
        <rdfs:label>polycarbosilane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15277 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15277">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing 1,3,5-triazine-2,4,6-triyltrioxy constitutional units (formerly cyanurate groups) in the backbone:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Cyanurate is not an IUPAC approved name for 1,3,5-triazinetris(olate).</rdfs:comment>
        <rdfs:comment>Polycyanurates are isomeric with polyisocyanurates.</rdfs:comment>
        <rdfs:comment>Polycyanurates can be regarded as a subclass of polytriazines.</rdfs:comment>
        <rdfs:label>polycyanurate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15285"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15307"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15278 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15278">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing carboxylic ester linkages in the backbone: \[\ce{-O-CO\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polyester comprising unsaturated constitutional units such as a polyester prepared from maleic anhydride or from but-2-yne-1,4-diol is referred to as an unsaturated polyester. </rdfs:comment>
        <rdfs:comment>A polyester prepared from a polyol (typically a triol or tetrol), and a mixture of dicarboxylic anhydrides and fatty acids (e.g., linseed oil or tall oil) is referred to as an alkyd polymer or alkyd. Structure motifs of an alkyd polymer prepared from phthalic anhydride, glycerol, pentaerythritol [2,2-bis(hydroxymethyl)propane-1,3-diol], and fatty acids are shown below (MU stands for monomeric unit): </rdfs:comment>
        <rdfs:comment>A polymer containing only pendent ester groups is excluded, for example, an acrylic polymer.</rdfs:comment>
        <rdfs:comment>Polycarbonates, polythioesters, and unsaturated polyesters are subclasses of polyesters.</rdfs:comment>
        <rdfs:label>polyester</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15244"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15275"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15306"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15279 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15279">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing ether linkages in the backbone: \[\ce{-O\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polymer containing only pendent ether groups is excluded.</rdfs:comment>
        <rdfs:comment>Polyoxyalkylenes and polyoxyarylenes are subclasses of polyethers.</rdfs:comment>
        <rdfs:label>polyether</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15288"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15289"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15280 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15280">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively germanium atoms in the backbone: \[\ce{-[-GeR2\bond{-}]_{n}\bond{-}}\] where \(\ce{R}\) is alkyl, aryl or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polygermanes are sometimes referred to as polygermylenes. Use of this term is discouraged.</rdfs:comment>
        <rdfs:label>polygermane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15281 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15281">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing glutarimide rings in the backbone:   where \(\ce{R}\) is hydrogen or alkyl (usually methyl) and \(\ce{R^1}\) is hydrogen, or an alkyl, aryl, or heteroaryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polyglutarimide is commonly prepared by modification of a poly(alkyl acrylate) with an amine, such as aniline, so it also contains residual acrylic units: </rdfs:comment>
        <rdfs:label>polyglutarimide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15282 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15282">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing hydantoin (imidazolidine-2,4-dione) rings in the backbone:   where \(\ce{R}\) is hydrogen, or an alkyl, aryl, or heteroaryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polyhydantoins are a subclass of polyimides.</rdfs:comment>
        <rdfs:label>polyhydantoin</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15283 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15283">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing hydrazide linkages in the backbone: \[\ce{-CO-NR^1\bond{-}NR^2\bond{-}CO\bond{-}}\] where \(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen, alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyhydrazide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15284 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15284">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing imidazole rings in the backbone:   where \(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen, or an alkyl or aryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyimidazole</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15285 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15285">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing 2,4,6-trioxo-1,3,5-triazinane-1,3,5-triyl (formerly isocyanurate) rings in the backbone:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>An example of structure motifs of a polyisocyanurate is shown below: </rdfs:comment>
        <rdfs:comment>Polyisocyanurates are isomeric with polycyanurates.</rdfs:comment>
        <rdfs:label>polyisocyanurate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15277"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15286 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15286">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing keto groups as linkages in the backbone: \[\ce{-CO\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polyketone containing in addition to keto groups also ether linkages in the main chains is usually referred to as a polyetherketone. </rdfs:comment>
        <rdfs:comment>A polymer containing only pendent keto groups, such as a polyvinyl ketone, as well as a polymer containing main-chain carbonyl groups directly linked to a main-chain heteroatom, such as a polyester or a polyamide, is excluded.</rdfs:comment>
        <rdfs:label>polyketone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15267"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15278"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15287 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15287">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Organometallic polymer composed of macromolecules containing exclusively alternating metal and oxygen atoms in the main chain: \[\ce{-ML_{x}-O\bond{-}}\] where \(\ce{M}\) is a metal atom such as \(\ce{Al}\), \(\ce{Ge}\), \(\ce{Sn}\), or \(\ce{Ti}\), and \(\ce{L}\) is a metal-bonded substituent (ligand).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polymetaloxane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15288 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15288">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively oxyalkane-α,ω-diyl (formerly oxyalkylene) constitutional repeating units in the backbone: \[\ce{-[-O-Y\bond{-}]_{n}\bond{-}}\] where \(\ce{Y}\) is an alkane-α,ω-diyl (formerly alkylene) or substituted alkane-α,ω-diyl group contributing at least two carbon atoms to the main chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>An analog of polyoxyalkylene, for which \(\ce{Y}\) is \(\ce{-CR2\bond{-}}\) (\(\ce{R = H}\), alkyl, aryl, etc.) is a polyoxymethylene.</rdfs:comment>
        <rdfs:comment>Polyoxyalkylenes are a subclass of polyethers.</rdfs:comment>
        <rdfs:label>polyoxyalkylene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15279"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15290"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15289 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15289">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively oxyarenediyl (formerly oxyarylene) constitutional repeating units in the backbone: \[\ce{-[-O-Ar\bond{-}]_{n}\bond{-}}\] where \(\ce{Ar}\) is an arenediyl (formerly arylene), heteroarenediyl (formerly heteroarylene), substituted arenediyl or substituted heteroarenediyl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polyoxyarylene in which arenediyl is phenylene or a substituted phenylene is a polyoxyphenylene.</rdfs:comment>
        <rdfs:comment>Polyoxyarylenes are a subclass of polyethers.</rdfs:comment>
        <rdfs:label>polyoxyarylene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15279"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15291"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15290 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15290">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively oxymethylene or substituted oxymethylene constitutional repeating units in the backbone:   where \(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen, alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polyacetal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polyketal</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A polyoxymethylene is also referred to as a polyacetal, polyketal, or acetal resin. Use of the last term is discouraged.</rdfs:comment>
        <rdfs:label>polyoxymethylene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15291 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15291">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively oxyphenylene or ring-substituted oxyphenylene constitutional repeating units in the backbone:   where \(\ce{R^1}\), \(\ce{R^2}\), \(\ce{R^3}\), and \(\ce{R^4}\) are each hydrogen or an alkyl, aryl, or aralkyl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polyoxyphenylenes are a subclass of polyoxyarylenes as well as a subclass of polyethers.</rdfs:comment>
        <rdfs:label>polyoxyphenylene</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15279"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15289"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15292 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15292">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing imidazolidine-2,4,5-trione (parabanic acid) rings in the backbone:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Parabanic acid is not an IUPAC-approved name for imidazolidine-2,4,5-trione.</rdfs:comment>
        <rdfs:comment>Polyparabanic acids are a subclass of polyimides.</rdfs:comment>
        <rdfs:label>polyparabanic acid</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15293 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15293">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively alternating phenylene or substituted phenylene and methylene or substituted methylene constitutional units in the backbone:   where \(\ce{R^1}\), \(\ce{R^2}\), \(\ce{R^3}\), \(\ce{R^4}\), \(\ce{R^5}\), and \(\ce{R^6}\) are each hydrogen, alkyl, aryl, halogen, trialkylsilyl, etc.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polyphenylenemethylenes were also referred to as polybenzyls; this name is obsolete and strongly discouraged.</rdfs:comment>
        <rdfs:label>polyphenylenemethylene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15294 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15294">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing phosphate constitutional repeating units:   where \(\ce{R}\) is hydrogen, alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyphosphate</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15295 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15295">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively nitrilophosphanylylidene (formerly phosphazene) constitutional repeating units in the backbone:   where \(\ce{R^1}\) and \(\ce{R^2}\) are each a monovalent group, such as a halogen or an alkoxy group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyphosphazene</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15296 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15296">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of single strand or ladder macromolecules comprising isoindolo[2,1-a]benzimidazole (formerly pyrrone) constitutional repeating units such as:  where \(\ce{Z}\) is a divalent linking group or atom.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polybenzimidazolimides</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polybenzimidazolones</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polybenzimidazopyrrolones</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polyimidazopyrrolones</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polyisoindolobenzimidazole</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>polyisoindolobenzimidazoles</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Polypyrrones are also referred to as polybenzimidazolimides, polybenzimidazolones, polybenzimidazopyrrolones, polybenzoylenebenzimidazoles (usage strongly discouraged), polyimidazopyrrolones, and polyisoindolobenzimidazoles.</rdfs:comment>
        <rdfs:comment>Pyrrone is not an IUPAC approved name.</rdfs:comment>
        <rdfs:label>polypyrrone</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15297 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15297">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing quinoline moieties in the backbone:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyquinoline</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15298 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15298">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing quinoxaline groups in the backbone:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polyquinoxaline</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15299 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15299">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively alternating nitrogen and silicon atoms in the backbone: \[\ce{-[-NR^{1}\bond{-}SiR^{2}\!\,R^{3}\bond{-}]_{n}\bond{-}}\] where \(\ce{R^1}\), \(\ce{R^2}\), and \(\ce{R^3}\) are each hydrogen or an alkyl or aryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polysilazanes can comprise both silicon and nitrogen branching points, the former being formed from ammonia and the latter from, for example, alkyltrichlorosilanes or tetrachlorosilane used as monomers:  where \(\ce{R^1}\), \(\ce{R^2}\), and \(\ce{R^3}\) are each hydrogen or an alkyl or aryl group.</rdfs:comment>
        <rdfs:label>polysilazane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15300 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15300">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing alternating oxygen and silicon atoms in the backbone: \[\ce{-[-O\bond{-}SiR^{1}\!\,R^{2}\bond{-}]_{n}\bond{-}}\] where \(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen or an alkyl or aryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polyoxysilylenes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>silicones</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Polysiloxanes are often referred to as silicones or polyoxysilylenes. Use of the last term is discouraged.</rdfs:comment>
        <rdfs:comment>Polysilsesquioxanes are a subclass of polysiloxanes.</rdfs:comment>
        <rdfs:label>polysiloxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15301"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15301 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15301">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing silicon and oxygen atoms in the ratio \(1{:}1.5\) (ideal ratio for infinite macromolecule), which alternate in a hyperbranched or ladder structure such as:   where \(\ce{R}\) is alkyl, aryl, or heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polysilsesquioxanes are a subclass of polysiloxanes.</rdfs:comment>
        <rdfs:comment>The ideal value of the \(\ce{O{:}Si}\) ratio of \(1.5{:}1\) is achieved only in the case of a ladder polymer. For hyperbranched polysilsesquioxanes, the value of the \(\ce{O{:}Si}\) ratio is higher.</rdfs:comment>
        <rdfs:label>polysilsesquioxane</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15300"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15302 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15302">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing exclusively tin atoms in the backbone: \[\ce{-[-SnR^{1}\!\,R^{2}\bond{-}]_{n}\bond{-}}\] where \(\ce{R^1}\) and \(\ce{R^2}\) are each hydrogen or an alkyl or aryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polystannane</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15303 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15303">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing sulfonamide linkages in the backbone: \[\ce{-SO2-NR\bond{-}}\] where \(\ce{R}\) is hydrogen or an alkyl, aryl, or heteroaryl group.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:label>polysulfonamide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15304 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15304">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing sulfonyl linkages in the backbone: \[\ce{-SO2\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>Polysulfonamides and polysulfonates are excluded.</rdfs:comment>
        <rdfs:comment>Polysulfones that also comprise ether linkages in the backbone are more exactly classified as polyethersulfones. Similarly, other subclasses of polysulfones can be derived.</rdfs:comment>
        <rdfs:label>polysulfone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15303"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15305 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15305">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing thiocarboxylate (thioester) linkages in the backbone:\(\ce{-S-CO\bond{-}}\) or \(\ce{-O-CS\bond{-}}\) or \(\ce{-S-CS\bond{-}}\)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polymer containing only pendent thioester groups is excluded.</rdfs:comment>
        <rdfs:label>polythioester</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15306 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15306">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymers composed of macromolecules containing thioether (sulfide) linkages in the backbone: \[\ce{-S\bond{-}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A polymer containing only pendent thioether groups is excluded.</rdfs:comment>
        <rdfs:comment>A polymer with \(\ce{S_{x}} (x \gt 1)\) linkages is a polysulfide.</rdfs:comment>
        <rdfs:comment>A polymer with sulfanediylalkan-α,ω-diyl (formerly thioalkylene), sulfanediylarenediyl (formerly thioarylene), sulfanediylmethylene, or sulfanediylphenylene constitutional repeating units is classified more narrowly as a polythioalkylene, polythioarylene, polythiomethylene, or polythiophenylene.</rdfs:comment>
        <rdfs:label>polythioether</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15307 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15307">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing triazine rings in the backbone:</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A molecule of a typical polytriazine contains 1,3,5-triazine rings, however, polytriazines containing 1,2,4-triazine rings and, less likely, 1,2,3-triazine rings are also possible.</rdfs:comment>
        <rdfs:comment>A polycyanurate and an amino polymer prepared from 1,3,5-triazine-2,4,6-triamine (trivial name: melamine) are excluded; however, these polymers can be regarded as subclasses of polytriazines.</rdfs:comment>
        <rdfs:comment>A polytriazine is usually a branched or network polymer: </rdfs:comment>
        <rdfs:label>polytriazine</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15245"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15277"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15308 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15308">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules containing ureylene or N-substituted ureylene linkages in the backbone: \[\ce{-NR-CO-NR\bond{-}}\] where \(\ce{R}\) is hydrogen, alkyl, aryl, heteroaryl, substituted alkyl, substituted aryl, or substituted heteroaryl.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <oboInOwl:hasRelatedSynonym>polyureylene</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>A polymer containing only pendent ureylene groups is excluded.</rdfs:comment>
        <rdfs:comment>An amino polymer prepared from urea and an aldehyde is excluded.</rdfs:comment>
        <rdfs:label>polyurea</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15245"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15309 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15309">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules consisting of a single-strand main chain and many ring units, each having one atom in common with the main chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A cardo polymer can also be defined as a polymer composed of macromolecules containing loop-like cyclic side groups, one ring atom of which is part of the backbone.</rdfs:comment>
        <rdfs:comment>A cardo polymer can be represented graphically as follows: </rdfs:comment>
        <rdfs:comment>The adjective &quot;cardo&quot; is derived from the Latin word for heart because the cyclic unit, together with adjacent parts of the main chain, resembles the shape of a heart with arteries.</rdfs:comment>
        <rdfs:label>cardo polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15310 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15310">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules consisting of physically catenated macrorings that have no atom in common and cannot be separated unless chemical bonds are broken.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A catenane polymer can be a linear, branched, or network polymer.</rdfs:comment>
        <rdfs:comment>A catenane polymer can be graphically represented as follows: </rdfs:comment>
        <rdfs:comment>A catenane-polymer main chain resembles a jewelry or technical chain of physically interlocked rings.</rdfs:comment>
        <rdfs:label>catenane polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15311 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15311">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymer composed of macromolecules that adopt partly or completely a helical conformation.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/PAC-REC-08-01-30"/>
        <rdfs:comment>A helical structure is generated by regularly repeating rotations around the backbone bonds of a linear macromolecule.</rdfs:comment>
        <rdfs:comment>Biopolymers such as nucleic acids, amylose, and some proteins are typical helical polymers.</rdfs:comment>
        <rdfs:label>helical polymer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15312 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15312">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a substance \(\ce{B}\), activity coefficient \(f_{\ce{B}}\) extrapolated to infinite dilution: \[\ln (f_{\ce{B}}^{\infty}) = \lim \limits_{x_{\ce{B}} \to 0} (\frac{\mu_{\ce{B}} - \mu_{\ce{B}}^{\ast}}{RT} - \ln x_{\ce{B}})\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>The relation between the activity coefficient at infinite dilution and the standard chemical potentials is, for a solute \(\ce{B}\) in a solvent \(\ce{A}\), \[\ln f_{\ce{B}}^{\infty} = \frac{\mu_{m,\ce{B}}^{_{^⦵\!}} - \mu_{\ce{B}}^{\ast}}{RT} - \ln (M_{\ce{A}}m_{\ce{B}}^{_{^⦵\!}})\] where \(M_{\ce{A}}\) is the molar mass of the solvent.</rdfs:comment>
        <rdfs:comment>Useful for dilute mixtures as an alternative to the standard chemical potential on a molality basis.</rdfs:comment>
        <rdfs:label>activity coefficient at infinite dilution</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15333"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15313 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15313">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of experimental procedures for solubility determination in which a saturated solution is prepared and then analyzed to determine composition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>analytical method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15364"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15314 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15314">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a solute \(\ce{B}\) in a system containing solvent \(\ce{A}\) and a reference solvent \(\ce{C}\), \[m_{\ce{B}}^{(\ce{C})} = m_{\ce{B}} \overline M/M_{\ce{C}}\] where \(m_{\ce{B}}\) is the molality of \(\ce{B}\), \(M_{\ce{C}}\) is the molar mass of a reference component, and \(\overline{M}\) is the average molar mass of a mixed solvent, defined for a system containing two solvents as \[\overline M = x_{ u,\ce{A}} M_{\ce{A}} + (1 - x_{ u,\ce{A}}) M_{\ce{C}}\] the solvent amount fraction of solvent \(\ce{A}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>solvomolality</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Used most frequently in discussing comparative solubilities in water (\(\ce{C}\)) and heavy water (\(\ce{A}\)) and their mixtures, but applies to any reference component, where solvomolality is a more appropriate term.</rdfs:comment>
        <rdfs:label>aquamolality</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15315 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15315">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a mixture, temperature and pressure (the azeotropic temperature and pressure) at which the compositions of the liquid and vapor phases become equal (the azeotropic composition), but the intensive properties of the two phases (such as molar volume) are different.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>azeotrope</oboInOwl:hasRelatedSynonym>
        <rdfs:label>azeotropic point</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15316 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15316">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System containing two components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>binary system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15332"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15317 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15317">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume \(V^{\rm{g}}\) of an amount \(n_{\ce{B}}^{\rm{l}}\) of a gas dissolved at a given standard temperature \(T^{^⦵\!}\) (usually \(\pu{273.15 K}\)) and given standard (partial) pressure \(p_{\ce{B}}^{_{^⦵\!}}\) (\(\pu{1 bar} = \pu{0.1 MPa}\) or, in older literature, \(\pu{1 atm}\)) divided by the volume of the solvent \(V^{\rm{l}}\) containing an amount \(n_{\ce{A}}\) of solvent at temperature \(T\) and the given total pressure \(p^{_{^⦵\!}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>The Bunsen coefficient and the related quantities for expression of gas solubility; absorption coefficient, Kuenen coefficient, and Ostwald coefficient appear frequently in the older literature of gas solubility determination. However, the modern practice, recommended here, is to express gas solubility as molality, mole fraction, or mole ratio.</rdfs:comment>
        <rdfs:comment>The relations between the molality \(m_{\ce{B}}(p^{_{^⦵\!}})\) or mole fraction \(x_{\ce{B}}(p^{_{^⦵\!}})\) of dissolved gas and the Bunsen coefficients are \[\begin{array}{l} \frac{1}{x_{\ce{B}}(p^{_{^⦵\!}})} = 1 + \frac{1}{m_{\ce{B}}(p^{_{^⦵\!}})M_{\ce{A}}} = 1 + \frac{RT^{^⦵\!}Z_{\ce{B}}^{^⦵\!}(T^{^⦵\!})}{p^{_{^⦵\!}}V_{\ce{A}}\alpha_{\ce{B}}} \\ \frac{1}{x_{\ce{B}}(p^{_{^⦵\!}})} = 1 + \frac{1}{m_{\ce{B}}(p^{_{^⦵\!}})M_{\ce{A}}} = 1 + \frac{RT^{^⦵\!}Z_{\ce{B}}^{^⦵\!}(T^{^⦵\!})}{p^{_{^⦵\!}}V_{m,\ce{A}}\alpha_{\ce{B}}} \end{array}\] where \(V_{\ce{A}}\), \(V_{m,{\ce{A}}}\) are the respective partial molar volume and molar volume of the solvent and \(Z_{\ce{B}}\) is the compression factor of the gas.</rdfs:comment>
        <rdfs:comment>There are two Bunsen coefficients, depending on whether the liquid is the equilibrium solution or the pure liquid, with mathematical definitions:- Bunsen coefficient, solution reference \(\alpha_{\ce{B}} = V^{\rm{g}}(T^{^⦵\!}, p^{_{^⦵\!}}, n_{\ce{B}}^{1})/V^{\rm{l}}(T, p^{_{^⦵\!}}, n_{\ce{A}}, n_{\ce{B}}^{1})\)- Bunsen coefficient, pure solvent reference \(\alpha_{\ce{B}}^{\ast} = V^{\rm{g}}(T^{^⦵\!}, p^{_{^⦵\!}}, n_{\ce{B}}^{1})/V^{\rm{l}}(T, p^{_{^⦵\!}}, n_{\ce{A}})\)where \(n_{\ce{B}}^{\rm{l}}\) is the amount of dissolved gas in the liquid solution.</rdfs:comment>
        <rdfs:label>Bunsen coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15341"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15377"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15318 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15318">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semi-empirical equation describing the temperature dependence of the standard Gibbs energy of solution, \[\Delta_{\rm{sln}}G^{^⦵\!}(T, p^{_{^⦵\!}})/RT = A_{0} + A_{1}(T_{\rm{ref}}/T) + A_{2}\ln(T/T_{\rm{ref}}) + A_{3}(T/T_{\rm{ref}}) + A_{4}(T/T_{\rm{ref}})^{2} + \ldots\] where the \(A_{i}\) are constants that can be related to thermodynamic quantities (but subject to uncertainty because of statistical correlations among the fitting coefficients) and \(T_{\rm{ref}}\) is a reference temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>Clarke–Glew equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15319"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15319 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15319">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Clarke–Glew equation with \(T_{\rm{ref}} = \pu{100 K}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>Clarke–Glew–Weiss equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15318"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15320 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15320">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Boundary of stable phase separation (limits of solubility) in a liquid or solid system of two or more components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>binodal curve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>conodal curve</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In a binary system, a plot of experimental variables such as temperature or pressure, or of theoretical variables such as Gibbs energy, against mole fraction displays the coexistence curve. In ternary or higher-order systems, coexistence curves are displayed on a plot of composition at constant temperature or pressure, usually on a ternary diagram.</rdfs:comment>
        <rdfs:comment>The locus of the compositions of two co-existing phases on a phase diagram.</rdfs:comment>
        <rdfs:label>coexistence curve</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15321"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15332"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15365"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15321 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15321">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Two phases of variable composition in mutual thermodynamic equilibrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>conjugate phases</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15320"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15322 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15322">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Index in the basic equation describing a coexistence curve \[\beta = \lim \limits_{T \to T_{\rm{c}}} \left(\frac{\partial \ln (x&apos;&apos; - x&apos;)}{\partial \ln \vert T - T_{\rm{c}}\vert} \right)\] where \(x&apos;&apos;\), \(x&apos;\) are the mole fractions of one component in the respective concentrated and dilute phases and \(T_{\rm{c}}\) is the critical solution temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>critical index</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15320"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15323 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15323">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Experimental results, often numerical.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Data directly obtained from experimental apparatus may be referred to as raw data. Raw data may be subjected to numerical operations (unit conversions, etc.) to give transformed data, which maintain a point-for-point correspondence with the raw data. However, the use of the term &quot;data&quot; to refer to the results of numerical modeling operations or other elaborate calculations is controversial and discouraged. The latter are better referred to as &quot;results&quot; and, when presented graphically, are usually represented by smooth lines.</rdfs:comment>
        <rdfs:comment>The term is plural; its singular form is datum.</rdfs:comment>
        <rdfs:label>data</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15324 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15324">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isobaric, reversible melting or dissolution with either complete or partial dissociation on heating of a solid compound, \(\ce{A_{\rm{a}}B_{\rm{b}}}\), formed by components \(\ce{A}\) and \(\ce{B}\) \[\ce{A_{\rm{a}}B_{\rm{b}}(s)  A_{\rm{a}}B_{\rm{b}}(l)  {\rm{a}}A(l) + {\rm{b}}B(l)}\] where the forward arrows indicate the direction of heating.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>congruent melting</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>indifferent melting</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>From Greek δύστηκτος, difficult (or highest) melting.</rdfs:comment>
        <rdfs:comment>Occasionally, a similar reaction takes place in the subsolidus region. Quite appropriately, it is called a dystectoid reaction.</rdfs:comment>
        <rdfs:comment>The dystectic temperature is a maximum (\({\rm{d}}T/{\rm{d}}x = 0\)) of the melting temperature-composition curve. The dystectic point is the isobarically invariant maximum at the dystectic composition and dystectic temperature, where the compositions of the liquid and solid phases are equal. The composition of a non-stoichiometric compound is also equal to that of the melt at the dystectic temperature and composition.</rdfs:comment>
        <rdfs:label>dystectic reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15325 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15325">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reversible dissolution in an isothermal, isobaric system of three or more components characterized by dissolution and saturation with a stoichiometric compound consisting of two or more of these components. The equilibrium process is, for example, \[\ce{AB.p H2O  A(aq, sat) + B(aq, sat) + p H2O(l)}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Dystonic points have been detected in aqueous media only.</rdfs:comment>
        <rdfs:comment>From Greek δύστονος, difficult (highest) tension (vapor pressure).</rdfs:comment>
        <rdfs:comment>The chemical potential of solvent and consequently its partial pressure reaches a maximum value at the dystonic composition or point, which is isothermally and isobarically invariant.</rdfs:comment>
        <rdfs:label>dystonic reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15327"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15326 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15326">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isothermal reversible reaction of a solid mixture phase \(\upgamma\) which is transformed into two (or more) different solid (pure, binary compound or mixture) phases \(\upalpha\) and \(\upbeta\) during the cooling of a system. In a binary system, \[\ce{\upgamma  \upalpha + \upbeta}\] where the forward arrow indicates the direction of cooling. The equilibrium reaction occurs along the eutectoid line at the eutectoid temperature. At the eutectoid composition, the compositions of the high temperature solid phase and the mechanical mixture of the low-temperature solid phases are equal, and intermediate to the compositions of the pure solid phases \(\upalpha\) and \(\upbeta\). This composition and the eutectoid temperature, which are isobaric invariants of the system, define the eutectoid point.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Derived from Greek and Latin, meaning &quot;resembling a eutectic&quot;.</rdfs:comment>
        <rdfs:label>eutectoid reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15327 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15327">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reversible dissolution in a system of three or more components characterized by the composition of a solution that is simultaneously saturated with respect to all (at least two or more) dissolved solutes. The two simultaneous equilibrium processes are, for example, \[\begin{array}{l}\ce{A.p H2O  A{(aq, sat)} + p H2O(l)} \\ \ce{B.q H2O  B{(aq, sat)} + q H2O(l)}\end{array}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>(isothermally and isobarically invariant) reaction of double saturation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>isothermally invariant reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Eutonic points have been detected in aqueous media only.</rdfs:comment>
        <rdfs:comment>From Greek ευτονος, easy (or lowest) tension (or vapor pressure).</rdfs:comment>
        <rdfs:comment>The chemical potential of solvent decreases along the two solubility curves that intersect at the eutonic point, and thus reaches a minimum value at that point. Thus, colligative properties (that depend on solvent activity) reach a minimum value at the eutonic point. For example, if the solutes are nonvolatile and the solvent is volatile, the vapor pressure reaches a minimum value.</rdfs:comment>
        <rdfs:comment>The eutonic point is invariant in a ternary system at a given temperature and pressure.</rdfs:comment>
        <rdfs:label>eutonic reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15344"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15328 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15328">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theoretically based or empirical equation for interpolation of data over a range of temperature, pressure, composition, or other variable.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>smoothing equation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The use of a fitting equation for extrapolation of data beyond the equation’s known range of validity is a potential source of extreme error.</rdfs:comment>
        <rdfs:label>fitting equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15323"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15329 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15329">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation relating the intensive variables \(T\), \(p\) and the \(C\) chemical potentials \(\mu_{i}\) in a phase \[S{\rm{d}}T - V{\rm{d}}p + \sum \limits_{i=1}^{C} n_{i} {\rm{d}}\mu_{i} = 0\] where \(C\) is the total number of components, \(i\) in a phase.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Note that the variables in this equation are the intensive quantities \(T\), \(p\) and \(\mu_{i}\).</rdfs:comment>
        <rdfs:comment>The Gibbs–Duhem equation may be written in terms of intensive quantities, \[\sum \limits_{i=1}^{C} n_{i}(S_{i}{\rm{d}}T - V_{i}{\rm{d}}p + {\rm{d}}\mu_{i}) = 0\] where \(S_{i}\), \(V_{i}\), \(x_{i}\) are the respective partial molar entropy, partial molar volume, and mole fraction of component \(i\).</rdfs:comment>
        <rdfs:comment>There is a Gibbs–Duhem equation for each phase in a system exhibiting multiphase equilibria. Application of the conditions for an equilibrium state leads to the phase rule as one example of the application of this equation. When equilibrium conditions are applied, \(T\), \(p\) and \(\mu\) are equal in all phases of an equilibrated system, while \(S_{i}\), \(V_{i}\), and \(x_{i}\) are not.</rdfs:comment>
        <rdfs:label>Gibbs–Duhem equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15330 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15330">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in Gibbs energy at a given temperature and pressure for transfer of a substance between two different phases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>Gibbs energy of transfer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15331 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15331">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pair of equations for a binary mixture of components \(\ce{A}\) and \(\ce{B}\) that relate the variables \(T\), \(p\), in one phase of variable composition, \(\upalpha\), to the variables \(T\), \(p\), in a coexisting equilibrium phase of variable composition, \(\upbeta\): \[\begin{array}{c} -\frac{\left(1 - x_{\ce{B}}^{\beta} \right)\Delta_{\alpha}^{\beta} H_{\ce{A}} + x_{\ce{B}}^{\beta} \Delta_{\alpha}^{\beta} H_{\ce{B}}}{T}{\rm{d}}T + \left[\left(1 - x_{\ce{B}}^{\beta} \right)\Delta_{\alpha}^{\beta}V_{\ce{A}} + x_{\ce{B}}^{\beta}\Delta_{\alpha}^{\beta}V_{\ce{B}} \right]{\rm{d}}p +\left(x_{\ce{B}}^{\alpha} - x_{\ce{B}}^{\beta} \right)\left(\frac{\partial^{2} G_{\rm{m}}^{\alpha}}{\partial x_{\ce{B}}^{\alpha 2}} \right)_{T,p} {\rm{d}}x_{\ce{B}}^{\alpha} = 0 \\ -\frac{\left(1 - x_{\ce{B}}^{\alpha} \right)\Delta_{\alpha}^{\beta} H_{\ce{A}} + x_{\ce{B}}^{\alpha} \Delta_{\alpha}^{\beta} H_{\rm{B}}}{T}{\rm{d}}T + \left[\left(1 - x_{\ce{B}}^{\alpha} \right)\Delta_{\alpha}^{\beta}V_{\ce{A}} + x_{\ce{B}}^{\alpha}\Delta_{\alpha}^{\beta}V_{\ce{B}} \right]{\rm{d}}p +\left(x_{\ce{B}}^{\alpha} - x_{\ce{B}}^{\beta} \right)\left(\frac{\partial^{2} G_{\rm{m}}^{\alpha}}{\partial x_{\ce{B}}^{\beta 2}} \right)_{T,p} {\rm{d}}x_{\ce{B}}^{\beta} = 0 \end{array}\] where \(\Delta_{\upalpha}^{\upbeta} H_{\ce{A}} = H_{\ce{A}}^{\upbeta} - H_{\ce{A}}^{\upalpha}\), \(\Delta_{\upalpha}^{\upbeta} V_{\ce{A}} = V_{\ce{A}}^{\upbeta} - V_{\ce{A}}^{\upalpha}\) are the enthalpy and volume of transfer of component \(\ce{A}\) from phase \(\upalpha\) to phase \(\upbeta\), and similarly for component \(\ce{B}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>Gibbs–Konovalow equations</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>van der Waals’ equations</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Sometimes the German transliteration Konovalow is found.</rdfs:comment>
        <rdfs:comment>These equations show that an extremum occurs for each phase equation when the compositions of the two phases are equal, and that the slope of the \(T\)-composition or \(p\)-composition curve is zero for each phase equation at the extremum.</rdfs:comment>
        <rdfs:comment>\(\left(\frac{\partial^{2} G_{\rm{m}}}{\partial x_{\ce{B}}^{2}} \right)_{T,p} \gt 0\) (condition for diffusional stability). This quantity may also be expressed in terms of the derivatives of the chemical potentials, using \[\left(\frac{\partial^{2} G_{\rm{m}}}{\partial x_{\ce{B}}^{2}} \right)_{T,p} = -\frac{1}{x_{\ce{B}}} \left(\frac{\partial\mu_{\ce{A}}}{\partial x_{\ce{B}}} \right)_{T,p} = \frac{1}{x_{\ce{A}}} \left(\frac{\partial\mu_{\ce{B}}}{\partial x_{\ce{B}}} \right)_{T,p}\]</rdfs:comment>
        <rdfs:label>Gibbs–Konovalov equations</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15332 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15332">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System containing more than three components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>multicomponent system</oboInOwl:hasRelatedSynonym>
        <rdfs:label>higher-order system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15333 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15333">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Limiting composition or other variable in a solution obtained by extrapolating to a value of zero for the variable describing the composition of the solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>infinite dilution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15334 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15334">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Property of a system of forming a single phase at all relative proportions of its components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>miscibility in all proportions</oboInOwl:hasRelatedSynonym>
        <rdfs:label>infinite miscibility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15342"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15335 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15335">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For an ionized salt \(\ce{B}\) in solution, \[x_{+\rm{B}} = \frac{ u_{+\ce{B}}x_{\ce{B}}}{1 + \sum \limits_{i=1}^{s} \left( u_{i} - 1 \right)x_{i}},x_{-\ce{B}} = \frac{ u_{-\ce{B}}x_{+\ce{B}}}{ u_{+\ce{B}}}\] where the summation is over all $s$ solute components \(i\) and \( u_{i} =  u_{+i} +  u_{-i}\) is the sum of the stoichiometric numbers of the ions formed from salt \(i\). For a single solvent \(\ce{A}\) in an ionic solution, \[x&apos;_{\ce{A}} = \frac{x_{\ce{A}}}{1 + \sum \limits_{i=1}^{s} \left( u_{i} - 1 \right)x_{i}}\] Note 1: These are generalizations of terms and are used in formulating fitting equations for solubility of salts, in defining activity coefficients on the mole fraction scale, and in discussing salt effects on solubilities of gases.Note 2: Note that \[\sum \limits_{i=1}^{s} \left(x_{+i} - x_{-i} \right) + x&apos;_{\ce{A}} = 1\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>ionic amount fraction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>species amount fraction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>species mole fraction</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ionic mole fraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15336 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15336">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Line joining points of equal composition on a phase diagram.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>isopleth</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15346"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15337 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15337">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mass of one constituent \(\ce{A}\) divided by the mass of a second constituent \(\ce{B}\) in the same system. \[\zeta_{\ce{A,B}} = m_{\ce{A}}/m_{\ce{B}}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>mass ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16269"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15338 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15338">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Obsolete term for molality of a saturated solution of a gas.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>mass solubility</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15339 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15339">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isothermal reversible reaction of a solid mixture phase \(\upbeta\) which is transformed into a different solid phase \(\upalpha\) plus a liquid phase \(\ce{l}\) during cooling of a system. For a binary system, \[\ce{\upbeta  \upalpha + 1}\] where the forward arrow indicates the direction of cooling. The equilibrium transformation occurs along the metatectic line characterized by the metatectic temperature. The metatectic composition and temperature, isobaric invariants of the system, define the metatectic point, which lies between the compositions of liquid \(\ce{l}\) and solid phase \(\upalpha\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>catatectic reaction</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>From Greek μετα-, referring to position of melting relative to eutectectic and monotectic + -τηκτος, fusible.</rdfs:comment>
        <rdfs:comment>Occasionally, a similar reaction takes place in the subsolidus region. Quite appropriately, it is called metatectoid reaction.</rdfs:comment>
        <rdfs:comment>The alternate name catatectic reaction, from Greek κατα, down + -τηκτος, fusible has been suggested to emphasize the phenomenon of melting during cooling.</rdfs:comment>
        <rdfs:label>metatectic reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15340 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15340">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deprecated term that includes both a quantity and a unit. Replace by mole fraction expressed as percent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>mole percent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15341 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15341">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Amount of one constituent divided by the amount of a second constituent in the same system. For constituents 1 and 2, \[r_{12} = n_{1}/n_{2}\]</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>amount ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:label>mole ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16269"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15342 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15342">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a system of two or more liquid or solid components, solubility of all components in all phases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>If mutual solubility is limited over a range of temperature and composition, the liquids or solids are said to exhibit partial miscibility and the system possesses a miscibility gap.</rdfs:comment>
        <rdfs:label>mutual solubility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15343 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15343">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solute which forms an unsaturated solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Together with the term saturating solute used to distinguish among solutes in ternary and higher-order systems.</rdfs:comment>
        <rdfs:label>non-saturating solute</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15332"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15355"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15344 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15344">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Isothermal, isobaric reversible reaction between two phases, a saturated liquid and a solid, that results, on removal of the solvent component of a ternary system in one new solid phase. For example, \[\ce{l + \upalpha  \upbeta}\] where the forward arrow indicates the direction of removal of the solvent component. The system is in equilibrium along the peritonic line, on which is found the peritonic composition or point, an isothermal, isobaric invariant of the system which lies between the compositions of phases \(\ce{l}\) and \(\upalpha\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>transition reaction (in phase equilibria)</oboInOwl:hasRelatedSynonym>
        <rdfs:label>peritonic reaction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15325"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15327"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15345 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15345">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>One part in a thousand parts.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>per mille</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>permille</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>promille</oboInOwl:hasRelatedSynonym>
        <rdfs:label>permil</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15346 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15346">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Graphical representation, by use of points, lines, and surfaces, of the phases present at chemical equilibrium in unary, binary, ternary, and higher-order systems containing two or more phases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Phase diagrams may employ any pairs of the variables temperature, pressure, and compositions of various phases. Thus, temperature-composition and pressure-composition phase diagrams are possible, as well as diagrams showing only compositions under isothermal or isobaric conditions.</rdfs:comment>
        <rdfs:label>phase diagram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15332"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15347 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15347">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Factor used to convert experimentally determined Henry’s law constants at the saturation vapor pressure of the solvent \(\ce{A}\), \(p_{\ce{A}}^{\ast}\), to a reference pressure \(p\) \[\begin{array}{c} I_{\rm{p}} = \int_{p_{\ce{A}}^{\ast}}^p \frac{V_{\ce{B}}^{\infty {\rm{l}}}}{RT}{\rm{d}}p \\ k_{\rm{H},\ce{B}}(p) = k_{\rm{H},\ce{B}}(p^{\ast}) \exp \left[I_{\rm{p}}(p) \right]\end{array}\] is the partial molar volume of liquid \(\ce{B}\) at infinite dilution in solvent \(\ce{A}\). The second equation gives the relation between the two Henry’s law constants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>Poynting correction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15348 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15348">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Data reported in peer-reviewed scientific reports of original research which allow an assessment of data quality.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Primary data are distinguished from secondary data appearing in reviews, handbooks, compendia, etc. which hold the possibility of error and bias through transcription error, incomplete coverage of the primary literature, etc.</rdfs:comment>
        <rdfs:label>primary data</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15323"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15349 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15349">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Fugacity (\(\tilde{p}_{\ce{B}}\)) of a gaseous component (\(\ce{B}\)) in equilibrium with a liquid or solid mixture containing \(\ce{B}\) is directly proportional to the activity (\(a_{\ce{B}}\)) of the component in the mixture \[\tilde{p}_{\ce{B}} = \tilde{p}_{\ce{B}}^{\ast} f_{\ce{B}} x_{\ce{B}}\] where \(f_{\ce{B}}\) is the activity coefficient of \(\ce{B}\) referenced to Raoult’s law at mole fraction \(x_{\ce{B}}\) and \(\tilde{p}_{\ce{B}}\) is the fugacity of pure \(\ce{B}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>An ideal mixture is defined by replacing fugacities with partial pressures and setting the activity coefficient equal to unity \[p_{\ce{B}} = p_{\ce{B}}^{\ast} x_{\ce{B}} = y_{\ce{B}}p\] The total pressure, \(p\), is then simply the sum of the partial pressures of all components.</rdfs:comment>
        <rdfs:label>Raoult’s law</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15350 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15350">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System containing \(n\) ionic species with or without a single solvent. Because of electrical neutrality, the system has \(n\) components in an aqueous system with a single solvent and \(n - 1\) components in a molten salt system.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Ternary aqueous systems containing a common ion can be considered as a limiting case of this class of system, where there is only one cation or one anion. For example, \[\ce{Na^{+},Zn^{2+} \Vert\ SO4^{2-} + H2O}\]</rdfs:comment>
        <rdfs:comment>There is a special notation for reciprocal salt systems that involves use of double vertical bars. All ionic species are specified. For example, \[\ce{K^{+},Na^{+} \Vert\ Cl^{-},NO3^{-} + H2O}\] denotes a four-component (quaternary) aqueous reciprocal salt system in which each cation can combine with each anion to produce anhydrous, hydrated, binary, or ternary solid components; i.e., the solution may become saturated with respect to any one of \(\ce{KCl}\), \(\ce{NaCl}\), \(\ce{KNO3}\), \(\ce{NaNO3}\), their hydrates, or anhydrous or hydrated binary compounds of the simple salts.</rdfs:comment>
        <rdfs:label>reciprocal salt system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15351 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15351">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Pressure divided by the critical pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>reduced pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15352 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15352">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature divided by the critical temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>reduced temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15353 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15353">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Data that are critically evaluated and verified, obtained from an identified source, and related to a property of a phenomenon, body, or substance, or a system of components of known composition and structure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>reference data</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15323"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15354 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15354">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solubility that decreases with an increase in conditions such as temperature or added component, where an increase is expected as the usual case. In ternary liquid systems with coexisting phases, where the critical solution point is not a maximum on a ternary diagram, passing from a homogeneous mixture in which the composition of a given component is greater than that of the critical mixture to a heterogeneous mixture and back to a homogeneous mixture by altering the relative amounts of the two other components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>retrograde solubility</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15365"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15355 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15355">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solute that forms a saturated solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Together with the term non-saturating solute, used to distinguish among solutes in ternary and higher-order systems.</rdfs:comment>
        <rdfs:label>saturating solute</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15332"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15343"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15356 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15356">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Dimensionless equation representing mutual solubilities in a number of chemically related liquid systems. Each mutual solubility is subtracted from the solubility at the critical solution point, and the temperature is divided by the critical solution temperature.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>scaling equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15342"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15357 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15357">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Expression of the salt effect that relates the change in solubility of a nonelectrolyte (e.g., gas or organic liquid) to changing ionic strength of aqueous solutions, \[\lg (s_{\rm{o}}/s) = K_{s} I_{s}\] where \(s_{o}\), \(s\) are the solubilities of nonelectrolyte in pure water and saline solution, respectively, \(K_{s}\) the Sechenov parameter (an empirical proportionality constant), and \(I_{s}\) the ionic strength of the saline solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>Setschenow equation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Positive values of the Sechenov parameter correspond to the commonly observed salting-out effect; negative values to the less common salting-in effect.</rdfs:comment>
        <rdfs:comment>Sechenov is the international and Setschenow the German transliteration of Сеченоь.</rdfs:comment>
        <rdfs:label>Sechenov equation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15358 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15358">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solubility of a diatomic gas in a molten metal is proportional to the square root of the partial pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Other forms of the solubility constant are common, especially in terms of amount concentrations or mass fractions (especially in metallurgical papers) instead of mole fractions.</rdfs:comment>
        <rdfs:comment>The law follows from the solubility constant for equilibrium dissolution of an ideal diatomic gas \(\ce{X2}\) in a metal \(\ce{M}\) to form an ideal solution of dissociated atoms: \[\ce{X2(g)  2X(M)}\] for which, and for dilute solutions of the gas, \[K_{{\rm{s}},x} = a(\ce{X},\ce{M})^{2}/a(\ce{X2},{\rm{g}}) \approx x(\ce{X},\ce{M})^{2} p^{_{^⦵\!}}/p (\ce{X2},\rm{g})\] where \(x(\ce{X},\ce{M})\) is the solubility of the gas in the molten metal expressed as a mole fraction of \(\ce{H\mbox{-}atoms}\). The solubility constant \(K_{\rm{s},x}\) is called the Sieverts constant.</rdfs:comment>
        <rdfs:label>Sieverts’ law</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15359"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15359 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15359">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Generalization of solubility product to include, for example, undissociated salt or uncharged cation-anion pair as solute, reaction between solution species and the cation or anion of the solid salt, and gas-solution equilibria.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>The solubility constant can also be considered in many cases as relating to a solubility equilibrium as described under solubility product plus one or more simultaneous homogeneous equilibria in solution.</rdfs:comment>
        <rdfs:label>solubility constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15360 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15360">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process by which an agent increases the solubility or the rate of dissolution of a solid or liquid solute.Modified from entry &apos;micellar solubilization&apos; in.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Solubilization is sometimes used loosely to include processes caused by agents such as surfactants which hold a component in micelles or colloidal suspension rather than in solution.</rdfs:comment>
        <rdfs:comment>The solute that is solubilized is called the solubilizate.</rdfs:comment>
        <rdfs:label>solubilisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15361 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15361">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Mole or mass fraction of a solvent in a solution containing \(s\) solute constituents (\(i = 1, 2, \ldots, s\)) and \(p\) solvent constituents (\(i = s + 1, s + 2, \ldots, p\)). For a solvent \(\ce{A}\), \[x_{{\rm{v}},{\ce{A}}} = x_{\ce{A}}/\sum \limits_{i=s+1}^{p} x_{i}\] where \[\sum \limits_{i=1}^{p} x_{i} = \sum \limits_{i=1}^{s} x_{i} + \sum \limits_{i=s+1}^{p} x_{i} = 1\] and analogously for \(w_{{\rm{v}},{\ce{A}}}\), where the first and last summations are over all solvent constituents.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>solvent mole fraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15373"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16269"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15362 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15362">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>For a solvent \(\ce{A}\), volume fraction of \(\ce{A}\) divided by the sum of the volume fractions of solvent in a solution containing both \(s\) solutes (\(i = 1, 2, \ldots, s\)) and \(p\) solvents (\(i = s + 1, s + 2, \ldots, p\)) \[\varphi_{{\rm{v}},{\ce{A}}} = \varphi_{\ce{A}}/\sum \limits_{i=s+1}^{p} \varphi_{i}\] where the summation is over the \(p\) solvent components only.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>Used to express solvent composition for a system containing a solute in a mixed solvent.</rdfs:comment>
        <rdfs:label>solvent volume fraction</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15363 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15363">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chosen value of amount concentration.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>standard concentration</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In principle, one may choose any value for the standard concentration, although the choice must be specified. The most common choice for standard concentration is \(c^{_{^⦵\!}} = \pu{1 mol dm-3}\), which is universally accepted.</rdfs:comment>
        <rdfs:label>standard amount concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15364 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15364">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Class of experimental procedures for solubility determination in which a solution of known composition is prepared. Two major subclasses are recognized. In the isothermal method, one liquid component is titrated with a second liquid component at constant temperature until persistent turbidity is observed (i.e., to the cloud point). In the polythermal method, a mixture of known composition is heated above its solution temperature and monitored visually during cooling until turbidity (the cloud point) is observed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>synthetic method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16270"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15365 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15365">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Triangular plot (usually an equilateral or right-angled triangle) whose vertices represent the pure components of a ternary system at constant temperature and pressure. Any point within the triangle represents the composition in terms of the two independent mole (or mass) fractions. Lines parallel to the sides of the triangle represent constant proportions of the respective components (isopleths).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>Gibbs’ triangular representation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In addition, any triangle of any shape, including any triangle within the main triangle, can be used to obtain the composition of the system represented by a point within the triangle in terms of the compositions represented by its vertices.</rdfs:comment>
        <rdfs:comment>In an isobaric diagram, an axis perpendicular to the plane of the triangle may be added to represent temperature.</rdfs:comment>
        <rdfs:label>ternary diagram</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15336"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15366 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15366">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System containing three components.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>ternary system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15368"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15367 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15367">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Straight line connecting compositions of independent coexisting phases in equilibrium on a phase diagram.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>connodal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>conodal</oboInOwl:hasRelatedSynonym>
        <rdfs:label>tie-line</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15346"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15368 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15368">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>System containing one component.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>unary system</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15332"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16268"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15369 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15369">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solution that has a lower proportion of a solute than one that is in equilibrium with undissolved solute at specified values of temperature and pressure.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>unsaturated solution</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15370 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15370">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>State of an unsaturated solution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>undersaturation</oboInOwl:hasRelatedSynonym>
        <rdfs:label>unsaturation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15369"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15371 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15371">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for determining composition of a solid phase in a ternary system at constant temperature and pressure by analysis of the total mixture of solid and liquid in equilibrium.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>Schreinemakers’ method</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>initial complex method</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The method is generally more reliable than isolation and analysis of the solid phase, especially when the solid phase is a hydrate.</rdfs:comment>
        <rdfs:comment>The method relies on the fact that the wet residue lies on the tie-line connecting the solid phase and the saturated liquid phase. Equally well, the initial mixture of solid and liquid used in the solubility experiment can be used, when it is referred to as the &quot;initial complex&quot; method. In either case, two or more tie-lines intersect at the composition of the solid phase.</rdfs:comment>
        <rdfs:label>wet residue method</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15367"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15372 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15372">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Theory of coexistence curves or other discontinuities in the properties of phases (such as order-disorder or magnetic transitions) in binary systems, based on a one-, two-, or three-dimensional statistical mechanical nearest-neighbor lattice theory.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>The theory predicts phase separation in a wide variety of systems, including binary liquid or solid systems that possess critical solution points.</rdfs:comment>
        <rdfs:label>Ising model</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15316"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15320"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15373 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15373">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Coordinates used mainly in representation of multicomponent phase diagrams that distinguish solutes and a single solvent. The mole or mass fractions of the \(s\) solutes are chosen as the primary composition variables and the mole or mass fraction of solvent as a secondary variable, so that the solute amount (mass) fractions may be represented, for example, in ternary and quaternary systems, as linear (ternary) or planar triangular or square planar (quaternary) diagrams, with the solvent amount or mass fraction along an axis perpendicular to the chosen diagram of solute variables. Quantitatively, \[x_{{\rm{s}},{\ce{B}}} = x_{\ce{B}}/\sum \limits_{i=1}^{s}x_{i}\] where the summation is over the \(s\) solute substances. Note that \(\sum \limits_{i=1}^{s}x_{{\rm{s}},{\ce{B}}} = 1\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <oboInOwl:hasRelatedSynonym>solute mole (or mass) fraction coordinates</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The mole fraction of solvent component \(\ce{A}\) in a mixture containing \(p - s\) solvents (total species \(p\)) is replaced by a special case of the solvent mole fraction \(x_{{\rm{s}},{\ce{A}}} = x_{\ce{A}}/\sum \limits_{i=s+1}^{p}x_{i}\), which becomes infinite for pure solvent.</rdfs:comment>
        <rdfs:comment>This quantity can be scaled to a finite value by adding an arbitrary constant to the denominator.</rdfs:comment>
        <rdfs:label>Jänecke coordinates</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15346"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15361"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15366"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15374 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15374">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume \(V^{\rm{g}}\) of an amount \(n_{\ce{B}}^{\rm{l}}\) of a dissolved gas at a given standard temperature \(T^{^⦵\!}\) (usually \(\pu{273.15 K}\)) and given standard pressure \(p^{_{^⦵\!}}\) (\(\pu{1 bar} = \pu{0.1 MPa}\) or, in older literature, \(\pu{1 atm}\)) divided by the mass \(m^{\rm{l}}\) of the dissolving liquid containing an amount $n_{\ce{A}}$ of solvent at temperature $T$ and the given pressure \(p^{_{^⦵\!}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>The Kuenen coefficient and the related quantities for expression of gas solubility: absorption coefficient, Bunsen coefficient, and Ostwald coefficient appear frequently in the older literature of gas solubility determination. However, the modern practice, recommended here, is to express gas solubility as molality, mole fraction, or mole ratio.</rdfs:comment>
        <rdfs:comment>The relations between the molality \(m_{\ce{B}}(p^{_{^⦵\!}})\) or mole fraction \(x_{\ce{B}}(p^{_{^⦵\!}})\) of dissolved gas and the Kuenen coefficients are \[\begin{array}{l} \frac{1}{x_{\ce{B}}(p^{⦵})} = 1 + \frac{1}{m_{\ce{B}}(p^{⦵})M_{\ce{A}}} = 1 + \frac{RT^{⦵}Z_{\ce{B}}^{⦵}(T^{⦵})}{p^{⦵}M_{\ce{A}}S_{\ce{B}}} \\ \frac{1}{x_{\ce{B}}(p^{⦵})} = 1 + \frac{1}{m_{\ce{B}}(p^{⦵})M_{\ce{A}}} = 1 + \frac{RT^{⦵}Z_{\ce{B}}^{⦵}(T^{⦵})}{p^{⦵}M_{\rm{A}}S_{\ce{B}}^{\ast}} \end{array}\] where \(M_{\ce{A}}\) is the molar mass the solvent and \(Z_{\ce{B}}\) is the compression factor of the gas.</rdfs:comment>
        <rdfs:comment>There are two Kuenen coefficients, depending on whether the liquid is the equilibrium solution or the pure liquid, with mathematical definitions:- Kuenen coefficient, solution reference \(S_{\ce{B}} = V^{\rm{g}}(T^{^⦵\!}, p^{_{^⦵\!}}, n_{\ce{B}}^{1})/m^{\rm{l}}(T, p^{_{^⦵\!}}, n_{\ce{A}}, n_{\ce{B}}^{\rm{l}})\)- Kuenen coefficient, pure solvent reference \(S_{\ce{B}}^{\ast} = V^{\rm{g}}(T^{^⦵\!}, p^{_{^⦵\!}}, n_{\ce{B}}^{1})/m^{\rm{l}}(T, p^{_{^⦵\!}}, n_{\ce{A}})\)</rdfs:comment>
        <rdfs:label>Kuenen coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15317"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15341"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15377"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15375 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15375">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Deprecated term that includes both a quantity and a unit. Replace by mass fraction expressed as percent.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:label>mass percent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15377 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15377">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Volume \(V^{\rm{g}}\) of an amount \(n_{\ce{B}}^{\rm{l}}\) of a dissolved gas calculated at given temperature \(T\) and pressure \(p\) divided by the volume of the dissolving liquid of volume \(V^{\rm{l}}\) and containing an amount \(n_{\ce{A}}\) of solvent at the same temperature \(T\) and pressure \(p\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020233"/>
        <rdfs:comment>The Ostwald coefficient and the related quantities for expression of gas solubility, the absorption, Bunsen, and Kuenen coefficients, appear frequently in the older literature of gas solubility determination. However, the modern practice, recommended here, is to express gas solubility as molality, mole fraction, or mole ratio.</rdfs:comment>
        <rdfs:comment>The relations between the molality \(m_{\ce{B}}(p)\) or mole fraction \(x_{\ce{B}}(p)\) of dissolved gas and the Ostwald coefficients are \[\begin{array}{l} \frac{1}{x_{\ce{B}}(p)} = 1 + \frac{1}{m_{\ce{B}}(p)M_{\ce{A}}} = 1 + \frac{RTZ_{\ce{B}}}{V_{\ce{A}}p_{\ce{B}}L_{\ce{B}}} \\ \frac{1}{x_{\ce{B}}(p)} = 1 + \frac{1}{m_{\ce{B}}(p)M_{\ce{A}}} = 1 + \frac{RTZ}{pV_{m,\ce{A}}L_{\ce{B}}^{\ast}} \end{array}\] where \(V_{\ce{A}}\), \(V_{m,\ce{A}}\) are the respective partial molar volume and molar volume of the solvent and \(Z_{\ce{B}}\) is the compression factor of the gas.</rdfs:comment>
        <rdfs:comment>There are two Ostwald coefficients, depending on whether the liquid is the equilibrium solution or the pure liquid, with mathematical definitions:Ostwald coefficient, solution reference \[L_{\ce{B}} = V^{\rm{g}}(T,p,n_{\ce{B}}^{\rm{l}})/V^{\rm{l}}(T,p,n_{\ce{A}}, n_{\ce{B}}^{\rm{l}}) = c_{\ce{B}}^{\rm{l}}/c_{\ce{B}}^{\rm{g}}\] Ostwald coefficient, pure solvent reference \[L_{\ce{B}}^{\ast} = V^{\rm{g}}(T,p,n_{\ce{B}}^{\rm{l}})/V^{\rm{l}}(T,p,n_{\ce{A}})\]</rdfs:comment>
        <rdfs:label>Ostwald coefficient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15317"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15341"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15374"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15376"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15378 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15378">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metathesis polymerization of an acylic diene monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>ADMET</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acyclic diene metathesis polymerisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15378"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADMET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15379 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15379">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measured rate of polymerization divided by the concentration of the reactant (if there is only one) or the product of concentrations of the presumed reactants.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>The apparent rate constant of a polymerization should not be confused with the rate coefficients or the rate constants of the elementary reaction steps.</rdfs:comment>
        <rdfs:label>apparent rate constant of polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15418"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15380 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15380">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Increase in the rate of polymerization with increasing conversion of the reactant(s).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>auto-acceleration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15418"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15381 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15381">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Binary copolymerization in which the two monomer reactivity ratios, \(r_{12}\) and \(r_{21}\) are not both equal to unity yet the copolymerization forms a copolymer with its molar ratio of monomer units equal to the molar ratio of monomers in the monomer feed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>Although, in its equality of copolymer and monomer-feed compositions, an azeotropic polymerization has the same feature as an ideal binary copolymerization in which \(r_{12} = r_{21} = 1\), it is not an ideal copolymerization as it has \(r_{12} r_{21} \neq 1\).</rdfs:comment>
        <rdfs:comment>An azeotropic polymerization occurs at only one specific molar ratio of monomers in the feed.</rdfs:comment>
        <rdfs:label>azeotropic copolymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15405"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15406"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15410"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15382 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15382">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain transfer from an active center on a macromolecule to another part of the same macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>intramolecular chain transfer</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>An active center may be located anywhere along a macromolecular chain.</rdfs:comment>
        <rdfs:comment>Often, branching occurs or cyclic structures are formed as a result of backbiting.</rdfs:comment>
        <rdfs:label>backbiting</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15408"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15383 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15383">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Copolymerization involving two species of monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>binary copolymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15384 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15384">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization of an undiluted liquid monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>bulk polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15385 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15385">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature above which, in a given chain polymerization, polymer of high molar mass is not formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>A ceiling temperature is only observed for enthalpy-driven chain polymerizations in which \(\Delta H_{\rm{m}} \lt 0\) and \(\Delta S_{\rm{m}} \lt 0\), where \(\Delta H_{\rm{m}}\) and \(\Delta S_{\rm{m}}\) are respectively the enthalpy and entropy change per mole of monomer reacted.</rdfs:comment>
        <rdfs:comment>Because \(\Delta G_{\rm{m}} = 0\) at the ceiling temperature, \(T_{\rm{c}} = \Delta H_{\rm{m}}/\Delta S_{\rm{m}}\). If \(\Delta H_{\rm{m}}^{\circ}\) and \(\Delta S_{\rm{m}}^{\circ}\) are the enthalpy and entropy changes in the standard state, and the monomer behaves ideally, then \[T_{\rm{c}} = \Delta H_{\rm{m}}^{\circ}/\{\Delta S_{\rm{m}}^{\circ} + R\ln ([{\rm{M}}]_{0}/c^{\circ})\}\] where \(c^{\circ} = \pu{1 mol dm-3}\) is the standard concentration and \([{\rm{M}}]_{0}\) is the initial monomer concentration. Thus, \(T_{\rm{c}}\) depends on the initial monomer concentration.</rdfs:comment>
        <rdfs:comment>Below \(T_{\rm{c}}\), \(\Delta G_{\rm{m}} (= \Delta H_{\rm{m}} - T\Delta S_{\rm{m}}) \lt 0\); at \(T_{\rm{c}}\), \(\Delta G_{\rm{m}} = 0\); and above \(T_{\rm{c}}\), \(\Delta G_{\rm{m}} \gt 0\).</rdfs:comment>
        <rdfs:comment>For most chain polymerizations, \(\Delta H_{\rm{m}} \lt 0\) and \(\Delta S_{\rm{m}} \lt 0\).</rdfs:comment>
        <rdfs:comment>The symbol \(T_{\rm{c}}(c^{\circ})\) is used to denote the ceiling temperature when the initial monomer concentration, \([{\rm{M}}]_{0}\), is equal to \(c^{\circ}\).</rdfs:comment>
        <rdfs:comment>The symbol \(T_{\rm{c}}({\rm{bulk}})\) is used to denote the ceiling temperature when the initial monomer concentration is equal to its undiluted concentration.</rdfs:comment>
        <rdfs:label>ceiling temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15401"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15386 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15386">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain polymerization in which a copolymer is formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>chain copolymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15387 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15387">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chemical reaction that results in the formation of a monomer molecule at an active center on the terminal unit of a chain carrier and decreases the degree of polymerization of the chain carrier by one.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>depropagation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Chain depropagation is the reverse of chain propagation.</rdfs:comment>
        <rdfs:label>chain depropagation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15426"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15388 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15388">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a binary copolymerization, the ratio of two rate constants defining the relative activity of an active center on a given type of terminal unit of a chain carrier toward one type of monomer, in the two cases where the penultimate unit of the chain carrier is identical to and different from the terminal unit.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>radical reactivity ratio</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The chain-end reactivity ratios are expressed mathematically by the equations \[s_{1} = k_{211}/k_{111};\ s_{2} = k_{122}/k_{222}\].</rdfs:comment>
        <rdfs:comment>The monomer reactivity ratios, defined in accordance with the penultimate-unit effect, are \[r_{112} = k_{111}/k_{112};\ r_{212} = k_{211}/k_{212};\ r_{221} = k_{222}/k_{221};\ r_{121} = k_{122}/k_{121}\]. The symbols for the monomer reactivity ratios are often abbreviated to \(r_{1}\), \(r_{1}^{\prime}\), \(r_{2}\), \(r_{2}^{\prime}\), respectively (see monomer reactivity ratios for the definitions of \(r_{1}\) and \(r_{2}\) ignoring the penultimate-unit effect).</rdfs:comment>
        <rdfs:comment>The reactions involved are defined in accordance with the penultimate-unit effect, namely, \[\begin{array}{l} ...-{\rm{m}}_{11}^{\ast} + {\rm{M}}_{1}\ce{-&gt;[\textit{k}_{111}]} ...-{\rm{m}}_{11}^{\ast} \\ ...-{\rm{m}}_{21}^{\ast} + {\rm{M}}_{1}\ce{-&gt;[\textit{k}_{211}]} ...-{\rm{m}}_{11}^{\ast} \\ ...-{\rm{m}}_{11}^{\ast} + {\rm{M}}_{2}\ce{-&gt;[\textit{k}_{112}]} ...-{\rm{m}}_{12}^{\ast} \\ ...-{\rm{m}}_{21}^{\ast} + {\rm{M}}_{2}\ce{-&gt;[\textit{k}_{212}]} ...-{\rm{m}}_{12}^{\ast} \\ ...-{\rm{m}}_{12}^{\ast} + {\rm{M}}_{1}\ce{-&gt;[\textit{k}_{121}]} ...-{\rm{m}}_{21}^{\ast} \\ ...-{\rm{m}}_{22}^{\ast} + {\rm{M}}_{1}\ce{-&gt;[\textit{k}_{221}]} ...-{\rm{m}}_{21}^{\ast} \\ ...-{\rm{m}}_{12}^{\ast} + {\rm{M}}_{2}\ce{-&gt;[\textit{k}_{122}]} ...-{\rm{m}}_{22}^{\ast} \\ ...-{\rm{m}}_{22}^{\ast} + {\rm{M}}_{2}\ce{-&gt;[\textit{k}_{222}]} ...-{\rm{m}}_{22}^{\ast}, \end{array}\] where \({\rm{M}}_{1}\) and \({\rm{M}}_{2}\) are the two monomers involved in the binary copolymerization and \(-{\rm{m}}_{ij}^{\ast} (i,j = 1,2)\) denotes a chain carrier having an active site on its terminal monomer unit of type \({\rm{M}}_{j}\) and having the adjacent, penultimate monomer unit of type \({\rm{M}}_{i}\) (see chain carrier).</rdfs:comment>
        <rdfs:label>chain-end reactivity ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15410"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15413"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15389 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15389">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a homopolymerization, rate constant for chain transfer, \(k_{\rm{tr}}\), divided by the rate constant for chain propagation, \(k_{\rm{p}}\), i.e., \(C_{\rm{tr}} = k_{\rm{tr}}/k_{\rm{p}}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>chain-transfer constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15390 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15390">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Monomer used in copolymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>comonomer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15391 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15391">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equation relating the instantaneous composition of a binary copolymer to the monomer reactivity ratios and the ratio of instantaneous monomer concentrations.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>Mayo–Lewis equation</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Integrated forms of the copolymer composition equation have been developed to relate polymer composition to monomer reactivity ratios and monomer conversions.</rdfs:comment>
        <rdfs:comment>See also chain-end reactivity ratio, monomer reactivity ratios.</rdfs:comment>
        <rdfs:comment>The copolymer composition equation is known also as the Mayo–Lewis equation.</rdfs:comment>
        <rdfs:comment>The instantaneous composition of copolymer generally changes during the course of a copolymerization due to the changing composition of the monomer mixture (but see azeotropic polymerization).</rdfs:comment>
        <rdfs:label>copolymerisation composition equation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15381"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15388"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15410"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15392 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15392">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Linking of two macromolecules through chemical reaction.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>The coupling may proceed with or without interaction with an added coupling agent.</rdfs:comment>
        <rdfs:label>coupling reaction</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15393 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15393">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Propagation reaction in a copolymerization in which a chain carrier, bearing at its active end a monomer unit of one kind, reacts with a monomer molecule of another kind.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>The recommended symbol for the rate constant of cross-propagation in a binary copolymerization is \(k_{ij}\) , in which \(i\) and \(j\) refer to (a) the type of terminal monomer unit of the chain carrier and (b) the reacting monomer molecule, respectively.</rdfs:comment>
        <rdfs:label>cross-propagation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15394 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15394">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Termination reaction in a copolymerization between two chain carriers with different chemical structures.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>Cross-termination may occur by combination or disproportionation.</rdfs:comment>
        <rdfs:comment>Usually only the chemical structures of the units at the active centers are considered.</rdfs:comment>
        <rdfs:label>cross-termination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15395 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15395">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radical polymerization that stops, as a consequence of the depletion of the initiator, before the monomer has reacted fully.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>dead-end polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15396 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15396">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain transfer reaction that generates a new chain carrier of much lower reactivity than that of the original chain carrier.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>degradative chain transfer</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15397 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15397">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain termination in a chain polymerization in which the rate-determining step is a diffusion process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>diffusion-controlled termination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15398 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15398">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Reaction in which end-groups of a desired structure are intentionally formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>end-capping</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15399 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15399">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change of enthalpy, in a chain polymerization forming a homopolymer, associated with the conversion of one mole of monomer into polymer under isobaric and isothermal conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>molar enthalpy of polymerization</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The subscripts in \(\Delta_{\rm{ab}} H_{\rm{m}}\) denote (a) the state of the monomer and (b) the state of polymer, as follows: g: gaseous state (hypothetical in the case of polymer);l: liquid state (must be specified in the case of a mesophase);s: in solution (solvent and mesophases, if any, must be specified);c: (condensed) amorphous, glassy states;c′: crystalline or partly crystalline state; e.g., \(\Delta_{\rm{lc}} H_{\rm{m}}\) means: from liquid state to amorphous or glassy state; \(\Delta_{\rm{ss}} H_{\rm{m}}\) means: from monomer in solvent to polymer in solvent.</rdfs:comment>
        <rdfs:comment>The symbol \(\Delta H_{\rm{ab}}\), in common usage in polymer chemistry, is discouraged as the IUPAC-recommended symbol is \(\Delta_{\rm{ab}} H_{\rm{m}}\).</rdfs:comment>
        <rdfs:comment>Under defined standard conditions the enthalpy of polymerization is designated \(\Delta H_{\rm{m}}^{\circ}\).</rdfs:comment>
        <rdfs:label>enthalpy of polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15400 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15400">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change of entropy, in a chain polymerization forming a homopolymer, associated with the conversion of one mole of monomer into polymer under isobaric and isothermal conditions.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>molar entropy of polymerization</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The subscripts in \(\Delta_{\rm{ab}} S_{\rm{m}}\) denote the state of the monomer (a) and the state of polymer (b) (see enthalpy of polymerization (Note 2)).</rdfs:comment>
        <rdfs:comment>Under defined standard conditions, the entropy of polymerization is designated \(\Delta S_{\rm{m}}^{\circ}\); thus, if the standard state refers to standard concentration, and the monomer behaves ideally, \(\Delta S_{\rm{m}} = \Delta S_{\rm{m}}^{\circ} + R\ln ([{\rm{M]}}_{0}/c^{\circ})\), where \([{\rm{M}}]_{0}\) denotes the starting monomer concentration and \(c^{\circ} = \pu{1 mol dm-3}\) is the standard concentration.</rdfs:comment>
        <rdfs:label>entropy of polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15401 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15401">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Temperature below which, in a given chain polymerization, polymer of high molar mass is not formed.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>A floor temperature is only observed for entropy-driven chain polymerizations in which \(\Delta H_{\rm{m}} \gt 0\) and \(\Delta S_{\rm{m}} \gt 0\), where \(\Delta H_{\rm{m}}\) and \(\Delta S_{\rm{m}}\) are respectively the enthalpy and entropy change per mole of monomer reacted.</rdfs:comment>
        <rdfs:comment>Above \(T_{\rm{f}}\), \(\Delta G_{\rm{m}} (= \Delta H_{\rm{m}} - T \Delta H_{\rm{m}}) \lt 0\); at \(T_{\rm{f}}\), \(\Delta G_{\rm{m}} = 0\); and below \(T_{\rm{f}}\), \(\Delta G_{\rm{m}} \gt 0\).</rdfs:comment>
        <rdfs:comment>Because \(\Delta G_{\rm{m}} = 0\) at the floor temperature, \(T_{\rm{f}} = \Delta H_{\rm{m}}/\Delta S_{\rm{m}}\). If \(\Delta H_{\rm{m}}^{\circ}\) and \(\Delta S_{\rm{m}}^{\circ}\) are the enthalpy and entropy changes in the standard state, and the monomer behaves ideally, then \[T_{\rm{f}} = \Delta H_{\rm{m}}^{\circ}/ \{\Delta S_{\rm{m}}^{\circ} + R\ln ([{\rm{M]}}_{0}/c^{\circ})\}\] where \(c^{\circ} = \pu{1 mol dm-3}\) is the standard concentration and \([{\rm{M}}]_{0}\) is the initial monomer concentration. Thus, \(T_{\rm{f}}\) depends on the initial monomer concentration.</rdfs:comment>
        <rdfs:comment>Examples of chain polymerizations for which \(\Delta H_{\rm{m}} \gt 0\) and \(\Delta S_{\rm{m}} \gt 0\) are polymerizations of larger cyclic monomers, e.g., elemental sulfur (\(\ce{S8}\)) and octamethylcyclotetrasiloxane [2,2,4,4,6,6,8,8-octamethyl-1,3,5,7,2,4,6,8-tetraoxatetrasilocane], proceeding via ring-opening mechanisms.</rdfs:comment>
        <rdfs:comment>The symbol \(T_{\rm{f}}(c^{\circ})\) is used to denote the floor temperature when the initial monomer concentration, \([{\rm{M}}]_{0}\), is equal to \(c^{\circ}\).</rdfs:comment>
        <rdfs:comment>The symbol \(T_{\rm{f}}({\rm{bulk}})\) is used to denote the floor temperature when the initial monomer concentration is equal to its undiluted concentration.</rdfs:comment>
        <rdfs:label>floor temperature</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15385"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15402 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15402">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ion whose behavior is independent of the influence of a counterion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>A free ion is a distinct kinetic entity, and its reactivity is usually different from that of an ion pair.</rdfs:comment>
        <rdfs:comment>The behavior of a free ion may still be influenced by neighboring atoms or molecules.</rdfs:comment>
        <rdfs:label>free ion</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15403 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15403">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Heat absorbed or given off from the conversion of a specified amount of monomer into polymer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>The molar heat of polymerization is denoted by the symbol \(Q_{\rm{m}}\) and is the heat of polymerization of one mole of monomer. SI unit: \(\pu{J mol-1}\).</rdfs:comment>
        <rdfs:comment>The molar heat of polymerization is equal to the enthalpy of polymerization under isobaric and isothermal conditions.</rdfs:comment>
        <rdfs:label>heat of polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15399"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15404 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15404">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Addition of a monomer to a chain carrier bearing a terminal group derived from the same monomer species.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>homopropagation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15405 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15405">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Binary copolymerization in which the relative rates of incorporation of the two types of monomer into the copolymer are independent of the nature of the monomer unit at the end of a propagating chain.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>In an ideal binary copolymerization, \(k_{11}/k_{21} = k_{12}/k_{22}\) and \(r_{12} r_{21} = 1\). See monomer reactivity ratios.</rdfs:comment>
        <rdfs:comment>In the special case of an ideal binary copolymerization in which \(r_{12} = r_{21} = 1\), the two monomers show equal reactivities toward both types of propagating species. Thus, \(k_{11} = k_{21}\) and \(k_{12} = k_{22}\). Hence, copolymerization of a mixture of two monomers with any ratio of monomer concentrations in the monomer feed gives rise to a copolymer in which the molar ratio of monomer units is identical to that in the monomer feed. (See also azeotropic copolymerization.)</rdfs:comment>
        <rdfs:label>ideal binary copolymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15381"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15410"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15406 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15406">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Copolymerization in which all types of propagating species show the same relative reactivity toward the monomers present.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>ideal copolymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15407 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15407">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polycondensation involving two monomers separately dissolved in immiscible solvents, forming a twophase system, with polycondensation taking place at (or near) an interface between the two phases.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>interfacial polycondensation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15408 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15408">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain transfer from an active center on a macromolecule to a different macromolecule.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>An active center may be located anywhere along a macromolecular chain.</rdfs:comment>
        <rdfs:label>intermolecular chain transfer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15382"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15409 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15409">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In a chain polymerization, the rate of chain propagation divided by the sum of the rates of all of the chain-termination processes.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>Chain-termination processes include termination by combination or disproportionation but do not include chain transfer.</rdfs:comment>
        <rdfs:comment>In the absence of chain transfer, the kinetic-chain length will be equal to the degree of polymerization.</rdfs:comment>
        <rdfs:label>kinetic-chain length</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15410 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15410">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>In binary copolymerization, (a) the ratio (\(r_{12}\)) of the rate constant (\(k_{11}\)) for the homopropagation of monomer \(\rm{M}_{1}\) to the rate constant (\(k_{12}\)) for the cross-propagation of the chain carrier \(\ldots -{\rm{m}}_{1}^{\ast}\) with the monomer \(\rm{M}_{2}\) and (b) the ratio (\(r_{21}\)) of the rate constant (\(k_{22}\)) for the homopropagation of monomer \(\rm{M}_{2}\) to the rate constant for the cross-propagation (\(k_{21}\)) of the chain carrier \(\ldots -{\rm{m}}_{2}^{\ast}\) with monomer \(\rm{M}_{1}\). Thus, \(r_{12} = k_{11}/k_{12}, r_{21} = k_{22}/k_{21}\).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>The present definition ignores the penultimate-unit effect. For the definition of monomer reactivity ratios accounting for the penultimate-unit effect, see chain-end reactivity ratios (Note 3).</rdfs:comment>
        <rdfs:comment>The reactions involved are \[\begin{array}{l} ...-{\rm{m}}_{1}^{\ast} + {\rm{M}}_{1}\ce{-&gt;[\textit{k}_{11}]} ...-{\rm{m}}_{1}^{\ast} \\ ...-{\rm{m}}_{1}^{\ast} + {\rm{M}}_{2}\ce{-&gt;[\textit{k}_{12}]} ...-{\rm{m}}_{2}^{\ast} \\ ...-{\rm{m}}_{2}^{\ast} + {\rm{M}}_{2}\ce{-&gt;[\textit{k}_{22}]} ...-{\rm{m}}_{2}^{\ast} \\ ...-{\rm{m}}_{2}^{\ast} + {\rm{M}}_{1}\ce{-&gt;[\textit{k}_{21}]} ...-{\rm{m}}_{1}^{\ast} \\ \end{array}\] where \(\rm{M}_{1}\) and \(\rm{M}_{2}\) are the two monomers involved in the binary copolymerization and \(\ldots -{\rm{m}}_{i}^{\ast} (i = 1,2)\) denotes a chain carrier having an active site on its terminal monomer unit of type \({\rm{M}}_{i}\).</rdfs:comment>
        <rdfs:comment>The symbols \(r_{12}\) and \(r_{21}\) are often abbreviated to \(r_{1}\) and \(r_{2}\), respectively.</rdfs:comment>
        <rdfs:label>monomer reactivity ratios</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15388"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15393"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15404"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15413"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15411 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15411">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Relative scale defined by the values of the rate constants for the addition of monomers to a reference active center.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>monomer reactivity scale</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15412"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15416"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15412 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15412">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Method for the prediction of monomer reactivity ratios in binary copolymerization, based exclusively on experimentally determined parameters.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>Jenkins’ scheme</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>The parameters may be the monomer reactivity ratios for the separate copolymerizations of the monomers concerned, namely, 1 and 2, with a nonpolar monomer, e.g., styrene (\(\rm{S}\)), and a polar monomer, e.g., acrylonitrile (\(\rm{A}\)). The equations for the desired monomer reactivity ratios, \(r_{12}\) and \(r_{21}\), are then as follows: \[\ln r_{12} = \ln (r_{1\rm{S}} r_{\rm{S}2}) - [\ln\,(r_{\rm{AS}} r_{\rm{S}2}/r_{\rm{A}2)}][\ln\,(r_{\rm{SA}} r_{1\rm{S}}/r_{1\rm{A}})]/\ln\,(r_{\rm{AS}} r_{\rm{SA}})\] \[\ln r_{21} = \ln (r_{2\rm{S}} r_{\rm{S}1}) - [\ln\,(r_{\rm{AS}} r_{\rm{S}1}/r_{\rm{A}1)}][\ln\,(r_{\rm{SA}} r_{2\rm{S}}/r_{2\rm{A}})]/\ln\,(r_{\rm{AS}} r_{\rm{SA}})\]</rdfs:comment>
        <rdfs:comment>The patterns of reactivity scheme is known also as Jenkins’ scheme.</rdfs:comment>
        <rdfs:label>patterns of reactivity scheme</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15413 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15413">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Phenomenon that the penultimate monomer unit preceding the active center on the terminal unit of an active polymer chain affects the reactivity of that active center.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>penultimate-unit effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15388"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15414 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15414">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Termination reaction involving a radical chain carrier and a primary radical.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>primary-radical termination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15415 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15415">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization initiated by successive pulses of laser light.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>PLP</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>In a radical polymerization, PLP allows determination of the propagation rate constants.</rdfs:comment>
        <rdfs:label>pulsed-laser polymerisation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://dx.doi.org/10.1351/goldbook.15415"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PLP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15416 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15416">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Empirical equations expressing the monomer reactivity ratios in a binary radical copolymerization, \(r_{12}\) and \(r_{21}\), in terms of the empirical parameters \(Q\) and \(e\) for the two monomers, namely, \(\rm{Q}_{1}\), \(\rm{Q}_{2}\), \(\rm{e}_{1}\), and \(\rm{e}_{2}\), with\(r_{12} = (Q_{1}/Q_{2})\exp [-{e_{1}}(e_{1} - e_{2})]\) and \(r_{21} = (Q_{2}/Q_{1}) \exp [-{e_{2}}(e_{2} - e_{1})]\)</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>Alfrey–Price scheme</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Although the parameters are empirically derived, the parameter \(Q\) is considered to be a measure of the stabilization by conjugation of a monomer and the radical derived from it, while the parameter \(e\) is considered to be a measure of the polar effects of substituents on the monomer and the radical derived from it.</rdfs:comment>
        <rdfs:comment>The Q-e scheme is known also as the Alfrey–Price scheme.</rdfs:comment>
        <rdfs:label>&lt;i&gt;Q-e&lt;/i&gt; scheme</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15383"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15410"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15417 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15417">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Scale of the values of the rate constants for the reaction of radicals with a reference monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>radical reactivity scale</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15418 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15418">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Rate of consumption of monomers in a chain polymerization, or the rate of consumption of the functional groups in the reaction mixture of a polycondensation or polyaddition.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>rate of polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15419 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15419">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Radical formed by the rearrangement or fragmentation of a primary radical that is capable of initiating a polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>The term &quot;secondary radical&quot; is also used to designate a radical centered on a secondary carbon atom, e.g., a 2-propyl radical.</rdfs:comment>
        <rdfs:label>secondary radical</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15420 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15420">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization in which initiating species are formed exclusively from the monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>self-initiated polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15421 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15421">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Polymerization of a crystalline monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>A solid-state polymerization may lead to a semi-crystalline polymer having a crystal structure different from that of the crystalline monomer, or alternatively it may proceed as a topochemical polymerization.</rdfs:comment>
        <rdfs:comment>Depending on the initiation mode and the structure of the monomer, a solid-state polymerization may proceed by a radical or an ionic mechanism.</rdfs:comment>
        <rdfs:comment>The initiating species can be formed by the action of heat, irradiation of the monomer with, e.g., ultraviolet light or γ-rays, or (less frequently) by chemical initiation.</rdfs:comment>
        <rdfs:comment>Use of the term &quot;bulk polymerization&quot; to describe solid-state polymerization is discouraged.</rdfs:comment>
        <rdfs:label>solid-state polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15423"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15422 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15422">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain termination proceeding as a unimolecular process.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:label>spontaneous termination</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15423 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15423">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Solid-state polymerization, resulting in the formation of a polymer having essentially the same crystal structure as that of the monomer.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>A topochemical polymerization does not involve significant atomic or molecular motions.</rdfs:comment>
        <rdfs:comment>A topochemical polymerization is usually initiated by irradiation of the crystalline monomer with, e.g., ultraviolet light, γ-rays, or by chemical initiators.</rdfs:comment>
        <rdfs:label>topochemical polymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15421"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15424 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15424">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interchange reaction involving amide groups.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>amide interchange</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Transamidations commonly occur during polycondensations to form polyamides.</rdfs:comment>
        <rdfs:label>transamidation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15425 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15425">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Interchange reaction involving ester groups.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <oboInOwl:hasRelatedSynonym>ester interchange</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Transesterifications commonly occur during polycondensations to form polyesters.</rdfs:comment>
        <rdfs:label>transesterification</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15427 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15427">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Copolymerization that is a zwitterionic polymerization.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>A zwitterionic copolymerization usually involves a nucleophilic monomer and an electrophilic monomer, and it may produce an alternating copolymer.</rdfs:comment>
        <rdfs:label>zwitterionic copolymerisation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15428"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15428 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15428">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Chain polymerization in which a growing macromolecule bears two ionic chain carriers of opposite signs, at one or both of its ends.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880102163"/>
        <rdfs:comment>Chains in a zwitterionic polymerization may grow from one or both of their ends.</rdfs:comment>
        <rdfs:label>zwitterionic polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15429 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15429">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macromolecule in which the termini of the backbone are connected to form a ring.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020201"/>
        <rdfs:comment>Linear macromolecules comprising constitutional units that include small cyclic structures [e.g., the phenylene groups in poly(ethylene terephthalate)] are not cyclic macromolecules. However, a cyclic molecule comprising such constitutional (repeating) units is a cyclic macromolecule.</rdfs:comment>
        <rdfs:label>cyclic macromolecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15430 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15430">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Macrocycle in a bridged polycyclic macromolecule or polycyclic macromolecular portion that contains the subunits of highest seniority.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020201"/>
        <rdfs:comment>In macrocyclic molecules with macrocyclic substituents, the ring that contains the subunits of highest seniority is called the parent macrocycle or macrocyclic system.</rdfs:comment>
        <rdfs:label>main ring</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15432"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15431 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15431">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Number of polymer main-chain (backbone) atoms between two subunits.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020201"/>
        <rdfs:comment>Where a ring or ring system constitutes all or part of a path between two subunits, the shortest continuous chain of atoms in the ring or ring system is selected.</rdfs:comment>
        <rdfs:label>path length</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15432 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15432">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Molecule that includes more than one macrocycle, all of which have at least one atom in common with another macrocycle.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200880020201"/>
        <rdfs:comment>&quot;Multicyclic&quot; or &quot;pluricyclic&quot; have been proposed as alternative terms for polycyclic. In accordance with nomenclature of organic chemistry, the term &quot;polycyclic&quot; is used here, since it does not lead to confusion with respect to &quot;poly&quot; in polymer. Therefore, the use of &quot;multicyclic&quot; or &quot;pluricyclic&quot; is discouraged as an alternative for &quot;polycyclic&quot;.</rdfs:comment>
        <rdfs:comment>Molecules that have two rings without any common atom are not considered polycyclic, e.g., biphenyl. In general terminology, however, they are often regarded as polycyclic.</rdfs:comment>
        <rdfs:label>polycyclic macromolecule</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15433 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15433">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Process in which a substance is converted to simpler products by physical or chemical mechanisms.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>abiotic degradation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15434 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15434">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that causes pregnancy to end prematurely and causes an abortion.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>abortifacient</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15435 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15435">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Improper use of drugs or other substances.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>abuse</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15436 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15436">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance intended to kill mites, ticks, or other Acaridae.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>acaricide</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15437 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15437">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Acceptable concentration of a residue that has been established for an antibiotic found in human or animal foods.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>acceptable residue level</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15438 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15438">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability of suffering disease or injury that is considered to be sufficiently small to be &apos;negligible&apos;.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Calculated risk of an increase of one case in a million people per year for cancer is usually considered to be negligible.</rdfs:comment>
        <rdfs:label>acceptable risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15439 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15439">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Probability of suffering disease or injury that is accepted by an individual.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>accepted risk</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15440 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15440">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Unintended contact with a substance or change in the physical environment (including, e.g., radiation) resulting from an accident.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>accidental exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15441 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15441">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Equilibrium constant for the following reaction of an acid \(\ce{HB}\): \[\begin{gathered} \ce{HB(aq)  H^{+}(aq) + B^{-}(aq)} \\ K_{\rm{a}} = [\ce{H^{+}}][\ce{B^{-}}]/[\ce{HB}]c^{\rm{o}} \end{gathered}\] where \(c^{\rm{o}} = \pu{1 mol L-1}\) is the standard amount concentration and activity coefficients have been neglected.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>Because this constant differs for each acid and varies over many degrees of magnitude, the acidity constant is often represented by the additive inverse of its common logarithm, represented by the symbol \(\pu{p}K_{\rm{a}}\) (using the same mathematical relationship as [\(\ce{H^{+}}\)] is to \(\rm{pH}\)), viz.: \[\pu{p}K_{\rm{a}} = -\log_{10}K_{\rm{a}}\] In general, a larger value of \(K_{\rm{a}}\) (or a smaller value of \(\pu{p}K_{\rm{a}}\)) indicates a stronger acid, since the extent of dissociation is larger at the same concentration.</rdfs:comment>
        <rdfs:comment>This constant, because activity coefficients are neglected, is valid at a specified ionic strength. The thermodynamic dissociation constant is found by suitable extrapolation of the conditional constant to zero ionic strength. Note that it is defined as a dimensionless quantity, but sometimes it is given dimensions by omitting the standard amount concentration.</rdfs:comment>
        <rdfs:label>acid dissociation constant</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15442 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15442">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Concentration of a substance in air, soil, water, or other defined medium at which specified emergency counter-measures, such as the seizure and destruction of contaminated materials, evacuation of the local population or closing down the sources of pollution, are to be taken. Concentration of a pollutant in air, soil, water, or other defined medium at which some kind of preventive action (not necessarily of an emergency nature) is to be taken.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>action level</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15443 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15443">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Component of a mixture responsible for the biological effects of the mixture.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>active ingredient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15815"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15444 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15444">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Metabolite causing biological and (or) toxicological effects.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>active metabolite</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15445 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15445">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study in which organisms are observed during only a short part of the life span and in which there is often only a single exposure to the test agent at the beginning of the study.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>short-term toxicity test</oboInOwl:hasRelatedSynonym>
        <rdfs:label>acute toxicity test</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15559"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15446 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15446">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Change in an organism, in response to changing conditions of the environment (specifically chemical), which takes place without any irreversible disruptions of the given biological system and without exceeding normal (homeostatic) capacities of its response. Process by which an organism stabilizes its physiological condition after an environmental change.Note: If this process exceeds the homeostatic range, it becomes pathological and results in symptoms of disease (adverse effects).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>adaptation</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15447 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15447">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Difference between the incidence of an adverse effect in a treated group (of organisms or a group of exposed humans) and a control group (of the same organisms or the spontaneous incidence in humans).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>added risk</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15695"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15448 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15448">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Occurrence that causes an adverse effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:comment>An adverse event in clinical studies is any untoward reaction in a human subject participating in a research project; such an adverse event, which may be a psychological reaction, must be reported to an institutional review board.</rdfs:comment>
        <rdfs:label>adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15449 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15449">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Diameter of a spherical particle with relative density equal to unity that has the same settling velocity in air as the particle in question.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>aerodynamic diameter</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15450 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15450">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Ability of a poison to produce a change in an organism after cessation of contact.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>after-effect of a poison</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15451 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15451">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Quantitative and qualitative age dependence of an effect.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>age sensitivity</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15452 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15452">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Network of organizations that monitor air pollution. Group of measures or processes used to minimize or prevent air pollution.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>air pollution control system</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15453 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15453">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Presence of albumin, derived from plasma, in the urine.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>albuminuria</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15454 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15454">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that introduces an alkyl substituent into a compound.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>alkylating agent</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15455 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15455">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Regular and systematic pattern of growth such that the mass or size of any organ or part of a body can be expressed in relation to the total mass or size of the entire organism according to the allometric equation: \[Y = b{x^{\alpha}}\] where \(Y\) = mass of the organ, \(x\) = mass of the organism, \(\alpha\) = growth coefficient of the organ, and \(b\) is a constant.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>allometric growth</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15456 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15456">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Adjustment of data to allow for change in proportion between an organ or organs and other body parts during the growth of an organism. Adjustment of data to allow for differences and make comparisons between species having dissimilar characteristics (e.g., in size, shape, and metabolism).</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>allometric scaling</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15457 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15457">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Measurement of the rate of growth of a part or parts of an organism relative to the growth of the whole organism.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>allometry</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15458 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15458">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Semiochemical that is produced by an organism inducing a response in an organism of another species that is favorable to the emitter.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>allomone</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.15841"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16082"/>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.16124"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15459 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15459">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Study designed to examine associations, commonly putative or hypothesized causal relationships.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>analytic study</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15460 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15460">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Loss of normal cell differentiation, a feature characteristic of most malignancies.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <rdfs:label>anaplasia</rdfs:label>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15461 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15461">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Form of pneumoconiosis caused by accumulation of anthracite carbon deposits in the lungs due to inhalation of smoke or coal dust.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac200779071153"/>
        <oboInOwl:hasRelatedSynonym>coal miners’ pneumoconiosis</oboInOwl:hasRelatedSynonym>
