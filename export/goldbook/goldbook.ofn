Declaration(Class(goldbook:10920))
AnnotationAssertion(rdfs:label goldbook:10920 "maxillary")
AnnotationAssertion(dcterms:description goldbook:10920 "Relating to the maxilla (upper jaw).")
Declaration(Class(goldbook:10921))
