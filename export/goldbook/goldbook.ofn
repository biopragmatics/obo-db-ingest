AnnotationAssertion(rdfs:seeAlso goldbook:A00485 goldbook:E02175)
AnnotationAssertion(rdfs:seeAlso goldbook:A00485 goldbook:R05025)
AnnotationAssertion(rdfs:seeAlso goldbook:A00485 goldbook:R05026)
AnnotationAssertion(rdfs:seeAlso goldbook:A00485 goldbook:S05740)
AnnotationAssertion(rdfs:seeAlso goldbook:A00485 goldbook:S05975)
AnnotationAssertion(rdfs:seeAlso goldbook:A00485 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:A00485 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00485 "current"^^xsd:string)
