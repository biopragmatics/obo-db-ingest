AnnotationAssertion(rdfs:label goldbook:12101 "subarachnoid hemorrhage")
AnnotationAssertion(dcterms:description goldbook:12101 "Loss of blood into the space between the arachnoid membrane and the pia mater.")
AnnotationAssertion(rdfs:seeAlso goldbook:12101 goldbook:12010)
AnnotationAssertion(mito:isMentionedBy goldbook:12101 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12101 "current"^^xsd:string)
