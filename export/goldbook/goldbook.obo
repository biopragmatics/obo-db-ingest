consider: goldbook:M03980
consider: goldbook:O04310
consider: goldbook:W06668

[Term]
id: goldbook:E02071
name: enantiomerically enriched
def: "A sample of a chiral substance whose enantiomeric ratio is greater than \\\(50\\ \\colon\\ 50\\\) but less than \\\(100\\ \\colon\\ 0\\\)."
synonym: "enantioenriched" []
property_value: mito:isMentionedBy doi:10.1351/pac199668122193
property_value: hasStatus "current" xsd:string
