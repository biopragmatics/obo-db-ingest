AnnotationAssertion(obo:goldbook#hasStatus goldbook:13176 "current"^^xsd:string)
Declaration(Class(goldbook:13177))
AnnotationAssertion(rdfs:label goldbook:13177 "gluten")
AnnotationAssertion(dcterms:description goldbook:13177 "1) Any of the prolamins found in cereal grains, especially the prolamins in wheat, rye, barley, and possibly oats, which cause digestive disorders, notably celiac disease. 2) In wheat, mixture of water-insoluble proteins, including gliadins, that give wheat dough its elastic texture.")
AnnotationAssertion(rdfs:seeAlso goldbook:13177 goldbook:12992)
AnnotationAssertion(mito:isMentionedBy goldbook:13177 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13177 "current"^^xsd:string)
Declaration(Class(goldbook:13178))
AnnotationAssertion(rdfs:label goldbook:13178 "Goodpasture syndrome")
AnnotationAssertion(dcterms:description goldbook:13178 "Autoimmune disease of humans in which glomerulonephritis and pulmonary hemorrhage are produced by complement-mediated tissue damage caused by antibodies directed against the renal glomerular and alveolar basement membranes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13178 "Goodpasture disease")
AnnotationAssertion(rdfs:seeAlso goldbook:13178 goldbook:12919)
