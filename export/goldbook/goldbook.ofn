AnnotationAssertion(rdfs:seeAlso goldbook:P04794 goldbook:S05970)
AnnotationAssertion(mito:isMentionedBy goldbook:P04794 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04794 "current"^^xsd:string)
Declaration(Class(goldbook:P04795))
AnnotationAssertion(rdfs:label goldbook:P04795 "precipitation")
AnnotationAssertion(dcterms:description goldbook:P04795 "The sedimentation of a solid material (a precipitate) from a liquid solution in which the material is present in amounts greater than its solubility in the liquid.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04795 goldbook:S05534)
AnnotationAssertion(rdfs:seeAlso goldbook:P04795 goldbook:S05740)
AnnotationAssertion(mito:isMentionedBy goldbook:P04795 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04795 "current"^^xsd:string)
Declaration(Class(goldbook:P04799))
AnnotationAssertion(rdfs:label goldbook:P04799 "precision")
AnnotationAssertion(dcterms:description goldbook:P04799 "The closeness of agreement between independent test results obtained by applying the experimental procedure under stipulated conditions. The smaller the random part of the experimental errors which affect the results, the more precise the procedure. A measure of precision (or imprecision) is the standard deviation.")
AnnotationAssertion(rdfs:comment goldbook:P04799 "As recognized in VIM, precision is sometimes misused for @A00060@. This problem will be avoided if one recognizes that precision relates only to dispersion, not to @D01650@ from the (conventional) true value. Imprecision has been defined as 'the standard error of the reported value'."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:P04799 goldbook:A00060)
AnnotationAssertion(rdfs:seeAlso goldbook:P04799 goldbook:D01650)
AnnotationAssertion(rdfs:seeAlso goldbook:P04799 goldbook:S05911)
AnnotationAssertion(mito:isMentionedBy goldbook:P04799 doi:10.1351/pac199466030595)
AnnotationAssertion(mito:isMentionedBy goldbook:P04799 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04799 "current"^^xsd:string)
Declaration(Class(goldbook:P04803))
AnnotationAssertion(rdfs:label goldbook:P04803 "preconcentration")
AnnotationAssertion(dcterms:description goldbook:P04803 "An operation (process) as a result of which the ratio of the concentration or the amount of microcomponents (trace constituents) and macrocomponents (matrix) increases. The term enrichment is not recommended.")
AnnotationAssertion(mito:isMentionedBy goldbook:P04803 doi:10.1351/pac197951051195)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04803 "current"^^xsd:string)
Declaration(Class(goldbook:P04804))
AnnotationAssertion(rdfs:label goldbook:P04804 "preconcentration coefficient")
AnnotationAssertion(dcterms:description goldbook:P04804 "This is defined as \\[K = \\frac{Q_{\\rm{T}}/Q_{\\rm{M}}}{Q_{\\rm{T}}^{\\rm{o}}/Q_{\\rm{M}}^{\\rm{o}}}\\] where \\(Q_{\\rm{T}}\\) and \\(Q_{\\rm{T}}^{\\rm{o}}\\) are the quantities of the microcomponent in the concentrate and in the sample, respectively (mass units or concentration units), and \\(Q_{\\rm{M}}^{\\rm{o}}\\) and \\(Q_{\\rm{M}}\\) and are the quantities of the matrix before and after preconcentration, respectively. If the recovery is 100%, \\(K=\\frac{Q_{\\rm{M}}^{\\rm{o}}}{Q_{\\rm{M}}}\\). The terms enrichment coefficient and enrichment factor are not recommended.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04804 goldbook:C01124)
AnnotationAssertion(rdfs:seeAlso goldbook:P04804 goldbook:P04803)
AnnotationAssertion(rdfs:seeAlso goldbook:P04804 goldbook:R05206)
AnnotationAssertion(mito:isMentionedBy goldbook:P04804 doi:10.1351/pac197951051195)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04804 "current"^^xsd:string)
Declaration(Class(goldbook:P04805))
AnnotationAssertion(rdfs:label goldbook:P04805 "precursor")
AnnotationAssertion(dcterms:description goldbook:P04805 "Of a nuclide, any radioactive nuclide which precedes that nuclide in a decay chain.")
