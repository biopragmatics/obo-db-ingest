Declaration(Class(goldbook:R05022))
AnnotationAssertion(rdfs:label goldbook:R05022 "RM value")
AnnotationAssertion(dcterms:description goldbook:R05022 "A logarithmic function of the \\(R_{\\rm{F}}\\) value (retardation factor): \\[R_{\\rm{M}}=\\log _{10}(\\frac{1\\,-\\,R_{\\rm{F}}}{R_{\\rm{F}}})=\\log _{10}(\\frac{1}{R_{\\rm{F}}}\\,-\\,1)\\]")
