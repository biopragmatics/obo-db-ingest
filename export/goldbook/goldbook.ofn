AnnotationAssertion(obo:goldbook#hasStatus goldbook:11926 "current"^^xsd:string)
Declaration(Class(goldbook:11927))
AnnotationAssertion(rdfs:label goldbook:11927 "neurodevelopmental toxicity")
AnnotationAssertion(dcterms:description goldbook:11927 "Adverse effect of a substance that disrupts developmental processes of the nervous system. Toxicity in which the developing nervous system shows heightened sensitivity compared with the adult nervous system.")
AnnotationAssertion(rdfs:seeAlso goldbook:11927 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11927 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11927 "current"^^xsd:string)
Declaration(Class(goldbook:11928))
AnnotationAssertion(rdfs:label goldbook:11928 "neurofibril")
AnnotationAssertion(dcterms:description goldbook:11928 "Part of a filamentous structure found in the cell body, axons, dendrites, and sometimes synaptic endings of neurons, consisting of bundles of neurofilaments and neurotubules.")
AnnotationAssertion(rdfs:seeAlso goldbook:11928 goldbook:11627)
AnnotationAssertion(rdfs:seeAlso goldbook:11928 goldbook:11931)
AnnotationAssertion(rdfs:seeAlso goldbook:11928 goldbook:11957)
AnnotationAssertion(rdfs:seeAlso goldbook:11928 goldbook:12109)
AnnotationAssertion(mito:isMentionedBy goldbook:11928 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11928 "current"^^xsd:string)
Declaration(Class(goldbook:11929))
AnnotationAssertion(rdfs:label goldbook:11929 "neurofibrillary tangle")
AnnotationAssertion(dcterms:description goldbook:11929 "Intracellular accumulation of aggregates of hyperphosphorylated tau protein or paired helical filaments consisting of the tau protein, a microtubule-associated protein that normally stabilizes the cytoskeleton.")
AnnotationAssertion(rdfs:comment goldbook:11929 "Neurofibrillary tangles are characteristically found in neurons of the cerebral cortex of patients with Alzheimer disease."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11929 goldbook:11574)
AnnotationAssertion(rdfs:seeAlso goldbook:11929 goldbook:11986)
AnnotationAssertion(rdfs:seeAlso goldbook:11929 goldbook:12122)
AnnotationAssertion(mito:isMentionedBy goldbook:11929 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11929 "current"^^xsd:string)
Declaration(Class(goldbook:11930))
AnnotationAssertion(rdfs:label goldbook:11930 "neurofibroma")
AnnotationAssertion(dcterms:description goldbook:11930 "Tumor of the peripheral nervous system representing an abnormal collection of Schwann cells and connective tissue.")
AnnotationAssertion(rdfs:seeAlso goldbook:11930 goldbook:12064)
AnnotationAssertion(rdfs:seeAlso goldbook:11930 goldbook:12003)
AnnotationAssertion(mito:isMentionedBy goldbook:11930 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11930 "current"^^xsd:string)
Declaration(Class(goldbook:11931))
AnnotationAssertion(rdfs:label goldbook:11931 "neurofilament")
AnnotationAssertion(dcterms:description goldbook:11931 "Class of intermediate filament of the neuronal cytoskeleton, providing support for the axon and dendrites.")
AnnotationAssertion(rdfs:seeAlso goldbook:11931 goldbook:11627)
AnnotationAssertion(rdfs:seeAlso goldbook:11931 goldbook:11928)
AnnotationAssertion(mito:isMentionedBy goldbook:11931 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11931 "current"^^xsd:string)
Declaration(Class(goldbook:11932))
AnnotationAssertion(rdfs:label goldbook:11932 "neurogenesis")
AnnotationAssertion(dcterms:description goldbook:11932 "Formation of nerve cells or of the nervous system.")
AnnotationAssertion(rdfs:seeAlso goldbook:11932 goldbook:11909)
AnnotationAssertion(rdfs:seeAlso goldbook:11932 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11932 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11932 "current"^^xsd:string)
Declaration(Class(goldbook:11933))
AnnotationAssertion(rdfs:label goldbook:11933 "neurogenic")
AnnotationAssertion(dcterms:description goldbook:11933 "Originating in, starting from, or caused by, the nervous system or nerve impulses. Relating to neurogenesis.")
