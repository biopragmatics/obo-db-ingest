AnnotationAssertion(rdfs:comment goldbook:11336 "By using this technique, the human embryo can be observed in utero as early as \\(\\pu{5 1\\!{/}\\! 2 weeks}\\) of gestation: fetal monitoring by this technique (obstetric ultrasound) is standard."^^xsd:string)
