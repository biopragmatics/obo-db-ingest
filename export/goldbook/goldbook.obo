id: goldbook:14940
name: population pyramid
def: "Diagrammatic illustration of the age structure of a population by depicting the youngest age class at the base and stacking successive age classes above it."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-08-07-09
property_value: hasStatus "current" xsd:string
