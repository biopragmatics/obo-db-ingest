        <rdfs:label>genital</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10757"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10755 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10755">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Plural of genital. Externally visible sex organs.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>genitalia</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dx.doi.org/10.1351/goldbook.10754"/>
    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.10756 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10756">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Embryonic structure that will develop into the penis and scrotum in males or the labia in females.</dcterms:description>
