consider: goldbook:08394

[Term]
id: goldbook:08428
name: symmetrization
def: "Method of removing artefacts from a two-dimensional nuclear magnetic resonance spectrum that are symmetrical about the diagonal \(e.g.\, HH COSY\) or the \\\(\\rm\{f\}1\\\) axis \(e.g.\, tilted J-resolved spectra\). Values equidistant from midline are compared and replaced the lower \(or average\) value of the two."
property_value: mito:isMentionedBy doi:10.1515/pac-2019-0203
property_value: hasStatus "current" xsd:string
