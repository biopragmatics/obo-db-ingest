AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:P04779)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:R05140)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:R05168)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:ST06775)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:S05925)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:S05970)
AnnotationAssertion(rdfs:seeAlso goldbook:G02630 goldbook:T06468)
