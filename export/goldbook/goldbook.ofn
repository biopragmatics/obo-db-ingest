Declaration(Class(goldbook:FT07505))
AnnotationAssertion(rdfs:label goldbook:FT07505 "functionality")
AnnotationAssertion(dcterms:description goldbook:FT07505 "Number of covalent bonds that a monomer molecule or monomeric unit in a macromolecule or oligomer molecule can form with other reactants.")
AnnotationAssertion(rdfs:comment goldbook:FT07505 "There are no monofunctional monomers."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07505 "If \\(f = 2\\), a linear chain macromolecule or a macrocycle can be formed."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07505 "If \\(f > 2\\), a branch point can be formed leading to a branched macromolecule, a network or a micronetwork."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:FT07505 "Ethene and ethylene glycol are examples of difunctional monomers, glycerol is an example of a trifunctional monomer, and divinylbenzene and pentaerythritol are examples of tetrafunctional monomers."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07505 goldbook:L03546)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07505 goldbook:M03662)
AnnotationAssertion(rdfs:seeAlso goldbook:FT07505 goldbook:M04017)
