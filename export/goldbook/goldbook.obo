property_value: hasStatus "current" xsd:string
consider: goldbook:L03424
consider: goldbook:T06422

[Term]
id: goldbook:S05795
name: specific burn-up
def: "The total energy released through induced nuclear transformations divided by the mass of a nuclear fuel."
