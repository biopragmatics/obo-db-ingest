AnnotationAssertion(dcterms:description goldbook:13809 "Mesophase with an overall three-dimensional order of cubic symmetry.")
AnnotationAssertion(rdfs:seeAlso goldbook:13809 goldbook:13808)
AnnotationAssertion(mito:isMentionedBy goldbook:13809 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13809 "current"^^xsd:string)
Declaration(Class(goldbook:13810))
AnnotationAssertion(rdfs:label goldbook:13810 "director")
AnnotationAssertion(dcterms:description goldbook:13810 "Local symmetry axis for the singlet, orientational distribution of the molecules of a mesophase.")
AnnotationAssertion(rdfs:comment goldbook:13810 "The director is defined as a unit vector, but directions \\(\\boldsymbol{+n}\\) and \\(\\boldsymbol{-n}\\) are arbitrary."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13810 "In uniaxial nematics, formed by compounds consisting of either rod- or disc-like molecules, the mean direction of the effective molecular symmetry axis coincides with the director."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13810 "The director also coincides with a local symmetry axis of any directional property of the mesophase, such as the refractive index or magnetic susceptibility."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:13810 doi:10.1351/PAC-REC-12-03-12)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13810 "current"^^xsd:string)
Declaration(Class(goldbook:13811))
AnnotationAssertion(rdfs:label goldbook:13811 "discotic")
AnnotationAssertion(dcterms:description goldbook:13811 "Having a disc-like shape.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13811 "discoid")
