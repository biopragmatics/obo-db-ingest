AnnotationAssertion(mito:isMentionedBy goldbook:B00688 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00688 "current"^^xsd:string)
Declaration(Class(goldbook:B00692))
AnnotationAssertion(rdfs:label goldbook:B00692 "Bohr magneton")
AnnotationAssertion(dcterms:description goldbook:B00692 "Electromagnetic fundamental physical constant: \\[\\mu _{\\rm{B}} = \\frac{e\\ \\mathrm{\\hslash }}{2\\ m_{\\rm{e}}} = 9.274\\hspace{0.5em}0154\\hspace{0.25em}\\left(31\\right)\\times 10^{-24}\\ \\mathrm{J}\\ \\mathrm{T}^{-1}\\] where \\(e\\) is the elementary charge, \\(\\mathrm{\\hslash}\\) the Planck constant divided by \\(2\\ \\pi \\) and \\(m_{\\rm{e}}\\) the electron rest mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00692 goldbook:P04685)
AnnotationAssertion(rdfs:seeAlso goldbook:B00692 goldbook:E02008)
AnnotationAssertion(rdfs:seeAlso goldbook:B00692 goldbook:E02032)
AnnotationAssertion(mito:isMentionedBy goldbook:B00692 doi:10.6028/jres.092.010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00692 "current"^^xsd:string)
Declaration(Class(goldbook:B00693))
AnnotationAssertion(rdfs:label goldbook:B00693 "Bohr radius")
AnnotationAssertion(dcterms:description goldbook:B00693 "Atomic fundamental physical constant used as atomic unit of length: \\[a_{0}=\\frac{4\\ \\pi \\ \\varepsilon_{0}\\ \\mathrm{\\hslash }^{2}}{m_{\\rm{e}}\\ e^{2}}=5.291 \\ 772\\ 49\\ (24)\\times 10^{-11}\\ \\rm{m}\\] where \\(e\\) is the elementary charge, \\(\\mathrm{\\hslash}\\) is the Planck constant divided by \\(2\\ \\pi \\) and \\(m_{\\rm{e}}\\) is the electron rest mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00693 goldbook:P04685)
AnnotationAssertion(rdfs:seeAlso goldbook:B00693 goldbook:A00504)
AnnotationAssertion(rdfs:seeAlso goldbook:B00693 goldbook:E02008)
AnnotationAssertion(rdfs:seeAlso goldbook:B00693 goldbook:E02032)
AnnotationAssertion(mito:isMentionedBy goldbook:B00693 doi:10.6028/jres.092.010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00693 "current"^^xsd:string)
Declaration(Class(goldbook:B00694))
AnnotationAssertion(rdfs:label goldbook:B00694 "bolometer")
AnnotationAssertion(dcterms:description goldbook:B00694 "A detector constructed from a material having a large temperature coefficient of resistance. Absorption of radiation gives rise to a change in resistance. A bolometer is named according to its active component, e.g. thermistor bolometer, semiconductor bolometer, superconductor bolometer.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00694 goldbook:C01124)
AnnotationAssertion(rdfs:seeAlso goldbook:B00694 goldbook:R05054)
AnnotationAssertion(rdfs:seeAlso goldbook:B00694 goldbook:R05315)
AnnotationAssertion(rdfs:seeAlso goldbook:B00694 goldbook:S05591)
AnnotationAssertion(mito:isMentionedBy goldbook:B00694 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00694 "current"^^xsd:string)
Declaration(Class(goldbook:B00695))
AnnotationAssertion(rdfs:label goldbook:B00695 "Boltzmann constant")
AnnotationAssertion(dcterms:description goldbook:B00695 "The Boltzmann constant, \\(k\\), is one of seven fixed constants defining the International System of Units, the SI, with \\(k = \\pu{1.380649E-23 J K-1}\\). The Boltzmann constant is a proportionality constant between the quantities temperature (with unit kelvin) and energy (with unit joule).")
AnnotationAssertion(mito:isMentionedBy goldbook:B00695 doi:10.1088/1681-7575/aa950a)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00695 "current"^^xsd:string)
Declaration(Class(goldbook:B00696))
AnnotationAssertion(rdfs:label goldbook:B00696 "bomb-digestion")
AnnotationAssertion(dcterms:description goldbook:B00696 "Materials which are not fully dissolved by acid-digestion at atmospheric pressure may require a more vigorous treatment in pressure vessels lined with polytetrafluoroethylene (PTFE) glass, silica or vitreous (glassy) carbon or in sealed silica tubes; this treatment is called bomb-digestion. The test sample and acids are heated in such a closed vessel, so that the digestion is carried out at higher temperature and pressure.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00696 goldbook:T06285)
AnnotationAssertion(mito:isMentionedBy goldbook:B00696 doi:10.1351/pac198860091461)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:B00696 "current"^^xsd:string)
Declaration(Class(goldbook:B00697))
AnnotationAssertion(rdfs:label goldbook:B00697 "bond")
AnnotationAssertion(dcterms:description goldbook:B00697 "There is a chemical bond between two atoms or groups of atoms in the case that the forces acting between them are such as to lead to the formation of an aggregate with sufficient stability to make it convenient for the chemist to consider it as an independent 'molecular species'.")
AnnotationAssertion(rdfs:seeAlso goldbook:B00697 goldbook:A00187)
AnnotationAssertion(rdfs:seeAlso goldbook:B00697 goldbook:CT07009)
