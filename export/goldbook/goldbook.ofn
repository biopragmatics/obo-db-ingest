AnnotationAssertion(rdfs:label goldbook:P04538 "phenolates")
AnnotationAssertion(dcterms:description goldbook:P04538 "Synonymous with phenoxides. The term phenolate should not be used for solvates derived from a phenol, for the ending -ate often occurs in names for anions.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04538 goldbook:P04539)
AnnotationAssertion(rdfs:seeAlso goldbook:P04538 goldbook:P04543)
AnnotationAssertion(mito:isMentionedBy goldbook:P04538 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04538 "current"^^xsd:string)
