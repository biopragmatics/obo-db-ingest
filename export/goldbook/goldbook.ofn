Declaration(Class(goldbook:S05712))
AnnotationAssertion(rdfs:label goldbook:S05712 "slow neutrons")
AnnotationAssertion(dcterms:description goldbook:S05712 "Neutrons of kinetic energy less than some specified value. This value may vary over a wide range and depends on the application. In reactor physics, the value is frequently chosen to be \\(1\\ \\rm{eV}\\); in dosimetry, the effective cadmium cut-off is used.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05712 goldbook:E01891)
AnnotationAssertion(rdfs:seeAlso goldbook:S05712 goldbook:K03402)
AnnotationAssertion(mito:isMentionedBy goldbook:S05712 doi:10.1351/pac198254081533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05712 "current"^^xsd:string)
Declaration(Class(goldbook:S05715))
AnnotationAssertion(rdfs:label goldbook:S05715 "SM-interference")
AnnotationAssertion(dcterms:description goldbook:S05715 "Interference by a substance that produces a signal by a similar mechanism to the analyte, which in the given procedure (including the apparatus used) can not be distinguished from the signal given by the analyte. For example, in a colour reaction with an organic ligand by also reacting with the ligand and producing a coloured compound absorbing at the same wavelength as the compound produced by the analyte or in an atomic spectrochemical analysis by absorbing or emitting at the same wavelength as the analyte.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05715 goldbook:I03089)
AnnotationAssertion(rdfs:seeAlso goldbook:S05715 goldbook:L03518)
AnnotationAssertion(rdfs:seeAlso goldbook:S05715 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:S05715 doi:10.1351/pac198855030553)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05715 "current"^^xsd:string)
Declaration(Class(goldbook:S05716))
AnnotationAssertion(rdfs:label goldbook:S05716 "smog")
AnnotationAssertion(dcterms:description goldbook:S05716 "The term originated in Great Britain as a popular derivation of 'smoke-fog' and appears to have been in common use before World War 1. It originally referred to the heavy pollution derived largely from coal burning (largely smoke filled air, rich in sulfur dioxide), and it probably was largely a reducing atmosphere. More common today in cities is an oxidizing atmosphere which contains ozone and other oxidants.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05716 goldbook:F02470)
AnnotationAssertion(rdfs:seeAlso goldbook:S05716 goldbook:P04586)
AnnotationAssertion(rdfs:seeAlso goldbook:S05716 goldbook:S05719)
AnnotationAssertion(mito:isMentionedBy goldbook:S05716 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05716 "current"^^xsd:string)
Declaration(Class(goldbook:S05717))
AnnotationAssertion(rdfs:label goldbook:S05717 "smog chamber")
AnnotationAssertion(dcterms:description goldbook:S05717 "A large confined volume in which sunlight or simulated sunlight is allowed to irradiate air mixtures of atmospheric trace gases (hydrocarbons, nitrogen oxides, sulfur dioxide, etc.) which undergo oxidation. In theory these chambers allow the controlled study of complex reactions which occur in the atmosphere. However, ill-defined wall reactions which generate some molecular and radical species (e.g. $\\ce{HONO}$, $\\ce{CH2O}$, $\\ce{HO}$-radicals, etc.) and remove certain products ($\\ce{H2O2}$, $\\ce{HNO3}$, etc.), the use of reactant concentrations well above those in the atmosphere, ill-defined light intensities and wavelength distribution within the chamber, and other factors peculiar to chamber experiments require that caution be exercised in the extrapolation of results obtained from them to atmospheric systems.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05717 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:S05717 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:S05717 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:S05717 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05717 "current"^^xsd:string)
Declaration(Class(goldbook:S05718))
AnnotationAssertion(rdfs:label goldbook:S05718 "smog index")
AnnotationAssertion(dcterms:description goldbook:S05718 "A mathematical correlation between smog and meteorological and/or pollutant concentrations associated with it. These are qualitative indices which are sometimes used in some urban communities to predict the degree of the air pollution which is expected for the coming day.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05718 goldbook:A00195)
AnnotationAssertion(rdfs:seeAlso goldbook:S05718 goldbook:D01527)
AnnotationAssertion(rdfs:seeAlso goldbook:S05718 goldbook:S05716)
AnnotationAssertion(mito:isMentionedBy goldbook:S05718 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05718 "current"^^xsd:string)
Declaration(Class(goldbook:S05719))
AnnotationAssertion(rdfs:label goldbook:S05719 "smoke")
AnnotationAssertion(dcterms:description goldbook:S05719 "An aerosol originating from combustion, thermal decomposition or thermal evaporation. Its particles may be solid (magnesium oxide smoke) or liquid (tobacco smoke).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05719 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:S05719 goldbook:D01547)
AnnotationAssertion(rdfs:seeAlso goldbook:S05719 goldbook:E02227)
AnnotationAssertion(mito:isMentionedBy goldbook:S05719 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05719 "current"^^xsd:string)
Declaration(Class(goldbook:S05721))
AnnotationAssertion(rdfs:label goldbook:S05721 "soap")
AnnotationAssertion(dcterms:description goldbook:S05721 "A salt of a fatty acid, saturated or unsaturated, containing at least eight carbon atoms or a mixture of such salts. A neat soap is a lamellar structure containing much (e.g. $\\pu{75\\%}$) soap and little (e.g. $\\pu{25\\%}$) water.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05721 goldbook:S05447)
AnnotationAssertion(mito:isMentionedBy goldbook:S05721 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05721 "current"^^xsd:string)
Declaration(Class(goldbook:S05722))
AnnotationAssertion(rdfs:label goldbook:S05722 "soap curd")
AnnotationAssertion(dcterms:description goldbook:S05722 "A gel-like mixture of fibrous soap-crystals ('curd-fibres') and their saturated solution (not a mesomorphic phase).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05722 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:S05722 goldbook:M03846)
AnnotationAssertion(rdfs:seeAlso goldbook:S05722 goldbook:S05471)
AnnotationAssertion(rdfs:seeAlso goldbook:S05722 goldbook:S05721)
AnnotationAssertion(mito:isMentionedBy goldbook:S05722 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05722 "current"^^xsd:string)
Declaration(Class(goldbook:S05723))
AnnotationAssertion(rdfs:label goldbook:S05723 "soap film")
AnnotationAssertion(dcterms:description goldbook:S05723 "A term established by usage for A/W/A films stabilized by surfactants although it is not a film of soap, nor is the stabilizing surfactant necessarily a soap. (A/W/A means water film in air).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05723 goldbook:F02366)
AnnotationAssertion(rdfs:seeAlso goldbook:S05723 goldbook:S05721)
AnnotationAssertion(rdfs:seeAlso goldbook:S05723 goldbook:S06194)
AnnotationAssertion(mito:isMentionedBy goldbook:S05723 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05723 "current"^^xsd:string)
Declaration(Class(goldbook:S05726))
AnnotationAssertion(rdfs:label goldbook:S05726 "soiling")
AnnotationAssertion(dcterms:description goldbook:S05726 "Visible damage to materials by deposition of air pollutants.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05726 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:S05726 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05726 "current"^^xsd:string)
Declaration(Class(goldbook:S05727))
AnnotationAssertion(rdfs:label goldbook:S05727 "sol")
AnnotationAssertion(dcterms:description goldbook:S05727 "A fluid colloidal system of two or more components, e.g. a protein sol, a gold sol, an emulsion, a surfactant solution above the critical micelle concentration.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05727 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:S05727 goldbook:C01395)
AnnotationAssertion(rdfs:seeAlso goldbook:S05727 goldbook:E02065)
AnnotationAssertion(rdfs:seeAlso goldbook:S05727 goldbook:S06194)
AnnotationAssertion(mito:isMentionedBy goldbook:S05727 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05727 "current"^^xsd:string)
Declaration(Class(goldbook:S05728))
AnnotationAssertion(rdfs:label goldbook:S05728 "solar conversion efficiency")
AnnotationAssertion(dcterms:description goldbook:S05728 "The ratio of the Gibbs energy gain per unit time per \\(\\mathrm{m}^{2}\\) of surface exposed to the sun and the solar irradiance, \\(E\\), integrated between \\(\\lambda = 0\\) and \\(\\lambda = \\infty \\).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05728 goldbook:P04608)
AnnotationAssertion(mito:isMentionedBy goldbook:S05728 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05728 "current"^^xsd:string)
Declaration(Class(goldbook:S05729))
AnnotationAssertion(rdfs:label goldbook:S05729 "solar flare")
AnnotationAssertion(dcterms:description goldbook:S05729 "A bright eruption of energy from the sun's chromosphere.")
AnnotationAssertion(mito:isMentionedBy goldbook:S05729 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05729 "current"^^xsd:string)
Declaration(Class(goldbook:S05730))
AnnotationAssertion(rdfs:label goldbook:S05730 "solar radiation")
AnnotationAssertion(dcterms:description goldbook:S05730 "The electromagnetic radiation emitted by the sun. The total range of wavelengths of light emitted by the sun (99.9% in the range from \\(150\\ \\rm{to}\\ 4000\\ \\rm{nm}\\)) is filtered on entering the earth's atmosphere, largely through the absorption by oxygen, ozone, water vapour and carbon dioxide. Near sea level only light of wavelengths longer than about \\(290\\ \\rm{nm}\\) is present. The light from \\(290{-}400\\ \\rm{nm}\\) is effective in inducing important photochemical processes since absorption by the important trace gases, ozone, nitrogen dioxide, aldehydes, ketones, etc., is significant in this region.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05730 goldbook:A00208)
AnnotationAssertion(rdfs:seeAlso goldbook:S05730 goldbook:K03386)
AnnotationAssertion(mito:isMentionedBy goldbook:S05730 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05730 "current"^^xsd:string)
Declaration(Class(goldbook:S05731))
AnnotationAssertion(rdfs:label goldbook:S05731 "sol-gel transition")
AnnotationAssertion(dcterms:description goldbook:S05731 "Transition of a sol to a gel at the gel point.")
AnnotationAssertion(rdfs:comment goldbook:S05731 "Corrected from previous definition, within which the definition improperly attempts a redefinition of the terms sol and gel. The definition proposed here is recommended for its precision through cross-reference to the properly defined terms."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05731 goldbook:G02600)
AnnotationAssertion(rdfs:seeAlso goldbook:S05731 goldbook:GT07535)
AnnotationAssertion(rdfs:seeAlso goldbook:S05731 goldbook:P04799)
AnnotationAssertion(rdfs:seeAlso goldbook:S05731 goldbook:S05727)
AnnotationAssertion(mito:isMentionedBy goldbook:S05731 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05731 "current"^^xsd:string)
Declaration(Class(goldbook:S05732))
AnnotationAssertion(rdfs:label goldbook:S05732 "solid angle")
AnnotationAssertion(dcterms:description goldbook:S05732 "Of a cone, the ratio of the area cut out on a spherical surface (with its centre at the apex of that cone) to the square of the radius of the sphere. It is a quantity of dimension one (dimensionless quantity) with unit steradian (\\(\\mathrm{sr}=1\\)).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05732 goldbook:A00412)
AnnotationAssertion(rdfs:seeAlso goldbook:S05732 goldbook:S05971)
AnnotationAssertion(mito:isMentionedBy goldbook:S05732 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05732 "current"^^xsd:string)
Declaration(Class(goldbook:S05733))
AnnotationAssertion(rdfs:label goldbook:S05733 "solidification")
AnnotationAssertion(dcterms:description goldbook:S05733 "The transition of a liquid or gas into a solid.")
AnnotationAssertion(mito:isMentionedBy goldbook:S05733 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05733 "current"^^xsd:string)
Declaration(Class(goldbook:S05734))
AnnotationAssertion(rdfs:label goldbook:S05734 "solid phase antibody radioimmunoassay")
AnnotationAssertion(dcterms:description goldbook:S05734 "A kind of radioimmunoassay employing an antibody bound to a solid phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05734 goldbook:A00384)
AnnotationAssertion(rdfs:seeAlso goldbook:S05734 goldbook:R05105)
AnnotationAssertion(mito:isMentionedBy goldbook:S05734 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05734 "current"^^xsd:string)
Declaration(Class(goldbook:S05736))
AnnotationAssertion(rdfs:label goldbook:S05736 "solid state lasers")
AnnotationAssertion(dcterms:description goldbook:S05736 "CW or pulsed lasers in which the active medium is a solid matrix (crystal or glass) doped with an ion (e.g. $\\ce{Nd^{3+}}$, $\\ce{Cr^{3+}}$, $\\ce{Eu^{3+}}$). The emitted wavelength depends on the active ion, the selected optical transition, and the matrix. Some of these lasers are tunable within a very broad range (e.g. from \\(700\\) to \\(1000\\ \\rm{nm}\\) for $\\ce{Ti^{3+}}$ doped sapphire). Pulsed lasers may be free-running, Q-switched, or mode-locked. Some CW lasers may be mode-locked.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05736 goldbook:A00106)
AnnotationAssertion(rdfs:seeAlso goldbook:S05736 goldbook:M03958)
AnnotationAssertion(rdfs:seeAlso goldbook:S05736 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:S05736 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05736 "current"^^xsd:string)
Declaration(Class(goldbook:S05737))
AnnotationAssertion(rdfs:label goldbook:S05737 "solid support")
AnnotationAssertion(dcterms:description goldbook:S05737 "Normally an inert porous solid, which sorbs the liquid phase. The particle-size range of the support affects column efficiency and the pressure differential necessary to achieve a given flow rate. Modifications have been introduced for the achievement of special separations, in which the solid support is not inert but is an active solid. In capillary columns the inner wall of the column serves as the solid support and obviates the use of additional porous solids for this purpose.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05737 goldbook:A00109)
AnnotationAssertion(rdfs:seeAlso goldbook:S05737 goldbook:I03026)
AnnotationAssertion(mito:isMentionedBy goldbook:S05737 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05737 "current"^^xsd:string)
Declaration(Class(goldbook:S05738))
AnnotationAssertion(rdfs:label goldbook:S05738 "solidus")
AnnotationAssertion(dcterms:description goldbook:S05738 "A line on a binary phase diagram (or a surface on a ternary phase diagram) that indicates the temperature at which a system becomes completely solid on cooling or at which melting begins on heating under equilibrium conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05738 goldbook:M03821)
AnnotationAssertion(mito:isMentionedBy goldbook:S05738 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05738 "current"^^xsd:string)
Declaration(Class(goldbook:S05746))
AnnotationAssertion(rdfs:label goldbook:S05746 "solution")
AnnotationAssertion(dcterms:description goldbook:S05746 "A liquid or solid phase containing more than one substance, when for convenience one (or more) substance, which is called the solvent, is treated differently from the other substances, which are called solutes. When, as is often but not necessarily the case, the sum of the mole fractions of solutes is small compared with unity, the solution is called a dilute solution. A superscript attached to the \\(\\infty \\) symbol for a property of a solution denotes the property in the limit of infinite dilution.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05746 goldbook:D01739)
AnnotationAssertion(rdfs:seeAlso goldbook:S05746 goldbook:M03980)
AnnotationAssertion(mito:isMentionedBy goldbook:S05746 doi:10.1351/pac199062112167)
AnnotationAssertion(mito:isMentionedBy goldbook:S05746 doi:10.1351/pac199466030533)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05746 "current"^^xsd:string)
Declaration(Class(goldbook:S05747))
AnnotationAssertion(rdfs:label goldbook:S05747 "solvation")
AnnotationAssertion(dcterms:description goldbook:S05747 "Any stabilizing interaction of a solute (or solute moiety) and the solvent or a similar interaction of solvent with groups of an insoluble material (i.e. the ionic groups of an ion-exchange resin). Such interactions generally involve electrostatic forces and van der Waals forces, as well as chemically more specific effects such as hydrogen bond formation.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05747 goldbook:C01490)
AnnotationAssertion(rdfs:seeAlso goldbook:S05747 goldbook:H02899)
AnnotationAssertion(rdfs:seeAlso goldbook:S05747 goldbook:M03968)
AnnotationAssertion(rdfs:seeAlso goldbook:S05747 goldbook:RT07166)
AnnotationAssertion(rdfs:seeAlso goldbook:S05747 goldbook:V06597)
AnnotationAssertion(mito:isMentionedBy goldbook:S05747 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05747 "current"^^xsd:string)
Declaration(Class(goldbook:S05748))
AnnotationAssertion(rdfs:label goldbook:S05748 "solvatochromic relationship")
AnnotationAssertion(dcterms:description goldbook:S05748 "A linear free-energy relationship based on solvatochromism.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05748 goldbook:K03367)
AnnotationAssertion(rdfs:seeAlso goldbook:S05748 goldbook:L03551)
AnnotationAssertion(rdfs:seeAlso goldbook:S05748 goldbook:S05749)
AnnotationAssertion(mito:isMentionedBy goldbook:S05748 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05748 "current"^^xsd:string)
Declaration(Class(goldbook:S05749))
AnnotationAssertion(rdfs:label goldbook:S05749 "solvatochromism")
AnnotationAssertion(dcterms:description goldbook:S05749 "The (pronounced) change in position and sometimes intensity of an electronic absorption or emission band, accompanying a change in the polarity of the medium. Negative (positive) solvatochromism corresponds to a hypsochromic (bathochromic) shift with increasing solvent polarity.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05749 goldbook:Z06737)
AnnotationAssertion(rdfs:seeAlso goldbook:S05749 goldbook:D01746)
AnnotationAssertion(rdfs:seeAlso goldbook:S05749 goldbook:B00618)
AnnotationAssertion(rdfs:seeAlso goldbook:S05749 goldbook:H02929)
AnnotationAssertion(rdfs:seeAlso goldbook:S05749 goldbook:P04710)
AnnotationAssertion(mito:isMentionedBy goldbook:S05749 doi:10.1351/pac199466051077)
AnnotationAssertion(mito:isMentionedBy goldbook:S05749 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05749 "current"^^xsd:string)
Declaration(Class(goldbook:S05751))
AnnotationAssertion(rdfs:label goldbook:S05751 "solvent")
AnnotationAssertion(dcterms:description goldbook:S05751 "The term applied to the whole initial liquid phase containing the extractant.")
AnnotationAssertion(rdfs:comment goldbook:S05751 "The solvent may contain only one extractant or it may be a composite homogeneous mixture of extractant(s) with diluent(s) and also sometimes modifiers and accelerators."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05751 "The term solvent must not be used as a synonym for any of the individual components of a composite liquid phase even where, in the case of a single component (e.g. 3-methylbutan-2-one or tributyl phosphate), it becomes identical with the extractant."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05751 "The term may be qualified to denote the extract from a given processing step e.g. loaded solvent."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05751 goldbook:CT07545)
AnnotationAssertion(rdfs:seeAlso goldbook:S05751 goldbook:E02299)
AnnotationAssertion(mito:isMentionedBy goldbook:S05751 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05751 "current"^^xsd:string)
Declaration(Class(goldbook:S05752))
AnnotationAssertion(rdfs:label goldbook:S05752 "solvent extraction")
AnnotationAssertion(dcterms:description goldbook:S05752 "The process of transferring a substance from any matrix to an appropriate liquid phase. If the substance is initially present as a solute in an immiscible liquid phase the process is synonymous with liquid-liquid extraction.")
AnnotationAssertion(rdfs:comment goldbook:S05752 "If the extractable material is present in a solid (such as a crushed mineral or an ore) the term leaching may be more appropriate. The extractable material may also be a liquid entrapped within or adsorbed on a solid phase."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:S05752 "Common usage has established this term as a synonym for liquid-liquid distribution. This is acceptable provided that no danger of confusion with extraction from solid phases exists in a given context."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:S05752 goldbook:E02301)
AnnotationAssertion(rdfs:seeAlso goldbook:S05752 goldbook:L03587)
AnnotationAssertion(mito:isMentionedBy goldbook:S05752 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05752 "current"^^xsd:string)
Declaration(Class(goldbook:S05755))
AnnotationAssertion(rdfs:label goldbook:S05755 "solvent isotope effect")
AnnotationAssertion(dcterms:description goldbook:S05755 "A kinetic or equilibrium isotope effect resulting from change in the isotopic composition of the solvent.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05755 goldbook:I03327)
AnnotationAssertion(mito:isMentionedBy goldbook:S05755 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05755 "current"^^xsd:string)
Declaration(Class(goldbook:S05757))
AnnotationAssertion(rdfs:label goldbook:S05757 "solvent parameter")
AnnotationAssertion(dcterms:description goldbook:S05757 "Quantitative measures of the capability of solvents for interaction with solutes. Such parameters have been based on numerous different physicochemical quantities, e.g. rate constants, solvatochromic shifts in ultraviolet/visible spectra, solvent-induced shifts in infrared frequencies, etc. Some solvent parameters are purely empirical in nature, i.e. they are based directly on some experimental measurement. It may be possible to interpret such a parameter as measuring some particular aspect of solvent–solute interaction or it may be regarded simply as a measure of solvent polarity. Other solvent parameters are based on analysing experimental results. Such a parameter is considered to quantify some particular aspect of solvent capability for interaction with solutes.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:Z06737)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:D01746)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:G02710)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:K03367)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:K03412)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:P04710)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:O04322)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:S05763)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:S05757 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:S05757 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05757 "current"^^xsd:string)
Declaration(Class(goldbook:S05758))
AnnotationAssertion(rdfs:label goldbook:S05758 "solvent regeneration")
AnnotationAssertion(dcterms:description goldbook:S05758 "Treatment of the solvent for re-cycling, e.g. by removal of degradation products or non-strippable solutes. The term solvent purification is synonymous, but the terms scrubbing, stripping and washing should not be used in this context.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05758 goldbook:S05511)
AnnotationAssertion(rdfs:seeAlso goldbook:S05758 goldbook:S06054)
AnnotationAssertion(mito:isMentionedBy goldbook:S05758 doi:10.1351/pac199365112373)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05758 "current"^^xsd:string)
Declaration(Class(goldbook:S05761))
AnnotationAssertion(rdfs:label goldbook:S05761 "solvent shift")
AnnotationAssertion(dcterms:description goldbook:S05761 "A shift in the frequency of a spectral band of a chemical species arising from interaction with its solvent environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05761 goldbook:B00618)
AnnotationAssertion(rdfs:seeAlso goldbook:S05761 goldbook:H02929)
AnnotationAssertion(mito:isMentionedBy goldbook:S05761 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05761 "current"^^xsd:string)
Declaration(Class(goldbook:S05762))
AnnotationAssertion(rdfs:label goldbook:S05762 "solvolysis")
AnnotationAssertion(dcterms:description goldbook:S05762 "Generally, reaction with a solvent, or with a lyonium ion or lyate ion involving the rupture of one or more bonds in the reacting solute. More specifically the term is used for substitution elimination and fragmentation reactions in which a solvent species is the nucleophile ('alcoholysis' if the solvent is an alcohol, etc.).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05762 goldbook:E02038)
AnnotationAssertion(rdfs:seeAlso goldbook:S05762 goldbook:F02506)
AnnotationAssertion(rdfs:seeAlso goldbook:S05762 goldbook:L03653)
AnnotationAssertion(rdfs:seeAlso goldbook:S05762 goldbook:L03654)
AnnotationAssertion(rdfs:seeAlso goldbook:S05762 goldbook:N04249)
AnnotationAssertion(rdfs:seeAlso goldbook:S05762 goldbook:S06078)
AnnotationAssertion(mito:isMentionedBy goldbook:S05762 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05762 "current"^^xsd:string)
Declaration(Class(goldbook:S05763))
AnnotationAssertion(rdfs:label goldbook:S05763 "solvophobicity parameter")
AnnotationAssertion(dcterms:description goldbook:S05763 "A solvent parameter defined by: \\[Sp = 1 - \\frac{M}{M\\left(\\rm{hexadecane}\\right)}\\] derived from the Gibbs energy of transfer (\\(\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}}\\)) of a series of solutes from water to numerous aqueous-organic mixtures and to pure solvents: \\[\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}}\\left(\\rm{to solvent}\\right) = M\\ R_{\\rm{T}}+D\\] where \\(R_{\\rm{T}}\\) is a solute parameter, and \\(M\\) and \\(D\\) characterize the solvent. The \\(M\\) values are used to define a solvent solvophobic effect so that \\(Sp\\) values are scaled from unity (water) to zero (hexadecane).")
AnnotationAssertion(rdfs:seeAlso goldbook:S05763 goldbook:S05757)
AnnotationAssertion(mito:isMentionedBy goldbook:S05763 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05763 "current"^^xsd:string)
Declaration(Class(goldbook:S05764))
AnnotationAssertion(rdfs:label goldbook:S05764 "solvus")
AnnotationAssertion(dcterms:description goldbook:S05764 "A line on a binary phase diagram (or a surface on a ternary phase diagram) that defines the limit of solid solubility under equilibrium conditions.")
AnnotationAssertion(rdfs:seeAlso goldbook:S05764 goldbook:S05740)
AnnotationAssertion(mito:isMentionedBy goldbook:S05764 doi:10.1351/pac199466030577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:S05764 "current"^^xsd:string)
Declaration(Class(goldbook:S05765))
AnnotationAssertion(rdfs:label goldbook:S05765 "SOMO")
AnnotationAssertion(dcterms:description goldbook:S05765 "A Singly Occupied Molecular Orbital (such as the half-filled HOMO of a radical).")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:S05765 "SOMO")
AnnotationAssertion(rdfs:seeAlso goldbook:S05765 goldbook:H02838)
AnnotationAssertion(rdfs:seeAlso goldbook:S05765 goldbook:M03996)
