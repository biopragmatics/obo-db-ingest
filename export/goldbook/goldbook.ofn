AnnotationAssertion(rdfs:label goldbook:S06076 "substituent atom")
AnnotationAssertion(dcterms:description goldbook:S06076 "An atom (group) that replaces one or more hydrogen atoms attached to a parent structure or characteristic group except for hydrogen atoms attached to a chalcogen atom.")
