AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10636 "lobster-claw deformity")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10636 "split hand")
Declaration(Class(goldbook:10637))
AnnotationAssertion(rdfs:label goldbook:10637 "ectrosyndactyly")
