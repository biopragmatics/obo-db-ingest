Declaration(Class(goldbook:HT07582))
AnnotationAssertion(rdfs:label goldbook:HT07582 "homogeneous polymer blend")
AnnotationAssertion(dcterms:description goldbook:HT07582 "Polymer blend that is a single-phase structure.")
AnnotationAssertion(rdfs:comment goldbook:HT07582 "Modified from previous definition. The definition proposed here is preferred because it emphasizes the requirement for homogeneity over miscibility."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:HT07582 "For a polymer blend to be miscible it must obey the thermodynamic criteria of miscibility."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:HT07582 "Miscibility is sometimes assigned erroneously on the basis that a blend exhibits a single \\(T_{\\rm{g}}\\) or is optically clear."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:HT07582 "The miscible system can be thermodynamically stable or metastable."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:HT07582 "For components of chain structures that would be expected to be miscible, miscibility may not occur if molecular architecture is changed, e.g., by crosslinking."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07582 goldbook:MT07230)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07582 goldbook:P04736)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07582 goldbook:CT07136)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07582 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:HT07582 goldbook:S05900)
AnnotationAssertion(mito:isMentionedBy goldbook:HT07582 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:HT07582 "current"^^xsd:string)
