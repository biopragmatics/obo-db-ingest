AnnotationAssertion(rdfs:label goldbook:C01444 "curie")
AnnotationAssertion(dcterms:description goldbook:C01444 "Non-SI unit of radioactivity, \\(\\rm{Ci}\\approx 3.7\\times 10^{10}\\ \\rm{Bq}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:C01444 goldbook:R05092)
AnnotationAssertion(mito:isMentionedBy goldbook:C01444 doi:10.1351/pac199466122513)
