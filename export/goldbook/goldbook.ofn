Declaration(Class(goldbook:08958))
AnnotationAssertion(rdfs:label goldbook:08958 "initialization efficiency")
AnnotationAssertion(dcterms:description goldbook:08958 "Efficiency of conversion of a starting initiator or transfer agent into a macro-initiator or macro-chain-transfer agent.")
AnnotationAssertion(rdfs:seeAlso goldbook:08958 goldbook:08960)
AnnotationAssertion(rdfs:seeAlso goldbook:08958 goldbook:08962)
AnnotationAssertion(rdfs:seeAlso goldbook:08958 goldbook:08963)
AnnotationAssertion(rdfs:seeAlso goldbook:08958 goldbook:08947)
