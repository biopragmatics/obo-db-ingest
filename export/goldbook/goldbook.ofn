AnnotationAssertion(dcterms:description goldbook:12077 "Acronym for the constellation of signs salivation, lacrymation, urination, defecation, dyspnea/gastrointestinal upset, and emesis.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:12077 "SLUDGE")
AnnotationAssertion(rdfs:comment goldbook:12077 "These are consequences of stimulation of the parasympathetic nervous system by some poisons such as mushroom toxins, nerve gases, or organophosphateinsecticides."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12077 "Sometimes used as an acronym to remember functions of the parasympathetic nervous system."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12077 goldbook:11750)
AnnotationAssertion(rdfs:seeAlso goldbook:12077 goldbook:11833)
