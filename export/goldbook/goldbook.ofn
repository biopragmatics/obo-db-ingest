AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04385 "current"^^xsd:string)
Declaration(Class(goldbook:P04386))
AnnotationAssertion(rdfs:label goldbook:P04386 "π → π* transition")
AnnotationAssertion(dcterms:description goldbook:P04386 "An electronic transition described approximately as a promotion of an electron from a 'bonding' $\\ce{\\uppi\\! orbital}$ to an 'antibonding' $\\ce{\\uppi\\! orbital}$ designated as $\\ce{\\uppi\\!^{\\ast}}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:P04386 goldbook:P04877)
