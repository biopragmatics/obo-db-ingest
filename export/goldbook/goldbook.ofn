AnnotationAssertion(rdfs:label goldbook:12000 "passive avoidance test")
AnnotationAssertion(dcterms:description goldbook:12000 "Fear-motivated test in which rodents learn to avoid an otherwise preferred environment in which they are exposed to an aversive stimulus.")
AnnotationAssertion(rdfs:comment goldbook:12000 "The latency to avoid the aversive stimulus indicates changes of learning and (or) memory."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:12000 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12000 "current"^^xsd:string)
Declaration(Class(goldbook:12001))
AnnotationAssertion(rdfs:label goldbook:12001 "paw-reaching test")
AnnotationAssertion(dcterms:description goldbook:12001 "Test used to reveal motor deficits, usually of central origin, exhibited on the contralateral side by reduced ability of a test animal to extend the forelimb.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12001 "staircase test")
AnnotationAssertion(rdfs:comment goldbook:12001 "Typically performed with rodents in an apparatus resembling a staircase on which reward food pellets are placed on steps of increasing distance, or with larger animals reaching under a barrier for a reward."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12001 "Often used to assess traumatic brain injury deficits or recovery."^^xsd:string)
AnnotationAssertion(mito:isMentionedBy goldbook:12001 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12001 "current"^^xsd:string)
Declaration(Class(goldbook:12002))
AnnotationAssertion(rdfs:label goldbook:12002 "PC-12 cell")
AnnotationAssertion(dcterms:description goldbook:12002 "Cell of an established line originally derived from a pheochromocytoma of the rat adrenal medulla.")
AnnotationAssertion(rdfs:comment goldbook:12002 "PC-12 cells dividing in culture will terminally differentiate into neuron-like cells under an appropriate stimulus (e.g., nerve growth factor), making them a common model for studying neuronal differentiation and properties in culture."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12002 goldbook:11914)
AnnotationAssertion(rdfs:seeAlso goldbook:12002 goldbook:12006)
AnnotationAssertion(mito:isMentionedBy goldbook:12002 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12002 "current"^^xsd:string)
