AnnotationAssertion(dcterms:description goldbook:11761 "Characterized by or feeling intense excitement and happiness.")
AnnotationAssertion(mito:isMentionedBy goldbook:11761 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11761 "current"^^xsd:string)
Declaration(Class(goldbook:11762))
AnnotationAssertion(rdfs:label goldbook:11762 "evoked potential")
AnnotationAssertion(dcterms:description goldbook:11762 "Electrical potential that is triggered by presentation of a stimulus (somatosensory, auditory, visual) and measured with electrodes near the nerve or near the brain region in which the signal is processed.")
AnnotationAssertion(rdfs:comment goldbook:11762 "Speed, amplitude and location of the evoked potential provide information about the intactness of the response."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11762 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11762 goldbook:11909)
AnnotationAssertion(mito:isMentionedBy goldbook:11762 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11762 "current"^^xsd:string)
Declaration(Class(goldbook:11763))
AnnotationAssertion(rdfs:label goldbook:11763 "evoked response")
AnnotationAssertion(dcterms:description goldbook:11763 "Electrical potential recorded from the nervous system following exposure to a stimulus, as distinct from spontaneous potentials detected by electroencephalography, electromyography, or other electrophysiological recording methods.")
AnnotationAssertion(rdfs:seeAlso goldbook:11763 goldbook:11744)
AnnotationAssertion(rdfs:seeAlso goldbook:11763 goldbook:11745)
AnnotationAssertion(rdfs:seeAlso goldbook:11763 goldbook:11747)
AnnotationAssertion(rdfs:seeAlso goldbook:11763 goldbook:11762)
AnnotationAssertion(rdfs:seeAlso goldbook:11763 goldbook:11916)
AnnotationAssertion(mito:isMentionedBy goldbook:11763 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11763 "current"^^xsd:string)
Declaration(Class(goldbook:11764))
AnnotationAssertion(rdfs:label goldbook:11764 "excitable cell")
AnnotationAssertion(dcterms:description goldbook:11764 "Cell that can be stimulated to create an electric current; muscle fibers and nerve cells are excitable (see excitation).")
AnnotationAssertion(mito:isMentionedBy goldbook:11764 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11764 "current"^^xsd:string)
Declaration(Class(goldbook:11765))
AnnotationAssertion(rdfs:label goldbook:11765 "excitatory post-synaptic potential")
AnnotationAssertion(dcterms:description goldbook:11765 "Referring to a more positive membrane potential at the postsynaptic side of the synaptic cleft that renders the postsynaptic neuron more likely to generate an action potential.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11765 "EPSP")
AnnotationAssertion(rdfs:comment goldbook:11765 "EPSP’s are commonly produced by excitatory neurotransmitters such as glutamate."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11765 "Postsynaptic electrical activity is in part a function of the balance of EPSP’s and inhibitory post-synaptic potentials."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11765 goldbook:11562)
AnnotationAssertion(rdfs:seeAlso goldbook:11765 goldbook:11792)
AnnotationAssertion(rdfs:seeAlso goldbook:11765 goldbook:11832)
AnnotationAssertion(rdfs:seeAlso goldbook:11765 goldbook:11955)
AnnotationAssertion(rdfs:seeAlso goldbook:11765 goldbook:12016)
AnnotationAssertion(rdfs:seeAlso goldbook:11765 goldbook:12110)
AnnotationAssertion(mito:isMentionedBy goldbook:11765 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11765 "current"^^xsd:string)
Declaration(Class(goldbook:11766))
AnnotationAssertion(rdfs:label goldbook:11766 "excitotoxicity")
AnnotationAssertion(dcterms:description goldbook:11766 "Pathological process by which neurons are damaged and killed by the overactivation of receptors for the excitatory neurotransmitter glutamate, such as the N-methyl-D-aspartic acid (NMDA) receptor and the 2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid (AMPA) receptor.")
AnnotationAssertion(rdfs:comment goldbook:11766 "Excitotoxins like NMDA and kainic acid bind to glutamate receptors, and can cause excitotoxicity by allowing high levels of calcium ions to enter cells, activating enzymes such as phospholipases, endonucleases, and proteases such as calpain, which damage cell structures, including the cytoskeleton, membranes, and DNA."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11766 goldbook:11577)
AnnotationAssertion(rdfs:seeAlso goldbook:11766 goldbook:11869)
AnnotationAssertion(rdfs:seeAlso goldbook:11766 goldbook:11792)
AnnotationAssertion(rdfs:seeAlso goldbook:11766 goldbook:11842)
AnnotationAssertion(rdfs:seeAlso goldbook:11766 goldbook:11955)
AnnotationAssertion(mito:isMentionedBy goldbook:11766 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11766 "current"^^xsd:string)
Declaration(Class(goldbook:11767))
AnnotationAssertion(rdfs:label goldbook:11767 "facilitation")
AnnotationAssertion(dcterms:description goldbook:11767 "Neural facilitation: Increase in postsynaptic excitation as a result of very rapid firing of action potentials by a presynaptic neuron. Presynaptic facilitation: Increase of presynaptic excitation when an excited neuron receives additional excitatory impulses from other neurons.")
AnnotationAssertion(rdfs:seeAlso goldbook:11767 goldbook:11562)
AnnotationAssertion(rdfs:seeAlso goldbook:11767 goldbook:12016)
AnnotationAssertion(rdfs:seeAlso goldbook:11767 goldbook:12018)
AnnotationAssertion(mito:isMentionedBy goldbook:11767 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11767 "current"^^xsd:string)
Declaration(Class(goldbook:11768))
AnnotationAssertion(rdfs:label goldbook:11768 "falx")
AnnotationAssertion(dcterms:description goldbook:11768 "Continuation of dura mater between the right and left hemispheres of the brain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11768 "falx cerebri")
AnnotationAssertion(rdfs:seeAlso goldbook:11768 goldbook:11647)
AnnotationAssertion(rdfs:seeAlso goldbook:11768 goldbook:11727)
AnnotationAssertion(mito:isMentionedBy goldbook:11768 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11768 "current"^^xsd:string)
Declaration(Class(goldbook:11769))
AnnotationAssertion(rdfs:label goldbook:11769 "fasciculation")
AnnotationAssertion(dcterms:description goldbook:11769 "Involuntary contractions, or twitchings, of groups (fasciculi) of muscle fibers.")
AnnotationAssertion(rdfs:comment goldbook:11769 "This is a coarser form of repetitive muscular contraction than fibrillation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11769 goldbook:11770)
AnnotationAssertion(mito:isMentionedBy goldbook:11769 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11769 "current"^^xsd:string)
Declaration(Class(goldbook:11770))
AnnotationAssertion(rdfs:label goldbook:11770 "fibrillation")
AnnotationAssertion(dcterms:description goldbook:11770 "Rapid contractions or twitching of muscle fibrils, but not of the muscle as a whole.")
AnnotationAssertion(rdfs:comment goldbook:11770 "The term is commonly used for atrial fibrillation, where the muscles of the cardiac atrium show the phenomenon, leading to loss of normal rhythmic contraction, and also for loss of synchronized contraction of the ventricles, i.e., ventricular fibrillation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11770 goldbook:11769)
AnnotationAssertion(mito:isMentionedBy goldbook:11770 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11770 "current"^^xsd:string)
Declaration(Class(goldbook:11771))
AnnotationAssertion(rdfs:label goldbook:11771 "finger tapping test")
AnnotationAssertion(dcterms:description goldbook:11771 "Procedure in which a test subject is asked to tap a finger at maximal rate on a surface, a higher rate of tapping indicating better neuromuscular function.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11771 "tapping test")
AnnotationAssertion(mito:isMentionedBy goldbook:11771 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11771 "current"^^xsd:string)
Declaration(Class(goldbook:11772))
AnnotationAssertion(rdfs:label goldbook:11772 "flaccid")
AnnotationAssertion(dcterms:description goldbook:11772 "Relaxed, flabby, or without tone.")
AnnotationAssertion(rdfs:comment goldbook:11772 "Flaccid paralysis is a condition where one or more muscles are without tone. It is often caused by the lack of motor nerve impulses due to nerve trauma, disease or specific pharmaceuticals."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:11772 "Curare causes flaccid paralysis by binding to acetylcholine receptors and inhibiting their action."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11772 goldbook:11559)
AnnotationAssertion(rdfs:seeAlso goldbook:11772 goldbook:11909)
AnnotationAssertion(rdfs:seeAlso goldbook:11772 goldbook:11989)
AnnotationAssertion(mito:isMentionedBy goldbook:11772 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11772 "current"^^xsd:string)
Declaration(Class(goldbook:11773))
AnnotationAssertion(rdfs:label goldbook:11773 "frontal lobe")
AnnotationAssertion(dcterms:description goldbook:11773 "Most anterior of the four major lobes of each cerebral hemisphere, containing the primary motor cortex.")
AnnotationAssertion(rdfs:seeAlso goldbook:11773 goldbook:11854)
AnnotationAssertion(rdfs:seeAlso goldbook:11773 goldbook:11885)
AnnotationAssertion(mito:isMentionedBy goldbook:11773 doi:10.1515/pac-2015-0103)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:11773 "current"^^xsd:string)
Declaration(Class(goldbook:11774))
AnnotationAssertion(rdfs:label goldbook:11774 "frontotemporal dementia")
AnnotationAssertion(dcterms:description goldbook:11774 "Neurodegenerative disease characterized by progressive neuronal defects in the frontal and temporal lobes of the brain, leading to dementia.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11774 "FTD")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11774 "frontotemporal lobular degeneration (FTLD)")
AnnotationAssertion(rdfs:seeAlso goldbook:11774 goldbook:11926)
AnnotationAssertion(rdfs:seeAlso goldbook:11774 goldbook:11647)
