    </owl:Class>
    


    <!-- http://dx.doi.org/10.1351/goldbook.15462 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.15462">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Substance that prevents blood clotting (e.g., warfarin).</dcterms:description>
