AnnotationAssertion(mito:isMentionedBy goldbook:15444 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15444 "current"^^xsd:string)
Declaration(Class(goldbook:15445))
AnnotationAssertion(rdfs:label goldbook:15445 "acute toxicity test")
AnnotationAssertion(dcterms:description goldbook:15445 "Study in which organisms are observed during only a short part of the life span and in which there is often only a single exposure to the test agent at the beginning of the study.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:15445 "short-term toxicity test")
