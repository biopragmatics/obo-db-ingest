property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15493
name: avicide
def: "Substance intended to kill birds."
property_value: mito:isMentionedBy doi:10.1351/pac200779071153
property_value: hasStatus "current" xsd:string

[Term]
id: goldbook:15494
name: back-mutation
