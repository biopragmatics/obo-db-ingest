@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix goldbook: <https://goldbook.iupac.org/terms/view/> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

goldbook:08003 a skos:Concept ;
    skos:definition "Scientific discipline that develops and applies strategies, instruments, and procedures to obtain information on the composition and nature of matter in space and time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical chemistry" .

goldbook:08004 a skos:Concept ;
    skos:definition "Application of analytical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical analysis" .

goldbook:08005 a skos:Concept ;
    skos:altLabel "background interference",
        "translational matrix effect" ;
    skos:definition "Matrix effect that is independent of the measured quantity value of the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "additive matrix effect" .

goldbook:08006 a skos:Concept ;
    skos:altLabel "run" ;
    skos:definition "Set of measurements of the same quantity performed under repeatability conditions of measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical run" .

goldbook:08007 a skos:Concept ;
    skos:definition "Indication obtained from a phenomenon, body, or substance similar to the one under investigation but for which a quantity of interest is supposed not to be present or is not contributing to the indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "background indication" .

goldbook:08008 a skos:Concept ;
    skos:definition "Step in a measurement procedure in which the effect of a blank indication is removed from an indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blank correction" .

goldbook:08009 a skos:Concept ;
    skos:definition "Indication obtained from a sample of blank material under the measurement conditions for the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blank indication" .

goldbook:08010 a skos:Concept ;
    skos:altLabel "blank" ;
    skos:definition "Material which contains no, or as little as possible, of the analyte of interest used in measurement to establish a blank indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blank material" .

goldbook:08011 a skos:Concept ;
    skos:definition "Document issued by a technically competent organization providing information about a calibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration certificate" .

goldbook:08012 a skos:Concept ;
    skos:definition "Time period between calibrations over which the performance of the measuring system may be expected to meet specified requirements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration interval" .

goldbook:08013 a skos:Concept ;
    skos:definition "Property value of a reference material, accompanied by statements of associated uncertainty and traceability and identified as a certified property value in the reference material certificate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "certified property value" .

goldbook:08014 a skos:Concept ;
    skos:altLabel "purity" ;
    skos:definition "Mass (amount of substance or number of entities) of a specified component divided by the mass (amount of substance or number of entities, respectively) of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical purity" .

goldbook:08015 a skos:Concept ;
    skos:altLabel "consensus value" ;
    skos:definition "Property value derived from a collection of results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "consensus property value" .

goldbook:08016 a skos:Concept ;
    skos:altLabel "conventional value",
        "conventional value of a quantity" ;
    skos:definition "Quantity value attributed by agreement to a quantity for a given purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conventional quantity value" .

goldbook:08017 a skos:Concept ;
    skos:altLabel "critical level",
        "decision level" ;
    skos:definition "Measured quantity value for a quantity of a component in a material, above which the component is declared to be present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical value" .

goldbook:08018 a skos:Concept ;
    skos:definition "Set of operations that are carried out on an object in order to provide qualitative or quantitative information about this object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "determination" .

goldbook:08019 a skos:Concept ;
    skos:definition "Component of the matrix that embodies an influence quantity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interferent" .

goldbook:08020 a skos:Concept ;
    skos:altLabel "intermediate precision" ;
    skos:definition "Measurement precision under intermediate precision conditions of measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermediate measurement precision" .

goldbook:08021 a skos:Concept ;
    skos:definition "Contribution to measurement bias that is attributed to systematic effects on measurement results made in a laboratory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laboratory bias" .

goldbook:08022 a skos:Concept ;
    skos:altLabel "LOQ",
        "quantification limit" ;
    skos:definition "Smallest or largest measured quantity value, obtained by a given measurement procedure, which fulfils a requirement of fitness for purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limit of quantification" .

goldbook:08023 a skos:Concept ;
    skos:definition "Ability of a measuring system to provide measured quantity values that are directly proportional to the quantity value of the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linearity of a measuring system" .

goldbook:08024 a skos:Concept ;
    skos:altLabel "calibration linearity" ;
    skos:definition "Closeness of agreement between indications obtained using calibrators in the first step of a calibration and indications predicted by the calibration function for the calibrators’ reference quantity values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linearity of calibration" .

goldbook:08025 a skos:Concept ;
    skos:definition "Uniform structure or composition of a material with respect to one or more specified properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "material homogeneity" .

goldbook:08026 a skos:Concept ;
    skos:altLabel "recovery" ;
    skos:definition "Mass (volume, amount of substance) of a specified component isolated from a system divided by the mass (volume, amount of substance) of the system prior to isolation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "material recovery" .

goldbook:08027 a skos:Concept ;
    skos:altLabel "stability" ;
    skos:definition "Constancy of a property of a material over time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "material stability" .

goldbook:08028 a skos:Concept ;
    skos:definition "Detailed description of a measurement according to one or more measurement principles and to a given measurement method, based on a measurement model and including any calculation to obtain a measurement result." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement procedure" .

goldbook:08029 a skos:Concept ;
    skos:altLabel "measurement method bias" ;
    skos:definition "Contribution to measurement bias that is attributed to systematic effects on measurement results made according to a measurement procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement procedure bias" .

goldbook:08030 a skos:Concept ;
    skos:altLabel "standard addition" ;
    skos:definition "Measurement procedure in which indications are obtained for an analytical sample as well as for analytical samples with addition(s) of a measurement standard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement procedure with standard addition" .

goldbook:08031 a skos:Concept ;
    skos:altLabel "reproducibility" ;
    skos:definition "Measurement precision under reproducibility conditions of measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement reproducibility" .

goldbook:08032 a skos:Concept ;
    skos:altLabel "metrological compatibility" ;
    skos:definition "Property of a set of measurement results for a specified measurand, such that the absolute value of the difference of any pair of measured quantity values from two different measurement results is smaller than some chosen multiple of the standard measurement uncertainty of that difference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metrological compatibility of measurement results" .

goldbook:08033 a skos:Concept ;
    skos:altLabel "equivalence of measurement results" ;
    skos:definition "Property of two or more measurement results for a given measurand which have metrological compatibility of measurement results, so that they are each acceptable for the same specified intended use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metrological equivalence of measurement results" .

goldbook:08034 a skos:Concept ;
    skos:altLabel "minimum sample intake" ;
    skos:definition "Lower limit of sample size stipulated in documentation taken for chemical analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum sample size" .

goldbook:08035 a skos:Concept ;
    skos:definition "Matrix effect that is proportional to the measured quantity value of the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplicative matrix effect" .

goldbook:08036 a skos:Concept ;
    skos:definition "Property value that is provided for information only but is not certified by a reference material producer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-certified property value" .

goldbook:08037 a skos:Concept ;
    skos:altLabel "traceability (of an object)" ;
    skos:definition "Ability to trace the history, application, or location of an object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "object traceability" .

goldbook:08038 a skos:Concept ;
    skos:altLabel "value assignment" ;
    skos:definition "Determination of property values obtained in the course of the production of a reference material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "property value assignment" .

goldbook:08039 a skos:Concept ;
    skos:altLabel "analytical recovery",
        "recovery" ;
    skos:definition "Measured quantity value relating a component to a system divided by a reference value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recovered quantity value ratio" .

goldbook:08040 a skos:Concept ;
    skos:altLabel "repeatability condition" ;
    skos:definition "Condition of measurement, out of a set of conditions that includes the same measurement procedure, same operators, same measuring system, same operating conditions, and same location, and replicate measurements on the same or similar objects over a short period of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repeatability condition of measurement" .

goldbook:08041 a skos:Concept ;
    skos:definition "Contribution to measurement bias that is attributed to systematic effects on measurement results made in a single analytical run." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "run bias" .

goldbook:08042 a skos:Concept ;
    skos:altLabel "sample preparation" ;
    skos:definition "Collective noun for all procedures used for conditioning a sample to a defined state which allows subsequent chemical analysis or long-term storage (see material stability)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample pre-treatment" .

goldbook:08043 a skos:Concept ;
    skos:definition "Act of taking or constituting a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling" .

goldbook:08044 a skos:Concept ;
    skos:altLabel "increment" ;
    skos:definition "Individual portion of material collected by a single operation of a sampling device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling increment" .

goldbook:08045 a skos:Concept ;
    skos:definition "Portion of the material, at a particular time, that the sample is intended to represent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling target" .

goldbook:08046 a skos:Concept ;
    skos:definition "Time interval during which a reference material producer warrants the material stability of the reference material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shelf life" .

goldbook:08047 a skos:Concept ;
    skos:definition "Material with known quantity values added to an analytical sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spike" .

goldbook:08048 a skos:Concept ;
    skos:definition "Recognized effect of an influence quantity on a measured quantity value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systematic effect" .

goldbook:08049 a skos:Concept ;
    skos:altLabel "test" ;
    skos:definition "Determination of one or more characteristics of an object of conformity assessment, according to a specified procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "testing" .

goldbook:08050 a skos:Concept ;
    skos:definition "Quantity with a magnitude expressed as a reference quantity multiplied by a number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unitary quantity" .

goldbook:08051 a skos:Concept ;
    skos:altLabel "working range" ;
    skos:definition "Set of quantity values over which a measuring instrument or measuring system provides measurement results with acceptable measurement uncertainty under defined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "working interval" .

goldbook:08052 a skos:Concept ;
    skos:altLabel "acceptance zone" ;
    skos:definition "Interval of permissible measured quantity values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptance interval" .

goldbook:08053 a skos:Concept ;
    skos:definition "Specified upper or lower bound of permissible measured quantity values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptance limit" .

goldbook:08054 a skos:Concept ;
    skos:definition "Third-party attestation related to a laboratory conveying formal demonstration of its competence to carry out specific conformity assessment tasks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accreditation of a laboratory" .

goldbook:08055 a skos:Concept ;
    skos:altLabel "selectivity" ;
    skos:definition "Selectivity of a measuring system in analytical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical selectivity" .

goldbook:08056 a skos:Concept ;
    skos:definition "Person, assigned by an accreditation body, with relevant professional expertise and experience who can determine the competence of a laboratory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assessor" .

goldbook:08057 a skos:Concept ;
    skos:definition "Value attributed to a particular property of an item and that serves as an agreed reference for comparison." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assigned value" .

goldbook:08058 a skos:Concept ;
    skos:definition "Systematic, independent, and documented process for obtaining objective evidence and evaluating it objectively to determine the extent to which the audit criteria are fulfilled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "audit" .

goldbook:08059 a skos:Concept ;
    skos:altLabel "candidate CRM" ;
    skos:definition "Reference material subjected to a process of reference material certification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "candidate certified reference material" .

goldbook:08060 a skos:Concept ;
    skos:altLabel "candidate RM" ;
    skos:definition "Material subjected to the procedures necessary to show its fitness for intended use (see fitness for purpose)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "candidate reference material" .

goldbook:08061 a skos:Concept ;
    skos:definition "Ability of an object to realize an output that will fulfil the requirements for that output." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capability" .

goldbook:08062 a skos:Concept ;
    skos:altLabel "Ishikawa diagram",
        "fishbone diagram",
        "herringbone diagram" ;
    skos:definition "Diagram indicating the causes of a specific event or condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cause-and-effect diagram" .

goldbook:08063 a skos:Concept ;
    skos:definition "Third-party attestation related to products, processes, systems, or persons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "certification" .

goldbook:08064 a skos:Concept ;
    skos:definition "Property of a reference material, demonstrated by the closeness of agreement between the relation among the measurement results for a stated quantity in this material, obtained according to two given measurement procedures, and the relation obtained among the measurement results for other specified materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "commutability of a reference material" .

goldbook:08065 a skos:Concept ;
    skos:definition "Ability to apply knowledge and skills to achieve intended results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competence" .

goldbook:08066 a skos:Concept ;
    skos:definition "Probability that an item fulfils a specified requirement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformance probability" .

goldbook:08067 a skos:Concept ;
    skos:definition "Activity to determine whether specified requirements relating to a product, process, system, person, or body are fulfilled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformity assessment" .

goldbook:08068 a skos:Concept ;
    skos:definition "Chart with control limits on which some statistical measure related to a series of samples is plotted in a particular order to steer the process with respect to that measure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "control chart" .

goldbook:08069 a skos:Concept ;
    skos:definition "Value defining an intended level of stability for a process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "control limit" .

goldbook:08070 a skos:Concept ;
    skos:altLabel "coordinator" ;
    skos:definition "Person(s) with responsibility for organizing and managing all of the activities involved in the operation of an interlaboratory comparison." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordinator of an interlaboratory comparison" .

goldbook:08071 a skos:Concept ;
    skos:altLabel "CUSUM chart" ;
    skos:definition "Control chart where the cumulative sum of deviations of successive measured quantity values from a reference quantity value is plotted to detect shifts in the level of the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative sum control chart" .

goldbook:08072 a skos:Concept ;
    skos:altLabel "decision rule" ;
    skos:definition "Documented rule that describes how measurement uncertainty will be accounted for with regard to accepting or rejecting an item, given a specified requirement and a measured quantity value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decision rule in conformity assessment" .

goldbook:08073 a skos:Concept ;
    skos:altLabel "fitness for intended use" ;
    skos:definition "Ability of a product, process, or service to serve a defined purpose under specific conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fitness for purpose" .

goldbook:08074 a skos:Concept ;
    skos:altLabel "GLP" ;
    skos:definition "Quality system concerned with the organizational process, and conditions under which non-clinical health and environmental safety studies are planned, performed, monitored, recorded, archived, and reported." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "good laboratory practice" .

goldbook:08075 a skos:Concept ;
    skos:altLabel "GMP" ;
    skos:definition "Combination of manufacturing and quality procedures aimed at ensuring that products are consistently manufactured to their specified requirements and to avoid contamination of the product by internal or external sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "good manufacturing practice" .

goldbook:08076 a skos:Concept ;
    skos:definition "Interval between a tolerance limit and a corresponding acceptance limit. Figure 1: Guarded acceptance. Two-sided acceptance interval created by reducing the tolerance interval on either side by a guard band, thus reducing the probability of falsely accepting a non-conforming item.Figure 2: Guarded rejection. Two-sided acceptance interval created by increasing the tolerance interval on either side by a guard band, thus reducing the probability of falsely rejecting a conforming item." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guard band" .

goldbook:08077 a skos:Concept ;
    skos:altLabel "Horwitz curve",
        "Horwitz horn curve",
        "Horwitz trumpet curve" ;
    skos:definition "Empirical relationship providing a standard deviation under reproducibility conditions of measurement (\\(s_{\\rm{R,H}}\\)) to be expected for typical measurements of the mass fraction (\\(w\\)) of a component in a material: \\(s_{\\rm{R,H}} = 0.02 w^{0.8495}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Horwitz equation" .

goldbook:08078 a skos:Concept ;
    skos:altLabel "HORRAT",
        "Horrat" ;
    skos:definition "Standard deviation of a mass fraction of a component under reproducibility conditions of measurement divided by the corresponding standard deviation calculated from the Horwitz equation. Figure 1: Horwitz curve (trumpet, horn). Expected relative standard deviation under reproducibility conditions of measurement, \\(\\pm s_{\\rm{R,H}}/w\\) plotted against logarithm of mass fraction, \\(w\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Horwitz ratio" .

goldbook:08079 a skos:Concept ;
    skos:altLabel "laboratory reference material" ;
    skos:definition "Reference material produced and used by an analytical laboratory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-house reference material" .

goldbook:08080 a skos:Concept ;
    skos:definition "Examination of a product, process, service, or installation or their design and determination of conformity with specific requirements or on the basis of professional judgment, with general requirements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inspection" .

goldbook:08081 a skos:Concept ;
    skos:altLabel "ILC" ;
    skos:definition "Organization, performance, and evaluation of measurements or tests on the same or similar items by two or more laboratories in accordance with predetermined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interlaboratory comparison" .

goldbook:08082 a skos:Concept ;
    skos:altLabel "IQC" ;
    skos:definition "Quality control within a specified laboratory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal quality control" .

goldbook:08083 a skos:Concept ;
    skos:definition "Organization, performance, and evaluation of measurements or tests on the same or similar items within the same laboratory in accordance with predetermined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intralaboratory comparison" .

goldbook:08084 a skos:Concept ;
    skos:altLabel "laboratory information system" ;
    skos:definition "Information system which can provide services to one or more measuring systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laboratory information management system" .

goldbook:08085 a skos:Concept ;
    skos:definition "Intralaboratory comparison or interlaboratory comparison with the aim of assigning a reference quantity value to a quantity with stated measurement uncertainty or value to a reference nominal property value with stated examination uncertainty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "material characterization study" .

goldbook:08086 a skos:Concept ;
    skos:definition "Reference material that is characteristic of a real sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix reference material" .

goldbook:08087 a skos:Concept ;
    skos:definition "Ability to measure a quantity in a specified interval of quantity values, embodied in a specified material, as demonstrated by measurement uncertainty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement capability" .

goldbook:08088 a skos:Concept ;
    skos:altLabel "precision control material" ;
    skos:definition "Quality control material with or without reference quantity value used in quality control to assess measurement precision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement precision control material" .

goldbook:08089 a skos:Concept ;
    skos:definition "Quality control material with reference quantity value used in quality control to estimate a systematic measurement error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement trueness control material" .

goldbook:08090 a skos:Concept ;
    skos:definition "Intra- or interlaboratory study of one or more performance characteristics of a measurement procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "method performance study" .

goldbook:08091 a skos:Concept ;
    skos:definition "Person or group of people that has its own functions with responsibilities, authorities, and relationships to achieve its objectives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organization" .

goldbook:08092 a skos:Concept ;
    skos:definition "Set of decision rules for identifying the presence of special causes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "out-of-control criteria" .

goldbook:08093 a skos:Concept ;
    skos:altLabel "participant" ;
    skos:definition "Laboratory, organization, or person that receives test items and submits results for review by the coordinator of an interlaboratory comparison." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "participant in an interlaboratory comparison" .

goldbook:08094 a skos:Concept ;
    skos:altLabel "performance characteristic",
        "performance characteristic of a measurement method" ;
    skos:definition "Aspect of a measurement procedure that may be quantitatively investigated and assessed as part of procedure validation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "performance characteristic of a measurement procedure" .

goldbook:08095 a skos:Concept ;
    skos:altLabel "performance statistic" ;
    skos:definition "Statistic, derived from a result reported by a participant in a proficiency testing scheme, used in interpretation of participant performance and to allow comparison with defined objectives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "performance score" .

goldbook:08096 a skos:Concept ;
    skos:definition "Quantity value, less than or equal to what the absolute difference between two measured quantity values obtained under specified conditions of measurement is expected to be with a given probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precision limit" .

goldbook:08097 a skos:Concept ;
    skos:definition "Process of defining an analytical requirement and confirming that the procedure under consideration has capabilities consistent with that requirement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "procedure validation" .

goldbook:08098 a skos:Concept ;
    skos:definition "Confirmation, through the provision of objective evidence, that the procedure fulfils specified requirements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "procedure verification" .

goldbook:08099 a skos:Concept ;
    skos:altLabel "process in statistical control",
        "stable process" ;
    skos:definition "Process subject only to random causes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "process in a state of statistical control" .

goldbook:08100 a skos:Concept ;
    skos:altLabel "PT item" ;
    skos:definition "Sample, product, artefact, reference material, piece of equipment, measurement standard, data set, or other information used for proficiency testing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proficiency test item" .

goldbook:08101 a skos:Concept ;
    skos:altLabel "PT" ;
    skos:definition "Evaluation of the performance of a participant in an interlaboratory comparison against pre-established criteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proficiency testing" .

goldbook:08102 a skos:Concept ;
    skos:altLabel "PT provider" ;
    skos:definition "Organization which takes responsibility for all tasks in the development and operation of a proficiency testing scheme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proficiency testing provider" .

goldbook:08103 a skos:Concept ;
    skos:altLabel "PT round" ;
    skos:definition "Single complete sequence from distribution of proficiency test items to reporting of the evaluation results to the participants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proficiency testing round" .

goldbook:08104 a skos:Concept ;
    skos:altLabel "PT scheme" ;
    skos:definition "Proficiency testing designed and operated in one or more proficiency testing rounds for a specified area of testing, measurement, calibration, or inspection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proficiency testing scheme" .

goldbook:08105 a skos:Concept ;
    skos:definition "Detailed set of instructions describing the objectives, design, conduct, and reporting of an interlaboratory comparison." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protocol for interlaboratory comparison" .

goldbook:08106 a skos:Concept ;
    skos:definition "Degree to which a set of inherent characteristics of an object fulfils requirements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality" .

goldbook:08107 a skos:Concept ;
    skos:altLabel "control material" ;
    skos:definition "Material used for the purposes of quality control and subjected to the same or part of the same measurement procedure as that used for analytical samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality control material" .

goldbook:08108 a skos:Concept ;
    skos:definition "Part of quality management focused on increasing the ability to fulfil requirements for quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality improvement" .

goldbook:08109 a skos:Concept ;
    skos:definition "Coordinated activities to direct and control an organization with regard to quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality management" .

goldbook:08110 a skos:Concept ;
    skos:definition "Part of a set of interrelated or interacting elements of an organization to establish quality policies and quality objectives and processes to achieve those objectives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality management system" .

goldbook:08111 a skos:Concept ;
    skos:definition "Specification for the quality management system of an organization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality manual" .

goldbook:08112 a skos:Concept ;
    skos:definition "Result to be achieved related to quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality objective" .

goldbook:08113 a skos:Concept ;
    skos:definition "Specification of the procedures and associated resources to be applied when and by whom to a specific object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality plan" .

goldbook:08114 a skos:Concept ;
    skos:definition "Part of quality management focused on setting quality objectives and specifying necessary operational processes and related resources to achieve the quality objectives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality planning" .

goldbook:08115 a skos:Concept ;
    skos:definition "Intentions and direction of a laboratory as formally expressed by its top management related to quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality policy" .

goldbook:08116 a skos:Concept ;
    skos:definition "Laboratory that applies a reference measurement procedure, a reference examination procedure, or performs a calibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference laboratory" .

goldbook:08117 a skos:Concept ;
    skos:definition "Document, issued by a reference material producer, containing the essential information for the use of a certified reference material and confirming that the necessary procedures have been carried out to ensure the validity and traceability of the stated property values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference material certificate" .

goldbook:08118 a skos:Concept ;
    skos:altLabel "certification of a reference material" ;
    skos:definition "Process that formally establishes the certified property value(s) of a candidate certified reference material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference material certification" .

goldbook:08119 a skos:Concept ;
    skos:altLabel "certification report" ;
    skos:definition "Document giving detailed information, in addition to that contained in a reference material certificate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference material certification report" .

goldbook:08120 a skos:Concept ;
    skos:altLabel "RM producer" ;
    skos:definition "Technically competent body that produces a reference material compliant with the appropriate guidance documents and issues the reference material documentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference material producer" .

goldbook:08121 a skos:Concept ;
    skos:altLabel "rejection zone" ;
    skos:definition "Interval of non-permissible measured quantity values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rejection interval" .

goldbook:08122 a skos:Concept ;
    skos:definition "Need or expectation that is stated, generally implied or obligatory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "requirement" .

goldbook:08123 a skos:Concept ;
    skos:altLabel "robustness of a measurement procedure" ;
    skos:definition "Ability of a measurement procedure to maintain acceptable performance under minor changes in operating conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ruggedness of a measurement procedure" .

goldbook:08124 a skos:Concept ;
    skos:altLabel "analytical sensitivity",
        "sensitivity" ;
    skos:definition "Quotient of the change in an indication of a measuring system and the corresponding change in a quantity being measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitivity of a measuring system" .

goldbook:08125 a skos:Concept ;
    skos:definition "Control chart with Shewhart control limits intended primarily to distinguish between the variation in the plotted measure due to random causes and that due to special causes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shewhart control chart" .

goldbook:08126 a skos:Concept ;
    skos:definition "Control limit determined statistically from the variation of the process due to random causes alone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shewhart control limit" .

goldbook:08127 a skos:Concept ;
    skos:definition "Shewhart control chart in which the means of measured quantity values are plotted against time. Figure 1: Shewhart means chart of the means of duplicate analyses of a quality control material, twice per day (d) over 20 days. Each point is the mean of the day’s four results (\\(n = 4\\)). Upper and lower warning limits (UWL and LWL) are at \\(\\bar{x} \\pm 2s/\\sqrt{n}\\), where \\(\\bar{x}\\) is the process mean, \\(s\\) is the standard deviation under repeatability conditions of measurement, and upper and lower action limits (UAL and LAL) are at \\(\\bar{x} \\pm 3s/\\sqrt{n}\\). A simulated measurement bias of one standard deviation is applied after day 10." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shewhart means chart" .

goldbook:08128 a skos:Concept ;
    skos:definition "Shewhart control chart in which the ranges of measured quantity values are plotted against time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shewhart range chart" .

goldbook:08129 a skos:Concept ;
    skos:definition "Need or expectation that is stated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specified requirement" .

goldbook:08130 a skos:Concept ;
    skos:definition "Measure of dispersion used in the evaluation of results of proficiency testing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard deviation for proficiency assessment" .

goldbook:08131 a skos:Concept ;
    skos:altLabel "recommended operating procedure",
        "standard method" ;
    skos:definition "Authorized, documented procedure or set of procedures with detailed instructions for specified activities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard operating procedure" .

goldbook:08132 a skos:Concept ;
    skos:altLabel "SPC" ;
    skos:definition "Activities focused on the use of statistical techniques to reduce variation, increase knowledge about the process, and steer the process in the desired way." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "statistical process control" .

goldbook:08133 a skos:Concept ;
    skos:definition "Measurement uncertainty specified as an upper limit and decided on the basis of the intended use of measurement results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "target measurement uncertainty" .

goldbook:08134 a skos:Concept ;
    skos:altLabel "specified tolerance" ;
    skos:definition "Difference between upper and lower tolerance limits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerance" .

goldbook:08135 a skos:Concept ;
    skos:altLabel "specification zone" ;
    skos:definition "Interval of permissible quantity values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerance interval" .

goldbook:08136 a skos:Concept ;
    skos:altLabel "specification limit" ;
    skos:definition "Specified upper or lower bound of permissible quantity values of a property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerance limit" .

goldbook:08137 a skos:Concept ;
    skos:altLabel "TQM" ;
    skos:definition "Organization-wide efforts to install a permanent climate in which an organization continuously improves its ability to deliver high-quality products and services to customers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total quality management" .

goldbook:08138 a skos:Concept ;
    skos:definition "Confirmation, through the provision of objective evidence, that the requirements for a specific intended use or application have been fulfilled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "validation" .

goldbook:08139 a skos:Concept ;
    skos:definition "Confirmation, through the provision of objective evidence, that specified requirements have been fulfilled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "verification" .

goldbook:08140 a skos:Concept ;
    skos:definition "Graphical technique for evaluating an interlaboratory comparison when each participant has made two measurements on the same sample or one measurement on each of two different samples.Figure 1: Youden plot of the \\(z\\) scores of samples #9 and #10 of Round 5 of U39 of the proficiency testing program held by the RCPA Australia for the analysis of creatinine in urine by 218 laboratories. (Reproduced with permission)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Youden plot" .

goldbook:08141 a skos:Concept ;
    skos:definition "In theories of unimolecular reactions an energized chemical species, often characterized by the superscript \\(^{\\ddagger}\\), where the excitation is specific and the molecule is poised for reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated state" .

goldbook:08142 a skos:Concept ;
    skos:definition "Both nucleophilic and electrophilic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambiphilic" .

goldbook:08143 a skos:Concept ;
    skos:definition "1) Designation applied to the carbon to which a functional group is attached. 2) In carbohydrate nomenclature, a stereochemical designation of the configuration at the anomeric carbon. 3) Parameter in a Brønsted relation expressing the sensitivity of the rate of protonation to acidity. 4) Parameter in Leffler’s relation expressing the sensitivity of changes in Gibbs activation energy to changes in overall Gibbs energy for an elementary reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α" .

goldbook:08144 a skos:Concept ;
    skos:definition "Feature of a ligand with two potential binding sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bidentate" .

goldbook:08145 a skos:Concept ;
    skos:definition "Feature on a potential-energy surface whereby a minimum-energy reaction path (MERP) emanating from a saddle point (corresponding to a transition structure) splits in two and leads to alternative products without intervening minima or secondary barriers to overcome. A bifurcation arises when the curvature of the surface in a direction perpendicular to the MERP becomes zero and then negative; it implies the existence of a lower-energy transition structure with a transition vector orthogonal to the original MERP." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bifurcation" .

goldbook:08146 a skos:Concept ;
    skos:definition "Standard molar enthalpy required to break a given bond of some specific molecular entity by homolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond-dissociation enthalpy" .

goldbook:08147 a skos:Concept ;
    skos:altLabel "mean bond energy",
        "mean bond enthalpy" ;
    skos:definition "Average value of the gas-phase bond-dissociation enthalpies (usually at a temperature of \\(\\pu{298 K}\\)) for all bonds of the same type within the same chemical species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond enthalpy" .

goldbook:08148 a skos:Concept ;
    skos:definition "Two (or more) molecules with the same spin multiplicity but with different lengths for one or more bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond-stretch isomers" .

goldbook:08149 a skos:Concept ;
    skos:definition "Parameter in a Brønsted relation expressing the sensitivity of the rate of deprotonation to basicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>β</i>, <i>β</i><sub>nuc</sub>, <i>β</i><sub>lg</sub>" .

goldbook:08150 a skos:Concept ;
    skos:altLabel "1,2-elimination" ;
    skos:definition "Transformation of the general type \\[\\ce{XABY -> A=B + XY (or X + Y, or X^{+} + Y^{-})}\\] where the central atoms \\(\\ce{A}\\) and \\(\\ce{B}\\) are commonly, but not necessarily, carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-elimination" .

goldbook:08151 a skos:Concept ;
    skos:definition "Quantitative measure of solvent polarity, based on the solvent’s hydrogen-bond-donor ability, hydrogen-bond-acceptor ability, polarizability, and dipolarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Catalán solvent parameters" .

goldbook:08152 a skos:Concept ;
    skos:altLabel "abzyme" ;
    skos:definition "Monoclonal antibody with enzymatic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic antibody" .

goldbook:08153 a skos:Concept ;
    skos:definition "Sequence of reaction steps in the form of a loop. One step is binding of a reactant to the active catalyst (sometimes formed from a precatalyst), and another step is the release of product and regeneration of the catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic cycle" .

goldbook:08154 a skos:Concept ;
    skos:definition "Noncovalent attractive force between a positive ion (metal cation, protonated Brønsted base, etc.) and a \\(\\ce{\\uppi\\ electron}\\) system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cation-π interaction" .

goldbook:08155 a skos:Concept ;
    skos:definition "Structural characteristic rendering a molecule chiral." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral feature" .

goldbook:08156 a skos:Concept ;
    skos:definition "Attraction between molecules through noncovalent interactions that exhibit complementarity only between partners with specific chirality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral recognition" .

goldbook:08157 a skos:Concept ;
    skos:definition "Feature of a concerted transformation in which the primary changes in bonding occur within a cyclic array of atoms but in which two nonbonding atomic orbitals on an atom interchange roles with two bonding orbitals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coarctate" .

goldbook:08158 a skos:Concept ;
    skos:definition "Linear representation of the structure of a molecular entity in which bonds are omitted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condensed formula" .

goldbook:08160 a skos:Concept ;
    skos:definition "Symbols for depicting the flow of electrons in a chemical reaction or to generate additional resonance forms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "curly arrows" .

goldbook:08161 a skos:Concept ;
    skos:altLabel "arborol",
        "cascade molecule" ;
    skos:definition "Large molecule constructed from a central core with repetitive branching and multiple functional groups at the periphery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendrimer" .

goldbook:08163 a skos:Concept ;
    skos:altLabel "activation strain model" ;
    skos:definition "Method for analyzing activation energy as the sum of the energies to distort the reactants into the geometries they have in transition states plus the energy of interaction between the two distorted reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distortion interaction model" .

goldbook:08164 a skos:Concept ;
    skos:altLabel "donor number DN (misnomer)" ;
    skos:definition "Quantitative experimental measure of the Lewis basicity of a molecule \\(\\ce{B}\\), expressed as the negative enthalpy of the formation of the 1:1 complex \\(\\ce{B.SbCl5}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "donicity" .

goldbook:08165 a skos:Concept ;
    skos:definition "NMR spectroscopy of samples undergoing chemical reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic NMR" .

goldbook:08166 a skos:Concept ;
    skos:definition "Method using curly arrows for showing the formal movement of an electron pair (from a lone pair or a \\(\\upsigma\\) or \\(\\ce{\\uppi\\ bond}\\)) or of an unpaired electron, in order to generate additional resonance forms or to denote a chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron pushing" .

goldbook:08167 a skos:Concept ;
    skos:definition "Heterolytic reaction in which the entering group adds to a nucleophile and in which the leaving group, or electrofuge, relinquishes both electrons to its reaction partner, whereupon it becomes another potential electrophile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophilic substitution" .

goldbook:08168 a skos:Concept ;
    skos:altLabel "EXSY" ;
    skos:definition "Two-dimensional NMR technique producing cross peaks corresponding to site-to site chemical exchange. The cross-peak amplitudes carry information about exchange rates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "NMR exchange spectroscopy" .

goldbook:08169 a skos:Concept ;
    skos:definition "Quantity (omitted if zero) attached to each atom in a Lewis structure according to \\[Z_{\\rm{formal}} = N_{\\rm{valence}} - N_{\\rm{lonepairs}} - ½N_{\\rm{bonds}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "formal charge" .

goldbook:08170 a skos:Concept ;
    skos:definition "Acid and base for which adduct formation is prevented by steric hindrance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frustrated Lewis acid-base pair" .

goldbook:08171 a skos:Concept ;
    skos:definition "Function centered on an atom of the form \\(\\phi(r) \\propto x^{i} y^{j} z^{k} \\exp (-\\zeta r^{2})\\), used to approximate atomic orbitals in the LCAO-MO method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gaussian orbital" .

goldbook:08172 a skos:Concept ;
    skos:definition "Allotrope of carbon, whose structure is a one-atom-thick planar sheet of \\(\\ce{sp^{2}{-}bonded}\\) carbon atoms in a honeycomb (hexagonal) crystal lattice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphene" .

goldbook:08173 a skos:Concept ;
    skos:definition "Association between a Lewis-acidic halogen atom in a molecular entity and a Lewis-basic region in another, or the same, molecular entity, which acts as an electron-pair donor, such that the balance of forces of attraction and repulsion results in net stabilization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halogen bond" .

goldbook:08174 a skos:Concept ;
    skos:definition "Topological description for the number of contiguous atoms of a ligand that are bonded to a central metal atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hapticity" .

goldbook:08175 a skos:Concept ;
    skos:altLabel "hydrogen-bond acceptor solvent",
        "protophilic solvent" ;
    skos:definition "Strongly or weakly basic solvent capable of acting as a hydrogen-bond acceptor (HBA) and forming strong intermolecular solute-solvent hydrogen bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HBA solvent" .

goldbook:08176 a skos:Concept ;
    skos:altLabel "dipolar HBD solvent",
        "hydrogen-bond donating solvent",
        "protic solvent" ;
    skos:definition "Solvent with a sizable permanent dipole moment that bears suitably acidic hydrogen atoms to form strong intermolecular solvent-solute hydrogen bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HBD solvent" .

goldbook:08177 a skos:Concept ;
    skos:definition "Automated method to quickly assay large libraries of chemical species for the affinity of small organic molecules toward a target of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-throughput screening" .

goldbook:08178 a skos:Concept ;
    skos:definition "Cycloaddition of 1,3 dipolar compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Huisgen reaction" .

goldbook:08179 a skos:Concept ;
    skos:definition "Attachment of the ion \\(\\ce{H^{+}}\\) either in natural abundance or where it is not desired to distinguish between the isotopes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydronation" .

goldbook:08180 a skos:Concept ;
    skos:altLabel "ionic solvent",
        "molten salt" ;
    skos:definition "Liquid that consists exclusively or almost exclusively of equivalent amounts of oppositely charged ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic liquid" .

goldbook:08181 a skos:Concept ;
    skos:definition "Interconversion of ketone and enol tautomers by hydron migration, accelerated by acid or base catalysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keto-enol tautomerization" .

goldbook:08182 a skos:Concept ;
    skos:definition "Quantitative measures of solvent polarity, based on the solvent’s dispersion/induction interactions, electrostatic interactions between permanent multipoles, solute Lewis base/solvent Lewis acid interactions, and solute HBD/solvent HBA interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Laurence solvent parameters" .

goldbook:08183 a skos:Concept ;
    skos:altLabel "Leffler’s assumption" ;
    skos:definition "In a series of elementary reactions, the changes in Gibbs activation energies are often found to be proportional to the changes in Gibbs energies for the overall reaction.\\[\\updelta \\Delta^{\\ddagger} G = \\alpha \\Delta_{\\rm{r}} G^{\\circ}\\] This relation was interpreted in terms of the simple assumption that a small change in any transition-state property \\(P_{\\ddagger}\\) is a linear combination of changes in reactant- and product-state properties, \\(P_{\\ce{R}}\\) and \\(P_{\\ce{P}}\\). \\[\\updelta P_{\\ddagger} = \\alpha \\updelta P_{\\ce{P}} + (1-\\alpha)\\updelta P_{\\ce{R}}\\] Within the limits of this assumption, the parameter \\(\\alpha\\) is an approximate measure of the fractional displacement of the transition state along the minimum-energy reaction path from reactants to products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Leffler’s relation" .

goldbook:08184 a skos:Concept ;
    skos:definition "Statement that the velocity of a reaction depends on the active mass, i.e., the concentrations of the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass action, law of" .

goldbook:08185 a skos:Concept ;
    skos:definition "Rate constants for the reactions of \\(\\ce{sp^{2}{-}hybridized}\\) electrophiles with nucleophiles can be expressed by the correlation \\[\\lg [k/(\\pu{dm3 mol-1 s-1})] = s_{\\rm{N}}(E + N)\\] where \\(E\\) is the nucleophile-independent electrophilicity parameter, \\(N\\) is the electrophile-independent nucleophilicity parameter, and \\(s_{\\rm{N}}\\) is the electrophile-independent nucleophile-specific susceptibility parameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mayr–Patz equation" .

goldbook:08186 a skos:Concept ;
    skos:definition "Principle that a chemical reaction is expected to occur with a minimum of bond changes or with a minimum redistribution of electrons (although more complex reaction cascades are also possible)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum structural change, principle of" .

goldbook:08187 a skos:Concept ;
    skos:definition "Attraction between specific molecules through noncovalent interactions that often exhibit electrostatic and stereochemical complementarity between the partners." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular recognition" .

goldbook:08188 a skos:Concept ;
    skos:definition "Substance whose particles are in the size range of 1 to \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanomaterial" .

goldbook:08190 a skos:Concept ;
    skos:definition "Compound with unpaired electrons for which no Lewis structures are possible with all bonding electrons paired in single or double bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-Kekulé structure" .

goldbook:08191 a skos:Concept ;
    skos:definition "Heterolytic reaction in which an entering group adds to the electrophilic part of the substrate and in which the leaving group, or nucleofuge, retains both electrons of the bond that is broken, whereupon it becomes another potential nucleophile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleophilic substitution" .

goldbook:08192 a skos:Concept ;
    skos:altLabel "partition ratio",
        "water/octanol partition coefficient" ;
    skos:definition "Equilibrium concentration of a substance in octan-1-ol divided by its equilibrium concentration in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "octanol-water partition ratio" .

goldbook:08193 a skos:Concept ;
    skos:definition "Catalysis by small organic molecules, as distinguished from catalysis by (transition) metals or enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organocatalysis" .

goldbook:08194 a skos:Concept ;
    skos:definition "Change of the position of the transition state upon stabilization or destabilization of a structure (or structures) along the assumed minimum-energy reaction path." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parallel effect" .

goldbook:08195 a skos:Concept ;
    skos:definition "Characteristic of a bond between atoms of different electronegativity, such that the electrons in that bond are not shared equally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarity" .

goldbook:08196 a skos:Concept ;
    skos:altLabel "PMF" ;
    skos:definition "Free energy as a function of a set of coordinates, the negative gradient of which gives the average force acting on that configuration averaged over all other coordinates and momenta within a statistical distribution. If the averaging is performed within a canonical ensemble (constant volume, temperature, and number of particles), the PMF is equivalent to the Helmholtz energy, but if it is performed within an isobaric-isothermal ensemble (constant pressure, temperature, and number of particles), the PMF is equivalent to the Gibbs energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential of mean force" .

goldbook:08197 a skos:Concept ;
    skos:definition "Special case of nucleofugality, describing the relative rates of transfer of a proton (more generally: hydron) from a series of Brønsted acids \\(\\ce{H-X}\\) to a common Brønsted base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protofugality" .

goldbook:08198 a skos:Concept ;
    skos:definition "Attachment of the ion \\(\\ce{^{1}H^{+}}\\) of relative isotopic mass approximately equal to 1." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protonation" .

goldbook:08199 a skos:Concept ;
    skos:definition "Special case of nucleophilicity, describing the relative rates of reactions of a series of Lewis bases with a common Brønsted acid. This term has the advantage over the commonly used 'kinetic basicity' that philicity and fugality are associated with kinetics, while acidity and basicity are associated with thermodynamics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protophilicity" .

goldbook:08200 a skos:Concept ;
    skos:definition "Feature of an extended conjugated \\(\\ce{\\uppi\\ system}\\) bearing an electron donor group at one end and an electron acceptor group at the other end." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "push-pull conjugation" .

goldbook:08201 a skos:Concept ;
    skos:definition "Substituent capable of electron donation by resonance (e.g., \\(\\ce{OCH3}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π-electron donor" .

goldbook:08202 a skos:Concept ;
    skos:altLabel "QSPR" ;
    skos:definition "Regression model to correlate chemical properties such as boiling point or chromatographic retention time with predictor parameters based on measured or calculated features of molecular structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitative structure–property relationship" .

goldbook:08205 a skos:Concept ;
    skos:altLabel "canonical form",
        "contributing structure",
        "resonance structure" ;
    skos:definition "One of at least two Lewis structures, with fixed single, double, and triple bonds, that is a contributing structure to the valence-bond wavefunction of a molecule that cannot be described by a single Lewis structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance form" .

goldbook:08206 a skos:Concept ;
    skos:definition "Process whereby a system of single-molecule components spontaneously forms an organized structure, owing to molecular recognition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-assembly" .

goldbook:08207 a skos:Concept ;
    skos:definition "Paramagnetic substance that induces an additional change of the NMR resonance frequency of a nucleus near any site in a molecule to which the substance binds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shift reagent" .

goldbook:08208 a skos:Concept ;
    skos:altLabel "bond-line formula" ;
    skos:definition "Two-dimensional representation of a molecular entity in which bonds are indicated as lines between vertices representing octet carbon atoms with attached hydrogens omitted and in which other atoms are represented by their chemical symbols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skeletal formula" .

goldbook:08209 a skos:Concept ;
    skos:definition "Isomers that differ in their solvation environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvatomers" .

goldbook:08210 a skos:Concept ;
    skos:definition "Atom within a molecule bearing groups such that interchanging any two of them leads to a stereoisomer of the original molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereogenic center" .

goldbook:08212 a skos:Concept ;
    skos:altLabel "SLUMO" ;
    skos:definition "Second Lowest Unoccupied Molecular Orbital (SLUMO)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superjacent orbital" .

goldbook:08213 a skos:Concept ;
    skos:definition "Constitutional isomers that can interconvert more or less rapidly, often by migration of a hydron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tautomers" .

goldbook:08214 a skos:Concept ;
    skos:definition "Phenomenon whereby electrons can be delocalized from any of three (or more) groups to any other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "through-conjugation" .

goldbook:08215 a skos:Concept ;
    skos:definition "Extent, in consequence of Heisenberg’s Uncertainty Principle, by which a particle or a set of particles has an energy greater than that of the minimum on the potential-energy surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero-point energy" .

goldbook:08216 a skos:Concept ;
    skos:definition "Measurement principle of spectroscopy for the study of electromagnetic radiation absorbed and emitted by atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic spectroscopy" .

goldbook:08217 a skos:Concept ;
    skos:definition "Measurement principle of spectroscopy for the study of rotational, vibrational, and electronic transitions of molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular spectroscopy" .

goldbook:08218 a skos:Concept ;
    skos:altLabel "NMR" ;
    skos:definition "Measurement principle of spectroscopy to measure the precession of magnetic moments placed in a magnetic induction based on absorption of electromagnetic radiation of a specific frequency by an atomic nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear magnetic resonance spectroscopy" .

goldbook:08220 a skos:Concept ;
    skos:altLabel "imaginary refractive index" ;
    skos:definition "Imaginary part of the complex refractive index describing absorption of electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption index" .

goldbook:08221 a skos:Concept ;
    skos:definition "Condition that occurs when two or more normal transitions have the same energy as a matter of coincidence, as opposed to because of symmetry conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accidental degeneracy" .

goldbook:08222 a skos:Concept ;
    skos:definition "Angle between a beam of electromagnetic radiation and a line normal to a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle of incidence" .

goldbook:08223 a skos:Concept ;
    skos:altLabel "nonisotropic" ;
    skos:definition "Having properties that depend on direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anisotropic" .

goldbook:08224 a skos:Concept ;
    skos:definition "Technical term for changing the shape of a mathematical function, electrical signal, or optical transmission to remove or smooth a discontinuity at the edges, literally meaning 'removing the foot'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apodization" .

goldbook:08225 a skos:Concept ;
    skos:altLabel "window function" ;
    skos:definition "Mathematical function that effects apodization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apodization function" .

goldbook:08226 a skos:Concept ;
    skos:definition "Photoelectric detector in which a large number of pixels are distributed, usually in regularly spaced lines and usually over a rectangular area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "array detector" .

goldbook:08227 a skos:Concept ;
    skos:altLabel "ATR",
        "frustrated total internal reflection" ;
    skos:definition "Internal reflection from an absorbing material at angles of incidence at or above the critical angle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attenuated total reflection" .

goldbook:08228 a skos:Concept ;
    skos:definition "Device to split a beam of electromagnetic radiation into two parts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam splitter" .

goldbook:08229 a skos:Concept ;
    skos:definition "Function \\(y = a/(b^{2} + x^{2})\\) where \\(a\\) and \\(b\\) are constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cauchy function" .

goldbook:08230 a skos:Concept ;
    skos:altLabel "CCD" ;
    skos:definition "Device that stores information in the form of charge packets in an array of closely spaced capacitors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge coupled device" .

goldbook:08231 a skos:Concept ;
    skos:definition "Difference between the refractive indices of an optically active medium for left, \\(n^{\\rm{L}}\\), and right, \\(n^{\\rm{R}}\\), circularly polarized radiation (\\(n^{\\rm{L}}-n^{\\rm{R}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "circular birefringence" .

goldbook:08232 a skos:Concept ;
    skos:altLabel "phase relaxation" ;
    skos:definition "Loss of coherence between the upper and lower states of a transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dephasing" .

goldbook:08233 a skos:Concept ;
    skos:altLabel "detector integration time" ;
    skos:definition "Time for signal integration after start of detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detector gate width" .

goldbook:08234 a skos:Concept ;
    skos:definition "Measurement method of spectroscopy in which spectral subtraction is used to help the study and identification of individual species in a mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "difference spectroscopy" .

goldbook:08235 a skos:Concept ;
    skos:altLabel "remission fraction",
        "remittance" ;
    skos:definition "Diffuse reflected (remitted) radiant power (\\(P_{\\rm{rem}}\\)) divided by incident radiant power (\\(P_{0}\\)). \\(R = P_{\\rm{rem}}/P_{0}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuse reflectance" .

goldbook:08236 a skos:Concept ;
    skos:altLabel "remission" ;
    skos:definition "Reflection in which electromagnetic radiation incident on a scattering surface at a certain angle is reflected (remitted) over all angles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuse reflection" .

goldbook:08237 a skos:Concept ;
    skos:definition "Process in which radiation is transmitted by a scattering sample and leaves the sample in directions other than that required by Snell’s law of refraction. The process is complicated and involves transmission, reflection, and scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuse transmission" .

goldbook:08238 a skos:Concept ;
    skos:altLabel "transition-dipole transition dipole coupling" ;
    skos:definition "Coupling of different motions through dipole-dipole forces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipole coupling" .

goldbook:08239 a skos:Concept ;
    skos:altLabel "asymmetric Fourier-transform spectroscopy" ;
    skos:definition "Fourier-transform spectroscopy using a Michelson or other two-beam interferometer with the sample placed in one arm of the interferometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersive Fourier-transform spectroscopy" .

goldbook:08240 a skos:Concept ;
    skos:definition "Spectrometer in which electromagnetic radiation is separated spatially into its component wavenumbers by a dispersive element, such as a prism or a diffraction grating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersive spectrometer" .

goldbook:08242 a skos:Concept ;
    skos:altLabel "EM" ;
    skos:definition "Flow of energy through space propagated as synchronized sinusoidal waves of the electric field, \\(\\boldsymbol{E}\\), and the magnetic field \\(\\boldsymbol{H}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromagnetic radiation" .

goldbook:08243 a skos:Concept ;
    skos:definition "Transition accompanied by the emission or absorption of a photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromagnetic transition" .

goldbook:08244 a skos:Concept ;
    skos:definition "Measurement principle of spectrometry for the study of electrons emitted by atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron emission spectrometry" .

goldbook:08245 a skos:Concept ;
    skos:altLabel "transition" ;
    skos:definition "Transition in an atom, ion, or molecule from an electronic energy level \\(E_{1}\\) to another energy level \\(E_{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic transition" .

goldbook:08246 a skos:Concept ;
    skos:altLabel "energy state" ;
    skos:definition "Set of one or more stationary quantum states of a free atom, ion, or molecule having a particular internal energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy level" .

goldbook:08247 a skos:Concept ;
    skos:definition "Decadic absorbance as measured with no corrections for other processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "experimental absorbance" .

goldbook:08248 a skos:Concept ;
    skos:altLabel "aliasing" ;
    skos:definition "The appearance of peaks at incorrect frequencies in a mathematically-processed spectrum due to insufficient density of datapoints in the time-domain spectrum or from peaks outside of the sampled frequency range.This process can be simulated by folding a spectrum that shows the correct wavenumbers back onto itself at \\(\\tilde{ u}_{\\rm{M}}\\) and its multiples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "folding" .

goldbook:08249 a skos:Concept ;
    skos:altLabel "FID" ;
    skos:definition "Indication from a pulsed spectroscopy experiment that takes the form of damped sine waves arising from the excited system returning to equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free induction decay" .

goldbook:08250 a skos:Concept ;
    skos:definition "Reflection of radiation from a surface that is smooth and large with respect to the wavelength of the radiation. A reflected beam, of intensity governed by the Fresnel equations, is produced at an angle of reflection equal to the angle of incidence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fresnel reflection" .

goldbook:08252 a skos:Concept ;
    skos:definition "Spectral band with the shape \\(H_{\\rm{G}} \\exp[-4\\ln 2{(\\tilde{ u} - \\tilde{ u}_{0})}^{2}/W^{2}]\\), where \\(H_{\\rm{G}}\\) is the band maximum (peak height), \\(W\\) is the full width at half maximum, and \\(\\tilde{ u}_{0}\\) is the peak wavenumber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gaussian band" .

goldbook:08253 a skos:Concept ;
    skos:definition "Multiplexing spectrometer that uses the optical components of a dispersive spectrometer with a Hadamard encoding mask." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hadamard transform spectrometer" .

goldbook:08255 a skos:Concept ;
    skos:definition "Optical filter that excludes radiation of wavenumber lower (wavelength higher) than a certain value and passes radiation of wavenumber above (wavelength lower) than this value. Electrical filter that blocks signal with a modulation frequency lower than a certain cut-on value and passes signals of frequency above this value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-pass filter" .

goldbook:08256 a skos:Concept ;
    skos:definition "Functions that interrelate the real part, \\(f'\\), and imaginary part, \\(f''\\), of the refractive index, \\(\\boldsymbol{\\hat{n}} = n + {\\rm{i}}k\\), or relative permittivity, \\(\\boldsymbol{\\hat{\\epsilon}} = \\epsilon' + \\rm{i}\\epsilon''\\), through \\[f'(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}' = \\frac{1}{\\pi} P \\int_{-\\infty}^{\\infty} \\frac{f''(\\tilde{ u})}{\\tilde{ u} - \\tilde{ u}_{\\rm{a}}}\\rm{d}\\tilde{ u}\\] \\[f''(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}' = \\frac{-1}{\\pi} P \\int_{-\\infty}^{\\infty} \\frac{f'(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}'}{\\tilde{ u} - \\tilde{ u}_{\\rm{a}}}\\rm{d}\\tilde{ u}\\] where \\(P\\) means that the principal part of the integral is taken at the singularity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hilbert transforms" .

goldbook:08257 a skos:Concept ;
    skos:altLabel "ILS" ;
    skos:definition "Idealized form of a feature in a spectrometer corresponding to a transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instrument line shape" .

goldbook:08258 a skos:Concept ;
    skos:definition "Area under a spectral band in an absorption spectrum where the absorption is linearly proportional to the amount of absorber in unit area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integrated intensity" .

goldbook:08259 a skos:Concept ;
    skos:definition "Frequency or wavenumber range over which the integrated intensity of an absorption band is measured by numerical integration of the area under the band." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integration range" .

goldbook:08260 a skos:Concept ;
    skos:altLabel "ICCD" ;
    skos:definition "Charge coupled device with a prior amplification system to improve sensitivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intensified charge coupled device detector" .

goldbook:08261 a skos:Concept ;
    skos:definition "Absorbance in the absence of reflection, scattering or luminescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal absorbance" .

goldbook:08263 a skos:Concept ;
    skos:definition "Functions based on the physical principle of causality that interconvert the real and imaginary parts of complex optical quantities when they are known over a sufficiently wide (strictly infinite) wavenumber range. They are frequently used to interconvert the real part, \\(f'\\), and imaginary part, \\(f''\\), of the refractive index, \\(\\boldsymbol{\\hat{n}} = n + {\\rm{i}}k\\), the dielectric constant (relative permittivity), \\(\\boldsymbol{\\hat{\\epsilon}_{r}} = \\epsilon_{r}' + \\rm{i}\\epsilon_{r}''\\), or the logarithm of the complex reflection coefficient \\(re^{i\\varphi}\\) through \\[f'(\\tilde{ u}_{\\rm{a}}) - f_{\\infty}' = \\frac{2}{\\pi} P \\int_{0}^{\\infty} \\frac{\\tilde{ u} f''(\\tilde  u)}{\\tilde{ u}^{2} - \\tilde{ u}_{\\rm{a}}^{2}} {\\rm{d}}\\tilde{ u}\\] \\[f''(\\tilde{ u}_{\\rm{a}}) = \\frac{-2\\tilde{ u}_{\\rm{a}}}{\\pi} P \\int_{0}^{\\infty} \\frac{f'(\\tilde{ u}) - f_{\\infty}'}{\\tilde{ u}^2 - \\tilde{ u}_{\\rm{a}}^2} \\rm{d}\\tilde{ u}\\] where \\(P\\) means that the principal part of the integral is taken at the singularity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kramers–Kronig transforms" .

goldbook:08264 a skos:Concept ;
    skos:definition "Electromagnetic radiation visible to the human eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light" .

goldbook:08265 a skos:Concept ;
    skos:altLabel "Napierian absorption coefficient",
        "absorption coefficient" ;
    skos:definition "Napierian absorbance (\\(A_{\\rm{e}}\\)) divided by path-length (\\(l\\)). \\(\\alpha = A_{\\rm{e}}/l\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear Napierian absorption coefficient" .

goldbook:08266 a skos:Concept ;
    skos:altLabel "LCTF" ;
    skos:definition "Optical device based on polarization interference caused by transmission through a series of birefringent liquid crystal layers of different thicknesses that allow a narrow wavelength region to be selected and tuned over a broad spectral range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid crystal tunable filter" .

goldbook:08267 a skos:Concept ;
    skos:definition "Amplifier that amplifies only those signals that have, within a specified spectral bandwidth, the same frequency as, and a specified phase relation with, the selected reference signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lock-in amplifier" .

goldbook:08268 a skos:Concept ;
    skos:definition "Optical filter that excludes radiation of wavenumber greater (wavelength lower) than a certain value and passes radiation of wavenumber below (wavelength greater than) this value. Electrical filter that blocks signal with a modulation frequency above a certain cut-on value and passes signals of frequency below this value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-pass filter" .

goldbook:08269 a skos:Concept ;
    skos:altLabel "molar absorption coefficient" ;
    skos:definition "Decadic absorbance (\\(A_{10}\\)) divided by path-length (\\(l\\)) and amount concentration (\\(c\\)). \\(\\varepsilon = A_{10}/(cl)\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar decadic absorption coefficient" .

goldbook:08270 a skos:Concept ;
    skos:altLabel "absorption coefficient" ;
    skos:definition "Napierian absorbance (\\(A_{\\rm{e}}\\)) divided by path-length (\\(l\\)) and amount concentration (\\(c\\)). \\(\\kappa = A_{\\rm{e}}/(cl)\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar Napierian absorption coefficient" .

goldbook:08271 a skos:Concept ;
    skos:altLabel "MATR",
        "frustrated multiple internal reflection (FMIR)",
        "multiple internal reflection (MIR)" ;
    skos:definition "Process in which attenuated total reflection occurs sequentially several times with the same sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple attenuated total reflection" .

goldbook:08272 a skos:Concept ;
    skos:definition "Absorbance calculated with logarithm base \\(e\\) (natural or Napierian logarithm)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Napierian absorbance" .

goldbook:08273 a skos:Concept ;
    skos:altLabel "absorption cross-section ($\\upsigma$)" ;
    skos:definition "Molar Napierian absorption coefficient divided by the Avogadro constant. \\(\\sigma_{\\rm{net}} = \\kappa/N_{\\rm{A}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net absorption cross-section" .

goldbook:08274 a skos:Concept ;
    skos:altLabel "nominal resolution",
        "resolution" ;
    skos:definition "Spectral resolution setting on an instrument that a user sets to record a spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal spectral resolution" .

goldbook:08275 a skos:Concept ;
    skos:definition "Result of information theory that a sine wave can be completely reconstructed if its ordinate is known at two or more points in a cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nyquist criterion" .

goldbook:08276 a skos:Concept ;
    skos:definition "Highest frequency or wavenumber that can be characterized by sampling at a given rate in order to be able to fully reconstruct the signal without artefacts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nyquist frequency" .

goldbook:08277 a skos:Concept ;
    skos:altLabel "étendue" ;
    skos:definition "Volume in phase space, a function of the area of the emitting source (\\(S\\)) and the solid angle into which it propagates \\((\\mathit{\\Omega}).{\\rm{d}}^{2} G = {\\rm{d}}S {\\rm{d}}\\mathit{\\Omega}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical throughput" .

goldbook:08278 a skos:Concept ;
    skos:altLabel "path length" ;
    skos:definition "Length of the optical path through the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "path-length" .

goldbook:08279 a skos:Concept ;
    skos:altLabel "RF" ;
    skos:definition "Frequency or band of frequencies in the range \\(\\pu{E4}\\) to \\(\\pu{E12 Hz}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiofrequency" .

goldbook:08280 a skos:Concept ;
    skos:altLabel "incident flux density",
        "irradiance" ;
    skos:definition "Radiant power incident on unit area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "received radiant flux density" .

goldbook:08281 a skos:Concept ;
    skos:definition "Process by which electromagnetic radiation is reflected by a sample. For non-scattering samples the term means Fresnel reflection; for scattering samples the term includes regular reflection and volume reflection or diffuse reflection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflection" .

goldbook:08282 a skos:Concept ;
    skos:definition "Power of signal divided by power of noise." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signal-to-noise ratio" .

goldbook:08283 a skos:Concept ;
    skos:altLabel "intensity spectrum" ;
    skos:definition "Output of a single beam spectrometer as a function of wavenumber or wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single beam spectrum" .

goldbook:08284 a skos:Concept ;
    skos:definition "Distance between the blades of the entrance or exit slits in a monochromator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slit width" .

goldbook:08285 a skos:Concept ;
    skos:definition "Region of the absorption/transmission spectrum in which the absorbance/transmission passes through a maximum/minimum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral band" .

goldbook:08286 a skos:Concept ;
    skos:altLabel "bandwidth" ;
    skos:definition "Upper frequency minus lower frequency in a continuous band of frequencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral bandwidth" .

goldbook:08287 a skos:Concept ;
    skos:definition "Radiant energy density in unit wavenumber (wavelength) interval at wavenumber \\(\\tilde{ u}\\) (wavelength \\(\\lambda\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiant energy density" .

goldbook:08288 a skos:Concept ;
    skos:definition "Wavelength range for which a spectrometer can be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral range" .

goldbook:08289 a skos:Concept ;
    skos:altLabel "resolution" ;
    skos:definition "Smallest difference between wavenumbers (or wavelengths or frequencies) at which different spectral properties may be distinguished, measured as the full width at half maximum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral resolution" .

goldbook:08290 a skos:Concept ;
    skos:definition "Ordinate of one spectrum minus ordinate of another spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral subtraction" .

goldbook:08291 a skos:Concept ;
    skos:altLabel "vibrational spectrum" ;
    skos:definition "Graph of a quantity derived from the radiant power at each wavelength (frequency or wavenumber) as ordinate plotted against the wavelength (frequency or wavenumber) of electromagnetic radiation as abscissa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrum" .

goldbook:08292 a skos:Concept ;
    skos:altLabel "regular reflection" ;
    skos:definition "Reflection of electromagnetic radiation from a surface such that each incident ray is reflected at the same angle to the surface normal as the incident ray, but on the opposing side of the surface normal in the plane formed by incident and reflected rays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specular reflection" .

goldbook:08293 a skos:Concept ;
    skos:definition "Electromagnetic radiation that does not follow the usual path through a spectrometer and consequently appears in a spectrum at a frequency or wavenumber different from its initial value. The term is also used to refer to radiation that passes around the sample instead of through it, and consequently is not modified by the sample and seriously affects absolute and relative intensities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stray light" .

goldbook:08294 a skos:Concept ;
    skos:altLabel "transmittance spectrum" ;
    skos:definition "General term for the spectrum of transmitted electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission spectrum" .

goldbook:08295 a skos:Concept ;
    skos:altLabel "2-D correlation spectroscopy" ;
    skos:definition "Measurement principle of spectroscopy in which spectra are recorded at different magnitudes of an applied external perturbation of the sample and are processed to yield a 2-D correlation spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-dimensional correlation spectroscopy" .

goldbook:08296 a skos:Concept ;
    skos:altLabel "2-D correlation spectrum" ;
    skos:definition "Three-dimensional surface in which two of the dimensions show frequency axes (\\( u_{1}\\), \\( u_{2}\\)) and the third axis shows a correlation function of the spectral intensities observed at \\( u_{1}\\) and \\( u_{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-dimensional correlation spectrum" .

goldbook:08297 a skos:Concept ;
    skos:definition "Sampling less frequently than is required by the Nyquist criterion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "undersampling" .

goldbook:08298 a skos:Concept ;
    skos:definition "Convolution of Gaussian and Lorentzian (Cauchy) functions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Voigt function" .

goldbook:08299 a skos:Concept ;
    skos:altLabel "wavelength" ;
    skos:definition "Distance travelled by a wave of electromagnetic radiation in one cycle in a non-absorbing medium of real refractive index \\(n\\). \\(\\lambda = \\lambda_{0}/n\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength in medium" .

goldbook:08300 a skos:Concept ;
    skos:altLabel "vacuum wavelength" ;
    skos:definition "Distance travelled by a wave of electromagnetic radiation in one cycle in vacuum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength in vacuum" .

goldbook:08301 a skos:Concept ;
    skos:altLabel "wavenumber" ;
    skos:definition "Reciprocal of wavelength of electromagnetic radiation. \\(\\sigma = 1/\\lambda\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavenumber in medium" .

goldbook:08302 a skos:Concept ;
    skos:altLabel "vacuum wavenumber" ;
    skos:definition "Reciprocal of the vacuum wavelength of electromagnetic radiation. \\(\\tilde{ u} = 1/\\lambda_{0}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavenumber in vacuum" .

goldbook:08303 a skos:Concept ;
    skos:definition "Range of absorbance or intensity which a spectrometer can measure with accuracy and precision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "working range" .

goldbook:08304 a skos:Concept ;
    skos:definition "Addition of zeros to a free induction decay or interferogram to decrease the frequency or wavenumber spacing between points in the Fourier-transformed spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero filling" .

goldbook:08305 a skos:Concept ;
    skos:definition "In a Michelson interferometer or other two-beam interferometer, the position of the moving mirror at which the optical paths are equal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero path difference" .

goldbook:08306 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<sup>13</sup>C-HMQC-NOESY" .

goldbook:08307 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<sup>13</sup>C-NOESY-HSQC" .

goldbook:08308 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<sup>15</sup>N-NOESY-HSQC" .

goldbook:08309 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<sup>15</sup>N-TOCSY-HSQC" .

goldbook:08310 a skos:Concept ;
    skos:definition "Pulsed radiofrequency signal in NMR that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its opposing direction, effectively inverting the signal, (e.g., from the \\(+z\\) to \\(-z\\) axis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "180° pulse" .

goldbook:08311 a skos:Concept ;
    skos:definition "Pulsed radiofrequency signal that rotates the bulk magnetization vector (\\(\\boldsymbol{M}_{0}\\)) of a nuclear spin to its orthogonal plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "90° pulse" .

goldbook:08312 a skos:Concept ;
    skos:altLabel "AT" ;
    skos:definition "Duration of the digitization of a free induction decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acquisition time" .

goldbook:08313 a skos:Concept ;
    skos:definition "Radiofrequency pulse that inverts spins by using a frequency sweep during the pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic pulse" .

goldbook:08314 a skos:Concept ;
    skos:definition "Set of coupled differential equations which can be used to describe the behaviour of a magnetization vector under any conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bloch equations" .

goldbook:08315 a skos:Concept ;
    skos:definition "Frequency difference seen for a nuclear magnetic resonance signal when a radiofrequency field is applied during the acquisition time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bloch–Siegert shift" .

goldbook:08316 a skos:Concept ;
    skos:definition "Distribution of nuclear spins among their possible energy levels at thermal equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Boltzmann distribution of nuclear spins" .

goldbook:08317 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CBCA(CO)NH/HN(CO)CACB" .

goldbook:08318 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CBCANH/HNCACB" .

goldbook:08319 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CC(CO)NH" .

goldbook:08320 a skos:Concept ;
    skos:altLabel "CSA" ;
    skos:definition "Chemical shift difference between isotropic and anisotropic states in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical shift anisotropy" .

goldbook:08321 a skos:Concept ;
    skos:altLabel "CRAMPS" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy for obtaining high-resolution solid-state nuclear magnetic resonance spectra on nuclei with high gyromagnetic ratio such as \\(\\ce{^{1}H}\\) and \\(\\ce{^{19}F}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combined rotation and multiple pulse spectroscopy" .

goldbook:08322 a skos:Concept ;
    skos:definition "Segment of a pulse sequence in nuclear magnetic resonance spectroscopy that allows evolution of chemical shift during a fixed time period rather than through the traditional symmetrical incremented delays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constant time evolution" .

goldbook:08323 a skos:Concept ;
    skos:altLabel "COSY" ;
    skos:definition "Homonuclear two-dimensional nuclear magnetic resonance spectroscopy correlation experiment showing cross peaks representing spin-spin coupling between pairs of nuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation spectroscopy" .

goldbook:08324 a skos:Concept ;
    skos:altLabel "COLOC" ;
    skos:definition "Heteronuclear (typically \\(\\ce{^{13}C}\\)) detected long range 2D correlation experiment in nuclear magnetic resonance spectroscopy that has mostly been superseded by heteronuclear multiple bond correlation (HMBC) experiments and its variants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation spectroscopy through long-range coupling" .

goldbook:08325 a skos:Concept ;
    skos:definition "Parameter related to the mean time during which a molecule maintains its spatial geometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation time" .

goldbook:08326 a skos:Concept ;
    skos:altLabel "CP/MAS" ;
    skos:definition "Combined use of cross polarization with magic-angle spinning for solid-state nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross polarization with magic angle spinning NMR" .

goldbook:08327 a skos:Concept ;
    skos:definition "Technique in solid-state nuclear magnetic resonance spectroscopy that enables polarization from abundant spins such as \\(\\ce{^{1}H}\\) or \\(\\ce{^{19}F}\\) to be transferred to dilute spins such as \\(\\ce{^{13}C}\\) or \\(\\ce{^{15}N}\\) to enhance signal-to-noise ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross polarization" .

goldbook:08328 a skos:Concept ;
    skos:altLabel "DIPSI" ;
    skos:definition "Pulse sequence in nuclear magnetic resonance spectroscopy often used for isotropic mixing in total correlation spectroscopy (TOCSY) experiments due to its efficiency over large spectral bandwidths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decoupling in the presence of scalar interactions" .

goldbook:08329 a skos:Concept ;
    skos:altLabel "DOSY" ;
    skos:definition "Pseudo-two-dimensional nuclear magnetic resonance spectroscopy experiment that resolves NMR signals of a one-dimensional nuclear magnetic resonance spectrum in a second dimension through the diffusion times of their corresponding molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion ordered spectroscopy" .

goldbook:08330 a skos:Concept ;
    skos:altLabel "magnetic dipole–dipole interaction in NMR" ;
    skos:definition "Direct though-space interactions of nuclear magnetic moment vectors proportional to the inverse cube of internuclear distance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipolar coupling" .

goldbook:08331 a skos:Concept ;
    skos:altLabel "DEPT" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy used for determining the presence of primary, secondary and tertiary heteronuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distortionless enhancement by polarization transfer" .

goldbook:08332 a skos:Concept ;
    skos:altLabel "DPFGSE" ;
    skos:definition "Pulse sequence in nuclear magnetic resonance spectroscopy in which pulsed-field gradients are applied to a doubled spin echo sequence to cleanly and precisely excite particular resonances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double pulsed-field gradient spin-echo excitation" .

goldbook:08333 a skos:Concept ;
    skos:definition "Nuclear magnetic resonance spectroscopy experiment where excitation is applied independently to two distinct frequency ranges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double resonance" .

goldbook:08334 a skos:Concept ;
    skos:definition "Shorthand for a protein which has been uniformly \\(\\ce{^{15}N{-}}\\) and \\(\\ce{^{13}C{-}labelled}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-labelled protein" .

goldbook:08335 a skos:Concept ;
    skos:altLabel "DQF-COSY" ;
    skos:definition "Variant of the COSY experiment with a double quantum filter to remove, or at least reduce, impact of large singlet peaks on dynamic range and artefacts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-quantum filtered correlation spectroscopy" .

goldbook:08336 a skos:Concept ;
    skos:altLabel "DW" ;
    skos:definition "Time interval between sampled data points." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dwell time" .

goldbook:08337 a skos:Concept ;
    skos:altLabel "TE" ;
    skos:definition "In nuclear magnetic resonance spectroscopy, time interval between the middle of the first radiofrequency pulse and the peak of the spin echo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "echo time" .

goldbook:08338 a skos:Concept ;
    skos:altLabel "ERETIC" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy that generates an electronic signal in a nuclear magnetic resonance spectrometer which is detected simultaneously to the sample free induction decay during the acquisition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic reference to access in vivo concentrations" .

goldbook:08339 a skos:Concept ;
    skos:definition "When signal averaging in a single-pulse nuclear magnetic resonance spectroscopy experiment, flip angle giving the best signal-to-noise ratio for a given combination of spin-lattice relaxation time and repetition rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ernst angle" .

goldbook:08340 a skos:Concept ;
    skos:altLabel "EXSY" ;
    skos:definition "Nuclear magnetic resonance spectroscopy experiment, which is the same as a NOESY, but for the purposes of observing nuclei exchanging chemical environments during the course of the experiment through conformational or chemical exchange." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange spectroscopy" .

goldbook:08341 a skos:Concept ;
    skos:definition "Robust method of generating selective excitation through combination of shaped pulses and pulsed-field gradients in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation sculpting" .

goldbook:08342 a skos:Concept ;
    skos:altLabel "FFC-NMR" ;
    skos:definition "Relaxometry to measure the nuclear spin-lattice relaxation rate constant as a function of the applied magnetic field strength in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast field cycling NMR relaxometry" .

goldbook:08343 a skos:Concept ;
    skos:altLabel "tip angle" ;
    skos:definition "Rotation that the net magnetization experiences during the application of a radiofrequency pulse in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flip angle" .

goldbook:08344 a skos:Concept ;
    skos:definition "Application of spin decoupling only during selected time periods in a pulse experiment in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gated decoupling" .

goldbook:08345 a skos:Concept ;
    skos:altLabel "GARP" ;
    skos:definition "Spin decoupling pulse sequence in nuclear magnetic resonance spectroscopy used to provide decoupling over a large frequency range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "globally optimized alternating-phase rectangular pulses" .

goldbook:08346 a skos:Concept ;
    skos:definition "Nuclear magnetic resonance spectroscopy experiment where pulsed-field gradients are employed to filter out unwanted resonances from a spectrum rather than the classic phase-cycling approach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gradient-selected experiment" .

goldbook:08347 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen, and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "H(CCO)NH" .

goldbook:08348 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one nitrogen and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HBHA(CO)NH" .

goldbook:08349 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HCCH-COSY" .

goldbook:08350 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with one carbon and two hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HCCH-TOCSY" .

goldbook:08351 a skos:Concept ;
    skos:altLabel "decoupling" ;
    skos:definition "Spin decoupling in nuclear magnetic resonance spectroscopy between two different nuclei (e.g., \\(\\ce{^{13}C}\\) and \\(\\ce{^{1}H}\\)) by appropriate excitation of the decoupled nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear decoupling" .

goldbook:08352 a skos:Concept ;
    skos:altLabel "HMBC" ;
    skos:definition "Two-dimensional nuclear magnetic resonance spectroscopy that gives correlations between carbons and protons that are separated by two, three, and, sometimes in conjugated systems, four bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear multiple bond correlation NMR" .

goldbook:08353 a skos:Concept ;
    skos:altLabel "H2BC" ;
    skos:definition "Variant of the heteronuclear single quantum correlation (HSQC) and heteronuclear multiple bond correlation (HMBC) experiment in nuclear magnetic resonance spectroscopy that almost exclusively correlates \\(\\ce{^{1}H}\\) nuclei with heteronuclei separated by two covalent bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear multiple-bond correlation over two bonds" .

goldbook:08354 a skos:Concept ;
    skos:altLabel "HMQC" ;
    skos:definition "Simplest implementation of an inverse detected \\(\\ce{^{1}H}\\) heteronuclear correlation nuclear magnetic resonance spectroscopy experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear multiple-quantum correlation NMR" .

goldbook:08355 a skos:Concept ;
    skos:altLabel "HMQC-TOCSY" ;
    skos:definition "Variant of heteronuclear multiple bond correlation (HMBC) spectroscopy that shows correlations from a heteronucleus (e.g., \\(\\ce{^{13}C}\\)) to not only its directly bound \\(\\ce{^{1}H}\\) but also to all other \\(\\ce{^{1}H}\\) nuclei within the spin system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear multiple-quantum correlation with additional TOCSY transfer" .

goldbook:08356 a skos:Concept ;
    skos:altLabel "HOESY" ;
    skos:definition "Heteronuclear variant of nuclear Overhauser effect spectroscopy (NOSEY) showing through space interaction between \\(\\ce{^{1}H}\\) and a heteronucleus, typically \\(\\ce{^{13}C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear Overhauser effect spectroscopy" .

goldbook:08357 a skos:Concept ;
    skos:altLabel "HETCOR" ;
    skos:definition "Directly-observed one-bond heteronuclear correlation experiment in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear shift correlation NMR" .

goldbook:08358 a skos:Concept ;
    skos:altLabel "HSQC",
        "heteronuclear single quantum coherence" ;
    skos:definition "\\(\\ce{^{1}H}\\) (inverse) detected two-dimensional nuclear magnetic resonance spectroscopy heteronuclear experiment that correlates \\(\\ce{^{1}H}\\) nuclei with their directly coupled nucleus through a single bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear single quantum correlation" .

goldbook:08359 a skos:Concept ;
    skos:altLabel "HSQC-TOCSY" ;
    skos:definition "Variant of the heteronuclear single quantum correlation (HSQC) experiment that shows correlations from a heteronucleus (e.g., \\(\\ce{^{13}C}\\)) to not only its directly bound \\(\\ce{^{1}H}\\) but also to all other \\(\\ce{^{1}H}\\) nuclei within the spin system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear single quantum correlation with additional TOCSY transfer" .

goldbook:08360 a skos:Concept ;
    skos:altLabel "HSQMBC" ;
    skos:definition "Variant of the heteronuclear single quantum correlation (HSQC) experiment that provides pure absorption, antiphase line shapes for precise, direct measurement of \\(^{n}J(\\ce{C,H})\\) spin-spin coupling constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteronuclear single quantum multiple-bond correlation" .

goldbook:08361 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HN(CA)CO" .

goldbook:08362 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HN(CO)CA" .

goldbook:08363 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HNCA" .

goldbook:08364 a skos:Concept ;
    skos:definition "Three-dimensional nuclear magnetic resonance spectroscopy for the assignment of protein structure with nitrogen, carbon and hydrogen dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "HNCO" .

goldbook:08365 a skos:Concept ;
    skos:altLabel "decoupling" ;
    skos:definition "Spin decoupling in nuclear magnetic resonance spectroscopy between two signals of the same nuclear isotope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homonuclear decoupling" .

goldbook:08366 a skos:Concept ;
    skos:altLabel "imaginary spectrum" ;
    skos:definition "In nuclear magnetic resonance spectroscopy, one of two equally sized blocks of frequency data \\(\\pu{90\\!^{\\circ}}\\) out of phase to each other produced by Fourier transformation of the time domain signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imaginary NMR spectrum" .

goldbook:08367 a skos:Concept ;
    skos:altLabel "INADEQUATE" ;
    skos:definition "Nuclear magnetic resonance spectroscopy experiment designed to show homonuclear spin-spin coupling correlations between low natural abundance nuclei such as \\(\\ce{^{13}C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incredible natural-abundance double-quantum transfer experiment" .

goldbook:08368 a skos:Concept ;
    skos:altLabel "INEPT" ;
    skos:definition "Pulse sequence in nuclear magnetic resonance spectroscopy that involves the transfer of nuclear spin polarization from spins with large Boltzmann population differences to nuclear spins of interest with low Boltzmann population differences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insensitive nuclei enhanced by polarization transfer" .

goldbook:08369 a skos:Concept ;
    skos:definition "Pulse in nuclear magnetic resonance spectroscopy that completely inverts the magnetization of a spin, e.g., \\(+z\\) to \\(-z\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion pulse" .

goldbook:08370 a skos:Concept ;
    skos:altLabel "inversion recovery" ;
    skos:definition "Spin echo sequence preceded by a \\(\\pu{180\\!^{\\circ}}\\) inversion pulse used to determine spin-lattice relaxation times in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion recovery sequence" .

goldbook:08371 a skos:Concept ;
    skos:altLabel "TI" ;
    skos:definition "Time between the inversion pulse and the sampling pulse(s) in an inversion recovery sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion time" .

goldbook:08372 a skos:Concept ;
    skos:altLabel "J-MOD" ;
    skos:definition "Nuclear magnetic resonance pulse sequence that refocuses spin vectors that have fanned out due to field inhomogeneity or chemical shift differences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "J-modulated spin-echo" .

goldbook:08373 a skos:Concept ;
    skos:altLabel "J-RES" ;
    skos:definition "Two-dimensional nuclear magnetic resonance spectroscopy resolving chemical shift information in one dimension and spin-spin coupling in the second." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "J-resolved spectroscopy" .

goldbook:08374 a skos:Concept ;
    skos:definition "Frequency shift in the nuclear magnetic resonance spectrum of a paramagnetic species that refers to the relative shift \\(\\boldsymbol{K}\\) in NMR frequency for atoms in a metal (e.g., sodium) compared with the same atoms in a nonmetallic environment (e.g., as a salt)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Knight shift" .

goldbook:08375 a skos:Concept ;
    skos:altLabel "Larmor frequency" ;
    skos:definition "Frequency at which nuclei with a nuclear spin precess (Larmor precession) around the direction of an external magnetic induction \\(\\boldsymbol{B}_{0}\\). \\(\\boldsymbol{\\omega}_{\\rm{L}} = -\\gamma \\boldsymbol{B}_{0}\\), where \\(\\gamma\\) is the magnetogyric ratio of the nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Larmor angular frequency" .

goldbook:08376 a skos:Concept ;
    skos:definition "Precession of the magnetic moment (\\(\\boldsymbol{M}\\)) of an object at an angular frequency, \\(\\boldsymbol{\\omega}_{\\rm{L}}\\), about a static magnetic induction (\\(\\boldsymbol{B_{0}}\\)), named after Joseph Larmor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Larmor precession" .

goldbook:08377 a skos:Concept ;
    skos:altLabel "MAS" ;
    skos:definition "Technique in solid-state nuclear magnetic resonance spectroscopy to remove or reduce the influence of anisotropic interactions by rapid sample rotation about the magic angle, where \\(\\boldsymbol{B_{0}}\\) is external magnetic induction and \\(\\uptheta\\) is the axis of rotation of the sample at an angle of approx. \\(\\pu{54.74\\!^{\\circ}}\\) to the external magnetic induction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magic angle spinning" .

goldbook:08378 a skos:Concept ;
    skos:altLabel "MQMAS" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy used to obtain high-resolution NMR spectra of quadrupolar nuclei by removal of the anisotropy of the quadrupole interaction, involving creating a triple-quantum (or \\(5{\\rm{Q}}\\)) coherence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple-quantum magic angle spinning NMR" .

goldbook:08379 a skos:Concept ;
    skos:definition "Feature in a nuclear magnetic resonance spectrum that is split but is too complex to easily interpret." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplet" .

goldbook:08380 a skos:Concept ;
    skos:altLabel "T2-star" ;
    skos:definition "Measured time constant associated with spin-spin relaxation for loss of magnetization in the \\(xy\\) plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net dephasing time" .

goldbook:08381 a skos:Concept ;
    skos:altLabel "NUS" ;
    skos:definition "Technique employed within a high dimensionality nuclear magnetic resonance spectroscopy experiment that acquires only a subset of the data points traditionally acquired linearly thus enabling a reduction in experiment time or an increased resolution in the resultant spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-uniform sampling" .

goldbook:08382 a skos:Concept ;
    skos:altLabel "quadrupole moment of a nucleus" ;
    skos:definition "Parameter that describes the effective shape of the ellipsoid of nuclear charge distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear electric quadrupole moment" .

goldbook:08383 a skos:Concept ;
    skos:altLabel "NMRR",
        "relaxometry" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy to measure nuclear relaxation variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear magnetic resonance relaxometry" .

goldbook:08384 a skos:Concept ;
    skos:altLabel "NMR spectrum" ;
    skos:definition "Representation of nuclear magnetic resonance spectroscopy data with at least one dimension a frequency domain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear magnetic resonance spectrum" .

goldbook:08385 a skos:Concept ;
    skos:altLabel "nOe",
        "nuclear Overhauser enhancement" ;
    skos:definition "Change of intensity of one resonance when the spin transitions of another are somehow perturbed from their equilibrium populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear Overhauser effect" .

goldbook:08386 a skos:Concept ;
    skos:altLabel "nOe difference spectroscopy" ;
    skos:definition "One dimensional nuclear magnetic resonance spectroscopy that yields, through subtraction of spectra generated with and without selective excitation of a specific resonance, the nuclear Overhauser enhancement of nuclei spatially close to a selectively excited nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear Overhauser effect difference spectroscopy" .

goldbook:08387 a skos:Concept ;
    skos:altLabel "NOESY",
        "nuclear Overhauser enhancement spectroscopy" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy based on the nuclear Overhauser effect to observe nuclei that are close to each other in space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear Overhauser effect spectroscopy" .

goldbook:08388 a skos:Concept ;
    skos:altLabel "NQR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy where splitting of the nuclear spin states is determined by the electrostatic interaction of the nuclear charge density with the external electric potential of the surrounding electron cloud." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear quadrupole resonance spectroscopy" .

goldbook:08389 a skos:Concept ;
    skos:definition "Frequency corresponding to the centre of the spectrum window for a given nucleus under observation and the nominal frequency used to generate the hard, full spectrum pulses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "observation frequency" .

goldbook:08390 a skos:Concept ;
    skos:definition "Characteristic line shape seen in solid-state nuclear magnetic resonance spectroscopy arising from dipolar coupling between two nuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pake doublet" .

goldbook:08391 a skos:Concept ;
    skos:definition "Linear combination of the real and imaginary parts of a 1-D nuclear magnetic resonance spectrum to produce peaks with pure absorption mode line shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase correction" .

goldbook:08392 a skos:Concept ;
    skos:definition "Component of nuclear magnetic resonance spectroscopy experiment that repeats a pulse sequence changing only the phases of the pulse(s) and the phase-sensitive detector reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase cycling" .

goldbook:08393 a skos:Concept ;
    skos:definition "Very broad and distinctive line shape seen in a static solid-state nuclear magnetic resonance spectroscopy experiment with a typical magnitude of \\(\\pu{E2}\\) to \\(\\pu{E5 Hz}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "powder pattern" .

goldbook:08394 a skos:Concept ;
    skos:definition "Classical description of the behaviour of nuclear magnetic moments, in which the vectors rotate about the \\(\\boldsymbol{B_{0}}\\) axis at their Larmor angular frequencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precession" .

goldbook:08395 a skos:Concept ;
    skos:definition "Technique to suppress a particular nuclear magnetic resonance spectroscopy signal where a long low-power pulse is applied to that specific resonance prior to the main pulse sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "presaturation" .

goldbook:08396 a skos:Concept ;
    skos:definition "Timed series of radiofrequency pulses and magnetic field gradients that define a part or whole of a nuclear magnetic resonance spectroscopy experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse sequence" .

goldbook:08397 a skos:Concept ;
    skos:altLabel "PFG",
        "gradient pulse" ;
    skos:definition "Short, timed pulse in nuclear magnetic resonance spectroscopy that momentarily destroys the magnetic field homogeneity within the sample through a spatial-dependent field intensity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulsed-field gradient" .

goldbook:08398 a skos:Concept ;
    skos:altLabel "PSYCHE" ;
    skos:definition "Nuclear magnetic resonance spectroscopy experiment generating homonuclear spin-spin decoupled spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pure shift yielded by chirp excitation" .

goldbook:08399 a skos:Concept ;
    skos:definition "Collection of time domain nuclear magnetic resonance spectroscopy data on both the \\(x\\) and \\(y\\ (\\rm{g})\\) axes of the rotating frame of reference to allow discrimination of positive and negative frequencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrature detection" .

goldbook:08400 a skos:Concept ;
    skos:definition "Nuclide with spin quantum number \\(I \\gt &half;\\) and a non-spherical distribution of charge in the nucleus giving rise to a nuclear electric quadrupole moment (\\(eQ\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupolar nuclide" .

goldbook:08401 a skos:Concept ;
    skos:definition "Relaxation mechanism in nuclear magnetic resonance spectroscopy arising from intramolecular quadrupolar interactions with electric field gradients." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupolar relaxation" .

goldbook:08402 a skos:Concept ;
    skos:definition "Line-broadening effect on intense signals in high field nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation damping" .

goldbook:08403 a skos:Concept ;
    skos:altLabel "RF coil" ;
    skos:definition "In nuclear magnetic resonance spectroscopy, an inductor-capacitor resonant circuit used to set up \\(B_{1}\\) magnetic inductions in a sample and to detect the signal from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiofrequency coil" .

goldbook:08404 a skos:Concept ;
    skos:definition "In nuclear magnetic resonance spectroscopy, one of two equally sized blocks of frequency data \\(\\pu{90\\!^{\\circ}}\\) out of phase to each other produced by Fourier transformation of the time domain signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "real spectrum" .

goldbook:08405 a skos:Concept ;
    skos:definition "Paramagnetic species added to a sample in a nuclear magnetic resonance spectroscopy experiment to promote more rapid spin-lattice relaxation and allow a faster pulse repetition rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relaxation reagent" .

goldbook:08406 a skos:Concept ;
    skos:altLabel "TR" ;
    skos:definition "Time duration between repetitions of a nuclear magnetic resonance pulse sequence including the pulse sequence, acquisition time and relaxation delay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repetition time" .

goldbook:08407 a skos:Concept ;
    skos:altLabel "RDC" ;
    skos:definition "Dipolar coupling, but of a reduced magnitude to that seen in solids, observed in a liquid sample between spins in a molecule where there is incomplete averaging of spatially anisotropic dipolar couplings." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual dipolar coupling" .

goldbook:08408 a skos:Concept ;
    skos:altLabel "ROESY",
        "cross-relaxation appropriate for minimolecules emulated by locked spins (CAMELPSIN)" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy yielding through-space correlations via spin-spin relaxation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotating-frame NOE spectroscopy" .

goldbook:08409 a skos:Concept ;
    skos:altLabel "REDOR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy allowing recoupling of heteronuclear dipolar coupling under magic angle spinning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational echo double resonance" .

goldbook:08410 a skos:Concept ;
    skos:altLabel "STD" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy that allows detection of transient binding of small molecule ligands to macromolecular receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation transfer difference spectroscopy" .

goldbook:08411 a skos:Concept ;
    skos:definition "Spin decoupling of a specific resonance by selective irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective decoupling" .

goldbook:08412 a skos:Concept ;
    skos:altLabel "selective irradiation" ;
    skos:definition "Application of a frequency selective radiofrequency pulse(s) to a single resonance or a discrete band of frequencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective excitation" .

goldbook:08413 a skos:Concept ;
    skos:definition "Radiofrequency pulse with a narrow frequency spectral bandwidth (long, low-power pulse) to excite nuclei in a limited chemical shift range (see selective excitation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective pulse" .

goldbook:08414 a skos:Concept ;
    skos:definition "Solid-state nuclear magnetic resonance spectroscopy on a single crystal in a similar manner to that used in X-ray diffraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single crystal nuclear magnetic resonance spectroscopy" .

goldbook:08415 a skos:Concept ;
    skos:altLabel "SSNMR" ;
    skos:definition "Application of nuclear magnetic resonance spectroscopy to solids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid-state nuclear magnetic resonance spectroscopy" .

goldbook:08416 a skos:Concept ;
    skos:definition "In nuclear magnetic resonance spectroscopy reduction or removal of large, unwanted resonances from solvents to improve spectrum quality and dynamic range through selective excitation and exploiting differences in relaxation times between solvent and analyte signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent suppression" .

goldbook:08417 a skos:Concept ;
    skos:definition "Frequency range that describes the width of the spectrum window of a specific nucleus in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral width" .

goldbook:08418 a skos:Concept ;
    skos:altLabel "nuclear spin" ;
    skos:definition "Intrinsic angular momentum of a nucleus (or other sub-atomic particle)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin" .

goldbook:08419 a skos:Concept ;
    skos:definition "Irradiation of a nucleus in nuclear magnetic resonance spectroscopy to prevent spin-spin coupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin decoupling" .

goldbook:08420 a skos:Concept ;
    skos:altLabel "Hahn echo",
        "SE" ;
    skos:definition "Refocusing of spin magnetization usually by two consecutive radiofrequency pulses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin echo" .

goldbook:08421 a skos:Concept ;
    skos:definition "Group of magnetic nuclei that interact amongst themselves through spin-spin coupling but do not interact with any nuclei outside the spin system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin system" .

goldbook:08422 a skos:Concept ;
    skos:altLabel "$T1$ relaxation",
        "$T_1$ relaxation",
        "longitudinal relaxation" ;
    skos:definition "Mechanism in nuclear magnetic resonance spectroscopy by which the component of the magnetization vector along the direction of the static magnetic induction reaches thermodynamic equilibrium with its surroundings through loss of energy of the excited nuclear spins to the surrounding molecular lattice. The resultant exponential decay of signal is characterized by the spin-lattice relaxation time \\(T_{1}\\) (reciprocal of the rate constant of this mechanism)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-lattice relaxation" .

goldbook:08423 a skos:Concept ;
    skos:altLabel "spin-lattice time constant" ;
    skos:definition "Reciprocal of the rate constant of longitudinal relaxation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-lattice relaxation time" .

goldbook:08424 a skos:Concept ;
    skos:definition "Satellite peaks in a nuclear magnetic resonance spectrum symetrically spaced either side of a main peak at a frequency offset related to the rate of spinning of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spinning sidebands" .

goldbook:08425 a skos:Concept ;
    skos:altLabel "T2 relaxation",
        "transverse relaxation" ;
    skos:definition "Loss of magnetization in the \\(xy\\) plane (in the absence of \\(\\boldsymbol{B_{0}}\\) inhomogeneities) through the interchange of energy between nuclear spins resulting in some precessing faster than the Larmor angular frequency and some slower." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-spin relaxation" .

goldbook:08426 a skos:Concept ;
    skos:altLabel "transverse relaxation time" ;
    skos:definition "Reciprocal of the rate constant of spin-spin relaxation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-spin relaxation time" .

goldbook:08427 a skos:Concept ;
    skos:altLabel "magnetic flux density",
        "static magnetic field" ;
    skos:definition "Flux density of the magnetic field of a nuclear magnetic resonance spectrometer about whose direction the nuclear magnetic moment precesses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static magnetic flux density" .

goldbook:08428 a skos:Concept ;
    skos:definition "Method of removing artefacts from a two-dimensional nuclear magnetic resonance spectrum that are symmetrical about the diagonal (e.g., HH COSY) or the \\(\\rm{f}1\\) axis (e.g., tilted J-resolved spectra). Values equidistant from midline are compared and replaced the lower (or average) value of the two." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetrization" .

goldbook:08429 a skos:Concept ;
    skos:altLabel "$t_1$ in 2-D NMR" ;
    skos:definition "Time domain arising from the regular increments of the delay period in two-dimensional nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>t</em><sub>1</sub>" .

goldbook:08430 a skos:Concept ;
    skos:altLabel "$t_2$ in 2-D NMR" ;
    skos:definition "Time domain in two-dimensional nuclear magnetic resonance spectroscopy arising from direct free induction decay detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>t</em><sub>2</sub>" .

goldbook:08431 a skos:Concept ;
    skos:altLabel "$t_1$ noise in 2-D NMR" ;
    skos:definition "Streaks of spurious artefact signals in a two-dimensional nuclear magnetic resonance spectrum parallel to the \\(\\rm{f}1\\) axis at the \\(\\rm{f}2\\) of a strong resonance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>t</em><sub>1</sub> noise" .

goldbook:08432 a skos:Concept ;
    skos:altLabel "3-D NMR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy in which data are collected in three time domains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "three-dimensional nuclear magnetic resonance spectroscopy" .

goldbook:08433 a skos:Concept ;
    skos:definition "Condition in nuclear magnetic resonance spectroscopy where the independent variable of all functions is time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time domain" .

goldbook:08434 a skos:Concept ;
    skos:altLabel "TD-NMR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy run at low magnetic field strengths where data analysis is performed directly on the free induction decay, often through the extraction of relaxation time constants" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time domain nuclear magnetic resonance spectroscopy" .

goldbook:08435 a skos:Concept ;
    skos:altLabel "TOCSY",
        "homonuclear Hartmann-Hahn spectroscopy (HOHAHA)" ;
    skos:definition "Two-dimensional nuclear magnetic resonance homonuclear correlation experiment, which creates correlations between all protons within a given spin system, not just between geminal or vicinal protons as in COSY." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total correlation spectroscopy" .

goldbook:08436 a skos:Concept ;
    skos:altLabel "TOSS" ;
    skos:definition "Technique to suppress spinning sidebands in solid-state nuclear magnetic resonance spectroscopy with cross polarization in magic angle spinning experiments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total suppression of spinning sidebands" .

goldbook:08437 a skos:Concept ;
    skos:altLabel "TROSY" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy, usually in protein NMR, that improves peak sharpness for molecules having a molecular mass of greater than \\(\\pu{100 kDa}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transverse relaxation optimized spectroscopy" .

goldbook:08438 a skos:Concept ;
    skos:altLabel "triple-resonance NMR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy using three NMR-active nuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triple-resonance nuclear magnetic resonance spectroscopy" .

goldbook:08439 a skos:Concept ;
    skos:altLabel "2-D NMR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy in which data are collected in two time domains: acquisition of the free induction decay (\\(t_{2}\\)) and a successively incremented delay (\\(t_{1}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-dimensional nuclear magnetic resonance spectroscopy" .

goldbook:08440 a skos:Concept ;
    skos:altLabel "WALTZ decoupling" ;
    skos:definition "Cluster of pulses applied repeatedly for heteronuclear decoupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wideband, alternating-phase, low-power technique for residual splitting" .

goldbook:08441 a skos:Concept ;
    skos:definition "Energy levels of a nucleus arising from the interaction of its magnetic dipole with an external magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Zeeman levels" .

goldbook:08442 a skos:Concept ;
    skos:altLabel "zero-field NMR" ;
    skos:definition "Measurement method of nuclear magnetic resonance spectroscopy in which nuclear magnetic resonance spectra are acquired in an environment carefully screened from magnetic fields, including from the Earth’s field allowing the direct detection of J-spectra in the absence of Zeeman interactions (see Zeeman levels)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero-field nuclear magnetic resonance spectroscopy" .

goldbook:08443 a skos:Concept ;
    skos:definition "Bombardment of a sample surface with ions resulting in the removal of atoms from their lattice sites, and thus an ongoing discharge process that causes continuous ablation of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ablation by sputtering" .

goldbook:08444 a skos:Concept ;
    skos:definition "Mass of sample removed in laser-induced breakdown spectroscopy divided by the energy delivered by the laser beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ablation efficiency" .

goldbook:08445 a skos:Concept ;
    skos:definition "Depth of sample layer removed in the glow discharge process per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ablation rate" .

goldbook:08446 a skos:Concept ;
    skos:definition "Minimum fluence required to achieve ablation of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ablation threshold fluence" .

goldbook:08447 a skos:Concept ;
    skos:definition "Increase in signal equilibration time or in wash out time caused by a modification in inorganic acid concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid transient effects" .

goldbook:08448 a skos:Concept ;
    skos:definition "Gases added to a combustion mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "additional gases" .

goldbook:08449 a skos:Concept ;
    skos:definition "Processes occurring inside the spray chamber or desolvation system responsible for the modification of the primary aerosol to finally yield the tertiary aerosol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerosol transport phenomena" .

goldbook:08450 a skos:Concept ;
    skos:definition "Mass of analyte reaching the plasma per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analyte transport rate" .

goldbook:08451 a skos:Concept ;
    skos:altLabel "AAS" ;
    skos:definition "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the absorption of characteristic electromagnetic radiation by atoms in the vapour phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic absorption spectroscopy" .

goldbook:08452 a skos:Concept ;
    skos:altLabel "AES" ;
    skos:definition "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the intensity of characteristic electromagnetic radiation emitted by atoms or molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic emission spectroscopy" .

goldbook:08453 a skos:Concept ;
    skos:altLabel "excitation source" ;
    skos:definition "Atomizer intended to convert free atoms to an excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic excitation source" .

goldbook:08454 a skos:Concept ;
    skos:altLabel "AFS" ;
    skos:definition "Measurement method of atomic spectroscopy for measuring the amount of a chemical element based on the measurement of the re-emission of characteristic electromagnetic radiation by atoms, following the absorption of radiation in the vapour phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic fluorescence spectroscopy" .

goldbook:08455 a skos:Concept ;
    skos:altLabel "atomic vapor" ;
    skos:definition "Vapour containing free atoms of analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic vapour" .

goldbook:08456 a skos:Concept ;
    skos:definition "Graph of absorbance against atomization temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomization curve" .

goldbook:08457 a skos:Concept ;
    skos:definition "Inductively-coupled plasma optical emission spectrometer configuration in which the entrance slit is aligned with the main plasma axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axial viewing mode" .

goldbook:08458 a skos:Concept ;
    skos:definition "Intense continuous background usually observed in laser-induced breakdown spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "background continuum emission" .

goldbook:08459 a skos:Concept ;
    skos:definition "Concentration of a given element measured at a given wavelength providing the same intensity as the background." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "background equivalent concentration" .

goldbook:08460 a skos:Concept ;
    skos:definition "Minimum fluence required to achieve measurable emission signals" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "breakdown threshold fluence" .

goldbook:08461 a skos:Concept ;
    skos:definition "Plasma generated by a capacitor in presence of a microwave field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capacitive microwave plasma" .

goldbook:08462 a skos:Concept ;
    skos:definition "Spectral line of an atom used for the measurement of analyte concentration by atomic spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic line" .

goldbook:08463 a skos:Concept ;
    skos:definition "Source that emits electromagnetic radiation with relatively constant intensity over a broad spectral region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuum source" .

goldbook:08464 a skos:Concept ;
    skos:definition "Process by which the sample is sputtered 'atomic layer by layer' using suitable conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth-profiling" .

goldbook:08465 a skos:Concept ;
    skos:altLabel "DC GD-OES" ;
    skos:definition "Measurement method using optical emission spectroscopy in which atomization and excitation occur in a glow electric discharge sustained by a direct current electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct current glow discharge optical emission spectroscopy" .

goldbook:08466 a skos:Concept ;
    skos:definition "Conversion of the whole or part of a liquid or solid sample into a physical form sufficiently finely divided to allow it to be atomized (see atomization) upon introduction into the atomizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion of a sample" .

goldbook:08467 a skos:Concept ;
    skos:definition "Measurement method of laser-induced breakdown spectroscopy in which reactions are induced by the interaction of the evolved plasma and the remaining part of the laser pulse, or with a following laser pulse provided from a second laser system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-pulse laser-induced breakdown spectroscopy" .

goldbook:08468 a skos:Concept ;
    skos:definition "Inductively-coupled plasma spectrometer that allows axial viewing mode or radial viewing mode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual viewing mode" .

goldbook:08469 a skos:Concept ;
    skos:altLabel "discharge" ;
    skos:definition "Transmission of electrical current by a plasma in an applied electric field through a normally non-conducting medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric discharge" .

goldbook:08470 a skos:Concept ;
    skos:definition "Number of free electrons in vapour phase per volume unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron number density" .

goldbook:08471 a skos:Concept ;
    skos:altLabel "ETAAS" ;
    skos:definition "Measurement method of atomic absorption spectroscopy in which the sample is atomized by an electrothermal atomizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrothermal atomic absorption spectroscopy" .

goldbook:08472 a skos:Concept ;
    skos:definition "Technique for sample introduction based on the use of a solid furnace heated at a controlled temperature to vaporize the sample prior to its introduction into an inductively-coupled plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrothermal vaporization" .

goldbook:08473 a skos:Concept ;
    skos:definition "Energy that must be supplied to an atom to transfer it from the ground atomic state to a given ionic excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>E</em><sub>sum</sub>" .

goldbook:08474 a skos:Concept ;
    skos:definition "Spectrometer to make measurements by flame atomic spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame atomic spectrometer" .

goldbook:08475 a skos:Concept ;
    skos:altLabel "flame atomic spectrometry" ;
    skos:definition "Measurement method of atomic spectroscopy that uses a flame to excite atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame atomic spectroscopy" .

goldbook:08476 a skos:Concept ;
    skos:definition "Continuously flowing mixture of hot gases with a stationary position that derives its heat content from a strongly exothermic, irreversible chemical reaction between a fuel and an oxidant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame" .

goldbook:08477 a skos:Concept ;
    skos:definition "Component of a flame atomic spectrometer for creating turbulence in the stream of mist in the spray chamber and removing the largest droplets from this mist by deposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow spoiler" .

goldbook:08478 a skos:Concept ;
    skos:altLabel "time delay in laser induced breakdown spectroscopy" ;
    skos:definition "Time between the application of a laser pulse and the start of detection in laser-induced breakdown spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gate delay" .

goldbook:08479 a skos:Concept ;
    skos:definition "Spectrometers for glow discharge optical emission spectroscopy that allow simultaneous monitoring of selected spectral ranges or the whole emission spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "GD-OES spectrometers with simultaneous detection" .

goldbook:08480 a skos:Concept ;
    skos:definition "Fraction of the energy generated being used for creating and maintaining the plasma in an inductively-coupled plasma spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generator coupling efficiency" .

goldbook:08481 a skos:Concept ;
    skos:definition "Component of an atomic emission spectrometer employing a glow electric discharge used in atomic emission spectroscopy for qualitative and quantitative analysis of solid materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glow discharge source" .

goldbook:08482 a skos:Concept ;
    skos:altLabel "glow discharge" ;
    skos:definition "Electric discharge in gas at low pressure (\\(\\pu{100}\\) to \\(\\pu{1000 Pa}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glow electric discharge" .

goldbook:08483 a skos:Concept ;
    skos:altLabel "GD-OES" ;
    skos:definition "Optical emission spectroscopy in which a glow electric discharge excites atoms at the surface of a sample, which is made the cathode of the discharge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glow-discharge optical emission spectroscopy" .

goldbook:08484 a skos:Concept ;
    skos:definition "Cathode for a glow electric discharge consisting of a flat sample, which is cooled during the discharge process so that thermal volatilization is suppressed and the sample material is removed by sputtering only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Grimm-type cathode" .

goldbook:08485 a skos:Concept ;
    skos:definition "Glow discharge source with a graphite cathode, into which the sample is inserted in the form of drillings, a pressed pellet or a dry solution residue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hollow-cathode discharge source" .

goldbook:08486 a skos:Concept ;
    skos:altLabel "line source" ;
    skos:definition "Glow discharge source of spectral lines of an atom in which the cathode is made of the desired element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hollow-cathode lamp" .

goldbook:08487 a skos:Concept ;
    skos:definition "Power supplied by a generator to the plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incident power" .

goldbook:08488 a skos:Concept ;
    skos:altLabel "ICP" ;
    skos:definition "Plasma produced by induction by means of a high-frequency (about \\(\\pu{2500 Hz}\\)) electromagnetic field. The region of gas at high temperature and free from the field is taken as the region of observation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma" .

goldbook:08489 a skos:Concept ;
    skos:altLabel "ICP",
        "inductively-coupled plasma spectroscopy" ;
    skos:definition "Measurement method of atomic spectroscopy that uses an inductively-coupled plasma to excite and ionize atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma spectrometry" .

goldbook:08490 a skos:Concept ;
    skos:altLabel "ICP-MS" ;
    skos:definition "Measurement method of atomic spectrometry that uses an inductively-coupled plasma to excite and ionize atoms with measurement of the number and kind of ions in the plasma using mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma mass spectrometry" .

goldbook:08491 a skos:Concept ;
    skos:altLabel "ICP-OES" ;
    skos:definition "Measurement method of atomic spectroscopy that uses an inductively-coupled plasma to excite and ionize atoms with measurement of the number and kind of ions in the plasma from their emission of electromagnetic radiation (see optical emission spectroscopy)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma optical emission spectroscopy" .

goldbook:08492 a skos:Concept ;
    skos:altLabel "plasma robustness" ;
    skos:definition "Ability of an inductively-coupled plasma to withstand slight modification in the operating conditions and/or matrix composition with no significant changes in its fundamental characteristics (i.e., temperatures, electron number density) or the analytical figures of merit (i.e., sensitivity, detection limits or signal-to-noise ratio)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma robustness" .

goldbook:08493 a skos:Concept ;
    skos:definition "Decrease in the inductively-coupled plasma volume normally caused when an organic volatile solution is delivered to it. Organic vapours diffuse towards the outermost area of the plasma and its volume decreases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma thermal pinch" .

goldbook:08494 a skos:Concept ;
    skos:definition "Quartz component of an inductively-coupled plasma spectrometer where the plasma is generated and stabilized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductively-coupled plasma torch" .

goldbook:08495 a skos:Concept ;
    skos:definition "Inductively-coupled plasma volume in inductively-coupled plasma optical emission spectroscopy where the analytically-relevant light emission begins to be observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initial plasma radiation zone" .

goldbook:08496 a skos:Concept ;
    skos:definition "Graph of absorbance or intensity plotted as a function of the concentration of an interfering element in an atomic spectroscopy experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interference curve" .

goldbook:08497 a skos:Concept ;
    skos:definition "Absorption of photon energy by free electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse Bremsstrahlung" .

goldbook:08498 a skos:Concept ;
    skos:definition "Gas phase containing free ions of analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic cloud" .

goldbook:08499 a skos:Concept ;
    skos:definition "Removal of material as an aerosol from a surface on irradiation by a laser beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser ablation" .

goldbook:08500 a skos:Concept ;
    skos:altLabel "LIBS" ;
    skos:definition "Measurement method of atomic spectroscopy that uses a focused laser beam to ablate, atomize and excite atoms from a sample surface with subsequent measurement of the generated electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser induced breakdown spectroscopy" .

goldbook:08501 a skos:Concept ;
    skos:definition "Emission spectrum generated as a consequence of the decay of the excited states generated in a laser-induced plasma that consists of a continuous background and element-specific atomic or ionic lines and molecular bands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser-induced breakdown spectrum" .

goldbook:08502 a skos:Concept ;
    skos:definition "Local plasma formed by the interaction between a laser beam and a solid sample and initiated by the production of primary electrons by multiphoton ionization and thermionic photoemission mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser-induced plasma" .

goldbook:08503 a skos:Concept ;
    skos:definition "Increase in the theoretical width of a spectral line owing to thermal motion of emitting atoms (Doppler effect), to electric field (Stark effect), to self-absorption and to pressure (Lorentz effect)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line-broadening" .

goldbook:08504 a skos:Concept ;
    skos:definition "Graph of the variation of emitted radiation intensity as a function of wavelength (emission line) or the variation of the absorption factor as a function of wavelength (absorption line)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line profile" .

goldbook:08505 a skos:Concept ;
    skos:definition "Liquid-sample introduction system to an inductively-coupled plasma spectrometer adapted to work at sample flow rates below \\(\\pu{100 \\upmu L min-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low sample consumption system" .

goldbook:08506 a skos:Concept ;
    skos:definition "Number of detector events per atom in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement efficiency" .

goldbook:08507 a skos:Concept ;
    skos:definition "Resonant cavity that permits focusing a microwave field inside a discharge tube thus giving rise to a standing wave." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microwave cavity" .

goldbook:08508 a skos:Concept ;
    skos:altLabel "microwave plasma" ;
    skos:definition "Plasma generated in a microwave cavity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microwave-induced plasma" .

goldbook:08509 a skos:Concept ;
    skos:definition "Conversion of a liquid into an aerosol consisting of droplets suspended in a gas stream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nebulization" .

goldbook:08510 a skos:Concept ;
    skos:definition "Device for producing nebulization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nebulizer" .

goldbook:08511 a skos:Concept ;
    skos:definition "Electromagnetic radiation, within the bandpass filter used, emitted by, or absorption caused by, atoms, molecules and radicals that are subject to the atomizer by all components, apart from the analyte, that are present there during measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-specific emission or attenuation" .

goldbook:08512 a skos:Concept ;
    skos:definition "Inductively-coupled plasma volume mainly responsible for emission of analytically-useful light because processes leading to excited species, such as droplet desolvation, element vaporization, atomization (or ionization) and excitation have been completed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal plasma analytical zone" .

goldbook:08513 a skos:Concept ;
    skos:altLabel "OES" ;
    skos:definition "Measurement principle of atomic emission spectroscopy in which the emitted electromagnetic radiation is in the range of frequencies from the infrared, through visible, to the ultra-violet region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical emission spectroscopy" .

goldbook:08514 a skos:Concept ;
    skos:definition "In atomic spectroscopy, mass of analyte converted into free atoms in the atomizer divided by mass of analyte entering the dispersion device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "overall efficiency of atomization" .

goldbook:08515 a skos:Concept ;
    skos:altLabel "Penning ionization" ;
    skos:definition "Collisional excitation and ionization mechanism of inductively-coupled plasma spectrometry involving analyte atoms and metastable argon atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Penning excitation" .

goldbook:08516 a skos:Concept ;
    skos:definition "In atomic spectroscopy, flux of mass of sample divided by the flux of mass of solvent blank, measured under the same conditions, expressed as a percentage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percentage transmission" .

goldbook:08517 a skos:Concept ;
    skos:definition "Substance added together with the sample or standards in electrothermal atomic absorption spectroscopy that is refractory, or forms a refractory species (e.g., a carbide), and thus does not need to be renewed for several atomization cycles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permanent modifier" .

goldbook:08518 a skos:Concept ;
    skos:definition "Plasma formed by an arc-discharge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma arc" .

goldbook:08519 a skos:Concept ;
    skos:definition "Temperature governing the number density of atomic species in their ground state and excited states following a Boltzmann distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma excitation temperature" .

goldbook:08520 a skos:Concept ;
    skos:definition "Gas streams used to maintain and stabilize the inductively-coupled plasma. The external stream is the main constituent of the plasma and confines the plasma avoiding melting of the torch walls; the intermediate gas stream keeps the plasma at a given height above the top of the torch and, the central stream carries the aerosol and promotes its injection in the plasma central channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma gases" .

goldbook:08521 a skos:Concept ;
    skos:definition "Inductively-coupled plasma volume where there is a maximum interaction between the electromagnetic field and the plasma gas (mostly argon). This is the plasma’s hottest area and has a toroidal configuration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma induction zone" .

goldbook:08522 a skos:Concept ;
    skos:definition "Temperature associated with the energy level of plasma ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma ionization temperature" .

goldbook:08523 a skos:Concept ;
    skos:altLabel "LTE" ;
    skos:definition "Condition for which the temperatures estimated from different particles (atoms, molecules, ions, electrons) constituting a plasma are locally coincident." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma local thermodynamic equilibrium" .

goldbook:08524 a skos:Concept ;
    skos:definition "Prevention of laser pulse energy from reaching a sample surface as a result of the presence of a laser-induced plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma shielding" .

goldbook:08525 a skos:Concept ;
    skos:definition "Extinction of the plasma after a laser pulse as a consequence of self-absorption (quenching) and recombination of electrons and ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma termination" .

goldbook:08526 a skos:Concept ;
    skos:altLabel "L’vov platform" ;
    skos:definition "Sample support made of graphite that is inserted into the atomizer tube in electrothermal atomic absorption spectroscopy. The sample, a liquid or a solid, is deposited onto this platform, from which it undergoes all the transformations leading to atomization. The use of a platform delays atomization, until a more stabilized temperature in the gas phase is reached." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "platform atomization" .

goldbook:08527 a skos:Concept ;
    skos:definition "Nebulizers for which the aerosol generation principle is based on the exposure of the liquid sample to a high velocity gas stream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pneumatic nebulizers" .

goldbook:08528 a skos:Concept ;
    skos:altLabel "preheating plasma zone" ;
    skos:definition "Inductively-coupled plasma volume where tertiary aerosols suffer from complete solvent evaporation, element salt vaporization and dissociation into atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preheating inductively-coupled plasma zone" .

goldbook:08529 a skos:Concept ;
    skos:definition "Aerosol generated by a nebulizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary aerosol" .

goldbook:08531 a skos:Concept ;
    skos:definition "Total optical energy content of a laser pulse. Integral of optical power over pulse duration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse energy" .

goldbook:08532 a skos:Concept ;
    skos:definition "Laser system that emits electromagnetic radiation in the form of pulses of a defined and constant duration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulsed laser" .

goldbook:08533 a skos:Concept ;
    skos:definition "Graph of absorbance against pyrolysis temperature in electrothermal atomic absorption spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrolysis curve" .

goldbook:08534 a skos:Concept ;
    skos:definition "Atomizer that is used to atomize those elements that form volatile species (e.g., hydrides) at relatively low temperatures (e.g., \\(\\pu{1000^{\\circ}C}\\) or below)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quartz atomizer" .

goldbook:08535 a skos:Concept ;
    skos:definition "Inductively-coupled plasma optical emission spectrometer configuration in which the plasma and the entrance slit are perpendicular and from which the signal is taken perpendicularly to the main plasma axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radial viewing mode" .

goldbook:08536 a skos:Concept ;
    skos:altLabel "RF generator" ;
    skos:definition "Component of an inductively-coupled plasma spectrometer responsible for the generation of alternating current in the radiofrequency portion of the electromagnetic spectrum (see table)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiofrequency generator" .

goldbook:08537 a skos:Concept ;
    skos:altLabel "RF-GD-OES" ;
    skos:definition "Optical emission spectroscopy in which a radiofrequency-powered glow discharge is operated with frequencies in the low megahertz range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiofrequency glow discharge optical emission spectroscopy" .

goldbook:08538 a skos:Concept ;
    skos:definition "Intensity transmitted by the reference medium in a double-beam spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference flux density" .

goldbook:08539 a skos:Concept ;
    skos:definition "Incident power that is not absorbed by the plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflected power" .

goldbook:08540 a skos:Concept ;
    skos:altLabel "pulse frequency" ;
    skos:definition "Number of laser pulses emitted by a pulsed laser system per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repetition rate" .

goldbook:08541 a skos:Concept ;
    skos:altLabel "RIXS",
        "resonant X-ray Raman",
        "resonant X-ray emission" ;
    skos:definition "Measurement method of inelastic X-ray spectroscopy that uses a hard or soft X-ray beam to excite transitions of core-level electrons into empty energy levels. The subsequent transition of an electron into the core state is accompanied by X-ray emission with characteristic momentum and energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonant inelastic X-ray scattering" .

goldbook:08542 a skos:Concept ;
    skos:altLabel "Saha–Langmuir equation" ;
    skos:definition "Equation that relates the ionization state of an element present in a gas in thermal equilibrium to the temperature and the pressure of the medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Saha’s ionization equation" .

goldbook:08543 a skos:Concept ;
    skos:definition "Intensity transmitted by the atomizer when the latter is supplied with the sample solution or a reference solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample flux density" .

goldbook:08544 a skos:Concept ;
    skos:definition "Buffer containing interfering element(s) in sufficient quantity to reach the limit of enhancement or dispersion (i.e., saturation) of the interference curve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturator" .

goldbook:08545 a skos:Concept ;
    skos:definition "Sequential spectrometers use a dispersive element (grating) in combination with entrance and exit slits for selection of specific wavelengths. Geometric arrangements include the Czerny-Turner and the Ebert-geometry, both offering high resolution measurements. However, they do not permit simultaneous recording of different spectral lines, even for single emission line intensity, and adjacent spectral background has also to be measured sequentially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential detection" .

goldbook:08546 a skos:Concept ;
    skos:definition "Intensity transmitted by the atomizer when the latter is supplied with the solvent blank." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent blank flux density" .

goldbook:08547 a skos:Concept ;
    skos:definition "Solvent condensation on solid particles or droplets contained in an aerosol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent nucleation" .

goldbook:08548 a skos:Concept ;
    skos:definition "Mass of solvent, both in liquid and vapour forms, reaching an inductively-coupled plasma per unit of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent transport rate" .

goldbook:08549 a skos:Concept ;
    skos:altLabel "flame background" ;
    skos:definition "Electromagnetic radiation, within the bandpass used, emitted by, and/or in the case of atomic absorption spectroscopy, absorbed in, the atomizer when nothing is supplied to the atomizer but the gases involved in its operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral background" .

goldbook:08550 a skos:Concept ;
    skos:altLabel "line",
        "spectral line" ;
    skos:definition "In atomic spectroscopy, a very narrow band of frequencies of electromagnetic radiation emitted or absorbed by atoms, which undergo a single electronic transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral line" .

goldbook:08551 a skos:Concept ;
    skos:definition "Chamber of a nebulizer in which the sprayed liquid is converted to mist. Some of the droplets of this mist may evaporate, coalesce, or deposit in the chamber and subsequently drain away as waste." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spray chamber" .

goldbook:08552 a skos:Concept ;
    skos:definition "Mass of material removed from a sample surface in unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sputter rate" .

goldbook:08553 a skos:Concept ;
    skos:definition "Stoppage to the otherwise constant flow of argon gas to the atomizer in electrothermal atomic absorption spectroscopy, that can be programmed to occur during atomization, for the purpose of increasing the residence time of the analyte atoms and thus the associated signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stop-flow conditions" .

goldbook:08554 a skos:Concept ;
    skos:definition "X-ray spectroscopy performed using a high intensity, continuous polychromatic synchrotron X-ray source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synchrotron X-ray spectroscopy" .

goldbook:08555 a skos:Concept ;
    skos:definition "Aerosol that reaches an inductively-coupled plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tertiary aerosol" .

goldbook:08556 a skos:Concept ;
    skos:definition "Procedures whereby an aerosol is produced at a high temperature, for example by sparks, arcs, furnaces, lasers, cathodic sputtering or electron-beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal dispersion" .

goldbook:08557 a skos:Concept ;
    skos:definition "Process in glow-discharge atomic emission spectroscopy in which sample volatilization occurs by heating due to sample bombardment with argon ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal volatilization" .

goldbook:08558 a skos:Concept ;
    skos:definition "Measurement method of laser-induced breakdown spectroscopy in which the emitted radiation is monitored with time resolution sufficiently high to resolve different stages in the lifetime of the laser-induced plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-resolved laser-induced breakdown spectroscopy" .

goldbook:08559 a skos:Concept ;
    skos:definition "Liquid-sample introduction system able to achieve \\(\\pu{100\\%}\\) transport efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total sample consumption system" .

goldbook:08560 a skos:Concept ;
    skos:definition "Mass of analyte entering the atomizer of a flame atomic spectrometer or the plasma of an inductively-coupled plasma spectrometer divided by the mass of analyte entering the dispersion device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transport efficiency" .

goldbook:08561 a skos:Concept ;
    skos:definition "Nebulizers whose aerosol generation principle is based on the transfer of the energy from a vibrating transducer to the liquid sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrasonic nebulizers" .

goldbook:08562 a skos:Concept ;
    skos:definition "Electrothermal atomic absorption spectroscopy in which the sample is deposited directly onto the wall of the electrothermal atomizer tube, from which it undergoes all the transformations leading to atomization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wall atomization" .

goldbook:08563 a skos:Concept ;
    skos:definition "Time required for the output signal of an inductively-coupled plasma spectrometer for a given analyte to fall back to baseline levels from the end of sampling time and/or after introducing a blank solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wash out time" .

goldbook:08564 a skos:Concept ;
    skos:definition "Spectrum comprising the continuum Bremsstrahlung and the most energetic characteristic spectral lines defined by differences in binding energy between electron energy levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray emission spectrum" .

goldbook:08565 a skos:Concept ;
    skos:altLabel "AMTIR" ;
    skos:definition "Amorphous glasses made from elements of groups 4, 5 and 6 of the Periodic Table that transmit infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amorphous material transmitting infrared radiation" .

goldbook:08566 a skos:Concept ;
    skos:definition "Modulation of the amplitude of a beam of electromagnetic radiation; by the movement of a moving mirror in a rapid scan Fourier-transform spectrometer or by a mechanical chopper in other spectrometers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amplitude modulation" .

goldbook:08567 a skos:Concept ;
    skos:definition "Raman scattering by the anisotropic part of the derived polarizability tensor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anisotropic Raman scattering" .

goldbook:08568 a skos:Concept ;
    skos:definition "Changes in real refractive index of a material in the vicinity of an absorption band in which real refractive index decreases markedly with decreasing wavenumber on the high wavenumber side of an absorption band, then increases rapidly through the band centre and decreases markedly on the low wavenumber side of the band, before resuming normal dispersion at wavenumbers far from the band." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anomalous dispersion" .

goldbook:08569 a skos:Concept ;
    skos:definition "Raman band with a depolarization ratio greater than \\(\\pu{0.75}\\), as is frequently observed in surface-enhanced resonance Raman spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anomalously polarized Raman band" .

goldbook:08570 a skos:Concept ;
    skos:definition "Raman scattering of electromagnetic radiation in which the scattered radiation has greater energy (greater wavenumber) than the exciting radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-Stokes Raman scattering" .

goldbook:08571 a skos:Concept ;
    skos:definition "Rotor whose three principal moments of inertia are all different." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric top" .

goldbook:08572 a skos:Concept ;
    skos:altLabel "APT" ;
    skos:definition "3 × 3 tensor that gives the change in the components of the molecular dipole moment when the atom is displaced in three-dimensional space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic polar tensor" .

goldbook:08573 a skos:Concept ;
    skos:altLabel "frustrated total internal reflection spectroscopy",
        "internal reflection spectroscopy (IRS)" ;
    skos:definition "Measurement method of vibrational spectroscopy based on internal reflection from an absorbing material at angles of incidence at or above the critical angle (attenuated total reflection)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attenuated total reflection spectroscopy" .

goldbook:08574 a skos:Concept ;
    skos:definition "Description of the profile of a spectral band." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "band shape" .

goldbook:08575 a skos:Concept ;
    skos:definition "Optical filter used, for example, to attenuate Rayleigh scattering while transmitting light subject to Raman shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bragg filter" .

goldbook:08576 a skos:Concept ;
    skos:altLabel "center burst" ;
    skos:definition "Spectral region of an interferogram around zero-path-difference where intensity is greatest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centre burst" .

goldbook:08577 a skos:Concept ;
    skos:definition "Collections of solid particles that are transparent to electromagnetic radiation of a particular wavelength and are slightly larger than the wavelength of the radiation transmit poorly due to reflection and scattering from the interfaces. The transmission increases markedly at wavenumbers at which the refractive index of the particles is close to that of the surrounding medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Christiansen effect" .

goldbook:08578 a skos:Concept ;
    skos:definition "Optical filter based on the Christiansen effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Christiansen filter" .

goldbook:08579 a skos:Concept ;
    skos:altLabel "CARS" ;
    skos:definition "Measurement method of Raman spectroscopy that uses third-order susceptibility and is one of several four-wave mixing spectroscopies. The excitation is through lasers of wavenumber \\(\\tilde{ u}_{1}\\) and \\(\\tilde{ u}_{2}\\), which coincide spatially and temporally in the sample and produce an output laser of wavenumber \\(\\tilde{ u}_{3} = 2\\tilde{ u}_{1} - \\tilde{ u}_{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent anti-Stokes Raman spectroscopy" .

goldbook:08580 a skos:Concept ;
    skos:definition "Transition in which more than one vibration changes its degree of excitation; i.e., in which more than one vibrational quantum number changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combination transition" .

goldbook:08581 a skos:Concept ;
    skos:definition "Interferometer in which the optical path difference is continually changed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous scan interferometer" .

goldbook:08582 a skos:Concept ;
    skos:definition "Coupling between rotational and vibrational molecular motion caused by Coriolis forces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Coriolis coupling" .

goldbook:08583 a skos:Concept ;
    skos:definition "In vibrational theory, the motion of a polyatomic molecule is usually initially regarded as the independent superposition of a rotation and a vibration, with the vibration considered in a coordinate system that rotates with the molecule. This initial treatment must be corrected for centrifugal forces and for Coriolis forces. The Coriolis force on an atom is given by \\(F_{\\rm{Coriolis}} = 2m v_{\\rm{a}} \\omega \\sin \\varphi\\), where \\(m\\) is the mass of the atom, \\(v_{\\rm{a}}\\) is its apparent velocity in the rotating coordinate system, \\(\\omega\\) is the angular velocity of the coordinate system, and \\(\\varphi\\) is the angle between the velocity vector and the axis of rotation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Coriolis force" .

goldbook:08584 a skos:Concept ;
    skos:definition "Smallest angle of incidence at which total internal reflection occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical angle" .

goldbook:08585 a skos:Concept ;
    skos:definition "Vibration in which the dominant change from equilibrium is in one or more valence angles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deformation vibration" .

goldbook:08586 a skos:Concept ;
    skos:definition "Raman intensity with the electric vector of the scattered electromagnetic radiation perpendicular to that of the incident radiation divided by the Raman intensity with electric vectors parallel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depolarization ratio" .

goldbook:08587 a skos:Concept ;
    skos:definition "Raman band with depolarization ratio \\(\\rho = 0.75\\) for linear polarized incident radiation in normal Raman spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depolarized Raman band" .

goldbook:08588 a skos:Concept ;
    skos:altLabel "difference band",
        "difference tone" ;
    skos:definition "Combination transition that does not start at the ground state and in which at least one vibration decreases and at least one vibration increases its degree of excitation; i.e., a transition in which more than one vibrational quantum number changes and at least one becomes smaller." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "difference transition" .

goldbook:08589 a skos:Concept ;
    skos:definition "Measuring instrument for Raman spectroscopy incorporating a dish-shaped cell that is divided by a vertical partition through its middle to allow different liquids in its two halves. It is rotated about a vertical axis through its centre and the Raman scattered radiation from each half is measured alternately. With a standard liquid in one half and a sample in the other it is used to determine Raman scattering intensities relative to the standard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "divided spinning cell" .

goldbook:08590 a skos:Concept ;
    skos:definition "Spectrum of a material under the influence of an applied external perturbation represented by a variable \\(\\tau\\), relative to a reference spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic spectrum" .

goldbook:08591 a skos:Concept ;
    skos:altLabel "anharmonicity" ;
    skos:definition "Influence of terms that are of \\(2^{\\rm{nd}}\\) and higher order in the normal coordinate \\(Q\\) in the expansion of the electric dipole moment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrical anharmonicity" .

goldbook:08592 a skos:Concept ;
    skos:altLabel "harmonicity" ;
    skos:definition "Influence of the linear term, \\(\\Sigma_{k} (\\partial \\boldsymbol{\\mu}/\\partial Q_{k}) Q_{k}\\), in the expansion of the electric dipole moment. \\(Q\\) is the normal coordinate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrical harmonicity" .

goldbook:08593 a skos:Concept ;
    skos:altLabel "EELS" ;
    skos:definition "Measurement method of vibrational spectroscopy in which a constant-energy beam of electrons passes through or is reflected from a sample and the energy distribution in the transmitted or reflected beam is analysed to give a spectrum of number of electrons against electron energy loss." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron energy loss spectroscopy" .

goldbook:08594 a skos:Concept ;
    skos:altLabel "EOP",
        "equilibrium charge, charge flux (ECCF)" ;
    skos:definition "Characteristic quantity used in the analysis of absolute infrared intensity data chosen on the assumption that the electric dipole moment of the molecule can be described as the vector sum of bond dipole moments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-optic parameter" .

goldbook:08595 a skos:Concept ;
    skos:definition "Degree to which linearly polarized incident electromagnetic radiation becomes elliptically polarized in an absorbing optically active medium. \\[\\tan\\;\\psi = (E_{\\rm{R}} - E_{\\rm{L}})/(E_{\\rm{R}} + E_{\\rm{L}}) = \\tanh (k^{\\rm{L}} - k^{\\rm{R}})\\pi l/\\lambda\\] where \\(E_{\\rm{R}}\\) and \\(E_{\\rm{L}}\\) are the electric vectors of right and left circularly polarized radiation, \\(k^{\\rm{L}}\\) and \\(k^{\\rm{R}}\\) are the absorption indices of the sample for left and right circularly polarized radiation, \\(\\lambda\\) is the wavelength of the radiation and \\(l\\) is the path-length through the medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ellipticity" .

goldbook:08596 a skos:Concept ;
    skos:definition "Part of a standing-wave normal to a reflecting surface that extends beyond the reflecting surface when an electromagnetic wave undergoes total internal reflection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evanescent wave" .

goldbook:08597 a skos:Concept ;
    skos:definition "Unexpected minimum or hole in a broad absorption band due to a gap being created in a broad distribution of states by Fermi resonance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Evans hole" .

goldbook:08598 a skos:Concept ;
    skos:definition "Graph of Raman intensity at the desired Raman shift against wavenumber of the excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation profile" .

goldbook:08599 a skos:Concept ;
    skos:definition "Measurement method of spectroscopy in which radiation is reflected from a sample of higher refractive index than that of the incident medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external reflection spectroscopy" .

goldbook:08600 a skos:Concept ;
    skos:altLabel "extraordinary ray" ;
    skos:definition "In a uniaxial crystal electromagnetic radiation with electric vector oblique to the optic axis and which does not obey the normal laws of refraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraordinary wave" .

goldbook:08601 a skos:Concept ;
    skos:definition "Cubic anharmonic resonance (see anharmonicity), i.e., any interaction caused by cubic terms in the vibrational potential energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fermi resonance" .

goldbook:08602 a skos:Concept ;
    skos:definition "Free spectral range divided by resolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "finesse" .

goldbook:08603 a skos:Concept ;
    skos:definition "Infrared and Raman bands that are characteristic of a particular molecule rather than a functional group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fingerprint bands" .

goldbook:08604 a skos:Concept ;
    skos:definition "Region of a spectrum that contains fingerprint bands as well as bands with characteristic group frequencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fingerprint region" .

goldbook:08605 a skos:Concept ;
    skos:altLabel "FT-IR",
        "Fourier-transform infrared spectrometry" ;
    skos:definition "Infrared spectroscopy in which a Fourier-transform spectrometer is used to separate the transmitted electromagnetic radiation into its component wavenumbers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fourier-transform infrared spectroscopy" .

goldbook:08606 a skos:Concept ;
    skos:altLabel "Fourier-transform Raman spectrometry" ;
    skos:definition "Raman spectroscopy in which a Fourier-transform spectrometer is used to separate the scattered electromagnetic radiation into its component wavenumbers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fourier-transform Raman spectroscopy" .

goldbook:08607 a skos:Concept ;
    skos:definition "For a Fabry-Perot or laser cavity, wavenumber interval between successive longitudinal cavity modes of vibration; \\(\\Delta \\tilde{ u} = 1/(2nl)\\), where \\(l\\) is the cavity spacing and \\(n\\) is the refractive index of the material in the cavity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free spectral range" .

goldbook:08608 a skos:Concept ;
    skos:definition "Angle of incidence of a beam of electromagnetic radiation greater than \\(\\pu{70\\!^{\\circ}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grazing incidence" .

goldbook:08609 a skos:Concept ;
    skos:definition "Frequency in vibrational spectroscopy that is characteristic of a particular chemical functional group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "group frequency" .

goldbook:08610 a skos:Concept ;
    skos:altLabel "harmonic wavenumber" ;
    skos:definition "Coefficient of (\\( u + &half;\\)) in the vibrational term value, determined by the harmonic terms in the vibrational potential energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harmonic constant" .

goldbook:08611 a skos:Concept ;
    skos:altLabel "homogeneous broadening" ;
    skos:definition "Line-broadening by mechanisms that affect every molecule of the same species in the sample in the same way." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous line-broadening" .

goldbook:08612 a skos:Concept ;
    skos:definition "Electronic transition between an excited state and a state in which all vibrational quantum numbers are the same or greater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hot transition" .

goldbook:08613 a skos:Concept ;
    skos:altLabel "HRS" ;
    skos:definition "Raman spectroscopy in which scattering occurs through hyperpolarizabilities. A two-photon technique in which an intense pulsed beam of electromagnetic radiation is focused onto the sample. When sufficient power is present in the pulse, two photons may interact with the one molecule to create a virtual state at double the frequency of the laser excitation. Raman scattering from this virtual state to an excited vibrational state of the ground state then occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyper-Raman spectroscopy" .

goldbook:08614 a skos:Concept ;
    skos:definition "Measurement method to obtain information about the spatial composition of a sample by obtaining a spectrum at each spatially resolved point of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperspectral imaging" .

goldbook:08615 a skos:Concept ;
    skos:definition "In spectroscopy, a rotation-reflection axis, which is a symmetry element such that rotation by \\(2\\pi/n\\) about the axis followed by reflection through a plane perpendicular to the axis transforms an object into itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "improper rotation axis" .

goldbook:08616 a skos:Concept ;
    skos:altLabel "IETS" ;
    skos:definition "Measurement method of vibrational spectroscopy to obtain spectra of molecules on metal oxide surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inelastic electron tunnelling spectroscopy" .

goldbook:08617 a skos:Concept ;
    skos:altLabel "IR",
        "infrared" ;
    skos:definition "Electromagnetic radiation of wavelength between approximately \\(\\pu{780 nm}\\) and \\(\\pu{1000 \\upmu m}\\) or of wavenumber between approximately \\(\\pu{13000 cm-1}\\) and \\(\\pu{10 cm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infrared radiation" .

goldbook:08618 a skos:Concept ;
    skos:definition "Measurement principle of vibrational spectroscopy using infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infrared spectroscopy" .

goldbook:08619 a skos:Concept ;
    skos:definition "Line-broadening by mechanisms that arise from an ensemble of spectroscopically non-equivalent molecules of the same species. Such molecules exist, for example, when molecules occupy non-equivalent sites in a condensed phase, and when gaseous molecules have different velocities and, thus, shift the observed wavenumber differently through the Doppler effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhomogeneous broadening" .

goldbook:08620 a skos:Concept ;
    skos:altLabel "channel fringes" ;
    skos:definition "Sinusoidal intensity variation due to interference of electromagnetic radiation that undergoes multiple reflection between two flat and parallel surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interference fringes" .

goldbook:08621 a skos:Concept ;
    skos:altLabel "interference function" ;
    skos:definition "Record of the signal from the detector of a two-beam interferometer as the optical path difference between the two beams is varied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interference record" .

goldbook:08622 a skos:Concept ;
    skos:definition "Pattern formed by wave interference produced by an interferometer, especially one represented on a screen or chart recorder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interferogram" .

goldbook:08623 a skos:Concept ;
    skos:definition "Reflection of electromagnetic radiation from a material of lesser refractive index than that of the incident medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal reflection" .

goldbook:08624 a skos:Concept ;
    skos:definition "Transparent or semi-transparent material of high refractive index that carries infrared radiation to a sample in internal reflection and attenuated total reflection measurements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal reflection element" .

goldbook:08625 a skos:Concept ;
    skos:definition "Raman scattering showing absorption when Stokes Raman scattering exceeds anti-Stokes Raman scattering, in an experiment in which a sample is simultaneously illuminated by coincident beams from a continuum source and a pulse laser at \\(\\tilde{ u}_{0}\\). Energy is absorbed from the continuum at \\(\\tilde{ u}_{0} + \\tilde{ u}_{\\rm{s}}\\) where \\(\\tilde{ u}_{\\rm{s}}\\) is the wavenumber of a Raman-active vibration in the sample that is excited by this process, and this energy is emitted at \\(\\tilde{ u}_{0}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse Raman scattering" .

goldbook:08626 a skos:Concept ;
    skos:definition "Variant of spatially offset Raman spectroscopy in which a sample is illuminated with a ring of laser light and the Raman scattering is collected from the centre of the ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse spatially offset Raman spectroscopy" .

goldbook:08627 a skos:Concept ;
    skos:definition "Kinds of crystal transparent to infrared radiation used as windows and filters in infrared spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "IRTRAN™" .

goldbook:08628 a skos:Concept ;
    skos:altLabel "J-stop" ;
    skos:definition "Aperture in the optics of a Fourier-transform spectrometer, typically between the source and the interferometer, designed to be the limiting aperture when no other optical element such as the detector serves this purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Jacquinot stop" .

goldbook:08629 a skos:Concept ;
    skos:definition "Coupling of vibrational displacements through terms in the vibrational kinetic energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic coupling" .

goldbook:08630 a skos:Concept ;
    skos:definition "Eutectic (\\(\\pu{42 \\% TlBr, 58 \\% TlI}\\)) mixture of thallium bromide and thallium iodide transparent to infrared radiation used as window in infrared spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "KRS-5" .

goldbook:08631 a skos:Concept ;
    skos:altLabel "remission function" ;
    skos:definition "\\(f(R_{\\infty}) = (1 – R_{\\infty})^{2}/2R_{\\infty}\\), where \\(R_{\\infty}\\) is the diffuse reflectance from a sample of infinite depth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kubelka–Munk function" .

goldbook:08632 a skos:Concept ;
    skos:definition "Homogeneous line-broadening due to the limited lifetime of energy states involved in a transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lifetime broadening" .

goldbook:08633 a skos:Concept ;
    skos:altLabel "local mode" ;
    skos:definition "Mode of vibration localized in one type of bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local mode" .

goldbook:08634 a skos:Concept ;
    skos:altLabel "molar polarizability" ;
    skos:definition "Defined under the assumption of the Lorentz local field by the Lorentz-Lorenz formula: \\[\\hat{\\alpha}_{\\rm{m}}(\\tilde{ u}) = 3V_{\\rm{m}}\\epsilon_{0} \\frac{\\hat{\\epsilon}(\\tilde{ u}) - 1}{\\hat{\\epsilon}(\\tilde{ u}) + 2} = 3V_{\\rm{m}}{\\epsilon}_{0}\\,\\frac{\\hat{n}^{2}(\\tilde{ u}) - 1}{\\hat{n}^{2}(\\tilde{ u}) + 2}\\] where \\(V_{\\rm{m}}\\) is the molar volume and \\(\\hat{\\epsilon}\\) and \\(\\boldsymbol{\\hat{n}}\\) are the complex dielectric constant and refractive index, respectively. To allow description of absorption, \\(\\hat{\\alpha}_{\\rm{m}}(\\tilde{ u})\\) is complex: \\(\\hat{\\alpha}_{\\rm{m}}(\\tilde{ u}) = \\alpha_{\\rm{m}}'(\\tilde{ u}) + \\rm{i}\\alpha_{\\rm{m}}''(\\tilde{ u})\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local molar polarizability" .

goldbook:08635 a skos:Concept ;
    skos:altLabel "anharmonicity" ;
    skos:definition "Influence of cubic and higher-order terms in vibrational potential energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanical anharmonicity" .

goldbook:08636 a skos:Concept ;
    skos:altLabel "harmonicity" ;
    skos:definition "Influence of quadratic terms in vibrational potential energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanical harmonicity" .

goldbook:08638 a skos:Concept ;
    skos:definition "Ellipticity divided by the amount concentration of the optically active absorbing material and by the path-length at temperature (\\(t\\)) and wavelength (\\(\\lambda\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar ellipticity" .

goldbook:08639 a skos:Concept ;
    skos:definition "Decrease in measurement uncertainty obtained by measuring intensity at many different wavelengths simultaneously, as is done, for example, in Fourier-transform spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplex advantage" .

goldbook:08641 a skos:Concept ;
    skos:definition "Line width of a molecular spectral band that arises from the probability of spontaneous emission in the absence of radiation fields and interaction with other molecules or entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural linewidth" .

goldbook:08642 a skos:Concept ;
    skos:altLabel "near-IR" ;
    skos:definition "Infrared radiation of which vacuum wavenumbers range from approximately \\(\\pu{12800 cm-1}\\) to \\(\\pu{4800 cm-1}\\) and wavelengths range from approximately \\(\\pu{780 nm}\\) to \\(\\pu{2500 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "near-infrared radiation" .

goldbook:08643 a skos:Concept ;
    skos:definition "Kinds of infrared spectroscopy in which the effect of the sample on the radiation from the source is measured as a whole without exploring the dependence on wavenumber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-dispersive infrared spectroscopies" .

goldbook:08644 a skos:Concept ;
    skos:definition "Formal mathematical description of a normal vibration. When the potential energy, \\(V\\), is harmonic and the kinetic energy, \\(T\\), is calculated in the limit of infinitesimally small displacements, the normal coordinates are defined as independent entities such that '(for non-linear molecules)'\\[V = &half;\\sum_{k=1}^{3N-6}\\lambda_{k}Q_{k}^{2}\\ {\\rm{and}}\\ T = &half;\\sum_{k=1}^{3N-6}\\dot Q_{k}^{2}\\]where \\(\\lambda_{k}\\) is the \\(k^{\\rm{th}}\\) eigenvalue and \\(\\dot {Q}\\) is \\(\\partial Q/\\partial t\\). Normal coordinate \\(Q_{k}\\) is related to the internal displacement coordinates, \\(R_{i}\\), through the elements, \\(L_{ik} = \\partial R_{i}/\\partial Q_{k}\\) of the \\(k^{\\rm{th}}\\) column of the eigenvector matrix \\(\\boldsymbol{L}\\). Normal coordinates are not independent when the potential energy is anharmonic, or the displacements are not infinitesimal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal coordinate" .

goldbook:08645 a skos:Concept ;
    skos:definition "Calculation of the normal modes of vibrations of a molecule or crystal under the assumptions that the potential energy is harmonic and the displacements from equilibrium are infinitesimal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal coordinate analysis" .

goldbook:08646 a skos:Concept ;
    skos:altLabel "normal dispersion" ;
    skos:definition "Slow decrease of real refractive index of a material in a non-absorbing spectral region far from regions of strong absorption as the wavenumber decreases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal dispersion of the refractive index" .

goldbook:08647 a skos:Concept ;
    skos:definition "Incidence of a beam of electromagnetic radiation when the angle of incidence \\(\\theta = \\pu{0\\!^{\\circ}}\\), i.e., the incident radiation beam is normal to the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal incidence" .

goldbook:08648 a skos:Concept ;
    skos:altLabel "normal mode",
        "normal vibration",
        "normal vibration mode" ;
    skos:definition "One of the \\(3N - 6\\) (\\(3N - 5\\) for a linear molecule) modes of vibration that would add to give the total vibrational motion in a molecule if the interatomic potential were strictly quadratic in the displacements from equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal mode" .

goldbook:08649 a skos:Concept ;
    skos:altLabel "NTI",
        "constant resolution tunnelling intensity" ;
    skos:definition "Second differential of intensity with respect to bias voltage divided by first differential of intensity with respect to bias voltage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normalized tunnelling intensity" .

goldbook:08650 a skos:Concept ;
    skos:definition "Depth in a sample at which the intensity of an incident beam is reduced to \\(1/\\rm{e}\\) of its value at the surface of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical absorption depth" .

goldbook:08651 a skos:Concept ;
    skos:definition "Collective name for the real refractive index, \\(n\\) and the absorption index (imaginary refractive index), \\(k\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical constants" .

goldbook:08652 a skos:Concept ;
    skos:altLabel "NTI double beam spectrometer",
        "null-balance double beam spectrometer" ;
    skos:definition "Spectrometer in which the ratio of the radiant power in the two beams at each wavenumber is measured opto-mechanically by inserting a linear optical attenuator into the reference beam until the two signals measured by the detector are equal, then measuring the displacement of the optical attenuator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical null double beam spectrometer" .

goldbook:08653 a skos:Concept ;
    skos:altLabel "OPD",
        "optical retardation" ;
    skos:definition "Path-length difference between the arms of a two-beam interferometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical path difference" .

goldbook:08654 a skos:Concept ;
    skos:altLabel "ORD" ;
    skos:definition "Wavelength dependence of the angle of rotation of the plane of linearly-polarized radiation when transmitted through optically active materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical rotatory dispersion" .

goldbook:08655 a skos:Concept ;
    skos:altLabel "ordinary ray" ;
    skos:definition "In a uniaxial crystal electromagnetic radiation with electric vector perpendicular to the optic axis and which obeys the normal laws of refraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ordinary wave" .

goldbook:08656 a skos:Concept ;
    skos:definition "Transition between the ground state and a state in which a single mode of vibration is multiply excited." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "overtone transition" .

goldbook:08657 a skos:Concept ;
    skos:definition "\\(-\\log_{10}\\) of the spectrum obtained in attenuated total reflection spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pATR spectrum" .

goldbook:08658 a skos:Concept ;
    skos:definition "Condition in photoacoustic spectroscopy in which all bands with greater than a certain absorption intensity appear to have the same intensity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoacoustic saturation" .

goldbook:08659 a skos:Concept ;
    skos:definition "Measurement method of spectroscopy in which the absorption of electromagnetic radiation by a sample is detected as a result of the heat generated by the absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photothermal spectroscopy" .

goldbook:08660 a skos:Concept ;
    skos:definition "Raman band with depolarization ratio \\(\\rho \\le 0.75\\) for linear polarized incident radiation in normal Raman spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarized Raman band" .

goldbook:08661 a skos:Concept ;
    skos:definition "Coupling of vibrational displacements through terms in the vibrational potential energy. The second-order (quadratic) terms cause harmonic potential coupling while the cubic and higher terms cause anharmonic potential coupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential coupling" .

goldbook:08662 a skos:Concept ;
    skos:altLabel "TM polarization",
        "transverse magnetic polarization" ;
    skos:definition "Polarization when electromagnetic radiation is incident upon a surface with its electric vector in the plane of incidence and, therefore, inclined to the reflecting surface unless the incidence is normal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "p-polarization" .

goldbook:08663 a skos:Concept ;
    skos:altLabel "collision broadening" ;
    skos:definition "Increase in the line width of a spectral line of a gas due to molecular collisions and other intermolecular interactions that reduce the lifetime of an excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pressure broadening" .

goldbook:08664 a skos:Concept ;
    skos:altLabel "QCL" ;
    skos:definition "Laser that emits mid-infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum cascade laser" .

goldbook:08665 a skos:Concept ;
    skos:definition "Spectral band in Raman spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman band" .

goldbook:08666 a skos:Concept ;
    skos:altLabel "ROA" ;
    skos:definition "Phenomenon that vibrations in chiral molecules and materials Raman scattering right circularly polarized incident radiation to a different extent than left circularly polarized incident radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman optical activity" .

goldbook:08667 a skos:Concept ;
    skos:altLabel "normal Raman scattering" ;
    skos:definition "Inelastic scattering of electromagnetic radiation by molecules that are excited to higher energy levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman scattering" .

goldbook:08668 a skos:Concept ;
    skos:altLabel "Raman wavenumber shift" ;
    skos:definition "Difference in wavenumber between the incident and scattered electromagnetic radiation in Raman spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman shift" .

goldbook:08669 a skos:Concept ;
    skos:definition "Measurement principle of vibrational spectroscopy based on Raman scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman spectroscopy" .

goldbook:08670 a skos:Concept ;
    skos:definition "Graph of the intensity of scattered electromagnetic radiation in Raman spectroscopy against Raman shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman spectrum" .

goldbook:08671 a skos:Concept ;
    skos:altLabel "Raman shift" ;
    skos:definition "Wavenumber of exciting electromagnetic radiation minus wavenumber of the scattered radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raman wavenumber shift" .

goldbook:08672 a skos:Concept ;
    skos:definition "Fourier-transform infrared spectroscopy in which the optical path difference is continually changed at a rate of \\(\\pu{0.05 cm s-1}\\) or greater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rapid-scan Fourier-transform infrared spectroscopy" .

goldbook:08673 a skos:Concept ;
    skos:definition "Reflection-absorption with very thin layers of an absorbing material on a metallic substrate and the angle of incidence between \\(\\pu{70\\!^{\\circ}}\\) and \\(\\pu{90\\!^{\\circ}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflection-absorption at grazing incidence" .

goldbook:08674 a skos:Concept ;
    skos:altLabel "RR" ;
    skos:definition "Raman scattering that occurs through the polarizability of a molecule, (not the hyperpolarizabilities) and is excited by electromagnetic radiation that is in resonance with electronic transitions or vibronic transitions in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance Raman scattering" .

goldbook:08675 a skos:Concept ;
    skos:definition "Spectral lines in the rotation-vibration spectrum of a gas that derive from the same change in rotation quantum number, \\(J\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational branch" .

goldbook:08676 a skos:Concept ;
    skos:definition "Spectrum that shows absorption or emission of radiation during transitions between rotational-vibrational states of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotation-vibration spectrum" .

goldbook:08677 a skos:Concept ;
    skos:definition "Relation between the propagation directions, \\(k_{\\rm{i}}\\), \\(k_{\\rm{s}}\\), and the polarization directions, \\(p_{\\rm{i}}\\), \\(p_{\\rm{s}}\\), of the incident and scattered radiation, usually expressed in terms of laboratory-fixed or crystal-fixed Cartesian axes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering geometry" .

goldbook:08678 a skos:Concept ;
    skos:definition "Appearance of more than one band in the spectrum of a crystal when only one is seen in that of the gas, when this splitting is attributed to either the molecule lying on a crystal site of lower symmetry than that of the gaseous molecule or to molecules occupying more than one type of crystal site. See crystal field splitting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "site splitting" .

goldbook:08679 a skos:Concept ;
    skos:altLabel "SORS" ;
    skos:definition "Measurement method of Raman spectroscopy in which the sample is illuminated at one location, and the Raman signal is collected from a different location on the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spatially offset Raman spectroscopy" .

goldbook:08680 a skos:Concept ;
    skos:definition "Molecule whose three principal moments of inertia are all the same. An isotropic molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spherical top" .

goldbook:08681 a skos:Concept ;
    skos:definition "Interferometer (typically used for Fourier-transform infrared spectroscopy) in which the optical path difference is changed by a certain amount, held constant, or modulated if phase modulation is desired, while the signal at the current path difference is recorded, then the process is repeated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "step-scan interferometer" .

goldbook:08682 a skos:Concept ;
    skos:altLabel "SRS" ;
    skos:definition "Two-photon Raman scattering occurs when a picosecond pump beam is used to create a virtual state and a probe beam of a frequency to match the frequency of Stokes Raman scattering from the virtual state to a specific vibrational level. The Stokes emission is stimulated thus depopulating the virtual state very quickly and increasing the scattering efficiency for the chosen vibration by orders of magnitude. SRS is a non-linear process, so sufficient photons from both the pump and probe beams must be present on the molecule at the one time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimulated Raman scattering" .

goldbook:08683 a skos:Concept ;
    skos:altLabel "Stokes scattering" ;
    skos:definition "Raman scattering of electromagnetic radiation in which the scattered radiation has lesser energy (lesser wavenumber) than the exciting radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes–Raman scattering" .

goldbook:08684 a skos:Concept ;
    skos:definition "Band resulting from a sum transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sum band" .

goldbook:08685 a skos:Concept ;
    skos:definition "Combination transition between the ground state and a state in which more than one vibration is excited; i.e., a transition from the ground state in which more than one quantum number increases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sum transition" .

goldbook:08686 a skos:Concept ;
    skos:definition "Nonlinear optical technique in which pulsed lasers at frequencies \\(\\omega_{1}\\) and \\(\\omega_{2}\\) are overlapped at a surface and light emitted at the sum of the two frequencies, \\(\\omega_{1} + \\omega_{2}\\), is detected. One laser is normally in the mid-infrared and the other in the visible or near-infrared." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sum-frequency spectroscopy" .

goldbook:08687 a skos:Concept ;
    skos:altLabel "SEHRS" ;
    skos:definition "Measurement method of Raman spectroscopy by which the Raman spectrum is significantly enhanced simultaneously by both the hyper-Raman (see hyper-Raman spectroscopy) and surface-enhanced Raman (see surface-enhanced Raman spectroscopy) effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced hyper-Raman spectroscopy" .

goldbook:08688 a skos:Concept ;
    skos:altLabel "SEIRA" ;
    skos:definition "Measurement method of infrared spectroscopy by which the intensity of absorption bands of molecules within a few nanometers of the surface of metal particles is increased by interactions with surface plasmons (the collective resonance of electrons near the surface of metal islands)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced infrared absorption" .

goldbook:08689 a skos:Concept ;
    skos:altLabel "SERS" ;
    skos:definition "Measurement method of Raman spectroscopy by which the intensity of vibrational bands in the Raman spectra of molecules within a few nanometers of the surface of microscopically rough metals, metal colloids and metal nanoparticles is increased by several orders of magnitude." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced Raman spectroscopy" .

goldbook:08690 a skos:Concept ;
    skos:altLabel "SERRS" ;
    skos:definition "Measurement method of surface-enhanced Raman spectroscopy (SERS) by which the Raman spectrum is significantly enhanced when the conditions occur that whilst undergoing SERS the molecules are excited by radiation that is in resonance with electronic transitions in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced resonance Raman spectroscopy" .

goldbook:08691 a skos:Concept ;
    skos:altLabel "SESORS" ;
    skos:definition "Measurement method of Raman spectroscopy that combines spatially offset Raman spectroscopy and surface-enhanced Raman spectroscopy (SERS) enabling the detection of a SERS signal deep within diffusely scattering samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced, spatially offset Raman spectroscopy" .

goldbook:08692 a skos:Concept ;
    skos:definition "Term used in at least two senses in vibrational spectroscopy. In general usage, a symmetric molecule is a molecule with high symmetry. In more specific usage, a property is symmetric with respect to a symmetry element if it remains unchanged by the action of the corresponding symmetry operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetric" .

goldbook:08693 a skos:Concept ;
    skos:definition "Molecule that has two equal principal moments of inertia with the third one different." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetric top" .

goldbook:08694 a skos:Concept ;
    skos:definition "Each \\(S_{i}\\) is a linear combination of general coordinates, usually internal coordinates, constructed to take advantage of the molecular symmetry. The \\(S_{i}\\) are elements of the vector \\(\\boldsymbol{S}\\). They have the same units as the general coordinates from which they were constructed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetry coordinate" .

goldbook:08695 a skos:Concept ;
    skos:definition "Space group that does not contain screw-axes and glide planes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmorphic space group" .

goldbook:08696 a skos:Concept ;
    skos:altLabel "thermal wave decay length" ;
    skos:definition "In photoacoustic spectroscopy, \\(L = \\sqrt{(D/\\pi f)}\\), where \\(D\\) is thermal diffusivity and \\(f\\) is modulation frequency of the electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal diffusion depth" .

goldbook:08697 a skos:Concept ;
    skos:definition "Thermal conductivity divided by the product of the specific heat and the density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal diffusivity" .

goldbook:08698 a skos:Concept ;
    skos:definition "Reciprocal of the thermal diffusion depth (\\(L\\)). \\(a_{\\rm{s}} = 1/L\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal wave decay coefficient" .

goldbook:08699 a skos:Concept ;
    skos:altLabel "TERS" ;
    skos:definition "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to give complementary maps of a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tip-enhanced Raman spectroscopy" .

goldbook:08700 a skos:Concept ;
    skos:definition "Internal reflection from a non-absorbing material at angles of incidence at or above the critical angle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total internal reflection" .

goldbook:08701 a skos:Concept ;
    skos:definition "Spectral intensity of a transflected beam divided by spectral intensity of the incident beam in a transflection experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transflectance" .

goldbook:08702 a skos:Concept ;
    skos:definition "Reflection absorption at near-normal incidence when the thickness of the absorbing medium is large enough to yield an interpretable spectrum. The substrate is usually a mirror for mid-infrared measurements and a ceramic disk for near-infrared measurements. The angle of incidence is typically between \\(\\pu{0\\!^{\\circ}}\\) and \\(\\pu{45\\!^{\\circ}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transflection" .

goldbook:08703 a skos:Concept ;
    skos:altLabel "TRS" ;
    skos:definition "Measurement method of Raman spectroscopy in which the sample is illuminated on one side and the Raman signal is collected from the opposite side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission Raman spectroscopy" .

goldbook:08704 a skos:Concept ;
    skos:altLabel "VCD" ;
    skos:definition "Circular dichroism, \\(k^{\\rm{L}} – k^{\\rm{R}}\\), for vibrational transitions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational circular dichroism" .

goldbook:08705 a skos:Concept ;
    skos:definition "Part of the solution of the matrix equation of normal coordinate analysis, \\(\\boldsymbol{G\\!F\\!L} = \\boldsymbol{L \\lambda}\\). Each element \\(L_{ik}\\) of \\(\\boldsymbol{L}\\) is a vibrational eigenvector, and gives the change in internal coordinate \\(R_{i}\\) during unit change in the normal coordinate \\(Q_{k}\\), as shown in matrix form by \\(\\boldsymbol{R} = \\boldsymbol{LQ}\\), i.e., \\(L_{ik} = \\partial R_{i}/\\partial Q_{k}\\). Eigenvectors are sometimes expressed in terms of symmetry coordinates or Cartesian coordinates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational eigenvector" .

goldbook:08706 a skos:Concept ;
    skos:definition "Kinetic energy of the molecule as a function of the displacements of the atoms from equilibrium positions. For Cartesian displacement coordinates (\\(x, y, z\\)), \\[T = \\sum_{\\alpha}&frac12;m_{\\alpha}(\\dot x_{\\alpha}^{2} + \\dot y_{\\alpha}^{2} + \\dot z_{\\alpha}^{2})\\] where the sum is over all atoms and \\(\\dot{x}_{\\alpha}\\), etc., are the displacement velocities. For internal coordinates \\[T = &frac12;\\boldsymbol{P}^{t}\\boldsymbol{GP} = &frac12;\\dot{\\boldsymbol{R}}^{t}{\\boldsymbol{G}}^{-1}\\dot {\\boldsymbol{R}} = &frac12;\\sum_{ij}G_{ij}^{-1}\\dot R_{i}\\dot R_{j}\\] where \\(\\dot {\\boldsymbol{R}}^{t}\\) and \\(\\dot {\\boldsymbol{R}}\\) are the row and column vector, respectively, of the \\(\\partial R_{i}/\\partial t\\), \\(\\boldsymbol{P}^{t}\\) and \\(\\boldsymbol{P}\\) are the row and column vector, respectively, of the momenta conjugate to the \\(R_{i}\\), \\(\\boldsymbol{G}^{-1}\\) is the inverse of the \\(\\boldsymbol{G}\\) matrix and \\(G_{ij}^{-1}\\) is the \\(ij^{\\rm{th}}\\) element of \\(\\boldsymbol{G}^{-1}\\). The elements of the \\(\\boldsymbol{G}\\) matrix are defined by \\[G_{ij} = \\sum_{\\alpha} \\frac{1}{m_{\\alpha}} B_{i\\alpha} B_{j\\alpha}\\] where \\(B_{i\\alpha}\\) and \\(B_{j\\alpha}\\) relate the \\(i^{\\rm{th}}\\) and \\(j^{\\rm{th}}\\) internal coordinate to the \\(\\alpha^{\\rm{th}}\\) Cartesian coordinate through the equation \\(\\boldsymbol{R} = \\boldsymbol{BX}\\) in which \\(\\boldsymbol{X}\\) is the column vector of the Cartesian coordinates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational kinetic energy" .

goldbook:08707 a skos:Concept ;
    skos:definition "Potential energy of the molecule as a function of the displacements of the atoms from equilibrium positions. The harmonic terms are quadratic in the displacements and the anharmonic terms are of cubic, quartic and higher orders in the displacements. \\(Q\\) are normal coordinates \\[2V = \\sum\\limits_{k}\\lambda_{k}Q_{k}^{2} + \\sum\\limits_{ijk}k_{ijk}Q_{i}Q_{j}Q_{k} + higher\\,order\\,terms\\] In terms of internal coordinates, \\[2V = \\sum\\limits_{i} F_{ii} R_i^{2} + \\sum\\limits_{i,j e i} F_{ij} R_{i} R_{j} + \\sum\\limits_{i,j,k} F_{ijk} R_{i} R_{j} R_{k} + higher\\,order\\,terms\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational potential energy" .

goldbook:08708 a skos:Concept ;
    skos:definition "Measurement principle of spectroscopy to analyse molecular properties based on vibrations (bond stretching or deformation modes) in chemical species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational spectroscopy" .

goldbook:08709 a skos:Concept ;
    skos:definition "Vibrational energy, \\(E\\), expressed in wavenumber units. \\(G = E/(hc)\\), where \\(h\\) is the Planck constant and \\(c\\) is the speed of light in vacuum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational term value" .

goldbook:08710 a skos:Concept ;
    skos:altLabel "Kubelka–Munk reflection" ;
    skos:definition "Re-emergence of electromagnetic radiation from the surface of incidence after penetrating into a powdered sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume reflection" .

goldbook:08711 a skos:Concept ;
    skos:definition "Number of particles or photons counted by a radiation detector divided by the number emitted by a radiation source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute counting efficiency" .

goldbook:08712 a skos:Concept ;
    skos:altLabel "AMS" ;
    skos:definition "Mass spectrometry technique in which atoms and molecules from a sample are ionized, accelerated to mega-electron volt (\\(\\pu{1 MeV} = \\pu{1.602176634E-13 J}\\)) energies, and separated according to their momentum, charge, and energy, allowing high discrimination for the measurement of nuclide abundances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accelerator mass spectrometry" .

goldbook:08713 a skos:Concept ;
    skos:definition "Graph of the activity of a radioactive nuclide as a function of time and showing the increase of activity through the decay of the precursor or as a result of activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activity growth curve" .

goldbook:08714 a skos:Concept ;
    skos:definition "Measurement principle in which the backscattering of nuclear radiation impinging on a sample is applied to measure the structure and composition of materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattering analysis" .

goldbook:08716 a skos:Concept ;
    skos:altLabel "<em>k</em><sub>0</sub> method of calibration" ;
    skos:definition "Calibration method of neutron activation analysis in which the \\(k_{0}\\) proportionality factors, together with a value of the neutron flux (as a function of the neutron energy) and with a value of the radiation detector's response for gamma radiation (as a function of the gamma-ray energy) are used for establishing a relationship between the number of counts measured and the corresponding amounts of elements in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration, k0 method" .

goldbook:08717 a skos:Concept ;
    skos:altLabel "comparator (obsolete)" ;
    skos:definition "Measured amount of an element with stated measurement uncertainty that is simultaneously irradiated with the sample during activation analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibrator" .

goldbook:08718 a skos:Concept ;
    skos:definition "Range- (traveling distance) increasing effect caused by the decrease in interaction cross sections of the incident particles with atoms in a single crystal when a highly collimated particle beam impinges on a crystal along its principal axis or principal plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "channeling effect" .

goldbook:08719 a skos:Concept ;
    skos:definition "Measurement method to obtain a quenching correction by counting the spectrum in two separate channels, the ratio of which gives the degree of quenching." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "channels ratio method" .

goldbook:08720 a skos:Concept ;
    skos:definition "Measurement principle in which wavelengths and angular distribution of Compton scattered electrons is applied in order to reconstruct X-ray and gamma-ray spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Compton scattering analysis" .

goldbook:08721 a skos:Concept ;
    skos:definition "Ability of substances other than the analyte to bind to the binding reagent and ability of substances other than the binding reagent to bind the analyte in competitive binding assays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross reactivity" .

goldbook:08722 a skos:Concept ;
    skos:altLabel "microscopic cross section" ;
    skos:definition "Characteristic area related to the probability of a specified interaction or reaction between an incident nuclear radiation and a target particle or system of particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross section" .

goldbook:08723 a skos:Concept ;
    skos:altLabel "DNAA",
        "delayed-neutron analysis (DNA)",
        "delayed-neutron counting (DNC)" ;
    skos:definition "Neutron activation analysis where neutrons are counted after a delay to allow interfering species to decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed-neutron activation analysis" .

goldbook:08724 a skos:Concept ;
    skos:definition "Beam of particles capable of removing one or more orbital electrons in a single quantum event from a specified atom resulting in an ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "directly-ionizing radiation" .

goldbook:08725 a skos:Concept ;
    skos:definition "Measurement method to obtain a quenching correction through the use of a gamma-radiation source to generate a spectrum of Compton electrons within the sample vial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external standardization for quenching correction" .

goldbook:08726 a skos:Concept ;
    skos:definition "Radiation detector to measure energy flux density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flux monitor" .

goldbook:08727 a skos:Concept ;
    skos:definition "Change of energy flux density or energy distribution of particles or photons in an object as a result of effects such as flux depression and/or self-shielding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flux perturbation" .

goldbook:08728 a skos:Concept ;
    skos:altLabel "gamma-ray spectroscopy (obsolete)" ;
    skos:definition "Measurement principle of the quantitative study of the energy spectra of gamma-ray sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gamma-ray spectrometry" .

goldbook:08729 a skos:Concept ;
    skos:altLabel "half thickness",
        "half-value layer thickness" ;
    skos:definition "Thickness of a specified material that, when introduced into the path of a given beam of radiation, reduces the intensity of a specified radiation by one half." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-value thickness" .

goldbook:08730 a skos:Concept ;
    skos:definition "Beam of electrically neutral particles that cause ionization by interacting with atoms in a material, producing electrically-charged particles that subsequently cause direct ionization in the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirectly-ionizing radiation" .

goldbook:08731 a skos:Concept ;
    skos:definition "Measurement method of neutron activation analysis in which a living organism is exposed to neutrons to measure the concentrations of elements in that living organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>in-vivo</em> neutron activation analysis" .

goldbook:08732 a skos:Concept ;
    skos:altLabel "IBA" ;
    skos:definition "Measurement principle in which elementary particles resulting from nuclear reactions of charged particles with nuclei in a material are applied in order to measure the amount and depth distribution of elements in materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion beam analysis" .

goldbook:08733 a skos:Concept ;
    skos:definition "Radioactive or stable isotope of a specified element distinguishable by the observer but not by the system used to identify an isotopic tracer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic label" .

goldbook:08735 a skos:Concept ;
    skos:definition "Chemical element having only one stable nuclide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monoisotopic element" .

goldbook:08736 a skos:Concept ;
    skos:definition "Measurement method in which recoil-less resonance gamma ray scattering and absorption in solids is applied to measure the nuclear environment of atoms of elements in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mössbauer spectrometry" .

goldbook:08737 a skos:Concept ;
    skos:definition "Measurement method of X-ray analysis in which characteristic X-radiation emitted upon irradiation of a material with a beam of muons of certain energy is used to measure the chemical composition and chemical state of an element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "muon induced X-ray emission analysis" .

goldbook:08738 a skos:Concept ;
    skos:altLabel "NEXAFS" ;
    skos:definition "Measurement method of X-ray absorption analysis similar to X-ray absorption near edge structure, but usually reserved for soft X-rays with photon energy less than \\(\\pu{1 keV}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "near edge X-ray absorption fine structure" .

goldbook:08739 a skos:Concept ;
    skos:altLabel "NAA" ;
    skos:definition "Activation analysis using neutrons as the incident particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron activation analysis" .

goldbook:08740 a skos:Concept ;
    skos:altLabel "NDP" ;
    skos:definition "Measurement method of activation analysis for near-surface-depth light elements in which a thermal neutron or cold neutron (see: neutron energy) beam passes through a material with target nuclei that emit monoenergetic charged particles upon neutron absorption. The reduction of the energy of an emitted charged particle measures the depth of the target nuclei in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron depth profiling" .

goldbook:08741 a skos:Concept ;
    skos:definition "Measurement method in which the diffraction of neutrons is applied to measure parameters of the atomic and/or magnetic structure of a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron diffraction analysis" .

goldbook:08742 a skos:Concept ;
    skos:definition "Kinetic energy of a free neutron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron energy" .

goldbook:08743 a skos:Concept ;
    skos:definition "Measurement method in which the elastic or inelastic scattering of neutrons by the target nuclei is applied to study the composition and structure of a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron scattering analysis" .

goldbook:08744 a skos:Concept ;
    skos:definition "Deactivation of an electronically-excited state by interaction with the external environment through a non-radiative process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-radiative quenching" .

goldbook:08745 a skos:Concept ;
    skos:altLabel "capture" ;
    skos:definition "Process in which an atomic nucleus acquires an additional particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear capture" .

goldbook:08746 a skos:Concept ;
    skos:definition "Radionuclide which precedes a nuclide in a decay chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclide precursor" .

goldbook:08747 a skos:Concept ;
    skos:altLabel "fluence rate (obsolete)",
        "photon flux density" ;
    skos:definition "Number of particles (or photons) incident on a plane perpendicular to the incident radiation per unit time per unit area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle flux density" .

goldbook:08748 a skos:Concept ;
    skos:altLabel "PIGE" ;
    skos:definition "Measurement principle in which the energies and intensities of characteristic prompt gamma-radiation emitted during nuclear reactions with charged particles other than electrons is used to measure the amounts of elements in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle-induced gamma-ray-emission analysis" .

goldbook:08749 a skos:Concept ;
    skos:altLabel "PAC",
        "perturbed directional correlation spectrometry" ;
    skos:definition "Measurement method of gamma-ray spectrometry in which coincidence counting is used for the measurement of parameters describing hyperfine interactions, with internal or external electrical or magnetic field gradients, of the spin of an intermediate level between two gamma-ray transitions in cascade emitted in the decay of a radionuclide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perturbed angular correlation spectrometry" .

goldbook:08750 a skos:Concept ;
    skos:altLabel "PAA",
        "positron annihilation spectroscopy for chemical analysis (PASCA)" ;
    skos:definition "Measurement principle in which the annihilation of positrons is applied to study the microscopic structure of materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positron annihilation analysis" .

goldbook:08751 a skos:Concept ;
    skos:altLabel "PET" ;
    skos:definition "Imaging method based on the detection of pairs of gamma rays emitted indirectly by a positron-emitting isotopic tracer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positron emission tomography" .

goldbook:08752 a skos:Concept ;
    skos:altLabel "PLS",
        "positron annihilation lifetime spectrometry (PALS)" ;
    skos:definition "Measurement method of positron annihilation analysis in which the time interval between the emission of positrons from a radioactive source and the detection of gamma rays due to the annihilation of these positrons with electrons from the surrounding matter is the lifetime of the positron or positronium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positron lifetime spectrometry" .

goldbook:08753 a skos:Concept ;
    skos:definition "Gamma radiation emitted during the de-excitation of a compound nucleus formed in a nuclear capture reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prompt gamma radiation" .

goldbook:08754 a skos:Concept ;
    skos:altLabel "PGA" ;
    skos:definition "Measurement principle in which gamma radiation emitted during the de-excitation of the compound nucleus formed by neutron capture is applied to measure the amounts of elements in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prompt gamma-ray analysis" .

goldbook:08755 a skos:Concept ;
    skos:definition "Processing by a radiation counter of pulses resulting from the simultaneous absorption of independent particles or photons in a radiation detector, resulting in them being counted as one single particle or photon with energy between the individual energies and the sum of these energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse pile-up" .

goldbook:08757 a skos:Concept ;
    skos:definition "Material interposed in the path of radiation to modify the energy distribution of the radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation filter" .

goldbook:08758 a skos:Concept ;
    skos:altLabel "radioactive equilibrium",
        "secular equilibrium" ;
    skos:definition "Among the radionuclides of a decay chain, the state that prevails when the ratios between the activities of successive radionuclides remain constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive steady state" .

goldbook:08759 a skos:Concept ;
    skos:definition "Period of time after the dead time of a radiation counter during which the output pulses are smaller than the original." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recovery time" .

goldbook:08760 a skos:Concept ;
    skos:definition "Absolute counting efficiency of a given radiation counter divided by the absolute counting efficiency of a reference radiation counter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative counting efficiency" .

goldbook:08761 a skos:Concept ;
    skos:altLabel "SPM" ;
    skos:definition "Measurement method of X-ray fluorescence analysis in which protons are focused and collimated to form a micro beam to obtain an image of a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning proton microscopy" .

goldbook:08762 a skos:Concept ;
    skos:definition "An isotopically labelled compound is designated as selectively labelled when a mixture of isotopically substituted compounds is formally added to the analogous isotopically unmodified compound in such a way that the position(s), but not necessarily the number, of each labelling nuclide is defined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectively-labelled isotopic tracer" .

goldbook:08763 a skos:Concept ;
    skos:definition "Activity of a specified radionuclide (\\(\\ce{R}\\)) per unit mass of that nuclide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific activity (radionuclide)" .

goldbook:08764 a skos:Concept ;
    skos:definition "Measurement method of X-ray fluorescence analysis in which synchrotron X-radiation is used to irradiate the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synchrotron radiation induced X-ray fluorescence analysis" .

goldbook:08765 a skos:Concept ;
    skos:altLabel "TXRF" ;
    skos:definition "Measurement method of X-ray fluorescence analysis in which a collimated X-ray flux impinges on a smooth surface under a grazing angle; rendering total reflection is used to excite atoms in the top layers of the material for measurement of the amounts of elements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total reflection X-ray fluorescence analysis" .

goldbook:08766 a skos:Concept ;
    skos:altLabel "X-ray absorption spectroscopy (XAS)",
        "XAA" ;
    skos:definition "Measurement principle of X-ray analysis in which the absorption spectrum is used to measure the number of atoms, species, and other parameters of chemical elements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray absorption analysis" .

goldbook:08767 a skos:Concept ;
    skos:altLabel "absorption edge" ;
    skos:definition "Increase in X-ray absorption observed at the energy at which a strongly bound electron is released." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray absorption edge" .

goldbook:08768 a skos:Concept ;
    skos:altLabel "X-ray absorption near edge fine structure",
        "XANES" ;
    skos:definition "Measurement method of X-ray absorption analysis in which the fine structure of the adsorption spectrum in the range \\(\\pu{30 eV}\\) below to \\(\\pu{50 eV}\\) above the absorption edge is used to measure parameters describing the chemical state, coordination environment, and local geometry distortion for the X-ray absorbing atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray absorption near edge structure" .

goldbook:08769 a skos:Concept ;
    skos:definition "Measurement principle in which characteristic X-radiation, produced upon irradiation of a material with elementary particles or photons, is applied to measure amounts of elements in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray analysis" .

goldbook:08770 a skos:Concept ;
    skos:altLabel "X-ray micro-tomography (XMT)",
        "XCMT" ;
    skos:definition "Measurement method based on the transmission of X-rays to obtain three-dimensional images of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray computed micro-tomography" .

goldbook:08771 a skos:Concept ;
    skos:altLabel "X-ray diffraction (XRD)" ;
    skos:definition "Measurement method using diffraction of X-radiation to obtain the spatial arrangement of atoms in a crystalline sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray diffraction analysis" .

goldbook:08772 a skos:Concept ;
    skos:altLabel "XRM" ;
    skos:definition "Measurement method of X-ray fluorescence to obtain quantitative and spatial information about elements in a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray fluorescence microscopy" .

goldbook:08773 a skos:Concept ;
    skos:definition "Transducer that converts the energy supplied or taken from the surroundings into some mechanical motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "actuator" .

goldbook:08774 a skos:Concept ;
    skos:definition "Soliton with the negative amplitude or opposite spin with respect to a given soliton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antisoliton" .

goldbook:08775 a skos:Concept ;
    skos:definition "Particle or quasiparticle capable of transporting an electric charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier" .

goldbook:08776 a skos:Concept ;
    skos:altLabel "concentration of charge carriers" ;
    skos:definition "Number of charge carriers per unit volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier concentration" .

goldbook:08777 a skos:Concept ;
    skos:definition "Purely random, thermally induced motion of charge carriers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier diffusion" .

goldbook:08778 a skos:Concept ;
    skos:altLabel "charge generation" ;
    skos:definition "Process whereby charge carriers are created." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier generation" .

goldbook:08779 a skos:Concept ;
    skos:definition "Process whereby charge carriers in excess of the thermodynamic equilibrium level are introduced into a conductor, a semiconductor or an insulator from another material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier injection" .

goldbook:08780 a skos:Concept ;
    skos:altLabel "charge mobility" ;
    skos:definition "Drift velocity (\\(v_{\\rm{d}}\\)) of charge carriers divided by the electric field strength (\\(E\\)). \\[\\mu = v_{\\rm{d}}/E \\quad (\\rm{unit}{:}\\ \\pu{m2 V-1 s-1})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier mobility" .

goldbook:08781 a skos:Concept ;
    skos:altLabel "charge recombination" ;
    skos:definition "Process whereby an electron in the conduction band (in LUMO level) loses its excess energy and re-occupies the energy state of a hole in the valence band (in HOMO level)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge carrier recombination" .

goldbook:08782 a skos:Concept ;
    skos:altLabel "CT" ;
    skos:definition "Transfer of charge carriers between two sites of the same molecular entity (intramolecular CT) or between two molecular entities occurring in close proximity (intermolecular CT)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge transfer" .

goldbook:08783 a skos:Concept ;
    skos:definition "Exciton formed by a charge-transfer transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer exciton" .

goldbook:08784 a skos:Concept ;
    skos:definition "Material having the ability to transmit energy or charge carriers or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conductor" .

goldbook:08785 a skos:Concept ;
    skos:definition "A polymer composed of molecules whose backbone is a sequence of alternating single and multiple bonds:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen, alkyl, aryl or heteroaryl and Ar is arenediyl (formerly: arylene) or heteroarenediyl (formerly: heteroarylene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugated polymer" .

goldbook:08786 a skos:Concept ;
    skos:definition "Molecule or a part of a molecule, of which structure may be represented as a system of alternating single and multiple bonds, in which, eventually, a multiple bond can be replaced by an atom with a pair of non-bonding electrons or an atom carrying a negative charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π-conjugated system" .

goldbook:08787 a skos:Concept ;
    skos:definition "Distance between two oppositely charged charge carriers at which the energy of their Coulombic attraction is equal to \\(kT\\), where \\(k\\) is the Boltzmann constant and \\(T\\) the absolute temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coulomb radius" .

goldbook:08788 a skos:Concept ;
    skos:altLabel "dark conductivity" ;
    skos:definition "Electric conductivity of a material in the dark where the free charge-carrier photogeneration is excluded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dark electric conductivity" .

goldbook:08789 a skos:Concept ;
    skos:definition "Redistribution of electron density in a molecular entity as compared with a model assuming individual atoms in the same valence states connected by localized bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delocalization of electrons" .

goldbook:08790 a skos:Concept ;
    skos:altLabel "dielectric" ;
    skos:definition "Material which polarizes when exposed to an external electric field, because it creates its own internal electric field oriented against the external field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dielectric material" .

goldbook:08791 a skos:Concept ;
    skos:definition "Irregular charge transport in which charge carriers move with an ill-defined mean velocity owing to the high variety of dwell times spent at different transport sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersive transport" .

goldbook:08792 a skos:Concept ;
    skos:altLabel "double charge carrier injection" ;
    skos:definition "Simultaneous injection of both types of charge carriers (electrons and holes) into a material or a device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double injection" .

goldbook:08793 a skos:Concept ;
    skos:definition "Electric current caused by electric drift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drift current" .

goldbook:08794 a skos:Concept ;
    skos:definition "Average velocity that a charge carrier attains due to an applied electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drift velocity" .

goldbook:08795 a skos:Concept ;
    skos:definition "Dielectric material with a permanent or quasi-permanent electric dipole." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electret" .

goldbook:08796 a skos:Concept ;
    skos:definition "Material that is able to transmit electric current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric conductor" .

goldbook:08797 a skos:Concept ;
    skos:definition "Oriented flow of otherwise randomly moving charge carriers induced by an applied external electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric drift" .

goldbook:08798 a skos:Concept ;
    skos:altLabel "conducting polymer composite" ;
    skos:definition "Composite composed of a non-conducting polymer matrix in which irregular powdered or fibrous particles of an electrically conducting material are evenly dispersed in an amount exceeding the percolation threshold for electric conductivity and so the composite exhibits electric conductivity close to that of the conducting filler." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrically conducting polymer composite" .

goldbook:08799 a skos:Concept ;
    skos:definition "Polymer that exhibits electrochromism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochromic polymer" .

goldbook:08800 a skos:Concept ;
    skos:definition "Electroluminescence originated from singlet-state excitons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrofluorescence" .

goldbook:08801 a skos:Concept ;
    skos:definition "Process of charge carrier injection induced by an applied external electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroinjection" .

goldbook:08802 a skos:Concept ;
    skos:definition "Physical field composed of two interconnected, mutually orthogonal fields, an electric field and a magnetic field, which mediates interactions of charged, dipolar and multipolar objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromagnetic field" .

goldbook:08803 a skos:Concept ;
    skos:definition "Polymer showing a noticeable response of its physical or chemical properties during or upon exposure to an electromagnetic field or one of its components: electric field and magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromagnetic field responsive polymer" .

goldbook:08804 a skos:Concept ;
    skos:definition "Molecule that has fewer valence electrons than required for forming normal two-center two-electron chemical bonds and thus contains multicenter chemical bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-deficient molecule" .

goldbook:08805 a skos:Concept ;
    skos:definition "Molecule that has more valence electrons than is needed to link its atoms by single covalent bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-rich molecule" .

goldbook:08806 a skos:Concept ;
    skos:altLabel "electron quantum tunneling" ;
    skos:definition "Quantum mechanical effect of passing an electron through a potential energy barrier separating two energy equivalent regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron tunneling" .

goldbook:08807 a skos:Concept ;
    skos:definition "Change in the optical properties of a material in response to a change in an external electric field strength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-optic effect" .

goldbook:08808 a skos:Concept ;
    skos:definition "Electroluminescence originated from triplet-state excitons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophosphorescence" .

goldbook:08809 a skos:Concept ;
    skos:definition "Reversible change in the apparent viscosity of a liquid system such as suspension of polar or good polarizable microparticles in an oil, upon exposure of an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrorheological effect" .

goldbook:08810 a skos:Concept ;
    skos:altLabel "electronic band" ;
    skos:definition "Quasi-continuous range of discrete energy levels that an electron is either allowed (an occupied band) or forbidden (forbidden band or band gap) to occupy in a molecule or solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy band" .

goldbook:08811 a skos:Concept ;
    skos:altLabel "electronic band theory" ;
    skos:definition "Theory describing the electronic structure of a solid in terms of energy intervals, called energy bands that are allowed or forbidden for occupation by electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy band theory" .

goldbook:08812 a skos:Concept ;
    skos:altLabel "bandgap" ;
    skos:definition "Energy interval in a lattice where no electronic state exists." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy gap" .

goldbook:08813 a skos:Concept ;
    skos:definition "Interaction of two excitons resulting in their decay and radiative emission of the stored excitation energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton annihilation" .

goldbook:08814 a skos:Concept ;
    skos:definition "Random movement of an exciton from one molecular entity to another or from one part of a molecular entity or a lattice to another part of the same kind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton diffusion" .

goldbook:08815 a skos:Concept ;
    skos:definition "Fission of an exciton into independent, Coulombically unbound mobile charge carriers: an electron and a hole, or a negative and a positive polaron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton dissociation" .

goldbook:08816 a skos:Concept ;
    skos:altLabel "exciton mean pathway" ;
    skos:definition "Mean distance that an exciton travels from the site of its creation to the site where it radiatively or non-radiatively decays or dissociates into charge carriers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton mean free path" .

goldbook:08817 a skos:Concept ;
    skos:definition "Interaction in which a part of the exciton energy is converted into the lattice vibrational energy and vice versa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton–phonon coupling" .

goldbook:08818 a skos:Concept ;
    skos:altLabel "effective conjugation length" ;
    skos:definition "Magnitude of the region in a molecule over which a molecular orbital occupied with delocalized electrons is extended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extent of electron delocalization" .

goldbook:08819 a skos:Concept ;
    skos:definition "Quantum yield relating to the whole device or the overall process involved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external quantum yield" .

goldbook:08820 a skos:Concept ;
    skos:definition "Semiconductor whose electric properties are largely determined by the dopant 'impurities' present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrinsic semiconductor" .

goldbook:08821 a skos:Concept ;
    skos:altLabel "FET" ;
    skos:definition "Transistor in which the flow of charge carriers from source to drain is controlled by the potential applied to the gate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field-effect transistor" .

goldbook:08822 a skos:Concept ;
    skos:definition "Ratio of the real maximum output power, \\(P_{\\rm{max}}\\), that can be obtained with an actual solar cell to the product of the open-circuit potential, \\(V_{\\rm{oc}}\\), and short-circuit photocurrent, \\(I_{\\rm{sc}}\\): \\[f_{\\rm{FF}} = P_{\\rm{max}}/V_{\\rm{oc}}I_{\\rm{sc}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fill factor" .

goldbook:08823 a skos:Concept ;
    skos:altLabel "charge-carrier photogeneration" ;
    skos:definition "Generation of free charge carriers by photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free charge-carrier photogeneration" .

goldbook:08824 a skos:Concept ;
    skos:altLabel "HT-isomerism",
        "regioisomerism" ;
    skos:definition "Constitutional isomerism of polymeric (oligomeric) chains composed of identical non symmetric repeating units consisting in different orientations of the units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "head-tail isomerism" .

goldbook:08825 a skos:Concept ;
    skos:definition "Interface between dissimilar crystalline or amorphous solid phases that have unequal bandgap levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterojunction" .

goldbook:08826 a skos:Concept ;
    skos:altLabel "electron hole" ;
    skos:definition "Quasiparticle, a conceptual charge carrier opposite to electron, defined as the absence of electron at a position where it should be present if a lattice is in its ground state (valence band normally filled)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hole" .

goldbook:08827 a skos:Concept ;
    skos:definition "Material, typically a semiconductor, in which holes are predominant mobile charge carriers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hole-transporting material" .

goldbook:08828 a skos:Concept ;
    skos:altLabel "pn-junction" ;
    skos:definition "Interface occurring between two similar semiconductors with equal bandgaps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homojunction" .

goldbook:08829 a skos:Concept ;
    skos:definition "Incoherent transport of charge carriers by hopping between adjacent energetically nearly equivalent localized sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hopping transport" .

goldbook:08830 a skos:Concept ;
    skos:definition "Electron that is out of the thermal equilibrium with its environment and has enough kinetic energy to overcome potential barriers to travel between different regions of a molecule or lattice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hot electron" .

goldbook:08831 a skos:Concept ;
    skos:definition "Charge carrier generation by another charge carrier possessing a high kinetic energy, which knocks an electron out of the HOMO into the LUMO or still higher state so creating a new electron-hole pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impact ionization" .

goldbook:08832 a skos:Concept ;
    skos:definition "Quantum yield relating to a single component or a part of a device or a partial step of an overall process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal quantum yield" .

goldbook:08833 a skos:Concept ;
    skos:definition "Semiconductor in which mobile charge carriers are generated solely by thermal excitation of electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic semiconductor" .

goldbook:08834 a skos:Concept ;
    skos:definition "Conducting polymer in which ionic species are mobile charge carriers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-conducting polymer" .

goldbook:08835 a skos:Concept ;
    skos:definition "Periodic grid-like ideal structure consisting of regularly arranged elementary repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lattice" .

goldbook:08836 a skos:Concept ;
    skos:altLabel "LED" ;
    skos:definition "Transducer-type device that converts an electric current into luminescence light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light emitting diode" .

goldbook:08837 a skos:Concept ;
    skos:altLabel "LUMO" ;
    skos:definition "Lowest-energy molecular orbital that is unoccupied in the ground state but occupied by one or more electrons if the molecular entity occurs in its first electronically excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lowest unoccupied molecular orbital" .

goldbook:08838 a skos:Concept ;
    skos:altLabel "luminescent polymer" ;
    skos:definition "Material (polymer) that exhibits a luminescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminescent material" .

goldbook:08839 a skos:Concept ;
    skos:definition "Change in the electric resistance of a material in response to an external magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetoresistance" .

goldbook:08840 a skos:Concept ;
    skos:altLabel "memristive system" ;
    skos:definition "Electric component that can be reversibly switched between stable low- and high-resistive states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "memristor" .

goldbook:08841 a skos:Concept ;
    skos:altLabel "MO theory" ;
    skos:definition "Theory of quantum mechanics in which electrons in a molecule (lattice) are not assigned to particular bonds between atoms but move under the influence of all atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular orbital theory" .

goldbook:08842 a skos:Concept ;
    skos:definition "Molecule that can be reversibly switched between two or more stable states in response to a change in, e.g., its microenvironment (pH, the presence of a ligand, temperature etc.), illumination or electric current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular switch" .

goldbook:08843 a skos:Concept ;
    skos:definition "Energy band occupied by electrons, typically the valence band." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupied band" .

goldbook:08844 a skos:Concept ;
    skos:definition "Electric junction which exhibits linear and symmetric current-potential dependence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ohmic contact" .

goldbook:08845 a skos:Concept ;
    skos:definition "Polymer that exhibits a nonlinear optical effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optically nonlinear polymer" .

goldbook:08846 a skos:Concept ;
    skos:definition "Branch of physics that deals with the optical-to-electric and electric-to-optical transducers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optoelectronics" .

goldbook:08847 a skos:Concept ;
    skos:definition "Formation of the long-range (infinite) functional connectivity in a disperse system composed of small active particles evenly dispersed in an inactive matrix, which makes the system penetrable for a fluid or current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percolation" .

goldbook:08848 a skos:Concept ;
    skos:definition "Minimal volume fraction of functionally active small particles evenly dispersed in a non-active matrix, at which the long-range (infinite) functional connectivity in the system is achieved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percolation threshold" .

goldbook:08849 a skos:Concept ;
    skos:definition "Polymer exhibiting photochromism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochromic polymer" .

goldbook:08850 a skos:Concept ;
    skos:definition "Polymer exhibiting electrical conductivity or a clear increase in electrical conductivity under irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoconducting polymer" .

goldbook:08851 a skos:Concept ;
    skos:definition "Removal of charge carriers from traps in the bandgap by irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodetrapping" .

goldbook:08852 a skos:Concept ;
    skos:definition "Discharging of an electrically charged material by irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoinduced discharge" .

goldbook:08853 a skos:Concept ;
    skos:definition "Charge carrier injection by a process induced by irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoinjection" .

goldbook:08854 a skos:Concept ;
    skos:definition "Optically nonlinear polymer that changes refractive index when exposed to light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photorefractive polymer" .

goldbook:08855 a skos:Concept ;
    skos:definition "Phenomenon consisting in converting light to electricity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photovoltaic effect" .

goldbook:08856 a skos:Concept ;
    skos:altLabel "dielectric polarization" ;
    skos:definition "Change in electric dipole moment per unit volume of dielectric material in response to its exposure to an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarization density" .

goldbook:08857 a skos:Concept ;
    skos:definition "Orientation of dipoles or dipolar domains inside a material by using a sufficiently strong electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poling" .

goldbook:08858 a skos:Concept ;
    skos:definition "Increase in the electric conductivity of a semiconductor or insulator by exposing it to an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Poole–Frenkel effect" .

goldbook:08859 a skos:Concept ;
    skos:altLabel "hydronic conductivity" ;
    skos:definition "Ionic conductivity mediated by protons (more exactly by hydrogen cations properly called hydrons)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protonic conductivity" .

goldbook:08860 a skos:Concept ;
    skos:altLabel "hydron doping" ;
    skos:definition "Transformation of a semiconducting or insulating material to conducting state by protonation (hydronation) of its molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton doping" .

goldbook:08861 a skos:Concept ;
    skos:altLabel "quantum size effect" ;
    skos:definition "Effect occurring if at least one dimension of a structure is comparable to the de Broglie wavelength of the electron-hole pair and the motion of charge carriers is thus quantized by the structure boundary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum confinement effect" .

goldbook:08862 a skos:Concept ;
    skos:definition "Electrically conducting polymer composite that, however, is conducting only when pressed due to thinning the insulating polymer matrix membranes so much that they allow electron tunneling through them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum tunneling polymer composite" .

goldbook:08863 a skos:Concept ;
    skos:definition "Discrete disorder in a multi-particulate system that exhibits particle-specific behavior and properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasiparticle" .

goldbook:08864 a skos:Concept ;
    skos:altLabel "radiative recombination" ;
    skos:definition "Charge carrier recombination in which the energy released is emitted as a photon of corresponding energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative charge carrier recombination" .

goldbook:08865 a skos:Concept ;
    skos:definition "Doping of a parent polymer consisting in oxidation or reduction of its molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redox doping" .

goldbook:08866 a skos:Concept ;
    skos:definition "Regular polymer or an irregular polymer whose macromolecules contain non-uniformly oriented simple asymmetric repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regioirregular polymer" .

goldbook:08867 a skos:Concept ;
    skos:definition "Regioirregular polymer with randomly oriented asymmetric constitutional repeating units in its chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regiorandom polymer" .

goldbook:08868 a skos:Concept ;
    skos:definition "Regular polymer whose chains are composed of uniformly oriented asymmetric constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regioregular polymer" .

goldbook:08869 a skos:Concept ;
    skos:definition "Surface-conducting polymer composite obtained by crystallization of a low-molar-mass organic conductor on an insulating or semiconducting polymer support." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reticulate doped polymer" .

goldbook:08870 a skos:Concept ;
    skos:definition "Potential energy barrier at a semiconductor-metal junction with the current rectifying characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schottky barrier" .

goldbook:08871 a skos:Concept ;
    skos:altLabel "frequency doubling" ;
    skos:definition "Transformation of the input monochromatic radiation beam into a double frequency (half wavelength) beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "second harmonic generation" .

goldbook:08872 a skos:Concept ;
    skos:definition "Transducer-type device that responds to a specific property of its surroundings or to a coming stimulus by a visually readable change in its state or by generation of a signal that can be read by an observer or instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensor" .

goldbook:08873 a skos:Concept ;
    skos:definition "Photocurrent flowing through a short circuited solar cell (if the electric potential across the cell is zero)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "short circuit photocurrent" .

goldbook:08874 a skos:Concept ;
    skos:definition "Effect of size on properties of the material or device which incorporates it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "size effect" .

goldbook:08875 a skos:Concept ;
    skos:definition "Device that directly transduces electromagnetic radiation into electricity based on the photovoltaic effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solar cell" .

goldbook:08876 a skos:Concept ;
    skos:definition "Radiative charge carrier recombination induced by incident photons of appropriate wavelength, which synchronize emission of other photons as to their wavelength, phase, polarization and direction of travel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimulated radiative charge carrier recombination" .

goldbook:08877 a skos:Concept ;
    skos:definition "Charge carrier injection by a thermally activated processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal injection" .

goldbook:08878 a skos:Concept ;
    skos:altLabel "VB theory" ;
    skos:definition "Quantum mechanics theory of chemical bonding that treats electrons as being assigned to individual bonds between particular atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence bond theory" .

goldbook:08879 a skos:Concept ;
    skos:definition "Minimum thermodynamic work (energy) needed to remove an electron from a solid to a point in the vacuum nearby the solid surface.\\[\\mathit{\\Phi} = -e{\\mathit{\\Psi}} - \\mu\\]where \\(e\\) is the elementary charge (\\(-e\\) is charge of electron), \\(\\mathit{\\Psi}\\) is the electric potential nearby the surface and \\(\\mu\\) is the energy of Fermi level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "work function" .

goldbook:08880 a skos:Concept ;
    skos:definition "Polymers whose macromolecules are rich in fluorocarbon groups (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluoropolymers" .

goldbook:08881 a skos:Concept ;
    skos:altLabel "MSP" ;
    skos:definition "Dynamic polymeric entity whose macromolecules are composed of alternating simple or oligomeric molecules with two or more chelate end-groups (so-called unimers) and metal ions (so-called ion couplers) that are linked to chains by reversible coordination bonds (structure-based polymer class name):" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallo-supramolecular polymer" .

goldbook:08882 a skos:Concept ;
    skos:definition "Polymers prepared from acetylene (ethyne), a substituted acetylene, or both in admixture by a polymerization involving one or more triple bonds (source-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyacetylenes" .

goldbook:08883 a skos:Concept ;
    skos:definition "Polymers prepared exclusively from aniline, or substituted aniline, or both in admixture (source-based class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyanilines" .

goldbook:08884 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively arenediyl (formerly arylene) or heteroarenediyl (formerly heteroarylene) units in the backbone:  where Ar is a divalent arenediyl or heteroarenediyl group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyarylenes" .

goldbook:08885 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively alternating arenediyl or heterarenediyl (formerly arylene or heteroarylene, respectively) and ethynediyl (formerly ethynylene) constitutional repeating units in the backbone:  where Ar is a divalent arenediyl or heterarenediyl group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyarylenethynylenes" .

goldbook:08886 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively alternating arenediyl or heteroarenediyl (formerly arylene or heteroarylene, respectively) and ethene-1,2-diyl (formerly vinylene) or substituted vinylene constitutional repeating units in the backbone:  where Ar is a divalent arenediyl or heteroarenediyl group and \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen, or an alkyl, aryl or heteroaryl group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyarylenevinylenes" .

goldbook:08887 a skos:Concept ;
    skos:altLabel "poly (Schiff bases)" ;
    skos:definition "Polymers composed of macromolecules containing azomethine (azanylylidenemethanylylidene) linkages in the backbone: \\[\\ce{-N=CR-}\\] where \\(\\ce{R}\\) is hydrogen, or an alkyl or aryl group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyazomethines" .

goldbook:08888 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing benzimidazole groups in the backbone, such as groups (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polybenzimidazoles" .

goldbook:08889 a skos:Concept ;
    skos:definition "Polymer prepared from buta-1,3-diyne (diacetylene) or a substituted buta-1,3-diyne or both in admixture (source-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polydiacetylenes" .

goldbook:08890 a skos:Concept ;
    skos:altLabel "poly(acetylene) (source-based name)",
        "poly(vinylene) (former structure-based name)" ;
    skos:definition "Polymer composed of macromolecules exclusively consisting of ethene-1,2-diyl (formerly called vinylene) constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poly(ethene-1,2-diyl)" .

goldbook:08891 a skos:Concept ;
    skos:altLabel "PEDOT",
        "poly{3,4-[ethylene-1,2-bis(oxy)]thiophene-2,5-diyl}" ;
    skos:definition "Polymer prepared from 3,4-(ethylenedioxy)thiophene (source-based polymer name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poly[3,4-(ethylenedioxy)thiophene]" .

goldbook:08892 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing fluorenediyl or substituted fluorenediyl (mainly 2,7-diyl) constitutional repeating units in the backbone (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyfluorenes" .

goldbook:08893 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing cyclic dicarboximide groupings in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\) and \\(\\ce{R^{4}}\\) are groups with connectivity one, two, three, and four, respectively (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyimides" .

goldbook:08894 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively oxadiazole rings in the backbone (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyoxadiazoles" .

goldbook:08895 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively \\(\\upsigma\\)-bonded benzene or substituted benzene rings in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\) and \\(\\ce{R^{4}}\\) are each hydrogen or an univalent group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyphenylenes" .

goldbook:08896 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively alternating phenylene or substituted phenylene and ethynediyl (formerly ethynylene) constitutional repeating units in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\) and \\(\\ce{R^{4}}\\) are each hydrogen, alkyl, aryl, halogen, trialkylsilyl etc. (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyphenylenethynylenes" .

goldbook:08897 a skos:Concept ;
    skos:altLabel "PPV" ;
    skos:definition "Polymers composed of macromolecules containing exclusively alternating phenylene or substituted phenylene and ethene-1,2-diyl (formerly vinylene) or substituted ethene-1,2-diyl constitutional repeating units in the backbone:  where \\(\\ce{R^{1}}\\), \\(\\ce{R^{2}}\\), \\(\\ce{R^{3}}\\), \\(\\ce{R^{4}}\\), \\(\\ce{R^{5}}\\) and \\(\\ce{R^{6}}\\) are each hydrogen, alkyl, aryl, heteroaryl, halogen, trialkylsilyl, etc. (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyphenylenevinylenes" .

goldbook:08898 a skos:Concept ;
    skos:altLabel "Ppy" ;
    skos:definition "Polymers composed of macromolecules with backbones composed of pyrrole rings (structure-based polymer class name definition)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polypyrroles" .

goldbook:08899 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively silicon atoms in the backbone:  where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen or an alkyl, aryl or heteroaryl group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysilanes" .

goldbook:08900 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing tetrazine or hydrogenated tetrazine rings in the backbone (structure-based polymer class name):" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polytetrazines" .

goldbook:08901 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing thiadiazole rings in the backbone (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polythiadiazoles" .

goldbook:08902 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing thiazole rings in the backbone:  where R is hydrogen, alkyl, aryl, heteroaryl, substituted alkyl, substituted aryl or substituted heteroaryl (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polythiazoles" .

goldbook:08903 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively thiophene rings in the backbone (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polythiophenes" .

goldbook:08904 a skos:Concept ;
    skos:definition "Polymers prepared from a vinylcarbazole or a substituted vinylcarbazole or both in admixture (source-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinylcarbazoles" .

goldbook:08905 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing exclusively ethene-1,2-diyl (formerly vinylene) or substituted ethene-1,2-diyl constitutional repeating units in the backbone: \\[\\ce{-CR^{1}=CR^{2}-}\\] where \\(\\ce{R^{1}}\\) and \\(\\ce{R^{2}}\\) are each hydrogen or an alkyl, aryl, or heteroaryl group (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinylenes" .

goldbook:08906 a skos:Concept ;
    skos:altLabel "poly(inner salts)",
        "polyamphions",
        "zwitterionic polymers" ;
    skos:definition "Polymers composed of macromolecules consisting of zwitterionic repeating units (structure-based polymer class name)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyzwitterions" .

goldbook:08907 a skos:Concept ;
    skos:altLabel "AMP" ;
    skos:definition "Chain polymerization in which propagation involves reaction between a growing-chain end and an activated monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated-monomer polymerization" .

goldbook:08908 a skos:Concept ;
    skos:definition "Term indicating control of a certain kinetic feature of a polymerization or structural aspect of the polymer molecules formed, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled polymerization" .

goldbook:08909 a skos:Concept ;
    skos:altLabel "DTP",
        "degenerate-transfer polymerization" ;
    skos:definition "Reversible-deactivation polymerization in which the deactivation of the active species involves degenerative chain transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerative-transfer polymerization" .

goldbook:08910 a skos:Concept ;
    skos:altLabel "GTP" ;
    skos:definition "Chain polymerization in which a specific atom or group is intramolecularly transferred to remain associated with the active chain-end during the course of polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "group-transfer polymerization" .

goldbook:08911 a skos:Concept ;
    skos:altLabel "polyinsertion" ;
    skos:definition "Chain polymerization in which monomer units are sequentially inserted into a specific site within a polymer structure with retention of chain-end functionality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insertion polymerization" .

goldbook:08912 a skos:Concept ;
    skos:altLabel "RDP",
        "controlled reversible-deactivation polymerization." ;
    skos:definition "Chain polymerization, propagated by chain carriers that are deactivated reversibly, bringing them into active-dormant equilibria of which there might be more than one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-deactivation polymerization" .

goldbook:08913 a skos:Concept ;
    skos:altLabel "CRP" ;
    skos:definition "Term indicating control of a certain kinetic feature of a radical polymerization or structural aspect of the polymer molecules formed by radical polymerization, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled radical polymerization" .

goldbook:08914 a skos:Concept ;
    skos:definition "Radical polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living radical polymerization" .

goldbook:08915 a skos:Concept ;
    skos:definition "Radical polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical ring-opening polymerization" .

goldbook:08916 a skos:Concept ;
    skos:altLabel "RDRP",
        "controlled reversible-deactivation radical polymerization" ;
    skos:definition "Chain polymerization, propagated by radicals that are deactivated reversibly, bringing them into active-dormant equilibria of which there might be more than one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-deactivation radical polymerization" .

goldbook:08917 a skos:Concept ;
    skos:altLabel "AMRP",
        "aminoxyl-mediated polymerization" ;
    skos:definition "Stable-radical-mediated polymerization in which the deactivation of the radicals involves reversible coupling with aminoxyl radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminoxyl-mediated radical polymerization" .

goldbook:08918 a skos:Concept ;
    skos:altLabel "CMRP" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by a cobalt complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cobalt-mediated radical polymerization" .

goldbook:08919 a skos:Concept ;
    skos:definition "Stable-radical-mediated polymerization where the initiator and dormant species are iniferters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iniferter process" .

goldbook:08920 a skos:Concept ;
    skos:altLabel "OMRP" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by an organometallic reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organometallic-mediated radical polymerization" .

goldbook:08921 a skos:Concept ;
    skos:altLabel "SRMP" ;
    skos:definition "Reversible-deactivation radical polymerization in which the deactivation involves reversible coupling with stable (persistent) radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable-radical-mediated polymerization" .

goldbook:08922 a skos:Concept ;
    skos:altLabel "RAFRP" ;
    skos:definition "Reversible-deactivation radical polymerization in which the dormant species is a stable (persistent) radical and the deactivation step involves reversible fragmentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-addition-fragmentation radical polymerization" .

goldbook:08923 a skos:Concept ;
    skos:definition "Reversible-addition-fragmentation radical polymerization mediated by a carbonothioyl compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonothioyl-mediated radical polymerization" .

goldbook:08924 a skos:Concept ;
    skos:altLabel "ATRP" ;
    skos:definition "Reversible-deactivation radical polymerization in which the deactivation of the radicals involves reversible atom-transfer or reversible group transfer to usually, though not exclusively, transition-metal complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atom-transfer radical polymerization" .

goldbook:08925 a skos:Concept ;
    skos:altLabel "ISET-ATRP" ;
    skos:definition "Atom-transfer radical polymerization where the activation step involves direct atom or group transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inner-sphere electron transfer atom-transfer radical polymerization" .

goldbook:08926 a skos:Concept ;
    skos:altLabel "NM-ATRP" ;
    skos:definition "Atom-transfer radical polymerization in which the deactivation of the radicals involves reversible atom transfer or reversible group transfer to a non-metallic reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-metal-mediated atom-transfer radical polymerization" .

goldbook:08927 a skos:Concept ;
    skos:altLabel "OSET-ATRP",
        "single-electron-transfer RDRP (SET-RDRP)" ;
    skos:definition "Atom-transfer radical polymerization where the activation step involves consecutive single electron transfer and atom or group transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "outer-sphere electron transfer ATRP" .

goldbook:08928 a skos:Concept ;
    skos:altLabel "transition-metal-mediated reversible-deactivation radical polymerization" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by transition-metal complexes or organometallic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition-metal-mediated radical polymerization" .

goldbook:08929 a skos:Concept ;
    skos:altLabel "DTRP",
        "degenerate chain-transfer radical polymerization" ;
    skos:definition "Reversible-deactivation radical polymerization in which the deactivation of the radicals involves degenerative transfer (DT) of a group (or atom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerative chain-transfer radical polymerization" .

goldbook:08930 a skos:Concept ;
    skos:altLabel "ITP" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by an iodo-compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iodine-transfer polymerization" .

goldbook:08931 a skos:Concept ;
    skos:altLabel "BIRP" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by an organobismuthane compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organobismuthane-mediated radical polymerization" .

goldbook:08932 a skos:Concept ;
    skos:altLabel "SBRP" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by an organostibane compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organostibane-mediated radical polymerization" .

goldbook:08933 a skos:Concept ;
    skos:altLabel "TERP" ;
    skos:definition "Reversible-deactivation radical polymerization mediated by an organotellurium compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organotellurium-mediated radical polymerization" .

goldbook:08934 a skos:Concept ;
    skos:altLabel "RITP" ;
    skos:definition "Iodine-transfer polymerization where the initial polymerization mixture comprises a conventional initiator (e.g., an azo-compound or a peroxide) and molecular iodine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse iodine-transfer polymerization" .

goldbook:08935 a skos:Concept ;
    skos:altLabel "RAFT",
        "RAFT polymerization" ;
    skos:definition "Degenerate-transfer radical polymerization in which chain activation and chain deactivation involve a degenerative chain-transfer process, which occurs by a two-step addition-fragmentation mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-addition-fragmentation chain-transfer polymerization" .

goldbook:08936 a skos:Concept ;
    skos:definition "Reactive species generated reversibly from a monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated monomer" .

goldbook:08937 a skos:Concept ;
    skos:definition "Chain-transfer process that proceeds by a propagating species adding to a chain-transfer agent to form an intermediate that then fragments to provide an initiating species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "addition-fragmentation chain transfer" .

goldbook:08938 a skos:Concept ;
    skos:altLabel "initiator (in coordination polymerization)",
        "precatalyst (in coordination polymerization)" ;
    skos:definition "Coordination compound that by reaction with an activator or cocatalyst provides an active catalyst during initialization of coordination polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst precursor" .

goldbook:08939 a skos:Concept ;
    skos:altLabel "CCT" ;
    skos:definition "Chain-transfer process involving transfer of an atom or group to a reagent (the catalyst) that in turn transfers that group to a monomer to reinitiate polymerization and regenerate the original reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic chain transfer" .

goldbook:08940 a skos:Concept ;
    skos:definition "Chain termination process involving transfer of a group to a reagent (the catalyst) that in turn transfers that group to a propagating species to terminate a chain and regenerate the original reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic chain termination" .

goldbook:08941 a skos:Concept ;
    skos:altLabel "activation (in SRMP)",
        "unimolecular activation",
        "unimolecular chain activation" ;
    skos:definition "Unimolecular dissociation of a dormant species to form a mediating agent and a propagating species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain activation" .

goldbook:08942 a skos:Concept ;
    skos:altLabel "activation (in ATRP)",
        "bimolecular activation",
        "bimolecular chain activation" ;
    skos:definition "Reaction of an activator with a dormant species to form a deactivator and a propagating species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain activation" .

goldbook:08943 a skos:Concept ;
    skos:altLabel "deactivation" ;
    skos:definition "Conversion of a chain carrier into an inactive species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain deactivation" .

goldbook:08944 a skos:Concept ;
    skos:altLabel "propagation" ;
    skos:definition "Chemical reaction between a chain carrier and a monomer that results in the growth of a polymer chain and the regeneration of at least one chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain propagation" .

goldbook:08945 a skos:Concept ;
    skos:altLabel "activation (in a chain polymerization)",
        "reactivation" ;
    skos:definition "Conversion of an inactive chain into a chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain reactivation" .

goldbook:08946 a skos:Concept ;
    skos:altLabel "irreversible chain deactivation",
        "termination" ;
    skos:definition "Chemical reaction in which a chain carrier is converted irreversibly into a non-propagating species without the formation of a new chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain termination" .

goldbook:08947 a skos:Concept ;
    skos:altLabel "CTA",
        "transfer agent" ;
    skos:definition "Substance able to react with a chain carrier by a reaction in which the original chain carrier is deactivated and a new chain carrier is generated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-transfer agent" .

goldbook:08948 a skos:Concept ;
    skos:definition "Chain termination, in a chain polymerization, between two propagating macromolecules that gives rise to a single macromolecule of molar mass equal to the sum of the molar masses of the two macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combination" .

goldbook:08949 a skos:Concept ;
    skos:definition "Reagent that reacts reversibly with the initiating species or propagating species to form an initiator or a dormant chain, respectively, and an activator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deactivator" .

goldbook:08950 a skos:Concept ;
    skos:altLabel "dead macromolecule (in RDP)" ;
    skos:definition "Polymer chain which plays no active role in the polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead polymer chain" .

goldbook:08951 a skos:Concept ;
    skos:altLabel "degenerate chain transfer",
        "degenerate transfer",
        "degenerative transfer" ;
    skos:definition "Chain-transfer reaction that generates a new chain carrier and a new chain-transfer agent with the same reactivity as the original chain carrier and chain-transfer agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerative chain transfer" .

goldbook:08952 a skos:Concept ;
    skos:altLabel "dormant macromolecule (in RDP)",
        "dormant polymer chain" ;
    skos:definition "Temporarily deactivated chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dormant species" .

goldbook:08953 a skos:Concept ;
    skos:altLabel "inactive macromolecule (in RDP)",
        "non-propagating species" ;
    skos:definition "Dead chains or dormant chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inactive chain" .

goldbook:08954 a skos:Concept ;
    skos:definition "Substance that combines the properties of an initiator and a reversible chain-transfer agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inifer" .

goldbook:08955 a skos:Concept ;
    skos:definition "Substance that combines the properties of an initiator, a reversible chain-transfer agent and a chain terminator or reversible deactivator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iniferter" .

goldbook:08956 a skos:Concept ;
    skos:definition "Process for converting a starting coordination complex or precatalyst into an active catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initialization" .

goldbook:08957 a skos:Concept ;
    skos:definition "Starting initiator or transfer agent in reversible-deactivation polymerization (RDP)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initializer" .

goldbook:08958 a skos:Concept ;
    skos:definition "Efficiency of conversion of a starting initiator or transfer agent into a macro-initiator or macro-chain-transfer agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initialization efficiency" .

goldbook:08959 a skos:Concept ;
    skos:definition "Species to which monomer adds or becomes inserted to start a chain polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initiating species" .

goldbook:08960 a skos:Concept ;
    skos:definition "Number of growing chains initiated divided by the number of active-centers generated from initiator molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initiator efficiency" .

goldbook:08961 a skos:Concept ;
    skos:altLabel "living macromolecule (in RDP)" ;
    skos:definition "Polymer chains that possess the potential for chain growth under the polymerization conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living polymer chain" .

goldbook:08962 a skos:Concept ;
    skos:altLabel "macroCTA",
        "macroRAFT agent (in RAFT polymerization)" ;
    skos:definition "Macromolecule containing chain-transfer-agent functionality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macro-chain-transfer agent" .

goldbook:08963 a skos:Concept ;
    skos:definition "Macromolecule containing initiator functionality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroinitiator" .

goldbook:08964 a skos:Concept ;
    skos:altLabel "mediator" ;
    skos:definition "Species that mediates polymerization in reversible-deactivation polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mediating agent" .

goldbook:08965 a skos:Concept ;
    skos:definition "Species that is formed from an initiator or monomer molecule and that is capable of initiating polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary species" .

goldbook:08966 a skos:Concept ;
    skos:altLabel "active macromolecule (in RDP)",
        "active polymer chain",
        "growing chain" ;
    skos:definition "Active species formed by addition to monomer that is capable of adding further monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "propagating species" .

goldbook:08967 a skos:Concept ;
    skos:definition "Diminished rate of polymerization brought about by the action of a retarder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retardation" .

goldbook:08968 a skos:Concept ;
    skos:altLabel "RAFT agent",
        "chain-transfer agent (CTA) (in RAFT polymerization)" ;
    skos:definition "Chain-transfer agent that provides chain transfer by a reversible-addition-fragmentation mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-addition-fragmentation chain-transfer agent" .

goldbook:08969 a skos:Concept ;
    skos:definition "Species formed by the rearrangement or fragmentation of a primary species that is capable of initiating a polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary species" .

goldbook:08970 a skos:Concept ;
    skos:definition "Mediating agent in stable-radical-mediated radical polymerization with sufficient kinetic stability such that it is essentially unreactive towards addition to monomer under the conditions of the experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable radical" .

goldbook:08971 a skos:Concept ;
    skos:definition "Species comprising only one monomer unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unimer" .

goldbook:08972 a skos:Concept ;
    skos:definition "Chain-transfer process that proceeds by a one-step substitution reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substitution chain transfer" .

goldbook:08973 a skos:Concept ;
    skos:definition "Term indicating control of a certain kinetic feature of an ionic polymerization or structural aspect of the polymer molecules formed by ionic polymerization, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled ionic polymerization" .

goldbook:08974 a skos:Concept ;
    skos:definition "Ionic polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic ring-opening polymerization" .

goldbook:08975 a skos:Concept ;
    skos:definition "Ionic polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living ionic polymerization" .

goldbook:08976 a skos:Concept ;
    skos:altLabel "RDIP" ;
    skos:definition "Reversible-deactivation polymerization in which the kinetic-chain carriers are ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-deactivation ionic polymerization" .

goldbook:08977 a skos:Concept ;
    skos:altLabel "group-transfer polymerization (GTP)" ;
    skos:definition "Anionic polymerization in which a specific atom or group is intramolecularly transferred to remain associated with the active chain-end during the course of polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anionic group-transfer polymerization" .

goldbook:08978 a skos:Concept ;
    skos:definition "Anionic polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anionic ring-opening polymerization" .

goldbook:08979 a skos:Concept ;
    skos:definition "Term indicating control of a certain kinetic feature of an anionic polymerization or structural aspect of the polymer molecules formed by anionic polymerization, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled anionic polymerization" .

goldbook:08980 a skos:Concept ;
    skos:definition "Anionic polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living anionic polymerization" .

goldbook:08981 a skos:Concept ;
    skos:altLabel "RDAP" ;
    skos:definition "Reversible-deactivation polymerization in which the kinetic-chain carriers are anions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-deactivation anionic polymerization" .

goldbook:08982 a skos:Concept ;
    skos:definition "Chain polymerization in which the active centres are nucleophilic species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleophilic chain polymerization" .

goldbook:08983 a skos:Concept ;
    skos:definition "Nucleophilic chain polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring-opening nucleophilic chain polymerization" .

goldbook:08984 a skos:Concept ;
    skos:definition "Cationic polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cationic ring-opening polymerization" .

goldbook:08985 a skos:Concept ;
    skos:definition "Term indicating control of a certain kinetic feature of a cationic polymerization or structural aspect of the polymer molecules formed by cationic polymerization, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled cationic polymerization" .

goldbook:08986 a skos:Concept ;
    skos:definition "Chain polymerization in which the active centres are electrophilic species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophilic chain polymerization" .

goldbook:08987 a skos:Concept ;
    skos:definition "Cationic polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living cationic polymerization" .

goldbook:08988 a skos:Concept ;
    skos:altLabel "RDCP" ;
    skos:definition "Reversible-deactivation polymerization in which the chain carriers are cations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-deactivation cationic polymerization" .

goldbook:08989 a skos:Concept ;
    skos:altLabel "anionic activated-monomer polymerization" ;
    skos:definition "Activated-monomer polymerization where the propagating species is an electrophile and activating species is anionic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anion-activated-monomer polymerization" .

goldbook:08990 a skos:Concept ;
    skos:altLabel "cationic activated-monomer polymerization" ;
    skos:definition "Activated-monomer polymerization where the propagating species is a nucleophile and the activating species is cationic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cation-activated-monomer polymerization" .

goldbook:08991 a skos:Concept ;
    skos:definition "Ring-opening metathesis polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living ring-opening metathesis polymerization" .

goldbook:08992 a skos:Concept ;
    skos:definition "Polymerization in which unsaturated monomers are transformed into unsaturated polymers by a process of bond redistribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metathesis polymerization" .

goldbook:08993 a skos:Concept ;
    skos:altLabel "ROMP" ;
    skos:definition "Metathesis polymerization in which an unsaturated cyclic monomer is converted into an unsaturated monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring-opening metathesis polymerization" .

goldbook:08994 a skos:Concept ;
    skos:altLabel "ET-ROMP" ;
    skos:definition "Ring-opening metathesis polymerization (ROMP) proceeding through one-electron redox processes in the absence of a metal carbene initiator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-transfer ring-opening metathesis polymerization" .

goldbook:08995 a skos:Concept ;
    skos:definition "Chain polymerization that involves the preliminary coordination of a monomer molecule with a chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination polymerization" .

goldbook:08996 a skos:Concept ;
    skos:definition "Coordination polymerization of \\(\\ce{\\upalpha\\!,\\!\\upbeta\\mbox{-}unsaturated}\\) amides or esters that proceeds by sequential monomer coordination and Michael addition events." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination-addition polymerization" .

goldbook:08997 a skos:Concept ;
    skos:altLabel "insertion polymerization",
        "polyinsertion" ;
    skos:definition "Coordination polymerization of olefins that proceeds by insertion of the olefin into a metal–carbon bond" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination-insertion polymerization" .

goldbook:08998 a skos:Concept ;
    skos:definition "Coordination polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living coordination polymerization" .

goldbook:08999 a skos:Concept ;
    skos:altLabel "RDCP" ;
    skos:definition "Reversible-deactivation polymerization in which the chain carriers are coordination complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible-deactivation coordination polymerization" .

goldbook:09000 a skos:Concept ;
    skos:definition "Coordination polymerization in which a cyclic monomer yields a monomeric unit that is either acyclic or contains fewer rings than the cyclic monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination ring-opening polymerization" .

goldbook:09001 a skos:Concept ;
    skos:altLabel "CSP" ;
    skos:definition "Coordinative chain-transfer polymerization that involves two different catalysts showing different specificity, where chain propagation occurs sequentially on the two catalysts, allowing for the formation of segmented or multiblock copolymers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-shuttling polymerization" .

goldbook:09002 a skos:Concept ;
    skos:altLabel "CWP" ;
    skos:definition "Coordination polymerization in which the chain carrier migrates along the formed polymer chain through a series of \\(\\ce{\\upbeta\\mbox{-}hydrogen}\\) eliminations and reinsertions with inversion of stereochemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-walking polymerization" .

goldbook:09003 a skos:Concept ;
    skos:altLabel "CCTP" ;
    skos:definition "Coordination polymerization in which a propagating chain is able to transfer reversibly between the catalyst and a chain-transfer agent, thereby converting the active species into a dormant species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordinative chain-transfer polymerization" .

goldbook:09004 a skos:Concept ;
    skos:altLabel "heterogeneous coordination polymerization" ;
    skos:definition "Coordination polymerization making use of a heterogeneous catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous catalysis coordination polymerization" .

goldbook:09005 a skos:Concept ;
    skos:altLabel "homogeneous coordination polymerization" ;
    skos:definition "Coordination polymerization making use of a homogeneous catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous catalysis coordination polymerization" .

goldbook:09006 a skos:Concept ;
    skos:definition "Coordination polymerization making use of a metallocene catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallocene polymerization" .

goldbook:09007 a skos:Concept ;
    skos:definition "Polymerization proceeding by insertion of a monomer into a polar bond without the generation of ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-ionic polymerization" .

goldbook:09008 a skos:Concept ;
    skos:altLabel "lanthanide-mediated group-transfer polymerization",
        "rare-earth-metal-mediated coordination polymerization",
        "rare-earth-metal-mediated group-transfer polymerization" ;
    skos:definition "Coordination-addition polymerization with propagation occurring within the coordination sphere of a rare-earth metal complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rare-earth-metal-mediated coordination-addition polymerization" .

goldbook:09010 a skos:Concept ;
    skos:altLabel "CTP",
        "catalyst-transfer chain polymerization" ;
    skos:definition "Catalysed condensative chain polymerization where the catalyst is transferred from reactant polymer to product polymer with high efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst-transfer polymerization" .

goldbook:09011 a skos:Concept ;
    skos:definition "Catalyst-transfer polymerization where the propagation steps comprise cross-coupling reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst-transfer cross-coupling polymerization" .

goldbook:09012 a skos:Concept ;
    skos:definition "Condensative chain polymerization in which chain termination and irreversible chain transfer are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living condensative chain polymerization" .

goldbook:09013 a skos:Concept ;
    skos:definition "Polymer composed of brush macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brush polymer" .

goldbook:09014 a skos:Concept ;
    skos:definition "Numeral or letter or a combination of both that identifies position(s) in a structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "locant" .

goldbook:09015 a skos:Concept ;
    skos:altLabel "S-CRU" ;
    skos:definition "More (most) senior CRU of a structure of a macromolecule or oligomer molecule containing two or more different types of CRUs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "senior constitutional repeating unit" .

goldbook:09016 a skos:Concept ;
    skos:altLabel "P-CRU" ;
    skos:definition "Constitutional repeating unit (CRU) written with the subunits in a linear series from the highest (higher) seniority to the lowest (lower) or as close as possible by the shortest path." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preferred constitutional repeating unit" .

goldbook:09017 a skos:Concept ;
    skos:definition "Largest main-chain (backbone) segment of the constitutional repeating unit (CRU) that can be named a single unit under organic nomenclature rules. This may be a ring or a ring system, a heteroatom or a heteroatom chain, or an acyclic carbon chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subunit" .

goldbook:09018 a skos:Concept ;
    skos:altLabel "dimensionless Henry solubility" ;
    skos:definition "Amount concentration \\(c_{\\rm{l}}\\) of a species in the liquid phase divided by the amount concentration \\(c_{\\rm{g}}\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{cc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{l}}}{c_{\\rm{g}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dimensionless Henry’s law solubility constant" .

goldbook:09019 a skos:Concept ;
    skos:altLabel "dimensionless Henry volatility" ;
    skos:definition "Amount concentration \\(c_{\\rm{g}}\\) of a species in the gas phase divided by the amount concentration \\(c_{\\rm{g}}\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{cc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{g}}}{c_{\\rm{l}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dimensionless Henry’s law volatility constant" .

goldbook:09020 a skos:Concept ;
    skos:definition "Proportionality factor describing the equilibrium distribution of a chemical species between the gas phase and a liquid solution at infinite dilution of the solute according to Henry’s law. It is an umbrella term for the reciprocal quantities Henry’s law solubility constant and Henry’s law volatility constant. Because of its ambiguity, it is strongly recommended to specify whether a solubility or volatility constant is intended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law constant" .

goldbook:09021 a skos:Concept ;
    skos:altLabel "Henry solubility" ;
    skos:definition "Umbrella term for all variants of Henry’s law constants that are defined in such a way that the numerical value increases with increasing solubility of the solute. Variants include \\(H_{\\rm{s}}^{cp}\\), \\(H_{\\rm{s}}^{xp}\\), \\(H_{\\rm{s}}^{bp}\\), and \\(H_{\\rm{s}}^{cc}\\), as discussed elsewhere in this section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law solubility constant" .

goldbook:09022 a skos:Concept ;
    skos:altLabel "Henry volatility" ;
    skos:definition "Umbrella term for all variants of Henry’s law constants that are defined in such a way that the numerical value increases with increasing volatility of the solute. Variants include \\(H_{\\rm{v}}^{pc}\\), \\(H_{\\rm{v}}^{px}\\), \\(H_{\\rm{v}}^{pw}\\), and \\(H_{\\rm{v}}^{cc}\\), as discussed elsewhere in this section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law volatility constant" .

goldbook:09023 a skos:Concept ;
    skos:definition "Partial pressure \\(p\\) of a species in the gas phase divided by the amount concentration \\(c_{\\rm{l}}\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{pc}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{p}{c_{\\rm{l}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law volatility constant (via p and c)" .

goldbook:09024 a skos:Concept ;
    skos:altLabel "Henry solubility (defined via amount concentration and partial pressure)" ;
    skos:definition "Amount concentration \\(c_{\\rm{l}}\\) of a species in the liquid phase divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{cp}: = \\underset{c_{\\rm{l}} \\to 0}{\\rm{lim}}\\frac{c_{\\rm{l}}}{p}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law solubility constant (via c and p)" .

goldbook:09025 a skos:Concept ;
    skos:definition "Amount fraction \\(x\\) of a species in the liquid phase divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{xp}: = \\underset{x \\to 0}{\\rm{lim}}\\frac{x}{p}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law solubility constant (via x and p)" .

goldbook:09026 a skos:Concept ;
    skos:definition "Molality \\(b\\) of a species divided by the partial pressure \\(p\\) of that species in the gas phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{s}}^{bp}: = \\underset{b \\to 0}{\\rm{lim}}\\frac{b}{p}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law solubility constant (via b and p)" .

goldbook:09027 a skos:Concept ;
    skos:altLabel "Henry volatility (defined via partial pressure and liquid-phase amount fraction)" ;
    skos:definition "Partial pressure \\(p\\) of a species in the gas phase divided by the amount fraction \\(x\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{px}: = \\underset{x \\to 0}{\\rm{lim}}\\frac{p}{x}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law volatility constant (via p and x)" .

goldbook:09028 a skos:Concept ;
    skos:definition "Partial pressure \\(p\\) of a species in the gas phase divided by the mass fraction \\(w\\) of that species in the liquid phase under equilibrium conditions at infinite dilution: \\[H_{\\rm{v}}^{pw}: = \\underset{w \\to 0}{\\rm{lim}}\\frac{p}{w}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry’s law volatility constant (via p and w)" .

goldbook:09029 a skos:Concept ;
    skos:definition "Constitutive part of a conjugation that binds an active species to a substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "link" .

goldbook:09030 a skos:Concept ;
    skos:definition "Conjugate in which at least one conjugation includes a bioactive active species to be released by cleavage of the link where its action is desired." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prodrug conjugate" .

goldbook:09031 a skos:Concept ;
    skos:definition "Link used in a conjugation to distance the substrate from the active species that otherwise would have its activity affected by steric or other influences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spacer arm" .

goldbook:09032 a skos:Concept ;
    skos:definition "Materials chemistry is the scientific discipline that designs, synthesizes, and characterizes materials with particular interest on both their processing and the understanding of useful or potentially useful properties displayed by the materials designed and synthesized for specific applications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "materials chemistry" .

goldbook:09033 a skos:Concept ;
    skos:altLabel "PnB" ;
    skos:definition "Weak attractive interaction between an electrophilic region on a pnictogen atom in a molecular entity (wherein the pnictogen is involved in other stronger bonds) and a nucleophilic region in another, or the same, molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pnictogen bond" .

goldbook:09034 a skos:Concept ;
    skos:definition "Measure of the capacity of aqueous media to react with hydrogen ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkalinity" .

goldbook:09035 a skos:Concept ;
    skos:definition "Titration of remaining reagent after addition of excess reagent to the titrand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back titration" .

goldbook:09036 a skos:Concept ;
    skos:definition "Titration performed with titrand containing no analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blank titration" .

goldbook:09037 a skos:Concept ;
    skos:altLabel "cerimetry" ;
    skos:definition "Redox titration using cerium(IV), in which an iron(II)-1,10-phenanthroline complex (ferroin) color change indicates the end-point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerimetric titration" .

goldbook:09038 a skos:Concept ;
    skos:altLabel "phenolphthalein end-point alkalinity" ;
    skos:definition "Measurement by titration to the phenolphthalein end-point (pH 8.3) of that portion of alkalinity arbitrarily attributed to all the hydroxyl content and half the carbonate content of a titrand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composite alkalinity" .

goldbook:09039 a skos:Concept ;
    skos:definition "Mass of a body that is balanced by a standard mass under conventionally chosen conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conventional mass" .

goldbook:09040 a skos:Concept ;
    skos:definition "Titration in which titrant is added directly to titrand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct titration" .

goldbook:09041 a skos:Concept ;
    skos:definition "Difference in the volume or mass of titrant, or the corresponding difference in the volume or mass of titrand, between the end-point value and equivalence-point value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "end-point error" .

goldbook:09042 a skos:Concept ;
    skos:definition "Stage of a titration at which the titrant has completely reacted with the titrand according to the stoichiometry of the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalence-point" .

goldbook:09043 a skos:Concept ;
    skos:altLabel "gravimetry" ;
    skos:definition "Measurement principle of quantitative chemical analysis based on measurement of mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gravimetric analysis" .

goldbook:09044 a skos:Concept ;
    skos:altLabel "GF" ;
    skos:definition "Mass fraction of analyte in a precipitate (see precipitation) obtained in a gravimetric analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gravimetric factor" .

goldbook:09045 a skos:Concept ;
    skos:definition "Precipitation in gravimetric analysis in which the precipitating agent is produced from a homogeneously dissolved precursor to minimise local excesses and supersaturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous precipitation" .

goldbook:09046 a skos:Concept ;
    skos:definition "Systematic measurement error from the reaction of a visual indicator with a reactant in a titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indicator consumption error" .

goldbook:09047 a skos:Concept ;
    skos:definition "Redox titration in which the course of the reaction is followed by potentiometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometric titration" .

goldbook:09048 a skos:Concept ;
    skos:definition "Visual indicator precipitated, with concomitant color change, by reaction with excess titrant at the end-point of a titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitation indicator" .

goldbook:09049 a skos:Concept ;
    skos:definition "Visual indicator that reacts with excess titrant or titrand with a color change at the end-point of a redox titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redox indicator" .

goldbook:09050 a skos:Concept ;
    skos:definition "Solution prepared by weighing an appropriate portion of a solid or by measuring out an appropriate volume of a liquid and dissolving it in the weighed mass of solvent or by adding solvent to a given volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stock solution" .

goldbook:09051 a skos:Concept ;
    skos:definition "Reactant solution being titrated in a titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "titrand" .

goldbook:09052 a skos:Concept ;
    skos:altLabel "titrimetry" ;
    skos:definition "Methods of quantitative analysis employing titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "titrimetric analysis" .

goldbook:09053 a skos:Concept ;
    skos:definition "Potential at the end-point of a redox titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition potential" .

goldbook:09054 a skos:Concept ;
    skos:definition "Visual indicator composed of a solution of several pH indicators (main components are thymol blue, methyl red, bromothymol blue and phenolphthalein) that changes color through a range of pH values, usually from 1 to 14." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "universal indicator" .

goldbook:09055 a skos:Concept ;
    skos:altLabel "volumetry" ;
    skos:definition "Titration in which the titrant is added by volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volumetric titration" .

goldbook:09056 a skos:Concept ;
    skos:altLabel "relative supersaturation" ;
    skos:definition "Difference between the concentration of the supersaturated solution (see supersaturation) required for nucleation (\\(Q\\)) and its solubility (\\(S\\)), divided by the solubility, \\((Q − S)/S\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "von Weimarn ratio" .

goldbook:09057 a skos:Concept ;
    skos:definition "Algebraic sum of faradaic currents flowing through an electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net faradaic current" .

goldbook:09058 a skos:Concept ;
    skos:definition "System that consists of at least two electron conductors (electrodes) in contact with ionic conductors (electrolytes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical cell" .

goldbook:09059 a skos:Concept ;
    skos:definition "In May 2019, certain fundamental constants that had been measured in SI units have had their numerical values fixed, with no uncertainty, thus defining the units. Of importance to electroanalytical chemistry are the values of the Boltzmann constant, the elementary charge, and the Avogadro constant. These are given in the table below, with calculated values of the Faraday constant (\\(F = e·N_{\\rm{A}}\\)) and gas constant (\\(R = k\\cdot\\!N_{\\rm{A}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical constants" .

goldbook:09060 a skos:Concept ;
    skos:definition "Electron conductor in an electrochemical cell connected to the external circuit.  Half-cell consisting of at least one electron conductor and at least one ionic conductor (electrolyte)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode" .

goldbook:09061 a skos:Concept ;
    skos:definition "Conducting medium in which the flow of electric current is accompanied by the movement of ions.  Substance that provides ions on dissolution in a solvent or on melting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrolyte" .

goldbook:09062 a skos:Concept ;
    skos:definition "Electrochemical cell in which electrical energy is converted into chemical energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrolytic cell" .

goldbook:09063 a skos:Concept ;
    skos:altLabel "charge number",
        "number of electrons transferred" ;
    skos:definition "Number of electrons transferred in a charge transfer reaction between an electrode and a single entity (ion, radical-ion, or molecule) of an electroactive substance, whose identity must be specified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron number of an electrochemical reaction" .

goldbook:09064 a skos:Concept ;
    skos:altLabel "Nernst potential",
        "reversible potential" ;
    skos:definition "Potential of an electrode when no electric current flows through the cell and all local charge transfer equilibria across phase boundaries that are represented in the cell diagram (except at possible electrolyte-electrolyte junctions) and local chemical equilibria are established." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium electrode potential" .

goldbook:09065 a skos:Concept ;
    skos:altLabel "formal potential" ;
    skos:definition "Equilibrium electrode potential under conditions of unit concentration of species involved in the electrode reaction. \\[E_{\\rm{eq}} = E^{\\circ\\prime} - (RT/zF) \\mathop \\sum \\limits_{i}  u_{i} \\ln(c_{i}/c^{\\circ)\\] where \\(E_{\\rm{eq}}\\) is the equilibrium electrode potential, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, \\(z\\) the electron number of an electrochemical reaction, \\( u_{\\rm{i}}\\) the stoichiometric coefficients (numbers of species) in the equation of the electrode reaction (positive for products and negative for reactants), and \\(c_{\\rm{i}}\\) are the amount concentrations of the species involved (most usually ions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "formal electrode potential" .

goldbook:09066 a skos:Concept ;
    skos:definition "Electrochemical cell in which chemical reactions occur spontaneously and chemical energy is converted into electrical energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "galvanic cell" .

goldbook:09067 a skos:Concept ;
    skos:definition "Notation giving electrodes, electroactive substances, and other relevant information for an electrochemical cell. The notation starts and finishes with an electrode. Phase boundaries are denoted with a solid vertical bar \\(|\\), boundaries between miscible liquids by a vertical dashed bar \\(¦\\), and a liquid junction by double vertical dashed bars \\(¦¦\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line representation of electrochemical cells" .

goldbook:09068 a skos:Concept ;
    skos:definition "Fundamental equation in electrochemistry that describes the dependence of the equilibrium electrode potential on the composition of the contacting phases, written as a reduction: \\[E_{\\rm{eq}} = E^{\\circ}\\!-\\!(RT/zF)\\mathop \\sum \\limits_i  u_i \\ln(a_i)\\] where \\(E_{\\rm{eq}}\\) is the equilibrium electrode potential, \\(E^{\\circ}\\) the standard electrode potential of the reaction, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(F\\) the Faraday constant, \\(z\\) the electron number of an electrochemical reaction, and \\( u_{\\rm{i}}\\) are the stoichiometric coefficients (numbers of species) in the equation of the electrode reaction, positive for products and negative for reactants, while \\(a_{\\rm{i}}\\) represents the activities of the species involved (most usually ions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nernst equation" .

goldbook:09069 a skos:Concept ;
    skos:definition "Equation for diffusion current \\(I_{\\rm{d}}\\) at time \\(t\\) at a large planar electrode in contact with a semi-infinite layer of unstirred solution containing excess supporting (inert) electrolyte and an electroactive substance of bulk concentration \\(c\\) when, at the instant \\(t = 0\\), the potential of the electrode is suddenly changed to a value at which a mass-transport limited electrochemical reaction occurs and the concentration of the electroactive species at the electrode is zero, \\[I_{\\rm{d}} = zFA{D^{1/2}}c/(\\pi^{1/2} t^{1/2})\\] where \\(z\\) is the electron number of an electrochemical reaction in the charge transfer step of the species (being positive for an oxidation and negative for a reduction), \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, and \\(D\\) the diffusion coefficient of the electroactive substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cottrell equation" .

goldbook:09070 a skos:Concept ;
    skos:altLabel "I-E curve" ;
    skos:definition "Plot of current versus applied potential (\\(I\\!{-}\\!E\\)) for a given system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "current-potential curve" .

goldbook:09071 a skos:Concept ;
    skos:altLabel "bioanalytical sensor" ;
    skos:definition "Electrochemical sensor that has a biological recognition element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical biosensor" .

goldbook:09072 a skos:Concept ;
    skos:definition "Measuring system in which the response to an electrochemical reaction is converted, via a suitable transducer, into a measurable electrical signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical sensor" .

goldbook:09073 a skos:Concept ;
    skos:altLabel "electrode coverage" ;
    skos:definition "Amount of a chemical modifier at an electrode surface per unit area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode coverage density" .

goldbook:09074 a skos:Concept ;
    skos:definition "Area of electrode–solution interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode surface area" .

goldbook:09075 a skos:Concept ;
    skos:definition "Faraday’s First Law of electrolysis: Mass \\(m\\) of electrochemically-transformed substance is proportional to the charge \\(Q\\) passed, \\(m\\! \\propto\\! Q\\). Faraday’s Second Law of electrolysis: When the same electric charge (quantity of electricity) \\(Q\\) is passed through several electrolytes, the mass \\(m_{\\rm{i}}\\) of the substances deposited are proportional to their respective chemical equivalent molar mass, \\(M_{\\rm{i}}/z_{\\rm{i}}\\). \\[m_{1}/m_{2} = (M_{1}/z_{1})/(M_{2}/z_{2})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Faraday’s laws of electrolysis" .

goldbook:09076 a skos:Concept ;
    skos:definition "Instrument which controls the electric current between the working electrode and the auxiliary electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "galvanostat" .

goldbook:09077 a skos:Concept ;
    skos:altLabel "OCP" ;
    skos:definition "Electrode potential of working electrode relative to the reference electrode when no potential or electric current is being applied to the electrochemical cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open circuit potential" .

goldbook:09078 a skos:Concept ;
    skos:definition "Electrode whose potential changes with an applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarizable electrode" .

goldbook:09079 a skos:Concept ;
    skos:definition "Measuring instrument for electric current that controls the potential difference between a working electrode and a reference electrode and measures the electric current between a working electrode and an auxiliary electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiostat" .

goldbook:09080 a skos:Concept ;
    skos:definition "Means of making electrolytic connection between two half cells without introducing a significant liquid junction potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salt bridge" .

goldbook:09081 a skos:Concept ;
    skos:definition "Electrochemical cell with a working electrode, reference electrode, and auxiliary electrode.Schematic of a three-electrode cell. 1 - working electrode, 2 - reference electrode, 3 - auxiliary electrode. The potential between 1 and 2 is set while passing and measuring current between 1 and 3." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "three-electrode cell" .

goldbook:09082 a skos:Concept ;
    skos:definition "Range of electrode potentials of a given working electrode in a given electrolyte, where the electric current from reactions of the electrode or electrolyte is negligible compared with the current from reactions of the system under investigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "working potential range" .

goldbook:09083 a skos:Concept ;
    skos:definition "Electrode with smallest dimension of order millimetre or greater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroelectrode" .

goldbook:09084 a skos:Concept ;
    skos:definition "Electrode with smallest dimension of less than 1 millimetre and greater than 1 micrometre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microelectrode" .

goldbook:09085 a skos:Concept ;
    skos:altLabel "UME" ;
    skos:definition "Electrode with smallest dimension of less than 25 micrometre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultramicroelectrode" .

goldbook:09086 a skos:Concept ;
    skos:altLabel "NE" ;
    skos:definition "Electrode with smallest dimension less than 1 micrometre" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoelectrode" .

goldbook:09087 a skos:Concept ;
    skos:altLabel "QRE" ;
    skos:definition "Electrode that maintains a constant, but not generally well-defined, potential in an electrochemical cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-reference electrode" .

goldbook:09088 a skos:Concept ;
    skos:altLabel "GCE",
        "vitreous carbon electrode" ;
    skos:definition "Electrode made of glassy carbon material with an intertwined graphitic ribbon structure, formed by pyrolysis of a resol precursor at temperatures up to \\(\\pu{3000^{\\circ}C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glassy carbon electrode" .

goldbook:09089 a skos:Concept ;
    skos:altLabel "HOPGE" ;
    skos:definition "Graphite electrode of material produced by high temperature deposition of carbon on a ceramic surface and subject to graphitization at \\(\\pu{3000^{\\circ}C}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "highly oriented pyrolytic graphite electrode" .

goldbook:09090 a skos:Concept ;
    skos:altLabel "PIGE" ;
    skos:definition "Graphite electrode based on a graphitic material impregnated with paraffin having a high melting point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paraffin impregnated graphite electrode" .

goldbook:09091 a skos:Concept ;
    skos:altLabel "BDDE" ;
    skos:definition "Electrode composed of a boron-doped diamond film on an electron-conducting substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boron-doped diamond electrode" .

goldbook:09092 a skos:Concept ;
    skos:definition "Detection principle for a chemically modified electrode (CME) in which the electrode is modified by a biological recognition element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biorecognition" .

goldbook:09093 a skos:Concept ;
    skos:definition "Detection principle for a chemically modified electrode (CME) in which the signal originates from accumulation and/or release of an analyte or reagent as well as other electrochemical processes which can result in changes in the mass of the CME." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "change of mass" .

goldbook:09094 a skos:Concept ;
    skos:definition "Detection principle for a chemically modified electrode (CME) in which a charge transfer reaction between a CME and analyte proceeds at a lower overpotential than at the bare electrode. Usually, the effect of electrocatalysis is also an increase of faradaic current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrocatalysis" .

goldbook:09095 a skos:Concept ;
    skos:definition "Detection principle for a chemically modified electrode (CME) in which an immobilized redox couple can shuttle electrons between the electrode and an analyte, for instance, one with difficult access to the electrode surface because of steric reasons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redox mediation" .

goldbook:09096 a skos:Concept ;
    skos:altLabel "CPE" ;
    skos:definition "Electrode of a composite of carbon powder and a pasting liquid (including mineral oil, Nujol, bromoform, bromonaphthalene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon paste electrode" .

goldbook:09097 a skos:Concept ;
    skos:definition "Development of a carbon paste electrode that is screen printed using a carbon/polymer mixture of suitable composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon ink electrode" .

goldbook:09098 a skos:Concept ;
    skos:altLabel "SAE" ;
    skos:definition "Electrode made of a solid amalgam of an appropriate metal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid amalgam electrode" .

goldbook:09099 a skos:Concept ;
    skos:definition "Foil, wire or disc electrode made of gold which is easily fabricated into a variety of electrode geometries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gold electrode" .

goldbook:09100 a skos:Concept ;
    skos:definition "Foil, wire, disc, or mesh electrode made of platinum, which is the most commonly used metallic working electrode in electrochemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "platinum electrode" .

goldbook:09101 a skos:Concept ;
    skos:definition "Electrode in the form of foil, mesh, wire, rod, tube, powder, pellets, or single crystal of silver." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silver electrode" .

goldbook:09102 a skos:Concept ;
    skos:definition "Liquid metal electrode used in polarography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mercury electrode" .

goldbook:09103 a skos:Concept ;
    skos:altLabel "DME" ;
    skos:definition "Mercury electrode formed by sequence of mercury drops falling from a small aperture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dropping mercury electrode" .

goldbook:09104 a skos:Concept ;
    skos:definition "Electrode containing two different metals (e.g. platinum and ruthenium) on its surface (e.g. to modify its electrocatalytic properties)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bimetallic electrode" .

goldbook:09105 a skos:Concept ;
    skos:altLabel "ChemFET" ;
    skos:definition "Non-faradaic electrode system in which electric field variations in the semiconductor gate region control the magnitude of the source-drain current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically-sensitive field effect transistor" .

goldbook:09106 a skos:Concept ;
    skos:altLabel "CME" ;
    skos:definition "Electrode coated with a thin layer of a substance that exhibits particular chemical, electrochemical, and/or optical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically-modified electrode" .

goldbook:09107 a skos:Concept ;
    skos:altLabel "enzyme electrode" ;
    skos:definition "Chemically-modified electrode in which the products of a reaction between enzymes in an immobilized enzyme layer and the enzyme reaction substrate are electrochemically active and are measured usually by amperometry or potentiometry.Schematic of the mediated oxidation of glucose to gluconolactone by glucose oxidase. The current passed to re-oxidise the mediator is proportional to the amount concentration of glucose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme-modified electrode" .

goldbook:09108 a skos:Concept ;
    skos:definition "ISE in which the membrane is a crystalline material prepared from either a single compound or a homogeneous mixture of compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous crystalline membrane electrodes" .

goldbook:09109 a skos:Concept ;
    skos:definition "ISE prepared of an active substance, or mixture of active substances, mixed with an inert matrix (such as silicone rubber or \\(\\ce{PVC}\\)), or placed on hydrophobized graphite or conducting epoxy resin, to form a heterogeneous sensing membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous crystalline membrane electrodes" .

goldbook:09110 a skos:Concept ;
    skos:definition "Kind of ion-selective membranes used in an ISE which is a support matrix, containing an ion exchanger (either cationic or anionic), a plasticizer solvent, and possibly an uncharged, selectivity-enhancing species, form the ion-selective membrane which is usually interposed between two aqueous solutions. The matrix can be either macroporous (e.g., poly(propylene carbonate) filter, glass frit, etc.) or microporous (e.g., “thirsty” glass or polymeric material such as \\(\\ce{PVC}\\)) yielding with the ion-exchanger and the solvent a “solidified” homogeneous mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-crystalline membrane" .

goldbook:09111 a skos:Concept ;
    skos:altLabel "matrix membranes",
        "self-supporting membranes" ;
    skos:definition "Kind of ion-selective membranes used in an ISE comprising synthetic cross-linked polymer with fixed sites or thin glass membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rigid membranes" .

goldbook:09112 a skos:Concept ;
    skos:definition "Kind of ion-selective membranes used in an ISE comprising:  Positively-charged, hydrophobic cations which, when dissolved in a suitable organic solvent and held in an inert support (e.g., poly(propylenecarbonate) filter or \\(\\ce{PVC}\\)), provide membranes which are sensitive to changes in the activities of anions. Negatively-charged hydrophobic anions which, when dissolved in a suitable organic solvent and held in an inert support (e.g., poly(propylene carbonate) filter or \\(\\ce{PVC}\\)), provide membranes which are sensitive to changes of cation activities. Uncharged “carrier” electrodes based on solutions of molecular complexing agents of cations and anions, which can be used for preparing ion exchanger membranes sensitive and selective to certain cations and anions. Hydrophobic ion-pair electrodes of plasticized polymers (e.g., \\(\\ce{PVC}\\)) containing a dissolved hydrophobic ion-pair respond to the ion activities of those components, which are relevant to the ion-pairs incorporated in the membrane. The responses can be Nernstian." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membranes with mobile charged sites" .

goldbook:09113 a skos:Concept ;
    skos:definition "Ion-selective electrode cell in which the ion-selective electrode and reference electrode are combined in a single sensor assembly, thereby avoiding the need for a separate external reference electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combined electrode" .

goldbook:09114 a skos:Concept ;
    skos:definition "Assembly of linked electrodes (usually microelectrodes, ultramicroelectrodes or nanoelectrodes) acting as a single electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode array" .

goldbook:09115 a skos:Concept ;
    skos:altLabel "glass electrode",
        "pH electrode" ;
    skos:definition "pH-sensitive electrode, usually consisting of a bulb, or other suitable form, of special glass attached to a stem of high-resistance glass, complete with an internal reference electrode and internal filling solution system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass pH-sensitive electrode" .

goldbook:09116 a skos:Concept ;
    skos:altLabel "heterogeneous crystalline membrane electrode" ;
    skos:definition "Ion-selective electrode in which the ion-selective membrane is a crystalline material mixed with an inert matrix (such as silicone rubber or polyvinyl chloride), or placed on hydrophobized graphite or conducting epoxy resin, to form a heterogeneous sensing membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous crystalline membrane ion-selective electrode" .

goldbook:09117 a skos:Concept ;
    skos:altLabel "homogeneous crystalline membrane electrode" ;
    skos:definition "Ion-selective electrode in which the ion-selective membrane is a crystalline material prepared from either a single compound or homogeneous mixture of compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous crystalline membrane ion-selective electrode" .

goldbook:09118 a skos:Concept ;
    skos:altLabel "ISFET" ;
    skos:definition "Electrochemical sensor based on the principle of the field effect transistor (FET) in which the surface of the gate is modified in a way that makes the response ion-selective." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-selective field effect transistor" .

goldbook:09119 a skos:Concept ;
    skos:definition "Membrane with controlled permeability to a particular ion covering an electrode, or separating two electrolyte solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-selective membrane" .

goldbook:09120 a skos:Concept ;
    skos:definition "Equation describing the contribution of interfering ions, \\(i\\), to the electrode potential of an ion-selective electrode that is mainly dominated by the primary ion \\(\\ce{X}\\). \\[E = {\\rm{const}} + \\frac{RT}{z_{\\rm{X}}F} \\ln \\left(a_{\\ce{X}} + \\sum\\limits_i K_{{\\ce{X}},i}^{\\rm{pot}}a_{i}^{(z_{\\ce{X}}/z_i)} \\right)\\] where \\(E\\) is the measured electrode potential of an ISE when the only variables are activities in the test solution. \\(R\\) is the gas constant, \\(T\\) the thermodynamic temperature, \\(z_{\\rm{X}}\\) and \\(z_{\\rm{i}}\\) are the numbers of electrons transferred by the analyte ion \\(\\ce{X}\\) and \\(i\\), respectively, \\(F\\) is the Faraday constant, \\(a_{\\rm{X}}\\) and \\(a_{\\rm{i}}\\) the activity of \\(\\ce{X}\\) and \\(i\\), respectively, and \\(K_{\\ce{X},i}^{\\rm{pot}}\\) is the potentiometric selectivity coefficient for interfering ion \\(i\\) with respect to the primary ion \\(\\ce{X}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nikolsky–Eisenman equation" .

goldbook:09121 a skos:Concept ;
    skos:definition "Potentiometric electrochemical sensor that measures pH as a linear function of electrode potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH-sensitive electrode" .

goldbook:09122 a skos:Concept ;
    skos:definition "Enzyme-modified electrode, or an electrode modified by a substrate, cofactor or inhibitor, in which the activity of a product of the enzyme reaction is measured by an ion-selective electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometric enzyme electrode" .

goldbook:09123 a skos:Concept ;
    skos:definition "Ion-selective electrode cell that is responsive to an analyte gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometric gas sensor" .

goldbook:09124 a skos:Concept ;
    skos:altLabel "RDE" ;
    skos:definition "A disc electrode that is embedded in the centre of a cylinder which rotates in solution around the longitudinal cylinder axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotating disc electrode" .

goldbook:09125 a skos:Concept ;
    skos:definition "A disc electrode with a thin circular jet of fluid impinging on its centre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wall-jet electrode" .

goldbook:09126 a skos:Concept ;
    skos:definition "Potentiometry in which the potential is measured with time following a change in applied current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronopotentiometry" .

goldbook:09127 a skos:Concept ;
    skos:definition "Electrochemical measurement principle where the potential difference between an indicator electrode and a reference electrode is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometry" .

goldbook:09128 a skos:Concept ;
    skos:definition "Electrochemical measurement principle based on measurement of current at a controlled applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amperometry" .

goldbook:09129 a skos:Concept ;
    skos:definition "Amperometry in which the current is measured as a function of time after a change in the applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronoamperometry" .

goldbook:09130 a skos:Concept ;
    skos:definition "Voltammetry in which a sinusoidal alternating potential of small amplitude (\\(\\pu{10 to 50 mV}\\)) of constant frequency (\\(\\pu{10 Hz to 100 kHz}\\)) is superimposed on a slowly and linearly varying potential ramp. The resulting alternating current is plotted versus imposed DC potential. The obtained AC voltammogram is peak-shaped.Waveform for AC voltammetry. The applied potential as a function of time is a sinusoidal alternating potential superimposed on a linearly increasing ramp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "AC voltammetry" .

goldbook:09131 a skos:Concept ;
    skos:definition "Empirically-determined quantity defined by the equation \\[{\\cal Q} = (1/Ac)\\Delta Q/\\Delta (t^{1/2})\\] where \\(A\\) is the electrode surface area, \\(c\\) is the bulk concentration of the electroactive substance, \\(Q\\) is the charge passed, and \\(\\Delta Q/\\Delta(t^{1/2})\\) is the slope of a plot of \\(Q\\) against \\(t^{1/2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronocoulometric constant" .

goldbook:09132 a skos:Concept ;
    skos:definition "Empirically-evaluated quantity defined by the equation \\[{\\cal T} = I\\tau^{1/2}/(A c_{B}) = j\\tau^{1/2}/c_{\\ce{B}}\\] where \\(I\\) is the electric current, \\(\\tau\\) is the transition time, \\(A\\) is the electrode surface area, \\(\\ce{B}\\) is the bulk concentration of the electroactive substance \\(\\ce{B}\\), and \\(j=I/A\\) is the current density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronopotentiometric constant" .

goldbook:09133 a skos:Concept ;
    skos:definition "Measurement of electric current in voltammetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "current sampling" .

goldbook:09134 a skos:Concept ;
    skos:altLabel "CV",
        "cyclic linear scan voltammetry" ;
    skos:definition "Voltammetry in which the electric current is recorded as the electrode potential is varied with time cyclically between two potential limits, normally at a constant scan rate.Cyclic voltammetry. (a) Variation of applied potential with time. (b) Cyclic voltammogram of current against applied potential for a reversible redox couple." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclic voltammetry" .

goldbook:09135 a skos:Concept ;
    skos:altLabel "classical polarography" ;
    skos:definition "Linear scan voltammetry with slow scan rate in which a dropping mercury electrode is used as the working electrode. See figure.Electric current as a function of applied potential for DC polarography, showing oscillations of current as the dropping mercury electrode grows and is detached." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DC polarography" .

goldbook:09136 a skos:Concept ;
    skos:altLabel "DPV" ;
    skos:definition "Voltammetry in which small potential pulses (constant height \\(\\pu{10 to 100 mV}\\), constant width \\(\\pu{10 to 100 ms}\\)) are superimposed onto a linearly varying potential or onto a staircase potential ramp. The current is sampled just before the onset of the pulse (e.g. \\(\\pu{10 to 20 ms}\\)) and for the same sampling time just before the end of the pulse. The difference between the two sampled currents is plotted versus the potential applied before the pulse. Thus, a differential pulse voltammogram is peak-shaped.(a) Potential waveform for differential pulse voltammetry (not to scale). Typical values for pulse parameters are $\\tau$=1 s, $t_{\\rm{p}}$=50 ms, $E_{\\tau}$=50 mV, $E_{\\rm{p}}$=2 mV. Sampling interval indicated by horizontal curly brackets is typically 15 ms. (b) Differential pulse voltammogram. $I$ is the difference between currents sampled at ‘2’ and ‘1’." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential pulse voltammetry" .

goldbook:09137 a skos:Concept ;
    skos:definition "The relationship that describes the electrode potential as a function of the current of a reversible redox system (reversible electrode reaction) in the steady state in voltammetry \\[E = E^{\\circ\\prime} - \\frac{RT}{zF} \\ln \\left(\\frac{D_{\\rm{red}}}{D_{\\rm{ox}}}\\right)^{s} \\pm \\frac{RT}{zF} \\ln\\!\\left(\\frac{I_{\\rm{d,lim}} - I}{I}\\right)\\] where \\(E^{\\circ\\prime}\\) is the formal electrode potential, \\(z\\) the electron number of an electrochemical reaction, \\(D_{\\rm{red}}\\) and \\(D_{\\rm{ox}}\\) the diffusion coefficients of the reduced and oxidized forms of the electroactive substance, respectively, \\(I_{\\rm{d,lim}}\\) is the limiting diffusion current, and \\(I\\) is the current at the potential being applied. The value of the exponent \\(s\\) is ½ for a stationary or dropping mercury electrode, ⅔ for a hydrodynamic electrode (see hydrodynamic voltammetry), or 1 for a microelectrode. In the equation, the last term is added for reduction and subtracted for oxidation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Heyrovský–Ilkovič equation" .

goldbook:09138 a skos:Concept ;
    skos:definition "Voltammetry with forced flow of the solution towards the electrode surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrodynamic voltammetry" .

goldbook:09139 a skos:Concept ;
    skos:definition "Equation relating electric current at a dropping mercury electrode under purely diffusional control, \\(I_{{\\rm{d,}}t}\\), the amount concentration of an electroactive substance at the drop surface \\(c\\), and the concentration in bulk solution \\(c_{\\rm{0}}\\), \\[I_{{\\rm{d}},t} = -k\\,z\\,F\\,D^{1/2}q_{\\rm{m}}^{2/3} t^{1/6}(c - c_{0})\\] where \\(k\\) is a numerical constant, $z$ the electron number of an electrochemical reaction, \\(F\\) the Faraday constant, \\(D\\) the diffusion coefficient of the electroactive substance, \\(q_{\\rm{m}}\\) the mass flux of mercury at the dropping electrode, and \\(t\\) the time elapsed from the beginning of the drop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ilkovič equation" .

goldbook:09140 a skos:Concept ;
    skos:definition "Equation relating limiting current at a rotating disc electrode (see hydrodynamic voltammetry) to the amount concentration of an electroactive substance in bulk solution \\(c_{0}\\), \\[I_{\\rm{lim}} = k\\,z\\,F\\,A\\,D^{2/3} \\omega^{1/2}  u^{−1/6} c_{0}\\] where \\(k\\) is a numerical factor, \\(z\\) the electron number of an electrochemical reaction, \\(F\\) the Faraday constant, \\(A\\) the electrode surface area, \\(D\\) the diffusion coefficient of the electroactive substance, \\(\\omega\\) the angular velocity (rotation rate), and \\( u\\) the kinematic viscosity of the solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Levich equation" .

goldbook:09141 a skos:Concept ;
    skos:altLabel "LSV",
        "linear-sweep voltammetry" ;
    skos:definition "Voltammetry in which the electric current is recorded as the electrode potential is varied linearly with time. See figure.Linear scan voltammogram of current against applied potential for a reversible redox couple." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear-scan voltammetry" .

goldbook:09142 a skos:Concept ;
    skos:altLabel "NPV" ;
    skos:definition "Voltammetry in which potential pulses of amplitude increasing by a constant increment and with a pulse width of \\(\\pu{2 to 200 ms}\\) are superimposed on a constant initial potential. The current is sampled at the end of the pulse and then plotted versus the potential of the pulse. Sigmoidal wave-shaped voltammograms are obtained. See figure.(a) Waveform for normal pulse voltammetry (not to scale). Typical values for pulse parameters are \\(\\tau = \\pu{1 s}\\), \\(t_{\\rm{p}} = \\pu{50 ms}\\), \\(E_{\\rm{p}} = \\pu{2 mV}\\), \\(E_{\\rm{step}} = \\pu{2 mV}\\). Sampling interval indicated by horizontal curly brackets is typically \\(\\pu{15 ms}\\). (b) Normal pulse voltammogram." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal pulse voltammetry" .

goldbook:09143 a skos:Concept ;
    skos:definition "Equations describing the peak current \\(I_{\\rm{p}}\\) in linear scan voltammetry and cyclic voltammetry as a function of the amount concentration, \\(c_{\\rm{0}}\\), of electroactive species in bulk solution. For a reversible charge transfer: \\[I_{\\rm{p,rev}} = k\\,z\\,F\\,A\\,c_0 (z\\,F\\,D u/RT)^{1/2}\\] for irreversible charge transfer: \\[I_{\\rm{p,irrev}} = k^{\\prime}(\\alpha z^{\\prime})^{1/2} zFA{c_0}(FD u/RT)^{1/2}\\] where \\(k\\) and \\(k^{\\prime}\\) are numerical constants, \\(\\alpha\\) is the charge transfer coefficient (usually assumed to be close to 0.5), \\(z\\) the electron number of an electrochemical reaction, \\(z^{\\prime}\\) the number of electrons transferred before the rate determining step, \\(F\\) the Faraday constant, \\(R\\) the gas constant, \\(T\\) the thermodynamic temperature, \\(A\\) the electrode surface area, \\(D\\) the diffusion coefficient, and \\( u\\) the scan rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Randles–Ševčík equations" .

goldbook:09144 a skos:Concept ;
    skos:altLabel "mass flux" ;
    skos:definition "Mass of a drop of liquid metal in polarography at the instant when it is detached from the tip of the capillary divided by the drop time \\(t_{\\rm{d}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of flow of liquid metal in polarography" .

goldbook:09145 a skos:Concept ;
    skos:altLabel "TAST polarography" ;
    skos:definition "DC polarography with current sampling at the end of each drop life mechanically enforced by a knocker at a preset drop time value. The current sampling and mechanical drop dislodge are synchronized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampled DC polarography" .

goldbook:09146 a skos:Concept ;
    skos:altLabel "potential scan rate",
        "potential sweep rate",
        "sweep rate" ;
    skos:definition "The rate of change of applied potential with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scan rate" .

goldbook:09147 a skos:Concept ;
    skos:altLabel "Osteryoung square-wave voltammetry (OSWV)",
        "SWV" ;
    skos:definition "Voltammetry in which a square-wave potential waveform is superimposed on an underlying linearlyhyphen‐varying potential ramp or staircase ramp. The current is sampled just before the end of the forward-going pulse and of the backward-going pulse and the difference of the two sampled currents is plotted versus the applied potential of the potential or staircase ramp. The square-wave voltammogram is peak-shaped. See figure.(a) Waveform for square wave voltammetry (not to scale). Typical values for pulse parameters are \\(\\tau = \\pu{10 ms}\\), \\(t_{\\rm{p}} = \\pu{5 ms}\\), \\(E_{\\rm{\\tau}} = \\pu{25 mV}\\), \\(E_{\\rm{step}} = \\pu{4 mV}\\). Sampling interval indicated by horizontal curly brackets is typically \\(\\pu{1 ms}\\). (b) Square wave voltammogram of the difference between currents sampled at ‘2’ and ‘1’ against applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "square-wave voltammetry" .

goldbook:09148 a skos:Concept ;
    skos:definition "Electrochemical measurement principle in which the electrode potential of a working electrode is controlled and the electric current measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "voltammetry" .

goldbook:09149 a skos:Concept ;
    skos:definition "Current-potential curve in a voltammetry experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "voltammogram" .

goldbook:09150 a skos:Concept ;
    skos:altLabel "accumulation" ;
    skos:definition "Transfer of an analyte from a test solution to an electrode surface as the first step in stripping voltammetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accumulation in stripping voltammetry" .

goldbook:09151 a skos:Concept ;
    skos:altLabel "AdSV" ;
    skos:definition "Stripping voltammetry involving pre-concentration by adsorption of the analyte (in contrast to electrochemical accumulation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorptive stripping voltammetry" .

goldbook:09152 a skos:Concept ;
    skos:altLabel "ASV" ;
    skos:definition "Stripping voltammetry in which material accumulated at the working electrode is electrochemically oxidized in the stripping step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anodic stripping voltammetry" .

goldbook:09153 a skos:Concept ;
    skos:altLabel "CSV" ;
    skos:definition "Stripping voltammetry in which material accumulated at the working electrode is electrochemically reduced in the stripping step. See figure.Applied potential against time during the accumulation and stripping steps in cathodic stripping voltammetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cathodic stripping voltammetry" .

goldbook:09154 a skos:Concept ;
    skos:altLabel "PSA" ;
    skos:definition "Two-step electrochemical measurement in which 1) material is accumulated at an electrode and 2) the material is removed by chemical reaction or electrochemically at constant current with measurement of electrode potential. The time between changes in potential in step two is related to the concentration of analyte in the solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometric stripping analysis" .

goldbook:09155 a skos:Concept ;
    skos:definition "Two-step electrochemical measurement in which 1) material is accumulated at an electrode and 2) the amount of an accumulated species is measured by voltammetry. The measured electric current in step 2 is related to the concentration of analyte in the solution by calibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stripping voltammetry" .

goldbook:09156 a skos:Concept ;
    skos:definition "Direct coulometry at controlled potential in which the electric charge passed after the application of a potential step perturbation is measured as a function of time (\\(Q{-}t\\) curve)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronocoulometry" .

goldbook:09157 a skos:Concept ;
    skos:definition "Measuring instrument to obtain the electrical charge passed in an experiment, or to produce a known amount of substance in a titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coulometer" .

goldbook:09159 a skos:Concept ;
    skos:definition "Electrochemical measurement principle in which the electric charge required to carry out a known electrochemical reaction is measured. By Faraday’s laws of electrolysis, the amount of substance is proportional to the charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coulometry" .

goldbook:09160 a skos:Concept ;
    skos:definition "Coulometry at an imposed, constant electric current in the electrochemical cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct coulometry at controlled current" .

goldbook:09161 a skos:Concept ;
    skos:definition "Coulometry at a preselected constant potential of the working electrode.Electric current against time showing the representation of the electric charge in direct coulometry at controlled potential as the area under the graph." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct coulometry at controlled potential" .

goldbook:09162 a skos:Concept ;
    skos:definition "Electrogravimetry using an electrochemical quartz crystal microbalance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical piezoelectric microgravimetry" .

goldbook:09163 a skos:Concept ;
    skos:altLabel "EQCM",
        "electrochemical quartz crystal nanobalance (EQCN)" ;
    skos:definition "Electrochemical cell in which the working electrode is located on one surface of a piezoelectric quartz crystal, the oscillation frequency of which is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical quartz crystal microbalance" .

goldbook:09164 a skos:Concept ;
    skos:definition "Gravimetry in which the material to be weighed is obtained by electrochemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrogravimetry" .

goldbook:09165 a skos:Concept ;
    skos:definition "Titration in which the electric conductivity of a solution is measured as a function of the amount of titrant added.Conductimetric titration curve of conductance ($G$) against volume of titrant. The end-point of the titration is indicated by a change in slope of the graph." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conductometric titration" .

goldbook:09166 a skos:Concept ;
    skos:definition "Measurement principle in which the electric conductivity of a solution is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conductometry" .

goldbook:09167 a skos:Concept ;
    skos:definition "Electrochemical measurement principle based on the measurement of the dielectric constant of a sample resulting from the orientation of particles (molecules or ions) that have a dipole moment in an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dielectrometry" .

goldbook:09168 a skos:Concept ;
    skos:altLabel "EIS" ;
    skos:definition "Electrochemical measurement method of the complex impedance of an electrochemical system as a function of the frequency of a small amplitude (normally \\(\\pu{5 to 10 mV}\\)) sinusoidal voltage perturbation superimposed on a fixed value of applied potential or on the open circuit potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical impedance spectroscopy" .

goldbook:09169 a skos:Concept ;
    skos:definition "Measurement principle in which the complex electric impedance of a system is measured, usually as a function of a small amplitude sinusoidal electrode potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impedimetry" .

goldbook:09170 a skos:Concept ;
    skos:definition "Electrochemical techniques (potentiometry, amperometry, voltammetry, coulometry, conductimetry) used for analyte detection in flowing systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical detection in flowing systems" .

goldbook:09171 a skos:Concept ;
    skos:definition "Measurement methods combining spectrometric and electrochemical measurements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectroelectrochemistry" .

goldbook:09172 a skos:Concept ;
    skos:altLabel "AES",
        "Auger electron spectroscopy" ;
    skos:definition "Measurement method of electron emission spectroscopy that utilizes Auger electrons emitted from the target following excitation with an electron beam or X-ray beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger spectroscopy" .

goldbook:09173 a skos:Concept ;
    skos:altLabel "APECS" ;
    skos:definition "Detection of an Auger electron and a core-level photoelectron, emitted from a solid irradiated by mono-energetic X-rays, within a sufficiently short time that the Auger electron shall arise from the decay of the particular core-hole associated with the photoelectron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger photoelectron coincidence spectroscopy" .

goldbook:09174 a skos:Concept ;
    skos:altLabel "EPES" ;
    skos:definition "Measurement method in which an electron spectrometer is used to measure the energy, intensity, and/or energy broadening distribution of quasi-elastically scattered electrons from a solid or liquid surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastic peak electron spectroscopy" .

goldbook:09175 a skos:Concept ;
    skos:altLabel "elastic recoil detection",
        "elastic recoil detection analysis" ;
    skos:definition "Measurement method to elucidate composition and structure of the outermost atomic layers of a solid material, in which principally monoenergetic neutral atoms or singly charged probe ions are used to sputter atoms or ions out of the solid surface, their energy being recorded at one or more angle of scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct recoil spectroscopy" .

goldbook:09176 a skos:Concept ;
    skos:altLabel "LEIS, LEISS" ;
    skos:definition "Measurement method to elucidate the composition and structure of the very outermost atomic layers of a solid material, in which principally monoenergetic, singly-charged probe ions scattered from the surface are detected and recorded as a function of their energy, angle of scattering, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-energy ion scattering spectrometry" .

goldbook:09177 a skos:Concept ;
    skos:altLabel "MEIS, MEISS" ;
    skos:definition "Measurement method to elucidate the composition and structure of the outermost atomic layers of a solid material, in which principally monoenergetic, singly-charged probe ions scattered from the surface are detected and recorded as a function of their energy, angle of scattering, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medium-energy ion scattering spectrometry" .

goldbook:09178 a skos:Concept ;
    skos:altLabel "RBS" ;
    skos:definition "Measurement method to elucidate composition and structure of layers at the surface of a solid material, in which principally monoenergetic, singly charged probe ions scattered from the surface with a Rutherford cross section are detected and recorded as a function of their energy or angle of scattering, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rutherford backscattering spectrometry" .

goldbook:09179 a skos:Concept ;
    skos:altLabel "DAPCI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of a nearby corona discharge in a humid carrier gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption atmospheric pressure chemical ionization mass spectrometry" .

goldbook:09180 a skos:Concept ;
    skos:altLabel "DAPPI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of desorption by a jet of hot solvent vapour and ionization by ultraviolet light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption atmospheric pressure photoionization mass spectrometry" .

goldbook:09181 a skos:Concept ;
    skos:altLabel "DESI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the bombardment by ionized solvent droplets generated by pneumatically assisted electrospray ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption electrospray ionization mass spectrometry" .

goldbook:09182 a skos:Concept ;
    skos:altLabel "DART" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the interaction with a beam containing metastable, excited atoms heated to about \\(\\pu{500^{\\circ}C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct analysis in real time" .

goldbook:09183 a skos:Concept ;
    skos:definition "Secondary-ion mass spectrometry analysis with primary ion current density sufficiently high for use in the analysis of sample surface layers in the depth direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic secondary-ion mass spectrometry" .

goldbook:09184 a skos:Concept ;
    skos:altLabel "ELDIMS" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge quotient and the abundance of ionized entities emitted from a sample in air via ablation by a focused pulsed laser while simultaneously directing an electrospray jet through the desorbed plume to enhance sample ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrospray laser desorption ionization mass spectrometry" .

goldbook:09185 a skos:Concept ;
    skos:altLabel "EESI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of an inert gas being passed over the sample to pick up the molecules, which are subsequently ionized by ionized solvent droplets generated by pneumatically assisted electrospray ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extractive electrospray ionization mass spectrometry" .

goldbook:09186 a skos:Concept ;
    skos:definition "Variant of static secondary-ion mass spectrometry in which the intensities for each mass in two spectra from the same area, recorded with different beam energies or different bombarding ions, are ratioed to each other and the result is used to scale one of the spectra to generate a new spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "G-SIMS" .

goldbook:09187 a skos:Concept ;
    skos:altLabel "LAESI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of laser ablation and electrospray ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser ablation electrospray ionization mass spectrometry" .

goldbook:09188 a skos:Concept ;
    skos:altLabel "MALDESI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities from a sample that has been mixed with a matrix whose role is enhancing the ion yield produced by laser ablation and electrospray ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix-assisted laser desorption electrospray ionization mass spectrometry" .

goldbook:09189 a skos:Concept ;
    skos:altLabel "MALDI" ;
    skos:definition "Measurement method in which a time-of-flight mass spectrometer is used to measure the ratio of mass to charge and the abundance of ions emitted, as a result of a short pulse of laser illumination, from a sample whose analyte is contained in a matrix that assists the formation of ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix-assisted laser desorption/ionization mass spectrometry" .

goldbook:09190 a skos:Concept ;
    skos:altLabel "PADI" ;
    skos:definition "Measurement method in which a mass spectrometer is used to measure the ratio of mass to charge and the abundance of ionized entities emitted from a sample in air as a result of the bombardment by a focused plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma assisted desorption ionization mass spectrometry" .

goldbook:09191 a skos:Concept ;
    skos:definition "Mode of desorption electrospray ionization mass spectrometry with reactive chemicals within the spray solution to enhance the analytical specificity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive desorption electrospray ionization mass spectrometry" .

goldbook:09192 a skos:Concept ;
    skos:altLabel "SIMS" ;
    skos:definition "Measurement method in which a focused beam of primary ions produces secondary ions by sputtering from a solid surface. The secondary ions are analysed by mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary-ion mass spectrometry" .

goldbook:09193 a skos:Concept ;
    skos:altLabel "SSIMS" ;
    skos:definition "Method of secondary-ion mass spectrometry using low current densities for analysis of sample surface components, in contrast with dynamic secondary-ion mass spectrometry, which is used for analysis of components in the depth direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static secondary-ion mass spectrometry" .

goldbook:09194 a skos:Concept ;
    skos:altLabel "SALDI" ;
    skos:definition "Matrix-assisted laser desorption/ionization mass spectrometry using a combined liquid and particulate matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-assisted laser desorption/ionization mass spectrometry" .

goldbook:09195 a skos:Concept ;
    skos:altLabel "ATRIRS" ;
    skos:definition "Attenuated total reflection spectroscopy in which the infrared absorption spectrum of a sample in contact with a prism is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attenuated total reflection infrared spectroscopy" .

goldbook:09196 a skos:Concept ;
    skos:altLabel "diffuse reflectance infrared Fourier transform spectroscopy" ;
    skos:definition "Measurement method in which the infrared absorption spectrum of light reflected and transmitted from powdered samples is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuse reflection-absorption infrared spectroscopy" .

goldbook:09197 a skos:Concept ;
    skos:definition "Measurement method for the thickness of transparent surface films and layers and for the refractive index of a reflecting material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ellipsometry" .

goldbook:09198 a skos:Concept ;
    skos:altLabel "EXAFS" ;
    skos:definition "X-ray absorption fine structure spectroscopy in the energy region from the core-level edge to an energy several hundred $\\pu{eV}$ greater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extended X-ray absorption fine structure spectroscopy" .

goldbook:09199 a skos:Concept ;
    skos:altLabel "GISAXS" ;
    skos:definition "Measurement method in which the elastically scattered intensity of X-rays from a reflecting surface is measured for small-angle deflections at grazing incidence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grazing-incidence small-angle X-ray scattering analysis" .

goldbook:09200 a skos:Concept ;
    skos:altLabel "diffuse X-ray reflectometry" ;
    skos:definition "X-ray reflectometry in which significant scattered intensity arises from imperfections in the specimen, the scattered intensity falling outside the specular condition (see specular X-ray reflectometry)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "off-specular X-ray reflectometry" .

goldbook:09201 a skos:Concept ;
    skos:altLabel "infrared reflection-absorption spectroscopy" ;
    skos:definition "Spectroscopy based on reflection-absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflection-absorption infrared spectroscopy" .

goldbook:09202 a skos:Concept ;
    skos:altLabel "SNOM",
        "near-field optical microscopy",
        "near-field scanning optical microscopy (NSOM)" ;
    skos:definition "Measurement method in microscopy in which spectroscopic data may be collected with the detector closer to the sample than the optical wavelength employed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning near-field optical microscopy" .

goldbook:09203 a skos:Concept ;
    skos:definition "Measurement method in which the elastically scattered intensity of X-rays is measured for small-angle deflections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "small-angle X-ray scattering" .

goldbook:09204 a skos:Concept ;
    skos:definition "Mode of X-ray reflectrometry in which the angle between the detected beam and the sample surface is equal to that of the incident beam and the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specular X-ray reflectrometry" .

goldbook:09205 a skos:Concept ;
    skos:altLabel "SFGS",
        "vibrational sum frequency spectroscopy (VSFS)" ;
    skos:definition "Measurement method from non-linear optics in which a structurally-ordered sample at an interface between two phases is irradiated by single frequency visible and variable frequency infrared pulses of light to generate a sum frequency vibrational spectrum of the interfacial species without any bulk phase contribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sum frequency generation spectroscopy" .

goldbook:09206 a skos:Concept ;
    skos:altLabel "SEXAFS" ;
    skos:definition "Extended X-ray absorption fine structure spectroscopy in which, instead of measuring X-ray absorption, electron emission arising from that absorption is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface extended X-ray absorption fine structure spectroscopy" .

goldbook:09207 a skos:Concept ;
    skos:altLabel "SEIRAS" ;
    skos:definition "Measurement method giving enhanced infrared absorption in the measured infrared spectrum of a sample adsorbed on a roughened thin metal substrate. The metal substrate is deposited onto a prism and data is collected by total internal reflection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced infrared spectroscopy" .

goldbook:09209 a skos:Concept ;
    skos:altLabel "SERRS" ;
    skos:definition "Measurement method of surface-enhanced Raman spectroscopy (SERS) by which the Raman spectrum is significantly enhanced under the conditions that, whilst undergoing SERS, the molecules are excited by radiation that is in resonance with electronic transitions in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced resonant Raman spectroscopy" .

goldbook:09210 a skos:Concept ;
    skos:altLabel "TERS" ;
    skos:definition "Measurement method of Raman spectroscopy combining surface-enhanced Raman spectroscopy and scanning using an atomic force microscope or scanning tunnelling microscope to produce maps of a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tip enhanced raman spectroscopy" .

goldbook:09211 a skos:Concept ;
    skos:altLabel "TXRF" ;
    skos:definition "Measurement method in which an X-ray spectrometer is used to measure the energy distribution of fluorescence X-rays emitted from a surface irradiated by primary X-rays under the condition of total reflection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total reflection X-ray fluorescence spectroscopy" .

goldbook:09212 a skos:Concept ;
    skos:altLabel "XAFS" ;
    skos:definition "Measurement method to measure the absorption of X-rays at energies near and above (typically several hundred \\(\\pu{eV}\\) greater) an absorption edge, over which fine structure (modulation of the X-ray absorption coefficient) can be detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray absorption fine structure spectroscopy" .

goldbook:09213 a skos:Concept ;
    skos:altLabel "XANES",
        "near-edge extended X-ray absorption fine structure spectroscopy (NEXAFS)" ;
    skos:definition "X-ray absorption fine structure spectroscopy in the energy region near (within approximately \\(\\pu{100 eV}\\)) an absorption edge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray absorption near-edge spectroscopy" .

goldbook:09214 a skos:Concept ;
    skos:altLabel "XRR" ;
    skos:definition "Measurement method for surface and interface roughness and density, layer thickness of thin layers, and electron density profile achieved by reflecting X-rays from a flat sample and analysing the reflected intensity as a function of angle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray reflectometry" .

goldbook:09215 a skos:Concept ;
    skos:altLabel "XSW" ;
    skos:definition "Measurement method based on the interference of X-rays that occurs near the Bragg condition at the surface of a crystalline solid, which leads to intensity maxima in yields of photoelectrons as the Bragg condition is scanned by tilting the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray standing waves" .

goldbook:09216 a skos:Concept ;
    skos:definition "Coefficient for an element by which the measured intensity for that element is divided to yield the atomic concentration or atomic fraction of the element present in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute elemental sensitivity factor" .

goldbook:09217 a skos:Concept ;
    skos:definition "Surface region of a material under particle bombardment where the chemical state or physical structure is modified by the effects of the bombardment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "altered layer" .

goldbook:09218 a skos:Concept ;
    skos:definition "Two-dimensional region of a sample surface measured in the plane of that surface, from which the entire analytical signal or a specified fraction of that signal is detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analysis area" .

goldbook:09219 a skos:Concept ;
    skos:definition "Two-dimensional region of a sample surface at the analytical point, but set in the plane at right angles to the spectrometer axis, from which the entire analytical signal or a specified fraction of that signal is detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analysis area" .

goldbook:09220 a skos:Concept ;
    skos:definition "Sample preparation in which a sample is mechanically polished at an angle to the original surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle lapping" .

goldbook:09221 a skos:Concept ;
    skos:altLabel "emission angle" ;
    skos:definition "Angle between the trajectory of a particle or photon, as it leaves a surface, and the local or average surface normal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle of emission" .

goldbook:09222 a skos:Concept ;
    skos:definition "Areic dose introduced into a solid in time interval \\(t\\) divided by \\(t\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "areic dose rate" .

goldbook:09223 a skos:Concept ;
    skos:altLabel "dose" ;
    skos:definition "Number, \\(N\\), of energetic particles of a specified type introduced into a solid through a surface area \\(A\\) divided by \\(A\\). \\(D = N/A\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "areic dose" .

goldbook:09224 a skos:Concept ;
    skos:altLabel "surface energy" ;
    skos:definition "Energy required to increase a surface area at thermodynamic equilibrium divided by that increase in area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "areic surface energy" .

goldbook:09225 a skos:Concept ;
    skos:definition "Migration of sample atoms due to energy transfer with incident particles in the surface region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic mixing" .

goldbook:09226 a skos:Concept ;
    skos:definition "Process in which an electron, tunnelling from the conduction band of a solid, neutralizes an incoming ion and an electron is ejected from a surface atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger neutralization" .

goldbook:09227 a skos:Concept ;
    skos:definition "Electric charge of specified polarity in a beam passing in time interval \\(t\\), divided by \\(t\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average beam current" .

goldbook:09228 a skos:Concept ;
    skos:definition "Energy of a particle from the primary beam after it has undergone a backscattering collision and escaped from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattering energy" .

goldbook:09229 a skos:Concept ;
    skos:definition "Procedure in which the sample is abraded by a sphere in order to expose compositional changes in layers below the original surface, with the intent that the depth of those layers can be related to the lateral position in the crater created by the abrasion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ball cratering" .

goldbook:09230 a skos:Concept ;
    skos:altLabel "elastic scattering" ;
    skos:definition "Collision between a moving particle and a second particle in which total kinetic energy and total momentum are conserved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binary elastic scattering" .

goldbook:09231 a skos:Concept ;
    skos:definition "Empirical rule formulated by W.H. Bragg and R. Kleeman that states that the stopping cross section of a compound sample is equal to the sum of the products of the elemental stopping cross sections for each constituent and its atomic fraction. \\[S_{\\ce{AB}}(\\varepsilon) = xS_{\\ce{A}}(\\varepsilon) + yS_{\\ce{B}}(\\varepsilon)\\] where \\(S_{\\ce{AB}}(\\varepsilon)\\) is the stopping cross section of the compound \\(\\ce{A}_{x}\\ce{B}_{y}\\), and \\(S_{\\ce{A}}(\\varepsilon)\\) and \\(S_{\\ce{B}}(\\varepsilon)\\) are the stopping cross sections of elements \\(\\ce{A}\\) and \\(\\ce{B}\\), respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bragg’s rule" .

goldbook:09232 a skos:Concept ;
    skos:definition "Diffusion-like process in which atoms of material are moved randomly by energy deposited by incident particles slowing down in the sample surface region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cascade mixing" .

goldbook:09233 a skos:Concept ;
    skos:definition "Preferential motion of energetic particles along the crystal axes of a crystalline solid as the particles move through the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "channeling" .

goldbook:09234 a skos:Concept ;
    skos:definition "Maintenance at a fixed potential, usually near neutrality, of the surface of a non-conducting or poorly conducting sample material under bombardment by primary particles or photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge neutralization" .

goldbook:09235 a skos:Concept ;
    skos:definition "Electric potential of the surface region of an insulating sample, caused by irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charging potential" .

goldbook:09236 a skos:Concept ;
    skos:definition "Surface map using signals proportional to the amount of an element in a particular chemical state in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical map" .

goldbook:09237 a skos:Concept ;
    skos:definition "Non-ideal focus of an electron or ion optical system for electrons or ions of different energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatic aberration" .

goldbook:09238 a skos:Concept ;
    skos:definition "Sequential energy transfer between atoms in a solid as a result of bombardment by an energetic species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision cascade" .

goldbook:09239 a skos:Concept ;
    skos:altLabel "CDP" ;
    skos:definition "Chemical composition measured as a function of distance normal to the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compositional depth profile" .

goldbook:09240 a skos:Concept ;
    skos:definition "Average depth of the region of a crater from which the measured signal is derived." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crater depth" .

goldbook:09241 a skos:Concept ;
    skos:definition "Sample preparation in which the sample is cleaved, cut, or polished in a plane perpendicular to the interface under study, so that associated compositional differences or gradients can be observed in that plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-sectioning" .

goldbook:09242 a skos:Concept ;
    skos:definition "Particle fluence above which significant changes in the spectrum or in a stated peak, arising from damage processes, are observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "damage limit" .

goldbook:09243 a skos:Concept ;
    skos:definition "Layer of discrete composition, one atom thick, formed during the growth of material on a substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delta layer" .

goldbook:09244 a skos:Concept ;
    skos:definition "Monitoring of signal intensity as a function of a variable that can be related to distance normal to the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth profiling" .

goldbook:09245 a skos:Concept ;
    skos:definition "Parameter that can be used as a coefficient in an analytic fit to a measured compositional depth profile or as a qualitative way of describing that profile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth resolution parameter" .

goldbook:09246 a skos:Concept ;
    skos:definition "Cross section for binary elastic scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastic scattering cross section" .

goldbook:09247 a skos:Concept ;
    skos:definition "Irradiation of a sample with low-energy electrons in order to change or stabilize the charging potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron flooding" .

goldbook:09248 a skos:Concept ;
    skos:definition "Surface map using signals proportional to the amount of an element present in a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elemental map" .

goldbook:09249 a skos:Concept ;
    skos:definition "Change in the position of the surface as a result of particle or photon irradiation divided by time of irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erosion rate" .

goldbook:09250 a skos:Concept ;
    skos:definition "Effect occurring in insulators or semi-conductors where internal electric fields cause the migration of sample atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field-induced migration" .

goldbook:09251 a skos:Concept ;
    skos:definition "\\(\\mathit{\\Phi} = {\\rm{d}}N/{\\rm{d}}t\\), where \\(N\\) is number of particles of a specified type and \\(t\\) is time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flux of a beam of particles" .

goldbook:09252 a skos:Concept ;
    skos:altLabel "FIB" ;
    skos:definition "Ion beam system used for machining small regions with sub-micron precision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "focused ion beam system" .

goldbook:09253 a skos:Concept ;
    skos:definition "Number of atoms and ions of a particular species sputtered from a sample divided by the total number of atoms and ions sputtered from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractional sputtering yield" .

goldbook:09254 a skos:Concept ;
    skos:definition "Three-dimensional representation of the spatial distribution of a particular elemental or molecular species, as indicated by emitted secondary ions or electrons, as a function of depth or material removed by sputtering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image depth profile" .

goldbook:09255 a skos:Concept ;
    skos:definition "Kinetic energy of particles on impact with a sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impact energy" .

goldbook:09256 a skos:Concept ;
    skos:definition "Number, \\(N_{\\rm{imp}}\\), of energetic particles of a specified type incident on a solid within a surface area \\(A\\) and stopped within the solid divided by \\(A\\). \\(D_{\\rm{imp}} = N_{\\rm{imp}}/A\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "implanted areic dose" .

goldbook:09257 a skos:Concept ;
    skos:definition "Maximum depth, normal to the surface, from which useful information is obtained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "information depth" .

goldbook:09258 a skos:Concept ;
    skos:definition "Maximum radius of a circular region, in the plane of the surface, from which useful information is obtained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "information radius" .

goldbook:09259 a skos:Concept ;
    skos:definition "Depth resolution in a sample arising from parameters of the instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instrumental depth resolution" .

goldbook:09260 a skos:Concept ;
    skos:definition "Directed flux of charged atoms or molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion beam" .

goldbook:09261 a skos:Concept ;
    skos:definition "Injection of ions into a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion implantation" .

goldbook:09262 a skos:Concept ;
    skos:definition "Plot of output signal intensity from a spectrometer, signal intensity from another detector, or processed intensity information from the available software along a line corresponding to a line on the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line scan" .

goldbook:09263 a skos:Concept ;
    skos:definition "Factors, arising from the composition of the matrix, for multiplying the quotient of the measured intensity and the appropriate sensitivity factor in formulae to determine the composition using surface analytical techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix factor" .

goldbook:09264 a skos:Concept ;
    skos:definition "Average depth normal to the surface from which specified particles or radiations escape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean escape depth" .

goldbook:09265 a skos:Concept ;
    skos:definition "Number of atoms and ions of a particular species sputtered from a sample divided by the total number of incident particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial sputtering yield" .

goldbook:09266 a skos:Concept ;
    skos:definition "Energy value corresponding to the intensity maximum in a direct spectrum or to the intensity minimum (i.e. the negative excursion) for a differential spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak energy" .

goldbook:09267 a skos:Concept ;
    skos:definition "Total ionization cross section for an incident photon of a given energy interacting with a material to produce one or more photoelectrons from all sub-shells that are energetically accessible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoionization cross section" .

goldbook:09268 a skos:Concept ;
    skos:altLabel "bulk plasmon",
        "volume plasmon" ;
    skos:definition "Excitation of valence-band electrons in a solid in which collective oscillations are generated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasmon" .

goldbook:09269 a skos:Concept ;
    skos:definition "Change in equilibrium surface composition of the sample, which can occur when sputtering multicomponent samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preferential sputtering" .

goldbook:09270 a skos:Concept ;
    skos:definition "Directed flux of beam particles or photons incident on a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary beam" .

goldbook:09271 a skos:Concept ;
    skos:definition "Distance from the surface at which an energetic ion or atom comes to rest in the sample, projected along the direction of the beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "projected range" .

goldbook:09272 a skos:Concept ;
    skos:definition "Sample preparation in which a sample is polished by a cylinder in order to expose compositional changes below the original sample surface, with the intent that the depth of these layers can be related to the position on the surface created by the cylinder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radial sectioning" .

goldbook:09273 a skos:Concept ;
    skos:definition "Standard deviation of the projected ranges of energetic ions or atoms of a given energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "range straggling" .

goldbook:09274 a skos:Concept ;
    skos:definition "Two-dimensional pattern generated by the deflection of a primary beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "raster" .

goldbook:09275 a skos:Concept ;
    skos:definition "Deposition of sputtered sample material back onto the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redeposition" .

goldbook:09276 a skos:Concept ;
    skos:altLabel "RISR" ;
    skos:definition "In Auger electron spectroscopy (AES), secondary-ion mass spectrometry, and X-ray photoelectron spectroscopy, the spectrometer response function divided by the response function of a reference instrument, or the average for several such instruments, as a function of energy (AES, XPS, etc.) or mass (SIMS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative instrument spectral response function" .

goldbook:09277 a skos:Concept ;
    skos:definition "Resolution of a spectrometer at a given energy, mass, or wavelength divided by that energy, mass, or wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative resolution" .

goldbook:09278 a skos:Concept ;
    skos:definition "Sputtering rate of a sample divided by the sputtering rate of a reference sample sputtered under the same conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative sputtering rate" .

goldbook:09279 a skos:Concept ;
    skos:definition "Electric potential applied to the whole or part of the sample, referenced to the electric potential of the sample holder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample bias" .

goldbook:09280 a skos:Concept ;
    skos:definition "Change in the electrical potential in the sample or on the sample surface caused by particle or photon bombardment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample charging" .

goldbook:09281 a skos:Concept ;
    skos:definition "Electric potential difference of the sample referenced to ground." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample voltage" .

goldbook:09282 a skos:Concept ;
    skos:definition "Solid angle allowing particles or photons to be transmitted from a point on the sample to the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid angle of analyser" .

goldbook:09283 a skos:Concept ;
    skos:definition "Number of particles detected with a spectrometer divided by the number of such particles per solid angle and per interval of the dispersing parameter available for measurement as a function of the dispersing parameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrometer response function" .

goldbook:09284 a skos:Concept ;
    skos:altLabel "analyser transmission function" ;
    skos:definition "Number of particles transmitted by the analyser divided by the number of such particles per solid angle and per interval of the dispersing parameter (e.g. energy, mass, or wavelength) available for measurement as a function of the dispersing parameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrometer transmission function" .

goldbook:09285 a skos:Concept ;
    skos:altLabel "SDP" ;
    skos:definition "Compositional depth profile obtained when the surface composition is measured while material is removed by sputtering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sputter depth profile" .

goldbook:09286 a skos:Concept ;
    skos:definition "Amount, mass, or number of entities of sample material removed, as a result of particle bombardment, per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sputtering rate" .

goldbook:09287 a skos:Concept ;
    skos:definition "Number of atoms and ions sputtered from a sample divided by the total number of incident primary particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sputtering yield" .

goldbook:09288 a skos:Concept ;
    skos:definition "Electric potential \\(\\pu{4.500 eV}\\) above the Fermi level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard vacuum level" .

goldbook:09289 a skos:Concept ;
    skos:definition "State of the sputtering process in which important operational and analytical parameters are unchanging over a meaningful timescale." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steady-state sputtering" .

goldbook:09290 a skos:Concept ;
    skos:altLabel "equilibrium surface composition sputtering" ;
    skos:definition "Steady-state surface composition produced by sputtering a homogeneous sample under non-varying conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steady-state surface composition sputtering" .

goldbook:09291 a skos:Concept ;
    skos:definition "State of the sputtering process in which the relative amounts of the elemental components sputtered from a sample are equal to their stoichiometry within the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stoichiometric sputtering" .

goldbook:09292 a skos:Concept ;
    skos:definition "For an interface, the difference between the amount of component actually present in the system and that which would be present (in a reference system) if the bulk concentration in the adjoining phases were maintained up to a chosen geometrical dividing surface (Gibbs dividing surface)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess amount" .

goldbook:09293 a skos:Concept ;
    skos:definition "Two- or three-dimensional representation of the sample surface where the information at each point in the representation, given by a brightness or colour or as a length in a third dimension, is related to the output signal from a detector or processed intensity information from the available software." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface map" .

goldbook:09294 a skos:Concept ;
    skos:definition "Collective motion of electrons on an interface of two phases which have different permittivity, of which one must have electrical conductivity to sustain the collective motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface plasmon" .

goldbook:09295 a skos:Concept ;
    skos:definition "Partitioning of a species from the bulk of a material to the surface as a result of kinetic or thermodynamic effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface segregation" .

goldbook:09296 a skos:Concept ;
    skos:definition "Angle between the trajectory of a particle as it leaves a surface and the local or average surface plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "take-off angle" .

goldbook:09297 a skos:Concept ;
    skos:definition "Parameter describing the apparent work function of a solid that controls the electronic current density, \\(J\\), emitted from a conductor at temperature \\(T\\). \\(W = -kT\\ln(J/AT^{2})\\), where \\(k\\) is the Boltzmann constant and \\(A\\) is the Richardson constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermionic work function" .

goldbook:09298 a skos:Concept ;
    skos:definition "Contrast in a surface map or image arising from the topography of the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topographic contrast" .

goldbook:09299 a skos:Concept ;
    skos:definition "Number of ions of both signs sputtered from a sample divided by the number of incident particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total ion yield" .

goldbook:09300 a skos:Concept ;
    skos:altLabel "local vacuum level" ;
    skos:definition "Energy level of an electron positioned at rest just outside a solid, i.e. with zero kinetic energy with respect to the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vacuum level" .

goldbook:09301 a skos:Concept ;
    skos:definition "Electric potential of the vacuum at a point in space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vacuum level at infinity" .

goldbook:09302 a skos:Concept ;
    skos:definition "Volume sputtered from a sample divided by number of incident particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume yield" .

goldbook:09303 a skos:Concept ;
    skos:definition "Energy width of the principal characteristic X-ray line." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray linewidth" .

goldbook:09304 a skos:Concept ;
    skos:definition "Device used to eliminate photons of energies other than those in a narrow energy or wavelength band." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray monochromator" .

goldbook:09305 a skos:Concept ;
    skos:definition "In X-ray photoelectron spectroscopy, measurement of the charging potential of a particular sample from a comparison of the experimentally measured \\(\\ce{C 1s}\\) binding energy, arising from adsorbed hydrocarbons on the sample, with a standard binding energy value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adventitious carbon referencing" .

goldbook:09306 a skos:Concept ;
    skos:definition "In X-ray photoelectron spectroscopy factor which characterizes the intensity distribution, \\(L(\\gamma)\\), of photoelectrons ejected by X-rays from isolated atoms at an angle \\(\\gamma\\) from the incident X-ray direction. In the dipole approximation, \\(L(\\gamma) = 1 + ½\\beta [3(\\sin^{2}\\gamma)/2-1]\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetry parameter" .

goldbook:09307 a skos:Concept ;
    skos:definition "Plot of intensity of Auger electrons as a function of the electron kinetic energy, usually as part of the energy distribution of detected electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger electron spectrum" .

goldbook:09308 a skos:Concept ;
    skos:definition "Kinetic energy of a narrow Auger electron peak in a spectrum minus the kinetic energy of the most intense X-ray photoelectron peak from the same element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger parameter" .

goldbook:09309 a skos:Concept ;
    skos:definition "Emission of an Auger electron in which additional spectator holes are present in the initial state or the final state) for the transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger vacancy satellite" .

goldbook:09310 a skos:Concept ;
    skos:altLabel "AMRSF" ;
    skos:definition "Coefficient, proportional to the intensity, calculated for an element in an average matrix, by which the measured intensity for that element is divided in calculations to yield the atomic concentration or atomic fraction of the element present in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average matrix relative sensitivity factor" .

goldbook:09311 a skos:Concept ;
    skos:definition "Electron, originating in the incident beam, which is emitted after interaction with the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattered electron" .

goldbook:09312 a skos:Concept ;
    skos:definition "In Auger electron spectroscopy, factor equal to the total Auger-electron current arising from ionizations in the sample caused by both primary electrons and backscattered electrons divided by the Auger-electron current arising directly from the primary electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattering correction factor" .

goldbook:09313 a skos:Concept ;
    skos:definition "In Auger electron spectroscopy, Auger-electron current arising from ionizations in the sample caused by backscattered electrons divided by Auger-electron current arising directly from the primary electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattering fraction" .

goldbook:09314 a skos:Concept ;
    skos:altLabel "backscattering coefficient" ;
    skos:definition "Number of electrons emitted from the sample with energies greater than \\(\\pu{50 eV}\\) divided by the number of electrons incident at a given energy and angle of incidence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattering yield" .

goldbook:09315 a skos:Concept ;
    skos:definition "Inelastic scattering of electrons in solids that produces a non-uniform energy loss spectrum determined by the characteristics of the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic electron energy losses" .

goldbook:09316 a skos:Concept ;
    skos:definition "Measurement of charging potential of a sample in order to correct the measured energies so that those energies correspond to a sample with no surface charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge referencing" .

goldbook:09317 a skos:Concept ;
    skos:definition "State of an atom arising from its chemical interaction with neighbouring atoms in a molecule, compound, solid, liquid, or gas that leads to a characteristic energy or feature observable in electron spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical state" .

goldbook:09318 a skos:Concept ;
    skos:altLabel "Wagner plot" ;
    skos:definition "In X-ray photoelectron spectroscopy, plot of the measured kinetic energy of a sharp Auger electron peak versus the binding energy of a photoelectron peak for the same element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical state plot" .

goldbook:09319 a skos:Concept ;
    skos:definition "Differential of a direct spectrum with respect to energy by an analogue electrode modulation method or by the numerical differentiation of that spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential spectrum" .

goldbook:09320 a skos:Concept ;
    skos:definition "Spectrum of intensity of electrons transmitted and detected by a spectrometer with a dispersing energy analyser as a function of energy, \\(E\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct spectrum" .

goldbook:09321 a skos:Concept ;
    skos:definition "Electron or ion optical method of steering a spectrometer axis to align with the impact area of the primary beam at all points of a raster scan on the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic emittance matching" .

goldbook:09322 a skos:Concept ;
    skos:definition "Parameter that, when introduced in place of the electron inelastic mean free path into an expression derived for Auger electron spectroscopy and X-ray photoelectron spectroscopy on the assumption that elastic scattering effects are negligible for a given quantitative application, will correct that expression for elastic scattering effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective attenuation length" .

goldbook:09323 a skos:Concept ;
    skos:altLabel "Einstein equation" ;
    skos:definition "Equation relating the kinetic energy of an electron, emitted from a conductor illuminated by monochromatic photons, and the photon energy and work function of the surface from which the photoelectron is emitted. \\(½m_{\\rm{e}}  u_{\\rm{max}}^{2} = h u - \\phi_{0}\\), where \\(m_{\\rm{e}}\\) is the mass of an electron, \\( u_{\\rm{max}}\\) the maximum velocity of the emitted electron, \\(h\\) the Planck constant, \\( u\\) the frequency of the illuminating photons, and \\(\\phi_{0}\\) the photoelectric work function of the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Einstein photoelectric equation" .

goldbook:09324 a skos:Concept ;
    skos:definition "Peak in the electron spectrum, produced by quasi-elastically scattered electrons detected by an electron spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastic peak" .

goldbook:09325 a skos:Concept ;
    skos:definition "Measuring instrument for measuring the number of electrons, or an intensity proportional to that number, as a function of the electron kinetic energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron energy analyser" .

goldbook:09326 a skos:Concept ;
    skos:definition "Energy spectrum of electrons from a nominally monoenergetic source emitted after inelastic interactions with the sample, often exhibiting peaks due to specific inelastic loss processes (see characteristic electron energy losses and plasmon)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron energy loss spectrum" .

goldbook:09327 a skos:Concept ;
    skos:definition "Average distance that an electron with a given energy travels between successive inelastic collisions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron inelastic mean free path" .

goldbook:09328 a skos:Concept ;
    skos:definition "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, measurement method for kinetic energy distribution by retarding the emitted electrons before or within the electron energy analyser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron retardation" .

goldbook:09329 a skos:Concept ;
    skos:definition "Measuring system, the essential part of which is an electron energy analyser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron spectrometer" .

goldbook:09330 a skos:Concept ;
    skos:definition "In dynamic secondary-ion mass spectrometry, coefficient for an element by which the measured intensity of a mass peak for that element, divided by the measured intensity of a mass peak for the matrix, is multiplied to yield the atomic concentration of the element present in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elemental relative sensitivity factor" .

goldbook:09331 a skos:Concept ;
    skos:definition "Plasmon excited as an electron travels through a condensed medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrinsic plasmon" .

goldbook:09332 a skos:Concept ;
    skos:definition "Process for establishing the binding energy scale for a particular sample by assigning the kinetic energy corresponding to the Fermi level, as determined by analysis of the spectrum obtained from X-ray photoelectron spectroscopy or ultraviolet photoelectron spectroscopy, as the point of zero binding energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fermi level referencing" .

goldbook:09333 a skos:Concept ;
    skos:definition "Energy state of an atom after a particular Auger, X-ray, or photoemission process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "final energy state" .

goldbook:09334 a skos:Concept ;
    skos:altLabel "inelastic background" ;
    skos:definition "Intensity distribution in a spectrum for particles originally at one energy but which are emitted at lower energies due to one or more inelastic scattering processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inelastic electron scattering background" .

goldbook:09335 a skos:Concept ;
    skos:definition "Subtraction of a chosen inelastic electron scattering background from a measured spectrum in Auger electron spectroscopy and X-ray photoelectron spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inelastic electron scattering background subtraction" .

goldbook:09336 a skos:Concept ;
    skos:definition "Cross section for inelastic scattering by an electron traversing a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inelastic scattering cross section" .

goldbook:09337 a skos:Concept ;
    skos:definition "Core-hole excited state of an atom prior to Auger transition or to X-ray emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initial energy state" .

goldbook:09338 a skos:Concept ;
    skos:definition "Ground state of an atom prior to photoelectron emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initial energy state" .

goldbook:09339 a skos:Concept ;
    skos:definition "\\(\\beta = 3E_{\\rm{B}} + E_{\\rm{K}}\\), where \\(E_{\\rm{B}}\\) and \\(E_{\\rm{K}}\\) are, respectively, the binding energy of a photoelectron peak and the Fermi level referenced (see Fermi level referencing) kinetic energy of an Auger electron peak, each involving the same initial core level of the same element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initial-state Auger parameter" .

goldbook:09340 a skos:Concept ;
    skos:definition "Auger transition in which at least one of the final electron vacancies is localized in valence levels or molecular orbitals of atoms adjacent to the atom in which the initial vacancy occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interatomic Auger process" .

goldbook:09341 a skos:Concept ;
    skos:definition "Energy shift observed in core-level photoelectron spectroscopy arising from the changed bonding and/or from the displacements of atoms from their bulk positions near an interface between two materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interface core-level shift" .

goldbook:09342 a skos:Concept ;
    skos:definition "Plasmon excited at the same time as the excitation of a core-level photoelectron or an Auger electron associated with the same locality as the excitation of the photoelectron or Auger electron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic plasmon" .

goldbook:09343 a skos:Concept ;
    skos:definition "Sum of the Fermi level referenced (see Fermi level referencing) kinetic energy of a narrow Auger electron peak in the spectrum and the binding energy of the most intense photoelectron peak from the same element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modified Auger parameter" .

goldbook:09344 a skos:Concept ;
    skos:definition "Mean kinetic energy of detected particles in the energy-dispersive portion of an electron energy analyser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pass energy" .

goldbook:09345 a skos:Concept ;
    skos:definition "Minimum photon energy required to liberate an electron from the surface of a conducting solid by absorption of that photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectric work function" .

goldbook:09346 a skos:Concept ;
    skos:altLabel "satellite peaks" ;
    skos:definition "Photoelectron peaks in a spectrum resulting from photoemission induced by characteristic minor X-ray lines associated with the X-ray spectrum of the anode material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectron X-ray satellite peaks" .

goldbook:09347 a skos:Concept ;
    skos:definition "Removal of photoelectron X-ray satellite peaks from a spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectron X-ray satellite subtraction" .

goldbook:09348 a skos:Concept ;
    skos:definition "Emission of electrons from atoms or molecules caused by the photoelectric effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoemission" .

goldbook:09349 a skos:Concept ;
    skos:altLabel "PERSF" ;
    skos:definition "In electron spectroscopy, coefficient, proportional to the intensity measured for a pure sample of an element, by which the measured intensity for that element is divided in calculations to yield the atomic concentration or atomic fraction of the element present in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pure-element relative sensitivity factor" .

goldbook:09350 a skos:Concept ;
    skos:definition "Energy associated with intra-atomic or extra-atomic electronic readjustment to the removal of an atomic electron, so as to minimize the energy of the final state of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relaxation energy" .

goldbook:09352 a skos:Concept ;
    skos:definition "Aperture in the electron or ion optical system restricting the detected signal to a small area of the sample surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selected-area aperture" .

goldbook:09353 a skos:Concept ;
    skos:definition "Multi-electron process in which two or more electrons are emitted, partitioning between them the excess kinetic energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shakeoff" .

goldbook:09354 a skos:Concept ;
    skos:definition "Multi-electron process in which an atom is left in an excited state following a photoionization or Auger electron process, so that the outgoing electron has a characteristic kinetic energy slightly less than that of the parent photoelectron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shakeup" .

goldbook:09355 a skos:Concept ;
    skos:definition "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, background calculated to fit the measured spectrum at points at greater and lesser kinetic energy than the peak or peaks of interest, such that the background contribution at a given kinetic energy is in a fixed proportion to the total peak area above that background for greater kinetic energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shirley background" .

goldbook:09356 a skos:Concept ;
    skos:definition "Electronic configuration of an atom containing an electronic vacancy that can be present during processes, such as Auger electron and X-ray photoelectron emission, but is not created or destroyed in the process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectator hole" .

goldbook:09357 a skos:Concept ;
    skos:definition "Cross section for an incident photon interacting with a material to produce one or more photoelectrons from a given sub-shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sub-shell photoionization cross section" .

goldbook:09358 a skos:Concept ;
    skos:definition "Energy shift observed in core-level photoelectron spectroscopy arising from the reduced coordination of the surface or near-surface atoms compared to bulk atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface core-level shift" .

goldbook:09359 a skos:Concept ;
    skos:definition "Total number of electrons emitted from a sample divided by the total number of electrons incident at a given energy and angle of incidence. \\(\\sigma = \\delta + \\eta\\), where \\(\\delta\\) is the secondary-electron yield and \\(\\eta\\) is the backscattering coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total secondary-electron yield" .

goldbook:09360 a skos:Concept ;
    skos:definition "In Auger electron spectroscopy and X-ray photoelectron spectroscopy, intensity distribution of the background due to inelastic scattering obtained from the differential inelastic scattering cross section with respect to energy loss and the three-dimensional distribution of the emitting atoms in the surface region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tougaard background" .

goldbook:09361 a skos:Concept ;
    skos:definition "Method of establishing the kinetic energy scale in which the zero point corresponds to an electron at rest at the vacuum level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vacuum level referencing" .

goldbook:09362 a skos:Concept ;
    skos:definition "X-ray photoelectron energy distribution arising from the excitation of electrons from the valence band of the sample material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence-band spectrum" .

goldbook:09363 a skos:Concept ;
    skos:definition "Backscattering spectrum recorded with the analysing beam aligned with crystallographic axes or planes of the sample that produce channelling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aligned incidence spectrum" .

goldbook:09364 a skos:Concept ;
    skos:definition "Plot of backscattering yield versus backscattering energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscattering spectrum" .

goldbook:09365 a skos:Concept ;
    skos:definition "Electrostatic or electromagnetic device used to generate pulses of ions from a continuous ion beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam chopper" .

goldbook:09366 a skos:Concept ;
    skos:definition "In ion-scattering spectrometry, increase in the spectrometer detection system response above the background signal, which can be attributed to the binary elastic scattering of an incident ion by a surface atom of a particular mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binary elastic scattering peak" .

goldbook:09367 a skos:Concept ;
    skos:definition "Experimental arrangement wherein the atom rows or planes of a single-crystal target are aligned parallel to a vector from the sample to the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blocking geometry" .

goldbook:09368 a skos:Concept ;
    skos:definition "Stopping cross section arising from energy transfer to the electrons of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic stopping cross section" .

goldbook:09369 a skos:Concept ;
    skos:definition "Values of the backscattering energy for an element, or for an isotope, that is located at the surface of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy edge" .

goldbook:09370 a skos:Concept ;
    skos:definition "Simplification of calculations involving the energy of an ion passing through a solid sample, where the energy of the ion at the surface is used in place of a properly averaged energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface approximation energy" .

goldbook:09371 a skos:Concept ;
    skos:definition "Cross section of an atom for elastic scattering that is greater than the Rutherford cross section due to partial penetration of a nucleus in the sample by the incident particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enhanced elastic cross section" .

goldbook:09372 a skos:Concept ;
    skos:definition "Measured response of the energy filtering and detection system as a consequence of bombarding the sample material with an ion beam, usually presented as the ordinate of an ion-scattering spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "experimental scattered-ion intensity" .

goldbook:09373 a skos:Concept ;
    skos:definition "Plot of the intensities of ions, scattered from a sample, as a function of the scattered-ion energy divided by the incident-ion energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-scattering spectrum" .

goldbook:09374 a skos:Concept ;
    skos:definition "Particle energy after an elastic collision divided by the energy before the collision, in the laboratory frame of reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinematic factor" .

goldbook:09375 a skos:Concept ;
    skos:definition "Cross section at a given beam energy and emission direction of the detected product for a particular nuclear reaction per atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear reaction cross section" .

goldbook:09376 a skos:Concept ;
    skos:definition "Stopping cross section arising from energy transfer to atomic nuclei of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear stopping cross section" .

goldbook:09377 a skos:Concept ;
    skos:definition "Counts in a backscattering spectrum arising from two or more separate events that occur so closely in time that the signals are not resolved by the detection system and cause counts to be recorded in erroneous channels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pileup" .

goldbook:09378 a skos:Concept ;
    skos:definition "Ion intentionally produced by an ion source and directed onto the sample surface at a known angle of incidence and a known energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "probe ion" .

goldbook:09379 a skos:Concept ;
    skos:definition "Backscattering spectrum recorded with the analysing beam incident on the sample in a direction such as to produce no channelling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random incidence spectrum" .

goldbook:09380 a skos:Concept ;
    skos:definition "Nuclear reaction that has a narrow peak in the nuclear reaction cross section as a function of energy, the nuclear reaction cross section at the peak being so much larger than the nuclear reaction cross sections at adjacent energies on either side of the peak that essentially all the particles detected from the reaction are due to the peak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance reaction" .

goldbook:09381 a skos:Concept ;
    skos:definition "Elastic scattering cross section calculated using classical mechanics and a Coulomb potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rutherford cross section" .

goldbook:09382 a skos:Concept ;
    skos:definition "Kinetic energy of a primary ion after a collision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattered-ion energy" .

goldbook:09383 a skos:Concept ;
    skos:definition "Scattered-ion energy divided by energy of the incident probe ion prior to a collision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattered-ion energy ratio" .

goldbook:09384 a skos:Concept ;
    skos:definition "Response arising from electrons in an atom causing an apparent reduction in the coulomb potential of the nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "screening" .

goldbook:09385 a skos:Concept ;
    skos:definition "Factor by which the Rutherford cross section is reduced as a result of screening in a given experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "screening function" .

goldbook:09386 a skos:Concept ;
    skos:definition "Energy loss of a particle scattered at a given depth in the sample, and detected at a given angle, by the product of the atomic density of the sample atoms and the depth of scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stopping cross section factor" .

goldbook:09387 a skos:Concept ;
    skos:definition "Rate of energy loss of a particle with distance along its trajectory in a sample divided by the atomic density of sample atoms for a sample of infinitesimal thickness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stopping cross section" .

goldbook:09388 a skos:Concept ;
    skos:definition "Ion moving with a velocity exceeding the Bohr speed of \\(c/137\\), where \\(c\\) is the velocity of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "swift ion" .

goldbook:09389 a skos:Concept ;
    skos:definition "Energy resolution or depth resolution measured in a backscattering spectrum for a monoenergetic incident-ion beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "system resolution" .

goldbook:09390 a skos:Concept ;
    skos:definition "Calculated intensity for probe ions scattered into a specified solid angle at a given direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "theoretical scattered-ion intensity" .

goldbook:09391 a skos:Concept ;
    skos:definition "In energetic-ion analysis and Rutherford backscattering spectrometry, sample whose thickness is sufficiently small that the variation in energy of particles backscattered from atoms of each constitutive element is small with respect to the system resolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thin target" .

goldbook:09392 a skos:Concept ;
    skos:definition "Action to prevent secondary ions from travelling through the mass spectrometer and being detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analyser blanking" .

goldbook:09393 a skos:Concept ;
    skos:definition "Reduction in the spread of arrival times of an ion pulse by reduction in the speed of the leading ions or acceleration of those at the trailing edge of the pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam bunching" .

goldbook:09394 a skos:Concept ;
    skos:definition "Device to shorten the time length of a pulse of ions so that they arrive at a point over a reduced time interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "buncher" .

goldbook:09395 a skos:Concept ;
    skos:definition "Atomic fraction or concentration of impurity species in a homogeneous matrix below which the secondary-ion mass spectrometry can safely be assumed to be linear with composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilute limit" .

goldbook:09396 a skos:Concept ;
    skos:definition "Cross section for the loss of intensity of an ion signal observed as a result of the bombardment by primary ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disappearance cross section" .

goldbook:09397 a skos:Concept ;
    skos:definition "In secondary-ion mass spectrometry, sputter depth profiling involving two ion guns." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual-beam profiling" .

goldbook:09398 a skos:Concept ;
    skos:definition "In secondary-ion mass spectrometry, electric field above a sample, operational during ion emission from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction field" .

goldbook:09399 a skos:Concept ;
    skos:definition "Electric potential, referenced to the sample, of the electrode defining the field above the sample and used to facilitate introduction of emitted ions into the mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extractor voltage" .

goldbook:09400 a skos:Concept ;
    skos:altLabel "FAB-SIMS" ;
    skos:definition "Secondary ion mass spectrometry in which the primary-ion beam is replaced by a fast-atom beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast-atom bombardment secondary ion mass spectrometry" .

goldbook:09401 a skos:Concept ;
    skos:definition "Number of ions of a particular species sputtered from a sample divided by number of particles of that species sputtered from that sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractional ion yield" .

goldbook:09402 a skos:Concept ;
    skos:definition "Power for the ratio of mass intensities in two mass spectra measured for two different primary ion conditions, used to generate the G-SIMS spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "g index" .

goldbook:09403 a skos:Concept ;
    skos:altLabel "G-SIMS-FPM" ;
    skos:definition "Development of G-SIMS in which the g index is varied in order to deduce the linkages between product ions and precursor ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "G-SIMS with fragmentation pathway mapping" .

goldbook:09404 a skos:Concept ;
    skos:definition "Intensity of analyte ion divided by intensity of matrix ion, both corrected for isotopic abundance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion beam ratio" .

goldbook:09405 a skos:Concept ;
    skos:altLabel "LMIG" ;
    skos:definition "Ion gun utilizing a liquid-metal Taylor cone as the source of the primary ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-metal ion gun" .

goldbook:09406 a skos:Concept ;
    skos:definition "Measured mass minus reference value for that mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass accuracy" .

goldbook:09407 a skos:Concept ;
    skos:definition "Intensity in a mass spectrum arising from ions that spontaneously fragment between emission and detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metastable background" .

goldbook:09408 a skos:Concept ;
    skos:definition "Ion or neutral particle that was part of a larger molecular structure and contains information about that structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular fragment" .

goldbook:09409 a skos:Concept ;
    skos:definition "Image of a surface formed from ions characteristic of a particular molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular image" .

goldbook:09410 a skos:Concept ;
    skos:definition "Number of negatively-charged secondary ions sputtered from a sample divided by total number of incident primary particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative-ion yield" .

goldbook:09411 a skos:Concept ;
    skos:altLabel "partial ion sputtering yield" ;
    skos:definition "Number of ions of a particular species sputtered from a sample divided by the number of incident particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial ion yield" .

goldbook:09412 a skos:Concept ;
    skos:definition "Ion or neutral particle composed of three or more atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyatomic fragment" .

goldbook:09413 a skos:Concept ;
    skos:definition "Number of positively-charged secondary ions sputtered from a sample divided by the total number of incident primary particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positive-ion yield" .

goldbook:09414 a skos:Concept ;
    skos:definition "Ion extracted from a source and directed at a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary ion" .

goldbook:09415 a skos:Concept ;
    skos:definition "Number of ion pulse cycles per second in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse rate" .

goldbook:09416 a skos:Concept ;
    skos:definition "Full width at half maximum of the time distribution of the pulse of ions generated by a beam chopper and, optionally, the use of beam bunching in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse width" .

goldbook:09417 a skos:Concept ;
    skos:definition "Extraction field around the sample that is pulsed to the working value for extracting ions for the time necessary for operation of a time-of-flight mass spectrometer, but is otherwise at a low value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulsed extraction field" .

goldbook:09418 a skos:Concept ;
    skos:definition "Electric potential set on the reflector electrode of a reflectron mass spectrometer with the zero referenced, such that an ion emitted from the sample with an energy numerically equal to the reflector voltage would just be on the point of reflection or transmission by the reflector electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflector voltage" .

goldbook:09419 a skos:Concept ;
    skos:definition "In dynamic secondary-ion mass spectrometry, coefficient for an element by which the measured intensity for an isotope of that element, divided by the measured intensity for a matrix ion, is multiplied to yield the atomic concentration of that isotope of the element present in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative isotopic sensitivity factor" .

goldbook:09420 a skos:Concept ;
    skos:definition "Mass accuracy divided by reference mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative mass accuracy" .

goldbook:09422 a skos:Concept ;
    skos:definition "Ion ejected from a sample surface as a result of energy and momentum transfer from a primary ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary ion" .

goldbook:09424 a skos:Concept ;
    skos:definition "Number of secondary ions as a function of angle of emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary-ion angular distribution" .

goldbook:09425 a skos:Concept ;
    skos:definition "Number of secondary ions as a function of kinetic energy at a specified collection angle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary-ion energy distribution" .

goldbook:09426 a skos:Concept ;
    skos:definition "Number of ions sputtered from a sample divided by the number of ions incident with a given mass, energy, charge, and angle of incidence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary-ion yield" .

goldbook:09427 a skos:Concept ;
    skos:definition "Number of ion pulses incident at each pixel in an image for one raster frame in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shots per pixel" .

goldbook:09428 a skos:Concept ;
    skos:definition "Two-dimensional surface map of the spatial distribution of the amount of a particular secondary ion emitted from within a specific area of the sample in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "SIMS ion image" .

goldbook:09429 a skos:Concept ;
    skos:definition "Ion fluence above which any significant changes in the spectrum, arising from beam damage, are observed in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static limit" .

goldbook:09430 a skos:Concept ;
    skos:definition "Registration of a particle by a time-to-digital converter in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stop event" .

goldbook:09431 a skos:Concept ;
    skos:definition "Probability of a defined charged or neutral species being produced, by consumption of a defined parent atomic or molecular configuration at a surface, as a result of sputtering in secondary ion mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transformation probability" .

goldbook:09432 a skos:Concept ;
    skos:definition "Depth profile in secondary-ion mass spectrometry where the depth over which significant changes occur is less than \\(\\pu{10 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultra-shallow depth profile" .

goldbook:09433 a skos:Concept ;
    skos:definition "In secondary ion mass spectrometry, number of ions of a particular isotope detected divided by the number of atoms of the same element sputtered from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "useful ion yield" .

goldbook:09434 a skos:Concept ;
    skos:definition "Image resolution in secondary ion mass spectrometry obtained in practice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "useful spatial resolution" .

goldbook:09435 a skos:Concept ;
    skos:definition "Distance over which the transmitted X-ray intensity falls by \\(1/e\\), where \\(e\\) is the base of the natural logarithm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption length" .

goldbook:09436 a skos:Concept ;
    skos:definition "Area on the specimen irradiated by X-rays in X-ray reflectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam footprint" .

goldbook:09437 a skos:Concept ;
    skos:definition "Fraction of the incident X-ray beam in X-ray reflectrometry missing the specimen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam spill-off" .

goldbook:09438 a skos:Concept ;
    skos:definition "X-ray energy at which there is a significant increase of absorption and for which the increased absorption occurs at a greater energy than a core-level binding energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed onset" .

goldbook:09439 a skos:Concept ;
    skos:definition "Plane containing the source, detector, incident, and specularly reflected X–ray beams in X-ray reflectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion plane" .

goldbook:09440 a skos:Concept ;
    skos:definition "Condition where the glancing angle for the incident X-rays is at or less than the critical angle and the X-rays are either reflected or absorbed in a region very close to the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total reflection of X-rays" .

goldbook:09441 a skos:Concept ;
    skos:definition "Vector in reciprocal space describing the direction of propagation of X-rays and equal in magnitude to \\(2\\uppi/\\lambda\\), where \\(\\lambda\\) is the wavelength of the X-rays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wave vector" .

goldbook:09442 a skos:Concept ;
    skos:definition "X-ray absorption coefficient at an energy just above an absorption edge divided by that at an energy just below the edge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray jump ratio" .

goldbook:09443 a skos:Concept ;
    skos:altLabel "depth resolution" ;
    skos:definition "In secondary-ion mass spectrometry, Auger electron spectroscopy, and X-ray photoelectron spectroscopy, distance over which a change in signal intensity from \\(\\pu{16\\%}\\) to \\(\\pu{84\\%}\\), or from \\(\\pu{84\\%}\\) to \\(\\pu{16\\%}\\), is measured at the junction of two dissimilar matrices, the thicknesses of which are more than six times that distance" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "observed interface width" .

goldbook:09444 a skos:Concept ;
    skos:definition "Resonant interaction between the natural frequency of a surface plasmon and incident light of the same frequency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface plasmon resonance" .

goldbook:09445 a skos:Concept ;
    skos:definition "Interfacial agent comprised of molecules possessing two or more functional groups, each of which exhibits preferential interactions with the various types of phase domains in a composite." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adhesion promoter" .

goldbook:09446 a skos:Concept ;
    skos:definition "Image of a mask pattern that is projected onto the photoresist coated wafer by an optical system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerial image" .

goldbook:09447 a skos:Concept ;
    skos:definition "Thermal treatment of a solid polymer material at a fixed or changing temperature that leads to desired changes in its physical structure and properties without involving complete melting or dissolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "annealing" .

goldbook:09448 a skos:Concept ;
    skos:definition "Annealing via the exposure of a substrate to solvent vapor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent vapor annealing" .

goldbook:09449 a skos:Concept ;
    skos:definition "Annealing in which a heating step is used to activate chemical processes in a resist that depend on diffusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal annealing" .

goldbook:09450 a skos:Concept ;
    skos:altLabel "ARC" ;
    skos:definition "Material used in lithography or in other technologies that is applied to a surface in order to reduce reflection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-reflective coating" .

goldbook:09451 a skos:Concept ;
    skos:definition "Proportional relationship between the width and height of an image produced by exposing a resist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aspect ratio" .

goldbook:09452 a skos:Concept ;
    skos:altLabel "AFM",
        "scanning force microscopy (SFM)" ;
    skos:definition "High-resolution scanning probe microscopy that maps a surface with a demonstrated resolution of the order of fractions of a nanometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic force microscopy" .

goldbook:09453 a skos:Concept ;
    skos:definition "Base added to a chemical amplification resist to neutralize low levels of acid that might diffuse into nominally unexposed regions and cause blur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base quencher" .

goldbook:09454 a skos:Concept ;
    skos:definition "Process in which a thin film of block copolymer is formed into a regular nanoscale pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "block copolymer lithography" .

goldbook:09455 a skos:Concept ;
    skos:altLabel "BARC" ;
    skos:definition "Layer placed between a photoresist and a substrate to prevent reflection from the latter resulting in a reduction in photoresist pattern quality, as characterized by resolution, line edge roughness, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bottom anti-reflective coating" .

goldbook:09456 a skos:Concept ;
    skos:definition "Pattern formation using self-assembly processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bottom-up lithography" .

goldbook:09457 a skos:Concept ;
    skos:definition "Solvent in which a resist or additional thin-film component (typically a BARC) is dissolved for the coating process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basting solvent" .

goldbook:09458 a skos:Concept ;
    skos:altLabel "clearing dose",
        "dose to clear" ;
    skos:definition "Dose of radiation required to completely remove a positive-tone resist from a large area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clearance dose" .

goldbook:09459 a skos:Concept ;
    skos:definition "Hole in a layer of a semiconductor device enabling contact with an underlying semiconductor layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact hole" .

goldbook:09460 a skos:Concept ;
    skos:altLabel "contrast ratio" ;
    skos:definition "Maximum of the absolute value of the gradient of a contrast curve taken as a measure of the ability of a resist to differentiate the regions that have been exposed to radiation from those that have not." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contrast" .

goldbook:09461 a skos:Concept ;
    skos:definition "Plot of the fraction of the original thickness that remains after the development of a uniformly irradiated resist versus the logarithm of the incident exposure dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contrast curve" .

goldbook:09462 a skos:Concept ;
    skos:altLabel "CD" ;
    skos:definition "Length of the smallest geometrical features that can be formed in a lithographic process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical dimension" .

goldbook:09463 a skos:Concept ;
    skos:definition "Unwanted change in the solubility of a resist that takes place in the absence of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dark loss" .

goldbook:09464 a skos:Concept ;
    skos:altLabel "image defect" ;
    skos:definition "Imperfection introduced during pattern formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "defect" .

goldbook:09465 a skos:Concept ;
    skos:definition "Imaged resist without imperfections in pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "defect-free pattern" .

goldbook:09466 a skos:Concept ;
    skos:definition "Removal of a protecting group which leads to a change in the solubility of a polymeric resist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deprotection" .

goldbook:09467 a skos:Concept ;
    skos:definition "Tolerance of the placement of the image plane in relation to image quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth of focus" .

goldbook:09468 a skos:Concept ;
    skos:definition "Process in which a developer is used to generate an image by removing the soluble portion of the latent pattern of an exposed resist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "development" .

goldbook:09469 a skos:Concept ;
    skos:definition "Direct write, tip-based patterning method that uses the tip of an AFM probe to act as a pen and deposit molecules on a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dip-pen nanolithography" .

goldbook:09470 a skos:Concept ;
    skos:altLabel "DSA" ;
    skos:definition "Process in which a thin film of block copolymer is formed into a regular nanoscale pattern on chemically or topographically nanopatterned surfaces (or a combination thereof)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "directed self-assembly" .

goldbook:09471 a skos:Concept ;
    skos:definition "Defect, or irregularity, within an ordered structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dislocation" .

goldbook:09472 a skos:Concept ;
    skos:definition "Compound that, when included in a resist formulation, slows the rate of dissolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolution inhibitor" .

goldbook:09473 a skos:Concept ;
    skos:definition "Compound that, when included in a resist formulation, increases the rate of dissolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolution promoter" .

goldbook:09474 a skos:Concept ;
    skos:definition "Rate at which resist is removed during development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolution rate" .

goldbook:09475 a skos:Concept ;
    skos:definition "Coating of solution or slurry drawn to uniform film by use of a knife edge or doctor blade." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "doctor blading" .

goldbook:09476 a skos:Concept ;
    skos:definition "Process that increases the thermal-equilibrium concentration of free charge carriers in a material to augment its electrical conductivity using chemical agents or additives (i.e. dopants)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "doping (p- and n-type)" .

goldbook:09478 a skos:Concept ;
    skos:definition "Lithographic process requiring two exposures to radiation for a single resist layer to form a finished pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double exposure" .

goldbook:09479 a skos:Concept ;
    skos:definition "Printing of two distinct lines at the edges of a single resist line pattern by means of a deposit-etch process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double patterning" .

goldbook:09480 a skos:Concept ;
    skos:definition "Assembly of a layer on a substrate by the use of a solvent-free process, such as vapor deposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dry deposition" .

goldbook:09481 a skos:Concept ;
    skos:definition "Process in which a portion of a latent pattern in an exposed resist is removed to form the image without the use of a liquid developer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dry development" .

goldbook:09482 a skos:Concept ;
    skos:altLabel "etch resistance" ;
    skos:definition "Facility of an exposed resist to withstand etching conditions, usually a plasma, determined in comparison to a reference standard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dry-etch resistance" .

goldbook:09483 a skos:Concept ;
    skos:definition "Photoresist capable of being processed in either positive tone (aqueous base development) or negative tone (organic solvent development)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual-tone resist" .

goldbook:09484 a skos:Concept ;
    skos:altLabel "edge sharpness" ;
    skos:definition "Degree to which the edge of an image appears sharp and precise." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "edge acuity" .

goldbook:09485 a skos:Concept ;
    skos:definition "Creating a pattern by pressing a master die into a malleable material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embossing" .

goldbook:09486 a skos:Concept ;
    skos:definition "Growth of crystals on other crystals involving a precisely defined mutual orientation of their lattices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epitaxial crystallization" .

goldbook:09487 a skos:Concept ;
    skos:definition "Deposition of a crystalline over layer on a crystalline substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epitaxy" .

goldbook:09488 a skos:Concept ;
    skos:definition "Treatment to remove substrate to a requisite depth from those areas of a surface no longer protected following the exposure and development of an overlaid resist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "etch" .

goldbook:09489 a skos:Concept ;
    skos:definition "Process of removal of material, typically of a masked pattern on a semiconductor, by exposing it to a bombardment of ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dry etching" .

goldbook:09490 a skos:Concept ;
    skos:definition "Rate of material removal using either a wet or a dry-etch process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "etch rate" .

goldbook:09491 a skos:Concept ;
    skos:definition "Process of removal of material, typically of a masked pattern on a semiconductor, by exposing it to a corrosive liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wet etching" .

goldbook:09492 a skos:Concept ;
    skos:definition "Extent to which a light- or radiation-sensitive material can be overexposed or underexposed and still achieve acceptable imaging." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure latitude" .

goldbook:09493 a skos:Concept ;
    skos:altLabel "FIB" ;
    skos:definition "Technique used for the site-specific analysis, deposition, ablation, and micromachining of materials down to dimensions of \\(\\pu{10}\\) to \\(\\pu{15 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "focused ion beam" .

goldbook:09494 a skos:Concept ;
    skos:definition "High temperature annealing to solidify any resist material remaining after development in order to provide a durable protective layer for etching." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard bake" .

goldbook:09495 a skos:Concept ;
    skos:definition "Pattern produced in or on a substrate during a lithographic process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image" .

goldbook:09496 a skos:Concept ;
    skos:definition "Visible image produced by an effect of radiation on a substrate followed by subsequent lithographic development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developed image" .

goldbook:09497 a skos:Concept ;
    skos:definition "Broadening during the development of a lithographic image." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image blur" .

goldbook:09498 a skos:Concept ;
    skos:definition "High refractive index liquid medium used in immersion lithography that replaces the air gap between the lens and the resist surface in conventional photolithography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immersion fluid" .

goldbook:09499 a skos:Concept ;
    skos:definition "Method whereby a film, usually metallic, deposited on a patterned substrate after etch processing, is removed during resist strip, which leaves only that portion of the film that is deposited directly onto the exposed regions of the substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lift-off process" .

goldbook:09500 a skos:Concept ;
    skos:altLabel "LER" ;
    skos:definition "Variations along one edge of a linear resist feature over an extended length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line edge roughness" .

goldbook:09501 a skos:Concept ;
    skos:altLabel "LWR" ;
    skos:definition "Variations in the width of a linear resist feature over an extended length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line width roughness" .

goldbook:09502 a skos:Concept ;
    skos:definition "Developed lithographic pattern comprising alternating lines with spaces between." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line-space patterning" .

goldbook:09503 a skos:Concept ;
    skos:definition "Process whereby an image is created on an apparently planar surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lithography" .

goldbook:09504 a skos:Concept ;
    skos:definition "Pattern created without recourse to irradiation through a mask of the image." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct-write lithography" .

goldbook:09505 a skos:Concept ;
    skos:altLabel "e-beam lithography" ;
    skos:definition "Lithography performed by exposing a resist to a beam of electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron beam lithography" .

goldbook:09506 a skos:Concept ;
    skos:altLabel "EBDW" ;
    skos:definition "Electron beam lithography whereby the pattern is written directly onto the photoresist without the use of a mask." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-beam direct-write lithography" .

goldbook:09507 a skos:Concept ;
    skos:altLabel "EUVL" ;
    skos:definition "Photolithography performed by exposing a resist to extreme ultraviolet (\\(\\pu{13 nm}\\)) radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extreme ultraviolet lithography" .

goldbook:09508 a skos:Concept ;
    skos:definition "Photolithography that provides resolution enhancement by immersing a resist-coated substrate in a fluid during the exposure process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immersion lithography" .

goldbook:09509 a skos:Concept ;
    skos:definition "Patterns created by mechanical deformation of an imprint resist and a subsequent curing process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imprint lithography" .

goldbook:09510 a skos:Concept ;
    skos:definition "Subset of imprint lithography that allows for the fabrication of nanometer scale patterns." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoimprint lithography" .

goldbook:09511 a skos:Concept ;
    skos:altLabel "holographic lithography" ;
    skos:definition "Technique for patterning regular arrays of fine features without the use of complex optical systems or photomasks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interference lithography" .

goldbook:09512 a skos:Concept ;
    skos:definition "Lithography for direct patterning of surfaces based on the application of a magnetic field to the substrate using paramagnetic metal masks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetolithography" .

goldbook:09513 a skos:Concept ;
    skos:definition "Lithography that does not need a mask of the image to make a pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maskless lithography" .

goldbook:09514 a skos:Concept ;
    skos:definition "Lithography or pattern formation at a resolution of the order of microns." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microlithography" .

goldbook:09515 a skos:Concept ;
    skos:definition "Umbrella term that is used to describe all lithographic techniques that allow for the fabrication of nanometer scale patterns." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanolithography" .

goldbook:09516 a skos:Concept ;
    skos:definition "Lithography in which material is deposited into the interstices of a 2D array of nanospheres that are subsequently removed to form a pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanosphere lithography" .

goldbook:09517 a skos:Concept ;
    skos:altLabel "optical lithography" ;
    skos:definition "Lithography performed by exposing a resist to an intense parallel light beam through an image mask." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photolithography" .

goldbook:09518 a skos:Concept ;
    skos:definition "Lithographic method in which a microscopic or nanoscopic stylus is moved mechanically across a surface to form a pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning-probe lithography" .

goldbook:09519 a skos:Concept ;
    skos:definition "Family of techniques for fabricating or replicating structures using elastomeric stamps, molds, and conformable photomasks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soft lithography" .

goldbook:09520 a skos:Concept ;
    skos:definition "Lithography performed by exposing a resist to X-radiation through an image mask." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray lithography" .

goldbook:09521 a skos:Concept ;
    skos:definition "Lithography performed in three dimensions, typically carried out using nanoimprint patterning or 2-photon lithography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "3D lithography" .

goldbook:09522 a skos:Concept ;
    skos:altLabel "two-photon lithography" ;
    skos:definition "Photolithography within a thick photoresist film, within which the photochemically-induced solubility change results from the simultaneous absorption of two photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "2-photon lithography" .

goldbook:09523 a skos:Concept ;
    skos:altLabel "photomask" ;
    skos:definition "Transparent substrate pre-patterned with the desired image that is inserted into the incident beam in photo- and X-ray lithography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mask" .

goldbook:09524 a skos:Concept ;
    skos:definition "Mask with a pattern defined by a paramagnetic metal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic mask" .

goldbook:09525 a skos:Concept ;
    skos:altLabel "MEEF" ;
    skos:definition "Increase in error of pattern edge location during pattern formation when the wavelength of light used to expose a resist is greater than the feature size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mask error enhancement factor" .

goldbook:09526 a skos:Concept ;
    skos:definition "Form of soft lithography that uses micron-scale and smaller relief patterns on a master elastomer stamp to form images on the surface of a substrate through conformal contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcontact printing" .

goldbook:09527 a skos:Concept ;
    skos:definition "Process whereby structures of micrometre scale and smaller are fabricated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microfabrication" .

goldbook:09528 a skos:Concept ;
    skos:definition "Multi-disciplinary subject concerned with the behavior, precise control, and manipulation of fluids that are geometrically constrained within a small, typically sub-millimeter, scale channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microfluidics" .

goldbook:09529 a skos:Concept ;
    skos:definition "Form of soft lithography that uses the relief patterns in a master template to make 3-dimensional structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micromolding" .

goldbook:09530 a skos:Concept ;
    skos:definition "Assembly of small molecules that vitrify, rather than crystallize, when cooled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular glass" .

goldbook:09531 a skos:Concept ;
    skos:definition "Molecule that acts as a device performing a logical operation based on one or more physical or chemical inputs and a single output." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular logic gate" .

goldbook:09532 a skos:Concept ;
    skos:definition "Molecular structure that transfers a pattern to or organizes another molecular scale structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular template" .

goldbook:09533 a skos:Concept ;
    skos:definition "Molecular-scale objects that conduct electrical current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular wires" .

goldbook:09534 a skos:Concept ;
    skos:definition "Empirical observation by Gordon E. Moore, co-founder of Intel, that, over the history of computing hardware, the number of transistors on integrated circuits doubles approximately every two years." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Moore’s law" .

goldbook:09535 a skos:Concept ;
    skos:definition "Device in which the manufactured size is between \\(\\pu{1}\\) and \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanodevice" .

goldbook:09536 a skos:Concept ;
    skos:altLabel "NEMS" ;
    skos:definition "Devices that integrate electrical and mechanical functionality at the nanoscale. A miniaturization of microelectromechanical systems (MEMS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoelectromechanical systems" .

goldbook:09537 a skos:Concept ;
    skos:definition "Application of nanotechnology to microelectronics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoelectronics" .

goldbook:09538 a skos:Concept ;
    skos:definition "Particle of any shape with an equivalent diameter of approximately \\(\\pu{1}\\) to \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoparticle" .

goldbook:09539 a skos:Concept ;
    skos:definition "Patterns on a substrate with lesser dimensions of between \\(\\pu{1}\\) to \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanopattern" .

goldbook:09540 a skos:Concept ;
    skos:altLabel "nano-optics" ;
    skos:definition "Study of the interaction of light with particles or substances on a scale less than the wavelength of the light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanophotonics" .

goldbook:09541 a skos:Concept ;
    skos:definition "Structure or feature of size between \\(\\pu{1}\\) and \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanostructure" .

goldbook:09542 a skos:Concept ;
    skos:definition "Manipulation of matter on an atomic and molecular scale." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanotechnology" .

goldbook:09543 a skos:Concept ;
    skos:altLabel "NSOM" ;
    skos:definition "Microscopy applied to the investigation of nanostructures that breaks the farfield resolution limit by exploiting the properties of evanescent waves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "near-field scanning optical microscopy" .

goldbook:09544 a skos:Concept ;
    skos:altLabel "NTD" ;
    skos:definition "Process for revealing the latent image in a resist in which the exposed regions are less soluble in the developer than the unexposed regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative-tone development" .

goldbook:09545 a skos:Concept ;
    skos:altLabel "NILS",
        "normalized image slope" ;
    skos:definition "Measure of the information content of the aerial image and represents an energy (intensity) gradient at the position of the nominal line edge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normalized image log slope" .

goldbook:09546 a skos:Concept ;
    skos:definition "Destruction of pattern during and after development caused by the surface tension of the development solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pattern collapse" .

goldbook:09547 a skos:Concept ;
    skos:definition "Transfer of the pattern of a developed lithographic image to an underlying substrate by processes such as etching." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pattern transfer" .

goldbook:09548 a skos:Concept ;
    skos:altLabel "PAG" ;
    skos:definition "Compound that on exposure to radiation gives rise to a proton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoacid generator" .

goldbook:09549 a skos:Concept ;
    skos:altLabel "PAC" ;
    skos:definition "Compound that on exposure to radiation will release an active ionic or radical species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoactive compound" .

goldbook:09550 a skos:Concept ;
    skos:definition "Periodic structures consisting of a dielectric material that shows strong interaction with light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photonic crystal" .

goldbook:09551 a skos:Concept ;
    skos:definition "Science and technology of the production, transmission, absorption, sensing, and direction of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photonics" .

goldbook:09552 a skos:Concept ;
    skos:definition "Method for making a lithographic pattern smaller than that deemed possible given the wavelength of the imaging radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pitch division" .

goldbook:09553 a skos:Concept ;
    skos:definition "Coating used to create a level surface during lithographic processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planarising layer" .

goldbook:09554 a skos:Concept ;
    skos:altLabel "PECVD" ;
    skos:definition "Process to deposit a solid film on a substrate resulting from plasma-induced reactions of precursor compounds, either in the gaseous state or on the film surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma enhanced chemical vapor deposition" .

goldbook:09555 a skos:Concept ;
    skos:definition "Plasma processing used in the fabrication of integrated circuits that generates volatile products from the elements of the material etched and the reactive species generated by the plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma etch" .

goldbook:09556 a skos:Concept ;
    skos:definition "Process for revealing the latent image in a resist in which the exposed regions are more soluble in the developer than are the unexposed regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positive-tone development" .

goldbook:09557 a skos:Concept ;
    skos:altLabel "PAB" ;
    skos:definition "Thermal annealing step following the coating of a substrate with a resist material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-apply bake" .

goldbook:09558 a skos:Concept ;
    skos:altLabel "PEB",
        "post bake" ;
    skos:definition "Thermal annealing step following the exposure of a resist to imaging radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-exposure bake" .

goldbook:09559 a skos:Concept ;
    skos:altLabel "PED" ;
    skos:definition "Pause between successive patterning steps in lithographic processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-exposure delay" .

goldbook:09560 a skos:Concept ;
    skos:definition "Non-reactive group temporarily used to transform a reactive group into one that does not react under conditions where the non-protected group reacts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protecting group" .

goldbook:09561 a skos:Concept ;
    skos:definition "Widening of the exposure dose distribution, and hence the developed pattern, caused by the scattering of the primary beam electrons within the resist and substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proximity effect" .

goldbook:09562 a skos:Concept ;
    skos:definition "Rectangular pattern of line-by-line scanning for image capture used in electron beam and ion-beam lithography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "raster scan" .

goldbook:09563 a skos:Concept ;
    skos:altLabel "RIE" ;
    skos:definition "Etching technology used in microfabrication that uses chemically reactive plasma to remove material from a substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive ion etching" .

goldbook:09564 a skos:Concept ;
    skos:definition "Material, usually a polymer, that when irradiated either undergoes a marked change in solubility in a given solvent or is ablated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resist" .

goldbook:09565 a skos:Concept ;
    skos:altLabel "CAR" ;
    skos:definition "Resist that undergoes solubility change upon exposure of photoacid generator, followed by thermally activated acid catalyzed deprotection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically amplified resist" .

goldbook:09566 a skos:Concept ;
    skos:altLabel "e-beam resist",
        "electron-beam resist" ;
    skos:definition "Resist optimized for use under electron beam irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron beam resist" .

goldbook:09567 a skos:Concept ;
    skos:altLabel "ion-beam resist" ;
    skos:definition "Resist optimized for use under ion beam irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion beam resist" .

goldbook:09568 a skos:Concept ;
    skos:definition "Resist comprising more than one active component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-component resist" .

goldbook:09569 a skos:Concept ;
    skos:definition "Resist optimized for use under X-ray irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray resist" .

goldbook:09570 a skos:Concept ;
    skos:definition "Topography of a resist pattern in cross section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resist profile" .

goldbook:09571 a skos:Concept ;
    skos:definition "Subsequent removal of the remaining resist that covers the protected regions of a substrate during development and etch processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resist strip" .

goldbook:09572 a skos:Concept ;
    skos:definition "Noise which originates from the discrete nature of elementary charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shot noise" .

goldbook:09573 a skos:Concept ;
    skos:altLabel "silation" ;
    skos:definition "Introduction of a substituted silyl group (\\(\\ce{R3Si}\\)) to an alcohol, carboxylic acid, amine, thiol, or phosphate, commonly as a protecting group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silylation" .

goldbook:09574 a skos:Concept ;
    skos:definition "Short, low temperature annealing step following the coating of a wafer with a photoresist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soft bake" .

goldbook:09575 a skos:Concept ;
    skos:definition "Three-dimensional template comprising the negative pattern used to leave an impression on the surface of a malleable material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stamp" .

goldbook:09576 a skos:Concept ;
    skos:altLabel "supramolecular species",
        "supramolecular structure",
        "supramolecule" ;
    skos:definition "Molecular system comprising two or more self-assembled molecular, or molecular and ionic, entities held together by means of non-covalent intermolecular binding interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supramolecular assembly" .

goldbook:09577 a skos:Concept ;
    skos:definition "Measure of the texture of a surface that is quantified by vertical deviations from its ideal location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface roughness" .

goldbook:09578 a skos:Concept ;
    skos:definition "Sinusoidal variation in the lithographic clearance dose arising from changes in the phase difference between incoming and outgoing radiation that is induced by variations in resist thickness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "swing curve" .

goldbook:09579 a skos:Concept ;
    skos:definition "Protective layer spun directly on top of a resist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topcoat" .

goldbook:09580 a skos:Concept ;
    skos:altLabel "top-down processing" ;
    skos:definition "Pattern formation using lithographic (also embossing) methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "top-down patterning" .

goldbook:09581 a skos:Concept ;
    skos:altLabel "TSI" ;
    skos:definition "Lithographic process in which the exposed region of resist is silylated and the image then formed through reactive oxygen etch." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "top-surface imaging" .

goldbook:09582 a skos:Concept ;
    skos:definition "Growth of solid materials on a substrate by deposition from the gas phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vapor deposition" .

goldbook:09583 a skos:Concept ;
    skos:definition "Pattern formation using a directed electron beam or ion beam that skips from region to region requiring exposure but is otherwise turned off." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vector scan" .

goldbook:09584 a skos:Concept ;
    skos:definition "Projection formula for macromolecules in which horizontal lines denote polymer backbone bonds. At each individual backbone carbon atom, horizontal lines represent bonds directed below the projection plane and vertical lines represent bonds directed above that plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotated Fischer projection" .

goldbook:09585 a skos:Concept ;
    skos:definition "Pair of adjacent constitutionally equivalent stereogenic units that are of like configuration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "m diad" .

goldbook:09586 a skos:Concept ;
    skos:definition "Pair of adjacent constitutionally equivalent stereogenic units that are of unlike configuration. Figure 2: Diagrammatic representations of the configurational repeating unit or stereorepeating unit (upper), and the diad sequence (lower) for isotactic poly(oxypropylene), both as a rotated Fischer projections (left) and as a zigzag projection (right). [image2]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "r diad" .

goldbook:09587 a skos:Concept ;
    skos:definition "Regular macromolecule having a configurational repeating unit comprising four configurational base units, the first two stereogenic units of which are identical and enantiomorphic to the last two." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterotactic macromolecule" .

goldbook:09588 a skos:Concept ;
    skos:definition "Asymmetric polymerization in which, starting from a mixture of enantiomeric monomer molecules, only one enantiomer is polymerized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric enantiomer-differentiating polymerization" .

goldbook:09589 a skos:Concept ;
    skos:definition "Polymerization that proceeds in an unsymmetrical manner in terms of chirality under the influence of chiral features present in one or more components of the reaction system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric polymerization" .

goldbook:09590 a skos:Concept ;
    skos:definition "The Bernoullian distribution is a discrete distribution having two possible outcomes labelled by \\(n = 0\\) and \\(n = 1\\), in which \\(n = 1\\) ('success') occurs with probability $p$ and \\(n = 0\\) ('failure') occurs with probability \\(q = 1 - p\\), where $0 \\lt p \\lt 1$. It is a special case of a binomial distribution corresponding to a random distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bernoullian distribution" .

goldbook:09591 a skos:Concept ;
    skos:definition "Conversion of a substance into biomass by biochemical processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioassimilation" .

goldbook:09592 a skos:Concept ;
    skos:definition "Composed of or derived from, in whole or in part, biological products derived from the biomass (including plant, animal, and marine or forestry materials)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biobased" .

goldbook:09593 a skos:Concept ;
    skos:definition "Qualifier for a substance or device that undergoes biodegradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodegradable" .

goldbook:09594 a skos:Concept ;
    skos:definition "Surface degradation resulting from the action of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioerosion" .

goldbook:09595 a skos:Concept ;
    skos:definition "Qualifier for actions or substances that are connected to living systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biorelated" .

goldbook:09596 a skos:Concept ;
    skos:definition "Qualifier used to indicate that a compound or a device is bioresorbed, i.e., totally eliminated or bioassimilated by an animal or a human body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioresorbable" .

goldbook:09597 a skos:Concept ;
    skos:definition "Process of biological decomposition of organic matter performed by microorganisms, mostly bacteria and fungi." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composting" .

goldbook:09598 a skos:Concept ;
    skos:definition "Qualifier to a substance that can undergo physical and/or chemical deleterious changes of some properties, especially of integrity, under stress conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradable" .

goldbook:09599 a skos:Concept ;
    skos:definition "Degradation or biodegradation occurring at different rates depending on the location within a matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous degradation" .

goldbook:09600 a skos:Concept ;
    skos:definition "Degradation that occurs at the same rate regardless of the location within a polymeric item." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous degradation" .

goldbook:09601 a skos:Concept ;
    skos:definition "Copolymer formed of constitutional repeating units that are constitutionally identical but configurationally different." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereocopolymer" .

goldbook:09602 a skos:Concept ;
    skos:definition "Constitutional repeating unit of connectivity three or more connected at least to three other constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branch constitutional repeating unit" .

goldbook:09603 a skos:Concept ;
    skos:definition "Constitutional unit in a dendrimer molecule, from which the dendron(s) emanate(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core unit" .

goldbook:09604 a skos:Concept ;
    skos:definition "Parameter characterizing the branched architecture of a hyperbranched polymer, which is equal to unity for a polymer that contains no linear or semi-dendritic constitutional repeating unit and is equal to 0 for a polymer that contains no dendritic or semi-dendritic constitutional repeating unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of branching" .

goldbook:09605 a skos:Concept ;
    skos:definition "Molecule consisting of one or more dendrons emanating from a single constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendrimer molecule" .

goldbook:09606 a skos:Concept ;
    skos:definition "Block macromolecule in which at least one block is a dendron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendritic block macromolecule" .

goldbook:09607 a skos:Concept ;
    skos:definition "Constitutional repeating unit of connectivity $c \\ge 3$ connected to $c$ other constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendritic constitutional repeating unit" .

goldbook:09608 a skos:Concept ;
    skos:definition "Graft macromolecule in which at least one of the grafts contains a dendron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendritic graft macromolecule" .

goldbook:09609 a skos:Concept ;
    skos:definition "Macromolecule containing at least one dendron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendritic macromolecule" .

goldbook:09610 a skos:Concept ;
    skos:definition "Substance composed of dendritic macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendritic polymer" .

goldbook:09611 a skos:Concept ;
    skos:definition "Part of a molecule with only one free valence, comprising exclusively dendritic and terminal constitutional repeating units and in which each path from the free valence to any end-group comprises the same number of constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendron" .

goldbook:09612 a skos:Concept ;
    skos:definition "For a constitutional repeating unit of a dendron, the direction from the free valence to the end-groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendron direction" .

goldbook:09613 a skos:Concept ;
    skos:definition "Core unit of a dendrimer molecule that comprises only one dendron" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "focal unit" .

goldbook:09614 a skos:Concept ;
    skos:definition "Set of constitutional repeating units separated from the free valence of a dendron by the same number of constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generation" .

goldbook:09615 a skos:Concept ;
    skos:definition "Highly branched macromolecule, the constitutional repeating units of which are in substantial part branch constitutional repeating units and terminal constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperbranched macromolecule" .

goldbook:09616 a skos:Concept ;
    skos:definition "Substance composed of hyperbranched oligomer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperbranched oligomer" .

goldbook:09617 a skos:Concept ;
    skos:definition "Highly branched oligomer molecule, the constitutional repeating units of which are in substantial part branch constitutional repeating units and terminal constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperbranched oligomer molecule" .

goldbook:09618 a skos:Concept ;
    skos:definition "Substance composed of hyperbranched macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperbranched polymer" .

goldbook:09619 a skos:Concept ;
    skos:definition "Substance composed of irregular dendrimer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irregular dendrimer" .

goldbook:09620 a skos:Concept ;
    skos:definition "Dendrimer molecule that contains either different types of regular dendrons or at least one irregular dendron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irregular dendrimer molecule" .

goldbook:09621 a skos:Concept ;
    skos:definition "Dendron composed of either different types of constitutional units, different types of end-groups or any combination of these." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irregular dendron" .

goldbook:09622 a skos:Concept ;
    skos:definition "Constitutional repeating unit connected to exactly two other constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear constitutional repeating unit" .

goldbook:09623 a skos:Concept ;
    skos:definition "Number of constitutional repeating units on the path from the free valence to any end-group of a dendron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number of generations" .

goldbook:09624 a skos:Concept ;
    skos:definition "Number of generation of the dendrons of a regular dendrimer molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number of generations" .

goldbook:09625 a skos:Concept ;
    skos:definition "Number of generations of the hypothetical dendrimer molecule that would present the same ratio of constitutional repeating units to core unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number of pseudo-generations" .

goldbook:09626 a skos:Concept ;
    skos:definition "Substance composed of regular dendrimer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular dendrimer" .

goldbook:09627 a skos:Concept ;
    skos:definition "Dendrimer molecule comprising only identical regular dendrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular dendrimer molecule" .

goldbook:09628 a skos:Concept ;
    skos:definition "Dendron composed of only one type of constitutional repeating units and of only one type of end-groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular dendron" .

goldbook:09629 a skos:Concept ;
    skos:definition "Constitutional repeating unit of connectivity \\(c \\ge 4\\) connected to more than two but less than \\(c\\) other constitutional repeating units.Example of a hyperbranched macromolecule part with a semi-dendritic constitutional repeating unit of connectivity \\(c = 4\\) (circled), connected to three other constitutional repeating units and to one hydroxymethyl end-group. The preferred constitutional repeating unit is chosen such that the branch points are at its end in the dendron direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-dendritic constitutional repeating unit" .

goldbook:09630 a skos:Concept ;
    skos:definition "Constitutional repeating unit connected to only one other constitutional repeating unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "terminal constitutional repeating unit" .

goldbook:09631 a skos:Concept ;
    skos:altLabel "ChB" ;
    skos:definition "Net attractive interaction between an electrophilic region associated with a chalcogen atom in a molecular entity and a nucleophilic region in another, or the same, molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chalcogen bond" .

goldbook:09632 a skos:Concept ;
    skos:definition "Sub-field of analytical chemistry dealing with analysis of biomolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioanalytical chemistry" .

goldbook:09633 a skos:Concept ;
    skos:definition "Molecule of biological origin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomolecule" .

goldbook:09634 a skos:Concept ;
    skos:definition "Macromolecule (including proteins, nucleic acids, and polysaccharides) formed by living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomacromolecule" .

goldbook:09635 a skos:Concept ;
    skos:definition "Fluid that surrounds the foetus in the amniotic sac." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amniotic fluid" .

goldbook:09636 a skos:Concept ;
    skos:definition "Fluid that circulates through the heart, arteries, capillaries, and veins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood" .

goldbook:09637 a skos:Concept ;
    skos:altLabel "haematopoietic cell",
        "hematocyte",
        "hemocyte" ;
    skos:definition "Any cellular element of the blood, including erythrocytes, leucocytes, and platelets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood cell" .

goldbook:09638 a skos:Concept ;
    skos:definition "Number of red blood cells and white blood cells per unit volume in a specimen of venous blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood cell count" .

goldbook:09639 a skos:Concept ;
    skos:definition "Red cell phenotypes classified by their antigenic structural characteristics, which are under the control of various allelic genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood group" .

goldbook:09640 a skos:Concept ;
    skos:definition "Liquids originating from the bodies of living or dead humans, animals, and other organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "body fluids" .

goldbook:09641 a skos:Concept ;
    skos:altLabel "CSF" ;
    skos:definition "Clear, colourless fluid that fills spaces within and around the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebrospinal fluid" .

goldbook:09642 a skos:Concept ;
    skos:definition "Blood contained in the vessels of the umbilical cord at the time of birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cord blood" .

goldbook:09643 a skos:Concept ;
    skos:definition "Yellowish, slightly basic fluid circulating through the lymphatic system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymph" .

goldbook:09644 a skos:Concept ;
    skos:definition "Blood present in such small amounts that its presence can be ascertained only by chemical analysis or by spectroscopic or microscopic examination; particularly the blood found in stools." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occult blood" .

goldbook:09645 a skos:Concept ;
    skos:definition "Blood obtained from parts of the body that are located at some distance from the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral blood" .

goldbook:09646 a skos:Concept ;
    skos:definition "Sample of blood, serum, or plasma from which all proteins have been removed by chemical or physical denaturation, dialysis, ultrafiltration, or solvent extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein-free filtrate" .

goldbook:09647 a skos:Concept ;
    skos:definition "Clear, viscous secretion from the parotid, submaxillary, sublingual, and smaller mucous glands in the cavity of the mouth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saliva" .

goldbook:09648 a skos:Concept ;
    skos:definition "Soft outer covering of vertebrates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skin" .

goldbook:09649 a skos:Concept ;
    skos:definition "Seminal fluid containing male reproductive cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sperm" .

goldbook:09650 a skos:Concept ;
    skos:definition "Fluid excreted by the sweat glands in the skin of mammals during perspiration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sweat" .

goldbook:09651 a skos:Concept ;
    skos:definition "Clear salty liquid that is secreted by the lachrymal gland of the eye to lubricate the surface between the eyeball and eyelid and to wash away irritants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tears" .

goldbook:09652 a skos:Concept ;
    skos:definition "Group of biological cells that perform a specific function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tissue" .

goldbook:09653 a skos:Concept ;
    skos:definition "Fluid containing metabolic products that is excreted by the kidneys, stored in the bladder, and normally discharged by way of the urethra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "urine" .

goldbook:09654 a skos:Concept ;
    skos:definition "Discipline encompassing the development and utilisation of computational tools to store, analyse, and interpret biological data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioinformatics" .

goldbook:09655 a skos:Concept ;
    skos:altLabel "biochemical receptor",
        "biocomponent (at a biosensor)" ;
    skos:definition "Component of biological origin that translates information from the biochemical domain into a physical or chemical domain with a defined selectivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological recognition element" .

goldbook:09656 a skos:Concept ;
    skos:definition "Decomposition of organic materials (e.g. starch, sugars, proteins, lignin, hemicelluloses, etc.) with specific enzymes or microbes in which the enzyme converts a high relative molecular mass compound into lower relative molecular mass species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzymatic decomposition" .

goldbook:09658 a skos:Concept ;
    skos:definition "Breaking down of a cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lysis" .

goldbook:09659 a skos:Concept ;
    skos:definition "Two-dimensional arrangement of a device for analysis of sub-microlitre sample volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microarray" .

goldbook:09660 a skos:Concept ;
    skos:definition "Test of the purity of the sample that will be subjected to detailed biochemical analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample quality control" .

goldbook:09661 a skos:Concept ;
    skos:altLabel "binding affinity" ;
    skos:definition "Strength of association between a single antibody and a single epitope of antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "affinity" .

goldbook:09662 a skos:Concept ;
    skos:definition "Type of agglutination in which particulate and soluble antigen compete for soluble antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agglutination inhibition" .

goldbook:09663 a skos:Concept ;
    skos:altLabel "epitome" ;
    skos:definition "Part of the structure of an antigen molecule that is responsible for specific interaction with antibody molecules evoked by the same or a similar antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigenic determinant" .

goldbook:09664 a skos:Concept ;
    skos:definition "Net affinity of all binding sites of all antibodies in the antiserum under specified physicochemical reaction conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "avidity" .

goldbook:09665 a skos:Concept ;
    skos:definition "Amount of a ligand that binds to a receptor expressed in operational units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binding capacity" .

goldbook:09666 a skos:Concept ;
    skos:definition "Coating of an immunospecific surface (e.g. serum, tissues, cells, biological macromolecules, biosensor surface) to form an active cover with selectivity or an inert layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blocking" .

goldbook:09667 a skos:Concept ;
    skos:altLabel "B/F" ;
    skos:definition "Amount of analyte bound by a label divided by amount of unbound (free) analyte" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bound/free ratio" .

goldbook:09668 a skos:Concept ;
    skos:definition "Array of serum proteins (some of which are enzymes) that become sequentially activated after the first member of the series is activated by either antigen-antibody complexes or microbial products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complement" .

goldbook:09669 a skos:Concept ;
    skos:definition "Conjugate that has an enzyme bound covalently." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme conjugate" .

goldbook:09670 a skos:Concept ;
    skos:definition "Agglutination reactions in which the particles used are erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemagglutination" .

goldbook:09671 a skos:Concept ;
    skos:definition "Technique that uses antibodies (or other specific ligands in related techniques) to identify target proteins among a number of unrelated protein species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoblotting" .

goldbook:09672 a skos:Concept ;
    skos:altLabel "specificity" ;
    skos:definition "The extent to which the immunoassay responds only to (all subsets of) a specific analyte and not to other substances of similar structure that are present in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunochemical specificity" .

goldbook:09673 a skos:Concept ;
    skos:definition "Product of an antigen-antibody reaction that may also contain components of the complement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunocomplex" .

goldbook:09674 a skos:Concept ;
    skos:definition "Classification of immunoglobulins based on antigenic and structural differences of the heavy peptide chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin class" .

goldbook:09675 a skos:Concept ;
    skos:definition "Isolation and concentration of an antigen by forming a precipitate with an antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoprecipitation" .

goldbook:09676 a skos:Concept ;
    skos:definition "Kinetic property of the immune response caused by an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoreactivity" .

goldbook:09677 a skos:Concept ;
    skos:definition "Biosensor where one of the immunointeracting partners (an antibody or an antigen as the analyte) is immobilised on the surface of a physicochemical transducer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosensor" .

goldbook:09678 a skos:Concept ;
    skos:altLabel "passive agglutination" ;
    skos:definition "Agglutination in which antigen is first immobilised artificially onto the particulate surfaces, either by physical adsorption or by chemical and/or immunochemical linkers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect agglutination" .

goldbook:09679 a skos:Concept ;
    skos:definition "Migration of the sample zone driven by capillary forces in a porous carrier strip." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lateral flow test" .

goldbook:09680 a skos:Concept ;
    skos:definition "Arising from a single clone of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monoclonal" .

goldbook:09681 a skos:Concept ;
    skos:definition "Immunoreactivity of an antiserum with its designated antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monospecificity" .

goldbook:09682 a skos:Concept ;
    skos:definition "Arising from multiple, different clones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyclonal" .

goldbook:09683 a skos:Concept ;
    skos:definition "Modification of the indirect agglutination assay, where the particles are coated with antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse passive agglutination" .

goldbook:09684 a skos:Concept ;
    skos:altLabel "two-site, noncompetitive immunoassay" ;
    skos:definition "Immunoassay using chemical or immunochemical binding of analyte to a solid phase carrying antibody and the immunochemical binding of a second (labelled) reagent to the analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sandwich immunoassay" .

goldbook:09685 a skos:Concept ;
    skos:altLabel "amplification of DNA" ;
    skos:definition "Process of producing multiple copies of a deoxyribonucleic acid (DNA) sequence by the repeated copying of a DNA segment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amplification of deoxyribonucleic acid" .

goldbook:09686 a skos:Concept ;
    skos:altLabel "bp" ;
    skos:definition "Pair of two nucleobases, consisting of one purine and one pyrimidine base, held together by hydrogen bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base pair" .

goldbook:09687 a skos:Concept ;
    skos:definition "Method for determining the nucleotide sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base sequence analysis" .

goldbook:09688 a skos:Concept ;
    skos:altLabel "BLAST" ;
    skos:definition "Computer algorithm that finds regions of local similarity between deoxyribonucleic acid (DNA) or protein sequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basic local alignment search tool" .

goldbook:09689 a skos:Concept ;
    skos:definition "Specialised deoxyribonucleic acid (DNA) technology for the production of multiple exact copies of a single gene or another segment of DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloning" .

goldbook:09690 a skos:Concept ;
    skos:definition "Deoxyribonucleic acid (DNA) molecule into which another DNA fragment of appropriate size can be integrated without the loss of its capacity for self-replication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloning vector" .

goldbook:09691 a skos:Concept ;
    skos:definition "Nucleotide sequence that can form a double-stranded structure with another deoxyribonucleic acid (DNA) sequence by following base-pairing (see base pair) rules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complementary sequence" .

goldbook:09692 a skos:Concept ;
    skos:definition "High-quality, low-error, gap-free deoxyribonucleic acid (DNA) sequence of an entire genome of an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complete genome sequence" .

goldbook:09693 a skos:Concept ;
    skos:altLabel "DNA damage",
        "damage to DNA" ;
    skos:definition "Alteration in the deoxyribonucleic acid (DNA) chemical structure resulting from interactions with physical or chemical agents occurring in the environment, generated in the organisms as by-products of metabolism, or used as therapeutics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "damage to deoxyribonucleic acid" .

goldbook:09694 a skos:Concept ;
    skos:definition "Loss of a part (one or more base pairs) of deoxyribonucleic acid (DNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deletion" .

goldbook:09695 a skos:Concept ;
    skos:definition "Type of pentose sugar that is incorporated in the structure of deoxyribonucleic acid (DNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribose" .

goldbook:09696 a skos:Concept ;
    skos:altLabel "DNA fragmentation",
        "fragmentation of DNA" ;
    skos:definition "Breaking and/or separation of large deoxyribonucleic acid (DNA) molecules into smaller pieces (fragments)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid fragmentation" .

goldbook:09697 a skos:Concept ;
    skos:altLabel "DFI",
        "DNA fragmentation index" ;
    skos:definition "Fraction of deoxyribonucleic acid (DNA) having fragmented DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid fragmentation index" .

goldbook:09698 a skos:Concept ;
    skos:altLabel "DNA integrity index" ;
    skos:definition "Ratio of longer fragments to shorter deoxyribonucleic acid (DNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid integrity index" .

goldbook:09699 a skos:Concept ;
    skos:altLabel "DNA mismatch",
        "mismatch in DNA",
        "multi-base mismatch",
        "single mismatch" ;
    skos:definition "Defect in the double stranded deoxyribonucleic acid (DNA) structure in which the DNA double helix contains one (or more) non-standard base pairs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid mismatch" .

goldbook:09700 a skos:Concept ;
    skos:altLabel "DNA profiling" ;
    skos:definition "Identification of individuals by matching characteristics of their genome deoxyribonucleic acid (DNA) sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid profiling" .

goldbook:09701 a skos:Concept ;
    skos:altLabel "DNA replication",
        "replication of DNA" ;
    skos:definition "Synthesis of new deoxyribonucleic acid (DNA) strands using existing DNA as a template." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid replication" .

goldbook:09702 a skos:Concept ;
    skos:altLabel "DNA sequencing",
        "sequencing of DNA" ;
    skos:definition "Determination of nucleotide sequence (the deoxyribonucleic acid (DNA) primary structure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid sequencing" .

goldbook:09703 a skos:Concept ;
    skos:definition "The twisted shape of two complementary strands of deoxyribonucleic acid (DNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double helix" .

goldbook:09704 a skos:Concept ;
    skos:definition "Enzyme that cleaves nucleic acids by hydrolysing phosphodiester bonds between nucleotides within a nucleic acid molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endonuclease" .

goldbook:09705 a skos:Concept ;
    skos:altLabel "exogenous DNA" ;
    skos:definition "Deoxyribonucleic acid (DNA) molecule of foreign origin that has been introduced into an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exogenous deoxyribonucleic acid" .

goldbook:09706 a skos:Concept ;
    skos:definition "Enzyme that cleaves nucleotides from free ends of a linear nucleic acid molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exonuclease" .

goldbook:09707 a skos:Concept ;
    skos:definition "Process for converting a gene’s coded information into biomolecules present and operating in the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene expression" .

goldbook:09708 a skos:Concept ;
    skos:definition "Technique involving hybridization of nucleic acids  used to study gene expression at the level of ribonucleic acid (RNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Northern blot" .

goldbook:09709 a skos:Concept ;
    skos:definition "Single stranded (ss) oligonucleotides (mainly deoxyribonucleic acid (DNA) or ribonucleic acid (RNA)) originating from in vitro selection, which, starting from random sequence libraries, optimise the nucleic acids for high-affinity binding to a given target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleic acid aptamers" .

goldbook:09710 a skos:Concept ;
    skos:definition "Purine or pyrimidine nitrogenous base occurring in deoxyribonucleic acid (DNA) or ribonucleic acid (RNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleobase" .

goldbook:09711 a skos:Concept ;
    skos:definition "Product of chemical modification of a nucleobase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleobase lesion" .

goldbook:09712 a skos:Concept ;
    skos:altLabel "base sequence" ;
    skos:definition "Order of nucleotides in a deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleotide sequence" .

goldbook:09713 a skos:Concept ;
    skos:altLabel "ORF" ;
    skos:definition "Sequence of deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) nucleotides, located between the start-code sequence (initiation codon) and the stop-code sequence (termination codon), which is transcribed and translated to generate a protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open reading frame" .

goldbook:09714 a skos:Concept ;
    skos:altLabel "PNA" ;
    skos:definition "Synthetic deoxyribonucleic acid (DNA) mimic, which contains 2-aminoethylglycine linkages instead of the negatively charged phosphodiesteric backbone of oligonucleotides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide nucleic acid" .

goldbook:09715 a skos:Concept ;
    skos:definition "Enzyme that catalyses the synthesis of nucleic acids on pre-existing nucleic acid templates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymerase" .

goldbook:09716 a skos:Concept ;
    skos:definition "Short pre-existing polynucleotide chain attached to a complementary stretch in template deoxyribonucleic acid (DNA) to which new deoxyribonucleotides can be added by DNA polymerase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primer" .

goldbook:09717 a skos:Concept ;
    skos:definition "Nitrogen-containing, double-ring, basic compound that occurs in nucleic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "purine" .

goldbook:09718 a skos:Concept ;
    skos:definition "Nitrogen-containing, single-ring, basic compound that occurs in nucleic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrimidine" .

goldbook:09719 a skos:Concept ;
    skos:altLabel "qPCR",
        "quantitative PCR" ;
    skos:definition "Polymerase chain reaction to quantify target nucleotide sequences of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitative polymerase chain reaction" .

goldbook:09720 a skos:Concept ;
    skos:altLabel "real-time PCR" ;
    skos:definition "Polymerase chain reaction where data are collected and monitored in real-time as the reaction proceeds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "real-time polymerase chain reaction" .

goldbook:09721 a skos:Concept ;
    skos:altLabel "recombinant DNA" ;
    skos:definition "Deoxyribonucleic acid (DNA) molecules joined together using recombinant deoxyribonucleic acid (DNA) technology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombinant deoxyribonucleic acid" .

goldbook:09722 a skos:Concept ;
    skos:definition "Process by which genetic material is broken and joined to other genetic material, which can lead to a rearrangement of genetic sequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombination" .

goldbook:09723 a skos:Concept ;
    skos:altLabel "RFLP" ;
    skos:definition "Variation between individuals in deoxyribonucleic acid (DNA) fragment sizes cut by specific restriction enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "restriction fragment length polymorphism" .

goldbook:09724 a skos:Concept ;
    skos:definition "Enzyme used to form a complementary deoxyribonucleic acid sequence (cDNA) from a ribonucleic acid (RNA) template." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse transcriptase" .

goldbook:09725 a skos:Concept ;
    skos:definition "Method for determining a nucleotide sequence of deoxyribonucleic acid (DNA) based on incorporating chain-terminating dideoxynucleotides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sanger sequencing" .

goldbook:09726 a skos:Concept ;
    skos:definition "Method used for determining the order of bases in long DNA using sequencing of deoxyribonucleic acid (DNA) broken up randomly into numerous small segments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shotgun method" .

goldbook:09727 a skos:Concept ;
    skos:altLabel "SNP",
        "point mutation" ;
    skos:definition "Variant of nucleotide sequence of deoxyribonucleic acid (DNA) in which the purine or pyrimidine base of a single nucleotide is replaced by another such base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single nucleotide polymorphism" .

goldbook:09728 a skos:Concept ;
    skos:definition "Technique based on deoxyribonucleic acid (DNA) hybridization used for the detection of a DNA fragment of specific nucleotide sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Southern blot" .

goldbook:09729 a skos:Concept ;
    skos:definition "Interruption of the sugar-phosphate backbone of a polynucleotide chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "strand break" .

goldbook:09730 a skos:Concept ;
    skos:definition "Multiple consecutive copies of the same nucleotide sequence on a chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tandem repeat sequence" .

goldbook:09731 a skos:Concept ;
    skos:definition "Enzyme that directs the replication of telomeres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "telomerase" .

goldbook:09732 a skos:Concept ;
    skos:definition "Repetitive nucleotide sequences present at the ends of a chromosome that protect the chromosome from deterioration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "telomere" .

goldbook:09733 a skos:Concept ;
    skos:altLabel "YAC" ;
    skos:definition "Vector used to clone large deoxyribonucleic acid (DNA) fragments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "yeast artificial chromosome" .

goldbook:09734 a skos:Concept ;
    skos:definition "Process occurring during gene expression that allows the generation of multiple protein molecules from one gene. It generally involves the processing of messenger ribonucleic acid (mRNA) via elimination of introns." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternative splicing" .

goldbook:09735 a skos:Concept ;
    skos:definition "Approach to identify proteins and characterise their amino acid sequences or post-translational modifications by sequential combination of proteolysis (enzymatic proteolysis and chemical proteolysis) prior to mass spectrometric analysis of the resulting proteolytic peptides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bottom-up proteomics" .

goldbook:09736 a skos:Concept ;
    skos:definition "Chemical method for C-terminal sequencing of proteins and peptides starting at their C-terminus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "C-terminal analysis" .

goldbook:09737 a skos:Concept ;
    skos:definition "End of an amino acid chain (protein or polypeptide), terminated by a carboxylic group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "C-terminus" .

goldbook:09738 a skos:Concept ;
    skos:definition "Bioinformatics analysis of proteomic mass spectrometric data used in order to identify a protein or its post-translational modification. It results in a list of candidates presented mostly in order of the decreasing statistical significance of the hit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "database searching" .

goldbook:09739 a skos:Concept ;
    skos:altLabel "DIGE" ;
    skos:definition "Measurement method of two-dimensional gel electrophoresis used to study protein expression regulation by the differential staining of multiple gels representing different states of a proteome, preferably with fluorescent dyes (e.g. \\(\\ce{Cy{3}}\\), \\(\\ce{Cy{5}}\\), \\(\\ce{Cy{2}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "difference gel electrophoresis" .

goldbook:09740 a skos:Concept ;
    skos:definition "Chemical reduction of protein disulfide bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disulfide bond cleavage" .

goldbook:09741 a skos:Concept ;
    skos:definition "Method of N-terminal analysis in which the N-terminal amino acid residue is labelled and cleaved from the peptide without affecting other peptide bonds in the peptide chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Edman degradation" .

goldbook:09742 a skos:Concept ;
    skos:altLabel "ETD" ;
    skos:definition "Ion fragmentation technique in mass spectrometry-driven proteomics based on the transfer of low energy electrons to the molecules selected for fragmentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-transfer dissociation" .

goldbook:09743 a skos:Concept ;
    skos:altLabel "EthcD" ;
    skos:definition "Ion fragmentation technique in mass spectrometry-driven proteomics that is a combination of electron-transfer dissociation (ETD) and higher-energy collision dissociation (HCD) in Kingdon trap instruments (Orbitrap™)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-transfer/higher-energy collision dissociation" .

goldbook:09744 a skos:Concept ;
    skos:altLabel "ESI" ;
    skos:definition "Soft ionisation technique in mass spectrometry-driven proteomics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrospray ionisation" .

goldbook:09745 a skos:Concept ;
    skos:altLabel "differential proteomics" ;
    skos:definition "Field of study in proteomics that deals with the determination of changes in protein expression and regulation in response to different stimuli, internal or external. It also includes the analysis of post-translational modifications (e.g. phosphorylation, glycosylation, etc.), their identification, and their localisation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "expression proteomics" .

goldbook:09746 a skos:Concept ;
    skos:definition "Field of study in proteomics studying protein interactions on different levels: protein-protein interactions (interactomics), the formation of protein complexes, and the interaction of proteins with other biomolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional proteomics" .

goldbook:09747 a skos:Concept ;
    skos:altLabel "PAGE" ;
    skos:definition "Separation technique used to separate or fractionate proteins and larger peptides according to their relative molecular mass using an electric field in polyacrylamide gel (PAGE)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel electrophoresis" .

goldbook:09748 a skos:Concept ;
    skos:altLabel "HCD" ;
    skos:definition "Ion fragmentation technique in mass spectrometry-driven proteomics used mostly in Kingdon trap (Orbitrap™) instruments. It does not have low mass cut-off of collision-induced dissociation (CID) and therefore is used for the tandem mass tag of stable isotope labels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "higher-energy collision dissociation" .

goldbook:09749 a skos:Concept ;
    skos:altLabel "IEF" ;
    skos:definition "Separation technique used to separate or fractionate proteins and peptides in a gel (or similar type of media) according to their isoelectric point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoelectric focusing" .

goldbook:09750 a skos:Concept ;
    skos:altLabel "mass mapping",
        "peptide mass fingerprinting" ;
    skos:definition "Protein analysis where an unknown protein is chemically or enzymatically cleaved into peptide fragments whose masses are determined by mass spectrometry. The peptide masses are compared to peptide masses calculated for known proteins in a database and analysed statistically to determine the best match." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass fingerprinting" .

goldbook:09751 a skos:Concept ;
    skos:definition "Mass spectrometric method used for protein/peptide identification based on protein sequencing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "MS/MS data based identification" .

goldbook:09752 a skos:Concept ;
    skos:altLabel "MudPIT" ;
    skos:definition "Non-gel step-wise multidimensional technique for separating and identifying individual components of complex protein and peptide mixtures. It combines fractionation of proteolytic peptides in steps on a strong cation exchanger (SAX) using ion exchange chromatography (IEC); each step uses higher elution force. Then, each fraction is separated on reversed phase liquid chromatography and analysed using mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multidimensional protein identification technology" .

goldbook:09753 a skos:Concept ;
    skos:definition "Chemical method for N-terminal sequencing of proteins and peptides starting at their N-terminus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "N-terminal analysis" .

goldbook:09754 a skos:Concept ;
    skos:definition "The end of an amino acid chain (protein or polypeptide), terminating in a free primary amine group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "N-terminus" .

goldbook:09755 a skos:Concept ;
    skos:altLabel "OFFGEL™" ;
    skos:definition "Separation technique used to fractionate proteins and peptides into discrete liquid fractions according to their isoelectric point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "off-gel isoelectric focusing" .

goldbook:09756 a skos:Concept ;
    skos:definition "Protein/peptide sequencing approach using overlapping complementary information on a sequence acquired using proteolysis in bottom-up proteomic analysis by at least two different proteolytic approaches." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "off peptide product ions" .

goldbook:09757 a skos:Concept ;
    skos:definition "Analytical process that derives an amino acid sequence of a peptide from its tandem mass spectrum without the assistance of a sequence database." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide de novo sequencing" .

goldbook:09758 a skos:Concept ;
    skos:definition "Product ion which originates in a peptide precursor ion fragmentation process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide fragment ion" .

goldbook:09759 a skos:Concept ;
    skos:definition "Mass spectrometric technique that serves to generate peptide fragment ions through the fragmentation of peptide precursor ions via different physicochemical processes in an ion source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide fragmentation technique" .

goldbook:09760 a skos:Concept ;
    skos:definition "Peptide ion generated during the ionisation of peptides in an ion source or during tandem mass spectrometry of an intact protein in top-down proteomic analysis, selected for further analysis by means of tandem mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide precursor ion" .

goldbook:09761 a skos:Concept ;
    skos:definition "Study of the set of peptides in an organism, its peptidome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptidomics" .

goldbook:09762 a skos:Concept ;
    skos:definition "Ensemble of two or more different associated proteins, each with a specific function, linked by non-covalent protein-protein interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein complex" .

goldbook:09763 a skos:Concept ;
    skos:definition "Set of methods serving to purify the intact protein complex for further analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein complex purification" .

goldbook:09764 a skos:Concept ;
    skos:definition "Collection of protein sequences from several sources, including translations from annotated genetic coding regions, as well as original protein and peptide sequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein database" .

goldbook:09765 a skos:Concept ;
    skos:definition "Physicochemical process by which a polypeptide folds into its characteristic and functional three-dimensional structure from a random coil." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein folding" .

goldbook:09766 a skos:Concept ;
    skos:altLabel "protein separation" ;
    skos:definition "Methodical approach to simplify a complex mixture of proteomic sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein fractionation" .

goldbook:09767 a skos:Concept ;
    skos:definition "Process which happens during tandem mass spectrometry of intact proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein fragmentation" .

goldbook:09768 a skos:Concept ;
    skos:definition "Analytical approach leading to the identity of a protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein identification" .

goldbook:09769 a skos:Concept ;
    skos:definition "Supramolecular interacting system, such as a metabolic circuit, intracellular signal transduction, or cell-to-cell communication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein machine" .

goldbook:09770 a skos:Concept ;
    skos:definition "Series of processes conducted to isolate either the whole proteome or a subset from a biological sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein purification" .

goldbook:09771 a skos:Concept ;
    skos:definition "Analytical methods and related techniques to measure the protein content." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein quantification" .

goldbook:09772 a skos:Concept ;
    skos:definition "Equipment designed for the automatic determination of amino acid sequences of peptides using a method of N-terminal analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein sequencer" .

goldbook:09773 a skos:Concept ;
    skos:definition "Technique used to visualise proteins separated on electrophoretic slab gels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein staining" .

goldbook:09774 a skos:Concept ;
    skos:definition "All of the different molecular forms in which the protein product of a single gene can be found, including changes due to genetic variations, alternatively spliced ribonucleic acid (RNA) transcripts, and post-translational modifications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteoform" .

goldbook:09775 a skos:Concept ;
    skos:definition "Field of biological research in-between proteomics and genomics using proteomic information (mostly derived from mass spectrometry) to improve gene annotations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteogenomics" .

goldbook:09776 a skos:Concept ;
    skos:definition "Protein cleavage to generate proteolytic peptides for bottom-up proteomic analysis, either enzymatic or chemical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteolysis" .

goldbook:09777 a skos:Concept ;
    skos:definition "Exposure of a sample to proteolytic reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteolytic digestion" .

goldbook:09778 a skos:Concept ;
    skos:definition "Group of enzymes that cleave the polypeptide into shorter oligopeptides (peptides) and amino acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteolytic enzyme" .

goldbook:09779 a skos:Concept ;
    skos:definition "Peptide generated via proteolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteolytic peptide" .

goldbook:09780 a skos:Concept ;
    skos:definition "Complex and comprehensive study of proteomes, particularly proteins, and the way they are expressed, modified, involved in metabolism, as well as of their interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteomics" .

goldbook:09781 a skos:Concept ;
    skos:definition "Type of protein/peptide quantification, where the relative amounts of one protein in different samples is determined, i.e. the ratio of the content of a protein/peptide in sample 1 to sample 2." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative quantification" .

goldbook:09782 a skos:Concept ;
    skos:definition "Techniques which serve to quantify protein content by means of mass spectrometry. The principle lies in the introduction of a mass tag to an internal standard protein/peptide containing different stable isotopes than the protein/peptide in the sample. Mass resolved signals originating in the internal standard and the sample are read individually and evaluated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable isotope labelling" .

goldbook:09783 a skos:Concept ;
    skos:definition "Field in proteomics which focuses on higher orders of the protein structure, mainly tertiary or quaternary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural proteomics" .

goldbook:09784 a skos:Concept ;
    skos:definition "Approach in proteomics focused on the selected proteins of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "targeted proteomics" .

goldbook:09785 a skos:Concept ;
    skos:definition "Arrangement of all atoms of a protein molecule or a subunit of a protein molecule in space, without regard to its relationship with neighbouring molecules or subunits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tertiary structure of a protein" .

goldbook:09786 a skos:Concept ;
    skos:definition "Approach to identify proteins and characterise their amino acid sequences or post-translational modifications either by direct mass spectrometric analysis of an ionised protein molecule or by sequential combination of protein/peptide fragmentation in the ion source or mass analyser with ion trapping mass spectrometers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "top-down proteomics" .

goldbook:09787 a skos:Concept ;
    skos:definition "Serine protease with highly specific primary endoproteolytic activity that serves to generate proteolytic peptides in bottom-up proteomics analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trypsin" .

goldbook:09788 a skos:Concept ;
    skos:altLabel "2D PAGE" ;
    skos:definition "Technique used to separate proteins using isoelectric focusing in a gel. The proteins are then further separated in the second dimension using denaturing PAGE." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-dimensional gel electrophoresis" .

goldbook:09789 a skos:Concept ;
    skos:definition "Immunoanalytical technique for the identification of polypeptides separated using gel electrophoresis. The polypeptide is transferred by blotting to a membrane, where it undergoes specific interaction with primary antibody that is specific to the protein of interest. The peptides are detected as complexes by a label and/or enzymatic reaction, which may be conjugated to the primary antibody directly or via a separate (secondary) antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Western blot" .

goldbook:09790 a skos:Concept ;
    skos:definition "Sample pretreatment to degrade complex metabolites in the presence of oxygen; a method for amplifying the concentration of native metabolites in solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cultivation" .

goldbook:09791 a skos:Concept ;
    skos:definition "Metabolomic workflow composed of sampling, metabolism quenching, metabolite extraction, metabolite analyses, data analysis, and interpretation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "design of experiment" .

goldbook:09792 a skos:Concept ;
    skos:definition "Complete set of metabolites inside a cell (intracellular metabolites)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endometabolome" .

goldbook:09793 a skos:Concept ;
    skos:definition "Process removing compounds and their metabolites from the body, usually through the kidneys (via urine) or in the feces. Unless excretion is complete, the accumulation of foreign substances can adversely affect normal metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excretion" .

goldbook:09794 a skos:Concept ;
    skos:definition "Complete set of metabolites outside the cell (extracellular environment)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exometabolome" .

goldbook:09795 a skos:Concept ;
    skos:definition "Qualitative analysis of the endometabolome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fingerprinting" .

goldbook:09796 a skos:Concept ;
    skos:definition "In vivo measurements of metabolic fluxes and integration of the results into stoichiometric network models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluxomics" .

goldbook:09797 a skos:Concept ;
    skos:definition "Qualitative analysis of the exometabolome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "footprinting" .

goldbook:09798 a skos:Concept ;
    skos:definition "Glycoside of glucuronic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glucuronide" .

goldbook:09799 a skos:Concept ;
    skos:definition "All metabolic products of the main compound (e.g. phase 1 and phase 2 metabolites) with the routes of metabolism and the excreted metabolites in body fluids, e.g. in urine or blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolic pathway" .

goldbook:09800 a skos:Concept ;
    skos:definition "Physical or chemical methodology used for rapidly breaking all biochemical processes in metabolomic samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolism quenching" .

goldbook:09801 a skos:Concept ;
    skos:definition "Unique pattern characterizing the metabolism in a given living phase that does not attempt to identify or quantify all the metabolites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolite fingerprinting and footprinting" .

goldbook:09802 a skos:Concept ;
    skos:definition "Strategy to identify and quantify a particular set of metabolites belonging to a specific metabolic pathway or class of compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolite profiling" .

goldbook:09803 a skos:Concept ;
    skos:definition "Complete set (from \\(\\pu{50}\\) to \\(\\pu{1000}\\) metabolites) of organic or inorganic compounds of low relative molecular mass, present in the cell or organism and which participate in the metabolic reactions required for growth, maintenance, and normal functioning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolome" .

goldbook:09804 a skos:Concept ;
    skos:definition "Complex and comprehensive study of metabolome; identification and quantification of the small molecule metabolic products of a biological system (cell, tissue, organ, biological fluid, or organism) at a specific point in time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolomics" .

goldbook:09805 a skos:Concept ;
    skos:definition "Measurement of the dynamic multiparametric metabolic response of a living system to pathophysiological stimuli or genetic modification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabonomics" .

goldbook:09806 a skos:Concept ;
    skos:definition "Metabolite directly involved in the normal life processes of each cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary metabolite" .

goldbook:09807 a skos:Concept ;
    skos:altLabel "nucleotide sugar" ;
    skos:definition "Activated form of monosaccharide linked to a nucleotide to be available in a high-energy state for glycosyl transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated nucleotide sugar" .

goldbook:09808 a skos:Concept ;
    skos:altLabel "glycosidic hydroxy group" ;
    skos:definition "Hydroxy group that originates from the aldehydic or ketonic group of a monosaccharide after ring closure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anomeric hydroxy group" .

goldbook:09809 a skos:Concept ;
    skos:altLabel "glycan" ;
    skos:definition "Monosaccharide, oligosaccharide and polysaccharide substances, as well as substances derived from a monosaccharide by reduction of the carbonyl group (alditol), by oxidation, including the oxidation of one or more terminal groups of a carboxylic acid, or by replacement of one or more hydroxy groups by a hydrogen atom, an amino group, a thiol group, or by similar heteroatomic groups. This term also includes derivatives of these of these compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbohydrate" .

goldbook:09810 a skos:Concept ;
    skos:definition "Field of glycoproteomics that studies that the changes in the structures and expression levels of glycoproteins under different conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comparative glycoproteomics" .

goldbook:09811 a skos:Concept ;
    skos:definition "Field of proteoglycomics that studies the changes in the structures and expression levels of proteoglycans under different conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comparative proteoglycomics" .

goldbook:09812 a skos:Concept ;
    skos:definition "Glycans attached to a surface of a microarray." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycan microarray" .

goldbook:09813 a skos:Concept ;
    skos:definition "Determination of the diversity of glycan structures expressed on glycoconjugates or cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycan profiling" .

goldbook:09814 a skos:Concept ;
    skos:altLabel "carbohydrate-binding protein" ;
    skos:definition "Protein that recognises and binds to specific glycans and mediates their biological function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycan-binding protein" .

goldbook:09815 a skos:Concept ;
    skos:definition "Specific form of a glycoprotein containing a distinct glycan structure per glycosylation site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycoform" .

goldbook:09816 a skos:Concept ;
    skos:definition "Gene encoding an enzyme or other functional protein for glycan synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycogene" .

goldbook:09817 a skos:Concept ;
    skos:definition "Compound containing a glycan covalently linked to a lipid aglycon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycolipid" .

goldbook:09818 a skos:Concept ;
    skos:definition "Complete set of glycans and glycoconjugates produced by a species, tissue, or cell in a specified time, space, and environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycome" .

goldbook:09819 a skos:Concept ;
    skos:definition "Complex and comprehensive study of the glycome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycomics" .

goldbook:09820 a skos:Concept ;
    skos:definition "Carbohydrate part of a glycoconjugate or a glycoside." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycone" .

goldbook:09821 a skos:Concept ;
    skos:definition "Protein with one or more covalently bound glycans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycoprotein" .

goldbook:09822 a skos:Concept ;
    skos:definition "Comprehensive analysis of glycoproteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycoproteomics" .

goldbook:09823 a skos:Concept ;
    skos:definition "Enzyme that catalyses the hydrolysis of glycosidic linkages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosidase" .

goldbook:09824 a skos:Concept ;
    skos:definition "Mixed acetal formally arising by the elimination of water between the hemiacetal or hemiketal hydroxy group of a sugar and a hydroxy group of a second compound. Glycan containing at least one glycosidic linkage to another glycan or an aglycon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycoside" .

goldbook:09825 a skos:Concept ;
    skos:altLabel "glycosidic bond" ;
    skos:definition "Linkage of a monosaccharide to another residue via the anomeric hydroxy group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosidic linkage" .

goldbook:09826 a skos:Concept ;
    skos:definition "Monosaccharide ring without the anomeric oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosyl" .

goldbook:09827 a skos:Concept ;
    skos:definition "Covalent attachment of a saccharide to a protein, lipid, polynucleotide, saccharide, or other organic compound, generally catalysed by enzymes glycosyltransferases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosylation" .

goldbook:09828 a skos:Concept ;
    skos:definition "Enzyme that catalyses the transfer of a saccharide from a nucleotide di(mono)phosphate-activated sugar to an acceptor molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosyltransferase" .

goldbook:09829 a skos:Concept ;
    skos:definition "Compound having the general formula \\(\\ce{RCH(OH)(OR^{\\prime})}\\) (\\(\\ce{R^{\\prime}}  eq \\ce{H}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemiacetal" .

goldbook:09830 a skos:Concept ;
    skos:definition "Compound having the general formula \\(\\ce{R2C(OH)OR^{\\prime}}\\) (\\(\\ce{R^{\\prime}}  eq \\ce{H}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemiketal" .

goldbook:09831 a skos:Concept ;
    skos:definition "Saccharide binding protein of non-immune origin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lectin" .

goldbook:09832 a skos:Concept ;
    skos:definition "Lectins with distinct saccharide-binding specificity arranged on a microarray platform." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lectin microarray" .

goldbook:09833 a skos:Concept ;
    skos:definition "Systematic study of the structure, expression, and function of proteoglycans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteoglycomics" .

goldbook:09834 a skos:Concept ;
    skos:definition "Term frequently applied to monosaccharides and lower oligosaccharides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sugar" .

goldbook:09835 a skos:Concept ;
    skos:altLabel "alkaline hydrolysis" ;
    skos:definition "Treatment with alkaline solution (e.g. hydrazine, \\(\\ce{KOH}\\), \\(\\ce{NaOH}\\)) useful for the cleavage of fatty acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkaline degradation" .

goldbook:09836 a skos:Concept ;
    skos:definition "Intermediate structural region between the O-polysaccharide and lipid A moiety of lipopolysaccharides (LPS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core oligosaccharide" .

goldbook:09837 a skos:Concept ;
    skos:altLabel "FA" ;
    skos:definition "Diverse group of lipid molecules synthesised by chain elongation of an acetyl-CoA primer with malonyl-CoA (or methylmalonyl-CoA) groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fatty acyls" .

goldbook:09838 a skos:Concept ;
    skos:altLabel "GL" ;
    skos:definition "Esters, ethers, and other O-derivatives of glycerol with alkyls or alkenyls, including mono-, di-, and tri-substituted glycerols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycerolipids" .

goldbook:09839 a skos:Concept ;
    skos:altLabel "GP",
        "phospholipids" ;
    skos:definition "Lipids with glycerol backbone esterified with one or two fatty acids in position \\(\\ce{C-1}\\) and/or \\(\\ce{C-2}\\) and with phosphoric acid at position \\(\\ce{C-3}\\). The phosphate group is usually esterified with an alcohol (choline, ethanolamine, serine, inositol, glycerol) to form the 'lipid head group'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycerophospholipids" .

goldbook:09840 a skos:Concept ;
    skos:definition "Glycolipid component of lipopolysaccharides (LPSs) that is integrated into the bacterial cell wall and is responsible for the beneficial (immunostimulatory) or toxic (immunopathological) effects of the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid A" .

goldbook:09841 a skos:Concept ;
    skos:altLabel "adiposomes",
        "lipid bodies",
        "lipid particles",
        "oil bodies",
        "oleosomes" ;
    skos:definition "Round-shaped intracellular inclusions consisting of hydrophobic cores (mainly triacylglycerols, sterol esters, occasionally free fatty acids or squalene) covered by a phospholipid monolayer containing a specific set of proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid droplets" .

goldbook:09842 a skos:Concept ;
    skos:definition "Isolation of lipids in their native state from samples of different origin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid extraction" .

goldbook:09843 a skos:Concept ;
    skos:definition "Lipidomics technique conferring unbiased information about total lipids within a particular cell type, tissue, or body fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid profiling" .

goldbook:09844 a skos:Concept ;
    skos:definition "Changes in the lipid molecules composition after completion of their biosynthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid remodelling" .

goldbook:09845 a skos:Concept ;
    skos:definition "Complete set of lipid species and their metabolites present within a particular cell type, tissue, or body fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipidome" .

goldbook:09846 a skos:Concept ;
    skos:definition "Systematic and comprehensive study aimed at the identification, profiling, and quantification of lipidome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipidomics" .

goldbook:09847 a skos:Concept ;
    skos:altLabel "LOS" ;
    skos:definition "Lipopolysaccharide produced by specific wild-type bacteria that give a smooth-colony appearance when cultured on agar plates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipooligosaccharide" .

goldbook:09848 a skos:Concept ;
    skos:definition "Study of the structure-activity relationship of bacterial lipopolysaccharides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipopolysaccharidomics" .

goldbook:09849 a skos:Concept ;
    skos:definition "Planar structure spontaneously formed by amphipathic lipids in a polar (aqueous) environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane bilayer" .

goldbook:09850 a skos:Concept ;
    skos:definition "Dynamic, nanometre-sized, highly ordered, membrane domains enriched in sterols and sphingolipids. They contain specific sets of membrane proteins that are sorted into rafts by their specific physical properties and specific lipid-protein interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane rafts" .

goldbook:09851 a skos:Concept ;
    skos:definition "Specific structure of lipid molecules (glycerophospholipids) in aqueous environments and membranes as a function of the ratio between the cross-sections of their polar heads and hydrophobic tails." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular shape of lipids" .

goldbook:09852 a skos:Concept ;
    skos:definition "Part of a lipopolysaccharide that consists of a polysaccharide chain extending outwards from the bacterial cell surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "O-polysaccharide" .

goldbook:09853 a skos:Concept ;
    skos:definition "Assemblies of lipids and proteins in blood plasma transporting lipids between tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma lipoproteins" .

goldbook:09854 a skos:Concept ;
    skos:altLabel "PUFA" ;
    skos:definition "Fatty acids with more than one double bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyunsaturated fatty acids" .

goldbook:09855 a skos:Concept ;
    skos:altLabel "PR" ;
    skos:definition "Lipids containing a linear chain of isoprenoid groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prenol lipids" .

goldbook:09856 a skos:Concept ;
    skos:definition "Proteins with covalently linked lipids, e.g. fatty acid or glycophosphatidylinositol (GPI)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteolipids" .

goldbook:09857 a skos:Concept ;
    skos:altLabel "SL" ;
    skos:definition "Biomolecules where fatty acids are directly bound to a saccharide backbone, thus forming structures similar to glycerolipids or glycerophospholipids, with saccharide substituting for the glycerol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saccharolipids" .

goldbook:09858 a skos:Concept ;
    skos:definition "Methodological approach based on the direct analysis of the total lipid extracts from cells or tissues without an online chromatographic separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shotgun lipidomics" .

goldbook:09859 a skos:Concept ;
    skos:altLabel "lipid mediators" ;
    skos:definition "Lipid molecules involved in intracellular signalling and the regulation of cell death, immune response, or inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signalling lipids" .

goldbook:09860 a skos:Concept ;
    skos:altLabel "SP" ;
    skos:definition "Complex family of lipids that contain a sphingoid base backbone and a fatty acyl chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sphingolipids" .

goldbook:09861 a skos:Concept ;
    skos:altLabel "ST" ;
    skos:definition "Structural derivatives of tetracyclic alcohols with a hydroxyl group in the position \\(\\ce{C-3}\\) and an aliphatic side chain in the position \\(\\ce{C-17}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sterol lipids" .

goldbook:09862 a skos:Concept ;
    skos:definition "Lipids (mainly glycerophospholipids, sterols and sphingolipids) involved in the formation of biological membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural lipids" .

goldbook:09863 a skos:Concept ;
    skos:definition "Analytical technique focusing on the quantification of specific lipids of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "targeted lipidomics" .

goldbook:09864 a skos:Concept ;
    skos:altLabel "UI" ;
    skos:definition "Measure of the number of double bonds in fatty acids moieties of phospholipids, calculated as the fraction of each unsaturated fatty acid multiplied by the number of double bonds within that fatty acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unsaturation index" .

goldbook:09865 a skos:Concept ;
    skos:definition "Specifically-designed single-stranded nucleic acid with a defined (known) nucleotide sequence immobilised on a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capture probe" .

goldbook:09866 a skos:Concept ;
    skos:definition "Method for studying deoxyribonucleic acid (DNA)–protein and/or protein–protein interactions in the context of chromatin, suitable for the identification of binding sites of proteins in genome DNA, etc. This method combines chemical cross-linking, the isolation of specific protein conjugates by immunoprecipitation, and polymerase chain reaction (PCR) amplification of co-precipitated DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatin immunoprecipitation" .

goldbook:09867 a skos:Concept ;
    skos:definition "Formation of a covalent bridge between two biomacromolecules or between two segments of the same biomacromolecule using reactive substances (e.g. formaldehyde, bifunctional aldehydes such as glutaraldehyde, or cisplatin) or photochemical processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-linking" .

goldbook:09868 a skos:Concept ;
    skos:altLabel "FISH" ;
    skos:definition "Cytogenetic technique used to detect and localise the presence or absence of specific deoxyribonucleic acid (DNA) sequences on chromosomes. It uses fluorescent probes that only bind to those parts of the chromosome with which they show a high degree of sequence complementarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescent <em>in situ</em> hybridization" .

goldbook:09869 a skos:Concept ;
    skos:definition "Process in which molecules are bound within a minor or major groove of the deoxyribonucleic acid (DNA) double helix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "groove binding" .

goldbook:09870 a skos:Concept ;
    skos:definition "Assay with specifically designed single-stranded deoxyribonucleic acid (DNA) probe with a defined (known) nucleotide sequence usually immobilised on a surface (in such a case, the nucleic acid probe is called the capture probe)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybridization assay" .

goldbook:09871 a skos:Concept ;
    skos:definition "Virtual map depicting protein–protein interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interactome" .

goldbook:09872 a skos:Concept ;
    skos:definition "Complex and comprehensive study of the interactions between various proteins and between protein and other molecules within a cell, such as nucleic acids and metabolites, as well as the consequences of these interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interactomics" .

goldbook:09873 a skos:Concept ;
    skos:definition "Interactions between (parts of) two biomolecule chains (e.g. base pairing in deoxyribonucleic acid (DNA) double helix, or the interactions between two polypeptide chains, or between a DNA and a protein molecule)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermolecular interactions" .

goldbook:09874 a skos:Concept ;
    skos:definition "Interactions between (neighbouring or distant) segments within the same biomolecule chain (e.g. base pairing in hairpin or monomolecular tetraplex structures of deoxyribonucleic acid (DNA) or ribonucleic acid (RNA), the interactions stabilizing the secondary or tertiary structures of proteins, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramolecular interactions" .

goldbook:09875 a skos:Concept ;
    skos:definition "Interactions between biomolecules or within a biomolecule (e.g. hydrogen bonds, electrostatic interactions, and van der Waals forces) taking part in the stabilization of proper biomolecule structure and intermolecular interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-covalent interactions" .

goldbook:09876 a skos:Concept ;
    skos:definition "Binding of a protein to deoxyribonucleic acid (DNA) independent of the nucleotide sequence or the conformation of the DNA, often with a strong contribution of electrostatic interaction between the negatively charged sugar-phosphate backbone of the DNA and basic amino acid residues of the protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-specific binding" .

goldbook:09877 a skos:Concept ;
    skos:definition "Formation of specific or non-specific complexes between deoxyribonucleic acid (DNA) or ribonucleic acid (RNA) and proteins, mediated and stabilised by a network of non-covalent interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleic acid–protein interaction" .

goldbook:09878 a skos:Concept ;
    skos:altLabel "PPI" ;
    skos:definition "Association of one protein with one or more other proteins to form either homo- or heteromeric proteins or protein complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein–protein interaction" .

goldbook:09879 a skos:Concept ;
    skos:definition "Approach used for studying protein–protein interactions analogous to immunoprecipitation, using (instead of antibody) one of the interacting proteins (the 'bait') immobilised at a surface to capture the other protein (the 'prey')." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pull-down assay" .

goldbook:09880 a skos:Concept ;
    skos:altLabel "signalling probe" ;
    skos:definition "Specifically designed single-stranded deoxyribonucleic acid (ssDNA) (alternatively, ribonucleic acid (RNA) or a synthetic nucleic acid analogue such as locked nucleic acid (LNA) or peptide nucleic acid (PNA)) with a defined (known) nucleotide sequence used to detect complementary DNA or RNA sequence in a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reporter probe" .

goldbook:09881 a skos:Concept ;
    skos:definition "Binding of proteins to specific sites in deoxyribonucleic acid (DNA) based on the precise recognition of nucleotide sequence and/or conformation of the DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific binding" .

goldbook:09882 a skos:Concept ;
    skos:definition "Attractive interaction between planar aromatic rings, in nucleic acids being one of the critical forces stabilizing double- and multistranded structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stacking interactions" .

goldbook:09883 a skos:Concept ;
    skos:altLabel "TUNEL" ;
    skos:definition "Method for the determination of strand breaks and DNA fragmentation in cells based on labelling and quantification of free 3′-OH ends of deoxyribonucleic acid (DNA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tunel test" .

goldbook:09884 a skos:Concept ;
    skos:definition "Molecular biology method for studying protein–protein or protein–deoxyribonucleic acid (DNA) interactions in cellular (yeast or bacterial) milieu." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two hybrid system" .

goldbook:09885 a skos:Concept ;
    skos:definition "Form in which the stationary phase is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatographic bed" .

goldbook:09886 a skos:Concept ;
    skos:altLabel "immobilized stationary phase material" ;
    skos:definition "Stationary phase which has been immobilized on the support particles or on the inner wall of the column, e.g. by a physical attraction (coated stationary phase), by chemical bonding (bonded stationary phase), or by in situ polymerisation (cross-linked stationary phase) after coating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immobilized stationary phase" .

goldbook:09887 a skos:Concept ;
    skos:altLabel "CCC" ;
    skos:definition "Partition chromatography which uses two immiscible liquid phases and no solid support. One liquid acts as the stationary phase and the other as the mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "countercurrent chromatography" .

goldbook:09888 a skos:Concept ;
    skos:altLabel "chiral chromatography",
        "chiral electrophoresis",
        "enantioselective electrophoresis" ;
    skos:definition "Separation of enantiomeric species due to the enantioselectivity of their interaction with the chiral selector(s) of a chromatographic (electrophoretic) system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantioselective chromatography" .

goldbook:09889 a skos:Concept ;
    skos:definition "Liquid chromatography for the separation of macromolecules and particles based on the difference in the speed of the mobile phase flow between the column axis and column wall and the specific size-dependent distribution of particles across the column cross-section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrodynamic chromatography" .

goldbook:09890 a skos:Concept ;
    skos:altLabel "HILIC" ;
    skos:definition "Liquid chromatography in which the molecules are partitioned between a water-enriched layer, which is immobilised on a hydrophilic (polar) stationary phase, and a less-polar mobile phase, containing water and organic solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophilic-interaction liquid chromatography" .

goldbook:09891 a skos:Concept ;
    skos:altLabel "HIC" ;
    skos:definition "Chromatography in which molecules are separated by interactions between their hydrophobic moieties and hydrophobic sites on the surface of the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophobic-interaction chromatography" .

goldbook:09892 a skos:Concept ;
    skos:definition "Exclusion chromatography in which ionized compounds are excluded from the pores of the support and elute first, while weakly ionized and non-ionic compounds elute later." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-exclusion chromatography" .

goldbook:09893 a skos:Concept ;
    skos:definition "Liquid chromatography in which the mobile liquid phase contains an ionized additive (an ion-pair reagent) that can form an ion pair with an analyte molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-pair chromatography" .

goldbook:09894 a skos:Concept ;
    skos:definition "Chromatography based on the different ability of substances to form complexes with metal ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand exchange chromatography" .

goldbook:09895 a skos:Concept ;
    skos:definition "Reversed-phase liquid chromatography which uses a mobile phase containing a surfactant above its critical micellar concentration (cmc)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar chromatography" .

goldbook:09896 a skos:Concept ;
    skos:altLabel "isocratic analysis" ;
    skos:definition "Chromatography in which the composition of the mobile phase remains constant during elution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isocratic elution" .

goldbook:09897 a skos:Concept ;
    skos:definition "Inner diameter of the column tubing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "column diameter" .

goldbook:09898 a skos:Concept ;
    skos:definition "Length of that part of the column tube that contains the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "column length" .

goldbook:09899 a skos:Concept ;
    skos:definition "Cross-sectional area of the empty tube: \\(A_{\\rm{c}} = \\pi r_{\\rm{c}}^{2} = \\pi (d_{\\rm{c}}/2)^{2}\\), where \\(d_{\\rm{c}}\\) is the column diameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-sectional area of the column" .

goldbook:09900 a skos:Concept ;
    skos:definition "Average thickness of the liquid stationary phase film coated on the inside wall of the column tubing of an open-tubular column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-phase film thickness" .

goldbook:09901 a skos:Concept ;
    skos:definition "Column packed with a single piece of solid material (monolith) composed of interconnected skeletons (forming macropores) and interconnected flow paths (mesopores) as a stationary phase material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monolithic column" .

goldbook:09902 a skos:Concept ;
    skos:definition "Width of a peak (\\(f + b\\)) divided by twice the width of the front of the peak (\\(f\\)), measured at \\(\\pu{10\\%}\\) of the peak height (see figure). \\[A_{\\rm{s}} = \\frac{(f + b)}{2f}\\] Peak asymmetry (schematic). \\(R_{\\rm{D}}\\) is the response of the detector.Peak asymmetry (schematic). \\(R_{\\rm{D}}\\) is the response of the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetry factor" .

goldbook:09903 a skos:Concept ;
    skos:altLabel "base width" ;
    skos:definition "Peak width at peak base intercepted by tangents to the chromatogram drawn at the inflection points on either side of the peak. Represented by the line AB in the peak height figure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak width at base" .

goldbook:09904 a skos:Concept ;
    skos:definition "Peak width at \\(\\pu{50\\%}\\) of the peak height that terminates at the intersections with the peak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak width at half height" .

goldbook:09905 a skos:Concept ;
    skos:definition "Width of the back of a peak (\\(b\\)) divided by the width of the front (\\(f\\)) of the peak measured at \\(\\pu{10\\%}\\) of the peak height. See figure in asymmetry factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tailing factor" .

goldbook:09906 a skos:Concept ;
    skos:altLabel "height equivalent to one effective plate" ;
    skos:definition "Column length (\\(L\\)) divided by effective plate number (\\(N_{\\rm{eff}}\\)): \\[H_{\\rm{eff}} = \\frac{L}{N_{\\rm{eff}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective plate height" .

goldbook:09907 a skos:Concept ;
    skos:altLabel "number of effective plates" ;
    skos:definition "Number indicative of column performance, calculated from the ratios of measures of adjusted retention and peak width: \\[\\eqalign{& N_{\\rm{eff}} = \\left(\\frac{V_{\\rm{R}}^{\\prime}}{\\sigma} \\right)^{2} = \\left(\\frac{t_{\\rm{R}}^{\\prime}}{\\sigma} \\right)^{2} \\cr & N_{\\rm{eff}} = 16 \\left(\\frac{V_{\\rm{R}}^{\\prime}}{w_{\\rm{b}}} \\right)^{2} = 16 \\left(\\frac{t_{\\rm{R}}^{\\prime}}{w_{\\rm{b}}} \\right)^{2} \\cr & N_{\\rm{eff}} \\approx 5.545 \\left(\\frac{V_{\\rm{R}}^{\\prime}}{w_{\\rm{h}}} \\right)^{2} \\approx 5.545 \\left(\\frac{t_{\\rm{R}}^{\\prime}}{w_{\\rm{h}}} \\right)^{2}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective plate number" .

goldbook:09908 a skos:Concept ;
    skos:definition "In liquid chromatography plate height divided by average particle diameter. \\[h = H/d_{\\rm{p}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced plate height" .

goldbook:09909 a skos:Concept ;
    skos:definition "Sensor that responds to components in the effluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detector" .

goldbook:09911 a skos:Concept ;
    skos:altLabel "ACE",
        "CAE",
        "affinity capillary electrophoresis" ;
    skos:definition "Capillary electrophoresis in which the background electrolyte contains substances capable of specific, often biospecific, interactions with the analytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary affinity electrophoresis" .

goldbook:09912 a skos:Concept ;
    skos:altLabel "CEC" ;
    skos:definition "Liquid chromatography, where the movement of the mobile phase through a capillary, filled, packed, or coated with a stationary phase, is achieved by electroosmotic flow (which may be assisted by pressure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary electrochromatography" .

goldbook:09913 a skos:Concept ;
    skos:altLabel "CE" ;
    skos:definition "Separation method based solely on the differences in the electrophoretic mobilities of charged species in capillaries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary electrophoresis" .

goldbook:09914 a skos:Concept ;
    skos:altLabel "CGE" ;
    skos:definition "Capillary sieving electrophoresis in which the capillary is filled with a gel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary gel electrophoresis" .

goldbook:09915 a skos:Concept ;
    skos:altLabel "CIEF" ;
    skos:definition "Electrophoretic technique for the separation of analytes according to their isoelectric points by an electric field along a pH gradient formed in a capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary isoelectric focusing" .

goldbook:09916 a skos:Concept ;
    skos:altLabel "CITP" ;
    skos:definition "Electrophoretic separation technique in a discontinuous buffer system in which analytes migrate according to their electrophoretic mobilities, forming a chain of adjacent zones moving with equal speed (velocity) between two solutions, leading and terminating electrolytes, bracketing the mobility range of the analytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary isotachophoresis" .

goldbook:09917 a skos:Concept ;
    skos:altLabel "CSE" ;
    skos:definition "Electrophoretic separation technique, which takes place in a capillary containing a medium in the background electrolyte that retains molecules and particles based on their size and shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary sieving electrophoresis" .

goldbook:09918 a skos:Concept ;
    skos:definition "Length of the capillary from the sample introduction point to the detection point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective length of the capillary" .

goldbook:09919 a skos:Concept ;
    skos:altLabel "electrokinetic capillary chromatography" ;
    skos:definition "Separation method based on a combination of electrophoresis and interactions of the analytes with additives (e.g. surfactants), which form a dispersed phase moving at a different speed (velocity). In order to achieve separation, either the analytes or this secondary phase should be charged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrokinetic chromatography" .

goldbook:09920 a skos:Concept ;
    skos:definition "Injection of the analytical sample by applying a potential across the sample and capillary and using the electroosmotic flow to draw an aliquot into the end of the capillary tube. The sample is then replaced by the running electrolyte for the separation to take place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrokinetic injection" .

goldbook:09921 a skos:Concept ;
    skos:altLabel "electro-osmosis" ;
    skos:definition "Motion of a liquid through a capillary (or membrane or plug) because of the application of an electric field across the capillary (or membrane or plug)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroosmosis" .

goldbook:09922 a skos:Concept ;
    skos:definition "Effective length of the capillary (\\(L_{\\rm{eff}}\\)) divided by the electroosmotic hold-up time (\\(t_{\\rm{eo}}\\)). \\[\\boldsymbol{v}_{\\rm{eo}} = L_{\\rm{eff}}/t_{\\rm{eo}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroosmotic velocity" .

goldbook:09923 a skos:Concept ;
    skos:altLabel "electroosmotic volume flow" ;
    skos:definition "Volume flow rate divided by electric field strength through the whole plug or capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroosmotic volume flow rate" .

goldbook:09924 a skos:Concept ;
    skos:definition "Methods that use differences in migration behaviour in spatially defined regions of the capillary of different field strengths (conductivities)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrostacking" .

goldbook:09925 a skos:Concept ;
    skos:definition "Introduction of the analytical sample into a capillary by a pressure difference between the ends of the capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrodynamic injection" .

goldbook:09926 a skos:Concept ;
    skos:definition "Biochemical methods for separation and characterization of proteins based on electrophoresis and reaction with antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoelectrophoresis" .

goldbook:09927 a skos:Concept ;
    skos:altLabel "micellar electrokinetic capillary chromatography" ;
    skos:definition "Electrokinetic chromatography, in which the secondary phase is a micellar dispersed phase in the capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar electrokinetic chromatography" .

goldbook:09928 a skos:Concept ;
    skos:altLabel "microemulsion electrokinetic capillary chromatography" ;
    skos:definition "Electrokinetic chromatography, where a microemulsion is employed as the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microemulsion electrokinetic chromatography" .

goldbook:09929 a skos:Concept ;
    skos:altLabel "NACE" ;
    skos:definition "Capillary electrophoresis, which uses water-free organic solutions and modifiers to produce ions in solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-aqueous capillary electrophoresis" .

goldbook:09930 a skos:Concept ;
    skos:definition "In isotachophoresis a sample is introduced between a zone of fast leading electrolyte and a zone of slow terminating electrolyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample introduction" .

goldbook:09931 a skos:Concept ;
    skos:definition "Flow field-flow fractionation in which only one channel wall is permeable, meaning there is one channel inlet for the flow during the run and some of the channel flow is directed through the accumulation wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetrical flow field-flow fractionation" .

goldbook:09932 a skos:Concept ;
    skos:altLabel "BFFF",
        "BFFF mode",
        "NFFF mode",
        "normal FFF",
        "normal FFF mode (NFFF)" ;
    skos:definition "Mechanism of field-flow fractionation of sub-micron particles that relies on Brownian motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brownian field-flow fractionation mode" .

goldbook:09933 a skos:Concept ;
    skos:altLabel "CTFFF" ;
    skos:definition "Field-flow fractionation in a long (usually \\(\\pu{10 m}\\) or more) rotating coiled column under the action of asymmetrical centrifugal field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coiled-tube field-flow fractionation" .

goldbook:09934 a skos:Concept ;
    skos:altLabel "FFF" ;
    skos:definition "Separation based on the retention and elution of macromolecular, colloidal, and particulate matter achieved by the combined action of the non-uniform flow speed (velocity) profile of a carrier fluid (mobile phase) and a physical force field (e.g. gravitational, centrifugal, electrical) applied at right angles to a thin (\\(\\pu{0.05 mm}\\) to \\(\\pu{0.5 mm}\\)) channel (see figure). Basic principle of field-flow fractionation.Basic principle of field-flow fractionation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field-flow fractionation" .

goldbook:09935 a skos:Concept ;
    skos:definition "Field-flow fractionation in which the physical force field is a nonspecific hydrodynamic force field across the channel, generated by a secondary mobile phase cross-flow in addition to the normal channel flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow field-flow fractionation" .

goldbook:09936 a skos:Concept ;
    skos:altLabel "GFFF" ;
    skos:definition "Field-flow fractionation in which the physical force field is the Earth’s gravitational field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gravitational field-flow fractionation" .

goldbook:09937 a skos:Concept ;
    skos:altLabel "HyFFF",
        "hyperlayer field-flow fractionation mode",
        "lift-hyperlayer field-flow fractionation mode" ;
    skos:definition "Mechanism of field-flow fractionation of particles greater than \\(\\pu{1 \\upmu m}\\) in diameter relying on hydrodynamic lift forces near the channel wall to move particles into faster flowing streams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperlayer focusing field-flow fractionation" .

goldbook:09938 a skos:Concept ;
    skos:altLabel "SdFFF" ;
    skos:definition "Field-flow fractionation in which the physical force field is a centrifugal force field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation field-flow fractionation" .

goldbook:09939 a skos:Concept ;
    skos:altLabel "SPLITT" ;
    skos:definition "Separation in which laminar flow conditions are established between a liquid containing suspended sample and a carrier liquid, with a physical force field applied across the streams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "split-flow thin-cell fractionation" .

goldbook:09940 a skos:Concept ;
    skos:altLabel "StFFF" ;
    skos:definition "Mechanism of field-flow fractionation of particles greater than \\(\\pu{1 \\upmu m}\\) in diameter relying on proximity to the accumulation wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric field-flow fractionation" .

goldbook:09941 a skos:Concept ;
    skos:definition "Flow field-flow fractionation in which the speed of mobile phase is constant along the length of the channel due to constant channel width." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetrical flow field-flow fractionation" .

goldbook:09942 a skos:Concept ;
    skos:altLabel "TFFF" ;
    skos:definition "Field-flow fractionation in which the physical force field is created by a temperature difference across the channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal field-flow fractionation" .

goldbook:09943 a skos:Concept ;
    skos:definition "Method of introduction of the mobile phase (upper or lower) into the rotating coil (from the head or the tail). Of four combinations, only two elution modes should be used in high-speed counter-current chromatography, i.e. either the lower phase from the head toward the tail or the upper phase from the tail toward the head." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elution mode" .

goldbook:09944 a skos:Concept ;
    skos:altLabel "HSCCC" ;
    skos:definition "Counter-current chromatography system using a multilayer coil separation column, which undergoes a type-J synchronous planetary motion (see figure).Type-J planetary motion of a multilayer coil separation column. The column holder rotates about its own axis and revolves around the centrifuge axis at the same angular velocity (ω) in the same direction. This planetary motion prevents twisting of the bundle of flow tubes, allowing continuous elution through a rotating column without risk of leakage and contamination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-speed counter-current chromatography" .

goldbook:09945 a skos:Concept ;
    skos:definition "Volume of the liquid mobile phase contained in the column in counter-current chromatography \\[V_{\\rm{M}} = V_{\\rm{C}} - V_{\\rm{S}}\\] where \\(V_{\\rm{C}}\\) is the total volume of the column and \\(V_{\\rm{S}}\\) is the volume of the liquid stationary phase in the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobile-phase volume" .

goldbook:09946 a skos:Concept ;
    skos:definition "Separation column used for high-speed counter-current chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multilayer coil" .

goldbook:09947 a skos:Concept ;
    skos:definition "Counter-current chromatography that produces a train of fused rectangular solute peaks called pH-zones, each with its specific pH. Each zone contains highly concentrated solute, often near saturation level, and is separated from the neighbouring zone by a narrow strip called a mixing zone, which contains a mixture of impurities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH-zone-refining counter-current chromatography" .

goldbook:09948 a skos:Concept ;
    skos:definition "Most important reagents in pH-zone-refining counter-current chromatography. A retainer is added to the stationary organic phase to retain the analytes and the eluter added to the mobile aqueous phase to elute the analytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retainer and eluter" .

goldbook:09949 a skos:Concept ;
    skos:definition "Volume of the stationary phase, which stays permanently within the column in counter-current chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention volume of the stationary phase" .

goldbook:09950 a skos:Concept ;
    skos:definition "Centrifuge that provides type-J synchronous planetary motion to the column holder, the axis of which is parallel to the centrifuge axis (see figure in high-speed counter-current chromatography)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "type-J coil planet centrifuge" .

goldbook:09951 a skos:Concept ;
    skos:definition "Unique type of planetary motion (so named because the flow tubes form a letter J figure, as shown in the figure in high-speed counter-current chromatography) of the column holder, which rotates around its own axis once during one revolution around the central axis of the centrifuge in the same direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "type-J synchronous planetary motion" .

goldbook:09952 a skos:Concept ;
    skos:definition "Chiral selector that has been added as a component of a mobile phase or electrophoretic medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral additive" .

goldbook:09953 a skos:Concept ;
    skos:altLabel "comprehensive chromatography" ;
    skos:definition "Type of two-dimensional chromatography in which all the effluent from the first separation step is transferred in fractions to a second separation step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comprehensive two-dimensional chromatography" .

goldbook:09954 a skos:Concept ;
    skos:definition "Type of two-dimensional chromatography in which selected fractions from the first separation step are transferred to a second separation step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heart-cut separations" .

goldbook:09955 a skos:Concept ;
    skos:definition "Number of modulations in a given time interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulation frequency" .

goldbook:09956 a skos:Concept ;
    skos:definition "Number of modulations for a given first-dimension peak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulation number" .

goldbook:09957 a skos:Concept ;
    skos:altLabel "modulation time" ;
    skos:definition "Duration of a complete cycle of modulation in a system for comprehensive two-dimensional chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulation period" .

goldbook:09958 a skos:Concept ;
    skos:definition "Interface device between the two columns in a system for comprehensive two-dimensional chromatography that accumulates or samples narrow bands from the effluent of the first column for fast re-injection into the second column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulator" .

goldbook:09959 a skos:Concept ;
    skos:definition "Chromatography in which parts or all of the separated sample components are subjected to additional separation steps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-dimensional chromatography" .

goldbook:09960 a skos:Concept ;
    skos:definition "Occurrence of second dimension peaks in subsequent elution sequences, caused by second-dimension retention times that exceed the modulation time in comprehensive two-dimensional chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wrap-around" .

goldbook:09962 a skos:Concept ;
    skos:definition "Retention volume of a sample component the molecules of which are larger than the largest pores of the particles of the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention volume of an unretained compound" .

goldbook:09963 a skos:Concept ;
    skos:definition "Retention volume of a sample component, the molecules of which are smaller than the largest pores of the particles of the stationary phase but larger than the smallest pores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention volume" .

goldbook:09964 a skos:Concept ;
    skos:definition "Retention volume of a sample component, the molecules of which are smaller than the smallest pores of the particles of the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total mobile phase volume" .

goldbook:09965 a skos:Concept ;
    skos:altLabel "molecular-weight exclusion limit" ;
    skos:definition "Maximum value of the relative molecular masses of components in a specific polymer solvent system that can enter into the pores of the porous non-adsorbing material used in size-exclusion chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative molecular-mass exclusion limit" .

goldbook:09966 a skos:Concept ;
    skos:definition "Peak resolution also considering the molar masses (\\(M_{1}\\), \\(M_{2}\\)) of the two test compounds: \\[R_{\\rm{sp}} = \\left[\\frac{V_{\\rm{R1}} - V_{\\rm{R2}}}{(w_{\\rm{b1}} + w_{\\rm{b2}})/2} \\right] \\cdot \\left[ \\frac{1}{\\log (M_{2}/M_{1})} \\right]\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific resolution" .

goldbook:09967 a skos:Concept ;
    skos:definition "Flavans are compounds with a 2-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran skeleton (1 in flavonoids), that may be substituted, and include flavan-3-ols (compounds derived from 2-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran-3-ol skeleton 2) and flavan-4-ones (compounds derived from 2-phenyl-2,3-dihydro-4\\(H\\)-1-benzopyran-4-one skeleton 3), which are generically designated as flavanols and flavanones, respectively. Compounds derived from 2-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran-3,4-diol skeleton 4 are flavan-3,4-diols, designated leukoanthocyanidins because these colourless compounds have their structure derived from that of an anthocyanidin, specifically they are dehydronated 3,4-dihydroxy-1,2,3,4-tetrahydroanthocyanidins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flavans" .

goldbook:09968 a skos:Concept ;
    skos:definition "Flavones and 3-hydroxyflavones (flavonols) are compounds with a 2-phenyl-4\\(H\\)-1-benzopyran-4-one (2-phenyl-4\\(H\\)-chromen-4-one) skeleton 5." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flavones" .

goldbook:09970 a skos:Concept ;
    skos:definition "Isoflavans are compounds with a 3-phenyl-3,4-dihydro-2\\(H\\)-1-benzopyran skeleton (see isoflavonoids). They may be substituted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoflavans" .

goldbook:09971 a skos:Concept ;
    skos:definition "Isoflavones are compounds with a 3-phenyl-4$H$-1-benzopyran-4-one (3-phenyl-4$H$-chromen-4-one) skeleton 9. They may be substituted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoflavones" .

goldbook:09973 a skos:Concept ;
    skos:definition "Neoflavans are compounds with a 4-phenyl-3,4-dihydro-2$H$-1-benzopyran skeleton (see neoflavonoids). They may be substituted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neoflavans" .

goldbook:09974 a skos:Concept ;
    skos:altLabel "4-phenylcoumarins" ;
    skos:definition "Neoflavones are compounds with a 4-phenyl-2$H$-1-benzopyran-2-one (4-phenyl-2$H$-chromen-2-one) skeleton 11. They may be substituted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neoflavones" .

goldbook:09975 a skos:Concept ;
    skos:definition "Aurones are compounds derived from (2$Z$)-2-benzylidene-1-benzofuran-3(2$H$)-one [alternative name: (2$Z$)-2-(phenylmethylidene)-1-benzofuran-3(2$H$)-one] (aurone, compound 14)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aurones" .

goldbook:09976 a skos:Concept ;
    skos:definition "Pterocarpans are compounds derived from (6a$R$,11a$R$)-6a,11a-dihydro-6$H$-[1]benzofuro[3,2-$c$][1]benzopyran (15), and their 6a,11a-didehydro derivatives 16 are named coumestans. They are numbered systematically following the numbering rules for fused ring systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pterocarpans" .

goldbook:09977 a skos:Concept ;
    skos:definition "Flavonolignans have structures based on flavonoids condensed with \\(\\ce{C6{-}C3}\\) lignan precursors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flavonolignans" .

goldbook:09978 a skos:Concept ;
    skos:definition "Biflavonoid and other flavonoid oligomers, which occur widely in nature, are exemplified and named in this recommendation (Flv-3.8)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biflavonoids" .

goldbook:09979 a skos:Concept ;
    skos:definition "Property of a phenomenon, body, or substance, where the property has no size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal property" .

goldbook:09980 a skos:Concept ;
    skos:definition "Defining aspect, common to mutually comparable nominal properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kind-of-nominal-property" .

goldbook:09981 a skos:Concept ;
    skos:definition "Kind-of-nominal-property indicating a class among nominal properties ordered according to nominal property values of a specified nominal property value set without relation to size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "category" .

goldbook:09982 a skos:Concept ;
    skos:definition "Category indicating a class of organisms within a recognized hierarchically structured nominal property value set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "taxon" .

goldbook:09983 a skos:Concept ;
    skos:definition "Kind-of-nominal-property with a sort of system and any pertinent sort(s) of component(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dedicated kind-of-nominal-property" .

goldbook:09984 a skos:Concept ;
    skos:definition "Process of experimentally obtaining one or more nominal property values that can reasonably be attributed to a nominal property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination" .

goldbook:09985 a skos:Concept ;
    skos:definition "Nominal property intended to be examined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examinand" .

goldbook:09986 a skos:Concept ;
    skos:definition "Set of one or more devices, including any reagent and supply, assembled and adapted to give information used to generate examined values from a nominal property value set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examining system" .

goldbook:09987 a skos:Concept ;
    skos:definition "Nominal property that, in an examination, does not affect the nominal property that is actually examined, but affects the relation between the nominal indication on the examining system and the examination result." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "influence nominal property" .

goldbook:09988 a skos:Concept ;
    skos:definition "Phenomenon serving as a basis of an examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination principle" .

goldbook:09989 a skos:Concept ;
    skos:definition "Generic description of a logical organization of operations used in an examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination method" .

goldbook:09990 a skos:Concept ;
    skos:definition "Detailed description of an examination according to one or more examination principles and to a given examination method and any decision algorithm necessary to obtain an examination result." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination procedure" .

goldbook:09991 a skos:Concept ;
    skos:definition "Nominal property value provided by an examining system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal indication" .

goldbook:09992 a skos:Concept ;
    skos:definition "Nominal indication obtained from an object similar to the one under investigation, except that the nominal property of interest is supposed not to be present, or is not contributing to the nominal indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blank nominal indication" .

goldbook:09993 a skos:Concept ;
    skos:definition "Condition of examination out of a set of conditions that includes the same examination procedure, same operators, same examining system, same operating conditions, same location, and replicate examinations on the same or similar objects over a short period of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repeatability condition" .

goldbook:09994 a skos:Concept ;
    skos:definition "Condition of examination out of a set of conditions that includes the same examination procedure, same location, and replicate examinations on the same or similar objects over an extended period of time, but may include other conditions involving changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermediate precision condition" .

goldbook:09995 a skos:Concept ;
    skos:definition "Condition of examination out of a set of conditions that includes different locations, operators, examining systems, and replicate examinations on the same or similar objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproducibility condition" .

goldbook:09996 a skos:Concept ;
    skos:definition "Feature common to equivalent individual nominal properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal property value" .

goldbook:09997 a skos:Concept ;
    skos:definition "Set of possible nominal property values for nominal properties of a given kind-of-nominal-property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal property value set" .

goldbook:09998 a skos:Concept ;
    skos:definition "Nominal property value used as a basis for comparison with nominal property values of nominal properties of the same kind-of-nominal-property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference nominal property value" .

goldbook:09999 a skos:Concept ;
    skos:definition "Set of nominal property values being attributed to an examinand together with any other available relevant information." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination result" .

goldbook:10000 a skos:Concept ;
    skos:definition "Nominal property value representing an examination result." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examined value" .

goldbook:10001 a skos:Concept ;
    skos:definition "Nominal property value consistent with the definition of a nominal property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "true nominal property value" .

goldbook:10002 a skos:Concept ;
    skos:definition "Nominal property value attributed by agreement to a nominal property for a given purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conventional nominal property value" .

goldbook:10003 a skos:Concept ;
    skos:definition "Fraction of examined values identical to one or more reference nominal property values among all the examined values provided." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination trueness" .

goldbook:10004 a skos:Concept ;
    skos:definition "Fraction of examined values that is different from a reference nominal property value among all the examined values provided." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination uncertainty" .

goldbook:10005 a skos:Concept ;
    skos:definition "Disagreement between an examined value and a reference nominal property value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination error" .

goldbook:10006 a skos:Concept ;
    skos:definition "Closeness of agreement between an examined value and a true nominal property value of an examinand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination accuracy" .

goldbook:10007 a skos:Concept ;
    skos:definition "Closeness of agreement between nominal indications on an examining system or examined values obtained by replicate examinations on the same or similar objects under specified examination conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination precision" .

goldbook:10008 a skos:Concept ;
    skos:definition "Examination precision under repeatability condition of examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination repeatability" .

goldbook:10009 a skos:Concept ;
    skos:definition "Examination precision under intermediate precision condition of examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermediate examination precision" .

goldbook:10010 a skos:Concept ;
    skos:definition "Examination precision under reproducibility condition of examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination reproducibility" .

goldbook:10011 a skos:Concept ;
    skos:definition "Fraction of examined values with examination error that in replicate examinations remains constant or varies in a predictable manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systematic examination error" .

goldbook:10012 a skos:Concept ;
    skos:definition "Estimate of a systematic examination error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination bias" .

goldbook:10013 a skos:Concept ;
    skos:definition "Examination uncertainty specified as an acceptable fraction and decided on the basis of the intended use of examination results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "target examination uncertainty" .

goldbook:10014 a skos:Concept ;
    skos:definition "Subset of the nominal property value set containing the true nominal property value(s) of an examinand with a stated probability, based on the information available." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal property value coverage set" .

goldbook:10015 a skos:Concept ;
    skos:definition "Probability that the set of true nominal property values of an examinand is contained within a specified nominal property value coverage set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal property value coverage probability" .

goldbook:10016 a skos:Concept ;
    skos:definition "Property of an examination result whereby it can be related to a reference through a documented unbroken chain of examination calibrations, each contributing to the examination uncertainty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination traceability" .

goldbook:10017 a skos:Concept ;
    skos:definition "Comparability of examination results, for nominal properties of a given kind-of-nominal-property, that are examined and traceable to the same reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examinational comparability" .

goldbook:10018 a skos:Concept ;
    skos:definition "Property of a set of examination results for a specified examinand of a given kind-of-nominal-property that have overlapping nominal property value sets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examinational compatibility" .

goldbook:10019 a skos:Concept ;
    skos:definition "Realization of the definition of a given nominal property (2.1), with stated nominal property value (3.1) and associated examination uncertainty (3.9), used as a reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination standard" .

goldbook:10020 a skos:Concept ;
    skos:definition "Material, sufficiently homogeneous and stable with reference to a specified nominal property, that has been established to be fit for its intended use in an examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal reference material" .

goldbook:10021 a skos:Concept ;
    skos:definition "Process that confers to one or more persons or to a device the capacity to provide nominal property values from specified examinations after having examined one or more examination standards." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination calibration" .

goldbook:10022 a skos:Concept ;
    skos:definition "Examination procedure accepted as providing examination results fit for their intended use in assessing examination trueness of examined values) obtained from other examination procedures for nominal properties of the same kind-of-nominal-property, in examination calibration, or in characterizing nominal reference materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference examination procedure" .

goldbook:10023 a skos:Concept ;
    skos:definition "Reference examination procedure used to obtain an examination result without relation to an examination standard for a nominal property of the same kind-of-nominal-property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary reference examination procedure" .

goldbook:10024 a skos:Concept ;
    skos:definition "Examination standard recognized by signatories to an international agreement and intended to serve worldwide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "international examination standard" .

goldbook:10025 a skos:Concept ;
    skos:definition "Examination standard recognized by national authority to serve in a state or economy as the basis for assigning nominal property values to other examination standards for the same kind-of-nominal-property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "national examination standard" .

goldbook:10026 a skos:Concept ;
    skos:definition "Examination standard established using a primary reference examination procedure, or created as an artefact, chosen by convention." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary examination standard" .

goldbook:10027 a skos:Concept ;
    skos:definition "Examination standard established through examination calibration with respect to a primary examination standard for a nominal property of the same kind-of-nominal-property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary examination standard" .

goldbook:10028 a skos:Concept ;
    skos:definition "Examination standard designated for the examination calibration of other examination standards for nominal properties of a given kind-of-nominal-property in a given organization or at a given location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference examination standard" .

goldbook:10029 a skos:Concept ;
    skos:definition "Examination standard that is used routinely to calibrate or verify examining systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "working examination standard" .

goldbook:10030 a skos:Concept ;
    skos:definition "Examination standard, sometimes of special construction, intended for transport between different locations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "travelling examination standard" .

goldbook:10031 a skos:Concept ;
    skos:definition "Device used as an intermediary to compare examination standards." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer examination device" .

goldbook:10032 a skos:Concept ;
    skos:definition "Examination standard based on a reproducible nominal property of a phenomenon or substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic examination standard" .

goldbook:10033 a skos:Concept ;
    skos:definition "Set of operations necessary to preserve the examinational properties of an examination standard within stated limits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conservation" .

goldbook:10034 a skos:Concept ;
    skos:definition "Examination standard used in examination calibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "examination calibrator" .

goldbook:10035 a skos:Concept ;
    skos:definition "Nominal reference material accompanied by documentation issued by an authoritative body and providing one or more specified nominal property values with examination uncertainty and examination traceability, using valid examination procedures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "certified nominal reference material" .

goldbook:10036 a skos:Concept ;
    skos:definition "Linear velocity of the mobile phase across the average cross-section of the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobile-phase speed" .

goldbook:10037 a skos:Concept ;
    skos:definition "Total retention time (\\(t_{\\rm{R}}\\)) minus hold-up time (\\(t_{\\rm{M}}\\)). \\(t_{\\rm{R}}^{\\prime} = t_{\\rm{R}} - t_{\\rm{M}}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adjusted retention time" .

goldbook:10038 a skos:Concept ;
    skos:definition "Time required to elute a component which is not retained by the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hold-up time" .

goldbook:10039 a skos:Concept ;
    skos:definition "Time between sample injection and the emergence of the peak maximum of the sample component of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total retention time" .

goldbook:10040 a skos:Concept ;
    skos:definition "Retention time of a sample component the molecules of which are larger than the largest pores of the particles of the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention time of an unretained compound" .

goldbook:10042 a skos:Concept ;
    skos:definition "Measured or observed quantity in an experimental design." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "response" .

goldbook:10043 a skos:Concept ;
    skos:definition "Correlation of a variable with itself over a successive time or space intervals (lags)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autocorrelation" .

goldbook:10044 a skos:Concept ;
    skos:definition "Variance scaling of mean-centered data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoscaling" .

goldbook:10045 a skos:Concept ;
    skos:definition "Data, values of which are one of a fixed number of nominal categories." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "categorical data" .

goldbook:10046 a skos:Concept ;
    skos:altLabel "cross tabulation" ;
    skos:definition "Type of table in a matrix format that displays the multivariate frequency distribution of variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contingency table" .

goldbook:10047 a skos:Concept ;
    skos:definition "Measurement results on a system arranged in a \\(m \\times n\\) matrix, with \\(m\\) objects and \\(n\\) variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "data matrix" .

goldbook:10048 a skos:Concept ;
    skos:definition "Manipulation of raw data prior to a specified data analysis treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "data pre-processing" .

goldbook:10049 a skos:Concept ;
    skos:definition "Process of synchronizing a data matrix so that it represents the same time shifts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic time warping" .

goldbook:10050 a skos:Concept ;
    skos:altLabel "validation data" ;
    skos:definition "Data used to validate a model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evaluation data" .

goldbook:10051 a skos:Concept ;
    skos:definition "Variable that influences the value of a response variable, and is used to build models of the response variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "explanatory variable" .

goldbook:10052 a skos:Concept ;
    skos:altLabel "EDA",
        "initial data analysis" ;
    skos:definition "Summary of the main characteristics of data, often using graphical methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exploratory data analysis" .

goldbook:10053 a skos:Concept ;
    skos:altLabel "centering" ;
    skos:definition "Data pre-processing in which the mean value of a variable is subtracted from data across all objects. \\[a_{i,j}^{\\ast} = a_{i,j} - \\frac{1}{n} \\sum \\limits_{i\\,=\\,1}^{n} a_{i,j}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean centering" .

goldbook:10054 a skos:Concept ;
    skos:altLabel "MSC",
        "multiplicative signal correction" ;
    skos:definition "Data pre-processing in which a constant and a multiple of a reference data set is subtracted from data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplicative scatter correction" .

goldbook:10055 a skos:Concept ;
    skos:definition "Data having two or more variables per object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multivariate data" .

goldbook:10056 a skos:Concept ;
    skos:altLabel "N-way data" ;
    skos:definition "Multivariate data having two or more kinds of explanatory variable per object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-way data" .

goldbook:10057 a skos:Concept ;
    skos:definition "Sampling in which the sample locations are selected randomly from the whole population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random sampling" .

goldbook:10058 a skos:Concept ;
    skos:altLabel "primary data" ;
    skos:definition "Data not yet subjected to analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "raw data" .

goldbook:10059 a skos:Concept ;
    skos:definition "Defined quantity of material having a boundary which may be physical or temporal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling unit" .

goldbook:10060 a skos:Concept ;
    skos:altLabel "weighting" ;
    skos:definition "Element-wise division of a data matrix by a scaling matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaling" .

goldbook:10061 a skos:Concept ;
    skos:definition "Transformation using an approximating function to capture important patterns in data, while removing noise or other fine-scale structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smoothing" .

goldbook:10062 a skos:Concept ;
    skos:definition "Sampling in which individual samples are taken at equal intervals in location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systematic sampling" .

goldbook:10063 a skos:Concept ;
    skos:altLabel "TILI" ;
    skos:definition "Happenstance data that must be processed, or not processed, as is." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "take-it-or-leave-it data" .

goldbook:10064 a skos:Concept ;
    skos:definition "Scaling in which the scaling matrix is the standard deviation of each variable across the objects. \\[a_{i,j}^{\\ast} = \\frac{a_{i,j}}{s_{j}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variance scaling" .

goldbook:10065 a skos:Concept ;
    skos:definition "List of combinations of effects that are aliased (confounded)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alias structure" .

goldbook:10066 a skos:Concept ;
    skos:altLabel "confounded effects" ;
    skos:definition "In a fractional-factorial design, effects for which the information obtained are identical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aliased effects" .

goldbook:10067 a skos:Concept ;
    skos:altLabel "coded design" ;
    skos:definition "Matrix of runs by factor levels in which each level is denoted by a code that represents the relative magnitude of the level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coded experimental design" .

goldbook:10068 a skos:Concept ;
    skos:altLabel "effect" ;
    skos:definition "Coefficient of a term in a response model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effect of a factor" .

goldbook:10069 a skos:Concept ;
    skos:definition "Matrix with rows representing individual experimental treatments (possibly transformed according to the assumed model) which can be extended by deduced levels of other functions of factor levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "design matrix" .

goldbook:10070 a skos:Concept ;
    skos:definition "Factor that is known to have no effect on the response, used in an experimental design, to estimate repeatability standard deviation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dummy factor" .

goldbook:10071 a skos:Concept ;
    skos:altLabel "DoE",
        "design of experiments" ;
    skos:definition "Efficient procedure for planning combinations of values of factors in experiments so that the data obtained can be analyzed to yield valid and objective conclusions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "experimental design" .

goldbook:10072 a skos:Concept ;
    skos:altLabel "level" ;
    skos:definition "Value of a factor in an experimental design." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "factor level" .

goldbook:10073 a skos:Concept ;
    skos:definition "Experimental design obtained from a full-factorial design in which experiments are systematically removed to fulfill stated statistical requirements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractional-factorial design" .

goldbook:10074 a skos:Concept ;
    skos:definition "Experimental design with all possible combinations of factor levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "full-factorial design" .

goldbook:10075 a skos:Concept ;
    skos:definition "Effect of a factor where the term is the product of two or more factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interaction effect" .

goldbook:10076 a skos:Concept ;
    skos:definition "Effect of a factor where the term is a single factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main effect" .

goldbook:10077 a skos:Concept ;
    skos:definition "Equation describing the response as a function of values of the factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "model" .

goldbook:10078 a skos:Concept ;
    skos:definition "Effect of a factor where the term is a factor raised to the power \\(n\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>n</em><sup>th</sup>-order effect" .

goldbook:10079 a skos:Concept ;
    skos:definition "Minimization or maximization of a real function by systematically choosing the values of real or integer variables from within an allowed set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optimization" .

goldbook:10080 a skos:Concept ;
    skos:definition "Incomplete experimental design to estimate main effects for which each combination of factor levels for any pair of factors appears the same number of times." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Plackett−Burman design" .

goldbook:10081 a skos:Concept ;
    skos:altLabel "resolution" ;
    skos:definition "One more than the smallest nth-order interaction effect that some main effect is aliased with." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution of a design" .

goldbook:10082 a skos:Concept ;
    skos:definition "Experimental design in which the response is modelled in terms of one or more factor levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "response surface methodology" .

goldbook:10083 a skos:Concept ;
    skos:altLabel "ALS",
        "alternating regression" ;
    skos:definition "Solution to the multivariate decomposition of a data matrix in which iteratively a solution of one output matrix is used to compute the second matrix, after the application of constraints." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternating least squares regression" .

goldbook:10084 a skos:Concept ;
    skos:definition "Stochastic process in which future values are estimated based on a weighted sum of past values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoregression" .

goldbook:10085 a skos:Concept ;
    skos:definition "Combination plot of a scores plot as points and loadings plot as vectors for common factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biplot" .

goldbook:10086 a skos:Concept ;
    skos:definition "Estimation of parameters by multiple re-sampling from measured data to approximate its distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bootstrapping" .

goldbook:10087 a skos:Concept ;
    skos:definition "Linear combinations of data with the greatest correlation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "canonical variables" .

goldbook:10088 a skos:Concept ;
    skos:altLabel "canonical analysis" ;
    skos:definition "Multivariate technique which finds linear combinations of two sets of data that are most highly correlated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "canonical variate analysis" .

goldbook:10089 a skos:Concept ;
    skos:altLabel "exploratory factor analysis",
        "factor analysis" ;
    skos:definition "Factor analysis in which latent variables are calculated that maximise the correlation with observed variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "common factor analysis" .

goldbook:10090 a skos:Concept ;
    skos:altLabel "CONCORDIA" ;
    skos:definition "Method to assess the appropriateness of a PARAFAC model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core consistency diagnostic" .

goldbook:10091 a skos:Concept ;
    skos:altLabel "correspondence analysis" ;
    skos:definition "Factor analysis applied to categorical data in which orthogonal factors are obtained from a contingency table." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correspondence factor analysis" .

goldbook:10092 a skos:Concept ;
    skos:altLabel "EFA" ;
    skos:definition "Factor analysis that follows the change or evolution of the rank of the data matrix as a function of an ordered variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evolving factor analysis" .

goldbook:10093 a skos:Concept ;
    skos:definition "Matrix decomposition of a data matrix (\\(\\boldsymbol{X}\\)) into the product of a scores matrix (\\(\\boldsymbol{T}\\)) and the transpose of the loadings matrix (\\(\\boldsymbol{P}^{\\rm{T}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "factor analysis" .

goldbook:10094 a skos:Concept ;
    skos:definition "Cross validation of a data set of \\(N\\) objects in which \\(N/G\\) objects are removed at each iteration of the procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>G</em>-fold cross validation" .

goldbook:10095 a skos:Concept ;
    skos:altLabel "hidden variable",
        "latent construct" ;
    skos:definition "Variable that is inferred through a mathematical model from other variables that are observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latent variable" .

goldbook:10096 a skos:Concept ;
    skos:definition "Projection of a factor onto the variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loadings" .

goldbook:10097 a skos:Concept ;
    skos:definition "Plot of one loading against variable number, or two or three loadings against each other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loadings plot" .

goldbook:10098 a skos:Concept ;
    skos:altLabel "MLPCA" ;
    skos:definition "Principal-component analysis that incorporates information about measurement uncertainty to develop models that are optimal in a maximum likelihood sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum likelihood principal component analysis" .

goldbook:10099 a skos:Concept ;
    skos:altLabel "mean squared error of estimation" ;
    skos:definition "In multivariate calibration the average of the squared deviation of estimated values from the values of evaluation data. For \\(N\\) evaluation data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the predicted value. \\[E_{\\rm{MSEP}} = \\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i}\\,-\\, c_{i})^2}{N}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean squared error of prediction" .

goldbook:10100 a skos:Concept ;
    skos:definition "Factor analysis for the decomposition of multicomponent data into a linear sum of chemically-meaningful components when little or no prior information about the composition is available." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multivariate curve resolution" .

goldbook:10101 a skos:Concept ;
    skos:altLabel "NIPALS" ;
    skos:definition "Iterative decomposition of a data matrix to give principal components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linear iterative partial least squares" .

goldbook:10102 a skos:Concept ;
    skos:altLabel "NLM" ;
    skos:definition "Projection of objects defined in a multivariate space onto two- or three-dimensional space so that the distances between objects are preserved as well as possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonlinear mapping" .

goldbook:10103 a skos:Concept ;
    skos:altLabel "canonical decomposition" ;
    skos:definition "Decomposition of a three-way data matrix into the sum of sets of two-way loadings matrices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parallel factors analysis" .

goldbook:10104 a skos:Concept ;
    skos:altLabel "residual sum of squares",
        "sum of squared errors of prediction",
        "sum of squared residuals" ;
    skos:definition "In multivariate calibration for a prediction set of \\(N\\) data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the predicted value. \\[E_{\\rm{PRESS}} = \\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i} - c_{i})^2\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prediction error sum of squares" .

goldbook:10105 a skos:Concept ;
    skos:altLabel "PC-DA" ;
    skos:definition "Discriminant analysis on a multivariate data set that has been subject to principal-component analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal component-discriminant analysis" .

goldbook:10106 a skos:Concept ;
    skos:altLabel "PCA" ;
    skos:definition "Factor analysis in which factors are calculated that successively capture the greatest variance in the data set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal-component analysis" .

goldbook:10107 a skos:Concept ;
    skos:altLabel "PC",
        "principal component" ;
    skos:definition "Orthogonal factors obtained in a principal-component analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal-component factor" .

goldbook:10108 a skos:Concept ;
    skos:definition "Comparison of shapes of multi-dimensional objects by a series of geometrical transformations to minimise the sum of squared distances between the transformed and target structures while maintaining the internal structure of the objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Procrustes analysis" .

goldbook:10109 a skos:Concept ;
    skos:altLabel "RMSECV" ;
    skos:definition "Root mean square error of prediction when the predicted data is obtained by cross validation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root mean square error of cross validation" .

goldbook:10110 a skos:Concept ;
    skos:altLabel "root mean squared error of estimation",
        "standard error of estimation",
        "standard error of prediction" ;
    skos:definition "In multivariate calibration or classification for \\(N\\) evaluation data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the predicted value \\[E_{\\rm{RMSEP}} = \\sqrt {\\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i}\\,-\\,c_{i})^2}{N}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root mean squared error of prediction" .

goldbook:10111 a skos:Concept ;
    skos:altLabel "SIMPLISMA" ;
    skos:definition "Interactive method to obtain concentrations and pure spectra from spectra of mixtures using directly-measured variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simple-to-use interactive self-modelling mixture analysis" .

goldbook:10112 a skos:Concept ;
    skos:definition "Factor analysis projection of an object onto a factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "score" .

goldbook:10113 a skos:Concept ;
    skos:definition "Plot of one score against object number, or two or three scores against each other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scores plot" .

goldbook:10114 a skos:Concept ;
    skos:definition "Generic probabilistic meta-heuristic to locate a good approximation to the global optimum of a given function in a large search space, in which there is a slow decrease in the probability of accepting worse solutions as the solution space is explored." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simulated annealing" .

goldbook:10115 a skos:Concept ;
    skos:altLabel "SVD" ;
    skos:definition "A factorization of an \\(m \\times n\\) matrix (\\(\\boldsymbol{M}\\)) such that \\(\\boldsymbol{M} = \\boldsymbol{U}\\boldsymbol{\\Sigma} \\boldsymbol{V}^{T}\\), where \\(\\boldsymbol{U}\\) is an \\(m \\times m\\) matrix, \\(\\boldsymbol{\\Sigma}\\) is a \\(m \\times n\\) matrix and \\(\\boldsymbol{V}^{\\rm{T}}\\) is a \\(n \\times n\\) matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singular value decomposition" .

goldbook:10116 a skos:Concept ;
    skos:altLabel "Tucker3 model" ;
    skos:definition "Decomposition of a three-way data matrix into a three-way core matrix, and three, two-way loadings matrices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tucker tri-linear analysis" .

goldbook:10117 a skos:Concept ;
    skos:altLabel "back chaining" ;
    skos:definition "Inference method from hypothesis to data that supports the hypothesis" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backward chaining" .

goldbook:10118 a skos:Concept ;
    skos:altLabel "back-propagation learning rule",
        "back-propagation of errors" ;
    skos:definition "Supervised classification method for an artificial neural network in which weights of connections between nodes are calculated from the known output layer back to the input layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backward propagation" .

goldbook:10119 a skos:Concept ;
    skos:definition "Linear discriminant analysis in which variables to build the discriminant functions are removed one at a time to minimise the loss of discrimination, until there is a significant loss." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backward stepwise linear discriminant analysis" .

goldbook:10120 a skos:Concept ;
    skos:altLabel "Hamming distance",
        "Manhattan distance",
        "taxi distance" ;
    skos:definition "Distance (\\(d_{i,j}\\)) between two objects (\\(i\\) and \\(j\\)) calculated as the sum of the absolute difference between \\(k\\) variables (\\(x\\)) that describe the objects. \\[d_{i,j} = \\sum\\limits_{k\\,=\\,1}^{k\\,=\\,N} \\vert x_{i,k} - x_{j,k}\\vert\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "city-block distance" .

goldbook:10121 a skos:Concept ;
    skos:definition "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects (one from each cluster) that are farthest apart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complete linkage" .

goldbook:10122 a skos:Concept ;
    skos:definition "Tree diagram used to illustrate the arrangement of clusters produced by hierarchical clustering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendrogram" .

goldbook:10123 a skos:Concept ;
    skos:definition "Principal-component analysis (PCA) independently performed on each class as a step in classification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disjoint principal component analysis" .

goldbook:10124 a skos:Concept ;
    skos:definition "Distance (\\(d_{i,j}\\)) between two objects (\\(i\\) and \\(j\\)) calculated as the square root of the sum of the squared differences between \\(k\\) variables (\\(x\\)) that describe the objects. \\[d_{i,j} = \\sqrt {\\sum\\limits_{k\\,=\\,1}^{k\\,=\\,N} (x_{i,k} - x_{j,k})^2}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Euclidean distance" .

goldbook:10125 a skos:Concept ;
    skos:definition "Inference method from data to hypothesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forward chaining" .

goldbook:10126 a skos:Concept ;
    skos:definition "Linear discriminant analysis in which variables to build the discriminant functions are introduced one at a time to maximise the discrimination, until there is no significant improvement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forward stepwise linear discriminant analysis" .

goldbook:10127 a skos:Concept ;
    skos:definition "Classification in which membership of an object in each possible class is given a weight between zero and one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fuzzy clustering" .

goldbook:10128 a skos:Concept ;
    skos:definition "Group of nodes in an artificial neural network between input layer and output layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hidden layer" .

goldbook:10129 a skos:Concept ;
    skos:definition "Pattern recognition in which objects are linked together by use of an appropriate measure of distance between pairs of objects, and a linkage criterion, which specifies the dissimilarity of sets as a function of the pairwise distances between objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hierarchical clustering" .

goldbook:10130 a skos:Concept ;
    skos:definition "Unsupervised classification method which partitions objects into \\(k\\) groups, in which each object belongs to the group with the nearest mean." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>k</em>-means clustering" .

goldbook:10131 a skos:Concept ;
    skos:altLabel "kNN" ;
    skos:definition "Non-parametric supervised classification method for objects based on the closest training examples in the variable space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>k</em>-nearest neighbour" .

goldbook:10132 a skos:Concept ;
    skos:definition "Type of self-organising map with low dimensional grid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kohonen network" .

goldbook:10133 a skos:Concept ;
    skos:altLabel "LDA" ;
    skos:definition "Discriminant analysis in which the criterion function is based on the pooled covariance matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear discriminant analysis" .

goldbook:10134 a skos:Concept ;
    skos:definition "Distance (\\(d_{i,j}\\)) between an object characterised by vector of variables \\(\\boldsymbol{x}_{i}\\) and the centroid of a class \\(\\boldsymbol{\\mu}_{j}\\) with covariance matrix \\(\\boldsymbol{S}\\) calculated as \\[d_{i,j} = \\sqrt {(\\boldsymbol{x}_{i} - \\boldsymbol{\\mu}_{j})^T \\boldsymbol{S}^{-1}(\\boldsymbol{x}_{i} - \\boldsymbol{\\mu}_{j})}\\] where \\(\\boldsymbol{S}\\) is the covariance matrix of the variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mahalanobis distance" .

goldbook:10135 a skos:Concept ;
    skos:altLabel "misclassification frequency" ;
    skos:definition "Fraction of objects incorrectly assigned to a group in supervised classification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "misclassification rate" .

goldbook:10136 a skos:Concept ;
    skos:altLabel "independent classification",
        "unary classification" ;
    skos:definition "Classification identifying objects of a specific class amongst all objects, by learning from training data containing only objects of the specific class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "one-class classification" .

goldbook:10137 a skos:Concept ;
    skos:definition "Locations in an artificial neural network that carry values that are calculated from values of connected nodes and weights by a transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "node" .

goldbook:10138 a skos:Concept ;
    skos:altLabel "PLS-DA" ;
    skos:definition "Linear classification in which the criterion function is obtained by partial least squares analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial least squares discriminant analysis" .

goldbook:10139 a skos:Concept ;
    skos:altLabel "QDA" ;
    skos:definition "Discriminant analysis in which the criterion function is based on the individual within-group covariance matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadratic discriminant analysis" .

goldbook:10140 a skos:Concept ;
    skos:definition "Discriminant analysis in which the criterion function is based on a combination of pooled covariance matrix and the individual within-group covariance matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regularized discriminant analysis" .

goldbook:10141 a skos:Concept ;
    skos:altLabel "similarity distance" ;
    skos:definition "Quantity that describes the equivalence of two objects characterised by multivariate data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "similarity index" .

goldbook:10142 a skos:Concept ;
    skos:definition "Linkage criterion in hierarchical clustering in which the distance between two clusters is the distance between those two objects (one from each cluster) that are closest together." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single linkage" .

goldbook:10143 a skos:Concept ;
    skos:altLabel "SIMCA" ;
    skos:definition "Supervised classification that performs a principal-component analysis on each class, and then an unknown is assigned to the class with which it has the lowest residual variance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soft independent modelling of class analogy" .

goldbook:10144 a skos:Concept ;
    skos:definition "Classification in which, in a first step, a model is built using data from objects of known classes, and in a second step, the model is applied to new data to assign a class to unknown objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supervised classification" .

goldbook:10145 a skos:Concept ;
    skos:altLabel "Tanimoto index" ;
    skos:definition "Fraction of variables that are considered to agree between two objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tanimoto similarity index" .

goldbook:10146 a skos:Concept ;
    skos:definition "Classification in which no prior information about membership of groups is known." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unsupervised classification" .

goldbook:10147 a skos:Concept ;
    skos:altLabel "UPGMA",
        "average linkage" ;
    skos:definition "Linkage criterion in hierarchical clustering in which the distance between two clusters is the average of all distances between pairs of objects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unweighted pair group method with arithmetic mean" .

goldbook:10148 a skos:Concept ;
    skos:altLabel "Ward’s method" ;
    skos:definition "Linkage criterion in hierarchical clustering in which the within-cluster variance is minimized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ward’s minimum variance method" .

goldbook:10149 a skos:Concept ;
    skos:altLabel "LS regression",
        "LSR" ;
    skos:definition "Regression that minimizes the sum of squared differences between observed values of a variable and the values predicted by a model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "least squares regression" .

goldbook:10150 a skos:Concept ;
    skos:altLabel "total least squares regression" ;
    skos:definition "Least squares regression in which both the response variable and predictor variable have measurement error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "errors-in-variables regression" .

goldbook:10151 a skos:Concept ;
    skos:altLabel "mean residual sum of squares" ;
    skos:definition "In calibration for \\(N\\) calibration data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the value predicted by the calibration function. \\[E_{\\rm{MSEC}} = \\frac{\\sum\\limits_{i\\,=\\,1}^{i\\,=\\,N} (\\hat c_{i} - c_{i})^2}{N}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean squared error of calibration" .

goldbook:10152 a skos:Concept ;
    skos:definition "Multivariate calibration in which the coefficients of the regression are calculated directly from the indications and values of standards." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multilinear least squares regression" .

goldbook:10153 a skos:Concept ;
    skos:definition "Calibration in which the indications are multivariate data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multivariate calibration" .

goldbook:10154 a skos:Concept ;
    skos:altLabel "OLSR",
        "classical least squares regression" ;
    skos:definition "Least squares regression that minimizes the sum of squared differences between the known values of dependent variable and values predicted by a linear model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ordinary least squares regression" .

goldbook:10155 a skos:Concept ;
    skos:altLabel "PLS",
        "partial least squares" ;
    skos:definition "Multivariate calibration which finds factors that maximise covariance between two blocks of data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial least squares regression" .

goldbook:10156 a skos:Concept ;
    skos:altLabel "PCR" ;
    skos:definition "Multivariate calibration in which a dependent variable is regressed against the scores of a chosen number of factors obtained from principal-component analysis of the predictor variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal components regression" .

goldbook:10157 a skos:Concept ;
    skos:altLabel "RMSEC",
        "standard error of calibration (SEC)" ;
    skos:definition "In calibration for \\(N\\) calibration data where \\(c_{i}\\) is an observed value and \\(\\hat c_{i}\\) is the value predicted by the calibration function. \\[E_{\\rm{RMSEC}} = \\sqrt \\frac{\\sum\\limits_{i\\,=\\,1}^{i,=\\,N} (\\hat c_{i} - c_{i})^2}{N}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root mean squared error of calibration" .

goldbook:10158 a skos:Concept ;
    skos:altLabel "underfitting" ;
    skos:definition "Condition in which a model fails to describe the data adequately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "underfitting of a calibration model" .

goldbook:10159 a skos:Concept ;
    skos:altLabel "WLSR" ;
    skos:definition "Least squares regression in which a nonnegative constant is associated with each value of the dependent variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weighted least squares regression" .

goldbook:10160 a skos:Concept ;
    skos:definition "Distance from the interface beyond which mass transfer is determined by convection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boundary layer thickness" .

goldbook:10161 a skos:Concept ;
    skos:definition "Sample volume at which a defined amount of an analyte pumped continuously through an extraction device will begin to be eluted. Typical breakthrough curve indicating the breakthrough volume \\(V_{\\rm{B}}\\) and the sample volume corresponding to the saturation capacity of the sorbent \\(V_{\\rm{C}}\\) (\\(V_{\\rm{R}}\\) corresponds to the chromatographic elution volume and \\(\\upsigma_{\\rm{v}}\\) the standard deviation of the derivative of the curve).Typical breakthrough curve indicating the breakthrough volume \\(V_{\\rm{B}}\\) and the sample volume corresponding to the saturation capacity of the sorbent \\(V_{\\rm{C}}\\) (\\(V_{\\rm{R}}\\) corresponds to the chromatographic elution volume and \\(\\upsigma_{\\rm{v}}\\) the standard deviation of the derivative of the curve)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "breakthrough volume" .

goldbook:10162 a skos:Concept ;
    skos:definition "Transfer of ions from an aqueous phase to an immiscible liquid (or solid) phase by adding an ion of complementary charge to the aqueous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-pair extraction" .

goldbook:10163 a skos:Concept ;
    skos:definition "Condensed phase where extraction of analytes can occur at the surface and in the bulk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorbent" .

goldbook:10164 a skos:Concept ;
    skos:definition "Component of a multi-phase system into which the target analytes are extracted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptor phase" .

goldbook:10165 a skos:Concept ;
    skos:definition "Continuous extraction with movement of the sample matrix with respect to the extraction phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active sampling" .

goldbook:10166 a skos:Concept ;
    skos:definition "Extraction in which the extraction phase and the sample are confined in an extraction vessel and processed according to a defined procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "batch extraction" .

goldbook:10167 a skos:Concept ;
    skos:definition "Internal standard that is incorporated in the extraction phase for calibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibrant in extraction phase" .

goldbook:10168 a skos:Concept ;
    skos:definition "Tube filled with charcoal typically used to adsorb analytes from the gas or liquid phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charcoal tube" .

goldbook:10169 a skos:Concept ;
    skos:definition "Extraction in which the sample is continuously introduced into the extraction device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous extraction" .

goldbook:10170 a skos:Concept ;
    skos:definition "Extraction in which both phases are continuously added (or changed) and flow (or move) in opposite directions as the extraction progresses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "countercurrent extraction" .

goldbook:10171 a skos:Concept ;
    skos:definition "In extraction, the sample or sample solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "donor phase" .

goldbook:10172 a skos:Concept ;
    skos:definition "Extraction in which clean (or recycled) extraction phase is continuously passed through the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic extraction" .

goldbook:10173 a skos:Concept ;
    skos:definition "Type of extraction where the intent is a complete extraction of the analytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exhaustive extraction" .

goldbook:10174 a skos:Concept ;
    skos:definition "Calibration employing a simplified sample matrix spiked with target analyte embodying a reference value of the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external calibration" .

goldbook:10175 a skos:Concept ;
    skos:definition "Liquid, solid, or gas phase in contact with the sample for the purpose of removal of analytes from the sample matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction phase" .

goldbook:10176 a skos:Concept ;
    skos:altLabel "kinetics of extraction" ;
    skos:definition "Rate at which analytes are transferred from the sample to the extraction phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction rate" .

goldbook:10177 a skos:Concept ;
    skos:definition "Solution or gas containing analyte introduced into an extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "feed" .

goldbook:10178 a skos:Concept ;
    skos:definition "Extraction in a biphasic system in which the main component of one phase is a highly fluorinated solvent (liquid-liquid extraction) or highly fluorinated sorbent (solid-phase extraction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorous extraction" .

goldbook:10179 a skos:Concept ;
    skos:definition "Dissolution of sample components from a solid with a liquid in which the solid phase is not wholly soluble." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leaching" .

goldbook:10180 a skos:Concept ;
    skos:definition "Calibration employing external calibration in which standard solutions of target are prepared in a solution of analyte-free matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix-matched calibration" .

goldbook:10181 a skos:Concept ;
    skos:definition "Plate with multiple wells for individual samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiwell sample plate" .

goldbook:10182 a skos:Concept ;
    skos:definition "Adjustment of extraction parameters to achieve a defined goal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optimisation of extraction" .

goldbook:10183 a skos:Concept ;
    skos:definition "Extraction process driven by diffusion of analytes towards the extraction phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive sampling" .

goldbook:10184 a skos:Concept ;
    skos:definition "Addition of an electrolyte to an aqueous phase to decrease the distribution ratio of the analyte(s) or matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salting in" .

goldbook:10186 a skos:Concept ;
    skos:definition "Extraction wherein extractants of increasing strength or different chemical character are used in order to extract analytes of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential extraction" .

goldbook:10187 a skos:Concept ;
    skos:definition "Batch extraction in which the extraction phase attains a constant composition before phase separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static extraction" .

goldbook:10188 a skos:Concept ;
    skos:definition "State of a continuous process operating in such a way that the concentration of solutes in exit streams remains constant with respect to time for constant feed concentrations, even though the two phases are not necessarily in thermodynamic equilibrium in any part of the process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steady state extraction" .

goldbook:10189 a skos:Concept ;
    skos:altLabel "TWA sampling" ;
    skos:definition "A passive sampling or active sampling strategy over a relatively long time, during which the amount of analyte(s) extracted is proportional to its average (mean) concentration over that time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-weighted average sampling" .

goldbook:10190 a skos:Concept ;
    skos:altLabel "CHG" ;
    skos:definition "Type of chemical vapour generation wherein volatile hydrides are generated by reaction with (usually) borane complexes in aqueous solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical hydride generation" .

goldbook:10191 a skos:Concept ;
    skos:altLabel "closed-loop stripping analysis" ;
    skos:definition "Extraction by a fixed volume of gas continuously recycled through the sample and a sorbent trap by a pump in a closed-circuit arrangement.Typical apparatus for closed-loop stripping analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "closed-loop extraction" .

goldbook:10192 a skos:Concept ;
    skos:definition "Device used to concentrate volatile analytes from the gas phase by condensation on a cold surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryogenic trap" .

goldbook:10193 a skos:Concept ;
    skos:altLabel "denuder device" ;
    skos:definition "Apparatus for the extraction of volatile analytes from a flowing gas stream by diffusion to the wall of a collection vessel, where they are retained by chemisorption or strong physisorption by the wall coating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "denuder" .

goldbook:10194 a skos:Concept ;
    skos:definition "Continuous removal of headspace above a sample by a flow of inert gas over or through the sample until all or a significant portion of the analytes have been removed from the sample. Sample vapours are typically transferred to a sorbent trap or cryogenic trap for collection.Typical apparatus for analysis by dynamic headspace (purge and trap). The gas flow (sparging gas) enters at the bottom of the sample container transporting volatile compounds through the headspace and purge head to the desorption tube for collection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic headspace analysis" .

goldbook:10195 a skos:Concept ;
    skos:definition "Separation of close-boiling liquids by fractional distillation in the presence of a low-volatility solvent or salt that selectively interacts with one or more components of the mixture, increasing the difference in vapour pressure of the sample components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extractive distillation" .

goldbook:10196 a skos:Concept ;
    skos:definition "Thermal desorption where the temperature of a packed tube or cryogenic trap is rapidly increased to transfer condensed or sorbed compounds to the gas phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flash desorption" .

goldbook:10197 a skos:Concept ;
    skos:definition "Small volume of sample in a headspace vessel maintained at a temperature sufficient to cause complete evaporation of analytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "full-evaporation headspace analysis" .

goldbook:10198 a skos:Concept ;
    skos:definition "Volume of gas phase above a sample in a closed container." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "headspace" .

goldbook:10199 a skos:Concept ;
    skos:definition "Dynamic gas extraction carried out stepwise, with sequential analysis of a number of headspace samples taken from the same vial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple headspace extraction" .

goldbook:10200 a skos:Concept ;
    skos:definition "Extraction in which a sample dispersed in water and a water immiscible organic solvent (extraction phase) in separate flasks are heated simultaneously and their vapours co-condensed and separated into two streams in which water is returned to the sample flask and the extraction phase to the organic solvent flask.Apparatus for simultaneous steam distillation-solvent extraction with a lighter-than-water extraction phase. A = aqueous sample solution or slurry; B = immiscible organic solvent and receiving flask for extracted compounds; C = bowl for phase separation; D, E, F, and G are solvent or vapour transfer arms; and H = entry port for additional solvent or alternative sample introduction position for continuous liquid–liquid extraction. Switching the position of flasks A and B allows extraction with a heavier-than-water extraction solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous steam distillation-solvent extraction" .

goldbook:10201 a skos:Concept ;
    skos:definition "Tube filled with porous sorbent typically used to extract analytes from the gas phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorbent trap" .

goldbook:10202 a skos:Concept ;
    skos:definition "Method of analysis, in which a small aliquot of the gas phase in contact with the sample in a closed container is withdrawn for analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static headspace analysis" .

goldbook:10203 a skos:Concept ;
    skos:definition "Release of volatile compounds from a sample by heat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal extraction" .

goldbook:10204 a skos:Concept ;
    skos:altLabel "TLHS" ;
    skos:definition "Dynamic headspace analysis of a flowing sample solution in the form of a thin film on the surface of a heated tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thin-layer headspace analysis" .

goldbook:10205 a skos:Concept ;
    skos:definition "Equilibrium system containing two or more solvents forming two phases with a single interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biphasic system" .

goldbook:10206 a skos:Concept ;
    skos:definition "Extraction method wherein charged analytes are extracted from an aqueous phase into an organic phase, assisted by a chelating agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chelation solvent extraction" .

goldbook:10207 a skos:Concept ;
    skos:definition "Coacervative extraction at a temperature above the cloud point temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloud point extraction" .

goldbook:10208 a skos:Concept ;
    skos:definition "Extraction by a surfactant-rich, water-immiscible phase formed by adding a dehydrating agent to a colloidal solution of the sample and a surfactant above its critical micelle concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coacervative extraction" .

goldbook:10209 a skos:Concept ;
    skos:definition "Extraction in which a water-immiscible extraction solvent is continuously percolated through an aqueous solution and returned to the extraction solvent reservoir.Apparatus for continuous liquid–liquid extraction with a lighter-than-water extraction solvent (left) and a heavier-than-water extraction solvent (right). In each case the extraction solvent is contained in the round bottom flask and the aqueous sample in the vertical glass column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous liquid-liquid extraction" .

goldbook:10210 a skos:Concept ;
    skos:definition "Apparatus for extraction based on a multistage countercurrent distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Craig countercurrent distribution apparatus" .

goldbook:10211 a skos:Concept ;
    skos:definition "Extraction comprising a cascading series of states where the raffinate is brought into a subsequent stage and contacted with fresh solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crosscurrent extraction" .

goldbook:10212 a skos:Concept ;
    skos:definition "Type of continuous multistage extraction equipment in which there is only one interface at which phase separation by settling occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential contactor" .

goldbook:10213 a skos:Concept ;
    skos:definition "Solvent used to disperse the extraction solvent as fine droplets throughout the sample solution in dispersive liquid–liquid microextraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersing solvent" .

goldbook:10214 a skos:Concept ;
    skos:altLabel "DLLME" ;
    skos:definition "Extraction of analyte(s) from an aqueous solution by fine droplets of extraction phase dispersed throughout the solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersive liquid-liquid microextraction" .

goldbook:10215 a skos:Concept ;
    skos:definition "Liquid-liquid distribution process that involves the transfer of ionic species from the extractant to the aqueous phase in exchange for ions from the aqueous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-ion exchange" .

goldbook:10216 a skos:Concept ;
    skos:definition "Microextraction technique using a liquid as the extraction phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-phase microextraction" .

goldbook:10217 a skos:Concept ;
    skos:definition "Multistage countercurrent separation based on a discontinuous, differential migration process employing stepwise extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multistage countercurrent distribution" .

goldbook:10218 a skos:Concept ;
    skos:altLabel "SDME" ;
    skos:definition "Extraction of analytes from the gas phase or solution by a single drop of extraction solvent.Typical experimental arrangement for single-drop microextraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-drop microextraction" .

goldbook:10219 a skos:Concept ;
    skos:definition "Droplet of organic solvent recovered from the surface of the sample solution by solidification induced by cooling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solidified floating organic drop" .

goldbook:10220 a skos:Concept ;
    skos:altLabel "SFODME" ;
    skos:definition "Microextraction employing a solidified floating organic drop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solidified floating organic drop microextraction" .

goldbook:10221 a skos:Concept ;
    skos:definition "Physically distinct part of an extraction process in which transfer of analyte(s) occurs, followed by phase separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stage" .

goldbook:10222 a skos:Concept ;
    skos:definition "Type of continuous multi-stage liquid-liquid distribution equipment in which each stage has a physically distinct cycle of interphase contact and separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stagewise contactor" .

goldbook:10223 a skos:Concept ;
    skos:definition "Distribution in a biphasic system formed by two aqueous solutions containing structurally incompatible components (two polymers or a polymer and a salt) above a critical concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-phase aqueous partition" .

goldbook:10224 a skos:Concept ;
    skos:altLabel "MSPD" ;
    skos:definition "Extraction in which samples are blended with an abrasive solid sorbent, forming a free flowing powder from which target analytes are recovered by solvent elution.Typical work flow scheme for solid-phase matrix dispersion. (i) Sample is blended with an abrasive sorbent, (ii) free flowing powder containing sample is packed in a short column, and (iii) target analytes are recovered by elution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix-solid phase dispersion" .

goldbook:10225 a skos:Concept ;
    skos:altLabel "MAE" ;
    skos:definition "Leaching using microwave energy to heat the solvent in contact with the sample or the sample directly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microwave-assisted extraction" .

goldbook:10226 a skos:Concept ;
    skos:altLabel "subcritical water extraction",
        "superheated water extraction" ;
    skos:definition "Extraction by water below its critical point (\\(\\pu{374.15^{\\circ}C}\\) and \\(\\pu{22.064 MPa}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pressurized hot-water extraction" .

goldbook:10227 a skos:Concept ;
    skos:definition "Leaching performed at elevated temperature and pressure.Schematic diagram of a typical apparatus for pressurized-liquid extraction. Gas flow is used to displace the extraction solvent from the sample chamber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pressurized-liquid extraction" .

goldbook:10228 a skos:Concept ;
    skos:definition "Leaching with fresh solvent cycled multiple times through a fine solid sample contained in a porous thimble.Typical apparatus for classical Soxhlet extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Soxhlet extraction" .

goldbook:10229 a skos:Concept ;
    skos:altLabel "SFE" ;
    skos:definition "Use of a supercritical fluid to extract analytes from a solid or supported liquid sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercritical fluid extraction" .

goldbook:10230 a skos:Concept ;
    skos:definition "Streamlined multiresidue method for extraction and clean-up of analytes in complex matrices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "QuEChERS (quick, easy, cheap, effective, rugged and safe) extraction" .

goldbook:10231 a skos:Concept ;
    skos:altLabel "UAE" ;
    skos:definition "Extraction in which ultrasound energy is used to increase the extraction rate by enhancing the contact area between the sample and solvent and by promoting efficient agitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrasound-assisted extraction" .

goldbook:10232 a skos:Concept ;
    skos:definition "Process in which the sample (analyte and matrix) is dissolved by an acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid digestion" .

goldbook:10233 a skos:Concept ;
    skos:definition "Type of acid digestion performed in a closed vessel at elevated pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "closed-vessel acid digestion" .

goldbook:10234 a skos:Concept ;
    skos:definition "Sample dissolution with simultaneous matrix simplification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "digestion" .

goldbook:10235 a skos:Concept ;
    skos:definition "Type of bomb acid digestion with microwave radiation used for sample heating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microwave acid digestion" .

goldbook:10236 a skos:Concept ;
    skos:definition "Type of acid digestion performed at ambient pressure wherein the digestion temperature is limited by the boiling point of the acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open-vessel acid digestion" .

goldbook:10237 a skos:Concept ;
    skos:definition "Formation of free metal ions in aqueous solution by oxidation under the influence of UV light and possibly an oxidizing agent (e.g. hydrogen peroxide or peroxodisulfate) in order to break down dissolved organic matter and metal complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "UV photochemical digestion" .

goldbook:10238 a skos:Concept ;
    skos:definition "Short disposable column containing a bed of porous particles immobilized between two porous frits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cartridge" .

goldbook:10239 a skos:Concept ;
    skos:definition "Small volume of solvent used to prepare the sorbent for efficient sample processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conditioning solvent" .

goldbook:10240 a skos:Concept ;
    skos:definition "Small volume of strong solvent used to displace target analytes from the sorbent bed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elution solvent" .

goldbook:10241 a skos:Concept ;
    skos:definition "Sorbent consisting of spherical, micron-sized, agglomerated particles bound together in a rigid and highly porous structure used for the extraction of semi-volatile organic compounds from air in high-volume samplers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foamed polyurethane sorbent" .

goldbook:10242 a skos:Concept ;
    skos:altLabel "immunoaffinity sorbents" ;
    skos:definition "Porous material with surface bound monoclonal or polyclonal antibodies capable of selective extraction of target analytes by formation of reversible antibody-antigen (compound) binding complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosorbents" .

goldbook:10243 a skos:Concept ;
    skos:definition "Adsorbent with site-specific polar and ion exchange functional groups that extract analytes from a gas or liquid phase by their complementary interactions with the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inorganic oxide adsorbent" .

goldbook:10244 a skos:Concept ;
    skos:definition "Porous sorbent material  containing fixed ionic sites with a complementary charge to that of the target analyte(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-exchange sorbent" .

goldbook:10245 a skos:Concept ;
    skos:definition "Sorbent with a non-selective surface used almost exclusively to extract analytes from an aqueous solution. The sorbent has a largely passive role in the extraction, with the driving force being the expulsion of the organic contaminants from waterto minimize disruption of the water structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-specificity sorbents" .

goldbook:10246 a skos:Concept ;
    skos:definition "Sorbent consisting of nanometre-sized, spherical particles with a magnetic or magnetisable core surrounded by a sorbent shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic nanoparticle sorbent" .

goldbook:10247 a skos:Concept ;
    skos:definition "Porous sorbent material with surface co-bonded ion exchange and alkyl functional groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed-mode sorbent" .

goldbook:10248 a skos:Concept ;
    skos:altLabel "MIPS" ;
    skos:definition "Porous polymer sorbent with synthetic recognition sites with a high specificity for the sorption of a targeted compound or group of structurally-related compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecularly imprinted polymer sorbent" .

goldbook:10249 a skos:Concept ;
    skos:definition "Regular array of wells in a single moulded body with a short sorbent bed or disc embedded at the base of each well.Multiwell extraction plate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiwell extraction plate" .

goldbook:10250 a skos:Concept ;
    skos:definition "Gas-tight syringe with a sorbent-filled needle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "needle trap" .

goldbook:10251 a skos:Concept ;
    skos:definition "Suspension of micron-sized sorbent particles woven into a glass fibre matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle-embedded glass fibre disc" .

goldbook:10252 a skos:Concept ;
    skos:definition "Suspension of micron-sized sorbent particles distributed throughout a web of poly(tetrafluroethylene) microfibrils formed into a thin disc of various diameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle-loaded membrane disc" .

goldbook:10253 a skos:Concept ;
    skos:definition "Porous material with a biocompatible outer surface and a retentive interior surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "restricted-access sorbent" .

goldbook:10254 a skos:Concept ;
    skos:definition "Weak solvent used to displace matrix components from a sorbent without displacing the target analyte(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rinse solvent" .

goldbook:10255 a skos:Concept ;
    skos:altLabel "SPE" ;
    skos:definition "Extraction of analytes from a gas, liquid, or fluid by transfer to a solid sorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid-phase extraction" .

goldbook:10256 a skos:Concept ;
    skos:definition "Use of a solvent, typically combined with agitation, to remove target analytes from a sorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent desorption" .

goldbook:10257 a skos:Concept ;
    skos:definition "Disposable pipette tip with a small packed bed, disc, or monolithic plug of sorbent at its narrow end.Sorbent containing pipette tips in an array for use with a multiwall sample plate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorbent-containing pipette tip" .

goldbook:10258 a skos:Concept ;
    skos:definition "Extraction from the surface of a solid by sorbent or polymer film in the form of a tape in direct contact with, or in the headspace above, the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorptive-tape extraction" .

goldbook:10259 a skos:Concept ;
    skos:definition "Extraction of compounds from solution by a sorbent coated magnetic stir bar by rapid stirring (direct immersion) or by exposure to the headspace above a sample (headspace extraction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stir bar sorptive extraction" .

goldbook:10260 a skos:Concept ;
    skos:definition "Porous sorbent with surface-bound macrocyclic ligands designed for the extraction of metal ions and some anions from aqueous solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-bound macrocyclic sorbent" .

goldbook:10261 a skos:Concept ;
    skos:definition "Porous sorbent with surface-bound phenylboronic acid groups for the selective extraction of bifunctional compounds by reversible formation of 5- or 6-membered covalent cyclic boronic acid complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-bound phenylboronic acid sorbent" .

goldbook:10262 a skos:Concept ;
    skos:definition "Extraction by a matrix-compatible immersion solid-phase microextraction device where the extraction phase and support are chosen to eliminate matrix interferences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biocompatible solid-phase microextraction" .

goldbook:10263 a skos:Concept ;
    skos:definition "Solid-phase microextraction device where the extraction phase (sorbent) is dispersed in the form of a thin coating on the surface of a blade." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blade format" .

goldbook:10264 a skos:Concept ;
    skos:definition "Sample vessel with sorbent-coated walls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coated-vessel format" .

goldbook:10265 a skos:Concept ;
    skos:definition "Solid-phase microextraction in the fibre format with a sorbent temperature maintained below that of the sample matrix during extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cold fibre solid-phase microextraction" .

goldbook:10266 a skos:Concept ;
    skos:definition "Extraction phase in the form of a thin layer supported on a fibre made of inert material, such as fused silica, stainless steel, or nickel-titanium alloy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibre format" .

goldbook:10267 a skos:Concept ;
    skos:definition "Solid-phase microextraction where the extraction phase is placed in the headspace above the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "headspace solid-phase microextraction" .

goldbook:10268 a skos:Concept ;
    skos:definition "Solid-phase microextraction where the extraction phase is immersed directly into the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immersion solid-phase microextraction" .

goldbook:10269 a skos:Concept ;
    skos:altLabel "INCAT" ;
    skos:definition "In-tube format device with a sorbent-coated capillary placed inside a needle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-needle capillary adsorption trap" .

goldbook:10270 a skos:Concept ;
    skos:definition "Extraction utilizing a coated open tubular or packed capillary tube as the extraction phase in a flow system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-tube solid-phase microextraction" .

goldbook:10271 a skos:Concept ;
    skos:definition "Immersion solid-phase microextraction where the extraction phase is designed to minimize sorption of particles or macromolecules present in the sample matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix-compatible solid-phase microextraction" .

goldbook:10272 a skos:Concept ;
    skos:definition "Immersion solid-phase microextraction in which the extraction phase is surrounded by a permeable membrane that allows access of analytes to the extraction phase while shielding the extraction phase from matrix components with a potential to interfere in the extraction or subsequent analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane-protected solid-phase microextraction" .

goldbook:10273 a skos:Concept ;
    skos:definition "Extraction phase in the form of sorbent particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle sorbent" .

goldbook:10274 a skos:Concept ;
    skos:altLabel "RDSE" ;
    skos:definition "Sorbent-coated disc consisting of a polytetrafluoroethylene (PTFE) base with an integrated magnet and a sorbent film attached to one side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotating disk sorptive extraction" .

goldbook:10275 a skos:Concept ;
    skos:altLabel "SPDE" ;
    skos:definition "Solid-phase microextraction in which the extraction phase is coated on the internal surface of a needle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid-phase dynamic extraction" .

goldbook:10276 a skos:Concept ;
    skos:definition "Microextraction where the extraction phase is a solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid-phase microextraction" .

goldbook:10277 a skos:Concept ;
    skos:definition "Solid-phase microextraction where the sorbent is in the form of a thin film on a support or self supported membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thin film format" .

goldbook:10278 a skos:Concept ;
    skos:altLabel "EME" ;
    skos:definition "Hollow-fibre liquid-phase microextraction in which the extraction is driven by an electrical potential sustained between the sample solution and the acceptor phase, separated by a supported liquid membrane.Typical experimental arrangement for electromembrane extraction of cations (anions extracted by reversing the polarity). SLM, supported liquid membrane in the form of a porous hollow fiber with solvent-filled pores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromembrane extraction" .

goldbook:10279 a skos:Concept ;
    skos:definition "Narrow cylindrical tube prepared from a porous polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hollow fibre" .

goldbook:10280 a skos:Concept ;
    skos:altLabel "HF-LPME" ;
    skos:definition "Liquid-phase microextraction of analytes from a liquid (or gaseous) sample by a supported liquid membrane in the form of a porous hollow fibre with solvent-filled pores. The analytes are transferred to an acceptor phase contained in the cavity of the hollow fibre.Typical experimental arrangement for hollow-fiber supported liquid membrane (SLM) for liquid-phase microextraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hollow-fibre liquid-phase microextraction" .

goldbook:10281 a skos:Concept ;
    skos:definition "Extraction of analytes from a sample by permeation through a membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane extraction" .

goldbook:10282 a skos:Concept ;
    skos:altLabel "MESI" ;
    skos:definition "Membrane extraction with a sorbent trap for concentration of the permeate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane extraction with sorbent interface" .

goldbook:10283 a skos:Concept ;
    skos:definition "Dialysis by a short length of hollow-fibre membrane used for sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microdialysis" .

goldbook:10284 a skos:Concept ;
    skos:definition "Membrane in which permeation occurs by processes other than flow through pores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-porous membrane" .

goldbook:10285 a skos:Concept ;
    skos:altLabel "PALME" ;
    skos:definition "Extraction of analytes from aqueous samples in a multiwell plate with a porous membrane at the base of each well by migration through the solvent-filled membrane pores into an acceptor phase located in each well." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parallel artificial liquid membrane extraction" .

goldbook:10286 a skos:Concept ;
    skos:definition "Stream of extraction phase entering a dialysis module." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perfusate" .

goldbook:10287 a skos:Concept ;
    skos:definition "Process by which mass transfer occurs through a membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permeation" .

goldbook:10288 a skos:Concept ;
    skos:definition "Membrane in which permeation occurs through its porous structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porous membrane" .

goldbook:10289 a skos:Concept ;
    skos:definition "Sample left over in membrane separations after initial contact with the membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retentate stream" .

goldbook:10290 a skos:Concept ;
    skos:altLabel "SPMD" ;
    skos:definition "Membrane extraction in which the membrane fully encloses an acceptor phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semipermeable membrane device" .

goldbook:10291 a skos:Concept ;
    skos:definition "The sample in membrane separations prior to contact with the membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stream" .

goldbook:10292 a skos:Concept ;
    skos:definition "Extraction phase in a membrane separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stripping phase" .

goldbook:10293 a skos:Concept ;
    skos:altLabel "SLM",
        "artificial liquid membrane" ;
    skos:definition "Porous membrane with solvent-filled pores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supported liquid membrane" .

goldbook:10294 a skos:Concept ;
    skos:definition "Flow system with extraction device employing a local detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "at-line extraction" .

goldbook:10295 a skos:Concept ;
    skos:definition "Extraction in a mechanical device regulated by feed-back of information without human intervention." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "automated extraction" .

goldbook:10296 a skos:Concept ;
    skos:definition "Extraction according to manually preselected conditions without further human intervention." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "automatic extraction" .

goldbook:10297 a skos:Concept ;
    skos:definition "Fully renewable (disposable) packed sorbent bed for solid-phase extraction in a flow manifold or mesofluidic platform using programmable flow extraction.Bead-injection protocols for automated solid phase microextraction with sorbent renewal for each assay [Reproduced from  https://www.flowinjectiontutorial.com].a) Injection of a metered amount of particles or beads with reactive surfaces in the flow system followed by mechanical trapping or capture with the aid of external energy sources; b) Injection of a metered volume of sample; c) Interaction of analyte(s) with sorptive surfaces; d) Preconcentration of analyte(s) followed by detection of native species or derivatization products; e) Automatic removal of sorptive surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bead injection" .

goldbook:10298 a skos:Concept ;
    skos:altLabel "environmental availabilty" ;
    skos:definition "Fraction of analytes desorbed from a sample potentially available to organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioaccessibility" .

goldbook:10299 a skos:Concept ;
    skos:definition "Leaching of analytes from a solid or semi-solid sample in a flow-through device to evaluate their bioaccessibility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic bioaccessibility" .

goldbook:10300 a skos:Concept ;
    skos:definition "Extraction by flow of sample through or over the extraction phase, or vice versa, to enhance the extraction rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow-through extraction" .

goldbook:10301 a skos:Concept ;
    skos:definition "Continuous optical interrogation of a packed-sorbent bed in a flow system at any stage of the extraction process prior to analyte elution and sorbent regeneration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow-through solid-phase spectrometry" .

goldbook:10302 a skos:Concept ;
    skos:definition "Coupling of a flow system with extraction device to a detector without flow interruption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-line extraction" .

goldbook:10303 a skos:Concept ;
    skos:definition "Batch-type extraction in which the barrel of a syringe pump is used as the device for liquid-phase microextraction or dispersive solid-phase microextraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-syringe microextraction" .

goldbook:10304 a skos:Concept ;
    skos:definition "Automatic batch-type liquid-phase microextraction by sequential injection analysis using an external extraction container (e.g. pipette tip) connected to a multiposition rotary valve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lab-at-valve liquid-phase microextraction" .

goldbook:10305 a skos:Concept ;
    skos:definition "Microfluidic platform containing microconduits to facilitate extraction processes with pressure-driven or electroosmotic flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lab-on-a-chip extraction" .

goldbook:10306 a skos:Concept ;
    skos:altLabel "LOV" ;
    skos:definition "Mesofluidic platform containing microconduits for extraction processes mounted on a multi-position rotary valve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lab-on-valve extraction" .

goldbook:10307 a skos:Concept ;
    skos:definition "Extraction using a device with at least one movable part that replaces or supplements human effort in any (or all) steps of the process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanized extraction" .

goldbook:10308 a skos:Concept ;
    skos:definition "Extraction device with channel widths from \\(\\pu{10 \\upmu m}\\) to \\(\\pu{2 mm}\\) integrated into a flow platform." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesofluidic extraction device" .

goldbook:10309 a skos:Concept ;
    skos:altLabel "μFIA",
        "μFIA extraction device" ;
    skos:definition "Miniaturized flow injection analysis device for extraction with conduits of a diameter greater than \\(\\pu{0.1 mm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microflow injection analysis extraction device" .

goldbook:10310 a skos:Concept ;
    skos:definition "Extraction device with channel widths from \\(\\pu{100 nm}\\) to \\(\\pu{10 \\upmu m}\\) integrated into a flow platform." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microfluidic extraction device" .

goldbook:10311 a skos:Concept ;
    skos:definition "Programmable flow extraction device with microsolenoid valves for processing microliter sample volumes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicommutation flow extraction" .

goldbook:10312 a skos:Concept ;
    skos:definition "Coupling of a flow system with an extraction device to a detector via a discontinuous interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "on-line extraction" .

goldbook:10313 a skos:Concept ;
    skos:definition "Multi-bidirectional flow (including stopped flow) of sample and/or extractant through an extraction device controlled by a pump." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "programmable flow extraction" .

goldbook:10314 a skos:Concept ;
    skos:definition "Continuous-flow system attaining steady-state extraction/reaction conditions facilitated by injection of air bubbles. This might be extended to immiscible liquids injected as droplets in the flow system. Related term: segmented flow extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "segmented flow analysis" .

goldbook:10315 a skos:Concept ;
    skos:definition "Extraction by insertion of the sample solution as equal-size droplets (segments) in a flowing stream of immiscible extraction phase.Typical segmented flow extraction manifold. C, carrier or liquid phase for sample; R, reagent (optional); P, propulsion unit; S, sample; IV, injection valve; MC, mixing coil; DB, displacement bottle (functions as a constant volume pump); ORG, organic solvent; SG, segmenter; EC, extraction coil; PS, phase separator; D, detector (optional); RC, restriction coil; and W, waste." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "segmented flow extraction" .

goldbook:10316 a skos:Concept ;
    skos:definition "Automatic programmable flow extraction through a multi-position rotary valve housing a mesofluidic extraction device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential injection analysis extraction device" .

goldbook:10317 a skos:Concept ;
    skos:definition "Ratio of the adult toxic dose to the developmentally toxic dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "A/D ratio" .

goldbook:10318 a skos:Concept ;
    skos:definition "Body cavity between the diaphragm and pelvis that contains the abdominal organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abdominal cavity" .

goldbook:10319 a skos:Concept ;
    skos:definition "Congenital absence of the eyelids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ablepharia" .

goldbook:10320 a skos:Concept ;
    skos:definition "Premature termination of pregnancy with the death of the embryo or fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abortion" .

goldbook:10321 a skos:Concept ;
    skos:definition "Intentional termination of a pregnancy with death of the embryo or fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "induced abortion" .

goldbook:10322 a skos:Concept ;
    skos:altLabel "miscarriage" ;
    skos:definition "Non-intentional termination of pregnancy before the embryo or fetus has developed to the stage of independent viability, or in humans before the 20th week of gestation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spontaneous abortion" .

goldbook:10323 a skos:Concept ;
    skos:definition "Rib arising from a cervical vertebra (cervical rib), or supernumerary rib arising from a thoracic or lumbar vertebra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessory rib" .

goldbook:10324 a skos:Concept ;
    skos:definition "Any gland, other than a gonad, associated with the genital tract, such as the bulbourethral gland and prostate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessory sex gland" .

goldbook:10325 a skos:Concept ;
    skos:altLabel "secondary sex organ" ;
    skos:definition "Organ or structure other than the gonads that matures at puberty and assists indirectly in sexual reproduction by nurturing and transporting gametes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessory sex organ" .

goldbook:10326 a skos:Concept ;
    skos:altLabel "hexosaminidase A" ;
    skos:definition "Hydrolytic enzyme (EC 3.2.1.52) that acts on ganglioside \\(\\rm{G}_{\\rm{M2}}\\), producing N-acetyl-D-galactosamine and ganglioside \\(\\rm{G}_{\\rm{M3}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-<em>N</em>-acetylhexosaminidase" .

goldbook:10327 a skos:Concept ;
    skos:definition "Inherited disorder where ossification of cartilage is retarded, especially affecting growth of long bones, resulting in very short limbs and a comparatively large head. Type of dwarfism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "achondroplasia" .

goldbook:10328 a skos:Concept ;
    skos:definition "Small sac-like cavity in a gland, surrounded by secretory cells. Terminal region of the airways of the lung where gas exchange occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acinus" .

goldbook:10329 a skos:Concept ;
    skos:definition "Either of two passages in the ear, one leading to the tympanic membrane (external acoustic meatus), and one for passage of nerves and blood vessels (internal acoustic meatus)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acoustic meatus" .

goldbook:10330 a skos:Concept ;
    skos:definition "Rare congenital disorder that occurs in the human fetus, in which the flat bones in the cranium are either completely or partially absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acrania" .

goldbook:10331 a skos:Concept ;
    skos:altLabel "acrocephalia",
        "oxycephaly" ;
    skos:definition "Type of cephalic disorder where the top of the skull is pointed or conical due to premature closure of the coronal suture plus any other suture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acrocephaly" .

goldbook:10332 a skos:Concept ;
    skos:altLabel "acromegalia" ;
    skos:definition "Abnormal enlargement of the hands, feet, and face in adults, caused by overproduction of growth hormone by the pituitary gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acromegaly" .

goldbook:10333 a skos:Concept ;
    skos:definition "Organelle that develops over the anterior half of the head in the spermatozoon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acrosome" .

goldbook:10334 a skos:Concept ;
    skos:definition "Process that occurs in the acrosome of the sperm as it contacts the egg, leading to structural changes that facilitate fusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acrosome reaction" .

goldbook:10335 a skos:Concept ;
    skos:definition "Growth factor of the transforming growth factor \\(\\upbeta\\) (TGF-\\(\\upbeta\\)) superfamily, originally identified as a gonadal factor that stimulated secretion of follicle-stimulating hormone, also involved in many aspects of development including mesodermal induction (see mesenchyme), hematopoiesis, and neuronal differentiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activin" .

goldbook:10336 a skos:Concept ;
    skos:definition "Irregular or absent estrous cycles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyclicity" .

goldbook:10337 a skos:Concept ;
    skos:altLabel "adactylia",
        "adactylism" ;
    skos:definition "Congenital absence of fingers or toes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adactyly" .

goldbook:10338 a skos:Concept ;
    skos:definition "Malignant tumor formed from glandular epithelial tissue or formed in a glandular pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adenocarcinoma" .

goldbook:10339 a skos:Concept ;
    skos:definition "Congenital absence of skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adermia" .

goldbook:10340 a skos:Concept ;
    skos:definition "Substance contributing to selective cell-cell and cell-matrix binding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adhesion factor" .

goldbook:10341 a skos:Concept ;
    skos:definition "Entrance or opening to some interior space or cavity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aditus" .

goldbook:10342 a skos:Concept ;
    skos:definition "Stage of human development beginning with puberty and ending with adulthood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adolescence" .

goldbook:10343 a skos:Concept ;
    skos:altLabel "Ad4BP" ;
    skos:definition "Transcription factor that regulates the expression of the enzymes of steroid synthesis and is expressed primarily in steroidogenic cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adrenal 4 binding protein" .

goldbook:10344 a skos:Concept ;
    skos:altLabel "paranephric gland",
        "suprarenal gland" ;
    skos:definition "Either of two small endocrine glands, one located above each kidney, consisting of a cortex, which secretes several steroid hormones, and a medulla, which secretes adrenaline and noradrenaline." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adrenal gland" .

goldbook:10345 a skos:Concept ;
    skos:altLabel "2-diol",
        "4-[(1R)-1-hydroxy-2-(methylamino)ethyl]benzene-1",
        "epinephrine" ;
    skos:definition "Catecholamine hormone secreted by the adrenal glands that increases heart rate, breathing rate, blood pressure, and carbohydrate metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adrenaline" .

goldbook:10346 a skos:Concept ;
    skos:altLabel "ACTH" ;
    skos:definition "Hormone secreted by the pituitary gland and stimulating the adrenal cortex (see adrenal gland)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adrenocortocotropic hormone" .

goldbook:10347 a skos:Concept ;
    skos:definition "Person or animal that is fully grown, developed and sexually mature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adult" .

goldbook:10348 a skos:Concept ;
    skos:definition "State of being adult." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adulthood" .

goldbook:10349 a skos:Concept ;
    skos:definition "Absence or partial development of an organ or body part observed at birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agenesis" .

goldbook:10350 a skos:Concept ;
    skos:altLabel "age-specific fecundity",
        "age-specific fertility rate" ;
    skos:definition "Mean number of offspring born to a female in a specific age class in a given year, expressed per \\(\\pu{1000}\\) females in that age class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "age-specific birth rate" .

goldbook:10351 a skos:Concept ;
    skos:definition "Organism made by combining cells from two embryos of different genotypes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aggregation chimera" .

goldbook:10352 a skos:Concept ;
    skos:definition "Congenital absence or partial absence of the lower jaw." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agnathia" .

goldbook:10353 a skos:Concept ;
    skos:definition "Part of the dorsal side of neural tube in the embryo, involved in general somatic and visceral sensory communication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alar plate" .

goldbook:10354 a skos:Concept ;
    skos:altLabel "achromasia",
        "achromatosis" ;
    skos:definition "Congenital disorder characterized by the complete or partial absence of pigment in the skin, hair and eyes, due to an absence of or defect in tyrosinase, a copper-containing enzyme involved in the production of melanin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "albinism" .

goldbook:10355 a skos:Concept ;
    skos:altLabel "ARND" ;
    skos:definition "Spectrum of functional neurologic (behavioral) defects resulting from exposure in utero to alcohol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alcohol-related neurodevelopmental disabilities" .

goldbook:10356 a skos:Concept ;
    skos:definition "Extra-embryonic membrane formed early in development as an outpouching of the yolk sac into the area of the future umbilical cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allantois" .

goldbook:10357 a skos:Concept ;
    skos:definition "Hairlessness; absence or thinning of hair from areas of skin where it is usually present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alopecia" .

goldbook:10358 a skos:Concept ;
    skos:altLabel "AFP",
        "α-1-fetoprotein" ;
    skos:definition "Protein coded by the AFP gene and produced by fetal tissues, an abnormally high amount of which in the amniotic fluid or maternal serum may indicate a neural tube defect, or some other loss of structural integrity in the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alpha-fetoprotein" .

goldbook:10359 a skos:Concept ;
    skos:definition "Any of the many terminal air sacs of the airways in the lungs necessary for rapid gaseous exchange with the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alveolus" .

goldbook:10360 a skos:Concept ;
    skos:definition "Congenital absence of one or both mammary glands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amastia" .

goldbook:10361 a skos:Concept ;
    skos:altLabel "bisexual" ;
    skos:definition "Pertaining to or characterized by hermaphroditism. Denoting sexual characteristics common to both sexes, e.g., pubic hair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambisexual" .

goldbook:10362 a skos:Concept ;
    skos:definition "Lacking one or more limbs or having a shrunken or deformed limb as a birth defect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amelia" .

goldbook:10363 a skos:Concept ;
    skos:definition "Epithelial cell that deposits enamel during tooth development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ameloblast" .

goldbook:10364 a skos:Concept ;
    skos:definition "Hereditary yellow, brown, or grey tooth enamel. Developmental disorder of the teeth in which they are covered with thin, abnormal enamel resulting from defective structure or processing of enamel proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amelogenesis imperfecta" .

goldbook:10365 a skos:Concept ;
    skos:altLabel "menostasis" ;
    skos:definition "Absence or abnormal stoppage of menstruation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amenorrhea" .

goldbook:10366 a skos:Concept ;
    skos:definition "Transabdominal procedure in which amniotic fluid is sampled by means of a needle inserted into the amniotic sac." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amniocentesis" .

goldbook:10367 a skos:Concept ;
    skos:definition "Composite membrane, formed by fusion of the amnion, interiorly, with the outer chorion that surrounds the developing fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amniochorionic membrane" .

goldbook:10368 a skos:Concept ;
    skos:definition "Membrane that lines the amniotic cavity (amniotic sac) and encloses the embryo of a mammal, bird, or reptile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amnion" .

goldbook:10369 a skos:Concept ;
    skos:definition "Any vertebrate animal, such as a reptile, bird, or mammal, that possesses an amnion, chorion, and allantois during embryonic development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amniote" .

goldbook:10370 a skos:Concept ;
    skos:definition "Fluid-filled space that surrounds the developing embryo of a mammal, bird, or reptile, bounded by the amniotic sac." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amniotic cavity" .

goldbook:10371 a skos:Concept ;
    skos:definition "Membranous structure in amniotes, within which the embryo and fetus develop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amniotic sac" .

goldbook:10372 a skos:Concept ;
    skos:definition "Procedure in which a frog (often _027793_) is exposed to a substance starting at the tadpole stage, and the growth and development of the animals is studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amphibian metamorphosis assay" .

goldbook:10373 a skos:Concept ;
    skos:definition "Flask-like dilatation of a canal or duct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ampulla" .

goldbook:10374 a skos:Concept ;
    skos:definition "Terminal part of the large intestine between the rectum and anus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anal canal" .

goldbook:10375 a skos:Concept ;
    skos:definition "In the embryo, dorsal part of the cloacal membrane after its division of the urorectal septum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anal membrane" .

goldbook:10376 a skos:Concept ;
    skos:definition "Any vertebrate animal, such as a fish or amphibian, that lacks an amnion, chorion, and allantois during embryonic development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anamniote" .

goldbook:10377 a skos:Concept ;
    skos:definition "Stage of mitosis and meiosis in which the chromosomes move from the equatorial plate toward opposite ends of the nuclear spindle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphase" .

goldbook:10378 a skos:Concept ;
    skos:definition "Slowing or stopping of normal migration of chromosomes during anaphase, resulting in chromosomes being excluded from one of the daughter cells causing aneuploidy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphase lag" .

goldbook:10379 a skos:Concept ;
    skos:altLabel "dropsy",
        "hydrosarca" ;
    skos:definition "Generalized edema in the subcutaneous connective tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anasarca" .

goldbook:10380 a skos:Concept ;
    skos:definition "Connection creating continuity between two tubular body structures, e.g. blood vessels or loops of bowel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anastomosis" .

goldbook:10381 a skos:Concept ;
    skos:definition "Usual positioning of the developing fetus with the back curved forward, head bent forward, and limbs drawn in towards the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetal anatomic position" .

goldbook:10382 a skos:Concept ;
    skos:definition "Chorionic villus that is attached to the region of the endometrium (see also decidua) that interacts with the trophoblast during development of the placenta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anchoring villus" .

goldbook:10383 a skos:Concept ;
    skos:altLabel "Sertoli cell tumor",
        "arrhenoblastoma" ;
    skos:definition "Rare benign tumor of the testis histologically resembling the fetal testis: the epithelium contains Sertoli cells that may produce estrogen and cause feminization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "androblastoma" .

goldbook:10384 a skos:Concept ;
    skos:definition "Substance, such as a naturally occurring steroid hormone, that binds to androgen receptors to activate the male accessory sex organs and induce male secondary sexual characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "androgen" .

goldbook:10385 a skos:Concept ;
    skos:definition "Producing masculine characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "androgenic" .

goldbook:10386 a skos:Concept ;
    skos:altLabel "AR" ;
    skos:definition "Nuclear receptor that is activated by binding of testosterone or dihydrotestosterone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "androgen receptor" .

goldbook:10387 a skos:Concept ;
    skos:definition "Steroid hormone produced in the adrenal glands and gonads as a common precursor of male (testosterone) and female (estrogen) sex hormones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "androstenedione" .

goldbook:10388 a skos:Concept ;
    skos:definition "Decrease in the number of erythrocytes or total hemoglobin in the blood that results in a decrease in the oxygen-carrying capacity of the blood, sometimes inducing pallor and fatigue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anemia" .

goldbook:10389 a skos:Concept ;
    skos:definition "Fetus lacking all or most of the neural tissues of brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anencephalus" .

goldbook:10390 a skos:Concept ;
    skos:altLabel "anencephalia" ;
    skos:definition "Congenital absence of a major portion of the brain and its meninges, skull, and scalp that results from abnormal embryonic development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anencephaly" .

goldbook:10391 a skos:Concept ;
    skos:definition "Interval of sexual inactivity between two periods of estrus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anestrus" .

goldbook:10392 a skos:Concept ;
    skos:definition "Agent inducing aneuploidy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aneugen" .

goldbook:10393 a skos:Concept ;
    skos:definition "Referring to a cell or organism with missing or extra chromosomes or parts of chromosomes, and thus an abnormal number of chromosomes that is not an exact multiple of the haploid number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aneuploid" .

goldbook:10394 a skos:Concept ;
    skos:definition "State of being aneuploid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aneuploidy" .

goldbook:10395 a skos:Concept ;
    skos:definition "Abnormal bulging of the wall of an artery or a chamber of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aneurysm" .

goldbook:10396 a skos:Concept ;
    skos:altLabel "vasoformative cell" ;
    skos:definition "Cell taking part in blood vessel formation. Primordial mesenchymal tissue from which embryonic blood cells and vascular endothelium are differentiated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angioblast" .

goldbook:10397 a skos:Concept ;
    skos:definition "Development of new blood vessels in the embryo or from pre-existing vessels; formation of capillary networks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angiogenesis" .

goldbook:10398 a skos:Concept ;
    skos:altLabel "ACE" ;
    skos:definition "Enzyme (EC 3.4.15.1) that converts angiotensin I to angiotensin II, causing blood vessels to constrict thus increasing blood pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angiotensin converting enzyme" .

goldbook:10399 a skos:Concept ;
    skos:definition "Congenital oral anomaly, in which the lingual frenulum (the membrane connecting the underside of the tongue to the floor of the mouth) is unusually short and thick." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ankyloglossia" .

goldbook:10400 a skos:Concept ;
    skos:definition "Congenital absence of all primary or permanent teeth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anodontia" .

goldbook:10401 a skos:Concept ;
    skos:altLabel "AGD" ;
    skos:definition "Distance along the perineum between the anus and the base of the vagina or penis, or in the fetus between the anus and the base of the genital tubercle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anogenital distance" .

goldbook:10402 a skos:Concept ;
    skos:altLabel "congenital anomaly" ;
    skos:definition "Deviation in structure or function arising in the embryo or fetus, due to genetic or other causes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental anomaly" .

goldbook:10403 a skos:Concept ;
    skos:definition "Absence of nails." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anonychia" .

goldbook:10404 a skos:Concept ;
    skos:definition "Congenital absence of one or both eyeballs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anophthalmia" .

goldbook:10405 a skos:Concept ;
    skos:definition "Congenital absence of one or both testes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anorchism" .

goldbook:10406 a skos:Concept ;
    skos:definition "Relating to the anus and rectum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anorectal" .

goldbook:10407 a skos:Concept ;
    skos:definition "Congenital absence of the (outer ear) pinna, often with narrowing or absence of the ear canal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anotia" .

goldbook:10408 a skos:Concept ;
    skos:definition "Failure of the ovaries to produce, to facilitate maturation of, or to release ova." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anovulation" .

goldbook:10409 a skos:Concept ;
    skos:definition "Total absence of dioxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anoxia" .

goldbook:10410 a skos:Concept ;
    skos:definition "Before death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antemortem" .

goldbook:10411 a skos:Concept ;
    skos:definition "Before birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antepartum" .

goldbook:10412 a skos:Concept ;
    skos:definition "Referring to inhibition of cell division by mitosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antimitotic" .

goldbook:10413 a skos:Concept ;
    skos:altLabel "AMH",
        "Müllerian inhibiting factor (MIF)",
        "Müllerian-inhibiting hormone (MIH)",
        "Müllerian-inhibiting substance (MIS)." ;
    skos:definition "Protein that inhibits the development of the Müllerian ducts (paramesonephric ducts) in the male embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-Müllerian hormone" .

goldbook:10414 a skos:Concept ;
    skos:definition "Cavity or chamber, often in bone, with specific meanings in some hollow organs (e.g., the pyloric end or gastric antrum of the stomach)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antrum" .

goldbook:10415 a skos:Concept ;
    skos:definition "External opening of the rectum to the body surface, controlled by the anal sphincter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anus" .

goldbook:10416 a skos:Concept ;
    skos:definition "Great artery arising from the left ventricle, being the main trunk from which the systemic arterial system proceeds" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aorta" .

goldbook:10417 a skos:Concept ;
    skos:altLabel "AGM",
        "AGM region" ;
    skos:definition "Region of the vertebrate embryonic mesoderm that gives rise to the genitourinary tract and its blood supply." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aorta-gonad-mesonephros region" .

goldbook:10418 a skos:Concept ;
    skos:definition "Curved portion of the aorta between its ascending portion exiting the heart and its descending portion that proceeds to the arteries of the thoracic and abdominal cavities and the lower body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aortic arch" .

goldbook:10419 a skos:Concept ;
    skos:altLabel "aorticopulmonary septum" ;
    skos:definition "Spiral septum that, during development, separates the truncus arteriosus into a ventral pulmonary trunk and the ascending aorta dorsally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aortopulmonary septum" .

goldbook:10420 a skos:Concept ;
    skos:definition "Absence of the lens of the eye, occurring as a congenital defect or as a result of trauma or surgery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aphakia" .

goldbook:10421 a skos:Concept ;
    skos:definition "Bones and cartilage that support the appendages, including the bones of the shoulders, upper limbs, pelvis, and lower limbs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "appendicular skeleton" .

goldbook:10422 a skos:Concept ;
    skos:definition "Tube-shaped sac ('vermiform appendix') attached to and opening into the upper end of the large intestine (cecum) in humans and some other mammals. Appendage, blind sac, or diverticulum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "appendix" .

goldbook:10423 a skos:Concept ;
    skos:definition "Extreme length and slenderness of the fingers or toes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arachnodactyly" .

goldbook:10424 a skos:Concept ;
    skos:altLabel "arachnoid mater" ;
    skos:definition "Web like membrane that lies between the outer (and much thicker) dura mater and the deeper pia mater, and which covers the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arachnoid membrane" .

goldbook:10425 a skos:Concept ;
    skos:altLabel "arachnoid granulation" ;
    skos:definition "Small projection of the arachnoid membrane into some of the venous sinuses of the dura mater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arachnoid villus" .

goldbook:10426 a skos:Concept ;
    skos:definition "A circular area of different color surrounding a central point, such as that surrounding the nipple of the breast, the part of the iris surrounding the pupil of the eye, or an area surrounding a vesicle. Any minute space or interstice in a tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "areola" .

goldbook:10427 a skos:Concept ;
    skos:altLabel "Chiari malformation" ;
    skos:definition "Congenital herniation of the brainstem and lower cerebellum through the foramen magnum into the cervical vertebral canal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Arnold–Chiari malformation" .

goldbook:10428 a skos:Concept ;
    skos:altLabel "estrogen synthetase" ;
    skos:definition "Enzyme (EC 1.14.14.1) of the cytochrome P450 superfamily that converts testosterone to 17\\(\\upbeta\\)-estradiol and androstenedione to estrone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aromatase" .

goldbook:10429 a skos:Concept ;
    skos:definition "Increase in the diameter of arterial vessels that leads to the formation of large conductance arteries from pre-existing arterioles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriogenesis" .

goldbook:10430 a skos:Concept ;
    skos:altLabel "AV Shunt" ;
    skos:definition "Connection between the arterial and venous sides of the circulation that bypasses the capillary beds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriovenous shunt" .

goldbook:10431 a skos:Concept ;
    skos:definition "Introduction of semen into the cervix, uterus or Fallopian tubes by means other than the natural one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial insemination" .

goldbook:10432 a skos:Concept ;
    skos:altLabel "AHR" ;
    skos:definition "Ligand-activated transcription factor involved in the regulation of biological responses to planar aromatic hydrocarbons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aryl hydrocarbon receptor" .

goldbook:10433 a skos:Concept ;
    skos:altLabel "ARNT" ;
    skos:definition "Protein coded for by a gene on chromosome 1q21 that forms a complex with ligand-bound aryl hydrocarbon receptor, resulting in translocation of the ligand-binding subunit to the nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aryl hydrocarbon receptor nucleotide translocator protein" .

goldbook:10434 a skos:Concept ;
    skos:definition "Total or partial collapse of the lung. Congenital condition characterized by the incomplete expansion of the lungs at birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atelectasis" .

goldbook:10435 a skos:Concept ;
    skos:definition "Congenital absence of one or both nipples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "athelia" .

goldbook:10436 a skos:Concept ;
    skos:definition "Congenital absence of functioning thymus tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "athymia" .

goldbook:10437 a skos:Concept ;
    skos:altLabel "clausura" ;
    skos:definition "Congenital absence or abnormal narrowing of a normal opening or normally patent lumen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atresia" .

goldbook:10438 a skos:Concept ;
    skos:altLabel "ASD" ;
    skos:definition "Defect in the septum between the atria of the heart, due to failure of normal closure of the foramen ovale in the perinatal period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atrial-septal defect" .

goldbook:10439 a skos:Concept ;
    skos:definition "Congenital baldness caused by an abnormality of the hairless gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atrichia congenita" .

goldbook:10440 a skos:Concept ;
    skos:definition "Relating to the atrial and ventricular chambers of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atrioventricular" .

goldbook:10441 a skos:Concept ;
    skos:definition "Each of the two upper chambers of the heart from which blood is passed to the ventricles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atrium" .

goldbook:10442 a skos:Concept ;
    skos:definition "Wasting away of the body or of an organ or tissue, involving a decrease in size and (or) numbers of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atrophy" .

goldbook:10443 a skos:Concept ;
    skos:altLabel "Eustachian tube" ;
    skos:definition "Narrow channel connecting the middle ear and the nasopharynx." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auditory tube" .

goldbook:10444 a skos:Concept ;
    skos:definition "An appendage to the atrium of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auricle" .

goldbook:10445 a skos:Concept ;
    skos:definition "Postmortem examination of the human organs and body tissue to determine cause of death or pathological condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autopsy" .

goldbook:10446 a skos:Concept ;
    skos:definition "Independent twin of a pair of conjoined twins; the other twin is a parasitic twin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autosite" .

goldbook:10447 a skos:Concept ;
    skos:definition "Change in an autosomal gene capable of expression when carried by only one of a pair of homologous chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autosomal dominant mutation" .

goldbook:10448 a skos:Concept ;
    skos:definition "Change in an autosomal gene that produces an effect in the organism only when it is homozygous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autosomal recessive mutation" .

goldbook:10449 a skos:Concept ;
    skos:definition "Any chromosome that is not a sex chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autosome" .

goldbook:10450 a skos:Concept ;
    skos:definition "Absence of a blood supply." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "avascularity" .

goldbook:10451 a skos:Concept ;
    skos:definition "Bones of the body axis, including the skull, spinal column, ribs and sternum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axial skeleton" .

goldbook:10452 a skos:Concept ;
    skos:definition "Absence of viable spermatozoa in the semen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azoospermia" .

goldbook:10453 a skos:Concept ;
    skos:altLabel "basal nuclei" ;
    skos:definition "Complex structure at the base of the brain consisting of several groups of neurons, the caudate nucleus, the putamen, the globus pallidus, and the substantia nigra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basal ganglia" .

goldbook:10454 a skos:Concept ;
    skos:altLabel "basal lamina" ;
    skos:definition "Thin layer of connective tissue underlying an attached epithelial cell layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basement membrane" .

goldbook:10455 a skos:Concept ;
    skos:definition "Period in which the developing tooth takes on a bell shape in cross section, immediately preceding the 'advanced bell stage', in which the hard tissues (dentin and enamel) form the crown of the tooth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bell stage" .

goldbook:10456 a skos:Concept ;
    skos:definition "Uterus that is divided into two lateral horns as a result of imperfect fusion of the paired embryonic tubes from which the uterus is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bicornate uterus" .

goldbook:10457 a skos:Concept ;
    skos:altLabel "bilaminar blastoderm" ;
    skos:definition "Early blastula having only two of the three primary germ layers that it will ultimately have; the two layers present are the cells of the epiblast that will give rise to the ectoderm and those of the hypoblast that will become the endoderm during gastrulation - both attached to a basement membrane before the mesoderm has formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bilaminar embryo" .

goldbook:10458 a skos:Concept ;
    skos:definition "Start of life as a physically separate being, e.g., the emergence of a baby from the body of its mother, or the hatching of an egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "birth" .

goldbook:10459 a skos:Concept ;
    skos:altLabel "congenital defect" ;
    skos:definition "Physical or biochemical abnormality that is present at birth, and that may either be inherited or be the result of environmental influence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "birth defect" .

goldbook:10460 a skos:Concept ;
    skos:definition "Mass of cells from which an organ or a body part develops, either in normal development or in the regeneration of a lost body part." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blastema" .

goldbook:10461 a skos:Concept ;
    skos:altLabel "cleavage cavity",
        "segmentation cavity" ;
    skos:definition "Fluid-filled cavity in the blastula of a developing embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blastocoel" .

goldbook:10462 a skos:Concept ;
    skos:definition "Modified blastula that is characteristic of placental mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blastocyst" .

goldbook:10463 a skos:Concept ;
    skos:definition "Any of the cells formed by cleavage of a fertilized egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blastomere" .

goldbook:10464 a skos:Concept ;
    skos:altLabel "blastocyst",
        "blastodermic vesicle" ;
    skos:definition "Hollow mass of cells formed after a zygote has undergone approximately six cell divisions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blastula" .

goldbook:10465 a skos:Concept ;
    skos:definition "Process by which the early embryo transforms from the morula into the blastula." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blastulation" .

goldbook:10466 a skos:Concept ;
    skos:altLabel "Sertoli cell barrier (SCB)",
        "blood-seminiferous tubule barrier" ;
    skos:definition "Occluding barrier, formed by the Sertoli cells of the seminiferous tubules, that separates the more mature cells of spermatogenesis from blood-borne products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood–testis barrier" .

goldbook:10467 a skos:Concept ;
    skos:definition "Average age at which children reach a given stage of bone maturation, denoting the stage of skeletal development of an individual fetus or child." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bone age" .

goldbook:10468 a skos:Concept ;
    skos:altLabel "BMP",
        "bone morphogenic protein" ;
    skos:definition "Any of a family of growth factors involved in bone and cartilage formation and, more generally, in orchestrating tissue architecture through morphogenetic signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bone morphogenetic protein" .

goldbook:10469 a skos:Concept ;
    skos:altLabel "BMP4",
        "bone morphogenic protein-4 (BMP4)" ;
    skos:definition "Bone morphogenetic protein member of the transforming growth factor \\(\\upbeta\\) (TGF-\\(\\upbeta\\)) superfamily." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bone morphogenetic protein-4" .

goldbook:10470 a skos:Concept ;
    skos:altLabel "brachydactylia" ;
    skos:definition "Congenital abnormal shortness of fingers and toes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brachydactyly" .

goldbook:10471 a skos:Concept ;
    skos:definition "Of, relating to, or resembling the gills of a fish or the homologous embryonic structures and their derivatives in higher animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branchial" .

goldbook:10472 a skos:Concept ;
    skos:altLabel "gill arch" ;
    skos:definition "In embryology, one of several arches, resembling the gill arches of a fish, found in the embryo of a higher vertebrate; these arches develop into structures of the ear and neck. In biology, one of several bony or cartilaginous arches located on either side of the pharynx and supporting the gills in fish and amphibians." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branchial arch" .

goldbook:10473 a skos:Concept ;
    skos:altLabel "branchiogenic cyst" ;
    skos:definition "Congenital cyst arising in the lateral aspect of the neck, from epithelial remnants of a pharyngeal groove." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congenital branchial cyst" .

goldbook:10474 a skos:Concept ;
    skos:definition "Shortness of the neck." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brevicollis" .

goldbook:10475 a skos:Concept ;
    skos:definition "Largest subdivision of a lobe of the lung with its air supply from a major branch of the bronchus and having its own arterial blood supply." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bronchopulmonary segment" .

goldbook:10476 a skos:Concept ;
    skos:altLabel "oropharyngeal membrane" ;
    skos:definition "Membrane present in fetal life that separates the nasal cavities from the pharynx." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "buccopharyngeal membrane" .

goldbook:10477 a skos:Concept ;
    skos:definition "Small protuberance resembling the bud of a plant and having the potential for growth and differentiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bud" .

goldbook:10478 a skos:Concept ;
    skos:definition "Region of the frontal lobe of the brain, receiving input from neurons of the nasal mucosa and involved in the sense of smell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "olfactory bulb" .

goldbook:10479 a skos:Concept ;
    skos:altLabel "Cowper’s gland" ;
    skos:definition "One of two small glands located on each side of, and inferior to, the prostate, draining to the urethra. Bulbourethral glands secrete a fluid component of the seminal fluid" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulbourethral gland" .

goldbook:10480 a skos:Concept ;
    skos:definition "Outflow tract of the embryonic heart between the primitive ventricle and the aorta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulbus cordis" .

goldbook:10481 a skos:Concept ;
    skos:altLabel "atrioventricular bundle" ;
    skos:definition "Band of specialized cardiac muscle fibers connecting the atria with the ventricles of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bundle of His" .

goldbook:10482 a skos:Concept ;
    skos:definition "Padlike fluid-filled sac or sac-like cavity, especially one reducing friction at a joint." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bursa" .

goldbook:10483 a skos:Concept ;
    skos:altLabel "Caesarian delivery" ;
    skos:definition "Surgical operation for delivering a child by opening the mother’s abdominal wall and uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Caesarian section" .

goldbook:10484 a skos:Concept ;
    skos:definition "In biology and medicine, a relatively narrow tubular passage or channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "canal" .

goldbook:10485 a skos:Concept ;
    skos:definition "Disease resulting from the development of a malignant tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cancer" .

goldbook:10486 a skos:Concept ;
    skos:definition "Sum of biochemical changes undergone by mammalian spermatozoa in the female genital tract that enables them to penetrate and fertilize (see fertilization) an egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capacitation" .

goldbook:10487 a skos:Concept ;
    skos:altLabel "globus major",
        "head of epididymis" ;
    skos:definition "Upper and larger extremity of the epididymis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "caput epididymis" .

goldbook:10488 a skos:Concept ;
    skos:definition "Induction, by chemical, physical, or biological agents, of malignant neoplasms and thus of cancer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcinogenesis" .

goldbook:10489 a skos:Concept ;
    skos:definition "Pertaining to the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiac" .

goldbook:10490 a skos:Concept ;
    skos:definition "Gelatinous substance, present between the endothelium and myocardium of the heart in early embryos, that develops into the connective tissue of the endocardium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiac jelly" .

goldbook:10491 a skos:Concept ;
    skos:definition "Development of the heart in the embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiogenesis" .

goldbook:10492 a skos:Concept ;
    skos:definition "Originating in the heart; describing anything caused by normal or abnormal function of the heart. Pertaining to cardiogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiogenic" .

goldbook:10493 a skos:Concept ;
    skos:definition "Pertaining to the heart and blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiovascular" .

goldbook:10494 a skos:Concept ;
    skos:definition "Specialized, fibrous connective tissue present in adults, forming the temporary skeleton in the embryo, providing a model in which the bones develop, and constituting a part of the organism’s growth mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cartilage" .

goldbook:10495 a skos:Concept ;
    skos:definition "Removal of the testicles or ovaries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "castration" .

goldbook:10496 a skos:Concept ;
    skos:definition "Partial or complete opacity (clouding) of the lens of the eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cataract" .

goldbook:10497 a skos:Concept ;
    skos:altLabel "globus minor" ;
    skos:definition "Tail of the epididymis that opens into the ductus deferens; part of the reservoir of spermatozoa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cauda epididymis" .

goldbook:10498 a skos:Concept ;
    skos:definition "Situated more toward the cauda, or tail, than some specified reference point; toward the inferior (in humans) or posterior (in animals) end of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "caudal" .

goldbook:10499 a skos:Concept ;
    skos:definition "Formation of a cavity, as in formation of the amnion in mammalian development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cavitation" .

goldbook:10500 a skos:Concept ;
    skos:definition "Pouch connected to the junction of the small and large intestines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cecum" .

goldbook:10501 a skos:Concept ;
    skos:altLabel "CNS" ;
    skos:definition "Part of an animal’s nervous system that exerts control over the rest of the nervous system; in vertebrates, the brain and spinal cord protected within the dorsal body cavity (cranial and spinal cavities)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "central nervous system" .

goldbook:10502 a skos:Concept ;
    skos:definition "Constricted region of a chromosome that joins the two chromatids to each other and attaches to spindle fibers in mitosis and meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centromere" .

goldbook:10503 a skos:Concept ;
    skos:definition "Having the centromere very close to one end." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acrocentric centromere" .

goldbook:10504 a skos:Concept ;
    skos:definition "Right or left half of the brain in sagittal section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebral hemisphere" .

goldbook:10505 a skos:Concept ;
    skos:altLabel "spastic paralysis" ;
    skos:definition "Condition marked by lack of muscle control, resulting from brain damage before, at, or shortly after birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebral palsy" .

goldbook:10506 a skos:Concept ;
    skos:altLabel "costa cervicalis" ;
    skos:definition "Supernumerary rib arising from a cervical vertebra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cervical rib" .

goldbook:10507 a skos:Concept ;
    skos:altLabel "cervix uteri",
        "uterine cervix" ;
    skos:definition "Narrow lower end of the uterus that opens into the vagina." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cervix" .

goldbook:10508 a skos:Concept ;
    skos:definition "Type of pathway used in intracellular signaling, activated in response to a cell’s own internal imbalance or to errors in its synthetic activities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "checkpoint pathway" .

goldbook:10509 a skos:Concept ;
    skos:definition "Group of testing methods for assessing parturition, postnatal growth, and viability of prenatally exposed litters of test animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Chernoff–Kavlock assay" .

goldbook:10510 a skos:Concept ;
    skos:definition "Animal consisting of genetically different cells derived from two (or more) different zygotes. Substance, such as an antibody, created from the proteins or genes of two different species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chimera" .

goldbook:10511 a skos:Concept ;
    skos:definition "Formation of cartilage; transformation into cartilage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chondrification" .

goldbook:10512 a skos:Concept ;
    skos:definition "Cartilage-producing mesenchymal progenitor cell, capable of proliferating and maturing into a chondrocyte or osteoblast." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chondroblast" .

goldbook:10513 a skos:Concept ;
    skos:definition "Any one of the cells embedded in the lacunae of the cartilage matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chondrocyte" .

goldbook:10514 a skos:Concept ;
    skos:definition "Secreted protein that dorsalizes early vertebrate embryonic tissues by binding to ventralizing transforming growth factor \\(\\upbeta\\) (TGF-\\(\\upbeta\\))-like bone morphogenetic proteins, sequestering them in latent complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chordin" .

goldbook:10515 a skos:Concept ;
    skos:definition "Placenta developed from the allantois and chorion, establishing a nutritive and excretory connection between the blood of the fetus and that of the mother." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorioallantoic placenta" .

goldbook:10516 a skos:Concept ;
    skos:definition "In human embryology, the cellular, outermost extra-embryonicmembrane, composed of trophoblast lined with mesoderm. Note: The chorion develops villi, becomes vascularized by allantoic vessels, and forms the fetal part of the placenta.  In mammalian embryology, the cellular, outer extra embryonic membrane, not necessarily developing villi. In biology, the noncellular membrane covering eggs of various animals, e.g., fish and insects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorion" .

goldbook:10517 a skos:Concept ;
    skos:definition "Hormone secreted by the chorionic villi of the placenta in mammals, especially human chorionic gonadotropin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorionic gonadotropin" .

goldbook:10518 a skos:Concept ;
    skos:definition "Outermost membranous sac that encloses the embryo in higher vertebrates (reptiles, birds, and mammals), lined by chorion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorionic sac" .

goldbook:10519 a skos:Concept ;
    skos:definition "Any of the tiny extensions from the chorion that contain fetal blood vessels and combine with the uterine tissue to form the placenta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorionic villus" .

goldbook:10520 a skos:Concept ;
    skos:definition "Inflammation of the choroid layer behind the retina of the eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorioretinitis" .

goldbook:10521 a skos:Concept ;
    skos:definition "Infoldings of blood vessels of the pia mater, projecting into the cerebral ventricles, covered with ependymal cells, and secreting cerebrospinal fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "choroid plexus" .

goldbook:10522 a skos:Concept ;
    skos:definition "Cell of the adrenal medulla that secretes epinephrine and norepinephrine, and contains granules that are readily stained with chromate salts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromaffin cell" .

goldbook:10523 a skos:Concept ;
    skos:definition "One of a pair of chromosomes arising by duplication during mitosis or by pairing during meiosis, and joined together at the centromere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatid" .

goldbook:10524 a skos:Concept ;
    skos:definition "Abnormality in the number or structure of chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosomal abnormality" .

goldbook:10525 a skos:Concept ;
    skos:definition "Loss of a chromosome or part of a chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosome deletion" .

goldbook:10526 a skos:Concept ;
    skos:definition "Abnormal chromosome in which both ends have been lost and the two broken ends have reunited to form a ring-shaped structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosome ring" .

goldbook:10527 a skos:Concept ;
    skos:definition "Agent causing chromosome breakage and (or) the consequent gain, loss, or rearrangement of pieces of chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clastogen" .

goldbook:10528 a skos:Concept ;
    skos:definition "First few divisions of a fertilized egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cleavage" .

goldbook:10529 a skos:Concept ;
    skos:definition "Partial cleavage of the egg, occurring in some animals, such as reptiles and birds, whose eggs have a large amount of yolk, resulting in unequal blastomeres and only part of the egg progressing to further cell division; the yolk mass remains and has nutritive value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meroblastic cleavage" .

goldbook:10530 a skos:Concept ;
    skos:definition "Cleavage producing separate, equal blastomeres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "holoblastic cleavage" .

goldbook:10531 a skos:Concept ;
    skos:altLabel "fissure" ;
    skos:definition "Gap in soft tissue, bone, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cleft" .

goldbook:10532 a skos:Concept ;
    skos:definition "Split, divided, or partly divided into two." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cleft" .

goldbook:10533 a skos:Concept ;
    skos:altLabel "cheiloschisis",
        "hare lip" ;
    skos:definition "Congenital malformation consisting of one or more clefts in the upper lip, the result of failed closure in the embryo of the maxillary and median nasal processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cleft lip" .

goldbook:10534 a skos:Concept ;
    skos:altLabel "palatoschisis" ;
    skos:definition "Congenital fissure along the midline of the hard palate, that may extend into the soft palate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cleft palate" .

goldbook:10535 a skos:Concept ;
    skos:definition "Rare congenital malformation resulting from defective fusion in the embryo of paired mesodermal bands in the ventral midline." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cleft sternum" .

goldbook:10536 a skos:Concept ;
    skos:definition "Erectile body in the female genitalia, homologous with the penis in the male." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clitoris" .

goldbook:10537 a skos:Concept ;
    skos:definition "Common cavity at the end of the digestive tract in vertebrates (apart from most mammals) into which are released both excretory and genital products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloaca" .

goldbook:10538 a skos:Concept ;
    skos:definition "Membrane that covers the embryonic cloaca during the development of urinary and reproductive organs in those vertebrates where the cloaca occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloacal membrane" .

goldbook:10539 a skos:Concept ;
    skos:altLabel "estrogenism" ;
    skos:definition "Condition caused by the continued ingestion of low but toxic levels of estrogens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clover disease" .

goldbook:10540 a skos:Concept ;
    skos:altLabel "talipes" ;
    skos:definition "Deformed foot that is twisted out of shape or position, usually congenital (congenital talipes equinovarus (CTEV))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clubfoot" .

goldbook:10541 a skos:Concept ;
    skos:definition "Narrowing or constriction of a short section of a blood vessel, commonly of the aorta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coarctation" .

goldbook:10542 a skos:Concept ;
    skos:definition "Spiral cavity of the inner ear containing the organ of Corti that transduces sound into nerve impulses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cochlea" .

goldbook:10543 a skos:Concept ;
    skos:definition "Body cavity, found in many animals, lined with mesodermal epithelium and containing the digestive tract and other visceral organs" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coelom" .

goldbook:10544 a skos:Concept ;
    skos:definition "Rich in the fibrous connective tissue protein, collagen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collagenous" .

goldbook:10545 a skos:Concept ;
    skos:definition "Procedure in which collembolans (small soil-inhabiting insects) are exposed to soil that has been treated with a test substance, and adult mortality and reproductive output are studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collembolan reproduction test" .

goldbook:10546 a skos:Concept ;
    skos:definition "Any defect resulting from incomplete closure of the retinal fissure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coloboma" .

goldbook:10547 a skos:Concept ;
    skos:definition "Procedure to evaluate both general systemic toxicity, with an emphasis on neurological endpoints, and notably reproductive effects and developmental progression in rodents. Groups of males and females are administered a test substance in graded doses prior to mating, during the mating period, and subsequently (up to two weeks post-mating in males and four days post-delivery in females)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combined repeated dose toxicity study" .

goldbook:10548 a skos:Concept ;
    skos:definition "Complication of labor in twin births in which there is attempted simultaneous expulsion of both twins, so that the lower part of the mother’s pelvis is filled and further descent through the birth canal is prevented. In embryology, process during which blastomeres change their shape and align themselves tightly against each other to form the compact morula." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compaction" .

goldbook:10549 a skos:Concept ;
    skos:definition "Hypothesis that explains transposition of the great arteries of the heart by failure of the aortopulmonary septum to follow a spiral course during partitioning of the bulbus cordis and truncus arteriosus in the process of forming the aorta and pulmonary trunk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conal growth hypothesis" .

goldbook:10550 a skos:Concept ;
    skos:definition "Formation of a viable zygote by the union of a spermatozoon and an ovum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conception" .

goldbook:10551 a skos:Concept ;
    skos:definition "Embryo and associated membranes in the uterus, especially during the early stages of pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conceptus" .

goldbook:10552 a skos:Concept ;
    skos:definition "Present from birth, as of a disease or physical abnormality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congenital" .

goldbook:10553 a skos:Concept ;
    skos:altLabel "adrenogenital syndrome" ;
    skos:definition "Group of disorders caused by hyperplasia of the adrenal cortex or by malignant tumors, resulting in excess secretion of adrenocortical androgenic hormones, and characterized by masculinization of women, feminization of men, or precocious puberty in the male." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congenital adrenal hyperplasia" .

goldbook:10554 a skos:Concept ;
    skos:definition "Malformation existing at birth, or developing during the first month of life, regardless of the cause." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congenital malformation" .

goldbook:10555 a skos:Concept ;
    skos:altLabel "Siamese twin" ;
    skos:definition "One of a pair of identical twins fused together with varying degrees of union and of residual duplication of organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjoined twin" .

goldbook:10556 a skos:Concept ;
    skos:definition "Extracellular matrix of fibrous proteins and glycoproteins, with associated cells such as fibroblasts, that fills the spaces between and within organs and tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "connective tissue" .

goldbook:10557 a skos:Concept ;
    skos:definition "Anything that prevents, or reduces the likelihood of pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contraceptive" .

goldbook:10558 a skos:Concept ;
    skos:definition "Sudden, violent, irregular movement of the body caused by involuntary contraction of muscles and associated with brain disorders, such as epilepsy, fever in children, or with drug or alcohol abuse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "convulsion" .

goldbook:10559 a skos:Concept ;
    skos:definition "Either of the two columns of erectile tissue forming the body of the clitoris (corpus cavernosum clitoridis) or penis (corpus cavernosum penis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corpus cavernosum" .

goldbook:10560 a skos:Concept ;
    skos:definition "Glandular mass of yellowish tissue in the ovary, formed by a Graafian ovarian follicle that has matured and released its oocyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corpus luteum" .

goldbook:10561 a skos:Concept ;
    skos:definition "Outer layer of an organ such as the kidney, the cerebellum, or the adrenal gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cortex" .

goldbook:10562 a skos:Concept ;
    skos:definition "Outer layer of the cerebrum, composed of folded grey matter, playing an important role in consciousness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebral cortex" .

goldbook:10563 a skos:Concept ;
    skos:definition "Thickenings in the surface ectoderm of the embryo associated with future eye and ear regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cranial placodes" .

goldbook:10564 a skos:Concept ;
    skos:definition "Line where the bony plates of the skull are joined together by fibrous bands of tissue, easily felt in the newborn before closure by ossification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cranial suture" .

goldbook:10565 a skos:Concept ;
    skos:definition "Pertaining to the cranium and the face." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "craniofacial" .

goldbook:10566 a skos:Concept ;
    skos:definition "Neural tube defect in which both the cranium and vertebral column remain open." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "craniorachischisis" .

goldbook:10567 a skos:Concept ;
    skos:definition "Developmental failure of the cranial sutures to close completely, especially at the occiput, usually leading to grossly defective development of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cranioschisis" .

goldbook:10568 a skos:Concept ;
    skos:definition "Premature closure of the cranial sutures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "craniosynostosis" .

goldbook:10569 a skos:Concept ;
    skos:definition "Bony structure surrounding the brain, excluding the bones of the face." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cranium" .

goldbook:10570 a skos:Concept ;
    skos:definition "Bacterial system in which the Cre protein mediates DNA recombination between specific DNA sequences known as lox-P sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cre/loxP" .

goldbook:10571 a skos:Concept ;
    skos:definition "Developmental disorder caused by deficiency of thyroid hormone, characterized by severe mental retardation and stunted physical growth, sometimes resulting from maternal iodine deficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cretinism" .

goldbook:10572 a skos:Concept ;
    skos:altLabel "5p - syndrome",
        "Lejeune syndrome" ;
    skos:definition "Hereditary congenital syndrome due to deletion of the short arm of chromosome 5." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cri du chat syndrome" .

goldbook:10573 a skos:Concept ;
    skos:definition "One of the inward projections or folds of the inner membrane of a mitochondrion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crista" .

goldbook:10574 a skos:Concept ;
    skos:definition "Specific time in the development of a biological system when it is particularly vulnerable to injury or misdirection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical period" .

goldbook:10575 a skos:Concept ;
    skos:altLabel "branchial arch syndrome" ;
    skos:definition "Group of autosomal dominant genetic diseases characterized by midfacial hypoplasia, craniosynostosis, exophthalmos, and a shortened head." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Crouzon syndrome" .

goldbook:10576 a skos:Concept ;
    skos:definition "Small tubular gland, pit, or depression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crypt" .

goldbook:10577 a skos:Concept ;
    skos:definition "Failure of the eyelids to develop with a fissure between them, usually with defective formation of the eyeballs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryptophthalmos" .

goldbook:10578 a skos:Concept ;
    skos:definition "Mass of follicular cells surrounding the oocyte in the Graafian follicle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulus oophorus" .

goldbook:10579 a skos:Concept ;
    skos:definition "Bluish discoloration of the skin and mucous membranes due to excessive concentration of deoxygenated haemoglobin, owing to poor circulation or inadequate oxygenation of the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanosis" .

goldbook:10580 a skos:Concept ;
    skos:definition "Cycle of physiological changes in the female reproductive organs, from the time of fertilization of the oocyte through gestation and parturition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive cycle" .

goldbook:10581 a skos:Concept ;
    skos:altLabel "cyclocephaly",
        "synophthalmia" ;
    skos:definition "Rare form of holoprosencephaly, a congenital disorder characterized by a single orbital fossa due to the failure of the embryonic prosencephalon to divide the orbits of the eye correctly into two cavities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclopia" .

goldbook:10582 a skos:Concept ;
    skos:definition "In an animal or plant, thin-walled hollow organ or cavity containing a liquid secretion. Sac, vesicle, or bladder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyst" .

goldbook:10583 a skos:Concept ;
    skos:definition "Branch of genetics in which the structure and function of chromosomes and of other cell constituents concerned with heritable properties and their expression are studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytogenetics" .

goldbook:10584 a skos:Concept ;
    skos:definition "Type of Herpes virus that usually produces very mild symptoms in an infected person but may cause severe neurological damage in people with weakened immune systems and in the newborn." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytomegalovirus" .

goldbook:10585 a skos:Concept ;
    skos:definition "Inner cellular layer of the trophectoderm (trophoblast); part of the mammalian placenta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotrophoblast" .

goldbook:10586 a skos:Concept ;
    skos:definition "Procedure in which young female Daphnia are exposed to a substance added to the water and numbers of living offspring and surviving parent organisms are recorded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Daphnia magna reproduction test" .

goldbook:10587 a skos:Concept ;
    skos:definition "Modified endometrial layer that lines the uterus during pregnancy and is shed with the afterbirth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decidua" .

goldbook:10588 a skos:Concept ;
    skos:definition "Enlarged, ovoid, connective tissue cell appearing in the endometrium during pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decidual cell" .

goldbook:10589 a skos:Concept ;
    skos:definition "Biological test method in which pseudopregnant rats undergo a surgical treatment of the uterus to induce uterine differentiation and proliferation, resulting in massive tissue growth that mimics the response of the uterus during normal blastocyst implantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decidual cell response technique" .

goldbook:10590 a skos:Concept ;
    skos:definition "Changes in response to progesterone that include the eosinophilic proliferation around arterioles after ovulation or progesterone action on endometrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decidualization" .

goldbook:10591 a skos:Concept ;
    skos:definition "Swelling of a uterine crypt produced by its reaction to an implanted embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deciduum" .

goldbook:10592 a skos:Concept ;
    skos:definition "Pertaining to two or more things that cross or intersect each other to form an X." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decussate" .

goldbook:10593 a skos:Concept ;
    skos:definition "Gonadotropin secretion without female sex hormones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "defeminized gonadotropin secretion" .

goldbook:10594 a skos:Concept ;
    skos:altLabel "castrated" ;
    skos:definition "Describing a male animal from which the testicles have been removed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "demasculinized" .

goldbook:10595 a skos:Concept ;
    skos:definition "Layer of the skin deep under the epidermis, consisting of a bed of vascularized connective tissue and containing the nerves and organs of sensation, the hair roots, and sebaceous and sweat glands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dermis" .

goldbook:10596 a skos:Concept ;
    skos:definition "Failure of synapsis due to separation of homologous chromosomes after initial pairing in meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desynapsis" .

goldbook:10597 a skos:Concept ;
    skos:definition "Study of biological development from fertilization to adulthood, usually with an emphasis on the prenatal period and regulation of morphogenesis, and neural development on through adolescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental biology" .

goldbook:10598 a skos:Concept ;
    skos:definition "Procedure in which female rodents are exposed to a test substance from the time of implantation through all of lactation; offspring may be exposed during the preweaning period, either directly or through milk, and are studied with regard to neurologic and behavioral abnormalities during postnatal development and until adulthood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental neurotoxicity study" .

goldbook:10599 a skos:Concept ;
    skos:definition "Any gene that encodes a gene product that can be altered by environmental agents to cause disturbance of normal development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental susceptibility gene" .

goldbook:10600 a skos:Concept ;
    skos:definition "Study of adverse effects on the developing organism that result from exposure of either parent to an agent or substance prior to conception, of the mother and fetus during prenatal development, and of the child from birth until the time development is completed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental toxicology" .

goldbook:10601 a skos:Concept ;
    skos:definition "Congenital defect in which the apex of the heart is directed toward the right side of the thorax (isolated dextrocardia), or the heart is found in a mirror image position on the right side of the body (dextrocardia situs inversus)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dextrocardia" .

goldbook:10602 a skos:Concept ;
    skos:definition "Displacement to the right." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dextroposition" .

goldbook:10603 a skos:Concept ;
    skos:altLabel "DGS",
        "DiGeorge anomaly",
        "Shprintzen syndrome",
        "Strong syndrome",
        "congenital thymic aplasia",
        "conotruncal anomaly face syndrome",
        "thymic hypoplasia",
        "velocardiofacial syndrome" ;
    skos:definition "Condition caused by the deletion of a small piece of chromosome 22 near the middle of the chromosome at a location designated 22q11.2." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DiGeorge syndrome" .

goldbook:10604 a skos:Concept ;
    skos:definition "Dome-shaped muscular membranous partition separating the thoracic cavity from the abdominal cavity in mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diaphragm" .

goldbook:10605 a skos:Concept ;
    skos:definition "Hereditary predisposition to a particular medical condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diathesis" .

goldbook:10606 a skos:Concept ;
    skos:definition "Posterior part of the forebrain (prosencephalon), containing the hypothalamus and other thalamic components and enclosing the third ventricle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diencephalon" .

goldbook:10607 a skos:Concept ;
    skos:altLabel "4,4′-[(3<em>E</em>)-hex-3-ene-3,4-diyl]diphenol",
        "DES" ;
    skos:definition "Synthetic nonsteroidal substance with estrogenic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diethylstilbestrol" .

goldbook:10608 a skos:Concept ;
    skos:definition "Cell or nucleus containing two complete sets of chromosomes, one from each parent, or an organism composed of such cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diploid" .

goldbook:10609 a skos:Concept ;
    skos:altLabel "blastodisc",
        "germinal disc" ;
    skos:definition "Bilayer plate of cells in the blastocyst from which the mammalian embryo develops." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryonic disc" .

goldbook:10610 a skos:Concept ;
    skos:definition "Entrance of two spermatozoa into one egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispermy" .

goldbook:10611 a skos:Concept ;
    skos:definition "Disturbance that interrupts a process or disorganizes a structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disruption" .

goldbook:10612 a skos:Concept ;
    skos:definition "Situated away from the centre of the body or from the point of attachment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distal" .

goldbook:10613 a skos:Concept ;
    skos:definition "Outpouching of a hollow structure in the body, that may be acquired (as in colonic diverticulitis) or be present at birth (e.g., Meckel diverticulum or Zenker diverticulum)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diverticulum" .

goldbook:10614 a skos:Concept ;
    skos:definition "Of a gene, determining the phenotype even when present only in one copy or inherited from only one parent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dominant" .

goldbook:10615 a skos:Concept ;
    skos:definition "On or relating to the upper side or back of an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dorsal" .

goldbook:10616 a skos:Concept ;
    skos:altLabel "DME" ;
    skos:definition "Any enzyme that metabolizes xenobiotics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug metabolizing enzyme" .

goldbook:10617 a skos:Concept ;
    skos:definition "Vessel for transporting fluids such as lymph, or glandular secretions such as tears or bile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "duct" .

goldbook:10618 a skos:Concept ;
    skos:definition "Fetal blood vessel connecting the pulmonary artery to the proximal descending aorta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ductus arteriosis" .

goldbook:10619 a skos:Concept ;
    skos:altLabel "Dipterian dung fly test" ;
    skos:definition "Procedure using dung flies of the order Diptera where a test substance is mixed with bovine feces to which eggs of the fly are added; number, sex, and morphology are determined when the last adult has emerged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dung fly test" .

goldbook:10620 a skos:Concept ;
    skos:definition "First portion of the small intestine, between the stomach and the jejunum, where bile and pancreatic digestive juices enter the intestinal tract." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "duodenum" .

goldbook:10621 a skos:Concept ;
    skos:definition "Defective or abnormal development of an organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysgenesis" .

goldbook:10622 a skos:Concept ;
    skos:definition "Dysgenesis of the gonads." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysgonesis" .

goldbook:10623 a skos:Concept ;
    skos:definition "Difficult and painful menstruation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysmenorrhea" .

goldbook:10624 a skos:Concept ;
    skos:altLabel "dysmorphism" ;
    skos:definition "Abnormality of shape of a body part or organ, often referring to a birth defect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysmorphia" .

goldbook:10625 a skos:Concept ;
    skos:definition "Production of dysmorphia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysmorphogenesis" .

goldbook:10626 a skos:Concept ;
    skos:definition "Abnormal development of an organ or tissue identified by morphological examination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysplasia" .

goldbook:10627 a skos:Concept ;
    skos:definition "Defect in the normal ossification of fetal cartilage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysostosis" .

goldbook:10628 a skos:Concept ;
    skos:altLabel "ELS",
        "ELS test" ;
    skos:definition "Toxicity test using an organism in an early life stage such as the embryo or larva, noting that this stage is often the most sensitive part of the species life cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "early life stage test" .

goldbook:10629 a skos:Concept ;
    skos:definition "Procedure in which adult worms (Eisenia sp.) are exposed to a test substance mixed into the soil; number, weight and behaviour of the adult worms are studied after four weeks and the number of juveniles hatched is counted after a further four weeks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "earthworm reproduction test" .

goldbook:10630 a skos:Concept ;
    skos:definition "Acute, life-threatening complication of pregnancy characterized by tonic-clonic seizures (convulsions), usually in a woman who has developed pre-eclampsia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eclampsia" .

goldbook:10631 a skos:Concept ;
    skos:definition "Study of the influence of hereditary factors on the response of individuals or populations to environmental factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecogenetics" .

goldbook:10632 a skos:Concept ;
    skos:definition "In an embryo, outermost layer that develops into the epidermis of the skin and the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectoderm" .

goldbook:10633 a skos:Concept ;
    skos:altLabel "ectopy" ;
    skos:definition "Abnormal location or malpositioning of an organ or body part, usually congenital." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectopia" .

goldbook:10634 a skos:Concept ;
    skos:definition "Expression of a gene in a tissue in which it is not normally expressed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectopic expression" .

goldbook:10635 a skos:Concept ;
    skos:definition "Complication of pregnancy in which the embryo implants (see implantation) and develops outside the cavity of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectopic pregnancy" .

goldbook:10636 a skos:Concept ;
    skos:altLabel "cleft hand",
        "lobster-claw deformity",
        "split hand" ;
    skos:definition "Congenital absence or deficiency of one or more of the central digits of the hand or foot." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectrodactyly" .

goldbook:10637 a skos:Concept ;
    skos:definition "Congenital absence or deficiency of one or more of the central digits of the hand or foot with fusion of the existing ones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectrosyndactyly" .

goldbook:10638 a skos:Concept ;
    skos:altLabel "oedema" ;
    skos:definition "Presence of abnormally large amounts of fluid in body cavities and intercellular spaces of tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "edema" .

goldbook:10639 a skos:Concept ;
    skos:altLabel "efferent ductule",
        "male efferent duct" ;
    skos:definition "Seminal duct leading from the testis to the head of the epididymis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efferent duct" .

goldbook:10640 a skos:Concept ;
    skos:definition "Female gamete after completion of the second meiotic division." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "egg" .

goldbook:10641 a skos:Concept ;
    skos:definition "Expulsion of semen from the genital ducts and urethra, usually resulting from a reflex process during sexual stimulation" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ejaculation" .

goldbook:10642 a skos:Concept ;
    skos:definition "Passage formed by the junction of the duct of the seminal vesicles and the ductus deferens through which semen enters the urethra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ejaculatory duct" .

goldbook:10643 a skos:Concept ;
    skos:definition "Means of introducing molecules into cells by transiently permeabilizing their membranes with brief electric field pulses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroporation" .

goldbook:10644 a skos:Concept ;
    skos:definition "Development and growth of an embryo in the period from formation of the bilaminar embryo to the beginning of the fetal period (in humans, the second through the eighth week after conception)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryogenesis" .

goldbook:10645 a skos:Concept ;
    skos:definition "Structure resembling an embryo which is formed by embryonic stem cells or teratocarcinoma cells when they are removed from a growth-promoting medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryoid body" .

goldbook:10646 a skos:Concept ;
    skos:definition "Process whereby the development of one group of cells, called the competent region, is altered by an inducing factor from another group, called a signaling center or organizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryonic induction" .

goldbook:10647 a skos:Concept ;
    skos:definition "Process of implanting a fertilized ovum into a uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryo transfer" .

goldbook:10648 a skos:Concept ;
    skos:definition "Method to evaluate the potential for early embryonic loss in rodents caused by accelerated or retarded arrival of embryos into the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryo transport rate analysis" .

goldbook:10649 a skos:Concept ;
    skos:definition "Science of the origin and development of the organism from fertilization of the oocyte to the beginning of fetal life (in humans, the end of the eighth week)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryology" .

goldbook:10650 a skos:Concept ;
    skos:definition "Period from fertilization to the end of major organogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryonic period" .

goldbook:10651 a skos:Concept ;
    skos:altLabel "ES",
        "ES cell" ;
    skos:definition "Undifferentiated, pluripotent cell from an early stage of the pre-implantation embryo (inner cell mass of the blastocyst)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryonic stem cell" .

goldbook:10652 a skos:Concept ;
    skos:definition "Inflammation of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encephalitis" .

goldbook:10653 a skos:Concept ;
    skos:definition "Congenital protrusion of brain tissue through a fissure or defect in the skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encephalocele" .

goldbook:10654 a skos:Concept ;
    skos:altLabel "atrioventricular canal cushion" ;
    skos:definition "Subset of cells in the primordial tube-like heart that is essential to the development of the ventricular septum and the atrioventricular valves of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocardial cushion" .

goldbook:10655 a skos:Concept ;
    skos:definition "Endothelial lining of the heart chambers, also containing small blood vessels and a few bundles of smooth muscle, continuous with the endothelium of the great blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocardium" .

goldbook:10656 a skos:Concept ;
    skos:definition "Formation and growth of bone tissue (especially of the long bones) during fetal development of the mammalian skeletal system, and in repair of bone fractures, that takes place in the presence of cartilage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endochondral ossification" .

goldbook:10657 a skos:Concept ;
    skos:definition "Pertaining to hormones or to glands that secrete hormones directly into the bloodstream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocrine" .

goldbook:10658 a skos:Concept ;
    skos:altLabel "endocrine modifier" ;
    skos:definition "Exogenous substance that, at some dose, alters function(s) of the endocrine system and consequently causes adverse health effects in an intact organism, its progeny, or (sub)populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocrine disrupter" .

goldbook:10659 a skos:Concept ;
    skos:definition "Innermost of the three primary germ layers of an embryo, developing into the gastrointestinal tract, the lungs, and associated structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endoderm" .

goldbook:10660 a skos:Concept ;
    skos:definition "Inner lining of the uterus that is shed during menstruation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endometrium" .

goldbook:10661 a skos:Concept ;
    skos:definition "Layer of flat cells that line the blood vessels, lymphatic vessels, and the chambers of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endothelium" .

goldbook:10662 a skos:Concept ;
    skos:definition "Physical, chemical, or biological agent or condition in the environment that has the potential to affect development and health of an organism, either in a positive or a negative manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental factor" .

goldbook:10663 a skos:Concept ;
    skos:definition "Located above or on the dorsal side of an axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epaxial" .

goldbook:10664 a skos:Concept ;
    skos:definition "Primitive ectoderm of the early embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epiblast" .

goldbook:10665 a skos:Concept ;
    skos:altLabel "visceral pericardium" ;
    skos:definition "Inner layer of the pericardium, a sac of fibrous tissue that surrounds and lies upon the heart and the base of the great vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epicardium" .

goldbook:10666 a skos:Concept ;
    skos:definition "Study of the distribution and determinants of health-related states or events in specified populations and the application of this study for the control of health problems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epidemiology" .

goldbook:10667 a skos:Concept ;
    skos:definition "In vertebrates, protective outer stratified squamous layer of the skin consisting mainly of keratinocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epidermis" .

goldbook:10668 a skos:Concept ;
    skos:definition "Tightly-coiled, thin-walled tube that conducts sperm from the testis to the vas deferens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epididymis" .

goldbook:10669 a skos:Concept ;
    skos:altLabel "appendix epididymidis" ;
    skos:definition "Cystic structure sometimes found on the head of the epididymis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epididymal appendix" .

goldbook:10670 a skos:Concept ;
    skos:definition "Chronic neurological disorder marked by sudden recurrent episodes of sensory disturbance, loss of consciousness, or convulsions, associated with abnormal electrical activity in the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epilepsy" .

goldbook:10671 a skos:Concept ;
    skos:definition "The disk of hyaline cartilage between the metaphysis and the epiphysis of an immature long bone that permits the bone to grow longer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epiphyseal plate" .

goldbook:10672 a skos:Concept ;
    skos:definition "Malformation in which the urethra does not develop to full length, opening typically on the dorsum of the penis (and rarely, in females, between the clitoris and labia); frequently associated with exstrophy of the bladder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epispadias" .

goldbook:10673 a skos:Concept ;
    skos:definition "Situation in which the phenotypic expression of one gene obscures the phenotypic effects of another gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epistasis" .

goldbook:10674 a skos:Concept ;
    skos:definition "Sheet of one or more layers of cells covering the internal and external surfaces of the body and hollow organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epithelium" .

goldbook:10675 a skos:Concept ;
    skos:altLabel "EMT" ;
    skos:definition "Sequence of events, where epithelial cells detach, migrate, and become mesenchymal stem cells that can differentiate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epithelial-to-mesenchymal transition" .

goldbook:10676 a skos:Concept ;
    skos:altLabel "epoxide hydratase" ;
    skos:definition "Detoxification enzyme (EC 3.3.2.9), located mainly in the endoplasmic reticulum, that hydrolyzes epoxides, converting them to metabolites that can be more rapidly excreted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epoxide hydrolase" .

goldbook:10677 a skos:Concept ;
    skos:definition "Inability of a male to have or to maintain an erection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erectile dysfunction" .

goldbook:10678 a skos:Concept ;
    skos:altLabel "17β-estradiol" ;
    skos:definition "Steroid sex hormone, involved in many regulatory processes, but most prominently in the development of female sex organs, the menstrual cycle, and pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estradiol" .

goldbook:10679 a skos:Concept ;
    skos:definition "Hormonally active metabolite of estradiol, eliminated in urine, especially during pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estriol" .

goldbook:10680 a skos:Concept ;
    skos:definition "Any substance, natural or synthetic, that exerts the hormonal effects of the natural estrogen, estradiol, usually by interaction with the estrogen receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estrogen" .

goldbook:10681 a skos:Concept ;
    skos:definition "Procedure in which a tumor cell line is exposed to a test substance and activation of the estrogen receptor is studied by a reporter molecule in order to assess the estrogen-sensitivity of the tumor. Test using estrogen-sensitive cells to evaluate estrogenic activity of a substance or environmental sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>in vitro</em> estrogen activity assay" .

goldbook:10682 a skos:Concept ;
    skos:definition "Behaving like an estrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estrogen-mimetic" .

goldbook:10683 a skos:Concept ;
    skos:definition "Exhibiting hormonal activity similar to that of estrogens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estrogenic" .

goldbook:10684 a skos:Concept ;
    skos:definition "Sequence of recurring physiological uterine, ovarian, and other changes, induced by reproductive hormones in higher female animals, resulting in readiness for insemination. This cycle starts in adulthood (at menarche), transiently discontinues during pregnancy, and disappears at the menopause." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estrous cycle" .

goldbook:10685 a skos:Concept ;
    skos:altLabel "heat",
        "oestrus" ;
    skos:definition "Recurrent period of sexual receptivity and arousal in the female of most mammals except the higher primates, during which conception is possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estrus" .

goldbook:10686 a skos:Concept ;
    skos:definition "Persistent estrus caused by elevated estrogenic activity, either due to endogenous estrogens (e.g., in polycystic ovary syndrome) or due to exogenous substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estrus syndrome" .

goldbook:10687 a skos:Concept ;
    skos:definition "Referring to a cell or organism with chromosomes present in an integral multiple of the haploid number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "euploid" .

goldbook:10688 a skos:Concept ;
    skos:definition "Subclass of mammals having a placenta through which the fetus is nourished." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutherian" .

goldbook:10689 a skos:Concept ;
    skos:altLabel "herniation of intestines" ;
    skos:definition "Protrusion of omentum and/or intestine through a defect or weakness in the abdominal wall while the skin remains intact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eventration" .

goldbook:10690 a skos:Concept ;
    skos:definition "Specific induction of a tissue within a developing embryo that results from the action of a single hormone or other chemical (the evocator)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evocation" .

goldbook:10691 a skos:Concept ;
    skos:definition "Pertaining to a vessel (or opening) conveying fluid outwards." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excurrent" .

goldbook:10692 a skos:Concept ;
    skos:altLabel "exencephalus" ;
    skos:definition "Exposed brain resulting from failure of the neural tube to close and absence of the top of the skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exencephaly" .

goldbook:10693 a skos:Concept ;
    skos:definition "Relating to or denoting glands that secrete through ducts opening on to superficial epithelium (e.g., the intestinal tract) rather than into the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exocrine" .

goldbook:10694 a skos:Concept ;
    skos:altLabel "omphalocele" ;
    skos:definition "Hernia in which bowel or omentum protrudes through the abdominal wall under the skin at the umbilicus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exomphalos" .

goldbook:10695 a skos:Concept ;
    skos:altLabel "exophthalmos" ;
    skos:definition "Marked protrusion of the eyeballs, usually resulting from an increased volume of the orbital contents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exophthalmia" .

goldbook:10696 a skos:Concept ;
    skos:altLabel "EST" ;
    skos:definition "Partial or full complementary DNA sequence that can serve as a marker for a region of the genome that encodes an expressed product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "expressed sequence tag" .

goldbook:10697 a skos:Concept ;
    skos:definition "Congenital malformation in which a hollow organ has its interior exposed through eversion; most commonly observed in the urinary bladder (ectopia vesicae)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exstrophy" .

goldbook:10698 a skos:Concept ;
    skos:definition "Genitalia visible outside the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external genitalia" .

goldbook:10699 a skos:Concept ;
    skos:altLabel "ECM" ;
    skos:definition "Mesh of molecules, secreted by cells into the surrounding extracellular space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extracellular matrix" .

goldbook:10700 a skos:Concept ;
    skos:definition "One of the membranes that surrounds the embryo, which include the yolk sac, allantois, amnion, and chorion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraembryonic membrane" .

goldbook:10701 a skos:Concept ;
    skos:definition "Cells outside the embryo that, although derived from the zygote, are not part of the embryo proper and contribute to the fetal membranes (yolk sac, allantois, amnion, and chorion)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraembryonic mesoderm" .

goldbook:10702 a skos:Concept ;
    skos:definition "Apoptotic pathway of cell death initiated upon occupancy of so-called death receptors at the cell surface with their ligands, such as Fas/CD95 and tumor necrosis factor-\\(\\upalpha\\), and involving activation of caspase 8." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrinsic pathway" .

goldbook:10703 a skos:Concept ;
    skos:definition "Indicating ‘first filial’ generation, denoting offspring from genotypically (see genotype) distinct parents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "F1 generation" .

goldbook:10704 a skos:Concept ;
    skos:definition "Congenital anomaly resulting from the failure of facial structures in the embryo to fuse properly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "facial cleft" .

goldbook:10705 a skos:Concept ;
    skos:definition "In medicine, facial expression of an individual that is typical of a particular syndrome, disease, or condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "facies" .

goldbook:10706 a skos:Concept ;
    skos:altLabel "oviduct",
        "salpinx",
        "uterine tube" ;
    skos:definition "One of a pair of tubes, on either side of the upper or outer extremity of the ovary, that provides a path by which an ovum travels from the ovary to the fundus of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fallopian tube" .

goldbook:10707 a skos:Concept ;
    skos:altLabel "impregnation" ;
    skos:definition "Process of fertilization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fecundation" .

goldbook:10708 a skos:Concept ;
    skos:definition "Ability to produce offspring within a given period of time. Quantity of reproductive output." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fecundity" .

goldbook:10709 a skos:Concept ;
    skos:definition "Development of female characteristics as part of normal female maturation, or, in a male, pathologically as a result of endocrine imbalance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "feminization" .

goldbook:10710 a skos:Concept ;
    skos:definition "Ability to conceive (see conception). Production of live offspring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "female fertility" .

goldbook:10711 a skos:Concept ;
    skos:definition "Ability to induce conception." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "male fertility" .

goldbook:10712 a skos:Concept ;
    skos:altLabel "FACB",
        "Reproductive Assessment by Continuous Breeding (RACB)" ;
    skos:definition "Reproductive toxicity test in rodents in which female animals are repeatedly mated and frequency and size of litter and other parameters are measured; second or later generation fertility is also studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fertility Assessment by Continuous Breeding" .

goldbook:10713 a skos:Concept ;
    skos:definition "In reproductive biology, union of male and female gametes to form a zygote from which an embryo can develop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fertilization" .

goldbook:10714 a skos:Concept ;
    skos:altLabel "FAS" ;
    skos:definition "Condition developing in the fetus and resulting in congenital abnormalities, caused by alcohol intake by the mother during pregnancy, typically characterized by decreased cognitive development, stunted growth and a characteristic facies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetal alcohol syndrome" .

goldbook:10715 a skos:Concept ;
    skos:definition "Thickening on the margin of the yolk sac of a fetus during pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetal pole" .

goldbook:10716 a skos:Concept ;
    skos:altLabel "frog embryo teratogenesis assay <em>Xenopus</em>",
        "frog embryo teratogenesis assay Xenopus" ;
    skos:definition "Assay for teratogenicity using embryos of the frog, Xenopus laevis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "FETAX" .

goldbook:10717 a skos:Concept ;
    skos:definition "Procedure in which a fetus may be directly observed in utero, using a fiber-optic endoscope (fetoscope) introduced through a small incision in the abdomen under local anesthesia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetoscopy" .

goldbook:10718 a skos:Concept ;
    skos:definition "Young mammal within the uterus of the mother, from the visible completion of characteristic organogenesis until birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetus" .

goldbook:10719 a skos:Concept ;
    skos:altLabel "desmocyte",
        "fibrocyte" ;
    skos:definition "Flat fibrous tissue cell, with stellate or spindle shape, associated with the formation of collagen fibers and intercellular extracellular matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibroblast" .

goldbook:10720 a skos:Concept ;
    skos:altLabel "FGF" ;
    skos:definition "Any member of a family of more than twenty protein growth factors involved in angiogenesis, wound healing, and, in early embryonic development, induction of mesoderm, patterning and morphogenesis, and development of the limbs and brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibroblast growth factor" .

goldbook:10721 a skos:Concept ;
    skos:altLabel "FET",
        "fish embryo acute toxicity test" ;
    skos:definition "Procedure in which fish (often zebrafish, Danio rerio) eggs and embryos are exposed to a test chemical and subsequent development or death of the animals is studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fish embryo test" .

goldbook:10722 a skos:Concept ;
    skos:definition "Procedure in which sexually mature male and spawning female fish are exposed to a test substance and multiple endpoints, including egg production, endocrine activity, vitellogenin, and gonadal histopathology are measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fish reproduction assay" .

goldbook:10723 a skos:Concept ;
    skos:definition "Procedure in which fish are exposed from the time of fertilization of the egg until sexual differentiation is completed and markers of possible endocrine disruptor activity are studied, including vitellogenin concentration, gonadal histopathology, sex ratios, and the occurrence of intersex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fish sexual development test" .

goldbook:10724 a skos:Concept ;
    skos:definition "Permanent abnormal passage from an internal organ to the body surface or between two internal organs or structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fistula" .

goldbook:10725 a skos:Concept ;
    skos:definition "Ability to survive and reproduce." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fitness" .

goldbook:10726 a skos:Concept ;
    skos:altLabel "right colic flexure" ;
    skos:definition "Bend between the ascending colon and the transverse colon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hepatic flexure" .

goldbook:10727 a skos:Concept ;
    skos:definition "Alternative spelling of fetus found in British English usage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foetus" .

goldbook:10728 a skos:Concept ;
    skos:definition "Water-soluble B vitamin involved in breakdown of carbohydrates, releasing energy and promoting biosynthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "folic acid" .

goldbook:10729 a skos:Concept ;
    skos:definition "Small, secretory sac, such as the dental follicles that enclose the teeth before eruption or the hair follicles within the epidermis. Fluid- or colloid-filled ball of cells in some glands such as the thyroid gland and the ovaries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follicle" .

goldbook:10730 a skos:Concept ;
    skos:altLabel "FSH" ;
    skos:definition "Hormone secreted by the anterior pituitary that stimulates the Graafian follicles of the ovary and subsequent follicular maturation, and in the male contributes to inducing spermatogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follicle-stimulating hormone" .

goldbook:10731 a skos:Concept ;
    skos:altLabel "FSH-RH",
        "gonadoliberin" ;
    skos:definition "Hormone, released by the hypothalamus, inducing the secretion of follicle-stimulating hormone and luteinizing hormone by the pituitary gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follicle-stimulating hormone releasing hormone" .

goldbook:10732 a skos:Concept ;
    skos:definition "Degeneration and resorption of an ovarian follicle before it reaches maturity and ruptures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follicular atresia" .

goldbook:10733 a skos:Concept ;
    skos:definition "First half of the human menstrual cycle, during which one or more follicles in the ovary may mature, culminating in ovulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follicular phase" .

goldbook:10734 a skos:Concept ;
    skos:definition "Any of several soft spots in specific locations on the skull of the newborn where the bones have not yet fused and the brain is covered by skin and a tough membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fontanelle" .

goldbook:10735 a skos:Concept ;
    skos:altLabel "foramina" ;
    skos:definition "Opening, hole." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foramen" .

goldbook:10736 a skos:Concept ;
    skos:definition "Large foramen in the base of the skull, through which the spinal cord passes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foramen magnum" .

goldbook:10737 a skos:Concept ;
    skos:definition "In the fetal heart, opening that allows shunting of blood between the right and left atria and normally closes at birth. One of the larger foramina in the base of the skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foramen ovale" .

goldbook:10738 a skos:Concept ;
    skos:definition "Approach to genetic investigation in which the aim is to identify the gene that governs a particular function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forward genetics" .

goldbook:10739 a skos:Concept ;
    skos:definition "In anatomy, a depression or hollow, often in a bone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fossa" .

goldbook:10740 a skos:Concept ;
    skos:definition "Oval depression in the heart, on the lower part of the septum of the right atrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fossa ovalis" .

goldbook:10741 a skos:Concept ;
    skos:altLabel "FND",
        "Tessier cleft numbers 0/14",
        "frontonasal dysostosis",
        "frontonasal malformation",
        "median cleft face syndrome" ;
    skos:definition "Congenital malformation of the midface in which the nose has a flat, wide appearance, the eyes may be wide-set, and there is a groove of varying size, running down the middle of the face across the nose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frontonasal dysplasia" .

goldbook:10742 a skos:Concept ;
    skos:definition "Development and implementation of technologies to characterize the mechanisms through which genes and their products function and interact with each other and with the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional genomics" .

goldbook:10743 a skos:Concept ;
    skos:definition "Part of a hollow organ (e.g., the uterus) that is furthest from its opening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fundus" .

goldbook:10744 a skos:Concept ;
    skos:definition "Pear-shaped muscular sac underneath the liver that stores bile secreted by the liver before its release into the duodenum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gall bladder" .

goldbook:10745 a skos:Concept ;
    skos:definition "Reproductive cell (e.g., sperm or egg) containing a haploid set of chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gamete" .

goldbook:10746 a skos:Concept ;
    skos:altLabel "GIFT" ;
    skos:definition "Technique of assisted reproduction by placing eggs and sperm into a woman’s Fallopian tubes in order that fertilization may occur there." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gamete intrafallopian transfer" .

goldbook:10747 a skos:Concept ;
    skos:definition "Development of male or female gametes to maturity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gametogenesis" .

goldbook:10748 a skos:Concept ;
    skos:definition "Congenital defect characterized by a fissure in the anterior abdominal wall through which the small and (or) large intestine protrude." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastroschisis" .

goldbook:10749 a skos:Concept ;
    skos:definition "Embryonic stage that develops from two to three germ layers during gastrulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastrula" .

goldbook:10750 a skos:Concept ;
    skos:definition "Stage of embryo development in which the two-layered blastula transforms into the gastrula by developing ectoderm and endoderm, as well as a third layer (mesoderm), through the movement of specific cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastrulation" .

goldbook:10751 a skos:Concept ;
    skos:definition "Both the messenger RNA resulting from transcription of a gene and the proteins and peptides translated from that mRNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene product" .

goldbook:10752 a skos:Concept ;
    skos:definition "Prevention of the expression of a specific gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene silencing" .

goldbook:10753 a skos:Concept ;
    skos:definition "Use of homologous recombination to change a gene, e.g., to delete a gene, remove exons, add a gene, or introduce point mutations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene targeting" .

goldbook:10754 a skos:Concept ;
    skos:definition "Of or relating to human or animal reproduction. Of or relating to the genital organs. Of or relating to the final stage of psychosexual maturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genital" .

goldbook:10755 a skos:Concept ;
    skos:definition "Plural of genital. Externally visible sex organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genitalia" .

goldbook:10756 a skos:Concept ;
    skos:altLabel "genital ridge",
        "genitourinary ridge",
        "labioscrotal swelling",
        "urogenital ridge" ;
    skos:definition "Embryonic structure that will develop into the penis and scrotum in males or the labia in females." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genital fold" .

goldbook:10757 a skos:Concept ;
    skos:definition "Organ of reproduction or generation, both external and internal to the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genital organ" .

goldbook:10758 a skos:Concept ;
    skos:altLabel "genital duct",
        "reproductive tract" ;
    skos:definition "Genital passages of the urogenital apparatus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genital tract" .

goldbook:10759 a skos:Concept ;
    skos:definition "Primordium of the penis or clitoris." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genital tubercle" .

goldbook:10760 a skos:Concept ;
    skos:definition "Capable of causing a change to the structure of the genome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genotoxic" .

goldbook:10761 a skos:Concept ;
    skos:definition "Procedure in which mutations induced by an agent are studied in germ line cells or somatic stem cells from a transgenic animal (rodent), containing reporter genes for detection of various mutations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germ cell gene mutation assay" .

goldbook:10762 a skos:Concept ;
    skos:altLabel "germ cell" ;
    skos:definition "Gamete or an embryonic cell that can develop into a gamete." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germ line cell" .

goldbook:10763 a skos:Concept ;
    skos:definition "Any of three distinct layers of cells (endoderm, ectoderm, and mesoderm) that become recognizable as the embryo develops." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germ layer" .

goldbook:10764 a skos:Concept ;
    skos:altLabel "pregnancy" ;
    skos:definition "Period between conception and birth during which an embryo or fetus is carried in the uterus of a female mammal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gestation" .

goldbook:10765 a skos:Concept ;
    skos:definition "Time from conception to birth, during which a fetus develops." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gestation period" .

goldbook:10766 a skos:Concept ;
    skos:definition "Condition of abnormal size or overgrowth of the entire body or of any of its parts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gigantism" .

goldbook:10767 a skos:Concept ;
    skos:definition "Organized aggregation of cells functioning as a secretory or excretory organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gland" .

goldbook:10768 a skos:Concept ;
    skos:definition "Any small rounded mass or gland-like body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glans" .

goldbook:10769 a skos:Concept ;
    skos:definition "Rounded mass of sensitive erectile tissue that forms the head of the clitoris." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glans clitoridis" .

goldbook:10770 a skos:Concept ;
    skos:definition "Rounded mass of sensitive erectile tissue at the distal end (head) of the penis, analogous to the glans clitoridis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glans penis" .

goldbook:10771 a skos:Concept ;
    skos:definition "Disease of the eye characterized by increased intraocular pressure, resulting in atrophy of the optic nerve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glaucoma" .

goldbook:10772 a skos:Concept ;
    skos:definition "Tuft or a cluster, as of a plexus of capillary blood vessels or nerve fibers (e.g., capillaries of the filtration apparatus of the kidney)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glomerulus" .

goldbook:10773 a skos:Concept ;
    skos:definition "Any of a group of steroid hormones, such as cortisone, produced by the adrenal cortex, inhibiting inflammation, and mediating a response to stress that alters protein, fat, and carbohydrate metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glucocorticoid" .

goldbook:10774 a skos:Concept ;
    skos:definition "Biochemical breakdown of glucose into pyruvic acid with the production of ATP." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycolysis" .

goldbook:10775 a skos:Concept ;
    skos:definition "Organ in animals that produces gametes, i.e., the testis or the ovary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gonad" .

goldbook:10776 a skos:Concept ;
    skos:altLabel "gonadotrophin" ;
    skos:definition "Glycopeptide hormone, produced by the fetal placenta, that maintains the function of the corpus luteum during the first few weeks of pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gonadotropin" .

goldbook:10777 a skos:Concept ;
    skos:altLabel "gonadoliberin",
        "luteinizing hormone-releasing hormone (LHRH)" ;
    skos:definition "Any factor from the hypothalamus that stimulates the anterior pituitary to release both follicle-stimulating hormone and luteinizing hormone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gonadotropin-releasing hormone" .

goldbook:10778 a skos:Concept ;
    skos:altLabel "vesicular ovarian follicle" ;
    skos:definition "Mature ovarian follicle within which an oocyte attains full size and which ruptures during ovulation to release the ovum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Graafian follicle" .

goldbook:10779 a skos:Concept ;
    skos:definition "White blood cell, distinct from a lymphocyte, containing cytoplasmic granules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granulocyte" .

goldbook:10780 a skos:Concept ;
    skos:definition "Pertaining to cells of the cumulus oophorus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granulosa" .

goldbook:10781 a skos:Concept ;
    skos:definition "Regions of the brain and spinal cord that are made up primarily of cell bodies and dendrites of nerve cells rather than of myelinated axons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grey matter" .

goldbook:10782 a skos:Concept ;
    skos:definition "Naturally occurring or genetically engineered protein or steroid hormone that binds to a receptor to regulate cell growth, proliferation, or differentiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth factor" .

goldbook:10783 a skos:Concept ;
    skos:altLabel "GH",
        "somatotropic hormone (STH)",
        "somatotropin" ;
    skos:definition "Peptide hormone secreted by the anterior pituitary that stimulates growth, energy metabolism, and cell proliferation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth hormone" .

goldbook:10784 a skos:Concept ;
    skos:altLabel "GHRF" ;
    skos:definition "Substance produced in the hypothalamus that regulates release of growth hormone by the anterior pituitary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth hormone releasing factor" .

goldbook:10785 a skos:Concept ;
    skos:definition "Fetal mesenchyme ligament that passes through the anterior abdominal wall and connects the lower pole of each developing gonad with the developing scrotum in men, and with the developing labia majora in women." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gubernaculum" .

goldbook:10786 a skos:Concept ;
    skos:altLabel "monoploid" ;
    skos:definition "State in which a cell contains only one set of chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haploid" .

goldbook:10787 a skos:Concept ;
    skos:definition "Pertaining to blood or blood vessels. Situated, in common with the heart and major blood vessels, on the ventral side of the body with respect to the vertebral column or its embryonic precursors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemal" .

goldbook:10788 a skos:Concept ;
    skos:definition "Benign tumor formed by a vascular malformation present at birth or developing during life, in which proliferation of blood vessels leads to a vascular tangle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemangioma" .

goldbook:10789 a skos:Concept ;
    skos:altLabel "hemopoiesis" ;
    skos:definition "Development of each of the types of blood cell from common precursor cells, located mainly in the bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hematopoiesis" .

goldbook:10790 a skos:Concept ;
    skos:definition "Congenital partial absence of all or part of the distal half of a limb." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemimelia" .

goldbook:10791 a skos:Concept ;
    skos:definition "Congenital defect of the vertebral column in which one side of a vertebra fails to develop completely due to failure of the chondrification center to form on that side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemivertebra" .

goldbook:10792 a skos:Concept ;
    skos:altLabel "erythroblastosis",
        "erythroblastosis fetalis" ;
    skos:definition "Severe form of anemia in a fetus or newborn infant caused by incompatibility with the mother’s blood type, typically when the mother is rhesus factor negative (Rh -ve) and produces antibodies which attack (Rh +ve) fetal blood through the placenta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemolytic disease of the newborn" .

goldbook:10793 a skos:Concept ;
    skos:definition "Enlargement of the liver and spleen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hepatosplenomegaly" .

goldbook:10794 a skos:Concept ;
    skos:definition "Having the reproductive organs and many of the secondary sex characteristics of both sexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hermaphrodite" .

goldbook:10795 a skos:Concept ;
    skos:definition "State of being hermaphrodite." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hermaphroditism" .

goldbook:10796 a skos:Concept ;
    skos:definition "Protrusion of an organ or structure through an abnormal opening in connective tissue or in the muscle wall of the cavity in which it is normally enclosed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hernia" .

goldbook:10797 a skos:Concept ;
    skos:altLabel "hiatus hernia" ;
    skos:definition "Hernia of a part of the stomach through a rupture of the diaphragm at the esophageal opening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hiatal hernia" .

goldbook:10798 a skos:Concept ;
    skos:definition "Family of viruses including herpes simplex types 1 and 2, and herpes zoster (also called varicella zoster)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "herpes" .

goldbook:10799 a skos:Concept ;
    skos:definition "Short-term in vivo procedure in which the androgenic or antiandrogenic effects of a test substance are studied in castrated, peripubertal male rodents, as indicated by changes in the weights of androgen-dependent tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hershberger bioassay" .

goldbook:10800 a skos:Concept ;
    skos:definition "Structural component of the limbic system of the vertebrate brain involved in short-term and long-term memory and spatial navigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hippocampus" .

goldbook:10801 a skos:Concept ;
    skos:altLabel "aganglionic megacolon",
        "congenital aganglionic megacolon" ;
    skos:definition "Absence of nerve ganglia throughout all or part of the gastrointestinal tract, causing dysregulation of intestinal motility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hirschsprung syndrome" .

goldbook:10802 a skos:Concept ;
    skos:altLabel "hypertrichosis" ;
    skos:definition "Presence of excessive bodily and facial hair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hirsutism" .

goldbook:10803 a skos:Concept ;
    skos:altLabel "arhinencephaly" ;
    skos:definition "Birth defect in which the embryonic forebrain fails to divide completely to form the cerebral hemispheres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "holoprosencephaly" .

goldbook:10804 a skos:Concept ;
    skos:definition "Any of a class of closely similar DNA sequences occurring in various genes and involved in regulating pattern formation, segmentation, and morphogenesis during embryonic development in many species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homeobox" .

goldbook:10805 a skos:Concept ;
    skos:definition "Gene containing a homeobox sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homeobox gene" .

goldbook:10806 a skos:Concept ;
    skos:definition "Replacement of part of one segment of an insect or other segmented animal by a structure characteristic of a different segment, especially through mutation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homeosis" .

goldbook:10807 a skos:Concept ;
    skos:definition "Having the same relationship, relative position, or structure. (Of organs) Similar in position, structure, and evolutionary origin but not necessarily in function. (Of chromosomes) Pairing at meiosis and having the same structural features and pattern of genes. (Of a series of chemical compounds) Having the same functional group(s) but differing in structure by a fixed group of atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homologous" .

goldbook:10808 a skos:Concept ;
    skos:definition "Crossing over between two similar or identical strands of DNA, resulting in exchange of corresponding stretches of DNA between two sister chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homologous recombination" .

goldbook:10809 a skos:Concept ;
    skos:definition "Procedure in which larvae of the honey bee (Apis mellifera) are exposed to a test chemical in the diet and subsequent mortality is recorded daily up to the \\(\\pu{72\\!\\!{-}\\!h}\\) \\(\\pu{LD_{50}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "honey bee larval toxicity test" .

goldbook:10810 a skos:Concept ;
    skos:definition "Substance formed in one organ or part of the body and carried in the blood to another organ or part where it selectively alters functional activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hormone" .

goldbook:10811 a skos:Concept ;
    skos:altLabel "HGP" ;
    skos:definition "International research project that started in 1990 with the goal of determining the base-pair sequence of the human genome. The project was declared complete in 2003." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Human Genome Project" .

goldbook:10812 a skos:Concept ;
    skos:definition "Vesicular or polycystic mass resulting from the proliferation of the trophoblast, with hydropic degeneration and avascularity of the chorionic villi." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydatidiform mole" .

goldbook:10813 a skos:Concept ;
    skos:definition "Rare condition in which the brain’s cerebral hemispheres are replaced by sacs filled with cerebrospinal fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydranencephaly" .

goldbook:10814 a skos:Concept ;
    skos:definition "Accumulation of serous fluid in a sacculated cavity; specifically, such an accumulation in the space of the tunica vaginalis testis, or in a separate pocket along the spermatic cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocele" .

goldbook:10815 a skos:Concept ;
    skos:definition "Accumulation of excess cerebrospinal fluid within the ventricles of the brain; head enlargement and brain damage may occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocephalus" .

goldbook:10816 a skos:Concept ;
    skos:definition "Microcephaly with excess cerebrospinal fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydromicrocephaly" .

goldbook:10817 a skos:Concept ;
    skos:definition "Swelling of the funnel-shaped part of the kidney, where urine is collected to enter the ureter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydronephrosis" .

goldbook:10818 a skos:Concept ;
    skos:definition "Gross edema of the entire body, with severe anemia, occurring in hemolytic disease of the newborn." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrops" .

goldbook:10819 a skos:Concept ;
    skos:altLabel "ureterectasia" ;
    skos:definition "Dilation of a ureter with fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydroureter" .

goldbook:10820 a skos:Concept ;
    skos:altLabel "hydroma" ;
    skos:definition "Accumulation of fluid in a sac, cyst, or bursa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hygroma" .

goldbook:10821 a skos:Concept ;
    skos:definition "Thin, membranous fold of highly variable appearance that, before its rupture, partly occludes the opening of the vagina." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hymen" .

goldbook:10822 a skos:Concept ;
    skos:definition "Second pharyngeal or branchial arch of the developing embryo, from which different tissues around the neck, ear, and face will develop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyoid arch" .

goldbook:10823 a skos:Concept ;
    skos:definition "Ventral to the long axis of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypaxial" .

goldbook:10824 a skos:Concept ;
    skos:definition "Extension of a limb or part of a limb beyond the normal limit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperextension" .

goldbook:10825 a skos:Concept ;
    skos:definition "Flexion of a limb or part of a limb beyond the normal limit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperflexion" .

goldbook:10826 a skos:Concept ;
    skos:definition "Abnormal multiplication or increase in the number of normal cells in a tissue or organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperplasia" .

goldbook:10827 a skos:Concept ;
    skos:definition "Abnormally wide space between two organs, especially referring to the eyes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypertelorism" .

goldbook:10828 a skos:Concept ;
    skos:definition "Enlargement of an organ or tissue as a result of the increase in the size of its cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypertrophy" .

goldbook:10829 a skos:Concept ;
    skos:definition "Innermost of the three primary germ layers, adjacent to the blastocyst cavity, that develops into the endoderm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypoblast" .

goldbook:10830 a skos:Concept ;
    skos:definition "Inadequate functioning of the testes or ovaries as manifested by deficiencies in gametogenesis or in secretion of gonadal hormones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypogonadism" .

goldbook:10831 a skos:Concept ;
    skos:definition "Underdevelopment or atrophy of a tissue or organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypoplasia" .

goldbook:10832 a skos:Concept ;
    skos:definition "Birth defect in which the urethra opens on the underside of the penis, or into the vagina." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypospadias" .

goldbook:10833 a skos:Concept ;
    skos:definition "Region at the base of the brain containing specialized nerve cells that help activate, control, and integrate peripheral autonomic mechanisms, endocrine activities, and some somatic functions such as body temperature, sleep, and appetite." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypothalamus" .

goldbook:10834 a skos:Concept ;
    skos:definition "Abnormally low dioxygen content or tension. Deficiency of dioxygen in the inspired air, in blood, or in tissues, short of anoxia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypoxia" .

goldbook:10835 a skos:Concept ;
    skos:altLabel "fish-scale disease",
        "fish-skin disease",
        "xeroderma" ;
    skos:definition "Congenital disorder of keratinization, characterized by dryness and scaling of the skin, often associated with other defects and with abnormalities of lipid metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ichthyosis" .

goldbook:10836 a skos:Concept ;
    skos:altLabel "monozygotic twins" ;
    skos:definition "Twins resulting from one zygote that, at an early stage of embryonic development, separated into two independently growing cell aggregations giving rise to two individuals of the same sex and identical genetic constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "identical twins" .

goldbook:10837 a skos:Concept ;
    skos:definition "Relating to the ileum and the cecum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ileocecal" .

goldbook:10838 a skos:Concept ;
    skos:definition "Third portion of the small intestine, between the jejunum and the cecum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ileum" .

goldbook:10839 a skos:Concept ;
    skos:altLabel "hypogastric artery" ;
    skos:definition "Main artery of the pelvis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iliac artery" .

goldbook:10840 a skos:Concept ;
    skos:altLabel "anal atresia" ;
    skos:definition "Congenital absence of an anal opening due to the persistence of epithelial plug (persistence of the anal membrane) or to complete absence of the anal canal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imperforate anus" .

goldbook:10841 a skos:Concept ;
    skos:altLabel "nidation" ;
    skos:definition "Embedding of the early embryo in the lining of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "implantation" .

goldbook:10842 a skos:Concept ;
    skos:definition "Pseudohermaphroditic condition in female gastropods (snails) manifested by the development (imposition) of male characteristics such as a penis or vas deferens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imposex" .

goldbook:10843 a skos:Concept ;
    skos:definition "Differential expression of a gene, depending on whether it was transmitted through the sperm or the egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imprinting" .

goldbook:10844 a skos:Concept ;
    skos:definition "Strain of an animal that has been inbred by brother-sister matings for more than \\(\\pu{20}\\) generations, and consequently all the individuals of the strain are more than \\(\\pu{98\\%}\\) genetically identical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inbred strain" .

goldbook:10845 a skos:Concept ;
    skos:definition "In rodents, number of pregnant females divided by the number of females mated, multiplied by 100." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "female fertility index" .

goldbook:10846 a skos:Concept ;
    skos:definition "In rodents, number of females with live born offspring divided by number of females with evidence of pregnancy, multiplied by \\(\\pu{100}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gestation index" .

goldbook:10847 a skos:Concept ;
    skos:definition "In rodents, number of males impregnating females divided by number of males mated, multiplied by \\(\\pu{100}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "male fertility index" .

goldbook:10848 a skos:Concept ;
    skos:definition "Percentage of seminiferous tubules containing identifiable spermatogonia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tubular fertility index" .

goldbook:10849 a skos:Concept ;
    skos:altLabel "iPS",
        "iPS cell" ;
    skos:definition "Pluripotent stem cell that is generated from an adult cell by genetic reprogramming." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "induced pluripotent stem cell" .

goldbook:10850 a skos:Concept ;
    skos:altLabel "barrenness",
        "infecundity",
        "sterility" ;
    skos:definition "Persistent inability of either a male or a female to achieve conception or to produce offspring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infertility" .

goldbook:10851 a skos:Concept ;
    skos:definition "Anatomical funnel-shaped opening, often referring to the hollow stalk that connects the hypothalamus and the posterior pituitary gland, or to the portion of the Fallopian tube that receives the ovum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infundibulum" .

goldbook:10852 a skos:Concept ;
    skos:definition "Passage in the lower anterior abdominal wall, which in men conveys the spermatic cord and in women the round ligament of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inguinal canal" .

goldbook:10853 a skos:Concept ;
    skos:definition "Any of a group of peptide hormones secreted by the follicular granulosa cells of the ovary and the Sertoli cells of the testis, inhibiting follicle-stimulating hormone secretion by the anterior pituitary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibin" .

goldbook:10854 a skos:Concept ;
    skos:definition "Malformation producing a cranial defect at the occiput, with the brain exposed, often combined with a cervical rachischisis and retroflexion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iniencephaly" .

goldbook:10855 a skos:Concept ;
    skos:definition "Twins conjoined at the occiput." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iniopagus" .

goldbook:10856 a skos:Concept ;
    skos:definition "Delivery of sperm into the female reproductive system for the purpose or with the result of causing pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insemination" .

goldbook:10857 a skos:Concept ;
    skos:definition "Any of a family of cell membrane glycoproteins that mediate cell-to-cell and cell-to-extracellular matrix interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integrin" .

goldbook:10858 a skos:Concept ;
    skos:altLabel "IF" ;
    skos:definition "Any of a group of fibrous proteins (including keratin fibres, neurofilaments, desmin, and vimentin) that make up part of the cytoskeleton of most eukaryotic cells; so named because, at about \\(\\pu{10 nm}\\) diameter, they are intermediate in thickness between actin filaments and microtubules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermediate filament" .

goldbook:10859 a skos:Concept ;
    skos:altLabel "intersex" ;
    skos:definition "Condition of having both male and female characteristics: thus, the state of being intermediate between the sexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intersexuality" .

goldbook:10860 a skos:Concept ;
    skos:altLabel "ICSI" ;
    skos:definition "Infertility treatment in which the sperm is injected through the membrane of the egg into its cytoplasm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intracytoplasmic sperm injection" .

goldbook:10861 a skos:Concept ;
    skos:definition "Creation of bone tissue during fetal development of jawed vertebrates, as well as during the healing of bone fractures; the tissue forms from mesenchymal stem cells residing in an extracellular matrix devoid of collagen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramembrous ossification" .

goldbook:10862 a skos:Concept ;
    skos:altLabel "in utero" ;
    skos:definition "Within the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrauterine" .

goldbook:10863 a skos:Concept ;
    skos:altLabel "IUGR",
        "intrauterine growth retardation" ;
    skos:definition "Subnormal, poor growth of the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrauterine growth restriction" .

goldbook:10864 a skos:Concept ;
    skos:definition "Apoptotic pathway of cell death initiated from within the cell by signals initiated by mitochondrial damage and (or) DNA damage, a defective cell cycle, detachment from the extracellular matrix, hypoxia, loss of cell survival factors, or other types of severe cell stress; characterized by the activation of caspase 9." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic pathway" .

goldbook:10865 a skos:Concept ;
    skos:definition "Rearrangement of a chromosome in which, after breakage at two points, a segment is reversed, resulting in a change in sequence of nucleotides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosomal inversion" .

goldbook:10866 a skos:Concept ;
    skos:altLabel "IVF" ;
    skos:definition "Fertilization outside the body, used as a treatment for infertility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>in vitro</em> fertilization" .

goldbook:10867 a skos:Concept ;
    skos:definition "Local deficiency of blood supply, and hence of dioxygen, to an organ or tissue, caused by constriction or obstruction of the blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ischemia" .

goldbook:10868 a skos:Concept ;
    skos:definition "Vitamin A-like medication (13-cis retinoic acid) used, among other things, for acne treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotretinoin" .

goldbook:10869 a skos:Concept ;
    skos:definition "Second part of the small intestine between the duodenum and ileum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "jejunum" .

goldbook:10870 a skos:Concept ;
    skos:definition "Dissolution of a cell nucleus, especially during mitosis and meiosis but also following necrosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "karyolysis" .

goldbook:10871 a skos:Concept ;
    skos:definition "Irreversible fragmentation of the nucleus of a dying cell following karyolysis, whereby its chromatin is distributed irregularly throughout the cytoplasm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "karyorrhexis" .

goldbook:10872 a skos:Concept ;
    skos:definition "Characterization of the number, form, and size of the chromosomes of an individual or a species. Photomicrograph of an individual’s chromosomes, arranged according to a standard classification for the species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "karyotype" .

goldbook:10873 a skos:Concept ;
    skos:definition "Fibrous protein forming the main structural constituent of hair, feathers, hoofs, claws, horns, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keratin" .

goldbook:10874 a skos:Concept ;
    skos:altLabel "cornification" ;
    skos:definition "Replacement of the outer epithelial layer of cells, especially in skin, with keratin-rich structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keratinization" .

goldbook:10875 a skos:Concept ;
    skos:definition "Acidosis, as in diabetes, pregnancy, or starvation, accompanied by the accumulation of ketone bodies in body tissues and fluids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketoacidosis" .

goldbook:10876 a skos:Concept ;
    skos:definition "Ketone that is an intermediate product of the breakdown of fats in the body; any of three compounds, acetoacetic acid, acetone, and (or) \\(\\upbeta\\)-hydroxybutanoic acid, found in excess in blood and urine of persons with metabolic disorders." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketone body" .

goldbook:10877 a skos:Concept ;
    skos:definition "Syndrome in males resulting from a genetic defect in which an extra female X chromosome (thus an XXY genotype) is present in a male, characterized by small testes, long legs, enlarged breasts, reduced sperm production, and mental retardation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Klinefelter syndrome" .

goldbook:10878 a skos:Concept ;
    skos:altLabel "null mutation" ;
    skos:definition "Mutation that leads to the loss of function of a particular gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "knockout mutation" .

goldbook:10879 a skos:Concept ;
    skos:altLabel "hunchback" ;
    skos:definition "Rearward curvature or convexity of the spine in excess of normal, resulting in a protuberant upper back." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kyphosis" .

goldbook:10880 a skos:Concept ;
    skos:definition "Physical efforts of expulsion of the fetus and the placenta from the uterus during birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "labor" .

goldbook:10881 a skos:Concept ;
    skos:definition "Secretion of milk from the mammary gland, usually to feed the infant during the neonatal period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactation" .

goldbook:10882 a skos:Concept ;
    skos:definition "Time following pregnancy during which the mammary glands secrete milk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactation period" .

goldbook:10883 a skos:Concept ;
    skos:definition "Layer of connective tissue, underlying the epithelium of a mucus membrane, containing capillaries and lymphatic vessels, as well as fibroblasts and cells of the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lamina propria" .

goldbook:10884 a skos:Concept ;
    skos:definition "Part of the respiratory tract between the pharynx and the trachea, having walls of cartilage and muscle and containing the vocal cords." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "larynx" .

goldbook:10885 a skos:Concept ;
    skos:definition "Disease caused by infection with the bacterium Mycobacterium leprae, often affecting the skin and nerves and causing body parts to become deformed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leprosy" .

goldbook:10886 a skos:Concept ;
    skos:definition "Malformation characterized by an abnormally tall, narrow cranium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leptocephaly" .

goldbook:10887 a skos:Concept ;
    skos:definition "Abnormally slender digits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leptodactyly" .

goldbook:10888 a skos:Concept ;
    skos:definition "Lack of pigmentation in the skin, hair, or feathers as a result of a failure of pigment cells to develop, or to migrate to those locations from their origin in the neural crest, in the embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leucism" .

goldbook:10889 a skos:Concept ;
    skos:definition "Abnormally low concentration of white cells (leukocytes) in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukopenia" .

goldbook:10890 a skos:Concept ;
    skos:definition "Normal position of the heart in the left hemithorax with the apex pointed to the left, and transposition of other viscera." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "levocardia" .

goldbook:10891 a skos:Concept ;
    skos:definition "Cell in the testis that produces androgens, mainly testosterone, in the presence of luteinizing hormone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Leydig cell" .

goldbook:10892 a skos:Concept ;
    skos:definition "Fibrous remnant of the ductus arteriosis linking the aortic arch and the top of the left pulmonary artery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligamentum arteriosum" .

goldbook:10893 a skos:Concept ;
    skos:altLabel "arm bud" ;
    skos:definition "Embryonic outgrowth of mesoderm covered in ectoderm that will give rise to one of the forelimbs or hindlimbs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limb bud" .

goldbook:10894 a skos:Concept ;
    skos:definition "Technique that studies patterns of heredity in high-risk families, in order to locate a disease-causing gene mutation by identifying co-inherited traits, usually by producing a LOD score." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linkage analysis" .

goldbook:10895 a skos:Concept ;
    skos:definition "Occurrence in members of a population of combinations of linked genes in non-random proportions, implying that the genes are close enough together on a chromosome to make it unlikely that they will be separated by recombination (see homologous recombination) during meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linkage disequilibrium" .

goldbook:10896 a skos:Concept ;
    skos:definition "Disorder of fat metabolism characterized by the accumulation of abnormal levels of certain lipids in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipidosis" .

goldbook:10897 a skos:Concept ;
    skos:definition "Multiple offspring produced by a mammal from one pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "litter" .

goldbook:10898 a skos:Concept ;
    skos:altLabel "loci" ;
    skos:definition "Specific location of a gene or DNA sequence on a chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "locus" .

goldbook:10899 a skos:Concept ;
    skos:altLabel "logarithm (base 10) of odds" ;
    skos:definition "Ratio of the likelihood of two or more loci remaining together when chromosomes recombine (true linkage) to the likelihood of this occurring by chance alone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "LOD score" .

goldbook:10900 a skos:Concept ;
    skos:definition "Forward (ventral) curvature of the spine in the lumbar and cervical regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lordosis" .

goldbook:10901 a skos:Concept ;
    skos:altLabel "spinal tap" ;
    skos:definition "Piercing into the subarachnoid space of the lumbar region in order to obtain spinal fluid for diagnostic purposes or to inject a drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lumbar puncture" .

goldbook:10902 a skos:Concept ;
    skos:altLabel "menstrual cycle" ;
    skos:definition "Phase of the human menstrual cycle, usually lasting \\(\\pu{14 days}\\), beginning with formation of the corpus luteum and ending, in the absence of fertilization, with the onset of menstruation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luteal phase" .

goldbook:10903 a skos:Concept ;
    skos:altLabel "LH" ;
    skos:definition "Hormone made by the pituitary gland that acts on the ovary to control egg maturation and to trigger ovulation. The same hormone acts in the testes to trigger production of testosterone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luteinizing hormone" .

goldbook:10904 a skos:Concept ;
    skos:definition "Relating to lymph or its secretion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphatic" .

goldbook:10905 a skos:Concept ;
    skos:definition "Relating to or denoting tissue responsible for producing lymphocytes and antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoid" .

goldbook:10906 a skos:Concept ;
    skos:altLabel "Lyon law",
        "X-inactivation",
        "lyonization" ;
    skos:definition "Hypothesis (named after Mary Lyon) that random inactivation of all but one X chromosome occurs in each female mammalian cell in early development, thus explaining why the effect of the X chromosome on phenotype is the same in males with one copy as in females with two copies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lyon hypothesis" .

goldbook:10907 a skos:Concept ;
    skos:definition "One of a group of rare inherited metabolic disorders resulting from a defect in lysosomal function, commonly a deficiency of enzymes required for the metabolism of lipids, glycoproteins, or mucopolysaccharides, resulting in their accumulation in the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lysosomal storage disease" .

goldbook:10908 a skos:Concept ;
    skos:altLabel "megacephaly",
        "megalocephaly" ;
    skos:definition "Congenital disorder characterized by an abnormally large head and (or) brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrocephaly" .

goldbook:10909 a skos:Concept ;
    skos:definition "Congenital disorder characterized by an abnormally enlarged tongue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroglossia" .

goldbook:10910 a skos:Concept ;
    skos:altLabel "megagnathia" ;
    skos:definition "Congenital disorder characterized by enlargement or elongation of the jaw." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrognathia" .

goldbook:10911 a skos:Concept ;
    skos:altLabel "megalomelia" ;
    skos:definition "Congenital disorder characterized by an abnormally large limb or limbs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromelia" .

goldbook:10912 a skos:Concept ;
    skos:definition "Congenital disorder characterized by an abnormally large body or body part." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrosomia" .

goldbook:10913 a skos:Concept ;
    skos:definition "Congenital disorder characterized by an abnormally large size of the mouth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrostomia" .

goldbook:10914 a skos:Concept ;
    skos:definition "Structural defect as a result of abnormal development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "malformation" .

goldbook:10915 a skos:Concept ;
    skos:definition "Occurring in a severe form, tending to become progressively worse, resistant to treatment, and likely to result in death. In cancer, cells showing both uncontrolled growth and a tendency to invade and destroy other tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "malignant" .

goldbook:10916 a skos:Concept ;
    skos:definition "Milk-producing organ in female mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mammary gland" .

goldbook:10917 a skos:Concept ;
    skos:definition "Congenital connective tissue disorder associated with mutation of the fibrillin-1 gene FBN1." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Marfan syndrome" .

goldbook:10918 a skos:Concept ;
    skos:definition "Development of male characteristics, such as facial hair, either as part of normal male maturation, or, pathologically, by people of either sex as a result of hormonal imbalance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "masculinization" .

goldbook:10919 a skos:Concept ;
    skos:altLabel "MSAFP" ;
    skos:definition "Protein made in the fetus that normally leaks, in small amounts, into the mother’s circulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maternal serum alpha-fetoprotein" .

goldbook:10920 a skos:Concept ;
    skos:definition "Relating to the maxilla (upper jaw)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maxillary" .

goldbook:10921 a skos:Concept ;
    skos:altLabel "ileal diverticulum" ;
    skos:definition "Congenital pouch in the ileum resulting from incomplete closure of the yolk sac." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Meckel diverticulum" .

goldbook:10922 a skos:Concept ;
    skos:definition "First intestinal discharges of the newborn infant, greenish in color and consisting of epithelial cells, mucus, and bile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meconium" .

goldbook:10923 a skos:Concept ;
    skos:altLabel "TC" ;
    skos:definition "Median concentration resulting in developmental malformations for \\(\\pu{50\\%}\\) of exposed test animals within a predetermined time, e.g., \\(\\pu{96 h}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median teratogenic concentration" .

goldbook:10924 a skos:Concept ;
    skos:definition "Region in the middle of the thorax between the two lungs, containing the regional vessels, trachea, esophagus, bronchi, lymph nodes, and heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mediastinum" .

goldbook:10925 a skos:Concept ;
    skos:definition "[medulla oblongata] Lower part of the brain stem continuous with the spinal cord, containing neural centers regulating the autonomic functions of breathing, heart rate, and blood pressure. Middle (central) part of an organ, as in adrenal medulla, renal medulla, or the medulla of a lymph node." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medulla" .

goldbook:10926 a skos:Concept ;
    skos:definition "Condition of extreme dilation of the colon that can be congenital (as in Hirschsprung disease) or acquired (as when children refuse to defecate)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "megacolon" .

goldbook:10927 a skos:Concept ;
    skos:altLabel "macrodactylia" ;
    skos:definition "Disorder characterized by an abnormally large fingers and (or) toes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "megadactyly" .

goldbook:10928 a skos:Concept ;
    skos:definition "First menstrual cycle of a woman." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "menarche" .

goldbook:10929 a skos:Concept ;
    skos:definition "Gene located in a chromosome that obeys the laws of Mendelian inheritance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mendelian gene" .

goldbook:10930 a skos:Concept ;
    skos:definition "Inheritance in which stable and indivisible characteristics are controlled entirely or overwhelmingly by a single genetic locus and transmitted over many generations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mendelian inheritance" .

goldbook:10931 a skos:Concept ;
    skos:definition "Phenotype that shows a pattern of Mendelian inheritance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mendelian trait" .

goldbook:10932 a skos:Concept ;
    skos:altLabel "meninges" ;
    skos:definition "Any of the three membranes (the dura mater, arachnoid, and pia mater) that line the skull and vertebral canal and enclose the brain and spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meninx" .

goldbook:10933 a skos:Concept ;
    skos:definition "Herniation of the membranes of the brain or spinal cord (see meninx) through a defect in the cranium or spinal column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meningocele" .

goldbook:10934 a skos:Concept ;
    skos:altLabel "meningoencephalocele" ;
    skos:definition "Birth defect following failure of the neural tube to close, resulting in protrusion of a sac of nerve tissue and its covering membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meningomyelocele" .

goldbook:10935 a skos:Concept ;
    skos:definition "Cessation of reproductive capability in a woman, marked by declining ovarian function and an end to menses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "menopause" .

goldbook:10936 a skos:Concept ;
    skos:definition "The period, normally lasting \\(\\pu{28 days}\\) in the human female, during which an ovum matures, is ovulated, and enters the uterus through the Fallopian tubes. If fertilization occurs, the cycle is interrupted by pregnancy; otherwise, the cycle ends with menstruation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "menstrual cycle" .

goldbook:10937 a skos:Concept ;
    skos:altLabel "menses" ;
    skos:definition "Cyclic endometrial shedding and discharge of a bloody fluid from the uterus during the menstrual cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "menstruation" .

goldbook:10938 a skos:Concept ;
    skos:definition "Congenital absence of a part of a limb, resulting in a shrunken and deformed extremity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meromelia" .

goldbook:10939 a skos:Concept ;
    skos:altLabel "ectomesenchyme" ;
    skos:definition "Embryonic migratory cells derived from the neural crest of the head that contribute to the formation of the meninges (see meninx) and become pigment cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesectoderm" .

goldbook:10940 a skos:Concept ;
    skos:altLabel "midbrain" ;
    skos:definition "Part of the vertebrate brain that develops from the middle section of the embryonic neural tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesencephalon" .

goldbook:10941 a skos:Concept ;
    skos:altLabel "MET" ;
    skos:definition "Process in which motile mesenchymal cells undergo a development to planar, polarized fixed cells, forming epithelia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesenchymal-to-epithelial transition" .

goldbook:10942 a skos:Concept ;
    skos:definition "Meshwork of embryonic connective tissue in the mesoderm, from which are formed the bone, muscular, and connective tissues of the body and also the urogenital system, blood vessels, and lymph vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesenchyme" .

goldbook:10943 a skos:Concept ;
    skos:definition "Membranous sheet attaching various organs to the body wall, especially the peritoneal fold attaching the intestine to the dorsal body wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesentery" .

goldbook:10944 a skos:Concept ;
    skos:altLabel "embryonic mesoderm" ;
    skos:definition "Middle layer of cells in the embryo, lying between the ectoderm and the endoderm. It includes the following tissues: Lateral mesoderm: peripheral portion of intraembryonic mesoderm. Intermediate mesoderm: origin of the nephrogenic cord. Parietal (somatic) mesoderm: cell source for the formation of the lateral and ventral body wall. Visceral (branchial, pharyngeal, splanchnic) mesoderm: inner layer of lateral mesoderm that, with the endoderm, provides the cells from which the gut and lungs and their coverings arise." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesoderm" .

goldbook:10945 a skos:Concept ;
    skos:definition "Part of the embryonic mesentery that is attached to the early stomach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesogastrium" .

goldbook:10946 a skos:Concept ;
    skos:altLabel "Wolffian duct" ;
    skos:definition "Embryonic duct of the mesonephros, which in the male becomes the vas deferens and in the female becomes vestigial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesonephric duct" .

goldbook:10947 a skos:Concept ;
    skos:definition "Middle part of the embryonic kidney in vertebrates, becoming the adult kidney in fishes and amphibians and the epididymis in reptiles, birds, and mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesonephros" .

goldbook:10948 a skos:Concept ;
    skos:definition "Single layer of flattened cells forming an epithelium that lines serous cavities such as the peritoneum, pleura, and pericardium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesothelium" .

goldbook:10949 a skos:Concept ;
    skos:definition "Morphogen, including bone morphogenetic protein, that affects metabolism and homeostasis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabologen" .

goldbook:10950 a skos:Concept ;
    skos:definition "One of a family of low-molecular mass proteins that binds metals such as zinc, copper, cadmium and mercury." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallothionein" .

goldbook:10951 a skos:Concept ;
    skos:definition "Primordium of the permanent kidney, developing later than, and caudal to, the mesonephros." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metanephros" .

goldbook:10952 a skos:Concept ;
    skos:definition "Stage of mitosis or meiosis in which the chromosomes become aligned on the equatorial plate of the cell, separating the centromeres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metaphase" .

goldbook:10953 a skos:Concept ;
    skos:definition "Abnormal transformation of an adult, fully differentiated tissue of one kind into a differentiated tissue of another kind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metaplasia" .

goldbook:10954 a skos:Concept ;
    skos:definition "Attachment of a methyl group to a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "methylation" .

goldbook:10955 a skos:Concept ;
    skos:definition "Congenital occurrence of an abnormally small head." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcephaly" .

goldbook:10956 a skos:Concept ;
    skos:definition "Congenital occurrence of abnormally small hands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcheiria" .

goldbook:10957 a skos:Concept ;
    skos:definition "Congenital occurrence of an abnormally small tongue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microglossia" .

goldbook:10958 a skos:Concept ;
    skos:definition "Congenital occurrence of abnormally small jaws, especially effecting the mandible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micrognathia" .

goldbook:10959 a skos:Concept ;
    skos:definition "Laboratory technique in which dispersed cells from an embryonic organ or tissue, such as the brain, limb bud, or cartilage, are allowed to reaggregate in culture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micromass culture" .

goldbook:10960 a skos:Concept ;
    skos:definition "Test for mutagenicity in which animals are treated with a test agent, after which time the frequency of micronucleated cells is determined. Note: If a test group shows significantly increased levels of micronucleated cells compared to a control group, the chemical is considered capable of inducing chromosomal damage. Procedure to detect clastogenic or aneugenic agents by microscopic examination of chromosomes. Note: The test can be performed in vivo in rodents, or in cell culture (in vitro mammalian cell micronucleus test)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micronucleus test" .

goldbook:10961 a skos:Concept ;
    skos:definition "Abnormally small penis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microphallus" .

goldbook:10962 a skos:Concept ;
    skos:definition "Congenital occurrence of abnormally small eyeballs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microphthalmia" .

goldbook:10963 a skos:Concept ;
    skos:altLabel "short tandem repeat (STR)" ;
    skos:definition "Non-coding segment of DNA consisting of short nucleotide sequences (\\(\\pu{2\\!{-}\\! 6}\\) base pairs), typically occurring in \\(\\pu{10\\!{-}\\! 100}\\) consecutive (tandem) repeats." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microsatellite" .

goldbook:10964 a skos:Concept ;
    skos:definition "Congenital occurrence of an abnormally small opening of the mouth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microstomia" .

goldbook:10965 a skos:Concept ;
    skos:altLabel "mesenteron" ;
    skos:definition "Middle section of the digestive tract in a vertebrate embryo, from which the ileum, jejunum, and portions of the duodenum and colon develop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "midgut" .

goldbook:10966 a skos:Concept ;
    skos:definition "Neurological disease caused by methylmercury, first seen in subjects ingesting contaminated fish from Minamata Bay in Japan." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Minamata disease" .

goldbook:10967 a skos:Concept ;
    skos:altLabel "variable number tandem repeat (VNTR)" ;
    skos:definition "Non-coding segment of DNA, found throughout the genome, usually near the ends of chromosomes, that consists of tandem repeats of sequences of about \\(\\pu{10\\!{-}\\! 100}\\) base pairs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minisatellite" .

goldbook:10968 a skos:Concept ;
    skos:definition "Lay term for spontaneous abortion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miscarriage" .

goldbook:10969 a skos:Concept ;
    skos:definition "Use in epidemiological studies of techniques of molecular biology, such as DNA profiling and genetic analysis, with the aim of detecting genetic patterns characteristic of susceptible populations or of groups at risk of disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular epidemiology" .

goldbook:10970 a skos:Concept ;
    skos:definition "Congenital absence of one eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monophthalmos" .

goldbook:10971 a skos:Concept ;
    skos:definition "Disorder in which body cells have only one pair instead of the normal two pairs of a particular chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monosomy" .

goldbook:10972 a skos:Concept ;
    skos:definition "Any of various signalling factors in embryonic tissue that influences the movement and organization of cells during morphogenesis by forming a concentration gradient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphogen" .

goldbook:10973 a skos:Concept ;
    skos:definition "Shaping of an organism during embryological development by differentiation of cells, tissues, organs, and organ systems, according to the genetic program of the organism, and influenced by morphogens and environmental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphogenesis" .

goldbook:10974 a skos:Concept ;
    skos:definition "Pertaining to structure or form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphological" .

goldbook:10975 a skos:Concept ;
    skos:definition "Early multi-celled stage of the embryo from which the blastocyst is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morula" .

goldbook:10976 a skos:Concept ;
    skos:definition "Condition in which an individual or an organism that develops from a single zygote has two or more cell populations that differ in genetic constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mosaicism" .

goldbook:10977 a skos:Concept ;
    skos:definition "Energy-dependent forward movement of the sperm, allowing it to reach and penetrate the egg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sperm motility" .

goldbook:10978 a skos:Concept ;
    skos:altLabel "mucosa" ;
    skos:definition "Layer of epithelial tissue with a thin underlying layer of connective tissue (the lamina propria) that lines many body cavities, including the gut, respiratory passages, and tubular organs; it secretes, and is covered in, mucus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucous membrane" .

goldbook:10979 a skos:Concept ;
    skos:definition "Slippery viscous fluid, consisting largely of water and glycoproteins, secreted by mucous membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucus" .

goldbook:10980 a skos:Concept ;
    skos:definition "Formation of a placenta with many lobes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicotyledonary placentation" .

goldbook:10981 a skos:Concept ;
    skos:definition "Transmission from parents to offspring of a trait that is determined by multiple genetic and environmental factors, each with a small effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multifactorial inheritance" .

goldbook:10982 a skos:Concept ;
    skos:definition "Animal test of reproductive toxicity in which two to three generations of the test organism are exposed to the substance being assessed. Animal test of reproductive toxicity in which only one generation is exposed and effects on subsequent generations are assessed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multigenerational study" .

goldbook:10983 a skos:Concept ;
    skos:definition "Very small infectious microorganism, related to bacteria, but without a cell wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mycoplasma" .

goldbook:10984 a skos:Concept ;
    skos:definition "Part of the brain in the embryo that gives rise to the medulla oblongata." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelencephalon" .

goldbook:10985 a skos:Concept ;
    skos:definition "The acquisition, development, or formation of a myelin sheath around a nerve fiber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelination" .

goldbook:10986 a skos:Concept ;
    skos:definition "Immature bone marrow cell that is a precursor of the granulocyte series." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloblast" .

goldbook:10987 a skos:Concept ;
    skos:definition "Harming bone marrow or any of its components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelotoxic" .

goldbook:10988 a skos:Concept ;
    skos:definition "Mononucleate cell that is committed to differentiate into muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myoblast" .

goldbook:10989 a skos:Concept ;
    skos:definition "Inflammation of the heart muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myocarditis" .

goldbook:10990 a skos:Concept ;
    skos:definition "Muscle of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myocardium" .

goldbook:10991 a skos:Concept ;
    skos:definition "Muscular wall of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myometrium" .

goldbook:10992 a skos:Concept ;
    skos:definition "Inflammation of muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myositis" .

goldbook:10993 a skos:Concept ;
    skos:definition "In the embryo, that part of a somite that develops into skeletal muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myotome" .

goldbook:10994 a skos:Concept ;
    skos:definition "Relating to the nose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nasal" .

goldbook:10995 a skos:Concept ;
    skos:definition "Rate of birth, the number of newborn individuals per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natality" .

goldbook:10996 a skos:Concept ;
    skos:definition "Postmortem examination of the organs and body tissue of a non-human animal to determine cause of death or pathological condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "necropsy" .

goldbook:10997 a skos:Concept ;
    skos:definition "Newborn animal or human infant during the first four weeks of postnatal life." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neonate" .

goldbook:10998 a skos:Concept ;
    skos:definition "New and abnormal formation of tissue as a consequence of growth by cell proliferation, which may continue after the initial stimulus that initiated the proliferation has ceased, and which may develop into a tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neoplasm" .

goldbook:10999 a skos:Concept ;
    skos:definition "Pertaining to a nerve or to the nervous system. Pertaining to the dorsal side of the vertebral bodies or to their precursors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural" .

goldbook:11000 a skos:Concept ;
    skos:altLabel "vertebral arch" ;
    skos:definition "Dorsal bony covering of the spinal cord. Cartilaginous structures surrounding the embryonicspinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural arch" .

goldbook:11001 a skos:Concept ;
    skos:definition "Band of cells on either side of the neural tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural crest" .

goldbook:11002 a skos:Concept ;
    skos:definition "Area in the middle of the early embryo that rolls up to form the neural tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural plate" .

goldbook:11003 a skos:Concept ;
    skos:definition "Embryonic tubular structure that becomes the brain and spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural tube" .

goldbook:11004 a skos:Concept ;
    skos:definition "Failure of the neural tube to close properly during gastrulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural tube defect" .

goldbook:11005 a skos:Concept ;
    skos:definition "Pertaining to the function of the nervous system as it relates to behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurobehavioral" .

goldbook:11006 a skos:Concept ;
    skos:definition "Cell derived from neural stem cell that will differentiate into a neuron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroblast" .

goldbook:11007 a skos:Concept ;
    skos:definition "Malignant neoplasm consisting of poorly differentiated embryonic nerve cells (neuroblasts)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroblastoma" .

goldbook:11008 a skos:Concept ;
    skos:definition "Central region of the early embryonic ectoderm that will give rise to the brain and spinal cord, together with the neural crest cells that will form the peripheral nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroectoderm" .

goldbook:11009 a skos:Concept ;
    skos:definition "Combined cooperating network of the nervous system and hormonal systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroendocrine system" .

goldbook:11010 a skos:Concept ;
    skos:definition "Pertaining to the nervous and endocrine systems in anatomical or functional relationship." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroendocrine" .

goldbook:11011 a skos:Concept ;
    skos:definition "Posterior lobe of the pituitary gland, involved in the storage and secretion of oxytocin and vasopressin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurohypophysis" .

goldbook:11012 a skos:Concept ;
    skos:definition "Nerve cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuron" .

goldbook:11013 a skos:Concept ;
    skos:definition "Opening at either the cranial (caudal) or anterior (rostral) end of the neural tube before it completes closure in the early embryonic stage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropore" .

goldbook:11014 a skos:Concept ;
    skos:definition "One of several protein growth factors that regulates development, maintenance, and function of the vertebrate nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotrophin" .

goldbook:11015 a skos:Concept ;
    skos:definition "Formation of the embryonic neural plate and its rolling up into the neural tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurulation" .

goldbook:11016 a skos:Concept ;
    skos:definition "Projection on the apex of the breast through which the ducts of the milk-producing glands open." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nipple" .

goldbook:11017 a skos:Concept ;
    skos:altLabel "nodal protein" ;
    skos:definition "Growth factor of the transforming growth factor \\(\\upbeta\\) (TGF-\\(\\upbeta\\)) superfamily, coded by a gene designated NODAL, that plays crucial roles in embryogenesis, particularly in signalling from the primitive streak to the mesoderm to establish left-right asymmetry as well as aspects of stem cell differentiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nodal" .

goldbook:11018 a skos:Concept ;
    skos:altLabel "NOG" ;
    skos:definition "Signaling protein released by the notochord, important in somite patterning and nervous system development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "noggin" .

goldbook:11019 a skos:Concept ;
    skos:definition "Failure of chromosomes to separate during meiosis, resulting in an uneven distribution of chromosomes in the two gametes (\\(\\pu{24}\\) and \\(\\pu{22}\\) in humans)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nondisjunction" .

goldbook:11020 a skos:Concept ;
    skos:altLabel "2-diol",
        "4-[(1S)-2-amino-1-hydroxyethyl]benzene-1",
        "norepinephrine" ;
    skos:definition "Catecholamine hormone acting as a postganglionic adrenergic mediator at $\\ce{\\upalpha\\!\\mbox{-}}$ and $\\ce{\\upbeta\\!\\mbox{-}adrenergic}$ receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "noradrenaline" .

goldbook:11021 a skos:Concept ;
    skos:definition "Rod-shaped structure of cells derived from mesoderm, lying ventral to the neural tube and defining the primitive axis of the embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "notochord" .

goldbook:11022 a skos:Concept ;
    skos:altLabel "mitotic spindle" ;
    skos:definition "Structure, formed from microtubules, that draws the newly duplicated chromosomes apart during mitosis and meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear spindle" .

goldbook:11023 a skos:Concept ;
    skos:definition "Steroid hormone receptor, found in the cytosol, that upon ligand binding translocates into the nucleus and interacts with DNA as a homodimer to drive specific gene transcription." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear type I receptor" .

goldbook:11024 a skos:Concept ;
    skos:definition "Steroid hormone receptor, found in the nucleus, that upon ligand binding interacts with DNA as a heterodimer (usually with the retinoid X receptor, RXR) to drive specific gene transcription." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear type II receptor" .

goldbook:11025 a skos:Concept ;
    skos:definition "Never having been pregnant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nulligravida" .

goldbook:11026 a skos:Concept ;
    skos:definition "Never having given birth to a live infant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nulliparous" .

goldbook:11027 a skos:Concept ;
    skos:definition "Back part of the head or skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occiput" .

goldbook:11028 a skos:Concept ;
    skos:definition "Dentin-forming cell of the pulp cavity of a tooth, arising from the mesenchyme of the neural crest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "odontoblast" .

goldbook:11029 a skos:Concept ;
    skos:definition "Child or children of a person, or the young of an animal, in relation to the parent(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "offspring" .

goldbook:11030 a skos:Concept ;
    skos:definition "Congenital occurrence of fewer than the usual number of digits, resulting in humans having fewer than five fingers or toes on a hand or foot." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligodactyly" .

goldbook:11031 a skos:Concept ;
    skos:definition "Congenital absence of some of the teeth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligodontia" .

goldbook:11032 a skos:Concept ;
    skos:definition "Infrequent or scanty menstruation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligomenomenorrhea" .

goldbook:11033 a skos:Concept ;
    skos:altLabel "oligospermatism",
        "oligozoospermia" ;
    skos:definition "Subnormal concentration of sperm in the male ejaculate (see ejaculation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligospermia" .

goldbook:11034 a skos:Concept ;
    skos:definition "Fold of peritoneal membrane passing between the stomach and another abdominal organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "omentum" .

goldbook:11035 a skos:Concept ;
    skos:definition "Omentum passing from the greater curvature of the stomach in front of the small intestine, folding back on itself to fuse into four layers of peritoneal membrane, and ascending to the transverse colon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "greater omentum" .

goldbook:11036 a skos:Concept ;
    skos:definition "Double-layer of peritoneal membrane (omentum) passing between the lesser curvature of the stomach and the duodenum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lesser omentum" .

goldbook:11037 a skos:Concept ;
    skos:altLabel "exomphalos" ;
    skos:definition "Congenital herniation of abdominal viscera into the base of the umbilical cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "omphalocele" .

goldbook:11038 a skos:Concept ;
    skos:definition "Lesser developed of two monozygotic twins that failed to separate completely during embryogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "omphalosite" .

goldbook:11039 a skos:Concept ;
    skos:definition "Procedure in which male rodents are dosed with a test substance for at least one spermatogenic cycle, and females for two estrous cycles, and then further exposed during mating, pregnancy, and nursing; adverse effects on reproduction, parturition, lactation and postnatal growth are studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "one-generation reprotox study" .

goldbook:11040 a skos:Concept ;
    skos:altLabel "ovocyte" ;
    skos:definition "Immature precursor of the ovum resident in the ovary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oocyte" .

goldbook:11041 a skos:Concept ;
    skos:definition "Oocyte during growth phase before completion of the first meiotic division." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary oocyte" .

goldbook:11042 a skos:Concept ;
    skos:definition "Oocyte in which the first meiotic division to a haploid cell has been completed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary oocyte" .

goldbook:11043 a skos:Concept ;
    skos:definition "Process of formation and development of an ovum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oogenesis" .

goldbook:11044 a skos:Concept ;
    skos:definition "Primitive germ cell that proliferates by mitosis and develops into a primary oocyte prior to birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oogonium" .

goldbook:11045 a skos:Concept ;
    skos:definition "Relating to the eye or vision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optic" .

goldbook:11046 a skos:Concept ;
    skos:altLabel "eye socket" ;
    skos:definition "Cavity in the skull of a vertebrate that contains the eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orbit" .

goldbook:11047 a skos:Concept ;
    skos:altLabel "spiral organ" ;
    skos:definition "Specialized collection of epithelial hair cells in the inner ear, involved in hearing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organ of Corti" .

goldbook:11048 a skos:Concept ;
    skos:definition "Formation and development of organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organogenesis" .

goldbook:11049 a skos:Concept ;
    skos:definition "Failure of the lip or palate to fuse properly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orofacial cleft" .

goldbook:11050 a skos:Concept ;
    skos:definition "Large multinucleate cell that resorbs bone, allowing for the deposition of new bone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteoclast" .

goldbook:11051 a skos:Concept ;
    skos:altLabel "ossification" ;
    skos:definition "Laying down of new bone tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteogenesis" .

goldbook:11052 a skos:Concept ;
    skos:altLabel "introitus" ;
    skos:definition "Opening into a vessel or cavity of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ostium" .

goldbook:11053 a skos:Concept ;
    skos:altLabel "auricular" ;
    skos:definition "Pertaining to, or located near the ear." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "otic" .

goldbook:11054 a skos:Concept ;
    skos:definition "Congenital anomaly characterized by the absence or extreme underdevelopment of the lower jaw, producing closeness of the ears below the face." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "otocephaly" .

goldbook:11055 a skos:Concept ;
    skos:definition "Sequence of events occurring in the ovary involved in ovulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovarian cycle" .

goldbook:11056 a skos:Concept ;
    skos:definition "Cavity in the ovary containing a maturing ovum, at any stage of development, surrounded by its encasing cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovarian follicle" .

goldbook:11057 a skos:Concept ;
    skos:definition "One of the paired female reproductive glands containing the ova (see ovum)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovary" .

goldbook:11058 a skos:Concept ;
    skos:definition "Abnormal gonad in which both ovarian and testicular tissues are present, and thus a form of hermaphroditism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovotestis" .

goldbook:11059 a skos:Concept ;
    skos:definition "Release of a mature ovum from the ovary into the Fallopian tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovulation" .

goldbook:11060 a skos:Concept ;
    skos:definition "Mature female sex cell, capable of undergoing fertilization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovum" .

goldbook:11061 a skos:Concept ;
    skos:definition "Peptide hormone secreted by the neurohypophysis that stimulates contraction of the myometrium during labor and secretion of milk during lactation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxytocin" .

goldbook:11062 a skos:Concept ;
    skos:definition "Roof of the mouth, separating the oral and nasal cavities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "palate" .

goldbook:11063 a skos:Concept ;
    skos:definition "Medial central ridge of the palate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "palatine raphe" .

goldbook:11064 a skos:Concept ;
    skos:altLabel "Pap smear",
        "Pap test",
        "Papanicolaou stain",
        "cervical smear" ;
    skos:definition "Examination by light microscopy of a sample of cells scraped from the uterine cervix, used to screen for cervical cancer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Papanicolaou smear" .

goldbook:11065 a skos:Concept ;
    skos:definition "Type of signaling in which a cell secretes into the intercellular space a molecular messenger that diffuses and binds to receptors on nearby target cells, producing a signal in those cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paracrine" .

goldbook:11066 a skos:Concept ;
    skos:altLabel "C cell" ;
    skos:definition "Neuroendocrine cell that migrates into the thyroid gland during embryonic development and secretes the hormone calcitonin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parafollicular cell" .

goldbook:11067 a skos:Concept ;
    skos:altLabel "Müllerian duct" ;
    skos:definition "One of two paired embryonic ducts of mesodermal origin that will become the Fallopian tubes, uterus, cervix and upper part of the vagina in the female, and will regress in the male." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paramesonephric duct" .

goldbook:11068 a skos:Concept ;
    skos:definition "Connective tissue of the floor of the female pelvis that lies in front of the uterine cervix and separates it from the bladder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parametrium" .

goldbook:11069 a skos:Concept ;
    skos:definition "Smaller of unequal conjoined twins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parasitic twin" .

goldbook:11070 a skos:Concept ;
    skos:altLabel "somitic mesoderm" ;
    skos:definition "Area of mesoderm in the embryo that forms during neurulation, lies along both sides of the neural tube, and gives rise to the somites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paraxial mesoderm" .

goldbook:11071 a skos:Concept ;
    skos:definition "Distinguishing or specific type of cell of an organ or gland, contained in, or supported by, the connective tissue framework provided by the stromal cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parenchymal cell" .

goldbook:11072 a skos:Concept ;
    skos:definition "Relating to or denoting the wall of the body or of a body cavity or hollow structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parietal" .

goldbook:11073 a skos:Concept ;
    skos:definition "Acid-producing cell in the stomach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastric parietal cell" .

goldbook:11074 a skos:Concept ;
    skos:altLabel "apogamia" ;
    skos:definition "Type of nonsexual reproduction in which an unfertilized ovum develops into an embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parthenogenesis" .

goldbook:11075 a skos:Concept ;
    skos:definition "Process of giving birth by a maternal organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parturition" .

goldbook:11076 a skos:Concept ;
    skos:definition "Congenital disorder wherein the ductus arteriosis fails to close after birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "patent ductus arteriosus" .

goldbook:11077 a skos:Concept ;
    skos:altLabel "ectopic kidney" ;
    skos:definition "Congenital abnormality in which a kidney develops and remains in the pelvic area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pelvic kidney" .

goldbook:11078 a skos:Concept ;
    skos:definition "Serous membranous sac that surrounds the heart, consisting of an inner visceral layer (the epicardium), and an outer parietal pericardium that is attached to the sternum and diaphragm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pericardium" .

goldbook:11079 a skos:Concept ;
    skos:definition "Relating to the period from shortly before to shortly after birth, in humans usually from the 20th to the 29th week of gestation to one to four weeks after birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perinatal" .

goldbook:11080 a skos:Concept ;
    skos:definition "Muscular structure of the lower pelvis, between the legs and extending from the anus to the pubic symphysis, or alternatively including the anus and vagina in the female and the region from the anus to the base of the scrotum in the male." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perineum" .

goldbook:11081 a skos:Concept ;
    skos:definition "Potential space between the two layers (visceral and parietal) of the peritoneum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritoneal cavity" .

goldbook:11082 a skos:Concept ;
    skos:altLabel "peritoneal membrane" ;
    skos:definition "Thin double layer of mesothelium and irregular connective tissue that lines the abdominal cavity and covers most of the abdominal organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritoneum" .

goldbook:11083 a skos:Concept ;
    skos:definition "Method that enables the presentation of large peptide libraries on the surface of phage particles, from which proteins with desired functional properties can be selected rapidly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phage display" .

goldbook:11084 a skos:Concept ;
    skos:definition "One of several paired grooves in the embryonic endoderm, lateral to the corresponding pharyngeal pouch in the ectoderm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharyngeal groove" .

goldbook:11085 a skos:Concept ;
    skos:altLabel "branchial pouch" ;
    skos:definition "One of several paired evaginations in the embryonic endoderm that develop into epithelial tissues and organs such as the thymus and thyroid gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharyngeal pouch" .

goldbook:11086 a skos:Concept ;
    skos:definition "Part of the digestive tube lying between the esophagus (below) and the mouth and nasal cavity (above and anterior)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharynx" .

goldbook:11087 a skos:Concept ;
    skos:altLabel "PKU" ;
    skos:definition "Autosomal recessive disorder resulting from mutations that impair the function of the enzyme phenylalanine 4-monooxygenase (EC 1.14.16.1)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenylketonuria" .

goldbook:11088 a skos:Concept ;
    skos:definition "Groove in the midline of the upper lip below the nose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "philtrum" .

goldbook:11089 a skos:Concept ;
    skos:definition "Congenital abnormality in which one or more of the hands or feet is attached to an underdeveloped limb, and therefore too close to the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phocomelia" .

goldbook:11090 a skos:Concept ;
    skos:definition "Non-steroidal natural product from a plant that, because of a structural similarity to 17\\(\\upbeta\\)-estradiol can exert mild estrogenic effects, or antagonize them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phytoestrogen" .

goldbook:11091 a skos:Concept ;
    skos:definition "Patchy absence of pigmentation of the hair or skin or, depending on the species, of feathers, scales, or other body surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "piebaldism" .

goldbook:11092 a skos:Concept ;
    skos:altLabel "epiphysis" ;
    skos:definition "Pea-sized conical mass of tissue behind the third ventricle of the brain, secreting the hormone-like substance melatonin in some mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pineal gland" .

goldbook:11093 a skos:Concept ;
    skos:definition "Externally visible portion of the ear.See also: auricle Feather or fin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pinna" .

goldbook:11094 a skos:Concept ;
    skos:altLabel "hypophysis",
        "pituitary gland" ;
    skos:definition "Small endocrine gland sitting in a bony cavity (the sella turcica) at the base of the brain and connected to the hypothalamus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pituitary" .

goldbook:11095 a skos:Concept ;
    skos:definition "Organ of exchange of nutrients and waste products between mother and fetus, having parts derived from both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "placenta" .

goldbook:11096 a skos:Concept ;
    skos:altLabel "placental membrane" ;
    skos:definition "Multilayered membrane of fetal tissue within the placenta that separates the maternal blood from the fetal blood and allows selective passage of substances between the two." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "placental barrier" .

goldbook:11097 a skos:Concept ;
    skos:definition "Circulation of blood through the placenta during intrauterine life, serving the needs of the fetus for oxygenation, nutrition, and elimination of waste." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "placental circulation" .

goldbook:11098 a skos:Concept ;
    skos:definition "Inadequate blood flow through the placenta to maintain the needs of the fetus for oxygenation and metabolic balance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "placental insufficiency" .

goldbook:11099 a skos:Concept ;
    skos:definition "Delivery of substances from the maternal circulation to the fetus, across the placental barrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "placental transfer" .

goldbook:11100 a skos:Concept ;
    skos:definition "Having more than one effect. Relating to a gene, expression of which gives rise to multiple phenotypic traits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pleiotropism" .

goldbook:11101 a skos:Concept ;
    skos:definition "Each of a pair of serous membranes lining the thorax and enveloping the lungs in humans and other mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pleura" .

goldbook:11102 a skos:Concept ;
    skos:definition "Potential space between the pleural membranes lining the chest cavity (parietal pleura) and covering the lungs (visceral pleura)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pleural cavity" .

goldbook:11103 a skos:Concept ;
    skos:definition "Able to differentiate into a variety of cell types." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pluripotent" .

goldbook:11104 a skos:Concept ;
    skos:definition "Composed of many cysts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycystic" .

goldbook:11105 a skos:Concept ;
    skos:definition "Congenital occurrence of supernumerary fingers or toes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polydactyly" .

goldbook:11106 a skos:Concept ;
    skos:definition "Occurrence of a gene in more than one distinct nucleotide sequence in a population, resulting from mutation(s) and potentially producing gene products with different levels of function. Note: It is sometimes considered that the least frequent of polymorphic gene sequences should be present in at least \\(\\pu{1\\%}\\) of the population; otherwise the variant is a mutation rather than a polymorphism. Occurrence of different phenotypes of a single trait." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymorphism" .

goldbook:11107 a skos:Concept ;
    skos:definition "Occurrence of more than two complete sets of chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyploidy" .

goldbook:11108 a skos:Concept ;
    skos:definition "Occurrence of a cyst in the substance of the brain that usually communicates with one of the lateral ventricles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porencephaly" .

goldbook:11109 a skos:Concept ;
    skos:definition "Occurring after the early embryo embeds in the lining of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-implantation" .

goldbook:11110 a skos:Concept ;
    skos:definition "After death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "postmortem" .

goldbook:11111 a skos:Concept ;
    skos:definition "Referring to events in the life of the mother or fetus following birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "postnatal" .

goldbook:11112 a skos:Concept ;
    skos:definition "Period following the birth of an infant, often considered to be about six weeks in the human." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "postpartum" .

goldbook:11113 a skos:Concept ;
    skos:definition "Procedure in which adult females of the predatory mite (_027814_ considered representative of soil fauna) are exposed to a test substance in artificial soil and the number of surviving females and of juveniles is determined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predatory mite test" .

goldbook:11114 a skos:Concept ;
    skos:definition "Pathological condition in pregnancy with symptoms of high blood pressure, kidney dysfunction and edema." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-eclampsia" .

goldbook:11115 a skos:Concept ;
    skos:definition "Fertilized ovum up to \\(\\pu{14 days}\\) of age and before implantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-embryo" .

goldbook:11116 a skos:Concept ;
    skos:definition "State of a female between conception and the termination of gestation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pregnancy" .

goldbook:11117 a skos:Concept ;
    skos:definition "Occurring before the early embryo embeds in the lining of the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-implantation" .

goldbook:11118 a skos:Concept ;
    skos:definition "Delivery before the expected length of gestation for the species; in humans taken as birth before a gestational age of \\(\\pu{37 weeks}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "premature birth" .

goldbook:11119 a skos:Concept ;
    skos:altLabel "antenatal" ;
    skos:definition "Referring to events in the life of the mother or fetus preceding birth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prenatal" .

goldbook:11120 a skos:Concept ;
    skos:definition "Procedure in which a substance is administered to pregnant animals (usually rodents or rabbits) from the time of implantation until closure of the hard palate. The animals are killed one to two days before a scheduled delivery, whereupon uterine contents and the fetuses are evaluated for abnormalities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prenatal development study" .

goldbook:11121 a skos:Concept ;
    skos:altLabel "preoptic region" ;
    skos:definition "Region of the anterior hypothalamus primarily involved in regulating body temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preoptic area" .

goldbook:11122 a skos:Concept ;
    skos:definition "Stage of human development before the onset of puberty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prepubertal" .

goldbook:11123 a skos:Concept ;
    skos:definition "Period before pubescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prepubescence" .

goldbook:11124 a skos:Concept ;
    skos:altLabel "clitoral hood",
        "foreskin" ;
    skos:definition "Skin protecting the glans penis in the male (foreskin) or the clitoris in the female (clitoral hood)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prepuce" .

goldbook:11125 a skos:Concept ;
    skos:definition "Separation of the prepuce from the glans penis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preputial separation" .

goldbook:11126 a skos:Concept ;
    skos:definition "Gonads, which form gametes; ovaries in the female and testes in the male." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary sex organ" .

goldbook:11127 a skos:Concept ;
    skos:definition "Thickening of the embryonic tissue extending forward from the primitive streak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive axis" .

goldbook:11128 a skos:Concept ;
    skos:definition "Shallow depression in the primitive streak that extends anteriorly to communicate with the yolk sac." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive groove" .

goldbook:11129 a skos:Concept ;
    skos:altLabel "primitive knot" ;
    skos:definition "Group of cells at the anterior end of the primitive streak, involved in secreting chemical signals that regulate differentiation of the germ layers during gastrulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive node" .

goldbook:11130 a skos:Concept ;
    skos:definition "Depression in the primitive node contiguous with the notochord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive pit" .

goldbook:11131 a skos:Concept ;
    skos:definition "Structure forming in the blastula during early embryogenesis that establishes bilateral symmetry and determines the site of gastrulation and germ layer formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive streak" .

goldbook:11132 a skos:Concept ;
    skos:definition "Early stage of the oocyte in which it is surrounded by a single layer of follicular cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primordial follicle" .

goldbook:11133 a skos:Concept ;
    skos:definition "Germ cell in the earliest stages of development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primordial germ cell" .

goldbook:11134 a skos:Concept ;
    skos:definition "Organ or tissue at its earliest recognizable stage of development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primordium" .

goldbook:11135 a skos:Concept ;
    skos:altLabel "anal pit" ;
    skos:definition "Ectodermal depression of the caudal end of the embryo, where later the anus is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proctodeum" .

goldbook:11136 a skos:Concept ;
    skos:altLabel "pregn-4-ene-3,20-dione" ;
    skos:definition "Steroidal hormone produced in the ovary by the corpus luteum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "progesterone" .

goldbook:11137 a skos:Concept ;
    skos:definition "Synthetic variant of progesterone, often used in oral contraceptive pills or to suppress hyperplasia of the endometrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "progestin" .

goldbook:11138 a skos:Concept ;
    skos:altLabel "gestagen" ;
    skos:definition "Member of a family of hormones, based on the 21-carbon pregnane skeleton, involved in maintaining gestation and regulating the ovarian cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "progestogen" .

goldbook:11139 a skos:Concept ;
    skos:definition "Hormone released from the anterior pituitary gland that stimulates milk production after childbirth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prolactin" .

goldbook:11140 a skos:Concept ;
    skos:definition "Falling or slipping out of place of an organ or other body part." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prolapse" .

goldbook:11141 a skos:Concept ;
    skos:definition "Collection of cells in the vertebrate embryo that represent the earliest stage of development of the kidney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pronephros" .

goldbook:11142 a skos:Concept ;
    skos:definition "Haploid nucleus formed by either the head of the sperm or the nucleus of the oocyte after fertilization but before their nuclei fuse to form the diploid zygotic nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pronucleus" .

goldbook:11143 a skos:Concept ;
    skos:definition "First phase of meiosis or mitosis in which thickening and orientation of the chromosomes occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prophase" .

goldbook:11144 a skos:Concept ;
    skos:altLabel "forebrain" ;
    skos:definition "Most forward part of the brain that includes most of the cerebral cortex, the thalamus and hypothalamus, and the basal ganglia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prosencephalon" .

goldbook:11145 a skos:Concept ;
    skos:definition "Male exocrine gland whose secretion contributes alkaline fluid to the ejaculate (see ejaculation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prostate" .

goldbook:11146 a skos:Concept ;
    skos:definition "Small, basic (arginine-rich) protein involved in sperm maturation and DNA packaging during spermatogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protamine" .

goldbook:11147 a skos:Concept ;
    skos:definition "Any enzyme catalyzing protein phosphorylation, often for the purpose of signal transduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein kinase" .

goldbook:11148 a skos:Concept ;
    skos:definition "Nearer to an anatomical point of origin or attachment, or the midline of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proximal" .

goldbook:11149 a skos:Concept ;
    skos:definition "Organism possessing either male (testes) or female (ovaries) gonads, but with ambiguous external genitalia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudohermaphrodite" .

goldbook:11150 a skos:Concept ;
    skos:altLabel "false pregnancy",
        "pseudocyesis" ;
    skos:definition "Development of signs of pregnancy in the absence of an embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudopregnancy" .

goldbook:11151 a skos:Concept ;
    skos:definition "Delayed development of both cognitive and motor function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychomotor retardation" .

goldbook:11152 a skos:Concept ;
    skos:definition "Process in which an individual undergoes sexual development, including the onset of gametogenesis, changes in hormonal secretions, secondary sexual characteristics, and reproductive competence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "puberty" .

goldbook:11153 a skos:Concept ;
    skos:definition "Being in the early stage of puberty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pubescent" .

goldbook:11154 a skos:Concept ;
    skos:definition "Relating to the region of the most ventral bone of the pelvis (the pubic bone), and thus the region around the genital area, normally showing hair growth (pubic hair) in the adult." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pubic" .

goldbook:11155 a skos:Concept ;
    skos:definition "Cartilaginous joint between the pubic bones forming the front of the pelvis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pubic symphysis" .

goldbook:11156 a skos:Concept ;
    skos:definition "Pertaining to the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulmonary" .

goldbook:11157 a skos:Concept ;
    skos:definition "Large vessel that transports blood from the heart to the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulmonary artery" .

goldbook:11158 a skos:Concept ;
    skos:definition "Condition in which the flow of blood from the heart to the lungs is slowed by a deformity on or near the pulmonary valve that controls the blood flow from the right heart to the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulmonary valve stenosis" .

goldbook:11159 a skos:Concept ;
    skos:definition "(n) Young or newborn dog, rat or seal. (v) Give birth to a pup." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pup" .

goldbook:11160 a skos:Concept ;
    skos:definition "Narrowing of the sphincter (the pylorus) between the stomach and duodenum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyloric stenosis" .

goldbook:11161 a skos:Concept ;
    skos:definition "Initial awareness of fetal movement by the pregnant mother, usually occurring early in the second trimester." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quickening" .

goldbook:11162 a skos:Concept ;
    skos:definition "Failure of the neural tube to close in utero, resulting in a birth defect that leaves a fissure in the vertebral column with part of the spinal cord exposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rachischisis" .

goldbook:11163 a skos:Concept ;
    skos:definition "Receptor that encounters its ligand in the cytosol and translocates to the nucleus, where it binds DNA and acts as a factor regulating gene transcription." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear receptor" .

goldbook:11164 a skos:Concept ;
    skos:definition "In genetics, relating to or denoting heritable characteristics controlled by genes which are expressed in offspring only when inherited from both parents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recessive" .

goldbook:11165 a skos:Concept ;
    skos:definition "Process in tissue or organ development in which epithelium induces changes in the mesenchyme and the mesenchyme also induces changes in the epithelium, through paracrine signaling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reciprocal mesenchymal-epithelial interaction" .

goldbook:11166 a skos:Concept ;
    skos:definition "Chromosomal translocation in which crossing over between two non-homologous chromosomes leads to each carrying genetic material from the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reciprocal translocation" .

goldbook:11167 a skos:Concept ;
    skos:definition "Referring to new gene sequences, and thus to new heritable information, caused by gene crossovers, occurring naturally in either meiosis or mitosis, or constructed artificially for the purpose of introducing a new trait into an organism or cell line. In immunology, random scrambling of specific gene sequences to produce the vast array of possible immunoglobulin and T cell receptor sequences required to recognize, potentially, all possible antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic recombination" .

goldbook:11168 a skos:Concept ;
    skos:definition "Terminal part of the large intestine, ending at the anus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rectum" .

goldbook:11169 a skos:Concept ;
    skos:altLabel "alpha-reductase" ;
    skos:definition "Enzyme (EC 1.3.99.5) that converts testosterone to 5\\(\\upalpha\\)-dihydrotestosterone in peripheral tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "5α-reductase" .

goldbook:11170 a skos:Concept ;
    skos:definition "Condition caused by a mutation of the $\\ce{5\\upalpha\\!\\mbox{-}reductase}$ type II gene, with autosomal recessive inheritance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "5α-reductase deficiency" .

goldbook:11171 a skos:Concept ;
    skos:definition "Pertaining to the kidneys." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "renal" .

goldbook:11172 a skos:Concept ;
    skos:definition "Progressive decline in reproductive capacity with age, marked by menopause in females." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive senescence" .

goldbook:11173 a skos:Concept ;
    skos:definition "Agent that interferes with reproductive function, including sexual performance, fertility, and development of the fetus and embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive toxicant" .

goldbook:11174 a skos:Concept ;
    skos:definition "Procedure based on specific guidelines in which adverse effects of a substance on reproduction and development are studied either in animals or by use of in vitro assays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive toxicity test" .

goldbook:11175 a skos:Concept ;
    skos:definition "Removal of mineralized tissue by natural processes, as in the breakdown of bone by osteoclasts or the disappearance of a tooth.  Disintegration and assimilation of an embryo or fetus through a natural process involving lysis and removal of all the products of conception by cells of the maternal immune system.  In multigestational pregnancies, death of one fetus followed by absorption of its tissue by another, sometimes referred to as a 'vanishing twin'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resorption" .

goldbook:11176 a skos:Concept ;
    skos:definition "Short DNA nucleotide sequence that is recognized by a sequence-specific enzyme (restriction enzyme) that cleaves the double stranded DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "restriction site" .

goldbook:11177 a skos:Concept ;
    skos:definition "Fibrous mesh or network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rete" .

goldbook:11178 a skos:Concept ;
    skos:definition "Rete in the testis that carries sperm from the seminiferous tubules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rete testis" .

goldbook:11179 a skos:Concept ;
    skos:definition "Multicell-layer membrane in the back of the eye that is sensitive to light and transduces incoming optical information into signals that are necessary for vision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retina" .

goldbook:11180 a skos:Concept ;
    skos:altLabel "(2E,4E,6E,8E)-3,7-dimethyl-9-(2,6,6-trimethylcyclohex-1-en-1-yl)nona-2,4,6,8-tetraenoic acid" ;
    skos:definition "Acidic metabolite of vitamin A." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retinoic acid" .

goldbook:11181 a skos:Concept ;
    skos:definition "Noninflammatory degenerative disease of the retina." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retinopathy" .

goldbook:11182 a skos:Concept ;
    skos:altLabel "X-linked retinoschisis",
        "juvenile retinoschisis" ;
    skos:definition "Congenital splitting of the retina into two layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congenital retinoschisis" .

goldbook:11183 a skos:Concept ;
    skos:definition "Outside of and posterior to the peritoneum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retroperitoneal" .

goldbook:11184 a skos:Concept ;
    skos:definition "Approach to elucidating the function of a gene by studying the effects on phenotype of expressed variations in a known DNA sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse genetics" .

goldbook:11185 a skos:Concept ;
    skos:altLabel "Rh",
        "Rh factor" ;
    skos:definition "Antigen that occurs on the red blood cells of about 85 per cent of humans and can cause hemolytic disease of the newborn (erythroblastosis fetalis) and hemolytic transfusion reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhesus factor" .

goldbook:11186 a skos:Concept ;
    skos:altLabel "hindbrain" ;
    skos:definition "Posterior portion of the brain that includes the cerebellum, pons, and medulla." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhombencephalon" .

goldbook:11187 a skos:Concept ;
    skos:altLabel "RNAi" ;
    skos:definition "Effect of small, often double-stranded RNA targeting a specific messenger RNA (mRNA), blocking its translation, and thereby silencing expression of the corresponding gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "RNA interference" .

goldbook:11188 a skos:Concept ;
    skos:definition "Chromosomal translocation in which chromosomes with acrocentric centromeres break the centromere to fuse the long arms into a new large chromosome and the short arms into another small one that may be lost, leaving a karyotype in the human of \\(\\pu{45}\\) chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Robertsonian translocation" .

goldbook:11189 a skos:Concept ;
    skos:definition "Pertaining to, resembling, or having a rostrum or beak. Situated toward the beak (thus, oral and nasal region), which may mean superior (in relationships of areas of the spinal cord) or anterior or ventral (in relationships of brain areas). Closer to the head." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rostral" .

goldbook:11190 a skos:Concept ;
    skos:definition "Smallest and weakest animal of a litter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "runt" .

goldbook:11191 a skos:Concept ;
    skos:altLabel "caudal regression syndrome" ;
    skos:definition "Absence or significant underdevelopment of the lower part of the spine and the lower limbs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sacral agenesis" .

goldbook:11192 a skos:Concept ;
    skos:definition "Vertical (longitudinal) plane dividing the body into right and left sections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sagittal" .

goldbook:11193 a skos:Concept ;
    skos:definition "Surgical removal of the Fallopian tubes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salpingectomy" .

goldbook:11194 a skos:Concept ;
    skos:definition "Mutagenesis screening in which a large number of mutations are introduced in a target area of the genome with the aim of identifying all the genes or their functions that are associated with that area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation mutagenesis" .

goldbook:11195 a skos:Concept ;
    skos:definition "Elongated and narrow head with decrease of the parietal regions and conspicuous frontal and occipital protrusions; a type of craniosynostosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaphocephaly" .

goldbook:11196 a skos:Concept ;
    skos:definition "Abnormal lateral and rotational curvature of the vertebral spinal column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scoliosis" .

goldbook:11197 a skos:Concept ;
    skos:definition "Pouch of skin containing the testicles and their accessory tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scrotum" .

goldbook:11198 a skos:Concept ;
    skos:definition "Feature of the adult animal, appearing during puberty in humans and distinct between the sexes, although not part of the reproductive system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary sexual characteristic" .

goldbook:11199 a skos:Concept ;
    skos:definition "Sudden change in neural activity, leading to convulsions and (or) changes in consciousness of varying degrees of severity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seizure" .

goldbook:11200 a skos:Concept ;
    skos:definition "Member of a group of genes that codes factors driving differentiation and regional patterning during development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selector gene" .

goldbook:11201 a skos:Concept ;
    skos:definition "Depression on the upper surface of the sphenoid bone, accommodating the pituitary gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sella turcica" .

goldbook:11202 a skos:Concept ;
    skos:altLabel "ejaculate (<em>n.</em>)",
        "seminal fluid" ;
    skos:definition "Fluid, containing spermatozoa, that is expelled from the penis during ejaculation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semen" .

goldbook:11203 a skos:Concept ;
    skos:definition "One of a pair of glands of the male reproductive system that together produce a significant portion of the semen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seminal vesicle" .

goldbook:11204 a skos:Concept ;
    skos:definition "One of numerous coiled tubes, found in the testis, in the walls of which spermatogenesis occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seminiferous tubule" .

goldbook:11205 a skos:Concept ;
    skos:definition "Model organism containing a mutation in a pathway (e.g., metabolic or signal transducing) that does not itself cause a change in phenotype, but makes the organism more sensitive to another change elsewhere in the pathway." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitized strain" .

goldbook:11206 a skos:Concept ;
    skos:definition "In anatomy, thin wall dividing two cavities or masses of softer tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "septum" .

goldbook:11207 a skos:Concept ;
    skos:definition "Containing, resembling, or secreting serum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "serous" .

goldbook:11208 a skos:Concept ;
    skos:definition "Somatic cell in the seminiferous tubule that supports spermatogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sertoli cell" .

goldbook:11209 a skos:Concept ;
    skos:altLabel "arrhenoblastoma" ;
    skos:definition "Ovarian tumor composed of both Sertoli and Leydig cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sertoli–Leydig cell tumor" .

goldbook:11210 a skos:Concept ;
    skos:altLabel "Barr body" ;
    skos:definition "Condensed mass of one inactivated X chromosome seen inside the nuclear membrane of an interphase cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sex chromatin" .

goldbook:11211 a skos:Concept ;
    skos:definition "One of the pair of chromosomes determining sex; in humans designated an X chromosome and a Y chromosome, with females having an XX genotype and males an XY genotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sex chromosome" .

goldbook:11212 a skos:Concept ;
    skos:altLabel "SRY",
        "SRY protein",
        "testis-determining factor (TDF)" ;
    skos:definition "Transcription factor coded by a gene on the Y chromosome that initiates development of the male sex organs (i.e., testicular differentiation) in the embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sex-determining region Y protein" .

goldbook:11213 a skos:Concept ;
    skos:definition "Phenotypic difference between the sexes of a species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sexual dimorphism" .

goldbook:11214 a skos:Concept ;
    skos:altLabel "SDN" ;
    skos:definition "Compact area of large cells in the anterior hypothalamus, larger in men than women, and believed to influence sexual behaviour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sexually dimorphic nucleus" .

goldbook:11215 a skos:Concept ;
    skos:definition "Process of reaching the age or stage when an organism can reproduce sexually." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sexual maturation" .

goldbook:11216 a skos:Concept ;
    skos:definition "Age or stage when an organism can reproduce sexually." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sexual maturity" .

goldbook:11217 a skos:Concept ;
    skos:definition "Creation of a new organism requiring combination of the genetic material from two different sexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sexual reproduction" .

goldbook:11218 a skos:Concept ;
    skos:altLabel "sib" ;
    skos:definition "One of two or more individuals with a common pair of parents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sibling" .

goldbook:11219 a skos:Concept ;
    skos:definition "Process whereby a signal arising outside the cell is converted through a series of intermediate chemical reactions inside the cell to produce a functional change in the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signal transduction" .

goldbook:11220 a skos:Concept ;
    skos:altLabel "sinuatrial node" ;
    skos:definition "Mass of specialized cardiac muscle cells ('pacemaker cells') that spontaneously depolarize to initiate rhythmic contraction of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sinoatrial node" .

goldbook:11221 a skos:Concept ;
    skos:definition "Hollow or cavity. Channel for the passage of fluid, lacking the usual lining of a blood or lymphatic vessel; especially a dilatation for the passage of venous blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sinus" .

goldbook:11222 a skos:Concept ;
    skos:altLabel "venous sinus" ;
    skos:definition "Cavity at the caudal end of the developing embryonic heart where intra- and extra-embryonic veins meet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sinus venosus" .

goldbook:11223 a skos:Concept ;
    skos:altLabel "SCE" ;
    skos:definition "Reciprocal exchange of chromatin between two replicated chromosomes that remain attached to each other until anaphase of mitosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sister chromatid exchange" .

goldbook:11224 a skos:Concept ;
    skos:definition "Developmental anomaly in which major visceral organs are found in a mirrored position to their normal location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "situs inversus" .

goldbook:11225 a skos:Concept ;
    skos:altLabel "siRNA",
        "siRNA molecule" ;
    skos:definition "Short interfering RNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "small interfering RNA molecule" .

goldbook:11226 a skos:Concept ;
    skos:definition "Pertaining to the body or describing cells that form the body other than germ line cells or undifferentiated stem cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic" .

goldbook:11227 a skos:Concept ;
    skos:altLabel "SHM",
        "mutation (in immunology)" ;
    skos:definition "Programmed process of mutation affecting the variable (V) regions of immunoglobulin (Ig) genes. SHM affects only individual immune cells, and the mutations are not transmitted to offspring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic hypermutation" .

goldbook:11228 a skos:Concept ;
    skos:altLabel "human placental lactogen (hPL)" ;
    skos:definition "Placental hormone that affects maternal metabolism and supports fetal growth by making more glucose and fatty acids available to the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human chorionic somatomammotropin" .

goldbook:11229 a skos:Concept ;
    skos:definition "Any of a group of peptide growth factors produced by the liver following stimulation by somatotropin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatomedin" .

goldbook:11230 a skos:Concept ;
    skos:altLabel "growth hormone" ;
    skos:definition "Hormone produced in the pituitary gland that stimulates the liver to produce somatomedin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatotropin" .

goldbook:11231 a skos:Concept ;
    skos:definition "One of bilaterally paired, segmented masses of mesodermal tissue lying along the notochord that gives rise to the vertebrae and associated muscle and connective tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somite" .

goldbook:11232 a skos:Concept ;
    skos:definition "Protein morphogen produced in the notochord that plays a critical role in early development, including vertebrate organogenesis, brain development and limb formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonic hedgehog" .

goldbook:11233 a skos:Concept ;
    skos:definition "(v) Release gametes. (Of mature adult fish, frogs, molluscs, crustacea, etc.). (n) Fertilized eggs of mature adult fish, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spawn" .

goldbook:11234 a skos:Concept ;
    skos:definition "(n) Release of gametes (eggs or sperm) from mature adult fish, frogs, molluscs, crustacea, etc. (adj) Describing behavior related to the readiness of mature adult fish, etc. to release gametes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spawning" .

goldbook:11235 a skos:Concept ;
    skos:definition "Group of cells in the amphibian embryo that is important in orientation of surrounding cells and facilitates development of the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Spemann organizer" .

goldbook:11236 a skos:Concept ;
    skos:definition "Storage of frozen donor sperm for use in artificial insemination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sperm banking" .

goldbook:11237 a skos:Concept ;
    skos:definition "Haploid cell in the late stage of developing into a spermatozoon, derived from the secondary spermatocyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatid" .

goldbook:11238 a skos:Concept ;
    skos:altLabel "spermicide" ;
    skos:definition "Agent that kills spermatozoa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatocide" .

goldbook:11239 a skos:Concept ;
    skos:definition "Parent cell of a spermatid, derived by mitotic division from a spermatogonium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatocyte" .

goldbook:11240 a skos:Concept ;
    skos:definition "Entire process by which spermatogonial stem cells divide and differentiate into spermatozoa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatogenesis" .

goldbook:11241 a skos:Concept ;
    skos:definition "Procedure in which rodents are exposed to a test substance and chromosome aberrations are then studied microscopically in germ cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatogonial chromosome aberration test" .

goldbook:11242 a skos:Concept ;
    skos:definition "Primitive cell derived from mitosis of the germ cell that becomes the diploid primary spermatocyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatogonium" .

goldbook:11243 a skos:Concept ;
    skos:altLabel "sperm",
        "sperm cell" ;
    skos:definition "Mature male gamete." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermatozoon" .

goldbook:11244 a skos:Concept ;
    skos:definition "Release of mature spermatozoa from the Sertoli cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermiation" .

goldbook:11245 a skos:Concept ;
    skos:definition "Maturation of an immature spermatid into a spermatozoon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spermiogenesis" .

goldbook:11246 a skos:Concept ;
    skos:altLabel "sphenoid" ;
    skos:definition "Irregular wing-shaped bone at the anterior base of the skull, forming part of the orbit, serving as an attachment site for muscles of mastication, and containing foramina for nerves and vessels of the head and neck." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sphenoid bone" .

goldbook:11247 a skos:Concept ;
    skos:definition "Ringlike muscle that maintains closure of a body passage or orifice by contracting, and opens it by relaxing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sphincter" .

goldbook:11248 a skos:Concept ;
    skos:definition "Failure of the neural tube to close, resulting in the absence of part of the vertebral arch at the midline of the spinal column and exposure of the spinal cord and its covering membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spina bifida" .

goldbook:11249 a skos:Concept ;
    skos:altLabel "spine",
        "vertebral column" ;
    skos:definition "Backbone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spinal column" .

goldbook:11250 a skos:Concept ;
    skos:definition "Portion of the central nervous system outside the brain and inside the vertebral column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spinal cord" .

goldbook:11251 a skos:Concept ;
    skos:altLabel "coiled artery of the uterus",
        "corkscrew-like artery",
        "spiral artery",
        "spiral endometrial artery" ;
    skos:definition "One of the corkscrew-like arterioles in premenstrual or progestational endometrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spiral arteriole" .

goldbook:11252 a skos:Concept ;
    skos:definition "Relating to the visceral organs, especially those of the abdomen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "splanchnic" .

goldbook:11253 a skos:Concept ;
    skos:definition "Embryonic epithelial cell that develops into a neuroglial cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spongioblast" .

goldbook:11254 a skos:Concept ;
    skos:definition "In anatomy, narrow connection with an organ or other structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stalk" .

goldbook:11255 a skos:Concept ;
    skos:definition "Narrow connecting tube between the intra- and extra-embryonic parts of the allantois." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allantoic stalk" .

goldbook:11256 a skos:Concept ;
    skos:definition "Abnormal narrowing of a passage or opening in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stenosis" .

goldbook:11257 a skos:Concept ;
    skos:definition "Infertility. Asepsis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sterility" .

goldbook:11258 a skos:Concept ;
    skos:definition "Process that makes an organism incapable of fertilization or reproduction, e.g., castration, vasectomy, or salpingectomy. Process that makes an object aseptic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sterilization" .

goldbook:11259 a skos:Concept ;
    skos:definition "Naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at \\(\\ce{C-10}\\) and \\(\\ce{C-13}\\), and often an alkyl group at \\(\\ce{C-17}\\). By extension, one or more bond scissions, ring expansions, and/or ring contractions of the skeleton may have occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steroid" .

goldbook:11260 a skos:Concept ;
    skos:altLabel "21-hydroxylase" ;
    skos:definition "Member (EC 1.14.14.16) of the cytochrome P450 family of enzymes required for the synthesis of some steroid hormones including aldosterone and cortisol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steroid 21-monooxygenase" .

goldbook:11261 a skos:Concept ;
    skos:definition "Procedure in which the effect of a test substance on steroid synthesis is studied, usually in a human adrenocortical carcinoma cell line." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steroidogenesis assay" .

goldbook:11262 a skos:Concept ;
    skos:definition "Birth of a baby without any signs of life, at a time variously taken as \\(\\pu{20\\!{-}\\! 28 weeks}\\) of pregnancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stillbirth" .

goldbook:11263 a skos:Concept ;
    skos:definition "Signaling events induced when normal cell function or development is disrupted by environmental (physical or chemical) factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress-response pathway" .

goldbook:11264 a skos:Concept ;
    skos:definition "Cell producing the connective tissue framework of an organ or other anatomical structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stromal cell" .

goldbook:11265 a skos:Concept ;
    skos:altLabel "prethalamus",
        "ventral thalamus" ;
    skos:definition "Part of the diencephalon, of which the major part is the subthalamic nucleus, and which connects to the globus pallidus, part of the telencephalon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subthalamus" .

goldbook:11266 a skos:Concept ;
    skos:definition "Any long, narrow groove, furrow or shallow depression, specifically referring to one of the fissures on the surface of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulcus" .

goldbook:11267 a skos:Concept ;
    skos:definition "Fertilization of two or more ova released in the same period of ovulation, either by different males or by the same male in separate acts of intercourse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superfecundation" .

goldbook:11268 a skos:Concept ;
    skos:definition "Presence of two fetuses in the uterus at different stages of development, resulting from fertilization of ova released in two successive periods of ovulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superfetation" .

goldbook:11269 a skos:Concept ;
    skos:definition "Exceeding the usual number; thus, in anatomy, anomalies such as a sixth finger on one hand or a third nipple (in a human)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supernumerary" .

goldbook:11270 a skos:Concept ;
    skos:definition "Surface-active layer of phospholipids and proteins coating the pulmonary alveoli that increases lung compliance, facilitates lung expansion, and stabilizes alveolar volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulmonary surfactant" .

goldbook:11271 a skos:Concept ;
    skos:altLabel "syndesis" ;
    skos:definition "Point-wise pairing of homologous chromosomes during the prophase of meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synapsis" .

goldbook:11272 a skos:Concept ;
    skos:definition "Structure of filamentous proteins that forms between homologous chromosomes when they pair during meiosis; it may contribute to synapsis and genetic recombination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synaptonemal complex" .

goldbook:11273 a skos:Concept ;
    skos:altLabel "monocephalus" ;
    skos:definition "Conjoined twins with two bodies and a fused head." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syncephalus" .

goldbook:11274 a skos:Concept ;
    skos:definition "Outer syncytial layer of trophoblast cells that invades the endometrium during implantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syncytiotrophoblast" .

goldbook:11275 a skos:Concept ;
    skos:definition "Referring to a large multinucleated mass of cellular contents that arises from the fusion of originally individual cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syncytium" .

goldbook:11276 a skos:Concept ;
    skos:definition "Congenital occurrence of fusion or webbing of the fingers or toes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syndactyly" .

goldbook:11277 a skos:Concept ;
    skos:definition "Group of signs and symptoms occurring together, having a common cause and defining a disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syndrome" .

goldbook:11278 a skos:Concept ;
    skos:altLabel "cyclopia",
        "monophthalmos" ;
    skos:definition "Congenital fusion of the orbits in the midline, which then contains one eyeball." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synophthalmia" .

goldbook:11279 a skos:Concept ;
    skos:definition "Congenital malformation characterized by the union or approximation of the ears in front of the neck, often accompanied by the absence or defective development of the lower jaw." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synotia" .

goldbook:11280 a skos:Concept ;
    skos:definition "In the vertebrate embryo, mass of proliferating cells at the caudal end that arises from the primitive node." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tail bud" .

goldbook:11281 a skos:Concept ;
    skos:altLabel "infantile GM2 gangliosidosis" ;
    skos:definition "Autosomal recessive inheritance of hexosaminidase A deficiency leading to a lysosomal storage disease characterized by central and peripheral neuronal involvement and early death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tay–Sachs disease" .

goldbook:11282 a skos:Concept ;
    skos:definition "Floor of the midbrain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tegmentum" .

goldbook:11283 a skos:Concept ;
    skos:definition "Embryonic structure that develops into the cerebrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "telencephalon" .

goldbook:11284 a skos:Concept ;
    skos:definition "Final phase of both meiosis and mitosis in which distinct nuclei form in each daughter cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "telophase" .

goldbook:11285 a skos:Concept ;
    skos:definition "Malignant teratoma, occurring most often in the testis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratocarcinoma" .

goldbook:11286 a skos:Concept ;
    skos:definition "Chemical, physical, or biological agent that, when administered to a parent either prior to conception or before birth of the child, induces permanent structural malformations or birth defects in the offspring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratogen" .

goldbook:11287 a skos:Concept ;
    skos:definition "Process of development of malformations or birth defects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratogenesis" .

goldbook:11288 a skos:Concept ;
    skos:definition "Study of how genes and teratogens interact to cause birth defects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratogenetics" .

goldbook:11289 a skos:Concept ;
    skos:altLabel "TI" ;
    skos:definition "Mortality of eggs expressed as a lethal concentration divided by the threshold concentration for production of abnormal embryos with nonheritable permanent structural malformations or defects following exposure to a teratogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratogenic index" .

goldbook:11290 a skos:Concept ;
    skos:definition "Inherent ability to act as a teratogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratogenicity" .

goldbook:11291 a skos:Concept ;
    skos:definition "Study of the causes, mechanisms, and manifestations of developmental deviation of either structure or function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratology" .

goldbook:11292 a skos:Concept ;
    skos:altLabel "dermoid cyst" ;
    skos:definition "Benign germ cell-derived tumor containing embryonic elements of the three primary germ layers, such as skin, hair, and muscle, occurring most frequently in the ovary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratoma" .

goldbook:11293 a skos:Concept ;
    skos:definition "Classification of bony and soft tissue facial clefts based on their anatomic location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tessier classification" .

goldbook:11294 a skos:Concept ;
    skos:definition "Type of male pseudohermaphroditism in which the individual has a male karyotype and testes present within the abdominal cavity, but develops external female genitalia and female secondary sexual characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "testicular feminization" .

goldbook:11295 a skos:Concept ;
    skos:altLabel "testicle" ;
    skos:definition "Gonad of a male animal, involved in the secretion of androgens and the site of sperm production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "testis" .

goldbook:11296 a skos:Concept ;
    skos:definition "Androgenic steroid hormone produced primarily in the testis, responsible for the development of the male sexual organs and male secondary sexual characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "testosterone" .

goldbook:11297 a skos:Concept ;
    skos:definition "Set of four congenital cardiac defects involving an opening in the wall that should separate the right and left ventricles (ventricular septal defect), allowing the aorta to receive venous as well as arterial blood: including stenosis of the pulmonary artery, hypertrophy of the right ventricle, and displacement of the aorta. Right ventricular hypertrophy is the fourth part of the tetralogy, although it may also be a consequence of the other defects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetralogy of Fallot" .

goldbook:11298 a skos:Concept ;
    skos:definition "Either of two masses of grey matter, the largest part of the diencephalon, lying between the cerebral hemispheres on either side of the third ventricle, relaying sensory information and acting as a centre for pain perception." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thalamus" .

goldbook:11299 a skos:Concept ;
    skos:definition "Teratogenic indole-based drug with sedative and anti-angiogenic properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thalidomide" .

goldbook:11300 a skos:Concept ;
    skos:definition "Bilayer covering of the ovarian follicle (thus theca interna and externa), of which the theca interna is involved in production of androstenedione." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "theca" .

goldbook:11301 a skos:Concept ;
    skos:definition "Largest of the lymphatic vessels; it conducts lymph from its origin in the abdomen to the venous circulation at the junction of the left subclavian and jugular veins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thoracic duct" .

goldbook:11302 a skos:Concept ;
    skos:definition "Abnormally low concentration of platelets (thrombocytes) in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thrombocytopenia" .

goldbook:11303 a skos:Concept ;
    skos:definition "Pyramid-shaped organ in the thoracic or cervical region of mammals, composed of lymphatic tissue in which minute concentric bodies (thymic corpuscles, the remnants of epithelial structures) are found." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymus" .

goldbook:11304 a skos:Concept ;
    skos:definition "Connection in the embryo between the site of initiation of development of the thyroid gland and its final location in the neck." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyroglossal duct" .

goldbook:11305 a skos:Concept ;
    skos:definition "Bilobar endocrine gland, located below the prominence of cartilage surrounding the larynx (the Adam’s apple), that produces and secretes the hormones triiodothyronine (T3), thyroxin (T4), and calcitonin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyroid gland" .

goldbook:11306 a skos:Concept ;
    skos:definition "Ectopic thyroid tissue arising from remnants of the thyroglossal duct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessory thyroid tissue" .

goldbook:11307 a skos:Concept ;
    skos:altLabel "TSH" ;
    skos:definition "Pituitary hormone that stimulates the thyroid gland to produce thyroxine (T4), and then triiodothyronine (T3)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyroid stimulating hormone" .

goldbook:11308 a skos:Concept ;
    skos:definition "Small, rounded mass of tissue, especially of lymphoid tissue; generally used to designate one of the paired palatine tonsils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tonsil" .

goldbook:11309 a skos:Concept ;
    skos:definition "Infection with the parasite Toxoplasma gondii that, when acquired by the fetus, can lead to a variety of congenital abnormalities that may include hydrocephalus or microcephaly, mental retardation, and problems with vision and hearing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxoplasmosis" .

goldbook:11310 a skos:Concept ;
    skos:definition "Thin-walled, cartilaginous tube descending from the larynx to the bronchi and carrying air to the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trachea" .

goldbook:11311 a skos:Concept ;
    skos:definition "DNA-binding protein that is involved in regulating gene expression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcription factor" .

goldbook:11312 a skos:Concept ;
    skos:definition "Describing an organism that is genetically changed by the addition or deletion of genetic material or whose existing genes are altered by gene targeting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transgenic" .

goldbook:11313 a skos:Concept ;
    skos:definition "Rearrangement involving transfer or exchange of genetic material between non-homologous chromosomes that may occur during gametogenesis or in somatic cells, potentially leading to birth defects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosomal translocation" .

goldbook:11314 a skos:Concept ;
    skos:definition "Substance that crosses the placenta and subsequently causes cancer in the child or young adult." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transplacental carcinogen" .

goldbook:11315 a skos:Concept ;
    skos:altLabel "transposition of the great vessels" ;
    skos:definition "Congenital cardiovascular malformation in which the position of the chief blood vessels of the heart (aorta and pulmonary artery) is reversed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transposition of the great arteries" .

goldbook:11316 a skos:Concept ;
    skos:altLabel "Treacher Collins–Franceschetti syndrome",
        "mandibulofacial dysostosis" ;
    skos:definition "Congenital deformity characterized by structural abnormalities of the head and face." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Treacher Collins syndrome" .

goldbook:11317 a skos:Concept ;
    skos:altLabel "trilaminary blastoderm" ;
    skos:definition "Disc-like embryonic stage in which differentiation into three layers (endoderm, mesoderm, and ectoderm) has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trilaminar embryo" .

goldbook:11318 a skos:Concept ;
    skos:definition "In pregnancy, one of three equal timed divisions of the normal human gestation period, each lasting approximately three months." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trimester" .

goldbook:11319 a skos:Concept ;
    skos:altLabel "triple test" ;
    skos:definition "Measurement of maternal serum levels of alpha-fetoprotein, human chorionic gonadotropin, and estriol, usually in the second trimester of pregnancy, that can serve as an indicator of risk for certain fetal chromosomal abnormalities and neural tube defects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triple screen" .

goldbook:11320 a skos:Concept ;
    skos:definition "Presence of three haploid sets of chromosomes in the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triploidy" .

goldbook:11321 a skos:Concept ;
    skos:definition "Condition of having three homologous chromosomes in each somatic cell instead of the normal pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trisomy" .

goldbook:11322 a skos:Concept ;
    skos:altLabel "Warkany syndrome 2" ;
    skos:definition "Presence of an extra chromosome 8." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trisomy 8" .

goldbook:11323 a skos:Concept ;
    skos:altLabel "Patau syndrome",
        "trisomy D" ;
    skos:definition "Presence of part or all of an extra chromosome 13 from nondisjunction during meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trisomy 13" .

goldbook:11324 a skos:Concept ;
    skos:altLabel "Edwards syndrome" ;
    skos:definition "Presence of part or all of an extra chromosome 18 from nondisjunction during meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trisomy 18" .

goldbook:11325 a skos:Concept ;
    skos:altLabel "Down syndrome" ;
    skos:definition "Presence of an extra chromosome 21." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trisomy 21" .

goldbook:11326 a skos:Concept ;
    skos:definition "Outer layer of the blastocyst that contacts the endometrium, establishes nutrition for the embryo, and differentiates into the trophoblast." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophectoderm" .

goldbook:11327 a skos:Concept ;
    skos:definition "Outer layer of the blastocyst that invades the endometrium and establishes nutrition for the embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophoblast" .

goldbook:11328 a skos:Concept ;
    skos:definition "Arterial trunk, opening from the fetal heart and developing into the aorta and pulmonary artery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "truncus arteriosus" .

goldbook:11329 a skos:Concept ;
    skos:definition "Group of dopaminergic neurons in the hypothalamus involved in regulating prolactin secretion from the anterior pituitary gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tuberoinfundibular pathway" .

goldbook:11330 a skos:Concept ;
    skos:altLabel "tumour" ;
    skos:definition "Any abnormal swelling or growth of tissue, whether benign or malignant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor" .

goldbook:11331 a skos:Concept ;
    skos:definition "Dense, collagenous fibrous coat surrounding an anatomical structure, and in particular surrounding the ovaries, testicles, and corpora cavernosa of the penis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tunica albuginea" .

goldbook:11332 a skos:Concept ;
    skos:definition "Membranous sheath, derived from the peritoneum, surrounding the testis and epididymis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tunica vaginalis" .

goldbook:11333 a skos:Concept ;
    skos:altLabel "Ullrich–Turner syndrome" ;
    skos:definition "Phenotypic female lacking one X chromosome, the genotype being designated XO." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "turner syndrome" .

goldbook:11334 a skos:Concept ;
    skos:definition "Procedure in rodents wherein parents (P0 generation) and their offspring (F1 generation) are both exposed to a test substance and the second generation (F2) is examined for possible toxic effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-generation reprotox study" .

goldbook:11335 a skos:Concept ;
    skos:definition "In anatomy, relating to the resonant cavity and membrane of the inner ear." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tympanic" .

goldbook:11336 a skos:Concept ;
    skos:definition "Imaging technique that creates a picture of internal body structures from differentially reflected ultrasound waves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrasonography" .

goldbook:11337 a skos:Concept ;
    skos:definition "Sound waves of frequency higher than the range audible to the human ear. Imaging technique that uses such sound waves to create a picture of internal body structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrasound" .

goldbook:11338 a skos:Concept ;
    skos:definition "Paired artery that, in the fetus, returns deoxygenated blood from each half of the fetal body to the placenta, via the umbilical cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umbilical artery" .

goldbook:11339 a skos:Concept ;
    skos:definition "Cord-like structure connecting the fetus with the placenta and housing the umbilical artery and umbilical vein that carry nutrients from the mother and remove wastes from the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umbilical cord" .

goldbook:11340 a skos:Concept ;
    skos:definition "Protrusion of bowel or omentum through the abdominal wall at the umbilicus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umbilical hernia" .

goldbook:11341 a skos:Concept ;
    skos:altLabel "left umbilical vein" ;
    skos:definition "Vessel within the umbilical cord, entering the fetus at the umbilicus and carrying oxygenated blood from the placenta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umbilical vein" .

goldbook:11342 a skos:Concept ;
    skos:altLabel "cryptorchid testis",
        "cryptorchidism" ;
    skos:definition "Testis that has failed to descend completely from its developmental origin in the lower abdominal cavity into the scrotum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "undescended testis" .

goldbook:11343 a skos:Concept ;
    skos:definition "Duct by which urine is conveyed out of the body from the bladder, and which in male vertebrates also conveys semen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "urethra" .

goldbook:11344 a skos:Concept ;
    skos:altLabel "genitourinary" ;
    skos:definition "Concerning the urinary and genital organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "urogenital" .

goldbook:11345 a skos:Concept ;
    skos:definition "Embryonic structure that forms in the ventral part of the cloaca when it separates from the anal canal to give rise to the genitourinary organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "urogenital sinus" .

goldbook:11346 a skos:Concept ;
    skos:definition "Chamber on the interior surface of the uterus that serves as a site of embryo homing and implantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uterine crypt" .

goldbook:11347 a skos:Concept ;
    skos:definition "Regular, periodic changes that occur in the uterus and, together with the ovarian cycle constitute the menstrual cycle necessary for female fertility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uterine cycle" .

goldbook:11348 a skos:Concept ;
    skos:altLabel "uterotropic" ;
    skos:definition "Having an effect on the uterus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uterotrophic" .

goldbook:11349 a skos:Concept ;
    skos:definition "Procedure in which immature female rodents are treated for three days with a test substance. A resultant increase in uterine wet weight suggests an estrogenic activity of the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uterotrophic assay" .

goldbook:11350 a skos:Concept ;
    skos:altLabel "womb" ;
    skos:definition "Hollow muscular organ of the female reproductive system that receives the fertilized ovum (see implantation) and supports the subsequent development of the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uterus" .

goldbook:11351 a skos:Concept ;
    skos:altLabel "palatine uvula" ;
    skos:definition "Muscular projection from the posterior edge of the soft palate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uvula" .

goldbook:11352 a skos:Concept ;
    skos:definition "Fibromuscular canal passing between the uterine cervix and the opening to the vulva." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vagina" .

goldbook:11353 a skos:Concept ;
    skos:definition "Conversion of the normal epithelium of the vagina to a keratinized squamous (flattened) epithelium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vaginal cornification" .

goldbook:11354 a skos:Concept ;
    skos:definition "Referring to the opening of the vagina that usually occurs at sexual maturity and is maintained by hormonal influences pre-menopausally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vaginal patency" .

goldbook:11355 a skos:Concept ;
    skos:definition "Examination by light microscopy of a sample of a vaginal discharge, used in the diagnosis of a vaginal infection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vaginal smear" .

goldbook:11356 a skos:Concept ;
    skos:definition "Anatomical deviation that is not life-threatening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental variation" .

goldbook:11357 a skos:Concept ;
    skos:definition "De novo development of blood vessel endothelium in absence of preexisting vessels, e.g., during fetal development or in connection with tissue repair, initiated by migration of mesodermal precursor cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasculogenesis" .

goldbook:11358 a skos:Concept ;
    skos:altLabel "ductus deferens",
        "spermatic duct" ;
    skos:definition "Secretory duct of the testis running between the epididymis and the ejaculatory duct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vas deferens" .

goldbook:11359 a skos:Concept ;
    skos:definition "Surgical removal of all or part of each vas deferens, typically as a means of sterilization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasectomy" .

goldbook:11360 a skos:Concept ;
    skos:altLabel "antidiuretic hormone" ;
    skos:definition "Pituitary hormone that acts to promote the retention of water by the kidneys and to increase blood pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasopressin" .

goldbook:11361 a skos:Concept ;
    skos:altLabel "velopharyngeal incompetence" ;
    skos:definition "Inability to achieve closure of the velopharyngeal sphincter (closure of the muscle of the soft palate) during speech, owing to muscular dysfunction, cleft palate, or other disorders." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "velopharyngeal insufficiency" .

goldbook:11362 a skos:Concept ;
    skos:definition "Large vein returning deoxygenated blood to the right heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vena cava" .

goldbook:11363 a skos:Concept ;
    skos:definition "Situated to the anterior side of the trunk; in humans, to the front of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventral" .

goldbook:11364 a skos:Concept ;
    skos:definition "Dividing wall between the two lower chambers (ventricles) of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventricular septum" .

goldbook:11365 a skos:Concept ;
    skos:altLabel "VSD" ;
    skos:definition "Congenital defect with an opening in the wall separating the right and left ventricles of the heart (see ventricular septum)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventricular septal defect" .

goldbook:11366 a skos:Concept ;
    skos:definition "One of the bony segments that together make up the bony column surrounding the spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vertebra" .

goldbook:11367 a skos:Concept ;
    skos:definition "Denoting an animal that has as part of its nervous system a spinal cord that is surrounded by a bony vertebral column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vertebrate" .

goldbook:11368 a skos:Concept ;
    skos:definition "Small fluid-filled sac, bladder-like structure, or blister." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vesicle" .

goldbook:11369 a skos:Concept ;
    skos:definition "In anatomy, pertaining to a remnant of an embryonic or fetal structure persisting in the adult." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vestigial" .

goldbook:11370 a skos:Concept ;
    skos:definition "Ability to continue living." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viability" .

goldbook:11371 a skos:Concept ;
    skos:definition "Projection from the surface, typically of a mucous membrane. Elongated projection of the dermis into an epidermal space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "villus" .

goldbook:11372 a skos:Concept ;
    skos:definition "Intermediate filament protein that is expressed in mesenchymal cells, e.g., fibroblasts, leukocytes, and blood vessel endothelial cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vimentin" .

goldbook:11373 a skos:Concept ;
    skos:definition "Possession or acquisition of characteristics of a male body, especially by a female or prepubescent male." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virilization" .

goldbook:11374 a skos:Concept ;
    skos:definition "Soft and hollow organs of the body, in vertebrates particularly those found in the thoracic and abdominal cavities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viscera" .

goldbook:11375 a skos:Concept ;
    skos:altLabel "VTG" ;
    skos:definition "Protein that forms part of the yolk of egg-laying vertebrates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vitellogenin" .

goldbook:11376 a skos:Concept ;
    skos:definition "External genitalia of the female." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vulva" .

goldbook:11377 a skos:Concept ;
    skos:definition "Accustomize a young mammal to independence from its mother’s milk as a source of nutrition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wean" .

goldbook:11378 a skos:Concept ;
    skos:altLabel "webbing" ;
    skos:definition "Tissue or membrane present between adjacent structures where it is not usually found, e.g., between fingers or toes, or between the neck and shoulder, representing a congenital abnormality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "web" .

goldbook:11379 a skos:Concept ;
    skos:definition "Gelatinous substance that embeds the vessels of the umbilical cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wharton’s jelly" .

goldbook:11380 a skos:Concept ;
    skos:altLabel "substantia alba" ;
    skos:definition "Portion of the brain and spinal cord consisting mainly of myelinated axons (see myelination) and glial cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "white matter" .

goldbook:11381 a skos:Concept ;
    skos:definition "Technique, used prior to embryo transfer during in vitro fertilization, in which embryos undergoing organogenesis are maintained in formulated medium outside the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "whole embryo culture" .

goldbook:11382 a skos:Concept ;
    skos:definition "Of an allele or phenotype, the naturally occurring, unaltered, or most frequent; if several alleles occur, the most frequent one is considered to be the wild type." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wild type" .

goldbook:11383 a skos:Concept ;
    skos:altLabel "elfin facies syndrome" ;
    skos:definition "Congenital disorder with characteristic facies (described as elf-like), short stature, outgoing personality and mild mental retardation; associated with contiguous gene deletions on chromosome 7." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Williams syndrome" .

goldbook:11384 a skos:Concept ;
    skos:definition "Family of genes important in development, the proteins they encode, or the signal transduction pathways they determine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wnt" .

goldbook:11385 a skos:Concept ;
    skos:definition "Chromosome determining female sex in the absence of a Y chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X chromosome" .

goldbook:11386 a skos:Concept ;
    skos:definition "Carried by a gene located on the X chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-linked" .

goldbook:11387 a skos:Concept ;
    skos:definition "Chromosome determining male sex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Y chromosome" .

goldbook:11388 a skos:Concept ;
    skos:altLabel "vitellus" ;
    skos:definition "Nutritive material stored in the ovum for the nourishment of the embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "yolk" .

goldbook:11389 a skos:Concept ;
    skos:definition "Fluid-filled, membrane-bound pouch on the ventral side of the early embryo that provides nourishment until the circulatory system develops." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "yolk sac" .

goldbook:11390 a skos:Concept ;
    skos:definition "Narrow tubular support that connects the yolk sac to the middle of the digestive tract of an embryo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "yolk stalk" .

goldbook:11391 a skos:Concept ;
    skos:definition "Small tertiary protein structure in which parts of the protein, typically with cysteine and histidine residues, link to a divalent zinc ion, forming a loop or 'finger' that attaches proteins to DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zinc finger" .

goldbook:11392 a skos:Concept ;
    skos:definition "Acellular glycoprotein-rich membrane surrounding the mature ovum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zona pellucida" .

goldbook:11393 a skos:Concept ;
    skos:definition "Sexual union of two cells with fusion of their nuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zygosis" .

goldbook:11394 a skos:Concept ;
    skos:altLabel "ZIFT",
        "tubal embryo transfer" ;
    skos:definition "Introduction of a zygote fertilized in vitro into one of the Fallopian tubes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zygote intrafallopian transfer" .

goldbook:11395 a skos:Concept ;
    skos:definition "An observed or calculated property of the whole molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "1D property descriptor" .

goldbook:11396 a skos:Concept ;
    skos:definition "The structure of a molecule encoded into a string such as SMILES or InChI." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "1D structure" .

goldbook:11397 a skos:Concept ;
    skos:definition "A molecular property that is calculated from the structure diagram of the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "2D property" .

goldbook:11398 a skos:Concept ;
    skos:definition "The structure of a molecule presented as a drawing or a file that contains a description of the topology, stereochemistry, and atomic symbol of its atoms and the bonds connecting them, but no explicit information about its three-dimensional structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "2D structure" .

goldbook:11399 a skos:Concept ;
    skos:altLabel "2D-QSAR",
        "two-dimensional quantitative structure-activity relationships" ;
    skos:definition "A computational model of the quantitative relationship between the observed independent 1D property of a set of compounds and their dependent 1D properties or 2D properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "2D quantitative structure-activity relationships" .

goldbook:11400 a skos:Concept ;
    skos:definition "A property that is observed or calculated from a 3D representation of a molecule, which may depend on one or more conformations of the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "3D property" .

goldbook:11401 a skos:Concept ;
    skos:definition "A virtual screening method that processes a chemical database to discover those compounds that match a query that either contains a 3D pharmacophore, a molecular shape or field, the 3D structure, or a combination of these." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "3D searching" .

goldbook:11402 a skos:Concept ;
    skos:definition "The structure of the conformation of a molecule presented as a drawing or a file that describes atomic symbols of its atoms and the bonds connecting them as well as their coordinates in three-dimensional space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "3D structure" .

goldbook:11403 a skos:Concept ;
    skos:definition "A method to generate one or more 3D structures, conformations, of a molecule from its topological molecular graph." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "3D structure generation" .

goldbook:11404 a skos:Concept ;
    skos:altLabel "4D-QSAR" ;
    skos:definition "A computational model of the quantitative relationship between the target observed independent 1D properties for a set of compounds and the 3D properties of  several of their conformations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "4D quantitative structure-activity relationships" .

goldbook:11405 a skos:Concept ;
    skos:definition "A step-by-step procedure for solving a problem or performing a function, usually by a computer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "algorithm" .

goldbook:11406 a skos:Concept ;
    skos:definition "The property or structure space for which the predictions of a computational model are considered to be reliable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "applicability domain" .

goldbook:11407 a skos:Concept ;
    skos:altLabel "AUC" ;
    skos:definition "The area under a graph curve, such as the number of actives identified by an algorithm as a function of the number of compounds tested, commonly used as a  measure of the discriminating ability of an algorithm to correctly classify a test molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "area under the curve" .

goldbook:11408 a skos:Concept ;
    skos:definition "A vector that describes a molecular structure in which each element corresponds to a distance (number of bonds in a 2D structure or a binned interatomic  distance in a 3D structure) between atoms of a particular type and the count of the number of times that distance is found in the structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autocorrelation vector" .

goldbook:11409 a skos:Concept ;
    skos:altLabel "BSSE" ;
    skos:definition "An artifactual increase in calculated stability of the supersystem (the system formed by noncovalent interaction between two or more molecular entities, e.g. hydrogen bond system) resulting from the basis set of the supersystem being larger than for the component subsystems. The BSSE arises from a lowering of the quantum mechanical energy when the electron density of each subsystem spreads into the basis functions provided by the other subsystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basis set superposition error" .

goldbook:11410 a skos:Concept ;
    skos:definition "A feed-forward neural network that uses Bayesian statistics to optimize the complexity and predictive power of the model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bayesian regularized neural network" .

goldbook:11411 a skos:Concept ;
    skos:definition "A branch of statistics in which the evidence of the state of a system is expressed in terms of degrees of belief (probabilities)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bayesian statistics" .

goldbook:11412 a skos:Concept ;
    skos:definition "A method for calculating prior probability estimates of an event that can be revised in accordance with new observations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bayes’s theorem" .

goldbook:11413 a skos:Concept ;
    skos:definition "A method to combine probability estimate states that given two or more probabilities \\(P_{i}\\) that a particular event is true, the combined probability of the event is given by: \\[P = 1 - \\Pi (1 - {P_{i}})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "belief theory" .

goldbook:11414 a skos:Concept ;
    skos:definition "A QSAR equation that describes the non-linear dependence of the relative biological potency (\\(\\log 1/C\\)) of a molecule on log P by the following form: \\[log(1/{C_i}) = a\\log P_{i} - b \\log (\\beta P_{i} + 1) + c\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bilinear equation" .

goldbook:11415 a skos:Concept ;
    skos:altLabel "bitmap" ;
    skos:definition "A description of a molecule in a fixed length vector, each element of which is set from corresponding structural keys or calculated by hashing a molecular  fingerprint." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bit string" .

goldbook:11416 a skos:Concept ;
    skos:definition "A generalization of the area under the ROC curve to weight more heavily the early recognition of active compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Boltzmann enhanced discrimination of receiver operating characteristic" .

goldbook:11417 a skos:Concept ;
    skos:definition "A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from many models developed using sample sets that contain the same number of observations as the original set, but for which certain observations are randomly omitted and other observations are included more than once." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bootstrap resampling" .

goldbook:11418 a skos:Concept ;
    skos:altLabel "CMR" ;
    skos:definition "The calculated molar refractivity of a molecule or substituent used as a measure of size and polarizability in 2D-QSAR." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calculated molar refractivity" .

goldbook:11419 a skos:Concept ;
    skos:definition "A unique representation of the chemical structure of a molecule that is independent of the sequence in which the atoms were ordered in the original input file  but is dependent on the algorithm used for the canonicalization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "canonical structure representation" .

goldbook:11420 a skos:Concept ;
    skos:definition "An artificial correlation that can arise when too many properties are screened relative to the number of available observations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chance correlation" .

goldbook:11421 a skos:Concept ;
    skos:altLabel "chemoinformatics" ;
    skos:definition "The science of handling, indexing, archiving, searching, and evaluating information that is specific to chemical structures and is used in data mining,  information retrieval, information extraction, and machine learning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cheminformatics" .

goldbook:11422 a skos:Concept ;
    skos:definition "Hashed molecular fingerprints that describe, either by atom type or properties, each atom in the molecule; the atoms connected to it (for path length 2); the  atoms connected to them (for path length 4); and the atoms connected to them (for path length 6); etc.." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "circular fingerprints" .

goldbook:11423 a skos:Concept ;
    skos:definition "Calculated log of the octan-1-ol/water partition coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clog P" .

goldbook:11424 a skos:Concept ;
    skos:definition "The geometric center of a cluster, often exemplified as the object that is closest to the center." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster centroid" .

goldbook:11425 a skos:Concept ;
    skos:definition "A linear relationship between two or more of the descriptors in a model, which can lead to difficulties in interpreting the relative importance of these  descriptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collinearity" .

goldbook:11426 a skos:Concept ;
    skos:altLabel "CoMSIA" ;
    skos:definition "A 3D-QSAR method similar to CoMFA that instead uses Gaussian-type functions to calculate the 3D properties of the molecules by the similarity of each molecule  to each probe at each lattice position surrounding the molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comparative molecular similarity analysis" .

goldbook:11427 a skos:Concept ;
    skos:definition "The ability of a two-group classification model to correctly classify all molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concordance" .

goldbook:11428 a skos:Concept ;
    skos:definition "A table layout that shows the results of a two-class/binary classifier in which columns correspond to the predicted classifications from the model and rows correspond to the observed classifications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confusion matrix" .

goldbook:11429 a skos:Concept ;
    skos:definition "The computational representation of a solvent as a continuous medium instead of individual explicit solvent molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuum" .

goldbook:11430 a skos:Concept ;
    skos:definition "A method to correct for basis set superposition error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counterpoise correction" .

goldbook:11431 a skos:Concept ;
    skos:definition "The extraction of useful information from large sets of observations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "data mining" .

goldbook:11432 a skos:Concept ;
    skos:definition "Path fingerprints that are generated from a structure where atoms are described by atomic number and aromaticity; bonds are described as single, double,  triple, or aromatic; and the results are hashed into a bit string of fixed length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Daylight fingerprints" .

goldbook:11433 a skos:Concept ;
    skos:definition "The process whereby a computer algorithm designs new molecules to meet certain single or multiple criteria, defined by an objective function, for example predicted affinity for a binding site or predicted affinity plus appropriate lipophilicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "de novo design" .

goldbook:11434 a skos:Concept ;
    skos:definition "The result of a recursive partitioning classification method that shows at each branching point the value of the property responsible for the split and the resulting classifications after the split." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decision tree" .

goldbook:11435 a skos:Concept ;
    skos:definition "A quantum mechanical modeling method used to investigate the electronic structure of molecules using functionals that describe the spatially dependent electron density, rather than the wavefunction as in ab initio and semi-empirical quantum chemical methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "density functional theory" .

goldbook:11436 a skos:Concept ;
    skos:definition "A qualitative or quantitative property of a molecule or a part of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "descriptor" .

goldbook:11437 a skos:Concept ;
    skos:definition "Computational methods that optimize the placement of a ligand in a macromolecular binding site of known or proposed 3D structure and provide a score as to the quality of the fit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "docking" .

goldbook:11438 a skos:Concept ;
    skos:definition "An estimate of the probability that a chemical structure is similar to known drugs based on chemical or physical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug-likeness" .

goldbook:11439 a skos:Concept ;
    skos:definition "The energy of the highest energy level in the ground state of a molecule that contains electrons, sometimes used as a measure of nucleophilicity in QSAR  models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy of the highest occupied molecular orbital" .

goldbook:11440 a skos:Concept ;
    skos:definition "The energy of the lowest energy level of a molecule that contains no electrons in the ground state, sometimes used as a measure of electrophilicity in QSAR  models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy of the lowest unoccupied molecular orbital" .

goldbook:11441 a skos:Concept ;
    skos:definition "A system that predicts properties or activities of chemicals from rules devised by domain experts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "expert system" .

goldbook:11442 a skos:Concept ;
    skos:definition "Individual solvent molecules that are included in a computation, in contrast to those implied by a continuum approximation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "explicit solvent" .

goldbook:11443 a skos:Concept ;
    skos:altLabel "ECFP",
        "ECFP fingerprints" ;
    skos:definition "Hashed circular fingerprints that encode each atom according to its atomic symbol and hybridization for path length 2, ECFP2; path length 4, ECFP4; and path  length 6, ECFP6." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extended connectivity fingerprints" .

goldbook:11444 a skos:Concept ;
    skos:altLabel "FN" ;
    skos:definition "A model prediction of a negative result, such as no biological activity, when the true result is positive, i.e. activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "false negative" .

goldbook:11445 a skos:Concept ;
    skos:altLabel "FP" ;
    skos:definition "A model prediction of a positive result, such as biological activity, when the true result is negative, i.e. inactivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "false positive" .

goldbook:11446 a skos:Concept ;
    skos:definition "A set of mathematical functions and their associated parameters used in a molecular mechanics or dynamics calculation of conformations, flexibility, and interactions of molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "force field" .

goldbook:11447 a skos:Concept ;
    skos:definition "Description of the structure of a molecule as the presence or absence of each of a pre-determined set of molecular substructures, usually associated with a  particular location in a bit string." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragment keys" .

goldbook:11448 a skos:Concept ;
    skos:definition "A method that uses molecular dynamics or Metropolis Monte Carlo simulations to compute the relative free energy differences between two conditions, typically the solution and bound states of a ligand-protein system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free energy perturbation" .

goldbook:11449 a skos:Concept ;
    skos:altLabel "FCFP" ;
    skos:definition "Hashed circular fingerprints that encode each atom according to its property (hydrophobic, hydrogen bond donor, hydrogen bond acceptor, negatively charged, or  positively charged) for path length 2, FCFP2; path length 4, FCFP4; and path length 6, FCFP6." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional class fingerprints" .

goldbook:11450 a skos:Concept ;
    skos:definition "A computational model designed to cover all of chemistry space although it typically includes a measure of if the molecule for which the properties are to be  predicted is within or outside the applicability domain of the model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "global model" .

goldbook:11451 a skos:Concept ;
    skos:definition "A computational method that converts the problem to be solved into a graph characterized by the character of the objects, such the atoms of a molecule or molecules in a database, and the distances between them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graph-based method" .

goldbook:11452 a skos:Concept ;
    skos:definition "A QSAR equation that describes the relationship between the logarithm of the relative biological potency of a molecule (\\(\\log (1/C_{i})\\)) and its electronic and hydrophobic properties: \\[\\log (1/C_{i}) = \\rho \\sigma_{i} + b\\,\\log P_{i} - c\\,(\\log P_{i})^{2}\\] in which fitting to the square term provides a parabola with an associated optimum log P." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hansch equation" .

goldbook:11453 a skos:Concept ;
    skos:definition "A constant that describes the contribution of a substituent to the octan-1-ol-water log P of a compound.]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hansch–Fujita π-constant" .

goldbook:11454 a skos:Concept ;
    skos:definition "An algorithm that maps data of variable length, such as the raw descriptors of path or circular fingerprints or InChIs, to a smaller fixed length vector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hashing" .

goldbook:11455 a skos:Concept ;
    skos:definition "A fixed length (character) condensed digital representation of the InChI that is not human-understandable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "InChIKey" .

goldbook:11456 a skos:Concept ;
    skos:altLabel "InChI" ;
    skos:definition "A non-proprietary canonical identifier of chemical substances that can be used in printed and electronic data sources to enable easier linking of diverse data  compilations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "International Chemical Identifier" .

goldbook:11457 a skos:Concept ;
    skos:definition "Predefined fragment keys that are used in 2D substructure and similarity searching with the ISIS software but are also generated by many other software  programs and used for 2D-QSAR or cluster analysis of molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ISIS keys" .

goldbook:11458 a skos:Concept ;
    skos:definition "A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from models developed by leaving out one or more observations at a time from the sample set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "jackknifing" .

goldbook:11459 a skos:Concept ;
    skos:definition "A type of topological index." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kappa shape descriptor" .

goldbook:11460 a skos:Concept ;
    skos:definition "Algorithms for pattern analysis that use functions such as Gaussians to enable them to operate in a high-dimensional descriptor space without ever computing  the coordinates of the data in that space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kernel method" .

goldbook:11461 a skos:Concept ;
    skos:altLabel "LSO" ;
    skos:definition "A form of cross-validation in which more than one observation is left out at each run. Typically many runs with random samplings are performed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leave-some-out cross-validation" .

goldbook:11462 a skos:Concept ;
    skos:definition "The influence of an observation on the coefficients of a fitted equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leverage" .

goldbook:11463 a skos:Concept ;
    skos:altLabel "LE" ;
    skos:definition "Measure of the free energy of binding per heavy atom count (i.e. non-hydrogen) of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand efficiency" .

goldbook:11464 a skos:Concept ;
    skos:altLabel "LIE" ;
    skos:definition "A method that forecasts ligand binding free energies using force field estimations of the receptor-ligand interactions and thermal conformational sampling ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear interaction energy" .

goldbook:11465 a skos:Concept ;
    skos:altLabel "LLE" ;
    skos:definition "A measure of the efficiency of ligand binding that is corrected for binding driven by lipophilicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipophilic ligand efficiency" .

goldbook:11466 a skos:Concept ;
    skos:definition "The contribution of the property to a principal component or partial least squares latent variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loading of a property" .

goldbook:11467 a skos:Concept ;
    skos:definition "A computational model that applies to only a subset of molecules, typically a closely related series." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local model" .

goldbook:11468 a skos:Concept ;
    skos:definition "The logarithm of the ratio of the total concentration (neutral and charged species) of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in water at a given \\(\\pu{pH}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "log <em>D</em>" .

goldbook:11469 a skos:Concept ;
    skos:definition "The logarithm of the ratio of the concentration of the uncharged form of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in  water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "log <em>P</em>" .

goldbook:11470 a skos:Concept ;
    skos:definition "A computer algorithm that generates empirical models, such as a model of biological potency as a function of the properties of the molecules, that is derived  from the analysis of a training set for which all the necessary data are available." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "machine learning" .

goldbook:11471 a skos:Concept ;
    skos:altLabel "mmCIF" ;
    skos:definition "A file that describes in detail the features of a macromolecular structure and the X‑ray diffraction experiment that was used to derive that structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecular crystallographic information file" .

goldbook:11472 a skos:Concept ;
    skos:definition "A structure diagram that describes a set of related molecules with the structure of the common core and the structures of the substituents at each position." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Markush structure" .

goldbook:11473 a skos:Concept ;
    skos:definition "A measure of the spread of various properties or chemotypes within a set of compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular diversity" .

goldbook:11474 a skos:Concept ;
    skos:definition "Descriptions of the structure of a molecule calculated from the properties of each of its atoms and bonds that are then usually condensed into a fixed-length string by a hashing algorithm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular fingerprints" .

goldbook:11475 a skos:Concept ;
    skos:definition "The degree to which two molecules resemble one another as calculated from their respective 2D or 3D properties, molecular fingerprints, fragment keys, or superimposed 3D structures that usually ranges from 1 (identical) to 0 (dissimilar)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular similarity" .

goldbook:11476 a skos:Concept ;
    skos:altLabel "MDS" ;
    skos:definition "A visualization method that converts a dataset of distances between molecules in property space into coordinates in lower dimension space with emphasis on  preserving the relative distances between dissimilar molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multidimensional scaling" .

goldbook:11477 a skos:Concept ;
    skos:altLabel "MOO" ;
    skos:definition "The search for those combinations of properties that produces the best compromise between the various objectives of the search, for example properties of  compounds that are the best trade-off between potency, bioavailability, and selectivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiobjective optimization" .

goldbook:11478 a skos:Concept ;
    skos:altLabel "O-PLS" ;
    skos:definition "A preprocessing method for partial least squares calculations that filters out variation that is not correlated to the property to be fit and so results in  improved interpretability of a PLS model while maintaining its predictivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orthogonal projections to latent structures" .

goldbook:11479 a skos:Concept ;
    skos:definition "Training a machine learning model for so long that the original input data is memorized with the result that model predictivity is degraded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "overtraining" .

goldbook:11480 a skos:Concept ;
    skos:definition "The various combinations of predictor properties that lead to optimum predicted compromises in multiple target properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pareto front" .

goldbook:11481 a skos:Concept ;
    skos:definition "The search for solutions to functions that provide a compromise between several desirable outcomes, such as potency, lack of toxicity, and good absorption, distribution, metabolism, and excretion (ADME) properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pareto optimization" .

goldbook:11482 a skos:Concept ;
    skos:definition "Charges assigned to atoms, arising from the uneven distribution of electrons in bonds, that are used to calculate intermolecular interaction energy or to  characterize the charge distribution of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial atomic charges" .

goldbook:11483 a skos:Concept ;
    skos:definition "Vectors of Boolean arrays generated from the properties of the atoms and bonds in linear paths, typically two to seven bonds long, hashed into an integer of  fixed determined length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "path fingerprints" .

goldbook:11484 a skos:Concept ;
    skos:altLabel "PDB file" ;
    skos:definition "A text file that stores the atomic coordinates of a macromolecule, usually a protein or nucleic acid with associated ligands, solvent molecules and ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein data bank file" .

goldbook:11485 a skos:Concept ;
    skos:definition "A proposal for the ensemble of steric and electronic features that define the optimal supermolecular intermolecular interaction of a ligand with a specific  biological target structure with the result that it triggers or blocks its biological response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacophore" .

goldbook:11486 a skos:Concept ;
    skos:definition "Visual programming of the computational execution of sequential operations on a dataset, with each node specifying an operation with options, and the nodes processed sequentially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pipelining programs" .

goldbook:11487 a skos:Concept ;
    skos:definition "One of the vectors of a linear combination of the input descriptors that a partial least squares calculation extracts from a dataset." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "PLS latent variable" .

goldbook:11488 a skos:Concept ;
    skos:definition "The contribution of a particular property to a PLS latent variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "PLS loading" .

goldbook:11489 a skos:Concept ;
    skos:definition "A differential equation that uses a mean-field, continuum model to describe the electrostatic interactions in ionic solutions where both ions and solvent are  treated implicitly, resulting in less computational effort to describe biomolecules in ionic aqueous solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Poisson–Boltzmann equation" .

goldbook:11490 a skos:Concept ;
    skos:altLabel "PSA" ;
    skos:definition "Surface area over all polar atoms (usually oxygen and nitrogen), including any attached hydrogen atoms, of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polar surface area" .

goldbook:11491 a skos:Concept ;
    skos:definition "A 2D diagram that shows the interactions between a ligand and a protein in the 3D structure of the complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pose diagram" .

goldbook:11492 a skos:Concept ;
    skos:definition "The conditional probability that is assigned to a quantity after relevant evidence is taken into account. The prior and posterior probabilities are linked by  the (normalized) likelihood function (Bayes's theorem)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "posterior probability" .

goldbook:11493 a skos:Concept ;
    skos:definition "Molecules that have been set aside from model development to test the reliability of the derived model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prediction set" .

goldbook:11494 a skos:Concept ;
    skos:definition "The contribution, scaled between \\(\\pu{-1.0}\\) and \\(\\pu{1.0}\\), of an original variable to a particular principal component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal component loading" .

goldbook:11495 a skos:Concept ;
    skos:definition "A property of a molecule calculated from a principal components analysis of the original properties and the value of these properties for the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal component score" .

goldbook:11496 a skos:Concept ;
    skos:definition "The conditional probability that is assigned to a quantity before relevant evidence is taken into account, for example, the prior probability of an active  compound would be the fraction of the compounds in the dataset that are active." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prior probability" .

goldbook:11497 a skos:Concept ;
    skos:altLabel "PDB" ;
    skos:definition "An archive of freely available macromolecular structural data of proteins, nucleic acids, and complex assemblies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein data bank" .

goldbook:11498 a skos:Concept ;
    skos:definition "The square of the leave-one-out cross-validation regression coefficient calculated from the variance of the observed versus predicted values of the target  property, usually potency, of each compound when eliminated during cross-validation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "q2" .

goldbook:11499 a skos:Concept ;
    skos:altLabel "$R^{2}$" ;
    skos:definition "The ratio of the sum of squares explained by a regression model (SSR) to the 'total' sum of squares around the mean (SST), or, because SST equals SSR plus the sum of squares of the error or residuals from the fit (SSE): \\[R^{2} = \\frac{{\\rm{SSR}}}{{\\rm{SST}}} = 1 - \\frac{{\\rm{SSE}}}{{\\rm{SST}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "r2" .

goldbook:11500 a skos:Concept ;
    skos:definition "A classification method that produces many recursive partitioning models, each with a random selection of predictor properties, and then combines the models  for predictions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random forest method" .

goldbook:11501 a skos:Concept ;
    skos:definition "The fraction of the total number of actives, in the top-scoring docking hits, such as the fraction of true actives that are retrieved in the top \\(\\pu{1\\%}\\) scoring molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recall" .

goldbook:11502 a skos:Concept ;
    skos:altLabel "ROC",
        "ROC curve" ;
    skos:definition "A plot that shows the result of a test of the performance of a binary classifier by plotting the fraction of true positives identified versus the fraction of  false positives as the discrimination threshold is varied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "receiver-operator characteristic curve" .

goldbook:11503 a skos:Concept ;
    skos:definition "A classification method that uses predictor properties to successively divide the data set into subsets such that each resulting subset is enriched in  molecules that are in one class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recursive partitioning" .

goldbook:11504 a skos:Concept ;
    skos:definition "Introducing additional information in order to solve an ill-posed problem or to prevent overfitting, usually taking the form of a penalty for complexity of the  model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regularization" .

goldbook:11505 a skos:Concept ;
    skos:definition "Evaluation of the robustness of a QSAR or classification model by repeatedly randomizing the target property of compounds, developing models based on this  randomized property, and comparing the statistics of fit of the scrambled models with those of the true model, which should be superior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "response scrambling" .

goldbook:11506 a skos:Concept ;
    skos:definition "The process whereby the molecules in a dataset are partitioned into the core ('scaffold'), usually user-specified, and the specific substituents ('R-groups')  found at each specific position." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "R-group decomposition" .

goldbook:11507 a skos:Concept ;
    skos:definition "The rule of five states that molecules that violate two or more of the following rules are likely to have permeability problems; (1) CLOGP calculated octan-1-ol-water log P greater than 5.0; (2) molecular weight greater than 500; (3) more than five hydrogen bond donors; and (4) the sum of oxygen and nitrogen atoms is greater than 10." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rule of five" .

goldbook:11508 a skos:Concept ;
    skos:definition "A mathematical formula that estimates the binding affinity of a ligand to a macromolecular target based on the structure of the complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scoring" .

goldbook:11509 a skos:Concept ;
    skos:altLabel "SDF file",
        "SDfile" ;
    skos:definition "A computer text file that follows a specified format in which each molecule is described by 2D or 3D coordinates, atom type, and connectivity to other atoms  and also specific user-definable fields that contain other information such as name and biological or chemical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure-data format file" .

goldbook:11510 a skos:Concept ;
    skos:definition "Analysis, often by finding approximate derivatives of the output with respect to each input, that determines which of the descriptors in a model has the  greatest influence on the output." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitivity analysis" .

goldbook:11511 a skos:Concept ;
    skos:altLabel "SEA" ;
    skos:definition "A method that predicts the probability that a molecule or set of molecules will be active against a particular target by considering its pairwise similarities  to all known ligands for that target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "similarity ensemble approach" .

goldbook:11512 a skos:Concept ;
    skos:definition "A virtual screening method that calculates the molecular similarity of an input 2D or 3D structure to each of the molecules in a database to identify a  requested number of most similar molecules or those above some similarity threshold." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "similarity searching" .

goldbook:11513 a skos:Concept ;
    skos:definition "An expansion of the SMILES language that describes a particular specific or generalized substructure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "SMARTS" .

goldbook:11515 a skos:Concept ;
    skos:definition "A derivative of the SMILES language that describes the transformation in a chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "SMIRKS" .

goldbook:11516 a skos:Concept ;
    skos:definition "The ability of a two-class model to detect known inactive or non-toxic molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specificity" .

goldbook:11517 a skos:Concept ;
    skos:definition "The standard error of the errors or residuals, observed minus calculated, from a computational model: \\[{\\rm{SEE}} = \\sqrt \\frac{\\sum (Y_{o} - Y_{c})^{2}}{n}\\] in which \\(Y_{o}\\) is the observed value of \\(Y\\), \\(Y_{c}\\) is the calculated value of \\(Y\\), and \\(n\\) is the number of observations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard error of estimates" .

goldbook:11518 a skos:Concept ;
    skos:definition "The standard deviation of the errors or residuals, observed minus calculated, from a computational model: \\[{\\rm{SEP}} = \\sqrt \\frac{\\sum (Y_{o} - Y_{p})^{2}}{n - k}\\] in which \\(Y_{o}\\) is the observed value of \\(Y\\), \\(Y_{p}\\) is the predicted value of \\(Y\\), \\(n\\) is the number of observations, and \\(k\\) is the number of terms in the model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard error of prediction" .

goldbook:11519 a skos:Concept ;
    skos:definition "A pre-established set of substructures the presence or absence of which are used to describe a molecule and are used during substructure searching as a filter  to eliminate molecules that cannot match a query, for clustering or similarity searching, or for developing classification or regression models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural keys" .

goldbook:11520 a skos:Concept ;
    skos:definition "A 2D drawing that shows the atoms of a molecular structure and the bonds that connect them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure diagram" .

goldbook:11521 a skos:Concept ;
    skos:definition "A virtual screening method that uses a graph-based method to discover which molecules in a chemical structure database contain the substructure specified in  the query." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substructure searching" .

goldbook:11522 a skos:Concept ;
    skos:definition "A machine learning method that aims to discover a relationship between the predictor and the response values, such as exists in a QSAR or recursive  partitioning model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supervised learning" .

goldbook:11523 a skos:Concept ;
    skos:definition "A scale that ranges from \\(\\pu{0.0}\\) to \\(\\pu{1.0}\\) when calculated as the ratio of the fingerprint bits or structural keys that both molecules have set divided by the number of bits or keys set in both molecules plus those set either molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tanimoto similarity" .

goldbook:11524 a skos:Concept ;
    skos:definition "The set of molecules not used in any way to devise a computational model but instead are used to test its predictivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "test set" .

goldbook:11525 a skos:Concept ;
    skos:definition "A numerical value associated with chemical constitution for correlation of chemical structure with various physical properties, chemical reactivity or biological activity. The numerical basis for topological indices is provided (depending on how a molecular graph is converted into a numerical value) by either the adjacency matrix or the topological distance matrix. In the latter the topological distance between two vertices is the number of edges in the shortest path between these." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topological index" .

goldbook:11526 a skos:Concept ;
    skos:altLabel "TPSA" ;
    skos:definition "An approximation to polar surface area that is calculated from the 2D structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topological polar surface area" .

goldbook:11527 a skos:Concept ;
    skos:altLabel "TN" ;
    skos:definition "A model prediction of a negative result, such as no biological activity, when the true result is also negative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "true negative" .

goldbook:11528 a skos:Concept ;
    skos:altLabel "TP" ;
    skos:definition "A model prediction of a positive result, such as biological activity, when the true result is also positive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "true positive" .

goldbook:11529 a skos:Concept ;
    skos:definition "An asymmetric measure in which a target structure is compared to a reference structure with user-selectable weighting of the relative importance of the fingerprint bits or structural keys that are present only in the reference versus the fingerprint bits or structural keys that are only in the target, weightings for which the Tanimoto coefficient uses \\(\\pu{1.0}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tversky similarity" .

goldbook:11530 a skos:Concept ;
    skos:definition "A system in which the number of descriptors is much larger than the number of observations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "underdetermined system" .

goldbook:11531 a skos:Concept ;
    skos:definition "The molecules not used to devise a computational model but instead are used during model development to test for possible over-fitting as seen when additional  properties are added to a model but the predicted potencies of the validation set become less accurate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "validation set" .

goldbook:11532 a skos:Concept ;
    skos:definition "The computer encoding of a possible chemical reaction between two explicit or Markush structures or substructures, often with a mapping between the atoms in  the starting material and those in the product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virtual reaction" .

goldbook:11533 a skos:Concept ;
    skos:definition "Computational methods that rank the molecules in a database by their forecast continuous or categorical biological or chemical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virtual screening" .

goldbook:11534 a skos:Concept ;
    skos:definition "The sequence of steps used to perform a certain task." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "workflow" .

goldbook:11535 a skos:Concept ;
    skos:definition "Monomer which from the name of a polymer appears to have been used in the synthesis of the latter when it has actually been prepared from different precursor(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apparent monomer" .

goldbook:11536 a skos:Concept ;
    skos:definition "Homopolymer that is composed of macromolecules comprising blocks that have at least one constitutional or configurational feature which is not present in the adjacent portions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "block homopolymer" .

goldbook:11537 a skos:Concept ;
    skos:definition "Homopolymer composed of macromolecules with one or more species of block connected to the main chain as side chains, these side chains having constitutional or configurational features that differ from those in the main chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft homopolymer" .

goldbook:11538 a skos:Concept ;
    skos:definition "Measurement of the concentration of a component of a solution with a reference measurement standard for the preparation of a secondary measurement standard" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standardization" .

goldbook:11539 a skos:Concept ;
    skos:definition "Detection principle for a chemically modified electrode (CME) in which an analyte or reagent accumulated at a CME undergoes quantitative release (egress, stripping, expulsion, or microdosing) to the test solution, under electrochemical or chemical control." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled release" .

goldbook:11540 a skos:Concept ;
    skos:altLabel "metal contact ion-selective electrode" ;
    skos:definition "Ion-selective electrode in which the ion-selective membrane contacts the electronic conductor without internal electrolyte solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "all-solid-state ion-selective electrode" .

goldbook:11541 a skos:Concept ;
    skos:altLabel "SAM" ;
    skos:definition "Film, one molecule thick, in an ordered assembly on a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-assembled monolayer" .

goldbook:11542 a skos:Concept ;
    skos:definition "Ion formed by the association of a cation with a molecule \\(\\ce{M}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cationized molecule" .

goldbook:11543 a skos:Concept ;
    skos:definition "Mass of a molecular ion or molecule calculated using the isotope mass of the most abundant constituent element isotope of each element rounded to the nearest integer value and multiplied by the number of atoms of each element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominal mass" .

goldbook:11544 a skos:Concept ;
    skos:definition "Component of a time-of-flight mass spectrometer that uses a static electric field to reverse the direction of travel of the ions and improves mass resolution by assuring that ions of the same m/z but different translational energy arrive at the detector at the same time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflectron" .

goldbook:11545 a skos:Concept ;
    skos:altLabel "tack" ;
    skos:definition "Attachment of interfaces between phases or components that is maintained by intermolecular forces, chain entanglements, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adhesion" .

goldbook:11546 a skos:Concept ;
    skos:definition "The relationship between the initial rate (velocity) of an enzyme-catalysed reaction \\(v_{0}\\) and the initial substrate concentration \\([\\ce{S}]_{0}\\) in the form \\[v_{0} = V[\\ce{S}]_{0}/(K_{\\rm{M}} + [\\ce{S}]_{0})\\] where \\(V\\) (the limiting rate) and \\(K_{\\rm{M}}\\) (the Michaelis constant) are independent of the initial substrate concentration and constant at a given temperature and a given enzyme concentration. The reaction is then said to display Michaelis–Menten kinetics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Michaelis–Menten equation" .

goldbook:11547 a skos:Concept ;
    skos:definition "Determination of the primary structure of a protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein sequencing" .

goldbook:11548 a skos:Concept ;
    skos:definition "pH of the solute zone in pH-zone-refining counter-current chromatography. \\[{\\rm{pH}}_{\\rm{zone}} = \\pu{p}K_{\\rm{a}} + \\log[(K_{\\rm{DS}}/K_{\\rm{S}}) - 1]\\], where \\(K_{\\rm{DS}}\\) is the partition ratio of solute $\\ce{S}$ (an indicator for solute hydrophobicity) and \\(K_{\\rm{S}}\\), the dissociation constant of the solute." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zone pH" .

goldbook:11549 a skos:Concept ;
    skos:altLabel "intrastitial volume of the column",
        "stationary mobile-phase volume" ;
    skos:definition "Volume of the mobile phase within the pores of the particles in the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intraparticle volume of the column" .

goldbook:11550 a skos:Concept ;
    skos:definition "Fraction of the intraparticle volume (the volume of the pores) available to the molecules of a particular sample component for diffusion: \\[K_{0} = \\frac{V_{\\rm{R}} - V_0}{V_{\\rm{i}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution constant (exclusion)" .

goldbook:11551 a skos:Concept ;
    skos:definition "Calibration for extraction when close to equilibrium conditions, using a known for the distribution constant for the analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution constant calibration" .

goldbook:11552 a skos:Concept ;
    skos:definition "Extraction method characterized by a low phase ratio, so that at equilibrium the fraction extracted is low (i.e. the extraction is not exhaustive)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microextraction (methology)" .

goldbook:11553 a skos:Concept ;
    skos:definition "Extraction technique in which the volume (mass) of the extraction phase (liquid or solid) is substantially smaller than the sample volume (mass)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microextraction (technique)" .

goldbook:11554 a skos:Concept ;
    skos:altLabel "MEPS" ;
    skos:definition "Solid-phase extraction using a syringe with a short sorbent bed located between the plunger and the needle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microextraction (packed sorbent)" .

goldbook:11556 a skos:Concept ;
    skos:altLabel "acclimatization" ;
    skos:definition "Adjustment, physiologically and (or) behaviorally, of an organism to its environment or circumstances, e.g., thermoregulation, psychological adjustment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acclimation" .

goldbook:11557 a skos:Concept ;
    skos:altLabel "2-acetoxy-N,N,N-trimethylethanaminium",
        "ACh" ;
    skos:definition "Substance that functions as a neurotransmitter between nerve cells and between nerves and muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetylcholine" .

goldbook:11558 a skos:Concept ;
    skos:altLabel "AChE",
        "acetylcholine hydrolase",
        "cholinesterase inhibitor" ;
    skos:definition "Enzyme that hydrolyzes acetylcholine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetylcholinesterase" .

goldbook:11559 a skos:Concept ;
    skos:definition "Integral membrane protein that allows the cell to respond to the binding of acetylcholine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetylcholine receptor" .

goldbook:11560 a skos:Concept ;
    skos:altLabel "acoustic neurinoma",
        "vestibular Schwannoma" ;
    skos:definition "Non-malignant intracranial tumor of the eighth cranial nerve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acoustic neuroma" .

goldbook:11561 a skos:Concept ;
    skos:definition "Abnormal feeling of numbness, tingling, or burning of the skin, typically in the extremities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acroparesthesia" .

goldbook:11562 a skos:Concept ;
    skos:definition "Brief, spike-like depolarization associated with the passage of an impulse without decrement along the membrane of a muscle cell or nerve cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "action potential" .

goldbook:11563 a skos:Concept ;
    skos:definition "Fear-motivated associative avoidance test based on presentation of an adverse stimulus (e.g., an electric current) as a source of discomfort, to create an environment from which the animal or subject would prefer to escape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active avoidance test" .

goldbook:11564 a skos:Concept ;
    skos:altLabel "physical dependence",
        "psychological dependence" ;
    skos:definition "Compulsive, uncontrolled reward-seeking behavior, especially referring to substance use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "addiction" .

goldbook:11565 a skos:Concept ;
    skos:definition "Benign tumor arising from epithelial cells in glandular tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adenoma" .

goldbook:11566 a skos:Concept ;
    skos:definition "Any of four types of purinergic receptors that respond to the nucleoside, adenosine, two of which are involved in release of the neurotransmitters, dopamine and glutamate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adenosine receptor" .

goldbook:11567 a skos:Concept ;
    skos:altLabel "(R)-4-(1-hydroxy-2-(methylamino)ethyl)benzene-1",
        "2-diol",
        "adrenaline",
        "epinephrine" ;
    skos:definition "Catecholamine hormone secreted by the adrenal glands that increases heart rate, breathing rate, blood pressure, and carbohydrate metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adrenalin" .

goldbook:11568 a skos:Concept ;
    skos:definition "Relating to or denoting secretion of and (or) response to adrenalin, noradrenalin or related substances; in particular referring to sympathetic nerve fibers. Relating to or denoting an agent that mimics the activity of adrenalin, noradrenalin or related substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adrenergic" .

goldbook:11569 a skos:Concept ;
    skos:definition "Class of adrenergicreceptor mainly functioning in vasoconstriction and modulation of glandular secretions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-adrenergic receptor" .

goldbook:11570 a skos:Concept ;
    skos:altLabel "adrenergic receptor",
        "adrenoceptor",
        "β-receptor" ;
    skos:definition "Member of a class of G protein-coupled receptors that are targets of the catecholamines, especially adrenalin, noradrenalin, and related substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-adrenergic receptor" .

goldbook:11571 a skos:Concept ;
    skos:definition "Inflowing. Of nerves, those that conduct impulses toward the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "afferent" .

goldbook:11572 a skos:Concept ;
    skos:definition "Impaired ability to recognize or comprehend the meaning of various sensations, not attributable to faulty sensory input or general intellect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agnosia" .

goldbook:11573 a skos:Concept ;
    skos:definition "Protein abundant in the human brain, thought to regulate the release of dopamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alpha-synuclein" .

goldbook:11574 a skos:Concept ;
    skos:definition "Common and progressive neurodegenerative disease leading to loss of memory, orientation, and judgment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Alzheimer disease" .

goldbook:11575 a skos:Concept ;
    skos:altLabel "4-aminobutanoic acid",
        "GABA" ;
    skos:definition "Major neurotransmitter at inhibitory synapses in the central nervous system of mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-aminobutyric acid" .

goldbook:11576 a skos:Concept ;
    skos:altLabel "GABA Receptor" ;
    skos:definition "Transmembrane receptor protein that binds and responds to the inhibitory neurotransmitter $\\ce{\\upgamma\\!\\mbox{-}aminobutyric acid}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-aminobutyric acid receptor" .

goldbook:11577 a skos:Concept ;
    skos:altLabel "AMPA Receptor" ;
    skos:definition "Glutamate receptor in the central nervous system activated by the synthetic glutamate analog, AMPA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid receptor" .

goldbook:11578 a skos:Concept ;
    skos:definition "Partial or total, transient or permanent loss of memory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amnesia" .

goldbook:11579 a skos:Concept ;
    skos:altLabel "ASP" ;
    skos:definition "Human illness caused by consumption of the marine toxin domoic acid that may lead to dizziness, confusion, motor weakness and seizures, with permanent cognitive impairment and short term memory loss." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amnesic shellfish poisoning" .

goldbook:11580 a skos:Concept ;
    skos:definition "Brain nucleus located in the median temporal lobe that is part of the limbic system and plays an important role in emotional responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amygdala" .

goldbook:11581 a skos:Concept ;
    skos:altLabel "amyloid" ;
    skos:definition "Extracellular aggregate of misfolded fibrous proteins, typically with cross-linked $\\ce{\\upbeta\\!\\mbox{-}sheet}$ structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-amyloid" .

goldbook:11582 a skos:Concept ;
    skos:altLabel "neuritic plaque",
        "senile plaque" ;
    skos:definition "Structure representing extracellular deposition of $\\ce{\\upbeta\\!\\mbox{-}amyloid protein}$ in the gray matter of the brain that occurs with aging and in increased amount in Alzheimer disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amyloid plaque" .

goldbook:11583 a skos:Concept ;
    skos:altLabel "Lou Gehrig’s disease",
        "motor neuron disease" ;
    skos:definition "Debilitating degenerative disease of the motor neurons characterized by progressive muscle weakness, muscle atrophy and fasciculations, muscle spasticity, difficulty speaking (dysarthria), difficulty swallowing (dysphagia), and difficulty breathing (dyspnea)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amyotrophic lateral sclerosis" .

goldbook:11584 a skos:Concept ;
    skos:definition "Anything tending to reduce libido." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphrodisiac" .

goldbook:11585 a skos:Concept ;
    skos:altLabel "anaesthetic" ;
    skos:definition "Substance that reduces the experience of pain with or without loss of consciousness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anesthetic" .

goldbook:11586 a skos:Concept ;
    skos:altLabel "Arteriography" ;
    skos:definition "Radiography of blood or lymph vessels, following the introduction of a radio-opaque substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angiography" .

goldbook:11587 a skos:Concept ;
    skos:definition "Tough outer ring of an intervertebral disc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "annulus" .

goldbook:11588 a skos:Concept ;
    skos:definition "Eating disorder characterized by self-imposed food restriction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anorexia" .

goldbook:11589 a skos:Concept ;
    skos:definition "Eating disorder characterized by obsessive desire to lose weight by reducing food intake or by repeated vomiting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anorexia nervosa" .

goldbook:11590 a skos:Concept ;
    skos:definition "Loss of the sense of smell, either total or selective." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anosmia" .

goldbook:11591 a skos:Concept ;
    skos:definition "Substance used to prevent or reduce the severity of convulsions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticonvulsant" .

goldbook:11592 a skos:Concept ;
    skos:definition "Substance used to alleviate depression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antidepressant" .

goldbook:11593 a skos:Concept ;
    skos:definition "Substance used to prevent nausea and vomiting (emesis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiemetic" .

goldbook:11594 a skos:Concept ;
    skos:definition "Substance used to alleviate the pain of neuralgia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antineuralgic" .

goldbook:11595 a skos:Concept ;
    skos:definition "Blockage of the perception of pain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antinociception" .

goldbook:11596 a skos:Concept ;
    skos:definition "Psychoactive substance used to manage psychotic behavior or psychotic ideation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antipsychotic" .

goldbook:11597 a skos:Concept ;
    skos:definition "Substance used to prevent muscle spasms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antispasmodic" .

goldbook:11598 a skos:Concept ;
    skos:definition "Agent that reduces anxiety without causing excessive sedation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anxiolytic" .

goldbook:11599 a skos:Concept ;
    skos:definition "Difficulty with, or loss of the use of language in reading, writing or speaking owing to specific lesions in the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aphasia" .

goldbook:11600 a skos:Concept ;
    skos:definition "Loss of the voice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aphonia" .

goldbook:11601 a skos:Concept ;
    skos:definition "Anything that stimulates libido." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aphrodisiac" .

goldbook:11602 a skos:Concept ;
    skos:altLabel "apneustic respiration" ;
    skos:definition "Abnormal breathing pattern consisting of a pause at full inspiration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apneusis" .

goldbook:11603 a skos:Concept ;
    skos:definition "Neurological condition characterized by loss of the ability to perform skilled or purposeful movement that a person is nevertheless physically able and willing to do." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apraxia" .

goldbook:11604 a skos:Concept ;
    skos:definition "Inflammation of the arachnoid membrane, often characterized by perception of burning pain in the legs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arachnoiditis" .

goldbook:11605 a skos:Concept ;
    skos:definition "Terminal branching of a neuron into a treelike structure of the dendrites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arborization" .

goldbook:11606 a skos:Concept ;
    skos:definition "Condition in which there is an irregular or abnormal heart beat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arrhythmia" .

goldbook:11607 a skos:Concept ;
    skos:definition "Communication in which blood is shunted from arterioles to venules without passing through capillaries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriolovenular anastomosis" .

goldbook:11608 a skos:Concept ;
    skos:altLabel "AV" ;
    skos:definition "Relating to both arteries and veins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriovenous" .

goldbook:11609 a skos:Concept ;
    skos:definition "Communication between an artery and a vein by collateral channels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriovenous anastomosis" .

goldbook:11610 a skos:Concept ;
    skos:definition "Abnormal communication between an artery and a vein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriovenous fistula" .

goldbook:11611 a skos:Concept ;
    skos:altLabel "AVM" ;
    skos:definition "Web of blood vessels with one or more abnormal communications between arteries and veins that bypass the capillary system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriovenous malformation" .

goldbook:11612 a skos:Concept ;
    skos:definition "Avoidance test in which the test animal has learned to develop an association between the stimulus and the delivery of an aversive event." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "associative avoidance test" .

goldbook:11613 a skos:Concept ;
    skos:definition "Process in which a new behavior arises as a consequence of association with a particular stimulus, sometimes restricted to learning through classical conditioning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "associative learning" .

goldbook:11614 a skos:Concept ;
    skos:definition "Glial cell of ectodermal origin in the central nervous system, characterized by filamentous protoplasmic extensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "astrocyte" .

goldbook:11615 a skos:Concept ;
    skos:definition "Astrocyte that, after injury or excessive neural activity, undergoes morphological (including extension of pseudopodia) and biochemical (notably increased synthesis of glial fibrillary acidic protein) changes and participates in astrocytic scar formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive astrocyte" .

goldbook:11616 a skos:Concept ;
    skos:altLabel "glial scar" ;
    skos:definition "Clustering of reactive astrocytes separating a localized brain injury from surrounding uninjured tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "astrocytic scar" .

goldbook:11617 a skos:Concept ;
    skos:definition "Tumor within the substance of the brain or spinal cord made up of astrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "astrocytoma" .

goldbook:11618 a skos:Concept ;
    skos:definition "Localized site of reactive astrocytes, distinct from an astrocytic scar." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "astrogliosis" .

goldbook:11619 a skos:Concept ;
    skos:definition "Loss of muscular coordination (see motor coordination) resulting in abnormal clumsiness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ataxia" .

goldbook:11620 a skos:Concept ;
    skos:definition "Condition in which inappropriate muscle contraction causes involuntary writhing movements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "athetosis" .

goldbook:11621 a skos:Concept ;
    skos:definition "Lacking muscular tone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atony" .

goldbook:11622 a skos:Concept ;
    skos:altLabel "ADHD",
        "hyperkinetic disorder" ;
    skos:definition "Neuropsychiatric disorder of childhood characterized by decreased attention span, impulsiveness and hyperactivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attention deficit hyperactivity disorder" .

goldbook:11623 a skos:Concept ;
    skos:definition "Constellation of symptoms experienced before a migraine headache or seizure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aura" .

goldbook:11624 a skos:Concept ;
    skos:definition "Neurodevelopmental disorder, present from early childhood, characterized by great difficulty in communicating and forming relationships with other people and in using abstract concepts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autism" .

goldbook:11625 a skos:Concept ;
    skos:altLabel "ANS" ;
    skos:definition "Part of the peripheral nervous system controlling the bodily functions that are not consciously directed, e.g., breathing, heart rate, and digestive processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autonomic nervous system" .

goldbook:11626 a skos:Concept ;
    skos:definition "Associative learning pairing an adverse event with a non-specific stimulus such that the animal learns to respond in a manner to avoid the adverse event." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "avoidance test" .

goldbook:11627 a skos:Concept ;
    skos:definition "Long thread-like process of a neuron along which impulses are conducted from the cell body to the nerve ending." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axon" .

goldbook:11628 a skos:Concept ;
    skos:definition "Progressive loss of structure and function of an axon, typically in a peripheral-to-central direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axonal degeneration" .

goldbook:11629 a skos:Concept ;
    skos:altLabel "axoplasmic transport" ;
    skos:definition "Movement of organelles and biomolecules to (retrograde) and from (anterograde) a neuron’s cell body, within the cytoplasm of its axon (the axoplasm)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axonal transport" .

goldbook:11630 a skos:Concept ;
    skos:definition "Damage (peripheral neuropathy) to multiple nerves in roughly the same areas on both sides of the body, causing weakness, numbness, and paresthesia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axonopathy" .

goldbook:11631 a skos:Concept ;
    skos:definition "Test for catalepsy in which a mouse is placed on a bar oriented parallel to and approximately \\(\\pu{2.5 cm}\\) off the ground. Typically, if the mouse remains immobile on the bar for more than 20 seconds, it is considered to be cataleptic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bar test" .

goldbook:11632 a skos:Concept ;
    skos:definition "Circular platform equipped with some 20 equidistant holes near the outer rim, one of which is marked by visual cues and is an escape hole for a rodent that is placed near the middle of the platform and subjected to an adverse stimulus, e.g., bright light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Barnes maze" .

goldbook:11633 a skos:Concept ;
    skos:altLabel "Bayley scales of infant development (BSID)" ;
    skos:definition "Range of scores on play tasks performed by infants age 0–3 years, intended to assess development of motor, cognitive, and language skills against norms for age-matched normal child development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bayley scale" .

goldbook:11634 a skos:Concept ;
    skos:altLabel "neuritic beading" ;
    skos:definition "Focal bead-like swellings in dendrites and axons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beading" .

goldbook:11635 a skos:Concept ;
    skos:definition "Assessment of the ability of an animal to remain upright and to walk on an elevated and relatively narrow beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam walking test" .

goldbook:11636 a skos:Concept ;
    skos:altLabel "Benton visual memory test" ;
    skos:definition "Procedure in which patterns on cards are memorized by a test subject who then attempts to recognize them on other cards presented subsequently." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Benton test" .

goldbook:11637 a skos:Concept ;
    skos:definition "A water labyrinth, described by Biel (1940), where rodents are forced to swim until they find a small underwater platform that allows them to escape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Biel water maze" .

goldbook:11638 a skos:Concept ;
    skos:altLabel "manic-depressive disorder" ;
    skos:definition "Psychiatric illness characterized by mood shifts with periods of severe depressive illness and one or more episodes of exaggerated activity levels (manic behavior)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bipolar disorder" .

goldbook:11639 a skos:Concept ;
    skos:altLabel "β-adrenergic antagonist",
        "β-adrenergic blocking agent",
        "β-adrenergic receptor antagonist",
        "β-adrenoreceptor antagonist",
        "β-antagonist" ;
    skos:definition "Any of a class of drugs that targets the $\\ce{\\upbeta\\!\\mbox{-}adrenergic receptor}$, interferes with binding of adrenalin and other related substances to the receptor, and weakens their effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-blocker" .

goldbook:11640 a skos:Concept ;
    skos:definition "Selectively permeable structure that restricts the exit of blood cells and many substances from the brain capillaries into the extracellular space of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood–brain barrier" .

goldbook:11641 a skos:Concept ;
    skos:definition "Functional restriction by cells of the choroid plexus of transit of substances from the cerebrospinal fluid into the extracellular space of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood–cerebrospinal fluid barrier" .

goldbook:11642 a skos:Concept ;
    skos:definition "Functional restriction of transit of substances from the blood to the retina by non-fenestrated endothelial cells with tight junctions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood–retinal barrier" .

goldbook:11643 a skos:Concept ;
    skos:altLabel "BNT" ;
    skos:definition "Procedure in which 60 pictures are shown to a subject who has to name them quickly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Boston naming test" .

goldbook:11644 a skos:Concept ;
    skos:definition "Bundle of nerve fibers that begins in the spine at the base of the neck, travels through the axilla (armpit region), and into the arm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brachial plexus" .

goldbook:11645 a skos:Concept ;
    skos:definition "Abnormally slow heart rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bradycardia" .

goldbook:11646 a skos:Concept ;
    skos:altLabel "hypokinesia" ;
    skos:definition "Abnormally slow body movement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bradykinesia" .

goldbook:11647 a skos:Concept ;
    skos:definition "That part of the central nervous system contained within the cranium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brain" .

goldbook:11648 a skos:Concept ;
    skos:altLabel "BDNF" ;
    skos:definition "Protein secreted by the brain that acts on neurons in the central and peripheral nervous systems; a member of the neurotrophin family of growth factors, related to the nerve growth factor (NGF)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brain-derived neurotrophic factor" .

goldbook:11649 a skos:Concept ;
    skos:definition "Movement of part of the brain across structures within the skull such as a shift across such structures as the falx cerebri, the tentorium cerebelli, and even sometimes through the foramen magnum in the base of the skull (through which the spinal cord connects with the brain)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brain herniation" .

goldbook:11650 a skos:Concept ;
    skos:definition "Slice of brain tissue immersed in artificial cerebrospinal fluid, used in electrophysiology experiments to allow study of a synapse or neural circuit in isolation from the rest of the brain, and in metabolic studies, under controlled physiological conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brain slice" .

goldbook:11651 a skos:Concept ;
    skos:definition "Unpaired subdivision of the brain, continuous with the spinal cord, that includes the thalamus, hypothalamus, pons, medulla oblongata, and the mesencephalon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brainstem" .

goldbook:11652 a skos:Concept ;
    skos:altLabel "Broca speech area" ;
    skos:definition "Region in the frontal lobe of one of the hemispheres (the speech-dominant hemisphere, usually the left) of the hominid brain that is involved in motor functions of speech production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Broca area" .

goldbook:11653 a skos:Concept ;
    skos:definition "Involuntary habitual grinding of the teeth, frequently during sleep." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bruxism" .

goldbook:11654 a skos:Concept ;
    skos:altLabel "trepanning",
        "trephination",
        "trephining" ;
    skos:definition "Medical intervention in which a hole is drilled or scraped into the human skull, exposing the dura mater, to gain access during surgery, to relieve intracranial pressure, to evacuate a subdural hematoma, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "burr hole surgery" .

goldbook:11655 a skos:Concept ;
    skos:altLabel "plasma cholinesterase",
        "pseudocholinesterase" ;
    skos:definition "Enzyme, found mainly in the liver, that hydrolyzes choline esters; it is non-specific and distinct from acetylcholinesterase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "butyrylcholinesterase" .

goldbook:11656 a skos:Concept ;
    skos:definition "Pyramidal neuron located in the cornu ammonis area 1, in the hippocampus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CA1-pyramidal cell" .

goldbook:11657 a skos:Concept ;
    skos:definition "Pyramidal neuron located in the cornu ammonis area 3, in the hippocampus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CA3-pyramidal cell" .

goldbook:11658 a skos:Concept ;
    skos:definition "Nematode with a well defined small neural network and homologues of human neurotransmitters, used as a model organism for studying normal development as well as neurotoxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>Caenorhabditis elegans</i>" .

goldbook:11659 a skos:Concept ;
    skos:definition "Procedure in which some common words are read aloud and the test subject is asked to recall as many of these as possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "california verbal learning test" .

goldbook:11660 a skos:Concept ;
    skos:definition "Malignant tumor of an epithelial cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcinoma" .

goldbook:11661 a skos:Concept ;
    skos:definition "One of two paired large arteries on either side of the neck that supplies most of the cerebralhemisphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carotid artery" .

goldbook:11662 a skos:Concept ;
    skos:altLabel "CTS" ;
    skos:definition "Median nerve entrapment neuropathy that causes paresthesia, pain, and numbness due to compression of the nerve at the wrist in the carpal tunnel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carpel tunnel syndrome" .

goldbook:11663 a skos:Concept ;
    skos:altLabel "konzo",
        "mantakassa" ;
    skos:definition "Epidemic paralytic disease, mainly affecting women and children, occurring in remote rural areas of African and Latin American countries, where cassava root is an important food." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cassavism" .

goldbook:11664 a skos:Concept ;
    skos:definition "Bundle of long spinal nerve roots arising from the end of the spinal cord and filling the lower part of the spinal canal (from approximately the thoraco-lumbar junction downwards)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cauda equina" .

goldbook:11665 a skos:Concept ;
    skos:altLabel "caudatum" ;
    skos:definition "Crescent-shaped mass of gray matter forming part of the corpus striatum and part of the basal ganglia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "caudate nucleus" .

goldbook:11666 a skos:Concept ;
    skos:definition "In or relating to the head." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cephalic" .

goldbook:11667 a skos:Concept ;
    skos:definition "Family of lipid molecules, each one composed of sphingosine and a fatty acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramide" .

goldbook:11668 a skos:Concept ;
    skos:definition "Abnormal protrusion of a portion of the cerebellum through the foramen magnum of the skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebellar tonsillar herniation" .

goldbook:11669 a skos:Concept ;
    skos:definition "Lower part of the brain that is beneath the posterior portion of the cerebrum, regulating the unconscious coordination of movement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebellum" .

goldbook:11670 a skos:Concept ;
    skos:definition "Member of a group of glycosphingolipids called monoglycosylceramides which are important components in animal nerve and muscle cell membranes and the myelin sheath." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebroside" .

goldbook:11671 a skos:Concept ;
    skos:definition "Principal part of the brain in vertebrates, located frontwards in the skull, consisting of the two hemispheres of the cerebral cortex separated by a fissure, and certain subcortical structures such as the hippocampus, basal ganglia, and the olfactory bulb." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cerebrum" .

goldbook:11672 a skos:Concept ;
    skos:definition "Part of the spine immediately inferior to the skull and connecting to the thoracic spine, made up of seven vertebrae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cervical spine" .

goldbook:11673 a skos:Concept ;
    skos:definition "Any of seven vertebrae that provide strength and structure to the cervical spine and support the head, allowing for its rotation and flexion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cervical vertebra" .

goldbook:11674 a skos:Concept ;
    skos:definition "Relating to or denoting a nerve that liberates acetylcholine at a synapse upon receiving an appropriate nerve impulse; in particular referring to parasympathetic nerve fibers. Relating to or denoting an agent that mimics or enhances the activity of acetylcholine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cholinergic" .

goldbook:11675 a skos:Concept ;
    skos:definition "Having an action similar to acetylcholine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cholinomimetic" .

goldbook:11676 a skos:Concept ;
    skos:altLabel "choreia" ;
    skos:definition "Neurological disorder characterized by rapid, jerky involuntary movements affecting especially the limbs or facial muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chorea" .

goldbook:11677 a skos:Concept ;
    skos:definition "Occurrence of involuntary movements in a combination of chorea and athetosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "choreoathetosis" .

goldbook:11678 a skos:Concept ;
    skos:definition "Disintegration of nuclear chromatin. Disintegration of Nissl bodies following neuronal injury." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatolysis" .

goldbook:11679 a skos:Concept ;
    skos:altLabel "CSE",
        "organic solvent syndrome",
        "toxic solvent syndrome" ;
    skos:definition "Constellation of neurological symptoms that may include polyneuropathies, encephalopathy, memory loss, attention deficit and dementia following long-term exposure, often occupational, to organic solvents found in paints, glues, and other industrial products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic solvent-induced encephalopathy" .

goldbook:11680 a skos:Concept ;
    skos:definition "Food-borne illness caused by ingesting fish containing ciguatera toxins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ciguatera poisoning" .

goldbook:11681 a skos:Concept ;
    skos:definition "Intrinsic smooth muscle of the eye that contracts to cause the lens to thicken, allowing accommodation to near vision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ciliary muscle" .

goldbook:11682 a skos:Concept ;
    skos:definition "Polypeptide hormone and nerve growth factor that promotes neurotransmitter synthesis and neurite outgrowth in certain neural populations including astrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ciliary neurotrophic factor" .

goldbook:11683 a skos:Concept ;
    skos:definition "Alternate involuntary muscular contraction and relaxation in rapid succession. Continuous rhythmic reflex tremor initiated by the spinal cord below an area of spinal cord injury, set in motion by reflex testing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonus" .

goldbook:11684 a skos:Concept ;
    skos:definition "Sum of the mental processes by which sensory input is stored, recovered, and used by the consciousbrain, including attention, memory, language usage, learning, reasoning, problem solving, and decision making." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cognition" .

goldbook:11685 a skos:Concept ;
    skos:definition "State of profound unconsciousness lasting more than several hours in which one cannot respond to stimuli and from which one cannot be roused." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coma" .

goldbook:11686 a skos:Concept ;
    skos:altLabel "CAR",
        "CAR Test" ;
    skos:definition "Experimental procedure in which an adverse effect (e.g., foot shock, drug withdrawal) is delivered to rats or mice after presentation of a cue (e.g., light or sound); the rodents are trained to avoid rather than escape the shock after the start of its delivery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conditioned avoidance response test" .

goldbook:11687 a skos:Concept ;
    skos:altLabel "Pavlovian conditioning",
        "respondent conditioning" ;
    skos:definition "Learning in which a behavior comes to be elicited as a reflex response by association with a neutral antecedent stimulus through repetition of the stimulus-response pairing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "classical conditioning" .

goldbook:11688 a skos:Concept ;
    skos:altLabel "instrumental conditioning" ;
    skos:definition "Learning in which appropriate behavior is rewarded, or inappropriate behavior is punished; behavior is modified by learned association with antecedents and consequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "operant conditioning" .

goldbook:11689 a skos:Concept ;
    skos:definition "Mental state of bewilderment or disorientation in which reactions to environmental stimuli may be inappropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confusion" .

goldbook:11690 a skos:Concept ;
    skos:definition "Aware of and responding to one’s surroundings." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conscious" .

goldbook:11691 a skos:Concept ;
    skos:altLabel "CPT" ;
    skos:definition "Any of several available neuropsychological procedures that measure a person’s sustained attention." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous performance test" .

goldbook:11692 a skos:Concept ;
    skos:altLabel "contraction" ;
    skos:definition "Persistent shortening and tightening of muscle, tendon, or other tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contracture" .

goldbook:11693 a skos:Concept ;
    skos:definition "Any material (usually opaque to X-rays) employed to delineate or define a structure during a radiologic procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contrast medium" .

goldbook:11694 a skos:Concept ;
    skos:definition "Part of the hippocampus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cornu ammonis" .

goldbook:11695 a skos:Concept ;
    skos:definition "Vertical (longitudinal) plane dividing the body into ventral and dorsal (front and back) sections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coronal" .

goldbook:11696 a skos:Concept ;
    skos:definition "Transverse junction in the skull separating the frontal bone from the parietal bones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coronal suture" .

goldbook:11697 a skos:Concept ;
    skos:definition "Bundle of myelin-enriched neural fibers beneath the cortex connecting the two hemispheres of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corpus callosum" .

goldbook:11698 a skos:Concept ;
    skos:definition "Striatum together with the globus pallidus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corpus striatum" .

goldbook:11699 a skos:Concept ;
    skos:definition "Painful muscle spasm caused by prolonged tetanic contraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cramp" .

goldbook:11700 a skos:Concept ;
    skos:definition "Each of 12 pairs of nerves that arise directly from the brain, not from the spinal cord, and pass through separate apertures in the skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cranial nerve" .

goldbook:11701 a skos:Concept ;
    skos:definition "Congenital tumor arising from the pituitary gland in the embryonic tissue between the brain and pharynx." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "craniopharyngioma" .

goldbook:11702 a skos:Concept ;
    skos:definition "Stimulus or associated feature of a stimulus that evokes a response or alerts the subject to a particular behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cue" .

goldbook:11703 a skos:Concept ;
    skos:definition "State of severe confusion, characterized by restlessness, hallucinations and hyperactivity, during which the person affected may be isolated from normal communication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delirium" .

goldbook:11704 a skos:Concept ;
    skos:definition "Serious loss of brain function in a previously unimpaired person, affecting memory, thinking, and behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dementia" .

goldbook:11705 a skos:Concept ;
    skos:definition "Dementia, often of the Alzheimer type (see Alzheimer disease) developing at or before age 65." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "presenile dementia" .

goldbook:11706 a skos:Concept ;
    skos:definition "Dementia, often of the Alzheimer type (see Alzheimer disease) developing after the age of 65." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "senile dementia" .

goldbook:11707 a skos:Concept ;
    skos:altLabel "demyelinization" ;
    skos:definition "Destruction of the protective myelin sheath that surrounds nerve fibers, resulting in diminished function and decreased action potential in those nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "demyelination" .

goldbook:11708 a skos:Concept ;
    skos:definition "Narrow strip of cerebral cortex associated with the hippocampus that continues forward to the uncus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dentate gyrus" .

goldbook:11709 a skos:Concept ;
    skos:altLabel "drug addiction" ;
    skos:definition "Craving for or addiction to a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical dependency" .

goldbook:11710 a skos:Concept ;
    skos:definition "Relative reduction in the resting membrane potential of an excitable cell, generally making the inside less negative, or even positive with respect to the outside." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depolarization" .

goldbook:11711 a skos:Concept ;
    skos:definition "Reduction in the activity of the central nervous system. Mental state or disorder characterized by feelings of sadness and despair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depression" .

goldbook:11712 a skos:Concept ;
    skos:definition "Adverse effects of toxic substances on the development of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental neurotoxicity" .

goldbook:11713 a skos:Concept ;
    skos:altLabel "DNT" ;
    skos:definition "Any examination that allows detection of substance-induced changes in the structural or functional integrity of the nervous system of a developing organism, fetus or child." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental neurotoxicity testing" .

goldbook:11714 a skos:Concept ;
    skos:altLabel "sudorific" ;
    skos:definition "n. Substance inducing perspiration. adj. Of a human, sweating heavily." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diaphoretic" .

goldbook:11715 a skos:Concept ;
    skos:altLabel "DSP",
        "diarrhetic shellfish poisoning (DSP)" ;
    skos:definition "Serious illness characterized primarily by diarrhea with rapid onset and resolution after \\(\\pu{24 h}\\) that is a consequence of consumption of bivalve shellfish (mollusks) such as mussels, oysters, and clams that have ingested, by filter feeding, large quantities of dinoflagellates containing a group of high-molecular-weight structures with multiple ether linkages, such as okadaic acid, dinophysis toxins, pectenotoxins, and yessotoxin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diarrheal shellfish poisoning" .

goldbook:11716 a skos:Concept ;
    skos:definition "Process by which a cell is committed to a lineage and becomes more specialized in structure and function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differentiation" .

goldbook:11717 a skos:Concept ;
    skos:altLabel "digit span task" ;
    skos:definition "Test of memory in which numbers (series of digits) are presented orally or on a computer screen to a test subject who is asked to repeat each number from memory; the numbers increase in length until mistakes are made." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "digit span test" .

goldbook:11718 a skos:Concept ;
    skos:altLabel "DSST",
        "digit symbol test" ;
    skos:definition "Neuropsychological assessment in which the top two rows of a test sheet function as a key, displaying numbers 1–9 (upper row) matched to 'non-sense' symbols (lower row). There follow pairs of rows where the numbers 1–9 appear in irregular sequence and the test subject must match the correct symbol from the key to each number, as quickly as possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "digit symbol substitution test" .

goldbook:11719 a skos:Concept ;
    skos:altLabel "double vision" ;
    skos:definition "Simultaneous perception of two images of a single object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diplopia" .

goldbook:11720 a skos:Concept ;
    skos:altLabel "spinal disc" ;
    skos:definition "Flat circular structure, consisting of a tough, fibrous exterior and a gelatinous core, interposed between adjacent vertebrae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intervertebral disc" .

goldbook:11721 a skos:Concept ;
    skos:definition "Loss of sense of direction. In clinical assessment, lack of awareness of one’s identity, present location, or the current day and time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disorientation" .

goldbook:11722 a skos:Concept ;
    skos:altLabel "(2S,3S,4S)-4-[(2Z,4E,6R)-6-carboxy-6-methylhexa-2,4-dien-2-yl]-3-(carboxymethyl)pyrrolidine-2-carboxylic acid" ;
    skos:definition "Neurotoxickainic acid analog produced by some algal blooms that causes amnesic shellfish poisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "domoic acid" .

goldbook:11723 a skos:Concept ;
    skos:altLabel "4-(2-aminoethyl)benzene-1,2-diol" ;
    skos:definition "Naturally occurring substance functioning as a neurotransmitter in the sympathetic nervous system, and a metabolic precursor of other substances including adrenalin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dopamine" .

goldbook:11724 a skos:Concept ;
    skos:definition "Relating to a nerve that releases or responds to dopamine as a neurotransmitter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dopaminergic" .

goldbook:11725 a skos:Concept ;
    skos:altLabel "posterior root of spinal nerve" ;
    skos:definition "Outgrowth of a spinal nerve that carries sensory signals to an appropriate integration center in the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dorsal root" .

goldbook:11726 a skos:Concept ;
    skos:definition "Nodule on a dorsal root of the spine that consists of afferent sensory neuronal cell bodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dorsal root ganglion" .

goldbook:11727 a skos:Concept ;
    skos:definition "Outermost and most fibrous of the three membranes of the meninges (see meninx) covering the brain and the spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dura mater" .

goldbook:11728 a skos:Concept ;
    skos:definition "Protein associated with motile structures that exhibits adenosine triphosphatase activity; it forms 'arms' on the outer microtubules of cilia and flagella and functions as a molecular motor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynein" .

goldbook:11729 a skos:Concept ;
    skos:definition "Member of a class of opioid peptides that arise from the precursor protein prodynorphin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynorphin" .

goldbook:11730 a skos:Concept ;
    skos:definition "Impairment of the sense of touch." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysaphia" .

goldbook:11731 a skos:Concept ;
    skos:definition "Difficulty in speech owing to disturbances of muscular control resulting from central or peripheral nervous system damage or emotional stress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysarthria" .

goldbook:11732 a skos:Concept ;
    skos:definition "Condition in which a disagreeable sensation, especially of touch, is produced following damage to peripheral or central sensory pathways. Abnormal sensation experienced in the absence of stimulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysesthesia" .

goldbook:11733 a skos:Concept ;
    skos:definition "Difficulty in writing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysgraphia" .

goldbook:11734 a skos:Concept ;
    skos:definition "Difficulty or abnormality in voluntary movement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dyskinesia" .

goldbook:11735 a skos:Concept ;
    skos:definition "Involuntary, repetitive body movement of slow onset." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tardive dyskinesia" .

goldbook:11736 a skos:Concept ;
    skos:definition "Impairment in appreciation of spatial relations, often leading to difficulty in reading." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dyslexia" .

goldbook:11737 a skos:Concept ;
    skos:definition "Difficulty in swallowing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysphagia" .

goldbook:11738 a skos:Concept ;
    skos:definition "Difficulty in the use of language owing to a brain lesion, without mental impairment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysphasia" .

goldbook:11739 a skos:Concept ;
    skos:altLabel "AD" ;
    skos:definition "Over-activity of the autonomic nervous system causing an abrupt onset of excessively high blood pressure, tachycardia, and constriction of peripheral blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autonomic dysreflexia" .

goldbook:11740 a skos:Concept ;
    skos:definition "State of abnormal (either hypo- or hypertonic) muscle tone resulting in impairment of voluntary movement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dystonia" .

goldbook:11741 a skos:Concept ;
    skos:definition "Carrying outward; of nerves, those that conduct impulses outward from the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efferent" .

goldbook:11742 a skos:Concept ;
    skos:altLabel "ECT",
        "electroshock therapy" ;
    skos:definition "Therapeutic intervention in which seizures are electrically induced in patients with the aim of providing relief from a specific mental illness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroconvulsive therapy" .

goldbook:11743 a skos:Concept ;
    skos:definition "Test or record of brain electrical activity detected by electroencephalography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroencephalogram" .

goldbook:11744 a skos:Concept ;
    skos:altLabel "EEG" ;
    skos:definition "Recording of electrical activity from different parts of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroencephalography" .

goldbook:11745 a skos:Concept ;
    skos:altLabel "EMG" ;
    skos:definition "Recording of the electrical activity of muscle, or its representation as a visual display or audible signal, using electrodes attached to the skin or inserted into a muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromyography" .

goldbook:11746 a skos:Concept ;
    skos:definition "Non-invasive method used to examine the integrity and conductivity of a peripheral nerve, in which a brief electrical stimulation is given to the nerve at one point, while at the same time the induced electrical activity (compound action potentials) is recorded at another point of the nerve’s distribution and the interval is displayed on a video monitor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroneurography" .

goldbook:11747 a skos:Concept ;
    skos:definition "Study of the electrical properties of cells and tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophysiology" .

goldbook:11748 a skos:Concept ;
    skos:altLabel "ERG" ;
    skos:definition "Recording, with electrodes placed on the cornea or nearby skin, of the electrical activity of photoreceptors and other retinal cells in response to standardized, patterned stimuli with light and colour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroretinogram" .

goldbook:11749 a skos:Concept ;
    skos:definition "Stage with four orthogonal side arms elevated above the floor, where two opposite arms have sidewalls and the other two arms have no walls; used as research tool for anxiety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elevated plus maze" .

goldbook:11750 a skos:Concept ;
    skos:definition "Vomiting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emesis" .

goldbook:11751 a skos:Concept ;
    skos:definition "n. Substance that produces vomiting. adj. Producing vomiting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emetic" .

goldbook:11752 a skos:Concept ;
    skos:definition "Any disorder of the brain that affects its functioning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encephalopathy" .

goldbook:11753 a skos:Concept ;
    skos:altLabel "endocrine modifier" ;
    skos:definition "Exogenous chemical that alters function(s) of the endocrine system and consequently causes adverse health effects in an intact organism, its progeny, or (sub)populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocrine disruptor" .

goldbook:11754 a skos:Concept ;
    skos:definition "One of several peptides (including the enkephalins) that activates the body’s opiate receptors, causing an analgesic effect; literally, endogenous morphine-like substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endorphin" .

goldbook:11755 a skos:Concept ;
    skos:definition "Either of two endogenous pentapeptides with opiate-like effects that are especially involved in modulating pain responses in the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enkephalin" .

goldbook:11756 a skos:Concept ;
    skos:definition "Glial cells that line the cavities within the brain’sventricles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ependymal tissue" .

goldbook:11757 a skos:Concept ;
    skos:definition "Growth in the brain or spinal cord arising from ependymal tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ependymoma" .

goldbook:11758 a skos:Concept ;
    skos:altLabel "extradural" ;
    skos:definition "Immediately outside the dura mater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epidural" .

goldbook:11759 a skos:Concept ;
    skos:definition "Dorsal part of the diencephalon, including the pineal gland and adjacent structures in the roof of the third ventricle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epithalamus" .

goldbook:11760 a skos:Concept ;
    skos:altLabel "St Anthony’s fire",
        "ignis infernalis",
        "ignis sacer" ;
    skos:definition "Poisoning produced by eating food affected by ergot (ergotamine alkaloids), substances produced by the fungus Claviceps purpurea that contaminate rye and wheat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ergotism" .

goldbook:11761 a skos:Concept ;
    skos:definition "Characterized by or feeling intense excitement and happiness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "euphoria" .

goldbook:11762 a skos:Concept ;
    skos:definition "Electrical potential that is triggered by presentation of a stimulus (somatosensory, auditory, visual) and measured with electrodes near the nerve or near the brain region in which the signal is processed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evoked potential" .

goldbook:11763 a skos:Concept ;
    skos:definition "Electrical potential recorded from the nervous system following exposure to a stimulus, as distinct from spontaneous potentials detected by electroencephalography, electromyography, or other electrophysiological recording methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evoked response" .

goldbook:11764 a skos:Concept ;
    skos:definition "Cell that can be stimulated to create an electric current; muscle fibers and nerve cells are excitable (see excitation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitable cell" .

goldbook:11765 a skos:Concept ;
    skos:altLabel "EPSP" ;
    skos:definition "Referring to a more positive membrane potential at the postsynaptic side of the synaptic cleft that renders the postsynaptic neuron more likely to generate an action potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitatory post-synaptic potential" .

goldbook:11766 a skos:Concept ;
    skos:definition "Pathological process by which neurons are damaged and killed by the overactivation of receptors for the excitatory neurotransmitter glutamate, such as the N-methyl-D-aspartic acid (NMDA) receptor and the 2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid (AMPA) receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitotoxicity" .

goldbook:11767 a skos:Concept ;
    skos:definition "Neural facilitation: Increase in postsynaptic excitation as a result of very rapid firing of action potentials by a presynaptic neuron. Presynaptic facilitation: Increase of presynaptic excitation when an excited neuron receives additional excitatory impulses from other neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "facilitation" .

goldbook:11768 a skos:Concept ;
    skos:altLabel "falx cerebri" ;
    skos:definition "Continuation of dura mater between the right and left hemispheres of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "falx" .

goldbook:11769 a skos:Concept ;
    skos:definition "Involuntary contractions, or twitchings, of groups (fasciculi) of muscle fibers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fasciculation" .

goldbook:11770 a skos:Concept ;
    skos:definition "Rapid contractions or twitching of muscle fibrils, but not of the muscle as a whole." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibrillation" .

goldbook:11771 a skos:Concept ;
    skos:altLabel "tapping test" ;
    skos:definition "Procedure in which a test subject is asked to tap a finger at maximal rate on a surface, a higher rate of tapping indicating better neuromuscular function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "finger tapping test" .

goldbook:11772 a skos:Concept ;
    skos:definition "Relaxed, flabby, or without tone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flaccid" .

goldbook:11773 a skos:Concept ;
    skos:definition "Most anterior of the four major lobes of each cerebral hemisphere, containing the primary motor cortex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frontal lobe" .

goldbook:11774 a skos:Concept ;
    skos:altLabel "FTD",
        "frontotemporal lobular degeneration (FTLD)" ;
    skos:definition "Neurodegenerative disease characterized by progressive neuronal defects in the frontal and temporal lobes of the brain, leading to dementia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frontotemporal dementia" .

goldbook:11775 a skos:Concept ;
    skos:definition "In the brain, referring to the concept that discrete regions are involved in specific aspects of cognitive function, thus giving rise to modularity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional domain" .

goldbook:11776 a skos:Concept ;
    skos:definition "Structured set of tests to examine changes in neuromuscular, arousal, autonomic and sensory functions that assesses the presence, absence or severity of specific neurological signs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional observational battery" .

goldbook:11777 a skos:Concept ;
    skos:altLabel "FUS",
        "FUS transcription factor" ;
    skos:definition "Nuclear DNA- and RNA-binding protein involved in transcription, splicing, and RNA-transport." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fused in sarcoma transcription factor" .

goldbook:11778 a skos:Concept ;
    skos:definition "Pertaining to the action of $\\ce{\\upgamma\\!\\mbox{-}aminobutyric acid}$ or to neural or metabolic pathways in which it functions as a neurotransmitter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "GABAergic" .

goldbook:11779 a skos:Concept ;
    skos:definition "Cluster of nerve cell bodies located outside the brain and spinal cord, i.e., in the peripheral nervous system.Note: Ganglia interconnect to form a complex network known as a plexus and serve as relay stations where different neurons can modulate the signals of each other. Compare: basal ganglion. Fibrous cyst usually attached to a tendon sheath." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ganglion" .

goldbook:11780 a skos:Concept ;
    skos:definition "Neuron located in a ganglion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ganglion cell" .

goldbook:11781 a skos:Concept ;
    skos:definition "Glycosphingolipid chemically similar to cerebrosides but containing one or more sialic (N-acetylneuraminic or N-glycolylneuraminic) acid residues, found principally in nerve tissue, spleen, and thymus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ganglioside" .

goldbook:11782 a skos:Concept ;
    skos:altLabel "squid giant axon" ;
    skos:definition "Very large axon (typically \\(\\pu{0.5 mm}\\) in diameter) that functions in the propulsion system of the squid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "giant axon" .

goldbook:11783 a skos:Concept ;
    skos:definition "Rare human genetic neurological disorder in which the neurofilaments become disordered, resulting in abnormal size and shape of neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "giant axonal neuropathy" .

goldbook:11784 a skos:Concept ;
    skos:altLabel "neuroglia" ;
    skos:definition "Non-neuronal cellular elements of the central and peripheral nervous system having metabolic and support functions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glia" .

goldbook:11785 a skos:Concept ;
    skos:definition "Cellular component of the glia, including oligodendroglial cells, astrocytes, ependymal cells and microglial cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glial cell" .

goldbook:11786 a skos:Concept ;
    skos:altLabel "GDNF" ;
    skos:definition "Protein that promotes and guides the growth of neurons and facilitates the survival of mature neurons by suppressing cell death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glial-derived neurotrophic factor" .

goldbook:11787 a skos:Concept ;
    skos:altLabel "GFAP" ;
    skos:definition "Cytoskeletal intermediate filament protein found in mature fibrillary astrocytes and in neural progenitor cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glial fibrillary acidic protein" .

goldbook:11788 a skos:Concept ;
    skos:altLabel "glioblastoma multiforme" ;
    skos:definition "Glioma consisting chiefly of undifferentiated anaplastic cells of astrocytic origin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glioblastoma" .

goldbook:11789 a skos:Concept ;
    skos:definition "Neoplasm originating from any of the glia cells in the brain and spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glioma" .

goldbook:11790 a skos:Concept ;
    skos:definition "Damage-induced proliferation, enlargement and overgrowth of glial cells, often astrocytes in the central nervous system, resulting in an astrocytic scar." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive gliosis" .

goldbook:11791 a skos:Concept ;
    skos:definition "Glycosphingolipid, specifically a ceramide tetrasaccharide (tetraglycosylceramide), isolated from kidney and erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "globoside" .

goldbook:11792 a skos:Concept ;
    skos:definition "Salt of glutamic acid (2-aminopentanedioic acid)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glutamate" .

goldbook:11793 a skos:Concept ;
    skos:definition "Form of excitotoxicity where excess glutamate release in synapses (glutamatergic storm) leads to overstimulation, followed by excess cellular calcium uptake, cytotoxicity and apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glutamate-induced excitotoxicity" .

goldbook:11794 a skos:Concept ;
    skos:altLabel "Golgi’s method" ;
    skos:definition "Method of silver staining of histological sections of tissue from the nervous system, in which a limited number of neurons stain in their entirety upon formation of microcrystals of silver chromate, thus allowing visualization in the light microscope of some individual neurons in densely packed tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Golgi staining" .

goldbook:11795 a skos:Concept ;
    skos:altLabel "GPCR" ;
    skos:definition "Seven-transmembrane-domain receptor that interacts with guanosine triphosphate/diphosphate (GTP/GDP) binding proteins to initiate signal transduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "G protein-coupled receptor" .

goldbook:11796 a skos:Concept ;
    skos:definition "One of several types of neurons with small cell bodies, involved in neural networks in several regions of the brain, including the cerebellum, hippocampus, and cerebral cortex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granule cell" .

goldbook:11797 a skos:Concept ;
    skos:altLabel "GBS" ;
    skos:definition "Type of idiopathic polyneuritis in which autoimmunity to peripheral nerve, myelin leads to a condition characterized by chronic demyelination of the spinal roots (see spinal cord), peripheral nerves, and cranial nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Guillain–Barré syndrome" .

goldbook:11798 a skos:Concept ;
    skos:definition "Decrease or cessation of a response to a stimulus after its repeated presentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "habituation" .

goldbook:11799 a skos:Concept ;
    skos:definition "The apparent, often strong, subjective perception of an external object or event when no such stimulus or situation is present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hallucination" .

goldbook:11800 a skos:Concept ;
    skos:definition "Pain in one or more parts of the cranium, not confined to the area of distribution of any nerve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "headache" .

goldbook:11801 a skos:Concept ;
    skos:definition "Headache caused by stopping analgesics following their overuse to relieve headaches." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rebound headache" .

goldbook:11802 a skos:Concept ;
    skos:definition "Headache associated with anxiety or other states of distress, associated with chronic contraction of the scalp muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tension headache" .

goldbook:11803 a skos:Concept ;
    skos:definition "Region of bleeding into a tissue or organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hematoma" .

goldbook:11804 a skos:Concept ;
    skos:definition "Paralysis of one side of the body, including the arm, trunk and leg." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemiplegia" .

goldbook:11805 a skos:Concept ;
    skos:definition "Cerebralhemisphere containing the representation of speech and controlling arm and leg preference in skilled movements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dominant hemisphere" .

goldbook:11806 a skos:Concept ;
    skos:definition "Copious escape of blood from a disrupted blood vessel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemorrhage" .

goldbook:11807 a skos:Concept ;
    skos:definition "Procedure using birds to study acute and delayed neurotoxicity, notably of organophosphates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hen test" .

goldbook:11808 a skos:Concept ;
    skos:definition "Maintenance in vitro of fresh prepared slices of the hippocampus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hippocampal slice culture" .

goldbook:11809 a skos:Concept ;
    skos:altLabel "2-(1H-imidazol-4-yl)ethanamine" ;
    skos:definition "Bioactive metabolite produced in living organisms by deamination of the amino acid histidine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histamine" .

goldbook:11810 a skos:Concept ;
    skos:definition "Pertaining to the action of histamine or to neural pathways in which it functions as a neurotransmitter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histaminergic" .

goldbook:11811 a skos:Concept ;
    skos:definition "Genetic autosomal dominant neurodegenerative disease resulting from a mutation in the Huntingtin gene and resulting notably in decline of cognitive function and a characteristic chorea." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Huntington disease" .

goldbook:11812 a skos:Concept ;
    skos:definition "Hydrocephalus where flow of cerebrospinal fluid is not blocked but there is failure of its reabsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "communicating hydrocephalus" .

goldbook:11813 a skos:Concept ;
    skos:definition "Hydrocephalus where flow of the cerebrospinal fluid is blocked." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "obstructive hydrocephalus" .

goldbook:11814 a skos:Concept ;
    skos:definition "Pathological dilation of the spinal cord due to expansion of the cerebrospinal fluid-filled central canal of the cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydromyelia" .

goldbook:11815 a skos:Concept ;
    skos:altLabel "3-(2-aminoethyl)-1H-indol-5-ol",
        "5-HT",
        "serotonin" ;
    skos:definition "Neurotransmitter found in the digestive tract, platelets and central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "5-hydroxytryptamine" .

goldbook:11816 a skos:Concept ;
    skos:definition "Abnormally increased carbon dioxide concentration in the blood resulting in a increased rate and depth of breathing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypercapnia" .

goldbook:11817 a skos:Concept ;
    skos:definition "Excessive sensitivity to touch, pain, or other sensory stimuli." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperesthesia" .

goldbook:11818 a skos:Concept ;
    skos:definition "Transient increase in membrane polarization of nerve cells or muscle cells; the opposite of depolarization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperpolarization" .

goldbook:11819 a skos:Concept ;
    skos:definition "Increased or exaggerated reflex response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperreflexia" .

goldbook:11820 a skos:Concept ;
    skos:definition "Extreme tension of the muscles or arteries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypertonia" .

goldbook:11821 a skos:Concept ;
    skos:definition "Agent that may reduce anxiety and induces sleep." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypnotic" .

goldbook:11822 a skos:Concept ;
    skos:definition "Abnormally decreased carbon dioxide concentration in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypocapnia" .

goldbook:11823 a skos:Concept ;
    skos:definition "Surgical removal of the pituitary gland (hypophysis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypophysectomy" .

goldbook:11824 a skos:Concept ;
    skos:definition "Diminished reflex response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyporeflexia" .

goldbook:11825 a skos:Concept ;
    skos:definition "Subnormal arterial blood pressure.Note: Hypotension can be a cause of dizziness, weakness and fainting. Lower than normal pressure or tension of any kind (used less commonly)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypotension" .

goldbook:11826 a skos:Concept ;
    skos:definition "Condition in which there is a diminution or loss of muscle tone. Relaxation of the arteries. Lower than normal tension in any part, as in intraocular pressure of the eyeball." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypotonia" .

goldbook:11827 a skos:Concept ;
    skos:definition "Sudden attack, stroke or seizure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ictus" .

goldbook:11828 a skos:Concept ;
    skos:definition "Particle in a cell, detectable under the light microscope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inclusion body" .

goldbook:11829 a skos:Concept ;
    skos:definition "Part of the cerebellum that is important for a number of motor functions, including balance, position sensing and coordination of movement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inferior cerebellar peduncle" .

goldbook:11830 a skos:Concept ;
    skos:definition "Reaction of the body to injury or to infectious, allergic, or chemical irritation; characterized by redness, swelling, heat, and pain resulting from dilation of the blood vessels accompanied by loss of plasma and leukocytes into the tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inflammation" .

goldbook:11831 a skos:Concept ;
    skos:definition "Below the tentorium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infratentorial" .

goldbook:11832 a skos:Concept ;
    skos:altLabel "IPSP" ;
    skos:definition "Referring to a more negative membrane potential at the postsynaptic side of the synaptic cleft that renders the postsynaptic neuron less likely to generate an action potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibitory post-synaptic potential" .

goldbook:11833 a skos:Concept ;
    skos:definition "Substance intended to kill insects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insecticide" .

goldbook:11834 a skos:Concept ;
    skos:definition "Inability to sleep during the period when sleep should normally occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insomnia" .

goldbook:11835 a skos:Concept ;
    skos:altLabel "IQ",
        "IQ test" ;
    skos:definition "Numeric measure of a person’s cognitive function based on one of several standardized tests of a problem-solving nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intelligence quotient" .

goldbook:11836 a skos:Concept ;
    skos:altLabel "ICP" ;
    skos:definition "Pressure within the cranial cavity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intracranial pressure" .

goldbook:11837 a skos:Concept ;
    skos:definition "Within a sheath, as within either the subarachnoid or the subdural space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrathecal" .

goldbook:11838 a skos:Concept ;
    skos:definition "Pore-forming transmembrane protein that can gate the transmembrane flux of small ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion channel" .

goldbook:11839 a skos:Concept ;
    skos:definition "Neuromuscular disease resulting from a genetic defect in an ion channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion channelopathy" .

goldbook:11840 a skos:Concept ;
    skos:altLabel "Iba-1",
        "allograft inflammatory factor 1 (AIF-1)" ;
    skos:definition "Protein that is expressed in several tissues, but in brain is a specific immunomarker for microglia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionized calcium-binding adapter molecule 1" .

goldbook:11841 a skos:Concept ;
    skos:definition "Set of neurobehavioral tests, including observations of behavior in novel environments, of reactions, and of motor functions; used in various modifications and resembling the functional observational battery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Irwin battery" .

goldbook:11842 a skos:Concept ;
    skos:altLabel "(2S,3S,4S)-3-(carboxymethyl)-4-(prop-1-en-2-yl)pyrrolidine-2-carboxylic acid" ;
    skos:definition "Natural amino acid produced by some seaweeds that activates a subclass of glutamate receptors ('kainate receptors') to produce excitotoxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kainic acid" .

goldbook:11843 a skos:Concept ;
    skos:definition "Increase of epileptogenic activities as a result of repeated, longer-lasting subthreshold brain stimulation, e.g., with electrical stimuli." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kindling" .

goldbook:11844 a skos:Concept ;
    skos:definition "Secretion and discharge of tears." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lacrimation" .

goldbook:11845 a skos:Concept ;
    skos:altLabel "Lanthony D-15 desaturated hue panel" ;
    skos:definition "Test of color vision using 15 distinct color chips with low color saturation that have to be arranged in a correct order." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lanthony D-15 color test" .

goldbook:11846 a skos:Concept ;
    skos:definition "Not yet manifest; dormant but potentially discernible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latent" .

goldbook:11847 a skos:Concept ;
    skos:altLabel "grass pea poisoning" ;
    skos:definition "Disease characterised by spastic paralysis of the legs and lower part of the body, pain, hyperesthesia, and paresthesia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lathyrism" .

goldbook:11848 a skos:Concept ;
    skos:definition "Relatively mild impairment of consciousness resulting in reduced alertness and awareness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethargy" .

goldbook:11849 a skos:Concept ;
    skos:altLabel "2-diol",
        "4-[(1S)-2-amino-1-hydroxyethyl]benzene-1",
        "S-noradrenaline" ;
    skos:definition "Levorotatory isomer of norepinephrine, having greater pressor activity than the natural dextrorotatory isomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "levarterenol" .

goldbook:11850 a skos:Concept ;
    skos:definition "Conscious or unconscious sexual desire; passionate interest in life force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "libido" .

goldbook:11851 a skos:Concept ;
    skos:definition "Ion channel that opens upon binding an activating ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand-gated ion channel" .

goldbook:11852 a skos:Concept ;
    skos:definition "Collection of interconnected neurons lying underneath the cerebrum on either side of the thalamus, related more by anatomical location than as a single functional entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limbic system" .

goldbook:11853 a skos:Concept ;
    skos:definition "Benign tumor of the adipose tissue, often visible under the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipoma" .

goldbook:11854 a skos:Concept ;
    skos:definition "One of the four main regions of the cerebral cortex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lobe" .

goldbook:11855 a skos:Concept ;
    skos:definition "Neuron that receives impulses from an upper motor neuron and whose axons innervate the skeletal muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lower motor neuron" .

goldbook:11856 a skos:Concept ;
    skos:definition "Portion of the vertebral column of the lower back between the thoracic spine and sacrum, in humans consisting of five vertebrae designated L1 to L5." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lumbar spine" .

goldbook:11857 a skos:Concept ;
    skos:definition "Noninvasive method based on nuclear spin alignment that allows localization of levels and measurement of kinetics of an injected labeled substances in living tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic resonance spectroscopy" .

goldbook:11858 a skos:Concept ;
    skos:definition "Condition of manganese poisoning, usually after chronic inhalation exposure to manganese fumes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "manganism" .

goldbook:11859 a skos:Concept ;
    skos:definition "Labyrinthine system, in which the ability of an animal (usually a rodent) to find a direct route from a starting point to a specific location is observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maze" .

goldbook:11860 a skos:Concept ;
    skos:definition "Highly malignant, invasive brain tumor of embryonal origin, arising in the posterior fossa, usually from the cerebellum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medulloblastoma" .

goldbook:11861 a skos:Concept ;
    skos:definition "Occurrence of a potential difference across a biological membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane polarization" .

goldbook:11862 a skos:Concept ;
    skos:definition "Plural of meninx." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meninges" .

goldbook:11863 a skos:Concept ;
    skos:definition "Firm, often vascular, tumor arising from the meninges of the brain or spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meningioma" .

goldbook:11864 a skos:Concept ;
    skos:definition "Inflammation or infection of the meninges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meningitis" .

goldbook:11865 a skos:Concept ;
    skos:altLabel "cerebromeningitis",
        "encephalomeningitis" ;
    skos:definition "Inflammation of the brain and meninges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meningoencephalitis" .

goldbook:11866 a skos:Concept ;
    skos:definition "Protrusion of both the meninges and brain tissue through a defect in the skull." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meningoencephalocele" .

goldbook:11867 a skos:Concept ;
    skos:definition "Formerly used term to describe intellectual disability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mental retardation" .

goldbook:11868 a skos:Concept ;
    skos:definition "Mental activity, conscious or unconscious, but especially referring to thinking and reasoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mentation" .

goldbook:11869 a skos:Concept ;
    skos:altLabel "NMDA" ;
    skos:definition "Excitotoxic non-essential amino acid used experimentally to identify a specific subset of glutamatereceptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>N</em>-methyl-D-aspartate" .

goldbook:11870 a skos:Concept ;
    skos:altLabel "NMDA-type glutamate receptor" ;
    skos:definition "One of the various types of receptors of the neurotransmitterglutamate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>N</em>-methyl-D-aspartate-type glutamate receptor" .

goldbook:11871 a skos:Concept ;
    skos:altLabel "MPTP" ;
    skos:definition "Synthetic substance causing parkinsonism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine" .

goldbook:11872 a skos:Concept ;
    skos:definition "Small glial cell; resident macrophage derived as a mononuclear phagocyte that populates the brain in early development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microglial cell" .

goldbook:11873 a skos:Concept ;
    skos:definition "Morphological response of microglia to injury, characterized by hypertrophy and amoeboid morphology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microgliosis" .

goldbook:11874 a skos:Concept ;
    skos:definition "Recurrent syndrome usually characterized by unilateral head pain accompanied by symptoms including nausea and vomiting, vertigo, photophobia and other visual phenomena." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migraine" .

goldbook:11875 a skos:Concept ;
    skos:definition "Stroke that occurs in connection with a migraine attack." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migrainous infarction" .

goldbook:11876 a skos:Concept ;
    skos:altLabel "MMPI",
        "MMPI-2-RF" ;
    skos:definition "Questionnaire type of psychological test for ages 18 and older. The RF version has 338 true–false statements with seven validity and ten personality scales that may be used in either an individual or group format." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Minnesota multiphasic personality inventory" .

goldbook:11877 a skos:Concept ;
    skos:definition "Abnormal contraction of the pupil of the eye to less than \\(\\pu{2 mm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miosis" .

goldbook:11878 a skos:Concept ;
    skos:definition "Protein that has the same amino acid sequence as the normal, functional protein but exhibits a deviant tertiary structure and lacks normal function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "misfolded protein" .

goldbook:11879 a skos:Concept ;
    skos:altLabel "Δψm" ;
    skos:definition "Membrane potential across the inner membrane of the mitochondrion generated by the electron transport chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitochondrial membrane potential" .

goldbook:11880 a skos:Concept ;
    skos:definition "Dysfunction or degeneration of both motor and sensory nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed neuropathy" .

goldbook:11881 a skos:Concept ;
    skos:altLabel "Monro doctrine",
        "Monro–Kellie doctrine" ;
    skos:definition "Hypothesis that the intracranial volume is unchangeable and therefore a constant intracranial pressure requires that the sum of the volumes of the three compartments blood, brain tissue and cerebrospinal fluid remains constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Monro–Kellie hypothesis" .

goldbook:11882 a skos:Concept ;
    skos:altLabel "(5α,6α)-7,8-didehydro-4,5-epoxy-17-methylmorphinan-3,6-diol" ;
    skos:definition "The major phenanthrene alkaloid of opium, used as an analgesic, sedative, and anxiolytic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphine" .

goldbook:11883 a skos:Concept ;
    skos:definition "Physical activity and performance of an animal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor activity" .

goldbook:11884 a skos:Concept ;
    skos:definition "Cooperation of the motor neurons and the involved muscles to perform a body movement precisely according to spatiotemporal requirements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor coordination" .

goldbook:11885 a skos:Concept ;
    skos:definition "Region of the cerebral cortex, located primarily in the frontal lobe, involved in coordinating motor activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor cortex" .

goldbook:11886 a skos:Concept ;
    skos:definition "Complex structure by which the axon of a motor neuron establishes synaptic contact with a skeletal muscle fiber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor endplate" .

goldbook:11887 a skos:Concept ;
    skos:definition "Nerve cell in the spinal cord having an axon that leaves the central nervous system to establish a functional connection with an effector (muscle or glandular) tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor neuron" .

goldbook:11888 a skos:Concept ;
    skos:altLabel "MND" ;
    skos:definition "Generic term for a heterogeneous group of disorders, all affecting motor neurons in the brain, spinal cord, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor neuron disease" .

goldbook:11889 a skos:Concept ;
    skos:definition "Part of the central nervous system responsible for control of movement, consisting of the pyramidal system controlling voluntary movement and the extrapyramidal system coordinating involuntary movement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "motor system" .

goldbook:11890 a skos:Concept ;
    skos:altLabel "MCS",
        "environmental illness",
        "idiopathic environmental intolerance" ;
    skos:definition "Intolerance condition attributed to extreme sensitivity of individuals to various environmental chemicals, found in air, food, water, building materials, or fabrics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple chemical sensitivity" .

goldbook:11891 a skos:Concept ;
    skos:altLabel "MS" ;
    skos:definition "Common demyelinating (see demyelination) disorder of the central nervous system, causing patches of sclerosis (plaques) in the brain and spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple sclerosis" .

goldbook:11892 a skos:Concept ;
    skos:definition "Referring to agents that stimulate the postganglionicparasympatheticreceptor, named after the prototypical mushroom alkaloid, muscarine [2,5-anhydro-1,4,6-trideoxy-6-(trimethylammonio)-D-ribo-hexitol]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "muscarinic" .

goldbook:11893 a skos:Concept ;
    skos:definition "One of the two main classes of acetylcholine receptors that responds to muscarinic agents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "muscarinic receptor" .

goldbook:11894 a skos:Concept ;
    skos:altLabel "neuromuscular spindle" ;
    skos:definition "Sensory organ in the body of a striated muscle containing afferent and efferentnerve fibers that detect passive muscle stretch and convey information to the central nervous system to cause reflex resistance to this stretch." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "muscle spindle" .

goldbook:11895 a skos:Concept ;
    skos:definition "Dilation of the pupil." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mydriasis" .

goldbook:11896 a skos:Concept ;
    skos:definition "Electrically insulating lipoprotein layers that are produced by glial cells and surround the axons of the neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelin" .

goldbook:11897 a skos:Concept ;
    skos:definition "Major component of myelin, that helps organizing the correct assembly of the lipids and proteins in myelin sheets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelin basic protein" .

goldbook:11898 a skos:Concept ;
    skos:definition "Transmembrane glycoprotein that plays an important role in the interaction between axons and myelin and affects myelination during nerve regeneration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelin-associated glycoprotein" .

goldbook:11899 a skos:Concept ;
    skos:definition "Concentric layers of myelin surrounding the axons of some neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelin sheath" .

goldbook:11900 a skos:Concept ;
    skos:definition "X-ray of the spinal canal following injection of a contrast material into the surrounding cerebrospinal fluid spaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelogram" .

goldbook:11901 a skos:Concept ;
    skos:definition "Protrusion of the spinal cord and its coverings through a defect in the vertebral column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelomeningocele" .

goldbook:11902 a skos:Concept ;
    skos:definition "Any functional or pathologic disturbance in the spinal cord. Disorder of the myelopoietic tissues of the bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelopathy" .

goldbook:11903 a skos:Concept ;
    skos:definition "Any disease of muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myopathy" .

goldbook:11904 a skos:Concept ;
    skos:definition "Prolonged contraction or delayed relaxation of a muscle after mechanical or brief electrical stimulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myotonia" .

goldbook:11905 a skos:Concept ;
    skos:altLabel "polydendrocyte" ;
    skos:definition "Glial cell of the central nervous system, distinct from an oligodendrocyte or astrocyte, that may serve as a precursor of oligodendrocytes, and that takes its name from expression of proteoglycan NG2." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "NG2 cell" .

goldbook:11906 a skos:Concept ;
    skos:definition "Nonspecific, reversible depression of central nervous system function, marked by stupor or unconsciousness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "narcosis" .

goldbook:11907 a skos:Concept ;
    skos:definition "Nonspecific usage – an agent that produces insensibility or stupor. Specific usage – any natural or synthetic substance that has morphine-like actions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "narcotic" .

goldbook:11908 a skos:Concept ;
    skos:definition "Outer layer of the cerebral cortex that supports higher brain functions, especially cognitive function and language in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neocortex" .

goldbook:11909 a skos:Concept ;
    skos:definition "Ensheathed bundle of nerve fibers that conveys information between the central nervous system and other regions of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve" .

goldbook:11910 a skos:Concept ;
    skos:definition "Measure of the functional integrity of a nerve with a stimulating electrode, placed on the skin over the nerve, and a more distal recording electrode, to determine the velocity of the impulse that passes along the nerve between the electrodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve conduction study" .

goldbook:11911 a skos:Concept ;
    skos:definition "Rate of progression of a nerve impulse in a peripheral nerve or in its largest component nerve fibers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve conduction velocity" .

goldbook:11912 a skos:Concept ;
    skos:definition "Axon with its surrounding myelin sheath." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve fiber" .

goldbook:11913 a skos:Concept ;
    skos:altLabel "nerve agent" ;
    skos:definition "Volatile chemical with neurotoxic features intended for use in warfare to disable or kill the organism rapidly after inhalation or skin contact, and classified as a prohibited weapon of mass destruction by The Chemical Weapons Convention (CWC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve gas" .

goldbook:11914 a skos:Concept ;
    skos:altLabel "NGF" ;
    skos:definition "One of a family of proteins known as neurotropins that function as signaling molecules to induce axon growth, branching, elongation and survival of neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve growth factor" .

goldbook:11915 a skos:Concept ;
    skos:definition "Proximal end of a spinal nerve nearest its attachment to the spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nerve root" .

goldbook:11916 a skos:Concept ;
    skos:definition "The entire neuronal apparatus, composed of both the central nervous system and the peripheral nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nervous system" .

goldbook:11917 a skos:Concept ;
    skos:definition "Metabolic and electrical activity of neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural activity" .

goldbook:11918 a skos:Concept ;
    skos:definition "Paroxysmal pain extending along the course of one or more nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuralgia" .

goldbook:11919 a skos:Concept ;
    skos:altLabel "neuronal network" ;
    skos:definition "A functionally interconnected set of neurons, generally in the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural network" .

goldbook:11920 a skos:Concept ;
    skos:definition "Multipotent cell, with mitotic potential, that may serve as a precursor for neuroprogenitor cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neural stem cell" .

goldbook:11921 a skos:Concept ;
    skos:definition "Excision of a nerve or part of a nerve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurectomy" .

goldbook:11922 a skos:Concept ;
    skos:definition "Outgrowth or projection of either an axon or a dendrite from the neuron cell body that is the structural basis of the neural network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurite" .

goldbook:11923 a skos:Concept ;
    skos:definition "Phenomenon in which neurons tend to send out neurites to make contact with other nerve cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurite outgrowth" .

goldbook:11924 a skos:Concept ;
    skos:definition "Inflammation of a nerve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuritis" .

goldbook:11925 a skos:Concept ;
    skos:altLabel "NCTB" ;
    skos:definition "A set of seven tests, recommended by the World Health Organization (WHO) in 1983, to detect neurotoxicity in human populations" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurobehavior core test battery" .

goldbook:11926 a skos:Concept ;
    skos:definition "Disease of the brain and (or) peripheral nervous system with progressive loss of neuronal function, accompanied by changes in morphology and subcellular organization of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurodegenerative disease" .

goldbook:11927 a skos:Concept ;
    skos:definition "Adverse effect of a substance that disrupts developmental processes of the nervous system. Toxicity in which the developing nervous system shows heightened sensitivity compared with the adult nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurodevelopmental toxicity" .

goldbook:11928 a skos:Concept ;
    skos:definition "Part of a filamentous structure found in the cell body, axons, dendrites, and sometimes synaptic endings of neurons, consisting of bundles of neurofilaments and neurotubules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurofibril" .

goldbook:11929 a skos:Concept ;
    skos:definition "Intracellular accumulation of aggregates of hyperphosphorylated tau protein or paired helical filaments consisting of the tau protein, a microtubule-associated protein that normally stabilizes the cytoskeleton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurofibrillary tangle" .

goldbook:11930 a skos:Concept ;
    skos:definition "Tumor of the peripheral nervous system representing an abnormal collection of Schwann cells and connective tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurofibroma" .

goldbook:11931 a skos:Concept ;
    skos:definition "Class of intermediate filament of the neuronal cytoskeleton, providing support for the axon and dendrites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurofilament" .

goldbook:11932 a skos:Concept ;
    skos:definition "Formation of nerve cells or of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurogenesis" .

goldbook:11933 a skos:Concept ;
    skos:definition "Originating in, starting from, or caused by, the nervous system or nerve impulses. Relating to neurogenesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurogenic" .

goldbook:11934 a skos:Concept ;
    skos:definition "Condition of decreased blood pressure, slow heart rate and insufficient perfusion of the body with blood, caused by loss of autonomic control following acute trauma to the brain or spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurogenic shock" .

goldbook:11935 a skos:Concept ;
    skos:definition "Process of producing images of the structure or activity of the brain or other parts of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroimaging" .

goldbook:11936 a skos:Concept ;
    skos:definition "Complex series of local immune responses within the nervous system to deal with a threat to the neural environment from infection, injury, or trauma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroinflammation" .

goldbook:11937 a skos:Concept ;
    skos:definition "Any of a class of psychotropic drugs used to treat psychosis, particularly schizophrenia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroleptic" .

goldbook:11938 a skos:Concept ;
    skos:definition "Breakdown of nervous tissue from disease or injury. Therapeutic destruction of a nerve or nerves to treat intractable pain. Surgical freeing of a nerve from adhesions of the neural sheath." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurolysis" .

goldbook:11939 a skos:Concept ;
    skos:definition "Tumor made up largely of nerve cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroma" .

goldbook:11940 a skos:Concept ;
    skos:definition "Disorder involving destruction of the cell bodies of neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuronopathy" .

goldbook:11941 a skos:Concept ;
    skos:definition "Enzyme of glucose metabolism, normally found in nervous tissue, that catalyzes the dehydration of 2-phosphoglycerate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuron-specific enolase" .

goldbook:11942 a skos:Concept ;
    skos:definition "Application of gross and histopathologic methods to study toxic changes in the morphology and histology of the nervous tissues and the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropathological examination" .

goldbook:11943 a skos:Concept ;
    skos:definition "Pathological change in the peripheral nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropathy" .

goldbook:11944 a skos:Concept ;
    skos:altLabel "NTE",
        "neurotoxic esterase" ;
    skos:definition "Enzyme that is phosphorylated by organophosphate compounds and is believed to be involved in the delayed neuropathy of organophosphates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropathy target esterase" .

goldbook:11945 a skos:Concept ;
    skos:definition "Precursor cell that is capable of differentiating into specific cell types of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroprogenitor cell" .

goldbook:11946 a skos:Concept ;
    skos:definition "Agent or property of an agent that protects neurons from damage and (or) from the process of aging or degeneration of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuroprotective" .

goldbook:11947 a skos:Concept ;
    skos:definition "Assessment, under standardized conditions, of an individual’s brain function as it impacts upon cognitive function, thought processes, behavior and personality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropsychological testing" .

goldbook:11948 a skos:Concept ;
    skos:definition "Poisonous to structures and (or) functions of the brain and nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotoxic" .

goldbook:11949 a skos:Concept ;
    skos:definition "Substance that can produce functional or structural damage to the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotoxicant" .

goldbook:11950 a skos:Concept ;
    skos:definition "Discipline applying principles of both neuroscience and toxicology to study the ability of certain substances to alter nervous system structure or function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotoxicology" .

goldbook:11951 a skos:Concept ;
    skos:altLabel "NSP" ;
    skos:definition "Toxic shellfish poisoning characterized by nausea, vomiting, and mild neurological symptoms such as dysarthria, paresthesia, ataxia, and vertigo caused by ingestion of shellfish (specifically, bivalve molluscs) contaminated with the polyether brevetoxin and its derivatives produced by the dinoflagellate Karenia brevis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotoxic shellfish poisoning" .

goldbook:11952 a skos:Concept ;
    skos:definition "Any substance that has the potential to damage the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotoxin" .

goldbook:11953 a skos:Concept ;
    skos:definition "Process by which a presynaptic cell, upon excitation, releases a specific agent (a neurotransmitter) that crosses the synapse to stimulate or inhibit the postsynaptic cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotransmission" .

goldbook:11954 a skos:Concept ;
    skos:definition "Neurotransmission wherein a neurotransmitter is sent from the postsynaptic to the presynaptic membrane in order to modify a signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retrograde neurotransmission" .

goldbook:11955 a skos:Concept ;
    skos:definition "Biochemical that is released upon excitation from a presynaptic membrane, crosses the synaptic space and binds to a receptor on the postsynaptic membrane, where it induces a signal that may be either stimulatory or inhibitory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotransmitter" .

goldbook:11956 a skos:Concept ;
    skos:altLabel "neurotrophic" ;
    skos:definition "Having an affinity for nerve cells or tissues of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotropic" .

goldbook:11957 a skos:Concept ;
    skos:definition "Microtubule found in neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotubule" .

goldbook:11958 a skos:Concept ;
    skos:definition "Relating to both the nervous system and the vascular system. Relating to the vasomotor nerves that supply the walls of the blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurovascular" .

goldbook:11959 a skos:Concept ;
    skos:definition "Referring to a substance or effect that mimics acetylcholine at the neuromuscular junction, at autonomic ganglia and at other locations in the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nicotinic" .

goldbook:11960 a skos:Concept ;
    skos:definition "One of the two main classes of acetylcholine receptors, ligand-gated ion channels that open upon binding nicotine as well as acetylcholine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nicotinic receptor" .

goldbook:11961 a skos:Concept ;
    skos:altLabel "5–9 hole attention box test" ;
    skos:definition "Behavioral test based on the five-choice serial reaction time task, which allows the study of attention based on a test animal learning from which hole (typically one of five open holes in an arc of nine) a visual (light) cue was given, with a food pellet reward for nose-poking the correct hole." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nine-hole box test" .

goldbook:11962 a skos:Concept ;
    skos:altLabel "Nissl granule",
        "Nissl substance" ;
    skos:definition "Granular structure consisting of rough endoplasmic reticulum, found in neurons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nissl body" .

goldbook:11963 a skos:Concept ;
    skos:definition "Physiological response to harmful stimuli by specialized nerve endings that transmit a signal perceived as pain by the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nociception" .

goldbook:11964 a skos:Concept ;
    skos:definition "Short interval in the myelin sheath of a nerve fiber where the axon is invested only by scant cytoplasmic processes of the neighboring Schwann cells or, in the central nervous system, of oligodendroglia cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "node of Ranvier" .

goldbook:11966 a skos:Concept ;
    skos:definition "Test allowing study of attention deficit based on noting the success of a test animal in gaining a food pellet reward for nosing the correct hole in a box." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nose-poke test" .

goldbook:11967 a skos:Concept ;
    skos:definition "Imprecise term for absent or reduced touch perception, as well as paresthesia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "numbness" .

goldbook:11968 a skos:Concept ;
    skos:definition "Involuntary rhythmic oscillation of the eyeballs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nystagmus" .

goldbook:11969 a skos:Concept ;
    skos:definition "One of the four major lobes of each cerebral hemisphere, situated within the occiput, containing most of the neural apparatus of visual processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occipital lobe" .

goldbook:11970 a skos:Concept ;
    skos:definition "Detection of odors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "olfaction" .

goldbook:11971 a skos:Concept ;
    skos:altLabel "oligodendroglial cell" ;
    skos:definition "Type of glial cell that produces the myelin sheath in the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligodendrocyte" .

goldbook:11972 a skos:Concept ;
    skos:definition "Glioma arising from the oligodendrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligodendroglioma" .

goldbook:11973 a skos:Concept ;
    skos:definition "Procedure to observe changes in motor activity and rearing, in which a rodent is placed on a surface and distance and patterns of movement are recorded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open field test" .

goldbook:11974 a skos:Concept ;
    skos:definition "One of a group of G-protein-coupled receptors that bind morphine and endogenous substances that have morphine-like effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "opiate receptor" .

goldbook:11975 a skos:Concept ;
    skos:definition "Synthetic narcotic having properties consistent with binding to opiate receptors, but not derived from opium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "opioid" .

goldbook:11976 a skos:Concept ;
    skos:altLabel "Papaver somniferum" ;
    skos:definition "Extract of the opium poppy, Papaver somniferum, containing morphine as a major psychoactive component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "opium" .

goldbook:11977 a skos:Concept ;
    skos:definition "Relating to perception by a sensory organ. Involving the use of sensory organs, e.g., organoleptic tests." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organoleptic" .

goldbook:11978 a skos:Concept ;
    skos:definition "Compound having covalent bonds between one or more metal atoms and one or more carbon atoms of an organyl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organometallic compound" .

goldbook:11979 a skos:Concept ;
    skos:definition "Organic ester of phosphoric acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organophosphate" .

goldbook:11980 a skos:Concept ;
    skos:altLabel "OPIDN" ;
    skos:definition "Disorder, typically with symptoms of pain and weakness in the extremities, resulting from neuronal death associated with organophosphate poisoning (either chronic or a late effect of acute poisoning)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organophosphate-induced delayed neuropathy" .

goldbook:11981 a skos:Concept ;
    skos:altLabel "olfactophobia" ;
    skos:definition "Morbid fear of odors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmophobia" .

goldbook:11982 a skos:Concept ;
    skos:definition "Adverse effects occurring when the generation of reactive oxygen species (ROS) in a system exceeds the system’s ability to neutralize and eliminate them; excess ROS can damage a cell’s lipids, protein, and DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidative stress" .

goldbook:11983 a skos:Concept ;
    skos:definition "Conscious awareness of an unpleasant sensation mediated by nerve conduction of a stimulus from a site of tissue injury to the brain. Note 1: Chemical mediators of pain include histamine, bradykinins, and prostaglandins. Note 2: The sensation may occur or persist when the injured tissue is no longer present, as in phantom pain. Sensation one feels when hurt in body or mind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pain" .

goldbook:11984 a skos:Concept ;
    skos:altLabel "neuropathic pain" ;
    skos:definition "Pain initiated by nerve injury, not mediated by nociception." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropathic pain" .

goldbook:11985 a skos:Concept ;
    skos:altLabel "phantom limb pain" ;
    skos:definition "Sensation that an amputated limb is still present, often associated with pain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phantom pain" .

goldbook:11986 a skos:Concept ;
    skos:altLabel "PHF" ;
    skos:definition "Describing the aggregation of hyperphosphorylated tau protein into neurofibrillary tangles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paired helical filament" .

goldbook:11987 a skos:Concept ;
    skos:definition "Unduly rapid or throbbing heartbeat that is noted by a patient; it may be regular or irregular. Undue awareness by a patient of a heartbeat that is otherwise normal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "palpitation" .

goldbook:11988 a skos:Concept ;
    skos:definition "Edema of the region of the head of the optic nerve in the retina (the optic disc)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "papilledema" .

goldbook:11989 a skos:Concept ;
    skos:definition "Total or partial loss of motor function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paralysis" .

goldbook:11990 a skos:Concept ;
    skos:altLabel "PSP" ;
    skos:definition "Illness that is a consequence of consumption of bivalve molluscs such as mussels, oysters, and clams that have ingested large quantities of microalgae containing saxitoxin or its derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paralytic shellfish poisoning" .

goldbook:11991 a skos:Concept ;
    skos:definition "Any of several related enzymes that hydrolyze aryl esters and lactones, notably organophosphate pesticides including the acetylcholinesterase inhibitor, paraoxon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paraoxonase" .

goldbook:11992 a skos:Concept ;
    skos:definition "Paralysis of both lower limbs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paraplegia" .

goldbook:11993 a skos:Concept ;
    skos:definition "Division of the autonomic nervous system involved in stimulating digestive secretions, slowing heart rate, constricting the pupils of the eyes, and dilating blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parasympathetic nervous system" .

goldbook:11994 a skos:Concept ;
    skos:altLabel "cholinomimetic" ;
    skos:definition "n., Substance that produces effects resembling those of impulses transmitted by the postganglionic fibers of the parasympathetic nervous system. adj., Producing effects resembling those of impulses transmitted by the postganglionic fibers of the parasympathetic nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parasympathomimetic" .

goldbook:11995 a skos:Concept ;
    skos:definition "Slight or incomplete paralysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paresis" .

goldbook:11996 a skos:Concept ;
    skos:altLabel "paraesthesia" ;
    skos:definition "Abnormal or unexplained tingling, pricking, or burning sensation on the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paresthesia" .

goldbook:11997 a skos:Concept ;
    skos:definition "One of the four major lobes of each cerebral hemisphere situated between the frontal and occipital lobes, above the temporal lobe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parietal lobe" .

goldbook:11998 a skos:Concept ;
    skos:altLabel "idiopathic parkinsonism",
        "primary parkinsonism" ;
    skos:definition "Degenerative disorder of the central nervous system resulting from decreased production of the neurotransmitterdopamine in the basal ganglia (notably the substantia nigra)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Parkinson disease" .

goldbook:11999 a skos:Concept ;
    skos:definition "Neurological syndrome resembling Parkinson disease and often resulting from decreased dopamine production as a consequence of neurodegenerative changes in the substantia nigra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary parkinsonism" .

goldbook:12000 a skos:Concept ;
    skos:definition "Fear-motivated test in which rodents learn to avoid an otherwise preferred environment in which they are exposed to an aversive stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive avoidance test" .

goldbook:12001 a skos:Concept ;
    skos:altLabel "staircase test" ;
    skos:definition "Test used to reveal motor deficits, usually of central origin, exhibited on the contralateral side by reduced ability of a test animal to extend the forelimb." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paw-reaching test" .

goldbook:12002 a skos:Concept ;
    skos:definition "Cell of an established line originally derived from a pheochromocytoma of the rat adrenal medulla." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "PC-12 cell" .

goldbook:12003 a skos:Concept ;
    skos:altLabel "PNS" ;
    skos:definition "One of the two major divisions of the nervous system, made up of the nerves and ganglia lying outside the brain and spinal cord that transmit sensory and motor signals to and from the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral nervous system" .

goldbook:12004 a skos:Concept ;
    skos:definition "Neuropathy affecting nerves of the peripheral nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral neuropathy" .

goldbook:12005 a skos:Concept ;
    skos:definition "Progression of a wave of smooth muscle contraction followed by relaxation along the length of a muscular tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peristalsis" .

goldbook:12006 a skos:Concept ;
    skos:definition "Tumor of the chromaffin cells of the adrenal medulla that results in excessive secretion of norepinephrine and other catecholamines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pheochromocytoma" .

goldbook:12007 a skos:Concept ;
    skos:definition "Abnormal fear of loud sound, or occasionally of voices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phonophobia" .

goldbook:12008 a skos:Concept ;
    skos:definition "Abnormal visual intolerance of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photophobia" .

goldbook:12009 a skos:Concept ;
    skos:definition "Specialized neuron found in the retina, involved in detecting light and transducing the signals of vision" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoreceptor cell" .

goldbook:12010 a skos:Concept ;
    skos:altLabel "pia mater" ;
    skos:definition "Innermost of three membranous layers, together composing the meninges, that surrounds and adheres to the brain and spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pia" .

goldbook:12011 a skos:Concept ;
    skos:definition "Network of interconnecting nerves, blood vessels or lymphatic vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plexus" .

goldbook:12012 a skos:Concept ;
    skos:altLabel "pontine respiratory group" ;
    skos:definition "Neural network in the brainstem involved in regulating respiration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pneumotaxic center" .

goldbook:12013 a skos:Concept ;
    skos:definition "Inflammation of several peripheral nerves simultaneously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyneuritis" .

goldbook:12014 a skos:Concept ;
    skos:definition "Neuropathy (distal axonopathy) of the peripheral nervous system, often affecting the extremities in a bilateral distribution, and characterized by numbness, tingling, and paresthesia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyneuropathy" .

goldbook:12015 a skos:Concept ;
    skos:definition "Pocket in the back of the skull that accommodates the cerebellum and the midbrain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "posterior fossa" .

goldbook:12016 a skos:Concept ;
    skos:definition "Event or structure at the distal side of a synaptic cleft." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "postsynaptic" .

goldbook:12017 a skos:Concept ;
    skos:definition "Potentiation lasting up to several months." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "long-term potentiation" .

goldbook:12018 a skos:Concept ;
    skos:definition "Event or structure at the proximal (transmitting) side of a synaptic cleft." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "presynaptic" .

goldbook:12019 a skos:Concept ;
    skos:definition "Phase before the onset of full-blown disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prodromal stage" .

goldbook:12020 a skos:Concept ;
    skos:definition "Symptom(s) heralding impending onset of a disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prodrome" .

goldbook:12021 a skos:Concept ;
    skos:altLabel "POMS",
        "POMS test" ;
    skos:definition "Procedure in which a test subject is asked to indicate his/her mood during the past week, by quickly marking specified emotional words on a scale between 'not at all' and 'extremely.'" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "profile of mood state test" .

goldbook:12022 a skos:Concept ;
    skos:definition "Sense of the movement or position of the body independent of vision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proprioception" .

goldbook:12023 a skos:Concept ;
    skos:definition "Sensory organ in a muscle, tendon or joint capsule that senses position or state of contraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proprioceptor" .

goldbook:12024 a skos:Concept ;
    skos:altLabel "PBA" ;
    skos:definition "Involuntary emotional outburst (typically crying or laughing)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudobulbar affect" .

goldbook:12025 a skos:Concept ;
    skos:definition "Part of the cerebrospinal fluid that, in contrast to a meningocele, is not surrounded by dura." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudomeningocele" .

goldbook:12026 a skos:Concept ;
    skos:altLabel "idiopathic intracranial hypertension" ;
    skos:definition "Disorder with increased intracranial pressure, cerebral edema, and frequently papilledema, symptoms that resemble the effects of a tumor but without the occurrence of one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudotumor cerebri" .

goldbook:12027 a skos:Concept ;
    skos:definition "Having the ability to alter mood, behavior, cognitive function or mental state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychoactive" .

goldbook:12028 a skos:Concept ;
    skos:altLabel "PNI" ;
    skos:definition "Study of links between the brain and the immune system, recognizing an interaction between psychological states and the outcome of immune responses to disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychoneuroimmunology" .

goldbook:12029 a skos:Concept ;
    skos:definition "Disordered thought processes that may include changes in cognitive function, perception, belief, behavior and personality; altered awareness of reality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychosis" .

goldbook:12030 a skos:Concept ;
    skos:altLabel "organic brain syndrome" ;
    skos:definition "Psychosis with a known physical (anatomic, disease-related or toxic) cause." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organic psychosis" .

goldbook:12031 a skos:Concept ;
    skos:definition "Capable of affecting the mind, emotions and behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychotropic" .

goldbook:12032 a skos:Concept ;
    skos:definition "Marine fish of the order Tetraodontiformes and family Tetraodontidae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "puffer fish" .

goldbook:12033 a skos:Concept ;
    skos:definition "Large neuron forming part of a layer of cells in the cerebellum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Purkinje cell" .

goldbook:12034 a skos:Concept ;
    skos:definition "Procedure in which a subject is instructed to place a dot in defined sites (such as a number of circles), as quickly as possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pursuit aiming test" .

goldbook:12035 a skos:Concept ;
    skos:definition "Part of the basal ganglia that plays a role in coordinating movement and learning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "putamen" .

goldbook:12036 a skos:Concept ;
    skos:definition "Clumping of nuclear chromatin and shrinkage of the cell nucleus during cell degeneration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyknosis" .

goldbook:12037 a skos:Concept ;
    skos:definition "Large neuron of the cerebral cortex having a triangular cell body in histological section with several dendrites at the base and one large apical axon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyramidal cell" .

goldbook:12038 a skos:Concept ;
    skos:definition "Synthetic molecule with structural similarity to the natural pyrethrins found in plants of the genus Chrysanthemum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrethroid" .

goldbook:12039 a skos:Concept ;
    skos:definition "Paralysis of both upper and both lower limbs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadriplegia" .

goldbook:12040 a skos:Concept ;
    skos:definition "Apparatus with a central platform and equidistant arms (usually eight), at the end of which is a reward (e.g., a food pellet)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radial arm maze" .

goldbook:12041 a skos:Concept ;
    skos:definition "Inflammation of the spinal nerve roots leading to pain and hyperesthesia radiating along the nerve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiculitis" .

goldbook:12042 a skos:Concept ;
    skos:definition "Of a rodent or other animal raising itself on its hind legs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rearing" .

goldbook:12043 a skos:Concept ;
    skos:definition "Reappearance of original symptom(s), often exacerbated, following cessation of treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rebound" .

goldbook:12044 a skos:Concept ;
    skos:definition "Involuntary reaction in response to a stimulus applied to the periphery following its transmission to the nervous centers in the brain or spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflex" .

goldbook:12045 a skos:Concept ;
    skos:altLabel "RSD" ;
    skos:definition "Diffuse persistent pain usually in an extremity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflex sympathetic dystrophy" .

goldbook:12046 a skos:Concept ;
    skos:definition "Use of a stimulus in operant conditioning to increase the likelihood that a particular behavior will occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reinforcement" .

goldbook:12047 a skos:Concept ;
    skos:definition "Agent that reduces muscle tension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relaxant" .

goldbook:12048 a skos:Concept ;
    skos:definition "Restoration of the blood supply to an organ or tissue following a period of ischemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reperfusion" .

goldbook:12049 a skos:Concept ;
    skos:definition "Returning of a cell’s membrane potential to its resting potential following depolarization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repolarization" .

goldbook:12050 a skos:Concept ;
    skos:definition "Return to a sexually unexcited state following orgasm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution phase" .

goldbook:12051 a skos:Concept ;
    skos:definition "Baseline membrane potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resting potential" .

goldbook:12052 a skos:Concept ;
    skos:definition "Transport of material from the nerve ending back to the cell body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retrograde axonal transport" .

goldbook:12053 a skos:Concept ;
    skos:definition "Transporter-dependent resequestration of a neurotransmitter by a presynapticneuron, terminating synaptic transmission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reuptake" .

goldbook:12054 a skos:Concept ;
    skos:altLabel "ROCF Test" ;
    skos:definition "Procedure in which the test subject first copies a complicated drawing and then is asked to draw it from memory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rey–Osterrieth complex figure test" .

goldbook:12055 a skos:Concept ;
    skos:definition "Reflex that restores the correct orientation of the body when taken out of the upright position." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "righting reflex" .

goldbook:12056 a skos:Concept ;
    skos:altLabel "aerial righting test" ;
    skos:definition "Experimental measurement of an animal’s (usually a rodent’s) ability to land in an upright position at the end of a fall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "righting test" .

goldbook:12057 a skos:Concept ;
    skos:definition "Test animal is placed on its back and the time to retain an uprate position with four paws in contact with the surface is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface righting test" .

goldbook:12058 a skos:Concept ;
    skos:definition "Experimental observation of an animal’s (usually a rodent’s) ability to stay on a rotating rod without falling off." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotarod test" .

goldbook:12059 a skos:Concept ;
    skos:definition "Rapid or jerky movement of the eyes from one line of sight to another, as in reading or correction of a jerky nystagmus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saccadic eye movement" .

goldbook:12060 a skos:Concept ;
    skos:definition "Referring to inflammatory conditions of the skin such as erysipelas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Saint Anthony fire" .

goldbook:12061 a skos:Concept ;
    skos:definition "Procedure in which a test subject stands in front of a plate with 48 square holes and an equal number of fitted pegs, each having a cylindrical upper part and square base, and is asked to fit the pegs into the holes as quickly as possible by turning them 180 degrees, first with one hand and in a subsequent trial with the other hand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Santa Ana dexterity test" .

goldbook:12062 a skos:Concept ;
    skos:altLabel "SCOB" ;
    skos:definition "Experimental procedure in which operant behavior is assessed following a conditioning stimulus delivered at a pre-determined duration and frequency ('schedule of reinforcement'), thus allowing comparison of the effects of magnitude, frequency and duration of the stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "schedule-controlled operant behaviour" .

goldbook:12063 a skos:Concept ;
    skos:definition "Frequency, duration, dose, and (or) intensity of a conditioning stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "schedule of reinforcement" .

goldbook:12064 a skos:Concept ;
    skos:definition "Glial cell in the peripheral nervous system that produces myelin for the axons of the peripheral nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schwann cell" .

goldbook:12065 a skos:Concept ;
    skos:definition "Hardening of an organ or tissue, especially that due to excessive growth of fibrous tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sclerosis" .

goldbook:12066 a skos:Concept ;
    skos:definition "Constellation of symptoms resembling an allergic reaction, caused by eating the meat of decaying fish that has high levels of histamine (in this context sometimes referred to as scombrotoxin)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Scombroid poisoning" .

goldbook:12067 a skos:Concept ;
    skos:definition "Substance that exerts a soothing or tranquillizing effect, or describing the effect itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedative" .

goldbook:12068 a skos:Concept ;
    skos:altLabel "SSRI" ;
    skos:definition "Drug in a subclass of substances that interfere with the resequestration of serotonin by the presynaptic membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective serotonin reuptake inhibitor" .

goldbook:12069 a skos:Concept ;
    skos:definition "Characteristics typically associated with old age, especially relating to memory loss and other mental impairment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "senility" .

goldbook:12070 a skos:Concept ;
    skos:definition "Nerve cell specialized for detecting and transducing signals from external or somatic stimuli." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensory neuron" .

goldbook:12071 a skos:Concept ;
    skos:definition "Relating to a nerve that releases or responds to serotonin as a neurotransmitter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "serotoninergic" .

goldbook:12072 a skos:Concept ;
    skos:definition "Illness associated with consumption of seafood contaminated with toxins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shellfish poisoning" .

goldbook:12073 a skos:Concept ;
    skos:definition "n. Fistula or prosthetic device that diverts fluid from one system to another. vb. To bypass or divert." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shunt" .

goldbook:12074 a skos:Concept ;
    skos:definition "Health effects or loss of a sense of well-being associated, by those who experience it, with time spent in a certain building or room." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sick building syndrome" .

goldbook:12075 a skos:Concept ;
    skos:definition "Method for visualization of macromolecules such as nucleic acids and proteins, typically in electrophoretic gels or formalin-fixed histological sections, based on the reduction of silver salts to metallic silver or formation of crystalline silver compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silver staining" .

goldbook:12076 a skos:Concept ;
    skos:definition "Procedure to assess psychomotor speed in which a test subject is presented at irregular intervals with a visual stimulus, such as a coloured dot on a screen, and is asked to press a button immediately after noticing the stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simple reaction time test" .

goldbook:12077 a skos:Concept ;
    skos:altLabel "SLUDGE" ;
    skos:definition "Acronym for the constellation of signs salivation, lacrymation, urination, defecation, dyspnea/gastrointestinal upset, and emesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "SLUDDE" .

goldbook:12078 a skos:Concept ;
    skos:definition "Behavioral test wherein a rodent stranger is placed in the cage of a domestic rodent and intensities and duration of interactions (e.g., sniffing, aggression, avoidance) between the socially unacquainted animals are observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "social interaction test" .

goldbook:12079 a skos:Concept ;
    skos:definition "Substance producing sleep." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soporific" .

goldbook:12080 a skos:Concept ;
    skos:definition "Sudden involuntary contraction of one or more muscles; includes cramps and contractures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spasm" .

goldbook:12081 a skos:Concept ;
    skos:definition "Agent that relieves smooth muscle spasms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spasmolytic" .

goldbook:12082 a skos:Concept ;
    skos:definition "Relating to spasticity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spastic" .

goldbook:12083 a skos:Concept ;
    skos:definition "Increased muscle tone at rest, characterized by resistance to passive stretch." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spasticity" .

goldbook:12084 a skos:Concept ;
    skos:definition "Member of a class of lipids containing the aliphatic amino alcohol sphingosine, or related structures, thus including ceramide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sphingolipid" .

goldbook:12085 a skos:Concept ;
    skos:definition "One of a family of phospholipids found especially in the central nervous system, containing 1-phosphocholine bound to a ceramide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sphingomyelin" .

goldbook:12086 a skos:Concept ;
    skos:altLabel "2-aminooctadec-4-ene-1,3-diol" ;
    skos:definition "Major lipid component of cell membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sphingosine" .

goldbook:12087 a skos:Concept ;
    skos:altLabel "startle part",
        "startle response" ;
    skos:definition "Rapid physiological and psychological response to a sudden, unexpected stimulus that includes muscle contraction and avoidance posturing, with an increase in heart rate, respiration, skin conductance, and a negative affect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "startle reaction" .

goldbook:12088 a skos:Concept ;
    skos:definition "The earliest brainstem-mediated part of the reflex reaction to a stimulus perceived as threatening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "startle reflex" .

goldbook:12089 a skos:Concept ;
    skos:definition "Neurophysiological examination in which an animal is exposed to a brief (e.g., \\(\\pu{40 ms}\\)) acoustic stimulus, followed by measurement of the animal’s motor reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acoustic startle response test" .

goldbook:12090 a skos:Concept ;
    skos:definition "Repeated or prolonged seizure lasting more than \\(\\pu{30 min}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "status epilepticus" .

goldbook:12091 a skos:Concept ;
    skos:definition "Three dimensional interpretation of two dimensional cross sections of tissue and other materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereology" .

goldbook:12092 a skos:Concept ;
    skos:definition "Stereological method that uses systematic analysis of defined spatial fractions of a sample to estimate numbers of neuronal nuclei independent of changes in size and shape that may occur during tissue processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unbiased stereology" .

goldbook:12093 a skos:Concept ;
    skos:definition "Agent that rouses or increases mental or physical activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimulant" .

goldbook:12094 a skos:Concept ;
    skos:definition "Anything that produces a reaction in an organism. That which causes a response in an excitable tissue such as a nerve, muscle or gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimulus" .

goldbook:12095 a skos:Concept ;
    skos:definition "Stimulus that comes to evoke a response after repetitive pairing with another stimulus that automatically elicits that response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conditioned stimulus" .

goldbook:12096 a skos:Concept ;
    skos:definition "Stimulus that automatically elicits a paired response, such as food eliciting salivation in a hungry animal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unconditioned stimulus" .

goldbook:12097 a skos:Concept ;
    skos:definition "Subcortical structure of striations of gray matter and white matter in the forebrain that serves as the major input to the basal ganglia, specifically the caudate nucleus, the putamen and the striated structure linking them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "striatum" .

goldbook:12098 a skos:Concept ;
    skos:definition "Acute impairment of circulation to a part of the brain, lasting more than \\(\\pu{24 h}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stroke" .

goldbook:12099 a skos:Concept ;
    skos:definition "State of impaired consciousness showing diminution in response to environmental stimulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stupor" .

goldbook:12100 a skos:Concept ;
    skos:definition "Underneath the arachnoid membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subarachnoid" .

goldbook:12101 a skos:Concept ;
    skos:definition "Loss of blood into the space between the arachnoid membrane and the pia mater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subarachnoid hemorrhage" .

goldbook:12102 a skos:Concept ;
    skos:definition "Between the dura mater and the arachnoid membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subdural" .

goldbook:12103 a skos:Concept ;
    skos:definition "Component of the basal ganglia involved in production of the neurotransmitterdopamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substantia nigra" .

goldbook:12104 a skos:Concept ;
    skos:definition "Intracranial contents located above the tentorium of the cerebellum, notably the white matter of the cerebrum, often describing functional symptoms of diseases of the white matter that lead to physical and mental disability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supratentorial" .

goldbook:12105 a skos:Concept ;
    skos:definition "Abnormal protrusion of brain structures into compartments above the tentorium, or over the edge of the tentorium, due to increased intracranial pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supratentorial herniation" .

goldbook:12106 a skos:Concept ;
    skos:altLabel "Porsolt forced swimming test",
        "behavioral despair test",
        "forced swimming test" ;
    skos:definition "Procedure in which a test animal (rodent) is forced to swim to avoid drowning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "swimming test" .

goldbook:12107 a skos:Concept ;
    skos:definition "Part of the autonomic nervous system originating in the thoracic and lumbar regions of the spinal cord that tends to inhibit or oppose the physiological effects of the parasympathetic nervous system, as in tending to reduce digestive secretions, increase the heart rate, and contract blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sympathetic nervous system" .

goldbook:12108 a skos:Concept ;
    skos:altLabel "adrenergic" ;
    skos:definition "n., Substance that produces effects resembling those of impulses transmitted by the postganglionic fibers of the sympathetic nervous system. adj., Having the property of producing such effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sympathomimetic" .

goldbook:12109 a skos:Concept ;
    skos:definition "Functional junction between two neurons, where a nerve impulse is transmitted from one neuron to another, by neurotransmitters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synapse" .

goldbook:12110 a skos:Concept ;
    skos:definition "Narrow gap between the presynaptic and postsynaptic regions of two communicating neurons, into which neurotransmitters are secreted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synaptic cleft" .

goldbook:12111 a skos:Concept ;
    skos:definition "Suppression of synaptic transmission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synaptic inhibition" .

goldbook:12112 a skos:Concept ;
    skos:definition "Ability of synapses to form and reform continually, including to allow learning. Malleability of signal strength arising at the level of synaptic transmission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synaptic plasticity" .

goldbook:12113 a skos:Concept ;
    skos:definition "Removal of dysfunctional synapses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synaptic stripping" .

goldbook:12114 a skos:Concept ;
    skos:definition "Neurotransmitter release, diffusion, and receptor binding, propagating an impulse across a synapse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synaptic transmission" .

goldbook:12115 a skos:Concept ;
    skos:altLabel "syrinx" ;
    skos:definition "Cyst occurring within the spinal cord as a result of accumulation of cerebrospinal fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syringomyelia" .

goldbook:12116 a skos:Concept ;
    skos:definition "Simple type of test apparatus with three arms shaped like the letter 'T.' After placing a rodent in the middle, it is recorded how often the animal enters each arm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T-maze" .

goldbook:12117 a skos:Concept ;
    skos:definition "Abnormally fast heartbeat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tachycardia" .

goldbook:12118 a skos:Concept ;
    skos:definition "Procedure in which the tail of a rodent is heated and the time taken for the animal to flick its tail (latency) is taken as a measure of the relative degree of antinociception." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tail flick test" .

goldbook:12119 a skos:Concept ;
    skos:definition "Procedure in which the tail of a rodent is placed in a hot water bath (typically between \\(\\pu{54^{\\circ}C}\\) and \\(\\pu{58^{\\circ}C}\\)) and the time it takes the animal to remove the tail from the water is interpreted as a measurement of the relative degree of antinociception." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tail immersion test" .

goldbook:12120 a skos:Concept ;
    skos:definition "Procedure in which a mouse is suspended by its tail and the time spent attempting to right itself is observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tail suspension test" .

goldbook:12121 a skos:Concept ;
    skos:definition "One of a class of neurodegenerative diseases, including Alzheimer disease, associated with abnormal aggregation of tau proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tauopathy" .

goldbook:12122 a skos:Concept ;
    skos:definition "One of a class of proteins that stabilizes microtubules, particularly in neurons, astrocytes, and oligodendrocytes of the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tau protein" .

goldbook:12123 a skos:Concept ;
    skos:definition "Cleavage product (\\(\\pu{43 kDa}\\)) of the transactive response (TAR) DNA binding protein (TARDBP) that targets TAR DNA and transcriptionally represses HIV-1." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "TDP-43 transcription factor" .

goldbook:12124 a skos:Concept ;
    skos:definition "Adverse responsiveness to heat or cold. Note: It is associated with a number of medical conditions, some physiologically well-defined (as in cold intolerance in hypothyroidism) and others less so (as in reported chronic fatigue syndrome). Phenotype arising from engineered or selected gene mutations in experimental organisms characterized by an altered temperature permissive for optimal growth or survival." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature sensitivity" .

goldbook:12125 a skos:Concept ;
    skos:definition "One of the four major lobes of each cerebral hemisphere, situated at the base of the brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temporal lobe" .

goldbook:12126 a skos:Concept ;
    skos:altLabel "tentorium cerebelli" ;
    skos:definition "Fold of the dura mater separating the cerebrum from the cerebellum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tentorium" .

goldbook:12127 a skos:Concept ;
    skos:definition "Pertaining to tetanus, characterized by tonic muscle spasm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetanic" .

goldbook:12128 a skos:Concept ;
    skos:definition "Sustained muscle contraction. Disease caused by tetanus toxin and characterized by painful, sustained muscle contraction with spasticity and paralysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetanus" .

goldbook:12129 a skos:Concept ;
    skos:altLabel "tetanospasmin" ;
    skos:definition "Neurotoxin produced by the bacterium Clostridium tetani growing in anaerobic conditions, producing the disease tetanus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetanus toxin" .

goldbook:12130 a skos:Concept ;
    skos:definition "Ganglioside that binds tetanus toxin, facilitating its internalization at the presynapticneuronal membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetanus toxin-binding ganglioside" .

goldbook:12131 a skos:Concept ;
    skos:definition "Neurological syndrome characterized by muscle twitches, cramps, and spasms; and in severe forms, by spasm of the muscles of the larynx (laryngospasm) and seizures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetany" .

goldbook:12132 a skos:Concept ;
    skos:definition "Battery of tests typically for the effects of cannabinoids in rodents that includes hypomotility assessed by an open field test, catalepsy assessed by the bar test, hypothermia measured by rectal temperature, and analgesia measured by avoidance of heat, e.g., in the tail immersion test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetrad test" .

goldbook:12133 a skos:Concept ;
    skos:altLabel "4R,4aR,5R,6S,7S,8S,8aR,10S,12S)-2-azaniumylidene-4,6,8,12-tetrahydroxy-6-(hydroxymethyl)-2,3,4,4a,5,6,7,8-octahydro-1H-8a,10-methano-5,7-(epoxymethanooxy)quinazolin-10-olate",
        "TTX" ;
    skos:definition "Neurotoxin that inhibits action potentials by blocking sodium ion channels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetrodotoxin" .

goldbook:12134 a skos:Concept ;
    skos:altLabel "TTX-insensitive" ;
    skos:definition "Denoting a class of sodium ion channels, found mainly in the heart, that is not blocked by tetrodotoxin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetrodotoxin-insensitive" .

goldbook:12135 a skos:Concept ;
    skos:definition "Movement of an organism toward or away from a mechanical stimulus, physical contact, or spatial discontinuity, as in movement away from touch by a physical stimulus or exploring close to a wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thigmotaxis" .

goldbook:12136 a skos:Concept ;
    skos:definition "Portion of the vertebral column of the upper back, between the cervical spine and lumbar spine, in humans consisting of 12 vertebrae designated T1 to T12." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thoracic spine" .

goldbook:12137 a skos:Concept ;
    skos:definition "Level of depolarization that must be reached to trigger an action potential in an excitable cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold potential" .

goldbook:12138 a skos:Concept ;
    skos:definition "Clot in the cardiovasculature formed from components of the blood, which may be attached to the vessel wall and (or) occlusive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thrombus" .

goldbook:12139 a skos:Concept ;
    skos:definition "Pricking type of paresthesia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tingling" .

goldbook:12140 a skos:Concept ;
    skos:definition "Continual noise in an ear, such as ringing, buzzing, roaring, or clicking." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tinnitus" .

goldbook:12141 a skos:Concept ;
    skos:definition "Construction of an image of a three-dimensional structure from a series of planar sections obtained with penetrating waves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tomography" .

goldbook:12142 a skos:Concept ;
    skos:altLabel "wry neck" ;
    skos:definition "Spasmodic contraction of neck muscles drawing the head to one side with the chin pointing to the other side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torticollis" .

goldbook:12143 a skos:Concept ;
    skos:definition "Substance causing injury to living organisms as a result of physicochemical interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxic substance" .

goldbook:12144 a skos:Concept ;
    skos:definition "Drug that calms and pacifies with minimal sedating or depressant effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tranquilizer" .

goldbook:12145 a skos:Concept ;
    skos:altLabel "TENS" ;
    skos:definition "Electrical stimulus applied across the skin to excite nerves for therapeutic purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcutaneous electronic nerve stimulation" .

goldbook:12146 a skos:Concept ;
    skos:definition "Referring to an event, such as transmission of a nerve impulse, across a synapse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transsynaptic" .

goldbook:12147 a skos:Concept ;
    skos:definition "Bulging of brain tissue from the cerebrum through the notch of the tentorium, caused by increased intracranial pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transtentorial herniation" .

goldbook:12148 a skos:Concept ;
    skos:definition "Procedure used to assess limb function and strength, often to evaluate models of peripheral neuropathy, in which a rodent is placed in an enclosed lane upon a surface that can be made to move at variable speed in a retrograde manner, thus allowing observation of the animal’s gait dimension during sustained attempt at forward motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "treadmill test" .

goldbook:12149 a skos:Concept ;
    skos:definition "Repetitive, often regular and usually involuntary oscillatory movement caused by alternating contractions of opposing muscle groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tremor" .

goldbook:12150 a skos:Concept ;
    skos:definition "Fifth cranial nerve, supplying sensation to the face and controlling motor activity of mastication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trigeminal nerve" .

goldbook:12151 a skos:Concept ;
    skos:altLabel "tic douloureux" ;
    skos:definition "Severe, paroxysmal bursts of pain in one or more branches of the trigeminal nerve, often induced by touching trigger points in or about the mouth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trigeminal neuralgia" .

goldbook:12152 a skos:Concept ;
    skos:definition "Member of a class of drugs based on tryptamine that act as serotonin receptor agonists." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triptan" .

goldbook:12153 a skos:Concept ;
    skos:definition "Not in a conscious state. In psychoanalytic theory, describing feelings and motivations of which one is unaware that nevertheless shape behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unconscious" .

goldbook:12154 a skos:Concept ;
    skos:definition "Anterior projection of the gray matter surrounding the hippocampus, covered by a region of the temporal lobe, involved in olfaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uncus" .

goldbook:12155 a skos:Concept ;
    skos:definition "Neuron whose cell body lies in the cerebral cortex or brainstem and whose axon carries impulses to a lower motor neuron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upper motor neuron" .

goldbook:12156 a skos:Concept ;
    skos:definition "Tenth cranial nerve, arising from the medulla oblongata." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vagus nerve" .

goldbook:12157 a skos:Concept ;
    skos:definition "Decrease in the diameter of the lumen of a blood vessel (especially in the arteries and arterioles) as a result of contraction of smooth muscles in the vessel walls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasoconstriction" .

goldbook:12158 a skos:Concept ;
    skos:definition "Agent that induces vasorelaxation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasodilator" .

goldbook:12159 a skos:Concept ;
    skos:altLabel "pressor",
        "vasoconstrictor" ;
    skos:definition "Agent that induces vasoconstriction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasopressor" .

goldbook:12160 a skos:Concept ;
    skos:altLabel "vasodilatation",
        "vasodilation" ;
    skos:definition "Increase in the diameter of the lumen of the blood vessels as a result of relaxation of smooth muscles in the vessel walls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasorelaxation" .

goldbook:12161 a skos:Concept ;
    skos:altLabel "angiospasm" ;
    skos:definition "Contraction of the muscular wall of blood vessels with sustained vasoconstriction possibly leading to tissue ischemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasospasm" .

goldbook:12162 a skos:Concept ;
    skos:definition "Animal toxin generally used for self-defense or predation and usually delivered by a bite or sting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "venom" .

goldbook:12163 a skos:Concept ;
    skos:definition "Normal cavity within an organ, as in the brain or heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventricle" .

goldbook:12164 a skos:Concept ;
    skos:definition "Surgical shunt draining cerebrospinal fluid into a cardiac atrium, to relieve pressure in hydrocephalus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventriculo-atrial shunt" .

goldbook:12165 a skos:Concept ;
    skos:definition "Radiographic image of the cerebralventricles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventriculogram" .

goldbook:12166 a skos:Concept ;
    skos:definition "Enlargement of the cerebralventricles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventriculomegaly" .

goldbook:12167 a skos:Concept ;
    skos:definition "Surgical shunt draining cerebrospinal fluid into the peritoneum of the abdominal cavity, to relieve pressure in hydrocephalus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventriculo-peritoneal shunt" .

goldbook:12168 a skos:Concept ;
    skos:altLabel "vermis cerebelli" ;
    skos:definition "Narrow central part of the cerebellum between the two cerebellar hemispheres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vermis" .

goldbook:12169 a skos:Concept ;
    skos:altLabel "spine" ;
    skos:definition "Bony structure consisting of the vertebrae and enclosing the spinal cord." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vertebral column" .

goldbook:12170 a skos:Concept ;
    skos:definition "Dizziness; an illusion of movement as if the external world were revolving around one’s self or as if one’s self were revolving in space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vertigo" .

goldbook:12171 a skos:Concept ;
    skos:definition "Ability to maintain concentration or sustain attention over prolonged periods of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vigilance" .

goldbook:12172 a skos:Concept ;
    skos:definition "Decreased vigilance measured as a decline in the ability to maintain an accurate voluntary response to signals with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vigilance decrement" .

goldbook:12173 a skos:Concept ;
    skos:definition "Part of the cerebral cortex located in the occipital lobe, responsible for processing the images of sight." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "visual cortex" .

goldbook:12174 a skos:Concept ;
    skos:definition "Ion channel that opens and closes in response to changes in membrane potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "voltage-gated ion channel" .

goldbook:12175 a skos:Concept ;
    skos:altLabel "Morris water maze test",
        "water navigation test" ;
    skos:definition "Procedure in which a rat or mouse is placed in a pool of water and observed to swim, using visual environmental clues, to an invisible submerged platform that allows escape from the water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "water maze test" .

goldbook:12176 a skos:Concept ;
    skos:altLabel "fluent aphasia",
        "receptive aphasia",
        "sensory aphasia" ;
    skos:definition "Type of aphasia associated with damage to Wernicke’s area or alternatively the medial temporal lobe of the brain, characterized by preservation of speech but with loss of meaningful language and language comprehension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wernicke aphasia" .

goldbook:12177 a skos:Concept ;
    skos:definition "Region of the brain in superior temporal gyrus of the dominant hemisphere, associated with comprehension of written and spoken language." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wernicke’s area" .

goldbook:12178 a skos:Concept ;
    skos:altLabel "alcoholic encephalopathy" ;
    skos:definition "Co-existence of Wernicke encephalopathy (with gait, ocular and mental disturbances) and Korsakoff psychosis (severe memory loss, often with aphasia, apraxia or agnosia) caused by vitamin B1 deficiency in the context of chronic alcohol abuse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wernicke–Korsakoff syndrome" .

goldbook:12179 a skos:Concept ;
    skos:altLabel "ALS-PDC" ;
    skos:definition "Neurodegenerative disease observed in the islands of Guam, Indonesia, Japan and Papua New Guinea, showing combinations of characteristics of amyotrophic lateral sclerosis, atypical parkinsonism with dementia, or dementia alone that may present sequentially during life." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Western Pacific amyotrophic lateral sclerosis and parkinsonism–dementia complex" .

goldbook:12180 a skos:Concept ;
    skos:altLabel "WCST" ;
    skos:definition "Procedure in which cards, depicting different arrangements, numbers, and colors of symbols, are presented to the test subject, who is asked to make the most appropriate match of a test card without further instructions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wisconsin card sorting test" .

goldbook:12181 a skos:Concept ;
    skos:definition "Cessation of exposure to a substance, being characterized by adverse symptoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "withdrawal" .

goldbook:12182 a skos:Concept ;
    skos:definition "Adverse event following withdrawal from a person or animal of a drug to which they have been chronically exposed or on which they have become dependent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "withdrawal effect" .

goldbook:12183 a skos:Concept ;
    skos:definition "Acidic proteolipid protein component of central nervous systemmyelin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wolfgram protein" .

goldbook:12184 a skos:Concept ;
    skos:altLabel "Teleky’s sign",
        "radial nerve palsy" ;
    skos:definition "Inability to extend the wrist as a result of peripheral nerve damage, causing drooping of the hand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wrist drop" .

goldbook:12185 a skos:Concept ;
    skos:altLabel "Danio rerio" ;
    skos:definition "Tropical fish (Danio rerio) about \\(\\pu{4 cm}\\) long, commonly used as a model organism in developmental biology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zebrafish" .

goldbook:12186 a skos:Concept ;
    skos:altLabel "segment" ;
    skos:definition "Group of contiguous skeletal atoms in a chain, including their side groups, if any, such that the chain itself can be represented as a chain of segments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain segment" .

goldbook:12187 a skos:Concept ;
    skos:altLabel "bond-conformational state (in polymer science)" ;
    skos:definition "Rotamer defined by a relative rotation about a skeletal bond of a single-strand chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational isomeric state" .

goldbook:12188 a skos:Concept ;
    skos:definition "Conformation of a chain as defined by its sequence of bond-conformational states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain conformation" .

goldbook:12189 a skos:Concept ;
    skos:definition "Chain conformation corresponding to unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unperturbed conformational state" .

goldbook:12190 a skos:Concept ;
    skos:definition "Radius of gyration of a macromolecule in an unperturbed conformational state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unperturbed radius of gyration" .

goldbook:12191 a skos:Concept ;
    skos:definition "For a flexible macromolecule composed of \\(n\\) mass elements, of masses \\(m_{i}\\), \\(i = 1, 2, \\ldots, n\\), located at statistical-mechanical mean-square distances \\(\\lt\\!s_{i}^{2}\\!\\gt\\) from the centre of mass, the root-mean-square radius of gyration is the square-root of the mass average of \\(\\lt\\!s_{i}^{2}\\!\\gt\\) over all mass elements, i.e., \\[\\lt\\!s^{2}\\!\\gt^{1/2}\\;= \\left(\\sum\\limits_{i=1}^{n} m_{i} \\lt\\!s_{i}^{2}\\!\\gt\\!/\\sum\\limits_{i=1}^{n} m_{i} \\right)^{1/2}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root-mean-square radius of gyration" .

goldbook:12192 a skos:Concept ;
    skos:definition "For a flexible macromolecule composed of \\(n\\) mass elements, of masses \\(m_{i}\\) , \\(i = 1, 2, \\ldots, n\\), located at statistical-mechanical mean-square distances \\(\\lt\\!s_{i}^{2}\\!\\gt\\) from the centre of mass, the mean-square radius of gyration is the mass average of \\(\\lt\\!s_{i}^{2}\\!\\gt\\) over all mass elements, i.e., \\[\\lt\\!s^{2}\\!\\gt = \\left(\\sum\\limits_{i=1}^{n} m_{i} \\lt\\!s_{i}^{2}\\!\\gt\\!/\\sum\\limits_{i=1}^{n} m_{i} \\right)\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean-square radius of gyration" .

goldbook:12193 a skos:Concept ;
    skos:definition "Root-mean-square radius of gyration of a macromolecule having unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root-mean-square unperturbed radius of gyration" .

goldbook:12194 a skos:Concept ;
    skos:definition "Mean-square radius of gyration of a macromolecule having unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean-square unperturbed radius of gyration" .

goldbook:12195 a skos:Concept ;
    skos:definition "Vector connecting the two ends of a linear chain in a particular conformation, with the chain having unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unperturbed end-to-end vector" .

goldbook:12196 a skos:Concept ;
    skos:definition "Magnitude of the unperturbed end-to-end vector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unperturbed end-to-end distance" .

goldbook:12197 a skos:Concept ;
    skos:definition "Statistical-mechanical mean-square end-to-end distance of a linear chain averaged over all chain conformations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean-square end-to-end distance" .

goldbook:12198 a skos:Concept ;
    skos:definition "Root-mean-square end-to-end distance of a chain having unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root-mean-square unperturbed end-to-end distance" .

goldbook:12199 a skos:Concept ;
    skos:definition "Mean-square end-to-end distance of a chain having unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean-square unperturbed end-to-end distance" .

goldbook:12200 a skos:Concept ;
    skos:definition "Root-mean-square end-to-end distance of a linear freely rotating chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "root-mean-square end-to-end distance of a freely rotating chain" .

goldbook:12201 a skos:Concept ;
    skos:definition "Mean-square end-to-end distance of a linear freely rotating chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean-square end-to-end distance of a freely rotating chain" .

goldbook:12202 a skos:Concept ;
    skos:definition "Square root of the ratio of the unperturbed mean-square end-to-end distance of a linear chain to its number of skeletal bonds, i.e., \\[b = (\\lt\\!r_{\\rm{o}}^{2}\\!\\gt\\!/n)^{1/2}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective bond length" .

goldbook:12203 a skos:Concept ;
    skos:definition "Hypothetical freely jointed chain with the same mean-square end-to-end distance and contour length as an actual linear chain having unperturbed dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalent freely jointed chain" .

goldbook:12204 a skos:Concept ;
    skos:altLabel "equivalent freely jointed link",
        "statistical segment" ;
    skos:definition "Segment or link of an equivalent freely jointed chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kuhn segment" .

goldbook:12205 a skos:Concept ;
    skos:altLabel "freely jointed link length",
        "statistical segment length" ;
    skos:definition "Length of a Kuhn segment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kuhn segment length" .

goldbook:12206 a skos:Concept ;
    skos:definition "Freely jointed chain subject to the condition that the segments cannot intersect one another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-avoiding random-walk chain" .

goldbook:12207 a skos:Concept ;
    skos:definition "Depiction of a macromolecule in which its segments are distributed about some point in space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecular coil" .

goldbook:12209 a skos:Concept ;
    skos:definition "Parameter describing the end-to-end distance of a linear, single-strand macromolecular chain having unperturbed dimensions relative to that of a model macromolecular chain not subject to short-range interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain stiffness" .

goldbook:12212 a skos:Concept ;
    skos:altLabel "contraction factor",
        "geometric contraction factor",
        "radius of gyration contraction factor" ;
    skos:definition "Ratio of the mean-square radius of gyration of a branched molecule, \\(\\lt\\!s_{\\rm{b}}^{2}\\!\\gt\\), to that of an otherwise identical linear molecule, \\(\\lt\\!s_{\\rm{l}}^{2}\\!\\gt\\), of the same relative molecular mass in the same solvent at the same temperature, i.e., \\(g = \\lt\\!s_{\\rm{b}}^{2}\\!\\gt\\!/\\!\\lt\\!s_{\\rm{l}}^{2}\\!\\gt\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>g</i>-factor" .

goldbook:12213 a skos:Concept ;
    skos:altLabel "hydrodynamic contraction factor",
        "viscosity contraction factor" ;
    skos:definition "Ratio of the intrinsic viscosity of a branched molecule, \\([\\eta_{\\rm{b}}]\\), to that of an otherwise identical linear molecule, \\([\\eta_{\\rm{l}}]\\), of the same relative molecular mass in the same solvent at the same temperature, i.e., \\(g^{\\prime} = [\\eta_{\\rm{b}}]/[\\eta_{\\rm{l}}]\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>g</i>′-factor" .

goldbook:12214 a skos:Concept ;
    skos:definition "Mass divided by amount of substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar mass" .

goldbook:12215 a skos:Concept ;
    skos:definition "Any average of the molar mass, molecular weight, relative molar mass, or relative molecular mass for a non-uniform polymer, with the symbol \\(\\rm{k}\\) specifying the type of average." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar-mass average" .

goldbook:12216 a skos:Concept ;
    skos:definition "The equation for number-average molar mass is \\[M_{\\rm{n}} = \\frac{1}{\\sum\\limits_{M} (w_{M}/M)}\\] The equation for number-average molecular weight  is \\[M_{\\rm{r,n}} = \\frac{1}{\\sum\\limits_{M_{\\rm{r}}}(w_{M_{\\rm{r}}}/M_{\\rm{r}})}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number-average molar mass" .

goldbook:12217 a skos:Concept ;
    skos:definition "The equation for mass-average molar mass is \\[M_{\\rm{m}} \\equiv M_{\\rm{w}} = \\sum\\limits_{M} w_{M}M\\] The equation for mass-average molecular weight  is \\[M_{\\rm{r,m}} \\equiv {M_{\\rm{r,w}}} = \\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}} M_{\\rm{r}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-average molar mass" .

goldbook:12218 a skos:Concept ;
    skos:definition "The equation for z-average molar mass is \\[M_{\\rm{z}} = \\frac{\\sum\\limits_{M} w_{M}M^{2}}{\\sum\\limits_{M} w_{M}M}\\] The equation for z-average molecular weight is \\[M_{\\rm{r,z}} = \\frac{\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M_{\\rm{r}}^{2}}{\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M_{\\rm{r}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "z-average molar mass" .

goldbook:12219 a skos:Concept ;
    skos:definition "The equation for (z + 1)-average molar mass is \\[M_{\\rm{z+1}} = \\frac{\\sum\\limits_{M} w_{M}M^{3}}{\\sum\\limits_M w_{M}M^{2}}\\] The equation for (z + 1)-average molecular weight is \\[M_{\\rm{r,z+1}} = \\frac{\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M^{3}}{\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M^{2}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "(z + 1)-average molar mass" .

goldbook:12220 a skos:Concept ;
    skos:definition "The equation for viscosity-average molar mass is \\[M_{\\rm{v}} = \\left[\\sum\\limits_{M} w_{M}M^{a} \\right]^{1/a}\\] The equation for viscosity-average molecular weight is \\[M_{\\rm{r,v}} = \\left[\\sum\\limits_{M_{\\rm{r}}} w_{M_{\\rm{r}}}M_{\\rm{r}}^{a} \\right]^{1/a}\\] where \\(a\\) is the exponent in the Mark–Houwink equation, \\([\\eta] = KM^{a}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viscosity-average molar mass" .

goldbook:12221 a skos:Concept ;
    skos:definition "Molar mass, molecular weight, relative molar mass, or relative molecular mass calculated from experimental data without the application of appropriate corrections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apparent molar mass" .

goldbook:12222 a skos:Concept ;
    skos:altLabel "cumulative number distribution",
        "integral number distribution",
        "integral number-distribution function" ;
    skos:definition "Cumulative distribution function in which the relative amount of a portion of a substance with values of the random variable or variables less than or equal to a given value or given values is expressed in terms of mole fraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative number-distribution function" .

goldbook:12223 a skos:Concept ;
    skos:altLabel "cumulative mass distribution",
        "integral mass distribution",
        "integral mass-distribution function" ;
    skos:definition "Cumulative distribution function in which the relative amount of a portion of a substance with values of the random variable or variables less than or equal to a given value or given values is expressed in terms of mass fraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative mass-distribution function" .

goldbook:12224 a skos:Concept ;
    skos:altLabel "molecular-weight dispersity",
        "relative-molar-mass dispersity",
        "relative-molecular-mass dispersity" ;
    skos:definition "Ratio of the mass-average molar mass, \\(M_{\\rm{m}}\\), molecular weight, relative molar mass, or relative molecular mass, \\(M_{\\rm{r,m}}\\), to the number-average molar mass, \\(M_{\\rm{n}}\\), molecular weight, relative molar mass, or relative molecular mass, \\(M_{\\rm{r,n}}\\). \\[Ð\\!_{\\rm{M}} = M_{\\rm{m}}/M_{\\rm{n}} = M_{\\rm{r,m}}/M_{\\rm{r,n}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar-mass dispersity" .

goldbook:12225 a skos:Concept ;
    skos:definition "Ratio of the mass-average degree of polymerisation, \\(X_{\\rm{m}}\\), to the number-average degree of polymerisation, \\(X_{\\rm{n}}\\). \\[Ð\\!_{\\rm{X}} = X_{\\rm{m}}/X_{\\rm{n}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree-of-polymerisation dispersity" .

goldbook:12226 a skos:Concept ;
    skos:definition "Ratio of \\(M_{\\rm{m}}\\) to \\(M_{\\rm{n}}\\), or the ratio of \\(X_{\\rm{m}}\\) to \\(X_{\\rm{n}}\\) for a homopolymer or an alternating copolymer of sufficiently large molar mass, such that the effects of the distinct structures of the end-groups of the constituent macromolecules can be neglected, giving \\(X_{\\rm{n}}\\) directly proportional to \\(M_{\\rm{n}}\\), \\(X_{\\rm{m}}\\) directly proportional to \\(M_{\\rm{m}}\\) and \\(Ð\\!_{\\rm{M}} = Ð\\!_{\\rm{X}} = Ð\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersity" .

goldbook:12228 a skos:Concept ;
    skos:definition "Polymer solution in the concentration range at which the domains occupied by the dissolved macromolecules or entities start to overlap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-dilute solution" .

goldbook:12229 a skos:Concept ;
    skos:definition "Polymer solution in the concentration range at which the domains occupied by the dissolved macromolecules or entities overlap to such an extent that it is not possible to distinguish the individual domains from one another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentrated solution" .

goldbook:12230 a skos:Concept ;
    skos:definition "Entanglement, involving one or more macromolecular chains, of duration at least equal to the period of observation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entanglement" .

goldbook:12231 a skos:Concept ;
    skos:definition "Average distance between two adjacent entanglements on a given macromolecule in a semi-dilute solution, a concentrated solution, or bulk amorphous polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesh size" .

goldbook:12232 a skos:Concept ;
    skos:definition "Hypothetical spherical volume element occupied by a subchain of a macromolecule between two neighbouring entanglements on the same macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blob" .

goldbook:12233 a skos:Concept ;
    skos:definition "Equation of the type \\(y = k x^{a}\\), relating two physical quantities, \\(x\\) and \\(y\\ (\\rm{g})\\), in which the value of the exponent \\(a\\) can be predicted by theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaling law" .

goldbook:12234 a skos:Concept ;
    skos:definition "Difference between specific volume of an amorphous polymer and that of its perfect crystalline form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free volume" .

goldbook:12235 a skos:Concept ;
    skos:definition "Theory reducing the difficult exact evaluation of interactions in a multi-body system to a simpler but approximate evaluation of an average effective interaction of one body with its surroundings." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean-field theory" .

goldbook:12236 a skos:Concept ;
    skos:definition "Decrease in solubility of a polymer in a solvent comprising more than one component, each component of which by itself is a solvent for the polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-nonsolvency" .

goldbook:12237 a skos:Concept ;
    skos:definition "Apparatus for measuring osmotic pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmometer" .

goldbook:12238 a skos:Concept ;
    skos:definition "Measurement of the osmotic pressure of a solution using an osmometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmometry" .

goldbook:12239 a skos:Concept ;
    skos:altLabel "virial coefficient of the chemical potential" ;
    skos:definition "Coefficient in the expansion of the chemical potential of the solvent, \\(\\mu_{\\rm{s}}\\), in powers of the mass concentration, \\(c\\), of the solute, i.e., \\[\\mu_{\\rm{s}} - \\mu_{\\rm{s}}^{\\circ} = -\\mathit{\\Pi} V_{s}^{\\prime} = -RT V_{s}^{\\prime} (A_{1}c + A_{2}c^{2} + A_{3}c^{3} + \\ldots)\\] where \\(\\mu_{\\rm{s}}^{\\circ}\\) is the chemical potential of the solvent in the reference state at the temperature of the system and ambient pressure, \\(\\mathit{\\Pi}\\) is the osmotic pressure and \\(V_{s}^{\\prime}\\) is the partial molar volume of the solvent. In solvents comprising more than one component, the definition applies to any solvent component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmotic virial coefficient" .

goldbook:12240 a skos:Concept ;
    skos:altLabel "binodal curve",
        "coexistence curve" ;
    skos:definition "Curve in the isobaric temperature-composition plane for a mixture defining the region of composition and temperature across which a transition occurs from miscibility of the components to conditions where single-phase mixtures are metastable or unstable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binodal" .

goldbook:12241 a skos:Concept ;
    skos:definition "Point in the isobaric temperature-composition plane of a binary or multicomponent mixture at which a decrease in transparency is observed due to the turbidity caused by phase separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloud point" .

goldbook:12242 a skos:Concept ;
    skos:definition "Curve of temperature vs. composition defined by the cloud points over range of compositions of two substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloud-point curve" .

goldbook:12243 a skos:Concept ;
    skos:definition "Temperature at a cloud point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloud-point temperature" .

goldbook:12244 a skos:Concept ;
    skos:altLabel "LCST" ;
    skos:definition "Critical temperature below which a mixture is miscible at any composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lower critical solution temperature" .

goldbook:12245 a skos:Concept ;
    skos:definition "Process by which the equilibrium statistical distribution of positions of molecules or entities in space is maintained or restored due to their translational Brownian motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "translational diffusion" .

goldbook:12246 a skos:Concept ;
    skos:altLabel "frictional coefficient (in polymer science)" ;
    skos:definition "Frictional force, \\(F\\), per unit velocity, \\(u\\), experienced by an isolated spherical body moving unidirectionally in a viscous isotropic fluid, i.e., \\(F = fu\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "translational frictional coefficient" .

goldbook:12247 a skos:Concept ;
    skos:altLabel "diffusion coefficient (in polymer science)" ;
    skos:definition "Proportionality constant relating the flux per unit area, \\(J_{n}\\), in unidirectional flow of amount, \\(n\\), of entities \\(\\ce{B}\\) to their concentration gradient in the direction (\\(x\\)) of flow, \\({\\rm{d}}c_{\\ce{B}}/{\\rm{d}}x\\), i.e., \\(J_{n} = -D{\\rm{d}} c_{\\ce{B}}/{\\rm{d}}x\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "translational diffusion coefficient" .

goldbook:12248 a skos:Concept ;
    skos:definition "Torque, \\(T\\), per unit angular velocity, \\(\\omega\\), required for rotation of a body about a given axis in a viscous isotropic fluid, i.e., \\(T = \\zeta\\omega\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational frictional coefficient" .

goldbook:12249 a skos:Concept ;
    skos:altLabel "sedimentation-equilibrium method" ;
    skos:definition "Experimental method by which the distribution of the concentration of the solute or dispersed component in a dilute solution or dispersion along the centrifuge cell is measured at sedimentation equilibrium, and the results are interpreted in terms of the molar masses of the solute species or their distribution functions, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium sedimentation method" .

goldbook:12250 a skos:Concept ;
    skos:altLabel "sedimentation equilibrium in a density gradient" ;
    skos:definition "Equilibrium sedimentation method using a multicomponent solvent forming a density gradient in a centrifugal field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium sedimentation in a density gradient" .

goldbook:12251 a skos:Concept ;
    skos:definition "Equation describing the dependence of the inherent viscosity, \\(\\eta_{\\rm{inh}}\\), of a dilute solution on the mass concentration of the solute, \\(c\\), with \\[\\eta_{\\rm{inh}} = (\\ln \\eta_{\\rm{r}})/c = [\\eta] + k_{\\rm{K}}[\\eta]^{2} c\\] where \\(k_{\\rm{K}}\\) is the Kraemer coefficient and \\([\\eta]\\) is the intrinsic viscosity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kraemer equation" .

goldbook:12252 a skos:Concept ;
    skos:definition "Parameter in the Kraemer equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kraemer coefficient" .

goldbook:12253 a skos:Concept ;
    skos:definition "In a solution or dispersion, the perturbation of the flow of the solvent continuum or dispersing medium continuum around a solute molecule, a segment of a dissolved macromolecule or dispersed entity caused by the presence of the other solute molecules, segments, or dispersed entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrodynamic interaction" .

goldbook:12254 a skos:Concept ;
    skos:altLabel "freely draining" ;
    skos:definition "Adjective describing the undisturbed flow of solvent through the domain of a dissolved macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free-draining" .

goldbook:12255 a skos:Concept ;
    skos:altLabel "non-free-draining" ;
    skos:definition "Adjective describing the flow behaviour of a macromolecule in solution or a dispersed entity when, due to hydrodynamic interaction, the solvent or dispersion medium within the domain of the macromolecule or dispersed entity is essentially immobilised and moves with the dissolved macromolecule or dispersed entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impermeable" .

goldbook:12256 a skos:Concept ;
    skos:altLabel "partially draining" ;
    skos:definition "Adjective describing the flow behaviour of a macromolecule in solution or a dispersed entity when, due to hydrodynamic interaction, the solvent within the domain of the macromolecule or a dispersed entity becomes progressively more immobilised with respect to the macromolecule or a dispersed entity in the direction from its outer fringes inward." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial free-draining" .

goldbook:12257 a skos:Concept ;
    skos:definition "Volume of the hydrodynamically equivalent sphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalent hydrodynamic volume" .

goldbook:12258 a skos:Concept ;
    skos:definition "Radius of the hydrodynamically equivalent sphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalent hydrodynamic radius" .

goldbook:12259 a skos:Concept ;
    skos:definition "For an isolated dissolved molecule or dispersed entity, an equation relating the translational frictional coefficient, \\(f\\), to the equivalent hydrodynamic radius in translational diffusive flow, \\(r_{D}\\), and to the viscosity of the solvent continuum or the dispersion medium continuum, \\(η_{0}\\), with \\[f = 6\\uppi \\eta_{0}r_{D}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes equation" .

goldbook:12260 a skos:Concept ;
    skos:definition "For an isolated dissolved molecule or dispersed entity, an equation relating the translational diffusion coefficient, \\(D\\), to the equivalent hydrodynamic radius in translational diffusive flow, \\(r_{D}\\) , and to the viscosity of the solvent continuum or the dispersion medium continuum, \\(\\eta_{0}\\), with \\[D = kT/(6\\uppi \\eta_{0}r_{D})\\] where \\(k\\) is the Boltzmann constant, and \\(T\\) the thermodynamic temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes–Einstein equation" .

goldbook:12261 a skos:Concept ;
    skos:definition "For an isolated dissolved molecule or dispersed entity, an equation relating the rotational diffusion coefficient, \\(\\mathit{\\Theta}\\), to the equivalent hydrodynamic radius in rotational diffusive flow, \\(r_{\\mathit{\\Theta}}\\), and to the viscosity of the solvent continuum or the dispersion medium continuum, \\(\\eta_{0}\\), with \\[D = kT/(6\\pi \\eta_{\\rm{0}} r_{\\mathit{\\Theta}}^3)\\] where \\(k\\) is the Boltzmann constant and \\(T\\) the thermodynamic temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Perrin equation" .

goldbook:12262 a skos:Concept ;
    skos:altLabel "bead-rod model" ;
    skos:definition "Model describing the flow behaviour of a dissolved chain macromolecule in terms of a freely jointed sequence of beads, each of which offers hydrodynamic resistance to the flow of the surrounding solvent continuum and is connected to the next bead by a rigid rod that offers no hydrodynamic resistance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pearl-necklace model" .

goldbook:12263 a skos:Concept ;
    skos:definition "Theory, based on the pearl-necklace model, that describes the translational diffusive and viscous flows of an isolated linear macromolecule in solution in the theta state and accounts for the gradual change from free-draining behaviour at lower molecular weights to impermeable behaviour at higher molecular weights." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kirkwood–Riseman theory" .

goldbook:12264 a skos:Concept ;
    skos:definition "Assumption that the Kirkwood–Riseman theory can be applied to linear isolated macromolecules in solution, independent of whether they are in the theta state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Flory–Fox assumption" .

goldbook:12265 a skos:Concept ;
    skos:definition "Equation relating intrinsic viscosity, \\(\\eta\\), and molar mass, \\(M\\), to the mean-square radius of gyration, with \\[[\\eta]M = \\mathit{\\Phi}^{\\prime}\\!\\lt\\!s^{2}\\!\\gt^{3/2}\\] where \\(\\mathit{\\Phi}^{\\prime}\\) is a parameter the value of which depends on the molar-mass distribution, macromolecular constitution, and chain expansion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Flory–Fox equation" .

goldbook:12266 a skos:Concept ;
    skos:definition "Molecular theory for treating polymer chain dynamics based on the bead-spring model assuming the beads (segments) have zero excluded volume and there is no hydrodynamic interaction between the beads." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rouse theory" .

goldbook:12267 a skos:Concept ;
    skos:definition "Hypothetical polymer chain satisfying the assumptions made in the Rouse theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rouse chain" .

goldbook:12268 a skos:Concept ;
    skos:definition "Snake-like movement of a polymer chain in a semi-dilute or concentrated solution or bulk amorphous polymer through the hypothetical tube created by neighbouring chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reptation" .

goldbook:12269 a skos:Concept ;
    skos:definition "Model to describe the motion of a polymer chain confined in the hypothetical tube created by neighbouring chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tube model" .

goldbook:12270 a skos:Concept ;
    skos:definition "Dynamic renewal of tubes by the disentanglement and re-entanglement of polymer chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tube renewal" .

goldbook:12271 a skos:Concept ;
    skos:definition "Polymer chain allowed to undergo reptation along the tube created by neighbouring chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive chain" .

goldbook:12272 a skos:Concept ;
    skos:definition "Dispersion of particles of identical size, shape, and constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniform dispersion" .

goldbook:12273 a skos:Concept ;
    skos:definition "Dispersion of particles not identical with respect to size, shape, or constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-uniform dispersion" .

goldbook:12274 a skos:Concept ;
    skos:altLabel "SLS" ;
    skos:definition "Experimental method based on the measurement of the time-averaged intensity of light scattered from a polymer solutions or a dispersion of particles at various angles with respect to the incident beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static light scattering" .

goldbook:12275 a skos:Concept ;
    skos:altLabel "DLS",
        "photon-correlation spectroscopy (PCS)",
        "quasi-elastic light scattering (QELS)" ;
    skos:definition "Experimental method based on the measurement of the time autocorrelation function of the intensity of light scattered from a polymer solution or a dispersion of particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic light scattering" .

goldbook:12276 a skos:Concept ;
    skos:definition "Molecule much smaller than the wavelength of the radiation in the solvent used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "small molecule" .

goldbook:12277 a skos:Concept ;
    skos:definition "Molecule of size similar to or larger than the wavelength of the radiation in the solvent used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "large molecule" .

goldbook:12278 a skos:Concept ;
    skos:definition "Difference between the scattering intensity for a dilute solution or a dilute dispersion and that for the pure solvent or the dispersion medium at the same scattering angle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excess scattering" .

goldbook:12279 a skos:Concept ;
    skos:definition "Function describing the dependence of relative scattering intensity on the magnitude of the scattering vector, \\(q\\), for a polymer solution or a dispersion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static structure factor" .

goldbook:12280 a skos:Concept ;
    skos:definition "Function describing the temporal dependence of relative scattering intensity on the magnitude of the scattering vector, \\(q\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic structure factor" .

goldbook:12281 a skos:Concept ;
    skos:definition "Time elapsed from the injection of the sample into a chromatography bed to the recording of a specified signal of the detector due to the sample having passed through the bed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elution time" .

goldbook:12282 a skos:Concept ;
    skos:definition "Volume of solvent that has passed through a chromatography bed from the injection of the sample to the recording of a specified signal of the detector due to the sample having passed through the bed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elution volume" .

goldbook:12283 a skos:Concept ;
    skos:definition "The anodic transfer coefficient \\(\\alpha_{\\rm{a}}\\) and the cathodic transfer coefficient \\(\\alpha_{\\rm{c}}\\) are defined by the following equations: \\[\\alpha_{\\rm{a}} = (RT/F)({\\rm{d}}\\ln\\! j_{\\rm{a}}/{\\rm{d}}E); \\quad \\alpha_{\\rm{c}} = -(RT/F)({\\rm{d}}\\ln\\!\\vert {j_{\\rm{c}}} \\vert /{\\rm{d}}E)\\] In these equations, \\(j_{\\rm{a}}\\) and \\(j_{\\rm{c}}\\) are the anodic and cathodic current densities, respectively, corrected for any changes in the reactant concentration at the electrode surface with respect to its bulk value; incidentally, the symbols \\(\\ln\\! j_{\\rm{a}}\\) and \\(\\ln\\!\\vert j_{\\rm{c}}\\vert\\) imply that the argument of the logarithm is of dimension one, obtained by division with the corresponding unit, e.g., \\(\\ln\\! j_{\\rm{a}}\\) meaning \\(\\ln(j_{\\rm{a}}/\\pu{A m^{-2}})\\), and similarly for the other quantities \\(\\vert j_{\\rm{c}}\\vert\\), \\(k_{\\rm{a}}\\) and \\(k_{\\rm{c}}\\). \\(E\\) is the applied electric potential, \\(R\\) is the gas constant, \\(T\\) is the thermodynamic temperature, and \\(F\\) is the Faraday constant. In practice, \\(\\alpha_{\\rm{a}}\\) and \\(\\alpha_{\\rm{c}}\\) are defined as the reciprocal of the corresponding Tafel slopes, \\({\\rm{d}}E/{\\rm{d}}\\ln\\! j_{\\rm{a}}\\) and \\(-{\\rm{d}}E/{\\rm{d}} \\ln\\! \\vert j_{\\rm{c}} \\vert\\), made dimensionless by the multiplying factor \\(RT/F\\). Both the transfer coefficient and the Tafel slope are determined at constant temperature and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer coefficient" .

goldbook:12284 a skos:Concept ;
    skos:definition "Application of two or more techniques to different samples at the same time. This can include thermal and nonthermal analytical techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combined technique" .

goldbook:12285 a skos:Concept ;
    skos:altLabel "CRTA" ;
    skos:definition "Sample-controlled method where the feedback used to control the heating is the rate of transformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled-rate thermal analysis" .

goldbook:12286 a skos:Concept ;
    skos:definition "Temperature history imposed on the sample during the course of the thermal analysis experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled temperature program" .

goldbook:12287 a skos:Concept ;
    skos:definition "Experimental result of measuring the temperature of the sample as a function of time during cooling. Heating curves are obtained for temperature-time experiments during heating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cooling curve" .

goldbook:12288 a skos:Concept ;
    skos:definition "Pertaining to the \\(1^{\\rm{st}}\\) derivative (mathematical) of any curve with respect to temperature or time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derivative technique" .

goldbook:12289 a skos:Concept ;
    skos:altLabel "DEA" ;
    skos:definition "Technique where dielectric properties are measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dielectric thermal analysis" .

goldbook:12290 a skos:Concept ;
    skos:definition "Pertaining to a difference in measured or measurable quantities usually between a sample and a reference or standard material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential technique" .

goldbook:12291 a skos:Concept ;
    skos:altLabel "DSC",
        "heat-flow DSC" ;
    skos:definition "Technique where the difference between the heat-flow rates into a sample and a reference material is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heat-flow differential scanning calorimetry" .

goldbook:12292 a skos:Concept ;
    skos:altLabel "DSC",
        "power compensation DSC" ;
    skos:definition "Technique where the difference between the electrical powers into a sample and a reference material is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "power compensation differential scanning calorimetry" .

goldbook:12293 a skos:Concept ;
    skos:definition "Indicates, especially in the mechanical analysis of materials, that a parameter changes continuously during the experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic technique" .

goldbook:12294 a skos:Concept ;
    skos:altLabel "DMA" ;
    skos:definition "Technique where storage and loss viscoelastic moduli are determined with the help of a periodical stress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic mechanical analysis" .

goldbook:12295 a skos:Concept ;
    skos:definition "Passage of gas from one part of the system to another. The gas may be either inert (carrier gas) or reactive, either introduced into the system or evolving from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas flow" .

goldbook:12296 a skos:Concept ;
    skos:definition "Applied to a technique to indicate that the temperature is maintained constant throughout the experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isothermal technique" .

goldbook:12297 a skos:Concept ;
    skos:definition "The substance which is studied and from which the sample is taken." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "material" .

goldbook:12298 a skos:Concept ;
    skos:definition "Prefix used to denote that the technique measures small quantities, either with respect to the amount of sample studied, or with respect to the change in the properties measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micro- technique" .

goldbook:12299 a skos:Concept ;
    skos:definition "Indicates that a parameter changes in a periodic manner during the experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulated technique" .

goldbook:12300 a skos:Concept ;
    skos:altLabel "MT" ;
    skos:definition "Applied to the technique name to indicate that a temperature modulation has been applied to the temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulated temperature technique" .

goldbook:12301 a skos:Concept ;
    skos:definition "Indicates that the experiment involves the illumination of the sample or measures the amount of light emitted from a sample. Where possible, the wavelength range of the light should be specified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo- technique" .

goldbook:12302 a skos:Concept ;
    skos:definition "Applied to the technique to indicate that a property of the sample is used either continuously or discontinuously to control the sample heating. Without this term, it is assumed that the experiment is following a controlled-temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample controlled technique" .

goldbook:12303 a skos:Concept ;
    skos:altLabel "thermal analysis curve" ;
    skos:definition "A term used to describe the data produced from a thermal analysis experiment. More correct usage is a thermal analysis curve, or, for a specific technique thermogravimetric curve, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scan" .

goldbook:12304 a skos:Concept ;
    skos:definition "Indicates that a specified experimental parameter, if not temperature, is changed in a controlled manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning technique" .

goldbook:12305 a skos:Concept ;
    skos:definition "Techniques where heat is measured as a function of temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning calorimetry" .

goldbook:12306 a skos:Concept ;
    skos:definition "Indicates the measurement of two or more properties of a single sample at the same time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous technique" .

goldbook:12307 a skos:Concept ;
    skos:definition "Indicates, especially in the mechanical analysis of materials, a constant parameter during the experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static technique" .

goldbook:12308 a skos:Concept ;
    skos:definition "Indicates discrete, discontinuous changes in an experimental parameter, e.g., force, temperature, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stepwise technique" .

goldbook:12309 a skos:Concept ;
    skos:definition "The dimensionless ratio of energy lost to energy returned during one cycle of a periodic process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tan $\\delta$" .

goldbook:12310 a skos:Concept ;
    skos:altLabel "TPD" ;
    skos:definition "EGA using an inert atmosphere or vacuum, in the absence of sample decomposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature-programmed desorption" .

goldbook:12311 a skos:Concept ;
    skos:altLabel "TPO" ;
    skos:definition "Experiment using an oxidising atmosphere, usually oxygen. Oxidation is monitored by any appropriate technique (EGA, TGA, gas sorption, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature-programmed oxidation" .

goldbook:12312 a skos:Concept ;
    skos:altLabel "TPR" ;
    skos:definition "Experiment using a reducing atmosphere, usually hydrogen. Reduction is monitored by any appropriate technique (EGA, TGA, gas sorption, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature-programmed reduction" .

goldbook:12313 a skos:Concept ;
    skos:altLabel "thermoanalytical curve" ;
    skos:definition "Any graph of any combination of property, time, temperature derived from a thermal analysis technique." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal curve" .

goldbook:12314 a skos:Concept ;
    skos:altLabel "TSC" ;
    skos:definition "Electrical current observed during heating and caused by the thermally initiated relaxation of the frozen-in electrical polarization of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermally stimulated current" .

goldbook:12315 a skos:Concept ;
    skos:definition "Relaxation of frozen-in electrical polarization caused by a temperature increase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermally stimulated depolarisation" .

goldbook:12316 a skos:Concept ;
    skos:definition "Indicating the use of changing temperature during the experiment, when in the name of a thermal analysis technique." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermo- technique" .

goldbook:12317 a skos:Concept ;
    skos:definition "Of, or pertaining to, thermal analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoanalytical" .

goldbook:12318 a skos:Concept ;
    skos:definition "A technique where the X-ray diffraction of the sample is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermodiffractometry" .

goldbook:12319 a skos:Concept ;
    skos:altLabel "TGA",
        "thermogravimetry (TG)" ;
    skos:definition "A technique where the mass of the sample is measured, also known as thermogravimetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermogravimetric analysis" .

goldbook:12320 a skos:Concept ;
    skos:definition "A technique where the gas pressure is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomanometry" .

goldbook:12321 a skos:Concept ;
    skos:altLabel "TMA" ;
    skos:definition "A technique where the deformation of the sample is measured under constant load." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomechanical analysis" .

goldbook:12322 a skos:Concept ;
    skos:definition "A technique where the optical properties of the sample are observed and measured through a microscope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomicroscopy" .

goldbook:12323 a skos:Concept ;
    skos:definition "A group of techniques where a spectrum of the sample is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermospectrometry" .

goldbook:12324 a skos:Concept ;
    skos:altLabel "AQUA" ;
    skos:definition "Method for absolute quantitation of proteins via measurements on constituent proteolytic peptides using chemically synthesized isotope-labeled peptides as surrogate internal standards for mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute quantitation of proteins" .

goldbook:12325 a skos:Concept ;
    skos:definition "Electrical potential difference used to impart translational energy to ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accelerating potential" .

goldbook:12326 a skos:Concept ;
    skos:definition "Experimentally determined mass of an ion of known charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accurate mass" .

goldbook:12327 a skos:Concept ;
    skos:definition "Value of the mass of a peptide from a protein that has been chemically or enzymatically cleaved into fragments. The mass is recorded with sufficiently high accuracy and precision that it can be used in identification of the protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accurate mass tag" .

goldbook:12328 a skos:Concept ;
    skos:definition "Fragment ion containing the peptide \\(\\ce{N}\\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \\(\\ce{C-C}\\) bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "a-ion" .

goldbook:12329 a skos:Concept ;
    skos:definition "Even-electron positively charged saturated hydrocarbon ion containing no aromatic groups, a special case of carbenium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkyl cation" .

goldbook:12330 a skos:Concept ;
    skos:altLabel "AGHIS" ;
    skos:definition "All-glass inlet system for ion sources operating under vacuum that can be heated to about \\(\\pu{500^{\\circ}C}\\) and allows low vapor pressure materials to be introduced into the mass spectrometer without breaking vacuum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "all-glass heated inlet system" .

goldbook:12331 a skos:Concept ;
    skos:definition "Even-electron ion formulated as \\(\\ce{R^{1}R^{2}C=CR^{3}C+R^{4}R^{5}}\\) and its resonance forms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allyl cation" .

goldbook:12332 a skos:Concept ;
    skos:definition "Desorption of molecules and formation of ions outside the mass spectrometer directly from samples in their native environment with no or minimal sample preparation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambient ionization" .

goldbook:12333 a skos:Concept ;
    skos:definition "Mass spectrometry analysis performed using an ambient ionization technique." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambient mass spectrometry" .

goldbook:12334 a skos:Concept ;
    skos:definition "Technique used to investigate details of the collisional excitation process by studying trends relating scattering angle of the precursor ion, internal energy transferred, and the masses of the ion and its collision partner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle resolved mass spectrometry" .

goldbook:12335 a skos:Concept ;
    skos:definition "Ion formed by the association of an anion with a molecule, \\(\\ce{M}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anionized molecule" .

goldbook:12336 a skos:Concept ;
    skos:altLabel "APCI" ;
    skos:definition "Chemical ionization of a sample that is a gas or nebulized liquid, using an atmospheric pressure corona discharge or beta emitter such as \\(\\ce{^{63}Ni}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmospheric pressure chemical ionization" .

goldbook:12337 a skos:Concept ;
    skos:altLabel "AP MALDI" ;
    skos:definition "Matrix-assisted laser desorption/ionization in which the sample target is at atmospheric pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmospheric pressure matrix-assisted laser desorption/ionization" .

goldbook:12338 a skos:Concept ;
    skos:altLabel "APPI" ;
    skos:definition "Direct ionization of molecules at atmospheric pressure by electron detachment induced by photons forming \\(\\ce{M^{+.}}\\), or atmospheric pressure chemical ionization in which the reactant ions are generated by photoionization of suitable dopant species and subsequent ion/molecule reactions of their molecular ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmospheric pressure photoionization" .

goldbook:12339 a skos:Concept ;
    skos:definition "Process whereby a negative ion in a discrete state with energy greater than the detachment threshold loses an electron spontaneously without further interaction with an energy source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autodetachment" .

goldbook:12340 a skos:Concept ;
    skos:definition "Gas used in a spray ion source in addition to the nebulizing gas to aid in solvent removal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auxiliary gas" .

goldbook:12341 a skos:Concept ;
    skos:definition "Mass of an ion or molecule weighted for its isotopic composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average mass" .

goldbook:12342 a skos:Concept ;
    skos:definition "Ejection of an ion from an ion trap in a direction parallel to the longitudinal axis of the trap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axial ejection" .

goldbook:12343 a skos:Concept ;
    skos:definition "Technique used in Fourier-transform ion cyclotron resonance mass spectrometers to limit the translational motion of the trapped ions so that they occupy a small volume near the trap center, thus optimizing performance criteria including resolving power." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axialization" .

goldbook:12344 a skos:Concept ;
    skos:altLabel "BPC",
        "base peak ion chromatogram" ;
    skos:definition "Chromatogram obtained by plotting the signal of the ions represented by the base peak detected in each of a series of mass spectra recorded as a function of retention time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base peak chromatogram" .

goldbook:12345 a skos:Concept ;
    skos:definition "Mass spectrometer in which an ion beam accelerated from the ion source is transmitted through a m/z analyzer, or analyzers, to the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam mass spectrometer" .

goldbook:12346 a skos:Concept ;
    skos:definition "Even-electron ion \\(\\ce{C7H7^{+}}\\) with the same carbon skeleton as toluene that has lost a hydrogen atom from the methyl side-chain that carries the positive charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benzyl ion" .

goldbook:12347 a skos:Concept ;
    skos:definition "Fragment ion containing the peptide \\(\\ce{N}\\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \\(\\ce{C-N}\\) bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "b-ion" .

goldbook:12348 a skos:Concept ;
    skos:altLabel "BIRD" ;
    skos:definition "Special case of infrared multiphoton dissociation wherein excitation of the reactant ion is caused by absorption of infrared photons radiating from heated blackbody surroundings, which are usually the walls of a vacuum chamber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blackbody infrared radiative dissociation" .

goldbook:12349 a skos:Concept ;
    skos:altLabel "Brubaker pre-filter" ;
    skos:definition "Additional set of four short, cylindrical electrodes, mounted co-linearly with a transmission quadrupole mass spectrometer that is excited with some fraction of the AC potential but not the DC potential applied to the main quadrupole. The Brubaker lens thus acts as a high-pass filter for ion m/z, but the resulting delay in application of the DC potential component also results in a reduction in defocusing by fringe fields and thus significantly improves overall ion transmission efficiency at a given mass resolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brubaker lens" .

goldbook:12350 a skos:Concept ;
    skos:altLabel "bath gas" ;
    skos:definition "Inert gas used for collisional reduction of the internal or translational energy of ions, such as in ion traps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "buffer gas" .

goldbook:12351 a skos:Concept ;
    skos:definition "Procedure of recording mass spectra in which an automated computer-based system detects peaks, calculates the centroid based on the average m/z value weighted by the intensity, and assigns m/z values based on a calibration file. Only the centroid m/z value and the peak magnitude are stored." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centroid acquisition" .

goldbook:12352 a skos:Concept ;
    skos:definition "Theoretical model for production of highly charged macromolecules by electrospray ionization in which the excess charges on electrosprayed droplets are transferred to and remain on molecules enclosed within the droplets after solvent evaporation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charged residue model" .

goldbook:12353 a skos:Concept ;
    skos:definition "Reaction of an ion with a neutral, surface, or ion of opposite polarity, in which the charge on the product ion is reversed in sign with respect to the reactant ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge inversion reaction" .

goldbook:12354 a skos:Concept ;
    skos:altLabel "heterolytic fragmentation; inductive cleavage" ;
    skos:definition "Fragmentation of an ion in which the cleavage of one of its bonds is induced by the charge site. The cleaved bond is adjacent to the apparent charge site, and its cleavage involves movement of the electron pair forming that bond to the original charge site and thus migration of the charge to the released fragment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-mediated fragmentation" .

goldbook:12355 a skos:Concept ;
    skos:altLabel "CRF" ;
    skos:definition "Fragmentation of an ion in which the cleaved bond is isolated from the apparent charge site by a distance of several bond lengths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge remote fragmentation" .

goldbook:12356 a skos:Concept ;
    skos:definition "Chemical derivatization of molecules to introduce a fixed charge site, thus improving ionization efficiency by electrospray ionization or matrix-assisted laser desorption/ionization and directing subsequent ion fragmentation in a manner that facilitates structure identification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge site derivatization" .

goldbook:12357 a skos:Concept ;
    skos:definition "Fragment ion containing the peptide \\(\\ce{N}\\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \\(\\ce{N-C}\\) bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "c-ion" .

goldbook:12358 a skos:Concept ;
    skos:definition "Reflectron that is arranged such that its main axis is coaxial with the ion source and first stage of the time-of-flight analyzer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coaxial reflectron" .

goldbook:12359 a skos:Concept ;
    skos:definition "Slit installed in a magnetic sector mass spectrometer to allow only those m/z separated ions with a specific m/z into the detector system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collector slit" .

goldbook:12360 a skos:Concept ;
    skos:definition "Effect where collisions with a buffer gas in a radio-frequency ion trap or transmission quadrupole causes ions to lose translational energy and concentrate at the center of the trap or axis of the linear quadrupole. The effect increases with gas pressure up to a point where ion scattering becomes the dominant process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collisional focusing" .

goldbook:12361 a skos:Concept ;
    skos:definition "Chamber in the ion path between m/z separation elements, or between ion source acceleration region and the first analyzer, in tandem mass spectrometry in space configurations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision cell" .

goldbook:12362 a skos:Concept ;
    skos:definition "Inert gas used for collisional excitation or a reactive gas used for ion/molecule reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision gas" .

goldbook:12363 a skos:Concept ;
    skos:definition "Transmission quadrupole to which an oscillating radio frequency potential is applied so as to focus a beam of ions through a collision gas or buffer gas with no m/z separation other than low m/z cut-off." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision quadrupole" .

goldbook:12364 a skos:Concept ;
    skos:altLabel "CRC" ;
    skos:definition "Collision cell for removal of interfering ions by ion/neutral reactions in inductively coupled plasma mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision reaction cell" .

goldbook:12365 a skos:Concept ;
    skos:definition "Pneumatic nebulizer in which the liquid flows through a central capillary and dispersion gas flows through a surrounding outer tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentric nebulizer" .

goldbook:12366 a skos:Concept ;
    skos:altLabel "CRM" ;
    skos:definition "Multiple-stage mass spectrometry experiment with three or more stages of m/z separation in which products of sequential fragmentation or bimolecular reactions are selected for detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "consecutive reaction monitoring" .

goldbook:12367 a skos:Concept ;
    skos:altLabel "fixed neutral gain spectrum",
        "fixed neutral mass gain spectrum" ;
    skos:definition "Spectrum formed of all precursor ions that have undergone a selected m/z increase corresponding to the mass of a particular neutral species divided by the charge number of the precursor. The ions detected are the product ions produced by gain of a preselected neutral species mass following ion/molecule reactions of the precursor ions with a reactant gas in a collision cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constant neutral mass gain spectrum" .

goldbook:12368 a skos:Concept ;
    skos:altLabel "fixed neutral loss spectrum",
        "fixed neutral mass loss spectrum" ;
    skos:definition "Spectrum of all precursor ions that have undergone a selected m/z decrement corresponding to the mass of a particular neutral divided by the charge number of the precursor. The ions detected are the product ions produced by loss of a preselected neutral mass following collision-induced dissociation of the precursor ions in a collision cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constant neutral mass loss spectrum" .

goldbook:12369 a skos:Concept ;
    skos:altLabel "channel electron multiplier" ;
    skos:definition "Ion-to-electron detector in which the ion strikes the inner surface of a continuous tube device and induces the production of secondary electrons that, in turn, impinge on the inner surfaces of the device to produce more secondary electrons. This avalanche effect produces an increase in the final measured current pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous dynode particle multiplier" .

goldbook:12370 a skos:Concept ;
    skos:altLabel "CF-FAB" ;
    skos:definition "Variant of fast atom bombardment in which the mixture of analyte and liquid matrix is continuously supplied to the sample probe tip." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous-flow fast atom bombardment" .

goldbook:12371 a skos:Concept ;
    skos:altLabel "CF-MALDI" ;
    skos:definition "Variant of matrix-assisted laser desorption/ionization in which the analyte is dissolved in a liquid matrix that is continuously supplied to the sample probe tip." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous-flow matrix-assisted laser desorption/ionization" .

goldbook:12372 a skos:Concept ;
    skos:definition "Surface that is held at high potential so that ions striking the surface produce secondary charged particles that are subsequently detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conversion dynode" .

goldbook:12373 a skos:Concept ;
    skos:definition "Electric discharge generated in a gas, usually at atmospheric pressure, surrounding a conductor carrying a sufficiently high potential that the electric field around it ionizes the gas so as to form a plasma in the immediate vicinity of the conductor without causing complete electric breakdown or arcing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corona discharge" .

goldbook:12374 a skos:Concept ;
    skos:definition "Formation of ions in a corona discharge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corona discharge ionization" .

goldbook:12375 a skos:Concept ;
    skos:definition "Stream of inert gas, often heated, that is used in an electrospray or other spray ionization source to aid in the evaporation of solvent from the sprayed particles. The flow of the gas is in the direction opposite to that of the spray." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter-current gas" .

goldbook:12376 a skos:Concept ;
    skos:definition "Counter electrode in an electrospray ionization ion source is one of two electrodes between which the high electric potential is applied, the other electrode being the electrospray needle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter electrode" .

goldbook:12377 a skos:Concept ;
    skos:definition "Pneumatic nebulizer in which the dispersion gas flows at an angle, usually \\(\\pu{90\\!^{\\circ}}\\), with respect to the column of liquid emerging from a capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-flow nebulizer" .

goldbook:12378 a skos:Concept ;
    skos:definition "Reflectron designed to provide a decelerating field strength that varies with depth of ion penetration and thus with ion translational energy, permitting energy focusing of ions with a range of translational energies such as those formed as product ions from post-source decay of metastable ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "curved field reflectron" .

goldbook:12379 a skos:Concept ;
    skos:definition "Circular motion of a charged particle moving perpendicularly to the direction of a magnetic field that results from the Lorentz force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclotron motion" .

goldbook:12380 a skos:Concept ;
    skos:definition "Detector consisting of an off-axis conversion dynode, scintillator, and photomultiplier. The dynode at high potential emits secondary electrons when ions impinge on the surface. The secondary electrons are accelerated onto the scintillator that produces light that is then detected by the photomultiplier detector, which can be outside the vacuum system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Daly detector" .

goldbook:12381 a skos:Concept ;
    skos:definition "Mode of data collection in tandem mass spectrometry in which a fixed number of precursor ions whose m/z values were recorded in a survey scan are selected using predetermined rules and are subjected to a second stage of mass selection in an MS/MS analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "data-dependent acquisition" .

goldbook:12382 a skos:Concept ;
    skos:definition "Mass spectrum processed with an algorithm designed to extract a desired signal or signals from raw experimental data in which the desired signals have been complicated (convolved) by some interferences or in some other way." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deconvoluted mass spectrum" .

goldbook:12383 a skos:Concept ;
    skos:altLabel "DE" ;
    skos:definition "Application of the accelerating voltage pulse after a time delay in desorption ionization from a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed extraction" .

goldbook:12384 a skos:Concept ;
    skos:definition "Ion formed by the removal of a proton from a molecule \\(\\ce{M}\\) to produce an anion represented as \\(\\ce{[M - H]^{-}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deprotonated molecule" .

goldbook:12385 a skos:Concept ;
    skos:altLabel "DCI" ;
    skos:definition "Formation of gas-phase ions by chemical ionization of gaseous molecules produced by the rapid heating and desorption of a solid or low vapour pressure liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption chemical ionization" .

goldbook:12386 a skos:Concept ;
    skos:definition "Formation of gas phase ions from a solid or liquid sample surface upon activation by heat, strong electric field, particles, droplets, or photon bombardment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption ionization" .

goldbook:12387 a skos:Concept ;
    skos:altLabel "DIOS" ;
    skos:definition "Soft ionization alternative to matrix-assisted desorption/ionization involving laser desorption ionization of a sample deposited on a porous silicon surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption ionization on silicon" .

goldbook:12388 a skos:Concept ;
    skos:definition "Product ion whose formation reveals structural or compositional information about its precursor ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diagnostic ion" .

goldbook:12389 a skos:Concept ;
    skos:definition "Atmospheric pressure chemical ionization in which the low-temperature plasma is not generated by a corona discharge but by a device consisting of two electrodes with at least one dielectric layer that separates the electrode from the plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dielectric barrier discharge ionization" .

goldbook:12390 a skos:Concept ;
    skos:definition "High-energy fragment ion of a protonated peptide, formally equivalent to a fragment ion formed by homolytic cleavage of a peptide \\(\\ce{C-N}\\) bond together with the part of the \\(\\ce{C}\\)-terminal side-chain starting at the \\(\\ce{\\upgamma\\mbox{-}carbon}\\) (if any)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "d-ion" .

goldbook:12391 a skos:Concept ;
    skos:altLabel "DEP" ;
    skos:definition "Device based on a modification of a direct insertion probe for exposing an involatile sample directly to the electron beam (in an electron ionization source) or to a chemical ionization plasma as in desorption chemical ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct exposure probe" .

goldbook:12392 a skos:Concept ;
    skos:definition "Method of liquid sample introduction in which the sample is continuously flowed into a mass spectrometer ion source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct infusion" .

goldbook:12393 a skos:Concept ;
    skos:altLabel "DIP" ;
    skos:definition "Device for introducing a single sample of a solid or liquid, usually contained in a quartz or other nonreactive sample holder, into a mass spectrometer ion source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct insertion probe" .

goldbook:12394 a skos:Concept ;
    skos:altLabel "DLI" ;
    skos:definition "Direct delivery of a liquid sample at a low solvent flow rate into the chemical ionization ion source of a mass spectrometer. The solvent vapour can act as the reagent gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct liquid introduction" .

goldbook:12395 a skos:Concept ;
    skos:definition "Ion-to-electron detector in which the ion strikes the surface of an electrode and induces the production of secondary electrons. In turn, these impinge in sequence on dynodes at a more positive electric potential to produce more secondary electrons. This avalanche effect produces an amplification of several orders of magnitude in the final measured current pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discrete dynode particle multiplier" .

goldbook:12396 a skos:Concept ;
    skos:definition "Ionization mechanism in which capture of a low-energy electron by a molecule leads directly to a dissociative state of the nascent anion, an example of dissociative ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissociative electron capture" .

goldbook:12397 a skos:Concept ;
    skos:definition "Cylindrical chamber containing a buffer gas. Ions introduced at one end are caused to move to the other end by either a flow of the buffer gas or by a uniform longitudinal electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drift tube" .

goldbook:12398 a skos:Concept ;
    skos:definition "Inert gas that is used to promote the removal of solvent from aerosol particles in spray ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drying gas" .

goldbook:12399 a skos:Concept ;
    skos:definition "Software method used to minimize repeat selections of identical precursor ions for collision-induced dissociation in replicate chromatography-tandem mass spectrometry analyses of complex mixtures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic exclusion" .

goldbook:12400 a skos:Concept ;
    skos:definition "Three-element charged particle lens in which the first and third elements are maintained at the same electric potential. Such a lens produces focusing without changing the translational energy of the particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "einzel lens" .

goldbook:12401 a skos:Concept ;
    skos:definition "Ionization process that produces charged droplets and gas-phase ions from a liquid under vacuum with the application of an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrohydrodynamic ionization" .

goldbook:12402 a skos:Concept ;
    skos:altLabel "ECD" ;
    skos:definition "Process in which multiply protonated molecules interact with low-energy electrons followed by fragmentation. The capture of an electron by the even-electron cation \\(\\ce{[M + nH]^{n+}}\\) liberates energy and reduces its charge state, thus producing the corresponding \\(\\ce{[M + nH]^{(n - 1)+.}}\\) odd-electron ion, which readily fragments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron capture dissociation" .

goldbook:12403 a skos:Concept ;
    skos:altLabel "ECI",
        "electron capture negative ionization" ;
    skos:definition "Ionization of a gas-phase atom or molecule by attachment of a free electron to form molecular ions of the \\(\\ce{M^{-.}}\\) type." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron capture ionization" .

goldbook:12404 a skos:Concept ;
    skos:altLabel "electrospray emitter" ;
    skos:definition "Narrow bore tube from which highly charged droplets are emitted in electrospray ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrospray needle" .

goldbook:12405 a skos:Concept ;
    skos:altLabel "ESA",
        "electric sector" ;
    skos:definition "Device consisting of pairs of parallel conducting plates, concentric cylinders, or concentric spheres that separate charged particles according to their ratio of translational energy to charge by means of a potential difference applied between the pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrostatic energy analyser" .

goldbook:12406 a skos:Concept ;
    skos:definition "Rule that states that even-electron ions tend to form even-electron fragment ions whereas odd-electron ions tend to dissociate to form either odd- or even-electron ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "even-electron rule" .

goldbook:12407 a skos:Concept ;
    skos:definition "Calculated mass of an ion or molecule with specified isotopic composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exact mass" .

goldbook:12408 a skos:Concept ;
    skos:altLabel "mass chromatogram",
        "reconstructed ion chromatogram" ;
    skos:definition "Chromatogram created by plotting the intensity of the signal observed at a chosen m/z value or set of values in a series of mass spectra recorded as a function of retention time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extracted ion chromatogram" .

goldbook:12409 a skos:Concept ;
    skos:altLabel "extracted ion electrophorogram" ;
    skos:definition "Electropherogram created by plotting the intensity of the signal observed at a chosen m/z value or set of values in a series of mass spectra recorded as a function of electrophoresis time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extracted ion electropherogram" .

goldbook:12410 a skos:Concept ;
    skos:definition "Any plot of signal intensity observed at a chosen m/z value or set of values in a series of mass spectra recorded as a function of time, including extracted ion chromatogram, extracted ion electropherogram, or from flow injection analysis or any other time-dependent sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extracted ion profile" .

goldbook:12411 a skos:Concept ;
    skos:altLabel "FIB" ;
    skos:definition "Ionization of any species by the interaction of a focused beam of ions, with a translational energy of several thousand \\(\\pu{eV}\\), with a solid or liquid sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast ion bombardment" .

goldbook:12412 a skos:Concept ;
    skos:altLabel "FFR" ;
    skos:definition "Section of a mass spectrometer in which there are no electric or magnetic fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field-free region" .

goldbook:12413 a skos:Concept ;
    skos:definition "Stability region of a Mathieu stability diagram closest to the origin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "first stability region" .

goldbook:12414 a skos:Concept ;
    skos:definition "Spectrum obtained when data are acquired that determine the m/z values of product ions produced by the reaction of a selected precursor ion with a user-specified m/z value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed precursor ion spectrum" .

goldbook:12415 a skos:Concept ;
    skos:altLabel "flow injection analysis mass spectrometry" ;
    skos:definition "Method of flow injection analysis in which an aliquot of sample is injected, without chromatographic separation, into a liquid carrier stream for on-line mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow injection mass spectrometry" .

goldbook:12416 a skos:Concept ;
    skos:definition "Detector for m/z spatially dispersed ion beams in which all ions simultaneously impinge on the detector plane to produce spatially defined signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "focal plane detector" .

goldbook:12417 a skos:Concept ;
    skos:altLabel "normal geometry" ;
    skos:definition "Double-focusing mass spectrometer configuration in which the ion beam traverses the electric sector before the magnetic sector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forward geometry" .

goldbook:12418 a skos:Concept ;
    skos:definition "Procedure of comparing a mass spectrum of an unknown compound with a mass spectral library so that the unknown spectrum is compared in turn with the library spectra, considering only the m/z peaks that have intensities greater than a specific threshold in the unknown." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forward library search" .

goldbook:12419 a skos:Concept ;
    skos:definition "Mass spectrometry technique in which m/z values are represented by frequencies of ion motion and mass spectra are generated by Fourier transform mathematical operations from time domain transients produced by image current detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fourier-transform mass spectrometry" .

goldbook:12420 a skos:Concept ;
    skos:definition "Electric or magnetic field that extends from the edge of an electric sector, magnetic sector, lens, or other ion optics element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fringe field" .

goldbook:12421 a skos:Concept ;
    skos:altLabel "GC-MS",
        "gas chromatography/mass spectrometry (GC/MS)" ;
    skos:definition "Technique by which a mixture is separated into individual components by gas chromatography, followed by detection with a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas chromatography-mass spectrometry" .

goldbook:12422 a skos:Concept ;
    skos:definition "Formation of ions from gaseous atoms or molecules or from the vapor of a solid sample at the cathode by applying a potential difference between two electrodes immersed in a low-pressure inert gas environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glow discharge ionization" .

goldbook:12423 a skos:Concept ;
    skos:definition "Reflectron design in which the decelerating/accelerating field is produced without the use of wire-mesh grids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gridless reflectron" .

goldbook:12424 a skos:Concept ;
    skos:definition "Formation of gas-phase ions accompanied by extensive fragmentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard ionization" .

goldbook:12425 a skos:Concept ;
    skos:altLabel "FAIMS",
        "RF-DC ion mobility spectrometry" ;
    skos:definition "Separation of ions at atmospheric pressure between two electrodes due to simultaneous application of a high potential asymmetric waveform, whereby ions migrate towards one of the two electrodes depending on the ratio of the high- to low-field mobility of the ion. A variable compensating DC potential is used to selectively transmit ions of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-field asymmetric waveform ion mobility spectrometry" .

goldbook:12426 a skos:Concept ;
    skos:definition "Mass spectrometer that combines m/z analyzers of different types to perform tandem mass spectrometry or higher-order \\({\\rm{MS}}^{n}\\) experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid mass spectrometer" .

goldbook:12427 a skos:Concept ;
    skos:altLabel "HDX" ;
    skos:definition "Exchange of hydrogen atoms with deuterium atoms in a chemical species in solution prior to introduction into a mass spectrometer, or by ion/molecule reaction with a neutral gas inside a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogen/deuterium exchange" .

goldbook:12428 a skos:Concept ;
    skos:definition "Sigmatropic reactions of ions in which the \\(\\ce{\\upsigma\\mbox{-}bonds}\\) broken and formed involve hydrogen atoms, and are subject to the Woodward–Hofmann rules resulting from orbital symmetry considerations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogen shifts" .

goldbook:12429 a skos:Concept ;
    skos:definition "Analytical technique in which mass spectrometry is interfaced with a pretreatment step, most often chromatographic separation but many other combinations are possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyphenated mass spectrometry technique" .

goldbook:12430 a skos:Concept ;
    skos:definition "Method of ion detection by measuring the current that results from the image charge induced by a coherent motion of ions passing near a conductor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image current detection" .

goldbook:12431 a skos:Concept ;
    skos:definition "Procedure used to form chemically selective images of an object based on the mass spectrometric detection of ions desorbed from its surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imaging mass spectrometry" .

goldbook:12432 a skos:Concept ;
    skos:altLabel "alkylideneaminylium ion" ;
    skos:definition "Cation with the structure \\(\\ce{R2C=N^{+}R2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iminium ion" .

goldbook:12433 a skos:Concept ;
    skos:altLabel "IRMPD" ;
    skos:definition "Dissociation of a reactant ion as a result of the absorption of multiple infrared photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infrared multiphoton dissociation" .

goldbook:12434 a skos:Concept ;
    skos:altLabel "in-source collisionally activated dissociation" ;
    skos:definition "Dissociation of an ion as a result of collisional excitation during ion transfer from an atmospheric pressure ion source to the vacuum chamber of the mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-source collision-induced dissociation" .

goldbook:12435 a skos:Concept ;
    skos:definition "Fragment ion of a peptide ion precursor formed by a double backbone cleavage that contains neither the original \\(\\ce{C}\\)- or \\(\\ce{N}\\)-terminal residues. Typically a combination of b- and y-type cleavages or occasionally an a- and y-type combination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal fragment" .

goldbook:12436 a skos:Concept ;
    skos:definition "Removal of solvent molecules clustered around a gas-phase ion by means of heating and/or collisions with gas molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion desolvation" .

goldbook:12437 a skos:Concept ;
    skos:altLabel "ionization enhancement" ;
    skos:definition "Phenomenon in which the ionization efficiency of a compound is increased by the presence of another compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion enhancement" .

goldbook:12438 a skos:Concept ;
    skos:definition "Mechanism for production of gas-phase ions from highly charged fine liquid droplets as in electrospray ionization that involves direct ejection of the ions from the droplet surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion evaporation model" .

goldbook:12439 a skos:Concept ;
    skos:definition "Series of stacked ring electrodes with progressively decreasing inner diameter to which a combined radio frequency and fixed potential is applied. The resulting field focuses ions travelling along the central axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion funnel" .

goldbook:12440 a skos:Concept ;
    skos:definition "Set of plates or grid of wires in an ion mobility spectrometer, time-of-flight mass spectrometer, or other mass spectrometer that is used to apply a pulsed electric field with the purpose of selectively deflecting charged particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion gate" .

goldbook:12441 a skos:Concept ;
    skos:altLabel "ion-ion reaction" ;
    skos:definition "Reaction between two ions, generally of opposite polarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion/ion reaction" .

goldbook:12442 a skos:Concept ;
    skos:altLabel "IMS" ;
    skos:definition "Separation of ions according to their velocity through a buffer gas under the influence of an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion mobility spectrometry" .

goldbook:12443 a skos:Concept ;
    skos:definition "Weakly bound species formed from an ion and neutral." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion/neutral complex" .

goldbook:12444 a skos:Concept ;
    skos:definition "Devices designed to control the formation, focusing, and deflection of charged particle beams in a vacuum under the influence of electric and magnetic fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion optics" .

goldbook:12445 a skos:Concept ;
    skos:altLabel "ionization suppression" ;
    skos:definition "Phenomenon in which the ionization efficiency of a species is lowered by the presence of a different species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion suppression" .

goldbook:12446 a skos:Concept ;
    skos:definition "Detector in which ions strike a conversion dynode to produce electrons that in turn strike a phosphor and the resulting photons are detected by a photomultiplier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-to-photon detector" .

goldbook:12447 a skos:Concept ;
    skos:altLabel "IT" ;
    skos:definition "Device for spatially confining ions using electric and magnetic fields alone or in combination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion trap" .

goldbook:12448 a skos:Concept ;
    skos:altLabel "iTRAQ" ;
    skos:definition "Chemical labeling reagents used for relative or absolute quantitation in proteomics, based on covalent labeling of the \\(\\ce{N}\\)-terminus and side-chain amines of peptides from protein digestions with tags of varying mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isobaric tag for relative and absolute quantitation" .

goldbook:12449 a skos:Concept ;
    skos:definition "Group of peaks representing ions of the same elemental composition, but different isotopic compositions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope cluster" .

goldbook:12450 a skos:Concept ;
    skos:altLabel "ICAT" ;
    skos:definition "Chemical labeling reagents used for relative quantitation in proteomics, consisting of a reactive group capable of labeling a defined amino acid side-chain, an isotopically coded linker, and a tag for the affinity isolation of labeled proteins and peptides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope coded affinity tag" .

goldbook:12451 a skos:Concept ;
    skos:altLabel "IDMS" ;
    skos:definition "Quantitative mass spectrometry technique in which an isotopically enriched compound is used as a surrogate internal standard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope dilution mass spectrometry" .

goldbook:12452 a skos:Concept ;
    skos:altLabel "isotope–number ratio" ;
    skos:definition "Ratio of the number of atoms of one isotope to the number of atoms of another isotope of the same chemical element in the same system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope ratio" .

goldbook:12453 a skos:Concept ;
    skos:altLabel "IRMS",
        "stable isotope mass spectrometry" ;
    skos:definition "Measurement and study of the relative abundances of the different isotopes of an element in a material using a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope ratio mass spectrometry" .

goldbook:12454 a skos:Concept ;
    skos:altLabel "isotopic homolog ions" ;
    skos:definition "Ions that differ only in the isotopic composition of one or more of the constituent atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopolog ions" .

goldbook:12455 a skos:Concept ;
    skos:definition "Isomeric ions having the same numbers of each isotopic atom but differing in their positions within the ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopomeric ion" .

goldbook:12456 a skos:Concept ;
    skos:definition "Gas chromatograph-to-mass spectrometer interface where the gas chromatography effluent expands into a lower-pressure region and then through a downstream orifice. The low mass carrier gas molecules diffuse from the jet axis, leaving the sample stream enriched in the heavier analyte molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "jet separator" .

goldbook:12457 a skos:Concept ;
    skos:altLabel "KER" ;
    skos:definition "Translational energy of fragments resulting from dissociation of a metastable ion measured relative to the center-of-mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic energy release" .

goldbook:12458 a skos:Concept ;
    skos:altLabel "KERD" ;
    skos:definition "Distribution of values of translational energies in the center-of-mass reference for an ensemble of metastable ions undergoing a specific dissociation reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic energy release distribution" .

goldbook:12459 a skos:Concept ;
    skos:definition "Excess energy above the thermochemical threshold required to observe dissociation of a precursor ion within the timeframe of a particular mass spectrometry experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic shift" .

goldbook:12460 a skos:Concept ;
    skos:definition "Ion trapping device that consists of an outer barrel-like electrode and a coaxial inner spindle-like electrode that form an electrostatic field with a quadro-logarithmic potential distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kingdon trap" .

goldbook:12461 a skos:Concept ;
    skos:definition "Method for determining the concentration of proteins through a combination of protein digestion and liquid chromatography-mass spectrometry (LC-MS) without relying on stable isotope labeling. Protein quantification is achieved by measuring the signal intensity of peptide ions corresponding to a protein or by counting and comparing the number of fragment mass spectra identifying peptides of a given protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "label-free quantitation" .

goldbook:12462 a skos:Concept ;
    skos:altLabel "LD" ;
    skos:definition "Formation of gas-phase species from a solid or liquid sample surface upon activation using a short pulse of photons from a laser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser desorption" .

goldbook:12463 a skos:Concept ;
    skos:altLabel "LDI" ;
    skos:definition "Formation of gas-phase ions by the interaction of a laser with a solid or liquid material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser desorption ionization" .

goldbook:12464 a skos:Concept ;
    skos:altLabel "LMMS" ;
    skos:definition "Laser desorption ionization mass spectrometry, particularly emphasizing spatially resolved composition information." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser microprobe mass spectrometry" .

goldbook:12465 a skos:Concept ;
    skos:altLabel "LIT" ;
    skos:definition "Two-dimensional Paul ion trap in which ions are confined in the axial dimension by means of a static electric potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear ion trap" .

goldbook:12466 a skos:Concept ;
    skos:altLabel "LC-MS",
        "liquid chromatography/mass spectrometry (LC/MS)" ;
    skos:definition "Technique by which a mixture of analytes is separated into individual components by liquid chromatography (typically high-performance liquid chromatography), followed by detection with a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid chromatography-mass spectrometry" .

goldbook:12467 a skos:Concept ;
    skos:definition "Spray ionization interface in which droplets are dispersed from a pneumatic nebulizer toward a high potential electrode that produces a static charge on the droplets leading to ion formation after solvent evaporation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid ion evaporation" .

goldbook:12468 a skos:Concept ;
    skos:definition "Means of coupling capillary electrophoresis to a mass spectrometer in which a liquid reservoir surrounds the separation capillary and transfer capillary to the mass spectrometer and provides electric contact for the capillary electrophoresis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid junction interface" .

goldbook:12469 a skos:Concept ;
    skos:altLabel "LSI" ;
    skos:definition "Ionization of any species by the interaction of a focused beam of ions or atoms with a sample that is dissolved in a solvent matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid secondary ionization" .

goldbook:12470 a skos:Concept ;
    skos:definition "Flow of make-up liquid in a sheath flow interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid sheath" .

goldbook:12471 a skos:Concept ;
    skos:definition "Mass of an ion of known m/z value, derived from a suitable standard compound introduced into an ion source together with the sample to be analyzed, which permits real-time recalibration by correction of m/z shifts arising from instrumental drift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lock mass" .

goldbook:12472 a skos:Concept ;
    skos:definition "Collision-induced dissociation process wherein the precursor ion has laboratory-frame translational energy lower than a given value, often taken to be \\(\\pu{1 keV}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-energy collision-induced dissociation" .

goldbook:12473 a skos:Concept ;
    skos:definition "Device that produces a magnetic field perpendicular to a charged particle beam that deflects the beam to an extent that is proportional to the ratio of particle momentum and charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic sector" .

goldbook:12474 a skos:Concept ;
    skos:definition "Slow rotation of the center of cyclotron motion around the central axis of a Penning ion trap that results from a drift of the cyclotron centre along the electric equipotential lines perpendicular to the magnetic field direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetron motion" .

goldbook:12475 a skos:Concept ;
    skos:definition "Solvent that is mixed with the sample flow in a liquid introduction mass spectrometry interface in order to adjust the flow rate or solvent characteristics of the system, for example, to promote ionization efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "make-up liquid" .

goldbook:12476 a skos:Concept ;
    skos:altLabel "MIKES" ;
    skos:definition "Procedure by which translational energy spectra are obtained from a sector mass spectrometer that incorporates at least one magnetic sector plus one electric sector in reverse geometry (a magnetic sector followed by an electric sector)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-analyzed ion kinetic energy spectrometry" .

goldbook:12477 a skos:Concept ;
    skos:definition "Means of determining m/z values of ions from experimentally detected signals using a theoretical or empirical relational equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass calibration" .

goldbook:12478 a skos:Concept ;
    skos:definition "Difference between the nominal mass and the monoisotopic mass of an atom, molecule, or ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass defect" .

goldbook:12479 a skos:Concept ;
    skos:definition "Differences in overall detection sensitivities for ions of different m/z values in a mass spectrum, caused by variations in ionization efficiency, transmission efficiency through the interface between the ion source and the analyzer vacuum system, analyzer, and detector response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass discrimination" .

goldbook:12480 a skos:Concept ;
    skos:definition "Ion gate used to transmit ions in a given m/z range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass gate" .

goldbook:12481 a skos:Concept ;
    skos:definition "Value of m/z above or below which ions cannot be detected in a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass limit" .

goldbook:12482 a skos:Concept ;
    skos:definition "Use of mass selective instability to eject ions of selected m/z values from an ion trap along the trap axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass selective axial ejection" .

goldbook:12483 a skos:Concept ;
    skos:altLabel "MSI" ;
    skos:definition "Unstable trajectories in an ion trap for ions within a particular range of m/z values caused by an appropriate combination of oscillating electric fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass selective instability" .

goldbook:12484 a skos:Concept ;
    skos:definition "Collection of mass spectra of different compounds, usually represented as arrays of signal intensity vs. the m/z values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectral library" .

goldbook:12485 a skos:Concept ;
    skos:altLabel "MS/MS",
        "tandem mass spectrometry" ;
    skos:definition "Acquisition and study of the spectra of the product ions or precursor ions of m/z selected ions, or of precursor ions of a selected neutral mass loss." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrometry/mass spectrometry" .

goldbook:12486 a skos:Concept ;
    skos:altLabel "stability diagram" ;
    skos:definition "Graphical representation expressed in terms of dimensionless reduced coordinates that describes the stability or instability of charged particle motion in a transmission quadrupole mass spectrometer or Paul ion trap, based on an appropriate form of the Mathieu differential equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mathieu stability diagram" .

goldbook:12487 a skos:Concept ;
    skos:altLabel "MIMS",
        "membrane inlet mass spectrometry",
        "membrane interface mass spectrometry" ;
    skos:definition "Mass spectrometry measurement that uses a semi-permeable membrane separator that permits the passage of analytes directly from solutions or ambient air to the mass spectrometer ion source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane introduction mass spectrometry" .

goldbook:12488 a skos:Concept ;
    skos:definition "GC-MS interface with a polymer membrane that selectively passes analyte molecules in preference to the carrier gas thereby enriching the analyte in the gas stream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane separator" .

goldbook:12489 a skos:Concept ;
    skos:altLabel "MCP",
        "channel electron multiplier array" ;
    skos:definition "Thin plate that contains a closely spaced array of channels each of which acts as a continuous dynode particle multiplier. A fast charged or neutral particle, or a photon, that strikes the plate causes a cascade of secondary electrons that ultimately exits the opposite side of the plate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microchannel plate" .

goldbook:12490 a skos:Concept ;
    skos:definition "Electrospray ionization at a low solvent flow rate, typically several microliters per minute (\\(\\pu{\\upmu L min-1}\\)) or lower, where a pump is used to provide the sample flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microelectrospray" .

goldbook:12491 a skos:Concept ;
    skos:definition "Mass spectrometry measurement in which the sample is introduced into the ion source of the mass spectrometer as a collimated beam of molecules with a narrow velocity distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular beam mass spectrometry" .

goldbook:12492 a skos:Concept ;
    skos:definition "GC-MS interface that subjects the GC effluent to effusive flow through a porous glass tube. The lighter carrier gas passes out of the tube, leaving the gas within the tube enriched in analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular effusion separator" .

goldbook:12493 a skos:Concept ;
    skos:definition "Mass spectrometer interface to inlets including chromatography and spray-based ion sources that enriches the sample by selecting the central part of the effluent or spray using an orifice or skimmer. Particles with a higher forward momentum diverge less from the spray axis for a given radial momentum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "momentum separator" .

goldbook:12494 a skos:Concept ;
    skos:altLabel "MAGIC" ;
    skos:definition "Particle beam interface that incorporates a monodisperse aerosol generator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monodisperse aerosol generating interface for chromatography" .

goldbook:12495 a skos:Concept ;
    skos:definition "Exact mass of an ion or molecule calculated using the mass of the most abundant isotope of each element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monoisotopic mass" .

goldbook:12496 a skos:Concept ;
    skos:definition "Liquid sample mass spectrometer interface that uses two or more pulleys and a continuous loop of material. Samples are sprayed or deposited from solution onto the belt where they are transported into the vacuum system for vaporization or desorption and ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moving belt interface" .

goldbook:12497 a skos:Concept ;
    skos:definition "Mass spectrum obtained using tandem mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "MS/MS spectrum" .

goldbook:12498 a skos:Concept ;
    skos:definition "Symbol for multiple-stage mass spectrometry experiments designed to record product ion spectra where \\(n\\) is the number of product ion stages (nth-generation product ions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "MS<sup><i>n</i></sup>" .

goldbook:12499 a skos:Concept ;
    skos:definition "Mass spectrograph based on a double-focusing magnetic analyzer that spatially disperses ions of different m/z values on to an array of Faraday cup detectors, generally used with inductively coupled plasma ion sources for isotopic composition measurements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicollector mass spectrometer" .

goldbook:12500 a skos:Concept ;
    skos:altLabel "MRM" ;
    skos:definition "Application of selected reaction monitoring to multiple product ions from one or more precursor ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple reaction monitoring" .

goldbook:12501 a skos:Concept ;
    skos:definition "Multiple stages of precursor ion m/z selection followed by product ion detection for successive nth-generation product ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple-stage mass spectrometry" .

goldbook:12502 a skos:Concept ;
    skos:definition "Electrospray ionization at a very low solvent flow rate, typically hundreds of nanoliters per minute of sample solution or lower, often without the use of an external solvent delivery system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoelectrospray" .

goldbook:12503 a skos:Concept ;
    skos:altLabel "NICI" ;
    skos:definition "Chemical ionization that results in the formation of negative ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative ion chemical ionization" .

goldbook:12504 a skos:Concept ;
    skos:altLabel "NRMS" ;
    skos:definition "Procedure by which neutral species are formed from m/z selected ions by charge transfer to a collision gas or by dissociation. The neutral species are separated from the remaining ions and ionized through collisions with a second gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutralization-reionization mass spectrometry" .

goldbook:12505 a skos:Concept ;
    skos:definition "Loss of an uncharged species from an ion during dissociation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutral loss" .

goldbook:12506 a skos:Concept ;
    skos:definition "Scan used to generate a constant neutral loss spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutral loss scan" .

goldbook:12507 a skos:Concept ;
    skos:definition "Rule stating that a neutral organic molecule containing one or more atoms of the elements \\(\\ce{C}\\), \\(\\ce{H}\\), \\(\\ce{O}\\), \\(\\ce{N}\\), \\(\\ce{S}\\), \\(\\ce{P}\\), or any halogen has an odd nominal mass if it contains an odd number of nitrogen atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrogen rule" .

goldbook:12508 a skos:Concept ;
    skos:altLabel "in-source collision-induced dissociation" ;
    skos:definition "Collisionally activated dissociation that is caused by collisions in the region between the nozzle and skimmer of an atmospheric pressure ionization source such as electrospray or atmospheric pressure chemical ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nozzle-skimmer dissociation" .

goldbook:12509 a skos:Concept ;
    skos:altLabel "needle voltage" ;
    skos:definition "Electric potential difference applied between the electrospray needle and the skimmer, which is typically held at the same potential as the counter electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nozzle-skimmer voltage" .

goldbook:12510 a skos:Concept ;
    skos:definition "Serial product ions from dissociation or bimolecular reaction of selected precursor ions where \\(n\\) refers to the number of stages of dissociation or bimolecular reaction in a series of consecutive reactions that involve successive product ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>n</i><sup>th</sup>-generation product ion" .

goldbook:12511 a skos:Concept ;
    skos:definition "Mass spectrum recorded from any mass spectrometer in which the appropriate scan function can be set to record the appropriate generation product ion or ions of m/z selected precursor ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>n</i><sup>th</sup>-generation product ion spectrum" .

goldbook:12512 a skos:Concept ;
    skos:definition "Configuration for electrospray ionization in which the axis of the spray is at a right angle to the axis of the sampling cone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orthogonal electrospray" .

goldbook:12513 a skos:Concept ;
    skos:altLabel "orthogonal acceleration" ;
    skos:definition "Pulsed acceleration of ions perpendicular to their original direction of travel into a mass spectrometer, typically time-of-flight." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orthogonal extraction" .

goldbook:12514 a skos:Concept ;
    skos:definition "Partial random mixing of isotopes among specified atom positions in an ion or neutral species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial isotopic scrambling" .

goldbook:12515 a skos:Concept ;
    skos:definition "Method for coupling liquid chromatography to mass spectrometry in which the effluent is passed through a heated capillary to form an expanding jet of vapour and aerosol particles. After passing through a skimmer that acts as a momentum separator, the beam impinges on a heated surface to form ions through chemical ionization at the surface or ionization of the resulting vapour in a chemical ionization or electron ionization source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle beam interface" .

goldbook:12516 a skos:Concept ;
    skos:altLabel "quadrupole ion storage trap",
        "quadrupole ion trap" ;
    skos:definition "Ion trapping device that depends on the application of radio frequency potentials between a ring electrode and two end-cap electrodes to confine the ion motion to a cyclic path described by an appropriate form of the Mathieu equation. The choice of these potentials determines the m/z value below which ions are not trapped." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Paul ion trap" .

goldbook:12517 a skos:Concept ;
    skos:definition "Procedure for measuring the accurate mass of an ion using scanning mass spectrometers, in which the peak corresponding to the unknown ion and that for a reference ion of known m/z are displayed alternately and caused to overlap by adjusting appropriate electric fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak matching" .

goldbook:12518 a skos:Concept ;
    skos:definition "Method used to extend the amount of time available for mass spectrometric analysis of the components in a narrow chromatographic peak. The eluent flow rate is reduced to an ultra-low level at the leading edge of the peak and held at this low flow rate for the duration of compound elution, thus enabling collection of sufficient data for reliable statistical analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak parking" .

goldbook:12519 a skos:Concept ;
    skos:definition "Data analysis technique used in elemental mass spectrometry to correct the intensity of an unresolved multiplet peak monitored for a specific element for contributions from a multi-isotopic contaminant. The correction is calculated from the measured intensity of a different isotopic peak of the contaminant and the known natural isotopic abundance ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak stripping" .

goldbook:12520 a skos:Concept ;
    skos:definition "Ionization via electron removal that occurs through the energy transfer from a neutral species \\(\\ce{N}\\) internally excited to a metastable state (such as a high Rydberg state) to a neutral species \\(\\ce{M}\\) with lower ionization energy, as represented by the following reaction: \\(\\ce{N^{\\ast} + M -> N + M^{+.} + \\textit{e}^{-}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Penning ionization" .

goldbook:12521 a skos:Concept ;
    skos:definition "Ion trapping device using a static magnetic field and a static electric potential well. The magnetic field confines the ion motion to circular orbits around the magnetic force line direction, which aligns with the direction of the trap axis, whereas the electric potential well confines the ion motion axially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Penning ion trap" .

goldbook:12522 a skos:Concept ;
    skos:altLabel "PMF",
        "mass mapping" ;
    skos:definition "Method for protein analysis where an unknown protein is chemically or enzymatically cleaved into peptide fragments whose masses are determined by mass spectrometry. The peptide masses are compared to peptide masses calculated for known proteins in a database and analyzed statistically to determine the best match." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide mass fingerprinting" .

goldbook:12523 a skos:Concept ;
    skos:definition "Sequence of peptide ion fragment masses that can be used to aid in the identification of the amino acid sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide sequence tag" .

goldbook:12524 a skos:Concept ;
    skos:definition "Process wherein the reactant ion or molecule is dissociated as a result of absorption of one or more photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodissociation" .

goldbook:12525 a skos:Concept ;
    skos:definition "Recording of ion currents by allowing them to strike a photographic plate, which is subsequently developed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photographic plate recording" .

goldbook:12526 a skos:Concept ;
    skos:altLabel "180º/<em>n</em> magnetic sector" ;
    skos:definition "Arrangement in which an ion beam is deflected magnetically through \\(\\pi/n\\ \\rm{rad}\\), where \\(n \\gt 1\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "$\\boldsymbol{\\pi}$/n rad magnetic sector" .

goldbook:12527 a skos:Concept ;
    skos:definition "Electrospray ionization in which the nebulization of the liquid stream is assisted by a concentric stream of gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pneumatically assisted electrospray ionization" .

goldbook:12528 a skos:Concept ;
    skos:definition "Detector in which the ion beam is focused onto a small area, for example, defined by a collector slit, rather than dispersed by m/z spatially across a focal plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "point detector" .

goldbook:12529 a skos:Concept ;
    skos:altLabel "PAD" ;
    skos:definition "Detector in which a high potential is applied after m/z separation to accelerate the ions and produce an improved signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-acceleration detector" .

goldbook:12530 a skos:Concept ;
    skos:altLabel "PSD" ;
    skos:definition "Technique specific to reflectron time-of-flight mass spectrometers where product ions of metastable transitions or collision-induced dissociations generated in the flight tube prior to entering the reflectron are separated according to m/z to yield product ion spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-source decay" .

goldbook:12531 a skos:Concept ;
    skos:definition "Mass spectrum in which the appropriate m/z separation function records the precursor ions of selected product ions or specified neutral loss." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precursor ion spectrum" .

goldbook:12532 a skos:Concept ;
    skos:definition "Electronic state capable of undergoing autoionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-ionization state" .

goldbook:12533 a skos:Concept ;
    skos:definition "Automated system for computer examination of the mass spectrum of an unknown mixture for the presence of a specific compound for which a standard spectrum is available in a library. The probability that the compound is present is given by a confidence index \\(K\\) such that \\(2^{K}\\) is the average number of randomly selected compounds whose mass spectra would have to be examined to find data which match the target spectrum to the same degree as does the unknown." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "probability-based matching" .

goldbook:12534 a skos:Concept ;
    skos:definition "Process whereby a precursor ion of a particular m/z is selected by m/z, fragmentation is induced, and the mass spectrum of the resulting product ions is recorded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product ion analysis" .

goldbook:12535 a skos:Concept ;
    skos:definition "Mass spectrum in which the appropriate m/z separation analysis function is set to record the product ions of a selected precursor ion selected by m/z." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product ion spectrum" .

goldbook:12536 a skos:Concept ;
    skos:definition "Method for acquiring a mass spectrum where each peak is displayed as a curve, with the data points defining the curve corresponding to the signal intensities at each particular m/z value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "profile mode" .

goldbook:12537 a skos:Concept ;
    skos:definition "Dimeric ion consisting of two similar or dissimilar molecules bound together by hydrogen bonding with a shared proton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton-bound dimer" .

goldbook:12538 a skos:Concept ;
    skos:altLabel "PYMS" ;
    skos:definition "Mass spectrometry technique in which the sample is heated to the point of decomposition and the gas-phase decomposition products are characterized by mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrolysis mass spectrometry" .

goldbook:12539 a skos:Concept ;
    skos:definition "Reflectron in which the electric field varies with the square of the distance from the entrance and compensates for kinetic energy spread to all orders." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadratic field reflectron" .

goldbook:12540 a skos:Concept ;
    skos:definition "Technique for axialization in Fourier transform-ion cyclotron resonance-mass spectrometers in which magnetron motion is converted into cyclotron motion by subjecting the trapped ions to a quadrupolar excitation field while they undergo collisions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupolar axialization" .

goldbook:12541 a skos:Concept ;
    skos:altLabel "QTOF" ;
    skos:definition "Hybrid mass spectrometer consisting of a transmission quadrupole mass spectrometer coupled to an orthogonal acceleration time-of-flight mass spectrometer. A collision quadrupole is typically inserted between the two mass spectrometers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupole time-of-flight" .

goldbook:12542 a skos:Concept ;
    skos:altLabel "QCAT" ;
    skos:definition "Method for absolute quantitation of a protein or proteins in a multiplexed fashion using isotope-labeled peptides as surrogate internal standards. The labeled peptides are produced by synthesizing a gene coding for all desired peptides, expressing this gene in E. coli culture containing appropriately labeled substrate, and digesting with trypsin the expressed protein composed of the desired concatenated peptides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitation by concatenated tryptic peptides" .

goldbook:12543 a skos:Concept ;
    skos:altLabel "QET" ;
    skos:definition "Statistical theory of unimolecular reaction rates (isomerization or fragmentation) of molecular species that assumes that reaction occurs from the ground electronic state of the reactant regardless of its mode of formation, at a rate determined by the free statistical redistribution of internal energy into those vibrational and rotational modes that must be activated sufficiently to reach the appropriate transition state for the specified reaction to occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-equilibrium theory" .

goldbook:12544 a skos:Concept ;
    skos:definition "Ejection of an ion from an ion trap in a direction perpendicular to the longitudinal axis of the trap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radial ejection" .

goldbook:12545 a skos:Concept ;
    skos:definition "Limiting droplet size at which self-fragmentation will occur for charged droplets generated in electrospray or other ionization processes. Self-fragmentation occurs when the electrostatic repulsion force generated by the excess charge exceeds the surface tension that maintains the integrity of the droplet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rayleigh limit" .

goldbook:12546 a skos:Concept ;
    skos:definition "Gas that reacts with ions to produce product ions through ion/molecule reactions; for example, a gas such as methane, ammonia, or isobutane used in chemical ionization to create reagent ions or a gas used in ion traps or collision cells to perform gas-phase ion/molecule reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reagent gas" .

goldbook:12547 a skos:Concept ;
    skos:definition "Ion that reacts with a neutral to produce an ionized form of such species through an ion/molecule reaction, for example, as in chemical ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reagent ion" .

goldbook:12548 a skos:Concept ;
    skos:definition "Energy released when an electron is added to an ionized molecule or atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombination energy" .

goldbook:12549 a skos:Concept ;
    skos:definition "Quadrupole ion trap whose electrodes form a rectilinear polygon, the simplest form of which consists of two pairs of rectangular electrodes supplied with radio frequency (RF) potentials and a pair of electrodes to which a DC potential is applied. Slits or apertures in the electrodes allow injection and ejection of charged particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rectilinear ion trap" .

goldbook:12550 a skos:Concept ;
    skos:definition "Stable ion whose structure or elemental formula is known with certainty. These ions are formed by direct ionization of a molecule of known structure or elemental formula, and are used to verify by comparison the structure or thermochemistry of an unknown ion or to calibrate the m/z scale of the mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference ion" .

goldbook:12551 a skos:Concept ;
    skos:altLabel "delta notation",
        "isotope delta",
        "relative difference of isotope ratios" ;
    skos:definition "Measure of an isotope ratio in a sample of interest relative to a reference defined by the relation \\[\\delta = (R_{\\rm{sample}} - R_{\\rm{standard}})/R_{\\rm{standard}}\\] where \\(R\\) is the isotope ratio of the element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative isotope-ratio difference" .

goldbook:12552 a skos:Concept ;
    skos:altLabel "RGA" ;
    skos:definition "Mass spectrometer used to measure the composition and pressure of gases in an evacuated chamber and to test for leaks in pressurized systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual gas analyser" .

goldbook:12553 a skos:Concept ;
    skos:definition "Value of \\((m/z)/\\Delta(m/z)\\) measured for two peaks of equal height in a mass spectrum at m/z and \\(m/z \\pm \\Delta(m/z)\\) that are separated by a valley which at its lowest point is \\(\\pu{10\\%}\\) of the height of either peak. For peaks of similar height separated by a valley, let the height of the valley at its lowest point be \\(\\pu{10\\%}\\) of the lower peak. Then the resolution (\\(\\pu{10\\%}\\) valley definition) is \\((m/z)/\\Delta(m/z)\\) and should be given for a number of values of m/z." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution: 10 per cent valley definition" .

goldbook:12554 a skos:Concept ;
    skos:definition "For a single peak corresponding to singly charged ions at mass \\(m\\) in a mass spectrum, the resolution may be expressed as \\((m/z)/\\Delta(m/z)\\), where \\(\\Delta(m/z)\\) is the width of the peak at a height which is a specified fraction of the maximum peak height. It is recommended that one of three values 50, 5, or \\(\\pu{0.5\\%}\\) should always be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution: peak width definition" .

goldbook:12555 a skos:Concept ;
    skos:altLabel "REMPI",
        "resonance ionization" ;
    skos:definition "Multiphoton ionization in which the ionization cross section is significantly enhanced because the energy of the incident photons is resonant with an intermediate excited state of the neutral." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance-enhanced multiphoton ionization" .

goldbook:12556 a skos:Concept ;
    skos:definition "Mode of ion ejection in an ion trap that relies on an auxiliary radio frequency potential that is applied to the end-cap or trapping electrodes. The potential is tuned to the classical oscillation frequency of a particular ion to eject it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance ion ejection" .

goldbook:12557 a skos:Concept ;
    skos:definition "Ion fragmentation mechanism in which the molecular ion \\(\\ce{M^{+.}}\\) of a cyclic alkene fragments to form a neutral diene and an alkene radical cation or a diene radical cation and an alkene. The reaction is the reverse of the Diels–Alder reaction of organic synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retro Diels–Alder reaction" .

goldbook:12558 a skos:Concept ;
    skos:definition "Double-focusing mass spectrometer configuration in which the ion beam traverses the magnetic sector prior to the electric sector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse geometry" .

goldbook:12559 a skos:Concept ;
    skos:definition "Process of comparing a subset of the peaks in the mass spectrum of an unknown compound with peaks present in the library mass spectrum. Any peaks in the mass spectrum of the unknown compound that are not in the library spectrum are disregarded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse library search" .

goldbook:12560 a skos:Concept ;
    skos:definition "Transmission quadrupole device in which a sinusoidal radio frequency (RF) potential is applied between the connected pairs of opposite rod electrodes in a linear quadrupole, providing a transmission device for all ions with m/z values above a cut-off value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "RF-only quadrupole" .

goldbook:12561 a skos:Concept ;
    skos:definition "Conventional measure of the degree of unsaturation of an organic molecule given by \\(X - Y/2 + Z/2 + 1\\) where \\(X\\) is the number of carbon atoms, \\(Y\\) is the number of hydrogen or halogen atoms and \\(Z\\) is the number of nitrogen and phosphorus atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring and double bond equivalent" .

goldbook:12562 a skos:Concept ;
    skos:definition "Compact ion and fast atom sources for use when small size and high beam intensity are required, as in fast atom bombardment mass spectrometry. The discharge is produced by electrons oscillating between two cold cathodes in an electric field that possesses a single saddle point. To produce and intensify the plasma the electrons must have long path lengths, achieved by allowing the electrons to have an oscillatory motion in the saddle-shaped electric field between the cathodes separated by the anode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saddle field gun" .

goldbook:12563 a skos:Concept ;
    skos:definition "Component of a spray ionization interface that consists of a cone with a small orifice through which the spray passes into a differentially pumped chamber" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling cone" .

goldbook:12564 a skos:Concept ;
    skos:definition "Time required to obtain a mass spectrum (or other mass spectrometric data quantity) such as in a separation coupled to mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scan cycle time" .

goldbook:12565 a skos:Concept ;
    skos:altLabel "SNMS" ;
    skos:definition "Mass spectrometry technique in which neutral species ejected from a sample surface as a result of bombardment by a primary beam of atoms or ions are ionized, most often by photoionization, prior to analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary neutral mass spectrometry" .

goldbook:12566 a skos:Concept ;
    skos:definition "Mass spectrometer consisting of one or more magnetic sectors for recording a mass spectrum of a monoenergetic beam of ions. Such instruments may also have one or more electric sectors for energy dispersion that can be arranged for velocity-focusing by compensating for dispersion by the magnetic sector if the beam is not truly monoenergetic. Such a combination provides double focusing of ions of the same m/z, i.e., focusing with respect to both direction and speed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sector mass spectrometer" .

goldbook:12567 a skos:Concept ;
    skos:altLabel "SIFT" ;
    skos:definition "Device in which m/z selected ions are entrained in an inert carrier gas and subsequently undergo ion/molecule reactions with molecules introduced into the gas flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selected ion flow tube" .

goldbook:12568 a skos:Concept ;
    skos:altLabel "SRM" ;
    skos:definition "Data acquired from one or more specific product ions corresponding to m/z selected precursor ions recorded via two or more stages of mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selected reaction monitoring" .

goldbook:12569 a skos:Concept ;
    skos:altLabel "self-CI" ;
    skos:definition "Chemical ionization of an analyte where the reagent ion is an ionized form of the analyte or one of its product ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-chemical ionization" .

goldbook:12570 a skos:Concept ;
    skos:definition "Capillary electrophoresis to electrospray ionization interface that uses a coaxial flow of make-up liquid that is introduced through a tube that is concentric with the separation capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sheath flow interface" .

goldbook:12571 a skos:Concept ;
    skos:definition "Gas introduced through a tube that is coaxial with the electrospray emitter to pneumatically assist the formation of the sprayed droplets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sheath gas" .

goldbook:12572 a skos:Concept ;
    skos:definition "Make-up liquid in a sheath flow interface" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sheath liquid" .

goldbook:12573 a skos:Concept ;
    skos:definition "Protein identification using a combination of high-performance liquid chromatography and mass spectrometry in which the proteins in a mixture are digested, usually by a specific enzyme, and the resulting peptides are separated by liquid chromatography and identified by tandem mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shotgun proteomics" .

goldbook:12574 a skos:Concept ;
    skos:definition "Cone with a central orifice that intercepts the center of a spray or jet expansion to sample the central portion of the expansion, for example, as in a momentum separator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skimmer" .

goldbook:12575 a skos:Concept ;
    skos:definition "Formation of gas-phase ions without extensive fragmentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soft ionization" .

goldbook:12576 a skos:Concept ;
    skos:altLabel "SSI" ;
    skos:definition "Process in which both anions and cations are produced at atmospheric pressure from an ionic solution due to a statistically unbalanced charge distribution in the minute droplets formed by the action of a sonic atomizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonic spray ionization" .

goldbook:12577 a skos:Concept ;
    skos:definition "Result of mutual repulsion of particles of like charge (ions, electrons, etc.) that can limit the current in a charged-particle beam and can also cause some motion of ions in a beam or packet in addition to that caused by external fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "space charge effect" .

goldbook:12578 a skos:Concept ;
    skos:definition "Deviation of the peak intensities in a mass spectrum from their expected values that occurs when the relative concentration of the various analytes change during acquisition of the mass spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral skewing" .

goldbook:12579 a skos:Concept ;
    skos:definition "General term used to describe a range of ionization techniques for analytes in solution that involve dispersing the liquid into fine droplets as a component step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spray ionization" .

goldbook:12580 a skos:Concept ;
    skos:altLabel "SILAC" ;
    skos:definition "Proteomics technique that detects differences in protein abundance between cultured cell samples using stable isotopic labeling achieved with labeled amino acids in one cell culture and unlabeled ones in a separate culture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable isotope ratio analysis of amino acids in cell culture" .

goldbook:12581 a skos:Concept ;
    skos:altLabel "SISCAPA" ;
    skos:definition "Method for absolute quantitation of a protein or proteins in a multiplexed fashion using isotope-labeled peptides as surrogate internal standards. The labeled peptides are produced by synthesizing a gene coding for each desired peptide, cell-free transcription, and translation of this gene in a medium containing \\(\\ce{^{13}C6}\\)-labeled lysine, and digesting with trypsin the expressed protein composed of the desired concatenated peptides. For low-abundance proteins the sensitivity is increased by selective enrichment of the target peptides by antibody capture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable isotope standards and capture by anti-peptide antibodies" .

goldbook:12582 a skos:Concept ;
    skos:definition "Electric or magnetic field that does not change in time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static field" .

goldbook:12583 a skos:Concept ;
    skos:definition "Rule stating that in competing fragmentations the product ion formed from its neutral species counterpart with the lower ionization energy will usually be the more abundant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stevenson’s rule" .

goldbook:12584 a skos:Concept ;
    skos:altLabel "SWIFT" ;
    skos:definition "Technique to create excitation waveforms for ions in Fourier transform-ion cyclotron resonance-mass spectrometers or Paul ion traps. An excitation waveform in the time-domain is generated by taking the inverse Fourier transform of an appropriate frequency-domain programmed excitation spectrum, in which the resonance frequencies of ions to be excited are included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stored waveform inverse fourier transform" .

goldbook:12585 a skos:Concept ;
    skos:altLabel "SFC-MS",
        "supercritical fluid chromatography/mass spectrometry (SFC/MS)" ;
    skos:definition "Combined technique in which a mixture of analytes is separated into solutions of individual components by chromatography that uses a supercritical fluid as mobile phase, followed by the ionization of the separation effluent in the ion source of a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercritical fluid chromatography-mass spectrometry" .

goldbook:12586 a skos:Concept ;
    skos:altLabel "SELDI" ;
    skos:definition "Variant of matrix-assisted laser desorption/ionization (MALDI) in which the matrix is replaced by a surface coating of a chromatographic stationary phase designed to selectively retain different subsets of proteins or peptides from a mixture depending on their physico-chemical properties or biochemical affinity characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-enhanced laser desorption/ionization" .

goldbook:12587 a skos:Concept ;
    skos:altLabel "SID" ;
    skos:definition "Fragmentation that results from the collision of an ion with a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-induced dissociation" .

goldbook:12588 a skos:Concept ;
    skos:altLabel "SIR" ;
    skos:definition "Process wherein a reactant ion interacts with a surface to produce either chemically different species or a change in the internal energy of the reactant ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-induced reaction" .

goldbook:12589 a skos:Concept ;
    skos:altLabel "internal standard" ;
    skos:definition "Compound added in accurately known amounts to a sample to be analyzed for a specified analyte. The surrogate internal standard is chemically similar to the analyte so that losses in the analytical procedure are the same for both and thus the analyte concentration can be determined relative to that of the standard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surrogate internal standard" .

goldbook:12590 a skos:Concept ;
    skos:altLabel "SORI" ;
    skos:definition "Procedure associated with Fourier transform-ion cyclotron resonance-mass spectrometers to facilitate ion/neutral reactions such as low-energy collision-induced dissociation in which a radio-frequency electric field, slightly off-resonance with respect to the cyclotron frequency of the reactant ion, cyclically accelerates and decelerates the reactant ion that is confined in the Penning ion trap. As a consequence, the orbit does not exceed the dimensions of the ion trap but maintains a high average translational energy for an extended time that activates an ion/neutral process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sustained off-resonance irradiation" .

goldbook:12591 a skos:Concept ;
    skos:definition "Tandem mass spectrometry procedure in which product ion spectra are recorded for ion beams in m/z analyzers separated in space. Specific m/z separation functions are designed so that in one section of the instrument ions are selected, dissociated in an intermediate region, and the product ions are then transmitted to another analyzer for m/z separation and data acquisition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tandem mass spectrometry in space" .

goldbook:12592 a skos:Concept ;
    skos:definition "Tandem mass spectrometry procedure in which product ion spectra are recorded in a single m/z analyzer (such as a Paul ion trap, linear ion trap, or Fourier transform-ion cyclotron resonance-mass spectrometer) in discrete steps over time. Ions in a specific m/z range are selected, dissociated, and the product ions analyzed sequentially in time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tandem mass spectrometry in time" .

goldbook:12593 a skos:Concept ;
    skos:definition "Conical shape of the liquid emanating from a capillary under high potential, as in electrospray or other electrohydrodynamic spray processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Taylor cone" .

goldbook:12594 a skos:Concept ;
    skos:definition "Spray ionization in which a liquid is flowed through a heated capillary to produce a spray of droplets and solvent vapor. Ions are formed due to the statistical imbalance of charges in the droplets or by a heated filament." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermospray ionization" .

goldbook:12595 a skos:Concept ;
    skos:altLabel "TLC-MS",
        "thin layer chromatography/mass spectrometry (TLC/MS)" ;
    skos:definition "Technique by which a mixture of analytes is separated into individual components by liquid chromatography, followed by the ionization of the separated species by an ion source of a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thin layer chromatography-mass spectrometry" .

goldbook:12596 a skos:Concept ;
    skos:altLabel "TLF" ;
    skos:definition "Energy focusing of ions formed in the gas phase in a time-of-flight mass spectrometer that is accomplished by introducing a time delay between the formation of the ions and the application of the accelerating potential pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-lag focusing" .

goldbook:12597 a skos:Concept ;
    skos:definition "Even-electron \\(\\ce{C7H7^{+}}\\) ion with the same carbon skeleton as toluene that has lost a hydrogen atom from one of the ring carbons that carries the positive charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolyl ion" .

goldbook:12598 a skos:Concept ;
    skos:definition "Ion trapping device based on the three-dimensional structure formed by rotating the cross-section of a quadrupole ion trap about the edge perpendicular to the plane of the ring electrode. The resulting trapping region is toroidal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toroidal ion trap" .

goldbook:12599 a skos:Concept ;
    skos:altLabel "total ion current electrophorogram" ;
    skos:definition "Plot of the total ion current in each of a series of mass spectra that are recorded as a function of electrophoresis time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total ion current electropherogram" .

goldbook:12600 a skos:Concept ;
    skos:definition "Any plot of total ion current in a series of mass spectra recorded as a function of time, including total ion current chromatogram, total ion current electropherogram, flow injection mass spectrometry, or any other time dependent sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total ion current profile" .

goldbook:12601 a skos:Concept ;
    skos:definition "Ratio of the number of ions leaving a region of a mass spectrometer to the number entering that region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission efficiency" .

goldbook:12602 a skos:Concept ;
    skos:altLabel "quadrupole mass analyzer",
        "quadrupole mass filter",
        "quadrupole mass spectrometer" ;
    skos:definition "Mass spectrometer that consists of an array of four parallel rod electrodes whose centers form the corners of a square and whose opposing electrode pairs are connected. The electric potential applied between the connected pairs of rods is a superposition of a static potential and a sinusoidal radio frequency potential. The motion of an ion in the \\(x\\mbox{-}y\\) plane perpendicular to the length direction of the rod electrodes is described by the Mathieu equation whose solutions show that ions in a particular m/z range can be transmitted along the \\(z\\mbox{-}\\rm{axis}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission quadrupole mass spectrometer" .

goldbook:12603 a skos:Concept ;
    skos:definition "Region in a mass spectrometer in which an ion beam is transported from the ion source to the ion optics or from one ion optical element to the next." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transport region" .

goldbook:12604 a skos:Concept ;
    skos:definition "Tandem mass spectrometer comprising two transmission quadrupole mass spectrometers in series, with a (non-selecting) RF-only quadrupole (or other multipole) between them to act as a collision cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triple quadrupole mass spectrometer" .

goldbook:12605 a skos:Concept ;
    skos:definition "Fragmentation reaction in which the molecularity of the reaction system is unity. The dissociation may arise from the extra energy acquired by a metastable ion produced in the ion source or that provided by collisional excitation of a stable ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unimolecular dissociation" .

goldbook:12606 a skos:Concept ;
    skos:definition "Mass resolution such that it is possible to clearly distinguish a peak corresponding to a singly charged ion from its neighbors \\(\\pu{1 u}\\) away, usually with no more than \\(\\pu{5\\!-\\! 10\\%}\\) overlap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unit mass resolution" .

goldbook:12607 a skos:Concept ;
    skos:definition "High-energy product ion of a protonated peptide formally equivalent to a y-ion with the ionizing proton on the \\(\\ce{N}\\)-terminus, but with elimination of \\(\\ce{HR}\\) from the \\(\\ce{N}\\)-terminus where \\(\\ce{R}\\) is the side-chain on the \\(\\ce{C}\\)-atom of the \\(\\ce{N}\\)-terminal residue, to give a (\\(\\ce{H2N^{+}=CH-CO\\bond{-}}\\)) structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "v-ion" .

goldbook:12608 a skos:Concept ;
    skos:definition "Compound added in a fixed reproducible amount to a solution to be analyzed by gas chromatography to permit corrections for uncontrolled variations in injected volumes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volumetric internal standard" .

goldbook:12609 a skos:Concept ;
    skos:definition "Diagram illustrating the relative contributions in unimolecular dissociation of an ion, for example, by homolytic cleavage of a single bond, and fragmentation following rearrangement. The diagram is in two parts with a common horizontal axis representing the internal energy of the ion. The vertical axis in one part of the diagram shows the two types of rate constant on a logarithmic scale, and that for the other portion of the diagram indicates the distribution function for internal energy of the ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wahrhaftig diagram" .

goldbook:12610 a skos:Concept ;
    skos:definition "Mass spectrometer in which m/z separation is achieved using crossed electric and magnetic fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wien filter" .

goldbook:12611 a skos:Concept ;
    skos:definition "High-energy product ion of a protonated peptide formally equivalent to a z-ion that has lost the part of the \\(\\ce{N}\\)-terminal side-chain starting at the \\(\\ce{\\upgamma\\mbox{-}carbon}\\) (if any)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "w-ion" .

goldbook:12612 a skos:Concept ;
    skos:definition "Fragment ion containing the peptide \\(\\ce{C}\\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \\(\\ce{C-C}\\) bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "x-ion" .

goldbook:12613 a skos:Concept ;
    skos:definition "Fragment ion containing the peptide \\(\\ce{C}\\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \\(\\ce{C-N}\\) bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "y-ion" .

goldbook:12614 a skos:Concept ;
    skos:definition "Fragment ion containing the peptide \\(\\ce{C}\\)-terminus formed upon dissociation of a peptide ion at the peptide backbone \\(\\ce{N-C}\\) bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "z-ion" .

goldbook:12615 a skos:Concept ;
    skos:definition "Acronym referring to the absorption, distribution, metabolism, excretion, and toxicity profile or processes for a xenobiotic upon its administration in vivo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ADMET" .

goldbook:12616 a skos:Concept ;
    skos:definition "Compound that binds to a receptor at a site separate from, but actively coupled to, that of the endogenous agonist to reduce actively receptor signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allosteric antagonist" .

goldbook:12617 a skos:Concept ;
    skos:definition "Secondary 3D structure of a protein or peptide containing a right-handed coiled or spiral conformation, in which every backbone \\(\\ce{N-H}\\) group donates a hydrogen bond to the backbone \\(\\ce{C=O}\\) group of the amino acid four residues earlier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alpha-helix" .

goldbook:12618 a skos:Concept ;
    skos:altLabel "analog" ;
    skos:definition "Chemical compound having structural similarity to a reference compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analogue" .

goldbook:12619 a skos:Concept ;
    skos:altLabel "analog-based drug discovery" ;
    skos:definition "Strategy for drug discovery and/or optimization in which structural modification of an existing drug provides a new drug with improved chemical and/or biological properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analogue-based drug discovery" .

goldbook:12620 a skos:Concept ;
    skos:altLabel "ABC protein" ;
    skos:definition "Large gene family of transporter proteins that bind ATP and use the energy to transport substrates (e.g., sugars, amino acids, metal ions, peptides, proteins, and a large number of hydrophobic compounds and metabolites) across lipid membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ATP binding cassette protein" .

goldbook:12621 a skos:Concept ;
    skos:definition "Rate of loss of drug candidates during progression through the optimisation and developmental stages while on route to the marketplace." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attrition rate" .

goldbook:12622 a skos:Concept ;
    skos:definition "Capacity of a drug to induce enzymes that mediate its own metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoinduction" .

goldbook:12623 a skos:Concept ;
    skos:definition "Molecule selected as a replacement for the lead drug candidate should this subsequently fail during further preclinical evaluation or in clinical studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back-up compound" .

goldbook:12624 a skos:Concept ;
    skos:definition "Drug acting on a specific molecular target that provides the best balance between efficacy and adverse effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "best-in-class" .

goldbook:12625 a skos:Concept ;
    skos:definition "Secondary 3D protein structure containing a large beta-sheet that twists and coils to form a closed structure in which the first-strand hydrogen bonds to the last." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beta-barrel" .

goldbook:12626 a skos:Concept ;
    skos:definition "Secondary 3D structure of a protein that takes on a flat, pleated appearance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beta-sheet" .

goldbook:12627 a skos:Concept ;
    skos:definition "Compound that on binding to a protein disrupts beta-sheet formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beta-sheet breaker" .

goldbook:12628 a skos:Concept ;
    skos:definition "Biopolymer-based pharmaceutical, such as a protein, applicable to the prevention, treatment, or cure of diseases or injuries to man." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological agent" .

goldbook:12629 a skos:Concept ;
    skos:definition "Drug that generates annual sales of USD 1 billion (\\(\\$\\pu{E9}\\)) or more." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blockbuster drug" .

goldbook:12630 a skos:Concept ;
    skos:definition "Agent (chemical, physical, or biological) that is capable of increasing the incidence of malignant neoplasms, thus causing cancer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcinogen" .

goldbook:12631 a skos:Concept ;
    skos:definition "Application of chemistry to the study of molecular events in biological systems, often using tool compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical biology" .

goldbook:12632 a skos:Concept ;
    skos:definition "Specific electronic repository for storage and retrieval of chemical information." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical database" .

goldbook:12633 a skos:Concept ;
    skos:altLabel "compound collection",
        "compound library" ;
    skos:definition "Collection of samples (e.g., chemical compounds, natural products, over-expression library of a microbe) available for biological screening. Set of compounds produced through combinatorial chemistry or other means that expands around a single core structure or scaffold." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical library" .

goldbook:12634 a skos:Concept ;
    skos:definition "Set of all possible stable molecules based on a specific chemical entity that interacts at one or more specific molecular targets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical space" .

goldbook:12635 a skos:Concept ;
    skos:altLabel "chemical genomics" ;
    skos:definition "Systematic screening of chemical libraries of congeneric compounds against members of a target family of proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemogenomics" .

goldbook:12636 a skos:Concept ;
    skos:definition "Member of a superfamily of proteins with the primary function to control leukocyte activity and trafficking through tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemokine" .

goldbook:12637 a skos:Concept ;
    skos:altLabel "mutual prodrug [1]" ;
    skos:definition "Two chemically linked synergistic drugs designed to improve the drug delivery properties of one or both drugs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-drug" .

goldbook:12638 a skos:Concept ;
    skos:definition "Receptor or enzymatic function displayed in the absence of an agonist or activator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitutive activity" .

goldbook:12639 a skos:Concept ;
    skos:altLabel "CRO" ;
    skos:definition "Commercial organisation that can be engaged to undertake specifically defined chemical, biological, safety, or clinical studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contract research organisation" .

goldbook:12640 a skos:Concept ;
    skos:definition "Ligand that binds irreversibly to its molecular target through the formation of a new chemical bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "covalent drug" .

goldbook:12641 a skos:Concept ;
    skos:definition "Compounds conceived and synthesised to act on two or more molecular targets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "designed multiple ligands" .

goldbook:12642 a skos:Concept ;
    skos:definition "Unrelatedness of a set of molecules (e.g., building blocks or members of a compound library), as measured by properties such as atom connectivity, physical properties, or computationally generated descriptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diversity" .

goldbook:12643 a skos:Concept ;
    skos:altLabel "DOS" ;
    skos:definition "Efficient production of a range of structures and templates with skeletal and stereochemical diversity as opposed to the synthesis of a specific target molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diversity-oriented synthesis" .

goldbook:12644 a skos:Concept ;
    skos:altLabel "drug combination" ;
    skos:definition "­(in drug therapy) Administration of two or more distinct pharmacological agents to achieve a combination of their individual effects. Note 1: The combined effect may be additive, synergistic, or designed to reduce side-effects. Note 2: This term is often used synonymously with that of 'drug combination' but is preferred in order to avoid confusion with medications in which different drugs are included in a single formulation. (in drug testing) Administration of two or more distinct compounds to test simultaneously their individual behaviours (e.g., pharmacological effects in high-throughput screens or drug metabolism)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug cocktail" .

goldbook:12645 a skos:Concept ;
    skos:definition "Process by which a drug is administered to its intended recipient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug delivery" .

goldbook:12646 a skos:Concept ;
    skos:definition "Measured amounts of an administered compound in various parts of the organism to which it is given." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug distribution" .

goldbook:12647 a skos:Concept ;
    skos:definition "Capacity of a molecular target to be modulated in a favourable manner by a small-molecule drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "druggability" .

goldbook:12648 a skos:Concept ;
    skos:altLabel "drug repositioning",
        "drug reprofiling" ;
    skos:definition "Strategy that seeks to discover new applications for an existing drug that were not previously referenced and not currently prescribed or investigated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug repurposing" .

goldbook:12649 a skos:Concept ;
    skos:definition "Assessment of the nontolerable biological effects of a drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug safety" .

goldbook:12650 a skos:Concept ;
    skos:definition "Presence of two distinct ligand binding sites on the same molecular target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual binding site" .

goldbook:12651 a skos:Concept ;
    skos:altLabel "EC" ;
    skos:definition "Concentration of a substance that produces a defined magnitude of response in a given system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective concentration" .

goldbook:12652 a skos:Concept ;
    skos:altLabel "ED" ;
    skos:definition "Dose of a substance that causes a defined magnitude of response in a given system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective dose" .

goldbook:12653 a skos:Concept ;
    skos:definition "Transporter protein located in the membrane of cells that utilizes active transport to move a compound from the internal to the external environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efflux pump" .

goldbook:12654 a skos:Concept ;
    skos:definition "Analytical composition of a mixture or solution that is saturated with one of the components in the designated mixture or solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium solubility" .

goldbook:12655 a skos:Concept ;
    skos:definition "Compound selected as a rapid successor to a lead drug candidate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast follower" .

goldbook:12656 a skos:Concept ;
    skos:definition "Representation of a compound or chemical library by attributes (descriptors) such as atom connectivities, 3D structure, or physical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fingerprint" .

goldbook:12657 a skos:Concept ;
    skos:definition "First drug acting on a hitherto unaddressed molecular target to reach the market." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "first-in-class" .

goldbook:12658 a skos:Concept ;
    skos:definition "Drug having a similar mechanism of action to an existing drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follow-on drug" .

goldbook:12659 a skos:Concept ;
    skos:definition "Low-molar-mass ligand (typically smaller than \\(\\pu{200 Da}\\)) that binds to a target with low affinity but high ligand efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragment" .

goldbook:12660 a skos:Concept ;
    skos:definition "Screening libraries of low-molar-mass compounds (typically \\(\\pu{120\\!{-}\\! 250 Da}\\)) using sensitive biophysical techniques capable of detecting weakly binding lead compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragment-based lead discovery" .

goldbook:12661 a skos:Concept ;
    skos:definition "Structural feature that regularly results in a positive response in a variety of high-throughput or primary screens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frequent hitter" .

goldbook:12662 a skos:Concept ;
    skos:altLabel "guanine binding protein" ;
    skos:definition "Member of a family of membrane-associated proteins which on activation by cellular receptors lead to signal transduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "G protein" .

goldbook:12663 a skos:Concept ;
    skos:definition "Invention, design, and application of chemical products and processes to reduce or eliminate the use and generation of hazardous substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "green chemistry" .

goldbook:12664 a skos:Concept ;
    skos:definition "Molecule that produces reproducible activity above a defined threshold in a biological assay and whose structural identity has been established." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hit" .

goldbook:12665 a skos:Concept ;
    skos:definition "Generation of additional compound sets that contain chemical motifs and scaffolds that have activity in the primary screen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hit expansion" .

goldbook:12666 a skos:Concept ;
    skos:definition "Process by which a proven molecule or series derived from high-throughput screening or primary screens is chemically optimised to a viable lead or series." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hit-to-lead chemistry" .

goldbook:12667 a skos:Concept ;
    skos:definition "Computational representation of a protein built from the 3D structure of a similar protein or proteins using alignment techniques and homology arguments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homology model" .

goldbook:12668 a skos:Concept ;
    skos:definition "Representation of the lipophilicity contribution of a constituent part of a structure to the total lipophilicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophobic fragmental constant" .

goldbook:12669 a skos:Concept ;
    skos:definition "The concentration of an enzyme inhibitor or receptor antagonist that reduces the enzyme activity or agonist response by \\(\\pu{50\\%}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibitory concentration at 50%" .

goldbook:12670 a skos:Concept ;
    skos:definition "Equilibrium dissociation constant of an enzyme-inhibitor complex: \\(K_{\\rm{i}} = [\\ce{E}][\\ce{I}]/[\\ce{EI}]\\). The equilibrium dissociation constant of a receptor-ligand complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibition constant" .

goldbook:12672 a skos:Concept ;
    skos:definition "Equilibrium solubility of the uncharged form of an ionisable compound at a pH where it is fully unionised. \\[\\ce{HA(s)  HA(aq)} \\quad (1)\\] \\[\\ce{HA(aq)  H^{+}(aq) + A^{-}(aq)} \\quad (2)\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic solubility" .

goldbook:12673 a skos:Concept ;
    skos:altLabel "IND" ;
    skos:definition "Drug not yet approved for general use by the national authority, such as the Food and Drug Administration of the United States of America, but undergoing clinical investigation to assess its safety and efficacy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "investigational new drug" .

goldbook:12674 a skos:Concept ;
    skos:definition "Transmembrane ion channel that opens or closes in response to the binding of a ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionotropic receptor" .

goldbook:12675 a skos:Concept ;
    skos:altLabel "phosphotransferase" ;
    skos:definition "Enzyme that transfers a phosphate group from high-energy donor molecules, such as ATP, to specific target molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinase" .

goldbook:12676 a skos:Concept ;
    skos:altLabel "turbidimetric solubility" ;
    skos:definition "Composition of a solution with respect to a compound when its induced precipitate first appears." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic solubility" .

goldbook:12677 a skos:Concept ;
    skos:definition "Compound (or compound series) that satisfies predefined minimum criteria for further structure and activity optimization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lead" .

goldbook:12678 a skos:Concept ;
    skos:definition "Process by which a lead compound is authenticated by the confirmation of its expected pharmacological properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lead validation" .

goldbook:12679 a skos:Concept ;
    skos:definition "Method of drug discovery and/or optimization in which the pursuit of new structures and/or structural modifications is based upon one or more ligands known to interact with the molecular target of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand-based drug design" .

goldbook:12680 a skos:Concept ;
    skos:definition "Receptor that modulates electric potential-gated channels via G-proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabotropic receptor" .

goldbook:12681 a skos:Concept ;
    skos:definition "Term applied to drug analogues that offer no significant advantage over the prototype compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "me-too drug" .

goldbook:12682 a skos:Concept ;
    skos:altLabel "miRNA" ;
    skos:definition "Small single-stranded RNA molecules that play a significant role in the post-transcriptional regulation of gene expression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microRNA" .

goldbook:12683 a skos:Concept ;
    skos:definition "Parameter that characterizes a specific structural or physicochemical aspect of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular descriptor" .

goldbook:12684 a skos:Concept ;
    skos:definition "Protein (e.g., receptor, enzyme, or ion channel), RNA, or DNA that is implicated in a clinical disorder or the propagation of any untoward event." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular target" .

goldbook:12685 a skos:Concept ;
    skos:altLabel "MDR" ;
    skos:definition "Characteristic of cells that confers resistance to the effects of several different classes of drugs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multidrug resistance" .

goldbook:12686 a skos:Concept ;
    skos:altLabel "MPO" ;
    skos:definition "Drug-likeness penetrability algorithm derived from CLOGP, clogD, molar mass, topological polar surface area, number of hydrogen-bond donors, and \\(\\pu{p}K_{\\rm{a}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiparameter optimisation" .

goldbook:12687 a skos:Concept ;
    skos:altLabel "MTDL",
        "multitarget drug" ;
    skos:definition "Ligand acting on more than one distinct molecular target. Targets may be of the same or different mechanistic classes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multitarget-directed ligand" .

goldbook:12688 a skos:Concept ;
    skos:altLabel "MTDD" ;
    skos:definition "Deliberate design of compounds that act on more than one molecular target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multitarget drug discovery" .

goldbook:12689 a skos:Concept ;
    skos:definition "Core scaffold of a molecule that remains after all chain substituents that do not terminate in a ring are removed. Single atoms connected by a double bond are typically also retained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Murcko assembly" .

goldbook:12690 a skos:Concept ;
    skos:definition "Term used to emphasise an imbalance between therapeutic needs and resource allocation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neglected disease" .

goldbook:12691 a skos:Concept ;
    skos:definition "Ligand that blocks the responses of a receptor to both agonists and inverse agonists with the same intensity. It binds to the receptor without evoking any change of conformation or change to the ratio of activated to inactivated conformations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutral antagonist" .

goldbook:12692 a skos:Concept ;
    skos:definition "Drug that contains no active moiety previously approved for use by the national authority, such as the U.S. Food and Drug Administration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "new chemical entity" .

goldbook:12693 a skos:Concept ;
    skos:definition "Active ingredient that has never before been approved in any form by the national authority, such as the U.S. Food and Drug Administration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "new molecular entity" .

goldbook:12694 a skos:Concept ;
    skos:definition "Functional antagonist that either binds irreversibly to a receptor or to a site distinct from that of the natural agonist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "noncompetitive antagonist" .

goldbook:12695 a skos:Concept ;
    skos:altLabel "nuclear receptor" ;
    skos:definition "Ligand-activated transcription factor that regulates gene expression by interacting with specific DNA sequences upstream of its target gene(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear hormone receptor" .

goldbook:12696 a skos:Concept ;
    skos:definition "Term associated with intellectual property wherein the latter’s patentability is assessed relative to the combination of more than one item of 'prior art'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "obviousness" .

goldbook:12697 a skos:Concept ;
    skos:definition "Pharmacological action induced by any molecule at molecular/biological sites distinct from that for which it was designed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "off-target effect" .

goldbook:12698 a skos:Concept ;
    skos:definition "Disease for which drug research, development, and marketing is economically unfavourable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orphan disease" .

goldbook:12699 a skos:Concept ;
    skos:definition "Pharmaceutical agent that has been approved specifically to treat a rare and commercially unfavourable medical condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orphan drug" .

goldbook:12700 a skos:Concept ;
    skos:definition "Receptor for which an endogenous ligand has yet to be identified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orphan receptor" .

goldbook:12701 a skos:Concept ;
    skos:definition "Simultaneous preparation of sets of discrete compounds in arrays of physically separate reaction vessels or microcompartments without interchange of intermediates during the assembly process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parallel synthesis" .

goldbook:12702 a skos:Concept ;
    skos:definition "Set of criteria that must be satisfied in order to achieve commercial exclusivity for an invention." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "patentability" .

goldbook:12703 a skos:Concept ;
    skos:definition "Peptide-like oligomer consisting of repeating \\(N\\)-substituted glycine units  where \\(\\ce{R1}\\) to \\(\\ce{R4}\\) are typically alkyl or aryl and may be the same or different." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptoid" .

goldbook:12704 a skos:Concept ;
    skos:altLabel "Pgp" ;
    skos:definition "ATP-binding cassette transporter responsible for the efflux of small molecules from cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "P-glycoprotein" .

goldbook:12705 a skos:Concept ;
    skos:definition "Study of inherited differences (variation) in drug metabolism and response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacogenetics" .

goldbook:12706 a skos:Concept ;
    skos:definition "General study of all of the many different genes that determine drug behaviour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacogenomics" .

goldbook:12707 a skos:Concept ;
    skos:altLabel "exploratory investigational new drug" ;
    skos:definition "Exploratory first-in-human trials that involve microdosing of drug to allow the assessment of pharmacokinetic parameters with limited drug exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase 0 clinical studies" .

goldbook:12708 a skos:Concept ;
    skos:definition "Initial introduction of an investigational new drug into humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase I clinical studies" .

goldbook:12709 a skos:Concept ;
    skos:definition "Controlled clinical studies conducted in a limited number of individuals to obtain some preliminary data on the effectiveness of an investigational new drug for a particular indication or indications in patients with the disease or condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase II clinical studies" .

goldbook:12710 a skos:Concept ;
    skos:definition "Expanded controlled and uncontrolled trials in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase III clinical studies" .

goldbook:12711 a skos:Concept ;
    skos:definition "Extended post-marketing studies in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase IV clinical studies" .

goldbook:12712 a skos:Concept ;
    skos:definition "Evaluation of compounds (small molecules, peptides, siRNA, etc.) in cells, tissues, or organisms for their ability to modify the system in a measurable manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenotypic screening" .

goldbook:12713 a skos:Concept ;
    skos:definition "Discovery and development compound portfolio of a pharmaceutical company or research organization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pipeline" .

goldbook:12714 a skos:Concept ;
    skos:definition "Experiment that provides strong support for or against the drug or molecular target under investigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pivotal study" .

goldbook:12715 a skos:Concept ;
    skos:definition "Confirmed or suspected presence of one or more known genotoxic materials in an active pharmaceutical ingredient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential genotoxic impurity" .

goldbook:12716 a skos:Concept ;
    skos:altLabel "PCC",
        "safety assessment candidate" ;
    skos:definition "Optimised lead compound successfully passing key screening, selectivity, and physicochemical criteria sufficient to warrant further detailed pharmacological and pharmacokinetic evaluation in animal models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preclinical candidate" .

goldbook:12717 a skos:Concept ;
    skos:definition "Substructural feature that confers desirable (often drug-like) properties on compounds containing that feature. They often consist of a semi-rigid scaffold that presents multiple hydrophobic residues without undergoing hydrophobic collapse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "privileged structure" .

goldbook:12718 a skos:Concept ;
    skos:definition "Procedure by which a specific therapeutic mechanism or treatment/diagnostic paradigm is shown to be beneficial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proof of concept" .

goldbook:12719 a skos:Concept ;
    skos:altLabel "protease" ;
    skos:definition "Enzyme that catalyses the hydrolysis of proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteinase" .

goldbook:12720 a skos:Concept ;
    skos:definition "Early compound that has biological properties suitable for target validation but may not necessarily be adequate for clinical studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prototype drug" .

goldbook:12721 a skos:Concept ;
    skos:definition "Time between the start of the Q wave and the end of the T wave in the heart’s electrical cycle. When corrected for individual heart rate it becomes known as the corrected QT, or QTc interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "QTc interval" .

goldbook:12722 a skos:Concept ;
    skos:definition "Process of conceptually deconstructing complex molecules into simpler fragments capable of chemical manipulation to reform the parent compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retrosynthesis" .

goldbook:12723 a skos:Concept ;
    skos:definition "Set of molecular descriptors used to assess the quality of hit or lead molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rule of three" .

goldbook:12724 a skos:Concept ;
    skos:altLabel "template" ;
    skos:definition "Core portion of a molecule common to all members of a chemical library or compound series." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaffold" .

goldbook:12725 a skos:Concept ;
    skos:definition "Exchange of one scaffold for another while maintaining molecular features that are important for biological properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaffold hopping" .

goldbook:12726 a skos:Concept ;
    skos:definition "Molecular biology technique in which mutations are created at one or more defined sites in a DNA molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "site-directed mutagenesis" .

goldbook:12727 a skos:Concept ;
    skos:altLabel "siRNA",
        "small interfering double-stranded RNA" ;
    skos:definition "Small RNA fragments that can combine with specific genes to silence their expression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "small inhibitory double-stranded RNA" .

goldbook:12728 a skos:Concept ;
    skos:altLabel "receptor reserve" ;
    skos:definition "Residual binding site still available to an endogenous ligand after sufficient sites have already been filled to elicit the maximal response possible for that particular biological system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spare receptor" .

goldbook:12729 a skos:Concept ;
    skos:definition "Chemical features present in a hit or lead molecule indicative of potential toxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural alert" .

goldbook:12730 a skos:Concept ;
    skos:definition "Solution that has a greater composition of a solute than one that is in equilibrium with undissolved solute at specified values of temperature and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supersaturated solution" .

goldbook:12731 a skos:Concept ;
    skos:definition "Integration of high-throughput biology measurements with computational models that study the projection of the mechanistic characteristics of metabolic and signalling pathways onto physiological and pathological phenotypes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systems biology" .

goldbook:12732 a skos:Concept ;
    skos:definition "Approach to target a drug to a specific tissue or molecular target using a prodrug or antibody recognition systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "targeted drug delivery" .

goldbook:12733 a skos:Concept ;
    skos:definition "Process by which a protein, RNA, or DNA is implicated in a biological pathway thought to be of relevance to a disease or adverse pathology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "target validation" .

goldbook:12734 a skos:Concept ;
    skos:definition "Structural isomer that can readily convert to another form that differs only by the attachment position of a hydrogen atom and the location of double bond(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tautomer" .

goldbook:12735 a skos:Concept ;
    skos:altLabel "therapeutic ratio" ;
    skos:definition "Ratio of the exposure/concentration of a therapeutic agent that causes beneficial effects to that which causes the first observed adverse effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "therapeutic index" .

goldbook:12736 a skos:Concept ;
    skos:definition "Term used for diseases or other disorders for which no optimal therapeutic options exist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unmet medical need" .

goldbook:12737 a skos:Concept ;
    skos:definition "Collection of chemical structures constructed solely in electronic form or on paper." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virtual chemical library" .

goldbook:12738 a skos:Concept ;
    skos:definition "Apparent (hypothetical) volume of fluid required to contain the total amount of a substance in the body at the same concentration as that present in the plasma assuming equilibrium has been attained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume of distribution" .

goldbook:12739 a skos:Concept ;
    skos:definition "Receptor that occurs naturally in human and other species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wild-type receptor" .

goldbook:12740 a skos:Concept ;
    skos:altLabel "α-relaxation" ;
    skos:definition "Highest-temperature or lowest-frequency relaxation in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alpha relaxation" .

goldbook:12741 a skos:Concept ;
    skos:altLabel "alpha loss peak",
        "α-loss peak",
        "α-relaxation peak" ;
    skos:definition "Highest-temperature peak or lowest-frequency peak in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alpha relaxation peak" .

goldbook:12742 a skos:Concept ;
    skos:definition "Polymer in the amorphous state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amorphous polymer" .

goldbook:12743 a skos:Concept ;
    skos:definition "State of matter characterised by the absence of long-range molecular order." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amorphous state" .

goldbook:12744 a skos:Concept ;
    skos:altLabel "β-relaxation" ;
    skos:definition "Second-highest-temperature or second-lowest-frequency relaxation in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beta relaxation" .

goldbook:12745 a skos:Concept ;
    skos:altLabel "beta loss peak",
        "β-loss peak",
        "β-relaxation peak" ;
    skos:definition "Second-highest-temperature or second-lowest-frequency peak in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beta relaxation peak" .

goldbook:12746 a skos:Concept ;
    skos:definition "Temperatures obtained from a differential scanning calorimeter (DSC) experiment or a differential thermal analysis (DTA) experiment that characterise the physical processes occurring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic temperatures" .

goldbook:12747 a skos:Concept ;
    skos:altLabel "clearing point" ;
    skos:definition "Temperature at which the transition between the mesophase with the highest temperature range and the isotropic phase occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clearing temperature" .

goldbook:12748 a skos:Concept ;
    skos:definition "Polymer crystallisation brought about from a glass, from a liquid-crystalline state, or a state displaying a low degree of crystallinity at temperatures a little above the glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cold crystallisation" .

goldbook:12749 a skos:Concept ;
    skos:definition "Enthalpy change associated with conformational changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational enthalpy" .

goldbook:12750 a skos:Concept ;
    skos:definition "Entropy change associated with conformational changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational entropy" .

goldbook:12751 a skos:Concept ;
    skos:definition "Step-like increase in the conformational entropy of macromolecules, or parts of macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational melting" .

goldbook:12752 a skos:Concept ;
    skos:definition "Transition between two conformational states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational transition" .

goldbook:12753 a skos:Concept ;
    skos:definition "Forced-resonance method to determine the viscoelastic properties of a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constant oscillation-amplitude method" .

goldbook:12754 a skos:Concept ;
    skos:definition "State of matter ideally characterised by three-dimensional, long-range order on an atomic scale." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystalline state" .

goldbook:12755 a skos:Concept ;
    skos:definition "Polymer that is able to partially crystallise." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystallisable polymer" .

goldbook:12756 a skos:Concept ;
    skos:altLabel "loss curve" ;
    skos:definition "Decrease in the deformation amplitude of a material specimen plotted vs. time when the specimen is subjected to a free oscillation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "damping curve" .

goldbook:12757 a skos:Concept ;
    skos:definition "Formation of a polymer melt from a polymer glass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "devitrification" .

goldbook:12758 a skos:Concept ;
    skos:altLabel "DSC" ;
    skos:definition "Apparatus for conducting a differential scanning calorimetry (DSC) experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential scanning calorimeter" .

goldbook:12759 a skos:Concept ;
    skos:altLabel "DTA" ;
    skos:definition "Apparatus for conducting a differential thermal analysis experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential thermal analyser" .

goldbook:12760 a skos:Concept ;
    skos:definition "Apparatus for conducting a dilatometry experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilatometer" .

goldbook:12761 a skos:Concept ;
    skos:definition "The measurement of changes with time in the volume, length, width, or thickness of a material sample caused by temperature changes under negligible load or by chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilatometry" .

goldbook:12762 a skos:Concept ;
    skos:altLabel "DLTMA" ;
    skos:definition "Thermomechanical analysis carried out using a sinusoidal stress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic-load thermomechanical analysis" .

goldbook:12763 a skos:Concept ;
    skos:altLabel "DMA" ;
    skos:definition "Apparatus for conducting a dynamic mechanical analysis experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic mechanical analyser" .

goldbook:12764 a skos:Concept ;
    skos:definition "Apparatus that uses a forced, non-resonance method to determine the viscoelastic properties of a material sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic viscometer" .

goldbook:12765 a skos:Concept ;
    skos:definition "Enthalpy change observed near the glass transition when a sample is heated at a rate different from that at which it was cooled down, or observed after annealing in the glassy state below the glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpy relaxation" .

goldbook:12766 a skos:Concept ;
    skos:definition "Temperature at which perfect polymer crystals of infinite thickness melt under equilibrium conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium melting temperature" .

goldbook:12767 a skos:Concept ;
    skos:altLabel "forced oscillation",
        "sinusoidal oscillation" ;
    skos:definition "Deformation of a material by the application of a small sinusoidal strain (\\(\\gamma\\)) such that \\[\\gamma = \\gamma_{0} \\cos \\omega t\\] where \\(\\gamma_{0}\\) and \\(\\omega\\) are positive constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forced sinusoidal oscillation" .

goldbook:12768 a skos:Concept ;
    skos:definition "Glass characterised by a large value of the fragility index (m)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragile glass" .

goldbook:12769 a skos:Concept ;
    skos:definition "Quantity characterising the fragility or the strength of a glass at a given temperature \\[m = \\left (\\frac{\\rm{d} \\log_{10} \\tau}{{\\rm{d}} (T_{\\rm{g}}/T)} \\right)_{T = T_{\\rm{g}}}\\] \\(\\tau\\) = relaxation time [\\(\\pu{s}\\)]; \\(T_{\\rm{g}}\\) = glass-transition temperature [\\(\\pu{K}\\)]; \\(T\\) = temperature [\\(\\pu{K}\\)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragility index" .

goldbook:12770 a skos:Concept ;
    skos:altLabel "free sinusoidal oscillation" ;
    skos:definition "Oscillatory deformation of a material specimen with the motion generated without the continuous application of an external force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free oscillation" .

goldbook:12771 a skos:Concept ;
    skos:altLabel "γ-relaxation" ;
    skos:definition "Third-highest-temperature or third-lowest-frequency relaxation in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gamma relaxation" .

goldbook:12772 a skos:Concept ;
    skos:altLabel "gamma loss peak",
        "γ-loss peak",
        "γ-relaxation peak" ;
    skos:definition "Third-highest-temperature or third-lowest-frequency peak in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gamma relaxation peak" .

goldbook:12773 a skos:Concept ;
    skos:definition "Amorphous matter in the glassy state, i.e., below its glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass" .

goldbook:12774 a skos:Concept ;
    skos:definition "State of amorphous matter below its glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glassy state" .

goldbook:12775 a skos:Concept ;
    skos:definition "Plot of melting temperature, \\(T_{\\rm{m}}\\), vs. crystallisation temperature, \\(T_{\\rm{cr}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hoffman–Weeks plot" .

goldbook:12776 a skos:Concept ;
    skos:definition "Temperature at which a transition from any anisotropic state to an isotropic liquid occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotropisation temperature" .

goldbook:12777 a skos:Concept ;
    skos:definition "Temperature at which the extrapolation of the entropy of a super-cooled liquid is equal to the entropy of its crystalline state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kauzmann temperature" .

goldbook:12778 a skos:Concept ;
    skos:altLabel "KWW Equation" ;
    skos:definition "Equation describing the enthalpy relaxation, \\(\\Delta H\\) which is observed during the annealing of polymers in the glassy state at a temperature, \\(T_{\\rm{a}}\\), lower than \\(T_{\\rm{g}}\\) \\[\\Delta H(t_{\\rm{a}}) = \\Delta c_{p}(T_{\\rm{g}} - T_{\\rm{a}}) \\exp\\!\\left[- \\left (\\frac{t_{\\rm{a}}}{\\tau} \\right)^{\\beta} \\right]\\] \\(\\Delta H\\) = difference of the enthalpy in the initial, glassy state, and the enthalpy of the glassy state after annealing; \\(t_{\\rm{a}}\\) = time of annealing; \\(\\Delta c_{p}\\) = difference in heat capacity at the glass-transition temperature, \\(T_{\\rm{g}}\\), and the starting temperature of the annealing process, \\(T_{\\rm{a}}\\); \\(\\tau\\) = relaxation time at \\(T_{\\rm{a}}\\); \\(\\beta\\) = exponential factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kohlrausch–Williams–Watts equation" .

goldbook:12779 a skos:Concept ;
    skos:definition "Technique in which one dimension of a substance under negligible load is measured as a function of temperature while the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear thermodilatometry" .

goldbook:12780 a skos:Concept ;
    skos:definition "Natural logarithm of the ratio of the displacement of a damping curve separated by one period of the displacement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "logarithmic decrement" .

goldbook:12781 a skos:Concept ;
    skos:definition "Plot of loss tangent (\\(\\tan \\delta\\)) vs. the temperature or the frequency of the forced sinusoidal oscillation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loss curve" .

goldbook:12782 a skos:Concept ;
    skos:definition "Ratio of the amplitude of the stress \\(\\pu{90\\!^{\\circ}}\\) out of phase with the strain (\\(\\sigma_{0} \\sin \\delta\\)) to the amplitude of the strain (\\(\\gamma_{0}\\)) in the forced sinusoidal oscillation of a material. \\[M^{\\prime\\prime} = \\frac{\\sigma_{0} \\sin \\delta}{\\gamma_{0}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loss modulus" .

goldbook:12783 a skos:Concept ;
    skos:altLabel "loss factor" ;
    skos:definition "Tangent of the phase angle (\\(\\delta\\)) between stress and strain during a forced sinusoidal oscillation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loss tangent" .

goldbook:12784 a skos:Concept ;
    skos:definition "Viscoelastic spectrum of a polymer or polymer material constructed using the time–temperature superposition (TTS) principle, so that the spectrum covers a wide range of lengths of time or frequencies of measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "master curve" .

goldbook:12785 a skos:Concept ;
    skos:definition "Mechanically induced transition of matter in the crystalline or glassy state to its melt." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanical melting" .

goldbook:12786 a skos:Concept ;
    skos:definition "Matter in the amorphous state above its glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melt" .

goldbook:12787 a skos:Concept ;
    skos:altLabel "MFI",
        "MFR",
        "melt flow rate",
        "melt mass flow rate",
        "melt volume flow" ;
    skos:definition "Mass of a polymer in grams that flows through a calibrated orifice at constant temperature under a specified load over a \\(\\pu{10\\!{-}min}\\) period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melt flow index" .

goldbook:12788 a skos:Concept ;
    skos:altLabel "melting point" ;
    skos:definition "Temperature at which the last trace of crystallinity disappears upon heating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melting temperature" .

goldbook:12789 a skos:Concept ;
    skos:altLabel "MHF" ;
    skos:definition "Heat flow in a modulated-temperature DSC experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulated heat flow" .

goldbook:12790 a skos:Concept ;
    skos:altLabel "MTDSC" ;
    skos:definition "DSC experiment in which a small sinusoidal modulation overlays the change in temperature with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modulated-temperature DSC" .

goldbook:12791 a skos:Concept ;
    skos:definition "Technique used in dynamic mechanical analysis in which a specimen is subjected to the superposition of a number of forced sinusoidal oscillations of different frequencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplexing" .

goldbook:12792 a skos:Concept ;
    skos:definition "In modulated-temperature DSC, the component of the total heat flow that is out-of-phase with the temperature modulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-reversing heat flow" .

goldbook:12793 a skos:Concept ;
    skos:altLabel "glassy polymer" ;
    skos:definition "Amorphous polymer at temperatures below its glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer glass" .

goldbook:12794 a skos:Concept ;
    skos:definition "Polymer in the amorphous state above its glass-transition temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer melt" .

goldbook:12795 a skos:Concept ;
    skos:definition "Plot of the logarithm of the relaxation time vs. the reciprocal temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relaxation map" .

goldbook:12796 a skos:Concept ;
    skos:altLabel "spectrum of relaxation times" ;
    skos:definition "Range of relaxation times describing stress relaxation in a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relaxation spectrum" .

goldbook:12797 a skos:Concept ;
    skos:definition "In modulated-temperature DSC the heat-capacity component of the total heat flow that is in-phase with the temperature modulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversing heat flow" .

goldbook:12798 a skos:Concept ;
    skos:definition "Second-, third-, fourth-, … highest-temperature or second-, third-, fourth-, … lowest-frequency relaxation in the loss curve of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary relaxation" .

goldbook:12799 a skos:Concept ;
    skos:altLabel "secondary loss peak" ;
    skos:definition "Any peak in a loss curve either at a lower temperature than the temperature of the alpha relaxation peak or at a higher frequency than the frequency of the alpha relaxation peak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary relaxation peak" .

goldbook:12800 a skos:Concept ;
    skos:definition "Temperature characterising a secondary relaxation peak identified as the temperature at which the loss modulus (or loss tangent), measured by DMA or DETA, exhibits a maximum at the measurement frequency, due to the occurrence of localised motions involving only short segments of the polymer chains, or side groups of the polymer chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary relaxation temperature" .

goldbook:12801 a skos:Concept ;
    skos:definition "Multiplier used to change the interval of time or the range frequencies of measurement of a viscoelastic property at a given temperature, \\(T_{1}\\), so that the values of the property superimpose on the values measured at a reference temperature, \\(T_{0}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shift factor" .

goldbook:12802 a skos:Concept ;
    skos:definition "Ratio of the amplitude of the stress in phase with the strain (\\(\\sigma_{0} \\cos \\delta\\)) to the amplitude of the strain (\\(\\gamma_{0}\\)) in the forced sinusoidal oscillation of a material. \\[M^{\\prime} = \\frac{\\sigma_{0} \\cos \\delta}{\\gamma_{0}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "storage modulus" .

goldbook:12803 a skos:Concept ;
    skos:definition "Change in stress with time after the instantaneous application of a constant strain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress relaxation" .

goldbook:12804 a skos:Concept ;
    skos:definition "Glass characterised by a small value of the fragility index (\\(m\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "strong glass" .

goldbook:12805 a skos:Concept ;
    skos:definition "Metastable melt of a crystallisable polymer at temperatures below its equilibrium melting temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercooled polymer melt" .

goldbook:12806 a skos:Concept ;
    skos:definition "Empirical rule that states that in a partially crystalline polymer the glass-transition temperature can be reasonably approximated by a value equal to two-thirds of the melting temperature, \\(T_{\\rm{m}}\\)/\\(\\pu{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tammann’s 2/3rd rule" .

goldbook:12807 a skos:Concept ;
    skos:definition "Thermal treatment a polymer material has experienced before its characterisation or measurement of its properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal history" .

goldbook:12808 a skos:Concept ;
    skos:definition "Delay of the response of a system to a change in temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal lag" .

goldbook:12809 a skos:Concept ;
    skos:altLabel "TGA",
        "thermobalance" ;
    skos:definition "Apparatus for conducting thermogravimetric analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermogravimetric analyser" .

goldbook:12810 a skos:Concept ;
    skos:altLabel "TLA" ;
    skos:definition "Technique that monitors the light that is emitted from a sample against time or temperature while the temperature of the sample, in a specified atmosphere, is heated in a controlled manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoluminescence analysis" .

goldbook:12811 a skos:Concept ;
    skos:altLabel "TMA" ;
    skos:definition "Apparatus for conducting thermomechanical analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomechanical analyser" .

goldbook:12812 a skos:Concept ;
    skos:definition "The temperature dependence of deformability or mechanical properties of a polymer sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomechanical properties" .

goldbook:12813 a skos:Concept ;
    skos:altLabel "TTS Principle" ;
    skos:definition "Principle stating that the value of a viscoelastic property measured at a given temperature, after a given length of time or at a given frequency, is equal to the value of the property at a different temperature after a length of time or at a frequency equal to the given length of time or given frequency multiplied by a shift factor, \\(a_{T}\\) , with the value of the shift factor being independent of length of the time or frequency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time–temperature superposition principle" .

goldbook:12814 a skos:Concept ;
    skos:definition "Device consisting of a disc or other body of large moment of inertia mounted on one end of a torsionally flexible elastic rod or wire, the other end of which is fixed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torsion pendulum" .

goldbook:12815 a skos:Concept ;
    skos:definition "Dynamic mechanical analysis performed using a torsion pendulum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torsional pendulum analysis" .

goldbook:12816 a skos:Concept ;
    skos:altLabel "Vicat hardness",
        "Vicat softening point",
        "softening point" ;
    skos:definition "Temperature at which a thermoplastic polymer reaches a specific degree of softness as measured by a standard test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Vicat softening temperature" .

goldbook:12817 a skos:Concept ;
    skos:definition "Double logarithmic plot of a viscoelastic property vs. frequency of measurement or interval of time of measurement at constant temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viscoelastic spectrum" .

goldbook:12818 a skos:Concept ;
    skos:definition "Formation of a polymer glass from a polymer melt." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vitrification" .

goldbook:12819 a skos:Concept ;
    skos:altLabel "VFT Equation" ;
    skos:definition "Equation describing the time-dependence of a relaxation time that deviates from an Arrhenius-type temperature dependence. \\[\\tau = \\tau_{0} \\exp\\!\\left({\\frac{B}{T - T_{0}}}\\right)\\] \\(\\tau\\)/\\(\\pu{s}\\) = relaxation time; \\(\\tau_{0}\\)/\\(\\pu{s}\\) = relaxation time at the Kauzmann temperature, \\(B\\)/\\(\\pu{K}\\) = constant; \\(T\\)/\\(\\pu{K}\\) = temperature; \\(T_{0}\\)/\\(\\pu{K}\\) = Kauzmann temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Vogel–Fulcher–Tammann equation" .

goldbook:12820 a skos:Concept ;
    skos:definition "Technique in which the volume of a substance under negligible load is measured as a function of temperature while the substance is heated or cooled in a controlled programme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume thermodilatometry" .

goldbook:12821 a skos:Concept ;
    skos:altLabel "WLF Equation" ;
    skos:definition "Equation describing the temperature dependence of the shift factor, \\(a_{T}\\), for time–temperature superposition \\[\\log_{10}a_{\\rm{T}} = \\frac{-C_{1}(T_{1} - T_{0})}{C_{2} + (T_{1} - T_{0})}\\] \\(C_{1}\\) and \\(C_{2}\\) are empirical constants, \\(T\\) is the temperature of measurement, and \\(T_{0}\\) is the reference temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Williams–Landel–Ferry equation" .

goldbook:12822 a skos:Concept ;
    skos:definition "A coordination compound with repeating coordination entities extending in 1, 2, or 3 dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination polymer" .

goldbook:12823 a skos:Concept ;
    skos:definition "A coordination compound extending, through repeating coordination entities, in one dimension, but with cross-links between two or more individual chains, loops, or spiro-links, or a coordination compound extending through repeating coordination entities in two or three dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination network" .

goldbook:12824 a skos:Concept ;
    skos:altLabel "MOF" ;
    skos:definition "A metal-organic framework, abbreviated to MOF, is a coordination network with organic ligands containing potential voids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metal-organic framework" .

goldbook:12825 a skos:Concept ;
    skos:definition "T-cell receptor (TCR) consisting of a heterodimer of two different glycoprotein chains, designated \\(\\upalpha\\) and \\(\\upbeta\\), assembled into an \\(\\upalpha{:}\\upbeta\\) heterodimer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α:β T-cell receptor" .

goldbook:12826 a skos:Concept ;
    skos:definition "Lymphocyte whose T-cell receptor (TCR) is a heterodimer of an \\(\\upalpha\\) chain and a \\(\\upbeta\\) chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α:β T cell" .

goldbook:12827 a skos:Concept ;
    skos:altLabel "BCR-ABL" ;
    skos:definition "Gene resulting from a chromosomal translocation (9;22) that fuses sequences from the BCR (breakpoint cluster region) gene with the ABL gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ABL oncogene" .

goldbook:12828 a skos:Concept ;
    skos:definition "System of antigens expressed on erythrocytes and used for typing human blood for transfusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ABO blood group system" .

goldbook:12829 a skos:Concept ;
    skos:definition "Antibody or antibody construct with catalytic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abzyme" .

goldbook:12830 a skos:Concept ;
    skos:definition "Cell that assists in the adaptive immune response but does not directly mediate specific antigen recognition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessory cell" .

goldbook:12831 a skos:Concept ;
    skos:definition "Molecule other than immunoglobulin (Ig), T-cell receptor (TCR), or major histocompatibility complex (MHC) molecule that participates in T lymphocyte recognition and response to antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessory molecule" .

goldbook:12832 a skos:Concept ;
    skos:definition "State of protection against pathogen-induced injury, with rapid immune elimination of pathogenic invaders owing to previous immunization or vaccination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acquired immunity" .

goldbook:12833 a skos:Concept ;
    skos:altLabel "AIDS" ;
    skos:definition "Disease caused by infection with the human immunodeficiency virus (HIV), assuming clinical relevance when an infected patient has lost most of his/her CD4+ T cells, so that infections with opportunistic pathogens occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acquired immunodeficiency syndrome" .

goldbook:12834 a skos:Concept ;
    skos:definition "Process by which immune responses end in the death of most of the responding lymphocytes, leaving only a small number of resting memory cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activation-induced cell death" .

goldbook:12835 a skos:Concept ;
    skos:definition "Immunization with antigen, as distinct from the transfer of antibody to an unimmunized individual, which is called passive immunization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active immunization" .

goldbook:12836 a skos:Concept ;
    skos:altLabel "ASA",
        "ASA test" ;
    skos:definition "Test for determining whether a drug can cause anaphylactic reactions in an animal following immunization with the drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active systemic anaphylaxis test" .

goldbook:12837 a skos:Concept ;
    skos:altLabel "ALL",
        "Acute Lymphocytic Leukemia" ;
    skos:definition "Highly aggressive, undifferentiated form of lymphoid malignancy derived from a progenitor cell that is thought to be able to give rise to both T- and B-cell lineages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute lymphoblastic leukemia" .

goldbook:12838 a skos:Concept ;
    skos:altLabel "AML" ;
    skos:definition "Cancer characterized by rapid growth of abnormal granulocytes that accumulate in the bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute myelogenous leukemia" .

goldbook:12839 a skos:Concept ;
    skos:definition "Serum protein, mostly produced in the liver, which rapidly changes in concentration (some acute-phase proteins increase, some decrease) during the initiation of an inflammatory response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute-phase protein" .

goldbook:12840 a skos:Concept ;
    skos:altLabel "APR" ;
    skos:definition "Physiological response stimulated by cytokines including interleukin-1, interleukin-6, interferons, and tumor necrosis factor (TNF), characterized by increased vascular permeability, fever, and increased levels of proteins (thus called acute-phase proteins) such as C-reactive protein (CRP), occurring within a few hours of initiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute-phase response" .

goldbook:12841 a skos:Concept ;
    skos:definition "Rejection of a tissue or organ graft from a genetically unrelated donor, typically occurring within 10 to 13 days of transplantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute rejection" .

goldbook:12842 a skos:Concept ;
    skos:altLabel "ARDS",
        "adult respiratory distress syndrome" ;
    skos:definition "Acute lung failure characterized by alveolar and interstitial edema, perivascular pulmonary edema, and hyaline membrane formation, resulting from a variety of underlying diseases that result in increased pulmonary vascular permeability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute respiratory distress syndrome" .

goldbook:12843 a skos:Concept ;
    skos:definition "Immune response based on the principle of clonal recognition, such that upon first exposure to an antigen, primed lymphocytes either differentiate into immune effector cells or form an expanded pool of memory cells that respond to secondary exposure to the same antigen by mounting an amplified and more rapid response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adaptive immune response" .

goldbook:12844 a skos:Concept ;
    skos:definition "Part of the immune system responsible for the adaptive immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adaptive immune system" .

goldbook:12845 a skos:Concept ;
    skos:altLabel "Addison autoimmune disease",
        "Addison's autoimmune disease",
        "Addison's disease" ;
    skos:definition "Adrenocortical hypofunction characterized by hypotension, weight loss, anorexia, and weakness. The most common form is idiopathic Addison disease, mediated by autoimmune mechanisms. Autoantibodies specific to the adrenal cortex are specific diagnostic markers of this form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Addison disease" .

goldbook:12846 a skos:Concept ;
    skos:definition "Extracellular protein of the venular endothelium serving as a ligand to a homing receptor for lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "addressin" .

goldbook:12847 a skos:Concept ;
    skos:altLabel "ADA",
        "ADA Deficiency" ;
    skos:definition "Lack of the enzyme adenosine deaminase (ADA), which catalyzes the deamination of adenosine and deoxyadenosine to produce inosine and deoxyinosine, respectively. Affected individuals have a form of severe combined immunodeficiency (SCID)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adenosine deaminase deficiency" .

goldbook:12848 a skos:Concept ;
    skos:definition "Molecule belonging mainly to the immunoglobulins, integrin superfamily (e.g., LFA-1, ICAM-1) or selectins, expressed on the cell membrane of various cells including those of the immune system. Interaction of adhesion molecules with each other as receptor and corresponding ligand facilitates cooperation (cross-talk) of cells, signal transduction, and information transfer between cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adhesion molecule" .

goldbook:12849 a skos:Concept ;
    skos:definition "Experimental model of immunopathology with features of rheumatoid arthritis (RA), induced in rats by injection with bacterial products, which may be used to study anti-inflammatory therapies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adjuvant arthritis" .

goldbook:12850 a skos:Concept ;
    skos:definition "Transfer, by transplantation of immunocompetent cells, of the capacity to mount an immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adoptive transfer" .

goldbook:12851 a skos:Concept ;
    skos:definition "Appreciably harmful or unpleasant reaction resulting from an intervention related to the administration of a pharmaceutical product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adverse drug reaction" .

goldbook:12852 a skos:Concept ;
    skos:definition "Antigen-non-specific, inappropriate, or unintended activation of a component of the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adverse immunostimulation" .

goldbook:12853 a skos:Concept ;
    skos:definition "Any airborne particle, such as a pollen grain or spore, that triggers an allergic reaction in sensitive individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aeroallergen" .

goldbook:12854 a skos:Concept ;
    skos:definition "Increase in antibody affinity for an antigen observed as the humoral immune response progresses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "affinity maturation" .

goldbook:12855 a skos:Concept ;
    skos:definition "Failure of the bone marrow to make sufficient granulocytes, especially neutrophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agranulocytosis" .

goldbook:12856 a skos:Concept ;
    skos:definition "Phenomenon whereby, following successful rearrangement of one allele of an antigen receptor gene, rearrangement of the other parental allele is suppressed, thereby ensuring each lymphocyte expresses only a single specificity of antigen receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allelic exclusion" .

goldbook:12857 a skos:Concept ;
    skos:definition "Immunostimulant antigenic substance that may or may not cause a clinically significant effect but which is capable of producing an immune reaction, often immediate-type hypersensitivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allergen" .

goldbook:12858 a skos:Concept ;
    skos:definition "Immunologically hypersensitive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allergic" .

goldbook:12859 a skos:Concept ;
    skos:definition "Symptoms or signs occurring in sensitized individuals following exposure to a previously encountered substance (allergen) that would otherwise not cause such symptoms or signs in non-sensitized individuals. The most common forms of allergy are rhinitis, urticaria, asthma, and contact dermatitis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allergy" .

goldbook:12860 a skos:Concept ;
    skos:definition "Antibody produced against an antigen from another member of the same species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alloantibody" .

goldbook:12861 a skos:Concept ;
    skos:altLabel "isoantigen" ;
    skos:definition "Antigen, present in some but not all individuals of a particular species, that arises from polymorphisms at the major histocompatibility complex (MHC) loci and stimulates intense reactions to allograft tissues from other individuals of the same species that do not produce it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alloantigen" .

goldbook:12862 a skos:Concept ;
    skos:altLabel "allogenic" ;
    skos:definition "Genetically different, referring to individuals of the same species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allogeneic" .

goldbook:12863 a skos:Concept ;
    skos:definition "Tissue or organ graft between allogeneic individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allograft" .

goldbook:12864 a skos:Concept ;
    skos:definition "Allelic variant of an antigen that, because it is not present in all individuals, may be immunogenic in members of the same species that have a different version of the allele." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allotype" .

goldbook:12865 a skos:Concept ;
    skos:definition "Reactivity of an antibody with an alloantigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alloreactivity" .

goldbook:12866 a skos:Concept ;
    skos:definition "Activation pathway involving complement components C3, Factor B, Factor D, and properdin that, in the presence of a stabilizing activator surface such as microbial polysaccharide, generates the alternative pathway C3 convertase C3bBb." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternative pathway" .

goldbook:12867 a skos:Concept ;
    skos:definition "Macrophage found in the lung alveoli; it may remove and sometimes retain inhaled particulate matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alveolar macrophage" .

goldbook:12868 a skos:Concept ;
    skos:definition "1) Inflammation of alveoli. 2) Inflammation of a tooth socket." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alveolitis" .

goldbook:12869 a skos:Concept ;
    skos:definition "Fibrous protein secreted into the extracellular space where it forms amorphous deposits in multiple organs in some pathological states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amyloid" .

goldbook:12870 a skos:Concept ;
    skos:definition "Describing immunological memory that gives rise to a rapid increase in immunological response after reexposure to antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anamnestic" .

goldbook:12871 a skos:Concept ;
    skos:definition "Immediate overreaction of the immune system to a drug or other agent in an individual who has previously encountered the agent and has produced antibodies to that agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphylactic shock" .

goldbook:12872 a skos:Concept ;
    skos:definition "Of or resembling anaphylaxis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphylactoid" .

goldbook:12873 a skos:Concept ;
    skos:definition "Complement-derived protein fragment (e.g., C3a, C4a, or C5a) capable of directly triggering mast cell degranulation, chemotaxis, smooth muscle contraction, and inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphylatoxin" .

goldbook:12874 a skos:Concept ;
    skos:definition "Life-threatening type I hypersensitivity allergic reaction occurring in a person or animal exposed to an antigen or hapten to which they have previously been sensitized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaphylaxis" .

goldbook:12875 a skos:Concept ;
    skos:definition "Lack of an immune response, usually taken as lack of response to common recall antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anergy" .

goldbook:12876 a skos:Concept ;
    skos:altLabel "angioneurotic edema" ;
    skos:definition "Swelling that occurs in the tissue just below the surface of the skin, most often around the lips and eyes, the mucous membranes and occasionally the viscera." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angioedema" .

goldbook:12877 a skos:Concept ;
    skos:definition "Chronic inflammatory disease affecting the spine, sacroiliac joints, and large peripheral joints, having a major genetic predisposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ankylosing spondylitis" .

goldbook:12878 a skos:Concept ;
    skos:definition "Antibody administered with the aim of treating a disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "therapeutic antibody" .

goldbook:12879 a skos:Concept ;
    skos:altLabel "ADCC",
        "antibody-dependent cell-mediated cytotoxicity" ;
    skos:definition "Cytotoxic reaction in which an antibody-coated target cell is directly killed by an Fc receptor-bearing leukocyte, e.g., NK cell, macrophage, neutrophil, or eosinophil." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antibody-dependent cellular cytotoxicity" .

goldbook:12880 a skos:Concept ;
    skos:altLabel "AFC",
        "AFC assay",
        "Jerne plaque assay",
        "hemolytic plaque assay",
        "plaque-forming cell (PFC) assay" ;
    skos:definition "Assay that measures the humoral immune response mediated by the concerted actions of antigen-presenting cells, T lymphocytes, and B lymphocytes, generally by determination of murine primary IgM or IgG antibodies directed against the T-cell-dependent sheep red blood cell (SRBC) surface antigens after in vivo sensitization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antibody-forming cell assay" .

goldbook:12881 a skos:Concept ;
    skos:definition "Use of an antibody to target specific cells (often tumor cells) or signal transduction pathways (often via chemokines/cytokines) in the treatment of disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antibody therapy" .

goldbook:12882 a skos:Concept ;
    skos:altLabel "antibody",
        "lupus",
        "lupus antibody",
        "lupus anticoagulant" ;
    skos:definition "Autoantibody that binds to phospholipids and/or proteins of the cell membrane in systemic lupus erythematosus (SLE), and can interfere with blood clotting and tests of clotting function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lupus anticoagulant" .

goldbook:12883 a skos:Concept ;
    skos:definition "Antibody directed against single-stranded or double-stranded DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-DNA antibody" .

goldbook:12884 a skos:Concept ;
    skos:definition "Antibody against molecules of the red blood cell, usually against membrane proteins, causing lysis of the red blood cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-erythrocyte antibody" .

goldbook:12885 a skos:Concept ;
    skos:definition "Capable of stimulating lymphocytes to produce antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigenic" .

goldbook:12886 a skos:Concept ;
    skos:definition "Ability of an antigen to bind to a specific antibody or T-cell receptor (TCR); often a measure of its ability to produce immunity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigenicity" .

goldbook:12887 a skos:Concept ;
    skos:definition "Display of antigen as peptide fragments bound to major histocompatibility complex (MHC) molecules on the surface of a cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen presentation" .

goldbook:12888 a skos:Concept ;
    skos:altLabel "APC" ;
    skos:definition "Cell, such as a dendritic cell or macrophage, that is responsible for making antigens accessible to lymphocytes and other immune effector and regulatory cells, making possible specific recognition by receptors on the cell surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen-presenting cell" .

goldbook:12889 a skos:Concept ;
    skos:altLabel "antigen-binding groove" ;
    skos:definition "1) Pocket in a major histocompatibility complex (MHC) molecule that binds antigen for antigen presentation. 2) Hydrophobic binding region in the CD1 protein that anchors lipid-containing antigens causing exposure of the peptide or carbohydrate moiety in a position enabling T-cell receptor (TCR) contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen-presenting groove" .

goldbook:12890 a skos:Concept ;
    skos:definition "Cleavage of protein antigens in antigen-presenting cells (APCs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen processing" .

goldbook:12891 a skos:Concept ;
    skos:definition "Specific antigen-binding receptor on T or B lymphocytes that is transcribed and translated following rearrangements and translocation of V, D, and J genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen receptor" .

goldbook:12892 a skos:Concept ;
    skos:definition "Ability of highly specialized proteins of the immune system to recognize antigens and specifically bind to them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen recognition" .

goldbook:12893 a skos:Concept ;
    skos:definition "Antibody raised against antigenic determinants unique to the variable region of a single antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-idiotypic antibody" .

goldbook:12894 a skos:Concept ;
    skos:definition "Antibody against universal features of a given constant (C) region isotype (such as $\\upgamma\\!$ or $\\upmu\\!$) of one species that is made by immunizing a member of another species with that isotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-isotypic antibody" .

goldbook:12895 a skos:Concept ;
    skos:altLabel "AMA" ;
    skos:definition "Autoantibody producing a mitochondrial staining pattern on sections of various tissues and on tumor cell monolayers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antimitochondrial antibody" .

goldbook:12896 a skos:Concept ;
    skos:altLabel "ANCA" ;
    skos:definition "Antibody against antigens in the cytoplasm of neutrophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antineutrophil cytoplasmic autoantibody" .

goldbook:12897 a skos:Concept ;
    skos:altLabel "ANCA-associated vasculitis" ;
    skos:definition "One of a group of autoimmune systemic vasculitides associated with antineutrophil cytoplasmic autoantibodies (ANCAs), e.g., Wegener granulomatosis (WG), microscopic polyangiitis, and Churg–Strauss syndrome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antineutrophil cytoplasmic autoantibody associated vasculitis" .

goldbook:12898 a skos:Concept ;
    skos:altLabel "ANA",
        "antinuclear factor (ANF)" ;
    skos:definition "Antibody, detectable in the blood, that has the capability of binding to a substance, e.g., DNA, within the nucleus of the cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antinuclear antibody" .

goldbook:12899 a skos:Concept ;
    skos:altLabel "APS" ;
    skos:definition "One of the most common autoimmune diseases, characterized by thrombosis, recurrent spontaneous abortions, and the presence of antiphospholipid antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiphospholipid syndrome" .

goldbook:12900 a skos:Concept ;
    skos:altLabel "SRBC",
        "SRBC Assay",
        "plaque assay" ;
    skos:definition "Test to determine T-cell-dependent antibody response, usually by enzyme-linked immunosorbent assay (ELISA). Sheep red blood cells (SRBCs) are used as an antigen. Often referred to as the plaque assay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-sheep red blood cell IgM response assay" .

goldbook:12901 a skos:Concept ;
    skos:definition "Antibody specific for exotoxins produced by certain microorganisms such as the causative agents of diphtheria and tetanus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antitoxin" .

goldbook:12902 a skos:Concept ;
    skos:definition "Greatly decreased formation of erythrocytes and hemoglobin, usually associated with pronounced granulocytopenia and thrombocytopenia, as a result of hypoplastic or aplastic bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aplastic anemia" .

goldbook:12903 a skos:Concept ;
    skos:definition "Inflammation of a joint or joints." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arthritis" .

goldbook:12904 a skos:Concept ;
    skos:altLabel "Gell and Coombs Type III reaction" ;
    skos:definition "Local antibody-mediated hypersensitivity reaction in which antigen-antibody complexes which fix complement are deposited in the walls of small vessels, often in the skin, causing acute inflammation with an infiltration of neutrophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Arthus reaction" .

goldbook:12905 a skos:Concept ;
    skos:definition "Chronic respiratory disease characterized by bronchoconstriction, excessive mucus secretion, and edema of the pulmonary alveoli, resulting in difficulty in exhaling, wheezing, and cough." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asthma" .

goldbook:12906 a skos:Concept ;
    skos:altLabel "AT" ;
    skos:definition "Disease characterized by staggering gait, multiple disorganized blood vessels, and an immunodeficiency, associated with a protein called ataxia telangiectasia-mutated (ATM), a protein kinase thought to be important in detection of double-stranded DNA breaks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ataxia telangiectasia" .

goldbook:12907 a skos:Concept ;
    skos:definition "Immunoglobulin E (IgE)-mediated hypersensitivity, including asthma, eczema, hay fever, and food allergy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atopic allergy" .

goldbook:12908 a skos:Concept ;
    skos:definition "Inflammation of the skin in atopic individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atopic dermatitis" .

goldbook:12909 a skos:Concept ;
    skos:definition "Chronic skin disease, often localized on flexural surfaces, in individuals with propensity to develop immunoglobulin E (IgE)-mediated allergy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atopic eczema" .

goldbook:12910 a skos:Concept ;
    skos:definition "Of, relating to, or caused by a hereditary predisposition toward developing certain hypersensitivity reactions, such as hay fever, asthma, or chronic urticaria, upon exposure to specific antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atopy" .

goldbook:12911 a skos:Concept ;
    skos:definition "Vaccine made from a live organism that targets cells of the immune system but has been engineered or weakened so as not to cause disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attenuated vaccine" .

goldbook:12912 a skos:Concept ;
    skos:altLabel "exogen allergic alveolitis" ;
    skos:definition "Acute or chronic respiratory distress in cattle, in the absence of toxemia or other systemic signs that are characteristic of other pneumonias." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atypical interstitial pneumonia" .

goldbook:12913 a skos:Concept ;
    skos:definition "Immunoglobulin (Ig) antibody that is directed against the organism’s own antigen(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoantibody" .

goldbook:12914 a skos:Concept ;
    skos:definition "Antigenic component of an individual’s tissues which may be a target of autoimmune responses by autoreactive B cells (autoantibodies) or T cells, including proteins (e.g., enzymes, structural proteins), glycoproteins (e.g., 2-glycoprotein I), nucleic acids, (e.g., double-stranded DNA), phospholipids (e.g., cardiolipin), and glycosphingolipids (e.g., gangliosides)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoantigen" .

goldbook:12915 a skos:Concept ;
    skos:definition "Pertaining to self." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autochthonous" .

goldbook:12916 a skos:Concept ;
    skos:definition "Type of signaling in which a cell secretes a chemical messenger that binds to receptors on the same cell, leading to changes in the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autocrine" .

goldbook:12917 a skos:Concept ;
    skos:definition "Tissue transplant from one site to another in an individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autograft" .

goldbook:12918 a skos:Concept ;
    skos:definition "Of or relating to an immune response by the body against one of its own cells or tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune" .

goldbook:12919 a skos:Concept ;
    skos:definition "Pathological condition resulting when an organism produces antibodies or specific cells that bind to constituents of its own tissues (autoantigens) and cause tissue injury." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune disease" .

goldbook:12920 a skos:Concept ;
    skos:definition "Autoimmune disease in which antibodies initiate complement lysis of erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune hemolytic anemia" .

goldbook:12921 a skos:Concept ;
    skos:altLabel "AIH" ;
    skos:definition "Chronic autoimmune-mediated hepatic inflammation usually characterized by antinuclear (ANA), smooth muscle (SMA)/anti-F-actin, liver-kidney microsomal (LKM), and/or soluble liver antigen (SLA) antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune hepatitis" .

goldbook:12922 a skos:Concept ;
    skos:altLabel "ALPS",
        "Canale–Smith syndrome" ;
    skos:definition "Disease characterized by lymphadenopathy, hepatosplenomegaly, autoimmune cytopenias, and hypergammaglobulinemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune lymphoproliferative syndrome" .

goldbook:12923 a skos:Concept ;
    skos:altLabel "APS" ;
    skos:definition "Heterogeneous group of rare diseases characterized by autoimmune activity against more than one endocrine organ, although non-endocrine organs can also be affected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune polyendocrine syndrome type 1 or 2" .

goldbook:12924 a skos:Concept ;
    skos:altLabel "AIRE" ;
    skos:definition "DNA-binding protein involved in immunoregulation (probably in the establishment and maintenance of tolerance)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune regulator" .

goldbook:12925 a skos:Concept ;
    skos:definition "Immune response to 'self' tissues or components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmunity" .

goldbook:12926 a skos:Concept ;
    skos:definition "Unregulated inflammation without significant levels of autoantibodies or autoactivated T cells, or evidence of infection, but rather caused by genetic disturbance of the mechanisms that initiate and control inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoinflammatory disease" .

goldbook:12927 a skos:Concept ;
    skos:definition "From the same individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autologous" .

goldbook:12928 a skos:Concept ;
    skos:definition "Antibody derived from a specific individual, acting within that individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autologous antibody" .

goldbook:12929 a skos:Concept ;
    skos:definition "Digestion and breakdown in lysosomes of a cell’s own proteins and/or organelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autophagy" .

goldbook:12930 a skos:Concept ;
    skos:definition "Immune response directed at self-antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoreactivity" .

goldbook:12931 a skos:Concept ;
    skos:definition "Small (\\(\\pu{12 kDa}\\)) protein forming part of the structure of major histocompatibility complex (MHC) class I-encoded molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β2-microglobulin" .

goldbook:12932 a skos:Concept ;
    skos:altLabel "B-1/B-2 lymphocytes" ;
    skos:definition "Two major subpopulations of B lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B-1/B-2 cells" .

goldbook:12933 a skos:Concept ;
    skos:definition "Co-stimulatory molecule on the surface of T-cell-activating antigen-presenting cells (APCs), allowing full activation of T cells that are bound to major histocompatibility complex (MHC)-peptide complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B7 molecule" .

goldbook:12934 a skos:Concept ;
    skos:altLabel "BLNK" ;
    skos:definition "Adaptor protein operating in B cells that, upon phosphorylation, recruits signaling molecules to membrane lipid rafts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B-cell linker protein" .

goldbook:12935 a skos:Concept ;
    skos:altLabel "BSF" ;
    skos:definition "Generic name given to B-cell-specific growth and differentiation factors involved in the T-cell-dependent activation of B cells. Many are now identified as specific interleukins (ILs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B-cell stimulatory factor" .

goldbook:12936 a skos:Concept ;
    skos:altLabel "BCR" ;
    skos:definition "Receptor on the surface of a B cell consisting of transmembrane immunoglobulin (Ig) that recognizes a specific antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B-cell receptor" .

goldbook:12937 a skos:Concept ;
    skos:altLabel "B cell" ;
    skos:definition "Bone marrow-derived lymphocyte, expressing an antigen-receptor complex composed of membrane-bound immunoglobulin (Ig) and associated molecular chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B lymphocyte" .

goldbook:12938 a skos:Concept ;
    skos:altLabel "CXCL13" ;
    skos:definition "Chemokine that attracts B cells and activated T cells into the follicles of peripheral lymphoid tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B-lymphocyte chemokine" .

goldbook:12939 a skos:Concept ;
    skos:altLabel "BLIMP-1" ;
    skos:definition "Transcriptional repressor in B cells, that switches off genes required for B cell proliferation in the germinal center, and for class switching and affinity maturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "B-lymphocyte-induced maturation protein 1" .

goldbook:12940 a skos:Concept ;
    skos:altLabel "BCG" ;
    skos:definition "Attenuated Mycobacterium tuberculosis used both as a specific vaccine for tuberculosis and as an adjuvant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bacille Calmette–Guérin" .

goldbook:12941 a skos:Concept ;
    skos:definition "Inbred albino mouse strain, substrains of which produce plasmacytomas on injection with mineral oil, useful for the production of monoclonal antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "BALB/c mouse" .

goldbook:12942 a skos:Concept ;
    skos:altLabel "BLS" ;
    skos:definition "Rare, recessive genetic condition in which the products of one or more genes required to switch on major histocompatibility complex (MHC) class I or MHC class II genes are defective or absent. As a consequence, MHC class I (BLS1) or MHC class II (BLS2) genes are not expressed, leading to severe immunodeficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bare lymphocyte syndrome" .

goldbook:12943 a skos:Concept ;
    skos:definition "Type of granulocyte found in the blood and resembling the tissue mast cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basophil" .

goldbook:12944 a skos:Concept ;
    skos:definition "Loss of granules in basophilic cells, associated with the release of active substances from the cells, characteristic of type I immediate hypersensitivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basophilic degranulation" .

goldbook:12945 a skos:Concept ;
    skos:definition "Member of the Bcl protein family that protects cells from apoptosis by binding to the mitochondrial membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bcl-2" .

goldbook:12946 a skos:Concept ;
    skos:definition "Chronic vasculitis of unknown origin, characterized by ulcerations and skin rash and treated by immunosuppression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Behcet disease" .

goldbook:12947 a skos:Concept ;
    skos:definition "Excess circulating kappa ($\\kappa$)-light chain found in the urine of patients with multiple myeloma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bence–Jones protein" .

goldbook:12948 a skos:Concept ;
    skos:definition "Nonmalignant overproduction of $\\ce{\\upgamma\\!\\mbox{-}globulin}$ by a single clone of lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benign monoclonal gammopathy" .

goldbook:12949 a skos:Concept ;
    skos:definition "Use of small particles, e.g., colloidal gold, as a vehicle for carrying agents (drugs, nucleic acid, etc.) into a cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biolistics" .

goldbook:12950 a skos:Concept ;
    skos:definition "Technique for selection of peptides with high affinity binding to a chosen target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biopanning" .

goldbook:12951 a skos:Concept ;
    skos:definition "Artificially produced hybrid antibody in which each of the two antigen-binding arms is specific for a different antigenic epitope. Such antibodies, which can be produced either by chemical cross-linkage or by recombinant DNA techniques, can be used to link together two different antigens or cells, e.g., a cytotoxic T lymphocyte and a tumor cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bispecific antibody" .

goldbook:12952 a skos:Concept ;
    skos:definition "Immature stage in cell development, before the appearance of the definitive characteristics of the cell; used also as a word termination, as in erythroblast, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blast" .

goldbook:12953 a skos:Concept ;
    skos:definition "Rare familial inflammatory disease characterized by arthritis, dermatitis, and uveitis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Blau syndrome" .

goldbook:12954 a skos:Concept ;
    skos:definition "Antibody that prevents other antibodies from combining with a specific antigen but does not itself produce an immunological response when combined with that antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blocking antibody" .

goldbook:12955 a skos:Concept ;
    skos:altLabel "dyscrasia" ;
    skos:definition "Presence of abnormal material in the blood, usually applied to diseases affecting blood cells or platelets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood dyscrasia" .

goldbook:12956 a skos:Concept ;
    skos:definition "Surface antigen on erythrocytes, detectable with a specific antibody from other individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood group antigen" .

goldbook:12957 a skos:Concept ;
    skos:definition "Physiological interface between maternal and fetal blood circulations that filters out some substances that could harm the fetus while favoring the passage of others such as nutrients." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood–placenta barrier" .

goldbook:12958 a skos:Concept ;
    skos:definition "Disease caused by mutations in a DNA helicase and characterized by low T cell numbers, reduced antibody levels, and an increased susceptibility to respiratory infections, cancer, and radiation damage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bloom syndrome" .

goldbook:12959 a skos:Concept ;
    skos:definition "Soft fatty vascular substance in the cavity of bone where blood cells are formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bone marrow" .

goldbook:12960 a skos:Concept ;
    skos:definition "Transfer of bone marrow from a donor to a recipient whose bone marrow has been ablated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bone marrow transplantation" .

goldbook:12961 a skos:Concept ;
    skos:definition "Portion of an immunizing agent given at a later time to stimulate the effects of a previous dose of the same agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "booster" .

goldbook:12962 a skos:Concept ;
    skos:definition "Vasoactive peptide and inflammatory mediator produced at sites of tissue damage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bradykinin" .

goldbook:12963 a skos:Concept ;
    skos:definition "Test of alteration of lung function induced by inhalation of an allergen or airway-constricting agent, providing information on bronchial responsiveness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bronchial provocation test" .

goldbook:12964 a skos:Concept ;
    skos:altLabel "BA",
        "Buehler test" ;
    skos:definition "Skin sensitization test for contact allergic dermatitis in which a test substance is applied to the shaved flank of a guinea pig in an occlusive patch for 6 h at 0, 1, and 2 weeks, followed by challenge of the untreated flank at 4 weeks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Buehler assay" .

goldbook:12965 a skos:Concept ;
    skos:altLabel "autoimmune bullous skin disease" ;
    skos:definition "Any of several autoimmune diseases characterized by intraepidermal or subepidermal blisters (e.g., pemphigus vulgaris, bullous pemphigoid) and highly specific autoantibodies against components of the desmosome or hemidesmosome (e.g., desmoglein 3, BP180)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune bullous skin disease" .

goldbook:12966 a skos:Concept ;
    skos:definition "Lymphoma caused by Epstein–Barr virus (EBV), occurring mainly in sub-Saharan Africa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Burkitt lymphoma" .

goldbook:12967 a skos:Concept ;
    skos:definition "Primary lymphoid organ in avian species, located at the cloacal-hind gut junction; it is the site of B-cell maturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bursa of Fabricius" .

goldbook:12968 a skos:Concept ;
    skos:definition "Positive or negative effect on the immune system seen after exposure to certain drugs, radiation, and other agents, induced by non-immune mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bystander effect" .

goldbook:12969 a skos:Concept ;
    skos:definition "Suppression of an immune response to an antigen due to tolerance to an unrelated (hence bystander) antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bystander suppression" .

goldbook:12970 a skos:Concept ;
    skos:altLabel "C1 esterase inhibitor" ;
    skos:definition "Plasma glycoprotein secreted primarily by the liver and acting as a serine proteinase inhibitor (serpin), inhibiting C1 components of the complement system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "C1 inhibitor" .

goldbook:12971 a skos:Concept ;
    skos:definition "Cell surface protein of antigen-presenting cells (APCs) involved in presentation of lipopeptide or glycolipid antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD1" .

goldbook:12972 a skos:Concept ;
    skos:definition "Molecule composed of five polypeptide chains associated with the heterodimer T-cell receptor (TCR), forming the T-cell receptor complex (TCR/CD3); CD3 transduces the activating signals when antigen binds to the TCR." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD3" .

goldbook:12973 a skos:Concept ;
    skos:definition "Cell surface antigen belonging to the immunoglobulin (Ig) superfamily of molecules and a marker of T helper cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD4" .

goldbook:12974 a skos:Concept ;
    skos:definition "Subtype of CD4+ regulatory T cell (Treg) with potential role in the regulation of immune homeostasis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD4+/CD25+ T cell" .

goldbook:12975 a skos:Concept ;
    skos:definition "Lymphocyte of type B-1a, which is predominant in fetal lymphoid organs and in neonatal cord blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD5+ B lymphocyte" .

goldbook:12976 a skos:Concept ;
    skos:definition "Cell surface molecule belonging to the immunoglobulin (Ig) superfamily of molecules found, among others, on cytotoxic T cells, which binds to major histocompatibility complex (MHC) class I molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD8" .

goldbook:12977 a skos:Concept ;
    skos:definition "Outdated term for CD8+ cytotoxic T lymphocyte (CTL, Tc). The term 'suppressor T cell' is nowadays reserved for regulatory T cell (Treg)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD8+ T suppressor cell" .

goldbook:12978 a skos:Concept ;
    skos:definition "Low-affinity $\\ce{Fc\\mbox{-}\\upgamma\\! receptor}$ ($\\ce{Fc\\mbox{-}\\upgamma\\!\\mbox{-}RIII}$) expressed mainly on natural killer (NK) cells, granulocytes, and macrophages, mediating antibody-dependent cellular cytotoxicity (ADCC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD16" .

goldbook:12979 a skos:Concept ;
    skos:definition "Low-affinity ${\\rm{Fc\\mbox{-}}}\\upvarepsilon\\!$ receptor induced by interleukin-4 (IL-4) and expressed on see activated B cells and macrophages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD23" .

goldbook:12980 a skos:Concept ;
    skos:definition "\\(\\ce{\\upalpha\\mbox{-}chain}\\) of the interleukin-2 (IL-2) receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD25" .

goldbook:12981 a skos:Concept ;
    skos:altLabel "CD40L" ;
    skos:definition "Essential molecule for normal switching signaling through binding to CD40 on B cells. The interaction of CD40L and CD40 is also critical for optimal T cell function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CD40 ligand" .

goldbook:12982 a skos:Concept ;
    skos:altLabel "CRP" ;
    skos:definition "Serum protein produced by liver cells as part of the acute-phase response, which acts as a stimulus of the classical pathway of complement activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "C-reactive protein" .

goldbook:12983 a skos:Concept ;
    skos:definition "Any of a large family of \\(\\ce{Ca^{2+}}\\)-dependent lectins; members of this family share primary structural homology in their carbohydrate-recognition domains and include many endocytic receptors, many proteoglycans, and all known collectins and selectins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "C-type lectin" .

goldbook:12984 a skos:Concept ;
    skos:definition "Calcium-dependent, transmembrane glycoprotein occurring in cell-cell contacts (desmosomes) and functioning as an adhesion molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cadherin" .

goldbook:12985 a skos:Concept ;
    skos:definition "Any member of a group of immunomodulating drugs that bind to the cytosolic protein cyclophilin of T lymphocytes, thus inhibiting the phosphatase calcineurin, an inducer of interleukin-2 (IL-2) formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calcineurin inhibitor" .

goldbook:12986 a skos:Concept ;
    skos:altLabel "candidosis",
        "moniliasis" ;
    skos:definition "Infection with a fungus of the genus Candida, especially C. albicans, that usually occurs in the skin and mucous membranes of the mouth, respiratory tract, or vagina but may invade the bloodstream, especially in immunocompromised individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "candidiasis" .

goldbook:12987 a skos:Concept ;
    skos:definition "Active process whereby cross-linking of cell surface molecules (e.g., by antibody) leads to aggregation and subsequent migration of the molecules to one pole of the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capping" .

goldbook:12988 a skos:Concept ;
    skos:altLabel "CEA" ;
    skos:definition "Membrane glycoprotein epitope normally present in the fetal gastrointestinal tract and elevated in many patients with various carcinomas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcinoembryonic antigen" .

goldbook:12989 a skos:Concept ;
    skos:definition "1,3-Bis(sn-3-phosphatidyl)-sn-glycerol, the main target of antiphospholipid antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiolipin" .

goldbook:12990 a skos:Concept ;
    skos:definition "Any member of a family of intracellular cysteine proteinases that cleave proteins at specific aspartic acid residues to initiate or promote apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "caspase" .

goldbook:12991 a skos:Concept ;
    skos:definition "Invagination on the cell surface (plasma membrane), enriched in caveolin proteins, cholesterol, and glycosphingolipids, important in various processes including pinocytosis and signal transduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "caveola" .

goldbook:12992 a skos:Concept ;
    skos:altLabel "gluten enteropathy",
        "gluten intolerance",
        "non-tropical sprue" ;
    skos:definition "Autoimmune disorder occurring in genetically predisposed individuals, characterized by immune intolerance to the \\(\\ce{\\upalpha\\mbox{-}gliadin}\\) component of gluten, a protein found in wheat, barley, and rye. Resultant inflammation of the mucosa of the upper small intestine is associated with malabsorption of nutrients and a wasting illness follows from this." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "celiac disease" .

goldbook:12993 a skos:Concept ;
    skos:definition "Lysis of a target cell initiated by a T lymphocyte binding to surface antibodies or antigen-bound major histocompatibility complex (MHC) molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell-mediated cytotoxicity" .

goldbook:12994 a skos:Concept ;
    skos:altLabel "cell-mediated response" ;
    skos:definition "Specific immune response in which T lymphocytes mediate the effects, either through the release of cytokines or through cytotoxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell-mediated immune response" .

goldbook:12995 a skos:Concept ;
    skos:altLabel "CMI",
        "cellular immunity" ;
    skos:definition "Immune response mediated by antigen-specific T lymphocytes, either through the release of cytokines or through cytotoxicity, in contrast with humoral immunity, which is antibody-mediated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell-mediated immunity" .

goldbook:12996 a skos:Concept ;
    skos:definition "Specific immunological tolerance due to the induction of lymphocyte apoptosis or anergy within the primary lymphoid organs (bone marrow in the case of B cell tolerance and the thymus for T cells)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "central tolerance" .

goldbook:12997 a skos:Concept ;
    skos:definition "Induction or evaluation of an immune response in an organism by administration of a specific antigen to which it has been sensitized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "challenge" .

goldbook:12998 a skos:Concept ;
    skos:altLabel "CMA" ;
    skos:definition "Type of autophagy targeting only those proteins that are recognized by the binding of an hsc70-containing chaperone/co-chaperone complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chaperone-mediated autophagy" .

goldbook:12999 a skos:Concept ;
    skos:definition "Biologically active substance, such as a chemokine or anaphylatoxin, that induces a concentration gradient-dependent movement of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemotactic factor" .

goldbook:13000 a skos:Concept ;
    skos:definition "1) General. Movement of an organism or cell along a concentration gradient of a chemical. 2) In immunology. Movement of cells up a concentration gradient of a chemical attractant (chemotactic factor), such as a chemokine or other cytokine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemotaxis" .

goldbook:13001 a skos:Concept ;
    skos:altLabel "chemovar" ;
    skos:definition "Character of a plant or microorganism based on a metabolite distinct from that found in other members of the same species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemotype" .

goldbook:13002 a skos:Concept ;
    skos:definition "Acne-like eruption caused by exposure to certain chlorinated organic substances such as polychlorinated biphenyls or 2,3,7,8-tetrachlorodibenzo[1,4]dioxin [2,3,7,8-tetrachlorooxanthrene] and other polychlorinated dibenzodioxins and furans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chloracne" .

goldbook:13003 a skos:Concept ;
    skos:definition "Method used in immunotoxicology to quantify the toxic effect of a substance on leukocytes by measuring uptake of \\(\\ce{^{51}Cr{-}labeled}\\) chromate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromate uptake assay" .

goldbook:13004 a skos:Concept ;
    skos:altLabel "<sup>51</sup>Cr release assay" ;
    skos:definition "Immunotoxicity assay that can be used to assess either natural killer (NK) cell or cytotoxic T cell activity or macrophage activity. When incubated with \\(\\ce{^{51}Cr{-}labeled}\\) chicken red blood cells (cRBCs), NK and cytotoxic T cells lyse the cRBC and thus induce the release of \\(\\ce{^{51}Cr}\\) into the medium. In contrast, macrophages phagocytose cRBC, and are then lysed to assess the amount of \\(\\ce{^{51}Cr}\\) they have taken up." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromium release assay" .

goldbook:13005 a skos:Concept ;
    skos:definition "Disease of airways, skin, eyes and other organs, resulting from repeated or continuous exposure to an allergen and involving immunoglobulin E (IgE) formation, IgE-induced histamine-release from mast cells, liberation of mediators such as cytokines and prostaglandins, and local inflammation characterized by infiltrating leucocytes; it results in augmented susceptibility to the allergen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic allergic inflammation" .

goldbook:13006 a skos:Concept ;
    skos:definition "Immunodeficiency disease in which multiple granulomas form as a result of defective elimination of bacteria by phagocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic granulomatous disease" .

goldbook:13007 a skos:Concept ;
    skos:altLabel "CLL" ;
    skos:definition "B cell tumor found in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic lymphocytic leukemia" .

goldbook:13008 a skos:Concept ;
    skos:altLabel "CML" ;
    skos:definition "Cancer characterized by overgrowth of the bone marrow with malignant white blood cells, usually exhibiting a chromosomal abnormality (Philadelphia chromosome), which causes uncontrolled proliferation of cells that are released into peripheral blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic myelogenous leukemia" .

goldbook:13009 a skos:Concept ;
    skos:altLabel "chronic graft rejection" ;
    skos:definition "Immunologically triggered reaction occurring in a transplanted organ or tissue, leading to progressive destruction and finally failure of the transplanted organ occurring two months to many years after transplantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic rejection" .

goldbook:13010 a skos:Concept ;
    skos:definition "Process by which a B cell changes the class but not specificity of a given antibody it produces, e.g., switching from an immunoglobulin M (IgM) to an immunoglobulin G (IgG) antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "class switching" .

goldbook:13011 a skos:Concept ;
    skos:definition "Activation pathway involving complement components C1, C2, and C4 which, following fixation of C1q, e.g., by antigen-antibody complexes, produces the classical pathway C3 convertase C4b2a." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "classical pathway" .

goldbook:13012 a skos:Concept ;
    skos:definition "Form of self-tolerance developing as a consequence of negative selection during thymic selection processes. Clones of thymocytes whose antigen receptors [T-cell receptors (TCRs)] bind with high affinity to self-antigens in association with major histocompatibility complex (MHC) molecules are inactivated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonal anergy" .

goldbook:13013 a skos:Concept ;
    skos:definition "Process by which contact with antigen (e.g., self-antigen) at an early stage of lymphocyte differentiation leads to cell death by apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonal deletion" .

goldbook:13014 a skos:Concept ;
    skos:definition "Proliferation of B lymphocytes and T lymphocytes activated by clonal selection in order to produce a clone of identical cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonal expansion" .

goldbook:13015 a skos:Concept ;
    skos:altLabel "clonal ignorance" ;
    skos:definition "Failure of B or T cells expressing anti-self-receptors to interact with antigen (e.g., by low valency, low concentration, or sequestration of antigens; low receptor avidity; or lack of co-stimulatory molecules)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonal indifference" .

goldbook:13016 a skos:Concept ;
    skos:altLabel "selection theory (in immunology)" ;
    skos:definition "Selection and activation by antigen of a lymphocyte, bearing a complementary receptor, which then proliferates to form an expanded clone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonal selection" .

goldbook:13017 a skos:Concept ;
    skos:altLabel "CD" ;
    skos:definition "Cluster of antigens representing a cell surface marker with which antibodies react. Not to be confused with cluster of differentiation (CD) antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster determinant" .

goldbook:13018 a skos:Concept ;
    skos:altLabel "CD" ;
    skos:definition "Any of a family of molecular markers on cell surfaces that may be used operationally to define phenotype, origin, and activation state of the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster of differentiation antigen" .

goldbook:13019 a skos:Concept ;
    skos:definition "Proteolytic cascade of plasma enzymes that triggers blood clotting when blood vessels are damaged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coagulation system" .

goldbook:13020 a skos:Concept ;
    skos:definition "Helper T lymphocyte (Th) primed by the same antigen as the B cell to which it gives help." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cognate T cell" .

goldbook:13021 a skos:Concept ;
    skos:definition "Autoantibody that reacts optimally at low temperatures (\\(\\pu{{0}{-}{5} ^{\\circ}C}\\)) with surface antigens of erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cold autoantibody type" .

goldbook:13022 a skos:Concept ;
    skos:definition "Autoimmune model of rheumatoid arthritis (RA), arising from combined cellular immunity and humoral immunity against collagen type II, and characterized by rapid and severe erosions of cartilage and bone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collagen arthritis" .

goldbook:13023 a skos:Concept ;
    skos:definition "Any member of a structurally related family of calcium-dependent carbohydrate-binding proteins or lectins containing collagen-like sequences, e.g., mannose-binding lectin (MBL)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collectin" .

goldbook:13024 a skos:Concept ;
    skos:altLabel "CSF" ;
    skos:definition "Factor that permits the proliferation and differentiation of hematopoietic cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colony-stimulating factor" .

goldbook:13025 a skos:Concept ;
    skos:definition "Component of antibody and T-cell receptor (TCR) diversity that is generated by the recombination of variable (V), diversity (\\(D\\), for immunoglobulin heavy chains, and for TCR \\(\\upbeta\\) and \\(\\ce{\\updelta\\ chains}\\)), and joining (J) gene segments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combinatorial diversity" .

goldbook:13026 a skos:Concept ;
    skos:definition "Merging of DNA segments generating new genetic information." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combinatorial joining" .

goldbook:13027 a skos:Concept ;
    skos:definition "Relatively common deficiency in antibody production, of unknown pathogenesis but strongly associated with genes mapping within the major histocompatibility complex (MHC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "common variable immunodeficiency" .

goldbook:13028 a skos:Concept ;
    skos:definition "Method of measuring an antigen in a sample using a labeled species of the antigen as a competitive inhibitor of its binding in a specific antigen–antibody reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competitive inhibition assay" .

goldbook:13029 a skos:Concept ;
    skos:altLabel "CDR" ;
    skos:definition "Hypervariable amino acid sequence within antibody and T-cell receptor (TCR) variable (V) regions, which interacts with complementary amino acids on the antigen or major histocompatibility complex (MHC)–peptide complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complementarity-determining region" .

goldbook:13030 a skos:Concept ;
    skos:definition "Congenital deficiency in any of the various components of the complement system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complement deficiency" .

goldbook:13031 a skos:Concept ;
    skos:definition "Physiological reaction to the presence of a foreign microorganism in which a cascade of enzymatic reactions, triggered by molecular features of the microorganism, result in lysis or phagocytosis of the foreign material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complement reaction" .

goldbook:13032 a skos:Concept ;
    skos:altLabel "CR" ;
    skos:definition "Cell-surface protein that recognizes and binds complement proteins that have bound an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complement receptor" .

goldbook:13033 a skos:Concept ;
    skos:definition "Group of serum proteins with the capacity to interact with each other when activated in a chain reaction which results in formation of a lytic complex and the release of several biologically active peptides of low relative molecular mass (anaphylatoxins)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complement system" .

goldbook:13034 a skos:Concept ;
    skos:altLabel "conA" ;
    skos:definition "Hemagglutinin, isolated from jack bean (Canavalia ensiformis) meal, which reacts with polyglucosans in the blood of mammals, causing agglutination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concanavalin A" .

goldbook:13035 a skos:Concept ;
    skos:altLabel "discontinuous epitope" ;
    skos:definition "Epitope on a protein antigen formed from several separate regions in the primary sequence of a protein brought together by protein folding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational epitope" .

goldbook:13036 a skos:Concept ;
    skos:definition "Differing at a single genetic locus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congenic" .

goldbook:13037 a skos:Concept ;
    skos:altLabel "allergic conjunctivitis" ;
    skos:definition "Irritation of the ocular conjunctiva, resulting from the activation of conjunctival mast cells by airborne allergens such as pollens or house dust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allergic conjunctivitis" .

goldbook:13038 a skos:Concept ;
    skos:altLabel "C gene" ;
    skos:definition "Gene that encodes the constant (C) region of immunoglobulin (Ig) chains or T-cell receptor (TCR) chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constant gene" .

goldbook:13039 a skos:Concept ;
    skos:altLabel "C region",
        "constant (C) region" ;
    skos:definition "Part of an immunoglobulin (Ig) or T-cell receptor (TCR) that is relatively constant in amino acid sequence among different Ig or TCR molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constant region" .

goldbook:13040 a skos:Concept ;
    skos:definition "Substance that causes a skin hypersensitivity reaction by direct contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact allergen" .

goldbook:13041 a skos:Concept ;
    skos:definition "Skin inflammation that occurs when the skin’s surface comes in contact with a substance originating outside the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact dermatitis" .

goldbook:13042 a skos:Concept ;
    skos:definition "Immune response following skin contact with an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact hypersensitivity" .

goldbook:13043 a skos:Concept ;
    skos:definition "State of immunological sensitization in which an eczematous epidermal reaction may occur when a hapten is applied to the skin of a sensitized individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact sensitivity" .

goldbook:13044 a skos:Concept ;
    skos:definition "Urticaria provoked by contact with inducing agents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact urticaria" .

goldbook:13045 a skos:Concept ;
    skos:definition "Predominant type of dendritic cell active in antigen presentation to and activation of naïve T cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conventional dendritic cell" .

goldbook:13046 a skos:Concept ;
    skos:definition "Independent evolution of similarity between molecules or between species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "convergent evolution" .

goldbook:13047 a skos:Concept ;
    skos:definition "Enzyme activity that converts complement protein into its reactive form by cleaving it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "convertase" .

goldbook:13048 a skos:Concept ;
    skos:altLabel "direct Coombs test",
        "direct antiglobulin test (DAT)",
        "indirect Coombs test",
        "indirect antiglobulin test (IAT)" ;
    skos:definition "Diagnostic test using anti-immunoglobulin (Ig) to agglutinate antibody-coated erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Coombs test" .

goldbook:13049 a skos:Concept ;
    skos:definition "Cell surface protein receptor that recognizes a substance bound to a primary receptor, and binds to a signaling molecule that thereby enhances the activity of another receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coreceptor" .

goldbook:13050 a skos:Concept ;
    skos:definition "Any of the family of steroid molecules that are produced in the adrenal cortex, or their synthetic analogs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corticosteroid" .

goldbook:13051 a skos:Concept ;
    skos:definition "Delivery of a second signal, in addition to that of antigen binding or antigen presentation, that is required for lymphocyte proliferation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-stimulation" .

goldbook:13052 a skos:Concept ;
    skos:definition "Hypothesis that all types of infection early in childhood may protect against the development of atopy by driving the production of cytokines such as interleukin-10 (IL-10) and transforming growth factor $\\ce{\\upbeta\\!}$ ($\\ce{TGF\\mbox{-}\\upbeta\\!}$), which downregulate both Th1 and Th2 responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter-regulation hypothesis" .

goldbook:13053 a skos:Concept ;
    skos:altLabel "Crohn's disease" ;
    skos:definition "Chronic inflammatory bowel disease (IBD) thought to result from an abnormal overresponsiveness to commensal gut flora." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Crohn disease" .

goldbook:13054 a skos:Concept ;
    skos:definition "1) Test for determining the compatibility between the blood of a donor and that of a recipient before transfusion; the clumping of erythrocytes indicates incompatibility. 2) Test for determining tissue compatibility between a transplant donor and the recipient before transplantation, in which the recipient’s serum is tested for antibodies that may react with the lymphocytes or other cells of the donor. 3) Process of performing one of these tests." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-matching" .

goldbook:13055 a skos:Concept ;
    skos:altLabel "cross-priming" ;
    skos:definition "Activation of CD8+ lymphocytes by the presentation of exogenous antigens in association with major histocompatibility complex (MHC) class I molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-presentation" .

goldbook:13056 a skos:Concept ;
    skos:definition "Antibody that is able to react with an antigen that did not specifically stimulate its production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-reacting antibody" .

goldbook:13057 a skos:Concept ;
    skos:definition "Antigen that is able to react with an antibody induced by a different antigen. Note: The two antigens may share the same antigenic determinants or carry determinants that are sufficiently alike stereochemically to enable the antibody to react with both. Antigen that has an identical structure in two strains of microorganism, so that antibody raised against one strain will react with the other strain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-reacting antigen" .

goldbook:13058 a skos:Concept ;
    skos:definition "State of immunological hypersensitivity to one substance that predisposes an individual to sensitivity to other substances that are related in chemical structure (cross-reacting antigens)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross sensitivity" .

goldbook:13059 a skos:Concept ;
    skos:definition "State of immunological tolerance to one substance produced by priming an animal with another substance that bears a cross-reacting antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-tolerance" .

goldbook:13060 a skos:Concept ;
    skos:definition "Immunoglobulin (Ig) that forms insoluble aggregates at temperatures below body temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryoglobulin" .

goldbook:13061 a skos:Concept ;
    skos:definition "Cutaneous or systemic vasculitis caused by cold-labile proteins (cryoglobulins, cryofibrinogen) that leads to increased viscosity, protein precipitation or gelatinification, complement activation, and endothelial cell damage, especially in the cold." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryoglobulinemic vasculitis" .

goldbook:13062 a skos:Concept ;
    skos:definition "Epitope that cannot be recognized by a lymphocyte receptor until the antigen has been broken down and processed or modified by hapten binding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryptic epitope" .

goldbook:13063 a skos:Concept ;
    skos:altLabel "CLA" ;
    skos:definition "Cell-surface molecule that is involved in lymphocyte homing to the skin in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cutaneous lymphocyte antigen" .

goldbook:13064 a skos:Concept ;
    skos:altLabel "mycosis fungoides" ;
    skos:definition "Malignant growth of T cells that home to the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cutaneous T-cell lymphoma" .

goldbook:13065 a skos:Concept ;
    skos:definition "Any of a group of soluble small proteins released from a variety of cells, typically of the immune system, that affect cell behavior in an autocrine or paracrine fashion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytokine" .

goldbook:13066 a skos:Concept ;
    skos:altLabel "<i>in vivo</i> cytokine capture assay (IVCCA)" ;
    skos:definition "Method to detect cytokine release by injecting an animal with a neutralizing biotinylated antibody to the cytokine, which inhibits its utilization and allows its accumulation in the blood. Recovered cytokineantibody complexes are then measured in an enzyme-linked immunosorbent assay (ELISA) with an antibody to a second epitope on the cytokine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytokine capture assay" .

goldbook:13067 a skos:Concept ;
    skos:definition "Characteristic pattern of cytokine production associated with a defined immunological state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytokine profile" .

goldbook:13068 a skos:Concept ;
    skos:altLabel "CRA" ;
    skos:definition "Method of quantifying cytokines released by viable cells, using cytokine-specific antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytokine release assay" .

goldbook:13069 a skos:Concept ;
    skos:altLabel "immune cytolysis" ;
    skos:definition "1) Cell lysis caused by a lesion produced by the action of complement proteins on the antibody-coated plasma membrane of a cell. 2) Cell lysis following plasma membrane reaction with perforins released by natural killer (NK) cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune cytolysis" .

goldbook:13070 a skos:Concept ;
    skos:definition "Decrease in the number of one or more types of blood cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytopenia" .

goldbook:13071 a skos:Concept ;
    skos:definition "Causing damage to cell structure or function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotoxic" .

goldbook:13072 a skos:Concept ;
    skos:altLabel "CD8+ T cell",
        "cytolytic T cell",
        "cytotoxic T cell",
        "killer T cell" ;
    skos:definition "Any of a subset of T lymphocytes bearing the CD8 surface marker and able to kill target cells [infected somatic or tumor cells, recognized by the antigen receptor complex (TCR/CD3)] after induction of a specific immune response to the antigens bound to major histocompatibility complex (MHC) class I molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotoxic T lymphocyte" .

goldbook:13073 a skos:Concept ;
    skos:altLabel "CD152",
        "CTLA-4" ;
    skos:definition "High affinity receptor for B7 molecules expressed on T cells, binding of which inhibits T cell activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotoxic T lymphocyte antigen 4" .

goldbook:13074 a skos:Concept ;
    skos:altLabel "CTL" ;
    skos:definition "Assay based on quantitation of cell death caused by sensitized lymphocytes or splenocytes cultured with a fixed number of tumor or other target cells that have been prelabeled with \\(\\ce{^{51}Cr}\\). The \\(\\ce{^{51}Cr}\\) is taken up and reversibly binds to cytosolic proteins. When these target cells are incubated with sensitized lymphocytes, the target cells are killed and the \\(\\ce{^{51}Cr}\\) is released." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotoxic T lymphocyte assay" .

goldbook:13075 a skos:Concept ;
    skos:definition "Substance with a specific toxic effect on certain cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotoxin" .

goldbook:13076 a skos:Concept ;
    skos:altLabel "CD205" ;
    skos:definition "Surface antigen characteristic of dendritic cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DEC-205" .

goldbook:13077 a skos:Concept ;
    skos:altLabel "DNA immunization" ;
    skos:definition "Injection of DNA into muscle, followed by its transcription and translation into a protein or proteins that elicit antibody and T-cell responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DNA vaccination" .

goldbook:13078 a skos:Concept ;
    skos:definition "Major histocompatibility complex (MHC) class II molecules occurring on human B lymphocytes and antigen-presenting cells (APCs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DP, DQ, and DR molecules" .

goldbook:13079 a skos:Concept ;
    skos:definition "Hypothesis that suggests it is not foreignness of a molecule per se but rather its ability to cause cell damage or stress that induces an immune response. Often implicated in causation of idiosyncratic drug reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "danger hypothesis" .

goldbook:13080 a skos:Concept ;
    skos:altLabel "death ligand receptor" ;
    skos:definition "Cell-surface receptor whose binding to extracellular ligands stimulates apoptosis in the receptor-bearing cell through the extrinsic pathway." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "death receptor" .

goldbook:13081 a skos:Concept ;
    skos:definition "Protein-interaction domain originally discovered in proteins involved in programmed cell death or apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "death domain" .

goldbook:13082 a skos:Concept ;
    skos:altLabel "CD55",
        "DAF" ;
    skos:definition "Cell-surface molecule that protects cells from lysis by complement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decay-accelerating factor" .

goldbook:13083 a skos:Concept ;
    skos:definition "Any member of a family of oligopeptides made within the body, notably by neutrophils and macrophages, and having potent antimicrobial properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "defensin" .

goldbook:13084 a skos:Concept ;
    skos:altLabel "mast cell degranulation" ;
    skos:definition "Cell reaction that releases antimicrobial cytotoxic molecules and other substances (e.g., histamine) from secretory vesicles called granules found inside some cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degranulation" .

goldbook:13085 a skos:Concept ;
    skos:altLabel "DTH",
        "Gell and Coombs Type IV reaction" ;
    skos:definition "Form of T cell-mediated immunity in which the ultimate effector cell is the activated mononuclear phagocyte (macrophage); the response of DTH appears fully over \\(\\pu{24}\\) to \\(\\pu{48 h}\\). Previous exposure is required." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed-type hypersensitivity" .

goldbook:13086 a skos:Concept ;
    skos:altLabel "DTH assay" ;
    skos:definition "In vivo assay of cell-mediated immune response, elicited by antigen in the skin and mediated by CD4+ Th1 cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed-type hypersensitivity assay" .

goldbook:13087 a skos:Concept ;
    skos:altLabel "interdigitating dendritic cell",
        "interdigitating reticular cell" ;
    skos:definition "Ameboid cell that is major histocompatibility complex (MHC) class II-positive, Fc receptor-negative, and presents processed antigens to T cells in the T-cell areas of secondary lymphoid tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dendritic cell" .

goldbook:13088 a skos:Concept ;
    skos:definition "Precipitation of immune complex in organs and tissues, often causing local inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune complex deposition" .

goldbook:13089 a skos:Concept ;
    skos:definition "Inflammation of the skin showing redness, swelling, infiltration, scaling, and sometimes vesicles and blisters: contact dermatitis is due to local exposure and may be caused by irritation, allergy, or photocontact dermatitis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dermatitis" .

goldbook:13090 a skos:Concept ;
    skos:definition "Disease characterized by the presence of inflammation of the skin and muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dermatomyositis" .

goldbook:13091 a skos:Concept ;
    skos:definition "Generally transient state of specific non-reactivity in a previously sensitized individual, resulting from repeated antigen exposures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desensitization" .

goldbook:13092 a skos:Concept ;
    skos:altLabel "diabetes mellitus",
        "insulin-dependent",
        "insulin-dependent diabetes mellitus (IDDM)",
        "type 1 diabetes mellitus" ;
    skos:definition "Disease in which the \\(\\ce{\\upbeta\\ cells}\\) of the pancreatic islets of Langerhans are destroyed with the result that no insulin is produced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diabetes mellitus type 1" .

goldbook:13093 a skos:Concept ;
    skos:definition "Movement of blood cells, particularly leukocytes, from the blood across blood vessel walls into tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diapedesis" .

goldbook:13094 a skos:Concept ;
    skos:definition "Reported blood count that distinguishes the percentages of the different blood cells present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential" .

goldbook:13095 a skos:Concept ;
    skos:definition "Utilization and splicing of different exons from a primary RNA transcript in order to generate different mRNA sequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential splicing" .

goldbook:13096 a skos:Concept ;
    skos:definition "Cell surface molecule expressed at a particular stage of development or on cells of a given lineage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differentiation antigen" .

goldbook:13097 a skos:Concept ;
    skos:altLabel "ADAM33" ;
    skos:definition "Member of the ADAM (A Disintegrin And Metalloproteinase domain) family of transmembrane proteins, possibly related to asthma susceptibility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disintegrin and metalloproteinase domain-containing protein 33" .

goldbook:13098 a skos:Concept ;
    skos:altLabel "D gene" ;
    skos:definition "Small segment of immunoglobulin (Ig) heavy-chain or T-cell receptor DNA between the variable (V) gene and joining (J) gene segments, coding for the third hypervariable region of the receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diversity gene" .

goldbook:13099 a skos:Concept ;
    skos:definition "Structural element of a polypeptide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "domain" .

goldbook:13100 a skos:Concept ;
    skos:definition "Two-dimensional graphical representation of individual data points." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dot plot" .

goldbook:13101 a skos:Concept ;
    skos:definition "Immature T cell in the thymus that lacks expression of the two coreceptors, CD4 and CD8." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-negative cell" .

goldbook:13102 a skos:Concept ;
    skos:definition "Immature T cell in the thymus that is characterized by expression of both CD4 and CD8 coreceptor proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-positive cell" .

goldbook:13103 a skos:Concept ;
    skos:definition "Lymph node that is downstream of a site of infection and thus receives antigens and microbes from the site via the lymphatic system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "draining lymph node" .

goldbook:13104 a skos:Concept ;
    skos:definition "Context: ocular; Test for potential to cause irritation to the eye in which the test substance is applied directly to the eye of restrained rabbits. Note: Widely criticized as unethical. Now often replaced with an acute eye irritation test using cadaveric chicken eyes. Context: skin; Test for the potential of a material to cause irritation or corrosion following local dermal application. Generally performed with rabbits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Draize test" .

goldbook:13105 a skos:Concept ;
    skos:definition "Immune-mediated idiosyncratic drug reaction against self-antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug-induced autoimmunity" .

goldbook:13106 a skos:Concept ;
    skos:altLabel "lupus-like syndrome" ;
    skos:definition "Idiosyncratic drug reaction similar in character to systemic lupus erythematosus (SLE) and having antinuclear antibodies (ANA), but generally milder in nature and resolving when drug exposure is discontinued." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug-induced lupus" .

goldbook:13107 a skos:Concept ;
    skos:definition "Acute or chronic skin inflammation with erythema, papules, vesicles, pustules, scales, crusts, or scabs, alone or in combination, of varied etiology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eczema" .

goldbook:13108 a skos:Concept ;
    skos:definition "Cell that carries out an immune function, e.g., cytokine release, cytotoxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effector cell" .

goldbook:13109 a skos:Concept ;
    skos:definition "Production of a cell-mediated or antibody-mediated allergic response by exposure of a sensitized individual to an allergen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elicitation" .

goldbook:13110 a skos:Concept ;
    skos:definition "Produced within or caused by factors within an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endogenous" .

goldbook:13111 a skos:Concept ;
    skos:definition "Intracellular smooth surfaced vesicle in which endocytosed material passes on its way to the lysosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endosome" .

goldbook:13112 a skos:Concept ;
    skos:definition "Pathogenic cell wall-associated lipopolysaccharides of Gram-negative bacteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endotoxin" .

goldbook:13113 a skos:Concept ;
    skos:definition "Antibody that binds to an antibody-antigen complex or idiotypic-anti-idiotypic antibody complex and strengthens the interaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enhancing antibody" .

goldbook:13114 a skos:Concept ;
    skos:definition "Toxin affecting intestinal cells and thus causing food poisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enterotoxin" .

goldbook:13115 a skos:Concept ;
    skos:altLabel "ELISA" ;
    skos:definition "Procedure for detection or quantitation of an antibody or antigen using a ligand (e.g., an anti-immunoglobulin) conjugated to an enzyme that changes the color of a substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme-linked immunosorbent assay" .

goldbook:13116 a skos:Concept ;
    skos:altLabel "ELISPOT",
        "ELISPOT assay" ;
    skos:definition "Adaptation of enzyme-linked immunosorbent assay (ELISA) in which cells are placed over antibodies or antigens attached to a plastic surface. The antigen or antibody traps the cells’ secreted products, which can then be detected using an enzyme-coupled antibody that cleaves a colorless substrate to make a localized colored spot. This allows quantitation of the number of cells producing a given product such as a cytokine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme-linked immunospot assay" .

goldbook:13117 a skos:Concept ;
    skos:definition "Circulating granular leukocyte (granulocyte) having prominent granules that stain specifically by eosin and containing numerous lysosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eosinophil" .

goldbook:13118 a skos:Concept ;
    skos:altLabel "ECF-A" ;
    skos:definition "Cytokine that facilitates anaphylaxis and attracts eosinophils during substrate release by mast cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eosinophil chemotactic factor of anaphylaxis" .

goldbook:13119 a skos:Concept ;
    skos:altLabel "CCL11" ;
    skos:definition "CC chemokine that acts predominantly on eosinophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eotaxin" .

goldbook:13120 a skos:Concept ;
    skos:altLabel "antigen retrieval" ;
    skos:definition "Treatment of denatured antigen with heat or other agents in order to regenerate (unmask) lost antibody-binding capacity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epitope retrieval" .

goldbook:13121 a skos:Concept ;
    skos:definition "Increase in the number of epitopes targeted by autoantibodies and/or T cells. The epitopes may be on the same autoantigen (intramolecular epitope spreading) and/or on other autoantigens (intermolecular epitope spreading)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epitope spreading" .

goldbook:13122 a skos:Concept ;
    skos:altLabel "EBV" ;
    skos:definition "Virus responsible for infectious mononucleosis and Burkitt’s lymphoma. This virus is used to immortalize human B lymphocytes in vitro." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Epstein–Barr virus" .

goldbook:13123 a skos:Concept ;
    skos:definition "Ratio of antibody to antigen at which immunoprecipitation of the reactants is virtually complete." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalence" .

goldbook:13124 a skos:Concept ;
    skos:definition "Range of concentrations of antigen and antibody in which neither is in significant excess in a precipitin reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalence zone" .

goldbook:13125 a skos:Concept ;
    skos:definition "Redness of the skin produced by congestion of the capillaries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erythema" .

goldbook:13126 a skos:Concept ;
    skos:definition "Two potentially disabling or fatal blood disorders in infants: Rhesus (Rh) factor incompatibility disease and ABO blood group incompatibility disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erythroblastosis fetalis" .

goldbook:13127 a skos:Concept ;
    skos:definition "Red blood cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erythrocyte" .

goldbook:13128 a skos:Concept ;
    skos:definition "Erythrocyte production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erythropoiesis" .

goldbook:13129 a skos:Concept ;
    skos:definition "Glycoprotein hormone that stimulates the production of erythrocytes by stem cells in bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erythropoietin" .

goldbook:13130 a skos:Concept ;
    skos:definition "Member of a class of proteins insoluble in water but soluble in saline solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "euglobulin" .

goldbook:13131 a skos:Concept ;
    skos:definition "Release of the content of an intracellular vesicle to the exterior of the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exocytosis" .

goldbook:13132 a skos:Concept ;
    skos:definition "Pathogenic protein secreted by bacteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exotoxin" .

goldbook:13133 a skos:Concept ;
    skos:definition "Movement of cells or fluid from within blood vessels to the surrounding tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extravasation" .

goldbook:13134 a skos:Concept ;
    skos:definition "Extravascular fluid containing proteins and cellular debris that accumulates during inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exudate" .

goldbook:13135 a skos:Concept ;
    skos:definition "Monovalent antigen-binding (‘ab’) fragment obtained following papain digestion of immunoglobulin (Ig). It consists of an intact light chain and the N-terminal VH and C H1 domains of the heavy chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fab fragment" .

goldbook:13136 a skos:Concept ;
    skos:definition "Bivalent antigen-binding fragment obtained following pepsin digestion of immunoglobulin. Consists of both light chains and the N-terminal part of both heavy chains linked by disulfide bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "F(ab')2 fragment" .

goldbook:13137 a skos:Concept ;
    skos:altLabel "Fc region" ;
    skos:definition "Crystallizable, non-antigen-binding fragment of an immunoglobulin (Ig) molecule obtained following papain digestion. Consists of the C-terminal portion of both heavy chains, responsible for binding to Fc receptors and complement factor C1q." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fc fragment" .

goldbook:13138 a skos:Concept ;
    skos:definition "Receptors expressed on a wide range of cells, interacting with the Fc portion of immunoglobulins (Ig) belonging to various isotypes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fc receptor" .

goldbook:13139 a skos:Concept ;
    skos:definition "Heavy chain portion of an immunoglobulin (Ig) N-terminal to the papain hydrolysis site, after reduction and separation of the light chain portion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fd fragment" .

goldbook:13140 a skos:Concept ;
    skos:definition "Formyl-methionyl-leucyl-phenylalanine, a chemoattractant (see chemotactic factor, chemotaxis) derived from degradation of bacterial or mitochondrial proteins. It causes neutrophil activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fMLP peptide" .

goldbook:13141 a skos:Concept ;
    skos:definition "Transcription repressor that is specifically expressed in CD4+CD25+ T cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Foxp3" .

goldbook:13142 a skos:Concept ;
    skos:definition "Variable (V) region fragment of an antibody heavy chain or light chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fv fragment" .

goldbook:13143 a skos:Concept ;
    skos:altLabel "FCAS" ;
    skos:definition "Episodic autoinflammatory disease, induced by exposure to cold, and caused by mutations in the gene CSA1, encoding cryopyrin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "familial cold autoinflammatory syndrome" .

goldbook:13144 a skos:Concept ;
    skos:altLabel "FHL" ;
    skos:definition "Progressive and potentially lethal inflammatory disease caused by an inherited deficiency of perforin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "familial hemophagocytic lymphohistiocytosis" .

goldbook:13145 a skos:Concept ;
    skos:definition "Hypersensitivity disease caused by the interaction of immunoglobulin G (IgG) antibodies with large amounts of an inhaled allergen in the alveolar wall of the lung, causing alveolar wall inflammation and compromising gas exchange." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "farmer’s lung" .

goldbook:13146 a skos:Concept ;
    skos:altLabel "CD95" ;
    skos:definition "Member of the tumor necrosis factor (TNF) receptor gene family. Engagement of Fas on the surface of the cell by the Fas ligand (CD178) present on cytotoxic cells can trigger apoptosis in the Fas-bearing target cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fas" .

goldbook:13147 a skos:Concept ;
    skos:definition "Human cancer cell antigens, which cross-react serologically with antigens normally expressed by embryonic tissue, e.g., carcinoembryonic antigen (CEA), or $\\ce{\\upalpha\\!\\mbox{-}fetoprotein}$ (AFP)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetal antigens" .

goldbook:13148 a skos:Concept ;
    skos:definition "Lack of rejection of a fetal allograft carrying paternal major histocompatibility complex (MHC) and minor histocompatibility antigens that differ from those of the mother." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetal tolerance" .

goldbook:13149 a skos:Concept ;
    skos:definition "Enzymatic lysis of a fibrin clot." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibrinolysis" .

goldbook:13150 a skos:Concept ;
    skos:definition "Pertaining to, characterized by, or causing the breakdown of fibrin (fibrinolysis), usually by the action of plasmin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibrinolytic" .

goldbook:13151 a skos:Concept ;
    skos:definition "Surface tissues, notably the skin, respiratory tract, and gastrointestinal tract." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "first line of defence" .

goldbook:13152 a skos:Concept ;
    skos:definition "Method of sorting and measuring types of cells by fluorescent labeling of markers on the surface of the cells. It is sometimes referred to as fluorescence-assisted (or activated) cell sorting (FACS) analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow cytometry" .

goldbook:13153 a skos:Concept ;
    skos:altLabel "FITC" ;
    skos:definition "Green fluorescent dye used to 'tag' antibodies for use in immunofluorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescein isothiocyanate" .

goldbook:13154 a skos:Concept ;
    skos:altLabel "FACS" ;
    skos:definition "Fluorescence-assisted cell sorting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence-activated cell sorting" .

goldbook:13155 a skos:Concept ;
    skos:definition "Antibody conjugated to a fluorescent dye such as fluorescein isothiocyanate (FITC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescent antibody" .

goldbook:13156 a skos:Concept ;
    skos:definition "Major histocompatibility complex (MHC) class II-negative Fc receptor-positive dendritic cell which bears immune complexes on its surface and is probably involved in the generation of antibody-secreting cells and maintenance of B-cell memory (see memory cell) in germinal centers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "follicular dendritic cell" .

goldbook:13157 a skos:Concept ;
    skos:definition "Test for allergic contact dermatitis in which the test substance is injected into the front footpad of a guinea pig and challenge is performed seven days later." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "footpad test" .

goldbook:13158 a skos:Concept ;
    skos:definition "Glycolipid heterophile antigen (globopentosylceramide) expressed on cell surfaces during embryonic and adult life in rodents and other mammals, and found in many pathogens, but probably not in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Forssman antigen" .

goldbook:13159 a skos:Concept ;
    skos:definition "One of several relatively conserved amino acid sequences that flank the hypervariable regions in immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions and maintain a common overall structure for all V region domains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "framework region" .

goldbook:13160 a skos:Concept ;
    skos:definition "Complete Freund’s adjuvant is an emulsion of aqueous antigen in mineral oil that contains heat-killed Mycobacteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Freund’s adjuvant" .

goldbook:13161 a skos:Concept ;
    skos:definition "Lymphocyte whose T-cell receptor (TCR) is a heterodimer of a \\(\\ce{\\upgamma\\mbox{-}chain}\\) and a \\(\\ce{\\updelta\\mbox{-}chain}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ:δ T cell" .

goldbook:13162 a skos:Concept ;
    skos:definition "T-cell receptor (TCR) composed of two different glycoprotein chains, designated \\(\\upgamma\\) and \\(\\updelta\\), assembled in a \\(\\ce{\\upgamma\\mbox{:}\\updelta\\ heterodimer}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ:δ T-cell receptor" .

goldbook:13163 a skos:Concept ;
    skos:altLabel "IFN-γ" ;
    skos:definition "Member of a group of cytokines, the interferons, which has as its primary action the activation of macrophages and can induce cells to resist viral replication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-interferon" .

goldbook:13164 a skos:Concept ;
    skos:definition "Viral glycoprotein, non-covalently associated with gp41 in the viral envelope of human immunodeficiency virus (HIV)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gp120" .

goldbook:13165 a skos:Concept ;
    skos:definition "One of a group of serum proteins, mostly immunoglobulins (Ig), which have the greatest mobility towards the cathode during electrophoresis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gammaglobulin" .

goldbook:13166 a skos:Concept ;
    skos:definition "Autoimmune-mediated destruction of the gastric mucosa that may result in the development of pernicious anemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune gastritis" .

goldbook:13167 a skos:Concept ;
    skos:definition "Classification of immune mechanisms of tissue injury into four types: type I, immediate-type hypersensitivity reactions, mediated by interaction of immunoglobulin E (IgE) antibody and antigen causing the release of histamine and other mediators; type II, antibody-mediated hypersensitivity reactions, due to antibody–antigen interactions on cell surfaces; type III, immune complex, local or general inflammatory responses due to formation of circulating immune complexes and their deposition in tissues; and type IV cell-mediated hypersensitivity reactions, initiated by sensitized T lymphocytes either by release of lymphokines or by T-cell-mediated cytotoxicity [see cytotoxic T lymphocyte (CTL)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gell and Coombs classification" .

goldbook:13168 a skos:Concept ;
    skos:altLabel "gene targeting" ;
    skos:definition "Method of disabling a specific gene by homologous recombination with an introduced DNA construct designed for that purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene knockout" .

goldbook:13169 a skos:Concept ;
    skos:definition "Structural alteration in a chromosome that changes the order of its genetic loci, occurring by DNA recombination, e.g., during development or in some cancers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene rearrangement" .

goldbook:13170 a skos:Concept ;
    skos:altLabel "gnotobiotic" ;
    skos:definition "Descriptor applied to animals (usually mice) raised in the complete absence of intestinal and other microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germ-free" .

goldbook:13171 a skos:Concept ;
    skos:altLabel "in immunology" ;
    skos:definition "Referring to genes in their unrearranged state rather than those rearranged for production of immunoglobulin (Ig) or T-cell receptor (TCR) molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germ line" .

goldbook:13172 a skos:Concept ;
    skos:definition "Discrete area within lymph nodes and spleen where B-cell maturation and memory development occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germinal center" .

goldbook:13173 a skos:Concept ;
    skos:definition "Large multinucleate cell derived from fused macrophages and often present in granulomas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "giant cell" .

goldbook:13174 a skos:Concept ;
    skos:definition "Any of a group of kidney diseases involving inflammation of the renal glomeruli, often as a result of antibody–antigen complexes that localize in the kidney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glomerulonephritis" .

goldbook:13175 a skos:Concept ;
    skos:altLabel "glomerulopathy" ;
    skos:definition "Disease of the renal glomeruli, which may show either thickening of the glomerular basement membrane due to the accretion of proteins or a minimal change disease, in which there is functional damage but little structural change by light microscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glomerulonephropathy" .

goldbook:13176 a skos:Concept ;
    skos:altLabel "GAD" ;
    skos:definition "Main autoantigen in diabetes mellitus type 1 and stiff-person syndrome (a neurological autoimmune disease)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glutamic acid decarboxylase" .

goldbook:13177 a skos:Concept ;
    skos:definition "1) Any of the prolamins found in cereal grains, especially the prolamins in wheat, rye, barley, and possibly oats, which cause digestive disorders, notably celiac disease. 2) In wheat, mixture of water-insoluble proteins, including gliadins, that give wheat dough its elastic texture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gluten" .

goldbook:13178 a skos:Concept ;
    skos:altLabel "Goodpasture disease" ;
    skos:definition "Autoimmune disease of humans in which glomerulonephritis and pulmonary hemorrhage are produced by complement-mediated tissue damage caused by antibodies directed against the renal glomerular and alveolar basement membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Goodpasture syndrome" .

goldbook:13179 a skos:Concept ;
    skos:definition "Destruction of grafted tissue by host lymphocytes following an adaptive immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft rejection" .

goldbook:13180 a skos:Concept ;
    skos:altLabel "GVHD" ;
    skos:definition "Disease that occurs following bone marrow transplantation between genetically non-identical people and in which mature T cells in the transplanted bone marrow attack and destroy the recipients tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft-versus-host disease" .

goldbook:13181 a skos:Concept ;
    skos:altLabel "GVH",
        "GVH reaction" ;
    skos:definition "Reaction occurring when T lymphocytes present in a graft recognize and attack host cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft-versus-host reaction" .

goldbook:13182 a skos:Concept ;
    skos:altLabel "G-CSF" ;
    skos:definition "Hematopoietic (see hematopoiesis) factor augmenting the production of neutrophils in the bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granulocyte colony-stimulating factor" .

goldbook:13183 a skos:Concept ;
    skos:altLabel "GM-CSF" ;
    skos:definition "Cytokine that stimulates production of granulocytes and monocytes from stem cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granulocyte–macrophage colony-stimulating factor" .

goldbook:13184 a skos:Concept ;
    skos:definition "Decreased circulating granulocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granulocytopenia" .

goldbook:13185 a skos:Concept ;
    skos:definition "Mass or nodule of granulation tissue, with actively growing fibroblasts and capillary buds, characterized by the presence of aggregates of modified macrophages resembling epithelial cells (epithelioid histiocytes), and lymphocytes, surrounded by a rim of giant multinucleate cells, either of the Langerhans or foreign body type." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granuloma" .

goldbook:13186 a skos:Concept ;
    skos:definition "Member of a family of serine esterases present in the granules of cytotoxic T lymphocytes and natural killer (NK) cells. They induce apoptosis in the target cell that they enter through perforin channels inserted into the target cell membrane by the cytotoxic lymphocyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granzyme" .

goldbook:13187 a skos:Concept ;
    skos:definition "Hyperthyroidism associated with diffuse hyperplastic goitre resulting from production of a thyroid-stimulating hormone receptor (TSHR)-binding autoantibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Graves disease" .

goldbook:13188 a skos:Concept ;
    skos:altLabel "GPMT" ;
    skos:definition "Skin sensitization test for allergic contact dermatitis in which shaved guinea pig skin is exposed to intradermal injections of a test agent together with complete Freund’s adjuvant, followed by an occlusive patch for boosting for \\(\\pu{48 h}\\) beginning on day 7, and challenged on day 21." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guinea pig maximization test" .

goldbook:13189 a skos:Concept ;
    skos:altLabel "GALT" ;
    skos:definition "Lymphoid cells and tissues lining the mucosa that seem to serve as the first point of antigen contact via this route, including Peyer’s patches, the appendix, tonsils, adenoids, and mesenteric lymph nodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gut-associated lymphoid tissue" .

goldbook:13190 a skos:Concept ;
    skos:definition "Region of mouse chromosome 17 coding the major histocompatibility complex (MHC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "H-2" .

goldbook:13191 a skos:Concept ;
    skos:definition "Mouse major histocompatibility complex (MHC) coded by H-2." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "H-2 complex" .

goldbook:13192 a skos:Concept ;
    skos:definition "B-cell neoplasm, usually occurring during middle age, constituting about \\(\\pu{2\\%}\\) of all leukemias and responding well to chemotherapy. The neoplastic cells have fine, hairlike surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hairy cell leukemia" .

goldbook:13193 a skos:Concept ;
    skos:definition "Set of allelic variants present at a given genetic region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haplotype" .

goldbook:13194 a skos:Concept ;
    skos:definition "Able to act as a hapten." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haptenic" .

goldbook:13195 a skos:Concept ;
    skos:altLabel "chronic lymphocytic thyroiditis" ;
    skos:definition "Autoimmune disease where the body’s own antibodies attack the cells of the thyroid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hashimoto thyroiditis" .

goldbook:13196 a skos:Concept ;
    skos:altLabel "pollenosis" ;
    skos:definition "Allergic condition affecting the mucous membranes of the upper respiratory tract and the eyes, characterized by nasal discharge, sneezing, and itchy, watery eyes; and usually caused by an abnormal sensitivity to airborne pollen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hay fever" .

goldbook:13197 a skos:Concept ;
    skos:definition "Evolutionarily conserved proteins, found in many organisms, that are induced upon exposure of cells to various types of stress, including heat, oxidative or hypoxic stress, and deprivation of nutrients or essential ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heat shock proteins" .

goldbook:13198 a skos:Concept ;
    skos:altLabel "H-chain" ;
    skos:definition "Larger of the two types of polypeptide chain found in immunoglobulin (Ig) molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heavy chain" .

goldbook:13199 a skos:Concept ;
    skos:altLabel "T helper cell",
        "Th",
        "helper T cell",
        "helper cell" ;
    skos:definition "Member of a subclass of T lymphocytes that provides help (in the form of cytokines and/or cognate interactions) necessary for the expression of effector function by other cells in the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helper T lymphocyte" .

goldbook:13200 a skos:Concept ;
    skos:definition "Any molecule that agglutinates erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemagglutinin" .

goldbook:13201 a skos:Concept ;
    skos:definition "Self-renewing stem cell that is capable of giving rise to all of the formed elements of the blood (i.e., leukocytes, erythrocytes, and platelets)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hematopoietic stem cell" .

goldbook:13202 a skos:Concept ;
    skos:definition "Anemia resulting from the lysis of erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemolytic anemia" .

goldbook:13203 a skos:Concept ;
    skos:altLabel "HIT" ;
    skos:definition "Most frequent antibody-mediated drug-induced thrombocytopenia, which occurs in \\(\\pu{1-}\\pu{2\\%}\\) of patients treated with heparin intravenously for longer than four days." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heparin-induced thrombocytopenia" .

goldbook:13204 a skos:Concept ;
    skos:definition "Clinical name for a genetic deficiency of the C1 inhibitor of the complement system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hereditary angioneurotic edema" .

goldbook:13205 a skos:Concept ;
    skos:altLabel "heterogenetic antigen" ;
    skos:definition "Identical or similar cross-reacting antigen shared by several species (e.g., Forssman antigen).Antibodies produced against one of these antigens will also react with the other antigens of the set even though these are derived from a different species; such antibodies are also called heterophile antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroantigen" .

goldbook:13206 a skos:Concept ;
    skos:definition "Antibody derived from another individual of the same species or another species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterologous antibody" .

goldbook:13207 a skos:Concept ;
    skos:definition "Antigen that reacts with an antibody other than the one whose formation it induced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterologous antigen" .

goldbook:13208 a skos:Concept ;
    skos:definition "Digestion of exogenous material taken up by a cell by phagocytosis or pinocytosis, following fusion of the phagocytic or pinocytic vacuole with a lysosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterophagy" .

goldbook:13209 a skos:Concept ;
    skos:altLabel "heterophilic antibody" ;
    skos:definition "Antibody raised against an antigen from one species, which also reacts against antigens from other species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterophile antibody" .

goldbook:13210 a skos:Concept ;
    skos:altLabel "heterophilic antigen" ;
    skos:definition "Antigen that stimulates production in a vertebrate of antibodies capable of reacting with tissue components having related antigens in a wide range of other species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterophile antigen" .

goldbook:13211 a skos:Concept ;
    skos:definition "Possessing different alleles at a given locus on the two homologous chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterozygous" .

goldbook:13212 a skos:Concept ;
    skos:altLabel "HEV" ;
    skos:definition "Specialized venule in lymphoid tissues that has walls permeable to migrating lymphocytes, allowing them to move from blood into the lymphoid tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high endothelial venule" .

goldbook:13213 a skos:Concept ;
    skos:altLabel "HAART" ;
    skos:definition "Approach to the treatment of acquired immune deficiency syndrome (AIDS) patients involving a combination of nucleoside analogs, which prevent reverse transcription, with drugs that inhibit responses to the virus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "highly active antiretroviral therapy" .

goldbook:13214 a skos:Concept ;
    skos:altLabel "HMGB",
        "HMGB Protein" ;
    skos:definition "Any of a group of universal sensors of nucleic acids, required for the induction of transmembrane and cytoplasmic receptor-mediated innate immune responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-mobility group box protein" .

goldbook:13215 a skos:Concept ;
    skos:definition "Amino acids between the Fab and Fc regions of immunoglobulin (Ig) that permit flexibility of the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hinge region" .

goldbook:13216 a skos:Concept ;
    skos:definition "Histamine intolerance, which may contribute to food intolerance as part of a pseudoallergic reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histaminosis" .

goldbook:13217 a skos:Concept ;
    skos:definition "Relationship between a tissue or organ donor and a recipient who have sufficient similarity in major histocompatibility complex (MHC) antigens to avoid rejection of a graft." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histocompatibility" .

goldbook:13218 a skos:Concept ;
    skos:definition "Relationship between a tissue or organ donor and a recipient who have sufficient differences in major histocompatibility complex (MHC) antigens to cause rejection of a graft." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histoincompatibility" .

goldbook:13219 a skos:Concept ;
    skos:altLabel "nettle rash",
        "urticaria" ;
    skos:definition "Vascular reaction pattern of the skin marked by the transient appearance of smooth, slightly elevated patches (wheals) that are either more red or more pale than the surrounding skin and are accompanied by severe itching." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hives" .

goldbook:13220 a skos:Concept ;
    skos:altLabel "Hodgkin lymphoma" ;
    skos:definition "Immune system tumor characterized by large cells called Reed–Sternberg cells that derive from mutated B-lineage cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hodgkin disease" .

goldbook:13221 a skos:Concept ;
    skos:definition "Movement of leukocytes to specific locations in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homing" .

goldbook:13222 a skos:Concept ;
    skos:definition "Cell surface molecule that directs leukocytes to specific locations in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homing receptor" .

goldbook:13223 a skos:Concept ;
    skos:definition "Antibody that binds preferentially to cells from the same species rather than to cells from other species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homocytotropic antibody" .

goldbook:13224 a skos:Concept ;
    skos:definition "Possessing the same allele at a given locus on the two homologous chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homozygous" .

goldbook:13225 a skos:Concept ;
    skos:definition "Term (Latin: dread of self-poisoning) to describe the body’s innate aversion to immunological self destruction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "horror autotoxicus" .

goldbook:13226 a skos:Concept ;
    skos:definition "Ability of an individual to resist invasion by opportunistic agents and production of disease associated with exposure to microorganisms, foreign tissue, and particulates, as well as certain types of neoplasia. Host defense may be either nonspecific (innate or natural immunity) or specific (adaptive or acquired immunity) in nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "host defense" .

goldbook:13227 a skos:Concept ;
    skos:definition "Evaluation of host resistance in rodents to in vivo challenge with an infectious organism under normal conditions and after pharmacological and nutritional alterations of the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "host-resistance assay" .

goldbook:13228 a skos:Concept ;
    skos:altLabel "HIV" ;
    skos:definition "Causative agent of acquired immune deficiency syndrome (AIDS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human immunodeficiency virus" .

goldbook:13229 a skos:Concept ;
    skos:definition "Genetically engineered monoclonal antibody of non-human origin in which all but the antigen-binding complementarity-determining region (CDR) sequences have been replaced with sequences derived from human antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "humanized antibody" .

goldbook:13230 a skos:Concept ;
    skos:altLabel "HLA" ;
    skos:definition "Antigen coded by genes of the human major histocompatibility complex (MHC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human leukocyte antigen" .

goldbook:13231 a skos:Concept ;
    skos:altLabel "HLA Polymorphism" ;
    skos:definition "Discontinuous genetic variation in the major histocompatibility complex (MHC) that results in the occurrence of several different forms of MHC molecules among people." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human leukocyte antigen polymorphism" .

goldbook:13232 a skos:Concept ;
    skos:altLabel "HLA Type I" ;
    skos:definition "Molecules that enable the body to recognize infected cells and tumor cells and destroy them with cytotoxic T lymphocytes (CTLs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human leukocyte antigen type I" .

goldbook:13233 a skos:Concept ;
    skos:altLabel "HLA Type II" ;
    skos:definition "Molecules that enable CD4+ lymphocytes to recognize epitopes of exogenous antigens and discriminate self from non-self." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human leukocyte antigen type II" .

goldbook:13234 a skos:Concept ;
    skos:definition "Pertaining to extracellular fluid such as plasma and lymph." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "humoral" .

goldbook:13235 a skos:Concept ;
    skos:definition "Immune response in which specific antibodies induce the effector functions (such as phagocytosis and activation of the complement system)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "humoral immune response" .

goldbook:13236 a skos:Concept ;
    skos:altLabel "humorally mediated immunity (HMI)" ;
    skos:definition "Specific immune response that is mediated primarily by humoral factors circulating in solution in the blood plasma and lymph (i.e., antibodies and complement)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "humoral immunity" .

goldbook:13237 a skos:Concept ;
    skos:definition "Increase of gammaglobulins in the blood by paraproteinemia or increased production of immunoglobulins (Ig)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypergammaglobulinemia" .

goldbook:13238 a skos:Concept ;
    skos:altLabel "Job syndrome" ;
    skos:definition "Rare primary immunodeficiency syndrome characterized by recurrent severe staphylococcal skin abscesses (hence Job syndrome), lung infections, and markedly elevated serum immunoglobulin E (IgE) levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperimmunoglobulin E syndrome" .

goldbook:13239 a skos:Concept ;
    skos:altLabel "HIGM" ;
    skos:definition "Primary T cell defect due to mutations in the CD40 ligand (CD40L), characterized by recurrent (opportunistic) infections and very low levels of immunoglobulin G (IgG) and immunoglobulin A (IgA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperimmunoglobulin M syndrome" .

goldbook:13240 a skos:Concept ;
    skos:definition "Abnormally increased response to a stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperreactivity" .

goldbook:13241 a skos:Concept ;
    skos:definition "State in which an individual reacts with allergic effects following exposure to a certain substance (allergen) after having been exposed previously to the same substance. It is sometimes used loosely for any increased response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypersensitivity" .

goldbook:13242 a skos:Concept ;
    skos:altLabel "HPS",
        "extrinsic allergic alveolitis" ;
    skos:definition "Immune-mediated inflammatory disease of the lung parenchyma caused by exposure to an inhaled chemical allergen or organic dust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypersensitivity pneumonitis" .

goldbook:13243 a skos:Concept ;
    skos:definition "Development of excessive immune reactivity to an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypersensitization" .

goldbook:13244 a skos:Concept ;
    skos:definition "Adverse immunological effects in an individual occurring under conditions of exposure to an allergen that result in no effects in the great majority of the population, or an individual exhibiting exaggerated effects in comparison with the great majority of those showing some adverse effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypersusceptibility" .

goldbook:13245 a skos:Concept ;
    skos:definition "Amino acid sequence within the immunoglobulin (Ig) and T-cell receptor (TCR) variable (V) regions that shows the greatest variability and contributes most to the antigen or peptide-major histocompatibility complex (MHC) molecule binding site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypervariable region" .

goldbook:13246 a skos:Concept ;
    skos:definition "Immunodeficiency state marked by abnormally low levels of all classes of immunoglobulins (Ig), associated with increased susceptibility to infectious diseases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypogammaglobulinemia" .

goldbook:13247 a skos:Concept ;
    skos:definition "Dermal application of a selected allergen to an allergic person in stepwise increasing dosage, with the aim of reducing the immune system’s tendency for the corresponding allergic reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyposensitization therapy" .

goldbook:13248 a skos:Concept ;
    skos:altLabel "I region-associated antigen",
        "immune response-associated antigen" ;
    skos:definition "Isoantigen encoded by the Ia region of the mouse major histocompatibility complex (H-2 complex)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ia antigen" .

goldbook:13249 a skos:Concept ;
    skos:altLabel "immune thrombocytopenic purpura" ;
    skos:definition "Term that describes a 'primary' symptom or disease in which no underlying cause or associated disorder can be found." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "idiopathic" .

goldbook:13250 a skos:Concept ;
    skos:altLabel "ITP",
        "immune thrombocytopenic purpura" ;
    skos:definition "Thrombocytopenia of unknown cause, probably related to the production of anti-platelet antibodies, and leading to bruising (purpura)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "idiopathic thrombocytopenic purpura" .

goldbook:13251 a skos:Concept ;
    skos:altLabel "IDR" ;
    skos:definition "Rare and unpredictable adverse drug reaction occurring only in susceptible individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "idiosyncratic drug reaction" .

goldbook:13252 a skos:Concept ;
    skos:definition "The combined antigenic determinants (idiotopes) expressed in the variable (V) region of immunoglobulins (Ig) of an individual that determine antibody specificity to a particular antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "idiotype" .

goldbook:13253 a skos:Concept ;
    skos:altLabel "idiotypic network" ;
    skos:definition "Regulatory network based on interactions of anti-idiotypic antibodies and idiotypes present on antibodies and T-cell receptors (TCRs), resulting in feedback inhibition of ongoing B cell or T cell responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "idiotype network" .

goldbook:13254 a skos:Concept ;
    skos:definition "Describing cells that are not fully developed and unable to participate immediately in an immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immature" .

goldbook:13255 a skos:Concept ;
    skos:altLabel "immediate-type allergy",
        "type I hypersensitivity" ;
    skos:definition "Reaction provoked by re-exposure to an antigen (allergen) that causes plasma cells to secrete immunoglobulin E (IgE) which binds to Fc receptors on the surface of tissue mast cells and blood basophils, sensitizing them, so that later exposure to the same allergen cross-links the bound IgE, leading to degranulation and the secretion of pharmacologically active mediators such as histamine, leukotriene, and prostaglandin that act immediately on the surrounding tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immediate-type hypersensitivity" .

goldbook:13256 a skos:Concept ;
    skos:definition "Attachment of particulate antigen coated with C3b (see complement) to cells expressing C3b receptors, which results in enhanced phagocytosis of bacteria by macrophages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune adherence" .

goldbook:13257 a skos:Concept ;
    skos:definition "Product of an antigen–antibody reaction, which may also contain components of the complement system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune complex" .

goldbook:13258 a skos:Concept ;
    skos:definition "Illness resulting from deposition of antigen–antibody complexes in tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune complex disease" .

goldbook:13259 a skos:Concept ;
    skos:definition "Regulatory mechanism of the preferential activation of one aspect (cellular or humoral) of the adaptive immune system at the expense of the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune deviation" .

goldbook:13260 a skos:Concept ;
    skos:definition "Removal of pathogens or tumor cells by the immune system; the first step of immunoediting of tumors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune elimination" .

goldbook:13261 a skos:Concept ;
    skos:altLabel "enhancement (in immunology)" ;
    skos:definition "Therapeutic stimulation of the immune response, especially in tumor therapy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune enhancement" .

goldbook:13262 a skos:Concept ;
    skos:definition "State in carcinogenesis where there is an equilibrium between elimination of tumor cells by the immune system and growth of non-immunogenic tumor cells; the second step in immunoediting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune equilibrium" .

goldbook:13263 a skos:Concept ;
    skos:definition "Biological feature of an infectious agent or of a tumor cell that prevents its elimination by the immune system. Such a feature can be acquired by a selection process. Immune escape is the third step in immunoediting of tumors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune escape" .

goldbook:13264 a skos:Concept ;
    skos:definition "Property of a pathogen that results in avoidance of attack by the immune system, e.g., because of reduced phagocytosis, lack of recognition by the innate immune system, or suppression of the immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune evasion" .

goldbook:13265 a skos:Concept ;
    skos:altLabel "immunomodulation" ;
    skos:definition "Alteration of the immune response to alleviate harmful effects of the immune system or to promote its activity by changes in regulatory factors; often part of deliberate therapeutic intervention." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune modulation" .

goldbook:13266 a skos:Concept ;
    skos:altLabel "immunoregulation" ;
    skos:definition "Capacity of the immune system to regulate itself so that an immune response does not become excessive and cause tissue damage, autoimmune reactions, or allergic reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune regulation" .

goldbook:13267 a skos:Concept ;
    skos:definition "Hypothesis that the immune response involves multiple redundancies that are capable of compensating for acute reductions in certain immune functions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune reserve hypothesis" .

goldbook:13268 a skos:Concept ;
    skos:altLabel "Ia protein" ;
    skos:definition "Protein found in antigen-presenting cells (APCs) and B lymphocytes in mice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune response-associated protein" .

goldbook:13269 a skos:Concept ;
    skos:altLabel "ir genes" ;
    skos:definition "Genes, including those within the major histocompatibility complex (MHC), that together determine the overall level of immune response to a given antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune response genes" .

goldbook:13270 a skos:Concept ;
    skos:altLabel "immunosurveillance" ;
    skos:definition "Recognition, and in some cases elimination, of tumor cells by the immune system before they become clinically detectable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune surveillance" .

goldbook:13271 a skos:Concept ;
    skos:definition "Integrated network of organs, glands, and tissues that has evolved to protect the body from foreign substances, including bacteria, viruses, and other infection-causing parasites and pathogens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune system" .

goldbook:13272 a skos:Concept ;
    skos:definition "Inherited, acquired, or induced resistance to infection by a specific pathogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunity" .

goldbook:13273 a skos:Concept ;
    skos:definition "Activation of the immune system as a whole to react more rapidly to antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoactivation" .

goldbook:13274 a skos:Concept ;
    skos:definition "Substance that activates the immune system as a whole to react more rapidly to antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoactivator" .

goldbook:13275 a skos:Concept ;
    skos:definition "Method for removal of antibody or antigen by allowing it to bind to a corresponding antigen or antibody immobilized in the solid phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoadsorption" .

goldbook:13276 a skos:Concept ;
    skos:definition "Supporting substrate [often a nitrocellulose, nylon, or poly(vinylidene fluoride) membrane] onto which proteins that have been separated by gel electrophoresis are transferred and then identified by the binding of specific antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoblot" .

goldbook:13277 a skos:Concept ;
    skos:definition "Having the ability to exhibit an immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunocompetence" .

goldbook:13278 a skos:Concept ;
    skos:definition "Unable to mount a full or effective immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunocompromised" .

goldbook:13279 a skos:Concept ;
    skos:altLabel "antibody conjugate" ;
    skos:definition "Antibody or antibody fragment to which a functional molecule, such as a drug, has been chemically linked." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoconjugate" .

goldbook:13280 a skos:Concept ;
    skos:definition "Antibody or antibody fragment to which a cytokine has been chemically linked." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunocytokine" .

goldbook:13281 a skos:Concept ;
    skos:definition "Inability to produce a normal repertoire of antibodies or immunologically sensitized T lymphocytes, especially in response to specific antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunodeficiency" .

goldbook:13282 a skos:Concept ;
    skos:definition "Epitope in an antigen that is preferentially recognized by T cells, which then come to dominate the immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunodominant epitope" .

goldbook:13283 a skos:Concept ;
    skos:altLabel "IPEX syndrome" ;
    skos:definition "X-linked syndrome characterized by immunodysregulation, polyendocrinopathy (diabetes mellitus type 1, thyroiditis), hemolytic anemia, thrombocytopenia, dermatitis, and enteropathy, caused by mutations in the gene encoding Foxp3." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunodysregulation–polyendocrinopathy–enteropathy, X-linked" .

goldbook:13284 a skos:Concept ;
    skos:definition "Process of continuing immunosuppression of immunogenic tumor cells, which may finally result in the selection of non-immunogenic tumor cells. It consists of the steps immune elimination, immune equilibrium, and immune escape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoediting" .

goldbook:13285 a skos:Concept ;
    skos:definition "Technique for detection of cell- or tissue-associated antigens by the use of a fluorescently tagged ligand, e.g., an anti-immunoglobulin (Ig) conjugated to fluorescein isothiocyanate (FITC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunofluorescence" .

goldbook:13286 a skos:Concept ;
    skos:altLabel "IgA" ;
    skos:definition "Class of immunoglobulin (Ig) characterized by $\\ce{\\upalpha\\!}$ heavy chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin A" .

goldbook:13287 a skos:Concept ;
    skos:altLabel "IgD" ;
    skos:definition "Class of immunoglobulin (Ig) characterized by $\\updelta\\!$ heavy chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin D" .

goldbook:13288 a skos:Concept ;
    skos:altLabel "IgE" ;
    skos:definition "Class of immunoglobulin (Ig) characterized by $\\upvarepsilon\\!$ heavy chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin E" .

goldbook:13289 a skos:Concept ;
    skos:altLabel "IgY" ;
    skos:definition "Immunoglobulin (Ig) found in chickens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin Y" .

goldbook:13290 a skos:Concept ;
    skos:altLabel "IgE-binding FC receptors" ;
    skos:definition "High-affinity IgE-binding ${\\rm{Fc\\mbox{-}}}\\upvarepsilon\\!{\\rm{\\mbox{-}R}}$ type I receptors are expressed on mast cells and basophils and interact with IgE antibodies with high affinity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin E-binding Fc receptors" .

goldbook:13291 a skos:Concept ;
    skos:altLabel "IgE-Mediated Hypersensitivity" ;
    skos:definition "State in which an individual reacts with allergic effects caused fundamentally by the reaction of antigen-specific immunoglobulin E (IgE) following exposure to a certain substance (allergen) after having been exposed previously to the same substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin E-mediated hypersensitivity" .

goldbook:13292 a skos:Concept ;
    skos:altLabel "IgG" ;
    skos:definition "Class of immunoglobulin (Ig) characterized by \\(\\upgamma\\) heavy chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin G" .

goldbook:13293 a skos:Concept ;
    skos:altLabel "IgM" ;
    skos:definition "Class of immunoglobulin (Ig) characterized by \\(\\upmu\\) heavy chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin M" .

goldbook:13294 a skos:Concept ;
    skos:definition "Genes encoding proteins containing one or more immunoglobulin (Ig) domains (homology units) that are homologous to either Ig variable (V) region or constant (C) region domains. Cell surface and soluble molecules mediating recognition, adhesion, or binding functions in and outside the immune system, derived from the same precursor, belong to this family of molecules (e.g., immunoglobulin, T-cell receptor (TCR), major histocompatibility complex (MHC) class I and class II molecules, CD4, CD8, and $\\ce{Fc\\upgamma\\!R}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin gene superfamily" .

goldbook:13295 a skos:Concept ;
    skos:definition "Large family of proteins characterized by possession of 'immunoglobulin-type' domains of approximately 110 amino acids folded into two \\(\\ce{\\upbeta\\mbox{-}pleated sheets}\\). Members include immunoglobulins \\(A\\), \\(E\\), \\(G\\), \\(M\\) (IgA, IgE, IgG, and IgM), T-cell receptors (TCRs), and human leukocyte antigen (HLA) major histocompatibility complex (MHC) molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin superfamily" .

goldbook:13296 a skos:Concept ;
    skos:altLabel "immunocytochemistry" ;
    skos:definition "Detection of cell-associated molecules in the light microscope with antibodies labeled with enzymes that change a substrate into a colored precipitate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunohistochemistry" .

goldbook:13297 a skos:Concept ;
    skos:definition "Absence of a pathogenic autoimmune response in spite of the concomitant presence in the host of the autoantigen and T cells bearing the specific autoreactive T-cell receptor (TCR)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunological ignorance" .

goldbook:13298 a skos:Concept ;
    skos:definition "Inability of the immune system to function in a normal fashion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunological incompetence" .

goldbook:13299 a skos:Concept ;
    skos:altLabel "privileged site" ;
    skos:definition "Any of various sites in the body where foreign tissue grafts do not induce an immune reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunologically privileged site" .

goldbook:13300 a skos:Concept ;
    skos:altLabel "immunological anamnesis" ;
    skos:definition "Ability of the immune system to respond faster and more effectively to subsequent exposures to an antigen following a primary immune response to the same antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunological memory" .

goldbook:13301 a skos:Concept ;
    skos:definition "Contact point between the T cell and antigen-presenting cell (APC) that is generated by reorganization and clustering of cell surface molecules in lipid rafts. The synapse facilitates interactions between T-cell receptor (TCR) and major histocompatibility complex (MHC) molecules, and between adhesion molecules, thereby potentiating a TCR-mediated activation signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunological synapse" .

goldbook:13302 a skos:Concept ;
    skos:altLabel "tolerance" ;
    skos:definition "Persistent specific immunological unresponsiveness toward a substance that would normally be expected to elicit an immune response, resulting from previous non-sensitizing exposure to an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunological tolerance" .

goldbook:13303 a skos:Concept ;
    skos:definition "Science that deals with the immune system including cell-mediated immunity (CMI) and humoral aspects of immunity and immune responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunology" .

goldbook:13304 a skos:Concept ;
    skos:definition "Method of separating specific cell types or macromolecules with the aid of cell-specific antibodies coupled to paramagnetic beads." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunomagnetic separation" .

goldbook:13305 a skos:Concept ;
    skos:definition "Modification of the functioning of the immune system by the action of a substance that increases or reduces the ability to produce an immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunomodulation" .

goldbook:13306 a skos:Concept ;
    skos:definition "1) Study of diseases of the immune system. 2) The occurrence of such diseases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunopathology" .

goldbook:13307 a skos:Concept ;
    skos:definition "Disease of the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunopathy" .

goldbook:13308 a skos:Concept ;
    skos:definition "1) Study of the immune system using drugs as diagnostic tools. 2) Use of pharmaceutical molecules to support and stimulate the immune system in patients with immunodeficiency, or to suppress or specifically influence the reactivity of the immune system in order to control a pathological immune reaction or disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunopharmacology" .

goldbook:13309 a skos:Concept ;
    skos:definition "Use of a panel of antibodies to determine a subset of proteins expressed on the surface of a cell or heterogeneous group of cells, often for diagnostic purposes, e.g., identifying the presence of leukemia cells in a population of lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunophenotyping" .

goldbook:13310 a skos:Concept ;
    skos:definition "Any of a group of cytoplasmic proteins in T cells that are targets of the immunosuppressant drugs cyclosporin A, tacrolimus (fujimycin), rapamycin, and related compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunophilin" .

goldbook:13311 a skos:Concept ;
    skos:definition "Enhancement of the capacity of the immune system to produce an effective response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunopotentiation" .

goldbook:13312 a skos:Concept ;
    skos:definition "Precipitate formed in an antigen–antibody reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoprecipitate" .

goldbook:13313 a skos:Concept ;
    skos:altLabel "ITAM" ;
    skos:definition "Consensus sequence for src-family tyrosine kinases, found in the cytoplasmic domains of several signaling molecules including the signal transduction units of lymphocyte antigen receptors and of Fc receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoreceptor tyrosine-based activation motif" .

goldbook:13314 a skos:Concept ;
    skos:altLabel "ITIM" ;
    skos:definition "Consensus sequence present in the cytoplasmic domains of certain cell surface molecules [e.g., Fc \\(\\upgamma\\) RIIB, inhibitory natural killer (NK) cell receptors] and which mediates inhibitory signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoreceptor tyrosine-based inhibitory motif" .

goldbook:13315 a skos:Concept ;
    skos:definition "Reactivity to antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosensitivity" .

goldbook:13316 a skos:Concept ;
    skos:definition "Substance that makes the immune system more reactive to antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosensitizer" .

goldbook:13317 a skos:Concept ;
    skos:altLabel "ISCOM" ;
    skos:definition "Immunological adjuvant composed of saponin, cholesterol, phospholipid, and an immunogen, usually protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunostimulating complex" .

goldbook:13318 a skos:Concept ;
    skos:definition "Increase in immune function, e.g., by use of bacille Calmette–Guérin (BCG) vaccine or drugs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunostimulation" .

goldbook:13319 a skos:Concept ;
    skos:definition "Substance that depresses the function of the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosuppressant" .

goldbook:13320 a skos:Concept ;
    skos:definition "Causing depression of the normal function of the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosuppressive" .

goldbook:13321 a skos:Concept ;
    skos:definition "Mechanisms by which the immune system is able to recognize and destroy malignant cells before the formation of an overt tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosurveillance" .

goldbook:13322 a skos:Concept ;
    skos:definition "Treatment or prevention of a disease using agents that can modify the immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunotherapy" .

goldbook:13323 a skos:Concept ;
    skos:definition "Harmful to the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunotoxic" .

goldbook:13324 a skos:Concept ;
    skos:definition "Substance that is harmful to the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunotoxicant" .

goldbook:13325 a skos:Concept ;
    skos:definition "Discipline applying cardinal principals of both immunology and toxicology to study the ability of certain substances to alter the immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunotoxicology" .

goldbook:13326 a skos:Concept ;
    skos:definition "Biochemical conjugate, or recombinant fusion protein, consisting of an immune targeting molecule such as an antibody or antibody fragment together with a cytotoxic molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunotoxin" .

goldbook:13327 a skos:Concept ;
    skos:definition "Vaccine formulated from the whole microorganism that has been rendered unable to reproduce or cause disease, often by mutation or heat denaturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inactivated vaccine" .

goldbook:13328 a skos:Concept ;
    skos:definition "Method of visualizing an antigen in which an unlabeled antibody against the antigen is reacted with it first, and then is detected by staining with a second fluorescently tagged immunoglobulin G (IgG) directed against the first antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect immunofluorescence" .

goldbook:13329 a skos:Concept ;
    skos:altLabel "IDO" ;
    skos:definition "Enzyme catalyzing the initial rate-limiting step of tryptophan degradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indolamine-2,3-dioxygenase" .

goldbook:13330 a skos:Concept ;
    skos:altLabel "ICOS" ;
    skos:definition "Highly specific receptor for the protein B7H/B7RP-1 that is expressed on the surface of B cells and macrophages, and also appears on the surface of T cells during the process of T-cell activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inducible co-stimulatory protein" .

goldbook:13331 a skos:Concept ;
    skos:definition "Continuing state of tolerance that can be transferred by T lymphocytes from a tolerant animal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infectious tolerance" .

goldbook:13332 a skos:Concept ;
    skos:altLabel "autoimmune infertility" ;
    skos:definition "Infertility caused by sperm antibodies, autoimmune ovarian inflammation (oophoritis), or autoimmune orchitis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune infertility" .

goldbook:13333 a skos:Concept ;
    skos:definition "High-molecular-weight complex that activates inflammatory caspases and the cytokines interleukin-1$\\ce{\\upbeta\\!}$ ($\\ce{IL\\mbox{-}1\\upbeta\\!}$) and IL-18." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inflammasome" .

goldbook:13334 a skos:Concept ;
    skos:altLabel "IBD" ;
    skos:definition "Group of chronic inflammatory conditions resulting in the inappropriate and persistent activation of the mucosal immune system of the bowel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inflammatory bowel disease" .

goldbook:13335 a skos:Concept ;
    skos:definition "Immunity that is not intrinsically affected by prior contact with antigen, i.e., all aspects of immunity not directly mediated by lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "innate immunity" .

goldbook:13336 a skos:Concept ;
    skos:altLabel "ICAM" ;
    skos:definition "Member of the immunoglobulin superfamily that interacts with integrins and is found on the surface of several cell types, including antigen-presenting cells (APCs) and T cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intercellular adhesion molecule" .

goldbook:13337 a skos:Concept ;
    skos:definition "Process which favors survival of foreign-specific lymphocytes at the expense of self-specific lymphocytes and is a secondary mechanism involved in the induction and maintenance of self-tolerance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interclonal competition" .

goldbook:13338 a skos:Concept ;
    skos:altLabel "IL" ;
    skos:definition "Member of a group of immunoregulatory glycoproteins, also called lymphokines, monokines, or cytokines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interleukin" .

goldbook:13339 a skos:Concept ;
    skos:definition "Epitope on an anti-idiotype that binds in a way that structurally and functionally mimics the antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal image" .

goldbook:13340 a skos:Concept ;
    skos:definition "Extreme sensitivity or allergy to a drug, food, or other substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intolerance" .

goldbook:13341 a skos:Concept ;
    skos:definition "Diagnostic test for a possible cause of hypersensitivity in an individual in which a small drop of antigen is placed on a scarified skin surface or injected intradermally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intradermal test" .

goldbook:13342 a skos:Concept ;
    skos:altLabel "IEL" ;
    skos:definition "Lymphocyte found in the epithelial layer of mammalian mucosal linings, such as those of the gastrointestinal and reproductive tracts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intra-epithelial lymphocyte" .

goldbook:13343 a skos:Concept ;
    skos:altLabel "CD74" ;
    skos:definition "Protein (\\(\\pu{31 kDa}\\)) of the endoplasmic reticulum lumen that binds to newly formed major histocompatibility complex (MHC) heterodimeric proteins, preventing binding of endogenous peptides to their groove." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "invariant chain" .

goldbook:13344 a skos:Concept ;
    skos:altLabel "ICA" ;
    skos:definition "Autoantibodies reacting with endocrine (pancreatic islet) cells and detectable by indirect immunofluorescence on pancreatic cryostat sections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "islet cell antibodies" .

goldbook:13345 a skos:Concept ;
    skos:altLabel "syngraft" ;
    skos:definition "Tissue transplanted (see graft) between two genetically identical individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isograft" .

goldbook:13346 a skos:Concept ;
    skos:definition "Naturally occurring immunoglobulin M (IgM) antibody specific for the erythrocyte antigens of the ABO blood groups, thought to result from immunization by bacteria in the gastrointestinal and respiratory tracts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isohemagglutinin" .

goldbook:13347 a skos:Concept ;
    skos:definition "Class of antibody that differs from others in the constant region of the heavy chain (Fc portion)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotype" .

goldbook:13348 a skos:Concept ;
    skos:definition "Antibody exhibiting the non-specific characteristics of the antibody-isotype but lacking any specificity for the antigen in question; used as a negative control in antibody-antigen detection assays, notably in flow cytometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotype control" .

goldbook:13349 a skos:Concept ;
    skos:definition "Process by which a B cell switches from making antibody of one isotype to another without altering the specificity of the antibody, producing an isotype with the same variable (V) regions but a different heavy chain constant (C) region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotype switch" .

goldbook:13350 a skos:Concept ;
    skos:definition "Mechanism that transmits information from chemical signals outside the cell to gene promoters on the DNA in the cell nucleus. The mechanism is activated by the binding of Janus-family tyrosine kinase (JAK) to the nonpolypeptide portion of occupied receptors for some interleukins (IL). JAK phosphorylates signal transducer and activator of transcription (STAT) proteins apart from STAT 5a and 5b." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "JAK/STAT signaling pathway" .

goldbook:13351 a skos:Concept ;
    skos:definition "Method which uses labeled nucleotide precursors to estimate DNA fragmentation during cell-mediated cytotoxicity or apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "JAM test" .

goldbook:13352 a skos:Concept ;
    skos:altLabel "JAK" ;
    skos:definition "Tyrosine kinase activated by cytokines binding to cell receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Janus-family tyrosine kinase" .

goldbook:13353 a skos:Concept ;
    skos:altLabel "J chain" ;
    skos:definition "Polypeptide that forms part of the polymeric structure of pentameric immunoglobulin M (IgM) and dimeric immunoglobulin A (IgA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "joining chain" .

goldbook:13354 a skos:Concept ;
    skos:altLabel "J gene" ;
    skos:definition "Gene coding for a joining segment that connects variable (V) regions and constant (C) regions of immunoglobulin (Ig) or T-cell receptor (TCR) chains that, upon gene rearrangement, encodes part of the third hypervariable region of the antigen receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "joining gene" .

goldbook:13355 a skos:Concept ;
    skos:definition "Diversity of the splice junctions in the recombined variable (V) gene, diversity (D) gene [for immunoglobulin (Ig) heavy chains, and for TCR b and d chains], and joining (J) gene segments of antibody and T-cell receptor (TCR) genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "junctional diversity" .

goldbook:13356 a skos:Concept ;
    skos:definition "Any of a group of enzymes found in the blood and body fluids that acts on certain plasma globulins to produce bradykinins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kallikrein" .

goldbook:13357 a skos:Concept ;
    skos:altLabel "KS" ;
    skos:definition "Form of skin cancer that can involve internal organs. It is most often found in patients with acquired immunodeficiency syndrome (AIDS) and can be fatal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kaposi sarcoma" .

goldbook:13358 a skos:Concept ;
    skos:altLabel "κ-light chain" ;
    skos:definition "Smaller of the two types of light chain found in human immunoglobulins (Ig), the other type being a lambda ($\\uplambda\\!$)-light chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kappa-light chain" .

goldbook:13359 a skos:Concept ;
    skos:definition "Epidermal cell that produces keratin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keratinocyte" .

goldbook:13360 a skos:Concept ;
    skos:altLabel "KAR",
        "killer cell immunoglobulin-like receptor" ;
    skos:definition "Receptor found on natural killer (NK) cells, and some $\\ce{\\upgamma\\!{:}\\updelta\\!}$ and $\\ce{\\upalpha\\!{:}\\upbeta\\! T cells}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "killer activatory receptor" .

goldbook:13361 a skos:Concept ;
    skos:altLabel "K cell" ;
    skos:definition "Cell that displays cell-mediated cytotoxicity, including cytotoxic T lymphocytes (CTL, Tc), natural killer (NK) cells, and natural killer T (NKT) cells. Some also consider activated macrophages, monocytes, and interferon (IFN)-activated neutrophils to be killer cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "killer cell" .

goldbook:13362 a skos:Concept ;
    skos:altLabel "KIR",
        "killer inhibitory receptor" ;
    skos:definition "Receptor expressed on natural killer (NK) cells that binds to major histocompatibility complex (MHC) class I molecules on target cells; binding MHC class I inhibits the signaling that would otherwise lead to target cell killing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "killer cell immunoglobulin-like receptor" .

goldbook:13363 a skos:Concept ;
    skos:altLabel "KLR" ;
    skos:definition "Killer cell receptor that binds to major histocompatibility complex (MHC) class I molecules and, like the C-type lectin receptors also found on these cells, can either inhibit or activate the killer cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "killer lectin-like receptor" .

goldbook:13364 a skos:Concept ;
    skos:definition "Any of a family of polypeptides that is released during inflammatory responses and that increases vascular permeability and smooth muscle contraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinin" .

goldbook:13365 a skos:Concept ;
    skos:definition "Use of homologous genetic recombination in embryonic stem cells to replace a functional gene with a defective copy of the gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "knockout" .

goldbook:13366 a skos:Concept ;
    skos:definition "Mouse produced from embryonic cells containing DNA that has been genetically engineered so that it does not express a particular gene or group of genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "knockout mouse" .

goldbook:13367 a skos:Concept ;
    skos:definition "Fixed tissue macrophage found lining the blood sinuses in the liver." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kupffer cell" .

goldbook:13368 a skos:Concept ;
    skos:definition "Test for sarcoidosis, eliciting a granuloma at the site of intrradermal injection of a lymph node extract from a person with active disease. Generally considered non-specific." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kveim reaction" .

goldbook:13369 a skos:Concept ;
    skos:definition "Any of a group of leukocyte surface adhesion molecules; they are classed as CD62 in the cluster of differentiation (CD) antigen marker system. All have lectin family carbohydrate binding domains and epidermal growth factor (EGF) repeats." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "L-selectin" .

goldbook:13370 a skos:Concept ;
    skos:definition "Family of multi-gene-encoded, small, generally glycosylphosphatidyl inositol-anchored membrane proteins thought to be involved in cell adhesion and signaling, and in antigen-independent activation of lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ly-6" .

goldbook:13371 a skos:Concept ;
    skos:altLabel "LEMS" ;
    skos:definition "Paraneoplastic neurological disorder associated with small-cell lung cancer and caused by autoantibodies against voltage-gated calcium channels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lambert–Eaton myasthenic syndrome" .

goldbook:13372 a skos:Concept ;
    skos:definition "One of the two types of light chain of human immunoglobulins (Ig), the other type being the kappa ($\\kappa$)-light chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lambda (λ)-light chain" .

goldbook:13373 a skos:Concept ;
    skos:definition "Immature, phagocytic dendritic cell of the mammalian skin, characterized by the presence of Fc receptors, major histocompatibility (MHC) class II molecules, and epidermal dendritic cell marker CD1. It contains a cytoplasmic organelle called the Birbeck granule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Langerhans cell" .

goldbook:13374 a skos:Concept ;
    skos:altLabel "LGL" ;
    skos:definition "Lymphocyte of greater than normal size that contains cytoplasmic granules and functions as a natural killer (NK) cell or killer (K) cell. Activated CD8+ cytotoxic T lymphocytes (CTL, Tc) also assume an LGL morphology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "large granular lymphocyte" .

goldbook:13375 a skos:Concept ;
    skos:definition "Immunoglobulin E (IgE)-mediated immune response occurring \\(\\pu{5}\\) to \\(\\pu{8 h}\\) after exposure to antigen, after the 'wheal and flare' reaction of immediate hypersensitivity has diminished, with inflammation peaking around \\(\\pu{24 h}\\), and then subsiding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "late phase reaction" .

goldbook:13376 a skos:Concept ;
    skos:altLabel "latex fixation test" ;
    skos:definition "Use of latex beads coated with antibodies to detect antigen in biological samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latex agglutination test" .

goldbook:13377 a skos:Concept ;
    skos:definition "Allergen found in natural rubber latex (NRL)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latex allergen" .

goldbook:13378 a skos:Concept ;
    skos:definition "Progressive, malignant disease of the blood-forming organs, characterized by excessive proliferation and development of leucocytes and their precursors in the bone marrow and blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukemia" .

goldbook:13379 a skos:Concept ;
    skos:definition "White blood cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukocyte" .

goldbook:13380 a skos:Concept ;
    skos:altLabel "CD45",
        "LCA" ;
    skos:definition "Antigen common to both T lymphocytes and B lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukocyte common antigen" .

goldbook:13381 a skos:Concept ;
    skos:altLabel "LFA" ;
    skos:definition "Any of a group of cell-surface antigens involved in intercellular adhesion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukocyte functional antigen" .

goldbook:13382 a skos:Concept ;
    skos:altLabel "leukopenia" ;
    skos:definition "Amount of leukocytes below normal values that is a characteristic feature of systemic autoimmune diseases [e.g., Felty syndrome, systemic lupus erythematosus (SLE), Sjögren syndrome, mixed connective tissue disease (MCTD)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukocytopenia" .

goldbook:13383 a skos:Concept ;
    skos:definition "Abnormal increase in the number of leukocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukocytosis" .

goldbook:13384 a skos:Concept ;
    skos:definition "Metabolic product of arachidonic acid that promotes inflammatory processes (e.g., chemotaxis, increased vascular permeability) and is produced by a variety of cell types including mast cells, basophils, and macrophages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukotriene" .

goldbook:13385 a skos:Concept ;
    skos:definition "Protein involved, after binding to inducible co-stimulatory protein (ICOS), in several harmful immune responses, such as autoimmunity, allergy, or graft-versus-host (GVH) reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand of inducible co-stimulatory protein" .

goldbook:13386 a skos:Concept ;
    skos:definition "Small polypeptide subunit of an antibody or immunoglobulin (Ig)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light chain" .

goldbook:13387 a skos:Concept ;
    skos:definition "Method of detecting bacterial endotoxins based on gelation of a blood cell lysate from the horseshoe crab, Limulus polyphemus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Limulus test" .

goldbook:13388 a skos:Concept ;
    skos:altLabel "continuous epitope" ;
    skos:definition "Antigenic determinant that is contiguous in the amino acid sequence of a protein and therefore does not require the protein to be folded into its native conformation for antibody to bind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear epitope" .

goldbook:13389 a skos:Concept ;
    skos:definition "Requirement for a helper T lymphocyte (Th) and B lymphocyte to interact with separate but physically linked epitopes in the same antigen, in order for an immune response to a thymus-dependent (TD) antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linked recognition" .

goldbook:13390 a skos:Concept ;
    skos:definition "Cholesterol- and glycosphingolipid-rich membrane subdomain in which molecules involved in cellular activation become concentrated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid raft" .

goldbook:13391 a skos:Concept ;
    skos:definition "Vaccine prepared from living attenuated organisms or from viruses that have been attenuated but can still replicate in the cells of the host organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "live attenuated vaccine" .

goldbook:13392 a skos:Concept ;
    skos:altLabel "LKM",
        "LKM antibodies" ;
    skos:definition "Autoantibodies directed against cytochrome P450 and uridine diphosphate (UDP)-glucuronosyltransferase (UGT) antigens typically found in patients with immune-mediated hepatitis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liver-kidney microsomal antibodies" .

goldbook:13393 a skos:Concept ;
    skos:definition "Enlarged lymph nodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphadenopathy" .

goldbook:13394 a skos:Concept ;
    skos:definition "Morphological or functional unit of lymphatic vessels consisting of the region between adjacent lymphatic valves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphangion" .

goldbook:13395 a skos:Concept ;
    skos:altLabel "lymphatic" ;
    skos:definition "Describing vessels whose special function is the collection of lymph and its ultimate conveyance to the blood circulation and thoracic duct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphatic system" .

goldbook:13396 a skos:Concept ;
    skos:definition "Tissue involved in the collection, production, and handling of lymph, including the lymphatic vessels and lymph nodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphatic tissue" .

goldbook:13397 a skos:Concept ;
    skos:altLabel "lymph gland" ;
    skos:definition "Any of the small rounded gland-like structures of the lymphatic system, which occur along the lymphatic vessels and which are responsible for removing bacteria, viruses, and foreign molecules from the lymph stream and for producing lymphocytes and antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymph node" .

goldbook:13398 a skos:Concept ;
    skos:definition "Abnormal cell with a large nucleus and scanty cytoplasm, thought to be the precursor of the lymphocyte, found in blood and blood-forming organs in patients with lymphoblastic leukemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoblast" .

goldbook:13399 a skos:Concept ;
    skos:definition "Small leucocyte found in the blood, lymph, and lymphoid tissues that has a single round nucleus and little or no granulation in the cytoplasm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte" .

goldbook:13400 a skos:Concept ;
    skos:definition "Interleukin-1 (IL-1)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte-activating factor" .

goldbook:13401 a skos:Concept ;
    skos:altLabel "activation" ;
    skos:definition "Sum of the biochemical processes necessary to stimulate a resting lymphocyte to become an immune effector cell, requiring antigen and co-stimulatory molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte activation" .

goldbook:13402 a skos:Concept ;
    skos:altLabel "LFA-1" ;
    skos:definition "Adhesion molecule found on lymphocytes, macrophages, and neutrophils, involved in adhesion of lymphocytes to antigen-presenting cells (APCs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte function-associated antigen-1" .

goldbook:13403 a skos:Concept ;
    skos:definition "Process that directs lymphocyte subsets to specialized microenvironments that control their differentiation, regulate their survival, and target immune effector cells to sites of antigenic or microbial invasion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte homing" .

goldbook:13404 a skos:Concept ;
    skos:definition "Cell surface glycoprotein on lymphocytes and other leukocytes that mediates adhesion to specialized blood vessels, the high endothelial venules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte homing receptor" .

goldbook:13405 a skos:Concept ;
    skos:altLabel "LPT" ;
    skos:definition "Test of immune sensitization in which white blood cells are exposed in vitro to an antigen and multiply if already sensitized to that antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte proliferation test" .

goldbook:13406 a skos:Concept ;
    skos:altLabel "T-Cell Receptor",
        "immunoglobulin lymphocyte repertoire" ;
    skos:definition "Profile of immunoglobulins (Ig) or T-cell receptors (TCRs) available within a specified group of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin or T-cell receptor lymphocyte repertoire" .

goldbook:13407 a skos:Concept ;
    skos:definition "Population forming part of the whole population of lymphocytes, usually characterized by sensitivity to a given antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte subpopulation" .

goldbook:13408 a skos:Concept ;
    skos:altLabel "LTT",
        "blastogenesis assay",
        "lymphocyte blastogenesis assay (LBA)" ;
    skos:definition "Test for increased DNA synthesis followed by cell division and differentiation of lymphocytes in response to antigens or mitogens; an in vitro test of lymphocyte function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocyte transformation test" .

goldbook:13409 a skos:Concept ;
    skos:altLabel "lymphopenia" ;
    skos:definition "Deficiency of lymphocytes in the blood compared with normal values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocytopenia" .

goldbook:13410 a skos:Concept ;
    skos:definition "Condition characterized by an abnormal increase in the number of lymphocytes in blood, usually a result of infection or inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocytosis" .

goldbook:13411 a skos:Concept ;
    skos:definition "Capability of lysing lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphocytotoxicity" .

goldbook:13412 a skos:Concept ;
    skos:definition "Region of clustered B cells, allowing the selection of antigen-binding B cells by dendritic cells during adaptive immune responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoid follicle" .

goldbook:13413 a skos:Concept ;
    skos:definition "Stem cell giving rise to the lineage of lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoid stem cell" .

goldbook:13414 a skos:Concept ;
    skos:definition "Vertebrate tissue that is made up predominantly of lymphocytes, e.g., lymph, lymph nodes, spleen, thymus, Peyer’s patches, adenoids, pharyngeal tonsils, and, in birds, bursa of Fabricius and cecal tonsils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoid tissue" .

goldbook:13415 a skos:Concept ;
    skos:definition "Cytokine produced by lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphokine" .

goldbook:13416 a skos:Concept ;
    skos:altLabel "LAK",
        "LAK cell",
        "lymphocyte-activated killer cell" ;
    skos:definition "Killer (K) cell or natural killer (NK) cell activated in vitro by interleukin (IL)-2 to give enhanced killing of target cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphokine-activated killer cell" .

goldbook:13417 a skos:Concept ;
    skos:definition "Neoplasm, usually malignant, of the lymphatic tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoma" .

goldbook:13418 a skos:Concept ;
    skos:definition "Production of lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphopoiesis" .

goldbook:13419 a skos:Concept ;
    skos:definition "Proliferation of lymphocytes in response to stimulation with cellular activators, including antigens or mitogens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphoproliferation" .

goldbook:13420 a skos:Concept ;
    skos:definition "Sum of B cells + T cells + natural killer (NK) cells determined separately (by flow cytometry), compared to the total number of lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphosum" .

goldbook:13421 a skos:Concept ;
    skos:altLabel "LT",
        "Tumor necrosis factor β (TNF-β)." ;
    skos:definition "T-cell-derived cytokine that is cytotoxic for certain tumor cells and also has immunoregulatory functions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lymphotoxin" .

goldbook:13422 a skos:Concept ;
    skos:definition "Cytoplasmic granule containing hydrolytic enzymes involved in the digestion of phagocytosed material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lysosome" .

goldbook:13423 a skos:Concept ;
    skos:altLabel "non-specific autophagy" ;
    skos:definition "Sequestration and breakdown of organelles and long-lived proteins in a double-membrane vesicle, called an autophagosome or autophagic vacuole, inside the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroautophagy" .

goldbook:13424 a skos:Concept ;
    skos:definition "Large (\\(\\pu{10\\!{-}\\! 20 \\upmu m}\\) diameter) ameboid and phagocytic cell found in many tissues, especially in areas of inflammation, derived from blood monocytes and playing an important role in host defense mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrophage" .

goldbook:13425 a skos:Concept ;
    skos:altLabel "IAL",
        "fixed macrophage",
        "resident macrophage",
        "residential macrophage" ;
    skos:definition "Macrophage stationed at a point where microbial invasion or accumulation of dust is likely to occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residential macrophage" .

goldbook:13426 a skos:Concept ;
    skos:definition "Any assay suitable to characterize the effect of substances on macrophage function in in vivo or in vitro." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrophage function test" .

goldbook:13427 a skos:Concept ;
    skos:altLabel "MMR" ;
    skos:definition "Receptor involved in pathogen recognition, in clearance of endogenous serum glycoproteins, and in antigen presentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrophage mannose receptor" .

goldbook:13428 a skos:Concept ;
    skos:definition "'High-volume' pinocytosis by which dendritic cells engulf relatively large volumes of fluid from their surroundings, enabling them to take in many antigens nonspecifically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macropinocytosis" .

goldbook:13429 a skos:Concept ;
    skos:definition "Small basic arginine-rich peptide (\\(\\pu{pI 10.9}\\), molecular mass of \\(\\pu{13.8 kDa}\\)) in the granules of eosinophils that kills helminths and protozoa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major basic protein" .

goldbook:13430 a skos:Concept ;
    skos:altLabel "MHC" ;
    skos:definition "Cluster of genes encoding cell surface molecules involved in antigen presentation to T cells. In humans, they are found on chromosome 6 and in mice on chromosome 17. They are polymorphic and code for antigens that lead to rapid graft rejection between members of a single species that differ at these loci." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major histocompatibility complex" .

goldbook:13431 a skos:Concept ;
    skos:altLabel "MHC class I molecule",
        "class I MHC gene product" ;
    skos:definition "Surface protein encoded by the major histocompatibility complex (MHC) expressed on all nucleated cells, presenting antigen-derived peptides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major histocompatibility complex class I molecule" .

goldbook:13432 a skos:Concept ;
    skos:altLabel "MHC class II molecule",
        "class II MHC gene product" ;
    skos:definition "Surface protein encoded by the major histocompatibility complex (MHC) expressed on antigen-presenting cells (APCs), presenting antigen-derived peptides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major histocompatibility complex class II molecule" .

goldbook:13433 a skos:Concept ;
    skos:altLabel "MHC class III molecule",
        "class III MHC gene product" ;
    skos:definition "Antigen encoded by the major histocompatibility complex (MHC) including several complement factors, tumor necrosis factor (TNF) $\\ce{\\upalpha\\!}$, and lymphotoxin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major histocompatibility complex class III molecule" .

goldbook:13434 a skos:Concept ;
    skos:altLabel "MHC molecule" ;
    skos:definition "Any of the cell-surface glycoprotein alloantigens encoded by the major histocompatibility complex (MHC) that are involved in the regulation of immune responses and can cause the rejection of grafted tissues, cells, and tumors bearing them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major histocompatibility complex molecule" .

goldbook:13435 a skos:Concept ;
    skos:altLabel "MHC restriction",
        "restriction (in immunology)" ;
    skos:definition "Necessity that T cells recognize processed antigen only when presented by major histocompatibility complex (MHC) molecules of the original haplotype associated with T-cell priming." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "major histocompatibility complex restriction" .

goldbook:13436 a skos:Concept ;
    skos:altLabel "mTOR" ;
    skos:definition "Intracellular signaling molecule (phosphoinositide-3-kinase) involved in control of cell growth, whose activity is negatively influenced by the immunosuppressive drug rapamycin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mammalian target of rapamycin" .

goldbook:13437 a skos:Concept ;
    skos:altLabel "mannose-binding protein-associated serine protease (MASP)" ;
    skos:definition "Complement-dependent bactericidal factors that bind to the Ra and R2 polysaccharides expressed by certain enterobacterium strains, such as Ra chemotype strains of Salmonella." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mannan-binding lectin-associated serine peptidase-1 and -2" .

goldbook:13438 a skos:Concept ;
    skos:altLabel "MBP",
        "mannose-binding lectin (MBL)" ;
    skos:definition "Member of the collectin family of calcium-dependent lectins, and an acute-phase protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mannose-binding protein" .

goldbook:13439 a skos:Concept ;
    skos:altLabel "corona",
        "mantle" ;
    skos:definition "Outer ring of small lymphocytes surrounding the center of a lymphatic nodule (lymphoid follicle). It contains transient lymphocytes and is the location of the lymphoma in mantle cell lymphoma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mantle zone" .

goldbook:13440 a skos:Concept ;
    skos:definition "Outer area of the splenic periarteriolar lymphoid sheath (PALS) that is rich in B cells, particularly those responding to thymus-independent antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "marginal zone" .

goldbook:13441 a skos:Concept ;
    skos:definition "Leukocyte adhesion to the endothelium of blood vessels in the early phase of an acute inflammatory response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "margination" .

goldbook:13442 a skos:Concept ;
    skos:altLabel "mastocyte" ;
    skos:definition "Large connective tissue cell that contains inflammatory substances such as histamine, proteases (including tryptases, chymases, and carboxypeptidase A), heparin and chondroitin sulfate proteoglycans, and eicosanoid lipid mediators (the precursors of leukotrienes and prostaglandins). These substances are released in allergic reactions or in response to injury or inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mast cell" .

goldbook:13443 a skos:Concept ;
    skos:altLabel "mast cell activation syndrome" ;
    skos:definition "Disorder or syndrome in which there is evidence of systemic, inappropriate release of mast cell mediators." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mast cell activation disorder" .

goldbook:13444 a skos:Concept ;
    skos:definition "Non-steroidal medication that reduces the release of substances from mast cells, e.g., sodium cromoglycate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mast cell stabilizer" .

goldbook:13445 a skos:Concept ;
    skos:altLabel "mast cell tumor" ;
    skos:definition "Nodule of mast cells that can involve the skin, subcutaneous tissue, and sometimes muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mastocytoma" .

goldbook:13446 a skos:Concept ;
    skos:definition "Rare disease characterized by the presence of too many mast cells in various organs and tissues. The condition can be a chronic, long-term illness or it can develop suddenly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mastocytosis" .

goldbook:13447 a skos:Concept ;
    skos:definition "Process by which B cells produce antibodies with increased affinity for antigen during the course of an immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maturation" .

goldbook:13448 a skos:Concept ;
    skos:definition "B cell with immunoglobulin M (IgM) and immunoglobulin D (IgD) on its surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mature B cell" .

goldbook:13449 a skos:Concept ;
    skos:definition "Bone marrow precursor of platelets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "megakaryocyte" .

goldbook:13450 a skos:Concept ;
    skos:altLabel "MAC" ;
    skos:definition "Complex of complement components C5b–C9 that inserts as a pore into the membrane of target cells leading to cell lysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane attack complex" .

goldbook:13451 a skos:Concept ;
    skos:altLabel "immunological memory" ;
    skos:definition "Characteristic of the acquired immune response (see acquired immunity) of lymphocytes whereby a second encounter with a given antigen produces a secondary immune response that is faster, greater, and longer lasting than the primary immune response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "memory" .

goldbook:13452 a skos:Concept ;
    skos:definition "Clonally expanded T cell or B cell produced during a primary immune response and which is primed to mediate a secondary immune response to the original antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "memory cell" .

goldbook:13453 a skos:Concept ;
    skos:altLabel "MELISA" ;
    skos:definition "Patented modification of the lymphocyte transformation test (LTT) based on the enzyme-linked immunosorbent assay (ELISA) principle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "memory lymphocyte immunostimulation assay" .

goldbook:13454 a skos:Concept ;
    skos:definition "Lymph node lying between layers of the mesentery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesenteric lymph node" .

goldbook:13455 a skos:Concept ;
    skos:definition "Formation of one or more chemically reactive intermediate(s) as a result of modification of a molecule by the xenobiotic-metabolizing enzymes of liver and other organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolic activation" .

goldbook:13456 a skos:Concept ;
    skos:definition "Process in which lysosomes directly engulf cytoplasm by invagination, protrusion, and/or septation of the lysosomal limiting membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microautophagy" .

goldbook:13457 a skos:Concept ;
    skos:altLabel "M cell" ;
    skos:definition "Cell found in the follicle-associated epithelium of the Peyer’s patch that has the unique ability to sample antigen from the lumen of the small intestine and deliver it via transcytosis to antigen-presenting cells (APCs) and lymphocytes located in a unique pocket-like structure on their basolateral side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microfold cell" .

goldbook:13458 a skos:Concept ;
    skos:definition "Any small globular protein found on the surface of many cells, including lymphocytes, and in the blood plasma distinct from albumin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microglobulin" .

goldbook:13459 a skos:Concept ;
    skos:altLabel "MPA" ;
    skos:definition "ANCA-associated necrotizing, pauci-immune vasculitis of the small vessels (capillaries, venules, arterioles) frequently associated with rapidly progressive glomerulonephritis and/or hemorrhagic alveolitis as well as autoantibodies against myeloperoxidase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic polyangiitis" .

goldbook:13460 a skos:Concept ;
    skos:definition "Non-major histocompatibility complex (MHC)-encoded cell surface processed peptide which, in association with MHC-encoded molecules, contributes to graft rejection, albeit not usually as severe as that due to MHC mismatch." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minor histocompatibility antigen" .

goldbook:13461 a skos:Concept ;
    skos:definition "Substance that induces lymphocyte transformation or, more generally, mitosis and cell proliferation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitogen" .

goldbook:13462 a skos:Concept ;
    skos:altLabel "MAPK" ;
    skos:definition "Member of a kinase network in which 'upstream' kinases activate 'downstream' kinases that, in response to phosphorylation, translocate to the nucleus and activate transcription factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitogen-activated protein kinase" .

goldbook:13463 a skos:Concept ;
    skos:definition "Autophagy-related pathway specific for mitochondria; it can be subdivided into macromitophagy and micromitophagy depending upon the degree of mitophagy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitophagy" .

goldbook:13464 a skos:Concept ;
    skos:altLabel "MLR",
        "mixed lymphocyte response" ;
    skos:definition "T-cell-proliferative response induced by cells expressing allogeneic major histocompatibility complex (MHC) molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed lymphocyte response" .

goldbook:13465 a skos:Concept ;
    skos:altLabel "MCTD",
        "Sharp’s syndrome" ;
    skos:definition "Human autoimmune disease in which the immune system attacks the body, producing symptoms that combine features of polymyositis, systemic lupus erythematosus (SLE), and systemic scleroderma, and thus being considered as an overlap syndrome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed connective tissue disease" .

goldbook:13466 a skos:Concept ;
    skos:definition "Concept that identity or similarity of epitopes expressed by a pathogen and by a self molecule may lead to production of antibodies reacting to the self-antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular mimicry" .

goldbook:13467 a skos:Concept ;
    skos:definition "Mononuclear phagocyte found in blood and which is the precursor of the tissue macrophage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monocyte" .

goldbook:13468 a skos:Concept ;
    skos:definition "Alternative name for a cytokine produced by monocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monokine" .

goldbook:13469 a skos:Concept ;
    skos:altLabel "MPS",
        "reticuloendothelial system (RES)" ;
    skos:definition "Network of phagocytic cells throughout the body. System comprising blood monocytes and tissue macrophages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mononuclear phagocyte system" .

goldbook:13470 a skos:Concept ;
    skos:altLabel "MIGET" ;
    skos:definition "Procedure in which serum immunoglobulin E (IgE) levels are measured in mice following topical exposure to a test substance. Substances that cause a significant increase in IgE are considered to be potential respiratory allergens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mouse IgE test" .

goldbook:13471 a skos:Concept ;
    skos:altLabel "MEST" ;
    skos:definition "Test for sensitization in which the test substance is applied topically to the ear of a mouse for three consecutive days. The change in ear thickness is then measured following challenge on day 8." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mouse ear-swelling test" .

goldbook:13472 a skos:Concept ;
    skos:definition "Pertaining to or affecting the mucous membranes and/or the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucocutaneous" .

goldbook:13473 a skos:Concept ;
    skos:definition "Moist tissue that lines some organs and body cavities, including the nose, mouth, lungs, and digestive tract." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucosa" .

goldbook:13474 a skos:Concept ;
    skos:altLabel "MALT",
        "bronchus-associated lymphoid tissue (BALT)",
        "nasal-associated lymphoid tissue (NALT)" ;
    skos:definition "Secondary lymphoid tissue present in the surface mucosa of the respiratory tract and bronchus (BALT), gastrointestinal tract (GALT), nasal passages (NALT), larynx (LALT), conjunctiva (CALT), and genitourinary tract, and in the skin sub-epidermis (SALT)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucosa-associated lymphoid tissue" .

goldbook:13475 a skos:Concept ;
    skos:altLabel "MAdCAM-1" ;
    skos:definition "Protein involved in trafficking of lymphocytes to mucosal endothelium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucosal addressin cell adhesion molecule-1" .

goldbook:13476 a skos:Concept ;
    skos:definition "State of lymphocyte hyporesponsiveness to protein antigens applied across mucosal surfaces by oral or nasal instillation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucosal tolerance" .

goldbook:13477 a skos:Concept ;
    skos:definition "Plasma cell malignancy resulting in high levels of monoclonal immunoglobulin (Ig) in serum and of free light chains (Bence–Jones protein) in urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple myeloma" .

goldbook:13478 a skos:Concept ;
    skos:definition "Type of particle immunoassay employing sets of microspheres with various physicochemical features, each labeled with a different antibody. The method allows detection in a single measurement of an array of 100 or more proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplex immunoassay" .

goldbook:13479 a skos:Concept ;
    skos:definition "Undifferentiated stem cell, obtained from adult bone marrow or other non-embryonic tissue sources, that possesses the ability to differentiate into a variety of cell types, especially into cells of a closely related family of cells that are expanded in vitro and deposited in master cell banks for 'off-the-shelf' use, with potential hematopoiesis-inducing and immunomodulating activities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multipotent progenitor cell" .

goldbook:13480 a skos:Concept ;
    skos:altLabel "LLNA",
        "local lymph node assay (LLNA)" ;
    skos:definition "Predictive test of sensitization in which a test substance is applied topically to the skin of mice (usually three times at daily intervals) and the weight of the local draining lymph nodes is measured at six days. Usually lymphoproliferation in the nodes is measured following injection of [\\(\\ce{^{3}H}\\)]thymidine or bromodeoxyuridine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "murine local lymph node assay" .

goldbook:13481 a skos:Concept ;
    skos:altLabel "acquired myasthenia gravis" ;
    skos:definition "Autoimmune disease characterized by muscle weakness usually affecting ocular and oropharyngeal muscles due to an autoimmune attack against components of the neuromuscular junction (e.g., the nicotinic acetylcholine receptor)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acquired myasthenia gravis" .

goldbook:13482 a skos:Concept ;
    skos:definition "Diverse collection of hematological conditions united by ineffective production (or dysplasia) of myeloid blood cells and risk of transformation to acute myelogenous leukemia (AML). Anemia requiring chronic blood transfusion is frequently present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelodysplastic syndrome" .

goldbook:13483 a skos:Concept ;
    skos:definition "Tumor composed of cells derived from hematopoietic cells (see hematopoiesis) of the bone marrow, or from mast cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloma" .

goldbook:13484 a skos:Concept ;
    skos:altLabel "myelogenous" ;
    skos:definition "Referring to the nonlymphocytic groups of white blood cells, including granulocytes, monocytes, and platelets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloid" .

goldbook:13485 a skos:Concept ;
    skos:definition "One of two groups of stem cells produced in the bone marrow. Myeloid stem cells may mature into several types of blood cells, including acidic basophils, eosinophils, erythrocytes, macrophages, megakaryocytes, and neutrophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloid stem cell" .

goldbook:13486 a skos:Concept ;
    skos:definition "Tissue within red bone marrow that produces the blood cells. It is found around the blood vessels and contains various cell types that are precursors of the blood cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloid tissue" .

goldbook:13487 a skos:Concept ;
    skos:definition "Monoclonal antibody secreted by myeloma cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloma protein" .

goldbook:13488 a skos:Concept ;
    skos:altLabel "MPO" ;
    skos:definition "Enzyme found in azurophilic granules of neutrophils, the major target of antineutrophil cytoplasmic autoantibody (ANCA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myeloperoxidase" .

goldbook:13489 a skos:Concept ;
    skos:definition "Process of formation and development of myeloid blood cells in the bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelopoiesis" .

goldbook:13490 a skos:Concept ;
    skos:definition "Decrease in myeloid cells, including pancytopenia, anemia, leukopenia, lymphopenia, thrombocytopenia, and other blood dyscrasias." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myelosuppression" .

goldbook:13491 a skos:Concept ;
    skos:altLabel "autoimmune myositis" ;
    skos:definition "Rare systemic inflammatory myopathy, including primary polymyositis, primary dermatomyositis, myositis associated with malignancy, childhood dermatomyositis, and myositis with multisystem autoimmune disease [e.g., mixed connective tissue disease (MCTD), systemic sclerosis (SSc)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune myositis" .

goldbook:13492 a skos:Concept ;
    skos:altLabel "cryopyrin" ;
    skos:definition "NOD-like receptor (NLR), found in certain inflammasomes, that binds to aggregated proteins and the peptides that compose them. Its activation leads to the generation of inflammatory cytokines, such as interleukin (IL)-1, and neurotoxic factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "NACHT domain-, leucine-rich repeat (LRR)-, and pyrin (N-terminal homology) domain (PYD)-containing protein 3" .

goldbook:13493 a skos:Concept ;
    skos:definition "Non-templated nucleotides added to the junctions between antibody and T-cell receptor (TCR) variable (V) gene, diversity (D) gene, and joining (J) gene segments during gene rearrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "N-nucleotides" .

goldbook:13494 a skos:Concept ;
    skos:altLabel "NLR" ;
    skos:definition "Any of a large family of cytoplasmic proteins containing a nucleotide-binding domain and leucine-rich repeats (LRRs), involved in regulation of inflammation and apoptosis; many family members are thought to function as pattern recognition receptors (PRRs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "NOD-like receptor" .

goldbook:13495 a skos:Concept ;
    skos:definition "Highly variable region on the H-chain of immunoglobulins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "N-region" .

goldbook:13496 a skos:Concept ;
    skos:definition "Mature T cell or B cell that has not yet been activated (see lymphocyte activation) by encounter with antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "naïve lymphocyte" .

goldbook:13497 a skos:Concept ;
    skos:altLabel "NAA" ;
    skos:definition "Part of the naturally occurring repertoire of polyreactive antibodies that bind to autoantigens with low affinity. They are mainly of immunoglobulin M (IgM) isotype and produced by CD5+ B lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural autoantibodies" .

goldbook:13498 a skos:Concept ;
    skos:definition "Host defense mechanisms that do not require prior exposure to antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural immunity" .

goldbook:13499 a skos:Concept ;
    skos:altLabel "NK",
        "NK cell" ;
    skos:definition "Large granular lymphocyte which does not rearrange nor express either immunoglobulin or T-cell receptor (TCR) genes but is able to recognize and destroy certain tumor and virally infected cells in a major histocompatibility complex (MHC) molecule- and antibody-independent manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural killer cell" .

goldbook:13500 a skos:Concept ;
    skos:definition "Immunotoxicity test in which lymphoid tissue or blood that has been treated with a test compound is co-incubated with target cells. The cytotoxic effect on target cells is measured, e.g., with the chromium release assay. It is used under circumstances where differences from untreated cells are attributed to natural killer (NK) cell activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural killer cell activity assay" .

goldbook:13501 a skos:Concept ;
    skos:altLabel "NKT",
        "NKT cell" ;
    skos:definition "Lymphoid cells with a morphology and granule content intermediate between T cells and natural killer (NK) cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural killer T cell" .

goldbook:13502 a skos:Concept ;
    skos:altLabel "NRAMP-1" ;
    skos:definition "Iron transporter that plays a critical role in macrophage activation and differentiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural resistance-associated macrophage protein" .

goldbook:13503 a skos:Concept ;
    skos:definition "Deletion by apoptosis in the thymus of T cells that recognize self-peptides presented by self-major histocompatibility complex (MHC) molecules, thus preventing the development of autoimmune T cells. Negative selection of developing B cells is also thought to occur if they encounter high levels of self-antigen in the bone marrow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative selection" .

goldbook:13504 a skos:Concept ;
    skos:definition "Antigen newly expressed on a tumor or virally infected cell, or arising after macromolecule-hapten binding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neoantigen" .

goldbook:13505 a skos:Concept ;
    skos:definition "Tolerance to specific foreign antigens induced by the exposure of a bird or mammal to the foreign antigens during embryonic or neonatal life, depending upon species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neonatal tolerance" .

goldbook:13506 a skos:Concept ;
    skos:altLabel "autoimmune nephritis" ;
    skos:definition "Inflammation of the kidney due to immunological reaction to renal antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune nephritis" .

goldbook:13507 a skos:Concept ;
    skos:altLabel "autoimmune neuropathy" ;
    skos:definition "Autoimmune disease of the nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune neuropathy" .

goldbook:13508 a skos:Concept ;
    skos:definition "Blocking by an antibody of the effects of a virus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutralization" .

goldbook:13509 a skos:Concept ;
    skos:definition "Abnormally low concentration of neutrophils in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutropenia" .

goldbook:13510 a skos:Concept ;
    skos:altLabel "polymorphonuclear leucocyte" ;
    skos:definition "Granular leukocyte, the major circulating phagocytic polymorphonuclear granulocyte, having a nucleus with three to five lobes and fine cytoplasmic granules stainable by neutral dyes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutrophil" .

goldbook:13511 a skos:Concept ;
    skos:definition "Change in morphology and behavior of a neutrophil resulting from exposure to a cytokine, chemokine, cellular ligand, or soluble factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutrophil activation" .

goldbook:13512 a skos:Concept ;
    skos:definition "Generic term for nitrogen monoxide species, including nitrosonium ion, nitric oxide radical, etc., that can function in a cell-signaling capacity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitric oxide" .

goldbook:13513 a skos:Concept ;
    skos:definition "Cell surface antibody that does not provoke attack by killer cells and thus does not provoke depletion of a group of cells in the body, usually referring to B cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nondepleting antibody" .

goldbook:13514 a skos:Concept ;
    skos:definition "Any of various malignant lymphomas characterized by the absence of Reed–Sternberg cells and producing symptoms similar to those of Hodgkin disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-Hodgkin lymphoma" .

goldbook:13515 a skos:Concept ;
    skos:altLabel "NOD",
        "NOD mouse" ;
    skos:definition "Genetically modified mouse with a susceptibility to spontaneous development of automimmune diabetes mellitus type I." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-obese diabetic mouse" .

goldbook:13516 a skos:Concept ;
    skos:definition "Of, relating to, or designating a cell or tissue that has not been produced by the individual organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-self" .

goldbook:13517 a skos:Concept ;
    skos:altLabel "NFAT" ;
    skos:definition "Transcription factor involved in rapid cell response to stress, such as injury or invading pathogens, and in cell proliferation and survival." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear factor of activated T cells" .

goldbook:13518 a skos:Concept ;
    skos:altLabel "NFκB" ;
    skos:definition "Protein complex that controls the transcription of genes involved in cytokine production, cellular adhesion, inflammation, and apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear factor kappa-light-chain-enhancer of activated B cells" .

goldbook:13519 a skos:Concept ;
    skos:definition "Members of a family of human intracellular proteins involved in the detection of invasive bacteria and activation of the $\\ce{NF\\kappa B}$ transcription factor pathway." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleotide-binding oligomerization domain-containing protein 1, 2" .

goldbook:13520 a skos:Concept ;
    skos:altLabel "NLR",
        "NOD-like receptor protein (NLRP)" ;
    skos:definition "Cytosolic protein that contains a central nucleotide-binding oligomerization domain, an N-terminal effector-binding domain and C-terminal leucine-rich repeats (LRRs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleotide-binding oligomerization domain-containing protein-like receptor" .

goldbook:13521 a skos:Concept ;
    skos:definition "Mouse that is T-cell-deficient due to a homozygous gene defect (\\(nu/nu\\)) resulting in the absence of a thymus (and also lack of body hair)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nude mouse" .

goldbook:13522 a skos:Concept ;
    skos:definition "Lymphocyte with neither T- nor B-cell differentiation antigens on its surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "null cell" .

goldbook:13523 a skos:Concept ;
    skos:definition "Brand name for muromonab-CD3, an immunosuppressant drug given intravenously to reverse acute rejection of transplanted organs, including the heart, kidneys, and liver." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "OKT3" .

goldbook:13524 a skos:Concept ;
    skos:definition "Having a few different clones, or the product of a few different clones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligoclonal" .

goldbook:13525 a skos:Concept ;
    skos:definition "Antigen whose expression is normally restricted to the fetus but which may be expressed during malignancy in adults." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oncofetal antigen" .

goldbook:13526 a skos:Concept ;
    skos:definition "Coating of antigen with an opsonin to enhance phagocytosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "opsonization" .

goldbook:13527 a skos:Concept ;
    skos:definition "Orally induced and immune-mediated non-responsiveness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oral tolerance" .

goldbook:13528 a skos:Concept ;
    skos:definition "Immunization against a pathogen with a vaccine administered by mouth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oral vaccination" .

goldbook:13529 a skos:Concept ;
    skos:altLabel "Ouchterlony double diffusion assay",
        "double diffusion" ;
    skos:definition "Double-radial immunodiffusion procedure for the detection of precipitating antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ouchterlony technique" .

goldbook:13530 a skos:Concept ;
    skos:definition "Palindromic nucleotide sequences generated at the junctions between antibody and T-cell receptor (TCR) variable (V), diversity (D), and joining (J) gene segments during gene rearrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "P-nucleotides" .

goldbook:13531 a skos:Concept ;
    skos:definition "Cell adhesion molecule expressed on the surface of activated endothelial cells and platelets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "P-selectin" .

goldbook:13532 a skos:Concept ;
    skos:definition "Decrease in the number of red blood cells, white blood cells, and platelets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pancytopenia" .

goldbook:13533 a skos:Concept ;
    skos:altLabel "paracortex" ;
    skos:definition "Region of a lymph node enriched in T lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paracortical area" .

goldbook:13534 a skos:Concept ;
    skos:definition "Paracrine agonist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paramone" .

goldbook:13535 a skos:Concept ;
    skos:definition "Any of several autoimmune diseases that are caused by tumor-induced perturbations of the immune system with damaging effects on various organ systems (e.g. cancer-associated retinopathy, paraneoplastic neurological syndromes, paraneoplastic cutaneous syndromes). In most cases, autoantibodies generated by antitumor immunity are responsible for the tissue injury." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paraneoplastic autoimmune syndrome" .

goldbook:13536 a skos:Concept ;
    skos:definition "Site in the variable region of an antibody or T-cell receptor (TCR) that binds to an epitope of an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paratope" .

goldbook:13537 a skos:Concept ;
    skos:definition "Immunoassay in which antibody is bound to the surface of microspheres. After incubation with the antigen-containing biological fluid, and subsequent manipulation, detection is usually performed by flow cytometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle immunoassay" .

goldbook:13538 a skos:Concept ;
    skos:altLabel "PCA",
        "PCA test" ;
    skos:definition "Assay for allergenicity in which an antibody is injected intradermally into a test animal followed at a later time (anywhere from \\(\\pu{3}\\) to \\(\\pu{48 h}\\)) with an intravenous injection of a mixture of a test antigen and a dye (typically Evans blue). Increased vascular permeability at the site of antigen-antibody reaction is visualized by extravasation of the dye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive cutaneous anaphylaxis test" .

goldbook:13539 a skos:Concept ;
    skos:definition "Method of measuring antibody titer, in which antigen-coated erythrocytes are agglutinated by adding antibody specific for the antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive hemagglutination" .

goldbook:13540 a skos:Concept ;
    skos:definition "Immunization of an individual by the transfer of antibody synthesized in another individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive immunization" .

goldbook:13541 a skos:Concept ;
    skos:definition "Test for allergy that is performed by placing the suspected allergen in direct contact with the skin or mucosa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "patch test" .

goldbook:13542 a skos:Concept ;
    skos:altLabel "PAMP" ;
    skos:definition "Describing repetitive motifs of molecules such as lipopolysaccharide (LPS), peptidoglycan, lipoteichoic acids, and mannans, which are widely expressed by microbial pathogens but are not present on host tissues. They are therefore utilized by the pattern recognition receptors (PRRs) of the immune system to distinguish pathogens from self-antigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pathogen-associated molecular pattern" .

goldbook:13543 a skos:Concept ;
    skos:altLabel "PRR" ;
    skos:definition "Receptor found on many different cell types in the immune system that enables them to recognize pathogen-associated molecular patterns (PAMPs). Amongst the large number of different PRRs are the mannose receptor (CD206), macrophage scavenger receptor (CD204), and the toll-like receptors (TLRs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pattern recognition receptor" .

goldbook:13544 a skos:Concept ;
    skos:definition "Referring to vasculitis characterized by relatively little deposition of immunoglobulin (Ig) and complement factors, usually describing a form of glomerulonephritis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pauci-immune" .

goldbook:13545 a skos:Concept ;
    skos:altLabel "pemphigus vulgaris" ;
    skos:definition "Rare, serious autoimmune disease marked by successive outbreaks of blisters, which appear suddenly and disappear, leaving pigmented spots." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pemphigus" .

goldbook:13546 a skos:Concept ;
    skos:definition "Structure consisting of four identical major histocompatibility complex (MHC)-encoded peptides, presenting four binding sites for biotin attached to the tail of the MHC molecule, and held together by fluorescent streptavidin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide tetramer" .

goldbook:13547 a skos:Concept ;
    skos:definition "Preparation of an immunologically active peptide found in a disease-causing organism or substance, or any of their products, which is specially treated for use in vaccination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide vaccine" .

goldbook:13548 a skos:Concept ;
    skos:definition "Structural feature found in major histocompatibility complex (MHC) class I and class II heterodimeric proteins that can bind endogenous peptides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptide-binding groove" .

goldbook:13549 a skos:Concept ;
    skos:definition "Molecule produced by cytotoxic T cells and natural killer (NK) cells that, like complement component C9, polymerizes to form a pore in the membrane of the target cell leading to cell death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perforin" .

goldbook:13550 a skos:Concept ;
    skos:altLabel "PALS" ;
    skos:definition "Lymphoid tissue that forms the white pulp of the spleen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periarteriolar lymphoid sheath" .

goldbook:13551 a skos:Concept ;
    skos:definition "Inflammatory reaction of the tissues surrounding a tooth (periodontium), usually resulting from the extension of gingival inflammation (gingivitis) into the periodontium, and involving inflammation and infection of the ligaments and bones that support the teeth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periodontitis" .

goldbook:13552 a skos:Concept ;
    skos:altLabel "PBL" ;
    skos:definition "Leukocyte derived from the peripheral circulatory system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral blood leukocyte" .

goldbook:13553 a skos:Concept ;
    skos:altLabel "PBMC" ;
    skos:definition "Monocyte produced by the bone marrow from hematopoietic stem cell precursors, circulating in the bloodstream for about one to three days before moving into tissues throughout the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral blood mononuclear cell" .

goldbook:13554 a skos:Concept ;
    skos:definition "Any of the lymphoid organs (see lymphoid tissue) other than the thymus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral lymphoid organ" .

goldbook:13555 a skos:Concept ;
    skos:altLabel "autoimmune peripheral neuropathy" ;
    skos:definition "Acute or chronic inflammatory neuropathy leading to demyelination and axonal damage of nerves and nerve roots associated with high-titeredautoantibodies against gangliosides [e.g., Guillain–Barré syndrome (GBS), Miller–Fisher syndrome, acute sensory ataxic neuropathy]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune peripheral neuropathy" .

goldbook:13556 a skos:Concept ;
    skos:definition "Specific immunological tolerance occurring outside of the primary lymphoid organs (see lymphoid tissue)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral tolerance" .

goldbook:13557 a skos:Concept ;
    skos:definition "Disease in which the erythrocytes are abnormally formed, due to an inability to absorb vitamin \\({\\rm{B}}_{12}\\). True pernicious anemia refers specifically to a disorder of atrophied parietal cells leading to absent intrinsic factor, resulting in an inability to absorb \\({\\rm{B}}_{12}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pernicious anemia" .

goldbook:13558 a skos:Concept ;
    skos:definition "Autophagy selective for degradation of peroxisomes, which can be separated into macropexophagy and micropexophagy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pexophagy" .

goldbook:13559 a skos:Concept ;
    skos:definition "Part of the gut-associated lymphoid tissue (GALT) and found as a distinct lymphoid nodule, mainly in the small intestine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Peyer’s patch" .

goldbook:13560 a skos:Concept ;
    skos:definition "Cell, especially of monocyte/macrophage or neutrophil lineage, that is specialized for the engulfment of cellular and particulate matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phagocyte" .

goldbook:13561 a skos:Concept ;
    skos:altLabel "phagocytosis assay" ;
    skos:definition "Method of quantifying phagocytosis in which yeast cells, stained with May–Grünwald stain, are incubated with macrophages, and subsequently, after a fixed time, yeast cells engulfed in the macrophages are counted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phagocytic activity assay" .

goldbook:13562 a skos:Concept ;
    skos:definition "Process by which particulate material is endocytosed by a cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phagocytosis" .

goldbook:13563 a skos:Concept ;
    skos:definition "Intracellular vacuole where killing and digestion of phagocytosed material occurs following the fusion of a phagosome with a lysosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phagolysosome" .

goldbook:13564 a skos:Concept ;
    skos:definition "Intracellular vacuole produced following invagination of the cell membrane around phagocytosed material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phagosome" .

goldbook:13565 a skos:Concept ;
    skos:definition "Chromosome resulting from a reciprocal translocation between human chromosomes 9 and 22, most commonly associated with chronic myelogenous leukemia (CML)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Philadelphia chromosome" .

goldbook:13566 a skos:Concept ;
    skos:altLabel "PMA",
        "tetradecanoyl phorbol acetate (TPA)" ;
    skos:definition "Mitogenic phorbol ester that directly stimulates protein kinase C (PKC) and acts as a tumor promoter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phorbol 12-myristate 13-acetate" .

goldbook:13567 a skos:Concept ;
    skos:altLabel "PLC-γ" ;
    skos:definition "Enzyme that cleaves phosphatidylinositol bisphosphate into diacylglycerol and inositol trisphosphate, leading to the activation of two major cell signaling pathways." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phospholipase Cγ" .

goldbook:13568 a skos:Concept ;
    skos:definition "Type IV hypersensitivity reaction in which photoactivation of a substance produces a hapten that then acts as a sensitizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoallergy" .

goldbook:13569 a skos:Concept ;
    skos:definition "Type of contact dermatitis arising when substances are transformed into either irritants or allergens upon exposure to light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocontact dermatitis" .

goldbook:13570 a skos:Concept ;
    skos:definition "Skin reddening due to an abnormal reaction to sunlight, characteristic of systemic autoimmune diseases [e.g., systemic lupus erythematosus (SLE), mixed connective tissue disease (MCTD)], and cutaneous and subacute cutaneous lupus erythematosus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosensitivity" .

goldbook:13571 a skos:Concept ;
    skos:definition "Procedure used to identify the phototoxic potential of a test substance. The substance is administered either systemically or topically on the skin, and light is subsequently shone on the skin to photoexcite the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phototoxicity test" .

goldbook:13572 a skos:Concept ;
    skos:altLabel "PHA" ;
    skos:definition "Plant lectin that acts as a T-cell mitogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phytohemagglutinin" .

goldbook:13573 a skos:Concept ;
    skos:definition "Animal antibody (or fragment thereof), expressed in a genetically modified plant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plantibody" .

goldbook:13574 a skos:Concept ;
    skos:altLabel "PFC" ;
    skos:definition "Antibody-secreting plasma cell detected in vitro by its ability to produce a 'plaque' of lysed antigen-sensitized erythrocytes in the presence of complement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plaque-forming cell" .

goldbook:13575 a skos:Concept ;
    skos:definition "Highly proliferative cell that is a developmental intermediate between small B lymphocytes and immunoglobulin (Ig)-secreting mature plasma cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasmablast" .

goldbook:13576 a skos:Concept ;
    skos:definition "Terminally differentiated B lymphocyte, with little or no capacity for mitotic division, that actively secretes large amounts of antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma cell" .

goldbook:13577 a skos:Concept ;
    skos:definition "Dendritic cell of distinct lineage, found in blood and peripheral lymphoid tissue, which secretes large amounts of interferon (IFN) upon activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasmacytoid dendritic cell" .

goldbook:13578 a skos:Concept ;
    skos:definition "Mass of neoplastic monoclonal plasma cells growing in bone or soft tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasmacytoma" .

goldbook:13579 a skos:Concept ;
    skos:altLabel "plasma exchange" ;
    skos:definition "Technique of extracorporeal separation of blood cells from plasma, with return of the cells to the patient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasmapheresis" .

goldbook:13580 a skos:Concept ;
    skos:altLabel "thrombocyte" ;
    skos:definition "Small irregular or disc-shaped cell found in large numbers in mammalian blood, essential for blood clotting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "platelet" .

goldbook:13581 a skos:Concept ;
    skos:altLabel "PAF" ;
    skos:definition "Alkyl phospholipid released by a variety of cell types including mast cells and basophils, which has immunoregulatory effects on lymphocytes and monocytes/macrophages, as well as causing platelet aggregation and degranulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "platelet-activating factor" .

goldbook:13582 a skos:Concept ;
    skos:altLabel "PDGF" ;
    skos:definition "Protein synthesized by platelets that is released into the serum during blood clotting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "platelet-derived growth factor" .

goldbook:13583 a skos:Concept ;
    skos:definition "Self-replicating cell capable of developing into cells and tissues of the three primary embryonic germ layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pluripotent stem cell" .

goldbook:13584 a skos:Concept ;
    skos:altLabel "PWM" ;
    skos:definition "Plant lectin which is a T-cell-dependent B-cell mitogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pokeweed mitogen" .

goldbook:13585 a skos:Concept ;
    skos:altLabel "disseminated necrotizing periarteritis",
        "panarteritis",
        "periarteritis",
        "periarteritis nodosa" ;
    skos:definition "Systemic disease characterized by widespread inflammation of small and medium-sized arteries in which many of the foci are nodular." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyarteritis nodosa" .

goldbook:13586 a skos:Concept ;
    skos:definition "Substance that induces activation of multiple clones of B lymphocytes or T lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyclonal activator" .

goldbook:13587 a skos:Concept ;
    skos:altLabel "APECED syndrome",
        "autoimmune polyendocrinopathy" ;
    skos:definition "Autoimmune disease affecting multiple endocrine organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune polyendocrinopathy" .

goldbook:13588 a skos:Concept ;
    skos:definition "Polyinosinic:polycytidylic acid, a synthetic immunostimulant mimicking viral double-stranded RNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poly I:C" .

goldbook:13589 a skos:Concept ;
    skos:definition "Polyinosinic:polycytidylic acid, poly-ʟ-lysine, and carboxymethylcellulose (letter roots of the acronym underlined), a synthetic immunostimulant mimicking viral double-stranded RNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poly ICLC" .

goldbook:13590 a skos:Concept ;
    skos:definition "Receptor molecule that specifically binds J chain-containing polymeric immunoglobulin (Ig), i.e., dimeric secretory immunoglobulin A (IgA) and pentameric immunoglobulin M (IgM), and transports it across mucosal epithelium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poly-Ig receptor" .

goldbook:13591 a skos:Concept ;
    skos:definition "Mature leukocyte with granular cytoplasm and a segmented and irregularly shaped nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymorphonuclear leukocyte" .

goldbook:13592 a skos:Concept ;
    skos:definition "Disorder characterized by inflammation and degeneration of skeletal muscle, causing pain, weakness, and wasting in affected (usually proximal) muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymyositis" .

goldbook:13593 a skos:Concept ;
    skos:altLabel "PLNA" ;
    skos:definition "Test for immunosensitization measuring popliteal lymph node hyperplasia after subcutaneous injection of a test substance into the footpad of the hindpaw of a rodent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "popliteal lymph node assay" .

goldbook:13594 a skos:Concept ;
    skos:definition "Selection of those developing T cells in the thymus that are able to recognize self-major histocompatibility complex (MHC) molecules. This occurs by preventing apoptosis in these cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positive selection" .

goldbook:13595 a skos:Concept ;
    skos:definition "Cell in the B-lymphocyte lineage that has rearranged heavy chain but not light chain genes; it expresses surrogate light chains and \\(\\upmu\\) heavy chain at its surface in conjunction with immunoglobulins Ig _012643_ and Ig _012644_. All these molecules comprise the pre-B-cell receptor (pre-BCR)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-B cell" .

goldbook:13596 a skos:Concept ;
    skos:definition "Antibody that is capable of reacting with a soluble antigen with the formation of an insoluble antigenantibody complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitating antibody" .

goldbook:13597 a skos:Concept ;
    skos:definition "Precipitate of antibody and multivalent antigen due to the formation of high-molecular-weight complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitin" .

goldbook:13598 a skos:Concept ;
    skos:altLabel "single-positive cell",
        "thymocyte" ;
    skos:definition "Cell differentiating into a T lymphocyte in the thymus gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-T cell" .

goldbook:13599 a skos:Concept ;
    skos:definition "Test carried out by placing a drop of a suspected allergenic extract on the skin of the forearm and gently pricking it into the upper layer of skin. Sensitivity to a substance is indicated if the spot swells slightly and becomes red within about \\(\\pu{15 min}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prick test" .

goldbook:13600 a skos:Concept ;
    skos:altLabel "PBC" ;
    skos:definition "Autoimmune liver disease that results in the destruction of bile ducts, leading to fibrosis and cirrhosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary biliary cirrhosis" .

goldbook:13601 a skos:Concept ;
    skos:altLabel "primary response" ;
    skos:definition "Immune response to the first encounter with an antigen, characterized by slow production of antibody molecules and the priming of lymphoid tissue in readiness for the production of a secondary immune response on subsequent challenge with the same antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary immune response" .

goldbook:13602 a skos:Concept ;
    skos:definition "First introduction of a vaccine into the body for the purposes of inducing immunity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary immunization" .

goldbook:13603 a skos:Concept ;
    skos:definition "Region of a secondary lymphoid organ containing predominantly unstimulated B lymphocytes that develops into a germinal center following antigen stimulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary lymphoid follicle" .

goldbook:13604 a skos:Concept ;
    skos:definition "Site at which immunocompetent lymphocytes develop, i.e., bone marrow and thymus in mammals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary lymphoid organ" .

goldbook:13605 a skos:Concept ;
    skos:definition "Atrophic form of diffuse autoimmune thyroiditis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary myxedema" .

goldbook:13606 a skos:Concept ;
    skos:altLabel "PSC" ;
    skos:definition "Chronic, non-bacterial, inflammatory narrowing of the bile ducts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary sclerosing cholangitis" .

goldbook:13607 a skos:Concept ;
    skos:altLabel "priming" ;
    skos:definition "Process of giving an initial sensitization to antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prime" .

goldbook:13608 a skos:Concept ;
    skos:definition "Highly efficient antigen-presenting cell (APC), generally referring to dendritic cells, B cells, or macrophages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "professional antigen-presenting cell" .

goldbook:13609 a skos:Concept ;
    skos:definition "Systemic autoimmune disease marked by formation of hyalinized and thickened collagenous fibrous tissue, with thickening and adhesion of skin to underlying tissues, especially of the hands and face and vascular alterations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "progressive systemic sclerosis" .

goldbook:13610 a skos:Concept ;
    skos:definition "Cytokine that initiates or enhances inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proinflammatory cytokine" .

goldbook:13611 a skos:Concept ;
    skos:definition "Any test that determines the effect on increase in cell number of a test agent such as a cytokine or mitogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proliferation assay" .

goldbook:13612 a skos:Concept ;
    skos:definition "Relatively heat-labile, normal serum protein (a euglobulin) that, in the presence of complement component C3 and magnesium ions, is involved in the alternative pathway of complement activation, and acts nonspecifically against Gram-negative bacteria and viruses and may contribute to the lysis of erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "properdin" .

goldbook:13613 a skos:Concept ;
    skos:definition "Cytoplasmic and nuclear multiprotein proteolytic complex involved in degradation of excess, damaged, or misfolded proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteasome" .

goldbook:13614 a skos:Concept ;
    skos:altLabel "CD59" ;
    skos:definition "Member of the Ly-6 family of cell surface molecules that prevents insertion of the membrane attack complex (MAC) into the membrane, thereby protecting cells from complement-induced lysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protectin" .

goldbook:13615 a skos:Concept ;
    skos:definition "Protection against infectious agents conferred by vaccination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protective immunity" .

goldbook:13616 a skos:Concept ;
    skos:definition "Staphylococcus aureus cell wall protein that binds to the Fc region of immunoglobulin G (IgG)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein A" .

goldbook:13617 a skos:Concept ;
    skos:altLabel "PR3" ;
    skos:definition "Multifunctional enzyme of azurophilic granules of neutrophils and monocytes and the major target of antineutrophil cytoplasmic autoantibodies (ANCA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteinase 3" .

goldbook:13618 a skos:Concept ;
    skos:definition "Streptococcal cell wall protein that binds to the Fc region of immunoglobulin G (IgG), with a wider species specificity than protein A." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein G" .

goldbook:13619 a skos:Concept ;
    skos:altLabel "PKC" ;
    skos:definition "Member of a kinase family with broad substrate specificity, activated by calcium, diacylglycerol, and (or) phorbol 12-myristate 13-acetate (PMA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein kinase C" .

goldbook:13620 a skos:Concept ;
    skos:definition "Loss of immunoprecipitation or agglutination that occurs when antibody concentration is increased to an extent that the antibody is in such excess that it is no longer able to effectively cross-link the antigen. A similar phenomenon may occur in antigen excess." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prozone effect" .

goldbook:13621 a skos:Concept ;
    skos:altLabel "pseudoallergic reaction" ;
    skos:definition "Inflammatory or anaphylactic reaction with symptoms similar to an allergy but not involving an antigen-specific immune response, e.g., salicylate intolerance, reaction to contrast reagents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudoallergy" .

goldbook:13622 a skos:Concept ;
    skos:definition "Skin disorder that has a hereditary component and is characterized by erythematous patches covered with silvery scales, especially on the elbows, knees, and scalp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psoriasis" .

goldbook:13623 a skos:Concept ;
    skos:definition "Of, relating to, or associated with psoriasis; affected with psoriasis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psoriatic" .

goldbook:13624 a skos:Concept ;
    skos:altLabel "PPD" ;
    skos:definition "Partially purified derivative of tuberculin used in the Mantoux test for tuberculosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "purified protein derivative" .

goldbook:13625 a skos:Concept ;
    skos:definition "Purple discoloration occurring in patches on the skin, mucus membranes, or organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "purpura" .

goldbook:13626 a skos:Concept ;
    skos:definition "Any substance that produces fever." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrogen" .

goldbook:13627 a skos:Concept ;
    skos:definition "Any of various tests used to determine whether an agent, usually an infusion or injection fluid, is free of pyrogens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrogen test" .

goldbook:13628 a skos:Concept ;
    skos:definition "'Non-classical' major histocompatibility complex (MHC) class I molecule in mice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Qa antigen" .

goldbook:13629 a skos:Concept ;
    skos:altLabel "Mancini immunodiffusion" ;
    skos:definition "Method for quantifying an antigen by measuring the diameters of circular precipitates around an antigen-spiked cavity in an antibody-containing agar gel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radial immunodiffusion" .

goldbook:13630 a skos:Concept ;
    skos:altLabel "RAST" ;
    skos:definition "Solid-phase radioimmunoassay (RIA) for detecting immunoglobulin E (IgE) antibody specific for a particular antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioallergosorbent test" .

goldbook:13631 a skos:Concept ;
    skos:definition "Biochemical conjugate consisting of an immune-targeting molecule such as an antibody or antibody fragment together with a cytotoxic radionuclide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioimmunoconjugate" .

goldbook:13632 a skos:Concept ;
    skos:definition "Intermittent bilateral attacks of vasospasm and ischemia of the fingers or toes and sometimes of the ears and nose, marked by a severe pallor and often accompanied by paresthesia and pain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raynaud phenomenon" .

goldbook:13633 a skos:Concept ;
    skos:altLabel "RADS" ;
    skos:definition "Syndrome characterized by reversible airflow limitation and complicating bronchial hyperresponsiveness induced by acute exposure to high concentrations of non-sensitizer irritant gases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive airways dysfunction syndrome" .

goldbook:13634 a skos:Concept ;
    skos:altLabel "ROS",
        "reactive oxygen intermediate (ROI)" ;
    skos:definition "Intermediates in the reduction of molecular dioxygen, \\(\\ce{O2}\\), to water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive oxygen species" .

goldbook:13635 a skos:Concept ;
    skos:definition "Historic term for antibodies of the immunoglobulin E (IgE) class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reagin" .

goldbook:13636 a skos:Concept ;
    skos:definition "Substance recognized by memory cells that stimulates rapid (secondary) immune responses, often associated with hypersensitivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recall antigen" .

goldbook:13637 a skos:Concept ;
    skos:definition "Antibody fragment manufactured by use of genetically modified microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombinant antibody" .

goldbook:13638 a skos:Concept ;
    skos:altLabel "RAG" ;
    skos:definition "Gene whose products are involved in V(D)J recombination in B cells and T cells. Two such genes that have been identified are RAG-1 and RAG-2." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombination-activating gene" .

goldbook:13639 a skos:Concept ;
    skos:altLabel "RSS" ;
    skos:definition "Any conserved heptamer (7-nucleotide)-nonamer (9-nucleotide) sequence, separated by a 12 or 23 base spacer, which occurs 3′ of variable gene segments, 5′ and 3′ of diversity gene segments, and 5′ of joining gene segments, in both immunoglobulin (Ig) and T-cell receptor (TCR) genes. It functions as a recognition sequence for the recombinase enzymes that mediate the gene rearrangement process involved in the generation of lymphocyte antigen receptor diversity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombination signal sequence" .

goldbook:13640 a skos:Concept ;
    skos:altLabel "splenic pulp" ;
    skos:definition "Parenchymal tissue of the spleen consisting of cords of cells and sinuses infiltrated with erythrocytes and responsible for removal of aged or damaged erythrocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "red pulp" .

goldbook:13641 a skos:Concept ;
    skos:definition "Large transformed lymphocyte, often binucleate, considered pathognomonic of Hodgkin lymphoma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Reed–Sternberg cell" .

goldbook:13642 a skos:Concept ;
    skos:altLabel "RANTES" ;
    skos:definition "Chemokine secreted by T cells and macrophages upon stimulation by mitogens, which acts as a chemoattractant and stimulates eosinophils and basophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regulated upon activation normal T cell expressed and secreted" .

goldbook:13643 a skos:Concept ;
    skos:definition "Antibody or T-cell receptor (TCR) idiotope capable of regulating immune responses via interaction with lymphocytes bearing complementary idiotopes (anti-idiotopes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regulatory idiotope" .

goldbook:13644 a skos:Concept ;
    skos:altLabel "Treg",
        "natural regulatory T cell" ;
    skos:definition "T cell that controls the maintenance of normal immune homeostasis. Treg cells are involved in controlling (anergizing or counter-regulating) autoreactive cells that escaped from thymic negative selection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regulatory T cell" .

goldbook:13645 a skos:Concept ;
    skos:altLabel "transplant rejection" ;
    skos:definition "Immune response leading to destruction of a transplanted organ or tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rejection" .

goldbook:13646 a skos:Concept ;
    skos:altLabel "NADPH oxidase",
        "oxidative burst" ;
    skos:definition "Generation of cytotoxic superoxide from dioxygen due to increased NADPH oxidase activity, typically occurring in activated neutrophils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "respiratory burst" .

goldbook:13647 a skos:Concept ;
    skos:definition "Test of the ability of a substance to induce hyperreactivity in the airways, typically measured as an increase in the rate of respiration of guinea pigs during inhalation of the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "respiratory hypersensitivity assay" .

goldbook:13648 a skos:Concept ;
    skos:definition "High-throughput procedure where information on potential immunogenic tumor proteins is gained from the amino acid sequences of gene products specifically expressed by the tumor, followed by predicted fitting of putative antigenic peptides to a peptide-binding groove, and finally experimental verification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse immunology" .

goldbook:13650 a skos:Concept ;
    skos:definition "Inflammatory disease that may develop following a streptococcal infection such as strep throat, and may affect the heart, joints, skin, and brain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rheumatic fever" .

goldbook:13651 a skos:Concept ;
    skos:altLabel "RA" ;
    skos:definition "Episodic inflammatory systemic disease with autoimmune pathogenetic mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rheumatoid arthritis" .

goldbook:13652 a skos:Concept ;
    skos:definition "Immunoglobulins IgM, IgG, and IgA autoantibodies to the Fc region of IgG." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rheumatoid factor" .

goldbook:13653 a skos:Concept ;
    skos:definition "Inflammation of the mucous membrane of the nose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhinitis" .

goldbook:13654 a skos:Concept ;
    skos:definition "Nasal discharge resulting from an allergic response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allergic rhinitis" .

goldbook:13655 a skos:Concept ;
    skos:definition "Technique in which a test antigen is electrophoretically driven through an antibody-containing gel. The rocket-shaped tails of precipitation give information on the antigen concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rocket electrophoresis" .

goldbook:13656 a skos:Concept ;
    skos:definition "Particles or cells bound to the surface of a lymphocyte (e.g., sheep erythrocytes around a human T cell)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rosette" .

goldbook:13657 a skos:Concept ;
    skos:definition "Single-chain molecule composed of the variable (V) regions of an antibody heavy and light chain joined together by a flexible linker." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scFv" .

goldbook:13658 a skos:Concept ;
    skos:altLabel "sarcoid" ;
    skos:definition "Chronic, progressive, generalized granulomatous reticulosis of unknown etiology, involving almost any organ or tissue, including the skin, lungs, lymph nodes, liver, spleen, eyes, and small bones of the hands and feet. It is characterized histologically by the presence in all affected organs or tissues of noncaseating epithelioid cell tubercles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sarcoidosis" .

goldbook:13659 a skos:Concept ;
    skos:definition "Cell surface receptor, for example on phagocytes, which recognizes cells or molecules that require clearance from the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scavenger receptor" .

goldbook:13660 a skos:Concept ;
    skos:definition "Chronic progressive autoimmune disease characterized by systemic fibrosis and vascular changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scleroderma" .

goldbook:13661 a skos:Concept ;
    skos:definition "Second exposure of primed lymphocytes to a given antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary challenge" .

goldbook:13662 a skos:Concept ;
    skos:definition "Qualitatively and quantitatively improved immune response that occurs upon the second encounter of primed lymphocytes with a given antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary immune response" .

goldbook:13663 a skos:Concept ;
    skos:altLabel "secondary lymphoid organ" ;
    skos:definition "Tissue (organ) in which antigen-driven proliferation and differentiation of mature B and T lymphocytes take place following antigen recognition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary lymphoid tissue" .

goldbook:13664 a skos:Concept ;
    skos:definition "Accelerated rejection of an allograft in a primed recipient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "second set rejection" .

goldbook:13665 a skos:Concept ;
    skos:definition "Proteolytic cleavage product of the poly-Ig receptor which remains associated with dimeric immunoglobulin A (IgA) in sero-mucus secretions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secretory component" .

goldbook:13666 a skos:Concept ;
    skos:altLabel "IgA" ;
    skos:definition "Dimeric immunoglobulin A (IgA) found in sero-mucus secretions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secretory immunoglobulin A" .

goldbook:13667 a skos:Concept ;
    skos:definition "Any member of a family of cell-surface adhesion molecules found on leukocytes and endothelial cells and that bind to sugars on glycoproteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectin" .

goldbook:13668 a skos:Concept ;
    skos:altLabel "SIgAD" ;
    skos:definition "Most common form of primary immunodeficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective IgA deficiency" .

goldbook:13669 a skos:Concept ;
    skos:definition "Specific immunological unresponsiveness to a defined autoantigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-tolerance" .

goldbook:13670 a skos:Concept ;
    skos:definition "Spread of bacteria or bacterial products throughout the blood, eliciting a life-threatening, systemic inflammatory reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sepsis" .

goldbook:13671 a skos:Concept ;
    skos:definition "The appearance in the blood serum of detectable antibodies against a specific infectious agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seroconversion" .

goldbook:13672 a skos:Concept ;
    skos:definition "Study of serum, especially blood serum, frequently used to detect antibodies to microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "serology" .

goldbook:13673 a skos:Concept ;
    skos:definition "Hypersensitive reaction to the administration of a foreign serum, characterized by fever, swelling, skin rash, and enlargement of the lymph nodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "serum sickness" .

goldbook:13674 a skos:Concept ;
    skos:altLabel "SCID" ;
    skos:definition "Immunodeficiency affecting both T and B lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "severe combined immunodeficiency" .

goldbook:13675 a skos:Concept ;
    skos:altLabel "SRBC",
        "SRBC antigen" ;
    skos:definition "T-cell-dependent target antigen often used in hemolytic plaque assays of immune responsiveness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sheep red blood cell antigen" .

goldbook:13676 a skos:Concept ;
    skos:altLabel "SIGLEC" ;
    skos:definition "Any member of a large family of lectins that bind sialylated glycans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signaling lectin" .

goldbook:13677 a skos:Concept ;
    skos:altLabel "signal sequence" ;
    skos:definition "Any sequence of amino acid residues that, when linked to a newly synthesized protein, identifies it to transport mechanisms that guide the protein to a specific location among the organelles of a eukaryotic cell, or from the cytoplasm to the periplasmic space of prokaryotic cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signal peptide" .

goldbook:13678 a skos:Concept ;
    skos:altLabel "STAT" ;
    skos:definition "Any member of a family of cytoplasmic proteins that act as second messengers to activate gene transcription in response to cytokines and growth factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signal transducer and activator of transcription" .

goldbook:13679 a skos:Concept ;
    skos:altLabel "SCA" ;
    skos:definition "Small antibody construct in which the variable fragment (Fv) [see variable (V) region] of a heavy chain is linked via a synthetic peptide to the variable fragment of a light chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-chain antibody" .

goldbook:13680 a skos:Concept ;
    skos:definition "Chronic inflammation of the lachrymal and salivary glands, often accompanied by rheumatoid arthritis (RA) and the presence of autoantibodies in the blood, occurring chiefly among women." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sjögren syndrome" .

goldbook:13681 a skos:Concept ;
    skos:altLabel "SIS" ;
    skos:definition "Skin-associated cells that participate in an immune response, including Langerhans cells, dendritic cells, and keratinocytes (mainly responsible for production of cytokines)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skin immune system" .

goldbook:13682 a skos:Concept ;
    skos:definition "Any test used to study skin hypersensitivity such as the guinea pig maximization test or the Buehler test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skin sensitization test" .

goldbook:13683 a skos:Concept ;
    skos:definition "Procedure for evaluating immunity status, involving the introduction of a reagent into or under the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skin test" .

goldbook:13684 a skos:Concept ;
    skos:altLabel "SRS-A" ;
    skos:definition "Group of leukotrienes released by mast cells during anaphylaxis, which induces a prolonged contraction of smooth muscle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slow-reacting substance of anaphylaxis" .

goldbook:13685 a skos:Concept ;
    skos:definition "Any member of a family of monomeric G proteins, with molecular mass typically \\(\\pu{20\\!{-}\\! 40 kDa}\\), that also bind guanine nucleotides and are involved in signal transduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "small G protein" .

goldbook:13686 a skos:Concept ;
    skos:altLabel "SOC",
        "SOC protein" ;
    skos:definition "Protein from the shell of the bacteriophage T4, commonly used in construction of phage antibody libraries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "small outer capsid protein" .

goldbook:13687 a skos:Concept ;
    skos:definition "Theory that very few immunoglobulins (Ig) are inherited, but that extensive antibody diversity arises from mutations in non-reproductive cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic diversification theory" .

goldbook:13688 a skos:Concept ;
    skos:definition "Nonreciprocal exchange of nucleic acid sequences between genes in which part of the donor gene or genes is 'copied' into an acceptor gene, but only the acceptor gene is altered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic gene conversion" .

goldbook:13689 a skos:Concept ;
    skos:definition "Process giving rise to increased antibody diversity by cutting and splicing immunoglobulin (Ig) genes during lymphocyte differentiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic recombination" .

goldbook:13690 a skos:Concept ;
    skos:definition "Largest of the secondary lymphoid organs, composed of white pulp, rich in lymphoid cells, and red pulp, which contains many erythrocytes and macrophages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spleen" .

goldbook:13691 a skos:Concept ;
    skos:definition "Of, pertaining to, connected with, or situated in the spleen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "splenic" .

goldbook:13692 a skos:Concept ;
    skos:definition "Any splenic cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "splenocyte" .

goldbook:13693 a skos:Concept ;
    skos:definition "Test for allergic contact dermatitis in which guinea pig skin is exposed to repeated applications of a test substance and intradermal injections of complete Freund’s adjuvant are administered separately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "split adjuvant technique" .

goldbook:13694 a skos:Concept ;
    skos:definition "Inflammation of the vertebral column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spondylitis" .

goldbook:13695 a skos:Concept ;
    skos:altLabel "SAT" ;
    skos:definition "Autoimmune thyroiditis (see thyroiditis, autoimmune) that develops spontaneously (without any apparent cause or manipulation) in certain strains of mice and rats (e.g., NOD mice, BB and BUF rats) as well as in other animals (e.g., OS chickens, marmoset monkeys, beagles)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spontaneous autoimmune thyroiditis" .

goldbook:13696 a skos:Concept ;
    skos:altLabel "bullous erythema multiforme" ;
    skos:definition "Allergic reaction, often to a medication (see adverse drug reaction) or infection, characterized by blistering of the skin and ulceration of mucosal membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stevens–Johnson syndrome" .

goldbook:13697 a skos:Concept ;
    skos:definition "Supporting tissue of an organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stroma" .

goldbook:13698 a skos:Concept ;
    skos:altLabel "SCLE" ;
    skos:definition "Chronic remitting form of dermatitis characterized by severe photosensitivity and Ro/SS-A and La/SS-B autoantibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subacute cutaneous lupus erythematosus" .

goldbook:13699 a skos:Concept ;
    skos:definition "Antigen which reacts with all the T cells belonging to a particular T-cell receptor (TCR) variable (V) region family, and which therefore stimulates (or deletes) a much larger number of cells than does conventional antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superantigen" .

goldbook:13700 a skos:Concept ;
    skos:definition "Large group of proteins related by structural homology and function. The term also refers to the genes that encode them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superfamily" .

goldbook:13701 a skos:Concept ;
    skos:definition "Dominant immunological tolerance, a phenomenon that plays an active role in regulating T-cell and B-cell responses to both foreign antigens and autoantigens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suppression" .

goldbook:13702 a skos:Concept ;
    skos:altLabel "suppressor T cell",
        "suppressor T lymphocyte" ;
    skos:definition "T cell that suppresses the immune response of B cells and other T cells to an antigen. In more current usage classified as a regulatory T cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suppressor cell" .

goldbook:13703 a skos:Concept ;
    skos:altLabel "SMAC" ;
    skos:definition "Collection of molecules forming at the contact point of a T cell and an antigen-presenting cell (APC), enriched in T-cell receptor (TCR), adhesion molecules, and signaling molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supramolecular adhesion complex" .

goldbook:13704 a skos:Concept ;
    skos:definition "Light chain-like structure formed when the proteins encoded by the \\({\\rm{V}}_{\\rm{preB}}\\) and \\(\\uplambda_{5}\\) genes associate with each other. It can form immunoglobulin (Ig)-like complexes which are expressed on the surface of pre-B cells at different stages of development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surrogate light chain" .

goldbook:13705 a skos:Concept ;
    skos:altLabel "switch region" ;
    skos:definition "Highly conserved repetitive sequence that mediates class switching in the immunoglobulin (Ig) heavy chain gene locus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "switch sequence" .

goldbook:13706 a skos:Concept ;
    skos:definition "Autoimmune injury to one eye that occurs after penetrating injury or surgery to the other eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sympathetic ophthalmia" .

goldbook:13707 a skos:Concept ;
    skos:definition "Genetically identical, e.g., a fully inbred strain of mice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syngeneic" .

goldbook:13708 a skos:Concept ;
    skos:definition "1) Relating to the body as a whole. 2) Occurring at a site in the body remote from the point of contact with a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systemic" .

goldbook:13709 a skos:Concept ;
    skos:definition "Autoimmune disease affecting a number of organs or tissues, or the whole body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systemic autoimmune disease" .

goldbook:13710 a skos:Concept ;
    skos:altLabel "SLE",
        "lupus",
        "lupus erythematosus" ;
    skos:definition "Chronic autoimmune disease that is potentially debilitating and sometimes fatal as the immune system attacks the body’s cells and tissues, with inflammation and tissue damage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systemic lupus erythematosus" .

goldbook:13711 a skos:Concept ;
    skos:altLabel "SSc" ;
    skos:definition "Fibrosing disease of unclear etiology that affects multiple organ systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systemic sclerosis" .

goldbook:13712 a skos:Concept ;
    skos:altLabel "drug-specific T cell" ;
    skos:definition "T-memory cell that is specific for a drug allergen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug-specific T cell" .

goldbook:13713 a skos:Concept ;
    skos:altLabel "TDAR" ;
    skos:definition "Immunotoxicity test that evaluates the ability of animals to produce antibodies to a T-dependent antigen [e.g., sheep red blood cells (SRBCs) or keyhole limpet hemocyanin (KLH)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T-cell-dependent antibody response" .

goldbook:13714 a skos:Concept ;
    skos:altLabel "TCR" ;
    skos:definition "Antigen-specific receptor on T cells composed of one set of heterodimeric chains. Two types of TCR heterodimers are known (\\(\\upalpha/\\upbeta\\) and \\(\\upgamma/\\updelta\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T-cell receptor" .

goldbook:13715 a skos:Concept ;
    skos:definition "Antigen that requires helper T lymphocytes (Th) in order to elicit an antibody response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T-dependent antigen" .

goldbook:13716 a skos:Concept ;
    skos:altLabel "TUNEL",
        "TUNEL assay" ;
    skos:definition "Method for detecting apoptotic cells in situ based on characteristic DNA fragmentation. It is based on the ability of terminal deoxynucleotidyl transferase (TdT) to transfer a labeled deoxyuridine triphosphate to the terminal ends arising from DNA cleavage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "TdT-dependent dUTP-biotin nick end labeling assay" .

goldbook:13717 a skos:Concept ;
    skos:definition "Helper T lymphocyte (Th) with a less restricted cytokine profile than Th1 and Th2 cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Th0 cell" .

goldbook:13718 a skos:Concept ;
    skos:definition "Helper T lymphocyte (Th) producing mainly interleukin-2 (IL-2), interferon (IFN-$\\ce{\\upgamma\\!}$), and tumor necrosis factor $\\ce{\\upbeta\\!}$ ($\\ce{TNF\\mbox{-}\\upbeta\\!}$), and thereby responsible for phagocyte-dependent host responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Th1 cell" .

goldbook:13719 a skos:Concept ;
    skos:definition "Helper T lymphocyte (Th) in mice producing interleukins IL-4, IL-5, IL-6, IL-9, IL-10, and IL-13." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Th2 cell" .

goldbook:13720 a skos:Concept ;
    skos:definition "Helper T lymphocyte (Th) producing and responding to transforming growth factor $\\ce{\\upbeta\\!}$ ($\\ce{TGF\\mbox{-}\\upbeta\\!}$) and helping immunoglobulin A (IgA) antibody responses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Th3 cell" .

goldbook:13721 a skos:Concept ;
    skos:definition "Helper T lymphocyte (Th) producing interleukin IL-9, which stimulates mast cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Th9 cell" .

goldbook:13722 a skos:Concept ;
    skos:altLabel "T17" ;
    skos:definition "Helper T lymphocyte (Th), distinct from Th1 and Th2 cells, that secretes the interleukin IL-17." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Th17 cell" .

goldbook:13723 a skos:Concept ;
    skos:definition "Antigen that is able to elicit an antibody response in the absence of T cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T-independent antigen" .

goldbook:13724 a skos:Concept ;
    skos:altLabel "T cell" ;
    skos:definition "Lymphocyte that matures in the thymus and has the ability to recognize specific peptide antigens through the receptors on its cell surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T lymphocyte" .

goldbook:13725 a skos:Concept ;
    skos:definition "T lymphocyte that regulates Th1 cell responses. It resembles the regulatory T cell (Treg) and is possibly related to the Th3 cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Tr1 cell" .

goldbook:13726 a skos:Concept ;
    skos:definition "Molecular construct with two fluorochromes where the first excites the second by its emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tandem conjugate" .

goldbook:13727 a skos:Concept ;
    skos:definition "Cell killed by one of the body’s killer cells, such as a cytotoxic T lymphocyte or natural killer (NK) cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "target cell" .

goldbook:13728 a skos:Concept ;
    skos:altLabel "TDT" ;
    skos:definition "Enzyme that inserts non-coded nucleotides at the junctions of V, D, and J gene segments of immunoglobulin (Ig) and T-cell receptor (TCR) locus DNA, thus increasing the diversity of antigen-specific recognition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "terminal deoxynucleotidyl transferase" .

goldbook:13729 a skos:Concept ;
    skos:definition "Detoxified tetanus toxin used to produce active immunity (see active immune response) against tetanus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetanus toxoid" .

goldbook:13730 a skos:Concept ;
    skos:definition "Technique used for selective staining of antigen-specific T lymphocytes in vitro or in situ. The antigen is presented to T cells by peptide tetramer constructs of major histocompatibility (MHC) class I molecules. It is also used to isolate antigen-specific T-cell populations for clonal expansion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetramer staining" .

goldbook:13731 a skos:Concept ;
    skos:altLabel "Tertiary Lymphoid Organ" ;
    skos:definition "Ectopic lymphoid aggregates that accumulate during the process of chronic immune stimulation, and exhibit characteristics usually associated with the secondary lymphoid organs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tertiary lymphoid tissue" .

goldbook:13732 a skos:Concept ;
    skos:definition "Any of several substances (predominantly thromboxanes A2 and B2) synthesized by platelets from arachidonic acid precursor, that cause vasoconstriction of vascular and bronchial smooth muscle and facilitates platelet aggregation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thromboxane" .

goldbook:13733 a skos:Concept ;
    skos:definition "Oral infection with Candida albicans, often in patients with immunosuppression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thrush" .

goldbook:13734 a skos:Concept ;
    skos:definition "Pertaining to the thymus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymic" .

goldbook:13735 a skos:Concept ;
    skos:definition "Involution of the thymus gland leading to a diminished capacity to generate new T cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymic atrophy" .

goldbook:13736 a skos:Concept ;
    skos:definition "Process by which T cells, developing in the thymus, are screened for potentially harmful self-reactive T cells (which are removed), while potentially beneficial T cells are promoted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymic education" .

goldbook:13737 a skos:Concept ;
    skos:definition "Rare, usually benign, tumor arising from tissue of the thymus gland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymoma" .

goldbook:13738 a skos:Concept ;
    skos:altLabel "TD",
        "TD antigen" ;
    skos:definition "Antigen that requires the participation of T lymphocytes to elicit an immune response in B lymphocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymus-dependent antigen" .

goldbook:13739 a skos:Concept ;
    skos:definition "Antigen that does not require the participation of T lymphocytes to elicit an immune response in B cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thymus-independent antigen" .

goldbook:13740 a skos:Concept ;
    skos:altLabel "TG" ;
    skos:definition "Glycoprotein secreted by thyroid follicular cells that is a major autoantigen in autoimmune diseases of the thyroid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyroglobulin" .

goldbook:13741 a skos:Concept ;
    skos:altLabel "autoimmune thyroiditis" ;
    skos:definition "Inflammatory destruction of the thyroid gland (ranging from a mild focal thyroiditis to extensive lymphocytic infiltration and scarring) often associated with goiter and hypothyroidism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoimmune thyroiditis" .

goldbook:13742 a skos:Concept ;
    skos:altLabel "TSHR" ;
    skos:definition "Main autoantigenic target in patients with Graves disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyroid-stimulating hormone receptor" .

goldbook:13743 a skos:Concept ;
    skos:altLabel "TPO" ;
    skos:definition "Thyroid enzyme that is a major autoantigen in autoimmune diseases of the thyroid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyroid peroxidase" .

goldbook:13744 a skos:Concept ;
    skos:altLabel "TTG" ;
    skos:definition "Main target of autoantibodies in celiac disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tissue transglutaminase" .

goldbook:13745 a skos:Concept ;
    skos:definition "Reciprocal of the highest dilution of a titration of an antigen with an antibody that gives a measurable effect (e.g., agglutination), and thus an empirical measure of the avidity of an antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "titer" .

goldbook:13746 a skos:Concept ;
    skos:definition "Antigen used to induce tolerance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerogen" .

goldbook:13747 a skos:Concept ;
    skos:altLabel "TLR" ;
    skos:definition "Member of a family of pattern recognition receptors involved in the detection of structures associated with pathogens or damaged host tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toll-like receptor" .

goldbook:13748 a skos:Concept ;
    skos:altLabel "Lyell syndrome",
        "TEN" ;
    skos:definition "A severe form of Stevens–Johnson syndrome with extensive detachment of the skin, often as a result of an allergic adverse drug reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxic epidermal necrolysis" .

goldbook:13749 a skos:Concept ;
    skos:definition "Systemic reaction produced by the toxin derived from the bacterium Staphylococcus aureus; the toxin acts as a superantigen, which activates a high proportion of CD4+ T lymphocytes to produce cytokines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxic shock syndrome" .

goldbook:13750 a skos:Concept ;
    skos:definition "Chemically or physically modified toxin that is no longer harmful but retains immunogenicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxoid" .

goldbook:13751 a skos:Concept ;
    skos:definition "Vesicular transport of macromolecules from one side of a cell to the other, through the cell’s interior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcytosis" .

goldbook:13752 a skos:Concept ;
    skos:altLabel "TGF-β" ;
    skos:definition "Secreted member of the protein superfamily of the same name that functions in controlling the cell cycle and apoptosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transforming growth factor β" .

goldbook:13753 a skos:Concept ;
    skos:altLabel "blood transfusion" ;
    skos:definition "Transference of blood or blood-based products from one individual into the circulation of another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blood transfusion" .

goldbook:13754 a skos:Concept ;
    skos:definition "Grafting solid tissue (e.g., cornea) or organ (e.g., kidney or heart), or cells (particularly bone marrow), from one individual to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transplantation" .

goldbook:13755 a skos:Concept ;
    skos:definition "Molecules that carry antigenic peptides from the cytoplasm into the lumen of the endoplasmic reticulum for incorporation into major histocompatibility (MHC) class I molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transporters associated with antigen processing" .

goldbook:13756 a skos:Concept ;
    skos:altLabel "(2S)-2-amino-3-(1H-indol-3-yl)propanoic acid" ;
    skos:definition "Essential amino acid for humans, and required for T-cell proliferation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tryptophan" .

goldbook:13757 a skos:Concept ;
    skos:definition "Antigen found in extracts of Mycobacteria, used in a skin test for tuberculosis (Mantoux test)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tuberculin" .

goldbook:13758 a skos:Concept ;
    skos:altLabel "Mantoux test" ;
    skos:definition "Diagnostic test in which antigens derived from the organism causing tuberculosis (Mycobacterium tuberculosis) are injected subcutaneously; individuals who have been exposed to the organism develop a delayed-type hypersensitivity (DTH) response at the injection site \\(\\pu{24}\\) to \\(\\pu{48 h}\\) later." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tuberculin test" .

goldbook:13759 a skos:Concept ;
    skos:definition "Antigen whose expression is associated with tumor cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor antigen" .

goldbook:13760 a skos:Concept ;
    skos:definition "Application of immunology to understanding tumor biology, immune system avoidance by tumors, and immunotherapy directed against tumors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor immunology" .

goldbook:13761 a skos:Concept ;
    skos:altLabel "TIL" ;
    skos:definition "Mononuclear lymphocyte derived from the inflammatory infiltrate of a solid tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor-infiltrating lymphocyte" .

goldbook:13762 a skos:Concept ;
    skos:altLabel "TNF",
        "TNF-α",
        "cachectin",
        "cachexin" ;
    skos:definition "Protein produced and secreted by several of the body’s cell types, including leukocytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor necrosis factor" .

goldbook:13763 a skos:Concept ;
    skos:definition "Family of proteins involved in regulating inflammation and apoptosis through interaction with the tumor necrosis factor receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor necrosis factor receptor-associated factor" .

goldbook:13764 a skos:Concept ;
    skos:altLabel "TRA" ;
    skos:definition "Antigen present specifically on a tumor cell that may target it for destruction by the immune system or for antibody therapy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor rejection antigen" .

goldbook:13765 a skos:Concept ;
    skos:altLabel "TSTA" ;
    skos:definition "Antigen, present only on a tumor cell, and targetable by the immune system or by antibody therapy in order to destroy the tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor-specific transplantation antigen" .

goldbook:13766 a skos:Concept ;
    skos:altLabel "protein tyrosine kinase" ;
    skos:definition "Any member of a family of enzymes that phosphorylates target proteins on tyrosine residues, thus playing a crucial role in signal transduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tyrosine kinase" .

goldbook:13767 a skos:Concept ;
    skos:definition "Highly conserved 76 amino acid peptide abundant in eukaryotic cells. Its covalent attachment to a protein by a ubiquitin ligase complex targets that protein for destruction by the proteasome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ubiquitin" .

goldbook:13768 a skos:Concept ;
    skos:definition "Inability to respond to an antigenic stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unresponsiveness" .

goldbook:13769 a skos:Concept ;
    skos:definition "Preferential partnering of \\(\\ce{J\\upalpha\\ gene}\\) segments with \\(\\ce{V\\upalpha\\ gene}\\) segments during rearrangement in the T-cell receptor (TCR) gene, possibly following deletion of the \\(\\ce{V\\updelta\\ gene}\\) region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Vα-Jα rearrangement" .

goldbook:13770 a skos:Concept ;
    skos:definition "Mechanism for generating antigen-specific receptors of T cells and B cells; it involves the joining of V, D, and J gene segments, mediated by the enzyme complex V(D)J recombinase, and products of the recombination-activating genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "V(D)J recombination" .

goldbook:13771 a skos:Concept ;
    skos:definition "Immunization with a vaccine against a pathogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vaccination" .

goldbook:13772 a skos:Concept ;
    skos:altLabel "V Gene" ;
    skos:definition "Gene, segment(s) of which rearrange together with diversity (D) gene and joining (J) gene segments in order to encode the variable (V) region amino acid sequences of immunoglobulins (Ig) and T-cell receptors (TCRs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variable gene" .

goldbook:13773 a skos:Concept ;
    skos:altLabel "V domain",
        "V region",
        "variable domain" ;
    skos:definition "N-terminal portion of an immunoglobulin (Ig) or T-cell receptor (TCR) that contains the antigen-binding region of the molecule. V regions are formed by the recombination of V(D) and J gene segments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variable region" .

goldbook:13774 a skos:Concept ;
    skos:definition "Cell adhesion molecule present on the luminal surface of blood and lymph vessel endothelium, recognized by homing molecules that direct leukocytes to tissues with the appropriate 'address'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vascular addressin" .

goldbook:13775 a skos:Concept ;
    skos:altLabel "CD106",
        "VCAM" ;
    skos:definition "Molecule, expressed on the surface of endothelial cells that functions in the adhesion of lymphocytes, monocytes, eosinophils, and basophils to vascular endothelium to the vascular surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vascular cell adhesion molecule" .

goldbook:13776 a skos:Concept ;
    skos:definition "Group of disorders that share a common underlying problem of inflammation of a blood vessel or vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasculitis" .

goldbook:13777 a skos:Concept ;
    skos:definition "Substance containing amino group(s) that increases vascular permeability and smooth muscle contraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasoactive amine" .

goldbook:13778 a skos:Concept ;
    skos:altLabel "CD69" ;
    skos:definition "Specific antigen expressed on lymphocytes very soon after activation by phorbol myristate acetate (PMA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "very early activating antigen" .

goldbook:13779 a skos:Concept ;
    skos:altLabel "VLA" ;
    skos:definition "T-cell surface antigen, named for its delayed appearance after T-cell activation; a member of the integrin superfamily involved in cell adhesion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "very late activation antigen" .

goldbook:13780 a skos:Concept ;
    skos:definition "Elimination by apoptosis of a self-peptide-major histocompatibility complex (MHC) molecule recognizing lymphocyte by a self-peptide-presenting (veto) cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vetoing" .

goldbook:13781 a skos:Concept ;
    skos:definition "Autoantibodies that react optimally at higher temperatures (\\(\\pu{37^{\\circ}C}\\)) with surface antigens of erythrocytes. They mediate autoimmune hemolytic anemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "warm autoantibody type" .

goldbook:13782 a skos:Concept ;
    skos:altLabel "WG" ;
    skos:definition "Granulomatous inflammation involving the respiratory tract, and necrotizing vasculitis affecting small to medium-sized vessels (e.g., capillaries, venules, arterioles, and arteries)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wegener granulomatosis" .

goldbook:13783 a skos:Concept ;
    skos:definition "Circumscribed papule or plaque of edema of the skin, occurring as an urticarial lesion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wheal" .

goldbook:13784 a skos:Concept ;
    skos:definition "Dermatological reaction at a skin site where an antigen is injected into an allergic individual. The reaction is characterized by a 'flare' of erythema and a wheal produced by serum exuding into tissue, causing local edema." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wheal and flare" .

goldbook:13785 a skos:Concept ;
    skos:definition "Collections of lymphocytes in the spleen, responsible for its immune function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "white pulp" .

goldbook:13786 a skos:Concept ;
    skos:altLabel "eczema-thrombocytopenia-immunodeficiency syndrome" ;
    skos:definition "Condition characterized by chronic eczema, chronic suppurative otitis media, anemia, and thrombocytopenic purpura (accompanied by bloody diarrhea); it is an immunodeficiency syndrome transmitted as an X-linked recessive trait, in which there is poor antibody response to polysaccharide antigens and dysfunction of cell-mediated immunity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wiskott–Aldrich syndrome" .

goldbook:13787 a skos:Concept ;
    skos:altLabel "Bruton agammaglobulinemia",
        "Bruton syndrome",
        "agammaglobulinemia" ;
    skos:definition "Sex-linked impairment of the ability to produce mature B cells, thus characterized by recurrent infections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-linked agammaglobulinemia" .

goldbook:13788 a skos:Concept ;
    skos:altLabel "combined immunodeficiency" ;
    skos:definition "Sex-linked trait carried on the X-chromosome of severe combined immunodeficiency syndrome resulting from nonfunctional B lymphocytes and lack of T lymphocytes and natural killer (NK) lymphocytes, leading to recurrent, persistent, and severe infections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-linked severe combined immunodeficiency" .

goldbook:13789 a skos:Concept ;
    skos:definition "Exhibiting genetic differences between species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xenogeneic" .

goldbook:13790 a skos:Concept ;
    skos:definition "Tissue or organ graft between individuals of different species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xenograft" .

goldbook:13791 a skos:Concept ;
    skos:definition "Autophagy selective for degradation of intracellular bacteria and viruses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xenophagy" .

goldbook:13792 a skos:Concept ;
    skos:definition "T-lymphocyte-specific tyrosine kinase involved in T-lymphocyte activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Zeta chain-associated protein kinase-70 kDa" .

goldbook:13793 a skos:Concept ;
    skos:definition "Crude preparation of yeast cell walls, consisting chiefly of polysaccharide, activating the alternative pathway of the complement system in the presence of properdin and used in the immunoassay of this compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zymosan" .

goldbook:13795 a skos:Concept ;
    skos:definition "Substance made up of molecules containing groups that are solvophilic and other groups that are solvophobic with respect to a given solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amphiphile" .

goldbook:13796 a skos:Concept ;
    skos:definition "Amphiphile, the constituent molecules of which have solvophilic groups at each end of a solvophobic chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boloamphiphile" .

goldbook:13797 a skos:Concept ;
    skos:definition "Mesophase formed by varying the pressure at constant temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "barotropic mesophase" .

goldbook:13798 a skos:Concept ;
    skos:definition "Having a rod- or lath-like shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calamitic" .

goldbook:13799 a skos:Concept ;
    skos:definition "Host-guest complex formed by a carcerand and a completely entrapped guest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carceplex" .

goldbook:13800 a skos:Concept ;
    skos:definition "Host molecule that completely entraps a guest molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcerand" .

goldbook:13801 a skos:Concept ;
    skos:definition "Self-assembly of two or more self-assembling species that might or might not incorporate a non-assembling component into an ordered structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-assembly" .

goldbook:13802 a skos:Concept ;
    skos:definition "Change in conformation of a macromolecular chain in solution from that of a coil to a relatively compact structure in which the chain has collapsed upon itself in response to an external stimulus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coil-to-globule transition" .

goldbook:13803 a skos:Concept ;
    skos:definition "Two- or three-dimensional ordered array of molecules or nanoparticles having a dimension roughly between \\(\\pu{1 nm}\\) and \\(\\pu{1 \\upmu m}\\) in at least one direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal crystal" .

goldbook:13804 a skos:Concept ;
    skos:definition "Cylindrical assembly of molecules within a distinct series of layers in which the axes of the molecules lie in the planes of the layers and are identically aligned and oriented in adjacent layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "columnar phase" .

goldbook:13805 a skos:Concept ;
    skos:definition "Core-shell structure formed by self-assembly of amphiphiles and subsequently covalently crosslinked through functionalities in the core." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core-crosslinked micelle" .

goldbook:13806 a skos:Concept ;
    skos:definition "Molecular entity of spherical, elliptical, or cylindrical symmetry in which the constitution of the interior, the core, differs from that of the external surface, the shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core-shell structure" .

goldbook:13807 a skos:Concept ;
    skos:altLabel "crystallographic defect" ;
    skos:definition "Interruption to the regular pattern of atomic arrangement in crystal lattices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal lattice defect" .

goldbook:13808 a skos:Concept ;
    skos:definition "Pertaining to assemblies of atoms, molecules, or ions with an overall three-dimensional order of cubic symmetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cubic" .

goldbook:13809 a skos:Concept ;
    skos:definition "Mesophase with an overall three-dimensional order of cubic symmetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cubic mesophase" .

goldbook:13810 a skos:Concept ;
    skos:definition "Local symmetry axis for the singlet, orientational distribution of the molecules of a mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "director" .

goldbook:13811 a skos:Concept ;
    skos:altLabel "discoid" ;
    skos:definition "Having a disc-like shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discotic" .

goldbook:13812 a skos:Concept ;
    skos:definition "Mesogen composed of relatively flat, disc- or sheet-shaped molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discotic mesogen" .

goldbook:13813 a skos:Concept ;
    skos:definition "Assembly or supramolecular assembly, the components of which are linked through reversible bondings that enable structural reassembly by reshuffling in response to changes in the chemical or physical environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamer" .

goldbook:13814 a skos:Concept ;
    skos:definition "Polymer with constitutional units that are susceptible to a change in orientation under the influence of an electric field that causes the system to have induced polarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroclinic polymer" .

goldbook:13815 a skos:Concept ;
    skos:definition "Confinement of microscopic particles with a host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micro-encapsulation" .

goldbook:13816 a skos:Concept ;
    skos:definition "Confinement of an individual molecule within a larger molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular encapsulation" .

goldbook:13817 a skos:Concept ;
    skos:definition "Field surrounding a molecular or ionic species emanating from a source external to that species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external field" .

goldbook:13818 a skos:Concept ;
    skos:definition "Qualifier indicating attraction to fluorous compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorophilic" .

goldbook:13819 a skos:Concept ;
    skos:definition "Attractive interaction of fluorous structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorophilic interaction" .

goldbook:13820 a skos:Concept ;
    skos:definition "Qualifier indicating repulsion by fluorous compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorophobic" .

goldbook:13821 a skos:Concept ;
    skos:definition "Repulsive interaction of fluorous and non-fluorous structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorophobic interaction" .

goldbook:13822 a skos:Concept ;
    skos:definition "Pertaining to the presence of a sufficient number of carbon-fluorine bonds as to cause a substance to be insoluble in water or common organic solvents but soluble in fluorocarbons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorous" .

goldbook:13823 a skos:Concept ;
    skos:definition "Polymer or oligomer molecule that adopts a secondary structure stabilized by noncovalent interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foldamer" .

goldbook:13824 a skos:Concept ;
    skos:definition "Conformation of a macromolecule in which the constitutional units collectively arrange into a compact ovoid or spherical shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "globule" .

goldbook:13825 a skos:Concept ;
    skos:definition "Reverse of a coil-to-globule transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "globule-to-coil transition" .

goldbook:13826 a skos:Concept ;
    skos:definition "Complex formed by a hemicarcerand and an entrapped guest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemicarceplex" .

goldbook:13827 a skos:Concept ;
    skos:definition "Host molecule that allows guest molecules to enter and exit its cavities in accordance with a change in the equilibrium conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemicarcerand" .

goldbook:13828 a skos:Concept ;
    skos:definition "Columnar mesophase characterized by a hexagonal packing of the molecular column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hexagonal mesophase" .

goldbook:13829 a skos:Concept ;
    skos:altLabel "honeycomb polymer" ;
    skos:definition "Hexagonal array of holes in a polymer film." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "honeycomb polymer film" .

goldbook:13830 a skos:Concept ;
    skos:definition "Attractive interaction between hydrophilic groups, molecules, or substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophilic interaction" .

goldbook:13831 a skos:Concept ;
    skos:definition "Qualifier indicating capacity of a molecular entity or of a substituent to interact repulsively with polar molecules, in particular with water or with polar groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophobic" .

goldbook:13832 a skos:Concept ;
    skos:definition "Colloidal crystal of spherical voids with a periodic structure within a solid polymer continuum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse opal" .

goldbook:13833 a skos:Concept ;
    skos:definition "Organized structure extended in two dimensions and of uniform thickness resembling a thin layer, a plate, or a membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lamella" .

goldbook:13834 a skos:Concept ;
    skos:definition "Assembly of block copolymer molecules in which like blocks are segregated in lamella." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lamellar block copolymer" .

goldbook:13835 a skos:Concept ;
    skos:definition "Process whereby multilayered structures of molecules or particles of a substance are assembled on a solid substrate by sequential adsorption of monolayers held together by noncovalent interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "layer-by-layer assembly" .

goldbook:13837 a skos:Concept ;
    skos:definition "Supramolecular structure in which molecules are linked only as a consequence of their topology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanically interlocked molecular architecture" .

goldbook:13838 a skos:Concept ;
    skos:definition "Mesogen composed of molecules incorporating one or more metal atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallomesogen" .

goldbook:13839 a skos:Concept ;
    skos:definition "Rod-like mesogens with the capacity to form micellar aggregates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar rod" .

goldbook:13840 a skos:Concept ;
    skos:definition "Structure of material in which at least one of the features repeats over distances of the order of micrometers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microstructure" .

goldbook:13841 a skos:Concept ;
    skos:definition "Technique to create templated cavities in polymer matrices with memory of the template molecules to be used in molecular recognition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular imprinting" .

goldbook:13842 a skos:Concept ;
    skos:definition "Region of a self-assembled entity with an equivalent diameter of approximately \\(\\pu{(1\\!-\\! 100) nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanodomain" .

goldbook:13843 a skos:Concept ;
    skos:definition "Polymer film that has lateral dimensions in the range of \\(\\pu{(1\\!-\\! 100) nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoscopic polymer film" .

goldbook:13844 a skos:Concept ;
    skos:definition "Qualifier indicating tendency of a molecular entity or of a pendent group thereof to interact favourably with nonpolar organic solvents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organophilic" .

goldbook:13845 a skos:Concept ;
    skos:definition "Attractive interaction between organophilic molecules or materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organophilic interaction" .

goldbook:13846 a skos:Concept ;
    skos:definition "Order parameter applied to macroscopic assemblies of ordered materials, such as crystal assemblies in fibers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orientation parameter" .

goldbook:13847 a skos:Concept ;
    skos:altLabel "branch",
        "side-chain" ;
    skos:definition "Oligomeric or polymeric offshoot from a macromolecular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pendent chain" .

goldbook:13848 a skos:Concept ;
    skos:definition "Vesicle with radius ranging from \\(\\pu{50 nm}\\) to greater than \\(\\pu{5 \\upmu m}\\) constructed from an amphiphilic synthetic block copolymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymersome" .

goldbook:13849 a skos:Concept ;
    skos:definition "Consisting of many molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymolecular" .

goldbook:13850 a skos:Concept ;
    skos:definition "Polymer comprising mechanically interlocked molecular architectures typically of a macromolecule threaded through one or more macrocycles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyrotaxane" .

goldbook:13851 a skos:Concept ;
    skos:definition "Receptor with two binding sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ditopic receptor" .

goldbook:13852 a skos:Concept ;
    skos:definition "Copolymer the molecules of which consist of rigid and flexible blocks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rod-coil copolymer" .

goldbook:13853 a skos:Concept ;
    skos:definition "Equation used to calculate the association constant, \\(K_{\\rm{a}}\\), of a ligand with a protein molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Scatchard equation" .

goldbook:13854 a skos:Concept ;
    skos:definition "Linear plot of \\(r/c\\) against \\(r\\) in accordance with the Scatchard equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Scatchard plot" .

goldbook:13855 a skos:Concept ;
    skos:definition "Inter- or intra-molecular self-assembly of constitutional units within the backbones of polymer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main-chain self-assembly" .

goldbook:13856 a skos:Concept ;
    skos:definition "Inter- or intra-molecular self-assembly of side-chains or constitutional units of polymer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "side-chain self-assembly" .

goldbook:13857 a skos:Concept ;
    skos:altLabel "knedel" ;
    skos:definition "Core-shell structure formed by self-assembly of amphiphiles and subsequently covalently crosslinked through functionalities in the shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shell-crosslinked micelle" .

goldbook:13858 a skos:Concept ;
    skos:definition "Pertaining to the arrangement and orientation of molecules in a smectic mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smectic" .

goldbook:13859 a skos:Concept ;
    skos:definition "Mesophase that has the molecules arranged in layers with a well-defined layer spacing or periodicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smectic mesophase" .

goldbook:13860 a skos:Concept ;
    skos:definition "Macrocyclic compound capable of completely enveloping a cation, having donor atoms (\\(\\ce{O}\\), \\(\\ce{N}\\), \\(\\ce{S}\\)) arranged such that they provide a solvation sphere to the encapsulated cation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spherand" .

goldbook:13861 a skos:Concept ;
    skos:altLabel "pi-pi stacking" ;
    skos:definition "Inter- or intra-molecular alignment of aromatic groups within molecules induced by the interactional overlap of their \\(\\ce{\\uppi\\mbox{-}orbitals}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π-π stacking" .

goldbook:13862 a skos:Concept ;
    skos:altLabel "edge-face interaction" ;
    skos:definition "Orthogonal alignment of constitutional units within molecules that lead to favourable interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "T-stacking" .

goldbook:13863 a skos:Concept ;
    skos:definition "Self-assembly at equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static self-assembly" .

goldbook:13864 a skos:Concept ;
    skos:definition "Polymer that responds reversibly to external stimulus or stimuli." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimuli-responsive polymer" .

goldbook:13865 a skos:Concept ;
    skos:definition "Qualifier indicating an affinity for solvents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvophilic" .

goldbook:13866 a skos:Concept ;
    skos:definition "Qualifier indicating a lack of affinity for solvents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvophobic" .

goldbook:13867 a skos:Concept ;
    skos:altLabel "Lehn association" ;
    skos:definition "Self-assembly involving reversible, noncovalent, directional interactions of molecules that result in a high-molecular-mass entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supramolecular association" .

goldbook:13868 a skos:Concept ;
    skos:definition "Polymerization of monomer molecules adsorbed and oriented (a) on a surface, (b) in a polymer lattice, (c) on polymer molecules in solution, or (d) round a metal ion whereby the structure of the polymer chains formed is controlled by the orientation of the monomer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "template polymerization" .

goldbook:13869 a skos:Concept ;
    skos:altLabel "liposome" ;
    skos:definition "Vesicle constructed from a lipid bilayer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid vesicle" .

goldbook:13870 a skos:Concept ;
    skos:definition "Qualifier for something that is made by human activity, rather than occurring naturally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial" .

goldbook:13871 a skos:Concept ;
    skos:definition "Man-made polymer that is not a biopolymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial polymer" .

goldbook:13872 a skos:Concept ;
    skos:definition "Qualifier for a substance that provokes any response from a living system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioactive" .

goldbook:13873 a skos:Concept ;
    skos:altLabel "biological activity" ;
    skos:definition "Capability of a substance, such as a drug or a vaccine, to provoke a response from a living matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioactivity" .

goldbook:13874 a skos:Concept ;
    skos:altLabel "bioattachment" ;
    skos:definition "Adhesion of cells or tissues to the surface of a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioadhesion" .

goldbook:13875 a skos:Concept ;
    skos:definition "Cell-mediated chemical modification without main chain scission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioalteration" .

goldbook:13877 a skos:Concept ;
    skos:definition "Capability of being degraded by biological activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodegradability" .

goldbook:13878 a skos:Concept ;
    skos:definition "Disintegration resulting from the action of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodisintegration" .

goldbook:13879 a skos:Concept ;
    skos:definition "Aggregate of microorganisms in which cells that are frequently embedded within a self-produced matrix of extracellular polymeric substance (EPS) adhere to each other and/or to a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biofilm" .

goldbook:13880 a skos:Concept ;
    skos:definition "Fragmentation resulting from the action of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biofragmentation" .

goldbook:13881 a skos:Concept ;
    skos:definition "Material exploited in contact with living tissues, organisms, or microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomaterial" .

goldbook:13882 a skos:Concept ;
    skos:definition "Mineralization caused by cell-mediated phenomena." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomineralization" .

goldbook:13883 a skos:Concept ;
    skos:definition "Resistance to the deleterious action of living systems that allows preservation of the initial characteristics of a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biostability" .

goldbook:13884 a skos:Concept ;
    skos:definition "Pertaining to, or produced by, living cells or organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotic" .

goldbook:13885 a skos:Concept ;
    skos:definition "Homogeneous degradation affecting the volume of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk degradation" .

goldbook:13886 a skos:Concept ;
    skos:definition "Supply of a substance according to desired rate and amount over time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled delivery" .

goldbook:13887 a skos:Concept ;
    skos:definition "Capability of undergoing degradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradability" .

goldbook:13888 a skos:Concept ;
    skos:definition "Macromolecule that is able to undergo chain scissions under specific conditions, resulting in a decrease of molar mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradable macromolecule" .

goldbook:13889 a skos:Concept ;
    skos:definition "Polymer in which macromolecules are able to undergo chain scissions, resulting in a decrease of molar mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradable polymer" .

goldbook:13890 a skos:Concept ;
    skos:definition "Progressive loss of the performance or of the characteristics of a substance or a device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradation" .

goldbook:13891 a skos:Concept ;
    skos:definition "Degradation that results in desired changes in the values of in-use properties of the material because of macromolecule cleavage and molar mass decrease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradation" .

goldbook:13892 a skos:Concept ;
    skos:definition "Mass fraction of a substance that is bioassimilated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of bioassimilation" .

goldbook:13893 a skos:Concept ;
    skos:definition "Mass fraction of a substance that is biodegraded under specified conditions as measured through specified phenomena or techniques sensitive to mineral and biomass formations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of biodegradation" .

goldbook:13894 a skos:Concept ;
    skos:definition "Mass fraction of a biodisintegrated substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of biodisintegration" .

goldbook:13895 a skos:Concept ;
    skos:definition "Mass fraction of the original material that is biofragmented." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of biofragmentation" .

goldbook:13896 a skos:Concept ;
    skos:definition "Mass fraction of a substance that is biomineralized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of biomineralization" .

goldbook:13897 a skos:Concept ;
    skos:definition "Mass fraction of a polymer that is degraded under specified conditions as measured through a specified phenomenon sensitive to molecular dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of degradation" .

goldbook:13898 a skos:Concept ;
    skos:definition "Mass fraction of the particles of defined size issued from a fragmented substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of disintegration" .

goldbook:13899 a skos:Concept ;
    skos:definition "Mass fraction of a substance that is fragmented." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of fragmentation" .

goldbook:13900 a skos:Concept ;
    skos:definition "Mass fraction of a substance that is mineralized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of mineralization" .

goldbook:13901 a skos:Concept ;
    skos:definition "Enzyme that is able to catalyse the depolymerization of a biomacromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depolymerase" .

goldbook:13902 a skos:Concept ;
    skos:definition "Deleterious alteration of a material in quality, serviceability, or vigor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deterioration" .

goldbook:13903 a skos:Concept ;
    skos:definition "Fragmentation to particles of a defined size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disintegration" .

goldbook:13904 a skos:Concept ;
    skos:definition "Ability of a material to retain the values of its properties under specified conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "durability" .

goldbook:13905 a skos:Concept ;
    skos:altLabel "enzymatic decomposition" ;
    skos:definition "Degradation caused by the catalytic action of enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzymatic degradation" .

goldbook:13906 a skos:Concept ;
    skos:definition "Degradation that occurs at the surface and progresses from it into the bulk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erosion" .

goldbook:13907 a skos:Concept ;
    skos:definition "Process of inserting new genetic information into existing cells in order to modify a specific organism for the purpose of changing its characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic engineering" .

goldbook:13908 a skos:Concept ;
    skos:definition "Greater value of the degree of biodegradation that can be reached under selected experimental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum degree of biodegradation" .

goldbook:13909 a skos:Concept ;
    skos:definition "Hollow microparticle composed of a solid shell surrounding a core-forming space available to permanently or temporarily entrapped substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcapsule" .

goldbook:13910 a skos:Concept ;
    skos:definition "Particle with dimensions between \\(\\pu{1E-7}\\) and \\(\\pu{1E-4 m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microparticle" .

goldbook:13911 a skos:Concept ;
    skos:definition "Microparticle of spherical shape without membrane or any distinct outer layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microsphere" .

goldbook:13912 a skos:Concept ;
    skos:definition "Process through which an organic substance becomes impregnated by or turned into inorganic substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mineralization" .

goldbook:13913 a skos:Concept ;
    skos:definition "Hollow nanoparticle composed of a solid shell that surrounds a core-forming space available to entrap substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanocapsule" .

goldbook:13914 a skos:Concept ;
    skos:definition "Nanoparticle of spherical shape without membrane or any distinct outer layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanosphere" .

goldbook:13915 a skos:Concept ;
    skos:definition "Generic term used in the case of polymeric material that may contain other substances to improve performance and/or reduce costs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plastic" .

goldbook:13917 a skos:Concept ;
    skos:altLabel "solid dispersion polymer" ;
    skos:definition "Solid multiphasic mixture with at least one polymer component dominating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid dispersion" .

goldbook:13919 a skos:Concept ;
    skos:altLabel "smart polymer" ;
    skos:definition "Polymer that responds or that is designed to respond to a stimulus like pH, light, heat, etc. change, and provides a predetermined action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimulus-responsive polymer" .

goldbook:13920 a skos:Concept ;
    skos:altLabel "prolonged delivery" ;
    skos:definition "Supply of a substance from a container where it is temporarily entrapped for the sake of achieving a prolonged action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sustained delivery" .

goldbook:13921 a skos:Concept ;
    skos:definition "Copy of a biopolymer man-made using abiotic chemical routes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synthetic biopolymer" .

goldbook:13922 a skos:Concept ;
    skos:definition "Degree of biodegradation that corresponds to conversion of all the organic matter present in an original polymer-based item to minerals and biomass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "theoretical degree of biodegradation" .

goldbook:13923 a skos:Concept ;
    skos:definition "Complete breakdown of a compound to either fully oxidized or reduced simple molecules (such as carbon dioxide/methane, nitrate/ammonium, and water)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultimate biodegradation" .

goldbook:13924 a skos:Concept ;
    skos:definition "Medical device that replaces, in part or in whole, the function of one of the organs of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial organ" .

goldbook:13925 a skos:Concept ;
    skos:definition "Qualifier for a domain grouping scientific and practical activities related to therapy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomedical" .

goldbook:13926 a skos:Concept ;
    skos:definition "Implantable prosthesis that consists totally or substantially of nonviable, treated donor tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioprosthesis" .

goldbook:13927 a skos:Concept ;
    skos:definition "Ability to be eliminated from an animal or human body through natural pathways." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioresorbability" .

goldbook:13928 a skos:Concept ;
    skos:definition "Disappearance of a substance from an organism by processes of metabolism, secretion, or excretion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioresorption" .

goldbook:13929 a skos:Concept ;
    skos:definition "Synthetic, self-curing organic or inorganic material used to fill up a cavity or to create a mechanical fixation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bone cement" .

goldbook:13930 a skos:Concept ;
    skos:definition "Ability or tendency to produce cancer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcinogenicity" .

goldbook:13931 a skos:Concept ;
    skos:definition "Macromolecule or polymer used to transport a pharmacologically active compound to be released later on due to an abiotic or biotic process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug carrier" .

goldbook:13932 a skos:Concept ;
    skos:definition "Cellular response of the inflammatory and wound healing processes following introduction of a foreign object in a human or animal body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foreign body reaction" .

goldbook:13933 a skos:Concept ;
    skos:definition "Reaction of a living system to the presence of a substance or a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "host response" .

goldbook:13934 a skos:Concept ;
    skos:definition "Artificial organ that is a combination of viable cells and one or more biomaterials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid artificial organ" .

goldbook:13935 a skos:Concept ;
    skos:definition "Ability of a material or substance to elicit a cellular immune response and/or antibody production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunogenicity" .

goldbook:13936 a skos:Concept ;
    skos:definition "Medical device made from one or more biomaterials that is intentionally placed within the body, either totally or partially buried beneath an epithelial surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "implant" .

goldbook:13937 a skos:Concept ;
    skos:definition "Prodrug in which the temporary chemical entity is a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecular prodrug" .

goldbook:13938 a skos:Concept ;
    skos:definition "Instrument, apparatus, implement, machine, contrivance, in vitro reagent, or other similar or related article, including any component, part of accessory, which is intended for use in the diagnosis of disease or other conditions, or in the cure, mitigation, treatment, or prevention of disease in man." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medical device" .

goldbook:13939 a skos:Concept ;
    skos:definition "Qualifier for substances or systems, including polymers, exploited by the pharmaceutical industry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmaceutical" .

goldbook:13940 a skos:Concept ;
    skos:altLabel "pharmacologic" ;
    skos:definition "Qualifiers for substances, including macromolecules or polymers, and actions involved in pharmacology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacological" .

goldbook:13941 a skos:Concept ;
    skos:definition "Qualifier for a substance that exhibits bioactivity of pharmacological interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacologically active" .

goldbook:13942 a skos:Concept ;
    skos:definition "Science of drugs including their origin, composition, pharmacokinetics, pharmacodynamics, therapeutic use, and toxicology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacology" .

goldbook:13943 a skos:Concept ;
    skos:definition "Compound that undergoes biotransformation before exhibiting pharmacological effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prodrug" .

goldbook:13944 a skos:Concept ;
    skos:definition "Device that replaces a limb, organ, or tissue of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prosthesis" .

goldbook:13945 a skos:Concept ;
    skos:altLabel "stealth biomedical polymer" ;
    skos:definition "Qualifier for a macromolecule, a surface, or a device that is not detected by defense proteins of the complement and the Mononuclear Phagocyte System, especially macrophages, after introduction in parental compartments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stealth" .

goldbook:13946 a skos:Concept ;
    skos:definition "Exploitation of specific or nonspecific interactions to target a particular part of a living system, or a particular type of cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "targeting" .

goldbook:13947 a skos:Concept ;
    skos:definition "Polymer aimed at helping therapists in treating diseases or trauma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "therapeutic polymer" .

goldbook:13948 a skos:Concept ;
    skos:definition "Property of a material (or substance) that induces and/or promotes the formation of a thrombus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thrombogenicity" .

goldbook:13949 a skos:Concept ;
    skos:definition "Use of a combination of cells, engineering and materials methods, and suitable biochemical and physico-chemical factors to improve or replace biological functions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tissue engineering" .

goldbook:13950 a skos:Concept ;
    skos:definition "Complete structure, such as an organ that is transferred from a site in a donor to a site in a recipient for the purpose of the reconstruction of the recipient site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transplant" .

goldbook:13951 a skos:Concept ;
    skos:definition "Biodegradation in the presence of molecular oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerobic biodegradation" .

goldbook:13952 a skos:Concept ;
    skos:definition "Biodegradation in the absence of oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaerobic biodegradation" .

goldbook:13953 a skos:Concept ;
    skos:definition "Biobased polymer derived from the biomass or issued from monomers derived from the biomass and which, at some stage in its processing into finished products, can be shaped by flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioplastic" .

goldbook:13954 a skos:Concept ;
    skos:definition "Solid product resulting from the decomposition of organic wastes by fermentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compost" .

goldbook:13955 a skos:Concept ;
    skos:definition "Film that is rapidly formed on the surface of a solid in contact with a biological system (in the widest sense) that conditions the surface for subsequent interaction with constituents of the biological system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conditioning film" .

goldbook:13956 a skos:Concept ;
    skos:definition "Consequence of adverse effects caused by a substance on the environment and on organisms living in it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecotoxicity" .

goldbook:13957 a skos:Concept ;
    skos:definition "Polymer that can be degraded by the action of the environment, through, for example, air, light, heat, or microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmentally degradable polymer" .

goldbook:13958 a skos:Concept ;
    skos:altLabel "ecocompatible" ;
    skos:definition "Qualifiers for a substance, device, or process that has minimal deleterious impact on the environment, which is air, water, minerals, living systems, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmentally friendly" .

goldbook:13959 a skos:Concept ;
    skos:definition "Polymer that conforms to the concept of green chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "green polymer" .

goldbook:13960 a skos:Concept ;
    skos:definition "Investigation and valuation of the environmental impacts of a given product or service caused or necessitated by its existence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life cycle assessment" .

goldbook:13961 a skos:Concept ;
    skos:definition "Polymer film aimed at covering seeded area in order to protect the growing plants from weeds and cold and preserve humidity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mulching film" .

goldbook:13962 a skos:Concept ;
    skos:definition "Developments that meet the needs of the present without compromising the ability of future generations to meet their needs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sustainability" .

goldbook:13963 a skos:Concept ;
    skos:definition "Residue left when a compound or a product reaches the end of its initial usefulness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "waste" .

goldbook:13964 a skos:Concept ;
    skos:definition "Control of the collection, treatment and disposal of wastes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "waste management" .

goldbook:13965 a skos:Concept ;
    skos:altLabel "MC" ;
    skos:definition "Molecule that has at least one ring (cycle) large enough to allow it to be threaded onto a linear subchain of another molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrocyclic component" .

goldbook:13966 a skos:Concept ;
    skos:definition "Macromolecule that is part of a rotaxane assembly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecular component" .

goldbook:13967 a skos:Concept ;
    skos:definition "Pseudorotaxane, at least one component of which is a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecular pseudorotaxane" .

goldbook:13968 a skos:Concept ;
    skos:definition "Rotaxane, at least one component of which is a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecular rotaxane" .

goldbook:13969 a skos:Concept ;
    skos:definition "Macromolecular rotaxane in which rotaxane constitutional units are exclusively located within the main macromolecular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main-chain macromolecular rotaxane" .

goldbook:13970 a skos:Concept ;
    skos:altLabel "main-chain polyrotaxane" ;
    skos:definition "Polymer composed of macromolecular assemblies that are main-chain macromolecular rotaxanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main-chain rotaxane polymer" .

goldbook:13971 a skos:Concept ;
    skos:definition "Rotaxane or pseudorotaxane comprising a threading component upon which is threaded a macrocyclic component that, depending on the conditions, can reside at either a specific recognition site on the threading component or away from any recognition site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular shuttle" .

goldbook:13972 a skos:Concept ;
    skos:definition "Rotaxane-like molecular assembly in which the threading component(s) has(have) ends small enough to permit threading or dethreading of the macrocyclic component(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudorotaxane" .

goldbook:13973 a skos:Concept ;
    skos:altLabel "polypseudorotaxane" ;
    skos:definition "Polymer composed of macromolecules that are macromolecular pseudorotaxanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudorotaxane polymer" .

goldbook:13974 a skos:Concept ;
    skos:definition "Macromolecular rotaxane, the structure of which essentially comprises the repetition of a single constitutional unit of the rotaxane type, referred to as the rotaxane constitutional repeating unit, rot-CRU, with all units connected identically with respect to directional sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular macromolecular rotaxane" .

goldbook:13975 a skos:Concept ;
    skos:altLabel "<em>rot</em>-CRU",
        "rotaxane CRU" ;
    skos:definition "Constitutional repeating unit (CRU) that has a rotaxane structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxane constitutional repeating unit" .

goldbook:13976 a skos:Concept ;
    skos:altLabel "<em>rot</em>-CU",
        "rotaxane CU" ;
    skos:definition "Constitutional unit (CU) that has a rotaxane structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxane constitutional unit" .

goldbook:13977 a skos:Concept ;
    skos:altLabel "<em>rot</em>-EU" ;
    skos:definition "Constitutional unit of a macromolecular rotaxane consisting of an end-group of its macromolecular component and a complementary threading or macrocyclic component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxane end-unit" .

goldbook:13978 a skos:Concept ;
    skos:definition "Monomer that is a rotaxane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxane monomer" .

goldbook:13979 a skos:Concept ;
    skos:altLabel "<em>rot</em>-MU",
        "rotaxane MU",
        "rotaxane monomer unit" ;
    skos:definition "Monomeric unit (monomer unit, mer) that has a rotaxane structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxane monomeric unit" .

goldbook:13980 a skos:Concept ;
    skos:altLabel "polymeric rotaxane",
        "polyrotaxane" ;
    skos:definition "Polymer composed of macromolecules that are macromolecular rotaxanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxane polymer" .

goldbook:13981 a skos:Concept ;
    skos:definition "Macromolecular rotaxane in which rotaxane constitutional units are located exclusively in side chains of the macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "side-chain macromolecular rotaxane" .

goldbook:13982 a skos:Concept ;
    skos:altLabel "side-chain polyrotaxane" ;
    skos:definition "Polymer composed of macromolecular assemblies that are side-chain macromolecular rotaxanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "side-chain rotaxane polymer" .

goldbook:13983 a skos:Concept ;
    skos:definition "Group bulky enough to prevent dethreading of a given macrocyclic component from a threading component or its translocation to another linear section of the threading component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stopper" .

goldbook:13984 a skos:Concept ;
    skos:altLabel "threadable cycle" ;
    skos:definition "Key part of a macrocyclic component: molecular ring (cycle) large enough to be threaded onto a linear subchain of a threading component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threadable ring" .

goldbook:13985 a skos:Concept ;
    skos:altLabel "TC" ;
    skos:definition "Molecule with at least one linear section onto which at least one macrocyclic component is threaded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threading component" .

goldbook:13986 a skos:Concept ;
    skos:altLabel "local spectral photon density absorption rate",
        "local volumetric rate of photon absorption" ;
    skos:definition "Local value of the spectral photon radiance, or spectral photon flux density, defined for a three-dimensional space, often in terms of napierian properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed local spectral photon flux density" .

goldbook:13987 a skos:Concept ;
    skos:altLabel "local volumetric rate of energy absorption" ;
    skos:definition "Local value of the spectral radiance, or energy density absorption rate, defined for a three-dimensional space, often in terms of napierian properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed local spectral radiance" .

goldbook:13988 a skos:Concept ;
    skos:altLabel "absorbed spectral radiant density" ;
    skos:definition "Monochromatic radiant energy, per time interval (spectral radiance) coming from all directions and absorbed by a system integrated over the whole volume and averaged per volume \\(V\\), \\(\\langle L_{\\lambda}^{\\rm{a}}\\left(t \\right) \\rangle_{V}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed radiant density" .

goldbook:13989 a skos:Concept ;
    skos:definition "Subsurface space where the majority carriers accumulate near the surface of a semiconductor because of band bending caused by the surface potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accumulation layer" .

goldbook:13990 a skos:Concept ;
    skos:definition "Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier that interacts with species at the solid/liquid, liquid/liquid, solid/gas, or liquid/gas interfaces with formation of, e.g., chemisorbed species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active state" .

goldbook:13991 a skos:Concept ;
    skos:definition "Electronically excited surface centre, or a surface centre (surface site) with a trapped photogenerated charge carrier or reactive intermediate that interacts with molecular entities at an interface with the formation of reaction products or intermediates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active state" .

goldbook:13992 a skos:Concept ;
    skos:altLabel "areal parameters" ;
    skos:definition "Quantities expressed in terms of 'per area' are denoted as area-related parameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "area-related parameters" .

goldbook:13993 a skos:Concept ;
    skos:definition "Photocatalytic production of substances from simple compounds (e.g., \\(\\ce{H2}\\) and \\(\\ce{O2}\\) from water, \\(\\ce{H2}\\) from hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation absorbed by chromophoric systems, often included in microheterogeneous media, mimicking the action of antennae and reaction centres in natural photosynthetic organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial photosynthesis" .

goldbook:13994 a skos:Concept ;
    skos:definition "Recombination of charge carriers occurring via a one-step electron transition from the conduction band to the valence band in a semiconductor or insulator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "band-to-band recombination" .

goldbook:13995 a skos:Concept ;
    skos:definition "Idealised object absorbing all incident radiant power, regardless of wavelength and transforming it all into heat. No electromagnetic radiation passes through it and none is reflected. A black body is a perfect absorber of radiant energy. Therefore, it is also a perfect emitter of radiation. The wavelength distribution of the radiation of a black body depends only on its temperature and not on its internal nature or structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "black body" .

goldbook:13996 a skos:Concept ;
    skos:definition "Reactor used to determine quantum yields of photoadsorption and photocatalysed reactions when the catalyst is in the form of a powdered layer (or powder dispersion). The incident photons are (nearly) all absorbed by the catalyst, provided that the dispersion layer is sufficiently thick (or the dispersion is sufficiently concentrated)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "black-body-like photocatalytic reactor" .

goldbook:13997 a skos:Concept ;
    skos:altLabel "BET" ;
    skos:definition "Specific surface area (\\(\\pu{m2 kg-1}\\)) determined from the adsorption isotherm of a gas with the help of the Brunauer, Emmett, and Teller model using the conventional value for the molecular cross-section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brunauer–Emmett–Teller surface area" .

goldbook:13998 a skos:Concept ;
    skos:altLabel "catalyst photomodification" ;
    skos:definition "Generation or alteration of the catalytic activity (selectivity) of a substance after its interaction with light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst photoactivation" .

goldbook:13999 a skos:Concept ;
    skos:definition "Site at which catalysed chemical transformations take place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic site" .

goldbook:14000 a skos:Concept ;
    skos:definition "Enhancement (alteration) of efficiency of photochemical reactions upon direct excitation of photoactive reactants via an intermediate interaction of these reactants with certain compounds that act as catalysts (promoters) of the appropriate chemical transformations of the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalysed photochemical reaction" .

goldbook:14001 a skos:Concept ;
    skos:altLabel "Coekelbergs–Solonitsyn effect" ;
    skos:definition "Adsorption at the surface of a pre-irradiated adsorbent (the photocatalyst) occurring in the dark, after the irradiation in the presence of the photoadsorbate entities is terminated, i.e., after preliminary photoadsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Coekelbergs effect" .

goldbook:14002 a skos:Concept ;
    skos:definition "Lattice defects (typically vacancies) that trap one or more electrons or holes in ionic crystals. They constitute a long-lived deep trap with a low efficiency of trapping of a carrier of the opposite sign." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colour centres" .

goldbook:14003 a skos:Concept ;
    skos:definition "Trap defined by an energy level (of trapped carriers) within the bandgap energy of a semiconductor or insulator with an energy difference between it and the conduction band (for electrons) or valence band (for holes) much greater than the energy of thermal excitation of the solid at a given temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deep energy trap" .

goldbook:14004 a skos:Concept ;
    skos:definition "Subsurface space where the majority carriers are forced away owing to band bending caused by the surface potential. (i) The subsurface layer of an n-type semiconductor becomes depleted of electrons, which are the majority carriers, as a consequence of upward band bending. (ii) The subsurface layer of a p-type semiconductor becomes enriched by electrons (depleted of holes) as a consequence of downward band bending." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depletion layer" .

goldbook:14005 a skos:Concept ;
    skos:definition "Semiconductor or dielectric materials whose first band-to-band transition occurs from the highest level in the valence band to the lowest level in the conduction band possessing the same electron momentum, i.e., \\(\\boldsymbol{p}_{\\rm{max}} = \\boldsymbol{p}_{\\rm{min}}\\), with \\(\\boldsymbol{p}_{\\rm{max}}\\) and \\(\\boldsymbol{p}_{\\rm{min}}\\) the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct bandgap semiconductor" .

goldbook:14006 a skos:Concept ;
    skos:definition "Simultaneous (or synchronous) formation of adsorbed species (adsorbate) via photoadsorption and detachment by photodesorption to yield the same species, both processes occurring under photoexcitation of the solid photocatalyst (adsorbent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic photoadsorption process" .

goldbook:14007 a skos:Concept ;
    skos:definition "Number of product entities (atoms, molecules, or radicals) generated by each \\(\\pu{100 eV}\\) of radiation incident on the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective radiation-catalytic activity" .

goldbook:14008 a skos:Concept ;
    skos:definition "Array of charged species and oriented dipoles existing at a solid-solution interface. The solid may be a metal or a semiconductor. Double refers to the fact that the surface charge and its counter charge at the solution side are included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrical double layer" .

goldbook:14009 a skos:Concept ;
    skos:definition "Absorption of ultraviolet, visible, or infrared radiation yielding optical information on the excitons in solids. Exciton absorption bands in a spectrum of a semiconductor or insulator are located on the long wavelength side of the fundamental absorption edge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton absorption" .

goldbook:14010 a skos:Concept ;
    skos:definition "Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators corresponding to optical transitions of electrons from defect energy levels (within the bandgap energy) to conduction band levels, or holes to valence band levels (photoionisation of defects), or from the ground state level to excited levels of a given intrinsic defect of any sort." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrinsic absorption" .

goldbook:14011 a skos:Concept ;
    skos:altLabel "extrinsic surface defect" ;
    skos:definition "Imperfection in a solid semiconductor (or insulator) connected with surface defects of any sort involving extrinsic chemical units in relation to the chemical formula of the solid, particularly adsorbed species of any sort." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrinsic defect" .

goldbook:14012 a skos:Concept ;
    skos:definition "Anion vacancies occupied by electrons in semiconductors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "F centres" .

goldbook:14013 a skos:Concept ;
    skos:definition "Splitting of the Fermi level in irradiated semiconductors and insulators into two Fermi quasi-levels for electrons \\(E_{\\rm{F}}^{\\rm{e}}\\) and for holes \\(E_{\\rm{F}}^{\\rm{h}}\\), displaced toward the bottom of the conduction band and toward the top of the valence band, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fermi level splitting" .

goldbook:14014 a skos:Concept ;
    skos:definition "Applies to free electrons or free holes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free charge carriers" .

goldbook:14015 a skos:Concept ;
    skos:definition "Photoexcited electrons from the valence band into the conduction band in semiconductors and insulators." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free electrons" .

goldbook:14016 a skos:Concept ;
    skos:altLabel "intrinsic absorption" ;
    skos:definition "Absorption of ultraviolet, visible, or infrared radiation in semiconductors and insulators inducing optical transitions of electrons originating exclusively from the valence band to the conduction band to yield free electron-hole pairs and/or exciton absorption bands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fundamental absorption" .

goldbook:14017 a skos:Concept ;
    skos:altLabel "fundamental absorption threshold" ;
    skos:definition "High wavelength limit of the fundamental absorption band in the spectrum of semiconductors and of insulators." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fundamental absorption edge" .

goldbook:14018 a skos:Concept ;
    skos:definition "Photocatalysis taking place at the interfacial boundary between two phases (solid/liquid, solid/gas, liquid/gas)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous photocatalysis" .

goldbook:14019 a skos:Concept ;
    skos:definition "Radiation catalysis taking place in heterogeneous systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous radiation catalysis" .

goldbook:14020 a skos:Concept ;
    skos:definition "Photocatalysis taking place in homogeneous systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous photocatalysis" .

goldbook:14021 a skos:Concept ;
    skos:definition "Radiation catalysis taking place in homogeneous systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous radiation catalysis" .

goldbook:14022 a skos:Concept ;
    skos:definition "Semiconductor or dielectric materials with a first band-to-band transition from the highest level in the valence band to the lowest level in the conduction band requiring the change of electron momentum, that is \\(\\boldsymbol{p}_{\\rm{max}}  eq \\boldsymbol{p}_{\\rm{min}}\\), where \\(\\boldsymbol{p}_{\\rm{max}}\\) and \\(\\boldsymbol{p}_{\\rm{min}}\\) are the momentum vectors of electrons of the highest level in the valence band and the lowest level in the conduction band, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect bandgap semiconductor" .

goldbook:14023 a skos:Concept ;
    skos:altLabel "scattering in (into the beam under consideration)" ;
    skos:definition "Physical phenomenon considering scattered radiative energy from rays in any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) of the rays considered in the radiative transfer equation (RTE)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-scattering" .

goldbook:14024 a skos:Concept ;
    skos:altLabel "IPET" ;
    skos:definition "Electron transfer taking place from a photoexcited semiconductor onto another semiconductor (or insulator) in its ground state leading to vectorial (irreversible) charge transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interparticle electron transfer" .

goldbook:14025 a skos:Concept ;
    skos:definition "Band-to-band recombination of electrons and holes (or exciton decay) in a semiconductor or insulator leading to luminescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic emission" .

goldbook:14026 a skos:Concept ;
    skos:altLabel "intrinsic surface defects" ;
    skos:definition "Imperfections connected with surface point defects (zero-dimensional), linear defects (one-dimensional), or square defects (two-dimensional) not including extrinsic chemical units in relation to the chemical formula of the solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic defects" .

goldbook:14027 a skos:Concept ;
    skos:definition "Layer formed when band bending places the Fermi level on the surface close to the band of the bulk minority charge carriers. This leads to a higher concentration of the minority charge carriers on the surface relative to the concentration of the majority charge carriers, an opposite situation to that in the bulk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion layer" .

goldbook:14028 a skos:Concept ;
    skos:definition "Absorption term in the radiative transfer equation (RTE). Mathematical expression is \\[\\alpha_{\\lambda} (\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x}/t)\\] with \\(\\alpha_{\\lambda} (\\boldsymbol{x},t)\\) the space- and time-dependent linear napierian absorption coefficient and \\(L_{\\mathit{\\Omega},\\lambda} (\\boldsymbol{x},t)\\) the spectral radiance arriving at position \\(x\\) and time \\(t\\) from every possible angular directions \\(\\mathit{\\Omega}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local differential absorption" .

goldbook:14029 a skos:Concept ;
    skos:definition "Production of complex organic substances by higher plants, algae and photosynthesising bacteria from simple compounds (e.g., carbon dioxide and water, hydrogen sulfide, etc.) using ultraviolet, visible, or infrared radiation energy absorbed by, e.g., chlorophyll, chlorophyll-protein complexes, and natural chromoproteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural photosynthesis" .

goldbook:14030 a skos:Concept ;
    skos:altLabel "scattering out (out of the beam under consideration)" ;
    skos:definition "Physical process by which the incoming electromagnetic radiation is forced to deviate from a straight trajectory by non-uniformities in the medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "out-scattering" .

goldbook:14031 a skos:Concept ;
    skos:definition "Distribution function representing the fraction of photons scattered from any direction \\(\\mathit{\\Omega}'\\) into the direction \\(\\mathit{\\Omega}\\) under consideration in the radiative transfer equation (RTE). Dimension one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase function" .

goldbook:14032 a skos:Concept ;
    skos:altLabel "photoadsorbed species" ;
    skos:definition "Entity (molecule, atom, or ion) bound to the surface of a solid (semiconductor or insulator) particle (typically to a photoadsorption centre) as the result of photoexcitation of either the solid or the entity (molecule, atom, or ion)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorbate" .

goldbook:14033 a skos:Concept ;
    skos:definition "Maximum amount of substance photoadsorbed per area on the uniformly irradiated surface of an adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption area number" .

goldbook:14034 a skos:Concept ;
    skos:definition "Maximal number of entities (molecules, atoms, or ions) per regular surface site that can be photoadsorbed at a uniformly irradiated surface of an adsorbent, \\(\\theta_{\\rm{max}} = N_{\\rm{max}}/N^{\\rm{ss}}\\) where \\(N_{\\rm{max}}\\) is the maximal number of entities photoadsorbed and \\(N^{\\rm{ss}}\\) is the number of surface sites (mainly regular surface sites, i.e., regular lattice ions or atoms; typically, \\(N^{\\rm{ss}}\\) ca. \\(\\pu{E15 cm-2}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption capacity" .

goldbook:14035 a skos:Concept ;
    skos:definition "Surface site or defect in its active state after photoexcitation capable of photoadsorbing species by a chemical interaction with the adsorbate entities (molecules, atoms, or ions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption centre" .

goldbook:14036 a skos:Concept ;
    skos:definition "Ratio of the maximal (typically the initial) rate of photoadsorption of entities \\(\\ce{B}\\) (molecules, atoms, or ions) to the integrated incident (superscript 0, zero) photon flux, \\(\\int_{\\lambda_{1}}^{\\lambda_{2}} q_{\\rm{p},\\lambda}^{0}{\\rm{d}}\\lambda = q_{\\rm{p}}^{0} = {\\rm{d}}N_{\\rm{p}}^{0}/{\\rm{d}}t\\), in the wavelength range \\(\\lambda_{1}{-}\\lambda_{2}\\). Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption efficiency" .

goldbook:14037 a skos:Concept ;
    skos:definition "Number of entities (atoms, molecules or ions) photoadsorbed per regular surface site at a uniformly irradiated surface of an adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption fraction" .

goldbook:14038 a skos:Concept ;
    skos:definition "Ratio of the maximal (typically the initial) rate of photoadsorption of entities \\(\\ce{B}\\) (molecules, atoms, or ions) on a surface to the incident (superscript 0, zero) photon flux, \\(q_{\\rm{p},\\lambda}^{0} = {\\rm{d}}N_{\\rm{p},\\lambda}^{0}/{\\rm{d}}t\\) at a given wavelength. Both rates should be measured under otherwise identical conditions (preferably as initial rates) in order to avoid concentration and/or surface area effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption photonic yield" .

goldbook:14039 a skos:Concept ;
    skos:definition "Ratio of the number of photoadsorbed entities \\(\\ce{B}\\) (molecules, atoms, or ions) on a surface to the number of photons of ultraviolet, visible, or infrared radiation (at a given wavelength \\(\\lambda\\)) absorbed by the system (typically by the adsorbent) during the initial stage of irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption quantum yield" .

goldbook:14040 a skos:Concept ;
    skos:definition "Nonequilibrium free electron or free hole generated in a solid by ultraviolet, visible, or infrared absorption and occupying energy levels in the conduction band or the valence band, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocarrier" .

goldbook:14041 a skos:Concept ;
    skos:definition "Surface centre, i.e., either a surface defect or a regular surface site, at which a chemical transformation takes place after converting the centre into an active state by a photophysical process, e.g., by photoexcitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalytic active centre" .

goldbook:14042 a skos:Concept ;
    skos:altLabel "PCA" ;
    skos:definition "Number of entities (product) formed in a photocatalytic process (alternatively the number of reactant entities disappearing) divided by the number of photons absorbed by the photocatalyst at one single wavelength or within a defined wavelength range. For one wavelength it has the same meaning as quantum yield, whereas within a defined wavelength range it has the same meaning as quantum efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalytic activity" .

goldbook:14043 a skos:Concept ;
    skos:definition "Surface centre, i.e., a surface defect or a regular surface site, in an active or electronically excited state at which a chemical transformation takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalytic centre" .

goldbook:14044 a skos:Concept ;
    skos:definition "Number of entities (product) formed (alternatively the number of reactant entities disappearing) divided by the number of ultraviolet, visible, or infrared photons incident (prior to absorption) on the system and in a wavelength range \\(\\lambda_{1}{-}\\lambda_{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalytic efficiency" .

goldbook:14045 a skos:Concept ;
    skos:altLabel "PCO" ;
    skos:definition "Commonly used to describe the oxidation of pollutants by the action of ultraviolet, visible, or infrared radiation and a catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalytic oxidation" .

goldbook:14046 a skos:Concept ;
    skos:definition "Decomposition of the photocatalyst or of the electrodes as a result of a photoinduced reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocorrosion" .

goldbook:14047 a skos:Concept ;
    skos:definition "Photogeneration and movement of charge between two electrodes in a photovoltaic cell or a photoelectrochemical cell as a result of photoprocesses induced by light absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocurrent" .

goldbook:14048 a skos:Concept ;
    skos:definition "Desorption induced by the absorption of ultraviolet, visible, or infrared radiation either by the adsorbate or by the adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodesorption" .

goldbook:14049 a skos:Concept ;
    skos:definition "Number of entities evolving into the medium from a surface divided by the number of photons absorbed at a given wavelength by a solid or by an adsorbed entity treated as a surface extrinsic defect (centre)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodesorption quantum yield" .

goldbook:14050 a skos:Concept ;
    skos:definition "Electrochemically assisted photocatalysis. The role of the photocatalyst is played by a photoelectrode, often a semiconductor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrocatalysis" .

goldbook:14051 a skos:Concept ;
    skos:definition "Electrode capable of initiating electrochemical transformations after absorbing ultraviolet, visible, or infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrode" .

goldbook:14052 a skos:Concept ;
    skos:definition "Process by which ultraviolet, visible, or infrared radiation is absorbed by a semiconductor, electron transfer occurs at the interface between the semiconductor and a liquid and the output is chemical energy, i.e., radiant energy is stored as chemical energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrosynthesis" .

goldbook:14053 a skos:Concept ;
    skos:definition "Initiation of chemical transformations through the photochemical formation of molecular species, which (once formed) are catalytically active even without the action of ultraviolet, visible, or infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photogenerated catalysis" .

goldbook:14054 a skos:Concept ;
    skos:definition "Charge carrying entity, especially an electron or a hole, in a semiconductor, produced by the absorption of ultraviolet, visible, or infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photogenerated charge carrier" .

goldbook:14055 a skos:Concept ;
    skos:definition "Agent initiating certain chemical transformations under the action of ultraviolet, visible, or infrared radiation and consumed therewith." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoinitiator" .

goldbook:14056 a skos:Concept ;
    skos:definition "Complete photodegradation of an organic compound into carbon dioxide and water, and other simple inorganic compounds (depending on the hetero-atom in the compound) upon absorption of ultraviolet, visible, or infrared radiation by the photocatalyst or by the adsorbate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photomineralisation" .

goldbook:14057 a skos:Concept ;
    skos:altLabel "FQE",
        "formal quantum efficiency" ;
    skos:definition "Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons within a defined wavelength interval inside the irradiation window of the reactor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photonic efficiency" .

goldbook:14058 a skos:Concept ;
    skos:definition "Ratio of the rate of the photoreaction measured for a specified time interval (usually the initial conditions) to the rate of incident photons of monochromatic light inside the irradiation window of the reactor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photonic yield" .

goldbook:14059 a skos:Concept ;
    skos:definition "Plot of the photonic yield of a given photoprocess, measured at the same photon flux of incident (prior to absorption) light, as a function of a measure of the energy of the photons, i.e., for monochromatic irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photonic yield spectrum" .

goldbook:14060 a skos:Concept ;
    skos:definition "Radiation catalysis under conditions not allowing a distinction between the effect of ultraviolet, visible, or infrared and of ionising radiation as well as the case in which the ionising radiation alone generates emission of chemically active light (e.g., the 'Cherenkov' light emission)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoradiation catalysis" .

goldbook:14061 a skos:Concept ;
    skos:definition "Reaction initiated by photosensitisation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosensitised reaction" .

goldbook:14062 a skos:Concept ;
    skos:definition "Catalysis occurring by the combined action of electronic excitation due to absorption of ultraviolet or visible radiation and thermal energy (infrared radiation or exothermic reactions) including catalytic phenomena." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photothermocatalysis" .

goldbook:14063 a skos:Concept ;
    skos:definition "Set of physical processes leading to the relaxation of the electronically excited system without chemical transformations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "physical pathway" .

goldbook:14064 a skos:Concept ;
    skos:definition "Radiant energy (\\(Q\\), SI unit is \\(\\pu{J}\\)) or amount of photons (in \\(\\pu{mol}\\) or the non-SI unit einstein) absorbed per area or volume by an object irradiated during a given exposure time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiant dose" .

goldbook:14065 a skos:Concept ;
    skos:altLabel "radioactivation" ;
    skos:definition "Increasing of catalytic activity or alteration of selectivity of a substance after its exposure to high-energy radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation-activation" .

goldbook:14066 a skos:Concept ;
    skos:altLabel "radiation-induced adsorption",
        "radioadsorption" ;
    skos:definition "The word combination may be misleading. Usually radiation is absorbed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation adsorption" .

goldbook:14067 a skos:Concept ;
    skos:definition "Change in the rate of a chemical reaction under the action of ionising radiation in the presence of a radiation catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation catalysis" .

goldbook:14068 a skos:Concept ;
    skos:definition "Substance absorbing ionising radiation and able to produce chemical transformations of the reaction partners, repeatedly producing intermediate transformations and regenerating its chemical composition after each cycle of such interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation catalyst" .

goldbook:14069 a skos:Concept ;
    skos:altLabel "G value" ;
    skos:definition "Number of entities of a product formed (alternatively, the number of entities of a reactant disappearing) generated per \\(\\pu{100 eV}\\) of energy absorbed from ionising radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation-chemical yield" .

goldbook:14070 a skos:Concept ;
    skos:definition "Desorption from solid or liquid interfaces induced by absorption of radiation by the solid or liquid adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation desorption" .

goldbook:14071 a skos:Concept ;
    skos:definition "Initiation of chemical transformations through the formation, by absorption of high-energy radiation, of substances that are catalytically active even in the absence of the radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation-generated catalysis" .

goldbook:14072 a skos:Concept ;
    skos:altLabel "radiation adsorption",
        "radioadsorption" ;
    skos:definition "Adsorption of a molecular entity at solid or liquid interfaces induced by absorption of high-energy radiation by the solid or the liquid adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation-induced adsorption" .

goldbook:14073 a skos:Concept ;
    skos:altLabel "radiosensitisation" ;
    skos:definition "Chemical change or physical process occurring in one entity (e.g., biological molecules, cells, and living organisms) as a result of initial absorption of high-energy radiation by the medium in the presence of another entity called the radiation sensitiser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation sensitisation" .

goldbook:14074 a skos:Concept ;
    skos:altLabel "radiosensitiser" ;
    skos:definition "Chemical substance that increases the radiation sensitivity of, in particular, biological molecules, cells and biological organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation sensitiser" .

goldbook:14075 a skos:Concept ;
    skos:altLabel "radiostimulated diffusion" ;
    skos:definition "Increase of diffusion of an adsorbate under the action of ionising radiation absorbed by either the adsorbent and/or the adsorbate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation-stimulated diffusion" .

goldbook:14076 a skos:Concept ;
    skos:altLabel "radiothermal catalysis" ;
    skos:definition "Radiation catalysis under the action of large radiation fluxes that simultaneously heat the system as a consequence of absorption of energy from radiationless deactivation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation thermal catalysis" .

goldbook:14077 a skos:Concept ;
    skos:altLabel "RTE" ;
    skos:definition "When a photon beam of radiance \\(L_{\\lambda}\\) and angular distribution \\(\\mathit{\\Omega}\\) passes along a single direction of propagation through a medium, which is totally absorbing and/or scattering, i.e., the processes occurring are described by the following equation: \\[\\begin{array} \\\\ \\frac{{\\rm{d}}L_{\\Omega,\\lambda}(\\boldsymbol{x},t)}{{\\rm{d}}s} + \\underbrace{\\alpha_{\\lambda}(\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t)}_{\\rm{adsorption}} + \\underbrace{\\sigma_{\\lambda}(\\boldsymbol{x},t) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t)}_{\\rm{out\\mbox{-}scattering}} = \\\\ \\underbrace{j_{\\lambda}(\\boldsymbol{x},t)}_{\\rm{emission}} + \\underbrace{\\frac{\\sigma_{\\lambda}(\\boldsymbol{x},t)}{4\\pi}B_{\\lambda}(\\mathit{\\Omega}' \\to \\mathit{\\Omega}) L_{\\mathit{\\Omega},\\lambda}(\\boldsymbol{x},t){\\rm{d}}\\mathit{\\Omega}'}_{\\rm{in\\mbox{-}scattering}} \\end{array}\\] where \\(\\frac{{\\rm{d}}L_{\\Omega,\\lambda}(\\boldsymbol{x},t)}{{\\rm{d}}s}\\) is the directional derivative along the direction \\(s\\) at a point \\(\\boldsymbol{x}\\) in the reaction space of the incident radiance, \\(\\alpha_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent spectral linear napierian absorption coefficient, \\(\\sigma_{\\lambda}(\\boldsymbol{x},t)\\) is the space- and time-dependent spectral linear napierian scattering coefficient, \\(j_{\\lambda}(\\boldsymbol{x},t)\\) represents the spontaneous and/or induced emission, and \\(B_{\\lambda}\\) is the phase function. All quantities are a function of time. The RTE is written for the direction \\(s\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative transfer equation" .

goldbook:14078 a skos:Concept ;
    skos:altLabel "rate of photogeneration" ;
    skos:definition "Number of carriers (or electron-hole pairs, or excitons) produced per time interval and per volume of a solid photocatalyst particle due to the absorption of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of generation" .

goldbook:14079 a skos:Concept ;
    skos:definition "Decay of carriers at the surface of a solid or interface between different phases, e.g., at the crystal surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of surface recombination" .

goldbook:14080 a skos:Concept ;
    skos:altLabel "recombination of photocarriers via defects" ;
    skos:definition "Two-step transition of an electron from the conduction band to a defect centre and then further to the valence band, or from the defect centre to the valence band (first step) and a subsequent transition of the conduction band electron to the defect centre (second step)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombination of photocarriers" .

goldbook:14081 a skos:Concept ;
    skos:definition "Defect in semiconductors and insulators capable of sequential capture of free charge carriers of both signs with high efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recombination centre" .

goldbook:14082 a skos:Concept ;
    skos:definition "Perfect surface of a solid without heterogeneity or defect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular surface" .

goldbook:14083 a skos:Concept ;
    skos:definition "Zero-dimension site (atom, ion, or interstitial position) at a regular surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular surface site" .

goldbook:14084 a skos:Concept ;
    skos:definition "Ratio of the photonic efficiency (\\(\\xi\\)) of a chemical process to the corresponding photonic efficiency of a standard process under otherwise identical conditions in the same reactor configuration and operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative photonic efficiency" .

goldbook:14085 a skos:Concept ;
    skos:definition "Efficiency of scattering, i.e., ratio of scattering coefficient, \\(\\sigma(\\lambda_{\\rm{i}})\\), to the total attenuance coefficient, \\(\\beta(\\lambda_{\\rm{i}})\\), at a particular wavelength \\(\\lambda_{\\rm{i}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering albedo" .

goldbook:14086 a skos:Concept ;
    skos:altLabel "shallow energy trap" ;
    skos:definition "Energy level (of trapped carrier) within the bandgap energy, near the bottom of the conduction band (electron shallow trap) and near the top of the valence band (hole shallow band) at an energy such that \\(E_{\\rm{trap}} \\approx kT\\), with \\(k\\) the Boltzmann constant and \\(T\\) the thermodynamic temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shallow trap" .

goldbook:14087 a skos:Concept ;
    skos:altLabel "post-adsorption" ;
    skos:definition "Adsorption (or reaction) after preliminary irradiation of a photocatalyst in vacuum (or in the absence of reagent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Solonitsyn effect" .

goldbook:14088 a skos:Concept ;
    skos:definition "Reactor in which a hybrid technique combining 'sonochemical' and photocatalytic reactions is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonophotocatalytic reactor" .

goldbook:14089 a skos:Concept ;
    skos:definition "Region formed within a semiconductor in contact with another phase in which there is a band bending that can be upward or downward." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "space charge region" .

goldbook:14090 a skos:Concept ;
    skos:definition "Maximum number of entities (molecules, atoms or radicals) adsorbed as a result of irradiation divided by the surface area and by the mass of adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific photoadsorption number" .

goldbook:14091 a skos:Concept ;
    skos:altLabel "specific linear Napierian spectral absorption coefficient",
        "specific linear decadic spectral absorption coefficient",
        "specific spectral absorption coefficient" ;
    skos:definition "Linear napierian, \\(\\alpha_{\\lambda}^{\\ast}\\), or linear decadic, \\(a_{\\lambda}^{\\ast}\\), absorption coefficient divided by the mass concentration, \\(\\rho\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific absorption coefficient" .

goldbook:14092 a skos:Concept ;
    skos:altLabel "specific Napierian extinction coefficient",
        "specific Napierian spectral extinction coefficient",
        "specific spectral Napierian attenuance coefficient" ;
    skos:definition "Attenuance (napierian), \\(D_{\\rm{e}}\\), divided by the absorption pathlength, \\(l\\), and the mass concentration, \\(\\rho\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific napierian attenuance coefficient" .

goldbook:14093 a skos:Concept ;
    skos:altLabel "specific spectral napierian scattering coefficient" ;
    skos:definition "Fraction of attenuance (napierian) not due to absorbance, divided by the pathlength, \\(l\\), within the scattering medium and the mass concentration, \\(\\rho\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific napierian scattering coefficient" .

goldbook:14094 a skos:Concept ;
    skos:definition "Derivative of photon irradiance, \\(E_{\\rm{p}}\\), with respect to wavelength, \\(\\lambda\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral photon irradiance" .

goldbook:14095 a skos:Concept ;
    skos:definition "Dependence of the photonic yield on the photon energy (wavelength, frequency, or wavenumber) of the radiation for a given photoreaction obtained at a certain incident (prior to absorption) photon irradiance in a given spectral range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral photonic yield" .

goldbook:14096 a skos:Concept ;
    skos:definition "Dependence of the quantum yield on the photon energy (wavelength, frequency or wavenumber) of the radiation absorbed by the reactant for a given photoreaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral quantum yield" .

goldbook:14097 a skos:Concept ;
    skos:altLabel "surface-active centre" ;
    skos:definition "Surface regular or defect site that can initiate the chemical transformation of reagents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-active site" .

goldbook:14098 a skos:Concept ;
    skos:definition "Recombination of charge carriers at a solid surface or at an interface between different phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface recombination" .

goldbook:14099 a skos:Concept ;
    skos:definition "Loss of absorption by the colour centres because of heating of the solid semiconductor or insulator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal bleaching" .

goldbook:14100 a skos:Concept ;
    skos:altLabel "light-initiated thermocatalytic phenomena" ;
    skos:definition "A photocatalytic phenomenon occurring when the system is also heated by the ultraviolet, visible, or infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermophotocatalysis" .

goldbook:14101 a skos:Concept ;
    skos:altLabel "TON" ;
    skos:definition "Number of times, \\(n\\), that the overall reaction (the photochemical transformation) goes through a photocatalytic cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "turnover number" .

goldbook:14102 a skos:Concept ;
    skos:definition "Trapped holes in semiconductors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "V centres" .

goldbook:14103 a skos:Concept ;
    skos:definition "Term commonly used to designate organic gas-phase pollutants frequently degraded by photocatalytic procedures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volatile organic chemical/compounds" .

goldbook:14104 a skos:Concept ;
    skos:altLabel "optical density assay (obsolete)" ;
    skos:definition "Assay in which response is determined by the detection of light absorption by an assay component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbance assay" .

goldbook:14105 a skos:Concept ;
    skos:definition "Sample that produces a response or signal above a defined threshold at a tested concentration in a single assay or screen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active" .

goldbook:14106 a skos:Concept ;
    skos:definition "Graphical representation of the number of samples present in each activity range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activity distribution" .

goldbook:14107 a skos:Concept ;
    skos:definition "Binding site on a protein, distinct from the site recognized by an endogenous agonist (i.e., the orthosteric site) in the case of a receptor, or substrate in the case of an enzyme, that when occupied by a ligand effects a conformational change in the protein, thus altering its signaling, catalytic properties, or its capability to interact with other macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allosteric site" .

goldbook:14108 a skos:Concept ;
    skos:altLabel "artefact" ;
    skos:definition "Observation, effect, or result that is inaccurate because it is produced by the methodology used in scientific investigation or by experimental error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artifact" .

goldbook:14109 a skos:Concept ;
    skos:definition "Experiments conducted to verify that the output measurements of the assay are consistently reflective of the activity against the target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assay validation" .

goldbook:14110 a skos:Concept ;
    skos:definition "Device that performs one or more functions without human intervention by means of direct control or by programmed operations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "automated device" .

goldbook:14111 a skos:Concept ;
    skos:definition "Assay in which the specific physical association or interaction between two molecules (e.g., ligand–receptor, antibody–antigen, protein–protein, ligand–transport protein) is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binding assay" .

goldbook:14112 a skos:Concept ;
    skos:definition "Graphical representation of the relationship between the amount of ligand that is specifically bound to a receptor per mass of binding material and the amount of free ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binding isotherm" .

goldbook:14113 a skos:Concept ;
    skos:definition "Assay in which the response of live cells to a test sample is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell-based assay" .

goldbook:14114 a skos:Concept ;
    skos:definition "Preparation from tissue or cells, in which the membranous elements, generally the cell membrane, are enriched in relation to other cellular constituents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell membrane preparation" .

goldbook:14115 a skos:Concept ;
    skos:definition "Ratio of counted dead cells to the total number of observed cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell mortality" .

goldbook:14116 a skos:Concept ;
    skos:definition "Ratio of counted live cells to the total number of observed cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell viability" .

goldbook:14117 a skos:Concept ;
    skos:definition "Compound that reduces or eliminates the conductance of an ion channel by impeding the movement of ions through that channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "channel blocker" .

goldbook:14118 a skos:Concept ;
    skos:altLabel "channel activator" ;
    skos:definition "Compound that increases the conductance of an ion channel by a mechanism other than alteration of membrane potential or activation of the cognate receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "channel opener" .

goldbook:14119 a skos:Concept ;
    skos:definition "Cell-based assay in which the rate and/or direction of cell migration is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemotaxis assay" .

goldbook:14120 a skos:Concept ;
    skos:definition "Set of compounds prepared by combinatorial chemistry. It may consist of a collection of pools, or sublibraries. Its composition may be described by the chemset notation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combinatorial library" .

goldbook:14121 a skos:Concept ;
    skos:altLabel "compound deck",
        "compound library" ;
    skos:definition "Set of chemicals that has been assembled and annotated for easy storage and retrieval and that is available for screening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compound collection" .

goldbook:14122 a skos:Concept ;
    skos:definition "Association between compound concentration and the resultant magnitude of the continuously graded change produced, in an assay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration–response relationship" .

goldbook:14123 a skos:Concept ;
    skos:definition "Sample that produces activity above the hit threshold in an assay and whose structural identity has been confirmed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confirmed hit" .

goldbook:14124 a skos:Concept ;
    skos:definition "Screen in which test samples are assessed against a target for unwanted activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter-screen" .

goldbook:14125 a skos:Concept ;
    skos:definition "Cell-based assay in which damage to cell structure or function caused by a test sample is determined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytotoxicity assay" .

goldbook:14126 a skos:Concept ;
    skos:definition "Extent to which a compound activates a receptor to produce a response in an assay under saturating conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efficacy" .

goldbook:14127 a skos:Concept ;
    skos:definition "Assay in which light emitted by electrogenerated luminescence is detected and used to quantify a label, e.g., ruthenium(II) tris-(bipyridine), on one of the two assay binding components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemiluminescence assay" .

goldbook:14128 a skos:Concept ;
    skos:definition "Kinetic assay run for a set constant incubation time. Typically, at the end of the set incubation time, a reagent that stops the reaction is added to allow postponed measurement of the signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "end-point assay" .

goldbook:14129 a skos:Concept ;
    skos:definition "Identification and localization of the specific regions of protein molecules that are recognized by the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epitope mapping" .

goldbook:14130 a skos:Concept ;
    skos:definition "Assay in which there is sufficient incubation time for the plateau phase of the signal to be reached and equilibrium has been established between the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium assay" .

goldbook:14131 a skos:Concept ;
    skos:definition "Ratio, at equilibrium, of \\([\\ce{AB}]/[\\ce{A}][\\ce{B}]\\) for the reversible binding interaction of \\(\\ce{A}\\) and \\(\\ce{B}\\) to yield the complex \\(\\ce{AB}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium association constant" .

goldbook:14132 a skos:Concept ;
    skos:definition "Ratio, at equilibrium, of \\([\\ce{A}][\\ce{B}]/[\\ce{AB}]\\), for the reversible binding interaction of \\(\\ce{A}\\) and \\(\\ce{B}\\) to yield the complex \\(\\ce{AB}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium dissociation constant" .

goldbook:14133 a skos:Concept ;
    skos:definition "Cell-based assay in which the response is dependent on the detection of the phenotype of cells as determined through the light-scattering properties of each cell, and, typically, the fluorescence intensity of a relevant probe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow cytometry assay" .

goldbook:14134 a skos:Concept ;
    skos:definition "Assay in which fluctuations in fluorescence intensity are detected and used to characterize a species that is labeled with a fluorescent probe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence correlation assay" .

goldbook:14135 a skos:Concept ;
    skos:definition "Dimensionless value determined from the fluorescence intensities (\\(I\\)) measured parallel (\\(I_{\\Vert}\\)) and perpendicular (\\(I_{\\perp}\\)) to the excitation plane: \\[p = \\frac{I_{\\Vert} - I_{\\perp}}{I_{\\Vert} + I_{\\perp}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence polarisation" .

goldbook:14136 a skos:Concept ;
    skos:definition "Assay in which the association between an intrinsically fluorescent ligand, or a ligand linked to a fluorescent probe, and a larger macromolecule is detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence polarisation assay" .

goldbook:14137 a skos:Concept ;
    skos:altLabel "FRET",
        "FRET assay" ;
    skos:definition "Assay based on the nonradiative energy transfer that occurs when the emission spectrum of a fluorescent donor molecule overlaps with the absorption spectrum of an energy acceptor molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence resonance energy transfer assay" .

goldbook:14138 a skos:Concept ;
    skos:definition "Assay in which the biological or physiological activity of the target is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional assay" .

goldbook:14139 a skos:Concept ;
    skos:definition "Assay in which the response is detected only after the physical separation by methods such as filtration or centrifugation of one or more assay components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous assay" .

goldbook:14140 a skos:Concept ;
    skos:definition "Assay in which one binding component is immobilized to a surface (e.g., cellular membrane, glass, gold, bead, or biopolymer layer) while its binding partner is freely diffusible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous binding assay" .

goldbook:14141 a skos:Concept ;
    skos:definition "A cell-based assay that produces multiple biological readouts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-content screening assay" .

goldbook:14142 a skos:Concept ;
    skos:altLabel "HPLC",
        "HPLC Assay" ;
    skos:definition "Assay in which response is determined after the physical separation of assay components using high-performance liquid chromatography (HPLC) with concurrent detection, usually by monitoring absorbance at an appropriate wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-performance liquid chromatography assay" .

goldbook:14143 a skos:Concept ;
    skos:definition "Relative term, applied to the generation of a large number of results in a short timeframe (e.g., \\(\\pu{E5}\\) in a week or a month)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high throughput" .

goldbook:14144 a skos:Concept ;
    skos:definition "Proportion of hits from a screen that displays confirmed activity beyond a minimum defined level, the hit threshold. It is expressed as a percentage of the number of samples screened." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hit rate" .

goldbook:14145 a skos:Concept ;
    skos:definition "Minimum activity that defines actives in a primary screen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hit threshold" .

goldbook:14146 a skos:Concept ;
    skos:definition "Assay in which all reagents and reactants are of a uniform phase (typically, liquid phase) and assay response is detected without the need for physical separation of assay components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous assay" .

goldbook:14147 a skos:Concept ;
    skos:definition "Single-phase system used to qualitatively discriminate between specific and nonspecific interactions or quantitatively determine the concentration of a component part of a mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous binding assay" .

goldbook:14148 a skos:Concept ;
    skos:definition "Assay in which image analysis algorithms that determine the compartmentalization of fluorescent probes give topological as well as quantitative information." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image-based assay" .

goldbook:14149 a skos:Concept ;
    skos:altLabel "IMAP™",
        "IMAP™ assay" ;
    skos:definition "Assay in which the interaction between nanoparticles coated with triply charged metal ions and phosphate groups on a substrate that carries a fluorescent tag is detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immobilised metal ion affinity-based fluorescence polarisation assay" .

goldbook:14150 a skos:Concept ;
    skos:definition "Sample that, at the tested concentration, does not produce a response above the hit threshold in an assay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inactive" .

goldbook:14151 a skos:Concept ;
    skos:definition "Ligand that decreases signaling through a receptor below the level of constitutive activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse agonist" .

goldbook:14152 a skos:Concept ;
    skos:definition "Assay in which the time dependence of the signal intensity is measured. Signal values are typically acquired at several time intervals in order to calculate kinetic parameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic assay" .

goldbook:14153 a skos:Concept ;
    skos:definition "Assay in which there is no requirement to modify one of the interacting components in order to facilitate signal detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "label-free assay" .

goldbook:14154 a skos:Concept ;
    skos:definition "Direct detection of compound activity on a target without the requirement for a labeled reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "label-free detection" .

goldbook:14155 a skos:Concept ;
    skos:definition "Process that is targeted toward the generation of at least one compound series that meets the requirements for progression to lead optimization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lead identification" .

goldbook:14156 a skos:Concept ;
    skos:definition "Process in which the drug-like properties of an initial lead or lead series are improved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lead optimisation" .

goldbook:14157 a skos:Concept ;
    skos:definition "Collection of samples (e.g., chemical compounds, natural products, over-expression library of a microbe) available for screening. Set of compounds produced through combinatorial chemistry or other means that expands around a single core structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "library" .

goldbook:14158 a skos:Concept ;
    skos:definition "Any ion channel that is gated (i.e., opened or closed) by a ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand-activated channel" .

goldbook:14159 a skos:Concept ;
    skos:altLabel "liquid handling machine" ;
    skos:definition "Automated device that accurately and precisely delivers programmed, predefined quantities of liquid to a microplate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid handler" .

goldbook:14160 a skos:Concept ;
    skos:definition "Assay in which response is measured by the detection of light of a nonradiative origin, such as bioluminescence or chemiluminescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminescence assay" .

goldbook:14161 a skos:Concept ;
    skos:definition "Any of a number of plates containing a series of wells which may be used for storage or to perform individual assays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microplate" .

goldbook:14162 a skos:Concept ;
    skos:definition "Defined footprint, height, flanges, and well positions for 96-, 384-, and 1536-well microplates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microplate standards" .

goldbook:14163 a skos:Concept ;
    skos:definition "Experimental design aimed at decreasing the reaction volume of an assay and consequently the amount and cost of reagents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miniaturisation" .

goldbook:14164 a skos:Concept ;
    skos:definition "Individual automated device within a fully automated assay system that usually performs a complete single assay step or procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "module" .

goldbook:14165 a skos:Concept ;
    skos:altLabel "MIPs" ;
    skos:definition "Synthetic polymers in which well-defined volume cavities (imprints) created by template molecules mimic a biomolecular specific ligand–receptor interaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular imprinted polymers" .

goldbook:14166 a skos:Concept ;
    skos:definition "Assay in which the activity of a single sample against more than one target is measured in a single test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplex assay" .

goldbook:14167 a skos:Concept ;
    skos:definition "Complex mixture derived from natural (biological) sources used in screening as a resource for identification of lead compounds. Pure compound of natural (biological) origin (whether obtained by purification of natural mixtures or by laboratory synthesis), as opposed to compounds originating from synthetic chemistry.Note: Typical origins include extracts from microbes and higher organisms from terrestrial or marine environments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural product" .

goldbook:14168 a skos:Concept ;
    skos:altLabel "low control" ;
    skos:definition "Experimental conditions designed to produce the signal reflective of the absence of the process under investigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative assay control" .

goldbook:14169 a skos:Concept ;
    skos:altLabel "indirect binding assay" ;
    skos:definition "Assay in which the interaction of a ligand with a receptor is measured without a requirement for added competing agents. It can be homogeneous or heterogeneous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "noncompetitive binding assay" .

goldbook:14170 a skos:Concept ;
    skos:definition "Method used to determine the presence or quantify the amount of specific target nucleotide sequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclease assay" .

goldbook:14171 a skos:Concept ;
    skos:definition "Rate of dissociation of the enzyme-substrate (\\(\\ce{ES}\\)) complex to enzyme (\\(\\ce{E}\\)) and substrate (\\(\\ce{S}\\)) or of ligand–receptor (\\(\\ce{LR}\\)) to receptor (\\(\\ce{R}\\)) and ligand (\\(\\ce{L}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "off-rate" .

goldbook:14172 a skos:Concept ;
    skos:definition "Rate of formation of the enzyme-substrate (\\(\\ce{ES}\\)) or ligand–receptor (\\(\\ce{LR}\\)) complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "on-rate" .

goldbook:14173 a skos:Concept ;
    skos:definition "Binding site recognized by the endogenous agonist of a receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orthosteric site" .

goldbook:14174 a skos:Concept ;
    skos:definition "Agonist that is unable to induce a maximal receptor response in a given biological assay, regardless of the amount applied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial agonist" .

goldbook:14175 a skos:Concept ;
    skos:definition "Device that aspirates and dispenses liquid (\\(\\pu{nL}\\) to \\(\\pu{mL}\\) range) for the purposes of transferring from a source to destination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pipettor" .

goldbook:14176 a skos:Concept ;
    skos:definition "Number and configuration of wells on a microplate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate format" .

goldbook:14177 a skos:Concept ;
    skos:definition "Handling device that positions microplates on a workstation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate gripper" .

goldbook:14178 a skos:Concept ;
    skos:definition "Layout of samples and controls configured on a plate during an assay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate map" .

goldbook:14179 a skos:Concept ;
    skos:definition "Automated device that uses optical and/or computer vision techniques to detect biological, chemical, or physical events in samples stored in microplates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate reader" .

goldbook:14180 a skos:Concept ;
    skos:definition "Automated device that loads, unloads, and restacks microplates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate stacker" .

goldbook:14181 a skos:Concept ;
    skos:definition "Automated device used to wash the wells of microplates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate washer" .

goldbook:14182 a skos:Concept ;
    skos:altLabel "high control" ;
    skos:definition "Experimental conditions designed to produce the signal reflective of maximum biological effect in an assay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positive assay control" .

goldbook:14183 a skos:Concept ;
    skos:definition "Dose of drug required to produce a specific effect of given intensity as compared to a standard reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potency" .

goldbook:14184 a skos:Concept ;
    skos:definition "Initial screen applied to assess the activity of a collection of compounds and identify hits or actives against a biological target of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary screen" .

goldbook:14185 a skos:Concept ;
    skos:definition "Ligand into which a radioisotope has been incorporated as a label." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioligand" .

goldbook:14186 a skos:Concept ;
    skos:definition "Automated device that performs tasks (i.e., screen functions) that would normally be performed by a human." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "robot" .

goldbook:14187 a skos:Concept ;
    skos:definition "Computer program used to organize the chronological sequence of experimental methods to be followed to execute an automated high-throughput screening campaign." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scheduling software" .

goldbook:14188 a skos:Concept ;
    skos:altLabel "SPA™" ;
    skos:definition "Homogeneous assay in which beads incorporated with scintillant emit light in the presence of radiolabeled molecules within the proximity of the bead’s scintillant detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scintillation proximity assay" .

goldbook:14189 a skos:Concept ;
    skos:definition "Execution, analysis, and interpretation of a large number of assays to evaluate the activity of a collection of samples against a target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "screen" .

goldbook:14190 a skos:Concept ;
    skos:definition "Assay conditions, as determined by assay validation, are performed in the chosen plate format with an acceptable signal to background ratio as described by the Z′ factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "screen validation" .

goldbook:14191 a skos:Concept ;
    skos:definition "Screen applied to independently confirm actives from the primary screen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary screen" .

goldbook:14192 a skos:Concept ;
    skos:definition "Assay used to determine the relative potency of active or lead compounds toward an alternative target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectivity assay" .

goldbook:14193 a skos:Concept ;
    skos:definition "Eukaryotic cells into which recombinant DNA has been introduced and incorporated into the genome, so that the cells replicate the new DNA in a stable fashion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stably transfected cells" .

goldbook:14194 a skos:Concept ;
    skos:altLabel "SEM" ;
    skos:definition "Sample standard deviation divided by the square root of the sample size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard error of the mean" .

goldbook:14195 a skos:Concept ;
    skos:definition "Portion of a library that is grouped or selected based on similarity of structure or biological effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sublibrary" .

goldbook:14196 a skos:Concept ;
    skos:altLabel "SPR",
        "SPR Assay" ;
    skos:definition "Assay in which the binding of a ligand to a target immobilized on the gold surface of a chip is detected by changes in the angle of the light reflected from the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface plasmon resonance assay" .

goldbook:14197 a skos:Concept ;
    skos:definition "Library designed, on the basis of preexisting information, to generate enhanced activity or hit rate against a particular biological target or target class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "targeted library" .

goldbook:14198 a skos:Concept ;
    skos:altLabel "TIRF" ;
    skos:definition "Spectroscopic technique that discriminates between labeled molecules in the homogeneous phase and those interacting with binding partners immobilized at a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total internal reflection fluorescence" .

goldbook:14199 a skos:Concept ;
    skos:definition "Eukaryotic cells into which recombinant DNA has been introduced and expressed by cellular transcription, but without incorporation into the stable genome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transiently transfected cells" .

goldbook:14200 a skos:Concept ;
    skos:definition "Relative term, currently applied to the screening of \\(\\pu{E5}\\) test samples in a \\(\\pu{24\\!\\mbox{-}h}\\) period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultra-high throughput" .

goldbook:14201 a skos:Concept ;
    skos:definition "Ion channel that is specifically activated, or gated, by the surrounding potential difference across the cell membrane near the channel (or near the cell, neuron, or synapse)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "voltage-activated channel" .

goldbook:14202 a skos:Concept ;
    skos:definition "Programmable device used to automate a single operation (such as liquid handling) on a microplate supplied to the device by a robot (automated stacker system or a robotic manipulator)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "workstation" .

goldbook:14203 a skos:Concept ;
    skos:definition "Dimensionless statistical parameter that provides a practical assessment of assay performance in the presence of test compounds. \\[Z = 1 - 3(\\sigma_{\\rm{s}} + \\sigma_{\\rm{c}})/\\vert\\mu_{\\rm{s}} - \\mu_{\\rm{c}}\\vert\\] where \\(\\mu_{\\rm{s}}\\) denotes the mean of the library sample signal, \\(\\mu_{\\rm{c}}\\) the mean of the control signal and \\(\\sigma_{\\rm{s}}\\), \\(\\sigma_{\\rm{c}}\\) the corresponding standard deviations. \\(1 \\gt Z \\ge 0.5\\) generally categorizes an excellent assay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Z factor" .

goldbook:14204 a skos:Concept ;
    skos:definition "Dimensionless statistical parameter used extensively in biomolecular screening, and a characteristic of an assay without the intervention of test compounds. It provides a practical index of the quality and reliability of the assay, and can be used as a guide to assay development and optimization. \\[Z' = 1 - 3(\\sigma_{\\rm{c^{+}}} + \\sigma_{\\rm{c^{-}}})/(\\vert\\mu_{\\rm{c^{+}}} - \\mu_{\\rm{c^{-}}}\\vert)\\] where \\(\\sigma_{\\rm{c^{+}}}\\) and \\(\\sigma_{\\rm{c^{-}}}\\) are the standard deviations of the high and low controls and \\(\\mu_{\\rm{c^{+}}}\\) and \\(\\mu_{\\rm{c^{-}}}\\) are the means of the high and low controls, respectively. A graphical illustration of the parameters used in the calculation of \\(Z'\\) is provided below." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Z′ factor" .

goldbook:14205 a skos:Concept ;
    skos:definition "Model based on the assumption that the polymer sample consists only of domains of a crystalline phase and of an amorphous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-phase model" .

goldbook:14206 a skos:Concept ;
    skos:altLabel "unit height" ;
    skos:definition "Projected length of a constitutional repeating unit (CRU) on the chain axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axial advancement per constitutional repeating unit" .

goldbook:14207 a skos:Concept ;
    skos:definition "Polymer chain that may be oriented in two distinguishable, opposite directions along the chain axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "directional chain" .

goldbook:14208 a skos:Concept ;
    skos:definition "Stem of a directional chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "directional stem" .

goldbook:14209 a skos:Concept ;
    skos:definition "Distance between successive helical windings projected on the chain axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helix pitch" .

goldbook:14210 a skos:Concept ;
    skos:definition "Minimum energy conformation of an isolated polymer chain constructed according to the equivalence postulate and approximating the conformation found in a crystalline phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal crystalline chain conformation" .

goldbook:14211 a skos:Concept ;
    skos:definition "Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds clockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "left-handed helix" .

goldbook:14212 a skos:Concept ;
    skos:definition "Helical arrangement comprising two or more intertwined helical chains sharing the same axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple helix" .

goldbook:14213 a skos:Concept ;
    skos:definition "Helix in which the continuous helical line, approximating the sequence of bonds along the polymer main chain, winds anticlockwise moving towards the observer, i.e., seen from the positive axis direction (see the figures in chain identity period)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "right-handed helix" .

goldbook:14214 a skos:Concept ;
    skos:altLabel "line repetition group" ;
    skos:definition "Symmetry group of a three-dimensional array of atoms, regularly repeating along one direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rod group" .

goldbook:14215 a skos:Concept ;
    skos:altLabel "unit twist" ;
    skos:definition "Angle of rotation about the chain axis per helix residue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotation per helix residue" .

goldbook:14216 a skos:Concept ;
    skos:altLabel "fiber repeat unit",
        "physical repeating unit" ;
    skos:definition "Smallest structural unit of a polymer chain that is repeated by translation in the crystal lattice along the chain axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "translational chain repeating unit" .

goldbook:14217 a skos:Concept ;
    skos:definition "Stems in a crystal having opposite side-group orientations with respect to the chain axis (see (a) in figure).(a) Pairs of anticlined stems and (b) pairs of isoclined stems of regioregular poly(3-butylthiophene), i.e., poly(3-n-butylthiophene-2,5-diyl). Since regioregular poly(3-n-butylthiophene-2,5-diyl) is also a directional chain, (a) is an example of antidirectional packing of two chains, while (b) is an example of isodirectional packing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticlined stems" .

goldbook:14218 a skos:Concept ;
    skos:altLabel "antiparallel packing" ;
    skos:definition "In a parallel-chain crystal, the crystalline packing of directional stems with opposite chain axis orientations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antidirectional packing" .

goldbook:14219 a skos:Concept ;
    skos:altLabel "crystal modification",
        "crystalline form" ;
    skos:definition "One of the different crystalline phases in which a given substance is able to crystallize." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal polymorph" .

goldbook:14220 a skos:Concept ;
    skos:definition "Feature of crystalline packing characterized by different crystalline arrangements of chain stems at two (or more) sites that would be expected to be equivalent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frustration" .

goldbook:14221 a skos:Concept ;
    skos:definition "Crystalline packing of stems having the same helicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isochiral stem packing" .

goldbook:14222 a skos:Concept ;
    skos:definition "Stems in a crystal having the same side-group orientation with respect to the chain axis (see figure (b) in anticlined stems)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoclined stems" .

goldbook:14223 a skos:Concept ;
    skos:altLabel "parallel packing" ;
    skos:definition "In a parallel-chain crystal, the crystalline packing of directional stems with the same chain axis orientation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isodirectional packing" .

goldbook:14224 a skos:Concept ;
    skos:definition "Spatial arrangement of polymer chain stems in a polymer crystal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "packing of chain stems" .

goldbook:14225 a skos:Concept ;
    skos:definition "Polymer crystal formed by domains of different crystal polymorphs of the same polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymorphic polymer crystal" .

goldbook:14226 a skos:Concept ;
    skos:definition "Packing in a polymer crystal in which stems of opposite helicity coexist in equal numbers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemic packing" .

goldbook:14227 a skos:Concept ;
    skos:definition "Vanishing, in a specific crystal polymorph, of selected symmetry elements present in other crystal polymorphs, or in selected minimum energy conformations of isolated molecules of a given substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetry breaking" .

goldbook:14228 a skos:Concept ;
    skos:definition "Structural disorder at given crystallographic positions, resulting from the statistical coexistence within crystals of directional stems with opposite orientations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orientational disorder" .

goldbook:14229 a skos:Concept ;
    skos:definition "Crystal model characterized by lattice distortions and hence by limited order along given lattice directions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paracrystal" .

goldbook:14230 a skos:Concept ;
    skos:altLabel "uncorrelated paracrystalline disorder" ;
    skos:definition "Structural disorder in a paracrystal, resulting from uncorrelated displacements of the atoms around their average positions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paracrystalline disorder of the first kind" .

goldbook:14231 a skos:Concept ;
    skos:altLabel "correlated paracrystalline disorder" ;
    skos:definition "Structural disorder in a paracrystal, resulting from permanent atomic displacements from the ordered crystallographic positions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paracrystalline disorder of the second kind" .

goldbook:14232 a skos:Concept ;
    skos:definition "Ratio of the statistical fluctuation \\(\\Delta a_{ik}\\) of a lattice vector \\(a_{i}\\) along the direction \\(a_{k}\\) \\[g_{ik} = \\frac{\\Delta a_{ik}}{a_{k}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paracrystalline distortion factor" .

goldbook:14233 a skos:Concept ;
    skos:definition "Crystal comprising a polymer guest within a low-molar-mass host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystalline polymer-inclusion complex" .

goldbook:14234 a skos:Concept ;
    skos:definition "Crystalline molecular complex between different polymers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystalline-polymer molecular complex" .

goldbook:14235 a skos:Concept ;
    skos:definition "Crystal consisting of two or more structurally different polymers, resulting in macromolecular isomorphism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomorphous polymer co-crystal" .

goldbook:14236 a skos:Concept ;
    skos:definition "Macromolecular isomorphism involving copolymers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copolymer isomorphism" .

goldbook:14237 a skos:Concept ;
    skos:definition "Macromolecular isomorphism involving two homopolymers with different constitutional repeating units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homopolymer isomorphism" .

goldbook:14238 a skos:Concept ;
    skos:definition "Polymer crystal presenting empty volume elements that can host low-molar-mass guest species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoporous polymer crystal" .

goldbook:14239 a skos:Concept ;
    skos:definition "Polymer co-crystal in which low-molar-mass guest species are hosted in molecular-sized cages or cavities containing more than one guest molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer clathrate" .

goldbook:14240 a skos:Concept ;
    skos:altLabel "polymer mixed crystal",
        "polymer-based crystalline molecular complex" ;
    skos:definition "Crystal structure in which at least two substances coexist, one of which is a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer co-crystal" .

goldbook:14241 a skos:Concept ;
    skos:definition "Adjacent re-entry model in which the fold period can vary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irregular adjacent re-entry model" .

goldbook:14242 a skos:Concept ;
    skos:definition "Idealized adjacent re-entry model in which the fold periods are assumed to have all the same length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular adjacent re-entry model" .

goldbook:14243 a skos:Concept ;
    skos:definition "Folded-chain crystal in which each macromolecule makes one, or, at most, a few folds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-extended crystal" .

goldbook:14244 a skos:Concept ;
    skos:altLabel "fold length" ;
    skos:definition "Thickness of a lamellar parallel-chain crystal in the direction of its stems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fold period" .

goldbook:14245 a skos:Concept ;
    skos:definition "Polymer crystal in which the stems are aligned along two or more different crystallographic directions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-parallel-chain crystal" .

goldbook:14246 a skos:Concept ;
    skos:definition "Model of crystalline polymer formed by lamellar crystallization from the melt, in which some stems of a macromolecule belong to one crystal, whilst other stems of the same macromolecule are in different crystals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solidification model" .

goldbook:14247 a skos:Concept ;
    skos:definition "Phase domain consisting of matter in the amorphous state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amorphous domain" .

goldbook:14248 a skos:Concept ;
    skos:definition "Crystal in which the chains predominantly extend from the crystal surface, resulting in a fringed-micelle model morphology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bundle crystal" .

goldbook:14249 a skos:Concept ;
    skos:definition "Polyhedral aggregate of lamellar crystals resulting in a morphology that resembles that of a polymer single crystal, at least from one viewing direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hedrite" .

goldbook:14250 a skos:Concept ;
    skos:definition "Portion of a lamellar crystal, often bounded by a well-defined crystal face." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lamellar crystal sector" .

goldbook:14251 a skos:Concept ;
    skos:altLabel "long spacing" ;
    skos:definition "Average periodicity (repeating distance) of the layers of lamellar crystals in a stacked assembly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "long period" .

goldbook:14252 a skos:Concept ;
    skos:definition "Crystalline polymer in which a large number of polymer crystallites coexist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycrystalline polymer" .

goldbook:14253 a skos:Concept ;
    skos:definition "Uniaxially oriented polymer filament with macroscopic cylindrical symmetry, in which the average direction of the polymer chain axis coincides with the cylindrical symmetry axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer fibre" .

goldbook:14254 a skos:Concept ;
    skos:definition "Small diameter polymer fiber consisting of a small number of polymer chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer fibril" .

goldbook:14255 a skos:Concept ;
    skos:definition "Individually distinct polymer crystal whose lattice, at crystallization, is characterized by a single orientation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer single crystal" .

goldbook:14256 a skos:Concept ;
    skos:definition "Polycrystalline polymer morphology resulting from nucleation of polymer lamellar crystals by multiple fibrillar structures or by macroscopic linear objects such as fibers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "row structure" .

goldbook:14257 a skos:Concept ;
    skos:definition "Lamellar crystals radiating from the center of the spherulite which, by splaying, constitute the initial skeleton of the spherulite." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dominant lamellae" .

goldbook:14258 a skos:Concept ;
    skos:altLabel "infilling lamellae" ;
    skos:definition "Lamellar crystals nucleated either epitaxially or incoherently on dominant lamellae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subsidiary lamellae" .

goldbook:14259 a skos:Concept ;
    skos:definition "Polycrystalline layer nucleated and shaped by a pre-existing planar surface within or in contact with a polymer melt." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcrystalline layer" .

goldbook:14260 a skos:Concept ;
    skos:definition "Polymer crystal in which two or more single crystalline domains of the same crystal polymorph, with different lattice orientations, coexist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "twinned polymer crystal" .

goldbook:14261 a skos:Concept ;
    skos:definition "Division of the growth front of individual or groups of dominant lamellae into divergent 'cells', with the impurities and the less crystallizable molecules segregated between the cells and at the spherulite boundaries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cellulation" .

goldbook:14262 a skos:Concept ;
    skos:definition "Polymer crystallization occurring inside elongated cavities, spheres, galleries, or layers formed by a host material different from the polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confined-spaces crystallisation" .

goldbook:14263 a skos:Concept ;
    skos:altLabel "degree of undercooling" ;
    skos:definition "Temperature difference between the equilibrium melting temperature and the temperature of a supercooled melt." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of supercooling" .

goldbook:14264 a skos:Concept ;
    skos:definition "Epitaxy between crystals of different substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroepitaxy" .

goldbook:14265 a skos:Concept ;
    skos:definition "Epitaxy between crystals of the same substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homoepitaxy" .

goldbook:14266 a skos:Concept ;
    skos:definition "Crystallization taking place at constant temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isothermal crystallisation" .

goldbook:14267 a skos:Concept ;
    skos:definition "Crystallization taking place under varying temperature conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-isothermal crystallisation" .

goldbook:14268 a skos:Concept ;
    skos:definition "The smallest crystalline entity, the further growth of which is thermodynamically favored." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary nucleus" .

goldbook:14269 a skos:Concept ;
    skos:definition "Nucleation of a new molecular layer on a growing crystal face.Note: Secondary nucleation refers to the further growth of an already-existing crystal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary nucleation" .

goldbook:14270 a skos:Concept ;
    skos:altLabel "self-seeding" ;
    skos:definition "Heterogeneous nucleation by crystals of the same polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-nucleation" .

goldbook:14271 a skos:Concept ;
    skos:definition "Crystallization, within the same crystal, of a polymer and at least one other component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer co-crystallisation" .

goldbook:14272 a skos:Concept ;
    skos:definition "Metastable melt of a crystallizable polymer at temperatures below its equilibrium melting temperature \\(T^{\\circ}_{\\rm{m}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercooled melt" .

goldbook:14273 a skos:Concept ;
    skos:altLabel "undercooling" ;
    skos:definition "The process of cooling a melt to a temperature below its equilibrium melting point, without crystallization occurring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercooling" .

goldbook:14274 a skos:Concept ;
    skos:definition "Particle of polymer of any shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer particle" .

goldbook:14275 a skos:Concept ;
    skos:definition "Sphere of polymer, usually with a diameter in the range from one-tenth to a few millimeters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer bead" .

goldbook:14276 a skos:Concept ;
    skos:definition "Particle of polymer of any shape with an equivalent diameter from approximately \\(\\pu{0.1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer microparticle" .

goldbook:14277 a skos:Concept ;
    skos:definition "Polymer microparticle of spherical shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer microsphere" .

goldbook:14278 a skos:Concept ;
    skos:definition "Particle of polymer of any shape and an equivalent diameter from approximately \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer nanoparticle" .

goldbook:14279 a skos:Concept ;
    skos:definition "Polymer nanoparticle of spherical shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer nanosphere" .

goldbook:14280 a skos:Concept ;
    skos:definition "Particle of gel in which the network component is a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer gel particle" .

goldbook:14281 a skos:Concept ;
    skos:altLabel "microgel" ;
    skos:definition "Particle of gel of any shape with an equivalent diameter of approximately \\(\\pu{0.1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel microparticle" .

goldbook:14282 a skos:Concept ;
    skos:altLabel "nanogel" ;
    skos:definition "Particle of gel particle of any shape and an equivalent diameter of approximately \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel nanoparticle" .

goldbook:14283 a skos:Concept ;
    skos:definition "Particle having any shape and composed of a polymer network and possibly species of finite molar mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer network particle" .

goldbook:14284 a skos:Concept ;
    skos:definition "Latex obtained by emulsification of a polymer or oligomer solution in a liquid or by emulsification of a liquid polymer or liquid oligomer in a liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial latex" .

goldbook:14285 a skos:Concept ;
    skos:definition "Latex comprising a polymer of relatively high molar mass and an oligomer or an alkyd resin, in which there is usually chemical bonding between the two components, formed either during latex synthesis or subsequently after formation of a film from the latex. Latex comprising multicomponent particles that contain both organic and inorganic material phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid latex" .

goldbook:14286 a skos:Concept ;
    skos:definition "Nonaqueous latex in which the dispersed phase comprises hydrophilic polymer usually swollen with water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse latex" .

goldbook:14287 a skos:Concept ;
    skos:definition "Polymer particle that is present in a latex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latex particle" .

goldbook:14288 a skos:Concept ;
    skos:definition "Latex, the dispersed phase of which is obtained from various plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural latex" .

goldbook:14289 a skos:Concept ;
    skos:definition "Latex obtained as a product of an emulsion, mini-emulsion, micro-emulsion, or dispersion polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synthetic latex" .

goldbook:14290 a skos:Concept ;
    skos:definition "Diameter of a hypothetical spherical particle of the same composition that, using a given particle-size determination method, would give the same diameter as a substance composed of spherical or nonspherical particles at the same concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalent particle diameter" .

goldbook:14291 a skos:Concept ;
    skos:definition "Calculated using the following equation: \\[\\left\\langle d_{\\rm{N}} \\right\\rangle = \\bar d_{\\rm{N}} = \\frac{\\Sigma N_{i} d_{i}}{\\Sigma N_{i}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number-average particle diameter" .

goldbook:14292 a skos:Concept ;
    skos:definition "Calculated using the following equation: \\[\\left\\langle {d_{\\rm{s}}} \\right\\rangle = \\bar d_{\\rm{s}} = \\frac{\\Sigma {N_{i}} {d_{i}^{3}}}{\\Sigma {N_{i}} {d_{i}^{2}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface-average particle diameter" .

goldbook:14293 a skos:Concept ;
    skos:definition "Calculated using the following equation: \\[\\left\\langle d_{\\rm{m}} \\right\\rangle = \\bar d_{\\rm{m}} = \\frac{\\Sigma {N_{i}} {d_{i}^{4}}}{\\Sigma {N_{i}} {d_{i}^{3}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-average particle diameter" .

goldbook:14294 a skos:Concept ;
    skos:definition "Calculated using the following equation: \\[\\left\\langle d_{\\rm{z}} \\right\\rangle = \\bar d_{\\rm{z}} = \\frac{\\Sigma N_{i} d_{i}^{5}}{\\Sigma N_{i}d_{i}^{4}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "z-average particle diameter" .

goldbook:14295 a skos:Concept ;
    skos:definition "Calculated using the following equation: \\[\\left\\langle d_{\\rm{v}} \\right\\rangle = \\bar d_{\\rm{v}} = \\left(\\frac{\\Sigma N_{i} d_{i}^{3}}{\\Sigma N_{i}}\\right)^{1/3}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume-average particle diameter" .

goldbook:14296 a skos:Concept ;
    skos:definition "Calculated using the following equation: \\[Ɖ_{\\rm{d}} = \\left\\langle d_{\\rm{m}} \\right\\rangle /\\!\\left\\langle d_{\\rm{N}} \\right\\rangle = \\bar d_{\\rm{m}}/\\bar d_{\\rm{N}} = \\frac{\\Sigma N_{i}\\Sigma N_{i} d_{i}^{4}}{\\Sigma N_{i} d_{i} \\Sigma N_{i} d_{i}^{3}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle-diameter dispersity" .

goldbook:14297 a skos:Concept ;
    skos:definition "Particle that is spatially uniform with respect to chemical composition of the constituent polymer(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous particle" .

goldbook:14298 a skos:Concept ;
    skos:altLabel "composite particle",
        "structured particle" ;
    skos:definition "Inhomogeneous particle consisting of two or more immiscible components.Examples of two-phase particle morphology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicomponent particle" .

goldbook:14299 a skos:Concept ;
    skos:definition "Polymer particle comprising at least two phase domains, one of which (the core) lies within the other(s) that form the polymeric outer layer(s) (the shell(s))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core-shell particle" .

goldbook:14300 a skos:Concept ;
    skos:definition "Core-shell particle in which polymer synthesized in the second stage is located in the core of the particle and polymer constituting the initial seed is located in the shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverted core-shell particle" .

goldbook:14301 a skos:Concept ;
    skos:definition "Multicomponent particle made of at least two different polymers, with an inner core of one polymer and with at least two layers of different polymers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multilayered particle" .

goldbook:14302 a skos:Concept ;
    skos:definition "Multicomponent particle in which one polymer forms more than one phase domain within a matrix of another polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occluded particle" .

goldbook:14303 a skos:Concept ;
    skos:definition "Multicomponent particle in which one or more polymer(s) cover(s) most, but not all, of the particle surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partially engulfed particle" .

goldbook:14304 a skos:Concept ;
    skos:definition "Particle containing pores of diameters exceeding about \\(\\pu{50 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroporous particle" .

goldbook:14305 a skos:Concept ;
    skos:definition "Particle containing pores of diameters between approximately \\(\\pu{2 \\upmu m}\\) and \\(\\pu{50 \\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesoporous particle" .

goldbook:14306 a skos:Concept ;
    skos:definition "Particle containing pores of diameters not exceeding \\(\\pu{2 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microporous particle" .

goldbook:14307 a skos:Concept ;
    skos:definition "Phase constituted of particles of any size and of any nature dispersed in a continuous phase of a different composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersed phase" .

goldbook:14308 a skos:Concept ;
    skos:definition "Phase not interrupted in space" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous phase" .

goldbook:14309 a skos:Concept ;
    skos:definition "Matrix for the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion medium" .

goldbook:14310 a skos:Concept ;
    skos:definition "Dispersion in which the continuous phase is nonaqueous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonaqueous dispersion" .

goldbook:14311 a skos:Concept ;
    skos:definition "Dispersion in which the dispersed phase consists of a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer dispersion" .

goldbook:14312 a skos:Concept ;
    skos:definition "Compound increasing stability of a colloid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloid stabiliser" .

goldbook:14313 a skos:Concept ;
    skos:definition "Colloidal dispersion in which at least one of the phases is a polymer, either organic, or inorganic or some combination of the two." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer colloid" .

goldbook:14314 a skos:Concept ;
    skos:definition "Emulsion in which the dispersed phase is a liquid polymer or a polymer solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer emulsion" .

goldbook:14315 a skos:Concept ;
    skos:definition "Emulsion in which the particles of the dispersed phase have diameters from approximately \\(\\pu{1 \\upmu m}\\) to \\(\\pu{100 \\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macro-emulsion" .

goldbook:14316 a skos:Concept ;
    skos:definition "Emulsion in which the particles of the dispersed phase have diameters in the range from approximately \\(\\pu{50 nm}\\) to \\(\\pu{1 \\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mini-emulsion" .

goldbook:14317 a skos:Concept ;
    skos:definition "Dispersion made of water, oil, and surfactant(s) that is an isotropic and thermodynamically stable system with dispersed domain diameter varying approximately from \\(\\pu{1 nm}\\) to \\(\\pu{100 nm}\\), usually \\(\\pu{10 nm}\\) to \\(\\pu{50 nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micro-emulsion" .

goldbook:14318 a skos:Concept ;
    skos:definition "Type of micelle that exists in relatively small numbers below the critical micelle concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemi-micelle" .

goldbook:14319 a skos:Concept ;
    skos:definition "Surfactant bilayer formed on a charged adsorbing surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ad-micelle" .

goldbook:14320 a skos:Concept ;
    skos:altLabel "micellar degree of association" ;
    skos:definition "Number of molecules constituting a micelle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar aggregation number" .

goldbook:14321 a skos:Concept ;
    skos:definition "Combined charge of the surfactant ions and counterions tightly bound to a micelle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar charge" .

goldbook:14322 a skos:Concept ;
    skos:altLabel "micellar molecular weight" ;
    skos:definition "Mass of a mole of micelles divided by the molar mass constant. The relative molar mass of micelles (mic) is thus \\(M_{\\rm{r,mic}} = M_{\\rm{mic}}/M_{\\rm{u}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar relative molar mass" .

goldbook:14323 a skos:Concept ;
    skos:definition "Number of particles per volume of suspending medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle number concentration" .

goldbook:14324 a skos:Concept ;
    skos:definition "Mass fraction of nonvolatile material in a polymer dispersion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solids content" .

goldbook:14325 a skos:Concept ;
    skos:definition "Mass fraction of polymer in a polymer dispersion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer content" .

goldbook:14326 a skos:Concept ;
    skos:altLabel "dispersed-phase amount concentration",
        "particle-phase amount concentration",
        "particle-phase concentration" ;
    skos:definition "Amount concentration of a species within the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersed-phase concentration" .

goldbook:14327 a skos:Concept ;
    skos:altLabel "continuous-phase amount concentration" ;
    skos:definition "Concentration of species within the continuous phase of a dispersion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous-phase concentration" .

goldbook:14328 a skos:Concept ;
    skos:definition "Mass fraction of polymer within the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer mass fraction" .

goldbook:14329 a skos:Concept ;
    skos:definition "Polymerization whereby monomer(s), initiator, dispersion medium, and possibly colloid stabilizer constitute initially an inhomogeneous system resulting in particles of colloidal dimensions containing the formed polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emulsion polymerisation" .

goldbook:14330 a skos:Concept ;
    skos:definition "Emulsion polymerization in which no seed particles are added." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ab initio emulsion polymerisation" .

goldbook:14331 a skos:Concept ;
    skos:definition "Emulsion polymerization in which all the ingredients are placed in a reactor prior to reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "batch emulsion polymerisation" .

goldbook:14332 a skos:Concept ;
    skos:definition "Emulsion polymerization in which all the ingredients are added continuously and the product latex is removed continuously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous emulsion polymerisation" .

goldbook:14333 a skos:Concept ;
    skos:definition "Emulsion polymerization carried out without the addition of a colloid stabilizer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emulsifier-free emulsion polymerisation" .

goldbook:14334 a skos:Concept ;
    skos:definition "Emulsion polymerization leading to the encapsulation of a solid within polymer particles or liquid polymer droplets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encapsulating emulsion polymerisation" .

goldbook:14335 a skos:Concept ;
    skos:definition "Emulsion polymerization in a nonaqueous medium in which the dispersed phase is usually an aqueous solution, initially of monomer(s), and finally of polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse emulsion polymerisation" .

goldbook:14336 a skos:Concept ;
    skos:definition "Semi-continuous emulsion polymerization in which the monomer(s) is(are) fed to the reactor at a rate that exceeds the rate of polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomer-flooded emulsion polymerisation" .

goldbook:14337 a skos:Concept ;
    skos:definition "Semi-continuous emulsion polymerization in which the polymerization rate is controlled by the feed rate(s) of monomer(s), in such a way that, for most of the process, the polymerization rate equals the monomer(s) feed rate(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomer-starved emulsion polymerisation" .

goldbook:14338 a skos:Concept ;
    skos:definition "Semi-continuous emulsion copolymerization in which the instantaneous composition of the formed copolymer is the same as that of the added monomer mixture(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "power-feed emulsion polymerisation" .

goldbook:14339 a skos:Concept ;
    skos:definition "Emulsion polymerization with seed particles are formed in situ or added initially to the polymerizing mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seeded emulsion polymerisation" .

goldbook:14340 a skos:Concept ;
    skos:altLabel "semi-batch emulsion polymerization" ;
    skos:definition "Emulsion polymerization in which some of the ingredients are initially placed in a reactor and the remaining ingredients are added during the polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-continuous emulsion polymerisation" .

goldbook:14341 a skos:Concept ;
    skos:definition "Polymerization inside the bilayer of a vesicle leading to formation of polymer inside the bilayer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vesicle polymerisation" .

goldbook:14342 a skos:Concept ;
    skos:definition "Emulsion polymerization in which the starting system is a micro-emulsion and the final latex comprises colloidal particles of polymer dispersed in an aqueous medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micro-emulsion polymerisation" .

goldbook:14343 a skos:Concept ;
    skos:definition "Emulsion polymerization in which the starting system is a micro-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse micro-emulsion polymerisation" .

goldbook:14344 a skos:Concept ;
    skos:definition "Polymerization of a polymerizable surfactant in solution above its critical micelle concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar polymerisation" .

goldbook:14345 a skos:Concept ;
    skos:definition "Polymerization of a mini-emulsion of monomer in which all of the polymerization occurs within preexisting monomer particles without the formation of new particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mini-emulsion polymerisation" .

goldbook:14346 a skos:Concept ;
    skos:definition "Emulsion polymerization in which the starting system is a mini-emulsion and the final system is composed of an organic continuous phase with an aqueous polymer solution as the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse mini-emulsion polymerisation" .

goldbook:14347 a skos:Concept ;
    skos:definition "Polymerization in which monomer(s), initiator(s) and colloid stabilizer(s) are dissolved in a solvent and this continuous phase that is a nonsolvent for the formed polymer beyond a critical molecular weight." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitation polymerisation" .

goldbook:14348 a skos:Concept ;
    skos:definition "Precipitation polymerization in which monomer(s), initiator(s), and colloid stabilizer(s) are dissolved in a solvent forming initially a homogeneous system that produces polymer and results in the formation of polymer particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion polymerisation" .

goldbook:14349 a skos:Concept ;
    skos:definition "Dispersion polymerization in which seed particles are formed in situ or added prior to initiation of the polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seeded dispersion polymerisation" .

goldbook:14350 a skos:Concept ;
    skos:definition "Precipitation polymerization proceeding by polycondensation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitation polycondensation" .

goldbook:14351 a skos:Concept ;
    skos:definition "Dispersion polymerization proceeding by polycondensation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion polycondensation" .

goldbook:14352 a skos:Concept ;
    skos:definition "Precipitation polymerization proceeding by polyaddition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitation polyaddition" .

goldbook:14353 a skos:Concept ;
    skos:definition "Dispersion polymerization proceeding by polyaddition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion polyaddition" .

goldbook:14354 a skos:Concept ;
    skos:definition "Polymerization in which polymer is formed in monomer, or monomer-solvent droplets in a continuous phase that is a nonsolvent for both the monomer and the formed polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension polymerisation" .

goldbook:14355 a skos:Concept ;
    skos:definition "Suspension polymerization in which the diameter of the monomer droplets is of the order of a few \\(\\pu{\\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micro-suspension polymerisation" .

goldbook:14356 a skos:Concept ;
    skos:definition "Ratio of the total number of radicals in particles to the number of particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average number of radicals per particle" .

goldbook:14357 a skos:Concept ;
    skos:definition "Lowest degree of polymerization of aqueous-phase oligomer-radicals needed for irreversible capture by colloidal particles, micelles, or both during a polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical oligomer degree of polymerisation for irreversible entry" .

goldbook:14358 a skos:Concept ;
    skos:definition "Lowest degree of polymerization of oligomer-radicals that precipitate from the continuous phase during a polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical oligomer degree of polymerisation for precipitation" .

goldbook:14359 a skos:Concept ;
    skos:definition "Periods in an emulsion polymerization defined by the formation of polymer particles, and the presence or absence of monomer droplets in the polymerizing mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intervals in emulsion polymerisations" .

goldbook:14360 a skos:Concept ;
    skos:definition "Period in a batch ab initio emulsion polymerization during which the formation of particles takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interval 1 in emulsion polymerisation" .

goldbook:14361 a skos:Concept ;
    skos:definition "Period in an emulsion polymerization during which no new particles are formed and monomer droplets are present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interval 2 in emulsion polymerisation" .

goldbook:14362 a skos:Concept ;
    skos:definition "Period in an emulsion polymerization during which no new particles are formed and no monomer droplets are present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interval 3 in emulsion polymerisation" .

goldbook:14363 a skos:Concept ;
    skos:definition "Limiting behaviour in an emulsion, mini-emulsion, or micro-emulsion polymerization during which the entry of a radical into a particle that contains a growing radical results in termination before significant propagation has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero-one behaviour" .

goldbook:14364 a skos:Concept ;
    skos:definition "Zero-one behaviour wherein radicals are isolated, each being located within a different latex particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compartmentalisation behaviour" .

goldbook:14365 a skos:Concept ;
    skos:definition "Behaviour in an emulsion, mini-emulsion, micro-emulsion, suspension, or dispersion polymerization wherein the kinetics are such that the rate equations are the same as those for polymerization in bulk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-bulk behaviour" .

goldbook:14366 a skos:Concept ;
    skos:definition "Formation of primary particles as a result of micelle formation from surface-active oligomer radicals formed in a polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous micellisation nucleation" .

goldbook:14367 a skos:Concept ;
    skos:definition "Formation of primary particles as a result of polymerization within monomer-swollen micelles initiated by the capture of primary radicals or oligomer-radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar nucleation" .

goldbook:14368 a skos:Concept ;
    skos:definition "A process combining nucleation by any mechanism with subsequent coagulation being a significant event in formation of colloidally stable particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coagulative nucleation" .

goldbook:14369 a skos:Concept ;
    skos:definition "Transport of any species (radical, monomer, chain-transfer agent, etc.) from the continuous to the discrete phase and vice-versa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase-transfer event in a dispersed system" .

goldbook:14370 a skos:Concept ;
    skos:definition "Irreversible transport of a radical from the continuous to the dispersed phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical entry" .

goldbook:14371 a skos:Concept ;
    skos:altLabel "entry frequency" ;
    skos:definition "Average number of entry events per particle per unit interval of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical entry frequency" .

goldbook:14372 a skos:Concept ;
    skos:altLabel "radical desorption" ;
    skos:definition "Reversible or irreversible transport of a radical from the dispersed to the continuous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical exit" .

goldbook:14373 a skos:Concept ;
    skos:altLabel "exit frequency" ;
    skos:definition "Average number of exit events per particle per unit interval of time per radical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical exit frequency" .

goldbook:14375 a skos:Concept ;
    skos:definition "Radicals formed from an initiator molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary radical" .

goldbook:14376 a skos:Concept ;
    skos:definition "Particle in a polymer colloid that is the locus of subsequent polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seed particle" .

goldbook:14377 a skos:Concept ;
    skos:definition "Monomer with the properties of a surfactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surfmer" .

goldbook:14378 a skos:Concept ;
    skos:definition "Initiator with the properties of a surfactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inisurf" .

goldbook:14379 a skos:Concept ;
    skos:definition "Chain-transfer agent with the properties of a surfactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transurf" .

goldbook:14380 a skos:Concept ;
    skos:definition "Formation of a system with separate macrophases from an emulsion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "breaking of an emulsion" .

goldbook:14381 a skos:Concept ;
    skos:altLabel "critical coagulation amount concentration" ;
    skos:definition "Minimum concentration of electrolyte at and above which rapid coagulation occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical coagulation concentration" .

goldbook:14382 a skos:Concept ;
    skos:definition "Coagulation of particles of different kinds or sizes, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterocoagulation" .

goldbook:14383 a skos:Concept ;
    skos:definition "Coagulation of colloidal particles of the same size and kind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homocoagulation" .

goldbook:14384 a skos:Concept ;
    skos:altLabel "rapid coagulation rate" ;
    skos:definition "Rate of coagulation in the absence of any repulsive barrier between particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast coagulation rate" .

goldbook:14385 a skos:Concept ;
    skos:definition "Rate coefficient for fast coagulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast coagulation rate coefficient" .

goldbook:14387 a skos:Concept ;
    skos:definition "Rate coefficient for flocculation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flocculation rate coefficient" .

goldbook:14388 a skos:Concept ;
    skos:definition "Process in which surface-active molecules or ions aggregate into micelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellisation" .

goldbook:14389 a skos:Concept ;
    skos:definition "Coagulation due to collisions of particles induced by hydrodynamic motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orthokinetic coagulation" .

goldbook:14390 a skos:Concept ;
    skos:definition "Monolayer of particles deposited at an interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle monolayer" .

goldbook:14391 a skos:Concept ;
    skos:definition "Coagulation due to collisions of particles caused by their Brownian motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perikinetic coagulation" .

goldbook:14392 a skos:Concept ;
    skos:definition "Rate of coagulation in presence of repulsive barriers between particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slow coagulation rate" .

goldbook:14393 a skos:Concept ;
    skos:definition "Rate coefficient for slow coagulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slow coagulation rate coefficient" .

goldbook:14394 a skos:Concept ;
    skos:altLabel "Fuchs stability ratio" ;
    skos:definition "Ratio \\(W = k_{\\rm{fast}}/k_{\\rm{slow}}\\) or \\(W = k_{\\rm{fast}}/k_{\\rm{floc}}\\), for coagulation or flocculation, respectively, with \\(k_{\\rm{fast}}\\), \\(k_{\\rm{slow}}\\), and \\(k_{\\rm{floc}}\\) measured under the same mixing (or hydrodynamic) conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stability ratio" .

goldbook:14395 a skos:Concept ;
    skos:definition "System in which the particles essentially do not aggregate or sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidally stable system" .

goldbook:14396 a skos:Concept ;
    skos:definition "Stabilization of a colloid resulting from the mutual repulsion of the electrical double layers surrounding its particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrostatic stabilisation" .

goldbook:14397 a skos:Concept ;
    skos:definition "Stabilization of a colloid that has both steric and electrostatic stabilization characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrosteric stabilisation" .

goldbook:14398 a skos:Concept ;
    skos:definition "Stabilization of a colloid resulting from covering particles with a layer of molecules solvated by the continuous medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric stabilisation" .

goldbook:14399 a skos:Concept ;
    skos:definition "Study of the toxic effects of chemical and physical agents on all living organisms, especially on populations and communities within defined ecosystems; it includes transfer pathways of these agents and their interactions with the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecotoxicology" .

goldbook:14400 a skos:Concept ;
    skos:definition "Ability of a physical, chemical, or biological agent to induce (or generate) heritable changes (mutations) in the genotype in a cell as a consequence of alterations or loss of genes or chromosomes (or parts thereof)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutagenicity" .

goldbook:14401 a skos:Concept ;
    skos:definition "Particle in air of aerodynamic diameter \\(\\pu{\\lt 0.1 \\upmu m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrafine particle" .

goldbook:14402 a skos:Concept ;
    skos:definition "Study of the influence of hereditary factors on the effects of potentially toxic substances on individual organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicogenetics" .

goldbook:14403 a skos:Concept ;
    skos:definition "Ability of a physical, chemical, or biological agent to induce adverse effects in the reproductive system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive toxicity" .

goldbook:14404 a skos:Concept ;
    skos:definition "Study of the non-heritable adverse effects of substances on male and female reproductive function or capacity and on resultant progeny." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive toxicology" .

goldbook:14405 a skos:Concept ;
    skos:definition "Global term for the whole process from hazard identification to risk management." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk assessment management process" .

goldbook:14406 a skos:Concept ;
    skos:definition "Decision-making process involving considerations of political, social, economic, and engineering factors with relevant risk assessments relating to a potential hazard so as to develop, analyze, and compare regulatory options and to select the optimal regulatory response for safety from that hazard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk management" .

goldbook:14407 a skos:Concept ;
    skos:definition "Reciprocal of risk: practical certainty that injury will not result from a hazard under defined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "safety" .

goldbook:14408 a skos:Concept ;
    skos:definition "Single page giving toxicological and other safety advice, usually associated with a particular preparation, substance, process, use pattern, or exposure scenario." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "safety data sheet" .

goldbook:14409 a skos:Concept ;
    skos:definition "Ability of a physical, chemical, or biological agent to induce adverse effects in the immune system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunotoxicity" .

goldbook:14410 a skos:Concept ;
    skos:definition "Temporarily deactivated chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dormant polymer chain" .

goldbook:14411 a skos:Concept ;
    skos:definition "Deactivation of a chain carrier in a chain polymerisation, reversibly converting the active center into an inactive one and then, within the lifetime of a growing macromolecule, regenerating an active center on the same original chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible chain deactivation" .

goldbook:14412 a skos:Concept ;
    skos:altLabel "DTRP" ;
    skos:definition "Controlled reversible-deactivation radical polymerization in which the deactivation of the radicals involves degenerative transfer (DT) of a group (or atom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerate-transfer radical polymerisation" .

goldbook:14413 a skos:Concept ;
    skos:definition "Substance that enters and is retained inside a solid or semisolid matrix (absorbent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbate" .

goldbook:14414 a skos:Concept ;
    skos:definition "Solid or semisolid matrix that is able to accommodate and retain an absorbate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbent" .

goldbook:14415 a skos:Concept ;
    skos:definition "Total number of individual organisms in a population, seen over a defined period of time in a certain place.Note: For fish, an estimate of total weight may replace number. Total number of organisms per unit of habitat space seen over a defined period. Amount of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all elements in a given medium (e.g., the Earth’s crust). Amount of an isotope of an element that exists in nature, usually expressed in relative terms as a percentage of the total amount of all isotopes of the element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abundance" .

goldbook:14416 a skos:Concept ;
    skos:altLabel "abundant metal" ;
    skos:definition "Element which is of common occurrence in the Earth’s crust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abundant element" .

goldbook:14417 a skos:Concept ;
    skos:definition "Capable of being entered or reached; easy of access; such as one can go to, come into the presence of, reach, or lay hold of; get-at-able." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accessible" .

goldbook:14418 a skos:Concept ;
    skos:altLabel "acclimatation",
        "acclimation" ;
    skos:definition "Processes, including selection and adaptation, by which a population of microorganisms develops the ability to degrade a substance, or develops a tolerance to it. In experimental systems, allowing an organism to adjust to its environment prior to undertaking a study. Modification of biological processes or structures in the maintenance of homeostasis in response to change in some environmental quality such as temperature, salinity, light, radiation, or toxicant concentration. Note: It is an expression of phenotypic plasticity of individuals in response to a sublethal change in some environmental factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acclimatisation" .

goldbook:14419 a skos:Concept ;
    skos:definition "Rain, fog, snow, sleet, or other particulate matter from the atmosphere with a _000078_ below \\(\\pu{5.6}\\) deposited from the air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid precipitation" .

goldbook:14420 a skos:Concept ;
    skos:altLabel "AVS" ;
    skos:definition "Soil- and sediment-associated solid-phase sulfides extractable with cold hydrochloric acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid-volatile sulfide" .

goldbook:14421 a skos:Concept ;
    skos:definition "Of short duration, in relation to exposure or effect; the effect usually shows a rapid onset. Note 1: In regulatory toxicology, 'acute' refers to studies where dosing is either single or limited to one day although the total study duration may extend to two weeks to permit appearance of toxicity in susceptible organ systems. Note 2: In aquatic ecotoxicology, exposure of the test organisms is typically continuous and of four days or less. In clinical medicine, sudden and severe, having a rapid onset." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute" .

goldbook:14422 a skos:Concept ;
    skos:altLabel "ACR" ;
    skos:definition "Numerical dimensionless quantity that is the ratio of an acute toxicity test result (e.g., \\(\\pu{LC_{50}}\\)) to a chronic toxicity test result (e.g., maximum acceptable toxicant concentration, MATC) where both are expressed in the same units (e.g., \\(\\pu{mg L-1}\\)). Ideally, the data are for the same chemical species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute-to-chronic toxicity ratio" .

goldbook:14423 a skos:Concept ;
    skos:definition "Consequence that follows exposure to two or more physicochemical agents that act jointly but do not interact: the total effect is the simple sum of the effects of separate exposures to the agents under the same conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "additive effect" .

goldbook:14424 a skos:Concept ;
    skos:definition "Quantification of the joint action of toxicants in mixture by adding measures of their toxicity calculated in relation to the toxicity of a reference toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "additive index" .

goldbook:14425 a skos:Concept ;
    skos:altLabel "AEC" ;
    skos:definition "Index reflecting the balance of energy transfer between catabolic and anabolic processes, calculated from the equation \\[\\rm{AEC} = ([\\ce{ATP}] + ½[\\ce{ADP})/([\\ce{ATP}] + [\\ce{ADP}] + [\\ce{AMP}])\\] where \\(\\ce{ATP}\\), \\(\\ce{ADP}\\), and \\(\\ce{AMP}\\) are the amount concentrations of adenosine tri-, di-, and monophosphate, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adenylate energy charge" .

goldbook:14426 a skos:Concept ;
    skos:definition "Ratio of the amount of substance adsorbed at the interface of a condensed layer and a liquid or gaseous phase to the total amount of the substance available for adsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption factor" .

goldbook:14427 a skos:Concept ;
    skos:definition "Group of organisms of the same age within a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "age class" .

goldbook:14428 a skos:Concept ;
    skos:definition "Distribution of organisms among the various age classes present in the population. The sum of the number of individuals in all age classes equals the population size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "age composition" .

goldbook:14429 a skos:Concept ;
    skos:definition "Composition of a population in terms of how its abundance is distributed across age classes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "age distribution" .

goldbook:14430 a skos:Concept ;
    skos:altLabel "age-specific mortality",
        "age-specific number of individuals dying" ;
    skos:definition "Mean number of deaths as tabulated for a life table interval or for a specific age class in a given year, expressed per \\(\\pu{1000}\\) in that interval or age class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "age-specific death rate" .

goldbook:14431 a skos:Concept ;
    skos:definition "Error in Bayesian probability analysis of model systems resulting from the use of a single set of parameters to represent a collection of distinct entities, such as individuals, in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aggregation error" .

goldbook:14432 a skos:Concept ;
    skos:altLabel "APTI" ;
    skos:definition "Empirical index used to assess the tolerance of individual plants to contaminated air. The numerical value of \\(T_{\\rm{I}}\\) is obtained by combining various quantities according to the recipe \\([A (T + P) + R]/10\\), where \\(A\\) is the mass of ascorbic acid divided by the dry mass of a leaf, expressed as \\(\\pu{mg/g}\\), \\(T\\) is the total mass of chlorophyll divided by the fresh mass, expressed as \\(\\pu{mg/g}\\), \\(P\\) is the pH of a leaf extract, and \\(R\\) is the mass of water in the leaf divided by the wet mass, expressed as percent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air pollution tolerance index" .

goldbook:14433 a skos:Concept ;
    skos:definition "Any of various chiefly aquatic, eukaryotic, photosynthetic organisms, ranging in size from single-celled forms to the giant kelp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alga" .

goldbook:14434 a skos:Concept ;
    skos:definition "Rapid increase in the abundance of phytoplankton or benthic algae in a given area, often as a result of an increased availability of nutrients or light, or increase in temperature (e.g., the spring bloom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "algal bloom" .

goldbook:14435 a skos:Concept ;
    skos:definition "Substance intended to kill algae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "algicide" .

goldbook:14436 a skos:Concept ;
    skos:definition "Inhibiting algal population growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "algistatic" .

goldbook:14437 a skos:Concept ;
    skos:definition "Sequential appearance of species driven by external influences that alter local conditions; e.g., silt deposits changing a marshland to woodland." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allogenic succession" .

goldbook:14438 a skos:Concept ;
    skos:definition "Surrounding (applied to environmental media such as air, water, sediment, or soil)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambient" .

goldbook:14439 a skos:Concept ;
    skos:definition "Continuous or repeated measurement of agents in the environment to evaluate ambient exposure and health risk by comparison with appropriate reference values based on knowledge of the probable relationship between exposure and resultant adverse health effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambient monitoring" .

goldbook:14440 a skos:Concept ;
    skos:definition "Showing anadromy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anadromous" .

goldbook:14441 a skos:Concept ;
    skos:definition "Life-history pattern that is characterized by egg incubation and early juvenile development in freshwater, migration to seawater for adult development, and a return to freshwater for spawning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anadromy" .

goldbook:14442 a skos:Concept ;
    skos:definition "Scheme that defines the exact format and design of the assessment, explicitly states the data needed, and describes the methods and design for analyzing these data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analysis plan" .

goldbook:14443 a skos:Concept ;
    skos:definition "Caused by or influenced by human activities. Describing a conversion factor used to calculate a dose or concentration affecting a human that has been derived from data obtained with another species, e.g., the rat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anthropogenic" .

goldbook:14444 a skos:Concept ;
    skos:definition "Quality of a population of bilaterally symmetrical individuals in which the difference in measurement of a trait made from the right and left sides of individuals from that population produces a bimodal distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antisymmetry" .

goldbook:14445 a skos:Concept ;
    skos:definition "\\(\\arcsin \\sqrt{P}\\), where \\(P\\) is the value of a measured effect, e.g., the proportion of exposed organisms in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arcsine square root transformation" .

goldbook:14446 a skos:Concept ;
    skos:definition "Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by adding the earthworms to an artificial soil made of sand, clay mineral, and peat, containing the substance of concern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial soil test" .

goldbook:14447 a skos:Concept ;
    skos:definition "Test with earthworms in which the toxicity of a substance by skin and gut uptake is determined by placing the worms in an artificial substrate consisting of silica, water, and glass balls, containing the substance of concern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artisol test" .

goldbook:14448 a skos:Concept ;
    skos:altLabel "AHH",
        "unspecific mono-oxygenase" ;
    skos:definition "Enzyme activity attributed to cytochrome P-450 monooxygenase isoforms and often measured in units of benzo[a]pyrene hydroxylation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aryl hydrocarbon hydroxylase" .

goldbook:14449 a skos:Concept ;
    skos:altLabel "ALARA" ;
    skos:definition "Describing the situation in which everything practicable is done to reduce risks to the minimum with the approval of the regulatory authorities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "as low as reasonably achievable" .

goldbook:14450 a skos:Concept ;
    skos:definition "Set of coexisting populations defined by phylogeny, location, or life style. Assemblages are intermediate between populations and communities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assemblage" .

goldbook:14451 a skos:Concept ;
    skos:definition "Ecological property that is to be protected and the precise parameter to be measured for this property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assessment endpoint" .

goldbook:14452 a skos:Concept ;
    skos:altLabel "AFNOR test" ;
    skos:definition "Commercially available test kit, certified by AFNOR as valid and equivalent to a standardized method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Association Française de Normalisation test" .

goldbook:14453 a skos:Concept ;
    skos:altLabel "ATCN" ;
    skos:definition "Concentration of a chemical at which some percentage of a population of test organisms is in a state of approximate homeostasis for a prolonged period of time (\\(\\pu{48 h}\\) or more)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymptotic threshold concentration" .

goldbook:14454 a skos:Concept ;
    skos:altLabel "deposition" ;
    skos:definition "Process that transfers a chemical from the atmosphere to the Earth’s surface (land, water, or vegetation) by either dry impingement or by transport in rain or snow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmospheric deposition" .

goldbook:14456 a skos:Concept ;
    skos:definition "Floral and (or) or faunal communities attached to submerged surfaces in aquatic ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aufwuchs" .

goldbook:14457 a skos:Concept ;
    skos:definition "Sequential appearance of species driven by processes operating within the community environment (compare allogenic succession), e.g., primary and secondary successions that occur on newly exposed land." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autogenic succession" .

goldbook:14458 a skos:Concept ;
    skos:definition "Organism that is independent of outside sources for organic food materials and manufactures its own organic material from inorganic sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autotroph" .

goldbook:14459 a skos:Concept ;
    skos:definition "Sequential appearance of species in a location principally involving plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autotrophic succession" .

goldbook:14460 a skos:Concept ;
    skos:definition "Growth of organisms of a single species in the absence of cells or living organisms of any other species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axenic culture" .

goldbook:14461 a skos:Concept ;
    skos:definition "General, nonspecific, reversible mode of toxic action that can be produced in most living organisms by the presence of sufficient amounts of many organic chemicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "baseline toxicity" .

goldbook:14462 a skos:Concept ;
    skos:definition "Attributed to Thomas Bayes (1702–1761), English mathematician. The term is used to designate concepts relating to inverse probability, especially Bayes’ theorem, a theorem expressing the probability of one of a number of mutually exclusive events \\(H_{\\rm{i}}\\), given some other event \\(E\\), in terms of the probabilities of all the \\(H_{\\rm{i}}\\) independently of \\(E\\) and the probabilities of \\(E\\) given each \\(H_{\\rm{i}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bayesian" .

goldbook:14463 a skos:Concept ;
    skos:definition "Subjective or objective concept of probability as a 'measure of the state of knowledge'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bayesian probability" .

goldbook:14464 a skos:Concept ;
    skos:definition "Study of behavioral abnormalities in otherwise apparently normal individuals after exposure in the embryonic state to a substance or physical agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "behavioural teratology" .

goldbook:14465 a skos:Concept ;
    skos:definition "Study of abnormal behavior produced by exposure to a substance or physical agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "behavioural toxicology" .

goldbook:14466 a skos:Concept ;
    skos:definition "Non-essential metal which in some form (chemical species) at an appropriate dose can improve health of defined organisms, commonly human beings." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beneficial metal" .

goldbook:14467 a skos:Concept ;
    skos:definition "Advantage to, or improvement in condition of, an individual, a population, a species, an assemblage, a community, or an ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benefit" .

goldbook:14468 a skos:Concept ;
    skos:definition "Living on the bottom of an aquatic system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benthic" .

goldbook:14469 a skos:Concept ;
    skos:definition "Able to come in contact with a living organism and perhaps interact with it with the possibility of absorption into the organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioaccessible" .

goldbook:14470 a skos:Concept ;
    skos:altLabel "accumulation in biology" ;
    skos:definition "Progressive increase in the amount of a substance in an organism or part of an organism that occurs because the rate of intake from all contributing sources and by all possible routes exceeds the organism’s ability to eliminate the substance from its body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioaccumulation" .

goldbook:14471 a skos:Concept ;
    skos:altLabel "accumulation factor" ;
    skos:definition "Ratio of tissue chemical residue to chemical concentration in an external environmental phase (e.g., sediment, water, soil, air, or food). BAF is measured at a steady state in situations where organisms are exposed to multiple sources (e.g., water, sediment, food), unless noted otherwise." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioaccumulation factor" .

goldbook:14472 a skos:Concept ;
    skos:altLabel "activation" ;
    skos:definition "Metabolic conversion of a xenobiotic to a more toxic derivative or to one that has more of an effect on living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioactivation" .

goldbook:14473 a skos:Concept ;
    skos:altLabel "available" ;
    skos:definition "Able to be absorbed by living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioavailable" .

goldbook:14474 a skos:Concept ;
    skos:altLabel "biocoenosis",
        "biological community",
        "biotic community",
        "ecological community" ;
    skos:definition "All the interacting organisms living together in a specified habitat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biocenosis" .

goldbook:14475 a skos:Concept ;
    skos:definition "Substance intended to kill living organisms. Nonagricultural pesticide used to control the severity and incidence of pests or diseases, e.g., algicide, slimicide, or disinfectant for the control of algal, fungal, or bacterial growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biocide" .

goldbook:14476 a skos:Concept ;
    skos:definition "Process leading to a higher concentration of a substance in an organism than in environmental media to which it is exposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioconcentration" .

goldbook:14477 a skos:Concept ;
    skos:altLabel "BCF" ;
    skos:definition "Measure of the tendency for a substance in water to accumulate in aquatic organisms defined as the ratio of the concentration of the substance of concern in the organism to the concentration in water at equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioconcentration factor" .

goldbook:14478 a skos:Concept ;
    skos:definition "Ratio of the concentration of the substance of concern in the lipid fraction of the test organism to the concentration in the ambient water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid-based bioconcentration factor" .

goldbook:14479 a skos:Concept ;
    skos:definition "Occurrence of a number of species within a given ecosystem or biome, or the presence of a number of community types in a given area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodiversity" .

goldbook:14480 a skos:Concept ;
    skos:altLabel "BAP" ;
    skos:definition "Internationally recognized program designed to protect and restore biological systems containing threatened species and habitats." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodiversity action plan" .

goldbook:14481 a skos:Concept ;
    skos:definition "Movement of elements or molecules among organisms and nonliving compartments of the atmosphere, lithosphere, and hydrosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biogeochemical cycle" .

goldbook:14482 a skos:Concept ;
    skos:altLabel "bioindicator",
        "indicator species" ;
    skos:definition "Any biological species or group of species whose performance, abundance, or population status is used to determine the health of an environment or ecosystem by systematic monitoring of chemical, physiological, or behavioral changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological indicator" .

goldbook:14483 a skos:Concept ;
    skos:definition "Property of living organisms that affects human or environmental health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological determinant" .

goldbook:14484 a skos:Concept ;
    skos:altLabel "bioamplification",
        "ecological magnification",
        "trophic enrichment" ;
    skos:definition "Sequence of processes by which higher concentrations of a substance are attained in organisms at higher trophic levels. Result of these processes of bioconcentration and bioaccumulation by which tissue concentrations of bioaccumulated chemicals increase as the chemical passes up through two or more trophic levels. Note: Biomagnification occurs in a food chain as a consequence of efficient transfer of a substance from food to consumer accompanied by the lack of, or very slow, excretion or degradation of the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomagnification" .

goldbook:14485 a skos:Concept ;
    skos:definition "Ratio of concentrations of a compound at two consecutive trophic levels at steady state. It can also be expressed in terms of a rate constant-based bioaccumulation model \\[B = C_{n}/C_{n-1} = \\alpha f/k_{\\rm{e}}\\] where \\(\\alpha\\) is assimilation efficiency, \\(f\\) is feeding rate, and \\(k_{\\rm{e}}\\) is the first-order elimination constant. \\(B\\) can be calculated from field data on assumed trophic relations or from laboratory feeding experiments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomagnification factor" .

goldbook:14486 a skos:Concept ;
    skos:altLabel "effect biomarker" ;
    skos:definition "Biomarker that, depending upon the magnitude, can be recognized as associated with an established or possible health impairment or disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomarker of effect" .

goldbook:14487 a skos:Concept ;
    skos:altLabel "exposure biomarker" ;
    skos:definition "Biomarker that relates exposure to a xenobiotic to the levels of the substance or its metabolite, or of the product of an interaction between the substance and some target molecule or cell, that can be measured in a compartment within an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomarker of exposure" .

goldbook:14488 a skos:Concept ;
    skos:altLabel "susceptibility biomarker" ;
    skos:definition "Biomarker of an inherent or acquired ability of an organism to respond to exposure to a specific substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomarker of susceptibility" .

goldbook:14489 a skos:Concept ;
    skos:definition "Set of plants and animals that occupy a certain geographic area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biome" .

goldbook:14490 a skos:Concept ;
    skos:definition "Alteration of the chemical or physical properties of a substance by the action of living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomodification" .

goldbook:14491 a skos:Concept ;
    skos:definition "n. Organism that provides quantitative information on the quality of the environment around it.Note: The ideal substance biomonitor would indicate the presence of a specific pollutant and provide additional information about the amount present. v. To use organisms to monitor pollutants and to deduce possible effects on biota or routes of toxicant exposure to humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomonitor" .

goldbook:14492 a skos:Concept ;
    skos:definition "Determination of community changes along a gradient or among sites differing in levels of pollution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomonitoring type 1" .

goldbook:14493 a skos:Concept ;
    skos:definition "Determination of bioaccumulation in organisms among sites notionally varying in the level of contamination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomonitoring type 2" .

goldbook:14494 a skos:Concept ;
    skos:definition "Determination of effects on organisms using tools such as biochemical markers in sentinel species or some measure of diminished fitness or condition of individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomonitoring type 3" .

goldbook:14495 a skos:Concept ;
    skos:definition "Determination of genetically based resistance in populations of contaminated areas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomonitoring type 4" .

goldbook:14496 a skos:Concept ;
    skos:definition "Biological agent with pesticidal activity, e.g., the bacterium Bacillus thuringiensis when used to kill insects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biopesticide" .

goldbook:14497 a skos:Concept ;
    skos:definition "Use of biological organisms such as plants or microbes to aid in removing hazardous substances from an area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioremediation" .

goldbook:14498 a skos:Concept ;
    skos:altLabel "BSAF",
        "accumulation factor (AF)",
        "bioavailability index (BI)",
        "biota-sediment factor (BSF)" ;
    skos:definition "Ratio of lipid-normalized tissue chemical residue to carbon-normalized sediment substance concentration (units of mass lipid/mass organic carbon)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biota-sediment accumulation factor" .

goldbook:14499 a skos:Concept ;
    skos:definition "One of several ranking systems calculated from the presence or abundance of sensitive species relative to tolerant species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotic index" .

goldbook:14500 a skos:Concept ;
    skos:definition "Component of a living organism to which an ion or other substance in aqueous solution can bind, usually with subsequent beneficial or harmful effect on the physiology of the organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotic ligand" .

goldbook:14501 a skos:Concept ;
    skos:altLabel "BLM" ;
    skos:definition "Model that integrates the interactions of metals with ligands in water to calculate the speciation (based on hardness, salinity, and presence of other metals) and the concentration of ionic species producing toxicity. The BLM chemically and mathematically models the organism’s target site as ligand(s) competing with nonbiotic ligands, based on the concept that toxicity occurs when a metal-(biotic ligand) complex reaches a critical concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotic ligand model" .

goldbook:14502 a skos:Concept ;
    skos:definition "Weighted measurement of organisms present—the weighted part is determined by each group’s pollution tolerance or intolerance. As pollution increases in a stream, the biotic score value tends to increase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotic score" .

goldbook:14503 a skos:Concept ;
    skos:definition "Habitat shared by many species, most often an area that is uniform in environmental conditions and in its distribution of animal and plant life." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotope" .

goldbook:14504 a skos:Concept ;
    skos:definition "Group of processes whereby organisms affect the structure of sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioturbation" .

goldbook:14505 a skos:Concept ;
    skos:definition "Model of adverse effect vs. dose relationship that, owing to hormesis, dips down from the control level before increasing with the dose; individuals exposed to low, but nontoxic concentrations are healthier than individuals not exposed to the chemical.Note: Biphasic dose–effect curves occur for any nutrient. Hormesis is a phenomenon associated with compounds that have no nutrient properties. Model of adverse effect vs. dose relationship that changes slope owing to a change in the mechanism of toxic action.Note: This may, e.g., be due to saturation of a transport or metabolic system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biphasic dose–effect model" .

goldbook:14506 a skos:Concept ;
    skos:definition "(in demography) Number of live births in a defined administrative jurisdiction in a calendar year divided by a midyear population of the jurisdiction, with the customary multiplier of \\(\\pu{1000}\\) to produce a whole number rather than a decimal or a fraction. Note: An alternative statistic is total fertility rate, the average number of children born to each woman over the course of her life. In general, the total fertility rate is a better indicator of fertility rates because, unlike the crude birth rate, it is not affected by the age distribution of the population. (in ecology) Number of births, \\(B\\), in a population of a defined size, \\(N\\), during a specified time interval \\(\\Delta t\\). The rate is calculated from the formula \\[B = \\Delta N/\\Delta t\\] where \\(\\Delta N\\) is the change in the number of births in a limited time period \\(\\Delta t\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "birth rate" .

goldbook:14507 a skos:Concept ;
    skos:definition "Delayed damage from earlier environmental contamination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boomerang effect" .

goldbook:14508 a skos:Concept ;
    skos:definition "Metal ions intermediate in properties between class a and class b metal ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "borderline metal ions" .

goldbook:14509 a skos:Concept ;
    skos:definition "Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at the suborganismal (cellular and biochemical) levels of organization rather than via the community and (or) ecosystem levels of organization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bottom-up ecotoxicological study" .

goldbook:14510 a skos:Concept ;
    skos:definition "Quantitative value for community species diversity calculated as \\[H_{\\rm{B}} = (\\ln N! - \\sum \\ln n_{i}!)/N\\] where \\(N\\) is the total number of individuals and \\(n_{i}\\) is the number of individuals in the \\(i^{\\rm{th}}\\) species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brillouin index" .

goldbook:14511 a skos:Concept ;
    skos:definition "Adult fish producing either eggs or sperm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "broodstock" .

goldbook:14512 a skos:Concept ;
    skos:definition "Any pathological condition characterized by the deposition of calcium salts in tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calcinosis" .

goldbook:14513 a skos:Concept ;
    skos:definition "Tissue such as arthropod cuticle, bivalve shell, or vertebrate bone that renders calcium or elements with similar biological behavior (such as lead or cadmium) less bioavailable during trophic interactions, thus providing a mechanism for trophic dilution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calcium sink" .

goldbook:14514 a skos:Concept ;
    skos:definition "Maximum population size expressed as total number of individuals, biomass, or population density that a given unit of habitat is capable of sustaining." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrying capacity" .

goldbook:14515 a skos:Concept ;
    skos:definition "Describing a species exhibiting catadromy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catadromous" .

goldbook:14516 a skos:Concept ;
    skos:definition "Life-history pattern that is characterized by egg incubation and early juvenile development in seawater, migration to freshwater for adult development, and return to seawater for spawning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catadromy" .

goldbook:14517 a skos:Concept ;
    skos:definition "Long-term geochemical alteration to organic matter, involving high temperatures and pressures deep below the surface of the Earth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catagenesis" .

goldbook:14518 a skos:Concept ;
    skos:definition "Whales, dolphins, and porpoises, in the order Cetacea." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cetaceans" .

goldbook:14519 a skos:Concept ;
    skos:definition "Series of reactions by which ozone is formed in the stratosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Chapman mechanism" .

goldbook:14520 a skos:Concept ;
    skos:definition "Substance or substances in a component of the environment which are not currently bioavailable but which may become bioavailable at an unknown time in the future with harmful consequences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical time bomb" .

goldbook:14521 a skos:Concept ;
    skos:definition "Specialized cell with a role in ion regulation, characterized by large numbers of mitochondria, an extensive intracellular tubular network and a high concentration of \\(\\ce{Na+}\\)/\\(\\ce{K+}\\) ATPase. This cell is found in salt-secreting glands like the rectal gland of elasmobranchs, the nasal gland of seabirds, and the gills of both seawater and freshwater fish, mainly on the primary lamellae but also on the secondary lamellae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chloride cell" .

goldbook:14522 a skos:Concept ;
    skos:definition "Proportion by mass of dissolved chloride ions in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chlorinity" .

goldbook:14523 a skos:Concept ;
    skos:altLabel "CFC" ;
    skos:definition "Carbon-based chemical containing chlorine and fluorine, responsible for ozone depletion in the stratosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chlorofluorocarbon" .

goldbook:14524 a skos:Concept ;
    skos:altLabel "long-term effect" ;
    skos:definition "Consequence that develops slowly and (or) has a long-lasting course: may be applied to an effect which develops rapidly and is long lasting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic effect" .

goldbook:14525 a skos:Concept ;
    skos:definition "Loss of green color in plants owing to the lack of production or the destruction of chlorophyll." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chlorosis" .

goldbook:14526 a skos:Concept ;
    skos:definition "Systematic classification of groups of organisms on the basis of shared characteristics thought to derive from a common ancestor. Also, the study of the branching of evolutionary lines of descent and the relationship between branches." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cladistics" .

goldbook:14527 a skos:Concept ;
    skos:altLabel "evolutionary tree",
        "phylogenetic tree" ;
    skos:definition "Dendrogram illustrating the supposed evolutionary relationships between clades; a diagram showing cladistic relationships." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cladogram" .

goldbook:14528 a skos:Concept ;
    skos:definition "Community of plants and animals in a steady state due to ecological succession resulting in a composition of the community best adapted to average conditions in the area. The term is sometimes applied to soil development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "climax community" .

goldbook:14529 a skos:Concept ;
    skos:definition "Theory that pollutants with high vapor pressure, e.g., mercury or persistent organic pollutants (POPs), in the air will condense onto soil, water, and biota at cool temperatures. Consequently, the ratios for POP concentrations in the air and on condensed phases decrease as one moves from warmer to cooler climates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cold condensation theory" .

goldbook:14530 a skos:Concept ;
    skos:definition "Microbial transformation of a compound (that is normally unable to support cell replication) in the requisite presence of a transformable cosubstrate that supports cell replication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cometabolism" .

goldbook:14531 a skos:Concept ;
    skos:altLabel "biocommunity" ;
    skos:definition "Assembly of populations of different species of living organisms, usually interdependent on and interacting with each other, within a specified location in space and time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "community" .

goldbook:14532 a skos:Concept ;
    skos:definition "Hypothesis that ecological communities retain information about events in their history and will not return to their original state after perturbation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "community conditioning hypothesis" .

goldbook:14533 a skos:Concept ;
    skos:definition "Tendency of a community to return to its original state after a disturbance (competition, temporarily changing environment, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "community stability" .

goldbook:14534 a skos:Concept ;
    skos:altLabel "ecological resilience" ;
    skos:definition "Ability of a community to return to its former state after perturbation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "community resilience" .

goldbook:14535 a skos:Concept ;
    skos:definition "Ability of a community to avoid displacement from its present state by a disturbance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "community resistance" .

goldbook:14536 a skos:Concept ;
    skos:definition "Species present in a community and their relative abundances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "community structure" .

goldbook:14537 a skos:Concept ;
    skos:definition "Conceptualized part of the body (organs, tissues, cells, or fluids) considered as an independent system for purposes of modeling and assessment of distribution and clearance of a substance. Part of an ecosystem considered as an independent system for purposes of assessment of uptake, distribution, and dissipation of a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compartment" .

goldbook:14538 a skos:Concept ;
    skos:definition "Outcompetition from a niche of one species by another that uses the available resources of the niche more efficiently, eventually resulting in the exclusion of the outcompeted species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competitive exclusion" .

goldbook:14539 a skos:Concept ;
    skos:definition "Niches where coexisting species occupy a similar position along one niche dimension, e.g., altitude, but differ along another, e.g., diet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complimentary niches" .

goldbook:14540 a skos:Concept ;
    skos:altLabel "exposure–response curve" ;
    skos:definition "Graph of the relation between exposure concentration and the proportion of individuals in a population responding with a defined effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration–response curve" .

goldbook:14541 a skos:Concept ;
    skos:definition "Linkage and interrelationship of assessment endpoint(s) and stressors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conceptual model" .

goldbook:14542 a skos:Concept ;
    skos:definition "Figure showing pathways of exposure of organisms and illustrating areas of uncertainty or concern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conceptual model diagram" .

goldbook:14543 a skos:Concept ;
    skos:altLabel "CSM" ;
    skos:definition "Integration of information on contaminants of potential concern (COPCs), ecological resources, evaluated exposure routes, fate and transport mechanisms, evaluated COPC toxicity, identified assessment endpoints, and risk questions and hypotheses, into a description of all that is known and (or) expected about a contaminated site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conceptual site model" .

goldbook:14544 a skos:Concept ;
    skos:definition "State of health determining potential for reproduction and growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condition" .

goldbook:14545 a skos:Concept ;
    skos:definition "Parameter used to describe growth in fish. It reflects real growth and nutritional status better than simple measurement of body mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condition factor" .

goldbook:14546 a skos:Concept ;
    skos:definition "Any quantitative measure of the condition in relation to a defined baseline." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condition index" .

goldbook:14547 a skos:Concept ;
    skos:definition "Science applied to the conservation of genes, populations, species, and ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conservation biology" .

goldbook:14548 a skos:Concept ;
    skos:definition "Science of analyzing and protecting the Earth’s biological diversity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conservation ecology" .

goldbook:14549 a skos:Concept ;
    skos:definition "Minor impurity present in a substance. Extraneous material inadvertently added to a sample prior to or during chemical or biological analysis. In some contexts, as in relation to gas cleaning equipment, used as a synonym for 'pollutant', especially on a small scale. Unintended component in food that may pose a hazard to the consumer. Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium, even without adverse effects being observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contaminant" .

goldbook:14550 a skos:Concept ;
    skos:definition "Change that can be measured on a continuum from zero (or even a negative value) to positive values such as growth and reproduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous effect" .

goldbook:14551 a skos:Concept ;
    skos:definition "Treatment in a toxicity test that duplicates all the conditions of the exposure treatments but contains no test material, in order to determine the absence of toxicity under basic test conditions (e.g., health of test organisms, quality of dilution water)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "control" .

goldbook:14552 a skos:Concept ;
    skos:definition "Cometabolism whereby growing microorganisms oxidize a compound without using either carbon or energy derived from the oxidation of that compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cooxidation" .

goldbook:14553 a skos:Concept ;
    skos:definition "Minute marine or freshwater crustacean, usually having six pairs of limbs on the thorax; some are abundant in plankton and others are parasitic on fish, marine mammals, and macro-invertebrates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copepod" .

goldbook:14554 a skos:Concept ;
    skos:definition "n. Substance having the capability or tendency to cause slow destruction. adj. Gradually destructive; steadily harmful." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrosive" .

goldbook:14555 a skos:Concept ;
    skos:altLabel "CBA" ;
    skos:definition "Procedure for determining the relationship of the expected benefits of a proposed action to the expected costs in order to decide whether the action provides the best option for the investment of limited resources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cost–benefit analysis" .

goldbook:14556 a skos:Concept ;
    skos:definition "Procedure for determining whether the expected beneficial effects of a defined course of action justify the cost when selecting among competing options for the use of limited resources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cost-effectiveness analysis" .

goldbook:14557 a skos:Concept ;
    skos:altLabel "gill purge" ;
    skos:definition "Abrupt, periodic reversal of water flow over the gills that dislodges and eliminates excess mucus from the gills’ surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cough" .

goldbook:14558 a skos:Concept ;
    skos:altLabel "CBR" ;
    skos:definition "Whole-body concentration of a chemical that is associated with a given adverse biological response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical body residue" .

goldbook:14559 a skos:Concept ;
    skos:definition "Toxicity testing focused on the species life stage thought to be the most sensitive to the toxicant, such as newly hatched individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical life-stage testing" .

goldbook:14560 a skos:Concept ;
    skos:altLabel "cotolerance" ;
    skos:definition "Condition in which enhanced tolerance to one toxicant also enhances tolerance to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-resistance" .

goldbook:14561 a skos:Concept ;
    skos:definition "n. Stock of healthy cells, tissue, microorganisms, or plants raised under well-defined and controlled conditions. v. To maintain a stock of healthy organisms under well-defined and controlled conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "culture" .

goldbook:14562 a skos:Concept ;
    skos:definition "Total dose resulting from repeated exposures or continuous exposure over a defined time to a substance or to radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative dose" .

goldbook:14563 a skos:Concept ;
    skos:definition "Total exposure resulting from repeated and continuous exposure over a defined time to a substance or to radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative exposure" .

goldbook:14564 a skos:Concept ;
    skos:definition "Small, mostly planktonic, crustaceans, between \\(\\pu{0.2 mm}\\) and \\(\\pu{5 mm}\\) in length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Daphnia" .

goldbook:14565 a skos:Concept ;
    skos:definition "Substance formed by a microbe’s metabolism of a substrate (most often during cometabolism) that cannot be further metabolized by that organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead-end metabolite" .

goldbook:14566 a skos:Concept ;
    skos:definition "In assessing population ecology, death of an individual is loss of the ability to reproduce." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "death" .

goldbook:14567 a skos:Concept ;
    skos:definition "Irreversible cessation of all vital functions of an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "death" .

goldbook:14568 a skos:Concept ;
    skos:definition "Number of deaths \\(D\\) in a closed population of size \\(N\\) during a specified time interval, \\(\\Delta t\\). The rate is calculated from the formula \\[D = -\\Delta N/\\Delta t\\] where \\(\\Delta N\\) is the change in number of deaths over a specified time period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "death rate" .

goldbook:14569 a skos:Concept ;
    skos:definition "Chlorinated water (usually municipal drinking water) that has been treated to remove chlorine and chlorinated compounds from solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dechlorinated water" .

goldbook:14570 a skos:Concept ;
    skos:definition "Organism that breaks down dead matter or wastes of other organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decomposer" .

goldbook:14571 a skos:Concept ;
    skos:definition "Substance used for removal of leaves by its toxic action on living plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "defoliant" .

goldbook:14572 a skos:Concept ;
    skos:definition "Variability in population growth rates arising from random differences among individuals in survival and reproduction within a season." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "demographic stochasticity" .

goldbook:14573 a skos:Concept ;
    skos:definition "Study of populations, especially their age structure and growth rates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "demography" .

goldbook:14574 a skos:Concept ;
    skos:definition "Variation in characteristics of individuals or of a population produced by changes in the density of the population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "density dependence" .

goldbook:14575 a skos:Concept ;
    skos:definition "Animal that feeds on particles of matter in the soil or sediment, usually the top soil or sediment where it is filled with organic matter. Feeding takes place either by ingesting soil or sediment or by trapping particles as they fall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deposit feeder" .

goldbook:14576 a skos:Concept ;
    skos:altLabel "depuration time" ;
    skos:definition "Loss of a substance from an organism owing to elimination and degradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depuration" .

goldbook:14577 a skos:Concept ;
    skos:definition "Predicted property of a substance that is dependent upon, or is an approximation of, a fundamental property and the prevailing environmental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derived characteristic" .

goldbook:14578 a skos:Concept ;
    skos:definition "Term applied to effects, of which the extent varies with the dose and for which a threshold is believed to exist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deterministic" .

goldbook:14579 a skos:Concept ;
    skos:definition "Detailed study in which all population and environmental parameters are assumed to be constant and accurately specified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deterministic analysis" .

goldbook:14580 a skos:Concept ;
    skos:definition "Mathematical model that is fully specified and does not include a stochastic component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deterministic model" .

goldbook:14581 a skos:Concept ;
    skos:definition "Organic debris from decomposing plants and animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detritus" .

goldbook:14582 a skos:Concept ;
    skos:definition "Describing an organism that survives by eating detritus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detrivorous" .

goldbook:14583 a skos:Concept ;
    skos:definition "Reference dose determined for developmental consequences of a single, maternal exposure during development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental reference dose" .

goldbook:14584 a skos:Concept ;
    skos:definition "Potential of an organism to develop into a consistent phenotype in an environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental stability" .

goldbook:14585 a skos:Concept ;
    skos:definition "Member of a major group of eukaryotic algae, among the most common types of phytoplankton. Unicellular, some form chains or simple colonies. Diatom cells are encased in a frustule, of widely diverse form, made of silica (hydrated silicon dioxide)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diatom" .

goldbook:14586 a skos:Concept ;
    skos:definition "Release into the environment from multiple sources covering a wide area as opposed to point source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuse source" .

goldbook:14587 a skos:Concept ;
    skos:definition "Belief that pollution is alleviated by dilution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilution paradigm" .

goldbook:14588 a skos:Concept ;
    skos:altLabel "diluent" ;
    skos:definition "Water used to dilute the test material in an aquatic toxicity test in order to prepare either different concentrations of a test chemical or different percentages of an effluent for the various test treatments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilution water" .

goldbook:14589 a skos:Concept ;
    skos:definition "Effect where a stressor acts immediately on an ecological component of interest and not through the consequences of effects on other components of the ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct ecological effect" .

goldbook:14590 a skos:Concept ;
    skos:definition "Deviation within a population from a mean of zero for the difference between a trait measured from the right and left sides of bilaterally symmetrical individuals from that population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "directional asymmetry" .

goldbook:14591 a skos:Concept ;
    skos:definition "Toxicity that results from, and is readily attributable to, substances acting at the sites of toxic action in and (or) on the exposed organisms that are exhibiting the adverse biological response in question." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct toxicity" .

goldbook:14592 a skos:Concept ;
    skos:definition "Release of any waste into the environment from a point source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discharge" .

goldbook:14593 a skos:Concept ;
    skos:altLabel "discrimination factor" ;
    skos:definition "Ratio measuring the degree of isotopic discrimination, with a ratio of 1 indicating no discrimination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discrimination ratio" .

goldbook:14594 a skos:Concept ;
    skos:definition "Substance used to disperse liquid spills, e.g., oil spills in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersant" .

goldbook:14595 a skos:Concept ;
    skos:altLabel "DOC" ;
    skos:definition "Amount concentration of carbon found dissolved in water samples from aquatic systems, measured as total elemental carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolved organic carbon" .

goldbook:14596 a skos:Concept ;
    skos:altLabel "DOC" ;
    skos:definition "Amount concentration of oxygen dissolved in water at a particular temperature and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolved oxygen content" .

goldbook:14597 a skos:Concept ;
    skos:altLabel "DOM" ;
    skos:definition "Analogous to dissolved organic carbon, but refers to the entire organic pool dissolved in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolved organic matter" .

goldbook:14598 a skos:Concept ;
    skos:definition "Event that introduces, removes, or redistributes organisms, changing the colonization potential of a given environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disturbance" .

goldbook:14599 a skos:Concept ;
    skos:definition "Mathematical descriptor of species variation within a community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diversity index" .

goldbook:14600 a skos:Concept ;
    skos:definition "Relation between dose and the magnitude of a measured biological change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose–effect" .

goldbook:14601 a skos:Concept ;
    skos:definition "Graph of the relation between dose and the magnitude of the biological change produced measured in appropriate units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose–effect curve" .

goldbook:14602 a skos:Concept ;
    skos:definition "Association between dose and the resulting magnitude of a continuously graded change, either in an individual or in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose–effect relationship" .

goldbook:14603 a skos:Concept ;
    skos:definition "Graph of the relation between dose and the proportion of individuals in a population responding with a defined biological effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose–response curve" .

goldbook:14604 a skos:Concept ;
    skos:definition "Association between dose and the incidence of a defined biological effect in an exposed population usually expressed as percentage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose–response relationship" .

goldbook:14605 a skos:Concept ;
    skos:altLabel "catchment",
        "catchment area",
        "catchment basin",
        "drainage area",
        "river basin",
        "water basin",
        "watershed" ;
    skos:definition "Area of land where water from rain or snow melt drains downhill into a body of water, such as a river, lake, dam, estuary, wetland, sea, or ocean." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drainage basin" .

goldbook:14606 a skos:Concept ;
    skos:altLabel "DEB",
        "DEB theory" ;
    skos:definition "Theory that simple quantitative rules may be applied to define the organization of metabolism of individual organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic energy budget theory" .

goldbook:14607 a skos:Concept ;
    skos:definition "Community that is stable for only a very limited range of environmental characteristics, e.g., a stable and predictable environment with respect to predator–prey ratios or disturbances caused by humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamically fragile community" .

goldbook:14608 a skos:Concept ;
    skos:definition "Community that is stable within a wide range of conditions, e.g., in very variable and unpredictable environments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamically robust community" .

goldbook:14609 a skos:Concept ;
    skos:definition "Hypothesis that long food chains are less stable than short food chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic stability hypothesis" .

goldbook:14610 a skos:Concept ;
    skos:definition "Branch of biology that studies the interactions between living organisms and all factors (including other organisms) in their environment. Such interactions encompass environmental factors that determine the distributions of living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecology" .

goldbook:14611 a skos:Concept ;
    skos:definition "Sum of biological, physical, and chemical components of an ecosystem and their interactions that maintain the ecosystem and its products, functions, and attributes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecological character" .

goldbook:14612 a skos:Concept ;
    skos:definition "Study of the flow of energy within an ecological system from the time the energy enters the living system until it is irretrievably lost from the system as heat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecological energetics" .

goldbook:14613 a skos:Concept ;
    skos:definition "Application of epidemiological methods to determine the cause, incidence, prevalence, and distribution of adverse effects in nonhuman species inhabiting contaminated sites; it is frequently associated with retrospective ecological risk assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecological epidemiology" .

goldbook:14614 a skos:Concept ;
    skos:definition "Change in any biological, physical, or chemical components of an ecosystem, or in their interactions, which result in change in ecological character and its functions and attributes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecological imbalance" .

goldbook:14615 a skos:Concept ;
    skos:altLabel "ecological death" ;
    skos:definition "Toxicant-related diminution of fitness of an individual functioning within an ecosystem that is of a magnitude sufficient to be equivalent to somatic death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecological mortality" .

goldbook:14616 a skos:Concept ;
    skos:definition "Measurable variable whose value is a determinant of the characteristics of an ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecological parameter" .

goldbook:14617 a skos:Concept ;
    skos:definition "Study of physiology and tolerance limits of species that enhances understanding of their distribution in relation to abiotic conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecophysiology" .

goldbook:14618 a skos:Concept ;
    skos:altLabel "bioregion" ;
    skos:definition "Any of a number of regions into which a continent, country, etc., can be divided according to their distinct environmental conditions and habitat types. Large area of land or water with a characteristic, geographically distinct assemblage of natural communities and species comprising a recurring pattern of ecosystems associated with characteristic combinations of soil and landform.Note: The biodiversity of ecosystems in an ecoregion is often distinct from that of other ecoregions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecoregion" .

goldbook:14619 a skos:Concept ;
    skos:definition "Grouping of organisms (microorganisms, plants, animals) interacting together, with and through their physical and chemical environments, to form a functional entity within a defined environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecosystem" .

goldbook:14620 a skos:Concept ;
    skos:definition "Area of gradual transition between two or more ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecotone" .

goldbook:14621 a skos:Concept ;
    skos:altLabel "ERC",
        "environmentally relevant concentration" ;
    skos:definition "Concentration of a pesticide (active ingredient, formulations, and relevant metabolites) that is likely to affect a determinable ecological characteristic of an exposed system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ecotoxicologically relevant concentration" .

goldbook:14622 a skos:Concept ;
    skos:definition "Pertaining to the soil." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "edaphic" .

goldbook:14623 a skos:Concept ;
    skos:definition "Movement in a current of water or air, that is contrary to the direction of the main current, especially in a circular motion, leading to irregularity in the motion of molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eddy motion" .

goldbook:14624 a skos:Concept ;
    skos:definition "Influence of the closeness of contrasting environments on an ecosystem, seen at boundaries between natural habitats, especially forests, and disturbed or developed land." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "edge effect" .

goldbook:14625 a skos:Concept ;
    skos:altLabel "ET" ;
    skos:definition "Time taken for a substance to produce a precisely defined effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effect time" .

goldbook:14626 a skos:Concept ;
    skos:definition "Component of risk assessment concerned with quantifying the manner in which the frequency and intensity of effects increase with increasing exposure to a contaminant or other source of stress (also known as dose–response assessment or toxicity assessment)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effects assessment" .

goldbook:14627 a skos:Concept ;
    skos:altLabel "community elasticity" ;
    skos:definition "Ability of a community to return to its prestressed condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elasticity" .

goldbook:14628 a skos:Concept ;
    skos:definition "Aqueous solution obtained after adding water to a solid substance (e.g., sediment, tailings, drilling mud, or dredging spoil), shaking the mixture, then centrifuging or filtering it or decanting the supernatant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elutriate" .

goldbook:14629 a skos:Concept ;
    skos:definition "Test in which a nonbenthic species, such as Daphnia magna, is exposed to an elutriate produced by mixing test sediment with water and then centrifuging the mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elutriate test" .

goldbook:14630 a skos:Concept ;
    skos:definition "New properties emerging with upward steps in hierarchical systems, such as ecological communities or ecosystems, that cannot be predicted solely from our limited understanding of the system’s parts or components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emergent properties" .

goldbook:14631 a skos:Concept ;
    skos:definition "Quantitative limit on the emission or discharge of a substance from a source, usually expressed in terms of a time-weighted average concentration or a ceiling value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission standard" .

goldbook:14632 a skos:Concept ;
    skos:definition "Pertaining to a species found in a discrete geographical unit, such as an island, habitat type, or other defined area or zone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endemic" .

goldbook:14633 a skos:Concept ;
    skos:definition "Ecological state of being unique to a place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endemism" .

goldbook:14634 a skos:Concept ;
    skos:definition "'Warm-blooded organism' that regulates its body temperature to be (almost) constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endotherm" .

goldbook:14635 a skos:Concept ;
    skos:definition "Objective of measurement of a toxicity test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endpoint" .

goldbook:14636 a skos:Concept ;
    skos:definition "Quantitative or quantifiable expression of the environmental value considered to be at risk in a risk analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endpoint assessment" .

goldbook:14637 a skos:Concept ;
    skos:altLabel "EA" ;
    skos:definition "Short, preliminary assessment of potential environmental harm used to determine if a full environmental impact statement (EIS) is required." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental assessment" .

goldbook:14638 a skos:Concept ;
    skos:definition "Portion of the total amount of a substance present in the environment that is involved in a particular process and is subject to physicochemical and biological modifying influences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental availability" .

goldbook:14639 a skos:Concept ;
    skos:definition "Ratio of uptake clearance to the rate at which an organism encounters a given contaminant in an environmental medium (e.g., soil, sediment, water, food) being processed by the organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental bioavailability" .

goldbook:14640 a skos:Concept ;
    skos:definition "Subdiscipline of human epidemiology concerned with diseases caused by chemical or physical agents in the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental epidemiology" .

goldbook:14641 a skos:Concept ;
    skos:definition "Destiny of a chemical or biological pollutant after release into the natural environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental fate" .

goldbook:14642 a skos:Concept ;
    skos:altLabel "EIA" ;
    skos:definition "Appraisal of the possible environmental consequences of a past, ongoing, or planned action, resulting in the production of an environmental impact statement or 'finding of no significant impact' (FONSI)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental impact assessment" .

goldbook:14643 a skos:Concept ;
    skos:altLabel "EIS" ;
    skos:definition "Report resulting from an environmental impact assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental impact statement" .

goldbook:14644 a skos:Concept ;
    skos:altLabel "EQO" ;
    skos:definition "Overall state to be aimed for in a particular aspect of the natural environment, for example, 'water in an estuary such that shellfish populations survive in good health'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental quality objective" .

goldbook:14645 a skos:Concept ;
    skos:altLabel "EQS",
        "ambient standard" ;
    skos:definition "Amount concentration or mass concentration of a substance that should not be exceeded in an environmental system, often expressed as a time-weighted average measurement over a defined period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental quality standard" .

goldbook:14646 a skos:Concept ;
    skos:definition "Determination of the probability of adverse effects on humans and other biota resulting from an environmental hazard (a chemical, physical, or biological agent occurring in or mediated by the environment)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental risk analysis" .

goldbook:14647 a skos:Concept ;
    skos:definition "Estimate of the probability that harm will result from a defined exposure to a substance in an environmental medium. The estimate is valid only for a given species and set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental risk assessment" .

goldbook:14648 a skos:Concept ;
    skos:definition "United Nations concept, defined as the relative stability of Earth’s natural ecosystems against human activity, most notably  global climate change caused by human release of greenhouse gas; deforestation caused by so-called 'clearing' of lands; or soil depletion and desertification caused by intensive monoculture techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental security" .

goldbook:14649 a skos:Concept ;
    skos:definition "Chemical transformation of a substance resulting from interactions in the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental transformation" .

goldbook:14650 a skos:Concept ;
    skos:definition "Movement of contaminants from their point of release through the various compartments to locations where exposure is assumed to occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental transport" .

goldbook:14651 a skos:Concept ;
    skos:definition "Present in a community or among a group of animals; term applied to a disease prevailing continually in a region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzootic" .

goldbook:14652 a skos:Concept ;
    skos:definition "Living on the bed of an aquatic system, normally on sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epibenthic" .

goldbook:14653 a skos:Concept ;
    skos:definition "Animals that live on the surface of soil or of the bed of an aquatic system, normally on sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epifauna" .

goldbook:14654 a skos:Concept ;
    skos:definition "Discontinuous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "episodic" .

goldbook:14655 a skos:Concept ;
    skos:definition "Outbreak of disease in a population or in a large number of individuals of a species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epizootic" .

goldbook:14656 a skos:Concept ;
    skos:definition "State of a system in which the macroscopic properties of the system become uniform and independent of time. If the temperature is uniform throughout the system, a state of thermal equilibrium has been reached; if the pressure is uniform, a state of hydrostatic equilibrium has been reached; and if the chemical potential of each component is uniform, a state of chemical equilibrium has been reached. If all these quantities become uniform, the system is said to be in a state of complete thermodynamic equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium" .

goldbook:14657 a skos:Concept ;
    skos:altLabel "EqP" ;
    skos:definition "Tendency for a substance to achieve the same fugacity (chemical activity) in different compartments of a complex system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium partitioning" .

goldbook:14658 a skos:Concept ;
    skos:altLabel "EqP approach" ;
    skos:definition "Approach to estimating the fate of chemicals in the aquatic environment that is based on equilibrium partitioning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium partitioning approach" .

goldbook:14659 a skos:Concept ;
    skos:altLabel "essential element",
        "essential metal",
        "nutrient" ;
    skos:definition "Substance that is absolutely required for the normal growth and development of a defined organism throughout a complete life cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "essential nutrient" .

goldbook:14660 a skos:Concept ;
    skos:definition "Belonging to an estuary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estuarine" .

goldbook:14661 a skos:Concept ;
    skos:definition "(general) Tidal opening, an inlet, or creek through which the tide enters; an arm of the sea indenting the land. Rare in modern use. (specific) Tidal mouth of a great river, where the tide meets the current of freshwater. Note 1: An estuary is a semi-enclosed coastal body of water with a free connection to the open sea made up of brackish water, typically the tidal mouth of rivers, often associated with sedimentation of material from terrestrial runoff. Note 2: An estuary is often associated with a high rate of biological productivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estuary" .

goldbook:14662 a skos:Concept ;
    skos:altLabel "etiological agent" ;
    skos:definition "Factor contributing to the cause of a disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "etiologic agent" .

goldbook:14663 a skos:Concept ;
    skos:definition "Equation used to estimate the intrinsic rate of increase from life-table data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Euler–Lotka equation" .

goldbook:14664 a skos:Concept ;
    skos:definition "Describing an environment having a high concentration of nutrients. Note: The term is usually used to describe nutrient-rich bodies of water or soil having a high or excessive rate of biological production. In medicine, tending to promote nutrition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutrophic" .

goldbook:14665 a skos:Concept ;
    skos:definition "Process producing a high concentration of nutrient salts and a high or excessive rate of biological production in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutrophication" .

goldbook:14666 a skos:Concept ;
    skos:definition "State of being eutrophic. (in medicine) Good nutrition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutrophy" .

goldbook:14667 a skos:Concept ;
    skos:definition "Transformation of animals, plants, and other living organisms into different forms by the accumulation of changes over successive generations. Transmutation of species. Origination or transformation of an organism, organ, physiological process, biological molecule, etc., by a series of changes. Note: The theory of evolution (in general) is the proposition that all living organisms have undergone a process of alteration and diversification from simple primordial forms during the Earth’s history; (in particular) it is a scientific theory proposing a mechanism for this process, now especially that based on Darwin’s theory of the natural selection of genetically inherited and adaptive variation (see neo-Darwinism)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evolution" .

goldbook:14668 a skos:Concept ;
    skos:definition "Diffusion across a membrane by means of a carrier molecule that requires no energy and involves the exchange of two ions across the membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange diffusion" .

goldbook:14669 a skos:Concept ;
    skos:definition "Average length of time an organism can be expected to survive, or a substance can be expected to persist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "expected life span" .

goldbook:14670 a skos:Concept ;
    skos:definition "Manmade construction intended to simulate a natural environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "experimental ecosystem" .

goldbook:14671 a skos:Concept ;
    skos:definition "Interspecies competition in which species compete for some limiting resource such as food." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exploitation competition" .

goldbook:14672 a skos:Concept ;
    skos:definition "Growth of cells, organisms, or populations in which the number or mass increases exponentially and growth at any time is proportional to the number or mass present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exponential growth" .

goldbook:14673 a skos:Concept ;
    skos:definition "Process of measuring or estimating concentration (or intensity), duration, and frequency of exposures to an agent present in the environment or, if estimating hypothetical exposures, that might arise from the release of a substance, or radionuclide, into the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure assessment" .

goldbook:14674 a skos:Concept ;
    skos:definition "Description of the presence and characteristics of contact between the contaminant and the ecological entity of concern, and a summary of this information in an exposure profile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure characterisation" .

goldbook:14675 a skos:Concept ;
    skos:definition "Route by which an individual is exposed to a contaminant, including the source and point of contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure pathway" .

goldbook:14676 a skos:Concept ;
    skos:definition "Outline of the magnitude and spatio-temporal pattern of exposure developed during the process of ecological risk assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure profile" .

goldbook:14677 a skos:Concept ;
    skos:definition "Model of the likely exposure of selected populations following release of a substance into a natural environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure scenario" .

goldbook:14678 a skos:Concept ;
    skos:definition "Probability that a population will eventually become extinct. Probability that a population will become extinct within a specified interval of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extinction probability" .

goldbook:14679 a skos:Concept ;
    skos:definition "Calculation, based on quantitative observations in exposed test species or in vitro test systems, of predicted dose–effect and dose–response relationships for a substance in the same species at other doses or in humans and other species at similar doses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrapolation" .

goldbook:14680 a skos:Concept ;
    skos:definition "Quantity used in effect and exposure assessments to adjust estimated exposures or concentrations/doses for uncertainties, to make corrections in the data, or to improve safety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrapolation factor" .

goldbook:14681 a skos:Concept ;
    skos:altLabel "facilitated transport" ;
    skos:definition "Passive diffusion down a gradient, not requiring energy, but occurring at a rate faster than expected by simple diffusion alone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "facilitated diffusion" .

goldbook:14682 a skos:Concept ;
    skos:definition "Disposition of a material in various environmental compartments (e.g., soil or sediment, water, air, biota) as a result of transport, partitioning, transformation, and degradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fate" .

goldbook:14683 a skos:Concept ;
    skos:altLabel "FS" ;
    skos:definition "Part of a remedial investigation that compares the various options available for remediation and identifies those that are practicable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "feasibility study" .

goldbook:14684 a skos:Concept ;
    skos:definition "Component of the life cycle of an individual in which natural selection can occur, involving the production of more offspring by matings of certain genotype pairs than are produced by other genotype pairs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fecundity selection" .

goldbook:14685 a skos:Concept ;
    skos:definition "Enhanced growth of plants as a result of exposure to low levels of pollutants such as nitrogen and sulfur oxides in acid precipitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fertilisation effect" .

goldbook:14686 a skos:Concept ;
    skos:definition "Substance applied to soil or hydroponic systems for improving the root nutrition of plants with the aim of increasing crop yields and (or) controlling production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fertiliser" .

goldbook:14687 a skos:Concept ;
    skos:altLabel "FAV" ;
    skos:definition "Estimate of the concentration of a substance corresponding to a cumulative probability of \\(\\pu{0.05}\\) in the acute toxicity values for all species for which acceptable acute tests have been conducted on the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "final acute value" .

goldbook:14688 a skos:Concept ;
    skos:altLabel "FCV" ;
    skos:definition "Estimate of the concentration of a substance corresponding to a cumulative probability of \\(\\pu{0.05}\\) in the chronic toxicity values for all genera for which acceptable chronic tests have been conducted on the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "final chronic value" .

goldbook:14689 a skos:Concept ;
    skos:altLabel "FONSI" ;
    skos:definition "Statement of no significant impact of a major federal action concluded after an environmental assessment (EA)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "finding of no significant impact" .

goldbook:14690 a skos:Concept ;
    skos:altLabel "multiplicative growth factor per generation" ;
    skos:definition "Rate of increase of population size measured over set intervals, such as between age classes of a life table or generations of a population with nonoverlapping generations, e.g., an annual plant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "finite rate of increase" .

goldbook:14691 a skos:Concept ;
    skos:altLabel "FATS" ;
    skos:definition "Behavioral, physiological, and biochemical responses of fish used to classify chemicals by mode of action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fish acute toxicity syndromes" .

goldbook:14692 a skos:Concept ;
    skos:definition "Increased relative fitness of a resistant genotype in a polluted environment compared to a nonresistant genotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fitness advantage" .

goldbook:14693 a skos:Concept ;
    skos:definition "Reduced relative fitness of a resistant genotype in an unpolluted environment compared to a nonresistant genotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fitness cost" .

goldbook:14694 a skos:Concept ;
    skos:definition "Exposure system for aquatic toxicity tests in which the test material solutions and control water flow into and out of test chambers on a once-through basis either intermittently or continuously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow-through system" .

goldbook:14695 a skos:Concept ;
    skos:altLabel "continuous flow test" ;
    skos:definition "Aquatic toxicity test performed in a flow-through system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow-through test" .

goldbook:14696 a skos:Concept ;
    skos:definition "Deviation from perfect bilateral symmetry for a population of a bilaterally symmetrical species that is thought to reflect developmental instability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluctuating asymmetry" .

goldbook:14697 a skos:Concept ;
    skos:definition "Organism that feeds on the fluids of other animals or of plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluid feeder" .

goldbook:14698 a skos:Concept ;
    skos:definition "Hierarchical sequence of transfer of substances from prey organism to predator organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "food chain" .

goldbook:14699 a skos:Concept ;
    skos:definition "Animal that feeds on the body parts of other animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "food-mass feeder" .

goldbook:14700 a skos:Concept ;
    skos:definition "Mineralized or otherwise preserved remnant or trace (such as a footprint) of an animal, plant, and other organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fossil" .

goldbook:14701 a skos:Concept ;
    skos:altLabel "FIAM" ;
    skos:definition "Model for acute metal toxicity to aquatic organisms based on the idea that toxicity occurs when the concentration of the free metal cation in solution reaches a certain level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free ion activity model" .

goldbook:14702 a skos:Concept ;
    skos:definition "Empirical equation that describes the adsorption of a contaminant to soil. The equation is \\[x/m = (K_{\\rm{f}} C_{\\rm{e}}) \\exp (1/n)\\] where \\(x/m\\) is the mass ratio of concentrations of adsorbed substance at equilibrium divided by the concentration of the contaminant in soil, \\(C_{\\rm{e}}\\) is the contaminant concentration in the aqueous phase at equilibrium, \\(K_{\\rm{f}}\\) is the equilibrium constant (the Freundlich adsorption constant), and \\(1/n\\) is a contaminant specific exponent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Freundlich adsorption isotherm" .

goldbook:14703 a skos:Concept ;
    skos:definition "Humic substance that is soluble at all \\(\\rm{pH}\\)s." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fulvic acid" .

goldbook:14704 a skos:Concept ;
    skos:definition "Apparently unaltered maintenance of community function despite changes in structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional redundancy" .

goldbook:14705 a skos:Concept ;
    skos:definition "Change in some predator function, such as prey consumption rate, in response to changes in prey density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional response" .

goldbook:14706 a skos:Concept ;
    skos:definition "Environmental conditions under which a species can thrive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fundamental niche" .

goldbook:14707 a skos:Concept ;
    skos:definition "Hypothesis proposed by James Lovelock that the Earth’s temperature, albedo, and surface chemistry are homeostatically regulated by the sum of all the biota of the Earth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gaia hypothesis" .

goldbook:14708 a skos:Concept ;
    skos:definition "Natural selection resulting from differential success of gametes produced by heterozygotes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gametic selection" .

goldbook:14709 a skos:Concept ;
    skos:definition "Excretion through the intestinal mucosa by active or passive processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastrointestinal excretion" .

goldbook:14710 a skos:Concept ;
    skos:altLabel "GAS" ;
    skos:definition "Specific syndrome associated with Selyean stress composed of three phases: the alarm reaction, adaptation or resistance, and exhaustion; adaptation in all phases of the GAS results in restoration of homeostasis or reduced deviation from homeostasis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "general adaptation syndrome" .

goldbook:14711 a skos:Concept ;
    skos:altLabel "adaptation",
        "evolutionary adaptation" ;
    skos:definition "Result of random genetic variation due to mutation and (or) to changes in allele frequencies, causing variation in the survival and reproductive success of individuals and hence of groups of organisms, with the consequence that those best adjusted to their environment flourish." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic adaptation" .

goldbook:14712 a skos:Concept ;
    skos:definition "Evolutionary process of change in the allele frequencies in a population due to random changes in the frequency by which different alleles are transferred to the next generation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic drift" .

goldbook:14713 a skos:Concept ;
    skos:definition "Situation in which a scored locus is acting only as a marker for a closely linked gene that is actually responsible for the difference in tolerance among genotypes. More generally, it is the condition 'in which a given allele changes in frequency as a result of linkage or gametic phase disequilibrium with another selected locus'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic hitchhiking" .

goldbook:14714 a skos:Concept ;
    skos:definition "Risk to the progeny of an exposed individual of an adverse effect associated with heritable genetic damage, e.g., damage to germ cells leading to a nonviable fetus or an offspring with a birth defect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic risk" .

goldbook:14716 a skos:Concept ;
    skos:definition "Low-level taxonomic rank used in the classification of living and fossil organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genus" .

goldbook:14717 a skos:Concept ;
    skos:altLabel "GIS" ;
    skos:definition "Computerized system to handle spatial data at a reasonable cost; most allow one to archive, organize, integrate, statistically analyze, and display many kinds of spatial information using a common coordinate system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geographic information system" .

goldbook:14718 a skos:Concept ;
    skos:definition "Process by which persistent and relatively volatile organochlorine compounds are distilled from warmer regions of use to cooler regions of the globe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "global distillation" .

goldbook:14719 a skos:Concept ;
    skos:definition "Process by which some persistent organic pollutants (POPs) move more rapidly than others toward the polar regions. Because POPs differ in their individual rates of degradation, vapor pressure, and lipophilicity, a fractionation occurs. The net result is a redistribution of the different POPs from the equator or site of origin toward the cold polar regions of the Earth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "global fractionation" .

goldbook:14720 a skos:Concept ;
    skos:definition "Heating up of the Earth’s climate thought to result from the increased atmospheric carbon dioxide (\\(\\ce{CO2}\\)) concentrations from fossil fuel burning, release of other greenhouse gases, and the worldwide destruction of forests." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "global warming" .

goldbook:14721 a skos:Concept ;
    skos:altLabel "GLP",
        "GLP principles" ;
    skos:definition "Fundamental rules incorporated in Organization for Economic Cooperation and Development (OECD) guidelines and national regulations concerned with the process of effective organization and the conditions under which laboratory studies are properly planned, performed, monitored, recorded, and reported." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "good laboratory practice principles" .

goldbook:14722 a skos:Concept ;
    skos:definition "Consequence that can be measured on a graded scale of intensity or severity and its magnitude related directly to the dose or concentration of the substance producing it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graded effect" .

goldbook:14723 a skos:Concept ;
    skos:definition "Global distillation of persistent organic pollutants (POPs) involving seasonal cycling of temperatures such that movement toward the higher latitudes occurs in annual pulses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grasshopper effect" .

goldbook:14724 a skos:Concept ;
    skos:definition "Atmospheric gases that are relatively transparent to sunlight entering the atmosphere but absorb infrared radiation generated at the Earth’s surface. They include water vapor, carbon dioxide (\\(\\ce{CO2}\\)), methane, dinitrogen oxide (nitrous oxide), chlorofluorocarbons (CFCs), chloroethane (methylchloroform), carbon tetrachloride, and the fire retardant, halon. Ozone in the troposphere can also act as a greenhouse gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "greenhouse gases" .

goldbook:14725 a skos:Concept ;
    skos:definition "Increase in size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth" .

goldbook:14726 a skos:Concept ;
    skos:definition "Decrease in contaminant concentration in a growing organism because the amount of tissue in which the contaminant is distributed is increasing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth dilution" .

goldbook:14727 a skos:Concept ;
    skos:definition "Group of functionally similar species whose members interact strongly with one another but weakly with the remainder of the community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guild" .

goldbook:14728 a skos:Concept ;
    skos:definition "Spatial area (geographical area) where a particular species population lives, large enough to comprise a breeding population. Note: A microhabitat or microenvironment is the immediate surroundings and other physical factors of an individual plant or animal within its habitat. Physical conditions that surround a species, or species population, or assemblage of species, or community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "habitat" .

goldbook:14729 a skos:Concept ;
    skos:definition "Concentration of all metallic cations, except those of the alkali metals, present in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hardness" .

goldbook:14730 a skos:Concept ;
    skos:definition "Water that contains mineral salts of divalent cations, commonly calcium and magnesium and sometimes iron(II) (ferrous) ions, principally as hydrogencarbonates, chlorides, and sulfates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard water" .

goldbook:14731 a skos:Concept ;
    skos:altLabel "genetic equilibrium" ;
    skos:definition "State of a population if the frequencies of different alleles of all genes in the genome remain constant between generations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hardy–Weinberg equilibrium" .

goldbook:14732 a skos:Concept ;
    skos:altLabel "damage" ;
    skos:definition "Adverse effect to an ecosystem, community, population, species, individual organism, organ, tissue, or cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harm" .

goldbook:14733 a skos:Concept ;
    skos:definition "Determination of factors controlling the likely effects of a hazard such as the dose–effect and dose–response relationships, variations in target susceptibility, bioaccumulation potential, persistence, and mechanism of toxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard assessment" .

goldbook:14734 a skos:Concept ;
    skos:definition "Identification and assessment of the potential adverse effects that could result from manufacture, use, and disposal of a material in a specified quantity and manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard evaluation" .

goldbook:14735 a skos:Concept ;
    skos:definition "Determination of substances of concern, their adverse effects, target populations, and conditions of exposure, taking into account toxicity data and knowledge of effects on human health, other organisms, and their environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard identification" .

goldbook:14736 a skos:Concept ;
    skos:altLabel "HI" ;
    skos:definition "Sum of the hazard quotients for substances that affect the same target organ or organ system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard index" .

goldbook:14737 a skos:Concept ;
    skos:altLabel "HQ" ;
    skos:definition "Ratio of toxicant exposure (estimated or measured) to a reference value regarded as corresponding to a threshold of toxicity; often this is determined as the predicted environmental concentration (PEC) divided by the predicted no-effect concentration (PNEC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard quotient" .

goldbook:14738 a skos:Concept ;
    skos:definition "Concentration of a substance producing a defined effect on \\(\\pu{\\textit{p} \\%}\\) (usually \\(\\pu{5\\%}\\)) of species of concern, derived by means of a statistical extrapolation procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazardous concentration" .

goldbook:14739 a skos:Concept ;
    skos:definition "Term used commonly but erroneously when referring to metal toxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heavy metal" .

goldbook:14740 a skos:Concept ;
    skos:definition "Animal that partially regulates body temperature, sometimes maintaining its body temperature at a certain level, e.g., when active, but at other times allowing it to fluctuate with the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterotherm" .

goldbook:14741 a skos:Concept ;
    skos:definition "Organism obtaining organic food by eating other organisms or their excreta." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterotroph" .

goldbook:14742 a skos:Concept ;
    skos:definition "Temporal sequential appearance of different heterotrophic species at a location, most often decomposer organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterotrophic succession" .

goldbook:14743 a skos:Concept ;
    skos:altLabel "heterosis" ;
    skos:definition "Greater Darwinian fitness (reproductive output) from heterozygous than from homozygous individuals of a species. This tends to preserve variation in the population gene pool." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterozygote advantage" .

goldbook:14744 a skos:Concept ;
    skos:definition "Totality of processes occurring in an open system or a closed system, especially a living organism, enabling it to regulate its internal environment to maintain stable, constant conditions or the outcome of these processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homeostasis" .

goldbook:14745 a skos:Concept ;
    skos:definition "Unexpected and unexplained but favorable biological response to low-level exposure to a substance or physical agent generally considered to be harmful." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hormesis" .

goldbook:14746 a skos:Concept ;
    skos:definition "Nonvolatile organic anionic polyelectrolytes, of biological origin, in the molecular mass range \\(\\pu{500\\!{-}\\! 5000}\\), which have complex structures and are variable in composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "humic substances" .

goldbook:14747 a skos:Concept ;
    skos:definition "Intersection of ranges of tolerances for sets of resources utilized by organisms, represented mathematically by a multidimensional hypervolume whose dimensions correspond to environmental variables. Any species is considered unimodally distributed, i.e., confined to a habitat in the niche." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hutchinsonian niche" .

goldbook:14748 a skos:Concept ;
    skos:definition "Result of interbreeding between two animals or plants of different taxa.Note: Hybrids between different species within the same genus are sometimes known as interspecific hybrids or crosses. Hybrids between different subspecies within a species are known as intra-specific hybrids. Hybrids between different genera are sometimes known as intergeneric hybrids. Cross-breed between populations, breeds, or cultivars within a single species.Note: Hybridization is often used in plant and animal breeding to obtain desirable characteristics not found or inconsistently present in the parent individuals or populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid" .

goldbook:14749 a skos:Concept ;
    skos:definition "Deficient oxygenation of the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypoxemia" .

goldbook:14750 a skos:Concept ;
    skos:definition "Dioxygen-deficient" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypoxic" .

goldbook:14751 a skos:Concept ;
    skos:definition "Concentration of a chemical which is lethal to \\(\\pu{50\\%}\\) of the test organisms as a result of exposure for periods long enough for acute lethal action to cease; in other words, the concentration below which \\(\\pu{50\\%}\\) of individuals will have a normal lifespan despite the previous exposure to a toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incipient LC<sub>50</sub>" .

goldbook:14752 a skos:Concept ;
    skos:definition "For an air pollutant, the additional lifetime cancer risk occurring in a hypothetical population in which all individuals are exposed continuously from birth throughout their lifetimes to a concentration of \\(\\pu{1 \\upmu g m-3}\\) of the pollutant in the air they breathe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incremental unit risk estimate" .

goldbook:14753 a skos:Concept ;
    skos:definition "Production of an effect by each toxicant in a given exposure that is independent of the others and occurs by a different mode of action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "independent joint action" .

goldbook:14754 a skos:Concept ;
    skos:definition "Composite index combining 12 qualities of fish communities of warm-water, low-gradient streams to determine the level of stream degradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "index of biological integrity" .

goldbook:14755 a skos:Concept ;
    skos:definition "Species whose presence shows the occurrence of defined environmental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indicator species" .

goldbook:14756 a skos:Concept ;
    skos:definition "Native to a given region or ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indigenous" .

goldbook:14757 a skos:Concept ;
    skos:definition "Effect resulting from imposed biotic or abiotic factors which alter ecosystem properties that in turn favor or disfavor an ecological component of importance (e.g., a species) and thus indirectly lead to improved or reduced fitness of that species. Result of imposed biotic or abiotic factors allowing indigenous or new species to dominate, thereby affecting ecosystem composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect ecological effect" .

goldbook:14758 a skos:Concept ;
    skos:definition "Degradation of a contaminant through interaction with other molecules in solution that have absorbed light energy. This can occur through energy transfer or by chemical reaction with short-lived reactive species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect photolysis" .

goldbook:14759 a skos:Concept ;
    skos:definition "Adverse effects that result from agent(s) acting on and producing changes in the chemical, physical, and (or) biological environment external to the organisms under study (e.g., decrease in food for predatory species due to direct toxicity from a chemical to prey may produce adverse effects in the predator species due to starvation rather than inducing any direct chemical toxicity in predator organisms)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect toxicity" .

goldbook:14760 a skos:Concept ;
    skos:definition "One whole organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "individual" .

goldbook:14761 a skos:Concept ;
    skos:altLabel "IED" ;
    skos:definition "Concept forming the basis for most dose–response models, which holds that there exists a smallest dose needed to kill any particular individual. The IED is a characteristic of an individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "individual effective dose" .

goldbook:14762 a skos:Concept ;
    skos:definition "Study of the flows of materials and energy in the industrial environment and the effects of these flows on natural systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "industrial ecology" .

goldbook:14763 a skos:Concept ;
    skos:definition "Gradual increase to predominance of melanic forms in populations from industrialized regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "industrial melanism" .

goldbook:14764 a skos:Concept ;
    skos:definition "Community’s ability to resist change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inertia" .

goldbook:14765 a skos:Concept ;
    skos:definition "Animals living in the sediment of aquatic systems but not on the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infauna" .

goldbook:14766 a skos:Concept ;
    skos:definition "Specific action that results in a risk being incurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initiating event" .

goldbook:14767 a skos:Concept ;
    skos:altLabel "IRIS" ;
    skos:definition "USEPA database containing reference doses, slope factors, and drinking-water health advisories (one-day, ten-day, longer-term, and lifetime advisories), and associated information." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integrated risk information system" .

goldbook:14768 a skos:Concept ;
    skos:definition "Interspecies competition in which one species interferes with another, as might occur with territoriality or aggressive behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interference competition" .

goldbook:14769 a skos:Concept ;
    skos:definition "Interference with or inhibition of one species by another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interspecies competition" .

goldbook:14770 a skos:Concept ;
    skos:definition "Competition by different species for the same (limited) resources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interspecific competition" .

goldbook:14771 a skos:Concept ;
    skos:definition "Relations between different species in a community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interspecific interaction" .

goldbook:14772 a skos:Concept ;
    skos:altLabel "pore water" ;
    skos:definition "Water in sediment or soil that surrounds the solid particles. The amount of interstitial water is calculated and expressed as the percentage ratio of the mass of water in the sediment to the mass of the wet sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interstitial water" .

goldbook:14773 a skos:Concept ;
    skos:definition "Competition by individuals of the same species (population) for the same (limited) resources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intraspecific competition" .

goldbook:14774 a skos:Concept ;
    skos:definition "\\(r = ({\\rm{natality}} + {\\rm{immigration}}) - ({\\rm{mortality}} + {\\rm{emigration}})\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic rate of growth" .

goldbook:14775 a skos:Concept ;
    skos:altLabel "Malthusian rate of increase" ;
    skos:definition "Rate of increase in the size of a population growing under no constraints." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic rate of increase" .

goldbook:14776 a skos:Concept ;
    skos:definition "Approach used to visualize or quantify joint action of chemical mixtures by plotting a graph (isobologram) of equally effective dose pairs (isoboles) for a single effect level. A particular effect level is selected, such as \\(\\pu{50\\%}\\) of the maximum, and doses of drugs \\(\\ce{A}\\) and \\(\\ce{B}\\) (each alone) that give this effect are plotted as axial points in a Cartesian plot. The straight line connecting \\(\\ce{A}\\) and \\(\\ce{B}\\) is the locus of points (dose pairs) that will produce this effect in a simply additive combination. This line of additivity allows a comparison with the actual dose pair that produces this effect level experimentally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isobole approach" .

goldbook:14777 a skos:Concept ;
    skos:definition "The differential behavior of isotopes occurring if the rate or extent of participation in some biological or chemical process depends significantly on the mass of the isotope. Also called the isotope effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic discrimination" .

goldbook:14778 a skos:Concept ;
    skos:definition "Species that reproduces more than once." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iteroparous species" .

goldbook:14779 a skos:Concept ;
    skos:definition "Any agent will be teratogenic if it is present at concentrations or intensities producing cell toxicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kamofsky’s law" .

goldbook:14780 a skos:Concept ;
    skos:definition "High-quality habitat patch essential to maintaining the vitality of the metapopulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keystone habitat" .

goldbook:14781 a skos:Concept ;
    skos:definition "Species, usually a top predator, that influences the ecological community by its activity or role, not its numerical dominance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keystone species" .

goldbook:14782 a skos:Concept ;
    skos:definition "Equilibrium strategy for species involving effective interactions with each other in the community, allowing coexistence of many species. Equilibrium species are more effective competitors than opportunistic species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "k-strategy" .

goldbook:14783 a skos:Concept ;
    skos:definition "Recently hatched insect, fish, or other organism that has different physical characteristics than those seen in the adult, requiring metamorphosis to reach the adult body structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "larva" .

goldbook:14784 a skos:Concept ;
    skos:definition "According to this 'law', there are comparatively many rare (low abundance) species, and possibly comparatively many common (high abundance) species, but relatively few in the middle (of medium abundance)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "law of frequence" .

goldbook:14785 a skos:Concept ;
    skos:definition "With reference to a soluble chemical or mineral, drain away from soil, ash, or similar material by the action of percolating liquid, especially rainwater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leach" .

goldbook:14786 a skos:Concept ;
    skos:definition "Water or waste-water that has percolated through a column of soil or solid waste in the environment, carrying with it substances dissolved from the soil or waste." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leachate" .

goldbook:14787 a skos:Concept ;
    skos:definition "Related to standing water riparian-wetland areas such as lakes, ponds, seeps, bogs, and meadows." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lentic" .

goldbook:14788 a skos:Concept ;
    skos:definition "Nonflowing or still inland water; e.g., lakes, ponds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lentic water" .

goldbook:14789 a skos:Concept ;
    skos:definition "Square matrix used in population biology to predict population growth. The top row of the matrix is the fecundity for each age class of mothers, and a subdiagonal is constructed from the number of individuals surviving from age class \\(x\\) to \\(x + 1\\). Multiplied by the population vector of the number of female offspring in each age class \\(x\\) at time \\(t\\), it predicts the age distribution of the population at the next time step \\(t + 1\\), corresponding to the age class interval \\(x + 1\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Leslie matrix" .

goldbook:14790 a skos:Concept ;
    skos:definition "Deadly; fatal; causing death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethal" .

goldbook:14791 a skos:Concept ;
    skos:altLabel "LBB" ;
    skos:definition "Total body uptake of a substance that is associated with mortality in short-term exposures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethal body burden" .

goldbook:14792 a skos:Concept ;
    skos:altLabel "LT" ;
    skos:definition "Time taken for a defined percentage, usually \\(\\pu{50\\%}\\), of a test population to die." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethal time" .

goldbook:14793 a skos:Concept ;
    skos:definition "Ability to cause death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethality" .

goldbook:14794 a skos:Concept ;
    skos:definition "Observation that a population’s size (number of individuals or biomass) is limited by some essential factor in the environment that is scarce relative to the amount of other essential factors, e.g., phosphorus-limited algal growth in a lake." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Liebig's law of the minimum" .

goldbook:14795 a skos:Concept ;
    skos:definition "Series of stages, from a given point in one generation to the same point in next generation, e.g., egglarva-adult-egg (hyphenated when used as an adjective, e.g., life-cycle strategy)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life cycle" .

goldbook:14796 a skos:Concept ;
    skos:definition "Comprehensive study to determine the impact of a substance or mixture on the survival, growth, reproduction, development, or other important qualities at all stages of a species life cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life-cycle study" .

goldbook:14797 a skos:Concept ;
    skos:definition "Description of life-cycle events through which an organism passes, with particular reference to those events that influence survival and reproduction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life history" .

goldbook:14798 a skos:Concept ;
    skos:definition "Statistical table that follows a hypothetical cohort of \\(\\pu{100000}\\) persons born at the same time as they progress through successive ages, with the cohort reduced from one age to the next according to a set of death rates by age until all persons eventually die." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life table" .

goldbook:14799 a skos:Concept ;
    skos:altLabel "LTRE" ;
    skos:definition "Retrospective comparison of two or more populations in which the response variable is a life table or a complete set of stage-specific vital rates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life-table response experiment" .

goldbook:14800 a skos:Concept ;
    skos:altLabel "LV" ;
    skos:definition "Limit concentration at or below which Member States of the European Community must set their environmental quality standard and emission standard for a particular substance according to Community Directives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limit value" .

goldbook:14801 a skos:Concept ;
    skos:definition "Model based on the assumption that the maximum life span of an individual organism is an inherent, genetically defined property of that organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limited life-span paradigm" .

goldbook:14802 a skos:Concept ;
    skos:definition "Artificial enclosures placed in the pelagic region of ponds, lakes, or marine environments. These systems vary in size from as little as \\(\\pu{2 L}\\) to over \\(\\pu{2.5E6 L}\\); however, most of these systems have a volume between \\(\\pu{1000 L}\\) and \\(\\pu{E4 L}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limnocorrals" .

goldbook:14803 a skos:Concept ;
    skos:definition "Study incorporating the study of all aspects of inland freshwater habitats including lakes, ponds, rivers, streams, swamps, wetlands, groundwaters, and reservoirs that make up inland water systems" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limnology" .

goldbook:14804 a skos:Concept ;
    skos:altLabel "LFER" ;
    skos:definition "An empirical relationship in which numerical parameters are associated with small perturbations in a parent molecule and are subsequently correlated with the change in the Gibbs energy of a certain reaction of the parent molecule vs. the perturbed molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear free energy relationship" .

goldbook:14805 a skos:Concept ;
    skos:definition "Simple, semigraphical method for analyzing survival time data and estimating \\(\\pu{LT_{50}}\\) values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Litchfield method" .

goldbook:14806 a skos:Concept ;
    skos:definition "Semigraphical method for estimating a median lethal concentration (\\(\\pu{LC_{50}}\\)), median lethal dose (\\(\\pu{LD_{50}}\\)), or median effective concentration (\\(\\pu{EC_{50}}\\)). Although very easy to perform, it is the most subjective method for such estimations because it involves fitting a line to data by eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Litchfield–Wilcoxon method" .

goldbook:14807 a skos:Concept ;
    skos:definition "Belonging to the shore of a lake, river, pond, or especially the sea. Intertidal zone, sometimes referring specifically to the shallow well-lit region along the shore." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "littoral" .

goldbook:14808 a skos:Concept ;
    skos:definition "Isolated shore regions of freshwater ponds separated from the main body of water by plastic dividers used for ecotoxicological testing. These test systems generally have a volume of \\(\\pu{1000 L}\\) to \\(\\pu{5E4 L}\\) and a maximum depth of \\(\\pu{2 m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "littoral enclosures" .

goldbook:14809 a skos:Concept ;
    skos:definition "Ratio of animal biomass to the volume of test solution in an exposure chamber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loading" .

goldbook:14810 a skos:Concept ;
    skos:definition "Function, often applied to growth curves, fitting the general equation \\[y = k/(1 + e^{a+bt})\\] where \\(t\\) represents time, \\(y\\) the body weight or population size, \\(k\\) the rate of growth, and \\(a\\) and \\(b \\gt 0\\) are constants. In the logistic equation the percentage rate of increase decreases linearly as size increases. The resulting curve continually rises, slowly at first, more rapidly in the middle phase, and slowly again near the end of growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "logistic curve" .

goldbook:14811 a skos:Concept ;
    skos:definition "Growth of a population under environmental constraints that set a maximum population size, giving an S-shaped curve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "logistic growth" .

goldbook:14812 a skos:Concept ;
    skos:definition "In competitive binding assays, the logit-log dose relationship, in which the response is defined by \\[R = {\\rm{logit}}\\,(y) = \\ln [y/(1 - y)]\\] where \\(y = b/b_{0}\\), \\(b\\) is fraction of tracer bound and \\(b_{0}\\) is the value of \\(b\\) with no unlabelled ligand in the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "logit transformation" .

goldbook:14813 a skos:Concept ;
    skos:definition "Transformation of data with a logarithmic function that results in a normal distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "log-normal transformation" .

goldbook:14814 a skos:Concept ;
    skos:definition "Delusion of selfless motivation in environmental stewardship or advocacy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lorax incongruity" .

goldbook:14815 a skos:Concept ;
    skos:altLabel "LLE" ;
    skos:definition "Calculated estimate of loss in lifetime associated with a risk factor; it is estimated as the simple difference between life expectancy without the risk factor and life expectancy with the risk factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loss of life expectancy" .

goldbook:14816 a skos:Concept ;
    skos:definition "Related to flowing continental waters, such as rivers and streams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lotic" .

goldbook:14817 a skos:Concept ;
    skos:altLabel "lotic microcosms" ;
    skos:definition "Streams of various sizes used to evaluate the effects of substances. Unlike lentic systems, no standardized design has been developed for flowing-water test systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lotic mesocosms" .

goldbook:14818 a skos:Concept ;
    skos:definition "Flowing continental waters, such as rivers and streams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lotic water" .

goldbook:14819 a skos:Concept ;
    skos:altLabel "LED" ;
    skos:definition "Lowest dose of a chemical inducing a specified effect in a specified fraction of exposed individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lowest effective dose" .

goldbook:14820 a skos:Concept ;
    skos:altLabel "LOEC" ;
    skos:definition "Lowest concentration of a material used in an aquatic toxicity test that has a statistically significant adverse effect on the exposed population of test organisms compared with controls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lowest-observed-effect concentration" .

goldbook:14821 a skos:Concept ;
    skos:definition "Life table that summarizes mortality data for populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "l<i>x</i> life table or schedule" .

goldbook:14822 a skos:Concept ;
    skos:definition "Life table that summarizes both mortality and natality data for populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "l<i>x</i>m<i>x</i> life table" .

goldbook:14823 a skos:Concept ;
    skos:definition "Model of island colonization giving the mathematical relationship \\[S(t) = S_{\\rm{EQ}}(1 - e^{-Gt})\\] where \\(S(t)\\) is the number of species present at time \\(t\\), \\(S_{\\rm{EQ}}\\) is the equilibrium number of species for the island, and \\(G\\) is the rate constant for colonization of the island." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "MacArthur–Wilson model" .

goldbook:14824 a skos:Concept ;
    skos:definition "Large multi-species test system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrocosm" .

goldbook:14825 a skos:Concept ;
    skos:definition "Imprecise term referring to a nutrient required for survival, or present in biological fluids or compartments at a level easily measured by existing analytical techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macronutrient" .

goldbook:14826 a skos:Concept ;
    skos:definition "Aquatic plant large enough to be seen easily with the naked eye (as distinct from phytoplankton and small algae)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrophyte" .

goldbook:14827 a skos:Concept ;
    skos:definition "Disease or birth defects produced by a father’s exposure to a physical or chemical agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "male-mediated toxicity" .

goldbook:14828 a skos:Concept ;
    skos:definition "Model, developed by Thomas R. Malthus (1766–1834), implying that, unchecked by environmental or social constraints, human populations would double every 25 years, regardless of the initial population size. Thus, if \\(X_{i}\\) denotes the population size during time period \\(i\\) and \\(r\\) the population growth rate, the Malthusian population model gives the relationship \\[X(I + 1) = (1 + r)X_{i}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Malthusian theory" .

goldbook:14829 a skos:Concept ;
    skos:definition "Equation that expresses the total mass of a chemical in terms of all the various forms and concentrations in different environmental compartments (including biota) in which it occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass balance equation" .

goldbook:14830 a skos:Concept ;
    skos:definition "Index for pollution based on the proportions of species in a soil nematode community that fall into various categories ranging from colonizers (\\(r\\mbox{-}\\rm{strategists}\\)) to persisters (\\(k\\mbox{-}\\rm{strategists}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maturity index" .

goldbook:14831 a skos:Concept ;
    skos:definition "Assignment of ecological or biological significance of a contaminant’s effect based primarily on statements of statistical significance but contrary to biological probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maulstick incongruity" .

goldbook:14832 a skos:Concept ;
    skos:altLabel "MATC" ;
    skos:definition "Geometric mean of the lowest exposure concentration that causes a statistically significant adverse effect (lowest-observed-effect concentration, LOEC) and the highest exposure concentration where no effect is observed (no-observed-effect concentration, NOEC) in a life-cycle (full chronic) or partial lifecycle (partial chronic) test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum acceptable toxicant concentration" .

goldbook:14833 a skos:Concept ;
    skos:altLabel "MLE" ;
    skos:definition "Parametric method used to fit dose- or concentration-effect data to the log-normal, log-logistic, or other models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum likelihood estimation" .

goldbook:14834 a skos:Concept ;
    skos:altLabel "MAT" ;
    skos:definition "Mean time required for absorption of a drug or contaminant calculated as the difference in mean residence time (MRT) of the material introduced by the (noninstantaneous) route of interest and the MRT for the same material injected intravenously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean absorption time" .

goldbook:14835 a skos:Concept ;
    skos:definition "Average time interval required for a bacterial cell to divide or for the population to double under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean generation time" .

goldbook:14836 a skos:Concept ;
    skos:definition "Measurable response to a stressor (e.g., fledglings produced per nest each year) that is related to the valued qualities of the assessment endpoint (e.g., reproductive success of bald eagles)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement endpoint" .

goldbook:14837 a skos:Concept ;
    skos:definition "For sublethal or ambiguously lethal effects, the median time until \\(\\pu{50\\%}\\) of the exposed individuals respond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median effective time" .

goldbook:14838 a skos:Concept ;
    skos:altLabel "inhibitory time (IT)" ;
    skos:definition "Time required for a toxicant to inhibit a specified process in \\(\\pu{50\\%}\\) of a population under test conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median inhibitory time" .

goldbook:14839 a skos:Concept ;
    skos:altLabel "MTTD" ;
    skos:definition "Median time resulting in death for \\(\\pu{50\\%}\\) of the exposed organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median time to death" .

goldbook:14840 a skos:Concept ;
    skos:definition "Concentration of a substance in air, water, sediment, or soil at which \\(\\pu{50\\%}\\) of the test organisms survive after a specified time of exposure. The \\(\\pu{TL_{50}}\\) (equivalent to the \\(\\pu{TL_{m}}\\)) is usually expressed as a time-dependent value (e.g., \\(\\pu{24\\!\\mbox{-}h}\\) or \\(\\pu{96\\!\\mbox{-}h}\\) \\(\\pu{TL_{50}}\\); the estimated concentration at which \\(\\pu{50\\%}\\) of test organisms survive after \\(\\pu{24 h}\\) or \\(\\pu{96 h}\\) of exposure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median tolerance limit" .

goldbook:14841 a skos:Concept ;
    skos:definition "Small benthic invertebrates living in interstices of soil or sediment or in aquatic systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meiofauna" .

goldbook:14842 a skos:Concept ;
    skos:definition "Any process that causes some alleles to be over-represented in the gametes which are formed during meiosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meiotic drive" .

goldbook:14843 a skos:Concept ;
    skos:definition "Individuals or subspecies with increased dark pigmentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melanic forms" .

goldbook:14844 a skos:Concept ;
    skos:definition "Increased black or nearly black pigmentation of skin, feathers, or hair of an organism, resulting from (increased) synthesis of melanin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melanism" .

goldbook:14845 a skos:Concept ;
    skos:definition "Fundamental principles of inheritance (especially the laws of segregation and independent assortment and the existence of dominant and recessive characters), propounded originally by Gregor Mendel (1822–1884) and forming the basis for the science of classical genetics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mendelism" .

goldbook:14846 a skos:Concept ;
    skos:definition "Enclosed and essentially self-sufficient (but not necessarily isolated) experimental environment or ecosystem that is on a larger scale than a laboratory microcosm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesocosm" .

goldbook:14847 a skos:Concept ;
    skos:definition "Process of using statistical methods to combine the results of different studies. In the biomedical sciences, the systematic evaluation of a problem using information (commonly in the form of statistical tables and other data) from a number of independent studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meta-analysis" .

goldbook:14848 a skos:Concept ;
    skos:definition "Poorly characterized, cysteine-rich metal-binding proteins or proteins not conforming precisely to the classic properties of metallothioneins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallothionein-like proteins" .

goldbook:14849 a skos:Concept ;
    skos:definition "Measurement or a transformation of a measurement used in the analysis of biological tests, e.g., the probit metameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metameter" .

goldbook:14850 a skos:Concept ;
    skos:definition "Set of local populations which interact via dispersing individuals among local populations; though not all local populations in a metapopulation need interact directly with every other local population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metapopulation" .

goldbook:14851 a skos:Concept ;
    skos:definition "Method proposed to reduce precipitate explanation by considering all plausible hypotheses simultaneously in testing so that equal amounts of effort and attention are provided to each." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "method of multiple working hypotheses" .

goldbook:14852 a skos:Concept ;
    skos:definition "Artificial multi-species test system that simulates major characteristics of the natural environment for the purposes of ecotoxicological effects and risk assessment; such systems are normally terrestrial or aquatic and may contain plants, animals (vertebrates and invertebrates), and microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcosm" .

goldbook:14853 a skos:Concept ;
    skos:definition "Evolutionary change below the species level; a small change in the genetic make-up of a population from generation to generation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microevolution" .

goldbook:14854 a skos:Concept ;
    skos:definition "Plant of microscopic size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microphyte" .

goldbook:14855 a skos:Concept ;
    skos:definition "Test involving luminescent marine bacteria of the Vibrio sp. [e.g., V. (Photobacterium) phosphoreum, V. fischeri, V. harveyi]. A decrease in bioluminescence is thought to reflect toxic action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Microtox® test" .

goldbook:14856 a skos:Concept ;
    skos:definition "Naturally occurring substance, usually crystalline, which has a particular chemical composition and specific physical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mineral" .

goldbook:14857 a skos:Concept ;
    skos:altLabel "MSD" ;
    skos:definition "Difference between groups (in tests with, e.g., salmonid fish, the difference in average weights or average mortality) that would have to occur before it could be concluded that there was a significant difference between the groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum significant difference" .

goldbook:14858 a skos:Concept ;
    skos:definition "Minimum time required to get an effect or response. Regardless of the toxicant concentration, the effect, or response, cannot occur any faster than this minimum time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimal time to effect or response" .

goldbook:14859 a skos:Concept ;
    skos:altLabel "MVP" ;
    skos:definition "Smallest population size of a species allowing survival in the wild." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum viable population" .

goldbook:14860 a skos:Concept ;
    skos:definition "Area where an effluent discharge undergoes initial dilution and is extended to cover the secondary mixing in the ambient water body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixing zone" .

goldbook:14861 a skos:Concept ;
    skos:definition "Elements of uncertainty associated with the discrepancy between the model and the real world." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "model error" .

goldbook:14862 a skos:Concept ;
    skos:definition "Test designed to be applied on a routine basis, with some degree of control, to ensure that the quality of an environmental compartment, biological endpoint, or effluent has not exceeded some prescribed criteria range. In a biomonitoring test, organisms are used as 'sensors' to detect changes in the quality of water or effluent. A monitoring test implies generation of information, on a continuous or other regular basis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monitoring test" .

goldbook:14863 a skos:Concept ;
    skos:definition "Officially the Protocol on Substances That Deplete the Ozone Layer, a treaty signed on 16 September 1987, in Montreal by 25 nations; there are now 168 subscribing nations. The protocol sets limits on the production of chlorofluorocarbons (CFCs), halons, and related substances that release chlorine or bromine to the ozone layer of the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Montreal protocol" .

goldbook:14864 a skos:Concept ;
    skos:definition "Study of the interaction and adjustment of the seafloor topography and fluid hydrodynamic processes, seafloor morphologies, and sequences of change dynamics involving the motion of sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphodynamics" .

goldbook:14865 a skos:Concept ;
    skos:definition "Death rate, the number of dead individuals per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mortality" .

goldbook:14866 a skos:Concept ;
    skos:definition "Ecotoxicological approach in which results for the most sensitive of all tested species are used as an indicator of the toxicant concentration below which the entire community is protected from adverse effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "most-sensitive-species approach" .

goldbook:14867 a skos:Concept ;
    skos:definition "Method of estimating \\(\\pu{LC_{50}}\\), \\(\\pu{EC_{50}}\\), or \\(\\pu{LD_{50}}\\). It can be implemented with straightforward equations if the toxicant concentrations are set in a geometric series and there are equal numbers of individuals exposed in each treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moving average method" .

goldbook:14868 a skos:Concept ;
    skos:definition "Higher fitness of an individual as a composite or summed effect of heterozygote superiority (heterosis) at each of a series of loci." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple heterosis" .

goldbook:14869 a skos:Concept ;
    skos:definition "Interaction between two or more species, giving fitness benefit to all the involved species, e.g., increased carrying capacity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutualism" .

goldbook:14870 a skos:Concept ;
    skos:altLabel "NAS",
        "NAS paradigm of risk assessment" ;
    skos:definition "Model for risk assessment with four components—hazard identification, exposure assessment, dose–response assessment, and risk characterization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "National Academy of Sciences paradigm of risk assessment" .

goldbook:14871 a skos:Concept ;
    skos:definition "Evolutionary theory, originally proposed by Darwin, of the preferential survival and reproduction of organisms better adapted to their environment as a result of genetic adaptation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural selection" .

goldbook:14872 a skos:Concept ;
    skos:definition "Cosmic radiation emitted from stars and long-lived terrestrial radionuclides that are ubiquitously present in the Earth’s soils." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural radiation background" .

goldbook:14873 a skos:Concept ;
    skos:definition "Aggregate of actively swimming animals in a body of water ranging from microscopic organisms to whales." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nekton" .

goldbook:14874 a skos:Concept ;
    skos:definition "Theory of biological evolution (widely accepted since the 1920s) based on Darwin’s theory of natural selection but incorporating the theories of later biologists regarding genes, inheritance, and mutation, particularly those of Weismann and Mendel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neo-Darwinism" .

goldbook:14875 a skos:Concept ;
    skos:definition "Plant found newly in an area where it had not been recorded previously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neophyte" .

goldbook:14876 a skos:Concept ;
    skos:definition "Expected number of females to be produced during the lifetime of a newborn female as estimated with a life table." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net reproductive rate" .

goldbook:14877 a skos:Concept ;
    skos:definition "Group of conditions and resources, facilitating but limiting survival, growth, and reproduction of a defined group of organisms or species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "niche" .

goldbook:14878 a skos:Concept ;
    skos:definition "Rapid use and preemption of resources by a species that exploits them to the exclusion or severe disadvantage of another species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "niche preemption" .

goldbook:14879 a skos:Concept ;
    skos:definition "Term referring to the area which a species could physically inhabit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "niche width" .

goldbook:14880 a skos:Concept ;
    skos:altLabel "NIMBY",
        "NIMBY principle" ;
    skos:definition "Public acceptance of necessary provisions (e.g., waste incinerators) provided they do not affect the individual’s quality of life." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "not in my backyard principle" .

goldbook:14881 a skos:Concept ;
    skos:definition "Nine aspects of evidence, defined by Bradford-Hill (1965), fostering the accuracy of linkage between a risk factor and disease: strength of association, consistency of association, specificity of association, temporal association, biological gradient (dose-response) in the association, biological plausibility, coherence of the association, experimental support of association, and analogy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nine aspects of disease association" .

goldbook:14882 a skos:Concept ;
    skos:definition "Scenario in which one assesses if the contaminants at the waste site pose, or will pose in the future, a risk if left alone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "\"no action\" alternative" .

goldbook:14883 a skos:Concept ;
    skos:definition "Effects that are dependent on the magnitude of the dose in excess of a threshold." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonstochastic health effects" .

goldbook:14884 a skos:Concept ;
    skos:definition "Organisms that are not the intended targets of a particular use of a pesticide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nontarget organisms" .

goldbook:14885 a skos:Concept ;
    skos:altLabel "NOEC" ;
    skos:definition "Special case of the no-observed-effect level (NOEL), commonly used in aquatic toxicology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no-observed-effect concentration" .

goldbook:14886 a skos:Concept ;
    skos:altLabel "NRL" ;
    skos:definition "Maximum dose of a substance at which no specified response is observed in a defined population and under defined conditions of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no-response level" .

goldbook:14887 a skos:Concept ;
    skos:definition "Metameter equal to the normal equivalent deviation (NED). The resulting analysis of dose– or concentration-effect data with the normit metameter is often called normit analysis and is essentially equivalent to probit analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normit" .

goldbook:14888 a skos:Concept ;
    skos:definition "Change in predator or grazer number through increased reproductive output, decreased mortality, or increased immigration in response to changes in prey or food densities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "numerical response" .

goldbook:14889 a skos:Concept ;
    skos:definition "Partition coefficient for a compound between octanol and air. Like \\(K_{\\rm{ow}}\\), it is a measure of lipophilicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "octanol-air partition coefficient" .

goldbook:14890 a skos:Concept ;
    skos:definition "Ratio of the solubility of a chemical in octanol to its solubility in water at equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "octanol-water partition coefficient" .

goldbook:14891 a skos:Concept ;
    skos:definition "Log2 classes (e.g., 1–2, 2–4, 4–8, 8–16, 16–32,... individuals) used in species-abundance curves and representing doubling of the numbers of individuals in a species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "octaves" .

goldbook:14892 a skos:Concept ;
    skos:definition "Naturally occurring nuclear reactors arising through biogeochemical processes approximately 1.8 billion years ago in Oklo (Gabon, Africa)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Oklo natural reactors" .

goldbook:14893 a skos:Concept ;
    skos:definition "Describing an environment having a low concentration of nutrients." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligotrophic" .

goldbook:14894 a skos:Concept ;
    skos:definition "State of being oligotrophic. Obligate or facultative capacity to live in low-nutrient habitats." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligotrophy" .

goldbook:14895 a skos:Concept ;
    skos:definition "Theory that the ideal forager will obtain a maximum net rate of energy gain by optimally allocating its time and energy to the various components of foraging." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optimal-foraging theory" .

goldbook:14896 a skos:Concept ;
    skos:definition "Optimal stress response involves a shift in the balance in energy allocation between somatic growth rate and longevity (survival) to optimize Darwinian fitness under stressful conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optimal stress response" .

goldbook:14897 a skos:Concept ;
    skos:altLabel "ozonosphere" ;
    skos:definition "Part of the Earth’s atmosphere, mainly located in the lower portion of the stratosphere, approximately \\(\\pu{15\\!-\\! 35 km}\\) above the Earth's surface, containing relatively high concentrations (a few micromoles per litre) of ozone (\\(\\ce{O3}\\)) which is higher than concentrations in the lower atmosphere. The thickness varies seasonally and geographically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ozone layer" .

goldbook:14898 a skos:Concept ;
    skos:definition "Branch of science that deals with extinct and fossil humans, animals, and plants, or more generally with evidence of organic life during the geological past." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "palaeontology" .

goldbook:14899 a skos:Concept ;
    skos:definition "Model or template. Body of concepts that, in a particular branch of science, has withstood rigorous testing, and is generally accepted by scientists working in that field as offering true explanations of fact and observation.Note: This usage is derived from the work of the philosopher T. S. Kuhn (1922–1996)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paradigm" .

goldbook:14900 a skos:Concept ;
    skos:definition "Treatment in a toxicity test in which some, but not all, exposed individuals are killed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial kill" .

goldbook:14901 a skos:Concept ;
    skos:definition "Sequence of enzymatic or other reactions by which one biological material is converted to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pathway" .

goldbook:14902 a skos:Concept ;
    skos:definition "Part of the Earth made up of soils and where important soil processes are occurring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pedosphere" .

goldbook:14903 a skos:Concept ;
    skos:definition "Of or relating to the open sea, as distinguished from the shallow water near the coast; dwelling on or near the surface of the open sea or ocean; oceanic. Now chiefly: (Ecology) designating, relating to, or inhabiting that region of the sea which consists of open water of any depth, away from or independent of both the shore and the sea floor (and so contrasted with the littoral and benthic regions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pelagic" .

goldbook:14904 a skos:Concept ;
    skos:definition "Average number of offspring per population member per time unit. Calculated from birth rate \\(B\\) and population size \\(N\\) as \\[b = B/N\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "per capita birth rate" .

goldbook:14905 a skos:Concept ;
    skos:definition "Average number of deaths per population member per time unit. Calculated from death rate \\(D\\) and population size \\(N\\) as \\[m = D/N\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "per capita death rate" .

goldbook:14906 a skos:Concept ;
    skos:definition "Relative increase, \\(r\\), in the population per unit of time expressed per capita. \\[r = b - m\\] where \\(b\\) is per capita birth rate and \\(m\\) is per capita death rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "per capita rate of increase" .

goldbook:14907 a skos:Concept ;
    skos:definition "Matrix of algae, microbes, and detritus attached to submerged surfaces in aquatic ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periphyton" .

goldbook:14908 a skos:Concept ;
    skos:altLabel "PIP" ;
    skos:definition "Inorganic substance that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "persistent inorganic pollutant" .

goldbook:14909 a skos:Concept ;
    skos:altLabel "POP",
        "bioaccumulative chemicals of concern (BCC)" ;
    skos:definition "Organic chemical that is stable in the environment, is liable to long-range transport, may bioaccumulate in human and animal tissue, and may have significant impacts on human health and the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "persistent organic pollutant" .

goldbook:14910 a skos:Concept ;
    skos:definition "Life history." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenology" .

goldbook:14911 a skos:Concept ;
    skos:definition "The duration of illumination and darkness over a \\(\\pu{24\\!\\mbox{-}h}\\) day." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoperiod" .

goldbook:14912 a skos:Concept ;
    skos:definition "Hypothesis that bioavailability is governed by the diffusion of the unionized form of an ionizable substance through the gastrointestinal lumen, as determined by \\(\\pu{p}K_{\\rm{a}}\\) and \\(\\rm{pH}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH-partition hypothesis" .

goldbook:14913 a skos:Concept ;
    skos:definition "Branch of biology that deals with phylogeny, especially with the deduction of the historical relationships between groups of organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phylogenetics" .

goldbook:14914 a skos:Concept ;
    skos:definition "Pattern of historical relationships between species or other groups resulting from divergence during evolution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phylogeny" .

goldbook:14915 a skos:Concept ;
    skos:definition "Taxonomic rank at the level below Kingdom and above Class" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phylum" .

goldbook:14916 a skos:Concept ;
    skos:definition "Change in an organism, in response to changing conditions of the environment, which takes place without any irreversible disruptions of the given biological system and without exceeding normal (homeostatic) capacities of its response. Process by which an organism stabilizes its physiological condition after an environmental change.Note: If this process exceeds the homeostatic range, it becomes pathological and results in symptoms of disease (adverse effects)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "physiological adaptation" .

goldbook:14917 a skos:Concept ;
    skos:definition "Class of cysteine-rich peptides in plants that are induced by and bind to metals. They can function in the regulation and detoxification of metals by plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phytochelatin" .

goldbook:14918 a skos:Concept ;
    skos:definition "Photosynthesizing organisms found in the plankton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phytoplankton" .

goldbook:14919 a skos:Concept ;
    skos:definition "Toxic to plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phytotoxic" .

goldbook:14920 a skos:Concept ;
    skos:definition "Measure of species evenness for a sample from a community. It is calculated from the following equation: \\[{\\rm{Pielouߴs}}\\ J = \\frac{H'}{\\log S}\\] where \\(H'\\) is the Shannon–Wiener diversity measure and \\(S\\) is the average species richness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pielou’s <i>J</i>" .

goldbook:14921 a skos:Concept ;
    skos:definition "Seals, sea lions, and walruses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pinnipeds" .

goldbook:14922 a skos:Concept ;
    skos:definition "Feeding on fish." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "piscivorous" .

goldbook:14923 a skos:Concept ;
    skos:definition "Feeding on plankton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planktivorous" .

goldbook:14924 a skos:Concept ;
    skos:definition "Organisms living suspended in the water column and incapable of moving against water currents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plankton" .

goldbook:14925 a skos:Concept ;
    skos:definition "Planktonic-dispersing larva that derives its nourishment by feeding in the plankton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planktotrophic larva" .

goldbook:14926 a skos:Concept ;
    skos:altLabel "ectotherm",
        "exotherm" ;
    skos:definition "'Cold-blooded organism' (such as an amphibian, reptile, or fish) with a body temperature varying with, but usually slightly higher than, the temperature of its environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poikilotherm" .

goldbook:14927 a skos:Concept ;
    skos:definition "Single emission source in a defined location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "point source" .

goldbook:14928 a skos:Concept ;
    skos:definition "Any undesirable solid, liquid, or gaseous matter occurring, as a result of human activities, in a solid, liquid, or gaseous environmental medium and causing adverse effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pollutant" .

goldbook:14929 a skos:Concept ;
    skos:altLabel "PICT" ;
    skos:definition "Increase in tolerance to pollution resulting from species composition shifts in the community, acclimatization of individuals, and genetic changes in populations in the community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pollution-induced community tolerance" .

goldbook:14930 a skos:Concept ;
    skos:altLabel "PTI" ;
    skos:definition "Means of measuring environmental quality, usually water quality, by determining the presence of indicator species, classified into three groups—sensitive, facultative, and tolerant. Each group is assigned an index value 1, 2, and 3, with the sensitive group having the highest index value. The number of species present from the list included in each group is identified in a representative environmental sample and the group index multiplied by the number of species in the group. The scores for each group are finally added to give the PTI for the environmental medium under consideration. The environmental quality is directly proportional to the value of the index." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pollution tolerance index" .

goldbook:14931 a skos:Concept ;
    skos:definition "Control of a phenotypic trait by several genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polygenic control" .

goldbook:14932 a skos:Concept ;
    skos:definition "In ecology, any group of interacting and interbreeding organisms of the same species occupying a given area at the same time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population" .

goldbook:14933 a skos:Concept ;
    skos:definition "Total mass or weight of organisms in a population, given by the sum of the masses (or weights) of all the individual members of the population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population biomass" .

goldbook:14934 a skos:Concept ;
    skos:definition "Changes in the numbers of individuals in a population that repeatedly oscillate between periods of high and low density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population cycle" .

goldbook:14935 a skos:Concept ;
    skos:altLabel "PD" ;
    skos:definition "Number of individuals divided by area (\\(\\pu{m-2}\\)) or volume (\\(\\pu{m-3}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population density" .

goldbook:14936 a skos:Concept ;
    skos:definition "Variations in time and space in the sizes and densities of populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population dynamics" .

goldbook:14937 a skos:Concept ;
    skos:definition "Study of the variations in time and space in the sizes and densities of populations, and of the factors causing these variations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population ecology" .

goldbook:14938 a skos:Concept ;
    skos:definition "Variations over time in the size of a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population fluctuation" .

goldbook:14939 a skos:Concept ;
    skos:definition "Change in population size \\(\\Delta N\\) during a specified time period \\(\\Delta t\\) \\[\\Delta N/\\Delta t = (b - d)N\\] where \\(N\\) is population size, \\(b\\) is per capita birth rate, and \\(d\\) is per capita death rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population growth rate" .

goldbook:14940 a skos:Concept ;
    skos:definition "Diagrammatic illustration of the age structure of a population by depicting the youngest age class at the base and stacking successive age classes above it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population pyramid" .

goldbook:14941 a skos:Concept ;
    skos:definition "Total number of organisms in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population size" .

goldbook:14942 a skos:Concept ;
    skos:definition "Biodegradation test that simulates the continuous activated sludge (sewage treatment) system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porous pot test" .

goldbook:14943 a skos:Concept ;
    skos:definition "Approach to risk management that can be applied in circumstances of scientific uncertainty, reflecting a perceived need to take action in the face of a potentially serious risk without waiting for definitive results of scientific research." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precautionary principle" .

goldbook:14944 a skos:Concept ;
    skos:altLabel "PEC",
        "estimated environmental concentration (EEC)",
        "expected environmental concentration (EEC)" ;
    skos:definition "Concentration of a substance likely to be found in an environmental compartment calculated from estimates of quantities released, discharge patterns, and inherent disposition of the substance (fate and distribution) as well as the nature of the specific receiving ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predicted environmental concentration" .

goldbook:14945 a skos:Concept ;
    skos:altLabel "PNEC" ;
    skos:definition "Concentration that is expected to cause no adverse effect to any naturally occurring population in an environment at risk from exposure to a given substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predicted no-effect concentration" .

goldbook:14946 a skos:Concept ;
    skos:altLabel "prospective risk assessment" ;
    skos:definition "Risk assessment performed for a proposed future action, such as the use of a new chemical or the release of a new effluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predictive risk assessment" .

goldbook:14947 a skos:Concept ;
    skos:definition "Number of instances of existing cases of a given disease or other condition in a given population at a designated time; sometimes used to mean prevalence rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prevalence" .

goldbook:14948 a skos:Concept ;
    skos:altLabel "prevalence ratio" ;
    skos:definition "Total number of individuals who have an attribute or disease at a particular time (or during a particular period) divided by the population at risk of having the attribute or disease at this point in time or midway through the period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prevalence rate" .

goldbook:14949 a skos:Concept ;
    skos:altLabel "filaments" ;
    skos:definition "Gill structures extending outward at right angles from the branchial arches." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary lamellae" .

goldbook:14950 a skos:Concept ;
    skos:definition "Organism capable of using the energy derived from light or a chemical substance in order to manufacture energy-rich organic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary producer" .

goldbook:14951 a skos:Concept ;
    skos:definition "Sequential colonization by species which begin to colonize the bare ground and modify the environmental conditions after a region is completely denuded; e.g., behind a retreating glacier, early colonizing organisms provide the soils needed by succeeding organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary succession" .

goldbook:14952 a skos:Concept ;
    skos:altLabel "concept of strategy" ;
    skos:definition "Concept that there exists a cost or trade-off to every allocation of energy resources. Energy spent by an individual organism on one function, process, or structure cannot be spent on another. Optimal allocation of resources enhances Darwinian fitness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principle of allocation" .

goldbook:14953 a skos:Concept ;
    skos:definition "Probability unit obtained by adding 5 to the normal deviates of a standardized normal distribution of results from a dose-response study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "probit" .

goldbook:14954 a skos:Concept ;
    skos:definition "Probability unit obtained from the standardized normal distribution plotted against the logarithm of the concentration or dose of a substance when a quantal or graded response has been measured. A linear plot provides evidence that the distribution is log-normal. Estimates of the \\(\\pu{L(E)C_{50}}\\) and \\(\\pu{L(E)D_{50}}\\), as well as the standard deviation for the distribution, can then be made." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "probit log transform" .

goldbook:14955 a skos:Concept ;
    skos:definition "Planning and scoping phase that establishes the framework around which the risk assessment is done." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "problem formulation" .

goldbook:14956 a skos:Concept ;
    skos:altLabel "Kaplan–Meier method" ;
    skos:definition "Nonparametric method for analyzing time-to-death or survival-time data that does not require a specific model for the survival curve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product-limit method" .

goldbook:14957 a skos:Concept ;
    skos:definition "Multiplication, i.e., an increase by frequent and repeated reproduction or growth by cell division." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proliferation" .

goldbook:14958 a skos:Concept ;
    skos:definition "Portion of a plant, fungus, etc., that is capable, when detached, of giving rise to a new individual by asexual reproduction (e.g., a cutting, leaf bud, bulbil, seed, or spore). Less commonly, any of the products of asexual reproduction in certain invertebrates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "propagule" .

goldbook:14959 a skos:Concept ;
    skos:definition "Relative to metapopulation dynamics, the presence of a seed bank or dormant stage for a species that continually introduces individuals to the patch regardless of the density of occupancy in the surrounding patches. This propagule rain increases the likelihood of population reappearance and decreases the likelihood of patch extinction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "propagule rain" .

goldbook:14960 a skos:Concept ;
    skos:definition "False assertion that any particular level of biological organization holds a more central or important role than any other in the science of ecotoxicology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ptolemaic incongruity" .

goldbook:14961 a skos:Concept ;
    skos:definition "Describing anything that causes fire. Describing products of fire; e.g., organic compounds produced by the high-temperature combustion of complex organic substances are pyrogenic compounds.Examples: Polycyclic aromatic hydrocarbons (PAHs) are examples of pyrogenic compounds. Describing a substance that produces fever." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrogenic" .

goldbook:14962 a skos:Concept ;
    skos:definition "Quality guidelines based on the evaluation of scientific data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality criteria" .

goldbook:14963 a skos:Concept ;
    skos:definition "Numerical limits or text statements established to support and maintain designated uses of the environment or to protect human health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality guidelines" .

goldbook:14964 a skos:Concept ;
    skos:definition "Fixed upper limits for exposure to certain chemicals recognized under law by one or more levels of government. Well-known examples include the air, water, and soil quality standards, as well as threshold limit values for air pollutants in the workplace." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality standards" .

goldbook:14965 a skos:Concept ;
    skos:altLabel "all-or-none effect" ;
    skos:definition "Condition that can be expressed only as 'occurring' or 'not occurring', such as death or occurrence of a tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantal effect" .

goldbook:14966 a skos:Concept ;
    skos:altLabel "QSMR" ;
    skos:definition "Quantitative association between the physicochemical and (or) the structural properties of a substance and its metabolic behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitative structure–metabolism relationship" .

goldbook:14967 a skos:Concept ;
    skos:definition "Calculation of the quotient of the measured or predicted environmental concentration (PEC) of a contaminant and the predicted no-effect level (PNEC), used as an expression of hazard or risk. Higher quotients constitute greater evidence of a hazard or a greater risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quotient method" .

goldbook:14968 a skos:Concept ;
    skos:definition "Removal of pollutants from air by incorporation into developing rain droplets of rain clouds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rain-out" .

goldbook:14969 a skos:Concept ;
    skos:definition "Estimate of species richness (\\(S\\)) expressed relative to that of a sample having a standard number of individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rarefaction estimate of richness" .

goldbook:14970 a skos:Concept ;
    skos:definition "Compartment model that employs rate constants to quantify the rate of change in concentration or amount of toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate constant-based model" .

goldbook:14971 a skos:Concept ;
    skos:definition "Theory that the total metabolic expenditure of a genotype is generally fixed, and longevity depends on the rate of energy expenditure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate-of-living theory of aging" .

goldbook:14972 a skos:Concept ;
    skos:altLabel "RR" ;
    skos:definition "Value obtained by dividing the rate in an exposed population by the rate in an unexposed population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate ratio" .

goldbook:14973 a skos:Concept ;
    skos:definition "Portion of a species’ fundamental niche that it actually occupies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "realised niche" .

goldbook:14974 a skos:Concept ;
    skos:definition "Semiquantitative term referring to the lower portion of the high end of the exposure, dose, or risk distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reasonable worst case" .

goldbook:14975 a skos:Concept ;
    skos:altLabel "RME" ;
    skos:definition "Highest exposure that is reasonably expected to occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reasonable maximum exposure" .

goldbook:14976 a skos:Concept ;
    skos:definition "Surface water (e.g., in a stream, river, or lake) that has received, or is about to receive, a discharged waste (i.e., the surface water immediately around the discharge point)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "receiving water" .

goldbook:14977 a skos:Concept ;
    skos:definition "Maximum concentration of a potentially toxic substance that is expected to be safe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recommended limit" .

goldbook:14978 a skos:Concept ;
    skos:definition "De-ionized or glass-distilled water to which reagent-grade chemicals have been added. The resultant synthetic freshwater is expected to be free from contaminants and have the desired \\(\\rm{pH}\\) and hardness characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reconstituted water" .

goldbook:14979 a skos:Concept ;
    skos:definition "Hypothesis that many species are redundant, and their loss will not influence the community function as long as crucial (e.g., keystone and dominant) species populations are maintained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redundancy hypothesis" .

goldbook:14980 a skos:Concept ;
    skos:definition "Generalized description of the environment into which contaminants will be released and in which organisms will be exposed. Reference environments are used when there is no specific site at risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference environment" .

goldbook:14981 a skos:Concept ;
    skos:definition "Whole sediment near an area of concern used to assess sediment conditions in the absence of substances of concern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference sediment" .

goldbook:14982 a skos:Concept ;
    skos:definition "Relatively unpolluted site used for comparison with polluted sites in environmental monitoring studies, often incorrectly referred to as a control site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference site" .

goldbook:14983 a skos:Concept ;
    skos:definition "Chemical used in an aquatic toxicity test as a positive control in contrast to the negative control provided by exposure water without the test chemical. Information collected is used to determine the general health and viability of the test organisms and assess consistency in testing protocol implementation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference toxicant" .

goldbook:14984 a skos:Concept ;
    skos:definition "Test conducted in conjunction with sediment tests to determine possible changes in condition of the test species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference toxicity test" .

goldbook:14985 a skos:Concept ;
    skos:definition "Area of the Earth’s surface differentiated by its specific characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "region" .

goldbook:14986 a skos:Concept ;
    skos:altLabel "RR",
        "risk ratio" ;
    skos:definition "Ratio of the risk of disease or death among the exposed to the risk among the unexposed. Ratio of the cumulative incidence rate in the exposed to the cumulative incidence rate in the unexposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative risk" .

goldbook:14987 a skos:Concept ;
    skos:altLabel "RI" ;
    skos:definition "Study that has three parts: characterization or the type and degree of the contamination, human risk assessment, and ecological risk assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "remedial investigation" .

goldbook:14988 a skos:Concept ;
    skos:altLabel "RI/FS" ;
    skos:definition "For an EPA Superfund site, a study that has as its goal the implementation of 'remedies that reduce, control, or eliminate risks to human health and the environment' or, more specifically, the accumulation of 'information sufficient to support an informed risk management decision regarding which remedy appears to be most appropriate for a given site'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "remedial investigation and feasibility study" .

goldbook:14989 a skos:Concept ;
    skos:definition "Giving a remedy. Removal of pollution or contaminants from environmental media such as soil, groundwater, sediment, or surface water for the general protection of human health and the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "remediation" .

goldbook:14990 a skos:Concept ;
    skos:definition "Technologies that allow the acquisition and analysis of data without requiring physical contact with the land or water surface being studied. Most determine qualities or characteristics of areas of interest based on measurements of visible light, infrared radiation, or radio energy coming from them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "remote sensing" .

goldbook:14991 a skos:Concept ;
    skos:definition "Expected contribution of offspring during the life of an individual of an age class \\(x\\) in a life table." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproductive value" .

goldbook:14992 a skos:Concept ;
    skos:definition "Increased probability of a vacated-patch reoccupation in a metapopulation as the number of nearby, occupied patches increases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rescue effect" .

goldbook:14993 a skos:Concept ;
    skos:definition "Ability of a community to maintain its structure and function in the face of disturbance, and to reorganize following disturbance-driven change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resilience" .

goldbook:14994 a skos:Concept ;
    skos:definition "Observed effect of the properties of persistent organic pollutants (POPs) with high lipophilicity which causes them to be bound more firmly than less lipophilic POPs in solid phases such as soil and vegetation; consequently, they spend less time in the atmosphere and are less available for transport in that medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention effect" .

goldbook:14995 a skos:Concept ;
    skos:altLabel "retroactive risk assessment" ;
    skos:definition "Risk assessment dealing with an existing condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retrospective risk assessment" .

goldbook:14996 a skos:Concept ;
    skos:altLabel "round-robin test" ;
    skos:definition "Part of an external quality assurance program for assessment of an analytical method or test. A reference institute sends identical samples, which have to be analyzed or tested for specified parameters, to a number of different laboratories. The laboratory has a deadline before which to provide results. Statistical evaluation and interpretation of the results permits assessment of the reliability of the methods used and a comparison of the laboratories’ proficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring test" .

goldbook:14997 a skos:Concept ;
    skos:definition "Interface between land and a flowing body of surface water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "riparian" .

goldbook:14998 a skos:Concept ;
    skos:definition "Process for controlling situations where an organism, system, or subpopulation could be exposed to a hazard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk analysis" .

goldbook:14999 a skos:Concept ;
    skos:definition "Outcome of hazard identification and risk estimation applied to a specific use of a substance or occurrence of an environmental health hazard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk characterisation" .

goldbook:15000 a skos:Concept ;
    skos:definition "Clear statements of postulated or predicted adverse effects of a toxicant on an assessment endpoint." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk hypotheses" .

goldbook:15001 a skos:Concept ;
    skos:definition "Agent, medium, process, procedure, or site with the potential to cause an adverse effect or effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk source" .

goldbook:15002 a skos:Concept ;
    skos:definition "Ratio of predicted exposure concentration (PEC) to predicted no-effect concentration (PNEC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk quotient" .

goldbook:15003 a skos:Concept ;
    skos:definition "Taking measures to protect humans or the environment against identified risks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk reduction" .

goldbook:15004 a skos:Concept ;
    skos:definition "Hypothesis that each species in a community contributes to its proper functioning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rivet popper hypothesis" .

goldbook:15005 a skos:Concept ;
    skos:definition "Opportunistic strategy favoring species that establish themselves quickly, grow quickly to exploit as many resources as possible, and produce many offspring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "r-strategy" .

goldbook:15006 a skos:Concept ;
    skos:definition "Fox’s rules of practical causal inference that are used in ecotoxicology (environmental epidemiology) to infer causality for toxicant exposure/effect scenarios." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rules of practical causal inference" .

goldbook:15007 a skos:Concept ;
    skos:definition "Portion of the wet precipitation on the land that ultimately reaches streams and, eventually, the sea." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "run-off" .

goldbook:15008 a skos:Concept ;
    skos:definition "Concentration of a substance to which prolonged exposure will cause no adverse effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "safe concentration" .

goldbook:15009 a skos:Concept ;
    skos:definition "Mass of dissolved salts in seawater, brackish water, brine, or other saline solution divided by the mass of the solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salinity" .

goldbook:15010 a skos:Concept ;
    skos:altLabel "STI" ;
    skos:definition "Quotient calculated as total plant (shoot + root) dry mass at different salt concentrations compared to the total plant dry mass obtained for the controls, as indicated below: \\[S_{\\rm{T}} = m_{\\rm{d}}({\\rm{x}})/m_{\\rm{d}}({\\rm{i}})\\] where \\(m_{\\rm{d}}\\) is the total dry mass, and \\(x\\), \\(i\\) refer to a control treatment and a defined salt treatment, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salt tolerance index" .

goldbook:15011 a skos:Concept ;
    skos:definition "Living in or being an environment rich in organic matter but lacking oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saprobic" .

goldbook:15012 a skos:Concept ;
    skos:definition "Means of classifying the saprobic state of running waters, covering the full range from unpolluted to extremely polluted waters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saprobic index" .

goldbook:15013 a skos:Concept ;
    skos:definition "Biological classification of water quality according to five categories: oligosaprobic: clear, with no or only slight pollution and high dissolved oxygen (DO) content; p-mesosaprobic: moderately polluted with still high DO content; x-mesosaprobic: polluted with not very high DO content; polysaprobic: strongly polluted, with negligible DO content; and antisaprobic: so polluted that no living organism is capable of living in the water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saprobic water classification" .

goldbook:15014 a skos:Concept ;
    skos:definition "Characteristic change in community composition at different distances below the discharge of putrescible organic waste to a river or stream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saprobien spectrum" .

goldbook:15015 a skos:Concept ;
    skos:definition "Organisms or groups of organisms treated in a similar fashion to those in standard toxicity tests for the purpose of special additional studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "satellite groups" .

goldbook:15016 a skos:Concept ;
    skos:definition "Index (\\(P\\) = production) calculated as the amount of energy taken into the organism in its food (\\(A\\)) minus the energy used for respiration (\\(R\\)) and excretion (\\(U\\)): \\[P = A - R - U\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scope for growth" .

goldbook:15017 a skos:Concept ;
    skos:definition "Difference between the rates of oxygen consumption of an organism under maximal and minimal activity levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scope of activity" .

goldbook:15018 a skos:Concept ;
    skos:definition "Decision limit or cut-off point at which a screening test is regarded as positive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "screening level" .

goldbook:15019 a skos:Concept ;
    skos:altLabel "preliminary test",
        "range-finding test" ;
    skos:definition "Test conducted to estimate the concentrations to be used for a definitive test. Acute test used early in a testing program to evaluate the potential of a substance to produce a given adverse effect (e.g., mortality)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "screening test" .

goldbook:15020 a skos:Concept ;
    skos:altLabel "respiratory lamellae" ;
    skos:definition "Parallel rows of projections on the dorsal and ventral sides of each primary lamella of the fish gill. They are the primary sites of gas exchange of the gills." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary lamellae" .

goldbook:15021 a skos:Concept ;
    skos:definition "Poisoning of a predator as a result of eating prey that has accumulated a toxicant as a result of biomagnification through its food chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary poisoning" .

goldbook:15022 a skos:Concept ;
    skos:definition "Microbial growth on a nutrient substrate while transforming another substrate without gaining energetic benefit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary substrate metabolism" .

goldbook:15023 a skos:Concept ;
    skos:definition "Sequential appearance of species following major changes to an established ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary succession" .

goldbook:15024 a skos:Concept ;
    skos:definition "Components of the life cycle of an individual upon which natural selection can act. They are viability selection, sexual selection, meiotic drive, gametic selection, and fecundity selection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selection components" .

goldbook:15025 a skos:Concept ;
    skos:definition "Syndrome named for Hans Selye (1907–1982) that consists of all the nonspecifically induced changes within a biological system following and during environmental stress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Selyean stress" .

goldbook:15026 a skos:Concept ;
    skos:definition "Species that reproduces once." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semelparous species" .

goldbook:15027 a skos:Concept ;
    skos:altLabel "SCAS",
        "SCAS test" ;
    skos:definition "Test for inherent biodegradability of organic substances in activated sludge by measurement of the decrease in dissolved oxygen content (DOC) in the test system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-continuous activated sludge test" .

goldbook:15028 a skos:Concept ;
    skos:definition "Feral, caged, or endemic species used in measuring and indicating the level of contamination or effect during a biomonitoring exercise." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sentinel species" .

goldbook:15029 a skos:Concept ;
    skos:definition "Minute living organisms and particles of nonliving matter that float in water and contribute to turbidity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seston" .

goldbook:15030 a skos:Concept ;
    skos:definition "Natural selection involving differential mating success of individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sexual selection" .

goldbook:15031 a skos:Concept ;
    skos:definition "Index based on the assumption that all species are represented in the sample studied and that the sample was obtained randomly, giving the following mathematical relationship: \\[H = -\\sum \\limits_{i=1}^S p_{i} \\log p_{i}\\] where \\(p_{i}\\) is the fraction of individuals belonging to the \\(i\\)-th species and \\(S\\) is the number of species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shannon–Wiener diversity index" .

goldbook:15032 a skos:Concept ;
    skos:definition "Species’ tolerance(s) along an environmental gradient (or series of environmental gradients) will determine its population distribution and size in the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Shelford’s law of tolerance" .

goldbook:15033 a skos:Concept ;
    skos:definition "Sediment particles with a grain size between \\(\\pu{0.004 mm}\\) and \\(\\pu{0.062 mm}\\), i.e., coarser than clay particles but finer than sand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silt" .

goldbook:15034 a skos:Concept ;
    skos:definition "Dominance index weighted toward the abundance of the most common species, giving the probability of any two individuals drawn at random from an infinitely large community belonging to different species. The bias corrected mathematical form of Simpson’s index is \\[D = \\sum \\limits_{i=1}^{S} p_{i}^{2}\\] where \\(p_{i}\\) is the fraction of all organisms which belong to the \\(i\\)-th species and \\(S\\) is the number of species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Simpson’s diversity index" .

goldbook:15035 a skos:Concept ;
    skos:definition "Experimental ecosystem that should be: physically confined; self-maintaining; multitrophic; have a duration time exceeding the generation time of the penultimate trophic level present; and of size sufficient to enable pertinent sampling and measurements to be made without seriously influencing the structure and dynamics of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simulated field studies" .

goldbook:15036 a skos:Concept ;
    skos:definition "Naturally occurring, unconsolidated mineral and (or) organic material at the surface of the Earth that is capable of supporting plant growth. It extends from the surface to \\(\\pu{15 cm}\\) below the depth at which properties produced by soil-forming processes can be detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soil" .

goldbook:15037 a skos:Concept ;
    skos:definition "Movement of a solute (e.g., a contaminant) along with the bulk movement of the solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent drag" .

goldbook:15038 a skos:Concept ;
    skos:definition "Death of an individual organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic death" .

goldbook:15039 a skos:Concept ;
    skos:definition "Risk of an adverse effect to the exposed individual associated with genetic damage to somatic cells, e.g., damage leading to cancer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "somatic risk" .

goldbook:15040 a skos:Concept ;
    skos:definition "Noncommittal term used instead of adsorbate or absorbate when the sorption process is undefined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorbate" .

goldbook:15041 a skos:Concept ;
    skos:definition "Quantity describing the distribution of a substance between a solvent and a sorbent, typically water and sediment, at equilibrium, e.g., \\[K_{\\rm{d}} = [\\pu{C(sediment)}]/[\\pu{C(water)}]\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorption constant" .

goldbook:15042 a skos:Concept ;
    skos:definition "Estimate of the total amount released, or the temporal pattern of the rate of release, of a pollutant from a source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "source term" .

goldbook:15043 a skos:Concept ;
    skos:definition "Nonparametric method to estimate the \\(\\pu{LC_{50}}\\), \\(\\pu{EC_{50}}\\), or \\(\\pu{LD_{50}}\\) when it is difficult or unnecessary to assume a specific model for the dose- or concentration effect data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Spearman–Karber method" .

goldbook:15044 a skos:Concept ;
    skos:definition "Common pattern in which the number of species on islands decreases as island area decreases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species–area relationship" .

goldbook:15045 a skos:Concept ;
    skos:definition "Operationally defined subset of the entire community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species assemblage" .

goldbook:15046 a skos:Concept ;
    skos:definition "Tendency in a model community for the remaining species to remain at locally stable equilibria after a species is made extinct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species–deletion stability" .

goldbook:15047 a skos:Concept ;
    skos:definition "Quantitative or qualitative differences of response to the action(s) of a potentially toxic substance on various species of living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species differences in sensitivity" .

goldbook:15048 a skos:Concept ;
    skos:definition "Heterogeneity of an ecological community, considering both species richness (\\(S\\)) and species evenness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species diversity" .

goldbook:15049 a skos:Concept ;
    skos:definition "Degree to which the individuals in the community are evenly or uniformly distributed among species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species evenness" .

goldbook:15050 a skos:Concept ;
    skos:definition "Change in the species numbers or diversity in an ecosystem, or in their interactions, which results in change in ecological character and its functions and attributes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species imbalance" .

goldbook:15051 a skos:Concept ;
    skos:definition "Total number of species in an ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species richness" .

goldbook:15052 a skos:Concept ;
    skos:altLabel "SSD" ;
    skos:definition "Statistical relationship between exposure concentration and a defined effect derived from a combination of single-species test data to predict concentrations affecting only a certain percentage of the total number of species in a defined community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species sensitivity distribution" .

goldbook:15053 a skos:Concept ;
    skos:definition "Quantitative and qualitative features of response to the action(s) of a potentially toxic substance that are characteristic for a particular species of living organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species-specific sensitivity" .

goldbook:15054 a skos:Concept ;
    skos:altLabel "specific activity concept" ;
    skos:definition "Assumption made in radiotracer usage concerning specificity of action of a radionuclide used to trace or quantify the movement of a stable nuclide (e.g., \\(\\ce{^{14}C}\\) for stable \\(\\ce{C}\\)), implying that the radionuclide behaves identically in chemical and biological processes to its nonradioactive analog (e.g., stable \\(\\ce{C}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific action concept" .

goldbook:15055 a skos:Concept ;
    skos:altLabel "SB",
        "SB approach" ;
    skos:definition "Sediment toxicity test method to generate a concentration response model for effects to individuals placed in sediments spiked with different amounts of toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spiked bioassay approach" .

goldbook:15056 a skos:Concept ;
    skos:definition "Hypothesis that toxic effects of metals will begin to occur after the metal concentration exceeds the capacity of the amount of metallothionein present to bind the metal. The unbound metals then 'spill over' to interact at sites of adverse action. This is based on the assumption that binding by metallothionein sequesters toxic metals away from sites of action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spillover hypothesis" .

goldbook:15057 a skos:Concept ;
    skos:definition "Abundance of relative age classes that a population approaches if it is allowed to grow exponentially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable age distribution" .

goldbook:15058 a skos:Concept ;
    skos:definition "Population with a constant distribution of individuals among the various age classes and a zero growth rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable population" .

goldbook:15059 a skos:Concept ;
    skos:definition "That which is established as a measure or model to which others of a similar nature should conform." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard" .

goldbook:15060 a skos:Concept ;
    skos:altLabel "technical directive" ;
    skos:definition "Technical specification, usually in the form of a document available to the public, drawn up with the consensus or general approval of all interests affected by it, based on the consolidated results of science, technology, and experience, aimed at the promotion of optimum community benefits and approved by a body recognized on the national, regional, or international level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard" .

goldbook:15061 a skos:Concept ;
    skos:altLabel "batch-replacement test",
        "renewal test",
        "renewed static test",
        "semi-static test",
        "static-replacement test" ;
    skos:definition "Modified static aquatic toxicity test in which solutions are completely or partially replaced with new solutions at set periods during exposures or in which organisms are periodically transferred to new solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static-renewal test" .

goldbook:15062 a skos:Concept ;
    skos:definition "Aquatic toxicity test in which the exposure water is not changed during the test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static-toxicity test" .

goldbook:15063 a skos:Concept ;
    skos:definition "Process by which materials form or are deposited in layers, as in sedimentary rocks and some igneous rocks. The atmosphere and the ocean also exhibit stratification, with the warmer air or water occupying the upper layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratification" .

goldbook:15064 a skos:Concept ;
    skos:definition "Sampling of individual subgroups (strata) of a population after its division into homogeneous strata." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratified sampling" .

goldbook:15065 a skos:Concept ;
    skos:definition "Any condition that results in reduced growth of an organism or that prevents an organism from realizing its 'genetic potential'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress" .

goldbook:15066 a skos:Concept ;
    skos:definition "Any physical, chemical, or biological factor causing an adverse response on any component of an ecosystem." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stressor" .

goldbook:15067 a skos:Concept ;
    skos:definition "Proposed use of the patterns of stress-protein induction seen in the field to suggest the particular toxicant inducing the response, after patterns from organisms sampled in the field are compared with those obtained with single-candidate toxicants in the laboratory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress-protein fingerprinting" .

goldbook:15068 a skos:Concept ;
    skos:definition "Several classes of proteins coded by genes transcriptionally activated by acute stresses, generally serving a protective or adaptive function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress proteins" .

goldbook:15069 a skos:Concept ;
    skos:definition "Theory that stress shortens longevity by accelerating energy expenditure. Selection takes place for resistance to stress, and as an epiphenomenon, individuals resistant to stress will predominate in extreme age classes of a population. The diminution of homeostasis under stress with age should be slowest in individuals with highest longevity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress theory of aging" .

goldbook:15070 a skos:Concept ;
    skos:definition "Range of types of physical structure in a community that may provide habitats for species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural diversity" .

goldbook:15071 a skos:Concept ;
    skos:altLabel "SMR" ;
    skos:definition "Association between the physicochemical and (or) the structural properties of a substance and its metabolic behavior." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure–metabolism relationship" .

goldbook:15072 a skos:Concept ;
    skos:definition "Biodegradation test based on the measurement of \\(\\ce{CO2}\\) production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sturm test" .

goldbook:15073 a skos:Concept ;
    skos:definition "Organism that lives only in groundwater." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stygobiont" .

goldbook:15074 a skos:Concept ;
    skos:definition "Organism that lives in groundwater and in surface water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stygophile" .

goldbook:15075 a skos:Concept ;
    skos:definition "Term applied to a substance that is a liquid at a temperature lower than the saturation temperature for the existing pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subcooled" .

goldbook:15076 a skos:Concept ;
    skos:definition "Vapor pressure of a subcooled liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subcooled liquid vapour pressure" .

goldbook:15077 a skos:Concept ;
    skos:definition "Orderly sequential progression of changes in community composition that occurs during development of new populations in any area, from initial colonization to the attainment of the climax typical of a particular geographic area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "succession" .

goldbook:15078 a skos:Concept ;
    skos:definition "Term describing a substance that persists as a liquid at a temperature below its freezing point without solidification or crystallization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercooled" .

goldbook:15079 a skos:Concept ;
    skos:definition "Test organism, or population that is cultured under laboratory conditions to serve as a substitute in toxicity testing for indigenous organisms, communities, or populations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surrogate organism" .

goldbook:15080 a skos:Concept ;
    skos:definition "Relatively well-studied substance whose properties are assumed to apply to an entire chemically and toxicologically related class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surrogate toxicant" .

goldbook:15081 a skos:Concept ;
    skos:definition "Systematic ongoing collection, collation, and analysis of data and the timely dissemination of information to those who need to know in order that action can be taken to initiate investigative or control measures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surveillance" .

goldbook:15082 a skos:Concept ;
    skos:definition "Time interval between initial exposure of an organism to a harmful substance and death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "survival time" .

goldbook:15083 a skos:Concept ;
    skos:definition "Proportion of animals surviving between two specified ages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "survivorship" .

goldbook:15084 a skos:Concept ;
    skos:definition "Graph showing how survivorship from birth varies with age." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "survivorship curve" .

goldbook:15085 a skos:Concept ;
    skos:definition "Condition of an organism or ecological system that makes it more vulnerable to a given exposure than the majority of the population or group of ecological systems to which it belongs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "susceptibility" .

goldbook:15086 a skos:Concept ;
    skos:altLabel "filter feeder" ;
    skos:definition "Animal that feeds by straining suspended matter and food particles from water, typically by passing the water over a specialized structure, such as the baleen of baleen whales." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension feeder" .

goldbook:15087 a skos:Concept ;
    skos:definition "Describing mineral deposits formed at the same time as the enclosing rocks; characterized by or pertaining to a formation contemporaneous with the enclosing or surrounding rock." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syngenetic" .

goldbook:15088 a skos:Concept ;
    skos:altLabel "taxonomy" ;
    skos:definition "Study of the diversity of past and present life forms and of relationships among them through time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systematics" .

goldbook:15089 a skos:Concept ;
    skos:definition "Taxonomically defined subset of an entire community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "taxocene" .

goldbook:15090 a skos:Concept ;
    skos:definition "Science applied to the allocation of biological names and the rules of naming." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "taxonomy" .

goldbook:15091 a skos:Concept ;
    skos:definition "Capable of causing nonheritable permanent structural malformations or defects in the offspring of an exposed parent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "teratogenic" .

goldbook:15092 a skos:Concept ;
    skos:definition "Relating to land, as distinct from water or air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "terrestrial" .

goldbook:15093 a skos:Concept ;
    skos:altLabel "TEC" ;
    skos:definition "Concentration calculated as the geometric mean of no-observed-effect concentration (NOEC) and lowest-observed-effect concentration (LOEC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold-effect concentration" .

goldbook:15094 a skos:Concept ;
    skos:definition "Theory that, for a given substance, no toxic effect can occur below a defined low dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold theory" .

goldbook:15095 a skos:Concept ;
    skos:definition "Structured approach to assessment of the fate and effects of substances, where a tier of relatively simple tests is used initially to select substances of concern and to define their toxicity. If the information from these tests is inadequate for regulatory decisions, further more complex tests (higher tier tests) may be required. For example, under a tiered structure, testing might progress from acute studies to chronic laboratory studies to field studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tiered testing" .

goldbook:15096 a skos:Concept ;
    skos:altLabel "TI",
        "TI test" ;
    skos:definition "Acute toxicity test with no predetermined temporal endpoint." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-independent test" .

goldbook:15097 a skos:Concept ;
    skos:altLabel "TI" ;
    skos:definition "Quotient of an adequate parameter acquired under treated and control environments, multiplied by \\(\\pu{100}\\), thus: \\[\\rm{TI} = (\\rm{parameter\\ treated}/\\rm{parameter\\ control}) \\times 100\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerance index" .

goldbook:15098 a skos:Concept ;
    skos:definition "Approach to investigating ecotoxicological effects that starts with a determination of the presence and nature of any adverse effects via responses at community and ecosystem levels of organization rather than the suborganismal levels of organization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "top-down ecotoxicological study" .

goldbook:15099 a skos:Concept ;
    skos:altLabel "TOC" ;
    skos:definition "Organic matter content of soil, sediment, or water determined by measurement of organic carbon as the ratio of mass of organic carbon/mass of solid or of water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total organic carbon" .

goldbook:15100 a skos:Concept ;
    skos:definition "Able to cause injury to living organisms as a result of physicochemical interaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxic" .

goldbook:15101 a skos:Concept ;
    skos:altLabel "TU",
        "toxicity unit" ;
    skos:definition "Dose or concentration of a toxicant expressed in units of lethality such as units of \\(\\pu{LD_{50}}\\) or \\(\\pu{LC_{50}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxic unit" .

goldbook:15102 a skos:Concept ;
    skos:definition "Curve obtained by plotting the median survival times of a group of test organisms against the concentration of a substance on a logarithmic scale." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity curve" .

goldbook:15103 a skos:Concept ;
    skos:altLabel "TEF" ;
    skos:definition "Ratio of the toxicity of a chemical to that of another structurally related chemical (or index compound) chosen as a reference. In risk assessment, ratio of the toxicity of a chemical to that of another structurally related chemical (or index compound) chosen as a reference. Factor used to estimate the toxicity of a complex mixture, commonly a mixture of chlorinated dibenzo-p-dioxins [oxanthrenes], furans, and biphenyls: in this case, TEF is based on relative toxicity to 2,3,7,8-tetrachlorodibenzo-p-dioxin [2,3,7,8-tetrachlorooxanthrene] for which the \\(f = 1\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity equivalency factor" .

goldbook:15104 a skos:Concept ;
    skos:altLabel "TEQ" ;
    skos:definition "Contribution of a specified component (or components) to the toxicity of a mixture of related substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity equivalent" .

goldbook:15105 a skos:Concept ;
    skos:altLabel "TIE" ;
    skos:definition "Systematic pretreatment (e.g., \\(\\rm{pH}\\) change, filtration, or aeration) of a sample to obtain defined fractions that are subsequently tested for their toxicity. This fractionation is designed to separate out defined substances and thus to identify the agent(s) primarily responsible for lethal or sublethal toxicity of a complex mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity identification and evaluation" .

goldbook:15106 a skos:Concept ;
    skos:definition "Factor used to estimate risk. It may be a reference dose or it may be calculated from the following equation: \\[T_{\\rm{x}} = m\\ C\\] where \\(m\\) is the slope of a published dose-effect relationship and \\(C\\) is the toxicant concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity value" .

goldbook:15107 a skos:Concept ;
    skos:altLabel "micronutrient" ;
    skos:definition "Substance required in very small quantities by a defined organism to maintain health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trace nutrient" .

goldbook:15108 a skos:Concept ;
    skos:definition "Exchange of one advantageous character for another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trade-off" .

goldbook:15109 a skos:Concept ;
    skos:definition "Criteria applied to results from tests (for fate or effects) which prompt further studies, e.g., moving to the next tier of tests, which are generally more complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trigger values" .

goldbook:15110 a skos:Concept ;
    skos:definition "Relating to nutrition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic" .

goldbook:15111 a skos:Concept ;
    skos:definition "Situation arising when predators in a food chain suppress the abundance of their prey, thereby releasing the next lower trophic level from predation (or herbivory if the intermediate trophic level is an herbivore)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic cascade" .

goldbook:15112 a skos:Concept ;
    skos:altLabel "biominification",
        "bioreduction" ;
    skos:definition "Decrease in contaminant concentration as trophic level increases; this results from a net balance of ingestion rate, uptake from food, internal transformation, and elimination processes favoring loss of contaminant that enters the organism via food." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic dilution" .

goldbook:15113 a skos:Concept ;
    skos:altLabel "trophic position" ;
    skos:definition "Position in a food chain, assessed by the number of energy-transfer steps to reach that level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic level" .

goldbook:15114 a skos:Concept ;
    skos:definition "Organization of an ecological community described in terms of energy flow through its various trophic levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic structure" .

goldbook:15115 a skos:Concept ;
    skos:definition "Transfer of a substance from one trophic level to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic transfer" .

goldbook:15116 a skos:Concept ;
    skos:definition "Ratio between the concentration of a compound in a predator and in its prey." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trophic transfer factor" .

goldbook:15117 a skos:Concept ;
    skos:definition "Extent to which the clarity of water is reduced by the presence of suspended or other matter that causes light to be scattered and absorbed rather than transmitted (in straight lines) through the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "turbidity of water" .

goldbook:15118 a skos:Concept ;
    skos:definition "Experimental method for evaluating assimilation that introduces simultaneously a radiotracer of the substance being assimilated and an inert tracer that will not be assimilated, thus providing a basis for evaluating the assimilation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "twin-tracer technique" .

goldbook:15119 a skos:Concept ;
    skos:definition "Animal or plant living in contact with sediments but unable to ingest particulates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "type A organism" .

goldbook:15120 a skos:Concept ;
    skos:definition "Animal or plant living in contact with sediments and capable of ingesting particulates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "type B organism" .

goldbook:15121 a skos:Concept ;
    skos:altLabel "UF",
        "application factor (AF)",
        "assessment factor",
        "modifying factor (MF)",
        "safety factor" ;
    skos:definition "In assay methodology, confidence interval or fiducial limit used to assess the probable precision of an estimate. In toxicology, value used in extrapolation from experimental animals to humans (assuming that humans may be more sensitive) or from selected individuals to the general population.Example: A value applied to the no-observed-effect-level (NOEL) or no-observed-adverse-effect-level (NOAEL) to derive an acceptable daily intake (ADI) or tolerable daily intake (TDI).Note: The NOEL or NOAEL is divided by the value to calculate the ADI or TDI." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uncertainty factor" .

goldbook:15122 a skos:Concept ;
    skos:definition "Water in a rivulet, river, or lake that is situated above a defined point, in a direction opposite to that of the current flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upstream water" .

goldbook:15123 a skos:Concept ;
    skos:definition "First-order one-compartment constant to describe the uptake of a substance by an organism from water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uptake rate constant" .

goldbook:15124 a skos:Concept ;
    skos:definition "Component of the life cycle of an individual in which natural selection can occur through the differential survival of individuals. It begins at the formation of the zygote and continues throughout the life of the individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viability selection" .

goldbook:15125 a skos:Concept ;
    skos:definition "Measures of how fast vital statistics change in a population (usually expressed per \\(\\pu{1000}\\) individuals)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vital rates" .

goldbook:15126 a skos:Concept ;
    skos:definition "Susceptibility to harm by toxicants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vulnerability" .

goldbook:15127 a skos:Concept ;
    skos:definition "Net deficit of heterozygotes when two populations, each in Hardy–Weinberg equilibrium but with different allele frequencies, are mixed and the genotype frequencies quantified in a combined population sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wahlund effect" .

goldbook:15128 a skos:Concept ;
    skos:definition "Widespread and substantial decline in growth and the change in behavior of many softwood and hardwood forest ecosystems in central Europe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "waldsterben" .

goldbook:15129 a skos:Concept ;
    skos:definition "General term describing effluents, leachate, and elutriates which enter the natural environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "waste-water" .

goldbook:15130 a skos:Concept ;
    skos:definition "Questionable extension of the critical life-stage concept (see critical life-stage testing) that protection of the most sensitive life stage will ensure protection of all life stages; it assumes that exposure of field populations to concentrations identified in laboratory testing as causing significant mortality at a critical stage of life will result in significant impact on the field population" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weakest-link incongruity" .

goldbook:15131 a skos:Concept ;
    skos:definition "Dose–response model of the form \\[P(d) = \\gamma + (1 - \\gamma)(1 - e^{-\\beta d^{\\alpha}})\\] where \\(P(d)\\) is the probability of a tumor (or other response) from lifetime, continuous exposure at dose \\(d\\) until age \\(t\\) (when tumor is fatal), \\(\\alpha\\) is a fitted dose parameter (sometimes called the Weibull parameter), \\(\\beta\\) is a fitted dose parameter, and \\(\\gamma\\) is the background response rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Weibull model" .

goldbook:15132 a skos:Concept ;
    skos:definition "Distribution of organisms among the various weight classes present in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weight composition" .

goldbook:15133 a skos:Concept ;
    skos:definition "(in general) Quantitative, semiquantitative, or qualitative estimate of the degree to which the evidence supports or undermines a given conclusion. (in toxicology) Estimate of the extent to which the available biomedical data support the hypothesis that a substance causes a defined toxic effect such as cancer in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weight of evidence" .

goldbook:15134 a skos:Concept ;
    skos:definition "Theory of evolution and heredity propounded by the German biologist, August Weismann, especially in regard to the continuity of the germ-plasm and the nontransmission of acquired characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Weismannism" .

goldbook:15135 a skos:Concept ;
    skos:definition "Transfer of chemicals from the atmosphere to the Earth’s surface in atmospheric water precipitation (atmospheric deposition), e.g., rain, snow, or hail, of pollutants that occur in the precipitation, e.g., as a result of Brownian capture, nucleation, dissolution, or impaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wet deposition" .

goldbook:15136 a skos:Concept ;
    skos:definition "Area of land consisting of soil that is saturated with moisture, such as a swamp, marsh, or bog." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wetland" .

goldbook:15137 a skos:Concept ;
    skos:altLabel "WET" ;
    skos:definition "Total toxic effect of an effluent measured directly with aquatic organisms in a toxicity test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "whole-effluent toxicity" .

goldbook:15138 a skos:Concept ;
    skos:definition "Sediment and associated interstitial water that have had minimal manipulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "whole sediment" .

goldbook:15139 a skos:Concept ;
    skos:definition "Small floating or weakly swimming animals that drift with water currents and which, with phytoplankton, make up the planktonic food supply upon which almost all oceanic organisms ultimately depend." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zooplankton" .

goldbook:15140 a skos:Concept ;
    skos:altLabel "NED" ;
    skos:definition "Proportion dying in a toxicity test expressed in terms of standard deviations from the mean of a normal curve." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal equivalent deviation" .

goldbook:15141 a skos:Concept ;
    skos:definition "Fraction of the administered dose of a drug from a dosage form absorbed intact into the systemic circulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute bioavailability" .

goldbook:15142 a skos:Concept ;
    skos:definition "Carriage of a solute across a biological membrane, which requires a suitable carrier and the expenditure of energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active transport of drugs" .

goldbook:15143 a skos:Concept ;
    skos:definition "Introduction of a substance to an organism by a defined route." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration" .

goldbook:15144 a skos:Concept ;
    skos:definition "Administration of drugs through the eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs ocular route" .

goldbook:15145 a skos:Concept ;
    skos:definition "Administration of drugs through the mouth to swallow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs oral route" .

goldbook:15146 a skos:Concept ;
    skos:definition "Method of introducing substances into an organism, avoiding the gastrointestinal tract." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs parenteral route" .

goldbook:15147 a skos:Concept ;
    skos:definition "Administration of drugs into the rectal cavity or through the rectum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs rectal route" .

goldbook:15148 a skos:Concept ;
    skos:altLabel "introduction of drugs by inhalation" ;
    skos:definition "Delivery to the lower respiratory tract in order to obtain a local or systemic effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs respiratory route" .

goldbook:15149 a skos:Concept ;
    skos:definition "Administration of drugs on surfaces of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs topical route" .

goldbook:15150 a skos:Concept ;
    skos:altLabel "diadermic administration",
        "percutaneous administration",
        "transcutaneous administration",
        "transdermic administration" ;
    skos:definition "Introduction of products through unbroken skin by means of a specific drug delivery system (such as a patch containing a semi-solid formulation of the drug) for systemic and/or prolonged drug effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs transdermal route" .

goldbook:15151 a skos:Concept ;
    skos:definition "Introduction of products into the vagina normally for local effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "administration of drugs vaginal route" .

goldbook:15152 a skos:Concept ;
    skos:definition "Characteristic angle of slope formed with the horizontal by the side of a static conical mound of powder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle of repose" .

goldbook:15153 a skos:Concept ;
    skos:definition "Process by which food is rendered free from pathogenic, toxigenic, and spoilage organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "appertisation" .

goldbook:15154 a skos:Concept ;
    skos:definition "Relationship between two preparations of the same drug in the same dosage form that have a similar bioavailability. Dosage forms containing the same drug are said to be bioequivalent if they do not differ significantly in the bioavailability (e.g., AUC, \\(c_{\\rm{max}}\\), \\(t_{\\rm{max}}\\)) of the active constituent/ingredient, when administered in the same dose under similar experimental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioequivalence" .

goldbook:15155 a skos:Concept ;
    skos:definition "Virus, therapeutic serum, toxin, antitoxin, or analogous product applicable to the prevention, treatment, or cure of diseases or injuries in humans and/or animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological product" .

goldbook:15156 a skos:Concept ;
    skos:definition "Branch of pharmaceutical science that deals with the fate of drugs in the living system; particularly the release of the drug from its dosage form into a biological medium, its passage across membranes into the systemic circulation, metabolism, and elimination, and the application of this knowledge to obtain the desired therapeutic effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biopharmaceutics" .

goldbook:15157 a skos:Concept ;
    skos:definition "Usually a small, flat, and soft tablet, which is designed to be placed inside the cheek to be directly absorbed through the mucosa for systemic effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "buccal tablet" .

goldbook:15158 a skos:Concept ;
    skos:definition "Characteristic of a powder rather than of individual particles given by the mass of powder occupying a known volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk density" .

goldbook:15159 a skos:Concept ;
    skos:definition "Small edible package made usually from gelatin or other materials that can be filled with drugs (solids or liquids) to produce a unit dose, mainly for oral use. Hard capsules consist of two pieces that fit one inside the other which are produced empty and filled in a separate operation, and soft, liquid-filled capsules, which are manufactured and filled in one operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capsule" .

goldbook:15160 a skos:Concept ;
    skos:definition "Transfer of a drug across a membrane by a transporter (often a protein) constituent of the cytosol membrane. Also known as active transport as opposed to passive diffusion/absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier-mediated drug transport" .

goldbook:15161 a skos:Concept ;
    skos:definition "Technological process consisting of the application of a substance, which forms a layer (e.g., to protect the drug and/or the tablet, to mask taste, to control the rate of drug release (e.g., film coating, sugar coating)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coating" .

goldbook:15162 a skos:Concept ;
    skos:definition "A solid dosage form prepared to a desired shape, usually in large-scale production, by means of high pressure in a punch and die." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compressed tablet" .

goldbook:15163 a skos:Concept ;
    skos:definition "Medication, which due to its special technological construction provides for drug release having predefined kinetics (zero order, \\(t^{1/2}\\), first order, etc.) at a sufficient rate to maintain the desired therapeutic level over an extended period of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled-release dosage form" .

goldbook:15164 a skos:Concept ;
    skos:definition "A stage in the drying of solids, above which the drying rate (derived from the plot of the loss of moisture content against time) is linear, at which the drying rate ceases to be linear, until it reaches the equilibrium moisture content." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical moisture content" .

goldbook:15165 a skos:Concept ;
    skos:definition "Type of comparative bioavailability study designed in such a way as to take into account differences in bioavailability arising from differences between patients suffering from disease, participating in the study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crossover study" .

goldbook:15166 a skos:Concept ;
    skos:definition "Term that describes a solid of regular shape and the presence of three-dimensional order on the level of atomic dimensions, for a given molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystalline" .

goldbook:15167 a skos:Concept ;
    skos:definition "Pharmaceutical preparation that releases the drug(s) at a time other than promptly after administration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed-release dosage form" .

goldbook:15168 a skos:Concept ;
    skos:definition "Substance that absorbs sufficient moisture from the atmosphere to dissolve itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deliquescent" .

goldbook:15169 a skos:Concept ;
    skos:definition "Deposit of a drug in a body created by injection or by a similar mode of introduction to form a source of slow release." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depot" .

goldbook:15170 a skos:Concept ;
    skos:definition "Property, which serves as basis for the process whereby surfactants are used for the removal of foreign matter from surfaces (including dirt from clothes or body surfaces)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detergency" .

goldbook:15171 a skos:Concept ;
    skos:definition "Obstacle such as coating or embedding, which acts as a factor controlling the rate of drug release." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion barrier" .

goldbook:15172 a skos:Concept ;
    skos:definition "Dosage form in which the active ingredient is insoluble in the carrier; includes aerosols (solids or liquids in gas), suspensions (solids in liquids), emulsions (liquids in liquids), and foams (gas in liquid), or ointments/creams (solid in solid or in semi-solid, or liquid in solid)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disperse system" .

goldbook:15173 a skos:Concept ;
    skos:definition "Formulation in which individual doses of a granulated dosage form are separated (e.g., gelatin capsules)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "divided granule" .

goldbook:15174 a skos:Concept ;
    skos:definition "Powder formulation in which individual doses of a powdered dosage form are separately wrapped (e.g., sachets, envelopes, or gelatin capsules)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "divided powder" .

goldbook:15175 a skos:Concept ;
    skos:definition "Formulated preparation of molecules/drugs that are rarely if ever suitable for administration to patients without additives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dosage form" .

goldbook:15176 a skos:Concept ;
    skos:definition "Dose and dosing interval of a drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dosage regimen" .

goldbook:15177 a skos:Concept ;
    skos:definition "Sophisticated dosage form, which, by its construction, is able to modify/control the availability of the drug substance to the body by temporal or spatial considerations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug delivery system" .

goldbook:15178 a skos:Concept ;
    skos:definition "Refers to a stent with an active drug that is intended to produce a therapeutic effect (e.g., reduction of restenosis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug-eluting stent" .

goldbook:15179 a skos:Concept ;
    skos:definition "Usually intended for external use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dusting powder" .

goldbook:15180 a skos:Concept ;
    skos:definition "Solid preparation that on contact with water breaks apart by the effect of gas (usually \\(\\ce{CO2}\\)) evolution, resulting commonly from the reaction of hydrogen carbonate with citric or tartaric acid, in order to facilitate dissolution or dispersion of the active ingredient before ingestion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effervescent tablet" .

goldbook:15181 a skos:Concept ;
    skos:definition "Substance that loses water to form a lower hydrate or becomes anhydrous spontaneously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efflorescent" .

goldbook:15182 a skos:Concept ;
    skos:definition "Sweet (often colored) dilute alcohol-based, 'hydroalcoholic', liquid used in the compounding of drugs to be taken by mouth in order to improve palatability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elixir" .

goldbook:15183 a skos:Concept ;
    skos:definition "Technological process, which consists of mixing or inclusion of the therapeutic substance with an excipient or their mixtures, typically as a matrix dosage form, in order to change the rate of release." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embedding" .

goldbook:15184 a skos:Concept ;
    skos:definition "Solutions (aqueous or oily), emulsions, or suspensions for rectal administration of medicaments for cleansing, diagnostic, or therapeutic purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enemas" .

goldbook:15185 a skos:Concept ;
    skos:definition "Used on tablets, granules, pellets, and capsules to make them resistant to gastric fluids but designed to disintegrate, disrupt, or dissolve when the preparation enters the duodenum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enteric coating" .

goldbook:15186 a skos:Concept ;
    skos:altLabel "EMC" ;
    skos:definition "Final stage reached after drying of a solid, beyond the critical moisture content." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium moisture content" .

goldbook:15187 a skos:Concept ;
    skos:definition "A tablet formulation intended for a rapid release of its active agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast-dissolving tablet" .

goldbook:15188 a skos:Concept ;
    skos:definition "Summary of operations carried out to convert a pharmacologically active compound into a dosage form suitable for administration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "formulation" .

goldbook:15189 a skos:Concept ;
    skos:altLabel "mouthwash" ;
    skos:definition "Aqueous solution used for the prevention and treatment of mouth and throat infections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gargle" .

goldbook:15190 a skos:Concept ;
    skos:definition "Pace at which a drug along with the stomach content leaves and enters the duodenum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastric emptying rate" .

goldbook:15191 a skos:Concept ;
    skos:definition "Use of products containing genetic material (e.g., pDNA, antisense DNA, siRNA) to treat a disease or condition, or to modify or manipulate the expression of genetic material or to alter the biological properties of living cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene therapy" .

goldbook:15192 a skos:Concept ;
    skos:altLabel "generics" ;
    skos:definition "Drug(s) or formulation(s) of drug(s) or dosage forms, which no longer have patent protection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generic" .

goldbook:15193 a skos:Concept ;
    skos:definition "Powder particles, which have been aggregated to form larger irregular particles, usually of \\(\\pu{0.5\\!{-}\\! 2 mm}\\) diameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granules" .

goldbook:15194 a skos:Concept ;
    skos:definition "Process in which powder particles are made to aggregate to larger particles called granules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granulation" .

goldbook:15195 a skos:Concept ;
    skos:definition "Crystalline form of a compound in which water molecules are part of the crystal structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrate" .

goldbook:15196 a skos:Concept ;
    skos:altLabel "HLB",
        "HLB System" ;
    skos:definition "Empirical scale (of \\(0\\!-\\!20\\)) used to classify surfactants and emulsifying agents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophile-lipophile balance system" .

goldbook:15197 a skos:Concept ;
    skos:definition "Tendency of a substance to absorb water from the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hygroscopicity" .

goldbook:15198 a skos:Concept ;
    skos:definition "Dosage form that releases the drug immediately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immediate-release tablet" .

goldbook:15199 a skos:Concept ;
    skos:altLabel "IF" ;
    skos:definition "Number that expresses the reduction in the numbers of a microorganism, brought about by a sterilization process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inactivation factor" .

goldbook:15200 a skos:Concept ;
    skos:definition "Administration of drugs directly to the respiratory tract, mostly by aerosols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhalation therapy" .

goldbook:15201 a skos:Concept ;
    skos:definition "Delivery of a generally sterile liquid medication into the body, or a vessel, tissue, or organ via syringe and needle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "injection" .

goldbook:15202 a skos:Concept ;
    skos:definition "Liquid intended for massaging into the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liniment" .

goldbook:15203 a skos:Concept ;
    skos:definition "Initial, typically larger than the maintenance dose of a drug given to a patient at the start of pharmacotherapy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loading dose" .

goldbook:15204 a skos:Concept ;
    skos:definition "Solution, emulsion, or suspension to be applied to the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lotion" .

goldbook:15205 a skos:Concept ;
    skos:definition "Tablet, which does not contain a disintegrant and which is sucked to dissolve in the mouth to produce either a local (e.g., antiseptic) or systemic (e.g., vitamins) effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lozenge" .

goldbook:15206 a skos:Concept ;
    skos:definition "Used as processing aid in tablet and capsule manufacturing, to facilitate the movement of the formulation into the dye and punch and to reduce the energy of compression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lubricant" .

goldbook:15207 a skos:Concept ;
    skos:definition "Specific case of drug embedding in insoluble excipients (typically in a polymer) in order to achieve extended release." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix formulation" .

goldbook:15208 a skos:Concept ;
    skos:definition "Maximum concentration of a drug, which will form a clear solution with a given concentration of surfactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum additive concentration" .

goldbook:15209 a skos:Concept ;
    skos:definition "Concentration of a drug in the plasma, above which side effects are likely to occur in a patient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum safe concentration" .

goldbook:15210 a skos:Concept ;
    skos:altLabel "minimum therapeutic plasma concentration" ;
    skos:definition "Concentration of a drug that must be achieved in the plasma before any desired therapeutic or pharmacological effect can be obtained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum effective plasma concentration" .

goldbook:15211 a skos:Concept ;
    skos:altLabel "MIC" ;
    skos:definition "Lowest concentration of an antibacterial drug necessary to inhibit the growth of a microorganism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum inhibitory concentration" .

goldbook:15212 a skos:Concept ;
    skos:definition "Release of a drug from a dosage form that it is not immediate (e.g., sustained release, retarded release, delayed-action preparations, controlled release, extended release, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modified release" .

goldbook:15213 a skos:Concept ;
    skos:definition "Usually water or low-molecular-weight alcohols or compounds, used in topical applications and in wet granulation, for the production of tablets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moistening agents" .

goldbook:15214 a skos:Concept ;
    skos:definition "Dosage form (capsule, tablet) comprising several elements (e.g., microspheres or coated pellets) differing in the rate of drug release." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicompartment formulation" .

goldbook:15215 a skos:Concept ;
    skos:definition "Consists of several different layers that are compressed on top of each other, to form a single tablet composed of two or more layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multilayer tablet" .

goldbook:15216 a skos:Concept ;
    skos:definition "Formation of nanoparticles encapsulating a drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoencapsulation" .

goldbook:15217 a skos:Concept ;
    skos:definition "Greasy, semi-solid preparation for external application, often anhydrous, containing dissolved or dispersed medicaments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ointment" .

goldbook:15218 a skos:Concept ;
    skos:definition "Kinetic model, where the whole body is thought of as a single compartment in which a substance is distributed rapidly, achieving an equilibrium between blood and tissue immediately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "one-compartment model" .

goldbook:15219 a skos:Concept ;
    skos:definition "Time required to achieve the minimum effective plasma concentration following administration of the dosage form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "onset of drug action" .

goldbook:15220 a skos:Concept ;
    skos:definition "Ointment containing \\(\\gt \\pu{0\\%}\\) of powder, dispersed in a fatty base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paste" .

goldbook:15221 a skos:Concept ;
    skos:definition "Very small tablet or pilule. Implantable polymeric matrix. Spherical granule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pellet" .

goldbook:15222 a skos:Concept ;
    skos:definition "Process of agglomeration that converts fine powders or granules of bulk drugs and excipients into small, free-flowing, spherical, or semi-spherical units, referred to as pellets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pelletisation" .

goldbook:15223 a skos:Concept ;
    skos:definition "To be pharmaceutically equivalent, the generic and proprietary formulations must (1) contain the same amount of active ingredient; (2) contain the same active ingredient in the same dosage form; (3) be intended for the same route of administration; and (4) generally be labeled for the same conditions of use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmaceutical equivalence" .

goldbook:15224 a skos:Concept ;
    skos:definition "Science of preparation of drugs, dosage forms, and drug delivery systems taking into account the pharmacokinetics and pharmacodynamics of the drug as well as its physical and chemical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmaceutics" .

goldbook:15225 a skos:Concept ;
    skos:definition "Solid material that exists at least in two different molecular arrangements, i.e., distinctly different crystal species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymorph" .

goldbook:15226 a skos:Concept ;
    skos:definition "Defined for powders used pharmaceutically, according to particle sizes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "powder grades" .

goldbook:15227 a skos:Concept ;
    skos:altLabel "powders" ;
    skos:definition "Dry solid material consisting of many, usually free flowing, fine particles. Conventionally, the title 'powder' should be restricted to powder mixes for internal use and alternative terms are used for other powdered formulations presented in this way, e.g., dusting powders, which are for external use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "powder" .

goldbook:15228 a skos:Concept ;
    skos:definition "Exploratory activity that begins early in pharmaceutics, involving studies designed to determine the compatibility of excipients with the active substance for a biopharmaceutical; physicochemical and bioanalytical investigation in support of promising experimental formulations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preformulation" .

goldbook:15229 a skos:Concept ;
    skos:altLabel "pseudopolymorphs" ;
    skos:definition "Different crystalline form(s) of a solvated compound that differ in the identity and/or the stoichiometry of the solvating molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudopolymorph" .

goldbook:15230 a skos:Concept ;
    skos:definition "Tablet or capsule distinguished from a sustained-release dosage form, by the fact that it releases the medicinal agent, or part of it, at any time other than promptly after administration as opposed to a slow, controlled manner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repeat action dosage form" .

goldbook:15231 a skos:Concept ;
    skos:definition "Process that differentiates or separates solid particles according to their size using a meshed or perforated device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sieving" .

goldbook:15232 a skos:Concept ;
    skos:definition "Method by which powder particles are compressed into a large tablet, called a slug, which is subsequently dry-screened and compressed into a tablet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slugging" .

goldbook:15233 a skos:Concept ;
    skos:definition "Additives making a substance soluble or more soluble, especially in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solubilising agents" .

goldbook:15234 a skos:Concept ;
    skos:definition "Crystalline form of a compound in which one or more solvent molecules are part of the crystal structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvate" .

goldbook:15235 a skos:Concept ;
    skos:definition "Process of making dense, spherical pellets by means of special spheronizing or pelletizing equipment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spheronisation" .

goldbook:15236 a skos:Concept ;
    skos:definition "Scaffold placed into narrowed, diseased vessels (mainly coronary arteries) or a device implanted in a vessel used to help keep it open." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stent" .

goldbook:15237 a skos:Concept ;
    skos:definition "Usually small, flat, and soft tablets, which are designed to be placed under the tongue to allow direct absorption of the active ingredient through the mucosa for systemic effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sublingual tablets" .

goldbook:15238 a skos:Concept ;
    skos:definition "Dosage form, semi-solid, used for the administration of drugs via the rectal route, for systemic or local effect. When application is via other routes (e.g., the vaginal route), suppositories are termed differently, inserts, pessaries, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suppositories" .

goldbook:15239 a skos:Concept ;
    skos:altLabel "extended release",
        "gradual release",
        "long acting",
        "prolonged action",
        "slow release" ;
    skos:definition "Dosage form designed to release the drug contained therein at a continuous and controlled rate for a longer period of time that can normally be achieved with its conventional, nonsustained counterpart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sustained release" .

goldbook:15240 a skos:Concept ;
    skos:definition "Liquid preparation of high sugar concentration with or without medicinal and additional flavoring substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syrup" .

goldbook:15241 a skos:Concept ;
    skos:altLabel "pastille",
        "pellet",
        "pill",
        "troche" ;
    skos:definition "Solid dosage form compressed into a specific shape containing medicinal substances with or without suitable diluents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tablet" .

goldbook:15242 a skos:Concept ;
    skos:definition "Solid layers based typically on cellulose derivatives and may include plasticizers and pigments. They are usually employed for one or more of the following reasons:  Protection of the ingredients (from light or moisture). Masking the bad taste of the drug. Masking possible batchwise differences in the appearance of raw materials and hence allaying possible patient concern over tablets of differing appearance. Coating confers mechanical strength and facilitates handling. Colored coating aids in the rapid identification of a product. Functional film coating is used to impart enteric or controlled-release properties to the tablet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tablet coating" .

goldbook:15243 a skos:Concept ;
    skos:definition "Applied to compressed lozenges. In lay language, lozenge and troche are used interchangeably." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "troche" .

goldbook:15244 a skos:Concept ;
    skos:altLabel "acrylate polymer",
        "acrylic",
        "polyacrylic" ;
    skos:definition "Polymer prepared from acrylic acid or a derivative of acrylic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acrylic polymer" .

goldbook:15245 a skos:Concept ;
    skos:altLabel "amide-aldehyde polymer",
        "amine-aldehyde polymer" ;
    skos:definition "Polymer prepared by polycondensation of an amino component such as amine or amide with an aldehyde, or by curing reactive oligomers prepared from an amino component and an aldehyde." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amino polymer" .

goldbook:15246 a skos:Concept ;
    skos:altLabel "1-benzofuran-indene polymer" ;
    skos:definition "Polymer prepared from a mixture containing 1-benzofuran (formerly coumarone) and indene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coumarone-indene polymer" .

goldbook:15247 a skos:Concept ;
    skos:definition "Polymer prepared by reaction of compounds carrying two or more epoxy groups (reactive epoxides) with curing agents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epoxy polymer" .

goldbook:15248 a skos:Concept ;
    skos:definition "Polymer prepared from furan or a furan derivative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "furan polymer" .

goldbook:15249 a skos:Concept ;
    skos:altLabel "phenol-aldehyde polymer" ;
    skos:definition "Polymer prepared by the polycondensation of phenols and aldehydes or by curing reactive oligomers prepared from phenols and aldehydes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenolic polymer" .

goldbook:15250 a skos:Concept ;
    skos:definition "Polymer prepared from a bismaleimide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polybismaleimide" .

goldbook:15251 a skos:Concept ;
    skos:definition "Polymer prepared from a carborane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycarborane" .

goldbook:15252 a skos:Concept ;
    skos:definition "Polymer prepared from a diene, or a substituted diene, or both in admixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polydiene" .

goldbook:15253 a skos:Concept ;
    skos:definition "Polymer prepared from an isocyanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyisocyanate" .

goldbook:15254 a skos:Concept ;
    skos:definition "Polymer prepared from an isocyanide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyisocyanide" .

goldbook:15255 a skos:Concept ;
    skos:definition "Polymer prepared from an olefin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyolefin" .

goldbook:15256 a skos:Concept ;
    skos:definition "Polymer prepared by acetalization of poly(vinyl alcohol) with an aldehyde." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinyl acetal" .

goldbook:15257 a skos:Concept ;
    skos:definition "Polymer prepared from a vinyl ester." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinyl ester" .

goldbook:15258 a skos:Concept ;
    skos:definition "Polymer prepared from a vinyl ether." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinyl ether" .

goldbook:15259 a skos:Concept ;
    skos:definition "Polymer prepared from a vinyl halide (monohalogenoethene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinyl halide" .

goldbook:15260 a skos:Concept ;
    skos:definition "Polymer prepared from a vinyl ketone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyvinyl ketone" .

goldbook:15261 a skos:Concept ;
    skos:altLabel "polystyrene" ;
    skos:definition "Polymer prepared from styrene, or a substituted styrene, or both in admixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "styrene polymer" .

goldbook:15262 a skos:Concept ;
    skos:definition "Polymer prepared from a monomer containing the vinyl group \\(\\ce{-CH=CH2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vinyl polymer" .

goldbook:15263 a skos:Concept ;
    skos:definition "Polymer prepared from a monomer containing the ethene-1,1-diyl group \\(\\gt\\!\\ce{C=CH2}\\), formerly called vinylidene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vinylidene polymer" .

goldbook:15264 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively alkene-α,ω-diyl (formerly alkenylene) constitutional repeating units: \\[\\ce{-[-CH=CH-[CH2]_{m}\\bond{-}]_{n}\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyalkenylene" .

goldbook:15265 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively alkane-α,ω-diyl (formerly alkylene) constitutional repeating units: \\[\\ce{-[-CR^{1}R^{2}\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each hydrogen, alkyl, or cycloalkyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
