AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10801 "aganglionic megacolon")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10801 "congenital aganglionic megacolon")
Declaration(Class(goldbook:10802))
AnnotationAssertion(rdfs:label goldbook:10802 "hirsutism")
AnnotationAssertion(dcterms:description goldbook:10802 "Presence of excessive bodily and facial hair.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10802 "hypertrichosis")
Declaration(Class(goldbook:10803))
AnnotationAssertion(rdfs:label goldbook:10803 "holoprosencephaly")
