Declaration(Class(goldbook:12932))
AnnotationAssertion(rdfs:label goldbook:12932 "B-1/B-2 cells")
AnnotationAssertion(dcterms:description goldbook:12932 "Two major subpopulations of B lymphocytes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:12932 "B-1/B-2 lymphocytes")
AnnotationAssertion(rdfs:comment goldbook:12932 "The majority of B cells are B-2 which express low levels of surface IgM, higher levels of surface IgD, do not express CD5, and are CD43-, CD23+; they are directly generated from precursors in the bone marrow, and secrete highly specific antibody."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:12932 "B-1 cells bear high levels of surface immunoglobulin M (IgM), show lower levels of surface immunoglobulin D (IgD), are CD43+/CD23-, and most express the cell surface antigen CD5. They are self-renewing, and frequently secrete high levels of antibody that binds to a range of antigens (\"polyspecificity\") with a relatively low affinity."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12932 goldbook:12937)
AnnotationAssertion(rdfs:seeAlso goldbook:12932 goldbook:12979)
AnnotationAssertion(rdfs:seeAlso goldbook:12932 goldbook:12959)
AnnotationAssertion(rdfs:seeAlso goldbook:12932 goldbook:13287)
AnnotationAssertion(rdfs:seeAlso goldbook:12932 goldbook:13293)
AnnotationAssertion(mito:isMentionedBy goldbook:12932 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:12932 "current"^^xsd:string)
Declaration(Class(goldbook:12933))
AnnotationAssertion(rdfs:label goldbook:12933 "B7 molecule")
AnnotationAssertion(dcterms:description goldbook:12933 "Co-stimulatory molecule on the surface of T-cell-activating antigen-presenting cells (APCs), allowing full activation of T cells that are bound to major histocompatibility complex (MHC)-peptide complexes.")
AnnotationAssertion(rdfs:comment goldbook:12933 "Whereas binding of B7 molecules to CD28 is stimulatory, binding to cytotoxic T-lymphocyte antigen-4 (CTLA-4) decreases T-cell activity and participates in tolerance."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:12933 goldbook:13051)
AnnotationAssertion(rdfs:seeAlso goldbook:12933 goldbook:13724)
AnnotationAssertion(rdfs:seeAlso goldbook:12933 goldbook:13401)
AnnotationAssertion(rdfs:seeAlso goldbook:12933 goldbook:12888)
AnnotationAssertion(rdfs:seeAlso goldbook:12933 goldbook:13073)
