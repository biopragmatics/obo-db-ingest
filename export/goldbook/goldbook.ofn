Declaration(Class(goldbook:10763))
AnnotationAssertion(rdfs:label goldbook:10763 "germ layer")
AnnotationAssertion(dcterms:description goldbook:10763 "Any of three distinct layers of cells (endoderm, ectoderm, and mesoderm) that become recognizable as the embryo develops.")
Declaration(Class(goldbook:10764))
AnnotationAssertion(rdfs:label goldbook:10764 "gestation")
AnnotationAssertion(dcterms:description goldbook:10764 "Period between conception and birth during which an embryo or fetus is carried in the uterus of a female mammal.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10764 "pregnancy")
Declaration(Class(goldbook:10765))
AnnotationAssertion(rdfs:label goldbook:10765 "gestation period")
AnnotationAssertion(dcterms:description goldbook:10765 "Time from conception to birth, during which a fetus develops.")
Declaration(Class(goldbook:10766))
AnnotationAssertion(rdfs:label goldbook:10766 "gigantism")
AnnotationAssertion(dcterms:description goldbook:10766 "Condition of abnormal size or overgrowth of the entire body or of any of its parts.")
Declaration(Class(goldbook:10767))
AnnotationAssertion(rdfs:label goldbook:10767 "gland")
AnnotationAssertion(dcterms:description goldbook:10767 "Organized aggregation of cells functioning as a secretory or excretory organ.")
Declaration(Class(goldbook:10768))
AnnotationAssertion(rdfs:label goldbook:10768 "glans")
AnnotationAssertion(dcterms:description goldbook:10768 "Any small rounded mass or gland-like body.")
Declaration(Class(goldbook:10769))
AnnotationAssertion(rdfs:label goldbook:10769 "glans clitoridis")
AnnotationAssertion(dcterms:description goldbook:10769 "Rounded mass of sensitive erectile tissue that forms the head of the clitoris.")
Declaration(Class(goldbook:10770))
AnnotationAssertion(rdfs:label goldbook:10770 "glans penis")
AnnotationAssertion(dcterms:description goldbook:10770 "Rounded mass of sensitive erectile tissue at the distal end (head) of the penis, analogous to the glans clitoridis.")
Declaration(Class(goldbook:10771))
AnnotationAssertion(rdfs:label goldbook:10771 "glaucoma")
AnnotationAssertion(dcterms:description goldbook:10771 "Disease of the eye characterized by increased intraocular pressure, resulting in atrophy of the optic nerve.")
Declaration(Class(goldbook:10772))
AnnotationAssertion(rdfs:label goldbook:10772 "glomerulus")
AnnotationAssertion(dcterms:description goldbook:10772 "Tuft or a cluster, as of a plexus of capillary blood vessels or nerve fibers (e.g., capillaries of the filtration apparatus of the kidney).")
Declaration(Class(goldbook:10773))
AnnotationAssertion(rdfs:label goldbook:10773 "glucocorticoid")
AnnotationAssertion(dcterms:description goldbook:10773 "Any of a group of steroid hormones, such as cortisone, produced by the adrenal cortex, inhibiting inflammation, and mediating a response to stress that alters protein, fat, and carbohydrate metabolism.")
Declaration(Class(goldbook:10774))
AnnotationAssertion(rdfs:label goldbook:10774 "glycolysis")
AnnotationAssertion(dcterms:description goldbook:10774 "Biochemical breakdown of glucose into pyruvic acid with the production of ATP.")
Declaration(Class(goldbook:10775))
AnnotationAssertion(rdfs:label goldbook:10775 "gonad")
AnnotationAssertion(dcterms:description goldbook:10775 "Organ in animals that produces gametes, i.e., the testis or the ovary.")
Declaration(Class(goldbook:10776))
AnnotationAssertion(rdfs:label goldbook:10776 "gonadotropin")
AnnotationAssertion(dcterms:description goldbook:10776 "Glycopeptide hormone, produced by the fetal placenta, that maintains the function of the corpus luteum during the first few weeks of pregnancy.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10776 "gonadotrophin")
Declaration(Class(goldbook:10777))
AnnotationAssertion(rdfs:label goldbook:10777 "gonadotropin-releasing hormone")
AnnotationAssertion(dcterms:description goldbook:10777 "Any factor from the hypothalamus that stimulates the anterior pituitary to release both follicle-stimulating hormone and luteinizing hormone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10777 "gonadoliberin")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:10777 "luteinizing hormone-releasing hormone (LHRH)")
Declaration(Class(goldbook:10778))
