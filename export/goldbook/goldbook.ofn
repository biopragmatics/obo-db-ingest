Declaration(Class(goldbook:H02885))
AnnotationAssertion(rdfs:label goldbook:H02885 "hydrazonic acids")
AnnotationAssertion(dcterms:description goldbook:H02885 "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing a double-bonded oxygen atom by $\\ce{=NNR2}$, as in carbohydrazonic acids, $\\ce{RC(OH)=NNH2}$ and sulfonohydrazonic acids, $\\ce{RS(=O)(=NNH2)OH}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02885 goldbook:O04374)
AnnotationAssertion(mito:isMentionedBy goldbook:H02885 doi:10.1351/pac199567081307)
