    <!-- http://dx.doi.org/10.1351/goldbook.A00562 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.A00562">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>The 1,3-dipolar N-imides of azomethines having the structure   The term azo ylides, derived from the second resonance form, has also been used.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1351/pac199567081307"/>
