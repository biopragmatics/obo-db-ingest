property_value: hasStatus "current" xsd:string
consider: goldbook:S05824
consider: goldbook:W06659

[Term]
id: goldbook:S05814
name: spectral effectiveness
def: "The reciprocal of the photon fluence rate\, \\\(E_\{\\rm\{p\}\}^\{0\}\\\)\, at wavelength \\\(\\lambda \\\)\, causing identical photoresponse\, \\\(\\Delta \\rm\{y\}\\\)\, per unit time \(\\\(\\frac\{\\Delta \\rm\{y\}\}\{\\Delta t\}\\\)\). The effectiveness spectrum is directly proportional to the conversion spectrum of the sensory pigment\, if spectral attenuance is negligible."
synonym: "effectiveness" []
synonym: "spectral photon effectiveness" []
