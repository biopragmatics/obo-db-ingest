AnnotationAssertion(dcterms:description goldbook:12977 "Outdated term for CD8+ cytotoxic T lymphocyte (CTL, Tc). The term 'suppressor T cell' is nowadays reserved for regulatory T cell (Treg).")
AnnotationAssertion(rdfs:seeAlso goldbook:12977 goldbook:13072)
AnnotationAssertion(rdfs:seeAlso goldbook:12977 goldbook:13644)
AnnotationAssertion(rdfs:seeAlso goldbook:12977 goldbook:13702)
