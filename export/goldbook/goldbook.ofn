AnnotationAssertion(obo:goldbook#hasStatus goldbook:F02542 "current"^^xsd:string)
Declaration(Class(goldbook:F02544))
AnnotationAssertion(rdfs:label goldbook:F02544 "fugacity coefficient")
AnnotationAssertion(dcterms:description goldbook:F02544 "Ratio of fugacity to the partial pressure of a gaseous constituent.")
AnnotationAssertion(rdfs:seeAlso goldbook:F02544 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:F02544 goldbook:F02543)
AnnotationAssertion(rdfs:seeAlso goldbook:F02544 goldbook:P04420)
