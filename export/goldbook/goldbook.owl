    <!-- http://dx.doi.org/10.1351/goldbook.S06122 -->

    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.S06122">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>3,3-Bis(hydroxyaryl)-3H-2,1-benzoxathiole S,S-dioxides, formed by condensation of o-sulfobenzoic acid with phenols or related compounds, e.g.</dcterms:description>
