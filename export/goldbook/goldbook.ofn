Declaration(Class(goldbook:11257))
AnnotationAssertion(rdfs:label goldbook:11257 "sterility")
AnnotationAssertion(dcterms:description goldbook:11257 """Infertility.
Asepsis.""")
Declaration(Class(goldbook:11258))
AnnotationAssertion(rdfs:label goldbook:11258 "sterilization")
AnnotationAssertion(dcterms:description goldbook:11258 """Process that makes an organism incapable of fertilization or reproduction, e.g., castration, vasectomy, or salpingectomy.
Process that makes an object aseptic.""")
Declaration(Class(goldbook:11259))
AnnotationAssertion(rdfs:label goldbook:11259 "steroid")
AnnotationAssertion(dcterms:description goldbook:11259 "Naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at \\(\\ce{C-10}\\) and \\(\\ce{C-13}\\), and often an alkyl group at \\(\\ce{C-17}\\). By extension, one or more bond scissions, ring expansions, and/or ring contractions of the skeleton may have occurred.")
Declaration(Class(goldbook:11260))
AnnotationAssertion(rdfs:label goldbook:11260 "steroid 21-monooxygenase")
AnnotationAssertion(dcterms:description goldbook:11260 "Member (EC 1.14.14.16) of the cytochrome P450 family of enzymes required for the synthesis of some steroid hormones including aldosterone and cortisol.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11260 "21-hydroxylase")
Declaration(Class(goldbook:11261))
AnnotationAssertion(rdfs:label goldbook:11261 "steroidogenesis assay")
AnnotationAssertion(dcterms:description goldbook:11261 "Procedure in which the effect of a test substance on steroid synthesis is studied, usually in a human adrenocortical carcinoma cell line.")
Declaration(Class(goldbook:11262))
AnnotationAssertion(rdfs:label goldbook:11262 "stillbirth")
AnnotationAssertion(dcterms:description goldbook:11262 "Birth of a baby without any signs of life, at a time variously taken as \\(\\pu{20\\!{-}\\! 28 weeks}\\) of pregnancy.")
Declaration(Class(goldbook:11263))
AnnotationAssertion(rdfs:label goldbook:11263 "stress-response pathway")
AnnotationAssertion(dcterms:description goldbook:11263 "Signaling events induced when normal cell function or development is disrupted by environmental (physical or chemical) factors.")
Declaration(Class(goldbook:11264))
AnnotationAssertion(rdfs:label goldbook:11264 "stromal cell")
AnnotationAssertion(dcterms:description goldbook:11264 "Cell producing the connective tissue framework of an organ or other anatomical structure.")
Declaration(Class(goldbook:11265))
AnnotationAssertion(rdfs:label goldbook:11265 "subthalamus")
AnnotationAssertion(dcterms:description goldbook:11265 "Part of the diencephalon, of which the major part is the subthalamic nucleus, and which connects to the globus pallidus, part of the telencephalon.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11265 "prethalamus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11265 "ventral thalamus")
Declaration(Class(goldbook:11266))
AnnotationAssertion(rdfs:label goldbook:11266 "sulcus")
AnnotationAssertion(dcterms:description goldbook:11266 "Any long, narrow groove, furrow or shallow depression, specifically referring to one of the fissures on the surface of the brain.")
Declaration(Class(goldbook:11267))
AnnotationAssertion(rdfs:label goldbook:11267 "superfecundation")
AnnotationAssertion(dcterms:description goldbook:11267 "Fertilization of two or more ova released in the same period of ovulation, either by different males or by the same male in separate acts of intercourse.")
Declaration(Class(goldbook:11268))
AnnotationAssertion(rdfs:label goldbook:11268 "superfetation")
AnnotationAssertion(dcterms:description goldbook:11268 "Presence of two fetuses in the uterus at different stages of development, resulting from fertilization of ova released in two successive periods of ovulation.")
Declaration(Class(goldbook:11269))
AnnotationAssertion(rdfs:label goldbook:11269 "supernumerary")
AnnotationAssertion(dcterms:description goldbook:11269 "Exceeding the usual number; thus, in anatomy, anomalies such as a sixth finger on one hand or a third nipple (in a human).")
Declaration(Class(goldbook:11270))
AnnotationAssertion(rdfs:label goldbook:11270 "pulmonary surfactant")
AnnotationAssertion(dcterms:description goldbook:11270 "Surface-active layer of phospholipids and proteins coating the pulmonary alveoli that increases lung compliance, facilitates lung expansion, and stabilizes alveolar volume.")
Declaration(Class(goldbook:11271))
AnnotationAssertion(rdfs:label goldbook:11271 "synapsis")
AnnotationAssertion(dcterms:description goldbook:11271 "Point-wise pairing of homologous chromosomes during the prophase of meiosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11271 "syndesis")
Declaration(Class(goldbook:11272))
AnnotationAssertion(rdfs:label goldbook:11272 "synaptonemal complex")
AnnotationAssertion(dcterms:description goldbook:11272 "Structure of filamentous proteins that forms between homologous chromosomes when they pair during meiosis; it may contribute to synapsis and genetic recombination.")
Declaration(Class(goldbook:11273))
AnnotationAssertion(rdfs:label goldbook:11273 "syncephalus")
AnnotationAssertion(dcterms:description goldbook:11273 "Conjoined twins with two bodies and a fused head.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11273 "monocephalus")
Declaration(Class(goldbook:11274))
AnnotationAssertion(rdfs:label goldbook:11274 "syncytiotrophoblast")
AnnotationAssertion(dcterms:description goldbook:11274 "Outer syncytial layer of trophoblast cells that invades the endometrium during implantation.")
Declaration(Class(goldbook:11275))
AnnotationAssertion(rdfs:label goldbook:11275 "syncytium")
AnnotationAssertion(dcterms:description goldbook:11275 "Referring to a large multinucleated mass of cellular contents that arises from the fusion of originally individual cells.")
Declaration(Class(goldbook:11276))
AnnotationAssertion(rdfs:label goldbook:11276 "syndactyly")
AnnotationAssertion(dcterms:description goldbook:11276 "Congenital occurrence of fusion or webbing of the fingers or toes.")
Declaration(Class(goldbook:11277))
AnnotationAssertion(rdfs:label goldbook:11277 "syndrome")
AnnotationAssertion(dcterms:description goldbook:11277 "Group of signs and symptoms occurring together, having a common cause and defining a disease.")
Declaration(Class(goldbook:11278))
AnnotationAssertion(rdfs:label goldbook:11278 "synophthalmia")
AnnotationAssertion(dcterms:description goldbook:11278 "Congenital fusion of the orbits in the midline, which then contains one eyeball.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11278 "cyclopia")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11278 "monophthalmos")
Declaration(Class(goldbook:11279))
AnnotationAssertion(rdfs:label goldbook:11279 "synotia")
AnnotationAssertion(dcterms:description goldbook:11279 "Congenital malformation characterized by the union or approximation of the ears in front of the neck, often accompanied by the absence or defective development of the lower jaw.")
Declaration(Class(goldbook:11280))
AnnotationAssertion(rdfs:label goldbook:11280 "tail bud")
AnnotationAssertion(dcterms:description goldbook:11280 "In the vertebrate embryo, mass of proliferating cells at the caudal end that arises from the primitive node.")
Declaration(Class(goldbook:11281))
AnnotationAssertion(rdfs:label goldbook:11281 "Tay–Sachs disease")
AnnotationAssertion(dcterms:description goldbook:11281 "Autosomal recessive inheritance of hexosaminidase A deficiency leading to a lysosomal storage disease characterized by central and peripheral neuronal involvement and early death.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11281 "infantile GM2 gangliosidosis")
Declaration(Class(goldbook:11282))
AnnotationAssertion(rdfs:label goldbook:11282 "tegmentum")
AnnotationAssertion(dcterms:description goldbook:11282 "Floor of the midbrain.")
Declaration(Class(goldbook:11283))
AnnotationAssertion(rdfs:label goldbook:11283 "telencephalon")
AnnotationAssertion(dcterms:description goldbook:11283 "Embryonic structure that develops into the cerebrum.")
Declaration(Class(goldbook:11284))
AnnotationAssertion(rdfs:label goldbook:11284 "telophase")
AnnotationAssertion(dcterms:description goldbook:11284 "Final phase of both meiosis and mitosis in which distinct nuclei form in each daughter cell.")
Declaration(Class(goldbook:11285))
AnnotationAssertion(rdfs:label goldbook:11285 "teratocarcinoma")
AnnotationAssertion(dcterms:description goldbook:11285 "Malignant teratoma, occurring most often in the testis.")
Declaration(Class(goldbook:11286))
AnnotationAssertion(rdfs:label goldbook:11286 "teratogen")
AnnotationAssertion(dcterms:description goldbook:11286 "Chemical, physical, or biological agent that, when administered to a parent either prior to conception or before birth of the child, induces permanent structural malformations or birth defects in the offspring.")
Declaration(Class(goldbook:11287))
AnnotationAssertion(rdfs:label goldbook:11287 "teratogenesis")
AnnotationAssertion(dcterms:description goldbook:11287 "Process of development of malformations or birth defects.")
Declaration(Class(goldbook:11288))
AnnotationAssertion(rdfs:label goldbook:11288 "teratogenetics")
AnnotationAssertion(dcterms:description goldbook:11288 "Study of how genes and teratogens interact to cause birth defects.")
Declaration(Class(goldbook:11289))
AnnotationAssertion(rdfs:label goldbook:11289 "teratogenic index")
AnnotationAssertion(dcterms:description goldbook:11289 "Mortality of eggs expressed as a lethal concentration divided by the threshold concentration for production of abnormal embryos with nonheritable permanent structural malformations or defects following exposure to a teratogen.")
Declaration(Class(goldbook:11290))
AnnotationAssertion(rdfs:label goldbook:11290 "teratogenicity")
AnnotationAssertion(dcterms:description goldbook:11290 "Inherent ability to act as a teratogen.")
Declaration(Class(goldbook:11291))
AnnotationAssertion(rdfs:label goldbook:11291 "teratology")
AnnotationAssertion(dcterms:description goldbook:11291 "Study of the causes, mechanisms, and manifestations of developmental deviation of either structure or function.")
Declaration(Class(goldbook:11292))
AnnotationAssertion(rdfs:label goldbook:11292 "teratoma")
AnnotationAssertion(dcterms:description goldbook:11292 "Benign germ cell-derived tumor containing embryonic elements of the three primary germ layers, such as skin, hair, and muscle, occurring most frequently in the ovary.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11292 "dermoid cyst")
Declaration(Class(goldbook:11293))
AnnotationAssertion(rdfs:label goldbook:11293 "Tessier classification")
AnnotationAssertion(dcterms:description goldbook:11293 "Classification of bony and soft tissue facial clefts based on their anatomic location.")
Declaration(Class(goldbook:11294))
AnnotationAssertion(rdfs:label goldbook:11294 "testicular feminization")
AnnotationAssertion(dcterms:description goldbook:11294 "Type of male pseudohermaphroditism in which the individual has a male karyotype and testes present within the abdominal cavity, but develops external female genitalia and female secondary sexual characteristics.")
Declaration(Class(goldbook:11295))
AnnotationAssertion(rdfs:label goldbook:11295 "testis")
AnnotationAssertion(dcterms:description goldbook:11295 "Gonad of a male animal, involved in the secretion of androgens and the site of sperm production.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11295 "testicle")
Declaration(Class(goldbook:11296))
AnnotationAssertion(rdfs:label goldbook:11296 "testosterone")
AnnotationAssertion(dcterms:description goldbook:11296 "Androgenic steroid hormone produced primarily in the testis, responsible for the development of the male sexual organs and male secondary sexual characteristics.")
Declaration(Class(goldbook:11297))
AnnotationAssertion(rdfs:label goldbook:11297 "tetralogy of Fallot")
AnnotationAssertion(dcterms:description goldbook:11297 "Set of four congenital cardiac defects involving an opening in the wall that should separate the right and left ventricles (ventricular septal defect), allowing the aorta to receive venous as well as arterial blood: including stenosis of the pulmonary artery, hypertrophy of the right ventricle, and displacement of the aorta. Right ventricular hypertrophy is the fourth part of the tetralogy, although it may also be a consequence of the other defects.")
Declaration(Class(goldbook:11298))
AnnotationAssertion(rdfs:label goldbook:11298 "thalamus")
AnnotationAssertion(dcterms:description goldbook:11298 "Either of two masses of grey matter, the largest part of the diencephalon, lying between the cerebral hemispheres on either side of the third ventricle, relaying sensory information and acting as a centre for pain perception.")
Declaration(Class(goldbook:11299))
AnnotationAssertion(rdfs:label goldbook:11299 "thalidomide")
AnnotationAssertion(dcterms:description goldbook:11299 "Teratogenic indole-based drug with sedative and anti-angiogenic properties.")
Declaration(Class(goldbook:11300))
AnnotationAssertion(rdfs:label goldbook:11300 "theca")
AnnotationAssertion(dcterms:description goldbook:11300 "Bilayer covering of the ovarian follicle (thus theca interna and externa), of which the theca interna is involved in production of androstenedione.")
Declaration(Class(goldbook:11301))
AnnotationAssertion(rdfs:label goldbook:11301 "thoracic duct")
AnnotationAssertion(dcterms:description goldbook:11301 "Largest of the lymphatic vessels; it conducts lymph from its origin in the abdomen to the venous circulation at the junction of the left subclavian and jugular veins.")
Declaration(Class(goldbook:11302))
AnnotationAssertion(rdfs:label goldbook:11302 "thrombocytopenia")
AnnotationAssertion(dcterms:description goldbook:11302 "Abnormally low concentration of platelets (thrombocytes) in the blood.")
Declaration(Class(goldbook:11303))
AnnotationAssertion(rdfs:label goldbook:11303 "thymus")
AnnotationAssertion(dcterms:description goldbook:11303 "Pyramid-shaped organ in the thoracic or cervical region of mammals, composed of lymphatic tissue in which minute concentric bodies (thymic corpuscles, the remnants of epithelial structures) are found.")
Declaration(Class(goldbook:11304))
AnnotationAssertion(rdfs:label goldbook:11304 "thyroglossal duct")
AnnotationAssertion(dcterms:description goldbook:11304 "Connection in the embryo between the site of initiation of development of the thyroid gland and its final location in the neck.")
Declaration(Class(goldbook:11305))
AnnotationAssertion(rdfs:label goldbook:11305 "thyroid gland")
AnnotationAssertion(dcterms:description goldbook:11305 "Bilobar endocrine gland, located below the prominence of cartilage surrounding the larynx (the Adam’s apple), that produces and secretes the hormones triiodothyronine (T3), thyroxin (T4), and calcitonin.")
Declaration(Class(goldbook:11306))
AnnotationAssertion(rdfs:label goldbook:11306 "accessory thyroid tissue")
AnnotationAssertion(dcterms:description goldbook:11306 "Ectopic thyroid tissue arising from remnants of the thyroglossal duct.")
Declaration(Class(goldbook:11307))
AnnotationAssertion(rdfs:label goldbook:11307 "thyroid stimulating hormone")
AnnotationAssertion(dcterms:description goldbook:11307 "Pituitary hormone that stimulates the thyroid gland to produce thyroxine (T4), and then triiodothyronine (T3).")
Declaration(Class(goldbook:11308))
AnnotationAssertion(rdfs:label goldbook:11308 "tonsil")
AnnotationAssertion(dcterms:description goldbook:11308 "Small, rounded mass of tissue, especially of lymphoid tissue; generally used to designate one of the paired palatine tonsils.")
Declaration(Class(goldbook:11309))
AnnotationAssertion(rdfs:label goldbook:11309 "toxoplasmosis")
AnnotationAssertion(dcterms:description goldbook:11309 "Infection with the parasite Toxoplasma gondii that, when acquired by the fetus, can lead to a variety of congenital abnormalities that may include hydrocephalus or microcephaly, mental retardation, and problems with vision and hearing.")
Declaration(Class(goldbook:11310))
AnnotationAssertion(rdfs:label goldbook:11310 "trachea")
AnnotationAssertion(dcterms:description goldbook:11310 "Thin-walled, cartilaginous tube descending from the larynx to the bronchi and carrying air to the lungs.")
Declaration(Class(goldbook:11311))
AnnotationAssertion(rdfs:label goldbook:11311 "transcription factor")
AnnotationAssertion(dcterms:description goldbook:11311 "DNA-binding protein that is involved in regulating gene expression.")
Declaration(Class(goldbook:11312))
AnnotationAssertion(rdfs:label goldbook:11312 "transgenic")
AnnotationAssertion(dcterms:description goldbook:11312 "Describing an organism that is genetically changed by the addition or deletion of genetic material or whose existing genes are altered by gene targeting.")
Declaration(Class(goldbook:11313))
AnnotationAssertion(rdfs:label goldbook:11313 "chromosomal translocation")
AnnotationAssertion(dcterms:description goldbook:11313 "Rearrangement involving transfer or exchange of genetic material between non-homologous chromosomes that may occur during gametogenesis or in somatic cells, potentially leading to birth defects.")
Declaration(Class(goldbook:11314))
AnnotationAssertion(rdfs:label goldbook:11314 "transplacental carcinogen")
AnnotationAssertion(dcterms:description goldbook:11314 "Substance that crosses the placenta and subsequently causes cancer in the child or young adult.")
Declaration(Class(goldbook:11315))
AnnotationAssertion(rdfs:label goldbook:11315 "transposition of the great arteries")
AnnotationAssertion(dcterms:description goldbook:11315 "Congenital cardiovascular malformation in which the position of the chief blood vessels of the heart (aorta and pulmonary artery) is reversed.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11315 "transposition of the great vessels")
Declaration(Class(goldbook:11316))
AnnotationAssertion(rdfs:label goldbook:11316 "Treacher Collins syndrome")
AnnotationAssertion(dcterms:description goldbook:11316 "Congenital deformity characterized by structural abnormalities of the head and face.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11316 "mandibulofacial dysostosis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11316 "Treacher Collins–Franceschetti syndrome")
Declaration(Class(goldbook:11317))
AnnotationAssertion(rdfs:label goldbook:11317 "trilaminar embryo")
AnnotationAssertion(dcterms:description goldbook:11317 "Disc-like embryonic stage in which differentiation into three layers (endoderm, mesoderm, and ectoderm) has occurred.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11317 "trilaminary blastoderm")
Declaration(Class(goldbook:11318))
AnnotationAssertion(rdfs:label goldbook:11318 "trimester")
AnnotationAssertion(dcterms:description goldbook:11318 "In pregnancy, one of three equal timed divisions of the normal human gestation period, each lasting approximately three months.")
Declaration(Class(goldbook:11319))
AnnotationAssertion(rdfs:label goldbook:11319 "triple screen")
AnnotationAssertion(dcterms:description goldbook:11319 "Measurement of maternal serum levels of alpha-fetoprotein, human chorionic gonadotropin, and estriol, usually in the second trimester of pregnancy, that can serve as an indicator of risk for certain fetal chromosomal abnormalities and neural tube defects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11319 "triple test")
Declaration(Class(goldbook:11320))
AnnotationAssertion(rdfs:label goldbook:11320 "triploidy")
AnnotationAssertion(dcterms:description goldbook:11320 "Presence of three haploid sets of chromosomes in the cell.")
Declaration(Class(goldbook:11321))
AnnotationAssertion(rdfs:label goldbook:11321 "trisomy")
AnnotationAssertion(dcterms:description goldbook:11321 "Condition of having three homologous chromosomes in each somatic cell instead of the normal pair.")
Declaration(Class(goldbook:11322))
AnnotationAssertion(rdfs:label goldbook:11322 "trisomy 8")
AnnotationAssertion(dcterms:description goldbook:11322 "Presence of an extra chromosome 8.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11322 "Warkany syndrome 2")
Declaration(Class(goldbook:11323))
AnnotationAssertion(rdfs:label goldbook:11323 "trisomy 13")
AnnotationAssertion(dcterms:description goldbook:11323 "Presence of part or all of an extra chromosome 13 from nondisjunction during meiosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11323 "Patau syndrome")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11323 "trisomy D")
Declaration(Class(goldbook:11324))
AnnotationAssertion(rdfs:label goldbook:11324 "trisomy 18")
AnnotationAssertion(dcterms:description goldbook:11324 "Presence of part or all of an extra chromosome 18 from nondisjunction during meiosis.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11324 "Edwards syndrome")
Declaration(Class(goldbook:11325))
AnnotationAssertion(rdfs:label goldbook:11325 "trisomy 21")
AnnotationAssertion(dcterms:description goldbook:11325 "Presence of an extra chromosome 21.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11325 "Down syndrome")
Declaration(Class(goldbook:11326))
AnnotationAssertion(rdfs:label goldbook:11326 "trophectoderm")
AnnotationAssertion(dcterms:description goldbook:11326 "Outer layer of the blastocyst that contacts the endometrium, establishes nutrition for the embryo, and differentiates into the trophoblast.")
Declaration(Class(goldbook:11327))
AnnotationAssertion(rdfs:label goldbook:11327 "trophoblast")
AnnotationAssertion(dcterms:description goldbook:11327 "Outer layer of the blastocyst that invades the endometrium and establishes nutrition for the embryo.")
Declaration(Class(goldbook:11328))
AnnotationAssertion(rdfs:label goldbook:11328 "truncus arteriosus")
AnnotationAssertion(dcterms:description goldbook:11328 "Arterial trunk, opening from the fetal heart and developing into the aorta and pulmonary artery.")
Declaration(Class(goldbook:11329))
AnnotationAssertion(rdfs:label goldbook:11329 "tuberoinfundibular pathway")
AnnotationAssertion(dcterms:description goldbook:11329 "Group of dopaminergic neurons in the hypothalamus involved in regulating prolactin secretion from the anterior pituitary gland.")
Declaration(Class(goldbook:11330))
AnnotationAssertion(rdfs:label goldbook:11330 "tumor")
AnnotationAssertion(dcterms:description goldbook:11330 "Any abnormal swelling or growth of tissue, whether benign or malignant.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11330 "tumour")
Declaration(Class(goldbook:11331))
AnnotationAssertion(rdfs:label goldbook:11331 "tunica albuginea")
AnnotationAssertion(dcterms:description goldbook:11331 "Dense, collagenous fibrous coat surrounding an anatomical structure, and in particular surrounding the ovaries, testicles, and corpora cavernosa of the penis.")
Declaration(Class(goldbook:11332))
AnnotationAssertion(rdfs:label goldbook:11332 "tunica vaginalis")
AnnotationAssertion(dcterms:description goldbook:11332 "Membranous sheath, derived from the peritoneum, surrounding the testis and epididymis.")
Declaration(Class(goldbook:11333))
AnnotationAssertion(rdfs:label goldbook:11333 "turner syndrome")
AnnotationAssertion(dcterms:description goldbook:11333 "Phenotypic female lacking one X chromosome, the genotype being designated XO.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11333 "Ullrich–Turner syndrome")
Declaration(Class(goldbook:11334))
AnnotationAssertion(rdfs:label goldbook:11334 "two-generation reprotox study")
AnnotationAssertion(dcterms:description goldbook:11334 "Procedure in rodents wherein parents (P0 generation) and their offspring (F1 generation) are both exposed to a test substance and the second generation (F2) is examined for possible toxic effects.")
Declaration(Class(goldbook:11335))
AnnotationAssertion(rdfs:label goldbook:11335 "tympanic")
AnnotationAssertion(dcterms:description goldbook:11335 "In anatomy, relating to the resonant cavity and membrane of the inner ear.")
Declaration(Class(goldbook:11336))
AnnotationAssertion(rdfs:label goldbook:11336 "ultrasonography")
AnnotationAssertion(dcterms:description goldbook:11336 "Imaging technique that creates a picture of internal body structures from differentially reflected ultrasound waves.")
Declaration(Class(goldbook:11337))
AnnotationAssertion(rdfs:label goldbook:11337 "ultrasound")
AnnotationAssertion(dcterms:description goldbook:11337 """Sound waves of frequency higher than the range audible to the human ear.
Imaging technique that uses such sound waves to create a picture of internal body structures.""")
Declaration(Class(goldbook:11338))
AnnotationAssertion(rdfs:label goldbook:11338 "umbilical artery")
AnnotationAssertion(dcterms:description goldbook:11338 "Paired artery that, in the fetus, returns deoxygenated blood from each half of the fetal body to the placenta, via the umbilical cord.")
Declaration(Class(goldbook:11339))
AnnotationAssertion(rdfs:label goldbook:11339 "umbilical cord")
AnnotationAssertion(dcterms:description goldbook:11339 "Cord-like structure connecting the fetus with the placenta and housing the umbilical artery and umbilical vein that carry nutrients from the mother and remove wastes from the fetus.")
Declaration(Class(goldbook:11340))
AnnotationAssertion(rdfs:label goldbook:11340 "umbilical hernia")
AnnotationAssertion(dcterms:description goldbook:11340 "Protrusion of bowel or omentum through the abdominal wall at the umbilicus.")
Declaration(Class(goldbook:11341))
AnnotationAssertion(rdfs:label goldbook:11341 "umbilical vein")
AnnotationAssertion(dcterms:description goldbook:11341 "Vessel within the umbilical cord, entering the fetus at the umbilicus and carrying oxygenated blood from the placenta.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11341 "left umbilical vein")
Declaration(Class(goldbook:11342))
AnnotationAssertion(rdfs:label goldbook:11342 "undescended testis")
AnnotationAssertion(dcterms:description goldbook:11342 "Testis that has failed to descend completely from its developmental origin in the lower abdominal cavity into the scrotum.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11342 "cryptorchid testis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11342 "cryptorchidism")
Declaration(Class(goldbook:11343))
AnnotationAssertion(rdfs:label goldbook:11343 "urethra")
AnnotationAssertion(dcterms:description goldbook:11343 "Duct by which urine is conveyed out of the body from the bladder, and which in male vertebrates also conveys semen.")
Declaration(Class(goldbook:11344))
AnnotationAssertion(rdfs:label goldbook:11344 "urogenital")
AnnotationAssertion(dcterms:description goldbook:11344 "Concerning the urinary and genital organs.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11344 "genitourinary")
Declaration(Class(goldbook:11345))
AnnotationAssertion(rdfs:label goldbook:11345 "urogenital sinus")
AnnotationAssertion(dcterms:description goldbook:11345 "Embryonic structure that forms in the ventral part of the cloaca when it separates from the anal canal to give rise to the genitourinary organs.")
Declaration(Class(goldbook:11346))
AnnotationAssertion(rdfs:label goldbook:11346 "uterine crypt")
AnnotationAssertion(dcterms:description goldbook:11346 "Chamber on the interior surface of the uterus that serves as a site of embryo homing and implantation.")
Declaration(Class(goldbook:11347))
AnnotationAssertion(rdfs:label goldbook:11347 "uterine cycle")
AnnotationAssertion(dcterms:description goldbook:11347 "Regular, periodic changes that occur in the uterus and, together with the ovarian cycle constitute the menstrual cycle necessary for female fertility.")
Declaration(Class(goldbook:11348))
AnnotationAssertion(rdfs:label goldbook:11348 "uterotrophic")
AnnotationAssertion(dcterms:description goldbook:11348 "Having an effect on the uterus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11348 "uterotropic")
Declaration(Class(goldbook:11349))
AnnotationAssertion(rdfs:label goldbook:11349 "uterotrophic assay")
AnnotationAssertion(dcterms:description goldbook:11349 "Procedure in which immature female rodents are treated for three days with a test substance. A resultant increase in uterine wet weight suggests an estrogenic activity of the substance.")
Declaration(Class(goldbook:11350))
AnnotationAssertion(rdfs:label goldbook:11350 "uterus")
AnnotationAssertion(dcterms:description goldbook:11350 "Hollow muscular organ of the female reproductive system that receives the fertilized ovum (see implantation) and supports the subsequent development of the fetus.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11350 "womb")
Declaration(Class(goldbook:11351))
AnnotationAssertion(rdfs:label goldbook:11351 "uvula")
AnnotationAssertion(dcterms:description goldbook:11351 "Muscular projection from the posterior edge of the soft palate.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11351 "palatine uvula")
Declaration(Class(goldbook:11352))
AnnotationAssertion(rdfs:label goldbook:11352 "vagina")
AnnotationAssertion(dcterms:description goldbook:11352 "Fibromuscular canal passing between the uterine cervix and the opening to the vulva.")
Declaration(Class(goldbook:11353))
AnnotationAssertion(rdfs:label goldbook:11353 "vaginal cornification")
AnnotationAssertion(dcterms:description goldbook:11353 "Conversion of the normal epithelium of the vagina to a keratinized squamous (flattened) epithelium.")
Declaration(Class(goldbook:11354))
AnnotationAssertion(rdfs:label goldbook:11354 "vaginal patency")
AnnotationAssertion(dcterms:description goldbook:11354 "Referring to the opening of the vagina that usually occurs at sexual maturity and is maintained by hormonal influences pre-menopausally.")
Declaration(Class(goldbook:11355))
AnnotationAssertion(rdfs:label goldbook:11355 "vaginal smear")
AnnotationAssertion(dcterms:description goldbook:11355 "Examination by light microscopy of a sample of a vaginal discharge, used in the diagnosis of a vaginal infection.")
Declaration(Class(goldbook:11356))
AnnotationAssertion(rdfs:label goldbook:11356 "developmental variation")
AnnotationAssertion(dcterms:description goldbook:11356 "Anatomical deviation that is not life-threatening.")
Declaration(Class(goldbook:11357))
AnnotationAssertion(rdfs:label goldbook:11357 "vasculogenesis")
AnnotationAssertion(dcterms:description goldbook:11357 "De novo development of blood vessel endothelium in absence of preexisting vessels, e.g., during fetal development or in connection with tissue repair, initiated by migration of mesodermal precursor cells.")
Declaration(Class(goldbook:11358))
AnnotationAssertion(rdfs:label goldbook:11358 "vas deferens")
AnnotationAssertion(dcterms:description goldbook:11358 "Secretory duct of the testis running between the epididymis and the ejaculatory duct.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11358 "ductus deferens")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11358 "spermatic duct")
Declaration(Class(goldbook:11359))
AnnotationAssertion(rdfs:label goldbook:11359 "vasectomy")
AnnotationAssertion(dcterms:description goldbook:11359 "Surgical removal of all or part of each vas deferens, typically as a means of sterilization.")
Declaration(Class(goldbook:11360))
AnnotationAssertion(rdfs:label goldbook:11360 "vasopressin")
AnnotationAssertion(dcterms:description goldbook:11360 "Pituitary hormone that acts to promote the retention of water by the kidneys and to increase blood pressure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11360 "antidiuretic hormone")
Declaration(Class(goldbook:11361))
AnnotationAssertion(rdfs:label goldbook:11361 "velopharyngeal insufficiency")
AnnotationAssertion(dcterms:description goldbook:11361 "Inability to achieve closure of the velopharyngeal sphincter (closure of the muscle of the soft palate) during speech, owing to muscular dysfunction, cleft palate, or other disorders.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11361 "velopharyngeal incompetence")
Declaration(Class(goldbook:11362))
AnnotationAssertion(rdfs:label goldbook:11362 "vena cava")
AnnotationAssertion(dcterms:description goldbook:11362 "Large vein returning deoxygenated blood to the right heart.")
Declaration(Class(goldbook:11363))
AnnotationAssertion(rdfs:label goldbook:11363 "ventral")
AnnotationAssertion(dcterms:description goldbook:11363 "Situated to the anterior side of the trunk; in humans, to the front of the body.")
Declaration(Class(goldbook:11364))
AnnotationAssertion(rdfs:label goldbook:11364 "ventricular septum")
AnnotationAssertion(dcterms:description goldbook:11364 "Dividing wall between the two lower chambers (ventricles) of the heart.")
Declaration(Class(goldbook:11365))
AnnotationAssertion(rdfs:label goldbook:11365 "ventricular septal defect")
AnnotationAssertion(dcterms:description goldbook:11365 "Congenital defect with an opening in the wall separating the right and left ventricles of the heart (see ventricular septum).")
Declaration(Class(goldbook:11366))
AnnotationAssertion(rdfs:label goldbook:11366 "vertebra")
AnnotationAssertion(dcterms:description goldbook:11366 "One of the bony segments that together make up the bony column surrounding the spinal cord.")
Declaration(Class(goldbook:11367))
AnnotationAssertion(rdfs:label goldbook:11367 "vertebrate")
AnnotationAssertion(dcterms:description goldbook:11367 "Denoting an animal that has as part of its nervous system a spinal cord that is surrounded by a bony vertebral column.")
Declaration(Class(goldbook:11368))
AnnotationAssertion(rdfs:label goldbook:11368 "vesicle")
AnnotationAssertion(dcterms:description goldbook:11368 "Small fluid-filled sac, bladder-like structure, or blister.")
Declaration(Class(goldbook:11369))
AnnotationAssertion(rdfs:label goldbook:11369 "vestigial")
AnnotationAssertion(dcterms:description goldbook:11369 "In anatomy, pertaining to a remnant of an embryonic or fetal structure persisting in the adult.")
Declaration(Class(goldbook:11370))
AnnotationAssertion(rdfs:label goldbook:11370 "viability")
AnnotationAssertion(dcterms:description goldbook:11370 "Ability to continue living.")
Declaration(Class(goldbook:11371))
AnnotationAssertion(rdfs:label goldbook:11371 "villus")
AnnotationAssertion(dcterms:description goldbook:11371 """Projection from the surface, typically of a mucous membrane.
Elongated projection of the dermis into an epidermal space.""")
Declaration(Class(goldbook:11372))
AnnotationAssertion(rdfs:label goldbook:11372 "vimentin")
AnnotationAssertion(dcterms:description goldbook:11372 "Intermediate filament protein that is expressed in mesenchymal cells, e.g., fibroblasts, leukocytes, and blood vessel endothelial cells.")
Declaration(Class(goldbook:11373))
AnnotationAssertion(rdfs:label goldbook:11373 "virilization")
AnnotationAssertion(dcterms:description goldbook:11373 "Possession or acquisition of characteristics of a male body, especially by a female or prepubescent male.")
Declaration(Class(goldbook:11374))
AnnotationAssertion(rdfs:label goldbook:11374 "viscera")
AnnotationAssertion(dcterms:description goldbook:11374 "Soft and hollow organs of the body, in vertebrates particularly those found in the thoracic and abdominal cavities.")
Declaration(Class(goldbook:11375))
AnnotationAssertion(rdfs:label goldbook:11375 "vitellogenin")
AnnotationAssertion(dcterms:description goldbook:11375 "Protein that forms part of the yolk of egg-laying vertebrates.")
Declaration(Class(goldbook:11376))
AnnotationAssertion(rdfs:label goldbook:11376 "vulva")
AnnotationAssertion(dcterms:description goldbook:11376 "External genitalia of the female.")
Declaration(Class(goldbook:11377))
AnnotationAssertion(rdfs:label goldbook:11377 "wean")
AnnotationAssertion(dcterms:description goldbook:11377 "Accustomize a young mammal to independence from its mother’s milk as a source of nutrition.")
Declaration(Class(goldbook:11378))
AnnotationAssertion(rdfs:label goldbook:11378 "web")
AnnotationAssertion(dcterms:description goldbook:11378 "Tissue or membrane present between adjacent structures where it is not usually found, e.g., between fingers or toes, or between the neck and shoulder, representing a congenital abnormality.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11378 "webbing")
Declaration(Class(goldbook:11379))
AnnotationAssertion(rdfs:label goldbook:11379 "Wharton’s jelly")
AnnotationAssertion(dcterms:description goldbook:11379 "Gelatinous substance that embeds the vessels of the umbilical cord.")
Declaration(Class(goldbook:11380))
AnnotationAssertion(rdfs:label goldbook:11380 "white matter")
AnnotationAssertion(dcterms:description goldbook:11380 "Portion of the brain and spinal cord consisting mainly of myelinated axons (see myelination) and glial cells.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11380 "substantia alba")
Declaration(Class(goldbook:11381))
AnnotationAssertion(rdfs:label goldbook:11381 "whole embryo culture")
AnnotationAssertion(dcterms:description goldbook:11381 "Technique, used prior to embryo transfer during in vitro fertilization, in which embryos undergoing organogenesis are maintained in formulated medium outside the body.")
Declaration(Class(goldbook:11382))
AnnotationAssertion(rdfs:label goldbook:11382 "wild type")
AnnotationAssertion(dcterms:description goldbook:11382 "Of an allele or phenotype, the naturally occurring, unaltered, or most frequent; if several alleles occur, the most frequent one is considered to be the wild type.")
Declaration(Class(goldbook:11383))
AnnotationAssertion(rdfs:label goldbook:11383 "Williams syndrome")
AnnotationAssertion(dcterms:description goldbook:11383 "Congenital disorder with characteristic facies (described as elf-like), short stature, outgoing personality and mild mental retardation; associated with contiguous gene deletions on chromosome 7.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11383 "elfin facies syndrome")
Declaration(Class(goldbook:11384))
AnnotationAssertion(rdfs:label goldbook:11384 "Wnt")
AnnotationAssertion(dcterms:description goldbook:11384 "Family of genes important in development, the proteins they encode, or the signal transduction pathways they determine.")
Declaration(Class(goldbook:11385))
AnnotationAssertion(rdfs:label goldbook:11385 "X chromosome")
AnnotationAssertion(dcterms:description goldbook:11385 "Chromosome determining female sex in the absence of a Y chromosome.")
Declaration(Class(goldbook:11386))
AnnotationAssertion(rdfs:label goldbook:11386 "X-linked")
AnnotationAssertion(dcterms:description goldbook:11386 "Carried by a gene located on the X chromosome.")
Declaration(Class(goldbook:11387))
AnnotationAssertion(rdfs:label goldbook:11387 "Y chromosome")
AnnotationAssertion(dcterms:description goldbook:11387 "Chromosome determining male sex.")
Declaration(Class(goldbook:11388))
AnnotationAssertion(rdfs:label goldbook:11388 "yolk")
AnnotationAssertion(dcterms:description goldbook:11388 "Nutritive material stored in the ovum for the nourishment of the embryo.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11388 "vitellus")
Declaration(Class(goldbook:11389))
AnnotationAssertion(rdfs:label goldbook:11389 "yolk sac")
AnnotationAssertion(dcterms:description goldbook:11389 "Fluid-filled, membrane-bound pouch on the ventral side of the early embryo that provides nourishment until the circulatory system develops.")
Declaration(Class(goldbook:11390))
AnnotationAssertion(rdfs:label goldbook:11390 "yolk stalk")
AnnotationAssertion(dcterms:description goldbook:11390 "Narrow tubular support that connects the yolk sac to the middle of the digestive tract of an embryo.")
Declaration(Class(goldbook:11391))
AnnotationAssertion(rdfs:label goldbook:11391 "zinc finger")
AnnotationAssertion(dcterms:description goldbook:11391 "Small tertiary protein structure in which parts of the protein, typically with cysteine and histidine residues, link to a divalent zinc ion, forming a loop or 'finger' that attaches proteins to DNA.")
Declaration(Class(goldbook:11392))
AnnotationAssertion(rdfs:label goldbook:11392 "zona pellucida")
AnnotationAssertion(dcterms:description goldbook:11392 "Acellular glycoprotein-rich membrane surrounding the mature ovum.")
Declaration(Class(goldbook:11393))
AnnotationAssertion(rdfs:label goldbook:11393 "zygosis")
AnnotationAssertion(dcterms:description goldbook:11393 "Sexual union of two cells with fusion of their nuclei.")
Declaration(Class(goldbook:11394))
AnnotationAssertion(rdfs:label goldbook:11394 "zygote intrafallopian transfer")
AnnotationAssertion(dcterms:description goldbook:11394 "Introduction of a zygote fertilized in vitro into one of the Fallopian tubes.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11394 "tubal embryo transfer")
Declaration(Class(goldbook:11395))
AnnotationAssertion(rdfs:label goldbook:11395 "1D property descriptor")
AnnotationAssertion(dcterms:description goldbook:11395 "An observed or calculated property of the whole molecule.")
Declaration(Class(goldbook:11396))
AnnotationAssertion(rdfs:label goldbook:11396 "1D structure")
AnnotationAssertion(dcterms:description goldbook:11396 "The structure of a molecule encoded into a string such as SMILES or InChI.")
Declaration(Class(goldbook:11397))
AnnotationAssertion(rdfs:label goldbook:11397 "2D property")
AnnotationAssertion(dcterms:description goldbook:11397 "A molecular property that is calculated from the structure diagram of the molecule.")
Declaration(Class(goldbook:11398))
AnnotationAssertion(rdfs:label goldbook:11398 "2D structure")
AnnotationAssertion(dcterms:description goldbook:11398 "The structure of a molecule presented as a drawing or a file that contains a description of the topology, stereochemistry, and atomic symbol of its atoms and the bonds connecting them, but no explicit information about its three-dimensional structure.")
Declaration(Class(goldbook:11399))
AnnotationAssertion(rdfs:label goldbook:11399 "2D quantitative structure-activity relationships")
AnnotationAssertion(dcterms:description goldbook:11399 "A computational model of the quantitative relationship between the observed independent 1D property of a set of compounds and their dependent 1D properties or 2D properties.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11399 "two-dimensional quantitative structure-activity relationships")
Declaration(Class(goldbook:11400))
AnnotationAssertion(rdfs:label goldbook:11400 "3D property")
AnnotationAssertion(dcterms:description goldbook:11400 "A property that is observed or calculated from a 3D representation of a molecule, which may depend on one or more conformations of the molecule.")
Declaration(Class(goldbook:11401))
AnnotationAssertion(rdfs:label goldbook:11401 "3D searching")
AnnotationAssertion(dcterms:description goldbook:11401 "A virtual screening method that processes a chemical database to discover those compounds that match a query that either contains a 3D pharmacophore, a molecular shape or field, the 3D structure, or a combination of these.")
Declaration(Class(goldbook:11402))
AnnotationAssertion(rdfs:label goldbook:11402 "3D structure")
AnnotationAssertion(dcterms:description goldbook:11402 "The structure of the conformation of a molecule presented as a drawing or a file that describes atomic symbols of its atoms and the bonds connecting them as well as their coordinates in three-dimensional space.")
Declaration(Class(goldbook:11403))
AnnotationAssertion(rdfs:label goldbook:11403 "3D structure generation")
AnnotationAssertion(dcterms:description goldbook:11403 "A method to generate one or more 3D structures, conformations, of a molecule from its topological molecular graph.")
Declaration(Class(goldbook:11404))
AnnotationAssertion(rdfs:label goldbook:11404 "4D quantitative structure-activity relationships")
AnnotationAssertion(dcterms:description goldbook:11404 """A computational model of the quantitative relationship between the target observed independent 1D properties for a set of compounds and the 3D properties of
 several of their conformations.""")
Declaration(Class(goldbook:11405))
AnnotationAssertion(rdfs:label goldbook:11405 "algorithm")
AnnotationAssertion(dcterms:description goldbook:11405 "A step-by-step procedure for solving a problem or performing a function, usually by a computer.")
Declaration(Class(goldbook:11406))
AnnotationAssertion(rdfs:label goldbook:11406 "applicability domain")
AnnotationAssertion(dcterms:description goldbook:11406 "The property or structure space for which the predictions of a computational model are considered to be reliable.")
Declaration(Class(goldbook:11407))
AnnotationAssertion(rdfs:label goldbook:11407 "area under the curve")
AnnotationAssertion(dcterms:description goldbook:11407 """The area under a graph curve, such as the number of actives identified by an algorithm as a function of the number of compounds tested, commonly used as a
 measure of the discriminating ability of an algorithm to correctly classify a test molecule.""")
Declaration(Class(goldbook:11408))
AnnotationAssertion(rdfs:label goldbook:11408 "autocorrelation vector")
AnnotationAssertion(dcterms:description goldbook:11408 """A vector that describes a molecular structure in which each element corresponds to a distance (number of bonds in a 2D structure or a binned interatomic
 distance in a 3D structure) between atoms of a particular type and the count of the number of times that distance is found in the structure.""")
Declaration(Class(goldbook:11409))
AnnotationAssertion(rdfs:label goldbook:11409 "basis set superposition error")
AnnotationAssertion(dcterms:description goldbook:11409 "An artifactual increase in calculated stability of the supersystem (the system formed by noncovalent interaction between two or more molecular entities, e.g. hydrogen bond system) resulting from the basis set of the supersystem being larger than for the component subsystems. The BSSE arises from a lowering of the quantum mechanical energy when the electron density of each subsystem spreads into the basis functions provided by the other subsystems.")
Declaration(Class(goldbook:11410))
AnnotationAssertion(rdfs:label goldbook:11410 "Bayesian regularized neural network")
AnnotationAssertion(dcterms:description goldbook:11410 "A feed-forward neural network that uses Bayesian statistics to optimize the complexity and predictive power of the model.")
Declaration(Class(goldbook:11411))
AnnotationAssertion(rdfs:label goldbook:11411 "Bayesian statistics")
AnnotationAssertion(dcterms:description goldbook:11411 "A branch of statistics in which the evidence of the state of a system is expressed in terms of degrees of belief (probabilities).")
Declaration(Class(goldbook:11412))
AnnotationAssertion(rdfs:label goldbook:11412 "Bayes’s theorem")
AnnotationAssertion(dcterms:description goldbook:11412 "A method for calculating prior probability estimates of an event that can be revised in accordance with new observations.")
Declaration(Class(goldbook:11413))
AnnotationAssertion(rdfs:label goldbook:11413 "belief theory")
AnnotationAssertion(dcterms:description goldbook:11413 "A method to combine probability estimate states that given two or more probabilities \\(P_{i}\\) that a particular event is true, the combined probability of the event is given by: \\[P = 1 - \\Pi (1 - {P_{i}})\\]")
Declaration(Class(goldbook:11414))
AnnotationAssertion(rdfs:label goldbook:11414 "bilinear equation")
AnnotationAssertion(dcterms:description goldbook:11414 "A QSAR equation that describes the non-linear dependence of the relative biological potency (\\(\\log 1/C\\)) of a molecule on log P by the following form: \\[log(1/{C_i}) = a\\log P_{i} - b \\log (\\beta P_{i} + 1) + c\\]")
Declaration(Class(goldbook:11415))
AnnotationAssertion(rdfs:label goldbook:11415 "bit string")
AnnotationAssertion(dcterms:description goldbook:11415 """A description of a molecule in a fixed length vector, each element of which is set from corresponding structural keys or calculated by hashing a molecular
 fingerprint.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11415 "bitmap")
Declaration(Class(goldbook:11416))
AnnotationAssertion(rdfs:label goldbook:11416 "Boltzmann enhanced discrimination of receiver operating characteristic")
AnnotationAssertion(dcterms:description goldbook:11416 "A generalization of the area under the ROC curve to weight more heavily the early recognition of active compounds.")
Declaration(Class(goldbook:11417))
AnnotationAssertion(rdfs:label goldbook:11417 "bootstrap resampling")
AnnotationAssertion(dcterms:description goldbook:11417 "A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from many models developed using sample sets that contain the same number of observations as the original set, but for which certain observations are randomly omitted and other observations are included more than once.")
Declaration(Class(goldbook:11418))
AnnotationAssertion(rdfs:label goldbook:11418 "calculated molar refractivity")
AnnotationAssertion(dcterms:description goldbook:11418 "The calculated molar refractivity of a molecule or substituent used as a measure of size and polarizability in 2D-QSAR.")
Declaration(Class(goldbook:11419))
AnnotationAssertion(rdfs:label goldbook:11419 "canonical structure representation")
AnnotationAssertion(dcterms:description goldbook:11419 """A unique representation of the chemical structure of a molecule that is independent of the sequence in which the atoms were ordered in the original input file
 but is dependent on the algorithm used for the canonicalization.""")
Declaration(Class(goldbook:11420))
AnnotationAssertion(rdfs:label goldbook:11420 "chance correlation")
AnnotationAssertion(dcterms:description goldbook:11420 "An artificial correlation that can arise when too many properties are screened relative to the number of available observations.")
Declaration(Class(goldbook:11421))
AnnotationAssertion(rdfs:label goldbook:11421 "cheminformatics")
AnnotationAssertion(dcterms:description goldbook:11421 """The science of handling, indexing, archiving, searching, and evaluating information that is specific to chemical structures and is used in data mining,
 information retrieval, information extraction, and machine learning.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11421 "chemoinformatics")
Declaration(Class(goldbook:11422))
AnnotationAssertion(rdfs:label goldbook:11422 "circular fingerprints")
AnnotationAssertion(dcterms:description goldbook:11422 """Hashed molecular fingerprints that describe, either by atom type or properties, each atom in the molecule; the atoms connected to it (for path length 2); the
 atoms connected to them (for path length 4); and the atoms connected to them (for path length 6); etc..""")
Declaration(Class(goldbook:11423))
AnnotationAssertion(rdfs:label goldbook:11423 "clog P")
AnnotationAssertion(dcterms:description goldbook:11423 "Calculated log of the octan-1-ol/water partition coefficient.")
Declaration(Class(goldbook:11424))
AnnotationAssertion(rdfs:label goldbook:11424 "cluster centroid")
AnnotationAssertion(dcterms:description goldbook:11424 "The geometric center of a cluster, often exemplified as the object that is closest to the center.")
Declaration(Class(goldbook:11425))
AnnotationAssertion(rdfs:label goldbook:11425 "collinearity")
AnnotationAssertion(dcterms:description goldbook:11425 """A linear relationship between two or more of the descriptors in a model, which can lead to difficulties in interpreting the relative importance of these
 descriptors.""")
Declaration(Class(goldbook:11426))
AnnotationAssertion(rdfs:label goldbook:11426 "comparative molecular similarity analysis")
AnnotationAssertion(dcterms:description goldbook:11426 """A 3D-QSAR method similar to CoMFA that instead uses Gaussian-type functions to calculate the 3D properties of the molecules by the similarity of each molecule
 to each probe at each lattice position surrounding the molecules.""")
Declaration(Class(goldbook:11427))
AnnotationAssertion(rdfs:label goldbook:11427 "concordance")
AnnotationAssertion(dcterms:description goldbook:11427 "The ability of a two-group classification model to correctly classify all molecules.")
Declaration(Class(goldbook:11428))
AnnotationAssertion(rdfs:label goldbook:11428 "confusion matrix")
AnnotationAssertion(dcterms:description goldbook:11428 "A table layout that shows the results of a two-class/binary classifier in which columns correspond to the predicted classifications from the model and rows correspond to the observed classifications.")
Declaration(Class(goldbook:11429))
AnnotationAssertion(rdfs:label goldbook:11429 "continuum")
AnnotationAssertion(dcterms:description goldbook:11429 "The computational representation of a solvent as a continuous medium instead of individual explicit solvent molecules.")
Declaration(Class(goldbook:11430))
AnnotationAssertion(rdfs:label goldbook:11430 "counterpoise correction")
AnnotationAssertion(dcterms:description goldbook:11430 "A method to correct for basis set superposition error.")
Declaration(Class(goldbook:11431))
AnnotationAssertion(rdfs:label goldbook:11431 "data mining")
AnnotationAssertion(dcterms:description goldbook:11431 "The extraction of useful information from large sets of observations.")
Declaration(Class(goldbook:11432))
AnnotationAssertion(rdfs:label goldbook:11432 "Daylight fingerprints")
AnnotationAssertion(dcterms:description goldbook:11432 """Path fingerprints that are generated from a structure where atoms are described by atomic number and aromaticity; bonds are described as single, double,
 triple, or aromatic; and the results are hashed into a bit string of fixed length.""")
Declaration(Class(goldbook:11433))
AnnotationAssertion(rdfs:label goldbook:11433 "de novo design")
AnnotationAssertion(dcterms:description goldbook:11433 "The process whereby a computer algorithm designs new molecules to meet certain single or multiple criteria, defined by an objective function, for example predicted affinity for a binding site or predicted affinity plus appropriate lipophilicity.")
Declaration(Class(goldbook:11434))
AnnotationAssertion(rdfs:label goldbook:11434 "decision tree")
AnnotationAssertion(dcterms:description goldbook:11434 "The result of a recursive partitioning classification method that shows at each branching point the value of the property responsible for the split and the resulting classifications after the split.")
Declaration(Class(goldbook:11435))
AnnotationAssertion(rdfs:label goldbook:11435 "density functional theory")
AnnotationAssertion(dcterms:description goldbook:11435 """A quantum mechanical modeling method used to investigate the electronic structure of molecules using functionals that describe the spatially dependent electron density, rather than the wavefunction as in
ab initio and semi-empirical quantum chemical methods.""")
Declaration(Class(goldbook:11436))
AnnotationAssertion(rdfs:label goldbook:11436 "descriptor")
AnnotationAssertion(dcterms:description goldbook:11436 "A qualitative or quantitative property of a molecule or a part of a molecule.")
Declaration(Class(goldbook:11437))
AnnotationAssertion(rdfs:label goldbook:11437 "docking")
AnnotationAssertion(dcterms:description goldbook:11437 "Computational methods that optimize the placement of a ligand in a macromolecular binding site of known or proposed 3D structure and provide a score as to the quality of the fit.")
Declaration(Class(goldbook:11438))
AnnotationAssertion(rdfs:label goldbook:11438 "drug-likeness")
AnnotationAssertion(dcterms:description goldbook:11438 "An estimate of the probability that a chemical structure is similar to known drugs based on chemical or physical properties.")
Declaration(Class(goldbook:11439))
AnnotationAssertion(rdfs:label goldbook:11439 "energy of the highest occupied molecular orbital")
AnnotationAssertion(dcterms:description goldbook:11439 """The energy of the highest energy level in the ground state of a molecule that contains electrons, sometimes used as a measure of nucleophilicity in QSAR
 models.""")
Declaration(Class(goldbook:11440))
AnnotationAssertion(rdfs:label goldbook:11440 "energy of the lowest unoccupied molecular orbital")
AnnotationAssertion(dcterms:description goldbook:11440 """The energy of the lowest energy level of a molecule that contains no electrons in the ground state, sometimes used as a measure of electrophilicity in QSAR
 models.""")
Declaration(Class(goldbook:11441))
AnnotationAssertion(rdfs:label goldbook:11441 "expert system")
AnnotationAssertion(dcterms:description goldbook:11441 "A system that predicts properties or activities of chemicals from rules devised by domain experts.")
Declaration(Class(goldbook:11442))
AnnotationAssertion(rdfs:label goldbook:11442 "explicit solvent")
AnnotationAssertion(dcterms:description goldbook:11442 "Individual solvent molecules that are included in a computation, in contrast to those implied by a continuum approximation.")
Declaration(Class(goldbook:11443))
AnnotationAssertion(rdfs:label goldbook:11443 "extended connectivity fingerprints")
AnnotationAssertion(dcterms:description goldbook:11443 """Hashed circular fingerprints that encode each atom according to its atomic symbol and hybridization for path length 2, ECFP2; path length 4, ECFP4; and path
 length 6, ECFP6.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11443 "ECFP fingerprints")
Declaration(Class(goldbook:11444))
AnnotationAssertion(rdfs:label goldbook:11444 "false negative")
AnnotationAssertion(dcterms:description goldbook:11444 "A model prediction of a negative result, such as no biological activity, when the true result is positive, i.e. activity.")
Declaration(Class(goldbook:11445))
AnnotationAssertion(rdfs:label goldbook:11445 "false positive")
AnnotationAssertion(dcterms:description goldbook:11445 "A model prediction of a positive result, such as biological activity, when the true result is negative, i.e. inactivity.")
Declaration(Class(goldbook:11446))
AnnotationAssertion(rdfs:label goldbook:11446 "force field")
AnnotationAssertion(dcterms:description goldbook:11446 "A set of mathematical functions and their associated parameters used in a molecular mechanics or dynamics calculation of conformations, flexibility, and interactions of molecules.")
Declaration(Class(goldbook:11447))
AnnotationAssertion(rdfs:label goldbook:11447 "fragment keys")
AnnotationAssertion(dcterms:description goldbook:11447 """Description of the structure of a molecule as the presence or absence of each of a pre-determined set of molecular substructures, usually associated with a
 particular location in a bit string.""")
Declaration(Class(goldbook:11448))
AnnotationAssertion(rdfs:label goldbook:11448 "free energy perturbation")
AnnotationAssertion(dcterms:description goldbook:11448 "A method that uses molecular dynamics or Metropolis Monte Carlo simulations to compute the relative free energy differences between two conditions, typically the solution and bound states of a ligand-protein system.")
Declaration(Class(goldbook:11449))
AnnotationAssertion(rdfs:label goldbook:11449 "functional class fingerprints")
AnnotationAssertion(dcterms:description goldbook:11449 """Hashed circular fingerprints that encode each atom according to its property (hydrophobic, hydrogen bond donor, hydrogen bond acceptor, negatively charged, or
 positively charged) for path length 2, FCFP2; path length 4, FCFP4; and path length 6, FCFP6.""")
Declaration(Class(goldbook:11450))
AnnotationAssertion(rdfs:label goldbook:11450 "global model")
AnnotationAssertion(dcterms:description goldbook:11450 """A computational model designed to cover all of chemistry space although it typically includes a measure of if the molecule for which the properties are to be
 predicted is within or outside the applicability domain of the model.""")
Declaration(Class(goldbook:11451))
AnnotationAssertion(rdfs:label goldbook:11451 "graph-based method")
AnnotationAssertion(dcterms:description goldbook:11451 "A computational method that converts the problem to be solved into a graph characterized by the character of the objects, such the atoms of a molecule or molecules in a database, and the distances between them.")
Declaration(Class(goldbook:11452))
AnnotationAssertion(rdfs:label goldbook:11452 "Hansch equation")
AnnotationAssertion(dcterms:description goldbook:11452 "A QSAR equation that describes the relationship between the logarithm of the relative biological potency of a molecule (\\(\\log (1/C_{i})\\)) and its electronic and hydrophobic properties: \\[\\log (1/C_{i}) = \\rho \\sigma_{i} + b\\,\\log P_{i} - c\\,(\\log P_{i})^{2}\\] in which fitting to the square term provides a parabola with an associated optimum log P.")
Declaration(Class(goldbook:11453))
AnnotationAssertion(rdfs:label goldbook:11453 "Hansch–Fujita π-constant")
AnnotationAssertion(dcterms:description goldbook:11453 "A constant that describes the contribution of a substituent to the octan-1-ol-water log P of a compound.]")
Declaration(Class(goldbook:11454))
AnnotationAssertion(rdfs:label goldbook:11454 "hashing")
AnnotationAssertion(dcterms:description goldbook:11454 "An algorithm that maps data of variable length, such as the raw descriptors of path or circular fingerprints or InChIs, to a smaller fixed length vector.")
Declaration(Class(goldbook:11455))
AnnotationAssertion(rdfs:label goldbook:11455 "InChIKey")
AnnotationAssertion(dcterms:description goldbook:11455 "A fixed length (character) condensed digital representation of the InChI that is not human-understandable.")
Declaration(Class(goldbook:11456))
AnnotationAssertion(rdfs:label goldbook:11456 "International Chemical Identifier")
AnnotationAssertion(dcterms:description goldbook:11456 """A non-proprietary canonical identifier of chemical substances that can be used in printed and electronic data sources to enable easier linking of diverse data
 compilations.""")
Declaration(Class(goldbook:11457))
AnnotationAssertion(rdfs:label goldbook:11457 "ISIS keys")
AnnotationAssertion(dcterms:description goldbook:11457 """Predefined fragment keys that are used in 2D substructure and similarity searching with the ISIS software but are also generated by many other software
 programs and used for 2D-QSAR or cluster analysis of molecules.""")
Declaration(Class(goldbook:11458))
AnnotationAssertion(rdfs:label goldbook:11458 "jackknifing")
AnnotationAssertion(dcterms:description goldbook:11458 "A procedure to evaluate the accuracy of the statistics of a model, such as the overall R2 or the contribution of particular properties, by systematically recomputing the statistics generated from models developed by leaving out one or more observations at a time from the sample set.")
Declaration(Class(goldbook:11459))
AnnotationAssertion(rdfs:label goldbook:11459 "kappa shape descriptor")
AnnotationAssertion(dcterms:description goldbook:11459 "A type of topological index.")
Declaration(Class(goldbook:11460))
AnnotationAssertion(rdfs:label goldbook:11460 "kernel method")
AnnotationAssertion(dcterms:description goldbook:11460 """Algorithms for pattern analysis that use functions such as Gaussians to enable them to operate in a high-dimensional descriptor space without ever computing
 the coordinates of the data in that space.""")
Declaration(Class(goldbook:11461))
AnnotationAssertion(rdfs:label goldbook:11461 "leave-some-out cross-validation")
AnnotationAssertion(dcterms:description goldbook:11461 "A form of cross-validation in which more than one observation is left out at each run. Typically many runs with random samplings are performed.")
Declaration(Class(goldbook:11462))
AnnotationAssertion(rdfs:label goldbook:11462 "leverage")
AnnotationAssertion(dcterms:description goldbook:11462 "The influence of an observation on the coefficients of a fitted equation.")
Declaration(Class(goldbook:11463))
AnnotationAssertion(rdfs:label goldbook:11463 "ligand efficiency")
AnnotationAssertion(dcterms:description goldbook:11463 "Measure of the free energy of binding per heavy atom count (i.e. non-hydrogen) of a molecule.")
Declaration(Class(goldbook:11464))
AnnotationAssertion(rdfs:label goldbook:11464 "linear interaction energy")
AnnotationAssertion(dcterms:description goldbook:11464 """A method that forecasts ligand binding free energies using force field estimations of the receptor-ligand interactions and thermal conformational sampling
.""")
Declaration(Class(goldbook:11465))
AnnotationAssertion(rdfs:label goldbook:11465 "lipophilic ligand efficiency")
AnnotationAssertion(dcterms:description goldbook:11465 "A measure of the efficiency of ligand binding that is corrected for binding driven by lipophilicity.")
Declaration(Class(goldbook:11466))
AnnotationAssertion(rdfs:label goldbook:11466 "loading of a property")
AnnotationAssertion(dcterms:description goldbook:11466 "The contribution of the property to a principal component or partial least squares latent variable.")
Declaration(Class(goldbook:11467))
AnnotationAssertion(rdfs:label goldbook:11467 "local model")
AnnotationAssertion(dcterms:description goldbook:11467 "A computational model that applies to only a subset of molecules, typically a closely related series.")
Declaration(Class(goldbook:11468))
AnnotationAssertion(rdfs:label goldbook:11468 "log <em>D</em>")
AnnotationAssertion(dcterms:description goldbook:11468 "The logarithm of the ratio of the total concentration (neutral and charged species) of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in water at a given \\(\\pu{pH}\\).")
Declaration(Class(goldbook:11469))
AnnotationAssertion(rdfs:label goldbook:11469 "log <em>P</em>")
AnnotationAssertion(dcterms:description goldbook:11469 """The logarithm of the ratio of the concentration of the uncharged form of a compound in a nonpolar phase, traditionally water-saturated octan-1-ol, to that in
 water.""")
Declaration(Class(goldbook:11470))
AnnotationAssertion(rdfs:label goldbook:11470 "machine learning")
AnnotationAssertion(dcterms:description goldbook:11470 """A computer algorithm that generates empirical models, such as a model of biological potency as a function of the properties of the molecules, that is derived
 from the analysis of a training set for which all the necessary data are available.""")
Declaration(Class(goldbook:11471))
AnnotationAssertion(rdfs:label goldbook:11471 "macromolecular crystallographic information file")
AnnotationAssertion(dcterms:description goldbook:11471 "A file that describes in detail the features of a macromolecular structure and the X‑ray diffraction experiment that was used to derive that structure.")
Declaration(Class(goldbook:11472))
AnnotationAssertion(rdfs:label goldbook:11472 "Markush structure")
AnnotationAssertion(dcterms:description goldbook:11472 "A structure diagram that describes a set of related molecules with the structure of the common core and the structures of the substituents at each position.")
Declaration(Class(goldbook:11473))
AnnotationAssertion(rdfs:label goldbook:11473 "molecular diversity")
AnnotationAssertion(dcterms:description goldbook:11473 "A measure of the spread of various properties or chemotypes within a set of compounds.")
Declaration(Class(goldbook:11474))
AnnotationAssertion(rdfs:label goldbook:11474 "molecular fingerprints")
AnnotationAssertion(dcterms:description goldbook:11474 "Descriptions of the structure of a molecule calculated from the properties of each of its atoms and bonds that are then usually condensed into a fixed-length string by a hashing algorithm.")
Declaration(Class(goldbook:11475))
AnnotationAssertion(rdfs:label goldbook:11475 "molecular similarity")
AnnotationAssertion(dcterms:description goldbook:11475 "The degree to which two molecules resemble one another as calculated from their respective 2D or 3D properties, molecular fingerprints, fragment keys, or superimposed 3D structures that usually ranges from 1 (identical) to 0 (dissimilar).")
Declaration(Class(goldbook:11476))
AnnotationAssertion(rdfs:label goldbook:11476 "multidimensional scaling")
AnnotationAssertion(dcterms:description goldbook:11476 """A visualization method that converts a dataset of distances between molecules in property space into coordinates in lower dimension space with emphasis on
 preserving the relative distances between dissimilar molecules.""")
Declaration(Class(goldbook:11477))
AnnotationAssertion(rdfs:label goldbook:11477 "multiobjective optimization")
AnnotationAssertion(dcterms:description goldbook:11477 """The search for those combinations of properties that produces the best compromise between the various objectives of the search, for example properties of
 compounds that are the best trade-off between potency, bioavailability, and selectivity.""")
Declaration(Class(goldbook:11478))
AnnotationAssertion(rdfs:label goldbook:11478 "orthogonal projections to latent structures")
AnnotationAssertion(dcterms:description goldbook:11478 """A preprocessing method for partial least squares calculations that filters out variation that is not correlated to the property to be fit and so results in
 improved interpretability of a PLS model while maintaining its predictivity.""")
Declaration(Class(goldbook:11479))
AnnotationAssertion(rdfs:label goldbook:11479 "overtraining")
AnnotationAssertion(dcterms:description goldbook:11479 "Training a machine learning model for so long that the original input data is memorized with the result that model predictivity is degraded.")
Declaration(Class(goldbook:11480))
AnnotationAssertion(rdfs:label goldbook:11480 "Pareto front")
AnnotationAssertion(dcterms:description goldbook:11480 "The various combinations of predictor properties that lead to optimum predicted compromises in multiple target properties.")
Declaration(Class(goldbook:11481))
AnnotationAssertion(rdfs:label goldbook:11481 "Pareto optimization")
AnnotationAssertion(dcterms:description goldbook:11481 "The search for solutions to functions that provide a compromise between several desirable outcomes, such as potency, lack of toxicity, and good absorption, distribution, metabolism, and excretion (ADME) properties.")
Declaration(Class(goldbook:11482))
AnnotationAssertion(rdfs:label goldbook:11482 "partial atomic charges")
AnnotationAssertion(dcterms:description goldbook:11482 """Charges assigned to atoms, arising from the uneven distribution of electrons in bonds, that are used to calculate intermolecular interaction energy or to
 characterize the charge distribution of a molecule.""")
Declaration(Class(goldbook:11483))
AnnotationAssertion(rdfs:label goldbook:11483 "path fingerprints")
AnnotationAssertion(dcterms:description goldbook:11483 """Vectors of Boolean arrays generated from the properties of the atoms and bonds in linear paths, typically two to seven bonds long, hashed into an integer of
 fixed determined length.""")
Declaration(Class(goldbook:11484))
AnnotationAssertion(rdfs:label goldbook:11484 "protein data bank file")
AnnotationAssertion(dcterms:description goldbook:11484 "A text file that stores the atomic coordinates of a macromolecule, usually a protein or nucleic acid with associated ligands, solvent molecules and ions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11484 "PDB file")
Declaration(Class(goldbook:11485))
AnnotationAssertion(rdfs:label goldbook:11485 "pharmacophore")
AnnotationAssertion(dcterms:description goldbook:11485 """A proposal for the ensemble of steric and electronic features that define the optimal supermolecular intermolecular interaction of a ligand with a specific
 biological target structure with the result that it triggers or blocks its biological response.""")
Declaration(Class(goldbook:11486))
AnnotationAssertion(rdfs:label goldbook:11486 "pipelining programs")
AnnotationAssertion(dcterms:description goldbook:11486 "Visual programming of the computational execution of sequential operations on a dataset, with each node specifying an operation with options, and the nodes processed sequentially.")
Declaration(Class(goldbook:11487))
AnnotationAssertion(rdfs:label goldbook:11487 "PLS latent variable")
AnnotationAssertion(dcterms:description goldbook:11487 "One of the vectors of a linear combination of the input descriptors that a partial least squares calculation extracts from a dataset.")
Declaration(Class(goldbook:11488))
AnnotationAssertion(rdfs:label goldbook:11488 "PLS loading")
AnnotationAssertion(dcterms:description goldbook:11488 "The contribution of a particular property to a PLS latent variable.")
Declaration(Class(goldbook:11489))
AnnotationAssertion(rdfs:label goldbook:11489 "Poisson–Boltzmann equation")
AnnotationAssertion(dcterms:description goldbook:11489 """A differential equation that uses a mean-field, continuum model to describe the electrostatic interactions in ionic solutions where both ions and solvent are
 treated implicitly, resulting in less computational effort to describe biomolecules in ionic aqueous solutions.""")
Declaration(Class(goldbook:11490))
AnnotationAssertion(rdfs:label goldbook:11490 "polar surface area")
AnnotationAssertion(dcterms:description goldbook:11490 "Surface area over all polar atoms (usually oxygen and nitrogen), including any attached hydrogen atoms, of a molecule.")
Declaration(Class(goldbook:11491))
AnnotationAssertion(rdfs:label goldbook:11491 "pose diagram")
AnnotationAssertion(dcterms:description goldbook:11491 "A 2D diagram that shows the interactions between a ligand and a protein in the 3D structure of the complex.")
Declaration(Class(goldbook:11492))
AnnotationAssertion(rdfs:label goldbook:11492 "posterior probability")
AnnotationAssertion(dcterms:description goldbook:11492 """The conditional probability that is assigned to a quantity after relevant evidence is taken into account. The prior and posterior probabilities are linked by
 the (normalized) likelihood function (Bayes's theorem).""")
Declaration(Class(goldbook:11493))
AnnotationAssertion(rdfs:label goldbook:11493 "prediction set")
AnnotationAssertion(dcterms:description goldbook:11493 "Molecules that have been set aside from model development to test the reliability of the derived model.")
Declaration(Class(goldbook:11494))
AnnotationAssertion(rdfs:label goldbook:11494 "principal component loading")
AnnotationAssertion(dcterms:description goldbook:11494 "The contribution, scaled between \\(\\pu{-1.0}\\) and \\(\\pu{1.0}\\), of an original variable to a particular principal component.")
Declaration(Class(goldbook:11495))
AnnotationAssertion(rdfs:label goldbook:11495 "principal component score")
AnnotationAssertion(dcterms:description goldbook:11495 "A property of a molecule calculated from a principal components analysis of the original properties and the value of these properties for the molecule.")
Declaration(Class(goldbook:11496))
AnnotationAssertion(rdfs:label goldbook:11496 "prior probability")
AnnotationAssertion(dcterms:description goldbook:11496 """The conditional probability that is assigned to a quantity before relevant evidence is taken into account, for example, the prior probability of an active
 compound would be the fraction of the compounds in the dataset that are active.""")
Declaration(Class(goldbook:11497))
AnnotationAssertion(rdfs:label goldbook:11497 "protein data bank")
AnnotationAssertion(dcterms:description goldbook:11497 "An archive of freely available macromolecular structural data of proteins, nucleic acids, and complex assemblies.")
Declaration(Class(goldbook:11498))
AnnotationAssertion(rdfs:label goldbook:11498 "q2")
AnnotationAssertion(dcterms:description goldbook:11498 """The square of the leave-one-out cross-validation regression coefficient calculated from the variance of the observed versus predicted values of the target
 property, usually potency, of each compound when eliminated during cross-validation.""")
Declaration(Class(goldbook:11499))
AnnotationAssertion(rdfs:label goldbook:11499 "r2")
AnnotationAssertion(dcterms:description goldbook:11499 "The ratio of the sum of squares explained by a regression model (SSR) to the 'total' sum of squares around the mean (SST), or, because SST equals SSR plus the sum of squares of the error or residuals from the fit (SSE): \\[R^{2} = \\frac{{\\rm{SSR}}}{{\\rm{SST}}} = 1 - \\frac{{\\rm{SSE}}}{{\\rm{SST}}}\\]")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11499 "$R^{2}$")
Declaration(Class(goldbook:11500))
AnnotationAssertion(rdfs:label goldbook:11500 "random forest method")
AnnotationAssertion(dcterms:description goldbook:11500 """A classification method that produces many recursive partitioning models, each with a random selection of predictor properties, and then combines the models
 for predictions.""")
Declaration(Class(goldbook:11501))
AnnotationAssertion(rdfs:label goldbook:11501 "recall")
AnnotationAssertion(dcterms:description goldbook:11501 "The fraction of the total number of actives, in the top-scoring docking hits, such as the fraction of true actives that are retrieved in the top \\(\\pu{1\\%}\\) scoring molecules.")
Declaration(Class(goldbook:11502))
AnnotationAssertion(rdfs:label goldbook:11502 "receiver-operator characteristic curve")
AnnotationAssertion(dcterms:description goldbook:11502 """A plot that shows the result of a test of the performance of a binary classifier by plotting the fraction of true positives identified versus the fraction of
 false positives as the discrimination threshold is varied.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11502 "ROC curve")
Declaration(Class(goldbook:11503))
AnnotationAssertion(rdfs:label goldbook:11503 "recursive partitioning")
AnnotationAssertion(dcterms:description goldbook:11503 """A classification method that uses predictor properties to successively divide the data set into subsets such that each resulting subset is enriched in
 molecules that are in one class.""")
Declaration(Class(goldbook:11504))
AnnotationAssertion(rdfs:label goldbook:11504 "regularization")
AnnotationAssertion(dcterms:description goldbook:11504 """Introducing additional information in order to solve an ill-posed problem or to prevent overfitting, usually taking the form of a penalty for complexity of the
 model.""")
Declaration(Class(goldbook:11505))
AnnotationAssertion(rdfs:label goldbook:11505 "response scrambling")
AnnotationAssertion(dcterms:description goldbook:11505 """Evaluation of the robustness of a QSAR or classification model by repeatedly randomizing the target property of compounds, developing models based on this
 randomized property, and comparing the statistics of fit of the scrambled models with those of the true model, which should be superior.""")
Declaration(Class(goldbook:11506))
AnnotationAssertion(rdfs:label goldbook:11506 "R-group decomposition")
AnnotationAssertion(dcterms:description goldbook:11506 """The process whereby the molecules in a dataset are partitioned into the core ('scaffold'), usually user-specified, and the specific substituents ('R-groups')
 found at each specific position.""")
Declaration(Class(goldbook:11507))
AnnotationAssertion(rdfs:label goldbook:11507 "rule of five")
AnnotationAssertion(dcterms:description goldbook:11507 "The rule of five states that molecules that violate two or more of the following rules are likely to have permeability problems; (1) CLOGP calculated octan-1-ol-water log P greater than 5.0; (2) molecular weight greater than 500; (3) more than five hydrogen bond donors; and (4) the sum of oxygen and nitrogen atoms is greater than 10.")
Declaration(Class(goldbook:11508))
AnnotationAssertion(rdfs:label goldbook:11508 "scoring")
AnnotationAssertion(dcterms:description goldbook:11508 "A mathematical formula that estimates the binding affinity of a ligand to a macromolecular target based on the structure of the complex.")
Declaration(Class(goldbook:11509))
AnnotationAssertion(rdfs:label goldbook:11509 "structure-data format file")
AnnotationAssertion(dcterms:description goldbook:11509 """A computer text file that follows a specified format in which each molecule is described by 2D or 3D coordinates, atom type, and connectivity to other atoms
 and also specific user-definable fields that contain other information such as name and biological or chemical properties.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11509 "SDF file")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11509 "SDfile")
Declaration(Class(goldbook:11510))
AnnotationAssertion(rdfs:label goldbook:11510 "sensitivity analysis")
AnnotationAssertion(dcterms:description goldbook:11510 """Analysis, often by finding approximate derivatives of the output with respect to each input, that determines which of the descriptors in a model has the
 greatest influence on the output.""")
Declaration(Class(goldbook:11511))
AnnotationAssertion(rdfs:label goldbook:11511 "similarity ensemble approach")
AnnotationAssertion(dcterms:description goldbook:11511 """A method that predicts the probability that a molecule or set of molecules will be active against a particular target by considering its pairwise similarities
 to all known ligands for that target.""")
Declaration(Class(goldbook:11512))
AnnotationAssertion(rdfs:label goldbook:11512 "similarity searching")
AnnotationAssertion(dcterms:description goldbook:11512 """A virtual screening method that calculates the molecular similarity of an input 2D or 3D structure to each of the molecules in a database to identify a
 requested number of most similar molecules or those above some similarity threshold.""")
Declaration(Class(goldbook:11513))
AnnotationAssertion(rdfs:label goldbook:11513 "SMARTS")
AnnotationAssertion(dcterms:description goldbook:11513 "An expansion of the SMILES language that describes a particular specific or generalized substructure.")
Declaration(Class(goldbook:11515))
AnnotationAssertion(rdfs:label goldbook:11515 "SMIRKS")
AnnotationAssertion(dcterms:description goldbook:11515 "A derivative of the SMILES language that describes the transformation in a chemical reaction.")
Declaration(Class(goldbook:11516))
AnnotationAssertion(rdfs:label goldbook:11516 "specificity")
AnnotationAssertion(dcterms:description goldbook:11516 "The ability of a two-class model to detect known inactive or non-toxic molecules.")
Declaration(Class(goldbook:11517))
AnnotationAssertion(rdfs:label goldbook:11517 "standard error of estimates")
AnnotationAssertion(dcterms:description goldbook:11517 "The standard error of the errors or residuals, observed minus calculated, from a computational model: \\[{\\rm{SEE}} = \\sqrt \\frac{\\sum (Y_{o} - Y_{c})^{2}}{n}\\] in which \\(Y_{o}\\) is the observed value of \\(Y\\), \\(Y_{c}\\) is the calculated value of \\(Y\\), and \\(n\\) is the number of observations.")
Declaration(Class(goldbook:11518))
AnnotationAssertion(rdfs:label goldbook:11518 "standard error of prediction")
AnnotationAssertion(dcterms:description goldbook:11518 "The standard deviation of the errors or residuals, observed minus calculated, from a computational model: \\[{\\rm{SEP}} = \\sqrt \\frac{\\sum (Y_{o} - Y_{p})^{2}}{n - k}\\] in which \\(Y_{o}\\) is the observed value of \\(Y\\), \\(Y_{p}\\) is the predicted value of \\(Y\\), \\(n\\) is the number of observations, and \\(k\\) is the number of terms in the model.")
Declaration(Class(goldbook:11519))
AnnotationAssertion(rdfs:label goldbook:11519 "structural keys")
AnnotationAssertion(dcterms:description goldbook:11519 """A pre-established set of substructures the presence or absence of which are used to describe a molecule and are used during substructure searching as a filter
 to eliminate molecules that cannot match a query, for clustering or similarity searching, or for developing classification or regression models.""")
Declaration(Class(goldbook:11520))
AnnotationAssertion(rdfs:label goldbook:11520 "structure diagram")
AnnotationAssertion(dcterms:description goldbook:11520 "A 2D drawing that shows the atoms of a molecular structure and the bonds that connect them.")
Declaration(Class(goldbook:11521))
AnnotationAssertion(rdfs:label goldbook:11521 "substructure searching")
AnnotationAssertion(dcterms:description goldbook:11521 """A virtual screening method that uses a graph-based method to discover which molecules in a chemical structure database contain the substructure specified in
 the query.""")
Declaration(Class(goldbook:11522))
AnnotationAssertion(rdfs:label goldbook:11522 "supervised learning")
AnnotationAssertion(dcterms:description goldbook:11522 """A machine learning method that aims to discover a relationship between the predictor and the response values, such as exists in a QSAR or recursive
 partitioning model.""")
Declaration(Class(goldbook:11523))
AnnotationAssertion(rdfs:label goldbook:11523 "Tanimoto similarity")
AnnotationAssertion(dcterms:description goldbook:11523 "A scale that ranges from \\(\\pu{0.0}\\) to \\(\\pu{1.0}\\) when calculated as the ratio of the fingerprint bits or structural keys that both molecules have set divided by the number of bits or keys set in both molecules plus those set either molecule.")
Declaration(Class(goldbook:11524))
AnnotationAssertion(rdfs:label goldbook:11524 "test set")
AnnotationAssertion(dcterms:description goldbook:11524 "The set of molecules not used in any way to devise a computational model but instead are used to test its predictivity.")
Declaration(Class(goldbook:11525))
AnnotationAssertion(rdfs:label goldbook:11525 "topological index")
AnnotationAssertion(dcterms:description goldbook:11525 "A numerical value associated with chemical constitution for correlation of chemical structure with various physical properties, chemical reactivity or biological activity. The numerical basis for topological indices is provided (depending on how a molecular graph is converted into a numerical value) by either the adjacency matrix or the topological distance matrix. In the latter the topological distance between two vertices is the number of edges in the shortest path between these.")
Declaration(Class(goldbook:11526))
AnnotationAssertion(rdfs:label goldbook:11526 "topological polar surface area")
AnnotationAssertion(dcterms:description goldbook:11526 "An approximation to polar surface area that is calculated from the 2D structure.")
Declaration(Class(goldbook:11527))
AnnotationAssertion(rdfs:label goldbook:11527 "true negative")
AnnotationAssertion(dcterms:description goldbook:11527 "A model prediction of a negative result, such as no biological activity, when the true result is also negative.")
Declaration(Class(goldbook:11528))
AnnotationAssertion(rdfs:label goldbook:11528 "true positive")
AnnotationAssertion(dcterms:description goldbook:11528 "A model prediction of a positive result, such as biological activity, when the true result is also positive.")
Declaration(Class(goldbook:11529))
AnnotationAssertion(rdfs:label goldbook:11529 "Tversky similarity")
AnnotationAssertion(dcterms:description goldbook:11529 "An asymmetric measure in which a target structure is compared to a reference structure with user-selectable weighting of the relative importance of the fingerprint bits or structural keys that are present only in the reference versus the fingerprint bits or structural keys that are only in the target, weightings for which the Tanimoto coefficient uses \\(\\pu{1.0}\\).")
Declaration(Class(goldbook:11530))
AnnotationAssertion(rdfs:label goldbook:11530 "underdetermined system")
AnnotationAssertion(dcterms:description goldbook:11530 "A system in which the number of descriptors is much larger than the number of observations.")
Declaration(Class(goldbook:11531))
AnnotationAssertion(rdfs:label goldbook:11531 "validation set")
AnnotationAssertion(dcterms:description goldbook:11531 """The molecules not used to devise a computational model but instead are used during model development to test for possible over-fitting as seen when additional
 properties are added to a model but the predicted potencies of the validation set become less accurate.""")
Declaration(Class(goldbook:11532))
AnnotationAssertion(rdfs:label goldbook:11532 "virtual reaction")
AnnotationAssertion(dcterms:description goldbook:11532 """The computer encoding of a possible chemical reaction between two explicit or Markush structures or substructures, often with a mapping between the atoms in
 the starting material and those in the product.""")
Declaration(Class(goldbook:11533))
AnnotationAssertion(rdfs:label goldbook:11533 "virtual screening")
AnnotationAssertion(dcterms:description goldbook:11533 "Computational methods that rank the molecules in a database by their forecast continuous or categorical biological or chemical properties.")
Declaration(Class(goldbook:11534))
AnnotationAssertion(rdfs:label goldbook:11534 "workflow")
AnnotationAssertion(dcterms:description goldbook:11534 "The sequence of steps used to perform a certain task.")
Declaration(Class(goldbook:11535))
AnnotationAssertion(rdfs:label goldbook:11535 "apparent monomer")
AnnotationAssertion(dcterms:description goldbook:11535 "Monomer which from the name of a polymer appears to have been used in the synthesis of the latter when it has actually been prepared from different precursor(s).")
Declaration(Class(goldbook:11536))
AnnotationAssertion(rdfs:label goldbook:11536 "block homopolymer")
AnnotationAssertion(dcterms:description goldbook:11536 "Homopolymer that is composed of macromolecules comprising blocks that have at least one constitutional or configurational feature which is not present in the adjacent portions.")
Declaration(Class(goldbook:11537))
AnnotationAssertion(rdfs:label goldbook:11537 "graft homopolymer")
AnnotationAssertion(dcterms:description goldbook:11537 "Homopolymer composed of macromolecules with one or more species of block connected to the main chain as side chains, these side chains having constitutional or configurational features that differ from those in the main chain.")
Declaration(Class(goldbook:11538))
AnnotationAssertion(rdfs:label goldbook:11538 "standardization")
AnnotationAssertion(dcterms:description goldbook:11538 "Measurement of the concentration of a component of a solution with a reference measurement standard for the preparation of a secondary measurement standard")
Declaration(Class(goldbook:11539))
AnnotationAssertion(rdfs:label goldbook:11539 "controlled release")
AnnotationAssertion(dcterms:description goldbook:11539 "Detection principle for a chemically modified electrode (CME) in which an analyte or reagent accumulated at a CME undergoes quantitative release (egress, stripping, expulsion, or microdosing) to the test solution, under electrochemical or chemical control.")
Declaration(Class(goldbook:11540))
AnnotationAssertion(rdfs:label goldbook:11540 "all-solid-state ion-selective electrode")
AnnotationAssertion(dcterms:description goldbook:11540 "Ion-selective electrode in which the ion-selective membrane contacts the electronic conductor without internal electrolyte solution.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11540 "metal contact ion-selective electrode")
Declaration(Class(goldbook:11541))
AnnotationAssertion(rdfs:label goldbook:11541 "self-assembled monolayer")
AnnotationAssertion(dcterms:description goldbook:11541 "Film, one molecule thick, in an ordered assembly on a surface.")
Declaration(Class(goldbook:11542))
AnnotationAssertion(rdfs:label goldbook:11542 "cationized molecule")
AnnotationAssertion(dcterms:description goldbook:11542 "Ion formed by the association of a cation with a molecule \\(\\ce{M}\\).")
Declaration(Class(goldbook:11543))
AnnotationAssertion(rdfs:label goldbook:11543 "nominal mass")
AnnotationAssertion(dcterms:description goldbook:11543 "Mass of a molecular ion or molecule calculated using the isotope mass of the most abundant constituent element isotope of each element rounded to the nearest integer value and multiplied by the number of atoms of each element.")
Declaration(Class(goldbook:11544))
AnnotationAssertion(rdfs:label goldbook:11544 "reflectron")
AnnotationAssertion(dcterms:description goldbook:11544 "Component of a time-of-flight mass spectrometer that uses a static electric field to reverse the direction of travel of the ions and improves mass resolution by assuring that ions of the same m/z but different translational energy arrive at the detector at the same time.")
Declaration(Class(goldbook:11545))
AnnotationAssertion(rdfs:label goldbook:11545 "adhesion")
AnnotationAssertion(dcterms:description goldbook:11545 "Attachment of interfaces between phases or components that is maintained by intermolecular forces, chain entanglements, or both.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11545 "tack")
Declaration(Class(goldbook:11546))
AnnotationAssertion(rdfs:label goldbook:11546 "Michaelis–Menten equation")
AnnotationAssertion(dcterms:description goldbook:11546 "The relationship between the initial rate (velocity) of an enzyme-catalysed reaction \\(v_{0}\\) and the initial substrate concentration \\([\\ce{S}]_{0}\\) in the form \\[v_{0} = V[\\ce{S}]_{0}/(K_{\\rm{M}} + [\\ce{S}]_{0})\\] where \\(V\\) (the limiting rate) and \\(K_{\\rm{M}}\\) (the Michaelis constant) are independent of the initial substrate concentration and constant at a given temperature and a given enzyme concentration. The reaction is then said to display Michaelis–Menten kinetics.")
Declaration(Class(goldbook:11547))
AnnotationAssertion(rdfs:label goldbook:11547 "protein sequencing")
AnnotationAssertion(dcterms:description goldbook:11547 "Determination of the primary structure of a protein.")
Declaration(Class(goldbook:11548))
AnnotationAssertion(rdfs:label goldbook:11548 "zone pH")
AnnotationAssertion(dcterms:description goldbook:11548 "pH of the solute zone in pH-zone-refining counter-current chromatography. \\[{\\rm{pH}}_{\\rm{zone}} = \\pu{p}K_{\\rm{a}} + \\log[(K_{\\rm{DS}}/K_{\\rm{S}}) - 1]\\], where \\(K_{\\rm{DS}}\\) is the partition ratio of solute $\\ce{S}$ (an indicator for solute hydrophobicity) and \\(K_{\\rm{S}}\\), the dissociation constant of the solute.")
Declaration(Class(goldbook:11549))
AnnotationAssertion(rdfs:label goldbook:11549 "intraparticle volume of the column")
AnnotationAssertion(dcterms:description goldbook:11549 "Volume of the mobile phase within the pores of the particles in the stationary phase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11549 "intrastitial volume of the column")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11549 "stationary mobile-phase volume")
Declaration(Class(goldbook:11550))
AnnotationAssertion(rdfs:label goldbook:11550 "distribution constant (exclusion)")
AnnotationAssertion(dcterms:description goldbook:11550 "Fraction of the intraparticle volume (the volume of the pores) available to the molecules of a particular sample component for diffusion: \\[K_{0} = \\frac{V_{\\rm{R}} - V_0}{V_{\\rm{i}}}\\]")
Declaration(Class(goldbook:11551))
AnnotationAssertion(rdfs:label goldbook:11551 "distribution constant calibration")
AnnotationAssertion(dcterms:description goldbook:11551 "Calibration for extraction when close to equilibrium conditions, using a known for the distribution constant for the analyte.")
Declaration(Class(goldbook:11552))
AnnotationAssertion(rdfs:label goldbook:11552 "microextraction (methology)")
AnnotationAssertion(dcterms:description goldbook:11552 "Extraction method characterized by a low phase ratio, so that at equilibrium the fraction extracted is low (i.e. the extraction is not exhaustive).")
Declaration(Class(goldbook:11553))
AnnotationAssertion(rdfs:label goldbook:11553 "microextraction (technique)")
AnnotationAssertion(dcterms:description goldbook:11553 "Extraction technique in which the volume (mass) of the extraction phase (liquid or solid) is substantially smaller than the sample volume (mass).")
Declaration(Class(goldbook:11554))
AnnotationAssertion(rdfs:label goldbook:11554 "microextraction (packed sorbent)")
AnnotationAssertion(dcterms:description goldbook:11554 "Solid-phase extraction using a syringe with a short sorbent bed located between the plunger and the needle.")
Declaration(Class(goldbook:11556))
AnnotationAssertion(rdfs:label goldbook:11556 "acclimation")
AnnotationAssertion(dcterms:description goldbook:11556 "Adjustment, physiologically and (or) behaviorally, of an organism to its environment or circumstances, e.g., thermoregulation, psychological adjustment.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11556 "acclimatization")
Declaration(Class(goldbook:11557))
AnnotationAssertion(rdfs:label goldbook:11557 "acetylcholine")
AnnotationAssertion(dcterms:description goldbook:11557 "Substance that functions as a neurotransmitter between nerve cells and between nerves and muscles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11557 "2-acetoxy-N,N,N-trimethylethanaminium")
Declaration(Class(goldbook:11558))
AnnotationAssertion(rdfs:label goldbook:11558 "acetylcholinesterase")
AnnotationAssertion(dcterms:description goldbook:11558 "Enzyme that hydrolyzes acetylcholine.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11558 "acetylcholine hydrolase")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11558 "cholinesterase inhibitor")
Declaration(Class(goldbook:11559))
AnnotationAssertion(rdfs:label goldbook:11559 "acetylcholine receptor")
AnnotationAssertion(dcterms:description goldbook:11559 "Integral membrane protein that allows the cell to respond to the binding of acetylcholine.")
Declaration(Class(goldbook:11560))
AnnotationAssertion(rdfs:label goldbook:11560 "acoustic neuroma")
AnnotationAssertion(dcterms:description goldbook:11560 "Non-malignant intracranial tumor of the eighth cranial nerve.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11560 "acoustic neurinoma")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11560 "vestibular Schwannoma")
Declaration(Class(goldbook:11561))
AnnotationAssertion(rdfs:label goldbook:11561 "acroparesthesia")
AnnotationAssertion(dcterms:description goldbook:11561 "Abnormal feeling of numbness, tingling, or burning of the skin, typically in the extremities.")
Declaration(Class(goldbook:11562))
AnnotationAssertion(rdfs:label goldbook:11562 "action potential")
AnnotationAssertion(dcterms:description goldbook:11562 "Brief, spike-like depolarization associated with the passage of an impulse without decrement along the membrane of a muscle cell or nerve cell.")
Declaration(Class(goldbook:11563))
AnnotationAssertion(rdfs:label goldbook:11563 "active avoidance test")
AnnotationAssertion(dcterms:description goldbook:11563 "Fear-motivated associative avoidance test based on presentation of an adverse stimulus (e.g., an electric current) as a source of discomfort, to create an environment from which the animal or subject would prefer to escape.")
Declaration(Class(goldbook:11564))
AnnotationAssertion(rdfs:label goldbook:11564 "addiction")
AnnotationAssertion(dcterms:description goldbook:11564 "Compulsive, uncontrolled reward-seeking behavior, especially referring to substance use.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11564 "physical dependence")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11564 "psychological dependence")
Declaration(Class(goldbook:11565))
AnnotationAssertion(rdfs:label goldbook:11565 "adenoma")
AnnotationAssertion(dcterms:description goldbook:11565 "Benign tumor arising from epithelial cells in glandular tissue.")
Declaration(Class(goldbook:11566))
AnnotationAssertion(rdfs:label goldbook:11566 "adenosine receptor")
AnnotationAssertion(dcterms:description goldbook:11566 "Any of four types of purinergic receptors that respond to the nucleoside, adenosine, two of which are involved in release of the neurotransmitters, dopamine and glutamate.")
Declaration(Class(goldbook:11567))
AnnotationAssertion(rdfs:label goldbook:11567 "adrenalin")
AnnotationAssertion(dcterms:description goldbook:11567 "Catecholamine hormone secreted by the adrenal glands that increases heart rate, breathing rate, blood pressure, and carbohydrate metabolism.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11567 "(R)-4-(1-hydroxy-2-(methylamino)ethyl)benzene-1")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11567 "2-diol")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11567 "adrenaline")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11567 "epinephrine")
Declaration(Class(goldbook:11568))
AnnotationAssertion(rdfs:label goldbook:11568 "adrenergic")
AnnotationAssertion(dcterms:description goldbook:11568 """Relating to or denoting secretion of and (or) response to adrenalin, noradrenalin or related substances; in particular referring to sympathetic nerve fibers.
Relating to or denoting an agent that mimics the activity of adrenalin, noradrenalin or related substances.""")
Declaration(Class(goldbook:11569))
AnnotationAssertion(rdfs:label goldbook:11569 "α-adrenergic receptor")
AnnotationAssertion(dcterms:description goldbook:11569 "Class of adrenergicreceptor mainly functioning in vasoconstriction and modulation of glandular secretions.")
Declaration(Class(goldbook:11570))
AnnotationAssertion(rdfs:label goldbook:11570 "β-adrenergic receptor")
AnnotationAssertion(dcterms:description goldbook:11570 "Member of a class of G protein-coupled receptors that are targets of the catecholamines, especially adrenalin, noradrenalin, and related substances.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11570 "adrenergic receptor")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11570 "adrenoceptor")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11570 "β-receptor")
Declaration(Class(goldbook:11571))
AnnotationAssertion(rdfs:label goldbook:11571 "afferent")
AnnotationAssertion(dcterms:description goldbook:11571 "Inflowing. Of nerves, those that conduct impulses toward the central nervous system.")
Declaration(Class(goldbook:11572))
AnnotationAssertion(rdfs:label goldbook:11572 "agnosia")
AnnotationAssertion(dcterms:description goldbook:11572 "Impaired ability to recognize or comprehend the meaning of various sensations, not attributable to faulty sensory input or general intellect.")
Declaration(Class(goldbook:11573))
AnnotationAssertion(rdfs:label goldbook:11573 "alpha-synuclein")
AnnotationAssertion(dcterms:description goldbook:11573 "Protein abundant in the human brain, thought to regulate the release of dopamine.")
Declaration(Class(goldbook:11574))
AnnotationAssertion(rdfs:label goldbook:11574 "Alzheimer disease")
AnnotationAssertion(dcterms:description goldbook:11574 "Common and progressive neurodegenerative disease leading to loss of memory, orientation, and judgment.")
Declaration(Class(goldbook:11575))
AnnotationAssertion(rdfs:label goldbook:11575 "γ-aminobutyric acid")
AnnotationAssertion(dcterms:description goldbook:11575 "Major neurotransmitter at inhibitory synapses in the central nervous system of mammals.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11575 "4-aminobutanoic acid")
Declaration(Class(goldbook:11576))
AnnotationAssertion(rdfs:label goldbook:11576 "γ-aminobutyric acid receptor")
AnnotationAssertion(dcterms:description goldbook:11576 "Transmembrane receptor protein that binds and responds to the inhibitory neurotransmitter $\\ce{\\upgamma\\!\\mbox{-}aminobutyric acid}$.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11576 "GABA Receptor")
Declaration(Class(goldbook:11577))
AnnotationAssertion(rdfs:label goldbook:11577 "2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid receptor")
AnnotationAssertion(dcterms:description goldbook:11577 "Glutamate receptor in the central nervous system activated by the synthetic glutamate analog, AMPA.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11577 "AMPA Receptor")
Declaration(Class(goldbook:11578))
AnnotationAssertion(rdfs:label goldbook:11578 "amnesia")
AnnotationAssertion(dcterms:description goldbook:11578 "Partial or total, transient or permanent loss of memory.")
Declaration(Class(goldbook:11579))
AnnotationAssertion(rdfs:label goldbook:11579 "amnesic shellfish poisoning")
AnnotationAssertion(dcterms:description goldbook:11579 "Human illness caused by consumption of the marine toxin domoic acid that may lead to dizziness, confusion, motor weakness and seizures, with permanent cognitive impairment and short term memory loss.")
Declaration(Class(goldbook:11580))
AnnotationAssertion(rdfs:label goldbook:11580 "amygdala")
AnnotationAssertion(dcterms:description goldbook:11580 "Brain nucleus located in the median temporal lobe that is part of the limbic system and plays an important role in emotional responses.")
Declaration(Class(goldbook:11581))
AnnotationAssertion(rdfs:label goldbook:11581 "β-amyloid")
AnnotationAssertion(dcterms:description goldbook:11581 "Extracellular aggregate of misfolded fibrous proteins, typically with cross-linked $\\ce{\\upbeta\\!\\mbox{-}sheet}$ structure.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11581 "amyloid")
Declaration(Class(goldbook:11582))
AnnotationAssertion(rdfs:label goldbook:11582 "amyloid plaque")
AnnotationAssertion(dcterms:description goldbook:11582 "Structure representing extracellular deposition of $\\ce{\\upbeta\\!\\mbox{-}amyloid protein}$ in the gray matter of the brain that occurs with aging and in increased amount in Alzheimer disease.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11582 "neuritic plaque")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11582 "senile plaque")
Declaration(Class(goldbook:11583))
AnnotationAssertion(rdfs:label goldbook:11583 "amyotrophic lateral sclerosis")
AnnotationAssertion(dcterms:description goldbook:11583 "Debilitating degenerative disease of the motor neurons characterized by progressive muscle weakness, muscle atrophy and fasciculations, muscle spasticity, difficulty speaking (dysarthria), difficulty swallowing (dysphagia), and difficulty breathing (dyspnea).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11583 "Lou Gehrig’s disease")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11583 "motor neuron disease")
Declaration(Class(goldbook:11584))
AnnotationAssertion(rdfs:label goldbook:11584 "anaphrodisiac")
AnnotationAssertion(dcterms:description goldbook:11584 "Anything tending to reduce libido.")
Declaration(Class(goldbook:11585))
AnnotationAssertion(rdfs:label goldbook:11585 "anesthetic")
AnnotationAssertion(dcterms:description goldbook:11585 "Substance that reduces the experience of pain with or without loss of consciousness.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11585 "anaesthetic")
Declaration(Class(goldbook:11586))
AnnotationAssertion(rdfs:label goldbook:11586 "angiography")
AnnotationAssertion(dcterms:description goldbook:11586 "Radiography of blood or lymph vessels, following the introduction of a radio-opaque substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11586 "Arteriography")
Declaration(Class(goldbook:11587))
AnnotationAssertion(rdfs:label goldbook:11587 "annulus")
AnnotationAssertion(dcterms:description goldbook:11587 "Tough outer ring of an intervertebral disc.")
Declaration(Class(goldbook:11588))
AnnotationAssertion(rdfs:label goldbook:11588 "anorexia")
AnnotationAssertion(dcterms:description goldbook:11588 "Eating disorder characterized by self-imposed food restriction.")
Declaration(Class(goldbook:11589))
AnnotationAssertion(rdfs:label goldbook:11589 "anorexia nervosa")
AnnotationAssertion(dcterms:description goldbook:11589 "Eating disorder characterized by obsessive desire to lose weight by reducing food intake or by repeated vomiting.")
Declaration(Class(goldbook:11590))
AnnotationAssertion(rdfs:label goldbook:11590 "anosmia")
AnnotationAssertion(dcterms:description goldbook:11590 "Loss of the sense of smell, either total or selective.")
Declaration(Class(goldbook:11591))
AnnotationAssertion(rdfs:label goldbook:11591 "anticonvulsant")
AnnotationAssertion(dcterms:description goldbook:11591 "Substance used to prevent or reduce the severity of convulsions.")
Declaration(Class(goldbook:11592))
AnnotationAssertion(rdfs:label goldbook:11592 "antidepressant")
AnnotationAssertion(dcterms:description goldbook:11592 "Substance used to alleviate depression.")
Declaration(Class(goldbook:11593))
AnnotationAssertion(rdfs:label goldbook:11593 "antiemetic")
AnnotationAssertion(dcterms:description goldbook:11593 "Substance used to prevent nausea and vomiting (emesis).")
Declaration(Class(goldbook:11594))
AnnotationAssertion(rdfs:label goldbook:11594 "antineuralgic")
AnnotationAssertion(dcterms:description goldbook:11594 "Substance used to alleviate the pain of neuralgia.")
Declaration(Class(goldbook:11595))
AnnotationAssertion(rdfs:label goldbook:11595 "antinociception")
AnnotationAssertion(dcterms:description goldbook:11595 "Blockage of the perception of pain.")
Declaration(Class(goldbook:11596))
AnnotationAssertion(rdfs:label goldbook:11596 "antipsychotic")
AnnotationAssertion(dcterms:description goldbook:11596 "Psychoactive substance used to manage psychotic behavior or psychotic ideation.")
Declaration(Class(goldbook:11597))
AnnotationAssertion(rdfs:label goldbook:11597 "antispasmodic")
AnnotationAssertion(dcterms:description goldbook:11597 "Substance used to prevent muscle spasms.")
Declaration(Class(goldbook:11598))
AnnotationAssertion(rdfs:label goldbook:11598 "anxiolytic")
AnnotationAssertion(dcterms:description goldbook:11598 "Agent that reduces anxiety without causing excessive sedation.")
Declaration(Class(goldbook:11599))
AnnotationAssertion(rdfs:label goldbook:11599 "aphasia")
AnnotationAssertion(dcterms:description goldbook:11599 "Difficulty with, or loss of the use of language in reading, writing or speaking owing to specific lesions in the brain.")
Declaration(Class(goldbook:11600))
AnnotationAssertion(rdfs:label goldbook:11600 "aphonia")
AnnotationAssertion(dcterms:description goldbook:11600 "Loss of the voice.")
Declaration(Class(goldbook:11601))
AnnotationAssertion(rdfs:label goldbook:11601 "aphrodisiac")
AnnotationAssertion(dcterms:description goldbook:11601 "Anything that stimulates libido.")
Declaration(Class(goldbook:11602))
AnnotationAssertion(rdfs:label goldbook:11602 "apneusis")
AnnotationAssertion(dcterms:description goldbook:11602 "Abnormal breathing pattern consisting of a pause at full inspiration.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11602 "apneustic respiration")
Declaration(Class(goldbook:11603))
AnnotationAssertion(rdfs:label goldbook:11603 "apraxia")
AnnotationAssertion(dcterms:description goldbook:11603 "Neurological condition characterized by loss of the ability to perform skilled or purposeful movement that a person is nevertheless physically able and willing to do.")
Declaration(Class(goldbook:11604))
AnnotationAssertion(rdfs:label goldbook:11604 "arachnoiditis")
AnnotationAssertion(dcterms:description goldbook:11604 "Inflammation of the arachnoid membrane, often characterized by perception of burning pain in the legs.")
Declaration(Class(goldbook:11605))
AnnotationAssertion(rdfs:label goldbook:11605 "arborization")
AnnotationAssertion(dcterms:description goldbook:11605 "Terminal branching of a neuron into a treelike structure of the dendrites.")
Declaration(Class(goldbook:11606))
AnnotationAssertion(rdfs:label goldbook:11606 "arrhythmia")
AnnotationAssertion(dcterms:description goldbook:11606 "Condition in which there is an irregular or abnormal heart beat.")
Declaration(Class(goldbook:11607))
AnnotationAssertion(rdfs:label goldbook:11607 "arteriolovenular anastomosis")
AnnotationAssertion(dcterms:description goldbook:11607 "Communication in which blood is shunted from arterioles to venules without passing through capillaries.")
Declaration(Class(goldbook:11608))
AnnotationAssertion(rdfs:label goldbook:11608 "arteriovenous")
AnnotationAssertion(dcterms:description goldbook:11608 "Relating to both arteries and veins.")
Declaration(Class(goldbook:11609))
AnnotationAssertion(rdfs:label goldbook:11609 "arteriovenous anastomosis")
AnnotationAssertion(dcterms:description goldbook:11609 "Communication between an artery and a vein by collateral channels.")
Declaration(Class(goldbook:11610))
AnnotationAssertion(rdfs:label goldbook:11610 "arteriovenous fistula")
AnnotationAssertion(dcterms:description goldbook:11610 "Abnormal communication between an artery and a vein.")
Declaration(Class(goldbook:11611))
AnnotationAssertion(rdfs:label goldbook:11611 "arteriovenous malformation")
AnnotationAssertion(dcterms:description goldbook:11611 "Web of blood vessels with one or more abnormal communications between arteries and veins that bypass the capillary system.")
Declaration(Class(goldbook:11612))
AnnotationAssertion(rdfs:label goldbook:11612 "associative avoidance test")
AnnotationAssertion(dcterms:description goldbook:11612 "Avoidance test in which the test animal has learned to develop an association between the stimulus and the delivery of an aversive event.")
Declaration(Class(goldbook:11613))
AnnotationAssertion(rdfs:label goldbook:11613 "associative learning")
AnnotationAssertion(dcterms:description goldbook:11613 "Process in which a new behavior arises as a consequence of association with a particular stimulus, sometimes restricted to learning through classical conditioning.")
Declaration(Class(goldbook:11614))
AnnotationAssertion(rdfs:label goldbook:11614 "astrocyte")
AnnotationAssertion(dcterms:description goldbook:11614 "Glial cell of ectodermal origin in the central nervous system, characterized by filamentous protoplasmic extensions.")
Declaration(Class(goldbook:11615))
AnnotationAssertion(rdfs:label goldbook:11615 "reactive astrocyte")
AnnotationAssertion(dcterms:description goldbook:11615 "Astrocyte that, after injury or excessive neural activity, undergoes morphological (including extension of pseudopodia) and biochemical (notably increased synthesis of glial fibrillary acidic protein) changes and participates in astrocytic scar formation.")
Declaration(Class(goldbook:11616))
AnnotationAssertion(rdfs:label goldbook:11616 "astrocytic scar")
AnnotationAssertion(dcterms:description goldbook:11616 "Clustering of reactive astrocytes separating a localized brain injury from surrounding uninjured tissue.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11616 "glial scar")
Declaration(Class(goldbook:11617))
AnnotationAssertion(rdfs:label goldbook:11617 "astrocytoma")
AnnotationAssertion(dcterms:description goldbook:11617 "Tumor within the substance of the brain or spinal cord made up of astrocytes.")
Declaration(Class(goldbook:11618))
AnnotationAssertion(rdfs:label goldbook:11618 "astrogliosis")
AnnotationAssertion(dcterms:description goldbook:11618 "Localized site of reactive astrocytes, distinct from an astrocytic scar.")
Declaration(Class(goldbook:11619))
AnnotationAssertion(rdfs:label goldbook:11619 "ataxia")
AnnotationAssertion(dcterms:description goldbook:11619 "Loss of muscular coordination (see motor coordination) resulting in abnormal clumsiness.")
Declaration(Class(goldbook:11620))
AnnotationAssertion(rdfs:label goldbook:11620 "athetosis")
AnnotationAssertion(dcterms:description goldbook:11620 "Condition in which inappropriate muscle contraction causes involuntary writhing movements.")
Declaration(Class(goldbook:11621))
AnnotationAssertion(rdfs:label goldbook:11621 "atony")
AnnotationAssertion(dcterms:description goldbook:11621 "Lacking muscular tone.")
Declaration(Class(goldbook:11622))
AnnotationAssertion(rdfs:label goldbook:11622 "attention deficit hyperactivity disorder")
AnnotationAssertion(dcterms:description goldbook:11622 "Neuropsychiatric disorder of childhood characterized by decreased attention span, impulsiveness and hyperactivity.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11622 "hyperkinetic disorder")
Declaration(Class(goldbook:11623))
AnnotationAssertion(rdfs:label goldbook:11623 "aura")
AnnotationAssertion(dcterms:description goldbook:11623 "Constellation of symptoms experienced before a migraine headache or seizure.")
Declaration(Class(goldbook:11624))
AnnotationAssertion(rdfs:label goldbook:11624 "autism")
AnnotationAssertion(dcterms:description goldbook:11624 "Neurodevelopmental disorder, present from early childhood, characterized by great difficulty in communicating and forming relationships with other people and in using abstract concepts.")
Declaration(Class(goldbook:11625))
AnnotationAssertion(rdfs:label goldbook:11625 "autonomic nervous system")
AnnotationAssertion(dcterms:description goldbook:11625 "Part of the peripheral nervous system controlling the bodily functions that are not consciously directed, e.g., breathing, heart rate, and digestive processes.")
Declaration(Class(goldbook:11626))
AnnotationAssertion(rdfs:label goldbook:11626 "avoidance test")
AnnotationAssertion(dcterms:description goldbook:11626 "Associative learning pairing an adverse event with a non-specific stimulus such that the animal learns to respond in a manner to avoid the adverse event.")
Declaration(Class(goldbook:11627))
AnnotationAssertion(rdfs:label goldbook:11627 "axon")
AnnotationAssertion(dcterms:description goldbook:11627 "Long thread-like process of a neuron along which impulses are conducted from the cell body to the nerve ending.")
Declaration(Class(goldbook:11628))
AnnotationAssertion(rdfs:label goldbook:11628 "axonal degeneration")
AnnotationAssertion(dcterms:description goldbook:11628 "Progressive loss of structure and function of an axon, typically in a peripheral-to-central direction.")
Declaration(Class(goldbook:11629))
AnnotationAssertion(rdfs:label goldbook:11629 "axonal transport")
AnnotationAssertion(dcterms:description goldbook:11629 "Movement of organelles and biomolecules to (retrograde) and from (anterograde) a neuron’s cell body, within the cytoplasm of its axon (the axoplasm).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11629 "axoplasmic transport")
Declaration(Class(goldbook:11630))
AnnotationAssertion(rdfs:label goldbook:11630 "axonopathy")
AnnotationAssertion(dcterms:description goldbook:11630 "Damage (peripheral neuropathy) to multiple nerves in roughly the same areas on both sides of the body, causing weakness, numbness, and paresthesia.")
Declaration(Class(goldbook:11631))
AnnotationAssertion(rdfs:label goldbook:11631 "bar test")
AnnotationAssertion(dcterms:description goldbook:11631 "Test for catalepsy in which a mouse is placed on a bar oriented parallel to and approximately \\(\\pu{2.5 cm}\\) off the ground. Typically, if the mouse remains immobile on the bar for more than 20 seconds, it is considered to be cataleptic.")
Declaration(Class(goldbook:11632))
AnnotationAssertion(rdfs:label goldbook:11632 "Barnes maze")
AnnotationAssertion(dcterms:description goldbook:11632 "Circular platform equipped with some 20 equidistant holes near the outer rim, one of which is marked by visual cues and is an escape hole for a rodent that is placed near the middle of the platform and subjected to an adverse stimulus, e.g., bright light.")
Declaration(Class(goldbook:11633))
AnnotationAssertion(rdfs:label goldbook:11633 "Bayley scale")
AnnotationAssertion(dcterms:description goldbook:11633 "Range of scores on play tasks performed by infants age 0–3 years, intended to assess development of motor, cognitive, and language skills against norms for age-matched normal child development.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11633 "Bayley scales of infant development (BSID)")
Declaration(Class(goldbook:11634))
AnnotationAssertion(rdfs:label goldbook:11634 "beading")
AnnotationAssertion(dcterms:description goldbook:11634 "Focal bead-like swellings in dendrites and axons.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11634 "neuritic beading")
Declaration(Class(goldbook:11635))
AnnotationAssertion(rdfs:label goldbook:11635 "beam walking test")
AnnotationAssertion(dcterms:description goldbook:11635 "Assessment of the ability of an animal to remain upright and to walk on an elevated and relatively narrow beam.")
Declaration(Class(goldbook:11636))
AnnotationAssertion(rdfs:label goldbook:11636 "Benton test")
AnnotationAssertion(dcterms:description goldbook:11636 "Procedure in which patterns on cards are memorized by a test subject who then attempts to recognize them on other cards presented subsequently.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11636 "Benton visual memory test")
Declaration(Class(goldbook:11637))
AnnotationAssertion(rdfs:label goldbook:11637 "Biel water maze")
AnnotationAssertion(dcterms:description goldbook:11637 "A water labyrinth, described by Biel (1940), where rodents are forced to swim until they find a small underwater platform that allows them to escape.")
Declaration(Class(goldbook:11638))
AnnotationAssertion(rdfs:label goldbook:11638 "bipolar disorder")
AnnotationAssertion(dcterms:description goldbook:11638 "Psychiatric illness characterized by mood shifts with periods of severe depressive illness and one or more episodes of exaggerated activity levels (manic behavior).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11638 "manic-depressive disorder")
Declaration(Class(goldbook:11639))
AnnotationAssertion(rdfs:label goldbook:11639 "β-blocker")
AnnotationAssertion(dcterms:description goldbook:11639 "Any of a class of drugs that targets the $\\ce{\\upbeta\\!\\mbox{-}adrenergic receptor}$, interferes with binding of adrenalin and other related substances to the receptor, and weakens their effects.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenergic antagonist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenergic blocking agent")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenergic receptor antagonist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-adrenoreceptor antagonist")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11639 "β-antagonist")
Declaration(Class(goldbook:11640))
AnnotationAssertion(rdfs:label goldbook:11640 "blood–brain barrier")
AnnotationAssertion(dcterms:description goldbook:11640 "Selectively permeable structure that restricts the exit of blood cells and many substances from the brain capillaries into the extracellular space of the brain.")
Declaration(Class(goldbook:11641))
AnnotationAssertion(rdfs:label goldbook:11641 "blood–cerebrospinal fluid barrier")
AnnotationAssertion(dcterms:description goldbook:11641 "Functional restriction by cells of the choroid plexus of transit of substances from the cerebrospinal fluid into the extracellular space of the brain.")
Declaration(Class(goldbook:11642))
AnnotationAssertion(rdfs:label goldbook:11642 "blood–retinal barrier")
AnnotationAssertion(dcterms:description goldbook:11642 "Functional restriction of transit of substances from the blood to the retina by non-fenestrated endothelial cells with tight junctions.")
Declaration(Class(goldbook:11643))
AnnotationAssertion(rdfs:label goldbook:11643 "Boston naming test")
AnnotationAssertion(dcterms:description goldbook:11643 "Procedure in which 60 pictures are shown to a subject who has to name them quickly.")
Declaration(Class(goldbook:11644))
AnnotationAssertion(rdfs:label goldbook:11644 "brachial plexus")
AnnotationAssertion(dcterms:description goldbook:11644 "Bundle of nerve fibers that begins in the spine at the base of the neck, travels through the axilla (armpit region), and into the arm.")
Declaration(Class(goldbook:11645))
AnnotationAssertion(rdfs:label goldbook:11645 "bradycardia")
AnnotationAssertion(dcterms:description goldbook:11645 "Abnormally slow heart rate.")
Declaration(Class(goldbook:11646))
AnnotationAssertion(rdfs:label goldbook:11646 "bradykinesia")
AnnotationAssertion(dcterms:description goldbook:11646 "Abnormally slow body movement.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11646 "hypokinesia")
Declaration(Class(goldbook:11647))
AnnotationAssertion(rdfs:label goldbook:11647 "brain")
AnnotationAssertion(dcterms:description goldbook:11647 "That part of the central nervous system contained within the cranium.")
Declaration(Class(goldbook:11648))
AnnotationAssertion(rdfs:label goldbook:11648 "brain-derived neurotrophic factor")
AnnotationAssertion(dcterms:description goldbook:11648 "Protein secreted by the brain that acts on neurons in the central and peripheral nervous systems; a member of the neurotrophin family of growth factors, related to the nerve growth factor (NGF).")
Declaration(Class(goldbook:11649))
AnnotationAssertion(rdfs:label goldbook:11649 "brain herniation")
AnnotationAssertion(dcterms:description goldbook:11649 "Movement of part of the brain across structures within the skull such as a shift across such structures as the falx cerebri, the tentorium cerebelli, and even sometimes through the foramen magnum in the base of the skull (through which the spinal cord connects with the brain).")
Declaration(Class(goldbook:11650))
AnnotationAssertion(rdfs:label goldbook:11650 "brain slice")
AnnotationAssertion(dcterms:description goldbook:11650 "Slice of brain tissue immersed in artificial cerebrospinal fluid, used in electrophysiology experiments to allow study of a synapse or neural circuit in isolation from the rest of the brain, and in metabolic studies, under controlled physiological conditions.")
Declaration(Class(goldbook:11651))
AnnotationAssertion(rdfs:label goldbook:11651 "brainstem")
AnnotationAssertion(dcterms:description goldbook:11651 "Unpaired subdivision of the brain, continuous with the spinal cord, that includes the thalamus, hypothalamus, pons, medulla oblongata, and the mesencephalon.")
Declaration(Class(goldbook:11652))
AnnotationAssertion(rdfs:label goldbook:11652 "Broca area")
AnnotationAssertion(dcterms:description goldbook:11652 "Region in the frontal lobe of one of the hemispheres (the speech-dominant hemisphere, usually the left) of the hominid brain that is involved in motor functions of speech production.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11652 "Broca speech area")
Declaration(Class(goldbook:11653))
AnnotationAssertion(rdfs:label goldbook:11653 "bruxism")
AnnotationAssertion(dcterms:description goldbook:11653 "Involuntary habitual grinding of the teeth, frequently during sleep.")
Declaration(Class(goldbook:11654))
AnnotationAssertion(rdfs:label goldbook:11654 "burr hole surgery")
AnnotationAssertion(dcterms:description goldbook:11654 "Medical intervention in which a hole is drilled or scraped into the human skull, exposing the dura mater, to gain access during surgery, to relieve intracranial pressure, to evacuate a subdural hematoma, etc.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11654 "trepanning")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11654 "trephination")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11654 "trephining")
Declaration(Class(goldbook:11655))
AnnotationAssertion(rdfs:label goldbook:11655 "butyrylcholinesterase")
AnnotationAssertion(dcterms:description goldbook:11655 "Enzyme, found mainly in the liver, that hydrolyzes choline esters; it is non-specific and distinct from acetylcholinesterase.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11655 "plasma cholinesterase")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11655 "pseudocholinesterase")
Declaration(Class(goldbook:11656))
AnnotationAssertion(rdfs:label goldbook:11656 "CA1-pyramidal cell")
AnnotationAssertion(dcterms:description goldbook:11656 "Pyramidal neuron located in the cornu ammonis area 1, in the hippocampus.")
Declaration(Class(goldbook:11657))
AnnotationAssertion(rdfs:label goldbook:11657 "CA3-pyramidal cell")
AnnotationAssertion(dcterms:description goldbook:11657 "Pyramidal neuron located in the cornu ammonis area 3, in the hippocampus.")
Declaration(Class(goldbook:11658))
AnnotationAssertion(rdfs:label goldbook:11658 "<i>Caenorhabditis elegans</i>")
AnnotationAssertion(dcterms:description goldbook:11658 "Nematode with a well defined small neural network and homologues of human neurotransmitters, used as a model organism for studying normal development as well as neurotoxicity.")
Declaration(Class(goldbook:11659))
AnnotationAssertion(rdfs:label goldbook:11659 "california verbal learning test")
AnnotationAssertion(dcterms:description goldbook:11659 "Procedure in which some common words are read aloud and the test subject is asked to recall as many of these as possible.")
Declaration(Class(goldbook:11660))
AnnotationAssertion(rdfs:label goldbook:11660 "carcinoma")
AnnotationAssertion(dcterms:description goldbook:11660 "Malignant tumor of an epithelial cell.")
Declaration(Class(goldbook:11661))
AnnotationAssertion(rdfs:label goldbook:11661 "carotid artery")
AnnotationAssertion(dcterms:description goldbook:11661 "One of two paired large arteries on either side of the neck that supplies most of the cerebralhemisphere.")
Declaration(Class(goldbook:11662))
AnnotationAssertion(rdfs:label goldbook:11662 "carpel tunnel syndrome")
AnnotationAssertion(dcterms:description goldbook:11662 "Median nerve entrapment neuropathy that causes paresthesia, pain, and numbness due to compression of the nerve at the wrist in the carpal tunnel.")
Declaration(Class(goldbook:11663))
AnnotationAssertion(rdfs:label goldbook:11663 "cassavism")
AnnotationAssertion(dcterms:description goldbook:11663 "Epidemic paralytic disease, mainly affecting women and children, occurring in remote rural areas of African and Latin American countries, where cassava root is an important food.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11663 "konzo")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11663 "mantakassa")
Declaration(Class(goldbook:11664))
AnnotationAssertion(rdfs:label goldbook:11664 "cauda equina")
AnnotationAssertion(dcterms:description goldbook:11664 "Bundle of long spinal nerve roots arising from the end of the spinal cord and filling the lower part of the spinal canal (from approximately the thoraco-lumbar junction downwards).")
Declaration(Class(goldbook:11665))
AnnotationAssertion(rdfs:label goldbook:11665 "caudate nucleus")
AnnotationAssertion(dcterms:description goldbook:11665 "Crescent-shaped mass of gray matter forming part of the corpus striatum and part of the basal ganglia.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11665 "caudatum")
Declaration(Class(goldbook:11666))
AnnotationAssertion(rdfs:label goldbook:11666 "cephalic")
AnnotationAssertion(dcterms:description goldbook:11666 "In or relating to the head.")
Declaration(Class(goldbook:11667))
AnnotationAssertion(rdfs:label goldbook:11667 "ceramide")
AnnotationAssertion(dcterms:description goldbook:11667 "Family of lipid molecules, each one composed of sphingosine and a fatty acid.")
Declaration(Class(goldbook:11668))
AnnotationAssertion(rdfs:label goldbook:11668 "cerebellar tonsillar herniation")
AnnotationAssertion(dcterms:description goldbook:11668 "Abnormal protrusion of a portion of the cerebellum through the foramen magnum of the skull.")
Declaration(Class(goldbook:11669))
AnnotationAssertion(rdfs:label goldbook:11669 "cerebellum")
AnnotationAssertion(dcterms:description goldbook:11669 "Lower part of the brain that is beneath the posterior portion of the cerebrum, regulating the unconscious coordination of movement.")
Declaration(Class(goldbook:11670))
AnnotationAssertion(rdfs:label goldbook:11670 "cerebroside")
AnnotationAssertion(dcterms:description goldbook:11670 "Member of a group of glycosphingolipids called monoglycosylceramides which are important components in animal nerve and muscle cell membranes and the myelin sheath.")
Declaration(Class(goldbook:11671))
AnnotationAssertion(rdfs:label goldbook:11671 "cerebrum")
AnnotationAssertion(dcterms:description goldbook:11671 "Principal part of the brain in vertebrates, located frontwards in the skull, consisting of the two hemispheres of the cerebral cortex separated by a fissure, and certain subcortical structures such as the hippocampus, basal ganglia, and the olfactory bulb.")
Declaration(Class(goldbook:11672))
AnnotationAssertion(rdfs:label goldbook:11672 "cervical spine")
AnnotationAssertion(dcterms:description goldbook:11672 "Part of the spine immediately inferior to the skull and connecting to the thoracic spine, made up of seven vertebrae.")
Declaration(Class(goldbook:11673))
AnnotationAssertion(rdfs:label goldbook:11673 "cervical vertebra")
AnnotationAssertion(dcterms:description goldbook:11673 "Any of seven vertebrae that provide strength and structure to the cervical spine and support the head, allowing for its rotation and flexion.")
Declaration(Class(goldbook:11674))
AnnotationAssertion(rdfs:label goldbook:11674 "cholinergic")
AnnotationAssertion(dcterms:description goldbook:11674 """Relating to or denoting a nerve that liberates acetylcholine at a synapse upon receiving an appropriate nerve impulse; in particular referring to parasympathetic nerve fibers.
Relating to or denoting an agent that mimics or enhances the activity of acetylcholine.""")
Declaration(Class(goldbook:11675))
AnnotationAssertion(rdfs:label goldbook:11675 "cholinomimetic")
AnnotationAssertion(dcterms:description goldbook:11675 "Having an action similar to acetylcholine.")
Declaration(Class(goldbook:11676))
AnnotationAssertion(rdfs:label goldbook:11676 "chorea")
AnnotationAssertion(dcterms:description goldbook:11676 "Neurological disorder characterized by rapid, jerky involuntary movements affecting especially the limbs or facial muscles.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11676 "choreia")
Declaration(Class(goldbook:11677))
AnnotationAssertion(rdfs:label goldbook:11677 "choreoathetosis")
AnnotationAssertion(dcterms:description goldbook:11677 "Occurrence of involuntary movements in a combination of chorea and athetosis.")
Declaration(Class(goldbook:11678))
AnnotationAssertion(rdfs:label goldbook:11678 "chromatolysis")
AnnotationAssertion(dcterms:description goldbook:11678 """Disintegration of nuclear chromatin.
Disintegration of Nissl bodies following neuronal injury.""")
Declaration(Class(goldbook:11679))
AnnotationAssertion(rdfs:label goldbook:11679 "chronic solvent-induced encephalopathy")
AnnotationAssertion(dcterms:description goldbook:11679 "Constellation of neurological symptoms that may include polyneuropathies, encephalopathy, memory loss, attention deficit and dementia following long-term exposure, often occupational, to organic solvents found in paints, glues, and other industrial products.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11679 "organic solvent syndrome")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11679 "toxic solvent syndrome")
Declaration(Class(goldbook:11680))
AnnotationAssertion(rdfs:label goldbook:11680 "ciguatera poisoning")
AnnotationAssertion(dcterms:description goldbook:11680 "Food-borne illness caused by ingesting fish containing ciguatera toxins.")
Declaration(Class(goldbook:11681))
AnnotationAssertion(rdfs:label goldbook:11681 "ciliary muscle")
AnnotationAssertion(dcterms:description goldbook:11681 "Intrinsic smooth muscle of the eye that contracts to cause the lens to thicken, allowing accommodation to near vision.")
Declaration(Class(goldbook:11682))
AnnotationAssertion(rdfs:label goldbook:11682 "ciliary neurotrophic factor")
AnnotationAssertion(dcterms:description goldbook:11682 "Polypeptide hormone and nerve growth factor that promotes neurotransmitter synthesis and neurite outgrowth in certain neural populations including astrocytes.")
Declaration(Class(goldbook:11683))
AnnotationAssertion(rdfs:label goldbook:11683 "clonus")
AnnotationAssertion(dcterms:description goldbook:11683 """Alternate involuntary muscular contraction and relaxation in rapid succession.
Continuous rhythmic reflex tremor initiated by the spinal cord below an area of spinal cord injury, set in
motion by reflex testing.""")
Declaration(Class(goldbook:11684))
AnnotationAssertion(rdfs:label goldbook:11684 "cognition")
AnnotationAssertion(dcterms:description goldbook:11684 "Sum of the mental processes by which sensory input is stored, recovered, and used by the consciousbrain, including attention, memory, language usage, learning, reasoning, problem solving, and decision making.")
Declaration(Class(goldbook:11685))
AnnotationAssertion(rdfs:label goldbook:11685 "coma")
AnnotationAssertion(dcterms:description goldbook:11685 "State of profound unconsciousness lasting more than several hours in which one cannot respond to stimuli and from which one cannot be roused.")
Declaration(Class(goldbook:11686))
AnnotationAssertion(rdfs:label goldbook:11686 "conditioned avoidance response test")
AnnotationAssertion(dcterms:description goldbook:11686 "Experimental procedure in which an adverse effect (e.g., foot shock, drug withdrawal) is delivered to rats or mice after presentation of a cue (e.g., light or sound); the rodents are trained to avoid rather than escape the shock after the start of its delivery.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11686 "CAR Test")
Declaration(Class(goldbook:11687))
AnnotationAssertion(rdfs:label goldbook:11687 "classical conditioning")
AnnotationAssertion(dcterms:description goldbook:11687 "Learning in which a behavior comes to be elicited as a reflex response by association with a neutral antecedent stimulus through repetition of the stimulus-response pairing.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11687 "Pavlovian conditioning")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11687 "respondent conditioning")
Declaration(Class(goldbook:11688))
AnnotationAssertion(rdfs:label goldbook:11688 "operant conditioning")
AnnotationAssertion(dcterms:description goldbook:11688 "Learning in which appropriate behavior is rewarded, or inappropriate behavior is punished; behavior is modified by learned association with antecedents and consequences.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11688 "instrumental conditioning")
Declaration(Class(goldbook:11689))
AnnotationAssertion(rdfs:label goldbook:11689 "confusion")
AnnotationAssertion(dcterms:description goldbook:11689 "Mental state of bewilderment or disorientation in which reactions to environmental stimuli may be inappropriate.")
Declaration(Class(goldbook:11690))
AnnotationAssertion(rdfs:label goldbook:11690 "conscious")
AnnotationAssertion(dcterms:description goldbook:11690 "Aware of and responding to one’s surroundings.")
Declaration(Class(goldbook:11691))
AnnotationAssertion(rdfs:label goldbook:11691 "continuous performance test")
AnnotationAssertion(dcterms:description goldbook:11691 "Any of several available neuropsychological procedures that measure a person’s sustained attention.")
Declaration(Class(goldbook:11692))
AnnotationAssertion(rdfs:label goldbook:11692 "contracture")
AnnotationAssertion(dcterms:description goldbook:11692 "Persistent shortening and tightening of muscle, tendon, or other tissue.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11692 "contraction")
Declaration(Class(goldbook:11693))
AnnotationAssertion(rdfs:label goldbook:11693 "contrast medium")
AnnotationAssertion(dcterms:description goldbook:11693 "Any material (usually opaque to X-rays) employed to delineate or define a structure during a radiologic procedure.")
Declaration(Class(goldbook:11694))
AnnotationAssertion(rdfs:label goldbook:11694 "cornu ammonis")
AnnotationAssertion(dcterms:description goldbook:11694 "Part of the hippocampus.")
Declaration(Class(goldbook:11695))
AnnotationAssertion(rdfs:label goldbook:11695 "coronal")
AnnotationAssertion(dcterms:description goldbook:11695 "Vertical (longitudinal) plane dividing the body into ventral and dorsal (front and back) sections.")
Declaration(Class(goldbook:11696))
AnnotationAssertion(rdfs:label goldbook:11696 "coronal suture")
AnnotationAssertion(dcterms:description goldbook:11696 "Transverse junction in the skull separating the frontal bone from the parietal bones.")
Declaration(Class(goldbook:11697))
AnnotationAssertion(rdfs:label goldbook:11697 "corpus callosum")
AnnotationAssertion(dcterms:description goldbook:11697 "Bundle of myelin-enriched neural fibers beneath the cortex connecting the two hemispheres of the brain.")
Declaration(Class(goldbook:11698))
AnnotationAssertion(rdfs:label goldbook:11698 "corpus striatum")
AnnotationAssertion(dcterms:description goldbook:11698 "Striatum together with the globus pallidus.")
Declaration(Class(goldbook:11699))
AnnotationAssertion(rdfs:label goldbook:11699 "cramp")
AnnotationAssertion(dcterms:description goldbook:11699 "Painful muscle spasm caused by prolonged tetanic contraction.")
Declaration(Class(goldbook:11700))
AnnotationAssertion(rdfs:label goldbook:11700 "cranial nerve")
AnnotationAssertion(dcterms:description goldbook:11700 "Each of 12 pairs of nerves that arise directly from the brain, not from the spinal cord, and pass through separate apertures in the skull.")
Declaration(Class(goldbook:11701))
AnnotationAssertion(rdfs:label goldbook:11701 "craniopharyngioma")
AnnotationAssertion(dcterms:description goldbook:11701 "Congenital tumor arising from the pituitary gland in the embryonic tissue between the brain and pharynx.")
Declaration(Class(goldbook:11702))
AnnotationAssertion(rdfs:label goldbook:11702 "cue")
AnnotationAssertion(dcterms:description goldbook:11702 "Stimulus or associated feature of a stimulus that evokes a response or alerts the subject to a particular behavior.")
Declaration(Class(goldbook:11703))
AnnotationAssertion(rdfs:label goldbook:11703 "delirium")
AnnotationAssertion(dcterms:description goldbook:11703 "State of severe confusion, characterized by restlessness, hallucinations and hyperactivity, during which the person affected may be isolated from normal communication.")
Declaration(Class(goldbook:11704))
AnnotationAssertion(rdfs:label goldbook:11704 "dementia")
AnnotationAssertion(dcterms:description goldbook:11704 "Serious loss of brain function in a previously unimpaired person, affecting memory, thinking, and behavior.")
Declaration(Class(goldbook:11705))
AnnotationAssertion(rdfs:label goldbook:11705 "presenile dementia")
AnnotationAssertion(dcterms:description goldbook:11705 "Dementia, often of the Alzheimer type (see Alzheimer disease) developing at or before age 65.")
Declaration(Class(goldbook:11706))
AnnotationAssertion(rdfs:label goldbook:11706 "senile dementia")
AnnotationAssertion(dcterms:description goldbook:11706 "Dementia, often of the Alzheimer type (see Alzheimer disease) developing after the age of 65.")
Declaration(Class(goldbook:11707))
AnnotationAssertion(rdfs:label goldbook:11707 "demyelination")
AnnotationAssertion(dcterms:description goldbook:11707 "Destruction of the protective myelin sheath that surrounds nerve fibers, resulting in diminished function and decreased action potential in those nerves.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11707 "demyelinization")
Declaration(Class(goldbook:11708))
AnnotationAssertion(rdfs:label goldbook:11708 "dentate gyrus")
AnnotationAssertion(dcterms:description goldbook:11708 "Narrow strip of cerebral cortex associated with the hippocampus that continues forward to the uncus.")
Declaration(Class(goldbook:11709))
AnnotationAssertion(rdfs:label goldbook:11709 "chemical dependency")
AnnotationAssertion(dcterms:description goldbook:11709 "Craving for or addiction to a substance.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11709 "drug addiction")
Declaration(Class(goldbook:11710))
AnnotationAssertion(rdfs:label goldbook:11710 "depolarization")
AnnotationAssertion(dcterms:description goldbook:11710 "Relative reduction in the resting membrane potential of an excitable cell, generally making the inside less negative, or even positive with respect to the outside.")
Declaration(Class(goldbook:11711))
AnnotationAssertion(rdfs:label goldbook:11711 "depression")
AnnotationAssertion(dcterms:description goldbook:11711 """Reduction in the activity of the central nervous system.
Mental state or disorder characterized by feelings of sadness and despair.""")
Declaration(Class(goldbook:11712))
AnnotationAssertion(rdfs:label goldbook:11712 "developmental neurotoxicity")
AnnotationAssertion(dcterms:description goldbook:11712 "Adverse effects of toxic substances on the development of the nervous system.")
Declaration(Class(goldbook:11713))
AnnotationAssertion(rdfs:label goldbook:11713 "developmental neurotoxicity testing")
AnnotationAssertion(dcterms:description goldbook:11713 "Any examination that allows detection of substance-induced changes in the structural or functional integrity of the nervous system of a developing organism, fetus or child.")
Declaration(Class(goldbook:11714))
AnnotationAssertion(rdfs:label goldbook:11714 "diaphoretic")
AnnotationAssertion(dcterms:description goldbook:11714 """n. Substance inducing perspiration.
adj. Of a human, sweating heavily.""")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11714 "sudorific")
Declaration(Class(goldbook:11715))
AnnotationAssertion(rdfs:label goldbook:11715 "diarrheal shellfish poisoning")
AnnotationAssertion(dcterms:description goldbook:11715 "Serious illness characterized primarily by diarrhea with rapid onset and resolution after \\(\\pu{24 h}\\) that is a consequence of consumption of bivalve shellfish (mollusks) such as mussels, oysters, and clams that have ingested, by filter feeding, large quantities of dinoflagellates containing a group of high-molecular-weight structures with multiple ether linkages, such as okadaic acid, dinophysis toxins, pectenotoxins, and yessotoxin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11715 "diarrhetic shellfish poisoning (DSP)")
Declaration(Class(goldbook:11716))
AnnotationAssertion(rdfs:label goldbook:11716 "differentiation")
AnnotationAssertion(dcterms:description goldbook:11716 "Process by which a cell is committed to a lineage and becomes more specialized in structure and function.")
Declaration(Class(goldbook:11717))
AnnotationAssertion(rdfs:label goldbook:11717 "digit span test")
AnnotationAssertion(dcterms:description goldbook:11717 "Test of memory in which numbers (series of digits) are presented orally or on a computer screen to a test subject who is asked to repeat each number from memory; the numbers increase in length until mistakes are made.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11717 "digit span task")
Declaration(Class(goldbook:11718))
AnnotationAssertion(rdfs:label goldbook:11718 "digit symbol substitution test")
AnnotationAssertion(dcterms:description goldbook:11718 "Neuropsychological assessment in which the top two rows of a test sheet function as a key, displaying numbers 1–9 (upper row) matched to 'non-sense' symbols (lower row). There follow pairs of rows where the numbers 1–9 appear in irregular sequence and the test subject must match the correct symbol from the key to each number, as quickly as possible.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11718 "digit symbol test")
Declaration(Class(goldbook:11719))
AnnotationAssertion(rdfs:label goldbook:11719 "diplopia")
AnnotationAssertion(dcterms:description goldbook:11719 "Simultaneous perception of two images of a single object.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11719 "double vision")
Declaration(Class(goldbook:11720))
AnnotationAssertion(rdfs:label goldbook:11720 "intervertebral disc")
AnnotationAssertion(dcterms:description goldbook:11720 "Flat circular structure, consisting of a tough, fibrous exterior and a gelatinous core, interposed between adjacent vertebrae.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11720 "spinal disc")
Declaration(Class(goldbook:11721))
AnnotationAssertion(rdfs:label goldbook:11721 "disorientation")
AnnotationAssertion(dcterms:description goldbook:11721 """Loss of sense of direction.
In clinical assessment, lack of awareness of one’s identity, present location, or the current day and time.""")
Declaration(Class(goldbook:11722))
AnnotationAssertion(rdfs:label goldbook:11722 "domoic acid")
AnnotationAssertion(dcterms:description goldbook:11722 "Neurotoxickainic acid analog produced by some algal blooms that causes amnesic shellfish poisoning.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11722 "(2S,3S,4S)-4-[(2Z,4E,6R)-6-carboxy-6-methylhexa-2,4-dien-2-yl]-3-(carboxymethyl)pyrrolidine-2-carboxylic acid")
Declaration(Class(goldbook:11723))
AnnotationAssertion(rdfs:label goldbook:11723 "dopamine")
AnnotationAssertion(dcterms:description goldbook:11723 "Naturally occurring substance functioning as a neurotransmitter in the sympathetic nervous system, and a metabolic precursor of other substances including adrenalin.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11723 "4-(2-aminoethyl)benzene-1,2-diol")
Declaration(Class(goldbook:11724))
AnnotationAssertion(rdfs:label goldbook:11724 "dopaminergic")
AnnotationAssertion(dcterms:description goldbook:11724 "Relating to a nerve that releases or responds to dopamine as a neurotransmitter.")
Declaration(Class(goldbook:11725))
AnnotationAssertion(rdfs:label goldbook:11725 "dorsal root")
AnnotationAssertion(dcterms:description goldbook:11725 "Outgrowth of a spinal nerve that carries sensory signals to an appropriate integration center in the brain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11725 "posterior root of spinal nerve")
Declaration(Class(goldbook:11726))
AnnotationAssertion(rdfs:label goldbook:11726 "dorsal root ganglion")
AnnotationAssertion(dcterms:description goldbook:11726 "Nodule on a dorsal root of the spine that consists of afferent sensory neuronal cell bodies.")
Declaration(Class(goldbook:11727))
AnnotationAssertion(rdfs:label goldbook:11727 "dura mater")
AnnotationAssertion(dcterms:description goldbook:11727 "Outermost and most fibrous of the three membranes of the meninges (see meninx) covering the brain and the spinal cord.")
Declaration(Class(goldbook:11728))
AnnotationAssertion(rdfs:label goldbook:11728 "dynein")
AnnotationAssertion(dcterms:description goldbook:11728 "Protein associated with motile structures that exhibits adenosine triphosphatase activity; it forms 'arms' on the outer microtubules of cilia and flagella and functions as a molecular motor.")
Declaration(Class(goldbook:11729))
AnnotationAssertion(rdfs:label goldbook:11729 "dynorphin")
AnnotationAssertion(dcterms:description goldbook:11729 "Member of a class of opioid peptides that arise from the precursor protein prodynorphin.")
Declaration(Class(goldbook:11730))
AnnotationAssertion(rdfs:label goldbook:11730 "dysaphia")
AnnotationAssertion(dcterms:description goldbook:11730 "Impairment of the sense of touch.")
Declaration(Class(goldbook:11731))
AnnotationAssertion(rdfs:label goldbook:11731 "dysarthria")
AnnotationAssertion(dcterms:description goldbook:11731 "Difficulty in speech owing to disturbances of muscular control resulting from central or peripheral nervous system damage or emotional stress.")
Declaration(Class(goldbook:11732))
AnnotationAssertion(rdfs:label goldbook:11732 "dysesthesia")
AnnotationAssertion(dcterms:description goldbook:11732 """Condition in which a disagreeable sensation, especially of touch, is produced following damage to peripheral or central sensory pathways.
Abnormal sensation experienced in the absence of stimulation.""")
Declaration(Class(goldbook:11733))
AnnotationAssertion(rdfs:label goldbook:11733 "dysgraphia")
AnnotationAssertion(dcterms:description goldbook:11733 "Difficulty in writing.")
Declaration(Class(goldbook:11734))
AnnotationAssertion(rdfs:label goldbook:11734 "dyskinesia")
AnnotationAssertion(dcterms:description goldbook:11734 "Difficulty or abnormality in voluntary movement.")
Declaration(Class(goldbook:11735))
AnnotationAssertion(rdfs:label goldbook:11735 "tardive dyskinesia")
AnnotationAssertion(dcterms:description goldbook:11735 "Involuntary, repetitive body movement of slow onset.")
Declaration(Class(goldbook:11736))
AnnotationAssertion(rdfs:label goldbook:11736 "dyslexia")
AnnotationAssertion(dcterms:description goldbook:11736 "Impairment in appreciation of spatial relations, often leading to difficulty in reading.")
Declaration(Class(goldbook:11737))
AnnotationAssertion(rdfs:label goldbook:11737 "dysphagia")
AnnotationAssertion(dcterms:description goldbook:11737 "Difficulty in swallowing.")
Declaration(Class(goldbook:11738))
AnnotationAssertion(rdfs:label goldbook:11738 "dysphasia")
AnnotationAssertion(dcterms:description goldbook:11738 "Difficulty in the use of language owing to a brain lesion, without mental impairment.")
Declaration(Class(goldbook:11739))
AnnotationAssertion(rdfs:label goldbook:11739 "autonomic dysreflexia")
AnnotationAssertion(dcterms:description goldbook:11739 "Over-activity of the autonomic nervous system causing an abrupt onset of excessively high blood pressure, tachycardia, and constriction of peripheral blood vessels.")
Declaration(Class(goldbook:11740))
AnnotationAssertion(rdfs:label goldbook:11740 "dystonia")
AnnotationAssertion(dcterms:description goldbook:11740 "State of abnormal (either hypo- or hypertonic) muscle tone resulting in impairment of voluntary movement.")
Declaration(Class(goldbook:11741))
AnnotationAssertion(rdfs:label goldbook:11741 "efferent")
AnnotationAssertion(dcterms:description goldbook:11741 "Carrying outward; of nerves, those that conduct impulses outward from the central nervous system.")
Declaration(Class(goldbook:11742))
AnnotationAssertion(rdfs:label goldbook:11742 "electroconvulsive therapy")
AnnotationAssertion(dcterms:description goldbook:11742 "Therapeutic intervention in which seizures are electrically induced in patients with the aim of providing relief from a specific mental illness.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11742 "electroshock therapy")
Declaration(Class(goldbook:11743))
AnnotationAssertion(rdfs:label goldbook:11743 "electroencephalogram")
AnnotationAssertion(dcterms:description goldbook:11743 "Test or record of brain electrical activity detected by electroencephalography.")
Declaration(Class(goldbook:11744))
AnnotationAssertion(rdfs:label goldbook:11744 "electroencephalography")
AnnotationAssertion(dcterms:description goldbook:11744 "Recording of electrical activity from different parts of the brain.")
Declaration(Class(goldbook:11745))
AnnotationAssertion(rdfs:label goldbook:11745 "electromyography")
AnnotationAssertion(dcterms:description goldbook:11745 "Recording of the electrical activity of muscle, or its representation as a visual display or audible signal, using electrodes attached to the skin or inserted into a muscle.")
Declaration(Class(goldbook:11746))
AnnotationAssertion(rdfs:label goldbook:11746 "electroneurography")
AnnotationAssertion(dcterms:description goldbook:11746 "Non-invasive method used to examine the integrity and conductivity of a peripheral nerve, in which a brief electrical stimulation is given to the nerve at one point, while at the same time the induced electrical activity (compound action potentials) is recorded at another point of the nerve’s distribution and the interval is displayed on a video monitor.")
Declaration(Class(goldbook:11747))
AnnotationAssertion(rdfs:label goldbook:11747 "electrophysiology")
AnnotationAssertion(dcterms:description goldbook:11747 "Study of the electrical properties of cells and tissues.")
Declaration(Class(goldbook:11748))
AnnotationAssertion(rdfs:label goldbook:11748 "electroretinogram")
AnnotationAssertion(dcterms:description goldbook:11748 "Recording, with electrodes placed on the cornea or nearby skin, of the electrical activity of photoreceptors and other retinal cells in response to standardized, patterned stimuli with light and colour.")
Declaration(Class(goldbook:11749))
AnnotationAssertion(rdfs:label goldbook:11749 "elevated plus maze")
AnnotationAssertion(dcterms:description goldbook:11749 "Stage with four orthogonal side arms elevated above the floor, where two opposite arms have sidewalls and the other two arms have no walls; used as research tool for anxiety.")
Declaration(Class(goldbook:11750))
AnnotationAssertion(rdfs:label goldbook:11750 "emesis")
AnnotationAssertion(dcterms:description goldbook:11750 "Vomiting.")
Declaration(Class(goldbook:11751))
AnnotationAssertion(rdfs:label goldbook:11751 "emetic")
AnnotationAssertion(dcterms:description goldbook:11751 """n. Substance that produces vomiting.
adj. Producing vomiting.""")
Declaration(Class(goldbook:11752))
AnnotationAssertion(rdfs:label goldbook:11752 "encephalopathy")
AnnotationAssertion(dcterms:description goldbook:11752 "Any disorder of the brain that affects its functioning.")
Declaration(Class(goldbook:11753))
AnnotationAssertion(rdfs:label goldbook:11753 "endocrine disruptor")
AnnotationAssertion(dcterms:description goldbook:11753 "Exogenous chemical that alters function(s) of the endocrine system and consequently causes adverse health effects in an intact organism, its progeny, or (sub)populations.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11753 "endocrine modifier")
Declaration(Class(goldbook:11754))
AnnotationAssertion(rdfs:label goldbook:11754 "endorphin")
AnnotationAssertion(dcterms:description goldbook:11754 "One of several peptides (including the enkephalins) that activates the body’s opiate receptors, causing an analgesic effect; literally, endogenous morphine-like substance.")
Declaration(Class(goldbook:11755))
AnnotationAssertion(rdfs:label goldbook:11755 "enkephalin")
AnnotationAssertion(dcterms:description goldbook:11755 "Either of two endogenous pentapeptides with opiate-like effects that are especially involved in modulating pain responses in the central nervous system.")
Declaration(Class(goldbook:11756))
AnnotationAssertion(rdfs:label goldbook:11756 "ependymal tissue")
AnnotationAssertion(dcterms:description goldbook:11756 "Glial cells that line the cavities within the brain’sventricles.")
Declaration(Class(goldbook:11757))
AnnotationAssertion(rdfs:label goldbook:11757 "ependymoma")
AnnotationAssertion(dcterms:description goldbook:11757 "Growth in the brain or spinal cord arising from ependymal tissue.")
Declaration(Class(goldbook:11758))
AnnotationAssertion(rdfs:label goldbook:11758 "epidural")
AnnotationAssertion(dcterms:description goldbook:11758 "Immediately outside the dura mater.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11758 "extradural")
Declaration(Class(goldbook:11759))
AnnotationAssertion(rdfs:label goldbook:11759 "epithalamus")
AnnotationAssertion(dcterms:description goldbook:11759 "Dorsal part of the diencephalon, including the pineal gland and adjacent structures in the roof of the third ventricle.")
Declaration(Class(goldbook:11760))
AnnotationAssertion(rdfs:label goldbook:11760 "ergotism")
AnnotationAssertion(dcterms:description goldbook:11760 "Poisoning produced by eating food affected by ergot (ergotamine alkaloids), substances produced by the fungus Claviceps purpurea that contaminate rye and wheat.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11760 "ignis infernalis")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11760 "ignis sacer")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11760 "St Anthony’s fire")
Declaration(Class(goldbook:11761))
AnnotationAssertion(rdfs:label goldbook:11761 "euphoria")
AnnotationAssertion(dcterms:description goldbook:11761 "Characterized by or feeling intense excitement and happiness.")
Declaration(Class(goldbook:11762))
AnnotationAssertion(rdfs:label goldbook:11762 "evoked potential")
AnnotationAssertion(dcterms:description goldbook:11762 "Electrical potential that is triggered by presentation of a stimulus (somatosensory, auditory, visual) and measured with electrodes near the nerve or near the brain region in which the signal is processed.")
Declaration(Class(goldbook:11763))
AnnotationAssertion(rdfs:label goldbook:11763 "evoked response")
AnnotationAssertion(dcterms:description goldbook:11763 "Electrical potential recorded from the nervous system following exposure to a stimulus, as distinct from spontaneous potentials detected by electroencephalography, electromyography, or other electrophysiological recording methods.")
Declaration(Class(goldbook:11764))
AnnotationAssertion(rdfs:label goldbook:11764 "excitable cell")
AnnotationAssertion(dcterms:description goldbook:11764 "Cell that can be stimulated to create an electric current; muscle fibers and nerve cells are excitable (see excitation).")
Declaration(Class(goldbook:11765))
AnnotationAssertion(rdfs:label goldbook:11765 "excitatory post-synaptic potential")
AnnotationAssertion(dcterms:description goldbook:11765 "Referring to a more positive membrane potential at the postsynaptic side of the synaptic cleft that renders the postsynaptic neuron more likely to generate an action potential.")
Declaration(Class(goldbook:11766))
AnnotationAssertion(rdfs:label goldbook:11766 "excitotoxicity")
AnnotationAssertion(dcterms:description goldbook:11766 "Pathological process by which neurons are damaged and killed by the overactivation of receptors for the excitatory neurotransmitter glutamate, such as the N-methyl-D-aspartic acid (NMDA) receptor and the 2-amino-3-(3-hydroxy-5-methyl-1,2-oxazol-4-yl)propanoic acid (AMPA) receptor.")
Declaration(Class(goldbook:11767))
AnnotationAssertion(rdfs:label goldbook:11767 "facilitation")
AnnotationAssertion(dcterms:description goldbook:11767 """Neural facilitation: Increase in postsynaptic excitation as a result of very rapid firing of action potentials by a presynaptic neuron.
Presynaptic facilitation: Increase of presynaptic excitation when an excited neuron receives additional excitatory impulses from other neurons.""")
Declaration(Class(goldbook:11768))
AnnotationAssertion(rdfs:label goldbook:11768 "falx")
AnnotationAssertion(dcterms:description goldbook:11768 "Continuation of dura mater between the right and left hemispheres of the brain.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11768 "falx cerebri")
Declaration(Class(goldbook:11769))
AnnotationAssertion(rdfs:label goldbook:11769 "fasciculation")
AnnotationAssertion(dcterms:description goldbook:11769 "Involuntary contractions, or twitchings, of groups (fasciculi) of muscle fibers.")
Declaration(Class(goldbook:11770))
AnnotationAssertion(rdfs:label goldbook:11770 "fibrillation")
AnnotationAssertion(dcterms:description goldbook:11770 "Rapid contractions or twitching of muscle fibrils, but not of the muscle as a whole.")
Declaration(Class(goldbook:11771))
AnnotationAssertion(rdfs:label goldbook:11771 "finger tapping test")
AnnotationAssertion(dcterms:description goldbook:11771 "Procedure in which a test subject is asked to tap a finger at maximal rate on a surface, a higher rate of tapping indicating better neuromuscular function.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11771 "tapping test")
Declaration(Class(goldbook:11772))
AnnotationAssertion(rdfs:label goldbook:11772 "flaccid")
AnnotationAssertion(dcterms:description goldbook:11772 "Relaxed, flabby, or without tone.")
Declaration(Class(goldbook:11773))
AnnotationAssertion(rdfs:label goldbook:11773 "frontal lobe")
AnnotationAssertion(dcterms:description goldbook:11773 "Most anterior of the four major lobes of each cerebral hemisphere, containing the primary motor cortex.")
Declaration(Class(goldbook:11774))
AnnotationAssertion(rdfs:label goldbook:11774 "frontotemporal dementia")
AnnotationAssertion(dcterms:description goldbook:11774 "Neurodegenerative disease characterized by progressive neuronal defects in the frontal and temporal lobes of the brain, leading to dementia.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11774 "frontotemporal lobular degeneration (FTLD)")
Declaration(Class(goldbook:11775))
AnnotationAssertion(rdfs:label goldbook:11775 "functional domain")
AnnotationAssertion(dcterms:description goldbook:11775 "In the brain, referring to the concept that discrete regions are involved in specific aspects of cognitive function, thus giving rise to modularity.")
Declaration(Class(goldbook:11776))
AnnotationAssertion(rdfs:label goldbook:11776 "functional observational battery")
AnnotationAssertion(dcterms:description goldbook:11776 "Structured set of tests to examine changes in neuromuscular, arousal, autonomic and sensory functions that assesses the presence, absence or severity of specific neurological signs.")
Declaration(Class(goldbook:11777))
AnnotationAssertion(rdfs:label goldbook:11777 "fused in sarcoma transcription factor")
AnnotationAssertion(dcterms:description goldbook:11777 "Nuclear DNA- and RNA-binding protein involved in transcription, splicing, and RNA-transport.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11777 "FUS transcription factor")
Declaration(Class(goldbook:11778))
AnnotationAssertion(rdfs:label goldbook:11778 "GABAergic")
AnnotationAssertion(dcterms:description goldbook:11778 "Pertaining to the action of $\\ce{\\upgamma\\!\\mbox{-}aminobutyric acid}$ or to neural or metabolic pathways in which it functions as a neurotransmitter.")
Declaration(Class(goldbook:11779))
AnnotationAssertion(rdfs:label goldbook:11779 "ganglion")
AnnotationAssertion(dcterms:description goldbook:11779 """Cluster of nerve cell bodies located outside the brain and spinal cord, i.e., in the peripheral nervous system.Note: Ganglia interconnect to form a complex network known as a plexus and serve as relay stations where different neurons can modulate the signals of each other. Compare: basal ganglion.
Fibrous cyst usually attached to a tendon sheath.""")
Declaration(Class(goldbook:11780))
AnnotationAssertion(rdfs:label goldbook:11780 "ganglion cell")
AnnotationAssertion(dcterms:description goldbook:11780 "Neuron located in a ganglion.")
Declaration(Class(goldbook:11781))
AnnotationAssertion(rdfs:label goldbook:11781 "ganglioside")
AnnotationAssertion(dcterms:description goldbook:11781 "Glycosphingolipid chemically similar to cerebrosides but containing one or more sialic (N-acetylneuraminic or N-glycolylneuraminic) acid residues, found principally in nerve tissue, spleen, and thymus.")
Declaration(Class(goldbook:11782))
AnnotationAssertion(rdfs:label goldbook:11782 "giant axon")
AnnotationAssertion(dcterms:description goldbook:11782 "Very large axon (typically \\(\\pu{0.5 mm}\\) in diameter) that functions in the propulsion system of the squid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11782 "squid giant axon")
Declaration(Class(goldbook:11783))
AnnotationAssertion(rdfs:label goldbook:11783 "giant axonal neuropathy")
AnnotationAssertion(dcterms:description goldbook:11783 "Rare human genetic neurological disorder in which the neurofilaments become disordered, resulting in abnormal size and shape of neurons.")
Declaration(Class(goldbook:11784))
AnnotationAssertion(rdfs:label goldbook:11784 "glia")
AnnotationAssertion(dcterms:description goldbook:11784 "Non-neuronal cellular elements of the central and peripheral nervous system having metabolic and support functions.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11784 "neuroglia")
Declaration(Class(goldbook:11785))
