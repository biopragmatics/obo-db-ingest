AnnotationAssertion(rdfs:label goldbook:T06275 "terminator")
AnnotationAssertion(dcterms:description goldbook:T06275 "A sequence of DNA lying beyond the 3' end of the coding segment of a gene which is recognized by RNA polymerase as a signal to stop synthesizing mRNA.")
AnnotationAssertion(rdfs:seeAlso goldbook:T06275 goldbook:D01597)
AnnotationAssertion(rdfs:seeAlso goldbook:T06275 goldbook:R05386)
