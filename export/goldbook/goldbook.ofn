AnnotationAssertion(mito:isMentionedBy goldbook:A00129 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00129 "current"^^xsd:string)
Declaration(Class(goldbook:A00132))
AnnotationAssertion(rdfs:label goldbook:A00132 "addition")
AnnotationAssertion(dcterms:description goldbook:A00132 "Refers to addition reaction or addition transformation.Loosely, the formation of an adduct. (For an example, see Lewis acid.)Loosely, any association or attachment.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00132 goldbook:L03508)
AnnotationAssertion(rdfs:seeAlso goldbook:A00132 goldbook:A00133)
AnnotationAssertion(rdfs:seeAlso goldbook:A00132 goldbook:A00138)
AnnotationAssertion(rdfs:seeAlso goldbook:A00132 goldbook:A00472)
AnnotationAssertion(rdfs:seeAlso goldbook:A00132 goldbook:A00512)
AnnotationAssertion(rdfs:seeAlso goldbook:A00132 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:A00132 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00132 "current"^^xsd:string)
Declaration(Class(goldbook:A00133))
AnnotationAssertion(rdfs:label goldbook:A00133 "addition reaction")
AnnotationAssertion(dcterms:description goldbook:A00133 "A chemical reaction of two or more reacting molecular entities, resulting in a single reaction product containing all atoms of all components, with formation of two chemical bonds and a net reduction in bond multiplicity in at least one of the reactants. The reverse process is called an elimination reaction. The addition may occur at only one site (α-addition, 1/1/addition), at two adjacent sites (1/2/addition) or at two non-adjacent sites (1/3/- or 1/4/addition, etc.). For example:   If the reagent or the source of the addends of an addition are not specified, then it is called an addition transformation.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:A00132)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:C01014)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:C01033)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:C01496)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:E02038)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:M03986)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:R05190)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:T06446)
AnnotationAssertion(rdfs:seeAlso goldbook:A00133 goldbook:A00001)
AnnotationAssertion(mito:isMentionedBy goldbook:A00133 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00133 "current"^^xsd:string)
Declaration(Class(goldbook:A00135))
AnnotationAssertion(rdfs:label goldbook:A00135 "additive name")
AnnotationAssertion(dcterms:description goldbook:A00135 "The formal assembly of names for the components of a compound without loss of atoms or groups of atoms from any componentThe addition or attachment of atoms or groups of atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00135 goldbook:A00512)
AnnotationAssertion(mito:isMentionedBy goldbook:A00135 doi:10.1351/pac199971071327)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00135 "current"^^xsd:string)
Declaration(Class(goldbook:A00137))
AnnotationAssertion(rdfs:label goldbook:A00137 "additivity principle")
AnnotationAssertion(dcterms:description goldbook:A00137 "The hypothesis that each of several structural features of a molecular entity makes a separate and additive contribution to a property of the substance concerned. More specifically, it is the hypothesis that each of the several substituent groups in a parent molecule makes a separate and additive contribution to the standard Gibbs energy change (or Gibbs energy of activation) corresponding to a particular equilibrium (or rate of reaction).")
AnnotationAssertion(rdfs:seeAlso goldbook:A00137 goldbook:G02631)
AnnotationAssertion(rdfs:seeAlso goldbook:A00137 goldbook:A00134)
AnnotationAssertion(rdfs:seeAlso goldbook:A00137 goldbook:M03986)
AnnotationAssertion(rdfs:seeAlso goldbook:A00137 goldbook:R05156)
AnnotationAssertion(rdfs:seeAlso goldbook:A00137 goldbook:S06076)
AnnotationAssertion(rdfs:seeAlso goldbook:A00137 goldbook:T06441)
AnnotationAssertion(mito:isMentionedBy goldbook:A00137 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00137 "current"^^xsd:string)
Declaration(Class(goldbook:A00138))
AnnotationAssertion(rdfs:label goldbook:A00138 "adduct")
AnnotationAssertion(dcterms:description goldbook:A00138 "A new chemical species AB, each molecular entity of which is formed by direct combination of two separate molecular entities A and B in such a way that there is change in connectivity, but no loss, of atoms within the moieties A and B. Stoichiometries other than 1:1 are also possible, e.g. a bis-adduct (2:1). An intramolecular adduct can be formed when A and B are groups contained within the same molecular entity. This is a general term which, whenever appropriate, should be used in preference to the less explicit term complex. It is also used specifically for products of an addition reaction. For examples, see Lewis adduct, Meisenheimer adduct, π-adduct.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:L03510)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:M03819)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:A00133)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:CT01038)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:C01203)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:C01274)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:M03968)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:M03986)
AnnotationAssertion(rdfs:seeAlso goldbook:A00138 goldbook:A04388)
AnnotationAssertion(mito:isMentionedBy goldbook:A00138 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00138 "current"^^xsd:string)
Declaration(Class(goldbook:A00139))
AnnotationAssertion(rdfs:label goldbook:A00139 "adduct ion")
AnnotationAssertion(dcterms:description goldbook:A00139 "An ion formed by interaction of two species, usually an ion and a molecule, and often within the ion source, to form an ion containing all the constituent atoms of one species as well as an additional atom or atoms.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00139 goldbook:C01281)
AnnotationAssertion(mito:isMentionedBy goldbook:A00139 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00139 "current"^^xsd:string)
Declaration(Class(goldbook:A00140))
AnnotationAssertion(rdfs:label goldbook:A00140 "adhesional wetting")
AnnotationAssertion(dcterms:description goldbook:A00140 "A process in which an adhesional joint is formed between two phases.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00140 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00140 "current"^^xsd:string)
Declaration(Class(goldbook:A00141))
AnnotationAssertion(rdfs:label goldbook:A00141 "adiabatic")
AnnotationAssertion(dcterms:description goldbook:A00141 "This word is used with various different meanings, and when it is used it should be defined. In thermodynamics 'adiabatic' is used in a macroscopic sense to refer to a process occurring in a thermally insulated system, so that there is no flow of heat to or from the surroundings. In reaction dynamics, the word has been used in a microscopic sense, with a range of meanings which have only a tenuous relationship to the thermodynamic meaning or the etymology. Whereas the thermodynamic meaning relates to conditions imposed on a process by an observer, the microscopic meaning relates to conditions under which the process occurs naturally. The microscopic meanings, as used in reaction dynamics, all have in common the feature that quantum states remain unchanged during the course of reaction. Different quantum states may be referred to: A reaction that is not adiabatic is referred to as nonadiabatic or diabatic, and some workers make a distinction between the two words.A reaction in which there is no change of electronic state or multiplicity has been called adiabatic, or more specifically electronically adiabatic. A reaction in which there is no change of vibrational state during the course of reaction has been said to be vibrationally adiabatic. More loosely, the expression has been applied to a process in which excess vibrational energy in the reactants appears as vibrational energy in the products, or in which ground-state vibration in the reactants leads to ground state vibration in the products.A reaction in which excess rotational energy in the reactants appears as rotational energy in the products, or in which ground-state rotation in the reactants leads to ground-state rotation in the products, has been referred to as rotationally adiabatic.In the Rice–Ramsperger–Kassel–Marcus (RRKM) theory of unimolecular reactions, a degree of freedom whose quantum number is more or less preserved during energization and subsequent reaction has been called 'adiabatic'; the word 'inactive' has also been applied to it.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:R05390)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:D01658)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:ET07026)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:P04861)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:R05163)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:R05170)
AnnotationAssertion(rdfs:seeAlso goldbook:A00141 goldbook:M03989)
AnnotationAssertion(mito:isMentionedBy goldbook:A00141 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00141 "current"^^xsd:string)
Declaration(Class(goldbook:A00142))
AnnotationAssertion(rdfs:label goldbook:A00142 "adiabatic electron transfer")
AnnotationAssertion(dcterms:description goldbook:A00142 "Electron transfer process in which the reacting system remains on a single electronic surface in passing from reactants to products. For adiabatic electron transfer the electronic transmission factor is close to unity.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00142 goldbook:E02011)
AnnotationAssertion(rdfs:seeAlso goldbook:A00142 goldbook:M03702)
AnnotationAssertion(rdfs:seeAlso goldbook:A00142 goldbook:A00141)
AnnotationAssertion(rdfs:seeAlso goldbook:A00142 goldbook:D01659)
AnnotationAssertion(rdfs:seeAlso goldbook:A00142 goldbook:T06482)
AnnotationAssertion(mito:isMentionedBy goldbook:A00142 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00142 "current"^^xsd:string)
Declaration(Class(goldbook:A00143))
AnnotationAssertion(rdfs:label goldbook:A00143 "adiabatic ionization")
AnnotationAssertion(dcterms:description goldbook:A00143 "A process whereby an electron is either removed from or added to an atom or molecule producing an ion in its ground state.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00143 goldbook:G02704)
AnnotationAssertion(mito:isMentionedBy goldbook:A00143 doi:10.1351/pac199163101541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00143 "current"^^xsd:string)
Declaration(Class(goldbook:A00144))
AnnotationAssertion(rdfs:label goldbook:A00144 "adiabatic lapse rate")
AnnotationAssertion(dcterms:description goldbook:A00144 "The rate of decrease in temperature with increase in altitude of an air parcel which is expanding slowly to a lower atmospheric pressure without exchange of heat; for a descending parcel it is the rate of increase in temperature with decrease in altitude. Theory predicts that for dry air it is equal to the acceleration of gravity divided by the specific heat of dry air at constant pressure (approximately \\(9.8\\ ^{\\unicode{x26ac}} \\rm{C}\\ \\rm{km}^{-1}\\)). The moist adiabatic lapse rate is less than the dry adiabatic lapse rate and depends on the moisture content of the air mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00144 goldbook:A00051)
AnnotationAssertion(rdfs:seeAlso goldbook:A00144 goldbook:A00141)
AnnotationAssertion(mito:isMentionedBy goldbook:A00144 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00144 "current"^^xsd:string)
Declaration(Class(goldbook:A00145))
AnnotationAssertion(rdfs:label goldbook:A00145 "adiabatic photoreaction")
AnnotationAssertion(dcterms:description goldbook:A00145 "Within the 'Born-Oppenheimer' approximation, a reaction of an excited state species that occurs on a single 'potential-energy surface'.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00145 goldbook:D01660)
AnnotationAssertion(rdfs:seeAlso goldbook:A00145 goldbook:E02257)
AnnotationAssertion(mito:isMentionedBy goldbook:A00145 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00145 "current"^^xsd:string)
Declaration(Class(goldbook:A00146))
AnnotationAssertion(rdfs:label goldbook:A00146 "adiabatic transition-state theory")
AnnotationAssertion(dcterms:description goldbook:A00146 "A form of transition-state theory in which the system is assumed to preserve its internal quantum states as it moves over the potential-energy surface. A detailed state-to-state scattering theory version of adiabatic transition-state theory has been referred to as the adiabatic channel model.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00146 goldbook:A00141)
AnnotationAssertion(rdfs:seeAlso goldbook:A00146 goldbook:C00970)
AnnotationAssertion(rdfs:seeAlso goldbook:A00146 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:A00146 goldbook:S05487)
AnnotationAssertion(rdfs:seeAlso goldbook:A00146 goldbook:T06470)
AnnotationAssertion(mito:isMentionedBy goldbook:A00146 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00146 "current"^^xsd:string)
Declaration(Class(goldbook:A00147))
AnnotationAssertion(rdfs:label goldbook:A00147 "adiabatic treatments of reaction rates")
AnnotationAssertion(dcterms:description goldbook:A00147 "These are treatments of reaction rates in which the system is assumed to remain on a single potential-energy surface during the entire course of reaction, or to remain in a conserved internal state.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00147 goldbook:P04780)
AnnotationAssertion(mito:isMentionedBy goldbook:A00147 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00147 "current"^^xsd:string)
Declaration(Class(goldbook:A00150))
AnnotationAssertion(rdfs:label goldbook:A00150 "adjuvant")
AnnotationAssertion(dcterms:description goldbook:A00150 "In pharmacology, a substance added to a drug to speed or increase the action of the main component.In immunology, a substance (such as aluminium hydroxide) or an organism (such as bovine tuberculosis bacillus) which increases the response to an antigen.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00150 goldbook:A00394)
AnnotationAssertion(rdfs:seeAlso goldbook:A00150 goldbook:D01863)
AnnotationAssertion(mito:isMentionedBy goldbook:A00150 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00150 "current"^^xsd:string)
Declaration(Class(goldbook:A00152))
AnnotationAssertion(rdfs:label goldbook:A00152 "adsorbate")
AnnotationAssertion(dcterms:description goldbook:A00152 "A molecular species of gas, dissolved substance or liquid which adheres to or is adsorbed in an extremely thin surface layer of a solid substance.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00152 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00152 "current"^^xsd:string)
Declaration(Class(goldbook:A00153))
AnnotationAssertion(rdfs:label goldbook:A00153 "adsorbent")
AnnotationAssertion(dcterms:description goldbook:A00153 "A condensed phase at the surface of which adsorption may occur.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00153 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00153 "current"^^xsd:string)
Declaration(Class(goldbook:A00154))
AnnotationAssertion(rdfs:label goldbook:A00154 "adsorber")
AnnotationAssertion(dcterms:description goldbook:A00154 "Solid material used to capture either a gas or liquid; often activated carbon is employed as the solid because of its high surface area per unit mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00154 goldbook:A00090)
AnnotationAssertion(rdfs:seeAlso goldbook:A00154 goldbook:C00796)
AnnotationAssertion(mito:isMentionedBy goldbook:A00154 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00154 "current"^^xsd:string)
Declaration(Class(goldbook:A00155))
AnnotationAssertion(rdfs:label goldbook:A00155 "adsorption")
AnnotationAssertion(dcterms:description goldbook:A00155 "An increase in the concentration of a dissolved substance at the interface of a condensed and a liquid phase due to the operation of surface forces. Adsorption can also occur at the interface of a condensed and a gaseous phase.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00155 goldbook:I03082)
AnnotationAssertion(mito:isMentionedBy goldbook:A00155 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00155 "current"^^xsd:string)
Declaration(Class(goldbook:A00156))
AnnotationAssertion(rdfs:label goldbook:A00156 "adsorption capacity")
AnnotationAssertion(dcterms:description goldbook:A00156 "For strongly adsorbed solutes of limited solubility, the value of the amount of adsorbed substance reached in a saturated solution is called the adsorption capacity of the adsorbent for a specific solute; its value depends also, in general, on the nature and, in the case of more than two components, on the relative composition of the bulk liquid.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00156 goldbook:A00153)
AnnotationAssertion(rdfs:seeAlso goldbook:A00156 goldbook:S05471)
AnnotationAssertion(rdfs:seeAlso goldbook:A00156 goldbook:S05740)
AnnotationAssertion(mito:isMentionedBy goldbook:A00156 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00156 "current"^^xsd:string)
Declaration(Class(goldbook:A00157))
AnnotationAssertion(rdfs:label goldbook:A00157 "adsorption chromatography")
AnnotationAssertion(dcterms:description goldbook:A00157 "Chromatography in which separation is based mainly on differences between the adsorption affinities of the sample components for the surface of an active solid.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00157 goldbook:C01075)
AnnotationAssertion(rdfs:seeAlso goldbook:A00157 goldbook:A00109)
AnnotationAssertion(mito:isMentionedBy goldbook:A00157 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00157 "current"^^xsd:string)
Declaration(Class(goldbook:A00158))
AnnotationAssertion(rdfs:label goldbook:A00158 "adsorption complex")
AnnotationAssertion(dcterms:description goldbook:A00158 "The entity constituted by the adsorbate and the part of the adsorbent to which it is bound.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00158 goldbook:A00152)
AnnotationAssertion(rdfs:seeAlso goldbook:A00158 goldbook:A00153)
AnnotationAssertion(mito:isMentionedBy goldbook:A00158 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00158 "current"^^xsd:string)
Declaration(Class(goldbook:A00159))
AnnotationAssertion(rdfs:label goldbook:A00159 "adsorption current")
AnnotationAssertion(dcterms:description goldbook:A00159 "A faradaic current whose magnitude depends on the applied potential, and, at any particular applied potential, on the rate or extent of the adsorption of an electroactive substance (or the product obtained from the reduction or oxidation of an electroactive substance) onto the surface of the indicator or working electrode.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:A00424)
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:E01940)
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:F02321)
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:I03006)
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:L03529)
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:A00159 goldbook:W06686)
AnnotationAssertion(mito:isMentionedBy goldbook:A00159 doi:10.1351/pac198557101491)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00159 "current"^^xsd:string)
Declaration(Class(goldbook:A00161))
AnnotationAssertion(rdfs:label goldbook:A00161 "adsorption hysteresis")
AnnotationAssertion(dcterms:description goldbook:A00161 "Adsorption hysteresis is said to occur when adsorption and desorption values deviate from one another.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00161 goldbook:A00155)
AnnotationAssertion(rdfs:seeAlso goldbook:A00161 goldbook:D01620)
AnnotationAssertion(rdfs:seeAlso goldbook:A00161 goldbook:H02930)
AnnotationAssertion(mito:isMentionedBy goldbook:A00161 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00161 "current"^^xsd:string)
Declaration(Class(goldbook:A00163))
AnnotationAssertion(rdfs:label goldbook:A00163 "adsorption isobar")
AnnotationAssertion(dcterms:description goldbook:A00163 "The function relating the amount, mass, or volume, or corresponding excess of substance adsorbed by a given amount of solid, to the temperature at constant pressure.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00163 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00163 "current"^^xsd:string)
Declaration(Class(goldbook:A00164))
AnnotationAssertion(rdfs:label goldbook:A00164 "adsorption isostere")
AnnotationAssertion(dcterms:description goldbook:A00164 "The function relating the equilibrium pressure to the temperature at a constant value of the amount, or excess amount, of substance adsorbed by a given amount of solid.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00164 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00164 "current"^^xsd:string)
Declaration(Class(goldbook:A00166))
AnnotationAssertion(rdfs:label goldbook:A00166 "adsorptive")
AnnotationAssertion(dcterms:description goldbook:A00166 "The material that is present in one or other (or both) of the bulk phases and capable of being adsorbed.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00166 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00166 "current"^^xsd:string)
Declaration(Class(goldbook:A00168))
AnnotationAssertion(rdfs:label goldbook:A00168 "advection")
AnnotationAssertion(dcterms:description goldbook:A00168 "The transport of air, its properties (such as heat), trace materials, fog, cold air, etc., solely by mass motion of the atmosphere, generally in a horizontal direction.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00168 goldbook:F02470)
AnnotationAssertion(mito:isMentionedBy goldbook:A00168 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00168 "current"^^xsd:string)
Declaration(Class(goldbook:A00169))
AnnotationAssertion(rdfs:label goldbook:A00169 "aeration")
AnnotationAssertion(dcterms:description goldbook:A00169 "The process by which a volume filled with a liquid becomes permeated with air or another gas; aeration is often accomplished by spraying the liquid into the air, bubbling air through a liquid or agitating the liquid to promote surface absorption of air.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00169 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00169 "current"^^xsd:string)
Declaration(Class(goldbook:A00170))
AnnotationAssertion(rdfs:label goldbook:A00170 "aerobe")
AnnotationAssertion(dcterms:description goldbook:A00170 "An organism that needs oxygen for respiration and hence for growth.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00170 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00170 "current"^^xsd:string)
Declaration(Class(goldbook:A00171))
AnnotationAssertion(rdfs:label goldbook:A00171 "aerobic")
AnnotationAssertion(dcterms:description goldbook:A00171 "Requiring molecular oxygen.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00171 goldbook:A00316)
AnnotationAssertion(mito:isMentionedBy goldbook:A00171 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00171 "current"^^xsd:string)
Declaration(Class(goldbook:A00172))
AnnotationAssertion(rdfs:label goldbook:A00172 "aerobic conditions")
AnnotationAssertion(dcterms:description goldbook:A00172 "Conditions for growth or metabolism in which the organism is sufficiently supplied with oxygen.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00172 goldbook:M03858)
AnnotationAssertion(mito:isMentionedBy goldbook:A00172 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00172 "current"^^xsd:string)
Declaration(Class(goldbook:A00173))
AnnotationAssertion(rdfs:label goldbook:A00173 "aerogel")
AnnotationAssertion(dcterms:description goldbook:A00173 "Gel comprised of a microporous solid in which the dispersed phase is a gas.")
AnnotationAssertion(rdfs:comment goldbook:A00173 "Microporous silica, microporous glass and zeolites are common examples of aerogels."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:A00173 goldbook:G02600)
AnnotationAssertion(mito:isMentionedBy goldbook:A00173 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00173 "current"^^xsd:string)
Declaration(Class(goldbook:A00174))
AnnotationAssertion(rdfs:label goldbook:A00174 "aerometer")
AnnotationAssertion(dcterms:description goldbook:A00174 "Instrument used to measure the density of gases.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00174 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00174 "current"^^xsd:string)
Declaration(Class(goldbook:A00175))
AnnotationAssertion(rdfs:label goldbook:A00175 "aerometric measurement")
AnnotationAssertion(dcterms:description goldbook:A00175 "A measurement of the temperature, pressure, air motion (velocity vectors), or other physical measurement to characterize an air mass.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00175 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00175 "current"^^xsd:string)
Declaration(Class(goldbook:A00176))
AnnotationAssertion(rdfs:label goldbook:A00176 "aerosol")
AnnotationAssertion(dcterms:description goldbook:A00176 "Sol in which the dispersed phase is a solid, a liquid or a mixture of both and the continuous phase is a gas (usually air).")
AnnotationAssertion(rdfs:comment goldbook:A00176 "Owing to their size, the particles of the dispersed phase have a comparatively small settling velocity and hence exhibit some degree of stability in the earth's gravitational field."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:A00176 "An aerosol can be characterized by its chemical composition, its radioactivity (if any), the particle size distribution, the electrical charge and the optical properties."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:A00176 "Modified from previous definition, within which particles with equivalent diameters usually between \\(0.01\\) and \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\) are specified. This extends beyond the size range specified for a colloidal system. To avoid confusion the definition proposed here is recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:A00176 goldbook:S05727)
AnnotationAssertion(rdfs:seeAlso goldbook:A00176 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:A00176 goldbook:R05092)
AnnotationAssertion(rdfs:seeAlso goldbook:A00176 goldbook:S05631)
AnnotationAssertion(mito:isMentionedBy goldbook:A00176 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00176 "current"^^xsd:string)
Declaration(Class(goldbook:A00177))
AnnotationAssertion(rdfs:label goldbook:A00177 "affinity chromatography")
AnnotationAssertion(dcterms:description goldbook:A00177 "An expression characterizing the particular variant of chromatography in which the unique biological specificity of the analyte and ligand interaction is utilized for the separation.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00177 goldbook:C01075)
AnnotationAssertion(mito:isMentionedBy goldbook:A00177 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00177 "current"^^xsd:string)
Declaration(Class(goldbook:A00182))
AnnotationAssertion(rdfs:label goldbook:A00182 "agglomeration")
AnnotationAssertion(dcterms:description goldbook:A00182 "Process of contact and adhesion whereby dispersed particles are held together by weak physical interactions ultimately leading to phase separation by the formation of precipitates of larger than colloidal size.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00182 "coagulation")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00182 "flocculation")
AnnotationAssertion(rdfs:comment goldbook:A00182 "Agglomeration is a reversible process."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:A00182 "The definition proposed here is recommended for distinguishing agglomeration from aggregation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:A00182 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:A00182 goldbook:P04534)
AnnotationAssertion(mito:isMentionedBy goldbook:A00182 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00182 "current"^^xsd:string)
Declaration(Class(goldbook:A00183))
AnnotationAssertion(rdfs:label goldbook:A00183 "agglutination")
AnnotationAssertion(dcterms:description goldbook:A00183 "An immunochemical reaction leading to the aggregation of particulate matter such as bacteria, erythrocytes or other cells, or synthetic particles such as plastic beads coated with antigens or antibodies.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00183 goldbook:A00384)
AnnotationAssertion(rdfs:seeAlso goldbook:A00183 goldbook:A00394)
AnnotationAssertion(mito:isMentionedBy goldbook:A00183 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00183 "current"^^xsd:string)
Declaration(Class(goldbook:A00184))
AnnotationAssertion(rdfs:label goldbook:A00184 "aggregate")
AnnotationAssertion(dcterms:description goldbook:A00184 "Certain materials used as catalysts or supports consist of spheroids smaller than \\(10\\ \\rm{nm}\\) in diameter, cemented into larger entities. A primary particle should be defined as the smallest discrete identifiable entity and the method of identification should be mentioned (e.g. transmission electron microscopy, scanning electron microscopy). An assemblage of such primary particles exhibiting an identifiable collective behaviour (e.g. chemical nature of the aggregated primary particles, texture of the aggregate, resistance to mechanical separation upon grinding) constitutes an aggregate. When describing the aggregates the criterion of identification should be mentioned. Strongly bonded aggregates are called agglomerates.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00184 goldbook:E02002)
AnnotationAssertion(rdfs:seeAlso goldbook:A00184 goldbook:R05315)
AnnotationAssertion(rdfs:seeAlso goldbook:A00184 goldbook:T06477)
AnnotationAssertion(mito:isMentionedBy goldbook:A00184 doi:10.1351/pac199163091227)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00184 "current"^^xsd:string)
Declaration(Class(goldbook:A00185))
AnnotationAssertion(rdfs:label goldbook:A00185 "aglycon")
AnnotationAssertion(dcterms:description goldbook:A00185 "The non-sugar compound remaining after replacement of the glycosyl group from a glycoside by a hydrogen atom.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00185 "aglycone")
AnnotationAssertion(rdfs:seeAlso goldbook:A00185 goldbook:G02661)
AnnotationAssertion(rdfs:seeAlso goldbook:A00185 goldbook:G02665)
AnnotationAssertion(mito:isMentionedBy goldbook:A00185 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00185 "current"^^xsd:string)
Declaration(Class(goldbook:A00186))
AnnotationAssertion(rdfs:label goldbook:A00186 "agonist")
AnnotationAssertion(dcterms:description goldbook:A00186 "Substance which binds to cell receptors normally responding to naturally occurring substances and which produces a response of its own.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00186 goldbook:A00376)
AnnotationAssertion(mito:isMentionedBy goldbook:A00186 doi:10.1351/pac199365092003)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00186 "current"^^xsd:string)
Declaration(Class(goldbook:A00187))
AnnotationAssertion(rdfs:label goldbook:A00187 "agostic")
AnnotationAssertion(dcterms:description goldbook:A00187 "The term designates structures in which a hydrogen atom is bonded to both a carbon atom and a metal atom. The term is also used to characterize the interaction between a $\\ce{CH}$ bond and an unsaturated metal centre, and to describe similar bonding of a transition metal with $\\ce{Si–H}$ compounds. The expression '$\\mu$-hydrido-bridged' is also used to describe the bridging hydrogen.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00187 doi:10.1351/pac199466051077)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00187 "current"^^xsd:string)
Declaration(Class(goldbook:A00188))
AnnotationAssertion(rdfs:label goldbook:A00188 "agranular carbon")
AnnotationAssertion(dcterms:description goldbook:A00188 "A monogranular or monolithic carbon material with homogeneous microstructure which does not exhibit any structural components distinguishable by optical microscopy.")
AnnotationAssertion(rdfs:comment goldbook:A00188 "The above definition of a homogeneous microstructure does not pertain to pores and structural components which may be visible by contrast differences in optical microscopy with polarized light. As a consequence, glass-like carbon with visible pores is still an agranular carbon. The same is true, for instance, for pyrolytic carbon with preferred orientation, such as conical or lamellar structures, visible in optical microscopy with polarized light. Use of the term agranular carbon is not restricted to bulk materials of a minimum size. Only particulate carbon should be excluded even if the isolated particles exhibit a homogeneous microstructure."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:A00188 goldbook:C00841)
AnnotationAssertion(rdfs:seeAlso goldbook:A00188 goldbook:G02639)
AnnotationAssertion(rdfs:seeAlso goldbook:A00188 goldbook:P04433)
AnnotationAssertion(rdfs:seeAlso goldbook:A00188 goldbook:P04963)
AnnotationAssertion(rdfs:seeAlso goldbook:A00188 goldbook:VT07496)
AnnotationAssertion(mito:isMentionedBy goldbook:A00188 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00188 "current"^^xsd:string)
Declaration(Class(goldbook:A00190))
AnnotationAssertion(rdfs:label goldbook:A00190 "air contaminant")
AnnotationAssertion(dcterms:description goldbook:A00190 "A substance, gaseous material or aerosol, which is present in an air mass at levels greater than in clean air. An air contaminant has been added commonly by anthropogenic activity.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00190 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:A00190 goldbook:A00194)
AnnotationAssertion(mito:isMentionedBy goldbook:A00190 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00190 "current"^^xsd:string)
Declaration(Class(goldbook:A00191))
AnnotationAssertion(rdfs:label goldbook:A00191 "air-lift bioreactor")
AnnotationAssertion(dcterms:description goldbook:A00191 "A bioreactor in which the reaction medium is kept mixed and gassed by introduction of air or another gas (mixture) at the base of a column-like reactor equipped either with a draught tube or another device (e.g. external tube) by which the reactor volume is separated into a gassed and an ungassed region thus generating a vertically circulating flow.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00191 goldbook:B00662)
AnnotationAssertion(mito:isMentionedBy goldbook:A00191 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00191 "current"^^xsd:string)
Declaration(Class(goldbook:A00192))
AnnotationAssertion(rdfs:label goldbook:A00192 "air mass")
AnnotationAssertion(dcterms:description goldbook:A00192 "A qualitative term to describe a widespread body of air with approximately uniform characteristics which had been identified at a given time over a particular region of the earth's surface. Sometimes an air mass is marked by inert tracers such as $\\ce{SF6}$ which may be added to it. The composition of a given air mass undergoes alteration as it migrates, chemical changes occur, compounds are removed by dry and wet deposition and new impurities are added to the mass.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00192 goldbook:I03026)
AnnotationAssertion(mito:isMentionedBy goldbook:A00192 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00192 "current"^^xsd:string)
Declaration(Class(goldbook:A00193))
AnnotationAssertion(rdfs:label goldbook:A00193 "air monitoring station")
AnnotationAssertion(dcterms:description goldbook:A00193 "A site at which monitoring of the concentration of one or more pollutants is carried out (e.g. the BAPMoN stations, Background Air Pollution Monitoring Network of the WMO, World Meteorological Organization).")
AnnotationAssertion(rdfs:seeAlso goldbook:A00193 goldbook:A00195)
AnnotationAssertion(rdfs:seeAlso goldbook:A00193 goldbook:MT06831)
AnnotationAssertion(rdfs:seeAlso goldbook:A00193 goldbook:NT07562)
AnnotationAssertion(mito:isMentionedBy goldbook:A00193 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00193 "current"^^xsd:string)
Declaration(Class(goldbook:A00194))
AnnotationAssertion(rdfs:label goldbook:A00194 "air pollutant")
AnnotationAssertion(dcterms:description goldbook:A00194 "A substance, gaseous material or aerosol which has been introduced into the air (either by human activity or by natural processes) in sufficient concentration to produce a measurable effect on humans, animals, vegetation or materials (monuments, etc.): $\\ce{SO2}$, $\\ce{NO2}$, $\\ce{H2S}$, $\\ce{CO}$, hydrocarbons, etc.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00194 "pollutant")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00194 "pollution")
AnnotationAssertion(rdfs:seeAlso goldbook:A00194 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:A00194 goldbook:H02889)
AnnotationAssertion(mito:isMentionedBy goldbook:A00194 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00194 "current"^^xsd:string)
Declaration(Class(goldbook:A00195))
AnnotationAssertion(rdfs:label goldbook:A00195 "air pollution")
AnnotationAssertion(dcterms:description goldbook:A00195 "Usually the presence of substances in the atmosphere, resulting either from human activity or natural processes, present in sufficient concentration, for a sufficient time and under circumstances such as to interfere with comfort, health or welfare of persons or the environment.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00195 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00195 "current"^^xsd:string)
Declaration(Class(goldbook:A00196))
AnnotationAssertion(rdfs:label goldbook:A00196 "air pollution index")
AnnotationAssertion(dcterms:description goldbook:A00196 "A mathematical combination of the concentrations of air pollutants (weighted in some fashion to reflect the estimated health impact of the specific pollutant) which gives an approximate numerical measure of the quality of the air at a given time. These indices have little scientific basis but have been used to inform the public (in a qualitative fashion) of the degree of pollution present at a given time. It is recommended that the actual measured pollutant concentrations be used by all information services when possible with simultaneous reference given to the corresponding concentrations which are considered by health authorities to be hazardous to human health.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00196 "air quality index")
AnnotationAssertion(mito:isMentionedBy goldbook:A00196 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00196 "current"^^xsd:string)
Declaration(Class(goldbook:A00197))
AnnotationAssertion(rdfs:label goldbook:A00197 "air pollution survey")
AnnotationAssertion(dcterms:description goldbook:A00197 "A study of the concentrations and geographical distribution of specified air pollutants in a given area and an assessment of the damage, if any, which the pollutants have caused.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00197 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00197 "current"^^xsd:string)
Declaration(Class(goldbook:A00198))
AnnotationAssertion(rdfs:label goldbook:A00198 "air quality characteristic")
AnnotationAssertion(dcterms:description goldbook:A00198 "One of the quantifiable properties relating to an air sample: concentration of a constituent, wind speed, temperature, etc. The quantity of air quality characteristic is the true value of the characteristic being investigated; it is recognized that in practice, this value can only be approximated by existing methods.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00198 goldbook:C01281)
AnnotationAssertion(mito:isMentionedBy goldbook:A00198 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00198 "current"^^xsd:string)
Declaration(Class(goldbook:A00199))
AnnotationAssertion(rdfs:label goldbook:A00199 "air resource management")
AnnotationAssertion(dcterms:description goldbook:A00199 "The detailed planning and the implementation of air pollution control programs designed to preserve the health and welfare of the people in the region, the plant and animal life, physical property, good visibility and other factors which determine the air quality and the maintenance of an aesthetically acceptable environment.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00199 goldbook:A00195)
AnnotationAssertion(mito:isMentionedBy goldbook:A00199 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00199 "current"^^xsd:string)
Declaration(Class(goldbook:A00200))
AnnotationAssertion(rdfs:label goldbook:A00200 "air sampling network")
AnnotationAssertion(dcterms:description goldbook:A00200 "A number of air sampling stations which are established in a given geographical region at which measurements of both pollutant concentrations and meteorological quantities (wind speed, direction, rain fall, humidity, etc.) are made to determine the extent and the nature of the air pollution and to establish trends in the concentrations of the air pollutants with time.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00200 goldbook:A00195)
AnnotationAssertion(mito:isMentionedBy goldbook:A00200 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00200 "current"^^xsd:string)
Declaration(Class(goldbook:A00201))
AnnotationAssertion(rdfs:label goldbook:A00201 "Aitken particles")
AnnotationAssertion(dcterms:description goldbook:A00201 "Aerosol particles below \\(0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter. These generally are the most numerous among all particles in the air. Their concentrations can be determined with the Aitken counter which measures total particle number density. Owing to their small size, Aitken particles contribute little to the total mass concentration of all aerosol particles; this is determined primarily by particles of diameter \\(> 0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:A00201 goldbook:A00176)
AnnotationAssertion(rdfs:seeAlso goldbook:A00201 goldbook:N04262)
AnnotationAssertion(mito:isMentionedBy goldbook:A00201 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00201 "current"^^xsd:string)
Declaration(Class(goldbook:A00202))
AnnotationAssertion(rdfs:label goldbook:A00202 "albedo")
AnnotationAssertion(dcterms:description goldbook:A00202 "The fraction of the energy of electromagnetic radiation reflected from a body (or surface) relative to the energy incident upon it. The reflection of light from a surface is, of course, dependent on the wavelength of the light, the nature of the surface and its angle of incidence with the surface. The term albedo usually connotes a broad wavelength band (visible, ultraviolet or infrared), whereas the terms reflectivity and spectral albedo are used to describe the reflection of monochromatic (single wavelength or small band of wavelengths) radiation.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00202 goldbook:A00346)
AnnotationAssertion(rdfs:seeAlso goldbook:A00202 goldbook:IT07399)
AnnotationAssertion(rdfs:seeAlso goldbook:A00202 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:A00202 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00202 "current"^^xsd:string)
Declaration(Class(goldbook:A00203))
AnnotationAssertion(rdfs:label goldbook:A00203 "alcoholates")
AnnotationAssertion(dcterms:description goldbook:A00203 "Synonymous with alkoxides. Alcoholate should not be used for solvates derived from an alcohol such as $\\ce{CaCl2.nROH}$, for the ending -ate often occurs in names for anions.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00203 goldbook:A00204)
AnnotationAssertion(rdfs:seeAlso goldbook:A00203 goldbook:A00225)
AnnotationAssertion(mito:isMentionedBy goldbook:A00203 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00203 "current"^^xsd:string)
Declaration(Class(goldbook:A00204))
AnnotationAssertion(rdfs:label goldbook:A00204 "alcohols")
AnnotationAssertion(dcterms:description goldbook:A00204 "Compounds in which a hydroxy group, $\\ce{-OH}$, is attached to a saturated carbon atom $\\ce{R3COH}$. The term 'hydroxyl' refers to the radical species, $\\ce{HO^{.}}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00204 goldbook:E02124)
AnnotationAssertion(rdfs:seeAlso goldbook:A00204 goldbook:P04539)
AnnotationAssertion(mito:isMentionedBy goldbook:A00204 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00204 "current"^^xsd:string)
Declaration(Class(goldbook:A00206))
AnnotationAssertion(rdfs:label goldbook:A00206 "aldaric acids")
AnnotationAssertion(dcterms:description goldbook:A00206 "Polyhydroxy dicarboxylic acids having the general formula $\\ce{HOC(=O)[CH(OH)]_{n}C(=O)OH}$, formally derived from an aldose by oxidation of both terminal carbon atoms to carboxyl groups.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00206 goldbook:A00213)
AnnotationAssertion(rdfs:seeAlso goldbook:A00206 goldbook:O04362)
AnnotationAssertion(mito:isMentionedBy goldbook:A00206 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00206 "current"^^xsd:string)
Declaration(Class(goldbook:A00207))
AnnotationAssertion(rdfs:label goldbook:A00207 "aldazines")
AnnotationAssertion(dcterms:description goldbook:A00207 "Azines of aldehydes $\\ce{RCH=NN=CHR}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00207 goldbook:A00557)
AnnotationAssertion(rdfs:seeAlso goldbook:A00207 goldbook:A00208)
AnnotationAssertion(mito:isMentionedBy goldbook:A00207 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00207 "current"^^xsd:string)
Declaration(Class(goldbook:A00208))
AnnotationAssertion(rdfs:label goldbook:A00208 "aldehydes")
AnnotationAssertion(dcterms:description goldbook:A00208 "Compounds $\\ce{RC(=O)H}$, in which a carbonyl group is bonded to one hydrogen atom and to one $\\ce{R}$ group.")
AnnotationAssertion(mito:isMentionedBy goldbook:A00208 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00208 "current"^^xsd:string)
Declaration(Class(goldbook:A00209))
AnnotationAssertion(rdfs:label goldbook:A00209 "aldimines")
AnnotationAssertion(dcterms:description goldbook:A00209 "Imines derived from aldehydes $\\ce{RCH=NR}$. E.g. $\\ce{EtCH=NH}$, $\\ce{PhCH=NMe}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00209 goldbook:I02957)
AnnotationAssertion(rdfs:seeAlso goldbook:A00209 goldbook:A00208)
AnnotationAssertion(mito:isMentionedBy goldbook:A00209 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00209 "current"^^xsd:string)
Declaration(Class(goldbook:A00210))
AnnotationAssertion(rdfs:label goldbook:A00210 "alditols")
AnnotationAssertion(dcterms:description goldbook:A00210 "Acyclic polyols having the general formula $\\ce{HOCH2[CH(OH)]nCH2OH}$ (formally derivable from an aldose by reduction of the carbonyl group).")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00210 "glycitols")
AnnotationAssertion(rdfs:seeAlso goldbook:A00210 goldbook:A00213)
AnnotationAssertion(mito:isMentionedBy goldbook:A00210 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00210 "current"^^xsd:string)
Declaration(Class(goldbook:A00211))
AnnotationAssertion(rdfs:label goldbook:A00211 "aldoketoses")
AnnotationAssertion(dcterms:description goldbook:A00211 "A now less preferred synonym for ketoaldoses.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00211 goldbook:K03384)
AnnotationAssertion(mito:isMentionedBy goldbook:A00211 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00211 "current"^^xsd:string)
Declaration(Class(goldbook:A00212))
AnnotationAssertion(rdfs:label goldbook:A00212 "aldonic acids")
AnnotationAssertion(dcterms:description goldbook:A00212 "Polyhydroxy acids having the general formula $\\ce{HOCH2[CH(OH)]_{n}C(=O)OH}$ and therefore derived from an aldose by oxidation of the aldehyde function, e.g. ᴅ-gluconic acid.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:A00212 "glyconic acids")
AnnotationAssertion(rdfs:seeAlso goldbook:A00212 goldbook:A00208)
AnnotationAssertion(rdfs:seeAlso goldbook:A00212 goldbook:A00213)
AnnotationAssertion(rdfs:seeAlso goldbook:A00212 goldbook:O04362)
AnnotationAssertion(mito:isMentionedBy goldbook:A00212 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00212 "current"^^xsd:string)
Declaration(Class(goldbook:A00213))
AnnotationAssertion(rdfs:label goldbook:A00213 "aldoses")
AnnotationAssertion(dcterms:description goldbook:A00213 "Aldehydic parent sugars (polyhydroxyaldehydes $\\ce{H[CH(OH)]_{n}C(=O)H}$, $n \\ge 2$) and their intramolecular hemiacetals.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00213 goldbook:H02774)
AnnotationAssertion(rdfs:seeAlso goldbook:A00213 goldbook:I03130)
AnnotationAssertion(rdfs:seeAlso goldbook:A00213 goldbook:M04021)
AnnotationAssertion(rdfs:seeAlso goldbook:A00213 goldbook:S06088)
AnnotationAssertion(mito:isMentionedBy goldbook:A00213 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:A00213 "current"^^xsd:string)
Declaration(Class(goldbook:A00214))
AnnotationAssertion(rdfs:label goldbook:A00214 "aldoximes")
AnnotationAssertion(dcterms:description goldbook:A00214 "Oximes of aldehydes $\\ce{RCH=NOH}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:A00214 goldbook:O04372)
AnnotationAssertion(rdfs:seeAlso goldbook:A00214 goldbook:A00208)
AnnotationAssertion(mito:isMentionedBy goldbook:A00214 doi:10.1351/pac199567081307)
