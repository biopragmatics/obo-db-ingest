AnnotationAssertion(obo:goldbook#hasStatus goldbook:13184 "current"^^xsd:string)
Declaration(Class(goldbook:13185))
AnnotationAssertion(rdfs:label goldbook:13185 "granuloma")
AnnotationAssertion(dcterms:description goldbook:13185 "Mass or nodule of granulation tissue, with actively growing fibroblasts and capillary buds, characterized by the presence of aggregates of modified macrophages resembling epithelial cells (epithelioid histiocytes), and lymphocytes, surrounded by a rim of giant multinucleate cells, either of the Langerhans or foreign body type.")
AnnotationAssertion(rdfs:comment goldbook:13185 "Granuloma is due to a chronic inflammatory process associated with infectious disease, such as tuberculosis, syphilis, sarcoidosis, leprosy, lymphogranuloma, etc., or with invasion by a foreign body."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13185 goldbook:13373)
AnnotationAssertion(rdfs:seeAlso goldbook:13185 goldbook:13399)
AnnotationAssertion(rdfs:seeAlso goldbook:13185 goldbook:13424)
