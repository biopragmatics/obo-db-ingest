Declaration(Class(goldbook:13423))
AnnotationAssertion(rdfs:label goldbook:13423 "macroautophagy")
AnnotationAssertion(dcterms:description goldbook:13423 "Sequestration and breakdown of organelles and long-lived proteins in a double-membrane vesicle, called an autophagosome or autophagic vacuole, inside the cell.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:13423 "non-specific autophagy")
AnnotationAssertion(rdfs:comment goldbook:13423 "The outer membrane of the autophagosome fuses in the cytoplasm with a lysosome to form an autolysosome or autophagolysosome where their contents are degraded by acidic lysosomal hydrolases."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13423 "Macroautophagy is the major inducible pathway for the general turnover of cytoplasmic constituents in eukaryotic cells. It is also responsible for the degradation of active cytoplasmic enzymes and organelles during nutrient starvation."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13423 goldbook:13563)
AnnotationAssertion(rdfs:seeAlso goldbook:13423 goldbook:12929)
AnnotationAssertion(rdfs:seeAlso goldbook:13423 goldbook:13422)
AnnotationAssertion(mito:isMentionedBy goldbook:13423 doi:10.1351/PAC-REC-11-06-03)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:13423 "current"^^xsd:string)
Declaration(Class(goldbook:13424))
