    <owl:Class rdf:about="http://dx.doi.org/10.1351/goldbook.10760">
        <goldbook1:hasStatus>current</goldbook1:hasStatus>
        <dcterms:description>Capable of causing a change to the structure of the genome.</dcterms:description>
        <mito:isMentionedBy rdf:resource="http://dx.doi.org/10.1515/pac-2015-1202"/>
        <rdfs:label>genotoxic</rdfs:label>
    </owl:Class>
    


