goldbook:15275 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing carbonate linkages in the backbone: \\[\\ce{-O-CO-O\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycarbonate" .

goldbook:15276 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing carbon-silicon linkages in the backbone: \\[\\ce{-SiR^{1}R^{2}\\bond{-}CR^{3}R^{4}\\bond{-}}\\] where \\(\\ce{R^1}\\), \\(\\ce{R^2}\\), \\(\\ce{R^3}\\), and \\(\\ce{R^4}\\) are each hydrogen, alkyl, aryl, or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycarbosilane" .

goldbook:15277 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing 1,3,5-triazine-2,4,6-triyltrioxy constitutional units (formerly cyanurate groups) in the backbone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycyanurate" .

goldbook:15278 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing carboxylic ester linkages in the backbone: \\[\\ce{-O-CO\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyester" .

goldbook:15279 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing ether linkages in the backbone: \\[\\ce{-O\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyether" .

goldbook:15280 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively germanium atoms in the backbone: \\[\\ce{-[-GeR2\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{R}\\) is alkyl, aryl or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polygermane" .

goldbook:15281 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing glutarimide rings in the backbone:   where \\(\\ce{R}\\) is hydrogen or alkyl (usually methyl) and \\(\\ce{R^1}\\) is hydrogen, or an alkyl, aryl, or heteroaryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyglutarimide" .

goldbook:15282 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing hydantoin (imidazolidine-2,4-dione) rings in the backbone:   where \\(\\ce{R}\\) is hydrogen, or an alkyl, aryl, or heteroaryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyhydantoin" .

goldbook:15283 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing hydrazide linkages in the backbone: \\[\\ce{-CO-NR^1\\bond{-}NR^2\\bond{-}CO\\bond{-}}\\] where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each hydrogen, alkyl, aryl, or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyhydrazide" .

goldbook:15284 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing imidazole rings in the backbone:   where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each hydrogen, or an alkyl or aryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyimidazole" .

goldbook:15285 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing 2,4,6-trioxo-1,3,5-triazinane-1,3,5-triyl (formerly isocyanurate) rings in the backbone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyisocyanurate" .

goldbook:15286 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing keto groups as linkages in the backbone: \\[\\ce{-CO\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyketone" .

goldbook:15287 a skos:Concept ;
    skos:definition "Organometallic polymer composed of macromolecules containing exclusively alternating metal and oxygen atoms in the main chain: \\[\\ce{-ML_{x}-O\\bond{-}}\\] where \\(\\ce{M}\\) is a metal atom such as \\(\\ce{Al}\\), \\(\\ce{Ge}\\), \\(\\ce{Sn}\\), or \\(\\ce{Ti}\\), and \\(\\ce{L}\\) is a metal-bonded substituent (ligand)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymetaloxane" .

goldbook:15288 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively oxyalkane-α,ω-diyl (formerly oxyalkylene) constitutional repeating units in the backbone: \\[\\ce{-[-O-Y\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{Y}\\) is an alkane-α,ω-diyl (formerly alkylene) or substituted alkane-α,ω-diyl group contributing at least two carbon atoms to the main chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyoxyalkylene" .

goldbook:15289 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively oxyarenediyl (formerly oxyarylene) constitutional repeating units in the backbone: \\[\\ce{-[-O-Ar\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{Ar}\\) is an arenediyl (formerly arylene), heteroarenediyl (formerly heteroarylene), substituted arenediyl or substituted heteroarenediyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyoxyarylene" .

goldbook:15290 a skos:Concept ;
    skos:altLabel "polyacetal",
        "polyketal" ;
    skos:definition "Polymer composed of macromolecules containing exclusively oxymethylene or substituted oxymethylene constitutional repeating units in the backbone:   where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each hydrogen, alkyl, aryl, or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyoxymethylene" .

goldbook:15291 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively oxyphenylene or ring-substituted oxyphenylene constitutional repeating units in the backbone:   where \\(\\ce{R^1}\\), \\(\\ce{R^2}\\), \\(\\ce{R^3}\\), and \\(\\ce{R^4}\\) are each hydrogen or an alkyl, aryl, or aralkyl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyoxyphenylene" .

goldbook:15292 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing imidazolidine-2,4,5-trione (parabanic acid) rings in the backbone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyparabanic acid" .

goldbook:15293 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively alternating phenylene or substituted phenylene and methylene or substituted methylene constitutional units in the backbone:   where \\(\\ce{R^1}\\), \\(\\ce{R^2}\\), \\(\\ce{R^3}\\), \\(\\ce{R^4}\\), \\(\\ce{R^5}\\), and \\(\\ce{R^6}\\) are each hydrogen, alkyl, aryl, halogen, trialkylsilyl, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyphenylenemethylene" .

goldbook:15294 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing phosphate constitutional repeating units:   where \\(\\ce{R}\\) is hydrogen, alkyl, aryl, or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyphosphate" .

goldbook:15295 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively nitrilophosphanylylidene (formerly phosphazene) constitutional repeating units in the backbone:   where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each a monovalent group, such as a halogen or an alkoxy group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyphosphazene" .

goldbook:15296 a skos:Concept ;
    skos:altLabel "polybenzimidazolimides",
        "polybenzimidazolones",
        "polybenzimidazopyrrolones",
        "polyimidazopyrrolones",
        "polyisoindolobenzimidazole",
        "polyisoindolobenzimidazoles" ;
    skos:definition "Polymer composed of single strand or ladder macromolecules comprising isoindolo[2,1-a]benzimidazole (formerly pyrrone) constitutional repeating units such as:  where \\(\\ce{Z}\\) is a divalent linking group or atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polypyrrone" .

goldbook:15297 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing quinoline moieties in the backbone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyquinoline" .

goldbook:15298 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing quinoxaline groups in the backbone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyquinoxaline" .

goldbook:15299 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively alternating nitrogen and silicon atoms in the backbone: \\[\\ce{-[-NR^{1}\\bond{-}SiR^{2}\\!\\,R^{3}\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{R^1}\\), \\(\\ce{R^2}\\), and \\(\\ce{R^3}\\) are each hydrogen or an alkyl or aryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysilazane" .

goldbook:15300 a skos:Concept ;
    skos:altLabel "polyoxysilylenes",
        "silicones" ;
    skos:definition "Polymer composed of macromolecules containing alternating oxygen and silicon atoms in the backbone: \\[\\ce{-[-O\\bond{-}SiR^{1}\\!\\,R^{2}\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each hydrogen or an alkyl or aryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysiloxane" .

goldbook:15301 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing silicon and oxygen atoms in the ratio \\(1{:}1.5\\) (ideal ratio for infinite macromolecule), which alternate in a hyperbranched or ladder structure such as:   where \\(\\ce{R}\\) is alkyl, aryl, or heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysilsesquioxane" .

goldbook:15302 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing exclusively tin atoms in the backbone: \\[\\ce{-[-SnR^{1}\\!\\,R^{2}\\bond{-}]_{n}\\bond{-}}\\] where \\(\\ce{R^1}\\) and \\(\\ce{R^2}\\) are each hydrogen or an alkyl or aryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polystannane" .

goldbook:15303 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing sulfonamide linkages in the backbone: \\[\\ce{-SO2-NR\\bond{-}}\\] where \\(\\ce{R}\\) is hydrogen or an alkyl, aryl, or heteroaryl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysulfonamide" .

goldbook:15304 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing sulfonyl linkages in the backbone: \\[\\ce{-SO2\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysulfone" .

goldbook:15305 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing thiocarboxylate (thioester) linkages in the backbone:\\(\\ce{-S-CO\\bond{-}}\\) or \\(\\ce{-O-CS\\bond{-}}\\) or \\(\\ce{-S-CS\\bond{-}}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polythioester" .

goldbook:15306 a skos:Concept ;
    skos:definition "Polymers composed of macromolecules containing thioether (sulfide) linkages in the backbone: \\[\\ce{-S\\bond{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polythioether" .

goldbook:15307 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules containing triazine rings in the backbone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polytriazine" .

goldbook:15308 a skos:Concept ;
    skos:altLabel "polyureylene" ;
    skos:definition "Polymer composed of macromolecules containing ureylene or N-substituted ureylene linkages in the backbone: \\[\\ce{-NR-CO-NR\\bond{-}}\\] where \\(\\ce{R}\\) is hydrogen, alkyl, aryl, heteroaryl, substituted alkyl, substituted aryl, or substituted heteroaryl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyurea" .

goldbook:15309 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules consisting of a single-strand main chain and many ring units, each having one atom in common with the main chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardo polymer" .

goldbook:15310 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules consisting of physically catenated macrorings that have no atom in common and cannot be separated unless chemical bonds are broken." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catenane polymer" .

goldbook:15311 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules that adopt partly or completely a helical conformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helical polymer" .

goldbook:15312 a skos:Concept ;
    skos:definition "For a substance \\(\\ce{B}\\), activity coefficient \\(f_{\\ce{B}}\\) extrapolated to infinite dilution: \\[\\ln (f_{\\ce{B}}^{\\infty}) = \\lim \\limits_{x_{\\ce{B}} \\to 0} (\\frac{\\mu_{\\ce{B}} - \\mu_{\\ce{B}}^{\\ast}}{RT} - \\ln x_{\\ce{B}})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activity coefficient at infinite dilution" .

goldbook:15313 a skos:Concept ;
    skos:definition "Class of experimental procedures for solubility determination in which a saturated solution is prepared and then analyzed to determine composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical method" .

goldbook:15314 a skos:Concept ;
    skos:altLabel "solvomolality" ;
    skos:definition "For a solute \\(\\ce{B}\\) in a system containing solvent \\(\\ce{A}\\) and a reference solvent \\(\\ce{C}\\), \\[m_{\\ce{B}}^{(\\ce{C})} = m_{\\ce{B}} \\overline M/M_{\\ce{C}}\\] where \\(m_{\\ce{B}}\\) is the molality of \\(\\ce{B}\\), \\(M_{\\ce{C}}\\) is the molar mass of a reference component, and \\(\\overline{M}\\) is the average molar mass of a mixed solvent, defined for a system containing two solvents as \\[\\overline M = x_{ u,\\ce{A}} M_{\\ce{A}} + (1 - x_{ u,\\ce{A}}) M_{\\ce{C}}\\] the solvent amount fraction of solvent \\(\\ce{A}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aquamolality" .

goldbook:15315 a skos:Concept ;
    skos:altLabel "azeotrope" ;
    skos:definition "For a mixture, temperature and pressure (the azeotropic temperature and pressure) at which the compositions of the liquid and vapor phases become equal (the azeotropic composition), but the intensive properties of the two phases (such as molar volume) are different." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azeotropic point" .

goldbook:15316 a skos:Concept ;
    skos:definition "System containing two components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binary system" .

goldbook:15317 a skos:Concept ;
    skos:definition "Volume \\(V^{\\rm{g}}\\) of an amount \\(n_{\\ce{B}}^{\\rm{l}}\\) of a gas dissolved at a given standard temperature \\(T^{^⦵\\!}\\) (usually \\(\\pu{273.15 K}\\)) and given standard (partial) pressure \\(p_{\\ce{B}}^{_{^⦵\\!}}\\) (\\(\\pu{1 bar} = \\pu{0.1 MPa}\\) or, in older literature, \\(\\pu{1 atm}\\)) divided by the volume of the solvent \\(V^{\\rm{l}}\\) containing an amount \\(n_{\\ce{A}}\\) of solvent at temperature \\(T\\) and the given total pressure \\(p^{_{^⦵\\!}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bunsen coefficient" .

goldbook:15318 a skos:Concept ;
    skos:definition "Semi-empirical equation describing the temperature dependence of the standard Gibbs energy of solution, \\[\\Delta_{\\rm{sln}}G^{^⦵\\!}(T, p^{_{^⦵\\!}})/RT = A_{0} + A_{1}(T_{\\rm{ref}}/T) + A_{2}\\ln(T/T_{\\rm{ref}}) + A_{3}(T/T_{\\rm{ref}}) + A_{4}(T/T_{\\rm{ref}})^{2} + \\ldots\\] where the \\(A_{i}\\) are constants that can be related to thermodynamic quantities (but subject to uncertainty because of statistical correlations among the fitting coefficients) and \\(T_{\\rm{ref}}\\) is a reference temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Clarke–Glew equation" .

goldbook:15319 a skos:Concept ;
    skos:definition "Clarke–Glew equation with \\(T_{\\rm{ref}} = \\pu{100 K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Clarke–Glew–Weiss equation" .

goldbook:15320 a skos:Concept ;
    skos:altLabel "binodal curve",
        "conodal curve" ;
    skos:definition "Boundary of stable phase separation (limits of solubility) in a liquid or solid system of two or more components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coexistence curve" .

goldbook:15321 a skos:Concept ;
    skos:definition "Two phases of variable composition in mutual thermodynamic equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugate phases" .

goldbook:15322 a skos:Concept ;
    skos:definition "Index in the basic equation describing a coexistence curve \\[\\beta = \\lim \\limits_{T \\to T_{\\rm{c}}} \\left(\\frac{\\partial \\ln (x'' - x')}{\\partial \\ln \\vert T - T_{\\rm{c}}\\vert} \\right)\\] where \\(x''\\), \\(x'\\) are the mole fractions of one component in the respective concentrated and dilute phases and \\(T_{\\rm{c}}\\) is the critical solution temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical index" .

goldbook:15323 a skos:Concept ;
    skos:definition "Experimental results, often numerical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "data" .

goldbook:15324 a skos:Concept ;
    skos:altLabel "congruent melting",
        "indifferent melting" ;
    skos:definition "Isobaric, reversible melting or dissolution with either complete or partial dissociation on heating of a solid compound, \\(\\ce{A_{\\rm{a}}B_{\\rm{b}}}\\), formed by components \\(\\ce{A}\\) and \\(\\ce{B}\\) \\[\\ce{A_{\\rm{a}}B_{\\rm{b}}(s)  A_{\\rm{a}}B_{\\rm{b}}(l)  {\\rm{a}}A(l) + {\\rm{b}}B(l)}\\] where the forward arrows indicate the direction of heating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dystectic reaction" .

goldbook:15325 a skos:Concept ;
    skos:definition "Reversible dissolution in an isothermal, isobaric system of three or more components characterized by dissolution and saturation with a stoichiometric compound consisting of two or more of these components. The equilibrium process is, for example, \\[\\ce{AB.p H2O  A(aq, sat) + B(aq, sat) + p H2O(l)}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dystonic reaction" .

goldbook:15326 a skos:Concept ;
    skos:definition "Isothermal reversible reaction of a solid mixture phase \\(\\upgamma\\) which is transformed into two (or more) different solid (pure, binary compound or mixture) phases \\(\\upalpha\\) and \\(\\upbeta\\) during the cooling of a system. In a binary system, \\[\\ce{\\upgamma  \\upalpha + \\upbeta}\\] where the forward arrow indicates the direction of cooling. The equilibrium reaction occurs along the eutectoid line at the eutectoid temperature. At the eutectoid composition, the compositions of the high temperature solid phase and the mechanical mixture of the low-temperature solid phases are equal, and intermediate to the compositions of the pure solid phases \\(\\upalpha\\) and \\(\\upbeta\\). This composition and the eutectoid temperature, which are isobaric invariants of the system, define the eutectoid point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutectoid reaction" .

goldbook:15327 a skos:Concept ;
    skos:altLabel "(isothermally and isobarically invariant) reaction of double saturation",
        "isothermally invariant reaction" ;
    skos:definition "Reversible dissolution in a system of three or more components characterized by the composition of a solution that is simultaneously saturated with respect to all (at least two or more) dissolved solutes. The two simultaneous equilibrium processes are, for example, \\[\\begin{array}{l}\\ce{A.p H2O  A{(aq, sat)} + p H2O(l)} \\\\ \\ce{B.q H2O  B{(aq, sat)} + q H2O(l)}\\end{array}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutonic reaction" .

goldbook:15328 a skos:Concept ;
    skos:altLabel "smoothing equation" ;
    skos:definition "Theoretically based or empirical equation for interpolation of data over a range of temperature, pressure, composition, or other variable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fitting equation" .

goldbook:15329 a skos:Concept ;
    skos:definition "Equation relating the intensive variables \\(T\\), \\(p\\) and the \\(C\\) chemical potentials \\(\\mu_{i}\\) in a phase \\[S{\\rm{d}}T - V{\\rm{d}}p + \\sum \\limits_{i=1}^{C} n_{i} {\\rm{d}}\\mu_{i} = 0\\] where \\(C\\) is the total number of components, \\(i\\) in a phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs–Duhem equation" .

goldbook:15330 a skos:Concept ;
    skos:definition "Change in Gibbs energy at a given temperature and pressure for transfer of a substance between two different phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs energy of transfer" .

goldbook:15331 a skos:Concept ;
    skos:altLabel "Gibbs–Konovalow equations",
        "van der Waals’ equations" ;
    skos:definition "Pair of equations for a binary mixture of components \\(\\ce{A}\\) and \\(\\ce{B}\\) that relate the variables \\(T\\), \\(p\\), in one phase of variable composition, \\(\\upalpha\\), to the variables \\(T\\), \\(p\\), in a coexisting equilibrium phase of variable composition, \\(\\upbeta\\): \\[\\begin{array}{c} -\\frac{\\left(1 - x_{\\ce{B}}^{\\beta} \\right)\\Delta_{\\alpha}^{\\beta} H_{\\ce{A}} + x_{\\ce{B}}^{\\beta} \\Delta_{\\alpha}^{\\beta} H_{\\ce{B}}}{T}{\\rm{d}}T + \\left[\\left(1 - x_{\\ce{B}}^{\\beta} \\right)\\Delta_{\\alpha}^{\\beta}V_{\\ce{A}} + x_{\\ce{B}}^{\\beta}\\Delta_{\\alpha}^{\\beta}V_{\\ce{B}} \\right]{\\rm{d}}p +\\left(x_{\\ce{B}}^{\\alpha} - x_{\\ce{B}}^{\\beta} \\right)\\left(\\frac{\\partial^{2} G_{\\rm{m}}^{\\alpha}}{\\partial x_{\\ce{B}}^{\\alpha 2}} \\right)_{T,p} {\\rm{d}}x_{\\ce{B}}^{\\alpha} = 0 \\\\ -\\frac{\\left(1 - x_{\\ce{B}}^{\\alpha} \\right)\\Delta_{\\alpha}^{\\beta} H_{\\ce{A}} + x_{\\ce{B}}^{\\alpha} \\Delta_{\\alpha}^{\\beta} H_{\\rm{B}}}{T}{\\rm{d}}T + \\left[\\left(1 - x_{\\ce{B}}^{\\alpha} \\right)\\Delta_{\\alpha}^{\\beta}V_{\\ce{A}} + x_{\\ce{B}}^{\\alpha}\\Delta_{\\alpha}^{\\beta}V_{\\ce{B}} \\right]{\\rm{d}}p +\\left(x_{\\ce{B}}^{\\alpha} - x_{\\ce{B}}^{\\beta} \\right)\\left(\\frac{\\partial^{2} G_{\\rm{m}}^{\\alpha}}{\\partial x_{\\ce{B}}^{\\beta 2}} \\right)_{T,p} {\\rm{d}}x_{\\ce{B}}^{\\beta} = 0 \\end{array}\\] where \\(\\Delta_{\\upalpha}^{\\upbeta} H_{\\ce{A}} = H_{\\ce{A}}^{\\upbeta} - H_{\\ce{A}}^{\\upalpha}\\), \\(\\Delta_{\\upalpha}^{\\upbeta} V_{\\ce{A}} = V_{\\ce{A}}^{\\upbeta} - V_{\\ce{A}}^{\\upalpha}\\) are the enthalpy and volume of transfer of component \\(\\ce{A}\\) from phase \\(\\upalpha\\) to phase \\(\\upbeta\\), and similarly for component \\(\\ce{B}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs–Konovalov equations" .

goldbook:15332 a skos:Concept ;
    skos:altLabel "multicomponent system" ;
    skos:definition "System containing more than three components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "higher-order system" .

goldbook:15333 a skos:Concept ;
    skos:definition "Limiting composition or other variable in a solution obtained by extrapolating to a value of zero for the variable describing the composition of the solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infinite dilution" .

goldbook:15334 a skos:Concept ;
    skos:altLabel "miscibility in all proportions" ;
    skos:definition "Property of a system of forming a single phase at all relative proportions of its components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infinite miscibility" .

goldbook:15335 a skos:Concept ;
    skos:altLabel "ionic amount fraction",
        "species amount fraction",
        "species mole fraction" ;
    skos:definition "For an ionized salt \\(\\ce{B}\\) in solution, \\[x_{+\\rm{B}} = \\frac{ u_{+\\ce{B}}x_{\\ce{B}}}{1 + \\sum \\limits_{i=1}^{s} \\left( u_{i} - 1 \\right)x_{i}},x_{-\\ce{B}} = \\frac{ u_{-\\ce{B}}x_{+\\ce{B}}}{ u_{+\\ce{B}}}\\] where the summation is over all $s$ solute components \\(i\\) and \\( u_{i} =  u_{+i} +  u_{-i}\\) is the sum of the stoichiometric numbers of the ions formed from salt \\(i\\). For a single solvent \\(\\ce{A}\\) in an ionic solution, \\[x'_{\\ce{A}} = \\frac{x_{\\ce{A}}}{1 + \\sum \\limits_{i=1}^{s} \\left( u_{i} - 1 \\right)x_{i}}\\] Note 1: These are generalizations of terms and are used in formulating fitting equations for solubility of salts, in defining activity coefficients on the mole fraction scale, and in discussing salt effects on solubilities of gases.Note 2: Note that \\[\\sum \\limits_{i=1}^{s} \\left(x_{+i} - x_{-i} \\right) + x'_{\\ce{A}} = 1\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic mole fraction" .

goldbook:15336 a skos:Concept ;
    skos:definition "Line joining points of equal composition on a phase diagram." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isopleth" .

goldbook:15337 a skos:Concept ;
    skos:definition "Mass of one constituent \\(\\ce{A}\\) divided by the mass of a second constituent \\(\\ce{B}\\) in the same system. \\[\\zeta_{\\ce{A,B}} = m_{\\ce{A}}/m_{\\ce{B}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass ratio" .

goldbook:15338 a skos:Concept ;
    skos:definition "Obsolete term for molality of a saturated solution of a gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass solubility" .

goldbook:15339 a skos:Concept ;
    skos:altLabel "catatectic reaction" ;
    skos:definition "Isothermal reversible reaction of a solid mixture phase \\(\\upbeta\\) which is transformed into a different solid phase \\(\\upalpha\\) plus a liquid phase \\(\\ce{l}\\) during cooling of a system. For a binary system, \\[\\ce{\\upbeta  \\upalpha + 1}\\] where the forward arrow indicates the direction of cooling. The equilibrium transformation occurs along the metatectic line characterized by the metatectic temperature. The metatectic composition and temperature, isobaric invariants of the system, define the metatectic point, which lies between the compositions of liquid \\(\\ce{l}\\) and solid phase \\(\\upalpha\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metatectic reaction" .

goldbook:15340 a skos:Concept ;
    skos:definition "Deprecated term that includes both a quantity and a unit. Replace by mole fraction expressed as percent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mole percent" .

goldbook:15341 a skos:Concept ;
    skos:altLabel "amount ratio" ;
    skos:definition "Amount of one constituent divided by the amount of a second constituent in the same system. For constituents 1 and 2, \\[r_{12} = n_{1}/n_{2}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mole ratio" .

goldbook:15342 a skos:Concept ;
    skos:definition "In a system of two or more liquid or solid components, solubility of all components in all phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutual solubility" .

goldbook:15343 a skos:Concept ;
    skos:definition "Solute which forms an unsaturated solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-saturating solute" .

goldbook:15344 a skos:Concept ;
    skos:altLabel "transition reaction (in phase equilibria)" ;
    skos:definition "Isothermal, isobaric reversible reaction between two phases, a saturated liquid and a solid, that results, on removal of the solvent component of a ternary system in one new solid phase. For example, \\[\\ce{l + \\upalpha  \\upbeta}\\] where the forward arrow indicates the direction of removal of the solvent component. The system is in equilibrium along the peritonic line, on which is found the peritonic composition or point, an isothermal, isobaric invariant of the system which lies between the compositions of phases \\(\\ce{l}\\) and \\(\\upalpha\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritonic reaction" .

goldbook:15345 a skos:Concept ;
    skos:altLabel "per mille",
        "permille",
        "promille" ;
    skos:definition "One part in a thousand parts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permil" .

goldbook:15346 a skos:Concept ;
    skos:definition "Graphical representation, by use of points, lines, and surfaces, of the phases present at chemical equilibrium in unary, binary, ternary, and higher-order systems containing two or more phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase diagram" .

goldbook:15347 a skos:Concept ;
    skos:definition "Factor used to convert experimentally determined Henry’s law constants at the saturation vapor pressure of the solvent \\(\\ce{A}\\), \\(p_{\\ce{A}}^{\\ast}\\), to a reference pressure \\(p\\) \\[\\begin{array}{c} I_{\\rm{p}} = \\int_{p_{\\ce{A}}^{\\ast}}^p \\frac{V_{\\ce{B}}^{\\infty {\\rm{l}}}}{RT}{\\rm{d}}p \\\\ k_{\\rm{H},\\ce{B}}(p) = k_{\\rm{H},\\ce{B}}(p^{\\ast}) \\exp \\left[I_{\\rm{p}}(p) \\right]\\end{array}\\] is the partial molar volume of liquid \\(\\ce{B}\\) at infinite dilution in solvent \\(\\ce{A}\\). The second equation gives the relation between the two Henry’s law constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Poynting correction" .

goldbook:15348 a skos:Concept ;
    skos:definition "Data reported in peer-reviewed scientific reports of original research which allow an assessment of data quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary data" .

goldbook:15349 a skos:Concept ;
    skos:definition "Fugacity (\\(\\tilde{p}_{\\ce{B}}\\)) of a gaseous component (\\(\\ce{B}\\)) in equilibrium with a liquid or solid mixture containing \\(\\ce{B}\\) is directly proportional to the activity (\\(a_{\\ce{B}}\\)) of the component in the mixture \\[\\tilde{p}_{\\ce{B}} = \\tilde{p}_{\\ce{B}}^{\\ast} f_{\\ce{B}} x_{\\ce{B}}\\] where \\(f_{\\ce{B}}\\) is the activity coefficient of \\(\\ce{B}\\) referenced to Raoult’s law at mole fraction \\(x_{\\ce{B}}\\) and \\(\\tilde{p}_{\\ce{B}}\\) is the fugacity of pure \\(\\ce{B}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Raoult’s law" .

goldbook:15350 a skos:Concept ;
    skos:definition "System containing \\(n\\) ionic species with or without a single solvent. Because of electrical neutrality, the system has \\(n\\) components in an aqueous system with a single solvent and \\(n - 1\\) components in a molten salt system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reciprocal salt system" .

goldbook:15351 a skos:Concept ;
    skos:definition "Pressure divided by the critical pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced pressure" .

goldbook:15352 a skos:Concept ;
    skos:definition "Temperature divided by the critical temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced temperature" .

goldbook:15353 a skos:Concept ;
    skos:definition "Data that are critically evaluated and verified, obtained from an identified source, and related to a property of a phenomenon, body, or substance, or a system of components of known composition and structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference data" .

goldbook:15354 a skos:Concept ;
    skos:definition "Solubility that decreases with an increase in conditions such as temperature or added component, where an increase is expected as the usual case. In ternary liquid systems with coexisting phases, where the critical solution point is not a maximum on a ternary diagram, passing from a homogeneous mixture in which the composition of a given component is greater than that of the critical mixture to a heterogeneous mixture and back to a homogeneous mixture by altering the relative amounts of the two other components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retrograde solubility" .

goldbook:15355 a skos:Concept ;
    skos:definition "Solute that forms a saturated solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturating solute" .

goldbook:15356 a skos:Concept ;
    skos:definition "Dimensionless equation representing mutual solubilities in a number of chemically related liquid systems. Each mutual solubility is subtracted from the solubility at the critical solution point, and the temperature is divided by the critical solution temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaling equation" .

goldbook:15357 a skos:Concept ;
    skos:altLabel "Setschenow equation" ;
    skos:definition "Expression of the salt effect that relates the change in solubility of a nonelectrolyte (e.g., gas or organic liquid) to changing ionic strength of aqueous solutions, \\[\\lg (s_{\\rm{o}}/s) = K_{s} I_{s}\\] where \\(s_{o}\\), \\(s\\) are the solubilities of nonelectrolyte in pure water and saline solution, respectively, \\(K_{s}\\) the Sechenov parameter (an empirical proportionality constant), and \\(I_{s}\\) the ionic strength of the saline solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sechenov equation" .

goldbook:15358 a skos:Concept ;
    skos:definition "Solubility of a diatomic gas in a molten metal is proportional to the square root of the partial pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sieverts’ law" .

goldbook:15359 a skos:Concept ;
    skos:definition "Generalization of solubility product to include, for example, undissociated salt or uncharged cation-anion pair as solute, reaction between solution species and the cation or anion of the solid salt, and gas-solution equilibria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solubility constant" .

goldbook:15360 a skos:Concept ;
    skos:definition "Process by which an agent increases the solubility or the rate of dissolution of a solid or liquid solute.Modified from entry 'micellar solubilization' in." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solubilisation" .

goldbook:15361 a skos:Concept ;
    skos:definition "Mole or mass fraction of a solvent in a solution containing \\(s\\) solute constituents (\\(i = 1, 2, \\ldots, s\\)) and \\(p\\) solvent constituents (\\(i = s + 1, s + 2, \\ldots, p\\)). For a solvent \\(\\ce{A}\\), \\[x_{{\\rm{v}},{\\ce{A}}} = x_{\\ce{A}}/\\sum \\limits_{i=s+1}^{p} x_{i}\\] where \\[\\sum \\limits_{i=1}^{p} x_{i} = \\sum \\limits_{i=1}^{s} x_{i} + \\sum \\limits_{i=s+1}^{p} x_{i} = 1\\] and analogously for \\(w_{{\\rm{v}},{\\ce{A}}}\\), where the first and last summations are over all solvent constituents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent mole fraction" .

goldbook:15362 a skos:Concept ;
    skos:definition "For a solvent \\(\\ce{A}\\), volume fraction of \\(\\ce{A}\\) divided by the sum of the volume fractions of solvent in a solution containing both \\(s\\) solutes (\\(i = 1, 2, \\ldots, s\\)) and \\(p\\) solvents (\\(i = s + 1, s + 2, \\ldots, p\\)) \\[\\varphi_{{\\rm{v}},{\\ce{A}}} = \\varphi_{\\ce{A}}/\\sum \\limits_{i=s+1}^{p} \\varphi_{i}\\] where the summation is over the \\(p\\) solvent components only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent volume fraction" .

goldbook:15363 a skos:Concept ;
    skos:altLabel "standard concentration" ;
    skos:definition "Chosen value of amount concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard amount concentration" .

goldbook:15364 a skos:Concept ;
    skos:definition "Class of experimental procedures for solubility determination in which a solution of known composition is prepared. Two major subclasses are recognized. In the isothermal method, one liquid component is titrated with a second liquid component at constant temperature until persistent turbidity is observed (i.e., to the cloud point). In the polythermal method, a mixture of known composition is heated above its solution temperature and monitored visually during cooling until turbidity (the cloud point) is observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synthetic method" .

goldbook:15365 a skos:Concept ;
    skos:altLabel "Gibbs’ triangular representation" ;
    skos:definition "Triangular plot (usually an equilateral or right-angled triangle) whose vertices represent the pure components of a ternary system at constant temperature and pressure. Any point within the triangle represents the composition in terms of the two independent mole (or mass) fractions. Lines parallel to the sides of the triangle represent constant proportions of the respective components (isopleths)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ternary diagram" .

goldbook:15366 a skos:Concept ;
    skos:definition "System containing three components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ternary system" .

goldbook:15367 a skos:Concept ;
    skos:altLabel "connodal",
        "conodal" ;
    skos:definition "Straight line connecting compositions of independent coexisting phases in equilibrium on a phase diagram." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tie-line" .

goldbook:15368 a skos:Concept ;
    skos:definition "System containing one component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unary system" .

goldbook:15369 a skos:Concept ;
    skos:definition "Solution that has a lower proportion of a solute than one that is in equilibrium with undissolved solute at specified values of temperature and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unsaturated solution" .

goldbook:15370 a skos:Concept ;
    skos:altLabel "undersaturation" ;
    skos:definition "State of an unsaturated solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unsaturation" .

goldbook:15371 a skos:Concept ;
    skos:altLabel "Schreinemakers’ method",
        "initial complex method" ;
    skos:definition "Method for determining composition of a solid phase in a ternary system at constant temperature and pressure by analysis of the total mixture of solid and liquid in equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wet residue method" .

goldbook:15372 a skos:Concept ;
    skos:definition "Theory of coexistence curves or other discontinuities in the properties of phases (such as order-disorder or magnetic transitions) in binary systems, based on a one-, two-, or three-dimensional statistical mechanical nearest-neighbor lattice theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ising model" .

goldbook:15373 a skos:Concept ;
    skos:altLabel "solute mole (or mass) fraction coordinates" ;
    skos:definition "Coordinates used mainly in representation of multicomponent phase diagrams that distinguish solutes and a single solvent. The mole or mass fractions of the \\(s\\) solutes are chosen as the primary composition variables and the mole or mass fraction of solvent as a secondary variable, so that the solute amount (mass) fractions may be represented, for example, in ternary and quaternary systems, as linear (ternary) or planar triangular or square planar (quaternary) diagrams, with the solvent amount or mass fraction along an axis perpendicular to the chosen diagram of solute variables. Quantitatively, \\[x_{{\\rm{s}},{\\ce{B}}} = x_{\\ce{B}}/\\sum \\limits_{i=1}^{s}x_{i}\\] where the summation is over the \\(s\\) solute substances. Note that \\(\\sum \\limits_{i=1}^{s}x_{{\\rm{s}},{\\ce{B}}} = 1\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Jänecke coordinates" .

goldbook:15374 a skos:Concept ;
    skos:definition "Volume \\(V^{\\rm{g}}\\) of an amount \\(n_{\\ce{B}}^{\\rm{l}}\\) of a dissolved gas at a given standard temperature \\(T^{^⦵\\!}\\) (usually \\(\\pu{273.15 K}\\)) and given standard pressure \\(p^{_{^⦵\\!}}\\) (\\(\\pu{1 bar} = \\pu{0.1 MPa}\\) or, in older literature, \\(\\pu{1 atm}\\)) divided by the mass \\(m^{\\rm{l}}\\) of the dissolving liquid containing an amount $n_{\\ce{A}}$ of solvent at temperature $T$ and the given pressure \\(p^{_{^⦵\\!}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kuenen coefficient" .

goldbook:15375 a skos:Concept ;
    skos:definition "Deprecated term that includes both a quantity and a unit. Replace by mass fraction expressed as percent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass percent" .

goldbook:15377 a skos:Concept ;
    skos:definition "Volume \\(V^{\\rm{g}}\\) of an amount \\(n_{\\ce{B}}^{\\rm{l}}\\) of a dissolved gas calculated at given temperature \\(T\\) and pressure \\(p\\) divided by the volume of the dissolving liquid of volume \\(V^{\\rm{l}}\\) and containing an amount \\(n_{\\ce{A}}\\) of solvent at the same temperature \\(T\\) and pressure \\(p\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ostwald coefficient" .

goldbook:15378 a skos:Concept ;
    skos:altLabel "ADMET" ;
    skos:definition "Metathesis polymerization of an acylic diene monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyclic diene metathesis polymerisation" .

goldbook:15379 a skos:Concept ;
    skos:definition "Measured rate of polymerization divided by the concentration of the reactant (if there is only one) or the product of concentrations of the presumed reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apparent rate constant of polymerisation" .

goldbook:15380 a skos:Concept ;
    skos:definition "Increase in the rate of polymerization with increasing conversion of the reactant(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auto-acceleration" .

goldbook:15381 a skos:Concept ;
    skos:definition "Binary copolymerization in which the two monomer reactivity ratios, \\(r_{12}\\) and \\(r_{21}\\) are not both equal to unity yet the copolymerization forms a copolymer with its molar ratio of monomer units equal to the molar ratio of monomers in the monomer feed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azeotropic copolymerisation" .

goldbook:15382 a skos:Concept ;
    skos:altLabel "intramolecular chain transfer" ;
    skos:definition "Chain transfer from an active center on a macromolecule to another part of the same macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backbiting" .

goldbook:15383 a skos:Concept ;
    skos:definition "Copolymerization involving two species of monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binary copolymerisation" .

goldbook:15384 a skos:Concept ;
    skos:definition "Polymerization of an undiluted liquid monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk polymerisation" .

goldbook:15385 a skos:Concept ;
    skos:definition "Temperature above which, in a given chain polymerization, polymer of high molar mass is not formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceiling temperature" .

goldbook:15386 a skos:Concept ;
    skos:definition "Chain polymerization in which a copolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain copolymerisation" .

goldbook:15387 a skos:Concept ;
    skos:altLabel "depropagation" ;
    skos:definition "Chemical reaction that results in the formation of a monomer molecule at an active center on the terminal unit of a chain carrier and decreases the degree of polymerization of the chain carrier by one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain depropagation" .

goldbook:15388 a skos:Concept ;
    skos:altLabel "radical reactivity ratio" ;
    skos:definition "In a binary copolymerization, the ratio of two rate constants defining the relative activity of an active center on a given type of terminal unit of a chain carrier toward one type of monomer, in the two cases where the penultimate unit of the chain carrier is identical to and different from the terminal unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-end reactivity ratio" .

goldbook:15389 a skos:Concept ;
    skos:definition "In a homopolymerization, rate constant for chain transfer, \\(k_{\\rm{tr}}\\), divided by the rate constant for chain propagation, \\(k_{\\rm{p}}\\), i.e., \\(C_{\\rm{tr}} = k_{\\rm{tr}}/k_{\\rm{p}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-transfer constant" .

goldbook:15390 a skos:Concept ;
    skos:definition "Monomer used in copolymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comonomer" .

goldbook:15391 a skos:Concept ;
    skos:altLabel "Mayo–Lewis equation" ;
    skos:definition "Equation relating the instantaneous composition of a binary copolymer to the monomer reactivity ratios and the ratio of instantaneous monomer concentrations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copolymerisation composition equation" .

goldbook:15392 a skos:Concept ;
    skos:definition "Linking of two macromolecules through chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coupling reaction" .

goldbook:15393 a skos:Concept ;
    skos:definition "Propagation reaction in a copolymerization in which a chain carrier, bearing at its active end a monomer unit of one kind, reacts with a monomer molecule of another kind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-propagation" .

goldbook:15394 a skos:Concept ;
    skos:definition "Termination reaction in a copolymerization between two chain carriers with different chemical structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-termination" .

goldbook:15395 a skos:Concept ;
    skos:definition "Radical polymerization that stops, as a consequence of the depletion of the initiator, before the monomer has reacted fully." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead-end polymerisation" .

goldbook:15396 a skos:Concept ;
    skos:definition "Chain transfer reaction that generates a new chain carrier of much lower reactivity than that of the original chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degradative chain transfer" .

goldbook:15397 a skos:Concept ;
    skos:definition "Chain termination in a chain polymerization in which the rate-determining step is a diffusion process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion-controlled termination" .

goldbook:15398 a skos:Concept ;
    skos:definition "Reaction in which end-groups of a desired structure are intentionally formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "end-capping" .

goldbook:15399 a skos:Concept ;
    skos:altLabel "molar enthalpy of polymerization" ;
    skos:definition "Change of enthalpy, in a chain polymerization forming a homopolymer, associated with the conversion of one mole of monomer into polymer under isobaric and isothermal conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpy of polymerisation" .

goldbook:15400 a skos:Concept ;
    skos:altLabel "molar entropy of polymerization" ;
    skos:definition "Change of entropy, in a chain polymerization forming a homopolymer, associated with the conversion of one mole of monomer into polymer under isobaric and isothermal conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entropy of polymerisation" .

goldbook:15401 a skos:Concept ;
    skos:definition "Temperature below which, in a given chain polymerization, polymer of high molar mass is not formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "floor temperature" .

goldbook:15402 a skos:Concept ;
    skos:definition "Ion whose behavior is independent of the influence of a counterion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free ion" .

goldbook:15403 a skos:Concept ;
    skos:definition "Heat absorbed or given off from the conversion of a specified amount of monomer into polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heat of polymerisation" .

goldbook:15404 a skos:Concept ;
    skos:definition "Addition of a monomer to a chain carrier bearing a terminal group derived from the same monomer species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homopropagation" .

goldbook:15405 a skos:Concept ;
    skos:definition "Binary copolymerization in which the relative rates of incorporation of the two types of monomer into the copolymer are independent of the nature of the monomer unit at the end of a propagating chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal binary copolymerisation" .

goldbook:15406 a skos:Concept ;
    skos:definition "Copolymerization in which all types of propagating species show the same relative reactivity toward the monomers present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal copolymerisation" .

goldbook:15407 a skos:Concept ;
    skos:definition "Polycondensation involving two monomers separately dissolved in immiscible solvents, forming a twophase system, with polycondensation taking place at (or near) an interface between the two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfacial polycondensation" .

goldbook:15408 a skos:Concept ;
    skos:definition "Chain transfer from an active center on a macromolecule to a different macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermolecular chain transfer" .

goldbook:15409 a skos:Concept ;
    skos:definition "In a chain polymerization, the rate of chain propagation divided by the sum of the rates of all of the chain-termination processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic-chain length" .

goldbook:15410 a skos:Concept ;
    skos:definition "In binary copolymerization, (a) the ratio (\\(r_{12}\\)) of the rate constant (\\(k_{11}\\)) for the homopropagation of monomer \\(\\rm{M}_{1}\\) to the rate constant (\\(k_{12}\\)) for the cross-propagation of the chain carrier \\(\\ldots -{\\rm{m}}_{1}^{\\ast}\\) with the monomer \\(\\rm{M}_{2}\\) and (b) the ratio (\\(r_{21}\\)) of the rate constant (\\(k_{22}\\)) for the homopropagation of monomer \\(\\rm{M}_{2}\\) to the rate constant for the cross-propagation (\\(k_{21}\\)) of the chain carrier \\(\\ldots -{\\rm{m}}_{2}^{\\ast}\\) with monomer \\(\\rm{M}_{1}\\). Thus, \\(r_{12} = k_{11}/k_{12}, r_{21} = k_{22}/k_{21}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomer reactivity ratios" .

goldbook:15411 a skos:Concept ;
    skos:definition "Relative scale defined by the values of the rate constants for the addition of monomers to a reference active center." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomer reactivity scale" .

goldbook:15412 a skos:Concept ;
    skos:altLabel "Jenkins’ scheme" ;
    skos:definition "Method for the prediction of monomer reactivity ratios in binary copolymerization, based exclusively on experimentally determined parameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "patterns of reactivity scheme" .

goldbook:15413 a skos:Concept ;
    skos:definition "Phenomenon that the penultimate monomer unit preceding the active center on the terminal unit of an active polymer chain affects the reactivity of that active center." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "penultimate-unit effect" .

goldbook:15414 a skos:Concept ;
    skos:definition "Termination reaction involving a radical chain carrier and a primary radical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary-radical termination" .

goldbook:15415 a skos:Concept ;
    skos:altLabel "PLP" ;
    skos:definition "Polymerization initiated by successive pulses of laser light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulsed-laser polymerisation" .

goldbook:15416 a skos:Concept ;
    skos:altLabel "Alfrey–Price scheme" ;
    skos:definition "Empirical equations expressing the monomer reactivity ratios in a binary radical copolymerization, \\(r_{12}\\) and \\(r_{21}\\), in terms of the empirical parameters \\(Q\\) and \\(e\\) for the two monomers, namely, \\(\\rm{Q}_{1}\\), \\(\\rm{Q}_{2}\\), \\(\\rm{e}_{1}\\), and \\(\\rm{e}_{2}\\), with\\(r_{12} = (Q_{1}/Q_{2})\\exp [-{e_{1}}(e_{1} - e_{2})]\\) and \\(r_{21} = (Q_{2}/Q_{1}) \\exp [-{e_{2}}(e_{2} - e_{1})]\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>Q-e</i> scheme" .

goldbook:15417 a skos:Concept ;
    skos:definition "Scale of the values of the rate constants for the reaction of radicals with a reference monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical reactivity scale" .

goldbook:15418 a skos:Concept ;
    skos:definition "Rate of consumption of monomers in a chain polymerization, or the rate of consumption of the functional groups in the reaction mixture of a polycondensation or polyaddition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of polymerisation" .

goldbook:15419 a skos:Concept ;
    skos:definition "Radical formed by the rearrangement or fragmentation of a primary radical that is capable of initiating a polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary radical" .

goldbook:15420 a skos:Concept ;
    skos:definition "Polymerization in which initiating species are formed exclusively from the monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-initiated polymerisation" .

goldbook:15421 a skos:Concept ;
    skos:definition "Polymerization of a crystalline monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid-state polymerisation" .

goldbook:15422 a skos:Concept ;
    skos:definition "Chain termination proceeding as a unimolecular process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spontaneous termination" .

goldbook:15423 a skos:Concept ;
    skos:definition "Solid-state polymerization, resulting in the formation of a polymer having essentially the same crystal structure as that of the monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topochemical polymerisation" .

goldbook:15424 a skos:Concept ;
    skos:altLabel "amide interchange" ;
    skos:definition "Interchange reaction involving amide groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transamidation" .

goldbook:15425 a skos:Concept ;
    skos:altLabel "ester interchange" ;
    skos:definition "Interchange reaction involving ester groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transesterification" .

goldbook:15427 a skos:Concept ;
    skos:definition "Copolymerization that is a zwitterionic polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zwitterionic copolymerisation" .

goldbook:15428 a skos:Concept ;
    skos:definition "Chain polymerization in which a growing macromolecule bears two ionic chain carriers of opposite signs, at one or both of its ends." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zwitterionic polymerisation" .

goldbook:15429 a skos:Concept ;
    skos:definition "Macromolecule in which the termini of the backbone are connected to form a ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclic macromolecule" .

goldbook:15430 a skos:Concept ;
    skos:definition "Macrocycle in a bridged polycyclic macromolecule or polycyclic macromolecular portion that contains the subunits of highest seniority." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main ring" .

goldbook:15431 a skos:Concept ;
    skos:definition "Number of polymer main-chain (backbone) atoms between two subunits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "path length" .

goldbook:15432 a skos:Concept ;
    skos:definition "Molecule that includes more than one macrocycle, all of which have at least one atom in common with another macrocycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycyclic macromolecule" .

goldbook:15433 a skos:Concept ;
    skos:definition "Process in which a substance is converted to simpler products by physical or chemical mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abiotic degradation" .

goldbook:15434 a skos:Concept ;
    skos:definition "Substance that causes pregnancy to end prematurely and causes an abortion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abortifacient" .

goldbook:15435 a skos:Concept ;
    skos:definition "Improper use of drugs or other substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abuse" .

goldbook:15436 a skos:Concept ;
    skos:definition "Substance intended to kill mites, ticks, or other Acaridae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acaricide" .

goldbook:15437 a skos:Concept ;
    skos:definition "Acceptable concentration of a residue that has been established for an antibiotic found in human or animal foods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptable residue level" .

goldbook:15438 a skos:Concept ;
    skos:definition "Probability of suffering disease or injury that is considered to be sufficiently small to be 'negligible'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptable risk" .

goldbook:15439 a skos:Concept ;
    skos:definition "Probability of suffering disease or injury that is accepted by an individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accepted risk" .

goldbook:15440 a skos:Concept ;
    skos:definition "Unintended contact with a substance or change in the physical environment (including, e.g., radiation) resulting from an accident." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accidental exposure" .

goldbook:15441 a skos:Concept ;
    skos:definition "Equilibrium constant for the following reaction of an acid \\(\\ce{HB}\\): \\[\\begin{gathered} \\ce{HB(aq)  H^{+}(aq) + B^{-}(aq)} \\\\ K_{\\rm{a}} = [\\ce{H^{+}}][\\ce{B^{-}}]/[\\ce{HB}]c^{\\rm{o}} \\end{gathered}\\] where \\(c^{\\rm{o}} = \\pu{1 mol L-1}\\) is the standard amount concentration and activity coefficients have been neglected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid dissociation constant" .

goldbook:15442 a skos:Concept ;
    skos:definition "Concentration of a substance in air, soil, water, or other defined medium at which specified emergency counter-measures, such as the seizure and destruction of contaminated materials, evacuation of the local population or closing down the sources of pollution, are to be taken. Concentration of a pollutant in air, soil, water, or other defined medium at which some kind of preventive action (not necessarily of an emergency nature) is to be taken." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "action level" .

goldbook:15443 a skos:Concept ;
    skos:definition "Component of a mixture responsible for the biological effects of the mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active ingredient" .

goldbook:15444 a skos:Concept ;
    skos:definition "Metabolite causing biological and (or) toxicological effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active metabolite" .

goldbook:15445 a skos:Concept ;
    skos:altLabel "short-term toxicity test" ;
    skos:definition "Study in which organisms are observed during only a short part of the life span and in which there is often only a single exposure to the test agent at the beginning of the study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute toxicity test" .

goldbook:15446 a skos:Concept ;
    skos:definition "Change in an organism, in response to changing conditions of the environment (specifically chemical), which takes place without any irreversible disruptions of the given biological system and without exceeding normal (homeostatic) capacities of its response. Process by which an organism stabilizes its physiological condition after an environmental change.Note: If this process exceeds the homeostatic range, it becomes pathological and results in symptoms of disease (adverse effects)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adaptation" .

goldbook:15447 a skos:Concept ;
    skos:definition "Difference between the incidence of an adverse effect in a treated group (of organisms or a group of exposed humans) and a control group (of the same organisms or the spontaneous incidence in humans)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "added risk" .

goldbook:15448 a skos:Concept ;
    skos:definition "Occurrence that causes an adverse effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adverse event" .

goldbook:15449 a skos:Concept ;
    skos:definition "Diameter of a spherical particle with relative density equal to unity that has the same settling velocity in air as the particle in question." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerodynamic diameter" .

goldbook:15450 a skos:Concept ;
    skos:definition "Ability of a poison to produce a change in an organism after cessation of contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "after-effect of a poison" .

goldbook:15451 a skos:Concept ;
    skos:definition "Quantitative and qualitative age dependence of an effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "age sensitivity" .

goldbook:15452 a skos:Concept ;
    skos:definition "Network of organizations that monitor air pollution. Group of measures or processes used to minimize or prevent air pollution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air pollution control system" .

goldbook:15453 a skos:Concept ;
    skos:definition "Presence of albumin, derived from plasma, in the urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "albuminuria" .

goldbook:15454 a skos:Concept ;
    skos:definition "Substance that introduces an alkyl substituent into a compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylating agent" .

goldbook:15455 a skos:Concept ;
    skos:definition "Regular and systematic pattern of growth such that the mass or size of any organ or part of a body can be expressed in relation to the total mass or size of the entire organism according to the allometric equation: \\[Y = b{x^{\\alpha}}\\] where \\(Y\\) = mass of the organ, \\(x\\) = mass of the organism, \\(\\alpha\\) = growth coefficient of the organ, and \\(b\\) is a constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allometric growth" .

goldbook:15456 a skos:Concept ;
    skos:definition "Adjustment of data to allow for change in proportion between an organ or organs and other body parts during the growth of an organism. Adjustment of data to allow for differences and make comparisons between species having dissimilar characteristics (e.g., in size, shape, and metabolism)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allometric scaling" .

goldbook:15457 a skos:Concept ;
    skos:definition "Measurement of the rate of growth of a part or parts of an organism relative to the growth of the whole organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allometry" .

goldbook:15458 a skos:Concept ;
    skos:definition "Semiochemical that is produced by an organism inducing a response in an organism of another species that is favorable to the emitter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allomone" .

goldbook:15459 a skos:Concept ;
    skos:definition "Study designed to examine associations, commonly putative or hypothesized causal relationships." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytic study" .

goldbook:15460 a skos:Concept ;
    skos:definition "Loss of normal cell differentiation, a feature characteristic of most malignancies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaplasia" .

goldbook:15461 a skos:Concept ;
    skos:altLabel "coal miners’ pneumoconiosis" ;
    skos:definition "Form of pneumoconiosis caused by accumulation of anthracite carbon deposits in the lungs due to inhalation of smoke or coal dust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anthracosis" .

goldbook:15462 a skos:Concept ;
    skos:definition "Substance that prevents blood clotting (e.g., warfarin)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticoagulant" .

goldbook:15463 a skos:Concept ;
    skos:definition "Substance capable of specifically counteracting or reducing the effect of a potentially toxic substance in an organism by a relatively specific chemical or pharmacological action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antidote" .

goldbook:15464 a skos:Concept ;
    skos:definition "Substance that blocks or counteracts the action of histamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antihistamine" .

goldbook:15465 a skos:Concept ;
    skos:definition "n., Substance inhibiting or preventing the actions of muscarine and muscarine-like agents (e.g., atropine) on the muscarinic acetylcholine receptors. adj., Inhibiting or preventing the actions of muscarine and muscarine-like agents on the muscarinic acetylcholine receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antimuscarinic" .

goldbook:15466 a skos:Concept ;
    skos:definition "n., Substance inhibiting or preventing the actions of nicotine and nicotine-like agents (e.g., suxamethonium chloride) on the nicotinic acetylcholine receptors. adj., Inhibiting or preventing the actions of nicotine and nicotine-like agents on the nicotinic acetylcholine receptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antinicotinic" .

goldbook:15467 a skos:Concept ;
    skos:definition "Substance that relieves or reduces fever." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antipyretic" .

goldbook:15468 a skos:Concept ;
    skos:definition "Common name for a harmful plant parasite in the family Aphididae, some species of which are vectors of plant virus diseases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aphid" .

goldbook:15469 a skos:Concept ;
    skos:definition "Lack of development of an organ or tissue, or of the cellular products from an organ or tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aplasia" .

goldbook:15470 a skos:Concept ;
    skos:definition "Substance intended to kill trees and shrubs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arboricide" .

goldbook:15471 a skos:Concept ;
    skos:altLabel "distributed source" ;
    skos:definition "Widespread origin of emissions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "area source" .

goldbook:15472 a skos:Concept ;
    skos:altLabel "AUMC" ;
    skos:definition "Area between a curve and the abscissa (horizontal axis) in a plot of (concentration \\(\\times\\) time) vs. time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "area under the moment curve" .

goldbook:15473 a skos:Concept ;
    skos:altLabel "argyrosis" ;
    skos:definition "Pathological condition characterized by gray-bluish or black pigmentation of tissues (such as skin, retina, mucous membranes, internal organs) caused by the accumulation of metallic silver, due to reduction of a silver compound which has entered the organism during (prolonged) administration or exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "argyria" .

goldbook:15474 a skos:Concept ;
    skos:definition "Chronic arsenical poisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arseniasis" .

goldbook:15476 a skos:Concept ;
    skos:definition "Hardening and thickening of the walls of the arteries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arteriosclerosis" .

goldbook:15477 a skos:Concept ;
    skos:definition "Pain in a joint." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arthralgia" .

goldbook:15478 a skos:Concept ;
    skos:altLabel "arthrosis" ;
    skos:definition "Disease of a joint." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arthropathy" .

goldbook:15479 a skos:Concept ;
    skos:definition "Joint or articulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arthrosis" .

goldbook:15480 a skos:Concept ;
    skos:definition "Form of pneumoconiosis caused by inhalation of asbestos fibers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asbestosis" .

goldbook:15481 a skos:Concept ;
    skos:definition "Substance intended to kill roundworms (Ascaridae)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ascaricide" .

goldbook:15482 a skos:Concept ;
    skos:definition "Condition resulting from insufficient intake of oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asphyxia" .

goldbook:15483 a skos:Concept ;
    skos:definition "Substance that blocks the transport or use of oxygen by living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asphyxiant" .

goldbook:15484 a skos:Concept ;
    skos:definition "Uptake and incorporation of substances by a living organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assimilation" .

goldbook:15485 a skos:Concept ;
    skos:definition "Weakness; lack or loss of strength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asthenia" .

goldbook:15486 a skos:Concept ;
    skos:altLabel "adstringent" ;
    skos:definition "adj., Causing contraction, usually locally after topical application. n., Substance causing cells to shrink, thus causing tissue contraction or stoppage of secretions and discharges; such substances may be applied to skin to harden and protect it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "astringent" .

goldbook:15487 a skos:Concept ;
    skos:definition "Pathological condition in which there is thickening, hardening, and loss of elasticity of the walls of blood vessels, characterized by a variable combination of changes of the innermost layer consisting of local accumulation of lipids, complex carbohydrates, blood and blood components, fibrous tissue, and calcium deposits. In addition, the outer layer becomes thickened and there is fatty degeneration of the middle layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atherosclerosis" .

goldbook:15488 a skos:Concept ;
    skos:definition "Substance that attracts animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attractant" .

goldbook:15489 a skos:Concept ;
    skos:definition "Membrane-bound body (secondary lysosome) in which parts of the cell are digested." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autophagosome" .

goldbook:15490 a skos:Concept ;
    skos:altLabel "autooxidation" ;
    skos:definition "Reaction with dioxygen at moderate temperatures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoxidation" .

goldbook:15491 a skos:Concept ;
    skos:definition "Apparently spontaneous, usually slow reaction of foodstuff components with dioxygen in an aerobic environment at moderate temperatures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoxidation" .

goldbook:15492 a skos:Concept ;
    skos:definition "Organism unable to synthesize an organic molecule which is required for its growth: When the compound is given to the organism with the other nutrients it requires, growth of the organism may occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auxotroph" .

goldbook:15493 a skos:Concept ;
    skos:definition "Substance intended to kill birds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "avicide" .

goldbook:15494 a skos:Concept ;
    skos:definition "Process that reverses the effect of a mutation which had inactivated a gene; thus, it restores the wild phenotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back-mutation" .

goldbook:15495 a skos:Concept ;
    skos:altLabel "BAC" ;
    skos:definition "DNA vector into which large DNA fragments can be inserted and cloned in a bacterial host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bacterial artificial chromosome" .

goldbook:15496 a skos:Concept ;
    skos:definition "Substance intended to kill bacteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bactericide" .

goldbook:15497 a skos:Concept ;
    skos:definition "Lung disease caused by the inhalation of dust from sugar-cane residues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bagassosis" .

goldbook:15498 a skos:Concept ;
    skos:definition "Triple-layered structure on which epithelium sits: It consists of an electron-dense layer (lamina densa) between two electron-transparent layers (lamina lucida). The lamina densa is composed of type IV collagen, and the lamina lucida contains the glycoprotein laminin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basal lamina" .

goldbook:15499 a skos:Concept ;
    skos:definition "Equation expressing the build up and decay in concentration of a substance (usually in plasma) based on first-order uptake and elimination in a one-compartment model, having the form \\[C = [fDk_{\\rm{a}}/V(k_{\\rm{a}} - k_{\\rm{e}})] [\\exp(-k_{\\rm{e}}t) - \\exp(-k_{\\rm{a}}t)] \\]where \\(C\\) is the concentration and \\(D\\) the dose of the substance, \\(f\\) the fraction absorbed, and \\(V\\) the volume of distribution. \\(k_{\\rm{a}}\\) and \\(k_{\\rm{e}}\\) are the first-order rate constants of uptake and elimination, respectively, and \\(t\\) is time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bateman function" .

goldbook:15500 a skos:Concept ;
    skos:definition "Biological monitoring guidance value set at the \\(90^{\\rm{th}}\\) percentile of available biological monitoring results collected from a representative sample of workplaces with good occupational hygiene practices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benchmark guidance value" .

goldbook:15501 a skos:Concept ;
    skos:definition "Response, expressed as an excess of background, at which a benchmark dose or benchmark concentration is set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benchmark response" .

goldbook:15502 a skos:Concept ;
    skos:definition "Of a disease, producing no persisting harmful effects. Tumor that does not invade other tissues (see metastasis ), having lost growth control but not positional control.Note: Such a tumor is not carcinogenic but may cause mechanical damage to adjacent tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benign" .

goldbook:15503 a skos:Concept ;
    skos:altLabel "berylliosis" ;
    skos:definition "Serious and usually permanent lung damage resulting from chronic inhalation of beryllium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beryllium disease" .

goldbook:15504 a skos:Concept ;
    skos:definition "Any sample that is not a random sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biased sample" .

goldbook:15505 a skos:Concept ;
    skos:definition "Orange-yellow pigment, a breakdown product of heme-containing proteins (hemoglobin, myoglobin, cytochromes), which circulates in the blood plasma bound to albumin or as water-soluble glucuronide conjugates, and is excreted in the bile by the liver." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bilirubin" .

goldbook:15506 a skos:Concept ;
    skos:definition "Ability of living organisms to concentrate a substance obtained either directly from the environment or indirectly through its food." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioaccumulation potential" .

goldbook:15507 a skos:Concept ;
    skos:definition "Reaction or series of reactions, usually enzyme-catalyzed, associated with a specific physiological event in a living organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biochemical mechanism" .

goldbook:15508 a skos:Concept ;
    skos:definition "Removal, usually from the aqueous phase, of a test substance in the presence of living organisms by biological processes supplemented by physicochemical reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioelimination" .

goldbook:15509 a skos:Concept ;
    skos:definition "Metabolic conversion of a xenobiotic to a less toxic derivative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioinactivation" .

goldbook:15510 a skos:Concept ;
    skos:definition "Science of the movements involved in the distribution of substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biokinetics" .

goldbook:15511 a skos:Concept ;
    skos:definition "Complete circulatory process through which a substance passes in the biosphere. It may involve transport through the various media (air, water, soil), followed by environmental transformation, and carriage through various ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological cycle" .

goldbook:15512 a skos:Concept ;
    skos:altLabel "biopreparation" ;
    skos:definition "Compound derived from living organisms and their products for use in medicine or as a pesticide, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological preparation" .

goldbook:15513 a skos:Concept ;
    skos:definition "Organ, tissue (including blood), secretion, or excretion product taken from an organism as a sample reflecting the state of the whole organism. Organism taken as a sample reflecting the state of a population or their environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological specimen" .

goldbook:15514 a skos:Concept ;
    skos:altLabel "germ warfare" ;
    skos:definition "Military operations using any organism (bacteria, virus, or other disease-causing organism) or toxin found in nature, to kill, injure, or incapacitate human beings, animals, or plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological warfare" .

goldbook:15515 a skos:Concept ;
    skos:definition "Excision of a small piece of living tissue for microscopic or biochemical examination; usually performed to establish a diagnosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biopsy" .

goldbook:15516 a skos:Concept ;
    skos:definition "Adjective applied to a substance that arrests the growth or multiplication of living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biostatic" .

goldbook:15517 a skos:Concept ;
    skos:definition "All living organisms as a totality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biota" .

goldbook:15518 a skos:Concept ;
    skos:altLabel "2",
        "3-dimercaptopropan-1-ol",
        "British anti-Lewisite",
        "dimercaprol" ;
    skos:definition "Metal chelator that has been used in the treatment of arsenic, antimony, gold, mercury, and lead poisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "2,3-bis(sulfanyl)propan-1-ol" .

goldbook:15519 a skos:Concept ;
    skos:definition "Single dose of a substance, originally a large pill. Dose of a substance administered by a single rapid intravenous injection. Concentrated mass of food ready to be swallowed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bolus" .

goldbook:15520 a skos:Concept ;
    skos:definition "Substance with activity against pests, that is produced naturally within a plant and may act as a defense against predators." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "botanical pesticide" .

goldbook:15521 a skos:Concept ;
    skos:definition "Acute food poisoning caused by botulinum toxin produced in food by the bacterium Clostridium botulinum and characterized by muscle weakness and paralysis; disturbances of vision, swallowing, and speech; and a high mortality rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "botulism" .

goldbook:15522 a skos:Concept ;
    skos:definition "Prefix meaning slow as in bradycardia or bradypnoea." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brady-" .

goldbook:15523 a skos:Concept ;
    skos:definition "Abnormally slow breathing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bradypnoea" .

goldbook:15524 a skos:Concept ;
    skos:definition "Space within a radius of \\(\\pu{0.5 m}\\) from a person’s face." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "breathing zone" .

goldbook:15525 a skos:Concept ;
    skos:definition "Narrowing of the air passages through the bronchi of the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bronchoconstriction" .

goldbook:15526 a skos:Concept ;
    skos:definition "Expansion of the air passages through the bronchi of the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bronchodilation" .

goldbook:15527 a skos:Concept ;
    skos:definition "Intermittent violent contraction of the air passages of the lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bronchospasm" .

goldbook:15528 a skos:Concept ;
    skos:definition "Material that enhances or maintains the cleaning efficiency of a surfactant, in a detergent, principally by inactivating water hardness; complex phosphates (especially sodium tripolyphosphate, i.e., pentasodium triphosphate), sodium carbonate, and sodium silicate are the builders most commonly used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "builder" .

goldbook:15529 a skos:Concept ;
    skos:definition "Pneumoconiosis caused by inhalation of dust and associated microbial contaminants and observed in cotton, flax, and hemp workers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "byssinosis" .

goldbook:15530 a skos:Concept ;
    skos:definition "Liability of members of the general public to come in contact with substances arising from operations or processes carried out by other individuals in their vicinity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bystander exposure" .

goldbook:15531 a skos:Concept ;
    skos:definition "Imagined perception of vile odors, including coprosmia (smelling feces) and necrosmia (the smell of death)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cacosmia" .

goldbook:15532 a skos:Concept ;
    skos:definition "Form of mineralization in which organic tissue becomes hardened by deposition of calcium salts within its substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calcification" .

goldbook:15533 a skos:Concept ;
    skos:altLabel "carboxyhemoglobin" ;
    skos:definition "Compound that is formed between carbon monoxide and hemoglobin in the blood of animals and humans and is incapable of transporting oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonylhemoglobin" .

goldbook:15534 a skos:Concept ;
    skos:definition "Long-term (chronic) test designed to detect any possible carcinogenic effect of a test substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carcinogenicity test" .

goldbook:15535 a skos:Concept ;
    skos:definition "Chemically harmful to the cells of the heart." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cardiotoxic" .

goldbook:15536 a skos:Concept ;
    skos:altLabel "carrier prodrug" ;
    skos:definition "Compound that contains a temporary linkage between a given active substance and a transient carrier group, the latter producing improved physicochemical or pharmacokinetic properties and easily removable in vivo." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier-linked prodrug" .

goldbook:15537 a skos:Concept ;
    skos:definition "Substance that binds to another substance and transfers it from one site to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier substance" .

goldbook:15538 a skos:Concept ;
    skos:definition "Variant of the case control study in which the controls are drawn from the same cohort as the cases but are identified before the cases develop; some of the controls may later become cases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "case cohort study" .

goldbook:15539 a skos:Concept ;
    skos:altLabel "case comparison study",
        "case compeer study",
        "case history study",
        "case referent study",
        "retrospective study" ;
    skos:definition "Study that starts with the identification of persons with the disease (or other outcome variable) of interest, and a suitable control (comparison, reference) group of persons without the disease. The relationship of an attribute to the disease is examined by comparing the diseased and non-diseased with regard to how frequently the attribute is present or, if quantitative, the levels of the attribute, in the two groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "case control study" .

goldbook:15540 a skos:Concept ;
    skos:definition "Behavior marked by excessive and sometimes violent motor activity and excitement, or by generalized inhibition or stupor, that may occur in schizophrenia, mood disorders, or organic brain syndromes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catatonia" .

goldbook:15541 a skos:Concept ;
    skos:definition "Regulated biochemical steps that cells go through involving DNA replication and cell division, usually depicted as a sequential cyclical series of events." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell cycle" .

goldbook:15542 a skos:Concept ;
    skos:definition "State in which an individual reacts with allergic effects caused by the reaction of antigen-specific T-lymphocytes following exposure to a certain substance (allergen) after having been exposed previously to the same substance or chemical group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell-mediated hypersensitivity" .

goldbook:15543 a skos:Concept ;
    skos:definition "Rapid increase in cell number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell proliferation" .

goldbook:15544 a skos:Concept ;
    skos:definition "Cells having specific properties or markers derived from a primary culture or cell line." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell strain" .

goldbook:15545 a skos:Concept ;
    skos:definition "Sample observations for which the complete distribution is not known." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "censored data" .

goldbook:15546 a skos:Concept ;
    skos:altLabel "CRM" ;
    skos:definition "Reference material, accompanied by documentation issued by an authoritative body and referring to valid procedures used to obtain a specified property value with uncertainty and traceability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "certified reference material" .

goldbook:15547 a skos:Concept ;
    skos:definition "Sequence of responsibility for a substance from the manufacturer to the distributor, to the user, or to the person(s) ultimately responsible for waste disposal. This term is also used in controlled transmission of samples from collection to analysis, especially of samples of materials used for medico-legal or forensic purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain of custody" .

goldbook:15548 a skos:Concept ;
    skos:definition "Treatment with a chelating agent to enhance the elimination or reduce the toxicity of a metal ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chelation therapy" .

goldbook:15549 a skos:Concept ;
    skos:definition "Sensations that arise when chemical compounds activate receptor mechanisms for other effectors, such as light, pain, pressure, and heat, in the eye, skin, nose, mouth, and throat; for example, the burning feeling from chili pepper, the cooling from the menthol in mouthwash, and the stinging feeling of carbonation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemesthesis" .

goldbook:15550 a skos:Concept ;
    skos:altLabel "conversion" ;
    skos:definition "Change from one chemical species to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical conversion" .

goldbook:15551 a skos:Concept ;
    skos:definition "Practical certainty that there will be no exposure of organisms to toxic amounts of any substance or group of substances: This implies attaining an acceptably low risk of exposure to potentially toxic substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical safety" .

goldbook:15552 a skos:Concept ;
    skos:definition "Military operations using the toxic properties of chemical agents to kill, injure, or incapacitate human beings, animals, or plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical warfare" .

goldbook:15553 a skos:Concept ;
    skos:definition "Irrational fear of chemicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemophobia" .

goldbook:15554 a skos:Concept ;
    skos:definition "Chemically induced swelling around the eye caused by edema of the conjunctiva." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemosis" .

goldbook:15555 a skos:Concept ;
    skos:definition "Substance used to sterilize mites, insects, rodents, or other animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemosteriliser" .

goldbook:15556 a skos:Concept ;
    skos:altLabel "anticholinesterase" ;
    skos:definition "Substance that inhibits the action of acetylcholinesterase (EC 3.1.1.7) and related enzymes which catalyze the hydrolysis of choline esters: Such a substance causes hyperactivity in parasympathetic nerves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cholinesterase inhibitor" .

goldbook:15557 a skos:Concept ;
    skos:definition "Stainable complex of DNA and proteins present in the nucleus of a eukaryotic cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatin" .

goldbook:15558 a skos:Concept ;
    skos:definition "Abnormality of chromosome number or structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosomal aberration" .

goldbook:15559 a skos:Concept ;
    skos:altLabel "long-term toxicity test" ;
    skos:definition "Study in which organisms are observed during the greater part of the life span and in which exposure to the test agent takes place over the whole observation time or a substantial part thereof." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic toxicity test" .

goldbook:15560 a skos:Concept ;
    skos:definition "Study of the influence of biological rhythms on the toxicity of substances or of the influence of a toxicant on biological rhythms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronotoxicology" .

goldbook:15561 a skos:Concept ;
    skos:definition "Serious illness caused by eating carnivorous fish such as snappers and barracuda that have become contaminated by toxins produced by the microalga, Gambierdiscus toxicus; gastrointestinal symptoms may accompany a wide variety of neurological symptoms, including ataxia, vertigo, flaccid paralysis, respiratory arrest, and reversed perception of hot and cold; the neurological symptoms may persist for many years." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ciguateratoxin poisoning" .

goldbook:15562 a skos:Concept ;
    skos:altLabel "nychthemeral" ;
    skos:definition "Relating to or exhibiting an approximately \\(\\pu{24\\!\\mbox{-}h}\\) periodicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "circadian" .

goldbook:15563 a skos:Concept ;
    skos:definition "Movement of xenobiotic substances in the environment with air flow, river current, sediment flow, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "circulation of substances" .

goldbook:15564 a skos:Concept ;
    skos:definition "Liver disease defined by histological examination and characterized by increased fibrous tissue, abnormal morphological and physiological changes such as loss of functional liver cells, and increased resistance to blood flow through the liver (portal hypertension). Chronic interstitial inflammation and fibrosis of an organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cirrhosis" .

goldbook:15565 a skos:Concept ;
    skos:definition "Describing an organ showing cirrhosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cirrhotic" .

goldbook:15566 a skos:Concept ;
    skos:definition "Formation (or generation) of chromosomal breaks and (or) consequent gain, loss, or rearrangement of pieces of chromosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clastogenesis" .

goldbook:15567 a skos:Concept ;
    skos:definition "Scientific study involving research, education, prevention, and treatment of diseases caused by substances such as drugs and toxins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clinical toxicology" .

goldbook:15568 a skos:Concept ;
    skos:definition "Pertaining to alternate muscular contraction and relaxation in rapid succession." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clonic" .

goldbook:15569 a skos:Concept ;
    skos:definition "A method of sampling in which the population is divided into aggregates (or clusters) of items bound together in a certain manner. A sample of these clusters is taken at random, and all the items which constitute them are included in the sample. A sampling method in which each unit selected is a group of persons (all persons in a city block, a family, etc.) rather than an individual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster sampling" .

goldbook:15570 a skos:Concept ;
    skos:definition "Chemical, physical, or biological factor that intensifies the effect of a carcinogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cocarcinogen" .

goldbook:15571 a skos:Concept ;
    skos:definition "Collection of internationally adopted food standards drawn up by the Codex Alimentarius Commission, the principal body implementing the joint FAO/WHO Food Standards Program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Codex Alimentarius" .

goldbook:15572 a skos:Concept ;
    skos:definition "Component of the population born during a particular period and identified by period of birth so that its characteristics (such as causes of death and numbers still living) can be ascertained as it enters successive time and age periods. The term 'cohort' has broadened to describe any designated group of persons followed or traced over a period of time, as in the term cohort study (prospective study)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cohort" .

goldbook:15573 a skos:Concept ;
    skos:definition "Tabulation and analysis of morbidity or mortality rates in relationship to the ages of a specific group of people (cohort), identified by their birth period, and followed as they pass through different ages during part or all of their life span. In certain circumstances such as studies of migrant populations, cohort analysis may be performed according to duration of residence in a country rather than year of birth, in order to relate health or mortality experience to duration of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cohort analysis" .

goldbook:15574 a skos:Concept ;
    skos:altLabel "concurrent study",
        "follow-up study",
        "incidence study",
        "longitudinal study",
        "prospective study" ;
    skos:definition "Analytic study in epidemiology in which subsets of a defined population can be identified who are, have been, or in the future may be exposed or not exposed, or exposed in different degrees, to a factor or factors hypothesized to influence the probability of occurrence of a given disease or other outcome. The main feature of the method is observation of a large population for a prolonged period (years), with comparison of incidence rates of the given disease in groups that differ in exposure levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cohort study" .

goldbook:15575 a skos:Concept ;
    skos:definition "Simultaneous or successive effect of two or more poisons on the organism by the same route of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combined effect of poisons" .

goldbook:15576 a skos:Concept ;
    skos:definition "Means of measuring DNA damage, particularly DNA strand breaks. A cell is embedded in agar and exposed to a DNA-damaging agent. The cell is then permeabilized with a detergent, and an electric field is applied. If the cell’s genomic DNA has been broken into small fragments, these fragments move out of the cell by electrophoresis and form a streak or 'tail' leading away from the cell which looks like a comet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comet assay" .

goldbook:15577 a skos:Concept ;
    skos:definition "Study of the relationship of genome structure and function across different biological species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comparative genomics" .

goldbook:15578 a skos:Concept ;
    skos:definition "Separate into compartments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compartmentalise" .

goldbook:15579 a skos:Concept ;
    skos:definition "In the context of European Community Council Directive 79/831/EEC, the Sixth Amendment to the European Community Council Directive 67/548/EEC relating to the Classification, Packaging and Labeling of Dangerous Substances, official government organization or group receiving and evaluating notifications of new substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competent authority" .

goldbook:15580 a skos:Concept ;
    skos:definition "Culture of bacteria (or yeast) treated in such a way that their ability to take up DNA molecules without transduction or conjugation has been enhanced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competent bacteria" .

goldbook:15581 a skos:Concept ;
    skos:definition "Complete breakdown of a complex organic compound to carbon dioxide, water, oxides, and oxidative inorganic products such as nitrate or sulfate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complete mineralisation" .

goldbook:15582 a skos:Concept ;
    skos:definition "Simultaneous or successive effect made on an organism by poisons entering from different media, air, water, or food or through the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comprehensive effect of poisons" .

goldbook:15583 a skos:Concept ;
    skos:definition "Application of mathematical and computer models to predict adverse effects and to better understand the mechanism(s) through which a given chemical causes harm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "computational toxicology" .

goldbook:15584 a skos:Concept ;
    skos:altLabel "exposure–effect curve" ;
    skos:definition "Graph of the relation between exposure concentration and the magnitude of the resultant biological change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration–effect curve" .

goldbook:15585 a skos:Concept ;
    skos:altLabel "exposure–effect relationship" ;
    skos:definition "Association between exposure concentration and the resultant magnitude of the continuously graded change produced, either in an individual or in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration–effect relationship" .

goldbook:15586 a skos:Concept ;
    skos:definition "Measurement and its criterion refer to the same point in time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concurrent validity" .

goldbook:15587 a skos:Concept ;
    skos:definition "Situation in which the effects of two processes are not distinguishable from one another: The distortion of the apparent effect of an exposure on risk brought about by the association of other factors which can influence the outcome. Relationship between the effects of two or more causal factors as observed in a set of data, such that it is not logically possible to separate the contribution which any single causal factor has made to an effect. Situation in which a measure of the effect of an exposure on risk is distorted because of the association of exposure with other factor(s) which influence the outcome under study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confounding" .

goldbook:15588 a skos:Concept ;
    skos:altLabel "confounder" ;
    skos:definition "Changing factor that can cause or prevent the outcome of interest, is not an intermediate variable, and is associated with the factor under investigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confounding variable" .

goldbook:15589 a skos:Concept ;
    skos:definition "Mucous membrane that covers the eyeball and lines the under-surface of the eyelid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjunctiva" .

goldbook:15590 a skos:Concept ;
    skos:definition "Inflammation of the conjunctiva." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjunctivitis" .

goldbook:15591 a skos:Concept ;
    skos:definition "Assessment of risk that assumes the worst possible case scenario and therefore gives the highest possible value for risk: Risk management decisions based on this value will maximize safety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conservative assessment of risk" .

goldbook:15592 a skos:Concept ;
    skos:definition "Extent to which a measurement corresponds to theoretical concepts (constructs) concerning the phenomenon under study; for example, if on theoretical grounds, the phenomenon should change with age, a measurement with construct validity would reflect such a change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "construct validity" .

goldbook:15593 a skos:Concept ;
    skos:definition "Chemical that injures the target organism through physical contact and skin absorption rather than through ingestion or inhalation. Pesticide (herbicide) that causes injury to only the plant tissue to which it is applied or which is not appreciably translocated within plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact poison" .

goldbook:15594 a skos:Concept ;
    skos:definition "Process by which possible release, discharge, or spill of a toxic substance during normal use or after an accident is prevented by appropriate action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "containment" .

goldbook:15595 a skos:Concept ;
    skos:definition "Extent to which the measurement incorporates the domain of the phenomenon under study; for example, a measurement of functional health status should embrace activities of daily living, occupational, family, and social functioning, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "content validity" .

goldbook:15596 a skos:Concept ;
    skos:definition "Any condition that renders some particular line of treatment improper or undesirable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contraindication" .

goldbook:15597 a skos:Concept ;
    skos:altLabel "comparison group" ;
    skos:definition "Selected subjects of study, identified as a rule before a study is done, which comprises humans, animals, or other species who do not have the disease, intervention, procedure, or whatever is being studied, but in all other respects are as nearly identical to the test group as possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "control group" .

goldbook:15598 a skos:Concept ;
    skos:definition "Control (individual or group or case) selected to be similar to a study individual or group, or case, in specific characteristics: some commonly used matching variables are age, sex, race, and socioeconomic status." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matched control" .

goldbook:15599 a skos:Concept ;
    skos:definition "Quality rating, based on standard evaluation criteria established by the U.S. Office of Pesticide Programs regulatory agencies, given to toxicological studies after submission by registrants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core grade" .

goldbook:15600 a skos:Concept ;
    skos:definition "Mean of the diameters of all particles in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "count mean diameter" .

goldbook:15601 a skos:Concept ;
    skos:definition "Calculated diameter in a population of particles in a gas or liquid phase above which there are as many particles with larger diameters as there are particles below it with smaller diameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "count median diameter" .

goldbook:15602 a skos:Concept ;
    skos:altLabel "crackles",
        "râles" ;
    skos:definition "Abnormal respiratory sounds heard on auscultation of the chest, produced by passage of air through passages which contain secretion or exudate or which are constricted by spasm or a thickening of their walls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crepitations" .

goldbook:15603 a skos:Concept ;
    skos:definition "Validated set of data used as a basis for judgment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "criterion" .

goldbook:15604 a skos:Concept ;
    skos:definition "Extent to which the measurement correlates with an external criterion of the phenomenon under study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "criterion validity" .

goldbook:15605 a skos:Concept ;
    skos:definition "Concentration of a substance at and above which adverse functional changes, reversible or irreversible, occur in a cell or an organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical concentration" .

goldbook:15606 a skos:Concept ;
    skos:definition "Dose of a substance at and above which adverse functional changes, reversible or irreversible, occur in a cell or an organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical dose" .

goldbook:15607 a skos:Concept ;
    skos:definition "For deterministic effects, the first adverse effect that appears when the threshold (critical) concentration or dose is reached in the critical organ: Adverse effects with no defined threshold concentration are regarded as critical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical effect" .

goldbook:15608 a skos:Concept ;
    skos:definition "Toxic effect used by the USEPA as the basis for a reference dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical end-point" .

goldbook:15609 a skos:Concept ;
    skos:definition "Part of a target population most in need of protection because it is most susceptible to a given toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical group" .

goldbook:15610 a skos:Concept ;
    skos:definition "Organ that first attains the critical concentration of a substance and exhibits the critical effect under specified circumstances of exposure and for a given population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical organ" .

goldbook:15611 a skos:Concept ;
    skos:definition "Mean concentration of a substance in the critical organ at the time the substance reaches its critical concentration in the most sensitive type of cell in the organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical organ concentration" .

goldbook:15612 a skos:Concept ;
    skos:altLabel "disease frequency survey",
        "prevalence study" ;
    skos:definition "Study that examines the relationship between diseases (or other health-related characteristics) and other variables of interest as they exist in a defined population at one particular time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-sectional study" .

goldbook:15613 a skos:Concept ;
    skos:definition "Proportion of a defined group that dies within the specified time period (e.g., month, year)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative death rate" .

goldbook:15614 a skos:Concept ;
    skos:definition "Overall change that occurs after repeated doses of a substance or radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative effect" .

goldbook:15615 a skos:Concept ;
    skos:altLabel "incidence proportion" ;
    skos:definition "Number or proportion of individuals in a group who experience the onset of a health-related event during a specified time interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative incidence" .

goldbook:15616 a skos:Concept ;
    skos:definition "Proportion of the cumulative incidence to the total population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative incidence rate" .

goldbook:15617 a skos:Concept ;
    skos:definition "Value obtained by dividing the cumulative incidence rate in the exposed population by the cumulative incidence rate in the unexposed population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative incidence ratio" .

goldbook:15618 a skos:Concept ;
    skos:definition "Estimate of the total administered amount of a substance that is associated with the death of half a population of animals when the substance is administered repeatedly in doses which are generally fractions of the median lethal dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative median lethal dose" .

goldbook:15619 a skos:Concept ;
    skos:definition "Probability of a common harmful effect associated with concurrent exposure by all relevant pathways and routes of exposure to a group of substances that share a common chemical mechanism of toxicity. Total probability of a harmful effect over time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative risk" .

goldbook:15620 a skos:Concept ;
    skos:definition "Toxin produced by Cyanobacteria, sometimes called blue–green algae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanotoxin" .

goldbook:15621 a skos:Concept ;
    skos:definition "Substances, such as aspirin and ibuprofen, that block the activity of cyclooxygenase (COX), an enzyme that is responsible for the formation of prostanoids (including prostaglandins, prostacyclin, and thromboxane); inhibition of COX can provide relief from inflammation and pain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclooxygenase specific inhibitors" .

goldbook:15622 a skos:Concept ;
    skos:definition "Inactive derivative of cytochrome P450 found in microsomal preparations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytochrome P420" .

goldbook:15623 a skos:Concept ;
    skos:definition "Obsolete term for cytochrome P450 I, A1, and A2, one of the major families of the cytochromes P450 hemoproteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytochrome P448" .

goldbook:15624 a skos:Concept ;
    skos:definition "Fundamental substance or matrix of the cell (within the plasma membrane) which surrounds the nucleus, endoplasmic reticulum, mitochondria, and other organelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytoplasm" .

goldbook:15625 a skos:Concept ;
    skos:definition "Unit of perceived air quality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decipol" .

goldbook:15626 a skos:Concept ;
    skos:definition "Explicit pathophysiological changes following compensation for adverse effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decompensation" .

goldbook:15627 a skos:Concept ;
    skos:definition "Process of rendering harmless (by neutralization, elimination, removal, etc.) a potentially toxic substance in the natural environment, laboratory areas, the workplace, other indoor areas, clothes, food, water, sewage, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decontamination" .

goldbook:15628 a skos:Concept ;
    skos:definition "Enzyme that catalyzes oxidation of compounds by removing hydrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dehydrogenase" .

goldbook:15629 a skos:Concept ;
    skos:altLabel "latent effect" ;
    skos:definition "Consequence occurring after a latent period following the end of exposure to a toxic substance or other harmful environmental factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed effect" .

goldbook:15630 a skos:Concept ;
    skos:definition "Tooth enamel malformations due to excessive fluoride exposure during dental development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dental fluorosis" .

goldbook:15631 a skos:Concept ;
    skos:altLabel "DNA cloning" ;
    skos:definition "Replication of DNA sequences ligated into a suitable vector in an appropriate host organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid cloning" .

goldbook:15632 a skos:Concept ;
    skos:altLabel "DNA repair" ;
    skos:definition "Restoration of the molecular structure of DNA after it has been damaged by a chemical or physical agent: This may involve direct DNA damage reversal, base excision repair, nucleotide excision repair, mismatch repair, or double-strand break repair" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acid repair" .

goldbook:15633 a skos:Concept ;
    skos:definition "A psychic craving for a drug or other substance that may or may not be accompanied by a physical dependency. Reliance on a drug or other substance to maintain health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dependence" .

goldbook:15634 a skos:Concept ;
    skos:definition "Substance causing loss of hair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depilatory" .

goldbook:15635 a skos:Concept ;
    skos:altLabel "cutaneous" ;
    skos:definition "Pertaining to the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dermal" .

goldbook:15636 a skos:Concept ;
    skos:definition "Skin reaction resulting from a single or multiple exposure to a physical or chemical entity at the same site, characterized by the presence of inflammation; it may result in cell death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dermal irritation" .

goldbook:15637 a skos:Concept ;
    skos:definition "Study of the occurrence of disease or other health-related characteristics in populations, including general observations concerning the relationship of disease to basic characteristics such as age, sex, race, occupation, and social class; it may also be concerned with geographic location. The major characteristics in descriptive epidemiology can be classified under the headings: individuals, time, and place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "descriptive epidemiology" .

goldbook:15638 a skos:Concept ;
    skos:definition "Shedding of an outer layer of skin in scales or shreds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desquamation" .

goldbook:15639 a skos:Concept ;
    skos:definition "Estimated measure of the expected harm or loss associated with an adverse event, usually in a manner chosen to facilitate meaningful addition over different events. It is generally the integrated product of arbitrary values of risk and hazard and is often expressed in terms such as costs in U.S. dollars, loss in expected years of life or loss in productivity, and is needed for numerical exercises such as cost-benefit analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detriment" .

goldbook:15640 a skos:Concept ;
    skos:definition "Adverse effects on the developing organism (including structural abnormality, altered growth, or functional deficiency or death) resulting from exposure through conception, gestation (including organogenesis), and postnatally up to the time of sexual maturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "developmental toxicity" .

goldbook:15641 a skos:Concept ;
    skos:definition "Profuse perspiration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diaphoresis" .

goldbook:15642 a skos:Concept ;
    skos:altLabel "discharge release limit",
        "effluent standard",
        "emission standard" ;
    skos:definition "Maximum amount of a pollutant released from a given source to a specified medium which is acceptable under specified circumstances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discharge standard" .

goldbook:15643 a skos:Concept ;
    skos:altLabel "genetic discordance" ;
    skos:definition "Any difference in a character between individuals due to genetic differences such as may occur in dizygotic twins, or between matched pairs in a case cohort study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discordance" .

goldbook:15644 a skos:Concept ;
    skos:definition "Literally, dis-ease, lack of ease; pathological condition that presents a group of symptoms peculiar to it and which establishes the condition as an abnormal entity different from other normal or pathological body states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disease" .

goldbook:15645 a skos:Concept ;
    skos:definition "Natural tendency shown by an individual or group of individuals, including any tendency to acquisition of specific diseases, often due to hereditary factors. Total of the processes of absorption of a chemical into the circulatory systems, distribution throughout the body, biotransformation, and excretion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disposition" .

goldbook:15646 a skos:Concept ;
    skos:definition "Reduction in the amount of a pesticide or other compound that has been applied to plants, soil, etc. (used when it is not clear whether this is by mineralization degradation, binding, or leaching)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissipation" .

goldbook:15647 a skos:Concept ;
    skos:definition "Theoretical volume of a body compartment throughout which a substance is calculated to be distributed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution volume" .

goldbook:15648 a skos:Concept ;
    skos:definition "Excretion of urine, especially in excess." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diuresis" .

goldbook:15649 a skos:Concept ;
    skos:altLabel "micturitic" ;
    skos:definition "Agent that increases urine production." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diuretic" .

goldbook:15650 a skos:Concept ;
    skos:definition "Half life of a fraction of a substance in a specific organ or compartment if it defines approximately the overall clearance rate for that substance at a specific time point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dominant half life" .

goldbook:15651 a skos:Concept ;
    skos:definition "Genetic change occurring in a germ cell that does not cause dysfunction of the gamete but which is lethal to the fertilized egg or developing embryo which develops from it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dominant lethal mutation" .

goldbook:15652 a skos:Concept ;
    skos:altLabel "duplicate diet study" ;
    skos:definition "Study in which test persons consume their ordinary diet but, for each meal, they prepare for subsequent analysis a duplicate portion of all food as prepared, served, and consumed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "duplicate portion sampling method" .

goldbook:15653 a skos:Concept ;
    skos:definition "Two samples taken under the same or comparable conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "duplicate samples" .

goldbook:15654 a skos:Concept ;
    skos:definition "Abnormal, impaired, or incomplete functioning of an organism, organ, tissue, or cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dysfunction" .

goldbook:15655 a skos:Concept ;
    skos:definition "Substance intended to kill parasites living on the exterior of the host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ectoparasiticide" .

goldbook:15656 a skos:Concept ;
    skos:altLabel "elimination half time" ;
    skos:definition "Period taken for the plasma concentration of a substance to decrease by half." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elimination half life" .

goldbook:15657 a skos:Concept ;
    skos:definition "Substance that contributes to the elimination of a poison from an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eliminator" .

goldbook:15658 a skos:Concept ;
    skos:definition "Production by a substance of toxic effects in progeny in the first period of pregnancy between conception and the fetal stage. Any toxic effect on the conceptus as a result of prenatal exposure during the embryonic stages of development: These effects may include malformations and variations, malfunctions, altered growth, prenatal death, and altered postnatal function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryotoxicity" .

goldbook:15659 a skos:Concept ;
    skos:definition "Change in the embryo and the regulation of its development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryotropic effect" .

goldbook:15660 a skos:Concept ;
    skos:definition "Technical and administrative procedures and specifications applied for the monitoring, reduction, or elimination of emissions from a source or exposure to a target." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission and exposure control" .

goldbook:15661 a skos:Concept ;
    skos:definition "Portion of a conjugated metabolite that is derived from a natural product (such as a sugar, amino acid, or other organic acid) of the metabolizing organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocon" .

goldbook:15662 a skos:Concept ;
    skos:definition "Intracellular complex of membranes in which proteins and lipids, as well as molecules for export, are synthesized and in which the biotransformation reactions of the monooxygenase enzyme systems occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endoplasmic reticulum" .

goldbook:15663 a skos:Concept ;
    skos:definition "Pertaining to the layer of flat cells lining the inner surface of blood and lymphatic vessels, and the surface lining of serous and synovial membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endothelial" .

goldbook:15664 a skos:Concept ;
    skos:definition "Intestinal inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enteritis" .

goldbook:15665 a skos:Concept ;
    skos:definition "Cyclical process involving intestinal reabsorption of a substance that has been excreted through the bile, followed by transfer back to the liver, making it available for biliary excretion again." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enterohepatic circulation" .

goldbook:15666 a skos:Concept ;
    skos:definition "Aggregate, at a given moment, of all external conditions and influences to which a system under study is subjected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environment" .

goldbook:15667 a skos:Concept ;
    skos:definition "Adverse effects to the natural environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental damage" .

goldbook:15668 a skos:Concept ;
    skos:altLabel "EEL" ;
    skos:definition "Level (concentration or amount or a time integral of either) of a substance to which an organism or other component of the environment is exposed in its natural surroundings." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental exposure level" .

goldbook:15669 a skos:Concept ;
    skos:definition "Human welfare and its influence by the environment, including technical and administrative measures for improving the human environment from a health point of view." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental health" .

goldbook:15670 a skos:Concept ;
    skos:definition "Estimate of the adverse effects to health or risks likely to follow from a proposed or expected environmental change or development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental health impact assessment" .

goldbook:15671 a skos:Concept ;
    skos:definition "Critical publications of IPCS containing reviews of methodologies and existing knowledge—expressed, if possible, in quantitative terms—of selected substances (or groups of substances) on identifiable, immediate, and long-term effects on human health and welfare." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental health criteria documents" .

goldbook:15672 a skos:Concept ;
    skos:altLabel "environmental sanitation" ;
    skos:definition "Practical control measures used to improve the basic environmental conditions affecting human health, for example, clean water supply, human and animal waste disposal, protection of food from biological contamination, and housing conditions, all of which are concerned with the quality of the human environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental hygiene" .

goldbook:15673 a skos:Concept ;
    skos:definition "Specialty devoted to the prevention and management of environmentally induced injury, illness, and disability, and the promotion of the health of individuals, families, and communities by ensuring a healthy environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental medicine" .

goldbook:15674 a skos:Concept ;
    skos:definition "Actions taken to prevent or minimize adverse effects to the natural environment. Complex of measures including monitoring of environmental pollution, development and practice of environmental protection principles (legal, technical, and hygienic), including risk assessment, risk management, and risk communication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental protection" .

goldbook:15675 a skos:Concept ;
    skos:definition "Pertaining to the upper-middle region of the abdomen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epigastric" .

goldbook:15676 a skos:Concept ;
    skos:definition "Occurring in severe or sudden spasms, as in convulsion or epilepsy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epileptiform" .

goldbook:15677 a skos:Concept ;
    skos:definition "Any tumor derived from epithelium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epithelioma" .

goldbook:15678 a skos:Concept ;
    skos:definition "Slough or dry scab on an area of skin that has been burnt." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eschar" .

goldbook:15679 a skos:Concept ;
    skos:altLabel "EDI" ;
    skos:definition "Prediction of the daily intake of a residue of a potentially harmful agent based on the most realistic estimation of the residue levels in food and the best available food consumption data for a specific population: Residue levels are estimated taking into account known uses of the agent, the range of contaminated commodities, the proportion of a commodity treated, and the quantity of home-grown or imported commodities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estimated daily intake" .

goldbook:15680 a skos:Concept ;
    skos:altLabel "EEC",
        "predicted exposure concentration (PEC)" ;
    skos:definition "Predicted concentration of a substance, typically a pesticide, within an environmental compartment based on estimates of quantities released, discharge patterns, and inherent disposition of the substance (fate and distribution) as well as the nature of the specific receiving ecosystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estimated environmental concentration" .

goldbook:15681 a skos:Concept ;
    skos:altLabel "EEC" ;
    skos:definition "Measured or calculated amount or mass concentration of a substance to which an organism is likely to be exposed, considering exposure by all sources and routes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estimated exposure concentration" .

goldbook:15682 a skos:Concept ;
    skos:altLabel "EED" ;
    skos:definition "Measured or calculated dose of a substance to which an organism is likely to be exposed, considering exposure by all sources and routes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estimated exposure dose" .

goldbook:15683 a skos:Concept ;
    skos:altLabel "EMDI" ;
    skos:definition "Prediction of the maximum daily intake of a residue of a potentially harmful agent based on assumptions of average food consumption per person and maximum residues in the edible portion of a commodity, corrected for the reduction or increase in residues resulting from preparation, cooking, or commercial processing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "estimated maximum daily intake" .

goldbook:15684 a skos:Concept ;
    skos:altLabel "aetiology" ;
    skos:definition "Science dealing with the cause or origin of disease. In individuals, the cause or origin of disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "etiology" .

goldbook:15685 a skos:Concept ;
    skos:definition "Cell or organism with the genetic material packed in a membrane-surrounded structurally discrete nucleus and with well-developed cell organelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eukaryote" .

goldbook:15686 a skos:Concept ;
    skos:altLabel "EINECS" ;
    skos:definition "List of all substances supplied either singly or as components in preparations to persons in a Member State of the European Community on any occasion between 1 January 1971 and 18 September 1981." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "European Inventory of Existing Chemical Substances" .

goldbook:15687 a skos:Concept ;
    skos:definition "Additional or excess risk incurred over the lifetime of an individual by exposure to a toxic substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excess lifetime risk" .

goldbook:15688 a skos:Concept ;
    skos:altLabel "blood substitution" ;
    skos:definition "Method of active artificial elimination of toxicity consisting in complete replacement of blood of the patient by donor blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange transfusion" .

goldbook:15689 a skos:Concept ;
    skos:definition "Amount of substance and (or) its metabolites that is excreted divided by time of excretion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excretion rate" .

goldbook:15690 a skos:Concept ;
    skos:definition "Portion of a conjugated metabolite that is derived from the parent molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exocon" .

goldbook:15691 a skos:Concept ;
    skos:definition "Resulting from causes or derived from materials external to an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exogenous" .

goldbook:15692 a skos:Concept ;
    skos:definition "Layer of flattened epithelial cells external to an organ or tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exothelium" .

goldbook:15693 a skos:Concept ;
    skos:altLabel "EEC",
        "expected exposure concentration (EEC)" ;
    skos:definition "Calculated concentrations of a substance, typically a pesticide, in various environmental compartments based on calculations using maximum-exposure scenarios." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "expected environmental concentration" .

goldbook:15694 a skos:Concept ;
    skos:definition "Living tissue removed from its normal environment and transferred to an artificial medium for growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "explant" .

goldbook:15695 a skos:Concept ;
    skos:definition "Subject to a factor that is under study in the environment, for instance, an environmental hazard." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposed" .

goldbook:15696 a skos:Concept ;
    skos:altLabel "exposed" ;
    skos:definition "People (or other organisms) who have been exposed to a supposed cause of a disease or health state of interest, or possess a characteristic that is a determinant of the health outcome of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposed group" .

goldbook:15697 a skos:Concept ;
    skos:definition "General term defining an administrative substance concentration or intensity of exposure that should not be exceeded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure limit" .

goldbook:15698 a skos:Concept ;
    skos:definition "In a case control study, value obtained by dividing the rate at which persons in the case group are exposed to a risk factor (or to a protective factor) by the rate at which persons in the control group are exposed to the risk factor (or to the protective factor) of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure ratio" .

goldbook:15699 a skos:Concept ;
    skos:definition "Surface on a target where a substance (e.g., a pesticide) is present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure surface" .

goldbook:15700 a skos:Concept ;
    skos:definition "Determination of the level, concentration, or uptake of a potentially toxic compound and (or) its metabolite(s) in biological samples from an organism (blood, urine, hair, etc.) and the interpretation of the results to estimate the absorbed dose or degree of environmental pollution; or the measuring of biochemical effects, usually not direct adverse effects of the substance, and relating them to the quantity of substance absorbed, or to its concentration in the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure test" .

goldbook:15701 a skos:Concept ;
    skos:definition "Generalizability of the results of a particular study, beyond the limits of the population actually studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external validity" .

goldbook:15702 a skos:Concept ;
    skos:definition "Volume within a tissue, outside cells, and excluding vascular and lymphatic space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extracellular space" .

goldbook:15703 a skos:Concept ;
    skos:definition "Volume of fluid outside the cells but within the outer surface of an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extracellular volume" .

goldbook:15704 a skos:Concept ;
    skos:definition "Amount of substance extracted from a source divided by the total contained within the source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction ratio" .

goldbook:15705 a skos:Concept ;
    skos:definition "Probability that an agent produces an observed response, as distinguished from the probability that the response is caused by a spontaneous event unrelated to the agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extra risk" .

goldbook:15706 a skos:Concept ;
    skos:altLabel "ERL" ;
    skos:definition "Refers to a pesticide residue or contaminant arising from environmental sources (including former agricultural uses) other than the use of a pesticide or contaminant substance directly or indirectly on the commodity. It is the maximum concentration of a pesticide residue or contaminant that is recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food, agricultural commodity, or animal feed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraneous residue limit" .

goldbook:15707 a skos:Concept ;
    skos:definition "Involuntary movement disorders mediated by signaling through neurons outside the pyramidal (corticospinal) tract, often describing side effects of psychiatric medications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrapyramidal movement disorders" .

goldbook:15708 a skos:Concept ;
    skos:definition "Ability to conceive and to produce offspring: For litter-bearing species, the number of offspring per litter is used as a measure of fertility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fertility" .

goldbook:15709 a skos:Concept ;
    skos:definition "Produces abnormalities of male or female reproductive functions or impairs reproductive capacity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fertility toxicant" .

goldbook:15710 a skos:Concept ;
    skos:definition "Toxicity to the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fetotoxicity" .

goldbook:15711 a skos:Concept ;
    skos:definition "Abnormal formation of fibrous tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibrosis" .

goldbook:15712 a skos:Concept ;
    skos:definition "Form of confidence limit given as a stated probability, for example, \\(P = \\pu{0.95}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fiducial limit" .

goldbook:15713 a skos:Concept ;
    skos:altLabel "first-order reaction" ;
    skos:definition "Chemical reaction where the initial rate is directly proportional to the concentration of one of the reactants. Any process in which a variable decreases with time at a constant fractional amount." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "first-order chemical reaction" .

goldbook:15714 a skos:Concept ;
    skos:definition "Acute toxicity test in which a substance is tested initially at a small number (3 or 4) predefined doses to identify which produces evident toxicity without lethality: The test may be repeated at one or more higher or lower defined discriminating doses to satisfy the criteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed dose procedure" .

goldbook:15715 a skos:Concept ;
    skos:altLabel "fluoridosis" ;
    skos:definition "Adverse effects of fluoride, as in dental or skeletal fluorosis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorosis" .

goldbook:15716 a skos:Concept ;
    skos:definition "Small groups of cells distinguishable, in appearance or histochemically, from the surrounding tissue: indicative of an early stage of a lesion that may lead to the formation of a neoplastic nodule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foci" .

goldbook:15717 a skos:Concept ;
    skos:definition "Any substance, not normally consumed as a food by itself and not normally used as a typical ingredient of a given food, whether or not it has nutritive value, that is added intentionally to food for a technological (including organoleptic) purpose in the manufacture, processing, preparation, treatment, packing, packaging, transport, or holding of the food. Addition results, or may be reasonably expected to result (directly or indirectly), in the substance or its byproducts becoming a component of, or otherwise affecting, the characteristics of the food to which it is added." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "food additive" .

goldbook:15718 a skos:Concept ;
    skos:definition "Hypersensitivity reaction to substances in the diet to which an individual has previously been sensitized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "food allergy" .

goldbook:15719 a skos:Concept ;
    skos:definition "Physiologically based reproducible, unpleasant (adverse) reaction to a specific food or food ingredient that is not immunologically based." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "food intolerance" .

goldbook:15720 a skos:Concept ;
    skos:definition "Network of food chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "food web" .

goldbook:15721 a skos:Concept ;
    skos:definition "Method of stimulating diuresis based on performing hydrational therapy, sometimes with parallel introduction of diuretics, with the aim of achieving increased clearance of a toxic substance in urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "forced diuresis" .

goldbook:15722 a skos:Concept ;
    skos:definition "Changes in allelic frequencies that occur when a small group is separated from a large population and establishes a colony in a new location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "founder effect" .

goldbook:15723 a skos:Concept ;
    skos:definition "Substance that is vaporized in order to kill or repel pests." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fumigant" .

goldbook:15724 a skos:Concept ;
    skos:definition "Substance obtained from fungi that has an insecticidal effect reflecting the pathogenicity of the fungi for insects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fungus preparation" .

goldbook:15725 a skos:Concept ;
    skos:definition "Substance intended to kill gametes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gametocide" .

goldbook:15726 a skos:Concept ;
    skos:definition "Inflammation of the stomach and intestine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastroenteritis" .

goldbook:15727 a skos:Concept ;
    skos:definition "Pertaining to or communicating with the stomach and intestine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gastrointestinal" .

goldbook:15728 a skos:Concept ;
    skos:definition "Administration of materials directly into the stomach by esophageal intubation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gavage" .

goldbook:15729 a skos:Concept ;
    skos:definition "Map showing the positions in the genome of genes or other genetic markers, either relative to each other or as a physical map of absolute distances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene map" .

goldbook:15730 a skos:Concept ;
    skos:altLabel "GRAS" ;
    skos:definition "Phrase used to describe the USFDA philosophy that justifies approval of food additives that may not meet the usual test criteria for safety but have been used extensively and have not demonstrated that they cause any harm to consumers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generally regarded as safe" .

goldbook:15731 a skos:Concept ;
    skos:altLabel "GMO" ;
    skos:definition "Bacterium, plant, or animal whose DNA has been deliberately altered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetically modified organism" .

goldbook:15732 a skos:Concept ;
    skos:definition "Existence of inter-individual differences in DNA sequences coding for one specific gene, giving rise to different functional and (or) morphological traits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic polymorphism" .

goldbook:15733 a skos:Concept ;
    skos:definition "Predisposition to a particular disease or sensitivity to a substance due to the presence of a specific allele or combination of alleles in an individual’s genome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic susceptibility" .

goldbook:15734 a skos:Concept ;
    skos:definition "Study of chemically or physically induced changes to the structure of DNA, including epigenetic phenomena or mutations that may or may not be heritable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic toxicology" .

goldbook:15735 a skos:Concept ;
    skos:altLabel "axenic animal" ;
    skos:definition "Animal grown under sterile conditions in the period of postnatal development: Such animals are usually obtained by Caesarean operation and kept in special sterile boxes in which there are no viable microorganisms (sterile air, food, and water are supplied)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germ-free animal" .

goldbook:15736 a skos:Concept ;
    skos:definition "Complete failure of gonad development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germinal aplasia" .

goldbook:15737 a skos:Concept ;
    skos:definition "Pertaining to a tuft or cluster, as of a plexus of capillary blood vessels or nerve fibers, especially referring to the capillaries of the glomerular of the kidney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glomerular" .

goldbook:15738 a skos:Concept ;
    skos:definition "Formation of an ultrafiltrate of the blood occurring in the glomerulus of the kidney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glomerular filtration" .

goldbook:15739 a skos:Concept ;
    skos:definition "Volume of ultrafiltrate formed in the kidney tubules from the blood passing through the glomerular capillaries divided by time of filtration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glomerular filtration rate" .

goldbook:15740 a skos:Concept ;
    skos:definition "Inhalation of solvent vapor from plastic cements or other adhesives in order to become intoxicated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glue-sniffing" .

goldbook:15741 a skos:Concept ;
    skos:definition "Specifically and entirely known microfauna and microflora of a specially reared laboratory animal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gnotobiota" .

goldbook:15742 a skos:Concept ;
    skos:altLabel "gnotobiont" ;
    skos:definition "Specially reared laboratory animal whose microflora and microfauna are specifically known in their entirety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gnotobiote" .

goldbook:15743 a skos:Concept ;
    skos:definition "Noncancerous enlargement of the thyroid gland, visible as a swelling at the front of the neck, that is often associated with iodine deficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "goiter" .

goldbook:15744 a skos:Concept ;
    skos:definition "Any substance (such as thiouracil) that induces the formation of a goiter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "goitrogen" .

goldbook:15745 a skos:Concept ;
    skos:definition "Pertaining to effects on sex glands and on the systems that regulate them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gonadotropic" .

goldbook:15746 a skos:Concept ;
    skos:altLabel "GAP" ;
    skos:definition "Nationally authorized safe uses of pesticides under actual conditions necessary for effective and reliable pest control." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "good agricultural practice" .

goldbook:15747 a skos:Concept ;
    skos:definition "Pesticide (herbicide) used for the control of weedy grasses (Gramineae)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graminicide" .

goldbook:15748 a skos:Concept ;
    skos:definition "Dusting or spraying of plants with pesticides by hand, by special machines, or by apparatus fixed to tractors or driven by them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ground treatment of plants" .

goldbook:15749 a skos:Concept ;
    skos:definition "Scientifically judged quantitative value (a concentration or number) of an environmental constituent that ensures aesthetically pleasing air, water, or food and from which no adverse effect is expected concerning noncarcinogenic endpoints, or that gives an acceptably low estimate of lifetime cancer risk from those substances which are proven human carcinogens or carcinogens with at least limited evidence of human carcinogenicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guideline for exposure limits" .

goldbook:15750 a skos:Concept ;
    skos:definition "Quantitative measure (a concentration or a number) of a constituent of an environmental medium that ensures aesthetically pleasing air, water, or food and does not result in a significant risk to the user." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guideline value" .

goldbook:15751 a skos:Concept ;
    skos:definition "Sets of atmospheric concentrations and exposure times that are associated with specific effects of varying degrees of pollution on humans, animals, vegetation, and the environment in general." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guides to air quality" .

goldbook:15752 a skos:Concept ;
    skos:definition "Sets of concentrations, numbers and exposure times that are associated with the specific effects of factors in environmental media on humans, animals, vegetation, and the environment in general." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guides to environmental quality" .

goldbook:15753 a skos:Concept ;
    skos:definition "Component of the work environment, the effect of which on a worker under certain conditions leads to ill health or reduction of working ability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harmful occupational factor" .

goldbook:15754 a skos:Concept ;
    skos:altLabel "noxious substance" ;
    skos:definition "Substance that, following contact with an organism, can cause ill health or adverse effects either at the time of exposure or later in the life of the present and future generations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harmful substance" .

goldbook:15755 a skos:Concept ;
    skos:definition "U.S. OSHA standard requiring all employers to inform employees of the hazard of substances in the workplace and the steps necessary to avoid harm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard communication standard" .

goldbook:15756 a skos:Concept ;
    skos:altLabel "hazard at work",
        "hazardous occupational factor" ;
    skos:definition "Production factor the effect of which on a worker under certain conditions results in injury or some impairment of health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazardous production factor" .

goldbook:15757 a skos:Concept ;
    skos:definition "State of complete physical, mental, and social well-being, and not merely the absence of disease or infirmity. State of dynamic balance in which an individual’s or a group’s capacity to cope with the circumstances of living is at an optimal level. State characterized by anatomical, physiological, and psychological integrity; ability to perform personally valued family, work, and community roles; ability to deal with physical, biological, psychological, and social stress; a feeling of well-being; and freedom from the risk of disease and untimely death. In ecology, a sustainable steady state in which humans and other living organisms can coexist indefinitely." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "health" .

goldbook:15758 a skos:Concept ;
    skos:altLabel "HAL" ;
    skos:definition "In the United States, nonregulatory health-based reference level of chemical traces (usually in ppm, i.e., \\(\\pu{mg L-1}\\)) in drinking water at which there are no adverse health risks when ingested over various periods of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "health advisory level" .

goldbook:15759 a skos:Concept ;
    skos:definition "Maximum concentration or intensity of exposure that can be tolerated without significant effect (based on only scientific and not economic evidence concerning exposure levels and associated health effects)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "health-based exposure limit" .

goldbook:15760 a skos:Concept ;
    skos:definition "Any factor or exposure that may adversely affect health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "health hazard" .

goldbook:15761 a skos:Concept ;
    skos:definition "Epidemiological phenomenon observed initially in studies of occupational diseases: Workers usually exhibit lower overall disease and death rates than the general population, due to the fact that the old, severely ill, and disabled are ordinarily excluded from employment. Death rates in the general population may be inappropriate for comparison, if this effect is not taken into account." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "healthy worker effect" .

goldbook:15762 a skos:Concept ;
    skos:definition "Vomiting of blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hematemesis" .

goldbook:15763 a skos:Concept ;
    skos:definition "Adverse changes in blood caused by exposure to chemicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hematotoxicity" .

goldbook:15764 a skos:Concept ;
    skos:definition "Presence of blood in the urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hematuria" .

goldbook:15766 a skos:Concept ;
    skos:definition "Hereditary disorder affecting iron metabolism in which excessive amounts of iron accumulate in the body tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemochromatosis" .

goldbook:15767 a skos:Concept ;
    skos:definition "Presence of free hemoglobin in the urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemoglobinuria" .

goldbook:15768 a skos:Concept ;
    skos:definition "Substance that damages the membrane of erythrocytes causing the release of hemoglobin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemolysin" .

goldbook:15769 a skos:Concept ;
    skos:definition "Release of hemoglobin from erythrocytes, and its appearance in the plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemolysis" .

goldbook:15770 a skos:Concept ;
    skos:definition "Passing blood through a column of charcoal or adsorbent resin for the removal of drugs or toxins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemoperfusion" .

goldbook:15771 a skos:Concept ;
    skos:definition "Insoluble iron(III) hydroxide-based pigment deposited in cells in conditions of iron overload." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemosiderin" .

goldbook:15772 a skos:Concept ;
    skos:definition "Pertaining to the liver." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hepatic" .

goldbook:15773 a skos:Concept ;
    skos:definition "Poisonous to liver cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hepatotoxic" .

goldbook:15774 a skos:Concept ;
    skos:definition "Substance intended to kill plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "herbicide" .

goldbook:15775 a skos:Concept ;
    skos:definition "Organism that has different allelic forms of a specified gene on each of a pair of homologous chromosomes or describing the genome of that organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterozygote" .

goldbook:15776 a skos:Concept ;
    skos:definition "Graphical method for analyzing binding of a molecule \\(\\ce{A}\\) to a macromolecule \\(\\ce{P}\\) with \\(n\\) binding sites. A Hill plot of \\(\\log[\\theta/(1 - \\theta)]\\) vs. \\(\\log[\\ce{A}]\\) has a slope of 1 if binding is noncooperative and \\(\\gt 1\\) for cooperative binding, where \\(\\theta = [\\ce{A}]_{\\rm{bound}}/n[\\ce{P}]_{\\rm{total}}\\) is the fraction of sites occupied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hill plot" .

goldbook:15777 a skos:Concept ;
    skos:definition "Germ cell layer of the embryo from which a given adult tissue develops." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histogenic origin" .

goldbook:15778 a skos:Concept ;
    skos:definition "Study (usually microscopic) of the anatomy of tissues and their cellular and subcellular structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histology" .

goldbook:15779 a skos:Concept ;
    skos:definition "Microscopic pathological study of the anatomy and cell structure of tissues in disease to reveal abnormal or adverse structural changes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histopathology" .

goldbook:15780 a skos:Concept ;
    skos:definition "Toxicity that follows a single exposure to a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hit-and-run effect" .

goldbook:15781 a skos:Concept ;
    skos:definition "Similarity of anatomical structures in different species because of shared ancestry Similarity of DNA or RNA nucleotide sequences, or of protein amino-acid sequences, supporting the hypothesis that they share a common ancestor.Note: Homology among DNA or RNA nucleotide sequences, or among protein amino-acid sequences, is often concluded on the basis of sequence similarity. In general, if there are almost identical sequences, it is likely that they are homologous. However, it is possible that highly similar sequences were not derived from a common ancestor, i.e., they are similar but not homologous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homology" .

goldbook:15782 a skos:Concept ;
    skos:definition "Organism that has the same allelic form of a specified gene on each of a pair of homologous chromosomes or describing the genome of that organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homozygote" .

goldbook:15783 a skos:Concept ;
    skos:definition "Interrelationship between humans and the entire environment—physical, biological, socioeconomic, and cultural, including the interrelationships between individual humans or groups of humans and other human groups or groups of other species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human ecology" .

goldbook:15784 a skos:Concept ;
    skos:definition "Human dose of an agent that is believed to induce the same magnitude of a toxic effect that the known animal dose has induced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human equivalent dose" .

goldbook:15785 a skos:Concept ;
    skos:definition "Generic value of exposure to a substance, or a group of substances falling within a defined structural class, below which there is expected to be no appreciable risk to human health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "human exposure threshold" .

goldbook:15786 a skos:Concept ;
    skos:definition "Science of health and its preservation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hygiene" .

goldbook:15787 a skos:Concept ;
    skos:definition "Prefix meaning above or excessive: when used with the suffix '-emia' refers to blood and with the suffix '-uria' refers to urine, for example, 'hyperbilirubinemia'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyper-" .

goldbook:15788 a skos:Concept ;
    skos:definition "Excessive amount of blood in any part of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperemia" .

goldbook:15789 a skos:Concept ;
    skos:definition "Ingestion or administration of nutrients in excess of optimal amounts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperalimentation" .

goldbook:15790 a skos:Concept ;
    skos:definition "Excessive concentration of bilirubin in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperbilirubinemia" .

goldbook:15791 a skos:Concept ;
    skos:definition "Excessive concentration of calcium in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypercalcemia" .

goldbook:15792 a skos:Concept ;
    skos:definition "Excessive concentration of glucose in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperglycemia" .

goldbook:15793 a skos:Concept ;
    skos:definition "Excessive concentration of potassium in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperkalemia" .

goldbook:15794 a skos:Concept ;
    skos:definition "Excessive concentration of sodium in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypernatremia" .

goldbook:15795 a skos:Concept ;
    skos:definition "Abnormally increased parathyroid gland activity that affects, and is affected by, plasma calcium concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperparathyroidism" .

goldbook:15796 a skos:Concept ;
    skos:definition "Persistently high blood pressure in the arteries or in a circuit, for example, pulmonary hypertension or hepatic portal hypertension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypertension" .

goldbook:15797 a skos:Concept ;
    skos:definition "Condition resulting from the ingestion of an excess of one or more vitamins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypervitaminosis" .

goldbook:15798 a skos:Concept ;
    skos:definition "Prefix meaning under, deficient: when used with the suffix '-emia' refers to blood and with the suffix '-uria' refers to urine, for example, 'hypocalcemia'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypo-" .

goldbook:15799 a skos:Concept ;
    skos:definition "Abnormally low calcium concentration in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypocalcemia" .

goldbook:15800 a skos:Concept ;
    skos:definition "Abnormally low potassium concentration in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypokalemia" .

goldbook:15801 a skos:Concept ;
    skos:definition "Abnormally low magnesium concentration in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypomagnesemia" .

goldbook:15802 a skos:Concept ;
    skos:definition "Abnormally low sodium concentration in the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyponatremia" .

goldbook:15803 a skos:Concept ;
    skos:definition "Pertaining to an abnormally decreased volume of circulating fluid (plasma) in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypovolemic" .

goldbook:15804 a skos:Concept ;
    skos:definition "Any adverse condition resulting from medical treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iatrogenic" .

goldbook:15805 a skos:Concept ;
    skos:definition "Excess of bile pigment in the blood and consequent deposition and retention of bile pigment in the skin and the sclera." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "icterus" .

goldbook:15806 a skos:Concept ;
    skos:definition "Genetically based unusually high sensitivity of an organism to the effect of certain substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "idiosyncrasy" .

goldbook:15807 a skos:Concept ;
    skos:altLabel "IDLHC" ;
    skos:definition "According to the U.S. NIOSH, the maximum exposure concentration from which one could escape within \\(\\pu{30 min}\\) without any escape-impairing symptoms or any irreversible health effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immediately-dangerous-to-life-or-health-concentration" .

goldbook:15808 a skos:Concept ;
    skos:definition "Phrase applied to data generated and analyzed using computer modeling and information technology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in silico" .

goldbook:15809 a skos:Concept ;
    skos:definition "Measure of the frequency at which new events occur in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incidence rate" .

goldbook:15810 a skos:Concept ;
    skos:definition "Quantity value provided by a measuring instrument or a measuring system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indication" .

goldbook:15811 a skos:Concept ;
    skos:definition "Exposure to a substance in a medium or vehicle other than the one originally receiving the substance. Exposure of people to a substance by contact with a person directly exposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect exposure" .

goldbook:15812 a skos:Concept ;
    skos:altLabel "IPD",
        "personal protective device (PPD)",
        "personal protective equipment (PPE)" ;
    skos:definition "Device for individual use for protection of the whole body, eyes, respiratory pathways, or skin of workers against hazardous and harmful production factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "individual protective device" .

goldbook:15813 a skos:Concept ;
    skos:definition "Probability that an individual person will experience an adverse effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "individual risk" .

goldbook:15814 a skos:Concept ;
    skos:definition "Substance that is not generally reactive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inert chemical" .

goldbook:15815 a skos:Concept ;
    skos:definition "Any intentionally added ingredient of a mixture that does not contribute to the desired biological effect: This definition does not include impurities and does not imply that the inert ingredient has no biological effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inert ingredient" .

goldbook:15816 a skos:Concept ;
    skos:definition "Therapeutic introduction of a fluid other than blood, as a (usually saline) solution, into a vein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infusion" .

goldbook:15817 a skos:Concept ;
    skos:definition "Process of taking food and drink into the body by mouth. Process of taking in particles by a phagocytic cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ingestion" .

goldbook:15818 a skos:Concept ;
    skos:definition "Act of drawing in of air, vapor, or gas and any suspended particulates into the lung." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhalation" .

goldbook:15819 a skos:Concept ;
    skos:definition "Class of compounds for which there is unequivocal evidence of biodegradation (primary or ultimate) in any test of biodegradability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inherently biodegradable" .

goldbook:15820 a skos:Concept ;
    skos:definition "Amount of a substance that is taken into the body, regardless of whether or not it is absorbed: The total daily intake is the sum of the daily intake by an individual from food, drinking-water, and inhaled air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intake" .

goldbook:15821 a skos:Concept ;
    skos:definition "Parameter (such as body weight or temperature) characterizing the overall changes in the general state of the organism exposed to a toxic substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integral indicator of toxic effect" .

goldbook:15822 a skos:Concept ;
    skos:altLabel "discontinuous effect" ;
    skos:definition "Biological change that comes and goes at intervals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermittent effect" .

goldbook:15823 a skos:Concept ;
    skos:definition "Selection and comparison of index and comparison groups in such a manner that, apart from sampling error, the observed differences between these groups with respect to dependent variables under study may be attributed only to the hypothesized effect under investigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal validity" .

goldbook:15824 a skos:Concept ;
    skos:definition "Estimation of a value between two known data points." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interpolation" .

goldbook:15825 a skos:Concept ;
    skos:definition "Evaluation of the observations from an investigation or study in order to determine their significance for human health, for the environment or for both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interpretation" .

goldbook:15826 a skos:Concept ;
    skos:definition "Process of extrapolating from the doses of one animal species to another, for example, from rodent dose to human equivalent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interspecies dose conversion" .

goldbook:15827 a skos:Concept ;
    skos:definition "Aqueous solution filling the narrow spaces between cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interstitial fluid" .

goldbook:15828 a skos:Concept ;
    skos:definition "Chronic form of pneumonia involving increase of the interstitial tissue and decrease of the functional lung tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interstitial pneumonia" .

goldbook:15829 a skos:Concept ;
    skos:definition "Epidemiological investigation designed to test a hypothesized cause–effect relationship by intentional change of a supposed causal factor in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intervention study" .

goldbook:15830 a skos:Concept ;
    skos:definition "Absorption further down the intestinal tract of a substance or substances that have been absorbed before and subsequently excreted into the intestinal tract, usually through the bile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intestinal reabsorption" .

goldbook:15831 a skos:Concept ;
    skos:definition "Poisoning: pathological process with clinical signs and symptoms caused by a substance of exogenous or endogenous origin. Drunkenness following consumption of beverages containing ethanol or other compounds affecting the central nervous system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intoxication" .

goldbook:15832 a skos:Concept ;
    skos:definition "Maximal stimulatory effect induced by a compound in relation to that of a given reference compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic activity" .

goldbook:15833 a skos:Concept ;
    skos:definition "Volume of plasma or blood from which a substance is completely removed in a period of time under unstressed conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic clearance" .

goldbook:15834 a skos:Concept ;
    skos:definition "Specific protein required for the absorption of \\(\\ce{vitamin B_{12}}\\) and secreted by cells in the gastric glands of the stomach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic factor" .

goldbook:15835 a skos:Concept ;
    skos:definition "Change from normal structure or function that persists or progresses after cessation of exposure of the organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irreversible alteration" .

goldbook:15836 a skos:Concept ;
    skos:definition "n., Substance that causes inflammation following immediate, prolonged, or repeated contact with skin, mucous membrane, or other biological material. Note: A substance capable of causing inflammation on first contact is called a primary irritant. adj., Causing inflammation following immediate, prolonged, or repeated contact with skin, mucous membrane, or other tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irritant" .

goldbook:15837 a skos:Concept ;
    skos:definition "Denoting a liquid exerting the same osmotic pressure or chemical potential of water (water potential) as another liquid with which it is being compared." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotonic" .

goldbook:15838 a skos:Concept ;
    skos:definition "Illness (renal osteomalacia) observed in the Toyama prefecture of Japan, resulting from the ingestion of cadmium-contaminated rice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "itai-itai disease" .

goldbook:15839 a skos:Concept ;
    skos:definition "Pathological condition characterized by deposition of bile pigment in the skin and mucous membranes, including the conjunctivae, resulting in yellow appearance of the patient or animal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "jaundice" .

goldbook:15840 a skos:Concept ;
    skos:definition "Simultaneous or successive effect of factors of diverse types (chemical, physical, biological) on an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "joint effect" .

goldbook:15841 a skos:Concept ;
    skos:definition "Semiochemical that is produced by one organism inducing a response in an organism of another species that is unfavorable to the emitter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kairomone" .

goldbook:15842 a skos:Concept ;
    skos:definition "Branch of chemistry concerned with measuring and studying rates of chemical reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetics" .

goldbook:15843 a skos:Concept ;
    skos:definition "Pathological increase in the production of ketone bodies, for example, following blockage or failure of carbohydrate metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketosis" .

goldbook:15844 a skos:Concept ;
    skos:definition "Technique used to decrease the expression of a particular gene in a cell or living organism in order to define its function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "knock-down" .

goldbook:15845 a skos:Concept ;
    skos:definition "Technique used to express an exogenous gene or to overexpress an endogenous gene in a living organism in order to define its function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "knock-in" .

goldbook:15846 a skos:Concept ;
    skos:definition "Technique used to inactivate a particular gene in a living organism in order to define its function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "knock-out" .

goldbook:15847 a skos:Concept ;
    skos:altLabel "lachrymator" ;
    skos:definition "Substance that irritates the eyes and causes the production of tears or increases the flow of tears." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lacrimator" .

goldbook:15848 a skos:Concept ;
    skos:definition "Substance intended to kill larvae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "larvicide" .

goldbook:15849 a skos:Concept ;
    skos:definition "Reflex spasmodic closure of the sphincter of the larynx, particularly the glottic sphincter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laryngospasm" .

goldbook:15850 a skos:Concept ;
    skos:definition "Weakness; exhaustion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lassitude" .

goldbook:15851 a skos:Concept ;
    skos:definition "Irrigation or washing out of a hollow organ or cavity such as the stomach, intestines, or lungs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lavage" .

goldbook:15852 a skos:Concept ;
    skos:altLabel "cathartic",
        "purgative" ;
    skos:definition "Substance that causes evacuation of the intestinal contents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laxative" .

goldbook:15853 a skos:Concept ;
    skos:altLabel "painters’ colic" ;
    skos:definition "Chronic intestinal pains and constipation caused by lead poisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lead colic" .

goldbook:15854 a skos:Concept ;
    skos:definition "Area of pathologically altered tissue. Injury or wound. Infected patch of skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lesion" .

goldbook:15856 a skos:Concept ;
    skos:definition "Subjection to a potentially toxic substance during the whole lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "life-long exposure" .

goldbook:15857 a skos:Concept ;
    skos:definition "Substance intended to kill mollusks including the gastropod mollusk, Limax." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limacide" .

goldbook:15858 a skos:Concept ;
    skos:definition "According to the USEPA’s Guidelines for Carcinogen Risk Assessment, 'limited evidence' is a collection of facts and accepted scientific inferences that suggests that an agent may be causing an effect, but this suggestion is not strong enough to be considered established fact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limited evidence" .

goldbook:15859 a skos:Concept ;
    skos:definition "Sequence of steps in which (a) a multistage model is fitted to tumor incidence data; (b) the maximum linear term consistent with the data is calculated; (c) the low-dose slope of the dose–response function is equated to the coefficient of the maximum linear term; and (d) the resulting slope is then equated to the upper bound of potency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linearised multistage model" .

goldbook:15860 a skos:Concept ;
    skos:altLabel "gross pathology" ;
    skos:definition "Study of changes associated with disease that are visible to the naked eye without the need for a microscope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroscopic pathology" .

goldbook:15861 a skos:Concept ;
    skos:definition "Smoke that is inhaled by the smoker." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mainstream smoke" .

goldbook:15862 a skos:Concept ;
    skos:definition "Vague feeling of bodily discomfort." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "malaise" .

goldbook:15863 a skos:Concept ;
    skos:definition "Population of cells showing both uncontrolled growth and a tendency to invade and destroy other tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "malignancy" .

goldbook:15864 a skos:Concept ;
    skos:definition "Emotional disorder (mental illness) characterized by an expansive and elated state (euphoria), rapid speech, flight of ideas, decreased need for sleep, distractibility, grandiosity, poor judgment, and increased motor activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mania" .

goldbook:15865 a skos:Concept ;
    skos:altLabel "MOE",
        "margin of safety (MOS)" ;
    skos:definition "Ratio of the no-observed-adverse-effect level (NOAEL) to the theoretical or estimated exposure dose (EED) or concentration (EEC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "margin of exposure" .

goldbook:15866 a skos:Concept ;
    skos:definition "Diameter of a spherical particle with a mass equal to the mean mass of all the particles in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass mean diameter" .

goldbook:15867 a skos:Concept ;
    skos:definition "Diameter of a spherical particle with the median mass of all the particles in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass median diameter" .

goldbook:15868 a skos:Concept ;
    skos:altLabel "peak daily average concentration of an air pollutant" ;
    skos:definition "Highest of the average daily concentrations recorded at a definite point of measurement during a certain period of observation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum average daily concentration of an atmospheric pollutant" .

goldbook:15869 a skos:Concept ;
    skos:altLabel "MCL" ;
    skos:definition "Under the Safe Drinking Water Act (USA), primary MCL is a regulatory concentration for drinking water which takes into account both adverse effects (including sensitive populations) and technological feasibility (including natural background levels): Secondary MCL is a regulatory concentration based on 'welfare', such as taste and staining, rather than health, but also takes into account technical feasibility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum contaminant level" .

goldbook:15870 a skos:Concept ;
    skos:altLabel "MEL" ;
    skos:definition "Occupational exposure limit legally defined in the United Kingdom under COSHH as the maximum concentration of an airborne substance, averaged over a reference period, to which employees may be exposed by inhalation under any circumstances, and set on the advice of the HSC Advisory Committee on Toxic Substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum exposure limit" .

goldbook:15871 a skos:Concept ;
    skos:altLabel "MRL" ;
    skos:definition "Maximum contents of a pesticide residue (expressed as \\(\\pu{mg kg-1}\\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted in or on food commodities and animal feeds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum residue limit" .

goldbook:15872 a skos:Concept ;
    skos:altLabel "MRL" ;
    skos:definition "Maximum contents of a drug residue (expressed as \\(\\pu{mg kg-1}\\) or \\(\\pu{\\upmu g kg-1}\\) fresh weight) recommended by the Codex Alimentarius Commission to be legally permitted or recognized as acceptable in or on food commodities and animal feeds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum residue limit for veterinary drugs" .

goldbook:15873 a skos:Concept ;
    skos:altLabel "maximum rate" ;
    skos:definition "In Michaelis–Menten kinetics, the maximum rate of conversion of a substrate when its concentration is not rate-limiting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum velocity" .

goldbook:15874 a skos:Concept ;
    skos:altLabel "Mad Hatter syndrome" ;
    skos:definition "Chronic poisoning caused by exposure to mercury, often by breathing its vapor but also by skin absorption and, less commonly, by ingestion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mercurialism" .

goldbook:15875 a skos:Concept ;
    skos:definition "Malignant tumor of the mesothelium of the pleura, pericardium, or peritoneum, that may be caused by exposure to asbestos fibers and some other fibers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesothelioma" .

goldbook:15876 a skos:Concept ;
    skos:definition "Proteins that catalyze chemical transformations of body constituents and, in more common usage, of xenobiotics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolic enzymes" .

goldbook:15877 a skos:Concept ;
    skos:definition "Analysis and theoretical reconstruction of the way in which the body deals with a specific substance, showing the proportion of the intake that is absorbed, the proportion that is stored and in what tissues, the rate of breakdown in the body and the subsequent fate of the metabolic products, and the rate at which it is eliminated by different organs as unchanged substance or metabolites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolic model" .

goldbook:15878 a skos:Concept ;
    skos:definition "Biotransformation of a substance that takes place within a living organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolic transformation" .

goldbook:15879 a skos:Concept ;
    skos:definition "Movement of bacteria or body cells, especially cancer cells, from one part of the body to another, resulting in change in location of a disease or of its symptoms from one part of the body to another. Growth of pathogenic microorganisms or of abnormal cells distant from the site of their origin in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metastasis" .

goldbook:15880 a skos:Concept ;
    skos:altLabel "methaemoglobin" ;
    skos:definition "Derivative of hemoglobin that is formed when the iron(II) in the heme porphyrin is oxidized to iron(III); this derivative cannot transport dioxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "methemoglobin" .

goldbook:15881 a skos:Concept ;
    skos:altLabel "methaemoglobinaemia" ;
    skos:definition "Presence of methaemoglobin in the blood in greater than normal proportion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "methemoglobinaemia" .

goldbook:15882 a skos:Concept ;
    skos:altLabel "methaemoglobin-forming substance" ;
    skos:definition "Substance capable of oxidizing directly or indirectly the iron(II) in hemoglobin to iron(III) to form methemoglobin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "methemoglobin-forming substance" .

goldbook:15883 a skos:Concept ;
    skos:definition "Chronic presence of albumin in slight excess in urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microalbuminuria" .

goldbook:15884 a skos:Concept ;
    skos:definition "Early or subclinical effects of exposure to elemental mercury detected at the low exposure levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micromercurialism" .

goldbook:15885 a skos:Concept ;
    skos:definition "Chronic presence of microprotein (alpha-1 and beta-2 microglobulin) in blood, indicating proximal renal tubule damage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microproteinaemia" .

goldbook:15886 a skos:Concept ;
    skos:definition "Taking an aliquot of a flowing liquid, such as urine, avoiding initial and terminal flow periods which are likely to be unrepresentative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "midstream sampling" .

goldbook:15887 a skos:Concept ;
    skos:altLabel "MRL" ;
    skos:definition "Estimate of the daily human exposure to a hazardous substance that is likely to be without appreciable risk of adverse noncancer health effects over a specified duration of exposure: This substance-specific estimate is used by ATSDR health assessors to identify contaminants and potential health effects that may be of concern at hazardous waste sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimal risk level" .

goldbook:15888 a skos:Concept ;
    skos:definition "Liquid substances capable of mixing without separation into two phases; refers to liquid mixtures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miscible" .

goldbook:15889 a skos:Concept ;
    skos:definition "Substance intended to kill mites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miticide" .

goldbook:15890 a skos:Concept ;
    skos:definition "Eukaryote cytoplasmic organelle that is bounded by an outer membrane and an inner membrane; the inner membrane has folds called cristae that are the center of ATP synthesis in oxidative phosphorylation in the animal cell and supplement ATP synthesis by the chloroplasts in photosynthetic cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitochondrion" .

goldbook:15891 a skos:Concept ;
    skos:altLabel "limacide",
        "molluscicide" ;
    skos:definition "Substance intended to kill mollusks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molluskicide" .

goldbook:15892 a skos:Concept ;
    skos:altLabel "mixed-function oxidase (MFO)" ;
    skos:definition "Enzyme that catalyzes reactions between an organic compound and molecular oxygen in which one atom of the oxygen molecule is incorporated into the organic compound and one atom is reduced to water; involved in the metabolism of many natural and foreign compounds giving both unreactive products and products of different or increased toxicity from that of the parent compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monooxygenase" .

goldbook:15893 a skos:Concept ;
    skos:definition "Any departure, subjective or objective, from a state of physiological or psychological well-being: In this sense, 'sickness', 'illness', and 'morbid condition' are similarly defined and synonymous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morbidity" .

goldbook:15894 a skos:Concept ;
    skos:definition "Term (to be avoided) used loosely to refer to incidence or prevalence rates of disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morbidity rate" .

goldbook:15895 a skos:Concept ;
    skos:definition "Method for the estimation of the prevalence and (or) incidence of a disease or diseases in a population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morbidity survey" .

goldbook:15896 a skos:Concept ;
    skos:definition "Investigation dealing with death rates or proportion of deaths attributed to specific causes as a measure of response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mortality study" .

goldbook:15897 a skos:Concept ;
    skos:definition "Process of removal of particles from the bronchi of the lungs in a mucus stream moved by cilia, thus contributing to uptake from the gastrointestinal tract." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucociliary transport" .

goldbook:15898 a skos:Concept ;
    skos:definition "Product of a compartmental analysis requiring more than two compartments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicompartment model" .

goldbook:15899 a skos:Concept ;
    skos:definition "Illness with pathogenesis dependent on complex interplay of genetic and (or) environmental factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multifactorial disease" .

goldbook:15900 a skos:Concept ;
    skos:altLabel "multiphasic screening" ;
    skos:definition "Procedure that has evolved by combining single screening tests, and is the logical corollary of mass screening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple screening" .

goldbook:15901 a skos:Concept ;
    skos:definition "Of a cell, capable of giving rise to several different kinds of structure or types of cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multipotent" .

goldbook:15902 a skos:Concept ;
    skos:definition "Cluster sampling with more than two stages, each sampling being made on aggregates (or clusters) in which the clusters already obtained by the preceding sampling have been divided." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multistage cluster sampling" .

goldbook:15903 a skos:Concept ;
    skos:definition "Dose–response model for cancer death estimation of the form \\[P = 1 - \\exp [-(q_{0} + q_{1}d_{1} + q_{2}d_{2} + \\ldots + q_{k}d_{k})]\\] where \\(P\\) is the probability of cancer death from a continuous dose rate, \\(d_{i}\\) , of group (or stage) \\(i = 0, 1, 2 \\ldots\\), the \\(q\\)’s are constants, and \\(k\\) is the number of dose groups (or, if less than the number of dose groups, \\(k\\) is the number of biological stages believed to be required in the carcinogenesis process). With the multistage model, it is assumed that cancer is initiated by cell mutations in a finite series of steps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multistage model" .

goldbook:15904 a skos:Concept ;
    skos:definition "Of or belonging to the family of rats and mice (Muridae)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "murine" .

goldbook:15905 a skos:Concept ;
    skos:definition "Pain or tenderness in a muscle or group of muscles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myalgia" .

goldbook:15906 a skos:Concept ;
    skos:definition "Muscular weakness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "myasthenia" .

goldbook:15907 a skos:Concept ;
    skos:definition "Toxin produced by a fungus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mycotoxin" .

goldbook:15908 a skos:Concept ;
    skos:definition "Scientific discipline involving the study of the actual or potential danger presented by the harmful effects of nanoparticles on living organisms and ecosystems, of the relationship of such harmful effects to exposure, and of the mechanisms of action, diagnosis, prevention, and treatment of intoxications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanotoxicology" .

goldbook:15909 a skos:Concept ;
    skos:altLabel "saluretic" ;
    skos:definition "Substance increasing the rate of excretion of sodium ion in the urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natriuretic" .

goldbook:15910 a skos:Concept ;
    skos:definition "Presence of a substance in nature, as distinct from presence resulting from inputs from human activities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural occurrence" .

goldbook:15911 a skos:Concept ;
    skos:definition "Probability of adverse effects occurring that can reasonably be described as trivial. Probability of adverse effects occurring that is so low that it cannot be reduced appreciably by increased regulation or investment of resources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negligible risk" .

goldbook:15912 a skos:Concept ;
    skos:altLabel "nematocide" ;
    skos:definition "Substance intended to kill nematodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nematicide" .

goldbook:15913 a skos:Concept ;
    skos:definition "New and abnormal formation of tissue as a tumor or growth by cell proliferation that is faster than normal and continues after the initial stimulus that initiated the proliferation has ceased." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neoplasia" .

goldbook:15914 a skos:Concept ;
    skos:definition "Inflammation of the kidney, leading to kidney failure, usually accompanied by proteinuria, hematuria, edema, and hypertension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nephritis" .

goldbook:15915 a skos:Concept ;
    skos:altLabel "renopathy" ;
    skos:definition "Any disease or abnormality of the kidney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nephropathy" .

goldbook:15916 a skos:Concept ;
    skos:definition "Disease of the kidneys marked by degeneration of renal tubular epithelium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nephrosis" .

goldbook:15917 a skos:Concept ;
    skos:definition "Chemically harmful to the cells of the kidney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nephrotoxic" .

goldbook:15918 a skos:Concept ;
    skos:definition "Adverse effects occurring when the generation of reactive nitrogen species in a system exceeds the system’s ability to neutralize and eliminate them; nitrosative stress may lead to nitrosylation reactions that can alter protein structure, thus inhibiting normal function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrosative stress" .

goldbook:15919 a skos:Concept ;
    skos:definition "This expression is applicable to a substance for which the available information is not sufficient to establish its safety, or when the specifications for identity and purity are not adequate, or when the available data show that the substance is hazardous and should not be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no-acceptable-daily-intake-allocated" .

goldbook:15920 a skos:Concept ;
    skos:definition "Small node or boss that is solid and can be detected by touch." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nodule" .

goldbook:15921 a skos:Concept ;
    skos:altLabel "NED",
        "subthreshold dose" ;
    skos:definition "Amount of a substance that has no effect on the organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no-effect dose" .

goldbook:15922 a skos:Concept ;
    skos:altLabel "NEL" ;
    skos:definition "Maximum dose (of a substance) that produces no detectable changes under defined conditions of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no-effect level" .

goldbook:15923 a skos:Concept ;
    skos:definition "Change in the chemical or physical nature of a substance occurring as a result of physicochemical conditions and independent of any biological system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-bioenvironmental transformation" .

goldbook:15924 a skos:Concept ;
    skos:definition "Electromagnetic radiation of low energy that is not capable of causing ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonionising radiation" .

goldbook:15925 a skos:Concept ;
    skos:definition "Environmental exposure outside the workplace to substances that are otherwise associated with particular work environments and (or) activities and processes that occur there." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonoccupational exposure" .

goldbook:15927 a skos:Concept ;
    skos:definition "Associated with a hospital or infirmary, especially used of diseases that may result from treatment in such an institution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nosocomial" .

goldbook:15928 a skos:Concept ;
    skos:definition "Procedure for evaluating the dietary intake of a large number of people." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nutritional table method" .

goldbook:15929 a skos:Concept ;
    skos:altLabel "circadian" ;
    skos:definition "Relating to or exhibiting a nychthemeron or \\(\\pu{24\\!\\mbox{-}h}\\) period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nychthemeral" .

goldbook:15930 a skos:Concept ;
    skos:definition "Actual physical, chemical, and social environment as described by objective measurements, such as noise levels in decibels and concentrations of air pollutants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "objective environment" .

goldbook:15931 a skos:Concept ;
    skos:definition "Surrounding conditions at a workplace." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupational environment" .

goldbook:15932 a skos:Concept ;
    skos:definition "Experience of substances, intensities of radiation, etc., or other conditions while at work." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupational exposure" .

goldbook:15933 a skos:Concept ;
    skos:altLabel "OEL" ;
    skos:definition "Regulatory level of exposure to substances, intensities of radiation, etc., or other conditions, specified appropriately in relevant government legislation or related codes of practice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupational exposure limit" .

goldbook:15934 a skos:Concept ;
    skos:altLabel "OES" ;
    skos:definition "Level of exposure to substances, intensities of radiation, etc., or other conditions considered to represent specified good practice and a realistic criterion for the control of exposure by appropriate plant design, engineering controls, and, if necessary, the addition and use of personal protective clothing. In UK, health-based exposure limit defined under COSHH Regulations as the concentration of any airborne substance, averaged over a reference period, at which, according to current knowledge, there is no evidence that it is likely to be injurious to employees, if they are exposed by inhalation, day after day, to that concentration, and set on the advice of the HSE Advisory Committee on Toxic Substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupational exposure standard" .

goldbook:15935 a skos:Concept ;
    skos:altLabel "industrial hygiene",
        "occupational safety and health" ;
    skos:definition "Identification, assessment, and control of physicochemical and biological factors in the workplace that may affect the health or well-being of those at work and in the surrounding community." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupational hygiene" .

goldbook:15936 a skos:Concept ;
    skos:definition "Specialty devoted to the prevention and management of occupational injury, illness, and disability, and the promotion of the health of workers, their families, and their communities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "occupational medicine" .

goldbook:15937 a skos:Concept ;
    skos:definition "Pertaining to the eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ocular" .

goldbook:15938 a skos:Concept ;
    skos:definition "Ratio of the probability of occurrence of an event to that of non-occurrence, or the ratio of the probability that something is so, to the probability that it is not so." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "odds" .

goldbook:15939 a skos:Concept ;
    skos:altLabel "OR",
        "cross-product ratio",
        "relative odds" ;
    skos:definition "Quotient obtained by dividing one set of odds by another. The terms 'odds' or 'odds ratio' are defined differently according to the situation under discussion. Consider the following notation for the distribution of a binary exposure and a disease in a population or a sample. \\[\\begin{array}{l c c} & Exposed & Nonexposed \\\\ \\rm{Disease} & a & b \\\\ \\rm{No\\ disease} & c & d \\\\ \\end{array}\\] The odds ratio (cross-product ratio) is \\(ad/bc\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "odds ratio" .

goldbook:15940 a skos:Concept ;
    skos:altLabel "odor detection threshold",
        "odour threshold" ;
    skos:definition "In principle, the lowest concentration of an odorant in the air that can be detected by a human being." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "odor threshold" .

goldbook:15941 a skos:Concept ;
    skos:definition "Unit used to measure scent emission of people and objects; one olf is defined as the scent emission of an 'average person', a sitting adult who takes an average of \\(\\pu{0.7}\\) baths per day and whose skin has a total area of \\(\\pu{1.8 m2}\\); the scent emission of an object or person is measured by specially trained personnel comparing it to normed scents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "olf" .

goldbook:15942 a skos:Concept ;
    skos:definition "Apparatus for testing the power of the sense of smell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "olfactometer" .

goldbook:15943 a skos:Concept ;
    skos:definition "Sperm concentration less than a reference value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligozoospermia" .

goldbook:15944 a skos:Concept ;
    skos:definition "Excretion of a diminished amount of urine in relation to fluid intake." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oliguria" .

goldbook:15945 a skos:Concept ;
    skos:definition "Neologism referring to the fields of study in biology ending in the suffix -omics, such as genomics or proteomics: The related neologism -omes are the objects of study of the field such as the genome or proteome, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "-omics, -omes" .

goldbook:15946 a skos:Concept ;
    skos:definition "Gene that can cause neoplastic (see neoplasia) transformation of a cell; oncogenes are slightly changed equivalents of normal genes known as proto-oncogenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oncogene" .

goldbook:15947 a skos:Concept ;
    skos:definition "Production or causation of tumors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oncogenesis" .

goldbook:15948 a skos:Concept ;
    skos:definition "Capable of producing tumors in animals, either benign (noncancerous) or malignant (cancerous)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oncogenic" .

goldbook:15949 a skos:Concept ;
    skos:definition "Dose-response model of the form \\[P = 1 - {\\rm{e}}^{-bd}\\] where \\(P\\) is the probability of cancer death from a continuous dose rate, \\(d\\), and \\(b\\) is a constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "one-hit model" .

goldbook:15950 a skos:Concept ;
    skos:definition "Loosening or detachment of the nail from the nail bed following some destructive process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "onycholysis" .

goldbook:15951 a skos:Concept ;
    skos:definition "Pertaining to the eye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ophthalmic" .

goldbook:15952 a skos:Concept ;
    skos:definition "Amount of a substance or physical agent (radiation) absorbed by an organ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organ dose" .

goldbook:15953 a skos:Concept ;
    skos:definition "Microstructure or separated compartment within a cell that has a specialized function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organelle" .

goldbook:15954 a skos:Concept ;
    skos:definition "Measure of the tendency for organic substances to be adsorbed by soil or sediment, expressed as: \\[K_{\\rm{oc}} = \\frac{(\\ce{mass adsorbed substance})/(\\ce{mass organic carbon})}{(\\ce{mass concentration of absorbed substance})}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organic carbon partition coefficient" .

goldbook:15955 a skos:Concept ;
    skos:definition "Prefix meaning pertaining to bone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteo-" .

goldbook:15956 a skos:Concept ;
    skos:definition "Abnormal development of bone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteodystrophy" .

goldbook:15957 a skos:Concept ;
    skos:definition "Condition marked by softening of the bones (due to impaired mineralization, with excess accumulation of osteoid), with pain, tenderness, muscular weakness, anorexia, and loss of weight, resulting from deficiency of vitamin D and calcium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteomalacia" .

goldbook:15958 a skos:Concept ;
    skos:definition "Significant decrease in bone mass with increased porosity and increased tendency to fracture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteoporosis" .

goldbook:15959 a skos:Concept ;
    skos:definition "Substance intended to kill eggs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ovicide" .

goldbook:15960 a skos:Concept ;
    skos:definition "Exposure of a worker’s family to substances carried from the workplace to the home. Exposure of visitors to substances in the workplace." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "para-occupational exposure" .

goldbook:15961 a skos:Concept ;
    skos:definition "Of, relating to, or affecting the parasympathetic nervous system which stimulates digestive secretions, slows the heart, constricts the pupils of the eyes, and dilates blood vessels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parasympathetic" .

goldbook:15962 a skos:Concept ;
    skos:definition "Producing effects resembling those caused by interruption of the parasympathetic nerve; also called anticholinergic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parasympatholytic" .

goldbook:15963 a skos:Concept ;
    skos:definition "Method of introducing substances into an organism avoiding the gastrointestinal tract (subcutaneously, intravenously, intramuscularly, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parenteral dosage" .

goldbook:15964 a skos:Concept ;
    skos:definition "Inhalation of sidestream smoke by people who do not smoke themselves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive smoking" .

goldbook:15965 a skos:Concept ;
    skos:definition "Action of entering or passing through a cell membrane. Ability or power to enter or pass through a cell membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "penetration" .

goldbook:15966 a skos:Concept ;
    skos:definition "Through the skin following application on the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percutaneous" .

goldbook:15967 a skos:Concept ;
    skos:definition "Act of pouring over or through, especially the passage of a fluid through the vessels of a specific organ. Liquid poured over or through an organ or tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perfusion" .

goldbook:15968 a skos:Concept ;
    skos:definition "Method of artificial detoxication in which a toxic substance from the body is transferred into liquid that is instilled into the peritoneum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritoneal dialysis" .

goldbook:15969 a skos:Concept ;
    skos:definition "Quantity defining the permeability of molecules across a cell membrane and expressed as \\[P = \\frac{KD}{\\Delta x}\\] where \\(K\\) is the partition coefficient, \\(D\\) is the diffusion coefficient, and \\(\\Delta x\\) is the thickness of the cell membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permeability coefficient" .

goldbook:15970 a skos:Concept ;
    skos:definition "Of a membrane, allowing a given substance to pass through." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permeable" .

goldbook:15971 a skos:Concept ;
    skos:altLabel "PEL" ;
    skos:definition "Recommendation by U.S. OSHA for a time-weighted average concentration that must not be exceeded during any \\(\\pu{8\\!\\mbox{-}h}\\) work shift of a \\(\\pu{40\\!\\mbox{-}h}\\) working week." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permissible exposure limit" .

goldbook:15972 a skos:Concept ;
    skos:definition "Type of environmental monitoring in which an individual’s exposure to a substance is measured and evaluated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "personal monitoring" .

goldbook:15973 a skos:Concept ;
    skos:altLabel "PPD",
        "individual protective device (IPD)",
        "personal protective equipment (PPE)" ;
    skos:definition "Equipment (clothing, gloves, hard hat, respirator, etc.) worn by an individual to prevent exposure to a potentially toxic substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "personal protective device" .

goldbook:15974 a skos:Concept ;
    skos:altLabel "individual monitor",
        "individual sampler" ;
    skos:definition "Compact, portable instrument for individual air sampling, measuring, or both, the content of a harmful substance in the respiration zone of a working person." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "personal sampler" .

goldbook:15975 a skos:Concept ;
    skos:definition "Organism that may harm public health, attacks food and other materials essential to mankind, or otherwise affects human beings adversely." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pest" .

goldbook:15976 a skos:Concept ;
    skos:definition "Further metabolism of conjugated metabolites produced by phase II reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase III reaction" .

goldbook:15977 a skos:Concept ;
    skos:definition "Complete phenotypic description of an organism (by analogy with genome)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenome" .

goldbook:15978 a skos:Concept ;
    skos:definition "Inflammation of the skin caused by exposure to light, especially that due to metabolites formed in the skin by photolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo-irritation" .

goldbook:15979 a skos:Concept ;
    skos:definition "Adverse effects produced by exposure to light energy, especially those produced in the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phototoxicity" .

goldbook:15980 a skos:Concept ;
    skos:definition "Map showing how much DNA, measured in base pairs, separates two genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "physical map" .

goldbook:15981 a skos:Concept ;
    skos:definition "Substance intended to kill fish." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "piscicide" .

goldbook:15982 a skos:Concept ;
    skos:definition "Formation of a placenta in the uterus. Type or structure of a placenta. In botany, arrangement of placentas within the plant ovary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "placentation" .

goldbook:15983 a skos:Concept ;
    skos:altLabel "saturnism" ;
    skos:definition "Chronic poisoning caused by absorption of lead or lead salts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plumbism" .

goldbook:15984 a skos:Concept ;
    skos:definition "Usually fibrosis of the lungs that develops owing to (prolonged) inhalation of inorganic or organic dusts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pneumoconiosis" .

goldbook:15985 a skos:Concept ;
    skos:definition "Inflammation of the lung." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pneumonitis" .

goldbook:15986 a skos:Concept ;
    skos:definition "Change in a single base pair in DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "point mutation" .

goldbook:15987 a skos:Concept ;
    skos:definition "Containing a poison." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poison-bearing" .

goldbook:15988 a skos:Concept ;
    skos:altLabel "intoxication" ;
    skos:definition "Morbid condition produced by a poison." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poisoning" .

goldbook:15989 a skos:Concept ;
    skos:definition "Antibody produced by a number of different cell types." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyclonal antibody" .

goldbook:15990 a skos:Concept ;
    skos:definition "Chronic excessive thirst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polydipsia" .

goldbook:15991 a skos:Concept ;
    skos:definition "Excessive production and discharge of urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyuria" .

goldbook:15992 a skos:Concept ;
    skos:definition "Persons who can and may develop an adverse health effect and who are potentially exposed to a substance under study. People already having chronic disease are excluded from the population at risk in studies of the incidence of the adverse effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population at risk" .

goldbook:15993 a skos:Concept ;
    skos:altLabel "PCC" ;
    skos:definition "Concentration of a substance in the critical organ at which a specified percentage of the exposed population has reached the individual critical organ concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population critical concentration" .

goldbook:15994 a skos:Concept ;
    skos:definition "Absolute number or incidence rate of cases occurring in a group of people." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population effect" .

goldbook:15995 a skos:Concept ;
    skos:definition "Disturbance of porphyrin metabolism characterized by increased formation, accumulation, and excretion of porphyrins and their precursors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porphyria" .

goldbook:15996 a skos:Concept ;
    skos:altLabel "porphin",
        "porphine" ;
    skos:definition "Natural pigment containing a fundamental skeleton of four pyrrole nuclei united through the α-positions by four methine groups to form a macrocyclic structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porphyrin" .

goldbook:15997 a skos:Concept ;
    skos:definition "Pharmacological study of the choice of appropriate dose of a drug in relation to the physiological factors, such as age, that may influence its effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "posology" .

goldbook:15998 a skos:Concept ;
    skos:definition "Processes by which proteins are biochemically modified within a cell following their synthesis on the ribosomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-translational modification" .

goldbook:15999 a skos:Concept ;
    skos:definition "Numerically specified low risk of exposure to a potentially toxic substance (e.g., 1 in \\(\\pu{1000}\\)) or socially acceptable low risk of adverse effects from such an exposure applied to decision making in regard to chemical safety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "practical certainty" .

goldbook:16000 a skos:Concept ;
    skos:definition "Pertaining to the region over the heart and lower thorax." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precordial" .

goldbook:16001 a skos:Concept ;
    skos:definition "Reliability of a measurement expressed in terms of its ability to predict the criterion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predictive validity" .

goldbook:16002 a skos:Concept ;
    skos:definition "Percentage of positive results that are true positives or of negative results that are true negatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predictive value" .

goldbook:16003 a skos:Concept ;
    skos:definition "Follicular depletion by the age of 35 years." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "premature ovarian failure" .

goldbook:16004 a skos:Concept ;
    skos:definition "Before the formation of a tumor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preneoplastic" .

goldbook:16005 a skos:Concept ;
    skos:altLabel "PIC" ;
    skos:definition "Concept in law and medicine that states that before one is subjected to a risk, especially a risk of bodily harm, one is entitled to be fully informed well in advance of the nature of that risk in order to make an informed decision about whether to accept it or not." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prior informed consent" .

goldbook:16006 a skos:Concept ;
    skos:definition "Accepted maximum level of a pollutant (or its indicator) in the target organism, or some part thereof, or an accepted maximum intake of a pollutant or nuisance into the target under specified circumstances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary protection standard" .

goldbook:16007 a skos:Concept ;
    skos:definition "Substance that has to be metabolized before it becomes a carcinogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "procarcinogen" .

goldbook:16008 a skos:Concept ;
    skos:definition "Increase in the size of a tumor or spread of cancer in the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "progression" .

goldbook:16009 a skos:Concept ;
    skos:definition "Unicellular organism, characterized by the absence of a membrane-enclosed nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prokaryote" .

goldbook:16010 a skos:Concept ;
    skos:definition "Substance applied in a form that is not active as a pesticide and which becomes active once it enters an organism and undergoes chemical modification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pro-pesticide" .

goldbook:16011 a skos:Concept ;
    skos:altLabel "proportional mortality ratio" ;
    skos:definition "Proportion of observed deaths from a specified condition in a defined population divided by the proportion of deaths expected from this condition in a standard population, expressed either on an age-specific basis or after age adjustment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proportional mortality rate" .

goldbook:16012 a skos:Concept ;
    skos:definition "Excretion of excessive amounts of protein (derived from blood plasma or kidney tubules) in the urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteinuria" .

goldbook:16013 a skos:Concept ;
    skos:altLabel "PADI" ;
    skos:definition "Intake for a substance derived by applying a thousandfold uncertainty factor to the lowest low-effect level for noncarcinogenic endpoints." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-acceptable daily intake" .

goldbook:16014 a skos:Concept ;
    skos:definition "Apparent adaptation of an organism to changing conditions of the environment (especially chemical) associated with stresses in biochemical systems that exceed the limits of normal (homeostatic) mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudoadaptation" .

goldbook:16015 a skos:Concept ;
    skos:definition "Applying risk assessment to a specific target population of known size, giving as the end product a quantitative statement about the number of people likely to be affected in a particular population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "public health impact assessment" .

goldbook:16016 a skos:Concept ;
    skos:definition "Condition in which the temperature of a human being or mammal is above normal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrexia" .

goldbook:16017 a skos:Concept ;
    skos:definition "Describing a condition that can be expressed only as 'occurring' or 'not occurring', such as death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantal" .

goldbook:16018 a skos:Concept ;
    skos:definition "Scientific study involving research, education, prevention, and treatment of diseases caused by ionizing or nonionizing radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation toxicology" .

goldbook:16019 a skos:Concept ;
    skos:altLabel "RD",
        "excess rate" ;
    skos:definition "Absolute difference between two rates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate difference" .

goldbook:16020 a skos:Concept ;
    skos:definition "Substance intended to kill rats." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ratticide" .

goldbook:16021 a skos:Concept ;
    skos:definition "Absorption by a living organism of a substance which it has previously absorbed and then released (e.g., the uptake of a substance from the proximal renal tubule following glomerular filtration)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reabsorption" .

goldbook:16022 a skos:Concept ;
    skos:altLabel "RNS" ;
    skos:definition "Radical nitrogen-based molecules that can act to facilitate nitrosylation reactions; reactive nitrogen species include dioxidonitrogen(\\(\\ce{^{.}}\\)) (nitrogen dioxide, nitryl radical) \\(\\ce{NO^{.}}\\), oxidonitrogen(\\(\\ce{^{.}}\\)) (nitrogen monoxide, nitrosyl radical) \\(\\ce{NO^{.}}\\) oxidonitrogen(1+) (nitrosyl cation) \\(\\ce{NO^{+}}\\), hydroxyoxidonitrogen (nitrous acid) \\(\\ce{HNO2}\\), and oxidonitrate(1-) \\(\\ce{NO^{-}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive nitrogen species" .

goldbook:16023 a skos:Concept ;
    skos:definition "Arbitrary classification of substances that have passed certain specified screening tests for ultimate biodegradability; these tests are so stringent that such compounds will be rapidly and completely biodegraded in a wide variety of aerobic environments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "readily biodegradable" .

goldbook:16024 a skos:Concept ;
    skos:definition "Ability of a substance to remain in a particular environment in an unchanged form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recalcitrance" .

goldbook:16025 a skos:Concept ;
    skos:definition "Endocytosis of a substance and its receptor following receptor binding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "receptor-mediated endocytosis" .

goldbook:16026 a skos:Concept ;
    skos:definition "Allele which in the heterozygous state is expected to have no effect on the phenotype of the organism which carries it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recessive gene" .

goldbook:16027 a skos:Concept ;
    skos:altLabel "REL" ;
    skos:definition "Highest allowable regulatory airborne concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recommended exposure level" .

goldbook:16028 a skos:Concept ;
    skos:definition "Restoration to original form of a substance previously altered for preservation and storage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reconstitution" .

goldbook:16029 a skos:Concept ;
    skos:definition "Process or method allowing for the recovery of some value from a waste, either as reusable material or as energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recycling" .

goldbook:16030 a skos:Concept ;
    skos:altLabel "RfC" ;
    skos:definition "An estimate (with uncertainty spanning perhaps an order of magnitude) of a continuous inhalation exposure to the human population (including sensitive subgroups which include children, asthmatics, and the elderly) that is likely to be without an appreciable risk of deleterious effects during a lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference concentration" .

goldbook:16031 a skos:Concept ;
    skos:definition "Statistical distribution of reference values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference distribution" .

goldbook:16032 a skos:Concept ;
    skos:definition "Person selected with the use of defined criteria for comparative purposes in a clinical study." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference individual" .

goldbook:16033 a skos:Concept ;
    skos:definition "Area between and including two reference limits, for example, the percentiles \\(\\pu{2.5}\\) and \\(\\pu{97.5}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference interval" .

goldbook:16034 a skos:Concept ;
    skos:definition "Boundary value defined so that a stated fraction of the reference values is less than or exceeds that boundary value with a stated probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference limit" .

goldbook:16035 a skos:Concept ;
    skos:definition "Group of all reference individuals used to establish criteria against which a population that is being studied can be compared." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference population" .

goldbook:16036 a skos:Concept ;
    skos:altLabel "reference group" ;
    skos:definition "Selected reference individuals, statistically adequate numerically to represent the reference population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference sample group" .

goldbook:16037 a skos:Concept ;
    skos:definition "Quantity value, generally accepted as having a suitably small measurement uncertainty, to be used as a basis for comparison with values of quantities of the same kind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference value" .

goldbook:16038 a skos:Concept ;
    skos:definition "Term used by the USEPA to describe the expected dose resulting from human exposure to a substance at the level at which it is regulated in the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regulatory dose" .

goldbook:16039 a skos:Concept ;
    skos:definition "DNA sequence to which specific proteins bind to activate or repress the expression of a gene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regulatory sequence" .

goldbook:16040 a skos:Concept ;
    skos:altLabel "RER",
        "comparative risk" ;
    skos:definition "Measure that can be used in comparison of adverse reactions to drugs, or other exposures, based solely on the component of risk due to the exposure or drug under investigation, removing the risk due to background exposure experienced by all in the population. The relative excess risk, \\(R\\), is given by \\[R = (R_{1} - R_{0})/(R_{2} - R_{0})\\] where \\(R_{1}\\) is the rate in the population, \\(R_{2}\\) is the rate in the comparison population, and \\(R_{0}\\) is the rate in the general population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative excess risk" .

goldbook:16041 a skos:Concept ;
    skos:definition "Quantity of metabolizable substance divided by product of quantity of absorbed substance and exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative systemic availability" .

goldbook:16042 a skos:Concept ;
    skos:definition "Anything, such as a medicine or therapy, that relieves pain, cures disease, or corrects a disorder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "remedy" .

goldbook:16043 a skos:Concept ;
    skos:definition "Volume of plasma passing through the kidneys in unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "renal plasma flow" .

goldbook:16044 a skos:Concept ;
    skos:definition "Substance used mainly to repel blood-sucking insects in order to protect humans and animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repellent" .

goldbook:16045 a skos:Concept ;
    skos:definition "Act of taking multiple samples concurrently under comparable conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "replicate sampling" .

goldbook:16046 a skos:Concept ;
    skos:definition "Physiological or biochemical capacity that may be available to maintain homeostasis when the body or an organism is exposed to an environmental change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reserve capacity" .

goldbook:16047 a skos:Concept ;
    skos:definition "Storage compartment from which a substance may be released with subsequent biological effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reservoir" .

goldbook:16048 a skos:Concept ;
    skos:definition "Health risk remaining after risk reduction actions are implemented." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual risk" .

goldbook:16049 a skos:Concept ;
    skos:definition "Contaminant remaining in an organism or in other material such as food or packaging, following exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residue" .

goldbook:16050 a skos:Concept ;
    skos:definition "Action of a substance after its reabsorption from the gut into the blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resorptive effect" .

goldbook:16051 a skos:Concept ;
    skos:altLabel "respirable particles" ;
    skos:definition "Mass fraction of dust (particles) that penetrates to the unciliated airways of the lung (the alveolar region)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "respirable dust" .

goldbook:16052 a skos:Concept ;
    skos:definition "Research design used to test etiological hypotheses in which inferences about exposure to the putative causal factor(s) are derived from data relating to characteristics of the persons or organisms under study or to events or experiences in their past." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retrospective study" .

goldbook:16053 a skos:Concept ;
    skos:definition "Enhancement of the dose–effect relationship for a poison following repeated exposure to decreasing doses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "returned effect of poisons" .

goldbook:16054 a skos:Concept ;
    skos:altLabel "back mutation" ;
    skos:definition "Mutation in a mutant allele which makes it capable of producing the nonmutant phenotype; this may result from restoration of the original DNA sequence of the gene or from production of a new DNA sequence which has the same effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse mutation" .

goldbook:16055 a skos:Concept ;
    skos:definition "Process by which an RNA molecule is used as a template to make a single-stranded DNA copy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse transcription" .

goldbook:16056 a skos:Concept ;
    skos:definition "Change from normal structure or function, induced by a substance or other agent(s), that returns to normal status or within normal limits after cessation of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible alteration" .

goldbook:16057 a skos:Concept ;
    skos:definition "Acute, fulminating, potentially lethal disease of skeletal muscle that causes disintegration of striated muscle fibers as evidenced by myoglobin in the blood and urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhabdomyolysis" .

goldbook:16058 a skos:Concept ;
    skos:definition "Harsh crepitation in the throat, often resembling snoring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhonchus" .

goldbook:16059 a skos:Concept ;
    skos:definition "Probability of the occurrence of a specified undesirable event following exposure of an individual person from a given population to a specified substance at a defined level for the expected lifetime of the average member of that population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk associated with a lifetime exposure" .

goldbook:16060 a skos:Concept ;
    skos:definition "Tendency of an individual person to avoid risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk aversion" .

goldbook:16061 a skos:Concept ;
    skos:definition "Interpretation and communication of risk assessments in terms that are comprehensible to the general public or to others without specialist knowledge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk communication" .

goldbook:16062 a skos:Concept ;
    skos:altLabel "de minimis risk",
        "negligible risk" ;
    skos:definition "Risk that is negligible and too small to be of societal concern (usually assumed to be a probability below \\(\\pu{E-5}\\) or \\(\\pu{E-6}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk <i>de minimis</i>" .

goldbook:16063 a skos:Concept ;
    skos:definition "Establishment of a qualitative or quantitative relationship between risks and benefits, involving the complex process of determining the significance of the identified hazards and estimated risks to those organisms or people concerned with or affected by them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk evaluation" .

goldbook:16064 a skos:Concept ;
    skos:definition "Recognition of a potential hazard and definition of the factors required to assess the probability of exposure of organisms or people to that hazard and of harm resulting from such exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk identification" .

goldbook:16065 a skos:Concept ;
    skos:altLabel "risk indicator" ;
    skos:definition "Attribute that is associated with an increased probability of occurrence of a disease or other specified outcome and that can be used as an indicator of this increased risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk marker" .

goldbook:16066 a skos:Concept ;
    skos:definition "Process of following up the decisions and actions within risk management in order to check whether the aims of reduced exposure and risk are achieved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk monitoring" .

goldbook:16067 a skos:Concept ;
    skos:definition "Subjective perception of the gravity or importance of the risk based on a person’s knowledge of different risks and the moral, economic, and political judgment of their implications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk perception" .

goldbook:16068 a skos:Concept ;
    skos:definition "Word groups identifying potential health or environmental hazards required under CPL Directives (European Community); may be incorporated into Safety Data Sheets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk phrases" .

goldbook:16069 a skos:Concept ;
    skos:definition "Amount of exposure corresponding to a specified level of risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk-specific dose" .

goldbook:16070 a skos:Concept ;
    skos:definition "Substance intended to kill rodents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rodenticide" .

goldbook:16071 a skos:Concept ;
    skos:definition "Means by which a toxic agent gains access to an organism by administration through the gastrointestinal tract (ingestion), lungs (inhalation), skin (topical), or by other routes such as intravenous, subcutaneous, intramuscular, or intraperitoneal routes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "route of exposure" .

goldbook:16072 a skos:Concept ;
    skos:definition "Supernatant fraction obtained from an organ (usually liver) homogenate by centrifuging at \\(\\pu{9000 g}\\) for \\(\\pu{20 min}\\) in a suitable medium; this fraction contains cytosol and microsomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "S9 fraction" .

goldbook:16073 a skos:Concept ;
    skos:definition "Science directed to the discovery, development, and safe therapeutic use of biologically active substances as a result of the identification, monitoring, and characterization of potentially undesirable pharmacodynamic activities of these substances in nonclinical studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "safety pharmacology" .

goldbook:16074 a skos:Concept ;
    skos:definition "Malignant tumor arising in a connective tissue and composed primarily of anaplastic cells resembling supportive tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sarcoma" .

goldbook:16075 a skos:Concept ;
    skos:definition "Elimination that becomes concentration-independent at a concentration at which the elimination process is functioning maximally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturable elimination" .

goldbook:16076 a skos:Concept ;
    skos:definition "Pain in a joint resulting from lead poisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturnia" .

goldbook:16077 a skos:Concept ;
    skos:altLabel "plumbism" ;
    skos:definition "Intoxication caused by lead." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturnism" .

goldbook:16078 a skos:Concept ;
    skos:definition "Area of diminished or lost vision within the visual field, surrounded by an area of less affected or normal vision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scotoma" .

goldbook:16079 a skos:Concept ;
    skos:definition "Process by which a substance such as a hormone or enzyme produced in a cell is passed through a plasma membrane to the outside, for example, the intestinal lumen or the blood (internal secretion).  Solid, liquid, or gaseous material passed from the inside of a cell through a plasma membrane to the outside as a result of cell activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secretion" .

goldbook:16080 a skos:Concept ;
    skos:definition "Water purification by natural biological and physicochemical processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-cleaning of water" .

goldbook:16081 a skos:Concept ;
    skos:definition "Purification of the atmosphere from contaminants by natural biological and physicochemical processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-purification of the atmosphere" .

goldbook:16082 a skos:Concept ;
    skos:definition "Substance produced by plants or animals, or a synthetic analogue thereof, that evokes a behavioral response in individuals of the producing species or other species (e.g., allomones, kairomones, pheromones, and synomones)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semiochemical" .

goldbook:16083 a skos:Concept ;
    skos:altLabel "differentially permeable membrane",
        "selectively membrane" ;
    skos:definition "Membrane that will preferentially allow certain molecules or ions to pass through it while preventing the passage of others." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semipermeable membrane" .

goldbook:16084 a skos:Concept ;
    skos:definition "Intensity, where the detection threshold level is defined as the lower limit of the perceived intensity range (by convention, the lowest concentration that can be detected in \\(\\pu{50\\%}\\) of the cases in which it is present). Quality, where the recognition threshold level is defined as the lowest concentration at which the sensory effect can be recognized correctly in \\(\\pu{50\\%}\\) of the cases. Acceptability and annoyance, where the nuisance threshold level is defined as the concentration at which not more than a small proportion of the population, less than \\(\\pu{5\\%}\\), experiences annoyance for a small part of the time, less than \\(\\pu{2\\%}\\).Note: Since annoyance will be influenced by a number of factors, a nuisance threshold level cannot be set on the basis of concentration alone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensory effect level" .

goldbook:16085 a skos:Concept ;
    skos:altLabel "STEL" ;
    skos:definition "Fifteen-minute time-weighted average (TWA) exposure recommended by ACGIH which should not be exceeded at any time during a workday, even if the \\(\\pu{8 h}\\) TWA is within the threshold limit value: time-weighted average, TLV-TWA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "short-term exposure limit" .

goldbook:16086 a skos:Concept ;
    skos:definition "Action of a drug other than that desired for beneficial pharmacological effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "side-effect" .

goldbook:16087 a skos:Concept ;
    skos:definition "Pneumoconiosis resulting from the inhalation of iron dust. Excess of iron in the urine, blood, or tissues, characterized by hemosiderin granules in urine and iron deposits in tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "siderosis" .

goldbook:16088 a skos:Concept ;
    skos:altLabel "environmental tobacco smoke (ETS)",
        "secondhand smoke" ;
    skos:definition "Cloud of small particles and gases that is given off from the end of a burning tobacco product (cigarette, pipe, cigar) between puffs and is not directly inhaled by the smoker." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sidestream smoke" .

goldbook:16089 a skos:Concept ;
    skos:definition "Objective evidence of a disease, deformity, or an effect induced by an agent, perceptible to an examining physician." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sign" .

goldbook:16090 a skos:Concept ;
    skos:definition "Pneumoconiosis resulting from inhalation of silica dust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silicosis" .

goldbook:16091 a skos:Concept ;
    skos:definition "Procedure designed to predict the rate of biodegradation of a compound under relevant environmental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simulation test" .

goldbook:16092 a skos:Concept ;
    skos:definition "Osteosclerosis due to fluoride." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skeletal fluorosis" .

goldbook:16093 a skos:Concept ;
    skos:definition "Substance intended to kill slime-producing organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slimicide" .

goldbook:16094 a skos:Concept ;
    skos:definition "Value, in inverse concentration or dose units, derived from the slope of a dose-response curve; in practice, limited to carcinogenic effects with the curve assumed to be linear at low concentrations or doses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slope factor" .

goldbook:16095 a skos:Concept ;
    skos:altLabel "population risk" ;
    skos:definition "Total probability of harm to a human population including the probability of adverse effects to health of descendants and the probability of disruption resulting from loss of services such as industrial plant or loss of material goods and electricity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "societal risk" .

goldbook:16096 a skos:Concept ;
    skos:definition "Experimental ratio of a substance’s concentration in the soil to that in the aqueous (dissolved) soil phase at equilibrium: It is valid only for the specific concentration and solid/solution ratio of the test." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soil partition coefficient" .

goldbook:16097 a skos:Concept ;
    skos:altLabel "solvent sniffing" ;
    skos:definition "Deliberate inhalation (or drinking) of volatile solvents, in order to become intoxicated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent abuse" .

goldbook:16098 a skos:Concept ;
    skos:definition "Death rate computed for a subpopulation of individual organisms or people having a specified characteristic or attribute, and named accordingly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific death rate" .

goldbook:16099 a skos:Concept ;
    skos:altLabel "SPF" ;
    skos:definition "Describing an animal removed from its mother under sterile conditions just prior to term and subsequently reared and kept under sterile conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific pathogen free" .

goldbook:16100 a skos:Concept ;
    skos:definition "Agent used in some pesticide formulations to extend the even disposition of the active ingredient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spreader" .

goldbook:16101 a skos:Concept ;
    skos:altLabel "stability half time" ;
    skos:definition "Time required for the amount of a substance in a formulation to decrease, for any reason, by one-half (\\(\\pu{50\\%}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stability half life" .

goldbook:16102 a skos:Concept ;
    skos:altLabel "SMR",
        "standardized morbidity ratio" ;
    skos:definition "Ratio of the number of patients with a particular disease observed in a study group or population to the total number of people in the group or population multiplied by \\(\\pu{100}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard morbidity ratio" .

goldbook:16103 a skos:Concept ;
    skos:altLabel "SMR",
        "standardized mortality ratio" ;
    skos:definition "Ratio of the number of deaths observed in the study group or population to the number of deaths that would be expected if the study population had the same specific rates as the standard population, multiplied by \\(\\pu{100}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard mortality ratio" .

goldbook:16104 a skos:Concept ;
    skos:definition "Pneumoconiosis resulting from inhalation of tin dust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stannosis" .

goldbook:16105 a skos:Concept ;
    skos:altLabel "semichronic",
        "subacute" ;
    skos:definition "Repeated over a short period, usually about \\(\\pu{10\\%}\\) of the life span; an imprecise term used to describe exposures of intermediate duration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subchronic" .

goldbook:16106 a skos:Concept ;
    skos:definition "Biological change resulting from an environmental alteration lasting about \\(\\pu{10\\%}\\) of the lifetime of the test organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subchronic effect" .

goldbook:16107 a skos:Concept ;
    skos:definition "Animal experiment serving to study the effects produced by the test substance when administered in repeated doses (or continually in food, drinking water, air) over a period of up to about 90 days." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subchronic toxicity test" .

goldbook:16108 a skos:Concept ;
    skos:definition "Biological change with detectable symptoms following exposure to an agent known to cause disease either before symptoms of the disease occur or when they are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subclinical effect" .

goldbook:16109 a skos:Concept ;
    skos:definition "Fertility below the normal range for a given species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subfertility" .

goldbook:16110 a skos:Concept ;
    skos:altLabel "perceived environment" ;
    skos:definition "Surrounding conditions as perceived by persons living in these conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subjective environment" .

goldbook:16111 a skos:Concept ;
    skos:definition "According to the USEPA’s Guidelines for Carcinogen Risk Assessment, sufficient evidence is a collection of facts and scientific references that is definite enough to establish that an adverse effect is caused by the agent in question." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sufficient evidence" .

goldbook:16112 a skos:Concept ;
    skos:altLabel "SNARL" ;
    skos:definition "Maximum dose or concentration that on current understanding is likely to be tolerated by an exposed organism without producing any harm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suggested no-adverse-response level" .

goldbook:16113 a skos:Concept ;
    skos:definition "Formation of irreversible cleavage complexes (also referred to as 'suicide complexes') leading to cell death." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suicide reaction" .

goldbook:16114 a skos:Concept ;
    skos:definition "Two-to-four page summary of a risk assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "summary sheet" .

goldbook:16115 a skos:Concept ;
    skos:definition "Process of addition of separate postsynaptic responses caused by stimuli that are adjacent in time and space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "summation" .

goldbook:16116 a skos:Concept ;
    skos:definition "Federal authority, established by the U.S. Comprehensive Environmental Response, Compensation, and Liability Act (CERCLA) in 1980, to respond directly to releases or threatened releases (such as from landfills or waste disposal areas) of hazardous substances that may endanger health or welfare." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Superfund" .

goldbook:16117 a skos:Concept ;
    skos:definition "Enzymatic antioxidant that removes the potentially toxic superoxide ion (\\(\\ce{O2^{-}}\\)) by disproportionating it to \\(\\ce{O2}\\) and hydrogen peroxide (\\(\\ce{H2O2}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superoxide dismutase" .

goldbook:16118 a skos:Concept ;
    skos:definition "Relatively well studied toxicant whose properties are assumed to apply to an entire chemically and toxicologically related class." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surrogate" .

goldbook:16119 a skos:Concept ;
    skos:altLabel "vulnerable" ;
    skos:definition "Describing a group of organisms more vulnerable to a given exposure than the majority of the population to which they belong." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "susceptible" .

goldbook:16120 a skos:Concept ;
    skos:altLabel "anti-adrenergic" ;
    skos:definition "adj., Blocking transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues. n., Agent that blocks transmission of impulses from the adrenergic (sympathetic) postganglionic fibers to effector organs or tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sympatholytic" .

goldbook:16121 a skos:Concept ;
    skos:definition "Any subjective evidence of a disease or an effect induced by a substance as perceived by the affected subject." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symptom" .

goldbook:16122 a skos:Concept ;
    skos:definition "General description of all of the signs and symptoms of exposure to a toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symptomatology" .

goldbook:16123 a skos:Concept ;
    skos:definition "Substance that contributes more than additively to a mutual effect with another substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synergist" .

goldbook:16124 a skos:Concept ;
    skos:definition "Semiochemical that is produced by one organism inducing a response in an organism of another species that is favorable to both the emitter and the responding organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synomone" .

goldbook:16125 a skos:Concept ;
    skos:definition "Property of genes which reside on the same chromosome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synteny" .

goldbook:16126 a skos:Concept ;
    skos:definition "Subset selected according to some simple rule such as specified date or alphabetic classification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systematic sample" .

goldbook:16127 a skos:Concept ;
    skos:definition "Prefix meaning rapid as in tachycardia and tachypnoea." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tachy-" .

goldbook:16128 a skos:Concept ;
    skos:definition "Abnormally fast breathing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tachypnoea" .

goldbook:16129 a skos:Concept ;
    skos:definition "Substance intended to kill tapeworms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "taeniacide" .

goldbook:16130 a skos:Concept ;
    skos:definition "Collection of individuals, items, measurements, etc. about which inferences are required: The term is sometimes used to indicate the population from which a sample is drawn and sometimes to denote any reference population about which inferences are needed. Group of persons for whom an intervention is planned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "target population" .

goldbook:16131 a skos:Concept ;
    skos:definition "Value for the acceptable daily intake (ADI) proposed for guidance when data are sufficient to conclude that use of the substance is safe over the relatively short period of time required to generate and evaluate further safety data, but are insufficient to conclude that use of the substance is safe over a lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temporary acceptable daily intake" .

goldbook:16132 a skos:Concept ;
    skos:definition "Regulatory value established for a specified, limited time when only a temporary acceptable daily intake has been established for the pesticide concerned or, with the existence of an agreed acceptable daily intake, the available residue data are inadequate for firm maximum residue recommendations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temporary maximum residue limit" .

goldbook:16133 a skos:Concept ;
    skos:definition "In toxicology, evaluation of the therapeutic and potentially toxic effects of substances by their application through relevant routes of exposure with appropriate organisms or biological systems so as to relate effects to dose following application. In chemistry, qualitative or quantitative analysis by the application of one or more fixed methods and comparison of the results with established standards." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "testing of chemicals" .

goldbook:16134 a skos:Concept ;
    skos:altLabel "TMDI" ;
    skos:definition "Predicted maximum daily intake of a residue, assuming that it is present at the maximum residue level and that average daily consumption of foods per person is represented by assessed regional diets: It is expressed in milligrams of residue per person per day." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "theoretical maximum daily intake" .

goldbook:16135 a skos:Concept ;
    skos:definition "Generation and manipulation of stem cells with the objective of deriving cells of a particular organ or tissue to treat a disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "therapeutic cloning" .

goldbook:16136 a skos:Concept ;
    skos:altLabel "threshold concentration",
        "threshold dose" ;
    skos:definition "Dose or exposure concentration below which a defined effect will not occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold" .

goldbook:16137 a skos:Concept ;
    skos:altLabel "TLV-C" ;
    skos:definition "As defined by ACGIH, concentration of a potentially toxic substance that should not be exceeded during any part of the working exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold limit value–ceiling" .

goldbook:16138 a skos:Concept ;
    skos:altLabel "TLV–STEL" ;
    skos:definition "As defined by ACGIH, concentration to which it is believed that workers can be exposed continuously for a short period of time without suffering from (1) irritation, (2) chronic or irreversible tissue damage, or (3) narcosis of sufficient degree to increase the likelihood of accidental injury, impair self-rescue or materially reduce work efficiency, and provided that the daily TLV-TWA is not exceeded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold limit value–short-term exposure limit" .

goldbook:16139 a skos:Concept ;
    skos:altLabel "TLV–TWA" ;
    skos:definition "As defined by ACGIH, time-weighted average concentration for a conventional \\(\\pu{8\\!\\mbox{-}h}\\) workday and a \\(\\pu{40\\!\\mbox{-}h}\\) workweek, to which it is believed nearly all workers may be repeatedly exposed, day after day, without adverse effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold limit value–time-weighted average" .

goldbook:16140 a skos:Concept ;
    skos:altLabel "TTC" ;
    skos:definition "Human exposure threshold value for a group of chemicals below which there should be no appreciable risk to human health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold of toxicological concern" .

goldbook:16141 a skos:Concept ;
    skos:definition "Condition resulting from excessive concentrations of thyroid hormones, as in hyperthyroidism, characterized by bulging eyes and rapid heart rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thyrotoxicosis" .

goldbook:16142 a skos:Concept ;
    skos:definition "Quantity of air or test gas that is inhaled and exhaled during one respiratory cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tidal volume" .

goldbook:16143 a skos:Concept ;
    skos:altLabel "TWAE",
        "time-weighted-average concentration (TWAC)" ;
    skos:definition "Concentration in the exposure medium at each measured time interval multiplied by that time interval and divided by the total time of observation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-weighted-average-exposure" .

goldbook:16144 a skos:Concept ;
    skos:definition "Amount of a substance or physical agent (radiation) absorbed by a tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tissue dose" .

goldbook:16145 a skos:Concept ;
    skos:altLabel "TDI" ;
    skos:definition "Estimate of the amount of a potentially harmful substance (e.g., contaminant) in food or drinking water that can be ingested daily over a lifetime without appreciable health risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerable daily intake" .

goldbook:16146 a skos:Concept ;
    skos:definition "Probability of suffering disease or injury that can, for the time being, be tolerated, taking into account the associated benefits, and assuming that the risk is minimized by appropriate control procedures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerable risk" .

goldbook:16147 a skos:Concept ;
    skos:altLabel "TWI",
        "provisional tolerable weekly intake (PTWI)" ;
    skos:definition "Estimate of the amount of a potentially harmful substance (e.g., a contaminant) in food or drinking water that can be ingested weekly over a lifetime without appreciable health risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tolerable weekly intake" .

goldbook:16148 a skos:Concept ;
    skos:definition "Characterized by tension, especially muscular tension. Medical preparation that increases or restores normal muscular tension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tonic" .

goldbook:16149 a skos:Concept ;
    skos:definition "Applied directly to the surface of the body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topical" .

goldbook:16150 a skos:Concept ;
    skos:definition "Potentially lethal form of ventricular tachycardia following chronic abuse of alcohol and mainly due to hypomagnesemia." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torsade de pointes" .

goldbook:16151 a skos:Concept ;
    skos:definition "Study designed to establish the pattern of pesticide residue intake by a person consuming a defined diet. Study undertaken to show the range and amount of various foodstuffs in a typical diet or to estimate the total amount of a specific substance in a typical diet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total diet study" .

goldbook:16152 a skos:Concept ;
    skos:definition "Summation of levels of all the residues of a defined pesticide in a food." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total terminal residue" .

goldbook:16153 a skos:Concept ;
    skos:altLabel "blood poisoning" ;
    skos:definition "Condition in which the blood contains toxins produced by body cells at a local source of infection or derived from the growth of microorganisms. Pregnancy-related condition characterized by high blood pressure, swelling, and fluid retention, and proteins in the urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxemia" .

goldbook:16154 a skos:Concept ;
    skos:altLabel "superthreshold dose" ;
    skos:definition "Amount of a substance that produces intoxication without lethal outcome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxic dose" .

goldbook:16155 a skos:Concept ;
    skos:definition "Experimental study of the adverse effects of exposure of a living organism to a substance for a defined duration under defined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity test" .

goldbook:16156 a skos:Concept ;
    skos:definition "Scientific subdiscipline that combines toxicology with genomics to determine how an organism’s genetic make-up influences its response to a toxic substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicogenomics" .

goldbook:16157 a skos:Concept ;
    skos:definition "Document that gives in a uniform manner data relating to the toxicology of a substance, its production and application, properties and methods of identification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicological data sheet" .

goldbook:16158 a skos:Concept ;
    skos:definition "Term sometimes used to indicate a combination of investigative methods and techniques for making a quantitative assessment of toxicity and the hazards of potentially toxic substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicometry" .

goldbook:16159 a skos:Concept ;
    skos:definition "Morbid dread of poisons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicophobia" .

goldbook:16160 a skos:Concept ;
    skos:altLabel "toxogenic group",
        "toxophoric group" ;
    skos:definition "Structural moiety that upon metabolic activation exerts toxic effects: The presence of a toxicophoric group indicates only potential and not necessarily actual toxicity of a drug or other substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicophoric group" .

goldbook:16161 a skos:Concept ;
    skos:definition "Active process of identification, investigation, and evaluation of various toxic effects in the community with a view to taking measures to reduce or control exposure(s) involving the substance(s) which produces these effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicovigilance" .

goldbook:16162 a skos:Concept ;
    skos:definition "Metabolic conversion of a potentially toxic substance to a product that is more toxic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxification" .

goldbook:16163 a skos:Concept ;
    skos:definition "Substance that can be tracked through one or more reactions or systems, often by detecting an incorporated isotope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tracer substance" .

goldbook:16164 a skos:Concept ;
    skos:definition "Total mRNA expressed in a cell or tissue at a given point in time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcriptome" .

goldbook:16165 a skos:Concept ;
    skos:definition "Global analysis of gene expression to identify and evaluate changes in synthesis of mRNA after chemical exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcriptomics" .

goldbook:16166 a skos:Concept ;
    skos:definition "Cell that has become genetically altered spontaneously or by incorporation of foreign DNA to produce a cell with an extended lifetime in culture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transformed cell" .

goldbook:16167 a skos:Concept ;
    skos:definition "Gene from one source that has been incorporated into the genome of another organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transgene" .

goldbook:16168 a skos:Concept ;
    skos:definition "In relation to waste water, the amenability of substances to removal without adversely affecting the normal operation of biological treatment processes (such as a sewage treatment plant)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "treatability" .

goldbook:16169 a skos:Concept ;
    skos:definition "Process for sorting people into groups based on their need for or likely benefit from immediate medical treatment. Note: Triage is used in hospital emergency rooms, on battlefields, and at disaster sites when limited medical resources must be allocated. System used to allocate a scarce commodity, such as food, to those most likely to benefit from it. Process in which things are ranked in terms of importance or priority." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triage" .

goldbook:16170 a skos:Concept ;
    skos:definition "Closeness of agreement between the average of a theoretically infinite number of replicate measured quantity values and a reference quantity value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trueness" .

goldbook:16171 a skos:Concept ;
    skos:definition "Transfer of solutes from the renal tubule lumen to the tubular epithelial cell and normally from there to the peritubular fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tubular reabsorption" .

goldbook:16172 a skos:Concept ;
    skos:definition "Able to cause tumors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumorigenic" .

goldbook:16173 a skos:Concept ;
    skos:definition "Sequence of changes by which a benign tumor develops from the initial lesion to a malignant stage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor progression" .

goldbook:16174 a skos:Concept ;
    skos:definition "Gene that serves to protect cells from entering a cancerous state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tumor suppressor gene" .

goldbook:16175 a skos:Concept ;
    skos:definition "Product of compartmental analysis requiring two compartments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-compartment model" .

goldbook:16176 a skos:Concept ;
    skos:definition "Defect, often associated with inflammation, occurring locally or at the surface of an organ or tissue owing to sloughing of necrotic tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ulcer" .

goldbook:16177 a skos:Concept ;
    skos:altLabel "measurement uncertainty" ;
    skos:definition "Parameter characterizing the dispersion of the quantity values being attributed to a measurand, based on the information used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uncertainty" .

goldbook:16178 a skos:Concept ;
    skos:definition "Upper-bound excess lifetime cancer risk estimated to result from continuous exposure to an agent at a concentration of \\(\\pu{1 \\upmu g L-1}\\) in water, or \\(\\pu{1 \\upmu g m-3}\\) in air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unit risk" .

goldbook:16179 a skos:Concept ;
    skos:definition "Estimate of the plausible upper limit to the true value of a quantity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upper boundary" .

goldbook:16180 a skos:Concept ;
    skos:definition "Vascular reaction of the skin marked by the transient appearance of smooth, slightly elevated patches (wheals, hives) that are redder or paler than the surrounding skin and often attended by severe itching." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "urticaria" .

goldbook:16181 a skos:Concept ;
    skos:definition "Membrane-bound cavity within a cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vacuole" .

goldbook:16182 a skos:Concept ;
    skos:definition "Expression of the degree to which a measurement measures what it purports to measure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "validity of a measurement" .

goldbook:16183 a skos:Concept ;
    skos:definition "Degree to which the inferences drawn, especially generalizations extending beyond the study sample, are warranted when account is taken of the study methods, the representativeness of the study sample, and the nature of the population from which it is drawn." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "validity" .

goldbook:16184 a skos:Concept ;
    skos:definition "Increase in the caliber of the blood vessels, leading to an increased blood flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vasodilation" .

goldbook:16185 a skos:Concept ;
    skos:definition "Substance(s) used to formulate active ingredients for administration or use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vehicle" .

goldbook:16186 a skos:Concept ;
    skos:definition "Process of supplying a building or room with fresh air. Process of exchange of air between the ambient atmosphere and the lungs. In physiology, the amount of air inhaled per day. Oxygenation of blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventilation" .

goldbook:16187 a skos:Concept ;
    skos:definition "Irregular heartbeat characterized by uncoordinated contractions of the ventricle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ventricular fibrillation" .

goldbook:16188 a skos:Concept ;
    skos:definition "Substance intended to kill intestinal worms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vermicide" .

goldbook:16189 a skos:Concept ;
    skos:definition "adj., Producing blisters on the skin. n., Substance that causes blisters on the skin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vesicant" .

goldbook:16190 a skos:Concept ;
    skos:altLabel "VSD" ;
    skos:definition "Human exposure over a lifetime to a carcinogen which has been estimated, using mathematical modeling, to result in a very low incidence of cancer, somewhere between zero and a specified incidence (e.g., 1 cancer in \\(\\pu{1000000}\\) exposed people)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virtually safe dose" .

goldbook:16191 a skos:Concept ;
    skos:altLabel "antiviral" ;
    skos:definition "Substance used to control viruses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virucide" .

goldbook:16192 a skos:Concept ;
    skos:definition "Disease marked by weight loss and atrophy of muscular and other connective tissues that is not directly related to a decrease in food and water consumption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wasting syndrome" .

goldbook:16193 a skos:Concept ;
    skos:definition "Difference in free energy or chemical potential (per unit molal volume) between pure water and water in cells and solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "water potential" .

goldbook:16194 a skos:Concept ;
    skos:definition "Extent to which the available biomedical data support the hypothesis that a substance causes a defined toxic effect such as cancer in humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weight-of-evidence for toxicity" .

goldbook:16195 a skos:Concept ;
    skos:definition "Space measuring up to \\(\\pu{2 m}\\) over the level of the floor or platform that contains a worker’s permanent or temporary station." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "working zone" .

goldbook:16196 a skos:Concept ;
    skos:definition "Hyperkeratotic disease in cattle following exposure to chlorinated dibenzo-p-dioxins, naphthalenes, and related compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "x-disease" .

goldbook:16197 a skos:Concept ;
    skos:definition "Kinetics of a reaction in which the rate is independent of the concentration(s) of the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero-order kinetics" .

goldbook:16198 a skos:Concept ;
    skos:definition "Substance intended to kill animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zoocide" .

goldbook:16199 a skos:Concept ;
    skos:definition "Molecular species that can rapidly be converted from inactive into active form by light. Typically, photocaged compounds have a covalently attached group that can be photocleaved by electromagnetic radiation of a specific wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "caged compound" .

goldbook:16200 a skos:Concept ;
    skos:altLabel "CT",
        "CT absorption" ;
    skos:definition "Electronic absorption corresponding to a charge-transfer transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer absorption" .

goldbook:16201 a skos:Concept ;
    skos:definition "Photoinduced geometric isomerization about a double bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cis/trans photoisomerisation" .

goldbook:16202 a skos:Concept ;
    skos:definition "Efficiency of light emission for solid-state light-emitting devices, such as organic light-emitting devices (OLEDs). Analogous to emission quantum yield." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external quantum efficiency" .

goldbook:16203 a skos:Concept ;
    skos:definition "Squared modulus of the overlap integral between the vibrational wave functions (\\(\\mathit{\\Theta}\\)) for the initial (0) and final (\\(\\rm{e}\\)) state of a given electronic transition. \\[\\left\\vert \\int \\mathit{\\Theta} _{\\rm{v'}}^{(\\rm{e})} \\mathit{\\Theta} _{\\rm{v}}^{(0)} dQ \\right\\vert^{2}\\] where the integration is over all nuclear coordinates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Franck–Condon factor" .

goldbook:16205 a skos:Concept ;
    skos:definition "Correlation of the Stokes-shift, \\(\\Delta \\tilde{ u}\\), between the absorption and emission maxima, and the orientation polarizability \\(f(\\varepsilon_{\\rm{r}},n)\\) of the solvent,\\[\\Delta \\tilde{ u} = 2 \\frac{(\\boldsymbol{\\mu}_{\\rm{exc}} - \\boldsymbol{\\mu}_{\\rm{gr}})^{2}}{c h r^{3}} f(\\varepsilon_{\\rm{r}},n) + {\\rm{const.}}\\]with \\(\\boldsymbol{\\mu}_{\\rm{exc}}\\) and \\(\\boldsymbol{\\mu}_{\\rm{gr}}\\) the excited- and ground-state dipole moments of the dissolved molecule, respectively, \\(c\\) the speed of light, \\(h\\) the Planck constant, \\(r\\) the radius of the cavity in which the solute resides, and \\(\\varepsilon_{\\rm{r}}\\) the 'relative static permittivity' (formerly called dielectric constant). The expression of the Stokes shift depends only on the absolute magnitude of the difference between dipole moments and not on the angle between the dipoles. The above equation is sometimes called the Lippert equation. The orientation polarizability is given by\\[f(\\varepsilon_{\\rm{r}},n) = \\frac{(\\varepsilon_{\\rm{r}} - 1)}{(2\\varepsilon_{\\rm{r}} + 1)} - \\frac{(n^{2} - 1)}{(2n^{2} + 1)}\\]with \\(\\varepsilon_{\\rm{r}}\\) the relative static permittivity and \\(n\\) the refractive index of the solvent, \\(f(\\varepsilon_{\\rm{r}},n)\\) ranges from \\(\\pu{0.001}\\) in cyclohexane to \\(\\pu{0.320}\\) in water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lippert–Mataga equation" .

goldbook:16206 a skos:Concept ;
    skos:definition "Caged fluorophores displaying a high fluorescent enhancement after photolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocaged fluorescent molecules" .

goldbook:16207 a skos:Concept ;
    skos:definition "Photoinduced substitution in an aromatic compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical aromatic substitution" .

goldbook:16208 a skos:Concept ;
    skos:altLabel "photo-EOCAS" ;
    skos:definition "Photosubstitution in electron-rich aromatic compounds, upon reaction with electron-deficient olefins, occurring in polar solvents through an electron-transfer pathway." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aromatic substitution photochemical electrophile-olefin combination" .

goldbook:16209 a skos:Concept ;
    skos:altLabel "photo-NOCAS" ;
    skos:definition "Photoinduced electron-transfer reaction of an aromatic electron-acceptor in the presence of an olefinic electron donor and a nucleophile, leading to aromatic substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical nucleophile-olefin combination - aromatic substitution" .

goldbook:16210 a skos:Concept ;
    skos:altLabel "photo-ROCAS" ;
    skos:definition "Regioselective combination of a radical, an olefin, and an arene via a photoinduced electron-transfer pathway." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aromatic substitution photochemical radical-olefin combination" .

goldbook:16211 a skos:Concept ;
    skos:definition "Photochemical induction of molecular chirality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochirogenesis" .

goldbook:16212 a skos:Concept ;
    skos:definition "A special case of phototautomerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoenolisation" .

goldbook:16213 a skos:Concept ;
    skos:definition "Photoinduced change in refractive index." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photorefractive effect" .

goldbook:16214 a skos:Concept ;
    skos:altLabel "PPG" ;
    skos:definition "Release of a reactive species by photolysis of a molecular entity. The release may be induced by direct excitation, by triplet sensitization, or by photoinduced electron transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoremovable protecting group" .

goldbook:16215 a skos:Concept ;
    skos:definition "Nucleophilic substitution in a substrate through processes that involve electron transfer steps. The reaction occurs through chain steps. The most extensively used method of initiation is photoinitiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photostimulated unimolecular radical nucleophilic substitution" .

goldbook:16216 a skos:Concept ;
    skos:definition "Photochemical process leading to a substitution reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosubstitution" .

goldbook:16217 a skos:Concept ;
    skos:definition "Photoisomerization of the general form \\[\\ce{G-X-Y=Z [h u] X=Y-Z-G}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phototautomerisation" .

goldbook:16218 a skos:Concept ;
    skos:definition "The negative of the standard Gibbs energy change (i.e., \\(-\\Delta G^{\\circ}\\)) for outer-sphere electron transfer in polar solvents, where the electrostatic work terms in the expression used for the calculation of the Gibbs energy of photoinduced electron transfer are in general negligibly small." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polar driving force" .

goldbook:16219 a skos:Concept ;
    skos:definition "In absorption experiments, polarization spectroscopy is performed with polarized light on anisotropic samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarisation spectroscopy" .

goldbook:16221 a skos:Concept ;
    skos:definition "Derivative of fluence, \\(H_{\\rm{o}}\\), with respect to wavelength, _010366_." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral fluence" .

goldbook:16224 a skos:Concept ;
    skos:definition "Study of the correlations between phenotypic trends and genetic variation across population groups and the application of the results of such a study to control of health problems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic epidemiology" .

goldbook:16225 a skos:Concept ;
    skos:definition "Value obtained by dividing the probability of occurrence of a specific effect in one group by the probability of occurrence of the same effect in another group, or the value obtained by dividing the probability of occurrence of one potentially hazardous event by the probability of occurrence of another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk ratio" .

goldbook:16226 a skos:Concept ;
    skos:altLabel "TER" ;
    skos:definition "Ratio of the measure of the effects (e.g., \\(\\pu{LD_{50}}\\), \\(\\pu{LC_{50}}\\), NOEC) to the estimated exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity exposure ratio" .

goldbook:16228 a skos:Concept ;
    skos:altLabel "butterfly entanglement" ;
    skos:definition "Chain entanglement with topology similar to that of a bowtie." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bowtie entanglement" .

goldbook:16229 a skos:Concept ;
    skos:definition "Effect of finite duration occurring rapidly (usually in the first \\(\\pu{24 h}\\) or up to \\(\\pu{14 d}\\)) following a single dose or short exposure to a substance or radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute effect" .

goldbook:16230 a skos:Concept ;
    skos:definition "Exposure of short duration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute exposure" .

goldbook:16231 a skos:Concept ;
    skos:definition "Long-term (in relation to exposure or effect)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic" .

goldbook:16232 a skos:Concept ;
    skos:altLabel "long-term exposure" ;
    skos:definition "Continued exposures occurring over an extended period of time, or a significant fraction of the test species’ or of the group of individuals’, or of the population’s lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic exposure" .

goldbook:16233 a skos:Concept ;
    skos:altLabel "BMC" ;
    skos:definition "Statistical lower CL on the concentration that produces a defined response (called the benchmark response or BMR, usually \\(\\pu{5\\%}\\) or \\(\\pu{100\\%}\\)) for an adverse effect compared to background, defined as \\(\\pu{0\\%}\\).Dose–response curve showing BMC and BMCL (BMC 10 % lower CL)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benchmark concentration" .

goldbook:16234 a skos:Concept ;
    skos:altLabel "PBPK",
        "toxicologically based pharmacokinetic modeling" ;
    skos:definition "Mathematical modeling of kinetic behavior of a substance, based on measured physiological parameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "physiologically based pharmacokinetic modeling" .

goldbook:16235 a skos:Concept ;
    skos:altLabel "deterministic process" ;
    skos:definition "Phenomenon committed to a particular outcome determined by fundamental physical principles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deterministic effect" .

goldbook:16236 a skos:Concept ;
    skos:definition "Pertaining to or arising from chance and hence obeying the laws of probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stochastic" .

goldbook:16237 a skos:Concept ;
    skos:definition "Change in biochemistry, morphology, physiology, growth, development, or lifespan of an organism which results in impairment of functional capacity or impairment of capacity to compensate for additional stress or increase in susceptibility to other environmental influences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effect" .

goldbook:16238 a skos:Concept ;
    skos:definition "Derivative with respect to time of the concentration or amount of a substance in the body, or a part thereof, resulting from elimination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elimination rate" .

goldbook:16239 a skos:Concept ;
    skos:definition "Change occurring at the site of contact between an organism and a toxicant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local effect" .

goldbook:16240 a skos:Concept ;
    skos:definition "This is the preferred term for a substance that is considered to be toxic under circumstances which are thought likely to happen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicant" .

goldbook:16241 a skos:Concept ;
    skos:definition "Any drug or remedy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medicine" .

goldbook:16242 a skos:Concept ;
    skos:definition "Dispersion of solid electrically charged particles, commonly larger in size range than colloidal particles (of approximate diameter range \\(\\pu{{1}{-}{1000} nm}\\)) (dispersed phase), in water or an aqueous solution (continuous, liquid phase)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension of solid charged particles" .

goldbook:16243 a skos:Concept ;
    skos:definition "Galvanic cell containing, as its essential component, a uniform or combined suspension or one of its separated parts alone, the eqs or sediment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension potentiometric cell" .

goldbook:16244 a skos:Concept ;
    skos:definition "Electrochemical potential that arises at the reference electrode–measurement solution interface when, during a potentiometric measurement, the filling solution of the salt bridge of the reference electrode contacts the charged particles of a suspension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anomalous liquid junction potential" .

goldbook:16245 a skos:Concept ;
    skos:definition "General mathematical expression form of any ion X activity: \\[\\rm{p(ion\\ X)} = {\\rm{pX}} = -\\lg {\\rm{a_{X}}} = -\\lg ({\\rm{m_{X}} \\gamma_{X}/m^{\\circ}})\\], analogously to \\[\\pu{pH} = -\\lg {\\rm{a_{H}}} = -\\lg ({\\rm{m_{H}} \\gamma_{H}/m^{\\circ}})\\]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pIon" .

goldbook:16246 a skos:Concept ;
    skos:altLabel "soil suspension pH",
        "suspension soil pH" ;
    skos:definition "Readings on a pH-meter scale obtained for a suspension of soil (in water or electrolyte) by any method for potentiometric pH measurement, performed in a manner analogous to the pH measurement in solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension pH" .

goldbook:16247 a skos:Concept ;
    skos:altLabel "bridgehead" ;
    skos:definition "Atom that is part of two or more rings in a polycyclic molecule and that is separated from another bridgehead atom by bridges all of which contain at least one other atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bridgehead atom" .

goldbook:16248 a skos:Concept ;
    skos:definition "Feature of a reaction in which only one molecular entity is involved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unimolecular" .

goldbook:16249 a skos:Concept ;
    skos:definition "Process for converting a starting initiator or chain transfer agent into a macro-initiator or macro-chain-transfer agent during reversible-deactivation polymerization (RDP)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initialisation" .

goldbook:16250 a skos:Concept ;
    skos:definition "Molecule or compound designed to support, transport, and/or deliver one or several active species in order to take advantage of their specificity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugate" .

goldbook:16251 a skos:Concept ;
    skos:definition "Negative Napierian logarithm of the ratio of the intensity of radiation scattered (\\(I_{\\rm{s}}\\)) by a non-absorbing sample to the incident intensity (\\(I_{0}\\)), divided by the path-length, \\(l\\). \\[s = -\\ln(I_{s}/I_{0})/l\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering coefficient" .

goldbook:16252 a skos:Concept ;
    skos:altLabel "NA" ;
    skos:definition "For an optical fibre, \\(n_{\\rm{o}}\\) sin \\(\\theta_{\\alpha}\\), where \\(n_{\\rm{o}}\\) is the refractive index of the exterior medium and \\(\\theta_{\\alpha}\\) is the maximum input half angle that can support propagation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "numerical aperture" .

goldbook:16253 a skos:Concept ;
    skos:definition "Activity of a specified radionuclide (\\(\\ce{R}\\)) in a material (\\(\\ce{M}\\)) divided by amount of substance of that material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar activity (material)" .

goldbook:16254 a skos:Concept ;
    skos:definition "Response of an ion-selective electrode according to a local thermodynamic equilibrium, over a given range of activity (or concentration) that follows the Nernst equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nernstian response" .

goldbook:16256 a skos:Concept ;
    skos:definition "Technique in chromatography in which the sample is chemically derivatized before entering the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-column derivatisation" .

goldbook:16257 a skos:Concept ;
    skos:definition "Volume of the mobile phase divided by volume of the stationary phase in a column in counter-current chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase volume ratio" .

goldbook:16258 a skos:Concept ;
    skos:definition "Sum of the interparticle volume of the column and intraparticle volume of the column: \\(V_{\\rm{t}} = V_{0} + V_{\\rm{i}}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total mobile-phase volume in column" .

goldbook:16259 a skos:Concept ;
    skos:definition "Retention time of a sample component, the molecules of which are smaller than the largest pores of the particles of the stationary phase but larger than the smallest pores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention time" .

goldbook:16260 a skos:Concept ;
    skos:definition "Retention time of a sample component the molecules of which are smaller than the smallest pores of the particles of the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total mobile phase time" .

goldbook:16261 a skos:Concept ;
    skos:altLabel "alveolar phase" ;
    skos:definition "Phase in lung development beginning in utero (about \\(\\pu{32}\\) to \\(\\pu{36}\\) weeks in the human fetus) and lasting until about eight years of age." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alveolar period" .

goldbook:16262 a skos:Concept ;
    skos:definition "Fibroblast-derived bone-forming cell that produces a collagen type-I-rich matrix; this matrix calcifies to become bone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osteoblast" .

goldbook:16263 a skos:Concept ;
    skos:altLabel "belly button",
        "navel" ;
    skos:definition "Feature marking the point in the abdominal wall where the umbilical cord entered the fetus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umbilicus" .

goldbook:16264 a skos:Concept ;
    skos:definition "Difficulty in breathing; shortness of breath." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dyspnea" .

goldbook:16265 a skos:Concept ;
    skos:definition "One of a group of small proteins (peptides) that serve as neurotransmitters in the brain, autonomic nervous system and neuroendocrine system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neuropeptide" .

goldbook:16266 a skos:Concept ;
    skos:altLabel "NTE",
        "NTE assay" ;
    skos:definition "Test in which delayed neuropathy resulting from hydrolytic cleavage of organophosphate esters is studied with measurement of the responsible enzyme activity," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neurotoxic esterase assay" .

goldbook:16267 a skos:Concept ;
    skos:definition "Toxicity of a chemical in the presence of light due to the production of toxic photolysis products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo-induced toxicity" .

goldbook:16268 a skos:Concept ;
    skos:altLabel "independent component",
        "thermodynamic component" ;
    skos:definition "Constituent whose amount or concentration can be varied independently in a mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "component" .

goldbook:16269 a skos:Concept ;
    skos:definition "Chemical species present in a system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constituent" .

goldbook:16270 a skos:Concept ;
    skos:definition "Gaseous, liquid, or solid phase containing more than one substance, when all the substances are treated in the same way." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixture" .

goldbook:A00001 a skos:Concept ;
    skos:altLabel "1/1/addition",
        "alpha-addition" ;
    skos:definition "A chemical reaction resulting in a single reaction product from two or three reacting chemical species, with formation of two new chemical bonds to the same atom in one of the reactant molecular entities. The synonymous term 1/1/addition is also used. For example:  (This particular example can also be viewed as an insertion reaction.). In inorganic chemistry such $\\ce{\\upalpha\\!\\mbox{-}addition}$ reactions, generally to a metallic central atom, are known as 'oxidative additions'. $\\ce{\\upalpha\\!\\mbox{-}Addition}$ is the reverse of α-elimination or 1/1/elimination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-addition" .

goldbook:A00003 a skos:Concept ;
    skos:altLabel "alpha, beta" ;
    skos:definition "Stereodescriptors, used in a number of different ways.Relative stereodescriptors used in carbohydrate nomenclature to describe the configuration at the anomeric carbon by relating it to the anomeric reference atom. For simple cases the anomeric reference atom is the same as the configurational reference atom. Thus in $\\ce{\\upalpha\\!{-ᴅ-glucopyranose}}$ the reference atom is $\\ce{C-5}$ and the $\\ce{OH}$ at $\\ce{C-1}$ is on the same side as the $\\ce{OH}$ at $\\ce{C-5}$ in the Fischer projection.Relative stereodescriptors used by Chemical Abstracts Service to describe the configuration of a cyclic molecule (including suitable polycyclic systems) with several stereogenic centres whereby the $\\ce{\\upalpha\\!}$ side of the reference plane is the side on which the substituent with CIP priority lies at the lowest numbered stereogenic centre. The other side is $\\ce{\\upbeta\\!}$. Absolute stereodescriptors originally devised for steroid nomenclature. However in this sense it is only meaningful if there is an agreed absolute configuration and orientation of the structure so as to define the plane and which way up the molecule is represented. Substituents above the plane of the steroid are described as $\\ce{\\upbeta\\!}$ and are shown as a solid line ( or ); those below the plane are described as $\\ce{\\upalpha\\!}$ and are shown by a broken line ( or ). The extension of this system to tetrapyrroles has been documented and it has been widely used elsewhere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α, β" .

goldbook:A00004 a skos:Concept ;
    skos:altLabel "alpha-cleavage" ;
    skos:definition "The fission of a bond originating at an atom which is adjacent to one assumed to bear the charge; the definition of $\\ce{\\upbeta\\!\\mbox{-}}$, $\\ce{\\upgamma\\!\\mbox{-}}$ cleavage then follows automatically. The process:  would thus be described as $\\ce{\\upalpha\\!\\mbox{-}fission}$ of a ketone with expulsion of a radical $\\ce{R^{1.}}$ The carbon atoms of the radical $\\ce{R^{1.}}$ are called the $\\ce{\\upalpha\\!\\mbox{-}}$, $\\ce{\\upbeta\\!\\mbox{-}}$, $\\ce{\\upgamma\\!\\mbox{-}carbons}$, starting with the atom nearest the functional group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-cleavage" .

goldbook:A00005 a skos:Concept ;
    skos:altLabel "alpha-decay" ;
    skos:definition "Radioactive decay in which an alpha particle is emitted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-decay" .

goldbook:A00006 a skos:Concept ;
    skos:definition "A positive deviation of an $\\ce{\\upalpha\\!\\mbox{-}nucleophile}$ (a nucleophile bearing an unshared pair of electrons on an atom adjacent to the nucleophilic site) from a Brønsted-type plot of \\(\\log k_{\\rm{nuc}}\\) vs. \\({\\rm{p}}K_{\\rm{a}}\\) constructed for a series of related normal nucleophiles. More generally, it is the influence of the atom bearing a lone pair of electrons on the reactivity at the adjacent site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-effect" .

goldbook:A00007 a skos:Concept ;
    skos:definition "A transformation of the general type:  where the central atom Z is commonly carbon. The reverse reaction is called α-addition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-elimination" .

goldbook:A00009 a skos:Concept ;
    skos:definition "Synonymous with acyl carbenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-oxo carbenes" .

goldbook:A00012 a skos:Concept ;
    skos:altLabel "Winstein–Holness A value" ;
    skos:definition "The conformational preference of an equatorial compared to an axial substituent in a monosubstituted cyclohexane. This steric substituent parameter equals \\(\\Delta _{\\rm{r}}G^{\\,\\unicode{x26ac}}\\) in \\(\\pu{kcal mol-1}\\) for the equatorial to axial equilibration on cyclohexane. The values are also known as 'Winstein–Holness' A values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "'A' value" .

goldbook:A00013 a skos:Concept ;
    skos:definition "Action taken to reduce air pollution which involves the use of control equipment or some new process. This refers to a reduction or lessening as opposed to elimination of a type of discharge or pollutant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abatement" .

goldbook:A00014 a skos:Concept ;
    skos:definition "Bond migration, i.e. the formal transfer of one end of a skeletal bond to another position, with a compensating transfer of a hydrogen atom, can be indicated by a prefix of the form '\\(x(y\\rightarrow z)abeo-\\)'. The prefix is compiled as follows: a numeral denoting the stationary (unchanged) end of the migrating bond (x) is followed by parentheses enclosing the locant denoting the original position (y) from which the other end of this bond has migrated, an arrow, and the locant (z) denoting the new position to which the bond has moved. The closing parenthesis is followed by the italicized prefix abeo- (Latin: I go away) to indicate bond migration. The original numbering is retained for the new compound and is used for the numbers x, y and z. It is always necessary to specify the resulting stereochemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>abeo-</i>" .

goldbook:A00016 a skos:Concept ;
    skos:altLabel "abiological" ;
    skos:definition "Not associated with living organisms. Synonymous with abiological." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abiotic" .

goldbook:A00017 a skos:Concept ;
    skos:definition "Process in which a substance in the environment is modified by non-biological mechanisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abiotic transformation" .

goldbook:A00018 a skos:Concept ;
    skos:definition "A kind of activation analysis in which the elemental concentrations in the material are calculated from known nuclear constants, irradiation and measurement parameters, rather than by comparing with known standards." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute activation analysis" .

goldbook:A00020 a skos:Concept ;
    skos:definition "The spatial arrangement of the atoms of a chiral molecular entity (or group) and its stereochemical description, e.g., R or S." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute configuration" .

goldbook:A00021 a skos:Concept ;
    skos:definition "A measurement under such well-defined conditions that the activity of a sample can be derived directly from the observed counting rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute counting" .

goldbook:A00022 a skos:Concept ;
    skos:definition "The electrode potential of a metal measured with respect to a universal reference system (not including any additional metal/solution interface)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute electrode potential" .

goldbook:A00023 a skos:Concept ;
    skos:definition "Of a radiation spectrometer, the counting efficiency when considering only the events recorded in the full energy peak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute full energy peak efficiency" .

goldbook:A00024 a skos:Concept ;
    skos:definition "Lowest concentration of a substance in an environmental medium which kills 100% of test organisms or species under defined conditions. This value is dependent on the number of organisms used in its assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute lethal concentration" .

goldbook:A00025 a skos:Concept ;
    skos:definition "Lowest amount of a substance which kills 100% of test animals under defined conditions. This value is dependent on the number of organisms used in its assessment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute lethal dose" .

goldbook:A00026 a skos:Concept ;
    skos:definition "Of a γ-ray spectrometer, the counting efficiency when only the events recorded in the photopeak are considered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute photopeak efficiency" .

goldbook:A00027 a skos:Concept ;
    skos:definition "An operation (process) as the result of which microcomponents are transferred from the sample of larger mass into the sample of smaller mass, so that the concentration of the microcomponents is increased. Examples include the decrease in solvent volume during distillation or evaporation, and the transfer of microcomponents from an aqueous solution into a smaller volume of organic solvent by extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absolute preconcentration" .

goldbook:A00029 a skos:Concept ;
    skos:definition "A procedure where the concentration of a known analyte may be determined by diluting the sample with solvent until the absorbance matches the absorbance of the analyte in the reference cell. This method is particularly useful if the Beer-Lambert law does not hold." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbance matching" .

goldbook:A00030 a skos:Concept ;
    skos:definition "Amount of a substance absorbed into an organism or into organs and tissues of interest." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed dose" .

goldbook:A00031 a skos:Concept ;
    skos:definition "Energy imparted to matter by ionizing radiation in a suitable small element of volume divided by the mass of that element of volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed dose" .

goldbook:A00032 a skos:Concept ;
    skos:definition "Number of absorbed electrons per primary electron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed electron coefficient" .

goldbook:A00033 a skos:Concept ;
    skos:definition "The (excess) electrons present in a specimen under electron bombardment which are led to ground and measured as specimen current. The number of absorbed electrons per unit time (or the specimen current) equals the number of primary electrons minus the number of back scattered, secondary and transmitted electrons per unit time. Therefore the fraction of electrons being absorbed depends on many parameters, including the composition and thickness of the specimen, the primary electron energy, the electron incidence angle and local electrostatic fields when present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed electrons" .

goldbook:A00034 a skos:Concept ;
    skos:definition "A device used commonly for sampling by absorption in which a gaseous or liquid material is removed from another gas or liquid by selective absorption; these include: scrubber, impinger, packed column, spray chamber, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorber" .

goldbook:A00036 a skos:Concept ;
    skos:definition "The process of one material (absorbate) being retained by another (absorbent); this may be the physical solution of a gas, liquid, or solid in a liquid, attachment of molecules of a gas, vapour, liquid, or dissolved substance to a solid surface by physical forces, etc. In spectrophotometry, absorption of light at characteristic wavelengths or bands of wavelengths is used to identify the chemical nature of molecules, atoms or ions and to measure the concentrations of these species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption" .

goldbook:A00041 a skos:Concept ;
    skos:definition "A narrow range of wavelengths in which a substance absorbs light; a series of discrete absorption lines can be used as an unambiguous identification for many relatively simple chemical species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption line" .

goldbook:A00042 a skos:Concept ;
    skos:definition "The length of the radiation path through the absorbing medium; it is equal to the cell path length, \\(l\\), in the case of single-pass cells at normal incidence of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption pathlength" .

goldbook:A00043 a skos:Concept ;
    skos:definition "The wavelength dependence of the absorption cross-section (or absorption coefficient); usually represented as a plot of absorption cross-section versus wavelength \\(\\lambda\\) (or \\(\\frac{1}{\\lambda}\\)) of the light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption spectrum" .

goldbook:A00044 a skos:Concept ;
    skos:definition "Absorptance divided by the optical path length. For very low attenuance it approximates the absorption coefficient [within the approximation \\((1 - e^{-A}) \\sim A\\)]. The use of this term is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorptivity" .

goldbook:A00045 a skos:Concept ;
    skos:definition "A chemical reaction or transformation, the main feature of which is the bimolecular removal of an atom (neutral or charged) from a molecular entity. For example:  (proton abstraction from acetone)  (hydrogen abstraction from methane)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abstraction" .

goldbook:A00046 a skos:Concept ;
    skos:definition "In abstraction and extraction processes, an adsorptive or adsorbate species extracts an adsorbed atom or a lattice atom respectively. Abstraction process: Extraction process:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abstraction process" .

goldbook:A00048 a skos:Concept ;
    skos:definition "The ratio of the maximum ion current recorded at a mass \\(m\\) to the ion current arising from the same species recorded at an adjacent mass (\\(m\\pm 1\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "abundance sensitivity" .

goldbook:A00050 a skos:Concept ;
    skos:altLabel "high voltage scan" ;
    skos:definition "This is an alternative method of producing a momentum (mass) spectrum in magnetic deflection instruments by varying the accelerating voltage. This scan can also be used, in conjunction with a fixed radial electric field, to produce an ion kinetic energy spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accelerating voltage scan" .

goldbook:A00051 a skos:Concept ;
    skos:definition "Vector quantity equal to the derivative of velocity with respect to time. For the acceleration of free fall the symbol \\(g\\) is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceleration" .

goldbook:A00053 a skos:Concept ;
    skos:definition "Acceleration of free fall in vacuum due to gravity. Also called acceleration due to gravity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceleration of free fall" .

goldbook:A00056 a skos:Concept ;
    skos:altLabel "AN" ;
    skos:definition "A quantitative measure of Lewis acidity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptor number" .

goldbook:A00057 a skos:Concept ;
    skos:definition "A measure of the efficiency of capture of molecules or atoms which collide with aerosol particles, cloud droplets, etc. The accommodation coefficient is the fraction of the collisions which result in the capture of the molecules (atoms, radicals, etc.) by the particle, cloud droplet, etc.; fraction of colliding molecules which are not reflected but which enter the surface of an aqueous aerosol. Synonymous with sticking coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accommodation coefficient" .

goldbook:A00058 a skos:Concept ;
    skos:definition "The process by which aerosols grow in size by external addition of various chemical species; a form of agglomeration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accretion" .

goldbook:A00059 a skos:Concept ;
    skos:definition "Ability of a measuring instrument to give responses close to a true value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accuracy" .

goldbook:A00060 a skos:Concept ;
    skos:definition "Closeness of the agreement between the result of a measurement and a true value of the measurand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "accuracy" .

goldbook:A00061 a skos:Concept ;
    skos:definition "Polycyclic aromatic hydrocarbons consisting of fused benzene rings in a rectilinear arrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acenes" .

goldbook:A00062 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C(OR')2}$ ($\\ce{R'}  eq \\ce{H}$) and thus diethers of geminal diols. Originally, the term was confined to derivatives of aldehydes (one $\\ce{R = H}$), but it now applies equally to derivatives of ketones (neither $\\ce{R = H}$). Mixed acetals have different $\\ce{R'}$ groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetals" .

goldbook:A00064 a skos:Concept ;
    skos:definition "Cyclic acetals derived from acetone and diols, usually vicinal diols, or polyhydroxy compounds. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetonides" .

goldbook:A00065 a skos:Concept ;
    skos:definition "A special type of carbon black formed by an exothermic decomposition of acetylene. It is characterized by the highest degree of aggregation and crystalline orientation when compared with all types of carbon black." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetylene black" .

goldbook:A00066 a skos:Concept ;
    skos:definition "Acyclic (branched or unbranched) and cyclic (with or without side chain) hydrocarbons having one or more carbon–carbon triple bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetylenes" .

goldbook:A00067 a skos:Concept ;
    skos:definition "Compounds arising by replacement of one or both hydrogen atoms of acetylene (ethyne) by a metal or other cationic group. E.g., $\\ce{NaC#CH}$ monosodium acetylide. By extension, analogous compounds derived from terminal acetylenes, $\\ce{RC#CH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acetylides" .

goldbook:A00068 a skos:Concept ;
    skos:definition "A synthetic graphite made by the Acheson process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Acheson graphite" .

goldbook:A00071 a skos:Concept ;
    skos:definition "A molecular entity or chemical species capable of donating a hydron (proton) (see Brønsted acid) or capable of forming a covalent bond with an electron pair (see Lewis acid)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid" .

goldbook:A00072 a skos:Concept ;
    skos:altLabel "anhydrides" ;
    skos:definition "Compounds consisting of two acyl groups bonded to the same oxygen atom acyl-O-acyl. Symmetric and mixed anhydrides have identical and different acyl groups, respectively. Examples,acetic anhydride  acetic benzenesulfonic anhydride  (thiobenzoic) anhydride" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid anhydrides" .

goldbook:A00077 a skos:Concept ;
    skos:definition "The acids deposited by transfer from the atmosphere either by precipitation (rain, fog, snow, etc.), called wet deposition, or by direct transfer to the surface of the earth induced by the flow of acid-containing air masses over the earth's surface, called dry deposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid deposition" .

goldbook:A00079 a skos:Concept ;
    skos:definition "Of a compound: For Brønsted acids the tendency of a compound to act as a hydron donor. It can be quantitatively expressed by the acid dissociation constant of the compound in water or some other specified medium. For Lewis acids it relates to the association constants of Lewis adducts and π adducts.Of a medium: The use of the term is mainly restricted to a medium containing Brønsted acids, where it means the tendency of the medium to hydronate a specific reference base. It is quantitatively expressed by the appropriate acidity function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acidity" .

goldbook:A00081 a skos:Concept ;
    skos:definition "Any function that measures the thermodynamic hydron-donating or -accepting ability of a solvent system, or a closely related thermodynamic property, such as the tendency of the lyate ion of the solvent system to form Lewis adduct. (The term 'basicity function' is not in common use in connection with basic solutions.) Acidity functions are not unique properties of the solvent system alone, but depend on the solute (or family of closely related solutes) with respect to which the thermodynamic tendency is measured. Commonly used acidity functions refer to concentrated acidic or basic solutions. Acidity functions are usually established over a range of composition of such a system by UV/VIS spectrophotometric or NMR measurements of the degree of hydronation (protonation or Lewis adduct formation) for the members of a series of structurally similar indicator bases (or acids) of different strength: the best known of these functions is the Hammett acidity function \\(H_{0}\\) (for uncharged indicator bases that are primary aromatic amines)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acidity function" .

goldbook:A00082 a skos:Concept ;
    skos:definition "Pathological condition in which the hydrogen ion substance concentration of body fluids is above normal and hence the pH of blood falls below the reference interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acidosis" .

goldbook:A00083 a skos:Concept ;
    skos:definition "Rain with \\(\\rm{pH}\\) values &lt; about 5; commonly results from acids formed from pollutants. 'Pure' rain water equilibrated with atmospheric $\\ce{CO2}$ and naturally occurring acids in relatively clean air usually has a \\(\\rm{pH} > 5\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid rain" .

goldbook:A00085 a skos:Concept ;
    skos:definition "A class name for hydrocarbylideneazinic acids, $\\ce{R2C=N^{+}(–O^{−})OH}$. The use of aci-nitro as a prefix in systematic nomenclature to name specific compounds is abandoned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>aci</i>-nitro compounds" .

goldbook:A00086 a skos:Concept ;
    skos:definition "The quantity of light available to molecules at a particular point in the atmosphere and which, on absorption, drives photochemical processes in the atmosphere. It is calculated by integrating the spectral radiance \\(L \\left(\\lambda,\\,\\theta,\\,\\varphi\\,\\right)\\) over all directions of incidence of the light, \\(S_{\\lambda} = \\int _{\\theta}\\, \\int _{\\phi} \\{L\\left (\\lambda,\\theta,\\varphi \\right)/(hc/\\lambda)\\}\\, \\rm{sin}\\,\\theta\\: \\rm{d}\\theta\\: \\rm{d}\\varphi\\). If the radiance is expressed in \\(\\pu{J m-2 s-1 st-1 nm-1}\\) and \\(hc/\\lambda\\) is the energy per quantum of light of wavelength \\(\\lambda\\), the actinic flux has units of \\(\\rm{quanta cm}^{-2}\\ \\rm{s}^{-1}\\ \\rm{nm}^{-1}\\). This important quantity is one of the terms required in the calculation of j-values, the first order rate coefficients for photochemical processes in the sunlight-absorbing, trace gases in the atmosphere. The actinic flux is determined by the solar radiation entering the atmosphere and by any changes in this due to atmospheric gases and particles (e.g. Rayleigh scattering absorption by stratospheric ozone, scattering and absorption by aerosols and clouds), and reflections from the ground. It is therefore dependent on the wavelength of the light, on the altitude and on specific local environmental conditions. The actinic flux has borne many names (e.g. flux, flux density, beam irradiance, actinic irradiance, integrated intensity) which has caused some confusion. It is important to distinguish the actinic flux from the spectral irradiance, which refers to energy arrival on a flat surface having fixed spatial orientation (\\(\\pu{J m-2 nm-1}\\)) given by: \\[E_{\\lambda} = \\int _{\\theta}\\, \\int _{\\phi} L\\left (\\lambda,\\theta,\\varphi \\right )\\, \\rm{cos}\\,\\theta  \\: \\rm{sin}\\,\\theta\\: \\rm{d}\\theta\\: \\rm{d}\\varphi\\] The actinic flux does not refer to any specific orientation because molecules are oriented randomly in the atmosphere. This distinction is of practical relevance: the actinic flux (and therefore a j-value) near a brightly reflecting surface (e.g. over snow or above a thick cloud) can be a factor of three higher than that near a non-reflecting surface. The more descriptive name of spectral spheradiance is suggested for the quantity herein called actinic flux." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "actinic flux" .

goldbook:A00087 a skos:Concept ;
    skos:definition "A chemical system or physical device which determines the number of photons in a beam integrally or per unit time. This name is commonly applied to devices used in the ultraviolet and visible wavelength ranges. For example, solutions of iron(III) oxalate can be used as a chemical actinometer, while bolometers, thermopiles, and photodiodes are physical devices giving a reading that can be correlated to the number of photons detected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "actinometer" .

goldbook:A00088 a skos:Concept ;
    skos:definition "A plot of a relative biological or chemical photoresponse (= \\(\\Delta y\\)) per number of incident photons against wavelength or energy of radiation under the same radiant power of light. This form of presentation is frequently used in the studies of biological or solid state systems, where the nature of the absorbing species is unknown. This type of action spectrum is sometimes called spectral responsivity or sensitivity spectrum. The precise action spectrum is a plot of the spectral or quantum effectiveness. By contrast, a plot of the biological or chemical change or response per absorbed photon (quantum efficiency) versus wavelength is the efficiency spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "action spectrum" .

goldbook:A00089 a skos:Concept ;
    skos:definition "If the temperature coefficient of the rate of adsorption is substantial, an adsorption process is said to be activated (i.e. to have a significant activation energy). In this case, the sticking coefficient is small. In general, the activation energy of activated adsorption is a function of coverage and it usually increases with increasing coverage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated adsorption process" .

goldbook:A00090 a skos:Concept ;
    skos:definition "A porous carbon material, a char which has been subjected to reaction with gases, sometimes with the addition of chemicals, e.g. $\\ce{ZnCl2}$, before, during or after carbonization in order to increase its adsorptive properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated carbon" .

goldbook:A00091 a skos:Concept ;
    skos:definition "A traditional term for activated carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated charcoal" .

goldbook:A00092 a skos:Concept ;
    skos:definition "An activated complex, often characterized by the superscript ‡, is defined as that assembly of atoms which corresponds to an arbitrary infinitesimally small region at or near the col (saddle point) of a potential energy surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activated complex" .

goldbook:A00093 a skos:Concept ;
    skos:definition "This word is used in different senses:   Input of external energy into a chemical system is said to bring about activation of the system.   An added substance that increases the rate of a catalysed reaction is known as an activator, and the effect is called activation. The degree of activation \\(\\varepsilon_{\\rm{a}}\\) is defined by: \\[\\varepsilon_{\\rm{a}}=\\frac{v\\,-\\,v_{0}}{v_{0}} = \\frac{v}{v_{0}} - 1\\] where \\(v_{0}\\) is the rate of the catalysed reaction in the absence of the activator and \\(v\\) is the rate of the catalysed reaction in the presence of the activator.  When some of the energy required for a reaction to occur is provided by a previous exothermic chemical reaction there is said to be chemical activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activation" .

goldbook:A00094 a skos:Concept ;
    skos:definition "The process of transition from the passive to the active state by removal of the passivating film. A necessary condition for activation is an electrode potential negative to the equilibrium potential of formation of the passivating film. Activation is achieved by cathodic currents, by a reduced substance in the adjacent solution, or by contact with an electronic conductor having a suitably negative corrosion potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activation" .

goldbook:A00095 a skos:Concept ;
    skos:definition "The process of inducing radioactivity by irradiation. In general, a specification is added of the type of incident radiation (e.g. nuclear, neutron, photon) or its energy (e.g. thermal, fast)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activation" .

goldbook:A00096 a skos:Concept ;
    skos:altLabel "nuclear activation analysis" ;
    skos:definition "A kind of elemental or isotopic analysis based on the measurement of characteristic radiation from nuclides formed directly or indirectly by activation of the test portion. In general, a specification is added of the type of the incident radiation (e.g. neutron, photon) and its energy (e.g. thermal, fast)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activation analysis" .

goldbook:A00101 a skos:Concept ;
    skos:definition "The cross-section for the formation of a radionuclide by a specified reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activation cross-section" .

goldbook:A00104 a skos:Concept ;
    skos:definition "A substance, other than the catalyst or one of the substrates, that increases the rate of a catalysed reaction without itself being consumed; the process is called activation. An activator of an enzyme-catalysed reaction may be called enzyme activator, if it acts by binding to the enzyme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activator" .

goldbook:A00107 a skos:Concept ;
    skos:definition "A metal corroding in the active state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active metal" .

goldbook:A00108 a skos:Concept ;
    skos:definition "The term is often applied to those sites for adsorption which are the effective sites for a particular heterogeneous catalytic reaction. The terms active site and active centre are often used as synonyms, but active centre may also be used to describe an ensemble of sites at which a catalytic reaction takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active site" .

goldbook:A00111 a skos:Concept ;
    skos:definition "Corrosion in the active state occurs by direct transfer (which may involve one or several steps) of metal ions from the metallic phase to the adjacent electrolyte. The corrosion current of an active metal usually increases when the electrode potential is made more positive, other conditions remaining constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active state" .

goldbook:A00112 a skos:Concept ;
    skos:definition "The carriage of a solute across a biological membrane from low to high concentration which requires the expenditure of (metabolic) energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "active transport" .

goldbook:A00114 a skos:Concept ;
    skos:altLabel "decay rate",
        "disintegration rate" ;
    skos:definition "The number of nuclear decays occurring in a given quantity of material in a small time interval, divided by that time interval. Often, this term is referred to as absolute activity. Symbol \\(A=- \\frac{\\mathrm{d}N}{\\mathrm{d}t}\\). Synonymous with disintegration rate or decay rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activity" .

goldbook:A00115 a skos:Concept ;
    skos:altLabel "relative activity" ;
    skos:definition "Defined by the equation \\[a = e^{\\frac{\\mu - \\mu^{o}}{R\\,T}}\\] where \\(R\\) is the gas constant, \\(T\\) the thermodynamic temperature, \\(\\mu\\) the chemical potential and \\(\\mu^{o}\\) the standard chemical potential the definition of which depends on the choice of the standard state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activity" .

goldbook:A00116 a skos:Concept ;
    skos:definition "The activity coefficient \\(f_{\\rm{B}}\\) of a substance B in a liquid or solid mixture containing mole fractions \\(x_{\\rm{B}}\\), \\(x_{\\rm{C}}\\), ... of the substances B, C, ... is a dimensionless quantity defined in terms of the chemical potential \\(\\mu _{\\rm{B}}\\) of B in the mixture by: \\[R\\ T\\ \\ln (x_{\\rm{B}}\\ f_{\\rm{B}})=\\mu _{\\rm{B}}\\left(\\rm{cd},\\,T,\\,P,\\,x\\right)- \\mu _{\\rm{B}}^{*}\\left(\\rm{cd},\\,T,\\,p\\right)\\] where \\(x\\) denotes the set of mole fractions \\(x_{\\rm{B}}\\), \\(x_{\\rm{C}}\\), ... . The activity coefficient \\(\\gamma _{\\rm{B}}\\) of a solute B in a solution (especially a dilute liquid solution) containing molalities \\(m_{\\rm{B}}\\), \\(m_{\\rm{C}}\\), ... of solutes B, C, ... in a solvent A is a dimensionless quantity defined in terms of the chemical potential \\(\\mu _{\\rm{B}}\\) by: \\[R\\ T\\ \\ln \\left(\\frac{m_{\\rm{B}}\\ \\gamma _{\\rm{B}}}{m^{\\ominus}}\\right)=\\mu _{\\rm{B}}- \\left\\{\\mu _{\\rm{B}}- R\\ T\\ \\ln \\left(\\frac{m_{\\rm{B}}}{m^{\\ominus }}\\right)\\right\\}^{\\infty }\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "activity coefficient" .

goldbook:A00119 a skos:Concept ;
    skos:definition "Diesters of geminal diols; i.e.  E.g. benzylidene diacetate:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acylals" .

goldbook:A00121 a skos:Concept ;
    skos:definition "Any compound . In organic chemistry, an unspecified acyl carbene is commonly a carboxylic acyl carbene, ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyl carbenes" .

goldbook:A00123 a skos:Concept ;
    skos:definition "Groups formed by removing one or more hydroxy groups from oxoacids that have the general structure $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$), and replacement analogues of such acyl groups. In organic chemistry an unspecified acyl group is commonly a carboxylic acyl group. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyl groups" .

goldbook:A00124 a skos:Concept ;
    skos:definition "Compounds consisting of an acyl group bonded to halogen, e.g. $\\ce{CH3S(=O)2Cl}$, methanesulfonyl chloride; $\\ce{CH3COCl}$, acetyl chloride; cyclohexanecarboximidoyl chloride," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyl halides" .

goldbook:A00126 a skos:Concept ;
    skos:definition "$\\ce{\\upalpha\\!\\mbox{-}Hydroxy}$ ketones, $\\ce{RCH(OH)C(=O)R}$. So named from the fact that they are formally derived from reductive coupling of carboxylic acyl groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyloins" .

goldbook:A00127 a skos:Concept ;
    skos:definition "Oxygen-centered radicals consisting of an acyl radical bonded to an oxygen atom. E.g. ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyloxyl radicals" .

goldbook:A00129 a skos:Concept ;
    skos:definition "Acyl intermediates include acyl anions, acyl radicals and acyl cations (synonym acylium ions) which are formally derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by removal of a hydroxyl cation $\\ce{HO^{+}}$, a hydroxyl radical $\\ce{HO^{.}}$ or a hydroxyl anion $\\ce{HO^{-}}$, respectively, and replacement analogues of such intermediates. Acyl anions, radicals and cations can formally be represented by canonical forms having a negative charge, an unpaired electron or a positive charge on the acid-generating element of the oxoacid.Acyl anions, e.g. Acyl radicals, e.g. Acyl cations, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyl species" .

goldbook:A00132 a skos:Concept ;
    skos:definition "Refers to addition reaction or addition transformation.Loosely, the formation of an adduct. (For an example, see Lewis acid.)Loosely, any association or attachment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "addition" .

goldbook:A00133 a skos:Concept ;
    skos:definition "A chemical reaction of two or more reacting molecular entities, resulting in a single reaction product containing all atoms of all components, with formation of two chemical bonds and a net reduction in bond multiplicity in at least one of the reactants. The reverse process is called an elimination reaction. The addition may occur at only one site (α-addition, 1/1/addition), at two adjacent sites (1/2/addition) or at two non-adjacent sites (1/3/- or 1/4/addition, etc.). For example:   If the reagent or the source of the addends of an addition are not specified, then it is called an addition transformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "addition reaction" .

goldbook:A00135 a skos:Concept ;
    skos:definition "The formal assembly of names for the components of a compound without loss of atoms or groups of atoms from any componentThe addition or attachment of atoms or groups of atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "additive name" .

goldbook:A00137 a skos:Concept ;
    skos:definition "The hypothesis that each of several structural features of a molecular entity makes a separate and additive contribution to a property of the substance concerned. More specifically, it is the hypothesis that each of the several substituent groups in a parent molecule makes a separate and additive contribution to the standard Gibbs energy change (or Gibbs energy of activation) corresponding to a particular equilibrium (or rate of reaction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "additivity principle" .

goldbook:A00138 a skos:Concept ;
    skos:definition "A new chemical species AB, each molecular entity of which is formed by direct combination of two separate molecular entities A and B in such a way that there is change in connectivity, but no loss, of atoms within the moieties A and B. Stoichiometries other than 1:1 are also possible, e.g. a bis-adduct (2:1). An intramolecular adduct can be formed when A and B are groups contained within the same molecular entity. This is a general term which, whenever appropriate, should be used in preference to the less explicit term complex. It is also used specifically for products of an addition reaction. For examples, see Lewis adduct, Meisenheimer adduct, π-adduct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adduct" .

goldbook:A00139 a skos:Concept ;
    skos:definition "An ion formed by interaction of two species, usually an ion and a molecule, and often within the ion source, to form an ion containing all the constituent atoms of one species as well as an additional atom or atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adduct ion" .

goldbook:A00140 a skos:Concept ;
    skos:definition "A process in which an adhesional joint is formed between two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adhesional wetting" .

goldbook:A00141 a skos:Concept ;
    skos:definition "This word is used with various different meanings, and when it is used it should be defined. In thermodynamics 'adiabatic' is used in a macroscopic sense to refer to a process occurring in a thermally insulated system, so that there is no flow of heat to or from the surroundings. In reaction dynamics, the word has been used in a microscopic sense, with a range of meanings which have only a tenuous relationship to the thermodynamic meaning or the etymology. Whereas the thermodynamic meaning relates to conditions imposed on a process by an observer, the microscopic meaning relates to conditions under which the process occurs naturally. The microscopic meanings, as used in reaction dynamics, all have in common the feature that quantum states remain unchanged during the course of reaction. Different quantum states may be referred to: A reaction that is not adiabatic is referred to as nonadiabatic or diabatic, and some workers make a distinction between the two words.A reaction in which there is no change of electronic state or multiplicity has been called adiabatic, or more specifically electronically adiabatic. A reaction in which there is no change of vibrational state during the course of reaction has been said to be vibrationally adiabatic. More loosely, the expression has been applied to a process in which excess vibrational energy in the reactants appears as vibrational energy in the products, or in which ground-state vibration in the reactants leads to ground state vibration in the products.A reaction in which excess rotational energy in the reactants appears as rotational energy in the products, or in which ground-state rotation in the reactants leads to ground-state rotation in the products, has been referred to as rotationally adiabatic.In the Rice–Ramsperger–Kassel–Marcus (RRKM) theory of unimolecular reactions, a degree of freedom whose quantum number is more or less preserved during energization and subsequent reaction has been called 'adiabatic'; the word 'inactive' has also been applied to it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic" .

goldbook:A00142 a skos:Concept ;
    skos:definition "Electron transfer process in which the reacting system remains on a single electronic surface in passing from reactants to products. For adiabatic electron transfer the electronic transmission factor is close to unity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic electron transfer" .

goldbook:A00143 a skos:Concept ;
    skos:definition "A process whereby an electron is either removed from or added to an atom or molecule producing an ion in its ground state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic ionization" .

goldbook:A00144 a skos:Concept ;
    skos:definition "The rate of decrease in temperature with increase in altitude of an air parcel which is expanding slowly to a lower atmospheric pressure without exchange of heat; for a descending parcel it is the rate of increase in temperature with decrease in altitude. Theory predicts that for dry air it is equal to the acceleration of gravity divided by the specific heat of dry air at constant pressure (approximately \\(9.8\\ ^{\\unicode{x26ac}} \\rm{C}\\ \\rm{km}^{-1}\\)). The moist adiabatic lapse rate is less than the dry adiabatic lapse rate and depends on the moisture content of the air mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic lapse rate" .

goldbook:A00145 a skos:Concept ;
    skos:definition "Within the 'Born-Oppenheimer' approximation, a reaction of an excited state species that occurs on a single 'potential-energy surface'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic photoreaction" .

goldbook:A00146 a skos:Concept ;
    skos:definition "A form of transition-state theory in which the system is assumed to preserve its internal quantum states as it moves over the potential-energy surface. A detailed state-to-state scattering theory version of adiabatic transition-state theory has been referred to as the adiabatic channel model." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic transition-state theory" .

goldbook:A00147 a skos:Concept ;
    skos:definition "These are treatments of reaction rates in which the system is assumed to remain on a single potential-energy surface during the entire course of reaction, or to remain in a conserved internal state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adiabatic treatments of reaction rates" .

goldbook:A00150 a skos:Concept ;
    skos:definition "In pharmacology, a substance added to a drug to speed or increase the action of the main component.In immunology, a substance (such as aluminium hydroxide) or an organism (such as bovine tuberculosis bacillus) which increases the response to an antigen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adjuvant" .

goldbook:A00152 a skos:Concept ;
    skos:definition "A molecular species of gas, dissolved substance or liquid which adheres to or is adsorbed in an extremely thin surface layer of a solid substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorbate" .

goldbook:A00153 a skos:Concept ;
    skos:definition "A condensed phase at the surface of which adsorption may occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorbent" .

goldbook:A00154 a skos:Concept ;
    skos:definition "Solid material used to capture either a gas or liquid; often activated carbon is employed as the solid because of its high surface area per unit mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorber" .

goldbook:A00155 a skos:Concept ;
    skos:definition "An increase in the concentration of a dissolved substance at the interface of a condensed and a liquid phase due to the operation of surface forces. Adsorption can also occur at the interface of a condensed and a gaseous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption" .

goldbook:A00156 a skos:Concept ;
    skos:definition "For strongly adsorbed solutes of limited solubility, the value of the amount of adsorbed substance reached in a saturated solution is called the adsorption capacity of the adsorbent for a specific solute; its value depends also, in general, on the nature and, in the case of more than two components, on the relative composition of the bulk liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption capacity" .

goldbook:A00157 a skos:Concept ;
    skos:definition "Chromatography in which separation is based mainly on differences between the adsorption affinities of the sample components for the surface of an active solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption chromatography" .

goldbook:A00158 a skos:Concept ;
    skos:definition "The entity constituted by the adsorbate and the part of the adsorbent to which it is bound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption complex" .

goldbook:A00159 a skos:Concept ;
    skos:definition "A faradaic current whose magnitude depends on the applied potential, and, at any particular applied potential, on the rate or extent of the adsorption of an electroactive substance (or the product obtained from the reduction or oxidation of an electroactive substance) onto the surface of the indicator or working electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption current" .

goldbook:A00161 a skos:Concept ;
    skos:definition "Adsorption hysteresis is said to occur when adsorption and desorption values deviate from one another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption hysteresis" .

goldbook:A00163 a skos:Concept ;
    skos:definition "The function relating the amount, mass, or volume, or corresponding excess of substance adsorbed by a given amount of solid, to the temperature at constant pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption isobar" .

goldbook:A00164 a skos:Concept ;
    skos:definition "The function relating the equilibrium pressure to the temperature at a constant value of the amount, or excess amount, of substance adsorbed by a given amount of solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption isostere" .

goldbook:A00166 a skos:Concept ;
    skos:definition "The material that is present in one or other (or both) of the bulk phases and capable of being adsorbed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorptive" .

goldbook:A00168 a skos:Concept ;
    skos:definition "The transport of air, its properties (such as heat), trace materials, fog, cold air, etc., solely by mass motion of the atmosphere, generally in a horizontal direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "advection" .

goldbook:A00169 a skos:Concept ;
    skos:definition "The process by which a volume filled with a liquid becomes permeated with air or another gas; aeration is often accomplished by spraying the liquid into the air, bubbling air through a liquid or agitating the liquid to promote surface absorption of air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aeration" .

goldbook:A00170 a skos:Concept ;
    skos:definition "An organism that needs oxygen for respiration and hence for growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerobe" .

goldbook:A00171 a skos:Concept ;
    skos:definition "Requiring molecular oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerobic" .

goldbook:A00172 a skos:Concept ;
    skos:definition "Conditions for growth or metabolism in which the organism is sufficiently supplied with oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerobic conditions" .

goldbook:A00173 a skos:Concept ;
    skos:definition "Gel comprised of a microporous solid in which the dispersed phase is a gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerogel" .

goldbook:A00174 a skos:Concept ;
    skos:definition "Instrument used to measure the density of gases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerometer" .

goldbook:A00175 a skos:Concept ;
    skos:definition "A measurement of the temperature, pressure, air motion (velocity vectors), or other physical measurement to characterize an air mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerometric measurement" .

goldbook:A00176 a skos:Concept ;
    skos:definition "Sol in which the dispersed phase is a solid, a liquid or a mixture of both and the continuous phase is a gas (usually air)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerosol" .

goldbook:A00177 a skos:Concept ;
    skos:definition "An expression characterizing the particular variant of chromatography in which the unique biological specificity of the analyte and ligand interaction is utilized for the separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "affinity chromatography" .

goldbook:A00182 a skos:Concept ;
    skos:altLabel "coagulation",
        "flocculation" ;
    skos:definition "Process of contact and adhesion whereby dispersed particles are held together by weak physical interactions ultimately leading to phase separation by the formation of precipitates of larger than colloidal size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agglomeration" .

goldbook:A00183 a skos:Concept ;
    skos:definition "An immunochemical reaction leading to the aggregation of particulate matter such as bacteria, erythrocytes or other cells, or synthetic particles such as plastic beads coated with antigens or antibodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agglutination" .

goldbook:A00184 a skos:Concept ;
    skos:definition "Certain materials used as catalysts or supports consist of spheroids smaller than \\(10\\ \\rm{nm}\\) in diameter, cemented into larger entities. A primary particle should be defined as the smallest discrete identifiable entity and the method of identification should be mentioned (e.g. transmission electron microscopy, scanning electron microscopy). An assemblage of such primary particles exhibiting an identifiable collective behaviour (e.g. chemical nature of the aggregated primary particles, texture of the aggregate, resistance to mechanical separation upon grinding) constitutes an aggregate. When describing the aggregates the criterion of identification should be mentioned. Strongly bonded aggregates are called agglomerates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aggregate" .

goldbook:A00185 a skos:Concept ;
    skos:altLabel "aglycone" ;
    skos:definition "The non-sugar compound remaining after replacement of the glycosyl group from a glycoside by a hydrogen atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aglycon" .

goldbook:A00186 a skos:Concept ;
    skos:definition "Substance which binds to cell receptors normally responding to naturally occurring substances and which produces a response of its own." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agonist" .

goldbook:A00187 a skos:Concept ;
    skos:definition "The term designates structures in which a hydrogen atom is bonded to both a carbon atom and a metal atom. The term is also used to characterize the interaction between a $\\ce{CH}$ bond and an unsaturated metal centre, and to describe similar bonding of a transition metal with $\\ce{Si–H}$ compounds. The expression '$\\mu$-hydrido-bridged' is also used to describe the bridging hydrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agostic" .

goldbook:A00188 a skos:Concept ;
    skos:definition "A monogranular or monolithic carbon material with homogeneous microstructure which does not exhibit any structural components distinguishable by optical microscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agranular carbon" .

goldbook:A00190 a skos:Concept ;
    skos:definition "A substance, gaseous material or aerosol, which is present in an air mass at levels greater than in clean air. An air contaminant has been added commonly by anthropogenic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air contaminant" .

goldbook:A00191 a skos:Concept ;
    skos:definition "A bioreactor in which the reaction medium is kept mixed and gassed by introduction of air or another gas (mixture) at the base of a column-like reactor equipped either with a draught tube or another device (e.g. external tube) by which the reactor volume is separated into a gassed and an ungassed region thus generating a vertically circulating flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air-lift bioreactor" .

goldbook:A00192 a skos:Concept ;
    skos:definition "A qualitative term to describe a widespread body of air with approximately uniform characteristics which had been identified at a given time over a particular region of the earth's surface. Sometimes an air mass is marked by inert tracers such as $\\ce{SF6}$ which may be added to it. The composition of a given air mass undergoes alteration as it migrates, chemical changes occur, compounds are removed by dry and wet deposition and new impurities are added to the mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air mass" .

goldbook:A00193 a skos:Concept ;
    skos:definition "A site at which monitoring of the concentration of one or more pollutants is carried out (e.g. the BAPMoN stations, Background Air Pollution Monitoring Network of the WMO, World Meteorological Organization)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air monitoring station" .

goldbook:A00194 a skos:Concept ;
    skos:altLabel "pollutant",
        "pollution" ;
    skos:definition "A substance, gaseous material or aerosol which has been introduced into the air (either by human activity or by natural processes) in sufficient concentration to produce a measurable effect on humans, animals, vegetation or materials (monuments, etc.): $\\ce{SO2}$, $\\ce{NO2}$, $\\ce{H2S}$, $\\ce{CO}$, hydrocarbons, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air pollutant" .

goldbook:A00195 a skos:Concept ;
    skos:definition "Usually the presence of substances in the atmosphere, resulting either from human activity or natural processes, present in sufficient concentration, for a sufficient time and under circumstances such as to interfere with comfort, health or welfare of persons or the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air pollution" .

goldbook:A00196 a skos:Concept ;
    skos:altLabel "air quality index" ;
    skos:definition "A mathematical combination of the concentrations of air pollutants (weighted in some fashion to reflect the estimated health impact of the specific pollutant) which gives an approximate numerical measure of the quality of the air at a given time. These indices have little scientific basis but have been used to inform the public (in a qualitative fashion) of the degree of pollution present at a given time. It is recommended that the actual measured pollutant concentrations be used by all information services when possible with simultaneous reference given to the corresponding concentrations which are considered by health authorities to be hazardous to human health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air pollution index" .

goldbook:A00197 a skos:Concept ;
    skos:definition "A study of the concentrations and geographical distribution of specified air pollutants in a given area and an assessment of the damage, if any, which the pollutants have caused." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air pollution survey" .

goldbook:A00198 a skos:Concept ;
    skos:definition "One of the quantifiable properties relating to an air sample: concentration of a constituent, wind speed, temperature, etc. The quantity of air quality characteristic is the true value of the characteristic being investigated; it is recognized that in practice, this value can only be approximated by existing methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air quality characteristic" .

goldbook:A00199 a skos:Concept ;
    skos:definition "The detailed planning and the implementation of air pollution control programs designed to preserve the health and welfare of the people in the region, the plant and animal life, physical property, good visibility and other factors which determine the air quality and the maintenance of an aesthetically acceptable environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air resource management" .

goldbook:A00200 a skos:Concept ;
    skos:definition "A number of air sampling stations which are established in a given geographical region at which measurements of both pollutant concentrations and meteorological quantities (wind speed, direction, rain fall, humidity, etc.) are made to determine the extent and the nature of the air pollution and to establish trends in the concentrations of the air pollutants with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "air sampling network" .

goldbook:A00201 a skos:Concept ;
    skos:definition "Aerosol particles below \\(0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter. These generally are the most numerous among all particles in the air. Their concentrations can be determined with the Aitken counter which measures total particle number density. Owing to their small size, Aitken particles contribute little to the total mass concentration of all aerosol particles; this is determined primarily by particles of diameter \\(> 0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Aitken particles" .

goldbook:A00202 a skos:Concept ;
    skos:definition "The fraction of the energy of electromagnetic radiation reflected from a body (or surface) relative to the energy incident upon it. The reflection of light from a surface is, of course, dependent on the wavelength of the light, the nature of the surface and its angle of incidence with the surface. The term albedo usually connotes a broad wavelength band (visible, ultraviolet or infrared), whereas the terms reflectivity and spectral albedo are used to describe the reflection of monochromatic (single wavelength or small band of wavelengths) radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "albedo" .

goldbook:A00203 a skos:Concept ;
    skos:definition "Synonymous with alkoxides. Alcoholate should not be used for solvates derived from an alcohol such as $\\ce{CaCl2.nROH}$, for the ending -ate often occurs in names for anions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alcoholates" .

goldbook:A00204 a skos:Concept ;
    skos:definition "Compounds in which a hydroxy group, $\\ce{-OH}$, is attached to a saturated carbon atom $\\ce{R3COH}$. The term 'hydroxyl' refers to the radical species, $\\ce{HO^{.}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alcohols" .

goldbook:A00206 a skos:Concept ;
    skos:definition "Polyhydroxy dicarboxylic acids having the general formula $\\ce{HOC(=O)[CH(OH)]_{n}C(=O)OH}$, formally derived from an aldose by oxidation of both terminal carbon atoms to carboxyl groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldaric acids" .

goldbook:A00207 a skos:Concept ;
    skos:definition "Azines of aldehydes $\\ce{RCH=NN=CHR}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldazines" .

goldbook:A00208 a skos:Concept ;
    skos:definition "Compounds $\\ce{RC(=O)H}$, in which a carbonyl group is bonded to one hydrogen atom and to one $\\ce{R}$ group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldehydes" .

goldbook:A00209 a skos:Concept ;
    skos:definition "Imines derived from aldehydes $\\ce{RCH=NR}$. E.g. $\\ce{EtCH=NH}$, $\\ce{PhCH=NMe}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldimines" .

goldbook:A00210 a skos:Concept ;
    skos:altLabel "glycitols" ;
    skos:definition "Acyclic polyols having the general formula $\\ce{HOCH2[CH(OH)]nCH2OH}$ (formally derivable from an aldose by reduction of the carbonyl group)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alditols" .

goldbook:A00211 a skos:Concept ;
    skos:definition "A now less preferred synonym for ketoaldoses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldoketoses" .

goldbook:A00212 a skos:Concept ;
    skos:altLabel "glyconic acids" ;
    skos:definition "Polyhydroxy acids having the general formula $\\ce{HOCH2[CH(OH)]_{n}C(=O)OH}$ and therefore derived from an aldose by oxidation of the aldehyde function, e.g. ᴅ-gluconic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldonic acids" .

goldbook:A00213 a skos:Concept ;
    skos:definition "Aldehydic parent sugars (polyhydroxyaldehydes $\\ce{H[CH(OH)]_{n}C(=O)H}$, $n \\ge 2$) and their intramolecular hemiacetals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldoses" .

goldbook:A00214 a skos:Concept ;
    skos:definition "Oximes of aldehydes $\\ce{RCH=NOH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aldoximes" .

goldbook:A00215 a skos:Concept ;
    skos:definition "Designated concentrations of certain key pollutants at which some degree of danger to public health is expected. In many areas in which a relatively high level of pollution is often encountered, several levels of alert are often established. For example, a first alert may signify a potential problem exists; a second alert becomes a signal for the curtailment of certain significant emission sources; the third alert signifies the need for some specified emergency action which must be taken to ensure the public safety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alert levels" .

goldbook:A00216 a skos:Concept ;
    skos:definition "Aliphatic compounds having a carbocyclic ring structure which may be saturated or unsaturated, but may not be a benzenoid or other aromatic system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alicyclic compounds" .

goldbook:A00217 a skos:Concept ;
    skos:definition "Acyclic or cyclic, saturated or unsaturated carbon compounds, excluding aromatic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aliphatic compounds" .

goldbook:A00218 a skos:Concept ;
    skos:definition "A known amount of a homogeneous material, assumed to be taken with negligible sampling error. The term is usually applied to fluids. The term 'aliquot' is usually used when the fractional part is an exact divisor of the whole; the term 'aliquant' has been used when the fractional part is not an exact divisor of the whole (e.g. a \\(15\\ \\rm{ml}\\) portion is an aliquant of \\(100\\ \\rm{ml}\\)). When a laboratory sample or test sample is 'aliquoted' or otherwise subdivided, the portions have been called split samples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aliquot" .

goldbook:A00220 a skos:Concept ;
    skos:definition "Basic nitrogen compounds (mostly heterocyclic) occurring mostly in the plant kingdom (but not excluding those of animal origin). Amino acids, peptides, proteins, nucleotides, nucleic acids, amino sugars and antibiotics are not normally regarded as alkaloids. By extension, certain neutral compounds biogenetically related to basic alkaloids are included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkaloids" .

goldbook:A00221 a skos:Concept ;
    skos:definition "Pathological condition in which the hydrogen ion substance concentration of body fluids is below normal and hence the pH of blood rises above the reference interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkalosis" .

goldbook:A00222 a skos:Concept ;
    skos:definition "Acyclic branched or unbranched hydrocarbons having the general formula $\\ce{C_{n}H_{2n+2}}$, and therefore consisting entirely of hydrogen atoms and saturated carbon atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkanes" .

goldbook:A00223 a skos:Concept ;
    skos:definition "Carbocations derived from alkanes by $C$-hydronation containing at least one pentacoordinate carbon atom, e.g. $\\ce{^{+}CH5}$ methanium, $\\ce{[C2H7]^{+}$ ethanium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkanium ions" .

goldbook:A00224 a skos:Concept ;
    skos:definition "Acyclic branched or unbranched hydrocarbons having one carbon–carbon double bond and the general formula $\\ce{C_{n}H_{2n}}$. Acyclic branched or unbranched hydrocarbons having more than one double bond are alkadienes, alkatrienes, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkenes" .

goldbook:A00225 a skos:Concept ;
    skos:definition "Compounds, $\\ce{ROM}$, derivatives of alcohols, $\\ce{ROH}$, in which $\\ce{R}$ is saturated at the site of its attachment to oxygen and $\\ce{M}$ is a metal or other cationic species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkoxides" .

goldbook:A00226 a skos:Concept ;
    skos:definition "O-Alkyl hydroxylamines (with or without substitution on $\\ce{N}$) $\\ce{R'ONR2}$ ($\\ce{R' eq H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkoxyamines" .

goldbook:A00227 a skos:Concept ;
    skos:definition "An old term, which is not recommended, for alkenes, especially those of low molecular weight.An old term for alkanediyl groups commonly but not necessarily having the free valencies on adjacent carbon atoms, e.g. $\\ce{–CH(CH3)CH2\\bond{–}}$ propylene (systematically called propane-1,2-diyl)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylenes" .

goldbook:A00228 a skos:Concept ;
    skos:definition "Univalent groups derived from alkanes by removal of a hydrogen atom from any carbon atom $\\ce{–C_{n}H_{2n+1}}$. The groups derived by removal of a hydrogen atom from a terminal carbon atom of unbranched alkanes form a subclass of normal alkyl ($n$-alkyl) groups $\\ce{H(CH2)_{n}}$. The groups $\\ce{RCH2}$, $\\ce{R2CH}$ ($\\ce{R  eq H}$), and $\\ce{R3C}$ ($\\ce{R  eq H}$) are primary, secondary and tertiary alkyl groups, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkyl groups" .

goldbook:A00230 a skos:Concept ;
    skos:definition "Radicals having the structure $\\ce{R2C=N–O^{.}}$. Synonymous with iminoxyl radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylideneaminoxyl radicals" .

goldbook:A00231 a skos:Concept ;
    skos:definition "Radicals having the structure $\\ce{R2C=N^{.}}$. Synonymous with iminyl radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylideneaminyl radicals" .

goldbook:A00232 a skos:Concept ;
    skos:definition "The divalent groups formed from alkanes by removal of two hydrogen atoms from the same carbon atom, the free valencies of which are part of a double bond, e.g. $\\ce{(CH3)2C=}$ propan-2-ylidene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylidene groups" .

goldbook:A00233 a skos:Concept ;
    skos:definition "Carbenes $\\ce{R2C{:}}$ formed by mono or dialkyl substitution of methylene, $\\ce{H2C{:}}$, e.g. $\\ce{CH3CH2CH{:}}$ propylidene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylidenes" .

goldbook:A00234 a skos:Concept ;
    skos:definition "Carbenes $\\ce{R2C…}$ containing a univalent carbon atom, atom, e.g. $\\ce{CH3CH2C…}$ propylidyne" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkylidynes" .

goldbook:A00235 a skos:Concept ;
    skos:definition "Carbon-centered radicals derived formally by removal of one hydrogen atom from an alkane, e.g. $\\ce{CH3CH2C^{.}H2}$ propyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkyl radicals" .

goldbook:A00236 a skos:Concept ;
    skos:definition "Acyclic branched or unbranched hydrocarbons having a carbon-carbon triple bond and the general formula $\\ce{C_{n}H_{2n-2}}$, $\\ce{RC#CR}$. Acyclic branched or unbranched hydrocarbons having more than one triple bond are known as alkadiynes, alkatriynes, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkynes" .

goldbook:A00237 a skos:Concept ;
    skos:definition "One of several alternate forms of a gene which occur at the same locus on homologous chromosomes and which become separated during meiosis and can be recombined following fusion of gametes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allele" .

goldbook:A00238 a skos:Concept ;
    skos:definition "Hydrocarbons (and by extension, derivatives formed by substitution) having two double bonds from one carbon atom to two others $\\ce{R2C=C=CR2}$. (The simplest member, propadiene, is known as allene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allenes" .

goldbook:A00240 a skos:Concept ;
    skos:definition "Enzymes which contain regions to which small, regulatory molecules (cf. effector) may bind in addition to and separate from substrate binding sites. On binding the effector, the catalytic activity of the enzyme towards the substrate may be enhanced, in which case the effector is an activator, or reduced, in which case it is an inhibitor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allosteric enzymes" .

goldbook:A00241 a skos:Concept ;
    skos:definition "A phenomenon whereby the conformation of an enzyme or other protein is altered by combination, at a site other than the substrate-binding site, with a small molecule, referred to as an effector, which results in either increased or decreased activity by the enzyme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allostery" .

goldbook:A00243 a skos:Concept ;
    skos:definition "Different structural modifications of an element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allotropes" .

goldbook:A00244 a skos:Concept ;
    skos:altLabel "allotriomorphic transition" ;
    skos:definition "A transition of a pure element, at a defined temperature and pressure, from one crystal structure to another which contains the same atoms but which has different properties. Examples: The transition of graphite to diamond, that of body-centred-cubic iron to face-centred-cubic iron, and the transition of orthorhombic sulfur to monoclinic sulfur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allotropic transition" .

goldbook:A00245 a skos:Concept ;
    skos:definition "The group $\\ce{CH2=CHCH2}$ (allyl) and derivatives formed by substitution. The term 'allylic position' or 'allylic site' refers to the saturated carbon atom. A group, such as $\\ce{–OH}$, attached at an allylic site is sometimes described as 'allylic'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allylic groups" .

goldbook:A00246 a skos:Concept ;
    skos:definition "Carbanions, carbenium ions or radicals, formally derived by detachment of one hydron, hydride or hydrogen from the $\\ce{CH3}$ group of propene or derivatives thereof. E.g. $\\ce{H2C=CHCH2^{+}}$ allyl cation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allylic intermediates" .

goldbook:A00247 a skos:Concept ;
    skos:definition "A substitution reaction occurring at position 1/ of an allylic system, the double bond being between positions 2/ and 3/. The incoming group may be attached to the same atom 1/ as the leaving group, or the incoming group becomes attached at the relative position 3/, with movement of the double bond from 2/3 to 1/2. For example:  (written as a transformation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allylic substitution reaction" .

goldbook:A00249 a skos:Concept ;
    skos:definition "A conjugated system of $\\ce{\\uppi\\!\\mbox{-}electrons}$ is termed alternant if its atoms can be divided into two sets so that no atom of one set is directly linked to any other atom of the same set." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternant" .

goldbook:A00250 a skos:Concept ;
    skos:definition "A copolymer consisting of macromolecules comprising two species of monomeric units in alternating sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternating copolymer" .

goldbook:A00251 a skos:Concept ;
    skos:definition "A copolymerization in which an alternating copolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternating copolymerization" .

goldbook:A00252 a skos:Concept ;
    skos:definition "Current with sinusoidal wave forms; all other wave forms should be termed 'periodic'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternating current" .

goldbook:A00254 a skos:Concept ;
    skos:definition "This term should be applied only to sinusoidal phenomena; the term periodic voltage should be used for other wave forms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternating voltage" .

goldbook:A00256 a skos:Concept ;
    skos:definition "A dappled layer of patch or cloud composed of flattened globules that may be arranged in groups, lines or waves collectively known as billows; \\(\\rm{2000–6000 m}\\); vertical velocities of \\(\\rm{0.05–0.1 m s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "altocumulus cloud" .

goldbook:A00257 a skos:Concept ;
    skos:definition "A grey, uniform, striated or fibrous sheet but without halo phenomena, and through which the sun is seen only as a diffuse, bright patch or not at all; usually at elevations \\(\\rm{2000–6000 m}\\); vertical velocities of \\(\\rm{0.05–0.1 m s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "altostratus cloud" .

goldbook:A00258 a skos:Concept ;
    skos:definition "A description applied to a chemical species whose molecular entities each possess two alternative and strongly interacting distinguishable reactive centres, to either of which a bond may be made in a reaction: the centres must be connected in such a way that reaction at either site stops or greatly retards subsequent attack at the second site. The term is most commonly applied to conjugated nucleophiles, for example the enolate ion:  (which may react with electrophiles either at the $\\ce{\\upbeta\\!\\mbox{-}carbon atom}$ or at oxygen) or $\\ce{\\upgamma\\!\\mbox{-}pyridones}$, and also to the vicinally ambident cyanide ion, cyanate ion, thiocyanate ion, sulfinate ion, nitrite ion and unsymmetrical hydrazines. Ambident electrophiles are exemplified by carboxylic esters $\\ce{RC(=O)OCR3}$ which react with nucleophiles either at the carbonyl carbon or the alkoxy carbon. Molecular entities, such as dianions of dicarboxylic acids, containing two non-interacting (or feebly interacting) reactive centres, are not generally considered to be ambident and are better described as 'bifunctional'. The Latin root of the word implies two reactive centres, but the term has in the past also incorrectly been applied to chemical species with more than two reactive centres. For such species the existing term 'polydent' (or, better, 'multident') is more appropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambident" .

goldbook:A00259 a skos:Concept ;
    skos:definition "The outdoor air in the particular location." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambient air" .

goldbook:A00260 a skos:Concept ;
    skos:definition "A general term used to describe the quality of the outside air. Usually adjectives such as good, fair, bad, etc. are used by the media to describe this; often some form of air pollution or air quality index is employed to determine the specific descriptive term to be used. These are very qualitative terms of little or no scientific value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ambient air quality" .

goldbook:A00261 a skos:Concept ;
    skos:definition "A prefix used to indicate that a molecule with two (or more) chiral elements is present as a mixture of the two racemic diastereoisomers in unspecified proportions. For example, the dipeptide formed from ʟ-alanine and ᴅʟ-leucine is ʟ-alanyl-ambo-leucine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>ambo</i>" .

goldbook:A00262 a skos:Concept ;
    skos:definition "A screening test employed in predicting the mutagenic and the potential carcinogenic activities of chemicals in the environment. It employs Ames test strains of salmonella bacteria ($\\ce{his^{-}}$) which lack the ability to produce histidine. The compound to be tested, the bacteria and a small amount of histidine (insufficient to permit colony growth but enough to allow sufficient growth for expression of mutations) are added to agar. The bacteria are allowed to incubate for about \\(63\\ \\rm{h}\\) at \\(37\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\). If a significant increase in colonies above background is observed in the sample containing the test compound, then it is concluded that the chemical tested is a direct mutagen for the particular Ames strain of bacteria. This is taken as a qualitative indication of the possible carcinogenic activity of this chemical in other biological systems. This procedure seems to be of qualitative value in a preliminary screening of potential carcinogens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ames/salmonella test" .

goldbook:A00263 a skos:Concept ;
    skos:definition "Carbamoyl carboxylic acids, i.e. compounds containing a carboxy and a carboxamide group, e.g. 5-carbamoylnicotinic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amic acids" .

goldbook:A00265 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC(NH2)=NOH}$ and derivatives formed by substitution; formally the oximes of carboxamides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amide oximes" .

goldbook:A00266 a skos:Concept ;
    skos:definition "Derivatives of oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}\\ (l  eq 0)$ in which an acidic hydroxy group has been replaced by an amino or substituted amino group. Chalcogen replacement analogues are called thio-, seleno- and telluro-amides. Compounds having one, two or three acyl groups on a given nitrogen are generically included and may be designated as primary, secondary and tertiary amides, respectively, e.g.  benzamide, N,N-dimethylmethanesulfonamide,  secondary amides (see imides),  tertiary amides,  phenylphosphonamidic acid.Notes:Amides with $\\ce{NH2}$, $\\ce{NHR}$ and $\\ce{NR2}$ groups should not be distinguished by means of the terms primary, secondary and tertiary.Derivatives of certain acidic compounds $\\ce{R_{n}E(OH)_{m}}$, where $\\ce{E}$ is not carbon (e.g. sulfenic acids, $\\ce{RSOH}$, phosphinous acids, $\\ce{R2POH)}$, having the structure $\\ce{R_{n}E(NR2)_{m}}$ may be named as amides but do not belong to the class amides proper, e.g. $\\ce{CH3CH2SNH2}$ ethanesulfenamide or ethylsulfanylamine.The term applies also to metal derivatives of ammonia and amines, in which a cation replaces a hydrogen atom on nitrogen. Such compounds are also called azanides, e.g.  lithium diisopropylamide, synonym lithium diisopropylazanide.See also: carboxamides, lactams, peptides, phosphoramides, sulfonamides" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amides" .

goldbook:A00267 a skos:Concept ;
    skos:definition "Derivatives of oxoacids $\\ce{R_{n}E(=O)OH}$ in which the hydroxy group is replaced by an amino group and the oxo group is replaced by $\\ce{=NR}$. Amidines include carboxamidines, sulfinamidines and phosphinamidines, $\\ce{R2P(=NR)NR2}$. In organic chemistry an unspecified amidine is commonly a carboxamidine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amidines" .

goldbook:A00268 a skos:Concept ;
    skos:definition "Cations formally derived by the addition of one hydron to the $\\ce{N}$ or $\\ce{O}$ atom of an amide and $N$-hydrocarbyl derivatives thereof. In organic chemistry an unspecified amidium ion is commonly a carboxamidium ion  or  The term does not imply knowledge concerning the position of the cationic centre, e.g. $\\ce{PhC(=O)N^{+}Me3}$ N,N,N-trimethylbenzamidium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amidium ions" .

goldbook:A00269 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC(=NH)NHNH2}$ or $\\ce{RC(NH2)=NNH2}$, formally derived from carboxylic acids. These tautomers are named hydrazide imides and amide hydrazones, respectively. Also included are $N$-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amidrazones" .

goldbook:A00270 a skos:Concept ;
    skos:definition "Compounds having two amino groups bonded to the same carbon, $\\ce{R2C(NR2)2}$. Also called geminal diamines. [The term aminal has also been used, with consequent ambiguity, for $\\ce{\\upalpha\\!\\mbox{-}amino}$ ethers (hemiaminal ethers); such use is discouraged.]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminals" .

goldbook:A00271 a skos:Concept ;
    skos:definition "Compounds formally derived from the attachment of an amine $\\ce{R3N}$ to a nitrene $\\ce{RN{:}}$ . The structure $\\ce{R3N^{+}–N−R}$ expresses the 1,2-dipolar character of amine imides. They may be named systematically as substituted diazan-2-ium-1-ides, e.g. $\\ce{Me3N^{+}–N−Me}$, 1,2,2,2-tetramethyldiazan-2-ium-1-ide or trimethylamine $N$-methylimide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amine imides" .

goldbook:A00273 a skos:Concept ;
    skos:definition "Compounds derived from tertiary amines by the attachment of one oxygen atom to the nitrogen atom $\\ce{R3N^{+}–O^{−}}$. By extension the term includes the analogous derivatives of primary and secondary amines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amine oxides" .

goldbook:A00274 a skos:Concept ;
    skos:definition "Compounds formally derived from ammonia by replacing one, two or three hydrogen atoms by hydrocarbyl groups, and having the general structures $\\ce{RNH2}$ (primary amines), $\\ce{R2NH}$ (secondary amines), $\\ce{R3N}$ (tertiary amines)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amines" .

goldbook:A00275 a skos:Concept ;
    skos:definition "Synonymous with ammonium ylides" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amine ylides" .

goldbook:A00277 a skos:Concept ;
    skos:definition "Cations $\\ce{HR3N^{+}}$ formed by hydronation of an amine $\\ce{R3N}$. 'Non-quaternary ammonium ions' is a synonymous term, e.g. prolinium, $\\ce{PhN^{+}HMe2}$, $N,N$-dimethylanilinium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminium ions" .

goldbook:A00278 a skos:Concept ;
    skos:definition "Radicals cations, $\\ce{R3N^{.+}}$, derivable from aminium ions, $\\ce{R3NH^{+}}$, by removal of a hydrogen atom. Aminiumyl radical ions are, except for $\\ce{H3N^{.+}}$, synonymous with the ammoniumyl radical ions. As the term ammonium is well known, ammoniumyl radical ions is the more desirable class name." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminiumyl radical ions" .

goldbook:A00283 a skos:Concept ;
    skos:definition "Monosaccharides having one alcoholic hydroxy group (commonly but not necessarily in position 2) replaced by an amino group; systematically known as $x$-amino-$x$-deoxymonosaccharides. (Glycosylamines are excluded.) E.g. ᴅ-glucosamine or 2-amino-2-deoxy-ᴅ-glucopyranose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amino sugars" .

goldbook:A00284 a skos:Concept ;
    skos:definition "The anion $\\ce{H2N–O^{−}}$, aminoxide and its $\\ce{N}$ hydrocarbyl derivatives $\\ce{R2N–O^{−}}$; formally derived from hydroxylamines, $\\ce{R2N–OH}$, by removing a hydron from the hydroxy group, e.g. $\\ce{(CH3)2N–O^{−}}$ dimethylaminoxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminoxides" .

goldbook:A00285 a skos:Concept ;
    skos:altLabel "aminooxyl radicals",
        "iminooxy radicals" ;
    skos:definition "Compounds having the structure $\\ce{R2N–O^{.}  R2N^{.+}–O^{−}}$; they are radicals derived from hydroxylamines by removal of the hydrogen atom from the hydroxy group, and are in many cases isolable. The synonymous terms 'nitroxyl radicals' and 'nitroxides' erroneously suggest the presence of a nitro group; their use is not desirable. Example, $\\ce{(ClCH2)2N–O^{.}}$ bis(chloromethyl)aminoxyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminoxyl radicals" .

goldbook:A00289 a skos:Concept ;
    skos:definition "The nitrogen-centered radical $\\ce{H2N^{.}}$, formally derived by the removal of a hydrogen atom from ammonia, and its hydrocarbyl derivatives $\\ce{R2N^{.}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aminyl radicals" .

goldbook:A00292 a skos:Concept ;
    skos:definition "1,2-Dipolar compounds of general structure $\\ce{R3N^{+}–C^{−}R2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ammonium ylides" .

goldbook:A00293 a skos:Concept ;
    skos:definition "$\\ce{H3N^{.+}}$ and its hydrocarbyl derivatives, e.g. $\\ce{(CH3)3N^{.+}}$ trimethylammoniumyl, $\\ce{PhN^{.+}H2}$ phenylammoniumyl or benzenaminiumyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ammoniumyl radical ions" .

goldbook:A00294 a skos:Concept ;
    skos:definition "A carbon material without long-range crystalline order. Short-range order exists, but with deviations of the interatomic distances and/or interbonding angles with respect to the graphite lattice as well as to the diamond lattice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amorphous carbon" .

goldbook:A00297 a skos:Concept ;
    skos:altLabel "chemical amount" ;
    skos:definition "The amount of substance, symbol \\(n\\), of a system is a measure of the number of specified elementary entities. An elementary entity may be an atom, a molecule, an ion, an electron, any other particle or specified group of particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amount of substance" .

goldbook:A00301 a skos:Concept ;
    skos:definition "A detection method in which the current is proportional to the concentration of the species generating the current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amperometric detection method" .

goldbook:A00302 a skos:Concept ;
    skos:definition "The property of surface activity is usually due to the fact that the molecules of the substance are amphipathic or amphiphilic, meaning that each contains both a hydrophilic and a hydrophobic (lipophilic) group. This assumes that one of the two phases is aqueous, and the other non-aqueous. If both are non-aqueous (e.g. oil/air), molecules containing organophilic and organophobic groups may be amphipathic and surface active." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amphipathic" .

goldbook:A00303 a skos:Concept ;
    skos:definition "A term used to describe a compound containing a large organic cation or anion which possesses a long unbranched hydrocarbon chain, e.g.   $\\ce{CH3(CH2)_{n}CO2^{−}M^{+}}$$\\ce{CH3(CH2)_{n}N^{+}(CH3)3X^{−}}$ ($n \\gt 7$)$\\ce{CH3(CH2)_{n}SO3^{−}M^{+}}$.The existence of distinct polar (hydrophilic) and nonpolar (hydrophobic) regions in the molecule promotes the formation of micelles in dilute aqueous solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amphiphilic" .

goldbook:A00304 a skos:Concept ;
    skos:altLabel "amphiprotic" ;
    skos:definition "Self-ionizing solvent possessing both characteristics of Brønsted acids and bases, for example $\\ce{H2O}$ and $\\ce{CH3OH}$, in contrast to aprotic solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amphiprotic solvent" .

goldbook:A00306 a skos:Concept ;
    skos:definition "A chemical species that behaves both as an acid and as a base is called amphoteric. This property depends upon the medium in which the species is investigated: $\\ce{H2SO4}$ is an acid when studied in water, but becomes amphoteric in superacids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amphoteric" .

goldbook:A00307 a skos:Concept ;
    skos:definition "A reaction which replaces the conventional reaction used in a particular determination so that a more favourable measurement can be made. The sequence can be repeated to provide a further favourable increase in measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amplification reaction" .

goldbook:A00310 a skos:Concept ;
    skos:definition "Half the peak-to-peak amplitude of a sinusoidal alternating current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amplitude of alternating current" .

goldbook:A00311 a skos:Concept ;
    skos:definition "This term should denote half of the peak-to-peak amplitude. Peak-to-peak and r.m.s. amplitudes should be so specified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amplitude of alternating voltage" .

goldbook:A00312 a skos:Concept ;
    skos:definition "Solar irradiance in space just above the atmosphere of the earth on a plane perpendicular to the direction of the sun (air mass, AM, zero). Also called extraterrestrial irradiance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "AM 0 sunlight" .

goldbook:A00313 a skos:Concept ;
    skos:altLabel "AM 1" ;
    skos:definition "Solar irradiance at sea level, i.e., traversing the atmosphere, when the direction of the sun is perpendicular to the surface of the earth. Also called terrestrial global irradiance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "AM 1 sunlight" .

goldbook:A00314 a skos:Concept ;
    skos:definition "The processes of metabolism that result in the synthesis of cellular components from precursors of low molecular weight." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anabolism" .

goldbook:A00315 a skos:Concept ;
    skos:definition "An organism that does not need free-form oxygen for growth. Many anaerobes are even sensitive to free oxygen. Obligate (strict) anaerobes grow only in the absence of oxygen. Facultative anaerobes can grow either in the presence or in the absence of molecular oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaerobe" .

goldbook:A00316 a skos:Concept ;
    skos:definition "Not requiring molecular oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaerobic" .

goldbook:A00317 a skos:Concept ;
    skos:definition "Substance which produces loss of feeling or sensation: general anaesthetic produces loss of consciousness; local or regional anaesthetic renders a specific area insensible to pain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anaesthetic" .

goldbook:A00318 a skos:Concept ;
    skos:definition "Substance which relieves pain, without causing loss of consciousness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analgesic" .

goldbook:A00319 a skos:Concept ;
    skos:definition "Process by which a normally non-biodegradable compound is biodegraded in the presence of a structurally similar compound which can induce the necessary enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analogue metabolism" .

goldbook:A00320 a skos:Concept ;
    skos:definition "A pulse amplitude analyser which, for each pulse processed, produces an integer proportional to the height of that pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analogue to digital converter (pulse)" .

goldbook:A00331 a skos:Concept ;
    skos:definition "The component of a system to be analysed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analyte" .

goldbook:A00332 a skos:Concept ;
    skos:definition "A function which relates the measured value \\(\\hat{C}_{\\rm{a}}\\) to the instrument reading, \\(X\\), with the value of all interferants, \\(C_{i}\\), remaining constant. This function is expressed by the following regression of the calibration results. \\[\\hat{C}_{\\rm{a}} = f\\left(X\\right)\\] The analytical function is taken as equal to the inverse of the calibration function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical function" .

goldbook:A00333 a skos:Concept ;
    skos:definition "A device or a combination of devices used to carry out an analytical process. The analytical process is all or part of the analytical procedure that encompasses all steps from the introduction of the sample or the test portion to the production of the result. An analytical instrument may carry out single or multiple analytical procedures. In the latter case it may be selective, i.e. designed to carry out any requested combination of procedures within the set, on each specimen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical instrument" .

goldbook:A00334 a skos:Concept ;
    skos:definition "A procedure which gives insight to the accuracy of results of analytical procedures by comparing the results obtained in the analyses of identical samples at different laboratories and preferably with different analytical methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical intercomparison" .

goldbook:A00336 a skos:Concept ;
    skos:definition "The characterization, in an inert atmosphere, of a material or a chemical process by a chemical degradation reaction(s) induced by thermal energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical pyrolysis" .

goldbook:A00337 a skos:Concept ;
    skos:definition "Procedures which give insight into the precision and accuracy of analysis results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical quality control" .

goldbook:A00338 a skos:Concept ;
    skos:altLabel "radioanalytical chemistry" ;
    skos:definition "That part of analytical chemistry in which the application of radioactivity is an essential step in the analytical procedures. Synonymous with radioanalytical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical radiochemistry" .

goldbook:A00342 a skos:Concept ;
    skos:altLabel "analyser" ;
    skos:definition "An assembly of subunits comprising: suitable apparatus permitting the introduction and removal of the gas, liquid or solid to be analysed and/or calibration materials; a measuring cell or other apparatus which, from the physical or chemical properties of the components of the material to be analysed, gives signals allowing their identification and/or measurement; signal processing devices (amplification, recording) or, if need be, data processing devices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "analytical unit" .

goldbook:A00344 a skos:Concept ;
    skos:definition "An instrument for monitoring the atmospheric pressure in which no liquid is employed, but rather changes in pressure between the atmosphere and a closed vessel bend a diaphram which moves a pointer on a scale." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aneroid barometer" .

goldbook:A00345 a skos:Concept ;
    skos:definition "A camera in which a large diameter scintillator is coupled to an array of photomultiplier tubes by fibre optics. X-ray imaging may also be achieved in multi-crystal cameras where many small crystals individually scintillate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Anger camera" .

goldbook:A00346 a skos:Concept ;
    skos:altLabel "plane angle" ;
    skos:definition "The angle between two half-lines terminating at the same point is the ratio of the length of the included arc of the circle (with its centre at that point) to the radius of the circle. Symbols: \\(\\alpha \\), \\(\\beta \\), \\(\\gamma \\) ... This is a quantity of dimension one with the SI unit radian (\\(\\pu{rad}\\)), but very often degrees of arc are used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle" .

goldbook:A00349 a skos:Concept ;
    skos:altLabel "Baeyer strain" ;
    skos:definition "Strain due to a departure in bond angle from 'normal' values. The term is often used in the context of non-aromatic cyclic compounds in which the internal angles differ from the regular tetrahedral angle of \\(109^{\\,\\unicode{x26ac}}\\,28^{\\prime }\\); in this sense angle strain is also known as 'Baeyer strain'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angle strain" .

goldbook:A00351 a skos:Concept ;
    skos:definition "With reference to the center of mass, the products of a bimolecular reaction are scattered with respect to the initial velocity vector, and the distribution of scattering angles is known as the angular distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angular distribution" .

goldbook:A00355 a skos:Concept ;
    skos:definition "Compounds resulting from internal acid–base neutralization (with loss of water) in iminium hydroxides containing an acidic site conjugated with the iminium function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anhydro bases" .

goldbook:A00356 a skos:Concept ;
    skos:definition "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}\\ (l  eq 0)$ by replacing an $\\ce{OH}$ group by the NHPh group or derivative formed by ring substitution; N-phenyl amides, e.g. $\\ce{CH3C(=O)NHPh}$ acetanilide.See: amidesSalts formed by replacement of a nitrogen-bound hydron of aniline by a metal or other cation, e.g. $\\ce{NaNHPh}$ sodium anilide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anilides" .

goldbook:A00357 a skos:Concept ;
    skos:definition "A term for the subclass of Schiff bases $\\ce{R2C=NR'}$, where $\\ce{R'}$ = phenyl or substituted phenyl group. Thus, $N$-phenyl imines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anils" .

goldbook:A00358 a skos:Concept ;
    skos:definition "A monoatomic or polyatomic species having one or more elementary charges of the electron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anion" .

goldbook:A00359 a skos:Concept ;
    skos:definition "The process of exchanging anions between a solution and an anion exchanger." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anion exchange" .

goldbook:A00360 a skos:Concept ;
    skos:definition "Ion exchanger with anions as counter-ions. The term anion-exchange resin may be used in the case of solid organic polymers. The base form of an anion exchanger is the ionic form in which the counter-ions are hydroxide groups ($\\ce{OH–}$ form) or the ionogenic groups form an uncharged base, e.g. $\\ce{-NH2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anion exchanger" .

goldbook:A00361 a skos:Concept ;
    skos:definition "An ionic polymerization in which the kinetic-chain carriers are anions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anionic polymerization" .

goldbook:A00362 a skos:Concept ;
    skos:altLabel "anionotropy" ;
    skos:definition "A rearrangement in which the migrating group moves with its electron pair from one atom to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anionotropic rearrangement" .

goldbook:A00365 a skos:Concept ;
    skos:definition "Alternative, but less desirable term for annulation. The term is widely used in the German and French languages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "annelation" .

goldbook:A00367 a skos:Concept ;
    skos:definition "A transformation involving fusion of a new ring to a molecule via two new bonds. Some authors use the term 'annelation' for the fusion of an additional ring to an already existing one, and 'annulation' for the formation of a ring from one or several acyclic precursors, but this distinction is not made generally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "annulation" .

goldbook:A00368 a skos:Concept ;
    skos:definition "Mancude monocyclic hydrocarbons without side chains of the general formula $\\ce{C_{n}H_{n}}$ ($n$ is an even number) or $\\ce{C_{n}H_{n+1}}$ ($n$ is an odd number). In systematic nomenclature an annulene with seven or more carbon atoms may be named [$n$]annulene, where $n$ is the number of carbon atoms, e.g. annulene for cyclonona-1,3,5,7-tetraene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "annulenes" .

goldbook:A00369 a skos:Concept ;
    skos:definition "Carbenes, derived by formal insertion of a divalent carbon atom into an even-membered annulene, e.g. cycloheptatrienylidene:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "annulenylidenes" .

goldbook:A00371 a skos:Concept ;
    skos:definition "Defined by analogy with cathodic transfer coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anodic transfer coefficient" .

goldbook:A00372 a skos:Concept ;
    skos:definition "Originally the thermodynamic preference for polar groups bonded to C-1 (the anomeric carbon of a glycopyranosyl derivative) to take up an axial position.  This effect is now considered to be a special case of a general preference (the generalized anomeric effect) for synclinal (gauche) conformations about the bond C–Y in the system X–C–Y–C where X and Y are heteroatoms having nonbonding electron pairs, commonly at least one of which is nitrogen, oxygen or fluorine. For example in chloro(methoxy)methane the anomeric effect stabilizes the synclinal conformation.  In alkyl glycopyranosides the anomeric effect operates at two sites (i) along the endocyclic C-1 oxygen bond (endo-anomeric effect) and (ii) along the exocyclic C-1 oxygen bond (exo-anomeric effect). The opposite preference is claimed for some systems, e.g., glycopyranosyltrialkylammonium salts, and has been referred to as the reverse anomeric effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anomeric effect" .

goldbook:A00373 a skos:Concept ;
    skos:definition "Diastereoisomers of glycosides, hemiacetals or related cyclic forms of sugars, or related molecules differing in configuration only at C-1 of an aldose, C-2 of a 2-ketose, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anomers" .

goldbook:A00374 a skos:Concept ;
    skos:definition "Benzene derivatives having para positions (or meta) bridged by a chain (commonly 10 to 12 atoms long) (Latin ansa, handle). By extension, any arene bridged by a chain constrained to lie over one of the two faces of the arene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ansa compounds" .

goldbook:A00375 a skos:Concept ;
    skos:definition "Combined effect of two or more factors which is smaller than the solitary effect of any one of those factors. In bioassays, the term may be used when a specified response is produced by exposure to either of two factors but not by exposure to both together." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antagonism" .

goldbook:A00376 a skos:Concept ;
    skos:definition "Substance that reverses or reduces the effect induced by an agonist.Substance that attaches to and blocks cell receptors that normally bind naturally occurring substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antagonist" .

goldbook:A00377 a skos:Concept ;
    skos:definition "When a part of a molecule ('molecular fragment') undergoes two changes in bonding (bond-making or bond-breaking), either to a common centre or to two related centres, external to itself, these bonding changes may be related in one of two spatially different ways. These are designated as 'antarafacial' if opposite faces of the molecular fragment are involved, and 'suprafacial' if both changes occur at the same face. The concept of 'face' is clear from the diagrams in the cases of planar (or approximately planar) frameworks with isolated or interacting p-orbitals [diagrams (a) and (b)].  The terms antarafacial and suprafacial are, however, also employed in cases in which the essential part of the molecular fragment undergoing changes in bonding comprises two atoms linked only by a $\\ce{\\upsigma\\!\\mbox{-}bond}$. In these cases it is customary to refer to the phases of the local $\\ce{\\upsigma\\!\\mbox{-}bonding}$ orbital: occurrence of the two bonding changes at sites of like orbital phase is regarded as suprafacial, whereas that at two sites of opposite phase is antarafacial. The possibilities are shown for $\\ce{C–C}$ and $\\ce{C–H}$ $\\ce{\\upsigma\\!\\mbox{-}bonds}$ in diagrams (c) and (d). There may be two distinct and alternative stereochemical outcomes of a suprafacial process involving a $\\ce{\\upsigma\\!\\mbox{-}bond}$ between saturated carbon atoms, i.e. either retention or inversion at both centres. The antarafacial process results in inversion at one centre and retention at the second. For examples of the use of these terms, see cycloaddition, sigmatropic rearrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antarafacial" .

goldbook:A00378 a skos:Concept ;
    skos:altLabel "anthelminth",
        "anthelminthic" ;
    skos:definition "Substance intended to kill parasitic intestinal worms, such as helminths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anthelmintic" .

goldbook:A00379 a skos:Concept ;
    skos:definition "Aglycons of anthocyanins; they are oxygenated derivatives of flavylium (2-phenylchromenylium) salts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anthocyanidins" .

goldbook:A00380 a skos:Concept ;
    skos:definition "Plant pigments of the flavonoid class; they are glycosides that on hydrolysis yield coloured aglycons called anthocyanidins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anthocyanins" .

goldbook:A00381 a skos:Concept ;
    skos:definition "In the representation of stereochemical relationships 'anti' means 'on opposite sides' of a reference plane, in contrast to 'syn' which means 'on the same side', as in the following examples.Two substituents attached to atoms joined by a single bond are anti if the torsion angle (dihedral angle) between the bonds to the substituents is greater than $\\pu{90\\!^{\\circ}}$, or syn if it is less than $\\pu{90\\!^{\\circ}}$. (A further distinction is made between antiperiplanar, synperiplanar, anticlinal and synclinal.)In the older literature the terms anti and syn were used to designate stereoisomers of oximes and related compounds. That usage was superseded by the terms 'trans' and 'cis' or E and Z, respectively.When the terms are used in the context of chemical reactions or transformations, they designate the relative orientation of substituents in the substrate or product:Addition to a carbon-carbon double bond:  Alkene-forming elimination:  In the examples described under (1) and (2) anti processes are always antarafacial, and syn processes are suprafacial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti" .

goldbook:A00382 a skos:Concept ;
    skos:definition "Compounds that contain \\(4\\ n\\) (\\(n eq 0\\)) $\\ce{\\uppi\\!\\mbox{-}electrons}$ in a cyclic planar, or nearly planar, system of alternating single and double bonds, e.g. cyclobuta-1,3-diene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiaromatic compounds" .

goldbook:A00383 a skos:Concept ;
    skos:definition "Substance produced by, and obtained from, certain living cells (especially bacteria, yeasts and moulds), or an equivalent synthetic substance, which is biostatic or biocidal at low concentrations to some other form of life, especially pathogenic or noxious organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antibiotic" .

goldbook:A00384 a skos:Concept ;
    skos:definition "A protein (immunoglobulin) produced by the immune system of an organism in response to exposure to a foreign molecule (antigen) and characterized by its specific binding to a site of that molecule (antigenic determinant or epitope)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antibody" .

goldbook:A00385 a skos:Concept ;
    skos:definition "(adjective). Preventing transmission of parasympathetic nerve impulses.(noun). Substance which prevents transmission of parasympathetic nerve impulses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticholinergic" .

goldbook:A00386 a skos:Concept ;
    skos:altLabel "anticircular development" ;
    skos:definition "The opposite of circular development. Here the sample as well as the mobile phase is applied at the periphery of a circle and both move towards the centre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticircular elution" .

goldbook:A00389 a skos:Concept ;
    skos:definition "A sequence of three nucleotides in the anticodon-loop of a tRNA, which recognizes and binds the complementary triplet sequence (codon) of the mRNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticodon" .

goldbook:A00390 a skos:Concept ;
    skos:definition "A gamma-ray spectrometer in which the effect of the Compton scattering is at least partly compensated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-Compton γ-ray spectrometer" .

goldbook:A00391 a skos:Concept ;
    skos:definition "A large system of winds that rotate about a centre of high atmospheric pressure, clockwise (viewed from above) in the northern hemisphere and counterclockwise in the southern hemisphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anticyclone" .

goldbook:A00394 a skos:Concept ;
    skos:definition "A substance that stimulates the immune system to produce a set of specific antibodies and that combines with the antibody through a specific binding site or epitope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antigen" .

goldbook:A00398 a skos:Concept ;
    skos:definition "Substance, structurally similar to a metabolite, which competes with it or replaces it, and so prevents or reduces its normal utilization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antimetabolite" .

goldbook:A00399 a skos:Concept ;
    skos:altLabel "antimony–xenon arc" ;
    skos:definition "An intense source of ultraviolet, visible, and near infra-red radiation produced by an electrical discharge in a mixture of antimony vapour and xenon under high pressure. Its output in the ultraviolet region is higher than that of the mercury–xenon arc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antimony–xenon lamp" .

goldbook:A00400 a skos:Concept ;
    skos:altLabel "fungicide" ;
    skos:definition "Substance used to kill a fungus or to inhibit its growth. Synonymous with fungicide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antimycotic" .

goldbook:A00401 a skos:Concept ;
    skos:definition "Of a given particle, a particle with the same rest mass, where the two can annihilate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiparticle" .

goldbook:A00404 a skos:Concept ;
    skos:definition "An affix used in names to denote eight atoms bound into a rectangular antiprism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>antiprismo</i>-" .

goldbook:A00405 a skos:Concept ;
    skos:definition "Substance used as an additive to a pesticide formulation in order to reduce the resistance of insects to the pesticide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiresistant" .

goldbook:A00406 a skos:Concept ;
    skos:definition "Serum containing antibodies to a particular antigen either because of immunization or after an infectious disease." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiserum" .

goldbook:A00408 a skos:Concept ;
    skos:altLabel "anti-Stokes type fluorescence" ;
    skos:definition "Fluorescence radiation occurring at shorter wavelengths than absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-Stokes type radiation" .

goldbook:A00409 a skos:Concept ;
    skos:definition "Opposite of thixotropy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anti-thixotropy" .

goldbook:A00412 a skos:Concept ;
    skos:definition "In measurement of non-faradaic admittance (or tensammetry), a plot of alternating current against applied potential shows a minimum or maximum when a non-electroactive substance undergoes adsorption or desorption at the surface of the indicator electrode. Such a maximum or minimum may be called an 'apex' to emphasize its non-faradaic origin and distinguish it from a 'summit', which would result from a charge-transfer process. The highest value of the current on such an apex may be called an 'apex current', and the corresponding applied potential may be called an 'apex potential'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apex current" .

goldbook:A00414 a skos:Concept ;
    skos:definition "Substance intended to kill aphids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aphicide" .

goldbook:A00415 a skos:Concept ;
    skos:definition "In trigonal bipyramidal structures (e.g. a five-coordinate trigonal bipyramid with phosphorus as central atom) the term apical refers to the two positions that are collinear with the central atom or to the bonds linking these positions to the central atom. The three equivalent bonds (or positions) in a plane passing through the central atom and perpendicular to the direction of the apical bonds are described as equatorial.  The term apical is also used for the bond pointing from the atom at or near the centre of the base to the apex of a pyramidal structure. The positions at or near the base of the pyramid, or the bonds linking those positions to the central atom of the base are described as 'basal'. The apical bonds have also been called axial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apical" .

goldbook:A00417 a skos:Concept ;
    skos:definition "The protein part of an enzyme without the cofactor necessary for catalysis. The cofactor can be a metal ion, an organic molecule (coenzyme), or a combination of both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apoenzyme" .

goldbook:A00418 a skos:Concept ;
    skos:altLabel "apparent quantity" ;
    skos:definition "A term, indicated by a superscript ', which means that a process is not well known or that its value carries uncertainties which are not known, e.g. \\(\\Delta G^{\\circ}{'}\\) is the apparent standard Gibbs energy change. In the context of partial molar quantities the word is used in a different sense; as a symbol for 'apparent' in this connection the use of subscript \\(\\varphi \\), as in \\(Y_{\\varphi}\\), is recommended. Other notations employed for this property include \\(^{\\varphi}X\\) and \\(\\varphi_{X}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apparent" .

goldbook:A00420 a skos:Concept ;
    skos:definition "The ratio of stress to rate of strain, calculated from measurements of forces and velocities as though the liquid were Newtonian. If the liquid is actually non-Newtonian, the apparent viscosity depends on the type and dimensions of the apparatus used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apparent viscosity" .

goldbook:A00421 a skos:Concept ;
    skos:altLabel "appearance potential" ;
    skos:definition "Refers to ionization of a molecule or atom by electron collision or photon absorption. In mass spectrometry it has often been reported as the voltage which corresponds to the minimum energy of the electrons in the ionizing beam necessary for the production of a given fragment ion. In photoionization it is the minimum energy of the quantum of light which produces ionization of the absorbing molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "appearance energy" .

goldbook:A00423 a skos:Concept ;
    skos:definition "The temperature of the atomization surface at which the analyte signal/noise (S/N) ratio reaches a value of 3 when the quantity of analyte in the atomizer is one hundred times the characteristic mass for peak high absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "appearance temperature" .

goldbook:A00424 a skos:Concept ;
    skos:definition "The difference of potential measured between identical metallic leads to two electrodes of a cell. The applied potential is divided into two electrode potentials, each of which is the difference of potential existing between the bulk of the solution and the interior of the conducting material of the electrode, an \\(i\\ R\\) or ohmic potential drop through the solution, and another ohmic potential drop through each electrode. In the electroanalytical literature this quantity has often been denoted by the term voltage, whose continued use is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "applied potential" .

goldbook:A00425 a skos:Concept ;
    skos:altLabel "aprotic" ;
    skos:definition "Non-protogenic (in a given situation). (With extremely strong Brønsted acids or bases, solvents that are normally aprotic may accept or lose a proton. For example, acetonitrile is in most instances an aprotic solvent, but it is protophilic in the presence of concentrated sulfuric acid and protogenic in the presence of potassium tert-butoxide. Similar considerations apply to benzene, trichloromethane, etc.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aprotic solvent" .

goldbook:A00426 a skos:Concept ;
    skos:definition "The incorporation of one or more integral molecules of water into another species with or without displacement of one or more other atoms or groups. For example, the incorporation of water into the inner ligand sphere of an inorganic complex is an aquation reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aquation" .

goldbook:A00427 a skos:Concept ;
    skos:definition "An affix used in names to designate a boron structure intermediate between nido- and hypho- in degree of openness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>arachno</i>-" .

goldbook:A00429 a skos:Concept ;
    skos:definition "This is understood to be the geometrical or projected area, and to ignore surface roughness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "area" .

goldbook:A00430 a skos:Concept ;
    skos:definition "In all measurements it is desirable that quantities like the charge and the capacity be related to unit, true, surface area of the interface. While this is relatively simple for a liquid-liquid interface, there are great difficulties when one phase is solid. In any report of these quantities it is essential to give a clear statement as to whether they refer to the true or the apparent (geometric) area and, especially if the former is used, precisely how it was measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "area of interface" .

goldbook:A00432 a skos:Concept ;
    skos:definition "Attribute to a physical quantity obtained by division by area. Areic charge is the charge on a surface divided by the surface area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "areic" .

goldbook:A00433 a skos:Concept ;
    skos:altLabel "arene oxides" ;
    skos:definition "Epoxides derived from arenes by 1,2-addition of an oxygen atom to a formal double bond, e.g. 5,6-epoxycyclohexa-1,3-diene.  (Common usage has extended the term to include examples with the epoxy group bridging nonadjacent atoms.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arene epoxides" .

goldbook:A00435 a skos:Concept ;
    skos:definition "Monocyclic and polycyclic aromatic hydrocarbons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arenes" .

goldbook:A00436 a skos:Concept ;
    skos:definition "Cations derived formally by the addition of a hydron or other cationic species to any position of an arene, e.g. $\\ce{C6H7^{+}}$, benzenium. The term includes:Arenium σ-adduct (sigma-adduct) (Wheland intermediates) (which are considered to be intermediates in electrophilic aromatic substitution reactions) and other cyclohexadienyl cations. Arenium π-adduct (pi-adduct), such as:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arenium ions" .

goldbook:A00437 a skos:Concept ;
    skos:definition "Synonymous with phenols (but rarely used)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arenols" .

goldbook:A00439 a skos:Concept ;
    skos:altLabel "CW" ;
    skos:definition "A CW or pulsed laser emitting lines from \\(334\\) to \\(529\\ \\rm{nm}\\) from singly ionized argon. Principal emissions are at \\(488.0\\) and \\(514.5\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "argon ion laser" .

goldbook:A00440 a skos:Concept ;
    skos:altLabel "average" ;
    skos:definition "The sum of a series of observations divided by the number of observations. Symbol: \\(\\bar{x}\\). It can be calculated by the formula: \\[\\bar{x}=\\frac{\\sum x_{i}}{n}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arithmetic mean" .

goldbook:A00441 a skos:Concept ;
    skos:definition "In the traditional sense, 'having a chemistry typified by benzene'.A cyclically conjugated molecular entity with a stability (due to delocalization) significantly greater than that of a hypothetical localized structure (e.g. Kekulé structure) is said to possess aromatic character. If the structure is of higher energy (less stable) than such a hypothetical classical structure, the molecular entity is 'antiaromatic'. The most widely used method for determining aromaticity is the observation of diatropicity in the $\\ce{^{1}H}$ NMR spectrum.See also: Hückel (4n + 2) rule, Möbius aromaticityThe terms aromatic and antiaromatic have been extended to describe the stabilization or destabilization of transition states of pericyclic reactions The hypothetical reference structure is here less clearly defined, and use of the term is based on application of the Hückel (4n + 2) rule and on consideration of the topology of orbital overlap in the transition state. Reactions of molecules in the ground state involving antiaromatic transition states proceed, if at all, much less easily than those involving aromatic transition states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aromatic" .

goldbook:A00442 a skos:Concept ;
    skos:altLabel "MO" ;
    skos:definition "The concept of spatial and electronic structure of cyclic molecular systems displaying the effects of cyclic electron delocalization which provide for their enhanced thermodynamic stability (relative to acyclic structural analogues) and tendency to retain the structural type in the course of chemical transformations. A quantitative assessment of the degree of aromaticity is given by the value of the resonance energy. It may also be evaluated by the energies of relevant isodesmic and homodesmotic reactions. Along with energetic criteria of aromaticity, important and complementary are also a structural criterion (the lesser the alternation of bond lengths in the rings, the greater is the aromaticity of the molecule) and a magnetic criterion (existence of the diamagnetic ring current induced in a conjugated cyclic molecule by an external magnetic field and manifested by an exaltation and anisotropy of magnetic susceptibility). Although originally introduced for characterization of peculiar properties of cyclic conjugated hydrocarbons and their ions, the concept of aromaticity has been extended to their homoderivatives (see homoaromaticity), conjugated heterocyclic compounds (heteroaromaticity), saturated cyclic compounds ($\\ce{\\upsigma\\!\\mbox{-}aromaticity}$) as well as to three-dimensional organic and organometallic compounds (three-dimensional aromaticity). A common feature of the electronic structure inherent in all aromatic molecules is the close nature of their valence electron shells, i.e., double electron occupation of all bonding MOs with all antibonding and delocalized nonbonding MOs unfilled. The notion of aromaticity is applied also to transition states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aromaticity" .

goldbook:A00443 a skos:Concept ;
    skos:definition "Equipment designed to remove particles from a gaseous medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arrester" .

goldbook:A00446 a skos:Concept ;
    skos:definition "An equation that represents the dependence of the rate constant \\(k\\) of a reaction on the absolute temperature \\(T\\): \\[k = A\\ \\rm{e}^{\\frac{-E_{\\rm{a}}}{R\\ T}}\\] In its original form the pre-exponential factor \\(A\\) and the activation energy \\(E_{\\rm{a}}\\) are considered to be temperature-independent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Arrhenius equation" .

goldbook:A00447 a skos:Concept ;
    skos:definition "The saturated hydrides of tervalent arsenic, having the general formula $\\ce{As_{n}H_{n+2}}$. Individual members having an unbranched arsenic chain are named arsane, diarsane, triarsane, etc. The name of a saturated hydride of arsenic where one or more arsenic atoms have bonding number 5 is formed by prefixing locants and \\(\\lambda ^{5}\\) symbols to the name of the corresponding arsane, e.g. $\\ce{H2AsAsHAsH2}$ triarsane, $\\ce{H4AsAsH3AsH4}$ 1\\(\\lambda ^{5}\\),2\\(\\lambda ^{5}\\),3\\(\\lambda ^{5}\\)-triarsane. Hydrocarbyl derivatives of $\\ce{AsH3}$ belong to the class arsines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsanes" .

goldbook:A00448 a skos:Concept ;
    skos:altLabel "arsinidenes" ;
    skos:definition "Recommended name for carbene analogues having the structure $\\ce{R–As{:}}$ (former IUPAC name is arsinediyls). A common non-IUPAC synonym is arsinidenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsanylidenes" .

goldbook:A00449 a skos:Concept ;
    skos:definition "The arsanyl cation, $\\ce{H2As^{+}}$, and derivatives by substitution. The name arsinylium (systematically derived from arsine) is not applied as it already designates $\\ce{H2As(=O)^{+}}$, the acylium ion derived from arsinic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsanylium ions" .

goldbook:A00450 a skos:Concept ;
    skos:definition "Compounds obtained from arsines $\\ce{AsR3}$ by replacing one or more hydrogen atoms by a metal, e.g. $\\ce{CaAsPh}$ calcium phenylarsenide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsenides" .

goldbook:A00451 a skos:Concept ;
    skos:definition "$\\ce{H3As=O}$ and its hydrocarbyl derivatives (analogously arsine imides and arsine sulfides), e.g. $\\ce{(CH3)3As=O}$ trimethylarsine oxide or trimethylarsane oxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsine oxides" .

goldbook:A00452 a skos:Concept ;
    skos:definition "AsH3 and compounds derived from it by substituting one, two or three hydrogen atoms by hydrocarbyl groups: $\\ce{R3As}$, $\\ce{RAsH2}$, $\\ce{R2AsH}$, $\\ce{R3As}$ ($\\ce{R}  eq \\ce{H}$) are called primary, secondary and tertiary arsines, respectively. A specific arsine is preferably named as a substituted arsane, e.g. $\\ce{CH3CH2AsH2}$ ethylarsane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsines" .

goldbook:A00453 a skos:Concept ;
    skos:definition "$\\ce{H2As(=O)OH}$ and its $\\ce{As}$-hydrocarbyl derivatives, e.g. $\\ce{Me2As(=O)OH}$, dimethylarsinic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsinic acids" .

goldbook:A00455 a skos:Concept ;
    skos:definition "$\\ce{H2AsOH}$ and its As-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsinous acids" .

goldbook:A00456 a skos:Concept ;
    skos:definition "$\\ce{HAs(=O)(OH)2}$ and its $\\ce{As}$-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsonic acids" .

goldbook:A00457 a skos:Concept ;
    skos:definition "Salts (including hydroxides) $\\ce{[R4As]^{+}X^{−}}$ containing tetracoordinate arsonium ion and the associated anion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsonium compounds" .

goldbook:A00458 a skos:Concept ;
    skos:definition "$\\ce{HAs(OH)2}$ and its As-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsonous acids" .

goldbook:A00459 a skos:Concept ;
    skos:definition "The mononuclear hydride $\\ce{AsH5}$, systematically named \\(\\lambda ^{5}\\)-arsane, and its hydrocarbyl derivatives. By extension the term also applies to arsonium ylides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arsoranes" .

goldbook:A00461 a skos:Concept ;
    skos:definition "Synonymous with induced radioactivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial radioactivity" .

goldbook:A00462 a skos:Concept ;
    skos:definition "Carbocations formally derived by removal of a hydride ion from a ring carbon atom of an arene. E.g. phenyl cation or phenylium:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aryl cations" .

goldbook:A00463 a skos:Concept ;
    skos:definition "Bivalent groups derived from arenes by removal of a hydrogen atom from two ring carbon atoms. A synonym is arenediyl groups. E.g. o-phenylene or benzene-1,2-diyl:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "arylene groups" .

goldbook:A00464 a skos:Concept ;
    skos:definition "Groups derived from arenes by removal of a hydrogen atom from a ring carbon atom. Groups similarly derived from heteroarenes are sometimes subsumed in this definition. E.g. o-tolyl:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aryl groups" .

goldbook:A00465 a skos:Concept ;
    skos:definition "A hydrocarbon derived from an arene by abstraction of two hydrogen atoms from adjacent carbon atoms; thus 1,2-didehydroarene. Arynes are commonly represented with a formal triple bond. The analogous heterocyclic compounds are called heteroarynes or hetarynes. For example, benzyne:  Arynes are usually transient species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aryne" .

goldbook:A00466 a skos:Concept ;
    skos:altLabel "ascending development" ;
    skos:definition "A mode of operation in which the paper or plate is in a vertical or slanted position and the mobile phase is supplied to its lower edge; the upward movement depends on capillary action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ascending elution" .

goldbook:A00467 a skos:Concept ;
    skos:definition "The solid residue which remains after the combustion of a fuel such as coal. Ash consists largely of heat treated mineral matter, but it may contain some products of the incomplete combustion of the fuel as well." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ash" .

goldbook:A00468 a skos:Concept ;
    skos:definition "Dry or wet mineralization as a method of preconcentration of trace substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ashing" .

goldbook:A00469 a skos:Concept ;
    skos:definition "Any apparatus that produces a movement of a fluid by suction (e.g. a squeeze bulb, pump, Venturi, etc.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aspirator" .

goldbook:A00470 a skos:Concept ;
    skos:definition "A set of operations having the object of determining the value of a quantity. In analytical chemistry, this term is synonymous with measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assay" .

goldbook:A00471 a skos:Concept ;
    skos:definition "A set of components (reagents and other necessary materials) and procedural instructions packaged together and designed for the estimation in vitro of a value of a specified quantity, when used according to the instructions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "assay kit" .

goldbook:A00472 a skos:Concept ;
    skos:definition "The assembling of separate molecular entities into any aggregate, especially of oppositely charged free ions into ion pairs or larger and not necessarily well-defined clusters of ions held together by electrostatic attraction. The term signifies the reverse of dissociation, but is not commonly used for the formation of definite adducts by colligation or coordination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "association" .

goldbook:A00473 a skos:Concept ;
    skos:altLabel "associative combination" ;
    skos:definition "The reaction of a (slow moving) ion with a neutral species wherein the reactants combine to form a single ionized species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "association reaction" .

goldbook:A00475 a skos:Concept ;
    skos:definition "This occurs when two excited gaseous atoms or molecular moieties interact and the sum of their internal energies is sufficient to produce a single, additive ionic product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "associative ionization" .

goldbook:A00477 a skos:Concept ;
    skos:definition "An affix used in names to denote asymmetrical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>asym</i>-" .

goldbook:A00478 a skos:Concept ;
    skos:definition "Lacking all symmetry elements (other than the trivial one of a one-fold axis of symmetry), i.e. belonging to the symmetry point group \\(C_{1}\\). The term has been used loosely (and incorrectly) to describe the absence of a rotation–reflection axis (alternating axis) in a molecule, i.e. as meaning chiral, and this usage persists in the traditional terms asymmetric carbon atom, asymmetric synthesis, asymmetric induction, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric" .

goldbook:A00479 a skos:Concept ;
    skos:definition "The traditional name (van 't Hoff) for a carbon atom that is attached to four different entities (atoms or groups), e.g. Cabcd." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric carbon atom" .

goldbook:A00482 a skos:Concept ;
    skos:definition "A film bounded by two different bulk phases. When the bulk phases are identical the film is described as symmetric." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric film" .

goldbook:A00483 a skos:Concept ;
    skos:definition "The traditional term describing the preferential formation in a chemical reaction of one enantiomer or diastereoisomer over the other as a result of the influence of a chiral feature present in the substrate, reagent, catalyst or environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric induction" .

goldbook:A00484 a skos:Concept ;
    skos:definition "A traditional term used for stereoselective synthesis of chiral compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric synthesis" .

goldbook:A00485 a skos:Concept ;
    skos:altLabel "deracemization" ;
    skos:definition "The conversion of a racemate into a pure enantiomer or into a mixture in which one enantiomer is present in excess, or of a diastereoisomeric mixture into a single diastereoisomer or into a mixture in which one diastereoisomer predominates. This is sometimes called deracemization. If the two enantiomers of a chiral substrate A are freely interconvertible and if an equal amount or excess of a non-racemizing second enantiomerically pure chemical species, say ($R$)-B, is added to a solution of racemic A, then the resulting equilibrium mixture of adducts A·B will, in general, contain unequal amounts of the diastereoisomers ($R$)-A$\\cdot$($R$)-B and ($S$)-A$\\cdot$($R$)-B. The result of this equilibration is called asymmetric transformation of the first kind. If, in such a system, the two diastereoisomeric adducts differ considerably in solubility so that only one of them, say ($R$)-A$\\cdot$($R$)-B, crystallizes from the solution, then the equilibration of diastereoisomers in solution and concurrent crystallization will continue so that all (or most) of the substrate A can be isolated as the crystalline diastereoisomer ($R$)-A$\\cdot$($R$)-B. Such a 'crystallization-induced asymmetric transformation' is called an asymmetric transformation of the second kind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric transformation" .

goldbook:A00488 a skos:Concept ;
    skos:definition "A regular macromolecule in which the configurational (base) units are not all identical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atactic macromolecule" .

goldbook:A00489 a skos:Concept ;
    skos:definition "A polymer composed of atactic macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atactic polymer" .

goldbook:A00490 a skos:Concept ;
    skos:definition "Non-SI unit of pressure, \\(1\\ \\rm{atm} = 101\\,325\\ \\rm{Pa}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmosphere" .

goldbook:A00491 a skos:Concept ;
    skos:definition "The entire mass of air surrounding the earth which is composed largely of nitrogen, oxygen, water vapour, clouds (liquid or solid water), carbon dioxide, together with trace gases and aerosols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmosphere" .

goldbook:A00492 a skos:Concept ;
    skos:definition "An ambiguous term; in essence, it is used to describe chemical ionization at atmospheric pressure. It is recommended that use of the term be discontinued." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atmospheric pressure ionization" .

goldbook:A00493 a skos:Concept ;
    skos:definition "Smallest particle still characterizing a chemical element. It consists of a nucleus of a positive charge (\\(Z\\) is the proton number and \\(e\\) the elementary charge) carrying almost all its mass (more than 99.9%) and \\(Z\\) electrons determining its size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atom" .

goldbook:A00495 a skos:Concept ;
    skos:definition "A gas laser which is pumped using energy transfer from other atoms or molecules. Examples are the helium-neon ($\\ce{HeNe}$) and the copper vapour laser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic laser" .

goldbook:A00496 a skos:Concept ;
    skos:definition "Rest mass of an atom in its ground state. The commonly used unit is the unified atomic mass unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic mass" .

goldbook:A00497 a skos:Concept ;
    skos:definition "One twelfth of the mass of a carbon-12 atom in its nuclear and electronic ground state, \\(m_{\\rm{u}} = \\pu{1.6605402(10)E-27 kg}\\). It is equal to the unified atomic mass unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic mass constant" .

goldbook:A00499 a skos:Concept ;
    skos:altLabel "proton number" ;
    skos:definition "The number of protons in the atomic nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic number" .

goldbook:A00500 a skos:Concept ;
    skos:definition "One-electron wavefunction obtained as a solution of the Schrödinger equation for an atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic orbital" .

goldbook:A00503 a skos:Concept ;
    skos:definition "One, two or three letters used to represent the atom in chemical formulae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic symbol" .

goldbook:A00504 a skos:Concept ;
    skos:definition "The units designed to simplify the form of the fundamental equations of quantum mechanics by eliminating from them fundamental constants. The atomic unit of length is the Bohr radius, \\(a_{\\rm{o}}=\\frac{h^{2}}{4\\ \\pi ^{2}\\ m\\ e^{2}}=5.291\\ 77249\\times 10^{-11}\\ \\rm{m}\\) (\\(0.529177249\\ \\mathring{\\rm{A}}\\)). Energy is measured in hartrees, where \\(1\\ \\rm{hartree} = \\frac{e^{2}}{a_{\\rm{o}}}=4.359\\ 7482\\times 10^{-18}\\ \\rm{J}\\). Masses are specified in terms of atomic mass unit, \\(\\pu{amu} = \\pu{1.6605402E-27 kg}\\) and of the electron mass unit, \\(m_{\\rm{e}} = \\pu{0.910953E-30 kg}\\). The advantage of atomic units is that if all calculations are directly expressed in such units, the results do not vary with any revision of the numerical values of the fundamental constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic units" .

goldbook:A00507 a skos:Concept ;
    skos:definition "The temperature of the support from which the sample is atomized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomization surface temperature" .

goldbook:A00508 a skos:Concept ;
    skos:definition "To subdivide a liquid into very small particles; methods include: impact with a jet of gas, use of a spinning disk generator, vibrating orifice generator, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomize" .

goldbook:A00510 a skos:Concept ;
    skos:definition "A mechanism that sometimes applies to the combination of atoms, but rarely of free radicals. In this mechanism the atom A first combines with a third body or chaperon, $$\\ce{A + M -> AM}$$ and the complex AM then forms $\\ce{A2 + M}$ by collision with another atom $\\ce{A}$. Contrast the energy-transfer mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atom–molecule complex mechanism" .

goldbook:A00511 a skos:Concept ;
    skos:definition "A subclass of conformers which can be isolated as separate chemical species and which arise from restricted rotation about a single bond, e.g. ortho-substituted biphenyl, 1,1,2,2-tetra-tert-butylethane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atropisomers" .

goldbook:A00512 a skos:Concept ;
    skos:definition "A transformation by which one molecular entity (the substrate) is converted into another by the formation of one (and only one) two-centre bond between the substrate and another molecular entity and which involves no other changes in connectivity in the substrate. For example, the formation of an acyl cation by attachment of carbon monoxide to a carbenium ion ($\\ce{R^{+}}$):  The product of an attachment may also be the adduct of the two reactants, but not all adducts can be represented as the products of an attachment. (For example, the Diels–Alder cycloaddition:  results in an adduct of buta-1,3-diene and ethene, but the reaction cannot be described as an attachment since bonds are formed between more than two centres.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attachment" .

goldbook:A00514 a skos:Concept ;
    skos:altLabel "neutral-density filter" ;
    skos:definition "An optical device (filter) which reduces the radiant power of a light beam by a constant factor over all wavelengths within its operating range. Sometimes called attenuator or neutral density filter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attenuance filter" .

goldbook:A00515 a skos:Concept ;
    skos:definition "The reduction of a radiation quantity upon passage of radiation through matter resulting from interactions of the radiation with the matter it traverses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attenuation" .

goldbook:A00518 a skos:Concept ;
    skos:altLabel "AMR" ;
    skos:definition "A classification of potential-energy surfaces in which a highly attractive surface is at one extreme and a highly repulsive surface is at the other. The energy release in intermediate cases is referred to as mixed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attractive–mixed–repulsive classification" .

goldbook:A00519 a skos:Concept ;
    skos:altLabel "early-downhill surface" ;
    skos:definition "A potential-energy surface for a process A + B–C in which the initial descent of the system into the product valley is associated with a substantial decrease in the A–B distance and with little separation between the products A–B and C. In terms of a potential-energy profile, the energy barrier occurs in the early stage of the reaction path. Attractive surfaces are also called early-downhill surfaces, and the barrier in such a surface is called a Type-I barrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attractive potential-energy surface" .

goldbook:A00520 a skos:Concept ;
    skos:definition "The emission of an electron from an atom accompanying the filling of a vacancy in an inner electron shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger effect" .

goldbook:A00521 a skos:Concept ;
    skos:definition "Electron originating in the Auger effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger electron" .

goldbook:A00522 a skos:Concept ;
    skos:definition "Any technique in which a specimen is bombarded with \\(\\mathrm{keV}\\)-energy electrons or X-rays, and the energy distribution of the electrons produced through radiationless de-excitation of the atoms in the sample (Auger electrons) is recorded. The derivative curve may also be recorded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger electron spectroscopy" .

goldbook:A00523 a skos:Concept ;
    skos:definition "The fraction of the atoms having a vacancy in an inner orbital which relax by emission of an Auger electron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger electron yield" .

goldbook:A00524 a skos:Concept ;
    skos:definition "For a given excited state of a specified atom the probability that the de-excitation occurs by the Auger effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Auger yield" .

goldbook:A00525 a skos:Concept ;
    skos:definition "A chemical reaction in which a product (or a reaction intermediate) also functions as a catalyst. In such a reaction the observed rate of reaction is often found to increase with time from its initial value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autocatalytic reaction" .

goldbook:A00526 a skos:Concept ;
    skos:definition "This occurs when an internally supra-excited atom or molecular moiety loses an electron spontaneously without further interaction with an energy source. (The state of the atom or molecular moiety is known as a pre-ionization state.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auto-ionization" .

goldbook:A00527 a skos:Concept ;
    skos:definition "Mechanization with process control, where process means a sequence of manipulations. One or several functions in an analytical instrument may be automated. The corresponding adjective is automated and the verb is automate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "automation" .

goldbook:A00528 a skos:Concept ;
    skos:definition "Synonymous with degenerate rearrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "automerization" .

goldbook:A00529 a skos:Concept ;
    skos:definition "If adsorption equilibrium and mutual saturation of the phases is not achieved instantly, it is possible to distinguish the initial spreading tension, \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), from the final spreading tension, \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), when equilibrium has been reached. In the case in which \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) is positive, while \\(\\sigma _{\\rm{i}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) is negative, the system is said to exhibit autophobicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autophobicity" .

goldbook:A00531 a skos:Concept ;
    skos:definition "A proton (hydron) transfer reaction between two identical molecules (usually a solvent), one acting as a Brønsted acid and the other as a Brønsted base. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoprotolysis" .

goldbook:A00532 a skos:Concept ;
    skos:definition "The product of the activities (or, more approximately, concentrations) of the species produced as the result of autoprotolysis. For solvents in which no other ionization processes are significant the term is synonymous with 'ionic product'. The autoprotolysis constant for water, \\(K_{\\rm{w}}\\), is equal to the product of activities: \\[a\\left(\\rm{H}_{3}\\rm{O}^{\\rm{+}}\\right)\\ a\\left(\\rm{OH}^{\\rm{-}}\\right) = 1.0\\times 10^{-14}\\] at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoprotolysis constant" .

goldbook:A00533 a skos:Concept ;
    skos:definition "A radiograph of an object containing radioactive substance, produced by placing the object adjacent to a photographic plate or film or a fluorescent screen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoradiograph" .

goldbook:A00534 a skos:Concept ;
    skos:definition "Radiolysis of a radioactive material resulting directly or indirectly from its radioactive decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autoradiolysis" .

goldbook:A00536 a skos:Concept ;
    skos:definition "An atom or group which, when added to or introduced into a chromophore, causes a bathochromic shift and/or a hyperchromic effect in a given band of the chromophore, usually in that of lowest frequency. This term is obsolete." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auxochrome" .

goldbook:A00537 a skos:Concept ;
    skos:definition "The inability of an organism to synthesize a particular organic compound required for its growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "auxotrophy" .

goldbook:A00539 a skos:Concept ;
    skos:definition "The average current density, \\(j\\), is defined by \\[j = A^{-1}\\ \\int _{A}j_{x}\\ \\rm{d}A\\] where \\(A\\) is the electrode area, \\(j_{x}\\) is the local current density and \\(\\rm{d}A\\) is an infinitesimal surface element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average current density" .

goldbook:A00541 a skos:Concept ;
    skos:definition "Defined for an atom or nuclear system in a specified state. For an exponentially decaying system, it is the average time for the number of atoms or nuclei in a specified state to decrease by a factor e. Synonymous with mean lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average life" .

goldbook:A00542 a skos:Concept ;
    skos:definition "The ratio of the mass of a drop, at the instant when it is detached from the tip of the capillary, to the drop time \\(t_{1}\\); the average value of the instantaneous rate of flow over the entire life of the drop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "average rate of flow" .

goldbook:A00543 a skos:Concept ;
    skos:definition "The Avogadro constant, \\(N_{\\rm{A}} = \\pu{6.02214076E23 mol-1}\\), is a proportionality constant between the quantity amount of substance (\\(n\\), with unit mole) and the quantity for counting entities (\\(N\\) with unit one, symbol 1), \\(N = N_{\\rm{A}}\\ n\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Avogadro constant" .

goldbook:A00544 a skos:Concept ;
    skos:definition "Frequently, two Born–Oppenheimer electronic states (A, B) change their energy order as molecular geometry (x) is changed continuously along a path. In the process their energies may become equal at some points (the surfaces are said to cross, dotted lines in the figure), or only come relatively close (the crossing of the surfaces is said to be avoided). If the electronic states are of the same symmetry, the surface crossing is always avoided in diatomics and usually avoided in polyatomics.   Synonymous with intended crossing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "avoided crossing" .

goldbook:A00546 a skos:Concept ;
    skos:definition "In the chair form of cyclohexane ring bonds to ring atoms (and molecular entities attached to such bonds) are termed axial or equatorial according to whether the bonds make a relatively large or small angle, respectively, with the plane containing or passing closest to a majority of the ring atoms. Thus the axial bonds are approximately parallel to the $C_{3}$ axis and the equatorial bonds approximately parallel to two of the ring bonds. These terms are also used for the chair form of other saturated six-membered rings. The corresponding bonds occurring at the allylic positions in mono-unsaturated six-membered rings are termed pseudo-axial (or quasi-axial) and pseudo-equatorial (or quasi-equatorial). The terms axial and equatorial have similarly been used in relation to the puckered conformation of cyclobutane, crown conformer of cyclooctane, etc. and the terms pseudo-axial and pseudo-equatorial in the context of the non-planar structures of cyclopentane and cycloheptane.  See apical for an alternative use of axial and equatorial with bipyramidal structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axial" .

goldbook:A00547 a skos:Concept ;
    skos:definition "Term used to refer to stereoisomerism resulting from the non-planar arrangement of four groups in pairs about a chirality axis. It is exemplified by allenes $\\ce{abC=C=Ccd}$ (or $\\ce{abC=C=Cab}$) and by the atropisomerism of ortho-substituted biphenyls. The configuration in molecular entities possessing axial chirality is specified by the stereodescriptors $R_{\\rm{a}}$ and $S_{\\rm{a}}$ (or by $P$ or $M$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "axial chirality" .

goldbook:A00553 a skos:Concept ;
    skos:definition "Saturated acyclic nitrogen hydrides having the general formula $\\ce{N_{n}H_{n+2}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azanes" .

goldbook:A00555 a skos:Concept ;
    skos:definition "Compounds bearing the group $\\ce{N3}$, viz. $\\ce{–N=N^{+}=N^{-}}$; usually attached to carbon, e.g. $\\ce{PhN3}$ phenyl azide or azidobenzene.Salts of hydrazoic acid, $\\ce{HN3}$, e.g. $\\ce{NaN3}$ sodium azide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azides" .

goldbook:A00557 a skos:Concept ;
    skos:definition "Condensation products, $\\ce{R2C=NN=CR2}$, of two moles of a carbonyl compound with one mole of hydrazine  (this term should not be confused with the ending -azine appearing in Hantzsch–Widman names for some heterocycles)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azines" .

goldbook:A00558 a skos:Concept ;
    skos:definition "Derivatives of the parent structure $\\ce{H2N^{+}(O^{−})OH}$, of which the alkylidene derivatives, $\\ce{R2C=N^{+}(O^{−})OH}$ (tautomers of nitroalkanes), are the most commonly encountered. The alkylideneazinic acids are known as nitronic acids, or synonymously as aci-nitro compounds, e.g. $\\ce{CH2=N^{+}(O^{−})OH}$ methylideneazinic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azinic acids" .

goldbook:A00559 a skos:Concept ;
    skos:definition "Oxazol-5(4$H$)-ones I, compounds derived by cyclization of $N$-acyl $\\ce{\\upalpha\\!\\mbox{-}amino}$ carboxylic acids, $\\ce{RC(=O)NHCR2C(=O)OH}$, through formal loss of the elements of water. 4-Hydrocarbylideneazlactones II are often referred to as 'unsaturated azlactones'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azlactones" .

goldbook:A00560 a skos:Concept ;
    skos:definition "Derivatives of diazene (diimide), $\\ce{HN=NH}$, wherein both hydrogens are substituted by hydrocarbyl groups, e.g. $\\ce{PhN=NPh}$ azobenzene or diphenyldiazene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azo compounds" .

goldbook:A00561 a skos:Concept ;
    skos:altLabel "azimines" ;
    skos:definition "N-Imides of azo compounds, analogous to azoxy compounds, having a delocalized structure  commonly but undesirably referred to as 'azimines'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azo imides" .

goldbook:A00562 a skos:Concept ;
    skos:altLabel "azo ylides" ;
    skos:definition "The 1,3-dipolar N-imides of azomethines having the structure   The term azo ylides, derived from the second resonance form, has also been used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azomethine imides" .

goldbook:A00564 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RN=CR2}$ ($\\ce{R eq H}$). Many consider the term to include the compounds $\\ce{RN=CRH}$ ($\\ce{R eq H}$), thus making azomethines synonymous with Schiff bases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azomethines" .

goldbook:A00565 a skos:Concept ;
    skos:definition "1,3-Dipolar compounds having the structure" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azomethine ylides" .

goldbook:A00566 a skos:Concept ;
    skos:definition "$N$-Hydrocarbyl derivatives of the parent structure $\\ce{HN^{+}(O^{−})(OH)2}$. Cf. phosphonic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azonic acids" .

goldbook:A00567 a skos:Concept ;
    skos:definition "$N$-Oxides of azo compounds of structure $\\ce{RN=N^{+}(O^{−})R}$, e.g. $\\ce{PhN=N^{+}(O^{−})Ph}$ azoxybenzene or diphenyldiazene oxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "azoxy compounds" .

goldbook:A04388 a skos:Concept ;
    skos:altLabel "π-complex" ;
    skos:definition "An adduct formed by electron-pair donation from a $\\ce{\\uppi\\!\\mbox{-}orbital}$ into a $\\ce{\\upsigma\\!\\mbox{-}orbital}$, or from a $\\ce{\\upsigma\\!\\mbox{-}orbital}$ into a $\\ce{\\uppi\\!\\mbox{-}orbital}$, or from a $\\ce{\\uppi\\!\\mbox{-}orbital}$ into a $\\ce{\\uppi\\!\\mbox{-}orbital}$. For example:  Such an adduct has commonly been known as a '$\\ce{\\uppi\\!\\mbox{-}complex}$', but, as the bonding is not necessarily weak, it is better to avoid the term complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π-adduct" .

goldbook:A05436 a skos:Concept ;
    skos:definition "The product formed by the attachment of an electrophilic or nucleophilic entering group or of a radical to a ring carbon of an aromatic species so that a new $\\ce{\\upsigma\\!\\mbox{-}bond}$ is formed and the original conjugation is disrupted. (This has generally been called a '$\\ce{\\upsigma\\!\\mbox{-}complex}$', but adduct is more appropriate than complex according to the definitions given.) The term may also be used for analogous adducts to unsaturated (and conjugated) systems in general." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "σ-adduct" .

goldbook:AT06761 a skos:Concept ;
    skos:definition "A type of protein, especially a protein of blood plasma which transports various substances, including metal ions, drugs and xenobiotics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "albumin" .

goldbook:AT06766 a skos:Concept ;
    skos:definition "Replacement of the ligand water by an anion in a coordination entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anation" .

goldbook:AT06767 a skos:Concept ;
    skos:definition "A protein without its characteristic prosthetic group or metal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apoprotein" .

goldbook:AT06776 a skos:Concept ;
    skos:definition "The property of molecules and materials to exhibit variations in physical properties along different molecular axes of the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anisotropy" .

goldbook:AT06794 a skos:Concept ;
    skos:definition "Refers to sulfido ligands, e.g., the bridging ligands in iron-sulfur proteins, which are released as $\\ce{H2S}$ at acid pH." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acid-labile sulfur" .

goldbook:AT06796 a skos:Concept ;
    skos:definition "A biological substance secreted by various cells whose physiological activity is restricted to the vicinity of its release; it is often referred to as a local hormone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "autacoid" .

goldbook:AT06797 a skos:Concept ;
    skos:definition "Ratio of the absorbed quantity (uptake) of a substance to the administered quantity (intake)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorption coefficient" .

goldbook:AT06799 a skos:Concept ;
    skos:altLabel "ADI",
        "JECFA" ;
    skos:definition "Estimate by JECFA of the amount of a food additive, expressed on a body-weight basis, that can be ingested daily over a lifetime without appreciable health risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acceptable daily intake" .

goldbook:AT06800 a skos:Concept ;
    skos:definition "Adverse effects of finite duration occurring within a short time (up to $\\pu{14 d}$) after administration of a single dose (or exposure to a given concentration) of a test substance or after multiple doses (exposures), usually within $\\pu{24 h}$ of a starting point (which may be exposure to the toxicant, or loss of reserve capacity, or developmental change, etc.)Ability of a substance to cause adverse effects within a short time of dosing or exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acute toxicity" .

goldbook:AT06803 a skos:Concept ;
    skos:definition "Pertaining to a systematic relationship between growth rates of different parts of an organism and its overall growth rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "allometric" .

goldbook:AT06804 a skos:Concept ;
    skos:definition "Active process of programmed cell death requiring metabolic energy, often characterised by fragmentation of DNA, and without associated inflammation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apoptosis" .

goldbook:AT06805 a skos:Concept ;
    skos:definition "Part of a risk that is identified as due to exposure to a defined substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "attributable risk" .

goldbook:AT06809 a skos:Concept ;
    skos:definition "Change in biochemistry, morphology, physiology, growth, development, or lifespan of an organism which results in impairment of functional capacity or impairment of capacity to compensate for additional stress or increase in susceptibility to other environmental influences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adverse effect" .

goldbook:AT06849 a skos:Concept ;
    skos:altLabel "ageing" ;
    skos:definition "Processes that occur in a polymeric material during a specified period of time, and that usually result in changes in physical and/or chemical structure and the values of the properties of the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aging" .

goldbook:AT06862 a skos:Concept ;
    skos:definition "Membrane constituted of two or more structural planes of non-identical morphologies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric membrane" .

goldbook:AT06934 a skos:Concept ;
    skos:definition "Isotherm describing adsorption of the sample component on the surface of the stationary phase from the mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "adsorption isotherm" .

goldbook:AT06947 a skos:Concept ;
    skos:altLabel "ANN" ;
    skos:definition "Artificial neural networks (ANN) are algorithms simulating the functioning of human neurons and may be used for pattern recognition problems, e.g., to establish quantitative structure-activity relationships." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "artificial neural networks" .

goldbook:AT06983 a skos:Concept ;
    skos:definition "Methods of quantum mechanical calculations independent of any experiment other than the determination of fundamental constants. The methods are based on the use of the full Schrödinger equation to treat all the electrons of a chemical system. In practice, approximations are necessary to restrict the complexity of the electronic wavefunction and to make its calculation possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>ab initio</i> quantum mechanical methods" .

goldbook:AT06984 a skos:Concept ;
    skos:definition "The manner of interaction (termed according to the Greek 'to hold or clasp to oneself as a shield') of a coordinatively unsaturated metal atom with a ligand, when the metal atom draws the ligand towards itself. An important type of agostic interaction is the C–H–Metal coordination providing for the activation of the C–H bond in transition metal complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agostic interaction" .

goldbook:AT06985 a skos:Concept ;
    skos:definition "A topological property of the molecular graphs of alternant hydrocarbons which allows the carbon atoms to be divided into two subsets in such a way that no two atoms of the same subset are adjacent. A consequence of this property is the symmetrical arrangement of the energy levels of bonding and antibonding Hückel MOs relative to the level of a nonbonding orbital (energy level of the p AO of a carbon atom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alternancy symmetry" .

goldbook:AT06986 a skos:Concept ;
    skos:altLabel "AOM" ;
    skos:definition "A method of description of transition metal–ligand interactions and main group stereochemistry, whose basic assumption is that the strength of a bond formed using atomic orbitals on two atoms is related to the magnitude of overlap of the two orbitals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "angular overlap model" .

goldbook:AT06987 a skos:Concept ;
    skos:altLabel "antithetical to aromaticity" ;
    skos:definition "Those cyclic molecules for which cyclic electron delocalization provides for the reduction (in some cases, loss) of thermodynamic stability compared to acyclic structural analogues are classified as antiaromatic species. In contrast to aromatic compounds, antiaromatic ones are prone to reactions causing changes in their structural type, and display tendency to alternation of bond lengths and fluxional behavior (see fluxional molecules) both in solution and in the solid. Antiaromatic molecules possess negative (or very low positive) values of resonance energy and a small energy gap between their highest occupied and lowest unoccupied molecular orbitals. In antiaromatic molecules, an external magnetic field induces a paramagnetic electron current. Whereas benzene represents the prototypical aromatic compound, cyclobuta-1,3-diene exemplifies the compound with most clearly defined antiaromatic properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antiaromaticity" .

goldbook:AT06988 a skos:Concept ;
    skos:altLabel "MO" ;
    skos:definition "The molecular orbital whose occupation by electrons decreases the total bonding (as usual, increases the total energy) of a molecule. The energy level of an antibonding MO lies higher than the average of the valence atomic orbitals of the atoms constituting the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antibonding molecular orbital" .

goldbook:AT06989 a skos:Concept ;
    skos:definition "The postulate that electrons must be described by wavefunctions which are antisymmetric with respect to interchange of the coordinates (including spin) of a pair of electrons. A corollary of the principle is the Pauli exclusion principle. All particles with half-integral spin (fermions) are described by antisymmetric wavefunctions, and all particles with zero or integral spin (bosons) are described by symmetric wavefunctions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "antisymmetry principle" .

goldbook:AT06990 a skos:Concept ;
    skos:definition "In trigonal bipyramidal structures with a five-coordinate central atom, the stabilization achieved through a ligand changing its position from equatorial to apical (axial). The apicophilicity of an atom or a group is evaluated by either the energy difference between the stereoisomers (permutational isomers) containing the ligand in apical and equatorial positions or the energy barrier to permutational isomerization (see also Berry pseudorotation). In general, the greater the electronegativity and the stronger the $\\ce{\\uppi\\!\\mbox{-}electron}$-withdrawing properties of a ligand (as for $\\ce{Cl}$, $\\ce{F}$, $\\ce{CN}$), the higher is its apicophilicity. The notion of apicophilicity has been extended to four-coordinate bisphenoidal and three-coordinate T-shaped structures, which can be viewed as trigonal bipyramidal species where, respectively, one or two vertices are occupied by phantom ligands (lone electron pairs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "apicophilicity" .

goldbook:AT06992 a skos:Concept ;
    skos:definition "A quantity used in perturbation HMO theory as a measure of the change in electron density, \\(q\\), of atom \\(s\\) caused by a change in the electronegativity (or coulomb integral) of atom \\(r\\): \\[\\pi _{\\rm{sr}}=\\frac{\\partial q_{\\rm{s}}}{\\partial a_{\\rm{r}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atom-atom polarizability" .

goldbook:AT06993 a skos:Concept ;
    skos:definition "A quantity used in perturbation HMO theory as a measure of the change in electron density, \\(q\\), of atom \\(m\\) caused by a change in the resonance integral, \\(\\beta \\), of bond \\(rs\\): \\[\\pi _{\\rm{m,rs}}=\\frac{\\partial q_{\\rm{m}}}{\\partial \\beta _{\\rm{rs}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atom-bond polarizability" .

goldbook:AT06994 a skos:Concept ;
    skos:altLabel "MO" ;
    skos:definition "The charge attributed to an atom \\(A\\) within a molecule defined as \\(\\zeta =Z_{\\rm{A}}- q_{\\rm{A}}\\), where \\(Z_{\\rm{A}}\\) is the atomic number of \\(A\\) and \\(q_{\\rm{A}}\\) is the electron density assigned to \\(A\\). The method of calculation of \\(q_{\\rm{A}}\\) depends on the choice of the scheme of partitioning electron density. In the framework of the Mulliken population analysis \\(q_{\\rm{A}}\\) is associated with the so-called gross atomic population: \\(q_{\\rm{A}}=\\sum q_{\\unicode[Times]{x3BC}}\\), where \\(q_{\\unicode[Times]{x3BC}}\\) is a gross population for an orbital \\(\\unicode[Times]{x3BC}\\) in the basis set employed defined according to \\[q_{\\unicode[Times]{x3BC}} = P_{\\unicode[Times]{x3BC}\\unicode[Times]{x3BC}}+\\sum _{\\begin{array}{c}   u  eq \\unicode[Times]{x3BC}   \\end{array}}P_{\\unicode[Times]{x3BC} u}\\ S_{\\unicode[Times]{x3BC} u}\\] where \\(P_{\\unicode[Times]{x3BC}\\unicode[Times]{x3BD} }\\) and \\(S_{\\unicode[Times]{x3BC}\\unicode[Times]{x3BD}}\\) are the elements of density matrix and overlap matrix, respectively (see overlap integral). In the Hückel molecular orbital theory (where \\(S_{\\unicode[Times]{x3BC} u} = \\delta _{\\unicode[Times]{x3BC} u}\\)), \\(q_{\\unicode[Times]{x3BC}} = n_{\\unicode[Times]{x3BC}}\\ P_{\\unicode[Times]{x3BC}\\unicode[Times]{x3BC}}\\), where \\(n_{\\unicode[Times]{x3BC}}\\) is the number of electrons in the \\(\\rm{MO}\\,\\unicode[Times]{x3BC}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "atomic charge" .

goldbook:AT06996 a skos:Concept ;
    skos:definition "A rule for building up the electronic configuration of atoms and molecules. It states that a maximum of two electrons are put into orbitals in the order of increasing orbital energy: the lowest-energy orbitals are filled before electrons are placed in higher-energy orbitals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aufbau principle" .

goldbook:AT07196 a skos:Concept ;
    skos:definition "Polyelectrolyte composed of macromolecules containing both cationic and anionic groups, or corresponding ionizable groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ampholytic polymer" .

goldbook:AT07198 a skos:Concept ;
    skos:definition "Polymer composed of negatively charged macromolecules and an equivalent amount of counter-cations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "anionic polymer" .

goldbook:AT07312 a skos:Concept ;
    skos:altLabel "absorbed spectral photon flux density" ;
    skos:definition "Number of photons of a particular wavelength per time interval (spectral photon flux, number basis, \\(q_{\\rm{p},\\lambda }\\), or spectral photon flux, amount basis, \\(q_{n,\\rm{p},\\lambda }\\)) absorbed by a system per volume, \\(V\\). On number basis, SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-4}\\), and the  common unit is \\(\\rm{s}^{-1}\\ \\rm{cm}^{-3}\\ \\rm{nm}^{-1}\\). On amount basis, SI unit is \\(\\pu{mol s-1 m-4}\\), and a common unit is \\(\\pu{einstein s-1 cm-3 nm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed photon flux density" .

goldbook:AT07313 a skos:Concept ;
    skos:altLabel "absorbed spectral radiant power density" ;
    skos:definition "Spectral radiant energy per time interval (spectral radiant power, \\(P_{\\lambda}\\)) absorbed by a system per volume, \\(V\\). SI unit is \\(\\rm{W m}^{-4}\\); common unit is \\(\\rm{W cm}^{-3}\\ \\rm{nm}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "absorbed radiant power density" .

goldbook:AT07314 a skos:Concept ;
    skos:definition "Applied or referred to actinism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "actinic" .

goldbook:AT07315 a skos:Concept ;
    skos:definition "Chemical changes on living and non-living materials caused by optical radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "actinism" .

goldbook:AT07317 a skos:Concept ;
    skos:altLabel "1",
        "2-acyl shift",
        "3-acyl shift" ;
    skos:definition "Photochemical process with skeletal isomerization by shift of an acyl group from position 1 to position 2 or 3." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "acyl shift" .

goldbook:AT07318 a skos:Concept ;
    skos:definition "Photochemical process leading to formation of a cyclobutane upon addition of an electronically excited alkene to another ground-state alkene or of an electronically excited $\\ce{\\upalpha\\!,\\upbeta\\!\\mbox{-}unsaturated}$ carbonyl compound to a ground-state alkene. The latter is called a de Mayo reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkene photocycloaddition" .

goldbook:AT07319 a skos:Concept ;
    skos:definition "Photochemical process leading to the formation of a cyclobutane from two identical alkenes, i.e., from the photocycloaddition of an electronically excited alkene to a ground-state alkene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkene photodimerization" .

goldbook:AT07320 a skos:Concept ;
    skos:definition "Photochemical process with geometrical isomerization of a carbon–carbon double bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkene photoisomerization" .

goldbook:AT07321 a skos:Concept ;
    skos:definition "Photochemical process leading to the skeletal rearrangement of an alkene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alkene photorearrangement" .

goldbook:AT07326 a skos:Concept ;
    skos:definition "Intense source of ultraviolet (\\(185\\) and \\(253.7\\ \\rm{nm}\\)) radiation produced by an electrical discharge in a lamp with the inner side covered by an amalgam of mercury with another element such as indium or gallium to control the vapour pressure of the mercury. These lamp have 2-3 times the UV output for the same wavelength as the standard low-pressure mercury lamp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "amalgam lamp" .

goldbook:AT07327 a skos:Concept ;
    skos:definition "Inter- and intramolecular photochemical processes involving the addition of a $\\ce{C–C}$ double (or triple) bond (i) to the 1,2-positions of an arene in which case it is called an ortho photocycloaddition, with formation of a benzocyclobutene (or a benzocyclobutadiene) derivative, (ii) to the 1,3-positions of an arene in which case it is called a meta photocycloaddition, with formation of tricyclo[3.3.0.02,8]oct-3-ene (or octa-3,6-diene) derivatives, or (iii) to the 1,4-positions of an arene in which case it is called a para photocycloaddition, with formation of bicyclo[2,2,2]oct-2-ene (or octa-2,5-diene) derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aromatic photocycloaddition" .

goldbook:AT07328 a skos:Concept ;
    skos:definition "Photochemical process leading to a chiral substance from an achiral precursor such that one enantiomer predominates over the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "asymmetric photochemistry" .

goldbook:AT07329 a skos:Concept ;
    skos:definition "Photochemical reaction of a 1-aza-1,4-diene or a 2-aza-1,4-diene in the triplet excited state to form the corresponding cyclopropylimine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aza-di-π-methane rearrangement" .

goldbook:AT07502 a skos:Concept ;
    skos:definition "Cluster of molecules or particles that results from agglomeration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agglomerate" .

goldbook:AT07516 a skos:Concept ;
    skos:definition "Gel in which the swelling agent consists predominantly of an alcohol or a mixture of alcohols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "alcogel" .

goldbook:AT07517 a skos:Concept ;
    skos:definition "Hydrogel in which the network component is a colloidal network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aquagel" .

goldbook:AT07591 a skos:Concept ;
    skos:definition "Behaviour of a polymer network in which the junction points deform uniformly with the macroscopic deformation of the network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "affine chain behaviour" .

goldbook:AT07606 a skos:Concept ;
    skos:definition "Hydrolysis of the dispersed component of an aerosol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aerosol hydrolysis" .

goldbook:AT07607 a skos:Concept ;
    skos:definition "Process in which dispersed molecules or particles assemble rather than remain as isolated single molecules or particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "agglomeration" .

goldbook:AT07608 a skos:Concept ;
    skos:definition "Process whereby dispersed molecules or particles form aggregates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "aggregation" .

goldbook:B00572 a skos:Concept ;
    skos:definition "Nuclear decay in which a β-particle is emitted or in which orbital electron capture occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-decay" .

goldbook:B00573 a skos:Concept ;
    skos:definition "Electron ejected from a radioactive nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "β-particle" .

goldbook:B00575 a skos:Concept ;
    skos:definition "A term often used to indicate thermal reversal of excited state electron transfer restoring the donor and acceptor in their original oxidation level. In using this term one should also specify the resulting electronic state of the donor and acceptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back electron transfer" .

goldbook:B00576 a skos:Concept ;
    skos:definition "Synonymous with stripping (by extraction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back extraction" .

goldbook:B00577 a skos:Concept ;
    skos:definition "The term employed to designate the value indicated by a radiation measuring device in the absence of the source whose radiation is to be measured, when the device is placed under its normal conditions of operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "background" .

goldbook:B00578 a skos:Concept ;
    skos:altLabel "background level",
        "baseline concentration" ;
    skos:definition "The concentration of a given species in a pristine air mass in which anthropogenic impurities of a relatively short lifetime are not present. The background concentrations of relatively long-lived molecules, methane, carbon dioxide, halocarbons ($\\ce{CF3Cl}$, $\\ce{CF2Cl2}$, etc.) and some other species continue to rise due to anthropogenic input, so the composition of background air is undergoing continual change. Background concentration of a given species is sometimes considered to be the concentration of that impurity in a given air mass when the contribution from anthropogenic sources under study is absent. Synonymous with baseline concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "background concentration" .

goldbook:B00580 a skos:Concept ;
    skos:definition "Radiation from any source other than the one it is desired to detect or measure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "background radiation" .

goldbook:B00581 a skos:Concept ;
    skos:definition "Scattering of radiation in a generally backward direction. In the assay of radioactivity, it applies to the scattering of radiation into the radiation detector from any material except the sample and the detector. In light scattering, it is said to occur when the scattering angle, \\(\\theta \\), is \\(180^{\\unicode{x26ac}}\\). Conversely, forward scattering occurs when \\(\\theta \\) is \\(0^{\\unicode{x26ac}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backscatter" .

goldbook:B00582 a skos:Concept ;
    skos:altLabel "BSEs" ;
    skos:definition "Number of back scattered electrons (BSEs) generated per primary electron for a given specimen and experimental condition. It depends on (mean) atomic number of the excited area of the sample, angle between electron beam and sample surface, primary electron energy and thickness of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back scatter coefficient" .

goldbook:B00583 a skos:Concept ;
    skos:altLabel "BSEs" ;
    skos:definition "All primary electrons which are scattered out of the original direction and retransmitted through the surface of the solid. In practice, electrons emitted from the surface of a solid under electron bombardment which have a kinetic energy in the range between \\(50\\ \\rm{eV}\\) and excitation energy (\\(E_{0}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back scattered electrons" .

goldbook:B00587 a skos:Concept ;
    skos:definition "A chamber used in incinerator design to promote the settling of fly ash and coarse particulate matter by changing the direction and/or reducing the velocity of the gases produced by the combustion of the refuse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "baffle chamber" .

goldbook:B00588 a skos:Concept ;
    skos:altLabel "fabric filter" ;
    skos:definition "A large bag constructed of a suitable fabric which is often tubular in shape, into which a particle-containing air stream flows. Modern bags are constructed of a fabric which is capable of collecting all but very fine particles in the gas stream. The efficiency of the removal of particles of various size ranges changes with the amount of particles captured by the filter and the filtering time. The bag operates on the same principle as the one on a household vacuum cleaner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bag filter" .

goldbook:B00589 a skos:Concept ;
    skos:definition "An installation which contains many bag filters in parallel so that the resistance to air flow in a large installation is not seriously increased by the addition of these controls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "baghouse" .

goldbook:B00590 a skos:Concept ;
    skos:definition "A term that is sometimes used in metallurgy for the martensitic transition that describes the transition between a face-centred-cubic lattice and a body-centred-tetragonal lattice. Example: The transition between the face-centred-cubic lattice of austenite and the body-centred-tetragonal lattice of a martensite." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bainite transition" .

goldbook:B00591 a skos:Concept ;
    skos:definition "The process in which the carbonaceous binder, usually coal tar pitch or petroleum pitch, as part of a shaped carbon mix is converted to carbon yielding a rigid carbon body by the slow application of heat. The process can take as little as \\(14\\ \\rm{days}\\) in coarse-grained, electrothermic grades (low binder level) and as long as \\(36\\ \\rm{days}\\) in ultra-fine-grained, specialty grades (high binder level). The final baking temperature can be in the range of \\(1100{-}1500\\ \\rm{K}\\), depending on the grade." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "baking" .

goldbook:B00592 a skos:Concept ;
    skos:definition "A set of empirical rules for certain formations of 3- to 7-membered rings. The predicted pathways are those in which the length and nature of the linking chain enables the terminal atoms to achieve the proper geometries for reaction. The disfavoured cases are subject to severe distortions of bond angles and bond distances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Baldwin's rules" .

goldbook:B00593 a skos:Concept ;
    skos:definition "The energy difference between the bottom of the conduction band and the top of the valence band in a semiconductor or an insulator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bandgap energy" .

goldbook:B00594 a skos:Concept ;
    skos:definition "An optical device which permits the transmission of radiation within a specified wavelength range and does not permit transmission of radiation at higher or lower wavelengths. It can be an interference filter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bandpass filter" .

goldbook:B00596 a skos:Concept ;
    skos:definition "Non-SI unit of pressure, \\(\\rm{bar} = 10^{5}\\ \\rm{Pa}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bar" .

goldbook:B00597 a skos:Concept ;
    skos:definition "Pyrimidine-2,4,6(1H,3H,5H)-trione (trivial name barbituric acid) and derivatives:  (keto tautomeric form)Salts of barbituric acid and its derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "barbiturates" .

goldbook:B00599 a skos:Concept ;
    skos:definition "Photolysis of a nitrite to form a $\\ce{\\updelta\\!\\mbox{-}nitroso alcohol}$. The mechanism is believed to involve a homolytic $\\ce{RO–NO}$ cleavage, followed by $\\ce{\\updelta\\!\\mbox{-}hydrogen}$ abstraction and radical coupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Barton reaction" .

goldbook:B00601 a skos:Concept ;
    skos:definition "A chemical species or molecular entity having an available pair of electrons capable of forming a covalent bond with a hydron (proton) (see Brønsted base) or with the vacant orbital of some other species (see Lewis base)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base" .

goldbook:B00602 a skos:Concept ;
    skos:definition "Synonymous with supporting electrolyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base electrolyte" .

goldbook:B00603 a skos:Concept ;
    skos:definition "A kind of quantity considered dimensionally independent of other kinds of quantities, i.e. it is not defined by an equation containing other kinds of quantities, e.g. length, mass, amount of substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base kind of quantity" .

goldbook:B00604 a skos:Concept ;
    skos:definition "The portion of the chromatogram recording the detector response when only the mobile phase emerges from the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "baseline" .

goldbook:B00606 a skos:Concept ;
    skos:definition "An error which arises if the two beams in a double-beam spectrometer are not fully equivalent in transmitted power nor are corrected to be so (e.g. due to unmatched cells)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "baseline error" .

goldbook:B00607 a skos:Concept ;
    skos:definition "The specific association between two complementary strands of nucleic acids that results from the formation of hydrogen bonds between the base components of the nucleotides of each strand: A=T and G=C in DNA, A=U and G=C (and sometimes G=U) in RNA (the lines indicate the number of hydrogen bonds). Single-stranded nucleic acid molecules can adopt a partially double-stranded structure through intrastrand base pairing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base pairing" .

goldbook:B00608 a skos:Concept ;
    skos:definition "The peak in a mass spectrum corresponding to the separated ion beam which has the greatest intensity. This term may be applied to the spectra of pure substances or mixtures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base peak" .

goldbook:B00609 a skos:Concept ;
    skos:definition "One of the quantities that, in a system of quantities, are conventionally accepted as functionally independent of one another. In the SI, these are: length, mass, time, electric current, temperature, amount of substance, and luminous intensity. All other physical quantities (and units) are regarded as being derived from these base quantities (and base units)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base quantity" .

goldbook:B00610 a skos:Concept ;
    skos:definition "Unit of measurement of a base quantity in a given system of quantities. By international agreement, a set of seven dimensionally independent units form the SI base units: the metre, kilogram, second, ampere, kelvin, mole and candela." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "base unit" .

goldbook:B00611 a skos:Concept ;
    skos:definition "For Brønsted bases, the tendency of a compound to act as hydron (proton) acceptor. The basicity of a chemical species is normally expressed by the acidity of the conjugate acid (see conjugate acid–base pair). For Lewis bases it relates to the association constants of Lewis adducts and π-adducts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basicity" .

goldbook:B00613 a skos:Concept ;
    skos:definition "A quantity of material which is known or assumed to be produced under uniform conditions. Some vocabularies assume 'lot' and 'batch' to be synonymous. The distinction made here with respect to knowledge of production history permits a lot to consist of one or more batches and is useful in interpreting the results of analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "batch" .

goldbook:B00615 a skos:Concept ;
    skos:definition "The operation of an analytical instrument in such a way that one or more analytical procedures must be completed for a sequence of samples before the next sequence can be started. This term batch usually implies a sequence of a variably sized group of samples, the size of which is not related to a particular type of instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "batch operation" .

goldbook:B00616 a skos:Concept ;
    skos:definition "In a batch reactor the reactants and the catalyst are placed in the reactor which is then closed to transport of matter and the reaction is allowed to proceed for a given time whereupon the mixture of unreacted material together with the products is withdrawn. Provision for mixing may be required." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "batch reactor" .

goldbook:B00618 a skos:Concept ;
    skos:altLabel "bathochromic effect" ;
    skos:definition "Shift of a spectral band to lower frequencies (longer wavelengths) owing to the influence of substitution or a change in environment. It is informally referred to as a red shift and is opposite to hypsochromic shift (blue shift)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bathochromic shift" .

goldbook:B00621 a skos:Concept ;
    skos:definition "The number of primary electrons reaching the surface of the specimen per unit time expressed as electrical current. Recommended symbol: \\(i_{\\rm{B}}\\); unit: \\(\\rm{A}\\); typical range: \\(\\mathrm{nA}\\). Recommended measurement technique: Faraday cage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam current" .

goldbook:B00622 a skos:Concept ;
    skos:definition "Diameter of the beam between which 68% of the electrons fall. For Gaussian beam shapes this corresponds to the 2\\(\\sigma \\)-value of the intensity distribution of the beam. Measurement can be carried out by scanning a beam across a sufficiently sharp edge and recording the transmitted electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "beam diameter" .

goldbook:B00624 a skos:Concept ;
    skos:definition "SI derived unit of radioactivity equal to one disintegration per second; admitted for reasons of safeguarding human health, symbol: \\(\\rm{Bq}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "becquerel" .

goldbook:B00625 a skos:Concept ;
    skos:definition "Synonymous with column volume for a packed column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bed volume" .

goldbook:B00626 a skos:Concept ;
    skos:altLabel "Beer–Lambert–Bouguer law" ;
    skos:definition "The absorbance of a beam of collimated monochromatic radiation in a homogeneous isotropic medium is proportional to the absorption path length, \\(l\\), and to the concentration, \\(c\\), or — in the gas phase — to the pressure of the absorbing species. The law can be expressed as: \\[A = \\rm{log}_{10}\\left ( \\frac{P_{\\lambda }^{0}}{P_{\\lambda }} \\right ) = \\varepsilon \\:c\\:l\\] or \\[P_{\\lambda }=P_{\\lambda }^{0}10^{-\\varepsilon \\: c\\: l}\\] where the proportionality constant, \\(\\varepsilon\\), is called the molar (decadic) absorption coefficient. For \\(l\\) in \\(\\pu{cm}\\) and \\(c\\) in \\(\\pu{mol dm-3}\\) or \\(\\rm{M}\\), \\(\\varepsilon\\) will result in \\(\\pu{dm3 mol-1 cm-1}\\) or \\(\\rm{M}^{-1}\\ \\rm{cm}^{-1}\\), which is a commonly used unit. The SI unit of \\(\\varepsilon\\) is \\(\\pu{m2 mol-1}\\). Note that spectral radiant power must be used because the Beer–Lambert law holds only if the spectral bandwidth of the light is narrow compared to spectral linewidths in the spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Beer–Lambert law" .

goldbook:B00628 a skos:Concept ;
    skos:definition "The linear relation between energy of activation \\((E_{\\rm{a}})\\) and enthalpy of reaction \\((\\Delta H_{\\rm{r}})\\) sometimes observed within a series of closely related reactions. \\[E_{\\rm{a}} = A + B\\ \\unicode[Times]{x394}H_{\\rm{r}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bell–Evans–Polanyi principle" .

goldbook:B00629 a skos:Concept ;
    skos:definition "The distribution of potential in the space charge region of a semiconductor results in a change in the electron energy levels with distance from the interface. This is usually described as 'bending of the energy bands'. Thus the bands are bent, upwards if \\(\\sigma >0\\) and downwards if \\(\\sigma" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bending of energy bands" .

goldbook:B00630 a skos:Concept ;
    skos:definition "Arenium ions, derived from benzene or substituted derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benzenium ions" .

goldbook:B00632 a skos:Concept ;
    skos:definition "Arylmethyl groups and derivatives formed by substitution: $\\ce{ArCR2^{–}}$, Benzyl, $\\ce{C6H5CH2^{–}}$, is the prototype. The term 'benzylic position' or 'benzylic site' refers to the saturated carbon atom. A group, such as $\\ce{–OH}$, attached at a benzylic site is sometimes referred to as 'benzylic'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benzylic groups" .

goldbook:B00633 a skos:Concept ;
    skos:definition "Carbanions, carbenium ions or radicals, derived formally by detachment of one hydron, hydride or hydrogen, respectively, from the $\\ce{CH3}$ group of toluene or substitution derivatives thereof, e.g. $\\ce{C6H5CH2^{.}}$, benzyl radical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benzylic intermediates" .

goldbook:B00634 a skos:Concept ;
    skos:definition "1,2-Didehydrobenzene (the aryne derived from benzene) and its derivatives formed by substitution; see arynes, dehydroarenes. The terms m- and p-benzyne are occasionally, but erroneously, used for 1,3- and 1,4-didehydrobenzene, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benzynes" .

goldbook:B00637 a skos:Concept ;
    skos:definition "Originally, the compound betaine, $\\ce{(CH3)3N^{+}–CH2C(=O)O^{−}}$ $N,N,N$-trimethylammonioacetate, and similar zwitterionic compounds derived from other amino acids. By extension, neutral molecules having charge-separated forms with an onium atom which bears no hydrogen atoms and that is not adjacent to the anionic atom. Betaines cannot be represented without formal charges. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "betaines" .

goldbook:B00638 a skos:Concept ;
    skos:definition "Bicyclic alkenes having a double bond between the bridgehead atoms and a trans attachment of each branch to the double bond. Thus trans-bicyclo[m.n.0]alk-1 (m+2)-enes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "betweenanenes" .

goldbook:B00640 a skos:Concept ;
    skos:definition "A pulse amplifier which, within the limits of its normal operating characteristics, has a constant gain for that portion of an input pulse that exceeds the threshold value and that produces no output for pulses whose amplitude is below the threshold." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biased linear pulse amplifier" .

goldbook:B00642 a skos:Concept ;
    skos:altLabel "polyfunctional catalysis" ;
    skos:definition "Catalysis (usually for hydron transfer) by a bifunctional chemical species involving a mechanism in which both functional groups are implicated in the rate-controlling step, so that the corresponding catalytic coefficient is larger than that expected for catalysis by chemical species containing only one of these functional groups. The term should not be used to describe the concerted action of two different catalysts ('concerted catalysis')." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bifunctional catalysis" .

goldbook:B00644 a skos:Concept ;
    skos:definition "The occurrence of two maxima in a frequency distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bimodal distribution" .

goldbook:B00646 a skos:Concept ;
    skos:definition "Usually a coal tar pitch or petroleum pitch (but may include thermosetting resins or mesophase pitch powders) which, when mixed with a binder coke or a filler, constitutes a carbon mix. This is used in preparation of the formation of shaped green bodies and subsequently carbon artifacts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binder" .

goldbook:B00647 a skos:Concept ;
    skos:definition "An additive used to hold the solid stationary phase to the inactive plate or sheet in thin-layer chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binder" .

goldbook:B00648 a skos:Concept ;
    skos:definition "A constituent of a carbon (or ceramic) artifact resulting from carbonization of the binder during baking." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binder coke" .

goldbook:B00649 a skos:Concept ;
    skos:definition "A specific region (or atom) in a molecular entity that is capable of entering into a stabilizing interaction with another molecular entity. An example of such an interaction is that of an active site in an enzyme with its substrate. Typical forms of interaction are by hydrogen bonding, coordination and ion pair formation. Two binding sites in different molecular entities are said to be complementary if their interaction is stabilizing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binding site" .

goldbook:B00650 a skos:Concept ;
    skos:definition "Many colloidal dispersions show Bingham flow which is characterized by a $\\upsigma\\!$-D diagram as shown. At rates of shear greater than that at point A, the following relation applies: \\[\\sigma - \\sigma _{\\rm{B}}=\\eta _{\\Delta }\\ D\\] where \\(\\sigma _{\\rm{B}}\\) (or \\(\\tau _{\\rm{B}}\\)) is called the Bingham yield stress, \\(\\eta _{\\Delta }\\) is the differential viscosity, \\(D\\) is the shear rate, and \\(\\sigma \\) is the average of three normal stress components if the deformation is purely dilatational." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bingham flow" .

goldbook:B00651 a skos:Concept ;
    skos:definition "A procedure for determining the concentration or biological activity of a substance (e.g. vitamin, hormone, plant growth factor, antibiotic) by measuring its effect on an organism or tissue compared to a standard preparation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioassay" .

goldbook:B00652 a skos:Concept ;
    skos:definition "An enzyme or enzyme complex consisting of, or derived from, an organism or cell culture (in cell-free or whole-cell forms) that catalyses metabolic reactions in living organisms and/or substrate conversions in various chemical reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biocatalyst" .

goldbook:B00653 a skos:Concept ;
    skos:altLabel "BOD",
        "biological oxygen demand" ;
    skos:definition "The amount of oxygen, divided by the volume of the system, taken up through the respiratory activity of microorganisms growing on the organic compounds present in the sample (e.g. water or sludge) when incubated at a specified temperature (usually \\(\\pu{20^{\\circ}C}\\)) for a fixed period (usually \\(\\rm{5\\ days}\\), \\(\\rm{BOD}_{5}\\)). It is a measure of that organic pollution of water which can be degraded biologically. In practice, it is usually expressed in milligrams \\(\\ce{O2}\\) per litre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biochemical oxygen demand" .

goldbook:B00654 a skos:Concept ;
    skos:definition "An integrated circuit whose electrical and logical functions are performed by protein molecules appropriately manipulated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biochip" .

goldbook:B00656 a skos:Concept ;
    skos:definition "Breakdown of a substance catalysed by enzymes in vitro or in vivo. This may be characterized for purposes of hazard assessment as:Primary. Alteration of the chemical structure of a substance resulting in loss of a specific property of that substance.Environmentally acceptable. Biodegradation to such an extent as to remove undesirable properties of the compound. This often corresponds to primary biodegradation but it depends on the circumstances under which the products are discharged into the environment.Ultimate. Complete breakdown of a compound to either fully oxidized or reduced simple molecules (such as carbon dioxide/methane, nitrate/ammonium and water).It should be noted that the products of biodegradation can be more harmful than the substance degraded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodegradation" .

goldbook:B00657 a skos:Concept ;
    skos:definition "The application of biomolecular principles to microelectronics such as in biosensors and biochips." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioelectronics" .

goldbook:B00658 a skos:Concept ;
    skos:definition "For a substance the time required for the amount of that substance in a biological system to be reduced to one half of its value by biological processes, when the rate of removal is approximately exponential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological half life" .

goldbook:B00659 a skos:Concept ;
    skos:definition "Luminescence produced by living systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioluminescence" .

goldbook:B00660 a skos:Concept ;
    skos:definition "Material produced by the growth of microorganisms, plants or animals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomass" .

goldbook:B00661 a skos:Concept ;
    skos:definition "Macromolecules (including proteins, nucleic acids and polysaccharides) formed by living organisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biopolymers" .

goldbook:B00662 a skos:Concept ;
    skos:definition "An apparatus used to carry out any kind of bioprocess; examples include fermenter or enzyme reactor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioreactor" .

goldbook:B00663 a skos:Concept ;
    skos:definition "A device that uses specific biochemical reactions mediated by isolated enzymes, immunosystems, tissues, organelles or whole cells to detect chemical compounds usually by electrical, thermal or optical signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biosensor" .

goldbook:B00664 a skos:Concept ;
    skos:definition "That part of the globe that encompasses all forms of life on the earth. It extends from the ocean depths to a few thousand metres of altitude in the atmosphere, and includes life forms at the earth's surface, in soils and constituents which exchange materials with atmospheres, oceans or surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biosphere" .

goldbook:B00665 a skos:Concept ;
    skos:definition "The production of a chemical compound by a living organism (cf. biotransformation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biosynthesis" .

goldbook:B00666 a skos:Concept ;
    skos:definition "The integration of natural sciences and engineering sciences in order to achieve the application of organisms, cells, parts thereof and molecular analogues for products and services." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotechnology" .

goldbook:B00667 a skos:Concept ;
    skos:altLabel "bioconversion" ;
    skos:definition "Any chemical conversion of substances that is mediated by living organisms or enzyme preparations derived therefrom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biotransformation" .

goldbook:B00668 a skos:Concept ;
    skos:definition "Simultaneous (coherent) absorption of two photons (either same or different wavelength), the energy of excitation being the sum of the energies of the two photons. Also called two-photon excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biphotonic excitation" .

goldbook:B00669 a skos:Concept ;
    skos:definition "Resulting from biphotonic excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biphotonic process" .

goldbook:B00671 a skos:Concept ;
    skos:definition "An even-electron molecular entity with two (possibly delocalized) radical centres which act nearly independently of each other, e.g.  Species in which the two radical centres interact significantly are often referred to as 'biradicaloids'. If the two radical centres are located on the same atom, the species are more properly referred to by their generic names: carbenes, nitrenes, etc. The lowest-energy triplet state of a biradical lies below or at most only a little above its lowest singlet state (usually judged relative to \\(k_{\\rm{B}}\\ T\\), the product of the Boltzmann constant \\(k_{\\rm{B}}\\) and the absolute temperature \\(T\\)). The states of those biradicals whose radical centres interact particularly weakly are most easily understood in terms of a pair of local doublets. Theoretical descriptions of low-energy states of biradicals display the presence of two unsaturated valences (biradicals contain one fewer bond than permitted by the rules of valence): the dominant valence bond structures have two dots, the low energy molecular orbital configurations have only two electrons in two approximately nonbonding molecular orbitals, two of the natural orbitals have occupancies close to one, etc. Although this term has been recommended in the past for diradicals, specialists working in the field prefer the latter term." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biradical" .

goldbook:B00673 a skos:Concept ;
    skos:altLabel "eclipsing conformation" ;
    skos:definition "For a structure containing the grouping $\\ce{R3C–C(Y)=X}$ (with identical or different groups $\\ce{R}$) the conformation in which the torsion angle is such that $\\ce{X}$ is antiperiplanar to one of the groups $\\ce{R}$, and, in a Newman projection, the double bond $\\ce{C=X}$ bisects one of the $\\ce{R–C–R}$ angles. In this conformation the bond $\\ce{C–Y}$ eclipses one of the $\\ce{C–R}$ bonds. The other conformation, in which $\\ce{X}$ is synperiplanar to one of the groups $\\ce{R}$, is called an eclipsing conformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bisecting conformation" .

goldbook:B00674 a skos:Concept ;
    skos:definition "The saturated hydrides of tervalent bismuth, having the general formula $\\ce{Bi_{n}H_{n+2}$. Hydrocarbyl derivatives of $\\ce{BiH3}$ belong to the class bismuthines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bismuthanes" .

goldbook:B00675 a skos:Concept ;
    skos:definition "$\\ce{BiH3}$ and compounds derived from it by substituting one, two or three hydrogen atoms by hydrocarbyl groups: $\\ce{R3Bi}$, $\\ce{RBiH2}$, $\\ce{R2BiH}$ ($\\ce{R}  eq \\ce{RH}$) are called primary, secondary and tertiary bismuthines, respectively. A specific bismuthine is preferably named as a substituted bismuthane, e.g. $\\ce{(CH3)3Bi}$ trimethylbismuthane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bismuthines" .

goldbook:B00676 a skos:Concept ;
    skos:definition "By usage, the methylenediphenols, $\\ce{HOC6H4CH2C6H4OH}$, commonly $p,p$-methylenediphenol, and their substitution products (generally derived from condensation of two equivalent amounts of a phenol with an aldehyde or ketone)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bisphenols" .

goldbook:B00677 a skos:Concept ;
    skos:definition "A wind vane used in turbulence studies to obtain horizontal and vertical components of the wind vector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bivane" .

goldbook:B00678 a skos:Concept ;
    skos:definition "A film thinner than about \\(\\frac{1}{4}\\) wavelength of visible light. Black films are often equilibrium film, but equilibrium films may be considerably thicker under some conditions. In soap films, two types of equilibrium film are often observed: the one characterized by thickness of the order of \\(7\\ \\rm{nm}\\) or more which varies significantly with minor changes in composition such as ionic strength is called 'common black film'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "black film" .

goldbook:B00679 a skos:Concept ;
    skos:definition "A reading or result originating from the matrix, reagents and any residual bias in the measurement device or process, which contributes to the value obtained for the quantity in the analytical procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blank value" .

goldbook:B00681 a skos:Concept ;
    skos:definition "The loss of absorption or emission intensity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bleaching" .

goldbook:B00682 a skos:Concept ;
    skos:definition "A portion of a macromolecule, comprising many constitutional units that has at least one feature which is not present in the adjacent portions. Where appropriate, definitions relating to 'macromolecule' may also be applied to 'block'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "block" .

goldbook:B00683 a skos:Concept ;
    skos:definition "A copolymer that is a block polymer. In the constituent macromolecules of a block copolymer, adjacent blocks are constitutionally different, i.e. adjacent blocks comprise constitutional units derived from different species of monomer or from the same species of monomer but with a different composition or sequence distribution of constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "block copolymer" .

goldbook:B00684 a skos:Concept ;
    skos:definition "A macromolecule which is composed of blocks in linear sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "block macromolecule" .

goldbook:B00685 a skos:Concept ;
    skos:definition "A polymer composed of block macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "block polymer" .

goldbook:B00686 a skos:Concept ;
    skos:definition "A technique used for transferring DNA, RNA or protein from gels to a suitable binding matrix, such as nitrocellulose or Nylon paper, while maintaining the same physical separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blotting" .

goldbook:B00687 a skos:Concept ;
    skos:definition "Hydrocarbons purged during refinery shutdowns and startups which should be piped to storage systems for safe venting, flaring or recovery. This term also applies to the purging of water in boiler operation, and serves in the control of dissolved solids in the boiler water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blowdown" .

goldbook:B00688 a skos:Concept ;
    skos:definition "Informal expression for hypsochromic shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "blue shift" .

goldbook:B00692 a skos:Concept ;
    skos:definition "Electromagnetic fundamental physical constant: \\[\\mu _{\\rm{B}} = \\frac{e\\ \\mathrm{\\hslash }}{2\\ m_{\\rm{e}}} = 9.274\\hspace{0.5em}0154\\hspace{0.25em}\\left(31\\right)\\times 10^{-24}\\ \\mathrm{J}\\ \\mathrm{T}^{-1}\\] where \\(e\\) is the elementary charge, \\(\\mathrm{\\hslash}\\) the Planck constant divided by \\(2\\ \\pi \\) and \\(m_{\\rm{e}}\\) the electron rest mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bohr magneton" .

goldbook:B00693 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant used as atomic unit of length: \\[a_{0}=\\frac{4\\ \\pi \\ \\varepsilon_{0}\\ \\mathrm{\\hslash }^{2}}{m_{\\rm{e}}\\ e^{2}}=5.291 \\ 772\\ 49\\ (24)\\times 10^{-11}\\ \\rm{m}\\] where \\(e\\) is the elementary charge, \\(\\mathrm{\\hslash}\\) is the Planck constant divided by \\(2\\ \\pi \\) and \\(m_{\\rm{e}}\\) is the electron rest mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bohr radius" .

goldbook:B00694 a skos:Concept ;
    skos:definition "A detector constructed from a material having a large temperature coefficient of resistance. Absorption of radiation gives rise to a change in resistance. A bolometer is named according to its active component, e.g. thermistor bolometer, semiconductor bolometer, superconductor bolometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bolometer" .

goldbook:B00695 a skos:Concept ;
    skos:definition "The Boltzmann constant, \\(k\\), is one of seven fixed constants defining the International System of Units, the SI, with \\(k = \\pu{1.380649E-23 J K-1}\\). The Boltzmann constant is a proportionality constant between the quantities temperature (with unit kelvin) and energy (with unit joule)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Boltzmann constant" .

goldbook:B00696 a skos:Concept ;
    skos:definition "Materials which are not fully dissolved by acid-digestion at atmospheric pressure may require a more vigorous treatment in pressure vessels lined with polytetrafluoroethylene (PTFE) glass, silica or vitreous (glassy) carbon or in sealed silica tubes; this treatment is called bomb-digestion. The test sample and acids are heated in such a closed vessel, so that the digestion is carried out at higher temperature and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bomb-digestion" .

goldbook:B00697 a skos:Concept ;
    skos:definition "There is a chemical bond between two atoms or groups of atoms in the case that the forces acting between them are such as to lead to the formation of an aggregate with sufficient stability to make it convenient for the chemist to consider it as an independent 'molecular species'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond" .

goldbook:B00698 a skos:Concept ;
    skos:definition "(In ordinary usage the term refers to homolysis only.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond dissociation" .

goldbook:B00699 a skos:Concept ;
    skos:definition "The enthalpy (per mole) required to break a given bond of some specific molecular entity by homolysis, e.g. for , symbolized as \\(D\\left(\\rm{CH}_{3}\\,-\\rm{H}\\right)\\) (cf. heterolytic bond dissociation energy)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond-dissociation energy" .

goldbook:B00700 a skos:Concept ;
    skos:definition "A stationary phase which is covalently bonded to the support particles or to the inside wall of the column tubing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bonded phase" .

goldbook:B00701 a skos:Concept ;
    skos:altLabel "mean bond energy" ;
    skos:definition "The average value of the gas-phase bond dissociation energies (usually at a temperature of \\(298\\ \\rm{K}\\)) for all bonds of the same type within the same chemical species. The mean bond energy for methane, for example, is one-fourth the enthalpy of reaction for:  Tabulated bond energies are generally values of bond energies averaged over a number of selected typical chemical species containing that type of bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond energy" .

goldbook:B00702 a skos:Concept ;
    skos:definition "An empirical procedure for estimating activation energies, involving empirical relationships between bond length, bond dissociation energy, and bond order." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond-energy-bond-order method" .

goldbook:B00703 a skos:Concept ;
    skos:definition "The bonding number \\(n\\) of a skeletal atom is the sum of the total number of bonding equivalents (valence bonds) of that skeletal atom to adjacent skeletal atoms in a parent hydride, if any, and the number of attached hydrogen atoms, if any. Examples: $\\ce{SH2}$: for $\\ce{S}$, \\(n=2\\); $\\ce{SH6}$: for $\\ce{S}$, \\(n=6\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bonding number" .

goldbook:B00705 a skos:Concept ;
    skos:definition "The number of electron-pair bonds between two nuclei in any given Lewis formula. For example, in ethene the bond number between the carbon atoms is two, and between the carbon and hydrogen atoms it is one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond number" .

goldbook:B00709 a skos:Concept ;
    skos:definition "The molecular hydrides of boron, e.g. $\\ce{B5H9}$ pentaborane(9)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boranes" .

goldbook:B00710 a skos:Concept ;
    skos:definition "The species $\\ce{RB{:}}$ containing an electrically neutral univalent boron atom with two formally non-bonding electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boranylidenes" .

goldbook:B00711 a skos:Concept ;
    skos:definition "A mechanism intermediate between two extremes, for example a nucleophilic substitution intermediate between \\(\\rm{S}_{\\rm{N}}1\\) and \\(\\rm{S}_{\\rm{N}}2\\), or intermediate between electron transfer and \\(\\rm{S}_{\\rm{N}}2\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "borderline mechanism" .

goldbook:B00712 a skos:Concept ;
    skos:definition "A traditional term for boranylidenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "borenes" .

goldbook:B00713 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2BOH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "borinic acids" .

goldbook:B00714 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RB(OH)2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boronic acids" .

goldbook:B00715 a skos:Concept ;
    skos:definition "A traditional term for boranylidenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "borylenes" .

goldbook:B00717 a skos:Concept ;
    skos:definition "That well-mixed region of the lower atmosphere in which the turbulence is maintained largely by convective buoyancy induced by the upward heat flux originating from the solar-heated surface of the earth. During the afternoon this often extends from \\(1\\ \\rm{km}\\) to \\(5\\ \\rm{km}\\) in height. The surface boundary layer is that region of the lower atmosphere where the shearing stress is constant. It is separated by the Ekman layer from the free atmosphere, where the behaviour of the atmosphere approaches that of an ideal fluid in approximate geostrophic equilibrium (horizontal coriolis force balances the horizontal pressure force at all points in the field)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "boundary layer" .

goldbook:B00718 a skos:Concept ;
    skos:definition "The fraction of the incubation mixture which, after separation, contains the analyte bound to the binding reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bound fraction" .

goldbook:B00719 a skos:Concept ;
    skos:definition "In the boat form of cyclohexane and related structures there are two ring atoms lying out of the plane of the other four; exocyclic bonds to these two atoms pointing in a direction roughly parallel to that plane are called bowsprit, the other two are called flagpole." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bowsprit" .

goldbook:B00720 a skos:Concept ;
    skos:altLabel "pendant chain",
        "side chain" ;
    skos:definition "An oligomeric or polymeric offshoot from a macromolecular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branch" .

goldbook:B00721 a skos:Concept ;
    skos:definition "A chain with at least one branch point intermediate between the boundary units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branched chain" .

goldbook:B00722 a skos:Concept ;
    skos:definition "A polymer the molecules of which are branched chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branched polymer" .

goldbook:B00723 a skos:Concept ;
    skos:definition "A chain reaction which includes a propagation step or steps in which there is an increase in the number of active intermediates; for example,  is a branching reaction since one active intermediate ($\\ce{H}$) gives rise to two ($\\ce{OH}$ and $\\ce{O}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branching chain reaction" .

goldbook:B00724 a skos:Concept ;
    skos:definition "Nuclear decay which can proceed in two or more different ways." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branching decay" .

goldbook:B00725 a skos:Concept ;
    skos:definition "In branching decay the fraction of nuclei which decay in a specified way." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branching fraction" .

goldbook:B00727 a skos:Concept ;
    skos:definition "The ratio of alternative products formed in a reaction (e.g. the $\\ce{HF}$/$\\ce{DF}$ ratio in the reaction between $\\ce{F}$ and $\\ce{HD}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branching ratio" .

goldbook:B00728 a skos:Concept ;
    skos:definition "Point on a polymer chain at which a branch is attached." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branch point" .

goldbook:B00729 a skos:Concept ;
    skos:definition "A constitutional unit containing a branch point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branch unit" .

goldbook:B00730 a skos:Concept ;
    skos:definition "The process involving the coalescence of gas bubbles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "break" .

goldbook:B00731 a skos:Concept ;
    skos:definition "The flocculation of an emulsion, viz. the formation of aggregates may be followed by coalescence. If coalescence is extensive it leads to the formation of a macrophase and the emulsion is said to break." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "break" .

goldbook:B00732 a skos:Concept ;
    skos:definition "A double bond cannot be placed with one terminus at the bridgehead of a bridged ring system unless the rings are large enough to accommodate the double bond without excessive strain. For example, while bicyclo[2.2.1]hept-1-ene is only capable of existence as a transient, its higher homologues having a double bond at the bridgehead position have been isolated: e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bredt's rule" .

goldbook:B00733 a skos:Concept ;
    skos:definition "The passage or conduit through which the exhaust products of combustion are carried to the stack or chimney." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "breeching" .

goldbook:B00734 a skos:Concept ;
    skos:definition "A term sometimes used to describe very fine particles of coke. Also a meteorological term for a gentle wind." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "breeze" .

goldbook:B00735 a skos:Concept ;
    skos:definition "X-radiation emitted as a result of the retardation of high energy particles by matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bremsstrahlung" .

goldbook:B00737 a skos:Concept ;
    skos:definition "A carbocation (real or hypothetical) in which there are two (or more) carbon atoms that could in alternative Lewis formulae be designated as carbenium centres but which is instead represented by a structure in which a group (a hydrogen atom or a hydrocarbon residue, possibly with substituents in non-involved positions) bridges these potential carbenium centres. One may distinguish 'electron-sufficient bridged carbocations' and 'electron-deficient bridged carbocations'. Examples of the former are phenyl-bridged ions (for which the trivial name 'phenonium ion' has been used), such as (A). These ions are straightforwardly classified as carbenium ions. The latter type of ion necessarily involves three-centre bonding. Structures (C) and (D) contain five-coordinate carbon atoms. The 'hydrogen-bridged carbocation' (B) contains a two-coordinate hydrogen atom. hypercoordination, which includes two-coordination for hydrogen and five- but also higher coordination for carbon is generally observed in bridged carbocations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bridged carbocation" .

goldbook:B00739 a skos:Concept ;
    skos:definition "In a coordination entity, the number of central atoms linked by a particular bridging ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bridge index" .

goldbook:B00740 a skos:Concept ;
    skos:definition "Solution of high concentration of inert salt, preferably comprising cations and anions of equal mobility, optionally interposed between the reference electrode filling and both the test and standard solution, when the test solution and filling solution are chemically incompatible. This procedure introduces into the operational cell a second liquid junction formed usually in a similar way to the first. (This definition refers to a bridge solution of a double junction reference electrode.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bridge solution" .

goldbook:B00741 a skos:Concept ;
    skos:definition "A ligand attached to two or more, usually metallic, central atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bridging ligand" .

goldbook:B00744 a skos:Concept ;
    skos:definition "A molecular entity capable of donating a hydron (proton) to a base, (i.e. a 'hydron donor') or the corresponding chemical species. For example: $\\ce{H2O}$, $\\ce{H3O^{+}}$, $\\ce{CH3CO2H}$, $\\ce{H2SO4}$, $\\ce{HSO4^{−}}$, $\\ce{HCl}$, $\\ce{CH3OH}$, $\\ce{NH3}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brønsted acid" .

goldbook:B00745 a skos:Concept ;
    skos:definition "A molecular entity capable of accepting a hydron (proton) from an acid (i.e. a 'hydron acceptor') or the corresponding chemical species. For example: $\\ce{OH−}$, $\\ce{H2O}$, $\\ce{CH3CO2^{−}}$, $\\ce{HSO4^{−}}$, $\\ce{SO4^{2−}}$, $\\ce{Cl^{−}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brønsted base" .

goldbook:B00746 a skos:Concept ;
    skos:definition "The term applies to either of the equations: \\[\\frac{k_{\\rm{HA}}}{p} = G\\left ( \\frac{q\\ K_{\\rm{HA}}}{p} \\right )^{\\alpha}\\] \\[\\frac{k_{\\rm{A}}}{q} = G\\left ( \\frac{q\\ K_{\\rm{HA}}}{p} \\right )^{-\\beta} \\] (or their logarithmic forms) where \\(\\alpha\\), \\(\\beta\\) and \\(G\\) are constants for a given reaction series (\\(\\alpha\\) and \\(\\beta\\) are called 'Brønsted exponents'), \\(k_{\\rm{HA}}\\) and \\(k_{\\rm{A}}\\) are catalytic coefficients (or rate coefficients) of reactions whose rates depend on the concentrations of $\\ce{HA}$ and/or of $\\ce{A^{-}}$. \\(K_{\\rm{HA}}\\) is the acid dissociation constant of the acid $\\ce{HA}$, \\(p\\) is the number of equivalent acidic protons in the acid $\\ce{HA}$, and \\(q\\) is the number of equivalent basic sites in its conjugate base $\\ce{A^{-}}$. The chosen values of \\(p\\) and \\(q\\) should always be specified. (The charge designations of $\\ce{H}$ and $\\ce{A}$ are only illustrative.) The Brønsted relation is often termed the 'Brønsted catalysis law' (or the 'Catalysis law'). Although justifiable on historical grounds, this name is not recommended, since Brønsted relations are known to apply to many uncatalysed and pseudo-catalysed reactions (such as simple proton (hydron) transfer reactions). The term 'pseudo-Brønsted relation' is sometimes used for reactions which involve nucleophilic catalysis instead of acid–base catalysis. Various types of Brønsted parameters have been proposed such as \\(\\beta_{\\rm{lg}}\\), \\(\\beta_{\\rm{nuc}}\\), \\(\\beta_{\\rm{eq}}\\) for leaving group, nucleophile and equilibrium constants, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Br&#xF8;nsted relation" .

goldbook:B00747 a skos:Concept ;
    skos:definition "The structure of the anisotropic spheres which precipitate from isotropic pitch during pyrolysis. The structure of the spheres consists of a lamellar arrangement of aromatic molecules in parallel layers which are perpendicular to the polar axis of the sphere and which are perpendicular to the mesophase-isotropic phase interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brooks and Taylor structure" .

goldbook:B00748 a skos:Concept ;
    skos:definition "The movement of particles in a colloidal system such as an aerosol caused by collision with the molecules in the fluid in which the particles are imbedded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brownian motion" .

goldbook:B00750 a skos:Concept ;
    skos:definition "A bioreactor, in the shape of a column, in which the reaction medium is kept mixed and aerated by introduction of air into the bottom (cf. air lift bioreactor)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bubble column" .

goldbook:B00751 a skos:Concept ;
    skos:definition "An apparatus used to absorb certain water soluble components in a gas stream for later analysis. Usually it involves the use of a glass fritted tube which forces the air into small bubbles of high surface area during operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bubbler" .

goldbook:B00753 a skos:Concept ;
    skos:definition "In any technique that involves the establishment of a concentration gradient, either within the material from which an electrode is made or in the solution that is in contact with an electrode, the bulk concentration of a substance B is the total or analytical concentration of B at points so remote from the electrode-solution interface that the concentration gradient for B is indistinguishable from zero at the instant under consideration. In common practice the bulk concentration of B is taken to be the total or analytical concentration of B that would be present throughout the electrode or solution if there were no current flowing through the cell and if the electrode and solution did not interact in any way. In the absence of any homogeneous reaction or other process that produces or consumes B, the bulk concentration of B is the total or analytical concentration of B that is present before the excitation signal is applied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk concentration" .

goldbook:B00754 a skos:Concept ;
    skos:definition "A continuous anisotropic phase formed by coalescence of mesophase spheres. Bulk mesophase retains fluidity and is deformable in the temperature range up to about \\(770\\ \\rm{K}\\), and transforms into green coke by further loss of hydrogen or low-molecular-weight species. This bulk mesophase can sometimes be formed directly from the isotropic pitch without observation of intermediate spheres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk mesophase" .

goldbook:B00755 a skos:Concept ;
    skos:definition "Rheology may be conveniently divided into bulk rheology, in which effects due to the surface of the system can be neglected, and surface rheology, in which such effects are predominant. It should be noted that in surface rheology the neglect of bulk behaviour is permissible only in exceptional circumstances, such as for very thin films surrounded by a gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk rheology" .

goldbook:B00756 a skos:Concept ;
    skos:definition "The sample resulting from the planned aggregation or combination of sample units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bulk sample" .

goldbook:B00758 a skos:Concept ;
    skos:definition "The equations for the relation between \\(\\log _{10}(\\frac{\\rm{[SH}^{+}\\rm{]}}{[S]})+\\rm{H}_{0}\\) and \\(\\log _{10}\\rm{[H}^{+}\\rm{]}+\\rm{H}_{0}\\) for base S in aqueous mineral acid solution, where \\(\\rm{H}_{0}\\) is Hammett's acidity function and \\(\\log _{10}\\rm{[H}^{+}\\rm{]}+\\rm{H}_{0}\\) represents the activity function \\(\\frac{\\log _{10}(\\gamma _{S}\\ \\gamma _{H^{+}})}{\\gamma _{\\rm{SH}^{+}}}\\) for the nitroaniline reference bases to build \\(\\rm{H}_{0}\\). \\[\\log _{10}(\\frac{[\\rm{SH}^{+}]}{[\\rm{S}]})- \\log _{10}[\\rm{H}^{+}]=(\\varPhi - 1)\\ (\\log _{10}\\rm{[H}^{+}\\rm{]}+\\rm{H}_{0})+pK_{\\rm{SH}^{+}}\\] \\[\\log _{10}(\\frac{[\\rm{SH}^{+}]}{[\\rm{S}]})+H_{0}=\\varPhi \\ (\\log _{10}[\\rm{H}^{+}]+\\rm{H}_{0})+pK_{\\rm{SH}^{+}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bunnett–Olsen equations" .

goldbook:B00760 a skos:Concept ;
    skos:definition "Salts (usually sodium salts) of $S$-alkylthiosulfuric acid, of general structure $\\ce{RSS(=O)2O^{−}M^{+}}$. Use of this term is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bunte salts" .

goldbook:B00762 a skos:Concept ;
    skos:definition "The mean velocity of the flame front (in \\(\\rm{mm s}^{-1}\\)) towards the unburnt gas mixture (usually vertically downwards). The quantity applies to gas mixtures and not to injection burners, and depends on the flame temperature and the solvent nebulized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "burning velocity" .

goldbook:B00763 a skos:Concept ;
    skos:definition "Induced nuclear transformation of atoms during reactor operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "burn-up" .

goldbook:B00764 a skos:Concept ;
    skos:definition "The fraction of an initial quantity of a given nuclide that has undergone burn-up." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "burn-up fraction" .

goldbook:BT06756 a skos:Concept ;
    skos:definition "A molecular species produced by living systems of biological origin when it is composed of two parts of different origins, e.g. a conjugate of a xenobiotic with some groups, e.g. glutathione, sulfate or glucuronic acid, to make it soluble in water or compartmentalized within the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioconjugate" .

goldbook:BT06768 a skos:Concept ;
    skos:definition "Refers to a laboratory procedure designed to imitate a natural chemical process. Also refers to a compound that mimics a biological material in its structure or function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomimetic" .

goldbook:BT06798 a skos:Concept ;
    skos:definition "A compound resulting from the exchange of an atom or group of atoms with another, broadly similar, atom or group of atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioisostere" .

goldbook:BT06813 a skos:Concept ;
    skos:definition "Ratio of the systemic exposure from extravascular (ev) exposure to that following intravenous (iv) exposure as described by the equation: \\[F=\\frac{A_{\\rm{ev}}\\ D_{\\rm{iv}}}{B_{\\rm{iv}}\\ D_{\\rm{ev}}}\\] where \\(F\\) is the bioavailabilty, \\(A\\) and \\(B\\) are areas under the (plasma) concentration-time curve following extravascular and intravenous administration, respectively, and \\(D_{\\rm{ev}}\\) and \\(D_{\\rm{iv}}\\) are the administered extravascular and intravenous doses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioavailability" .

goldbook:BT06847 a skos:Concept ;
    skos:definition "Extent of absorption of a substance by a living organism compared to a standard system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bioavailability" .

goldbook:BT06885 a skos:Concept ;
    skos:definition "Temporary reversal of the direction of the permeable flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "backflush" .

goldbook:BT06899 a skos:Concept ;
    skos:altLabel "lower effective dose" ;
    skos:definition "The statistical lower bound on a dose corresponding to a specified level of risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "benchmark dose" .

goldbook:BT06900 a skos:Concept ;
    skos:definition "Continuous or repeated measurement of early biological effects of exposure to a substance to evaluate ambient exposure and health risk by comparison with appropriate reference values based on knowledge of the probable relationship between ambient exposure and biological effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological effect monitoring" .

goldbook:BT06901 a skos:Concept ;
    skos:altLabel "BEI" ;
    skos:definition "Reference values intended as guidelines for the evaluation of potential health hazards in the practice of industrial hygiene. BEIs represent the levels of determinants that are most likely to be observed in specimens collected from a healthy worker who has been exposed to chemicals to the same extent as a worker with inhalation exposure to the TLV." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological exposure index" .

goldbook:BT06902 a skos:Concept ;
    skos:definition "Continuous or repeated measurement of potentially toxic substances or their metabolites in tissues, secreta, excreta, expired air, or any combination of these to evaluate occupational or environmental exposure and health risk by comparison with appropriate reference values based on knowledge of the probable relationship between ambient exposure and resultant health effects. Sometimes also called 'biomonitoring'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological monitoring" .

goldbook:BT06903 a skos:Concept ;
    skos:altLabel "BAT",
        "Biologische Arbeitsstoff Toleranz Werte" ;
    skos:definition "The maximum permissible quantity of a chemical compound or its metabolites, or any deviation from the norm of biological parameters induced by those substances in exposed humans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biological tolerance values for working materials" .

goldbook:BT06904 a skos:Concept ;
    skos:definition "A parameter that can be used to identify a toxic effect in an individual organism and can be used in extrapolation between species, or as an indicator signalling an event or condition in a biological system or sample and giving a measure of exposure, effect, or susceptibility. The term 'biomarker' is generally used in scientific publications. In occupational hygiene and health, 'biological monitoring' and 'biological effect monitoring' are used with the meaning 'monitoring biomarkers'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biomarker" .

goldbook:BT06905 a skos:Concept ;
    skos:definition "Total amount of substance of a chemical present in an organism at a given time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "body burden" .

goldbook:BT06997 a skos:Concept ;
    skos:altLabel "Chatt–Dewar–Duncanson model" ;
    skos:definition "A description of the bonding of $\\ce{\\uppi\\!\\mbox{-}conjugated}$ ligands to a transition metal which involves a synergic process with donation of electrons from the filled $\\ce{\\uppi\\!\\mbox{-}orbital}$ or lone electron pair orbital of the ligand into an empty orbital of the metal (donor–acceptor bond), together with release (back donation) of electrons from an nd orbital of the metal (which is of $\\ce{\\uppi\\!\\mbox{-}symmetry}$ with respect to the metal–ligand axis) into the empty $\\ce{\\uppi\\!^{\\ast}\\mbox{-}antibonding orbital}$ $\\ce{\\uppi\\!\\mbox{-}complex}$ of the ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "back donation" .

goldbook:BT06998 a skos:Concept ;
    skos:definition "A one-electron function used in the expansion of the molecular orbital function. Basis functions are commonly represented by atomic orbitals (see also Slater-type orbital or Gaussian-type orbital) centered on each atom of the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basis function" .

goldbook:BT06999 a skos:Concept ;
    skos:definition "A set of basis functions employed for the representation of molecular orbitals. One may distinguish the minimal basis set (includes one basis function for each SCF occupied atomic orbital with distinct principal and angular momentum quantum numbers); split valence basis set (includes two or more sizes of basis function for each valence orbital); double zeta (DZ) basis set (a split valence basis set that includes exactly twice as many functions as the minimal basis set); extended basis set (the set larger than the double zeta basis set); polarized basis set (incorporates basis functions of higher angular quantum number beyond what is required by the atom in its electronic ground state; allows orbitals to change not only a size, but also a shape); basis set with diffuse functions and others." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "basis set" .

goldbook:BT07000 a skos:Concept ;
    skos:definition "In a molecule, smaller bond angles are formed between electronegative ligands since the central atom, to which the ligands are attached, tends to direct bonding hybrid orbitals of greater p character towards its more electronegative substituents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Bent's rule" .

goldbook:BT07001 a skos:Concept ;
    skos:definition "The difference between the total energy of a molecular system and the sum of the energies of its isolated $\\ce{\\uppi\\!\\mbox{-}}$ and $\\ce{\\upsigma\\!\\mbox{-}bonds}$. The value of binding energy depends upon the geometrical arrangement of the isolated subunits (molecules). According to another definition, the term to be subtracted from the total energy is the sum of the energies of the separate atoms in the corresponding valence states, which compose the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "binding energy" .

goldbook:BT07002 a skos:Concept ;
    skos:definition "The energy required to break a given type of bond between atoms in certain valence states. An averaged bond energy is commonly derived by dissecting the heat of atomization of a molecule into contributions of individual bonds. For molecules with localized bonds, the heats of atomization (formation) are usually well approximated by the sum of pertinent averaged bond energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond energy" .

goldbook:BT07003 a skos:Concept ;
    skos:definition "The distance between atomic centers involved in a chemical bond. The notion of bond length is defined differently in various experimental methods of determination of molecular geometry; this leads to small (usually \\(0.01{-}0.02\\ \\mathring{\\rm{A}}\\)) differences in bond lengths obtained by different techniques. For example, in gas-phase electron-diffraction experiments, the bond length is the interatomic distance averaged over all occupied vibrational states at a given temperature. In an X-ray crystal structural method, the bond length is associated with the distance between the centroids of electron densities around the nuclei. In gas-phase microwave spectroscopy, the bond length is an effective interatomic distance derived from measurements on a number of isotopic molecules, etc. A number of empirical relationships between bond lengths and bond orders in polyatomic molecules were suggested, see, for example, fractional bond number (the Pauling's bond order)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond length" .

goldbook:BT07004 a skos:Concept ;
    skos:definition "A localized molecular orbital related to a certain $\\ce{\\upsigma\\!\\mbox{-}}$, $\\ce{\\uppi\\!\\mbox{-}}$, or $\\ce{\\updelta\\!\\mbox{-}bond}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond orbital" .

goldbook:BT07005 a skos:Concept ;
    skos:definition "The electron population in the region between atoms A and B of a molecular entity at the expense of electron density in the immediate vicinity of the individual atomic centers. Different schemes of partitioning electron density give rise to different definitions of bond orders. In the framework of the Mulliken population analysis, bond order is associated with the total overlap population, \\[\\rm{q}_{\\rm{AB}}=2\\ \\sum _{\\begin{array}{c} \\unicode[Times]{x3BC}  \\end{array}}^{\\rm{A}}\\sum _{\\begin{array}{c}  u  \\end{array}}^{\\rm{B}}\\rm{P}_{\\unicode[Times]{x3BC} \\unicode[Times]{x3BD} }\\ \\rm{S}_{\\unicode[Times]{x3BC} \\unicode[Times]{x3BD} }\\] where \\(\\rm{P}_{\\unicode[Times]{x3BC}\\unicode[Times]{x3BD}}\\) and \\(\\rm{S}_{\\unicode[Times]{x3BC}\\unicode[Times]{x3BD}}\\) are respectively the elements of the density matrix and overlap matrix (see overlap integral). A large positive value of bond order signifies strong bonding between the atoms of the molecular entity, whereas negative values of \\(\\rm{q}_{\\rm{AB}}\\) imply that electrons are displaced away from the inter-atomic region and point to an anti-bonding interaction. In valence bond theory, bond order is given by a weighted average of the formal bond orders (i.e. by the number of electron pairs in a given Lewis structure) between the atoms in the resonance structures (see resonance hybrid)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond order" .

goldbook:BT07006 a skos:Concept ;
    skos:altLabel "BDE" ;
    skos:definition "For a diatomic molecule, the maximum vibrational energy that a molecule can have prior to its decomposition into the ground electronic states of the constituent atoms (spectroscopic bond-dissociation energy, \\(D_{\\rm{e}}\\)). The \\(D_{\\rm{e}}\\) value is related to the chemical dissociation energy: \\(D_{\\rm{0}}=D_{\\rm{e}}- \\mathrm{E}_{\\rm{vib}}\\left(0\\right)\\), where \\(\\mathrm{E}_{\\rm{vib}}\\left(0\\right)\\) is zero-point vibrational energy. This definition is usually extended to the dissociation of polyatomic molecules into certain molecular fragments through homolytic or heterolytic bond cleavages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bond-dissociation energy" .

goldbook:BT07007 a skos:Concept ;
    skos:definition "The molecular orbital whose occupation by electrons increases the total bonding (usually, lowers the total energy) of a molecule. Generally, the energy level of a bonding MO lies lower than the average of the valence orbitals of the atoms constituting the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bonding molecular orbital" .

goldbook:BT07008 a skos:Concept ;
    skos:altLabel "BO",
        "BO approximation" ;
    skos:definition "Representation of the complete wavefunction as a product of an electronic and a nuclear part, \\[\\Psi \\left(\\rm{r,R}\\right)=\\Psi _{\\rm{e}}\\left(\\rm{r,R}\\right)\\ \\Psi _{\\rm{N}}\\left(\\rm{R}\\right)\\] where the two wave-functions may be determined separately by solving two different Schroedinger equations. The validity of the Born–Oppenheimer approximation is founded on the fact that the ratio of electronic to nuclear mass (\\(\\frac{m}{M}\\cong 5\\times 10^{-4}\\)) is sufficiently small and the nuclei, as compared to the rapidly moving electrons, appear to be fixed. The approximation breaks down near a point where two electronic states acquire the same energy (see Jahn–Teller effect). The BO approximation is often considered as being synonymous with the adiabatic approximation. More precisely, the latter term denotes the case when \\(\\Psi _{\\rm{e}}\\) diagonalize the electronic Hamiltonian. Thus, the adiabatic approximation is an application of the BO approximation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Born–Oppenheimer approximation" .

goldbook:BT07169 a skos:Concept ;
    skos:definition "Polymer susceptible to degradation by biological activity, with the degradation accompanied by a lowering of its molar mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "biodegradable polymer" .

goldbook:BT07330 a skos:Concept ;
    skos:altLabel "BP",
        "BP mechanism" ;
    skos:definition "Volume-conserving mechanism proposed for the photoisomerization of conjugated double bonds. Two alternating double bonds rotate concertedly with only the two $\\ce{CH}$ units turning in and out of the plane of the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bicycle-pedal mechanism" .

goldbook:BT07331 a skos:Concept ;
    skos:definition "Photochemical rearrangement of unsaturated substrates by group migration over a $\\ce{\\uppi\\! perimeter}$ following the movement of a bicycle pedal. An example is:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bicycle rearrangement" .

goldbook:BT07334 a skos:Concept ;
    skos:definition "Bound pairs of polarons mutually attracted by the lattice distortion in a solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bipolarons" .

goldbook:BT07335 a skos:Concept ;
    skos:definition "At a conical intersection point, the plane spanned by the gradient difference vector (\\(\\boldsymbol{x_{1}}\\)) and the gradient of the interstate coupling vector (\\(\\boldsymbol{x_{2}}\\)): \\[x_{1} = \\frac{\\delta(E_{2}-E_{1})}{\\delta Q}\\boldsymbol{q}\\] \\[x_{2} = \\boldsymbol{q}\\] where \\(\\boldsymbol{C_{1}}\\) and \\(\\boldsymbol{C_{2}}\\) are the configuration interaction eigenvectors (i.e., the excited and ground-state adiabatic wavefunctions) in a conical intersection problem, \\(H\\) is the conical intersection Hamiltonian, \\(\\textbf{Q}\\) represents the nuclear configuration vector of the system, and thus \\(\\textbf{q}\\) is a unit vector in the direction of vector \\(\\textbf{q}\\). \\(E_{1}\\) and \\(E_{2}\\) are the energies of the lower and upper states, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "branching plane" .

goldbook:BT07336 a skos:Concept ;
    skos:definition "When an unpolarized planar electromagnetic wavefront impinges on a flat dielectric surface, there is a unique angle (\\(\\theta_{\\rm{B}}\\)), commonly referred to as Brewster angle, at which the reflected waves are all polarized into a single plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Brewster angle" .

goldbook:BT07337 a skos:Concept ;
    skos:definition "Obsolete term. This term is reserved for non-quantitative reference to physiological perception of light and is not recommended as a quantitative measure of the radiance of an emitting device, e.g., a lamp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brightness" .

goldbook:BT07338 a skos:Concept ;
    skos:definition "Product of the fluorescence quantum yield (\\(\\varPhi _{\\rm{f}}\\)) of a dye and the molar decadic absorption coefficient at the excitation wavelength, \\(\\varepsilon\\left(\\lambda \\right)\\), i.e., \\(\\varPhi _{\\rm{f}}\\ \\varepsilon\\left(\\lambda \\right)\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "brightness" .

goldbook:BT07564 a skos:Concept ;
    skos:altLabel "bimodal polymer network" ;
    skos:definition "Polymer network comprising polymer chains having two significantly different molar-mass distributions between adjacent junction points." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "bimodal network" .

goldbook:C00769 a skos:Concept ;
    skos:definition "An aggregate of molecules, generally in the condensed phase, that surrounds the fragments formed, for example, by thermal or photochemical dissociation. Because the cage hinders the separation of the fragments by diffusion, they may preferentially react with one another ('cage effect') but not necessarily to reform the precursor species. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cage" .

goldbook:C00770 a skos:Concept ;
    skos:definition "A polycyclic compound having the shape of a cage. The term is also used for inclusion compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cage compound" .

goldbook:C00771 a skos:Concept ;
    skos:definition "When in a condensed phase, or in a dense gas, reactant molecules come together, or species are formed in proximity to one another, and are caged in by surrounding molecules, they may undergo a set of collisions known as an encounter; the term 'cage effect' is then applied.The cage effect is also known as the Franck–Rabinowitch effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cage effect" .

goldbook:C00773 a skos:Concept ;
    skos:definition "Heating to high temperatures in air or oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calcination" .

goldbook:C00774 a skos:Concept ;
    skos:definition "A petroleum coke or coal-derived pitch coke obtained by heat treatment of green coke to about \\(1600\\ \\rm{K}\\). It will normally have a hydrogen content of less than \\(0.1\\ \\rm{wt.}\\%\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calcined coke" .

goldbook:C00775 a skos:Concept ;
    skos:definition "The set of operations which establish, under specified conditions, the relationship between values indicated by the analytical instrument and the corresponding known values of an analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration" .

goldbook:C00776 a skos:Concept ;
    skos:definition "A component of a calibration mixture, present in the gaseous or vapour state, quantitatively and qualitatively defined, and used directly for testing and for calibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration component" .

goldbook:C00778 a skos:Concept ;
    skos:definition "The functional (not statistical) relationship for the chemical measurement process, relating the expected value of the observed (gross) signal or response variable \\(E(y)\\) to the analyte amount \\(x\\). The corresponding graphical display for a single analyte is referred to as the calibration curve. When extended to additional variables or analytes which occur in multicomponent analysis, the 'curve' becomes a calibration surface or hypersurface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration function" .

goldbook:C00779 a skos:Concept ;
    skos:definition "A gas mixture of known composition, generally comprising one or more calibration components and a complementary gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration gas mixture" .

goldbook:C00780 a skos:Concept ;
    skos:definition "A material of known composition or properties which can be presented to the analytical instrument for calibration purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration material" .

goldbook:C00781 a skos:Concept ;
    skos:definition "A gaseous or liquid mixture of known composition, generally comprising one or more calibration components and an inert diluent, used directly for testing and calibration of analytical instruments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration mixture" .

goldbook:C00782 a skos:Concept ;
    skos:definition "The test portion or test solution used for calibration of an analytical procedure. The calibration sample is normally of known weight or volume and is prepared according to specifications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calibration sample" .

goldbook:C00783 a skos:Concept ;
    skos:definition "Originally macrocyclic compounds capable of assuming a basket (or 'calix') shaped conformation. They are formed from p-hydrocarbyl phenols and formaldehyde. The term now applies to a variety of derivatives by substitution of the hydrocarbon cyclo{oligo[(1,3-phenylene)methylene]}." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calixarenes" .

goldbook:C00784 a skos:Concept ;
    skos:definition "Non-SI unit of energy. There are three differently defined calories: thermochemical calorie (\\(\\rm{cal}_{\\rm{th}} = 4.184\\ \\rm{J}\\)), international steam table calorie (\\(\\rm{cal}_{\\rm{IT}} = 4.1868\\ \\rm{J}\\)), \\(15\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\) calorie (\\(\\rm{cal}_{15} = 4.1855\\ \\rm{J}\\)), however only the symbol \\(\\rm{cal}\\) is usually used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calorie" .

goldbook:C00785 a skos:Concept ;
    skos:definition "A titration performed in a calorimeter which produces a plot of heat change versus volume of titrant. This is the preferred term for experiments in which the main goal is the measurement of thermodynamic parameters. Because such experiments may be performed in any of a variety of types of calorimeters with varying degrees of calorimetric accuracy, it is important that the reporting of such results include an assessment of accuracy and precision. The term stands in contrast to the main emphasis in enthalpimetric analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calorimetric titration" .

goldbook:C00786 a skos:Concept ;
    skos:definition "A general term describing any experiment in which heat is measured as some chemical reaction or physical process occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "calorimetry" .

goldbook:C00789 a skos:Concept ;
    skos:definition "The rate constant for a system in which the reactants are in thermal equilibrium at a given temperature. In statistical mechanics the expression 'canonical ensemble' is used to refer to a closed system in thermal equilibrium, the species being present in a statistical distribution. By contrast, a microcanonical ensemble is composed of systems all having the same energy: a canonical ensemble therefore consists of a statistical distribution of microcanonical ensembles. The canonical or thermal rate constant can be obtained from the microcanonical rate constant by summing over the energy, taking into account the statistical distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "canonical rate constant" .

goldbook:C00790 a skos:Concept ;
    skos:altLabel "CVTST" ;
    skos:definition "A development of transition-state theory in which the position of the dividing surface is varied so as to minimize the rate constant at a given temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "canonical variational transition-state theory" .

goldbook:C00791 a skos:Concept ;
    skos:altLabel "electric capacitance" ;
    skos:definition "The charge on a plate divided by the potential difference between the plates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capacitance" .

goldbook:C00792 a skos:Concept ;
    skos:definition "Hygrometer using the capacitance variations of a capacitor whose dielectric medium consists of the gas or of a material in contact with this gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capacitance hygrometer" .

goldbook:C00793 a skos:Concept ;
    skos:definition "A general term for columns having a small diameter. A capillary column may contain a packing or have the stationary phase supported on its inside wall. The former case corresponds to packed capillary column while the latter case corresponds to an open-tabular column. Due to the ambiguity of this term its use without an adjective is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary column" .

goldbook:C00794 a skos:Concept ;
    skos:definition "Capillary condensation is said to occur when, in porous solids, multilayer adsorption from a vapour proceeds to the point at which pore spaces are filled with liquid separated from the gas phase by menisci. The concept loses its sense when the dimensions of the pores are so small that the term meniscus ceases to have a physical significance. Capillary condensation is often accompanied by hysteresis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capillary condensation" .

goldbook:C00795 a skos:Concept ;
    skos:definition "Effect on the stability of a carbon-centred radical determined by the combined action of a captor (electron withdrawing) and a dative (electron releasing) substituent, both attached to the radical centre. The term is also used for certain unsaturated compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "captodative effect" .

goldbook:C00796 a skos:Concept ;
    skos:definition "A process in which an atomic or nuclear system acquires an additional particle. In general, a specification is added of the type of the captured particle or its energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capture" .

goldbook:C00798 a skos:Concept ;
    skos:definition "The cross-section for capture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capture cross-section" .

goldbook:C00800 a skos:Concept ;
    skos:definition "The γ-radiation emitted in radiative capture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "capture γ-radiation" .

goldbook:C00802 a skos:Concept ;
    skos:altLabel "carboranes" ;
    skos:definition "A class of boron compound of general formula $\\ce{[(CH)_{a}(BH)_{m}H_{b}]^{c}}$ where $c$ can be positive, negative or zero. The $\\ce{CH}$ groups occupy polyhedron vertices, and other hydrogen atoms are either bridging or terminal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbaboranes" .

goldbook:C00803 a skos:Concept ;
    skos:definition "Salts or esters of carbamic acid, $\\ce{H2NC(=O)OH}$, or of $N$-substituted carbamic acids $\\ce{R2NC(=O)OR'}$, ($\\ce{R'}$ = hydrocarbyl or a cation). The esters are often called urethanes or urethans, a usage that is strictly correct only for the ethyl esters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbamates" .

goldbook:C00804 a skos:Concept ;
    skos:definition "Generic name for anions containing an even number of electrons and having an unshared pair of electrons on a tervalent carbon atom (e.g. $\\ce{Cl3C^{−}}$ or $\\ce{HC#C^{−}}$) or — if the ion is mesomeric (see mesomerism) — having at least one significant contributing structure with an unshared pair of electrons on a tervalent carbon atom, for example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbanion" .

goldbook:C00806 a skos:Concept ;
    skos:definition "The electrically neutral species $\\ce{H2C{:}}$ (methylene) and its derivatives, in which the carbon is covalently bonded to two univalent groups of any kind or a divalent group and bears two nonbonding electrons, which may be spin-paired (singlet state) or spin-non-paired (triplet state). In systematic name formation, carbene is the name of the parent hydride $\\ce{C{:}H2}$ hence, the name dichlorocarbene for $\\ce{C{:}Cl2}$. However, names for acyclic and cyclic hydrocarbons containing one or more divalent carbon atoms are derived from the name of the corresponding all-\\(\\lambda ^{4}\\)-hydrocarbon using the suffix -ylidene. E.g. prop-2-en-1-ylidene, $\\ce{H2C=CHCH{:}}$ ethenylidene, $\\ce{H2C=C{:}}$; cyclohexylidene,Subclasses of carbenes include acyl carbenes , imidoyl carbenes,  and vinyl carbenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbenes" .

goldbook:C00807 a skos:Concept ;
    skos:definition "The electrically neutral mononuclear hydrides of group 14 having two non-bonding electrons, the electrically neutral mononuclear hydrides of group 15 having four non-bonding electrons, and also the compound $\\ce{HB{:}}$ . The names of a number of these are shown below.  $\\ce{RB{:}}$boranylidenes$\\ce{RAs{:}}$arsanylidenes $\\ce{RN{:}}$nitrenes$\\ce{R2Sn{:}}$stannylidenes $\\ce{R2Si{:}}$silylenes$\\ce{RSb{:}}$stibanylidenes $\\ce{RP{:}}$phosphanylidenes$\\ce{R2Pb{:}}$plumbylidenes $\\ce{R2Ge{:}}$germylidenes  Note that if $\\ce{R} = \\ce{H}$, these compounds are parent hydrides; derivatives formed by substitution are named accordingly. However, if the substituent's first atom, bearing the free valence, is of the same element as the atom of the carbene analogue, other parent compounds may be required (see carbenes), e.g. $\\ce{HN{:}}$ nitrene; $\\ce{CH3N{:}}$ methylnitrene; $\\ce{H2NN{:}}$ diazanylidene (synonym isodiazene, not aminonitrene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbene analogues" .

goldbook:C00809 a skos:Concept ;
    skos:definition "Species $\\ce{R2C^{_{\\vdots}−}}$, having three non-bonding electrons, formally derived by addition of an electron to a carbene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbene radical anions" .

goldbook:C00810 a skos:Concept ;
    skos:definition "Species $\\ce{R2C^{.+}}$ having one non-bonding electron, formally derived by subtraction of an electron from a carbene, e.g. $\\ce{H2C^{.+}}$ methyliumyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbene radical cations" .

goldbook:C00811 a skos:Concept ;
    skos:definition "The three-coordinate carbon atom in a carbenium ion to which the excess positive charge of the ion (other than that located on heteroatoms) may be formally considered to be largely attributed, i.e. which has one vacant p-orbital. (N.B. It is not always possible to uniquely identify such an atom.) This formal attribution of charge often does not express the real charge distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbenium centre" .

goldbook:C00812 a skos:Concept ;
    skos:definition "A generic name for carbocations, real or hypothetical, that have at least one important contributing structure containing a tervalent carbon atom with a vacant p-orbital. (The name implies a protonated carbene or a substitution derivative thereof.) The term was proposed (and rejected) as a replacement for the traditional usage of the name carbonium ion. To avoid ambiguity, the name should not be used as the root for the systematic nomenclature of carbocations. The corresponding difficulty confused carbonium ion nomenclature for many years. For example, the term 'ethylcarbonium ion' has at times been used to refer either to $\\ce{CH3CH2^{+}}$ (ethyl cation) or (correctly) to $\\ce{CH3CH2CH2^{+}}$ (propyl cation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbenium ion" .

goldbook:C00813 a skos:Concept ;
    skos:definition "Complexed carbene-like entities that display the reactivity characteristics of carbenes, either directly or by acting as sources of carbenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbenoids" .

goldbook:C00817 a skos:Concept ;
    skos:definition "A cation containing an even number of electrons with a significant portion of the excess positive charge located on one or more carbon atoms. This is a general term embracing carbenium ions, all types of carbonium ions vinyl cations, etc. Carbocations may be named by adding the word 'cation' to the name of the corresponding radical. Such names do not imply structure (e.g. whether three-coordinated or five-coordinated carbon atoms are present)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbocation" .

goldbook:C00818 a skos:Concept ;
    skos:definition "Cyclic compounds in which all of the ring members are carbon atoms, e.g. 1,2-dihydronaphthalene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbocyclic compounds" .

goldbook:C00819 a skos:Concept ;
    skos:definition "Carbodiimide, $\\ce{HN=C=NH}$, and its hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbodiimides" .

goldbook:C00820 a skos:Concept ;
    skos:definition "Originally, compounds such as aldoses and ketoses having the stoichiometric formula $\\ce{C_{n}(H2O)_{n}}$ hence 'hydrates of carbon'. The generic term carbohydrate includes monosaccharides, oligosaccharides and polysaccharides as well as substances derived from monosaccharides by reduction of the carbonyl group (alditols), by oxidation of one or more terminal groups to carboxylic acids, or by replacement of one or more hydroxy group(s) by a hydrogen atom, an amino group, thiol group or similar groups. It also includes derivatives of these compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbohydrates" .

goldbook:C00821 a skos:Concept ;
    skos:definition "Element number 6 of the periodic table of elements (electronic ground state \\(1\\rm{s}^{2}2\\rm{s}^{2}2\\rm{p}^{2}\\)). For a description of the various types of carbon as a solid the term carbon should be used only in combination with an additional noun or a clarifying adjective." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon" .

goldbook:C00822 a skos:Concept ;
    skos:definition "A liquid-crystalline state of pitch which shows the optical birefringence of disc-like (discotic) nematic liquid crystals. It can be formed as an intermediate phase during thermolysis (pyrolysis) of an isotropic molten pitch or by precipitation from pitch fractions prepared by selective extraction. Generally, the spherical mesophase precipitated from a pyrolysing pitch has the Brooks and Taylor structure. With continuous heat treatment the carbonaceous mesophase coalesces to a state of bulk mesophase before solidification to green coke with further loss of hydrogen or low-molecular-weight compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonaceous mesophase" .

goldbook:C00823 a skos:Concept ;
    skos:definition "An 'artificially produced' solid body which consists mainly of carbonaceous material in a distinct shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon artifact" .

goldbook:C00825 a skos:Concept ;
    skos:definition "A carbon fibre-reinforced carbon matrix material. The carbon matrix phase is typically formed by solid, liquid or gaseous pyrolysis of an organic precursor material. The matrix is either a graphitizable carbon or non-graphitizable carbon, and the carbonaceous reinforcement is fibrous in form. The composite may also contain other components in particulate or fibrous forms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon–carbon composite" .

goldbook:C00826 a skos:Concept ;
    skos:definition "Porous or hollow carbonaceous sphere-like particles (frequently in the size range of a few to several hundreds of µm diameter) formed during pyrolysis, also in the course of combustion, of carbonaceous liquid droplets (e.g. heavy fuel) or solid particles (e.g. coal)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon cenospheres" .

goldbook:C00827 a skos:Concept ;
    skos:definition "A textile material consisting of carbon fibres oriented at least in two directions. Carbon cloth is not necessarily woven." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon cloth" .

goldbook:C00828 a skos:Concept ;
    skos:altLabel "CO<sub>2</sub> laser" ;
    skos:definition "A continuous or pulsed source of coherent radiation normally tunable through the $\\ce{CO2}$ vibration–rotation band centred near \\(10.6\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon dioxide laser" .

goldbook:C00829 a skos:Concept ;
    skos:definition "An electrode for an electrical application. In its green state it comprises granular carbon material bound with pitch. The granular carbon material may be either needle coke, fine-grained or isotropic coke or reclaimed graphite powder. Electrodes for use in steel production can only be manufactured from needle coke, and the green electrodes are fired at temperatures above around \\(2800\\ \\rm{K}\\) to produce highly graphite electrodes. The other granular carbon materials may be used for aluminium electrodes where the duty is not so severe, and the green electrodes are generally fired to lower temperatures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon electrode" .

goldbook:C00830 a skos:Concept ;
    skos:definition "A textile material consisting of, in approximation, randomly oriented and intertwined carbon fibres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon felt" .

goldbook:C00831 a skos:Concept ;
    skos:definition "Fibres (filaments, tows, yarns, rovings) consisting of at least $\\pu{92\\%}$ (mass fraction) carbon, usually in the non-graphitic state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibre" .

goldbook:C00832 a skos:Concept ;
    skos:definition "Woven textile materials made of carbon fibres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibre fabrics" .

goldbook:C00833 a skos:Concept ;
    skos:definition "Carbon fibres type HM (high modulus) are carbon fibres with a value of Young's modulus (tensile modulus) larger than \\(300\\ \\rm{GPa}\\) (nearly $\\pu{30\\%}$ of the \\(C_{11}\\) elastic constant of a graphite single crystal)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibres type HM" .

goldbook:C00834 a skos:Concept ;
    skos:altLabel "HT" ;
    skos:definition "Carbon fibres type HT are carbon fibres with values of Young's modulus between \\(150\\) and \\(275\\) to \\(300\\ \\rm{GPa}\\). The term HT, referring to high tensile strength, was early applied because fibres of this type display the highest tensile strengths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibres type HT" .

goldbook:C00835 a skos:Concept ;
    skos:altLabel "IM" ;
    skos:definition "Carbon fibres type IM (intermediate modulus) are related to carbon fibres type HT because of the comparable values of tensile strength, but are characterized by greater stiffness (Young's modulus up to approximately $\\pu{35\\%}$ of the theoretical \\(C_{11}\\) value)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibres type IM" .

goldbook:C00836 a skos:Concept ;
    skos:altLabel "LM" ;
    skos:definition "Carbon fibres type LM (low modulus) are carbon fibres with isotropic structure, tensile modulus values as low as $\\pu{10\\%}$ of the \\(C_{11}\\) values of the graphite single crystal, and low strength values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibres type LM" .

goldbook:C00837 a skos:Concept ;
    skos:altLabel "UHM" ;
    skos:definition "Carbon fibres type UHM (ultra-high modulus) designates a class of carbon fibres having very high values of Young's modulus larger than \\(600\\ \\rm{GPa}\\) (i.e. greater than $\\pu{55\\%}$ of the theoretical \\(C_{11}\\) value of graphite)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon fibres type UHM" .

goldbook:C00838 a skos:Concept ;
    skos:definition "In systematic nomenclature, the suffix -carbonitrile is used to name compounds $\\ce{RC#N}$ where the suffix includes the carbon atom of the $\\ce{–CN}$. However, carbonitrile is not a class name for nitriles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonitriles" .

goldbook:C00839 a skos:Concept ;
    skos:definition "The term should be used with great care since several incompatible meanings are currently in use. It is not acceptable as the root for systematic nomenclature for carbocation.In most of the existing literature the term is used in its traditional sense for what is here defined as carbenium ion.A carbocation, real or hypothetical, that contains at least one five-coordinate carbon atom.A carbocation, real or hypothetical, whose structure cannot adequately be described by two-electron two-centre bonds only. (The structure may involve carbon atoms with a coordination number greater than five.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonium ion" .

goldbook:C00840 a skos:Concept ;
    skos:definition "A process by which solid residues with increasing content of the element carbon are formed from organic material usually by pyrolysis in an inert atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonization" .

goldbook:C00841 a skos:Concept ;
    skos:definition "A solid high in content of the element carbon and structurally in a non-graphitic state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon material" .

goldbook:C00842 a skos:Concept ;
    skos:definition "A mixture of filler coke, e.g. grains and/or powders of solid carbon materials and a carbonaceous binder and selected additives, prepared in heated mixers at temperatures in the range of \\(410{-}445\\ \\rm{K}\\) as a preliminary step for the formation of shaped green bodies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon mix" .

goldbook:C00844 a skos:Concept ;
    skos:definition "Compounds containing the carbonyl group, $\\ce{C=O}$. The term is commonly used in the restricted sense of aldehydes and ketones, although it actually includes carboxylic acids and derivatives.Metal carbonyls, in which carbon monoxide is a formal ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonyl compounds" .

goldbook:C00845 a skos:Concept ;
    skos:definition "1,3-dipolar compounds having the structure:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonyl imides" .

goldbook:C00847 a skos:Concept ;
    skos:altLabel "peroxo compounds" ;
    skos:definition "1,3 dipolar compounds having the structure  Also called peroxo compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonyl oxides" .

goldbook:C00848 a skos:Concept ;
    skos:definition "1,3-Dipolar compounds having the structure" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbonyl ylides" .

goldbook:C00850 a skos:Concept ;
    skos:definition "Amides of carboxylic acids, having the structure $\\ce{RC(=O)NR2}$. The term is used as a suffix in systematic name formation to denote the $\\ce{–C(=O)NH2}$ group including its carbon atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carboxamides" .

goldbook:C00851 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC(=NR)NR2}$. The term is used as a suffix in systematic nomenclature to denote the $\\ce{–C(=NH)NH2}$ group including its carbon atom, e.g. acetamidine, $\\ce{CH3C(=NH)NH2}$; 2-butyl-4,5-dihydroimidazole:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carboxamidines" .

goldbook:C00852 a skos:Concept ;
    skos:definition "Oxoacids having the structure $\\ce{RC(=O)OH}$. The term is used as a suffix in systematic name formation to denote the $\\ce{–C(=O)OH}$ group including its carbon atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carboxylic acids" .

goldbook:C00854 a skos:Concept ;
    skos:definition "The neutral species $\\ce{HC_{^\\vdots}}$ (methylidyne) and its derivatives formed by substitution in which a univalent carbon atom is covalently bonded to one group and also bears three nonbonding electrons. (This term carries no implication about spin-pairing)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbynes" .

goldbook:C00856 a skos:Concept ;
    skos:definition "The cationic species $\\ce{H2C^{.+}}$ or substitution derivatives thereof, formally derived by adding a hydron to a carbyne or subtracting an electron from a carbene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbynium ions" .

goldbook:C00857 a skos:Concept ;
    skos:definition "Hydrocarbon carotenoids (a subclass of tetraterpenes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carotenes" .

goldbook:C00858 a skos:Concept ;
    skos:definition "Tetraterpenoids ($\\ce{C40}$), formally derived from the acyclic parent, $\\ce{\\uppsi\\!,\\!\\uppsi\\!-carotene}$ I by hydrogenation, dehydrogenation, cyclization, oxidation, or combination of these processes. This class includes carotenes, xanthophylls and certain compounds that arise from rearrangement of the skeleton of I or by loss of part of this structure. retinoids are excluded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carotenoids" .

goldbook:C00859 a skos:Concept ;
    skos:definition "A substance in appreciable amount which, when associated with a trace of a specified substance, will carry the trace with it through a chemical or physical process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier" .

goldbook:C00860 a skos:Concept ;
    skos:definition "A substance in appreciable amount which, when associated with a tracer of a specified substance, will carry the tracer with it through a chemical or physical process, or prevent the tracer from undergoing nonspecific processes due to its low concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier" .

goldbook:C00861 a skos:Concept ;
    skos:definition "A participant atom which is neither core nor peripheral and which carries other groups to and from the molecule containing the core atom(s) but which does not itself become covalently attached to that molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier atom" .

goldbook:C00863 a skos:Concept ;
    skos:definition "A gas introduced in order to transport a sample for analytical purposes. In gas chromatography it is the gas which is passed continuously through the column and whose passage promotes the elution of the components of the sample. The carrier gas together with the portions of the sample present in this phase constitutes the mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier gas" .

goldbook:C00866 a skos:Concept ;
    skos:definition "A process by which materials are carried into a reaction mixture to which they do not belong. These materials can be either parts of a specimen, or reagents including the diluent or wash solution. In such cases, carry-over means the transfer of material (specimen or reagents) from one container, or from one reaction mixture, to another one. It can be either unidirectional or bidirectional in a series of specimens or assays. The term carry-over effect is used for carry-over from specimen to specimen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carry-over" .

goldbook:C00869 a skos:Concept ;
    skos:definition "An instrument used for the classification of aerosols according to size and for possible subsequent chemical analysis. Air is drawn through a series of orifices of decreasing size; the air flow is normal to collecting surfaces on which aerosols are collected by inertial impaction. The particles, separated stepwise by their momentum differences into a number of size ranges, are collected simultaneously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cascade impactor" .

goldbook:C00870 a skos:Concept ;
    skos:definition "Reactions involving the oxidation of organic substrates to provide chemically available energy (e.g. ATP) and to generate metabolic intermediates.Generally, the process of breakdown of complex molecules into simpler ones, often providing biologically available energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catabolism" .

goldbook:C00871 a skos:Concept ;
    skos:definition "A decrease in the activity of certain auxiliary catabolic enzymes when a surplus of an (easily metabolizable) substrate is available. Commonly this effect is caused by glucose (glucose repression) or by metabolites produced from glucose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catabolite repression" .

goldbook:C00872 a skos:Concept ;
    skos:definition "A titration process, which involves a catalyst, where the end-point is detected by the sudden increase or decrease of the rate of a reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalymetric titration" .

goldbook:C00873 a skos:Concept ;
    skos:definition "The observed rate of reaction, \\(\\xi \\), minus the spontaneous rate of reaction, \\(\\xi _{0}\\), observed under otherwise similar conditions in the absence of added catalytic material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalysed rate of reaction" .

goldbook:C00874 a skos:Concept ;
    skos:definition "The action of a catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalysis" .

goldbook:C00876 a skos:Concept ;
    skos:altLabel "accelerator",
        "kinetic synergist",
        "surface catalysis" ;
    skos:definition "A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction; the process is called catalysis. The catalyst is both a reactant and product of the reaction. The words catalyst and catalysis should not be used when the added substance reduces the rate of reaction (see inhibitor). Catalysis can be classified as 'homogeneous catalysis', in which only one phase is involved, and 'heterogeneous catalysis', in which the reaction occurs at or near an interface between phases. Catalysis brought about by one of the products of a reaction is called autocatalysis. Catalysis brought about by a group on a reactant molecule itself is called intramolecular catalysis. The term catalysis is also often used when the substance is consumed in the reaction (for example: base-catalysed hydrolysis of esters). Strictly, such a substance should be called an activator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst" .

goldbook:C00877 a skos:Concept ;
    skos:definition "A substance included in the solvent to increase the rate of transfer without affecting the position of equilibrium. The term accelerator may also be used but kinetic synergist is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst" .

goldbook:C00878 a skos:Concept ;
    skos:definition "Catalyst deactivation resulting from changes in the structure or in the texture of the catalyst. Changes of this kind are usually irreversible and the catalyst cannot be regenerated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst ageing" .

goldbook:C00880 a skos:Concept ;
    skos:altLabel "catalyst deactivation" ;
    skos:definition "The conversion in a catalytic reaction performed under constant conditions of reaction often decreases with time of run or time on stream. This phenomenon is called catalyst deactivation or catalyst decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalyst decay" .

goldbook:C00881 a skos:Concept ;
    skos:altLabel "enzyme activity" ;
    skos:definition "Increase in the rate of reaction of a specified chemical reaction that an enzyme produces in a specific assay system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic activity" .

goldbook:C00882 a skos:Concept ;
    skos:altLabel "catalytic concentration" ;
    skos:definition "Catalytic activity of the component divided by the volume of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic activity concentration" .

goldbook:C00883 a skos:Concept ;
    skos:altLabel "catalytic content" ;
    skos:definition "Catalytic activity of the component divided by the mass of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic activity content" .

goldbook:C00884 a skos:Concept ;
    skos:altLabel "catalytic fraction" ;
    skos:definition "Quotient of the catalytic activity of the isozyme and the catalytic activity of all the isozymes of the same enzyme in the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic activity fraction" .

goldbook:C00885 a skos:Concept ;
    skos:definition "If the rate of reaction, \\( u\\), is expressible in the form: \\[ u = (k_{0}+\\sum _{\\begin{array}{c}  i  \\end{array}}k_{i}\\ [C_{i}]^{n_{i}})\\ [A]^{\\alpha }\\ [B]^{\\beta }\\ ...\\] where $\\ce{A}$, $\\ce{B}$, ... are reactants and \\(C_{i}\\) represents one of a set of catalysts, then the proportionality factor \\(k_{i}\\) is the catalytic coefficient of the particular catalyst \\(C_{i}\\). Normally the partial order of reaction \\(n_{i}\\) with respect to a catalyst is unity, so that \\(k_{i}\\) is an \\(\\left ( \\mathit{\\alpha } + \\mathit{\\beta } + ... + 1 \\right )\\)th order rate coefficient. The proportionality factor \\(k_{0}\\) is the \\(\\left ( \\mathit{\\alpha } + \\mathit{\\beta } + ...\\right )\\)th order rate coefficient of the uncatalysed component of the total reaction. For example, if there is catalysis by hydrogen and hydroxide ions, and the order of reaction can be expressed in the form: \\[k = k_{0}+k_{\\rm{H}^{+}}\\ [\\rm{H}^{+}]+k_{\\rm{OH}^{-}}\\ [\\rm{OH}^{-}]\\] then \\(k_{H^{+}}\\) and \\(k_{\\rm{OH}^{-}}\\) are the catalytic coefficients for $\\ce{H^{+}}$ and $\\ce{OH^{-}}$, respectively. The constant \\(k_{0}\\) relates to the uncatalysed reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic coefficient" .

goldbook:C00889 a skos:Concept ;
    skos:definition "The faradaic current that is obtained with a solution containing two substances B and A may exceed the sum of the faradaic currents that would be obtained with B and A separately, but at the same concentrations and under the same experimental conditions. In either of the two following situations the increase is termed a catalytic current. B is reduced or oxidized at the electrode-solution interface to give a product B' that then reduces or oxidizes A chemically. The reaction of B with A may yield either B or an intermediate in the overall half-reaction by which B' was obtained from B. In this situation the increase of current that results from the addition of A to a solution of B may be termed a regeneration current. The presence at the electrode-solution interface of one substance, which may be either A or the product A' of its reduction or oxidation, decreases the over-potential for the reduction or oxidation of B. In either case the magnitude of the catalytic current depends on the applied potential. If the current observed with a mixture of A and B is smaller than the sum of the separate currents, the term non-additive current should be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic current" .

goldbook:C00891 a skos:Concept ;
    skos:definition "A reaction in which an alkane is converted into an aromatic hydrocarbon and hydrogen. For example," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic dehydrocyclization" .

goldbook:C00894 a skos:Concept ;
    skos:definition "The transformation of non-graphitic carbon into graphite by heat treatment in the presence of certain metals or minerals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic graphitization" .

goldbook:C00895 a skos:Concept ;
    skos:definition "A process similar to catalytic cracking in its industrial purpose but effected under hydrogen pressure and on a catalyst containing an ingredient with a hydrogenating function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic hydrocracking" .

goldbook:C00896 a skos:Concept ;
    skos:definition "A process in which, in the presence of hydrogen, sulfur is removed as hydrogen sulfide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic hydrodesulfurization" .

goldbook:C00897 a skos:Concept ;
    skos:definition "Ordinarily, a reaction in which $\\ce{A + H2}$ gives $\\ce{B}$.   For example,    The term may also be used for cleavage of bonds other than $\\ce{A}$, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic hydrogenolysis" .

goldbook:C00898 a skos:Concept ;
    skos:definition "A process for removing carbon monoxide from gas streams or for producing methane by the reaction" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic methanation" .

goldbook:C00899 a skos:Concept ;
    skos:definition "A process for increasing the octane number of naphthas. It involves isomerization of alkanes, dehydrogenation of cyclohexanes to aromatic hydrocarbons, isomerization and dehydrogenation of alkylcyclopentanes, and dehydrocyclization of alkanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalytic reforming" .

goldbook:C00902 a skos:Concept ;
    skos:definition "4-(2-Aminoethyl)pyrocatechol [4-(2-aminoethyl)benzene-1,2-diol] and derivatives formed by substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catecholamines" .

goldbook:C00903 a skos:Concept ;
    skos:definition "An affix used in inorganic nomenclature to denote a chain structure; often used to designate linear polymeric substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>catena</i>-" .

goldbook:C00904 a skos:Concept ;
    skos:altLabel "catena compounds" ;
    skos:definition "Hydrocarbons having two or more rings connected in the manner of links of a chain, without a covalent bond. More generally, the class catena compounds embraces functional derivatives and hetero analogues, e.g:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catenanes" .

goldbook:C00906 a skos:Concept ;
    skos:definition "For a reaction with a single rate-determining step \\[\\frac{\\alpha _{\\rm{c}}}{ u } = -\\frac{R\\ T}{n\\ F}\\ (\\frac{\\partial (\\ln (|I_{\\rm{c}}|))}{\\partial E})_{T,p,c_{i},...}\\] where \\(\\alpha _{\\rm{c}}\\) is the cathodic transfer coefficient (number), \\(R\\) is the gas constant, \\(T\\) is the thermodynamic temperature, and \\( u \\) the stoichiometric number giving the number of identical activated complexes formed and destroyed in the completion of the overall reaction as formulated with the transfer of \\(n\\) electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cathodic transfer coefficient" .

goldbook:C00907 a skos:Concept ;
    skos:definition "A monoatomic or polyatomic species having one or more elementary charges of the proton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cation" .

goldbook:C00908 a skos:Concept ;
    skos:definition "The process of exchanging cations between a solution and a cation exchanger." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cation exchange" .

goldbook:C00909 a skos:Concept ;
    skos:definition "Ion exchanger with cations as counter-ions. The term cation-exchange resin may be used in the case of solid organic polymers. The acid form of a cation exchanger is the ionic form of a cation exchanger in which counter-ions are hydrogen ions (H-form) or the ionogenic groups have added a proton forming an undissociated acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cation exchanger" .

goldbook:C00910 a skos:Concept ;
    skos:definition "An ionic polymerization in which the kinetic-chain carriers are cations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cationic polymerization" .

goldbook:C00914 a skos:Concept ;
    skos:definition "Compounds constrained by structure to having or accommodating a cavity large enough to host other molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cavitands" .

goldbook:C00915 a skos:Concept ;
    skos:definition "Periodic removal of coherent radiation from a laser cavity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cavity dumping" .

goldbook:C00917 a skos:Concept ;
    skos:definition "An automatic, recording instrument for reading the height of the cloud-base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceilometer" .

goldbook:C00918 a skos:Concept ;
    skos:definition "Defined as: \\[\\kappa _{\\rm{cell}} = \\kappa \\ R\\] where \\(R\\) is the measured resistance of the cell and \\(\\kappa \\) is the conductivity (formerly called the specific conductance)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell constant" .

goldbook:C00922 a skos:Concept ;
    skos:definition "The error which results if the incident beam does not fall perpendicularly to the windows of the cell, or if the cell windows are contaminated or have some other imperfection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell error" .

goldbook:C00928 a skos:Concept ;
    skos:definition "Thermodynamic temperature minus \\(273.15\\ \\rm{K}\\), invariably expressed in the SI unit degree Celsius (\\(\\pu{^{\\circ}C}\\)) which is equal to the kelvin. Sometimes the misnomer centigrade temperature is used for Celsius temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Celsius temperature" .

goldbook:C00930 a skos:Concept ;
    skos:definition "The atom in a coordination entity which binds other atoms or groups of atoms (ligands) to itself, thereby occupying a central position in the coordination entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "central atom" .

goldbook:C00931 a skos:Concept ;
    skos:definition "The centre of a Mössbauer spectrum is defined as the Doppler-velocity at which the resonance maximum is (or would be) observed when all magnetic dipole, electric quadrupole, etc. hyperfine interactions are (or would be) absent. The contribution of the second order Doppler shift (\\(\\delta _{\\rm{T}}\\)) should be indicated, if possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centre" .

goldbook:C00933 a skos:Concept ;
    skos:altLabel "centripetal acceleration" ;
    skos:definition "The acceleration of a component as a result of a uniform rotational motion. Centrifugal acceleration is a vector quantity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centrifugal acceleration" .

goldbook:C00934 a skos:Concept ;
    skos:definition "In a reaction without an electronic energy barrier, or its reverse, the rotational energy of the transition state gives rise to a reaction barrier, which is known as the centrifugal barrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centrifugal barrier" .

goldbook:C00936 a skos:Concept ;
    skos:definition "Fictitious force acting on a body as a result of centripetal acceleration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centrifugal force" .

goldbook:C00937 a skos:Concept ;
    skos:definition "The radius at which a component is spinning at the end of the period of centrifugation. For a component sedimented from a dilute suspension, it can be equated with radius of rotation at the bottom of the centrifuge tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "centrifugal radius" .

goldbook:C00938 a skos:Concept ;
    skos:altLabel "kephalins" ;
    skos:definition "Compounds derived from glycerol in which a primary and the secondary hydroxy groups are esterified with long-chain fatty acids, and the remaining primary one with the mono(2-aminoethyl) ester of phosphoric acid, or with the monoserine ester of phosphoric acid. The term is not recommended. These compounds are preferably designated as (3-phosphatidyl)ethanolamines and (3-phosphatidyl)serines respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cephalins" .

goldbook:C00939 a skos:Concept ;
    skos:definition "Cephems having the basic structure shown." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cephalosporins" .

goldbook:C00940 a skos:Concept ;
    skos:definition "Natural and synthetic antibiotics containing the 5-thia-1-azabicyclo[4.2.0]octan-8-one nucleus; generally assumed to have the 6R configuration, unless otherwise specified. The numbering used differs from that of the von Baeyer named bicyclic system. Where they differ, the von Baeyer numbering is shown in parentheses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cephams" .

goldbook:C00941 a skos:Concept ;
    skos:definition "2,3-Didehydrocephams: 5-thia-1-azabicyclo[4.2.0]oct-2-en-8-ones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cephems" .

goldbook:C00942 a skos:Concept ;
    skos:definition "A component of a stack sampling system which is suitable for high temperature use; also known as a ceramic thimble." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramic filter" .

goldbook:C00943 a skos:Concept ;
    skos:definition "A charged particle detector based on the Cerenkov effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cerenkov detector" .

goldbook:C00944 a skos:Concept ;
    skos:definition "Emission of radiation in the visible and ultraviolet spectrum arising when a charged particle crosses a medium with a velocity greater than that of light in the same medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cerenkov effect" .

goldbook:C00945 a skos:Concept ;
    skos:definition "Radiation resulting from the Cerenkov effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cerenkov radiation" .

goldbook:C00946 a skos:Concept ;
    skos:definition "The whole or part of a macromolecule, an oligomer molecule or a block, comprising a linear or branched sequence of constitutional units between two boundary constitutional units, each of which may be either an end-group, a branch point or an otherwise-designated characteristic feature of the macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain" .

goldbook:C00948 a skos:Concept ;
    skos:definition "When in a chain reaction there is a net increase in the number of chain carrier there is said to be chain branching. A simple example of a chain-propagating reaction leading to chain branching is:  in which there is one chain carrier (an oxygen atom) on the left and two chain carriers (a hydrogen atom and a hydroxyl radical) on the right." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain branching" .

goldbook:C00949 a skos:Concept ;
    skos:definition "A species, such as an atom or free radical, which is involved in chain-propagating reactions is known as a chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain carrier" .

goldbook:C00952 a skos:Concept ;
    skos:definition "The fraction of fissions giving rise to nuclei of a particular mass number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain fission yield" .

goldbook:C00955 a skos:Concept ;
    skos:definition "The process in a chain reaction that is responsible for the formation of a chain carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain initiation" .

goldbook:C00956 a skos:Concept ;
    skos:definition "In a chain reaction, the average number of times the closed cycle of reactions (involving the chain-propagating reactions) is repeated. It is equal to the rate of the overall reaction divided by the rate of the initiation reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain length" .

goldbook:C00958 a skos:Concept ;
    skos:definition "A chain reaction in which the growth of a polymer chain proceeds exclusively by reaction(s) between monomer(s) and reactive site(s) on the polymer chain with regeneration of the reactive site(s) at the end of each growth step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain polymerization" .

goldbook:C00959 a skos:Concept ;
    skos:altLabel "propagating reaction" ;
    skos:definition "A chain-propagating reaction, or more simply a propagating reaction, is an elementary step in a chain reaction in which one chain carrier is converted into another. The conversion can be a unimolecular reaction or a bimolecular reaction with a reactant molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain-propagating reaction" .

goldbook:C00960 a skos:Concept ;
    skos:definition "A reaction in which one or more reactive reaction intermediates (frequently radicals) are continuously regenerated, usually through a repetitive cycle of elementary steps (the 'propagation step'). For example, in the chlorination of methane by a radical mechanism, $\\ce{Cl^{.}}$ is continuously regenerated in the chain propagation steps:   In chain polymerization reactions, reactive intermediates of the same types, generated in successive steps or cycles of steps, differ in relative molecular mass, as in:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain reaction" .

goldbook:C00961 a skos:Concept ;
    skos:definition "A chemical reaction resulting in the breaking of skeletal bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain scission" .

goldbook:C00963 a skos:Concept ;
    skos:definition "The abstraction, by the radical end of a growing chain-polymer, of an atom from another molecule. The growth of the polymer chain is thereby terminated but a new radical, capable of chain propagation and polymerization, is simultaneously created. For the example of alkene polymerization cited for a chain reaction, the reaction:  represents a chain transfer, the radical $\\ce{Cl3C^{.}}$ inducing further polymerization:   The phenomenon occurs also in other chain reactions such as cationic polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain transfer" .

goldbook:C00964 a skos:Concept ;
    skos:definition "If carbon atoms 1, 2, 4 and 5 of cyclohexane occupy coplanar positions and when carbon atoms 3 and 6 are on opposite sides of the plane the conformation (of symmetry group $D_{\\rm{3d}}$) is called a chair form. The same term is applied to similar conformations of analogous saturated six-membered ring structures containing hetero-atoms and/or bearing substituent groups, but these conformations may be distorted from the exact $D_{\\rm{3d}}$ symmetry. For cyclohexane and most such analogues, the chair form is the most stable conformation. If the cyclohexane conformation has no centre of symmetry but possesses two planes of symmetry, one of them bisecting the bonds between atoms 1 and 2 and between 4 and 5 and the other plane passing through atoms 3 and 6 (which lie out of the plane and on the same side of the plane containing 1, 2, 4 and 5), that conformation (of symmetry group $C_{\\rm{2v}}$) is called a boat form and it is generally not a stable form. Again, this term is also applied to structural analogues. The conformation of $D_{2}$ symmetry passed through in the interconversion of two boat forms of cyclohexane is called the twist form (also known as skew boat, skew form and stretched form).  In a five-membered ring a conformation in which two adjacent atoms are maximally displaced, in opposite directions, relative to the plane containing the other three carbon atoms has been called a half-chair but is better called a twist conformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chair, boat, twist" .

goldbook:C00966 a skos:Concept ;
    skos:definition "1,3-Diphenylpropenone (benzylideneacetophenone), $\\ce{ArCH=CH(=O)Ar}$, and its derivatives formed by substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chalcones" .

goldbook:C00968 a skos:Concept ;
    skos:definition "The increment of the value of a quantity \\(Q\\) with time. The change may be expressed either infinitesimally at time \\(t\\) by the differential \\(\\rm{d}Q\\) or \\(\\rm{d}Q(t)\\), or in practice it may be expressed by a finite increment over the time interval \\((t_{1};t_{2})\\), i.e. \\(Q(t_{2})- Q(t_{1})\\), which may be written \\(\\Delta Q\\) or \\(\\Delta Q(t_{1};t_{2})\\) \\[\\Delta Q = \\Delta Q(t_{1};t_{2}) = Q(t_{2})- Q(t_{1})\\] Examples are: mass change, \\(\\Delta m\\); amount of substance change, \\(\\Delta n\\); volume change, \\(\\Delta V\\); substance concentration change, \\(\\Delta c\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "change of a quantity" .

goldbook:C00969 a skos:Concept ;
    skos:definition "A term which may be expressed infinitesimally at time \\(t\\) by a ratio of differentials \\(\\frac{\\rm{d}Q_{1}(t)}{\\rm{d}Q_{2}(t)}\\) where the kind of quantities are the same but for different components in the same system. In practice, the ratio for a finite interval is: \\[\\frac{\\Delta Q_{1}(t_{1};\\,t_{2})}{\\Delta Q_{2}(t_{1};t_{2})}\\] Examples are: mass change ratio, \\(\\frac{\\rm{d}m_{1}(t)}{\\rm{d}m_{2}(t)}\\); amount of substance change ratio, \\(\\frac{\\rm{d}n_{1}(t)}{\\rm{d}n_{2}(t)}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "change ratio of a quantity" .

goldbook:C00970 a skos:Concept ;
    skos:definition "Regions of potential-energy surfaces where there are valleys are sometimes referred to as arrangement channels. The reactant channel or entrance channel is that corresponding to configurations similar to those of the reactants; the product channel or exit channel relates to configurations similar to those of the products. In collision theory, the specification of a complete set of quantum numbers in a given arrangement channel is called a channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "channel" .

goldbook:C00973 a skos:Concept ;
    skos:definition "A species that facilitates a combination reaction between atoms or radicals, or the reverse process, is known as a chaperon. It is a special case of a third body." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chaperon" .

goldbook:C00974 a skos:Concept ;
    skos:definition "A solid decompostion product of a natural or synthetic organic material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "char" .

goldbook:C00975 a skos:Concept ;
    skos:definition "A property or attribute of a material that is measured, compared or noted. Attributes are ordinarily qualitative characteristics, but quantitative characteristics (variables) may be converted into attributes by assigning items to certain categories on the basis of the measured values. The value of the characteristic determined as a result of an observation or test is the observed value; when determined by a specified test method, it is called the test result. The concentration or quantity of an analyte as estimated by use of a sample is usually the characteristic of interest in analytical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic" .

goldbook:C00976 a skos:Concept ;
    skos:definition "A single heteroatom, for example, $\\ce{–Cl}$ and $\\ce{=O}$; a heteroatom bearing one or more hydrogen atoms or other heteroatoms, for example, $\\ce{–NH2}$, $\\ce{–OH}$, $\\ce{–SO3H}$, $\\ce{–PO3H2}$ and $\\ce{-IO2}$; or a heteroatomic group attached to or containing a single carbon atom, for example, $\\ce{–CHO}$, $\\ce{–C#N}$, $\\ce{–COOH}$ and $\\ce{–NCO}$, attached to a parent hydride." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic group" .

goldbook:C00977 a skos:Concept ;
    skos:altLabel "characteristic scale" ;
    skos:definition "The term characteristic length or scale refers, in general, to the parameter which characterizes the density profile (of a given physical quantity). The static (equilibrium) or dynamic character of a characteristic length must be specified. The terms out of plane and in plane refer to characteristic lengths normal or parallel to the interface, respectively. Since interfacial layer 'thickness' and characteristic length correspond to various concepts, the current usage where an out of plane characteristic length is referred to as the interfacial layer thickness, is confusing and should be abandoned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic length" .

goldbook:C00978 a skos:Concept ;
    skos:definition "That mass of analyte which produces an integrated absorbance signal whose net area is equal to \\(0.0044\\ \\rm{s}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic mass for integrated absorbance" .

goldbook:C00979 a skos:Concept ;
    skos:definition "That mass of analyte which produces a defined peak absorbance of 0.0044 (or 1% absorbance)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic mass for peak absorption" .

goldbook:C00980 a skos:Concept ;
    skos:definition "The mass of analyte which, when atomized electrothermally, produces the uniquely defined absorption signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic mass" .

goldbook:C00981 a skos:Concept ;
    skos:definition "An applied potential that is characteristic of a charge-transfer process and the experimental conditions (such as the composition of the solvent and supporting electrolyte and the temperature) under which it is investigated, and whose nature depends on the technique that is employed. Some typical characteristic potentials are the half-wave potential in polarography, the quarter-transition-time potential in chronopotentiometry, the peak potential and the half-peak potential in linear-sweep voltammetry, and the summit potential in ac polarography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic potential" .

goldbook:C00985 a skos:Concept ;
    skos:altLabel "characteristic X-radiation" ;
    skos:definition "X-ray emission originates from the radiative decay of electronically highly excited states of matter. Excitation by electrons is called primary excitation and by photons, secondary or fluorescence excitation. Particle induced X-ray emission (PIXE) is produced by the excitation of heavier particles such as protons, deuterons or heavy atoms in varying degrees of ionization. Emission of photons in the X-ray wavelength region also occurs from ionized gases or plasmas at high temperatures, from nuclear processes (low-energy end of the gamma-ray spectrum) and from radiative transitions between muonic states. Characteristic X-ray emission consists of a series of X-ray spectral lines with discrete frequencies, characteristic of the emitting atom. Other features are emission bands from transitions to valence levels. In a spectrum obtained with electron or photon excitation the most intense lines are called diagram lines or normal X-ray lines. They are dipole allowed transitions between normal X-ray diagram levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "characteristic X-ray emission" .

goldbook:C00986 a skos:Concept ;
    skos:definition "A traditional term for a char obtained from wood, peat, coal or some related natural organic materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charcoal" .

goldbook:C00989 a skos:Concept ;
    skos:definition "This occurs when an ion/atom or ion/molecule reaction takes place in which the charge on the ion is transferred to the neutral species without any dissociation of either. Synonymous with charge-transfer ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-exchange ionization" .

goldbook:C00990 a skos:Concept ;
    skos:definition "Synonymous with charge-transfer reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-exchange reaction" .

goldbook:C00991 a skos:Concept ;
    skos:definition "Electron or hole transfer between equivalent sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge hopping" .

goldbook:C00992 a skos:Concept ;
    skos:definition "Charge inversion processes of the types:  or   or respectively, occuring in a collision cell (containing a gas, X) located in a field-free region preceding a magnetic and electric sector combination placed in either order, may be detected as follows. If the instrument slits are wide, and if the connections to the two sectors, appropriate to transmission of either positive or negative main-beam ions, are simply reversed, the negative or positive product ions of the two processes, respectively, will be transmitted. If the magnetic field is scanned, a spectrum of such product ions will be obtained, and this spectrum is called a charge-inversion mass spectrum. These spectra are sometimes referred to as −E and +E spectra, respectively. The terms '2E, E/2, −E or +E mass spectrum' should not be used without prior explanation of the meaning 2E, E, +E or −E." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-inversion mass spectrum" .

goldbook:C00993 a skos:Concept ;
    skos:definition "Ratio of the charge of a particle to the elementary charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge number" .

goldbook:C00994 a skos:Concept ;
    skos:altLabel "Ewens–Bassett number" ;
    skos:definition "The magnitude of the charge on an ion, given in arabic numerals followed by the sign of the charge, in parentheses without a space, immediately after the name of an ion, e.g. iron(2+), hexacyanoferrate(4−)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge number" .

goldbook:C00996 a skos:Concept ;
    skos:definition "A general term to describe an ion/neutral species reaction where there is a change in the magnitude and/or sign of the charges of the reactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-permutation reaction" .

goldbook:C00997 a skos:Concept ;
    skos:definition "The net electric charge on a specified atom in a molecular entity, as determined by some prescribed definition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge population" .

goldbook:C00998 a skos:Concept ;
    skos:definition "Reverse of charge separation. In using this term it is important to specify the resulting electronic state of the donor and acceptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge recombination" .

goldbook:C00999 a skos:Concept ;
    skos:definition "A process in which, under the influence of a suitable driving force (e.g. provided by photoexcitation), electronic charge moves in a direction that increases the difference in local charges between donor and acceptor sites. electron transfer between neutral species is one of the most important examples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge separation" .

goldbook:C01000 a skos:Concept ;
    skos:definition "A process in which under the influence of a suitable driving force (e.g. provided by photoexcitation) electronic charge moves without changing the difference in local charges between donor and acceptor sites. Electron transfer reversing the charges in a system composed of a neutral donor and a cationic acceptor or of a neutral acceptor and an anionic donor provide prominent examples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge shift" .

goldbook:C01001 a skos:Concept ;
    skos:definition "An ion/neutral species reaction wherein the charge on the reactant ion is made more positive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-stripping reaction" .

goldbook:C01002 a skos:Concept ;
    skos:definition "Oxidative or reductive chemisorption where 'reductive' and 'oxidative' refer to electron gain or loss on species in the solid. In simple cases it is non-dissociative, i.e. there is a mere transfer of charge between adsorptive and adsorbent in forming the adsorbate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer adsorption" .

goldbook:C01003 a skos:Concept ;
    skos:altLabel "electron-donor-acceptor complex" ;
    skos:definition "An electron-donor–electron-acceptor complex, characterized by electronic transition(s) to an excited state in which there is a partial transfer of electronic charge from the donor to the acceptor moiety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer complex" .

goldbook:C01004 a skos:Concept ;
    skos:definition "A charge-transfer device has a metal oxide semiconductor (MOS) structure that is composed of many independent pixels where charge is stored in such a way that the charge pattern corresponds to the irradiation pattern. These devices can be linear or two-dimensional. According to the method used to detect the charge pattern, two types of charge-transfer devices can be distinguished: charge-coupled devices (CCDs) and charge-injection devices (CIDs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer device" .

goldbook:C01005 a skos:Concept ;
    skos:definition "An ion/neutral species reaction wherein the total charge on the reactant ion is transferred initially to the reactant neutral species so that the reactant ion becomes a neutral entity. Considering some of the possible reactions of ions $\\ce{M^{2+}}$, $\\ce{M^{+}}$ and $\\ce{M^{−}}$ with a neutral species $\\ce{X}$, these would be further categorized as follows:    All are ion/neutral species reactions and also charge permutation reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer reaction" .

goldbook:C01006 a skos:Concept ;
    skos:altLabel "CT",
        "CT state" ;
    skos:definition "A state related to the ground state by a charge-transfer transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer state" .

goldbook:C01007 a skos:Concept ;
    skos:definition "An elementary step in which charge is transferred from one phase to the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer step" .

goldbook:C01008 a skos:Concept ;
    skos:altLabel "CT",
        "CT transition" ;
    skos:definition "An electronic transition in which a large fraction of an electronic charge is transferred from one region of a molecular entity, called the electron donor, to another, called the electron acceptor (intramolecular CT) or from one molecular entity to another (intermolecular CT). Typical for donor-acceptor complexes or multichromophoric molecular entities. In some cases the charge-transfer absorption band may be obscured by the absorption of the partners." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer transition" .

goldbook:C01009 a skos:Concept ;
    skos:altLabel "CTTS" ;
    skos:definition "Electronic transition which is adequately described by single electron transfer between a solute and the solvent, as opposed to excitation followed by electron transfer to solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charge-transfer transition to solvent" .

goldbook:C01010 a skos:Concept ;
    skos:definition "Pyrolysis of samples containing organic matter. In the presence of oxygen this is referred to as ashing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "charring" .

goldbook:C01012 a skos:Concept ;
    skos:definition "The formation or presence of bonds (or other attractive interactions) between two or more separate binding sites within the same ligand and a single central atom. A molecular entity in which there is chelation (and the corresponding chemical species) is called a 'chelate'. The terms bidentate (or didentate), tridentate, tetradentate, ... multidentate are used to indicate the number of potential binding sites of the ligand, at least two of which must be used by the ligand in forming a 'chelate'. For example, the bidentate ethylenediamine forms a chelate with $\\ce{CuI}$ in which both nitrogen atoms of ethylenediamine are bonded to copper. (The use of the term is often restricted to metallic central atoms.) The phrase 'separate binding sites' is intended to exclude cases such as $\\ce{[PtCl3(CH2=CH2)]^{−}}$, ferrocene and (benzene)tricarbonylchromium in which ethene, the cyclopentadienyl group and benzene, respectively, are considered to present single binding sites to the respective metal atom, and which are not normally thought of as chelates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chelation" .

goldbook:C01014 a skos:Concept ;
    skos:definition "A form of cycloaddition across the terminal atoms of a fully conjugated system with formation of two new $\\ce{\\upsigma\\!\\mbox{-}bonds}$ to a single atom of the ('monocentric') reagent. There is formal loss of one $\\ce{\\uppi\\!\\mbox{-}bond}$ in the substrate and an increase in coordination number of the relevant atom of the reagent. An example is the addition of sulfur dioxide to butadiene:  The reverse of this type of reaction is designated 'cheletropic elimination'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cheletropic reaction" .

goldbook:C01015 a skos:Concept ;
    skos:definition "Alternative (and etymologically more correct) name for cheletropic reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chelotropic reaction" .

goldbook:C01017 a skos:Concept ;
    skos:definition "When some of the energy required for a reaction is provided by a preceding exothermic chemical reaction there is said to be chemical activation. For example, in the scheme:   some or all of the energy required for X to decompose is provided by the first reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical activation" .

goldbook:C01020 a skos:Concept ;
    skos:definition "The breakdown of a single entity (normal molecule, reaction intermediate, etc.) into two or more fragments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical decomposition" .

goldbook:C01022 a skos:Concept ;
    skos:altLabel "element" ;
    skos:definition "A species of atoms; all atoms with the same number of protons in the atomic nucleus.A pure chemical substance composed of atoms with the same number of protons in the atomic nucleus. Sometimes this concept is called the elementary substance as distinct from the chemical element as defined under (1), but mostly the term chemical element is used for both concepts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical element" .

goldbook:C01023 a skos:Concept ;
    skos:definition "Reversible processes [processes which may be made to proceed in the forward or reverse direction by the (infinitesimal) change of one variable], ultimately reach a point where the rates in both directions are identical, so that the system gives the appearance of having a static composition at which the Gibbs energy, \\(G\\), is a minimum. At equilibrium the sum of the chemical potentials of the reactants equals that of the products, so that: \\[\\Delta G_{\\rm{r}} = \\Delta G_{\\rm{r}}^{o}+R\\ T\\ \\ln K=0\\] \\[\\Delta G_{\\rm{r}}^{\\,\\unicode{x26ac}} = -R\\ T\\ \\ln K\\] The equilibrium constant, \\(K\\), is given by the mass-law effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical equilibrium" .

goldbook:C01024 a skos:Concept ;
    skos:altLabel "chemiflux",
        "total chemiflux" ;
    skos:definition "A concept related to rate of reaction, particularly applicable to the progress in one direction only of component reaction steps in a complex system or to the progress in one direction of reactions in a system at dynamic equilibrium (in which there are no observable concentration changes with time). Chemical flux is a derivative with respect to time, and has the dimensions of amount of substance per unit volume transformed per unit time. The sum of all the chemical fluxes leading to destruction of B is designated the 'total chemical flux out of B' (symbol \\(\\sum \\varphi_{-\\ce{B}}\\)); the corresponding formation of B by concurrent elementary reactions is the 'total chemical flux into B or A' (symbol \\(\\sum \\varphi_{\\ce{B}}\\)). For the mechanism:  the total chemical flux into C is caused by the single reaction (1): \\[\\sum \\varphi_{\\ce{C}} = \\varphi_{1}\\] whereas the chemical flux out of C is a sum over all reactions that remove C: \\[\\sum\\varphi_{-\\ce{C}} = \\varphi_{-1} + \\varphi_{2}\\] where \\(\\varphi_{-1}\\) is the 'chemical flux out of C into B (and/or A)' and \\(\\varphi_{2}\\) is the 'chemical flux out of C into E'. The rate of reaction of C is then given by: \\[\\frac{{\\rm{d}}[\\ce{C}]}{{\\rm{d}}t} = \\sum\\varphi_{\\ce{C}} - \\sum\\varphi_{-\\ce{C}}\\] In this system \\(\\varphi_{1}\\) (or \\(\\sum \\varphi_{-\\ce{A}}\\)) can be regarded as the hypothetical rate of decrease in the concentration of A due to the single (unidirectional) reaction (1) proceeding in the assumed absence of all other reactions. For a non-reversible reaction: \\[\\ce{A ->[1] P}\\] \\[-\\frac{{\\rm{d}}[\\ce{A}]}{{\\rm{d}}t} = \\varphi_{1}\\] If two substances A and P are in chemical equilibrium: \\[\\ce{A  P}\\] then: \\[\\sum\\varphi_{\\ce{A}} = \\sum\\varphi_{-\\ce{A}} = \\sum\\varphi_{\\ce{P}} = \\sum\\varphi_{-\\ce{P}}\\] and \\[-\\frac{{\\rm{d}}[\\ce{A}]}{{\\rm{d}}t} = \\frac{{\\rm{d}}[\\ce{P}]}{{\\rm{d}}t} = 0\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical flux" .

goldbook:C01025 a skos:Concept ;
    skos:altLabel "chemical coupling",
        "coupling" ;
    skos:definition "When in a chemical system one reaction accelerates another there is said to be chemical induction or coupling. It is due to an intermediate or product of the inducing reaction participating in the second reaction. Chemical induction is often observed in oxidation–reduction reactions, chain reactions, and biological reactions. Sometimes a reaction having \\(\\Delta G^{\\,\\unicode{x26ac}} > 0\\) is induced by a simultaneous process having \\(\\Delta G^{\\,\\unicode{x26ac}} < 0\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical induction" .

goldbook:C01026 a skos:Concept ;
    skos:definition "This concerns the process whereby new ionization species are formed when gaseous molecules interact with ions. The process may involve transfer of an electron, proton or other charged species between the reactants. When a positive ion results from chemical ionization, the term may be used without qualification. When a negative ion is involved, the term negative ion chemical ionization should be used; note that negative ion formation by attachment of a free electron does not fall within this definition. Chemical ionization and chemi-ionization are two terms which should not be used interchangeably." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical ionization" .

goldbook:C01027 a skos:Concept ;
    skos:definition "Exchange of isotopes between different types of molecules or ions in the course of a chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical isotope exchange" .

goldbook:C01028 a skos:Concept ;
    skos:definition "A continuous wave or pulsed laser in which the excitation and population inversion of the emitting species result from a chemical reaction. Typical examples are $\\ce{HF}$ and $\\ce{DF}$ lasers emitting many lines in the IR region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical laser" .

goldbook:C01030 a skos:Concept ;
    skos:altLabel "CMP" ;
    skos:definition "An analytical method of defined structure that has been brought into a state of statistical control, such that its imprecision and bias are fixed, given the measurement conditions. This is prerequisite for the evaluation of the performing characteristics of the method, or the development of meaningful uncertainty statements concerning analytical results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical measurement process" .

goldbook:C01031 a skos:Concept ;
    skos:altLabel "COD" ;
    skos:definition "A measure of the amount of oxygen, divided by the volume of the system, required to oxidize the organic (and inorganic) matter in wastewater using a chemically oxidizing agent. In practice, it is usually expressed in milligrams $\\ce{O2}$ per litre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical oxygen demand" .

goldbook:C01032 a skos:Concept ;
    skos:altLabel "partial molar Gibbs energy" ;
    skos:definition "The chemical potential of a substance B in a mixture of substances B, C ... is related to the Gibbs energy \\(G\\) of the mixture by: \\[\\mu _{\\rm{B}}=(\\frac{\\partial G}{\\partial n_{\\rm{B}}})_{T,p,n_{\\rm{C} eq \\rm{B}}}\\] where \\(T\\) is the thermodynamic temperature, \\(p\\) is the pressure and \\(n_{\\rm{B}}\\), \\(n_{\\rm{C}}\\), ... are the amounts of substance of B, C, ... . For a pure substance B, the chemical potential \\(\\mu _{\\rm{B}}^{*}\\) is given by: \\[\\mu _{\\rm{B}}^{*}=\\frac{G^{*}}{n_{\\rm{B}}}=G_{\\rm{m}}^{*}\\] where \\(G_{\\rm{m}}^{*}\\) is the molar Gibbs energy, and where the superscript * attached to a symbol denotes the property of the pure substance. The superscript \\(^{⦵}\\) or \\(^{\\circ}\\) attached to a symbol may be used to denote a standard thermodynamic quantity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical potential" .

goldbook:C01033 a skos:Concept ;
    skos:altLabel "reaction" ;
    skos:definition "A process that results in the interconversion of chemical species. Chemical reactions may be elementary reactions or stepwise reactions. (It should be noted that this definition includes experimentally observable interconversions of conformers.) Detectable chemical reactions normally involve sets of molecular entities as indicated by this definition, but it is often conceptually convenient to use the term also for changes involving single molecular entities (i.e. 'microscopic chemical events')." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical reaction" .

goldbook:C01035 a skos:Concept ;
    skos:definition "If the equilibrium mixture of a chemical reaction is disturbed by a sudden change, especially of some external parameter (such as temperature, pressure or electrical field strength), the system will readjust itself to a new position of the chemical equilibrium or return to the original position, if the perturbation is temporary. The readjustment is known as chemical relaxation. In many cases, and in particular when the displacement from equilibrium is slight, the progress of the system towards equilibrium can be expressed as a first-order law: \\[C_{t}- \\left(C_{\\rm{eq}}\\right)_{2} = [\\left(C_{\\rm{eq}}\\right)_{1}- \\left(C_{\\rm{eq}}\\right)_{2}]\\ \\rm{e}^{\\frac{-t}{\\tau }}\\] where \\(\\left(C_{\\rm{eq}}\\right)_{1}\\) and \\(\\left(C_{\\rm{eq}}\\right)_{2}\\) are the equilibrium concentrations of one of the chemical species involved in the reaction before and after the change in the external parameter, and \\(C_{t}\\) is its concentration at time \\(t\\). The time parameter \\(\\tau \\), named relaxation time, is related to the rate constants of the chemical reaction involved. Measurements of the relaxation times by relaxation methods [involving a temperature jump (T-jump), pressure jump, electric field jump or a periodic disturbance of an external parameter, as in ultrasonic techniques] are commonly used to follow the kinetics of very fast reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical relaxation" .

goldbook:C01036 a skos:Concept ;
    skos:definition "The fractional variation of the resonance frequency of a nucleus in nuclear magnetic resonance (NMR) spectroscopy in consequence of its magnetic environment. The chemical shift of a nucleus, \\(\\delta \\), is expressed as a ratio involving its frequency, \\( u _{\\mathrm{cpd}}\\), relative to that of a standard, \\( u _{\\mathrm{ref}}\\), and defined as: \\[\\delta = \\frac{ u _{\\rm{cpd}}-  u _{\\rm{ref}}}{ u _{ref}}\\] \\(\\delta \\)-values are normally expressed in \\(\\mathrm{ppm}\\). For $\\ce{^{1}H}$ and $\\ce{^{13}C}$ NMR the reference signal is usually that of tetramethylsilane (TMS), strictly speaking in dilute solution in $\\ce{CDCl3}$. Other references are used in the older literature and for other solvents, such as $\\ce{D2O}$. Resonance lines to high frequency from the TMS signal have positive, and resonance lines to low frequency from TMS have negative, \\(\\delta \\)-values (arising from relative deshielding and shielding respectively). The archaic terms 'downfield' and 'upfield' should no longer be used. For nuclei other than $\\ce{^{1}H}$, chemical shifts are expressed either in the same manner relative to an agreed substance containing the relevant nucleus or relative to the $\\ce{^{1}H}$ resonance of TMS as \\(\\mathit{\\Xi}\\) values, defined in the references below." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical shift" .

goldbook:C01037 a skos:Concept ;
    skos:definition "The displacement of photoelectron or Auger peak energies originating from changes in electron binding energies as a consequence of differences in the chemical environment of the atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical shift" .

goldbook:C01040 a skos:Concept ;
    skos:definition "A system in which the analyte is separated from the sample matrix by the generation of gaseous species as a result of a chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical vapour generation" .

goldbook:C01041 a skos:Concept ;
    skos:definition "The fraction of the amount of an element or chemical compound following a specified chemical reaction or separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical yield" .

goldbook:C01042 a skos:Concept ;
    skos:definition "Generation, by a chemical reaction, of electronically excited molecular entities from reactants in their ground electronic states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemiexcitation" .

goldbook:C01044 a skos:Concept ;
    skos:definition "This refers to a process whereby gaseous molecules are ionized when they interact with other internally excited gaseous molecules or molecular moieties. Chemi-ionization and chemical ionization are two terms which should not be used interchangeably." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemi-ionization" .

goldbook:C01045 a skos:Concept ;
    skos:definition "Emission of radiation resulting from a chemical reaction. The emitting species may be a reaction product or a species excited by energy transfer from an excited reaction product. The excitation may be electronic, vibrational or rotational; if the luminescence occurs in the infrared the expression infrared chemiluminescence is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemiluminescence" .

goldbook:C01046 a skos:Concept ;
    skos:definition "An instrument consisting of a reaction chamber with separate inlets for the sample and reagent gas, an optical filter, a photomultiplier and a signal processing device. The reactive gas is introduced in excess. The quantity of light produced is proportional to the sample flow rate and the concentration of the measured substance in the sample under specified temperature and pressure conditions. The filter limits the wavelength to the region of interest and helps to eliminate interferences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemiluminescence analyser" .

goldbook:C01047 a skos:Concept ;
    skos:definition "Methods which utilize gas or liquid phase reactions between two molecules which produce a third molecule in an excited state. The wavelength distribution of the light emission from the excited molecule is characteristic of the species; in some circumstances this may be used to identify and to determine the concentration of one of the reacting species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemiluminescent methods of detection" .

goldbook:C01048 a skos:Concept ;
    skos:altLabel "chemical adsorption" ;
    skos:definition "Adsorption which results from chemical bond formation (strong interaction) between the adsorbent and the adsorbate in a monolayer on the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemisorption" .

goldbook:C01051 a skos:Concept ;
    skos:definition "Chemoselectivity is the preferential reaction of a chemical reagent with one of two or more different functional groups. A reagent has a high chemoselectivity if reaction occurs with only a limited number of different functional groups. For example, sodium tetrahydroborate is a more chemoselective reducing agent than is lithium tetrahydroaluminate. The concept has not been defined in more quantitative terms. The term is also applied to reacting molecules or intermediates which exhibit selectivity towards chemically different reagents. Some authors use the term 'chemospecificity' for 100% chemoselectivity. However, this usage is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemoselectivity" .

goldbook:C01053 a skos:Concept ;
    skos:definition "A bioreactor in which constant growth conditions for microorganisms are maintained over prolonged periods of time by supplying the reactor with a continuous input of nutrients and continuous removal of medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemostat" .

goldbook:C01055 a skos:Concept ;
    skos:definition "A vertical movement of a localized mass of air or other gases which occurs due to local temperature differences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chimney effect" .

goldbook:C01057 a skos:Concept ;
    skos:definition "Having the property of chirality. As applied to a molecule the term has been used differently by different workers. Some apply it exclusively to the whole molecule, whereas others apply it to parts of a molecule. For example, according to the latter view, a meso-compound is considered to be composed of two chiral parts of opposite chirality sense; this usage is to be discouraged. In its application to an assembly of molecules, some restrict the term to an assembly in which all of the molecules have the same chirality sense, which is better called enantiopure. Others extend it to a racemic assembly, which is better just called a racemate. Use of the term to describe molecular assemblies should be avoided." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral" .

goldbook:C01058 a skos:Concept ;
    skos:definition "The geometric property of a rigid object (or spatial arrangement of points or atoms) of being non-superposable on its mirror image; such an object has no symmetry elements of the second kind (a mirror plane, \\(\\sigma =S_{1}\\), a centre of inversion, \\(i=S_{2}\\), a rotation-reflection axis, \\(S_{2n}\\)). If the object is superposable on its mirror image the object is described as being achiral." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirality" .

goldbook:C01059 a skos:Concept ;
    skos:altLabel "axis of chirality" ;
    skos:definition "An axis about which a set of ligands is held so that it results in a spatial arrangement which is not superposable on its mirror image. For example with an allene $\\ce{abC=C=Ccd}$ the chiral axis is defined by the $\\ce{C=C=C}$ bonds; and with an ortho-substituted biphenyl the atoms $\\ce{C-1}$, $\\ce{C-1'}$, $\\ce{C-4}$ and $\\ce{C-4'}$ lie on the chiral axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirality axis" .

goldbook:C01060 a skos:Concept ;
    skos:altLabel "asymmetric centre",
        "centre of chirality" ;
    skos:definition "An atom holding a set of ligands in a spatial arrangement which is not superposable on its mirror image. A chirality centre is thus a generalized extension of the concept of the asymmetric carbon atom to central atoms of any element, for example $\\ce{N^{+}abcd}$, $\\ce{Pabc}$ as well as $\\ce{Cabcd}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirality centre" .

goldbook:C01061 a skos:Concept ;
    skos:altLabel "element of chirality" ;
    skos:definition "General name for a chirality axis, chirality centre or chirality plane. Also referred to as an element of chirality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirality element" .

goldbook:C01062 a skos:Concept ;
    skos:definition "A planar unit connected to an adjacent part of the structure by a bond which results in restricted torsion so that the plane cannot lie in a symmetry plane. For example with (E)-cyclooctene the chiral plane includes the double bond carbon atoms and all four atoms attached to the double bond; with a monosubstituted paracyclophane the chiral plane includes the monosubstituted benzene ring with its three hydrogen atoms and the three other atoms linked to the ring (i.e. from the substituent and the two chains linking the two benzene rings)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirality plane" .

goldbook:C01063 a skos:Concept ;
    skos:definition "The property that distinguishes enantiomorphs. The specification of two enantiomorphic forms by reference to an oriented space e.g. of a screw, a right threaded one or a left threaded one. The expression 'opposite chirality' is short for 'opposite chirality sense'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirality sense" .

goldbook:C01064 a skos:Concept ;
    skos:definition "A term referring to the optical techniques (using refraction, absorption or emission of anisotropic radiation) for investigating chiral substances [e.g. measurements of optical rotation at a fixed wavelength, optical rotatory dispersion (ORD), circular dichroism (CD), and circular polarization of luminescence (CPL)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiroptic" .

goldbook:C01065 a skos:Concept ;
    skos:definition "The description of an atom (or point, group, face, etc. in a molecular model) that resides within a chiral environment. One that resides within an achiral environment has been called achirotopic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chirotopic" .

goldbook:C01066 a skos:Concept ;
    skos:definition "Amines substituted at nitrogen with one or two chlorine atoms (a contracted form of N-chloroamines)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chloramines" .

goldbook:C01067 a skos:Concept ;
    skos:definition "Compounds consisting wholly of chlorine and carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chlorocarbons" .

goldbook:C01071 a skos:Concept ;
    skos:definition "A graphical or other presentation of detector response, concentration of analyte in the effluent or other quantity used as a measure of effluent concentration versus effluent volume or time. In planar chromatography 'chromatogram' may refer to the paper or layer with the separated zones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatogram" .

goldbook:C01072 a skos:Concept ;
    skos:definition "The assembly of apparatus for carrying out chromatographic separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatograph" .

goldbook:C01073 a skos:Concept ;
    skos:definition "To separate by chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatograph" .

goldbook:C01074 a skos:Concept ;
    skos:definition "A device that measures the change of composition of the effluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatographic detector" .

goldbook:C01075 a skos:Concept ;
    skos:definition "A physical method of separation in which the components to be separated are distributed between two phases, one of which is stationary (stationary phase) while the other (the mobile phase) moves in a definite direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromatography" .

goldbook:C01076 a skos:Concept ;
    skos:definition "The part (atom or group of atoms) of a molecular entity in which the electronic transition responsible for a given spectral band is approximately localized. The term arose in the dyestuff industry, referring originally to the groupings in the molecule that are responsible for the dye's colour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromophore" .

goldbook:C01077 a skos:Concept ;
    skos:definition "A self-replicating structure consisting of DNA complexed with various proteins and involved in the storage and transmission of genetic information; the physical structure that contains genes (cf. plasmid). Eukaryotic cells have a characteristic number of chromosomes per cell (cf. ploidy) and contain DNA as linear duplexes. The chromosomes of bacteria consist of double-standed, circular DNA molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chromosome" .

goldbook:C01079 a skos:Concept ;
    skos:altLabel "CIDNP" ;
    skos:definition "Non-Boltzmann nuclear spin state distribution produced in thermal or photochemical reactions, usually from colligation and diffusion, or disproportionation of radical pairs, and detected by NMR spectroscopy by enhanced absorption or emission signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically induced dynamic nuclear polarization" .

goldbook:C01081 a skos:Concept ;
    skos:definition "A substitution reaction (generally aromatic) in which the entering group takes up a position adjacent to that occupied by the leaving group. For example," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cine-substitution" .

goldbook:C01082 a skos:Concept ;
    skos:altLabel "CIP",
        "priority" ;
    skos:definition "In the CIP rules the conventional order of ligands established for the purpose of unambiguous designation of stereoisomers. It is deduced by application of 'sequence rules', the authoritative statement of which appears in R.S. Cahn, C.K. Ingold and V. Prelog, Angew. Chem.78, 413-447 (1966), Angew. Chem. Internat. Ed. Eng. 5, 385-415, 511 (1966); and V. Prelog and G. Helmchen, Angew. Chem. 94, 614-631 (1982), Angew. Chem. Internat. Ed. Eng. 21, 567-583 (1982)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CIP priority" .

goldbook:C01083 a skos:Concept ;
    skos:definition "Short for Cahn–Ingold–Prelog system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "C. I. P. system" .

goldbook:C01087 a skos:Concept ;
    skos:definition "A prefix designating two groups occupying adjacent positions in a coordination sphere, not now generally recommended for precise nomenclature purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>cis</i>-" .

goldbook:C01092 a skos:Concept ;
    skos:definition "Descriptors which show the relationship between two ligands attached to separate atoms that are connected by a double bond or are contained in a ring. The two ligands are said to be located cis to each other if they lie on the same side of a plane. If they are on opposite sides, their relative position is described as trans. The appropriate reference plane of a double bond is perpendicular to that of the relevant $\\ce{\\upsigma\\!\\mbox{-}bonds}$ and passes through the double bond. For a ring (the ring being in a conformation, real or assumed, without re-entrant angles at the two substituted atoms) it is the mean plane of the ring(s). For alkenes the terms cis and trans may be ambiguous and have therefore largely been replaced by the E, Z convention for the nomenclature of organic compounds. If there are more than two entities attached to the ring the use of cis and trans requires the definition of a reference substituent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>cis</i>, <i>trans</i>" .

goldbook:C01093 a skos:Concept ;
    skos:altLabel "geometric isomerism" ;
    skos:definition "Stereoisomeric olefins or cycloalkanes (or hetero-analogues) which differ in the positions of atoms (or groups) relative to a reference plane: in the cis-isomer the atoms are on the same side, in the trans-isomer they are on opposite sides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>cis</i>-<i>trans</i> isomers" .

goldbook:C01094 a skos:Concept ;
    skos:definition "A metal ion that combines preferentially with ligands containing ligating atoms that are the lightest of their Periodic Group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "class (a) metal ion" .

goldbook:C01095 a skos:Concept ;
    skos:definition "A metal ion that combines preferentially with ligands containing ligating atoms other than the lightest of their Periodic Group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "class (b) metal ion" .

goldbook:C01097 a skos:Concept ;
    skos:definition "Inclusion compounds in which the guest molecule is in a cage formed by the host molecule or by a lattice of host molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clathrates" .

goldbook:C01099 a skos:Concept ;
    skos:definition "An experimental surface having no surface contamination observable by means of the used method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clean surface" .

goldbook:C01103 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "A population of genetically identical cells produced from a common ancestor. Sometimes, 'clone' is also used for a number of recombinant DNA molecules all carrying the same inserted sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clone" .

goldbook:C01106 a skos:Concept ;
    skos:definition "An affix used in names to denote a cage or closed structure, especially a boron skeleton that is a polyhedron having all triangular faces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>closo</i>-" .

goldbook:C01107 a skos:Concept ;
    skos:definition "An aerosol of the atmosphere which is dense enough to be perceptible to the eye. Usually refers to an assembly of water droplet aerosols suspended in the atmosphere, although dust clouds are also recognized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cloud" .

goldbook:C01115 a skos:Concept ;
    skos:definition "An ion formed by the combination of more ions or atoms or molecules of a chemical species often in association with a second species. For example, $\\ce{[(H2O)_{n}H]^{+}}$ is a cluster ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster ion" .

goldbook:C01116 a skos:Concept ;
    skos:definition "The separation into two liquid phases in colloidal systems. The phase more concentrated in colloid component is the coacervate, and the other phase is the equilibrium solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coacervation" .

goldbook:C01117 a skos:Concept ;
    skos:altLabel "flocculation" ;
    skos:definition "When a sol is colloidally unstable (i.e. the rate of aggregation is not negligible) the formation of aggregates is called coagulation or flocculation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coagulation" .

goldbook:C01118 a skos:Concept ;
    skos:definition "The primary industrial solid carbonization product obtained from coal tar pitch mainly produced in chamber or delayed coking processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coal-derived pitch coke" .

goldbook:C01119 a skos:Concept ;
    skos:definition "The disappearance of the boundary between two particles (usually droplets or bubbles) in contact, or between one of these and a bulk phase followed by changes of shape leading to a reduction of the total surface area. The flocculation of an emulsion, viz. the formation of aggregates, may be followed by coalescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coalescence" .

goldbook:C01120 a skos:Concept ;
    skos:definition "A geological process of formation of materials with increasing content of the element carbon from organic materials that occurs in a first, biological stage into peats, followed by a gradual transformation into coal by action of moderate temperature (about \\(500\\ \\rm{K}\\)) and high pressure in a geochemical stage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coalification" .

goldbook:C01121 a skos:Concept ;
    skos:definition "A residue produced by distillation or heat treatment of coal tar. It is a solid at room temperature, consists of a complex mixture of numerous predominantly aromatic hydrocarbons and heterocyclics, and exhibits a broad softening range instead of a defined melting temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coal tar pitch" .

goldbook:C01123 a skos:Concept ;
    skos:definition "The sequence of three consecutive nucleotides that occurs in mRNA which directs the incorporation of a specific amino acid into a protein and includes also the starting or termination signals of protein synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "codon" .

goldbook:C01125 a skos:Concept ;
    skos:altLabel "COH" ;
    skos:definition "One technique of measurement of the amount of filterable particulate matter suspended in air which has been used in the past depends upon drawing a measured sample of air (usually 1 000 linear feet) through a paper or membrane filter. A measurement is made of the intensity of light transmitted through the dust spot formed relative to that transmitted through an identical clean filter. The dirtiness of the air is reported in terms of the \\(\\rm{COH}\\) unit. This relates to the quantity of particulate material which produces an optical density, \\[\\log_{10}(\\frac{I_{0}}{I})\\] of 0.01 when measured by light transmission at \\(\\pu{400 nm}\\) and relative to the transmission of an identical dust-free filter taken as 100%. Thus a filter which transmitted 50% relative to the clean filter has an absorbance of 0.301 or 30.1 \\(\\rm{COH}\\) units. This is not a recommended measure of filterable particulate matter since the size, colour and other properties of the aerosol and the air in which it is suspended affect the results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coefficient of haze" .

goldbook:C01126 a skos:Concept ;
    skos:definition "The dissociable, low-relative-molecular-mass active group of an enzyme which transfers chemical groups, hydrogen or electrons. A coenzyme binds with its associated protein (apoenzyme) to form the active enzyme (holoenzyme)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coenzyme" .

goldbook:C01127 a skos:Concept ;
    skos:definition "Formation of mixed-species aggregates in a low-polarity organic phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coextraction" .

goldbook:C01128 a skos:Concept ;
    skos:definition "Organic molecules (cf. coenzymes) or ions (usually metal ions) that are required by an enzyme of its activity. They may be attached either loosely or tightly prosthetic group) to the enzyme. A cofactor binds with its associated protein (apoenzymes), which is functionally inactive, to form the active enzyme (holoenzyme)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cofactors" .

goldbook:C01129 a skos:Concept ;
    skos:definition "The distance over which order is maintained. As an example, there can be long-range atomic or molecular order, i.e. coherence. Coherence lengths are significantly larger than molecular size. Normally, coherence length is estimated from electron, neutron or X-ray scattering and scales the size of ordered domains in material where long range ordering occurs (as in liquid crystals, for example). The term coherence length is also used for the scale characterizing the profile of molecular axis orientation in the distorted, so-called, transition layers formed at a solid/liquid-crystal boundary when an appropriate external field is applied (e.g. when the orientation of anchored surface molecules of a nematic liquid crystal is unaffected by an external field -- magnetic or electric -- whereas the bulk molecules reorient freely). This scale is referred to as electric coherence length, \\(\\zeta _{\\rm{E}}\\) or magnetic coherence length, \\(\\zeta _{\\rm{M}}\\), depending on the nature of the applied field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherence length" .

goldbook:C01130 a skos:Concept ;
    skos:definition "Radiation emitted by a source when all the elementary waves emitted have a phase difference constant in space and time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent radiation" .

goldbook:C01131 a skos:Concept ;
    skos:definition "Scattering is coherent whenever the phases of the signals arising from different scattering centres are correlated and incoherent whenever these phases are uncorrelated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent scattering" .

goldbook:C01132 a skos:Concept ;
    skos:definition "Those sources where the radiation has a constant phase relationship between waves spatially as well as temporally, e.g. lasers. Non-coherent optical sources emit radiation which is randomly distributed in phase, spatially as well as temporally. Most sources which are used in spectroscopy and for spectrochemical analysis conform to this latter group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent source" .

goldbook:C01133 a skos:Concept ;
    skos:definition "If the net of an ordered adsorbed phase is in registry with the lattice of the adsorbent the structure is called coherent, if not it is called incoherent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent structure" .

goldbook:C01134 a skos:Concept ;
    skos:definition "System of units of measurement in which all of the derived units are coherent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent system of units of measurement" .

goldbook:C01135 a skos:Concept ;
    skos:altLabel "coherent derived unit" ;
    skos:definition "Derived unit of measurement that may be expressed as a product of powers of base units with the proportionality factor one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coherent unit" .

goldbook:C01136 a skos:Concept ;
    skos:definition "An electronic circuit which produces a usable output pulse only when each of its inputs receives a pulse within a specified time interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coincidence circuit" .

goldbook:C01139 a skos:Concept ;
    skos:definition "The greatest time interval that can elapse between the occurrence of two or more consecutive signal pulses, in order that the measuring device processes them as a coincidence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coincidence resolving time" .

goldbook:C01141 a skos:Concept ;
    skos:definition "Ions of low relative molecular mass with a charge of the same sign as that of a given colloidal ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-ions" .

goldbook:C01142 a skos:Concept ;
    skos:definition "A solid high in content of the element carbon and structurally in the non-graphitic state. It is produced by pyrolysis of organic material which has passed, at least in part, through a liquid or liquid-crystalline state during the carbonization process. Coke can contain mineral matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coke" .

goldbook:C01143 a skos:Concept ;
    skos:definition "A by-product of coke manufacture; it is the residue from the screening of heat-treated coke. The particle size is less than \\(10\\ \\rm{mm}\\). Generally, coke breeze has a volatile matter content of \\(" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coke breeze" .

goldbook:C01144 a skos:Concept ;
    skos:definition "Many reactions involving hydrocarbons and particularly those run at higher temperatures lead to the deposition on the catalyst of high molecular weight compounds of carbon and hydrogen which deactivate the catalyst. This phenomenon is called coking or fouling. Catalysts so deactivated can often be regenerated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coking" .

goldbook:C01145 a skos:Concept ;
    skos:altLabel "saddle point" ;
    skos:definition "A mountain-pass in a potential-energy surface is known as a col or saddle point. It is a point at which the gradient is zero along all coordinates, and the curvature is positive along all but one coordinate, which is the reaction coordinate, along which the curvature is negative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "col" .

goldbook:C01147 a skos:Concept ;
    skos:definition "Neutrons with a neutron temperature considerably lower than normal room temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cold neutrons" .

goldbook:C01149 a skos:Concept ;
    skos:definition "A term which characterizes an entire sampling and sample pretreatment procedure, usually represented as a percentage of the original amount of the analyte which is left for measurement (signal formation) after having passed through this procedure. This term also applies to the efficiency of collection of an air pollutant by an arrestment plant. For particulates, the collection efficiency is size related." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collection efficiency" .

goldbook:C01150 a skos:Concept ;
    skos:definition "A system in which the analyte is carried to a collecting device called the collector which may be an amalgamator for mercury, a cold trap for some of the more stable hydrides, an absorbing solution in which the analyte is absorbed by some chemical reaction, an electrothermal atomizer or a reservoir." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collection gas flow system" .

goldbook:C01151 a skos:Concept ;
    skos:definition "A device for removing and retaining contaminants from air or other gases; a term which is often applied to cleaning devices in exhaust systems. Also used to designate a device for removing and retaining samples from media in different environmental compartments to be investigated. A collector is sometimes used to describe a scavenger." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collector" .

goldbook:C01153 a skos:Concept ;
    skos:altLabel "radical combination" ;
    skos:definition "The formation of a covalent bond by the combination or recombination of two radicals (the reverse of unimolecular homolysis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colligation" .

goldbook:C01154 a skos:Concept ;
    skos:definition "The limiting of a beam of radiation to the required dimensions and angular spread." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collimation" .

goldbook:C01155 a skos:Concept ;
    skos:definition "An arrangement of absorbers used for collimation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collimator" .

goldbook:C01156 a skos:Concept ;
    skos:definition "This is a reaction assumed to occur via an activated complex in which all of the atoms directly involved in the process lie along a straight line." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collinear reaction" .

goldbook:C01157 a skos:Concept ;
    skos:altLabel "collisionally activated dissociation" ;
    skos:definition "An ion/neutral species process wherein excitation of a projectile ion of high translational energy is brought about by the same mechanism as in collision-induced dissociation. (The ion may decompose subsequently.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collisional activation" .

goldbook:C01158 a skos:Concept ;
    skos:altLabel "Holtsmark broadening",
        "Lorentz broadening" ;
    skos:definition "Collisions of the emitting or absorbing particle with other particles cause collisional broadening as well as collisional shift of the spectral line. When collisions occur between unlike, neutral particles the term foreign-gas broadening is used, or van der Waals' broadening when both collision partners are neutral. When the colliding particles are of the same species, the term resonance broadening is employed. The term Lorentz broadening was previously used for neutral particle collision broadening, and Holtsmark broadening for cases of van der Waals' broadening when collisions took place with like particles. Both terms are now discouraged. Stark broadening refers to collisions with charged particles or particles with a strong permanent electrical dipole moment. Whereas a strong chaotic electrical field causes Stark broadening, an applied static electrical field induces a Stark shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collisional broadening" .

goldbook:C01159 a skos:Concept ;
    skos:definition "An ion/neutral species process wherein there is an increase in the reactant ion's internal energy at the expense of the translational energy of either (or both) of the reacting species. The scattering angle may be large." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collisional excitation" .

goldbook:C01160 a skos:Concept ;
    skos:definition "An ensemble formed by two reaction partners for which the distance is the sum of their van der Waals radii. As such it constitutes a subclass of the species indicated as encounter complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision complex" .

goldbook:C01164 a skos:Concept ;
    skos:altLabel "de-energization efficiency" ;
    skos:definition "The collision efficiency, or de-energization efficiency, is defined by: \\[k_{\\rm{-1}} = B_{\\rm{c}}\\ k_{\\rm{-1}}^{\\rm{sc}}\\] where \\(k_{-1}\\) is the rate constant for a particular substance \\(\\rm{M}\\) when it brings about the de-energization process  and \\(k_{-1}^{\\rm{sc}}\\) is the corresponding rate constant for a reference molecule \\(\\rm{M}_{\\rm{r}}\\) that de-energizes \\(\\rm{A}^{*}\\) on every collision; that is, the reference molecule \\(\\rm{M}_{\\rm{r}}\\) undergoes strong collisions, and by definition has a collision efficiency \\(B_{\\rm{c}}\\) of unity. The species \\(\\rm{A}^{*}\\) is usually in a vibrationally-excited state, and \\(\\rm{A}\\) has energy less than that required for reaction to occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision efficiency" .

goldbook:C01167 a skos:Concept ;
    skos:definition "An ion/neutral species process wherein the projectile ion is dissociated as a result of interaction with a target neutral species. This is brought about by conversion of part of the translational energy of the ion to internal energy in the ion during the collision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision-induced dissociation" .

goldbook:C01169 a skos:Concept ;
    skos:definition "Now called collision density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision number" .

goldbook:C01170 a skos:Concept ;
    skos:altLabel "kinetic theory of collisions" ;
    skos:definition "Various collision theories, dealing with the frequency of collision between reactant molecules, have been put forward. In the earliest theories reactant molecules were regarded as hard spheres, and a collision was considered to occur when the distance \\(d\\) between the centres of two molecules was equal to the sum of their radii. For a gas containing only one type of molecule, A, the collision density is given by simple collision theory as: \\[Z_{\\mathrm{AA}}=\\frac{\\sqrt{2}\\ \\pi \\ \\sigma ^{2}\\ u\\ N_{\\rm{A}}^{2}}{2}\\] Here \\(N_{\\rm{A}}\\) is the number density of molecules and \\(u\\) is the mean molecular speed, given by kinetic theory to be \\(\\sqrt{\\frac{8\\ k_{\\rm{B}}\\ T}{\\pi \\ m}}\\), where \\(m\\) is the molecular mass, and \\(\\sigma =\\pi \\ d_{\\mathrm{AA}}^{2}\\). Thus: \\[Z_{\\mathrm{AA}}=2\\ N_{\\rm{A}}^{2}\\ \\sigma ^{2}\\ \\sqrt{\\frac{\\pi \\ k_{\\rm{B}}\\ T}{m}}\\] The corresponding expression for the collision density \\(Z_{\\mathrm{AB}}\\) for two unlike molecules A and B, of masses \\(m_{\\rm{A}}\\) and \\(m_{\\rm{B}}\\) is: \\[Z_{\\mathrm{AB}}=N_{\\rm{A}}\\ N_{\\rm{B}}\\ \\sigma ^{2}\\ \\sqrt{\\frac{\\pi \\ k_{\\rm{B}}\\ T}{\\mu }}\\] where \\(\\mu \\) is the reduced mass \\(\\frac{m_{\\rm{A}}\\ m_{\\rm{B}}}{m_{\\rm{A}}+m_{\\rm{B}}}\\), and \\(\\sigma =\\pi \\ d_{\\mathrm{AB}}^{2}\\). For the collision frequency factor these formulations lead to the following expression: \\[z_{\\mathrm{AA}}\\quad \\rm{or}\\quad z_{\\mathrm{AB}}=L\\ \\sigma ^{2}\\ \\sqrt{\\frac{8\\ \\pi \\ k_{\\rm{B}}\\ T}{\\mu }}\\] where \\(L\\) is the Avogadro constant. More advanced collision theories, not involving the assumption that molecules behave as hard spheres, are known as generalized kinetic theories." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "collision theory" .

goldbook:C01171 a skos:Concept ;
    skos:definition "A short synonym for colloidal system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloid" .

goldbook:C01172 a skos:Concept ;
    skos:definition "The term refers to a state of subdivision, implying that the molecules or polymolecular particles dispersed in a medium have at least in one direction a dimension roughly between \\(1\\ \\rm{nm}\\) and \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\), or that in a system discontinuities are found at distances of that order." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal" .

goldbook:C01173 a skos:Concept ;
    skos:definition "A particulate carbon with particle sizes below ca.\\(1000\\ \\rm{nm}\\) in at least one dimension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal carbon" .

goldbook:C01174 a skos:Concept ;
    skos:definition "A system in which particles of colloidal size of any nature (e.g. solid, liquid or gas) are dispersed in a continuous phase of a different composition (or state). The name dispersed phase for the particles should be used only if they have essentially the properties of a bulk phase of the same composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal dispersion" .

goldbook:C01175 a skos:Concept ;
    skos:definition "An electrolyte which gives ions of which at least one is of colloidal size. This term therefore includes hydrophobic sols, ionic association colloids, and polyelectrolytes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal electrolyte" .

goldbook:C01176 a skos:Concept ;
    skos:definition "Particles which do not aggregate at a significant rate: the precise connotation depends on the type of aggregation under consideration. For example, a concentrated paint is called stable by some people because oil and pigment do not separate out at a measurable rate, and unstable by others because the pigment particles aggregate into a continuous network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidally stable" .

goldbook:C01177 a skos:Concept ;
    skos:definition "A suspension in which the size of the particles lies in the colloidal range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal suspension" .

goldbook:C01178 a skos:Concept ;
    skos:altLabel "Donnan pressure" ;
    skos:definition "The pressure difference which has to be established between a colloidal system and its equilibrium liquid to prevent material transfer between the two phases when they are separated by a membrane, permeable to all components of the system, except the colloidal ones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloid osmotic pressure" .

goldbook:C01179 a skos:Concept ;
    skos:definition "An instrument used for colour measurement based on optical comparison with standard colours." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colorimeter" .

goldbook:C01181 a skos:Concept ;
    skos:definition "The tube and the stationary phase contained within, through which the mobile phase passes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "column" .

goldbook:C01182 a skos:Concept ;
    skos:definition "A separation technique in which the stationary bed is within a tube. The particles of the solid stationary phase or support coated with a liquid stationary phase may fill the whole inside volume of the tube (packed column) or be concentrated on or along the inside tube wall leaving an open, unrestricted path for the mobile phase in the middle part of the tube (open-tubular column)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "column chromatography" .

goldbook:C01183 a skos:Concept ;
    skos:definition "The geometric volume of the part of the tube that contains the packing: \\[V_{\\rm{c}} = A_{\\rm{c}}\\ L\\] where \\(A_{\\rm{c}}\\) is the internal cross-sectional area of the tube and \\(L\\) the length of the packed part of the column. In the case of wall-coated open-tubular columns the column volume corresponds to the geometric volume of the whole tube having a liquid or a solid stationary phase on its wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "column volume" .

goldbook:C01184 a skos:Concept ;
    skos:definition "An ion-selective electrode and an external reference electrode combined in a single unit, thereby avoiding the need for a separate external reference electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combination electrode" .

goldbook:C01185 a skos:Concept ;
    skos:definition "A sample obtained by removing specific fractions by separation or selection techniques (e.g. heavy liquid, magnetic, sieving, etc.), analysing the fractions separately, and combining the results mathematically. When not combined, the sample is a modified sample. This term should not be confused with composite sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combined sample" .

goldbook:C01186 a skos:Concept ;
    skos:definition "A macromolecule comprising a main chain with multiple trifunctional branch points from each of which a linear side-chain emanates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comb macromolecule" .

goldbook:C01187 a skos:Concept ;
    skos:definition "A polymer composed of comb macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comb polymer" .

goldbook:C01188 a skos:Concept ;
    skos:definition "A gas or vapour produced in furnaces, combustion chambers or in open burning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "combustion gas" .

goldbook:C01189 a skos:Concept ;
    skos:definition "A transition between two states having magnetic or crystallographic structures with a basic lattice and an imposed super-periodicity. In the commensurate (lock-in) state this super-periodicity is a simple rational multiple of the basic unit cell. In the incommensurate state the ratio of the super-periodicity repeat distance to the basic lattice repeat distance is irrational and may show continuous variation with variation in some degree of freedom (e.g. temperature, pressure, composition) of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "commensurate–incommensurate transition" .

goldbook:C01191 a skos:Concept ;
    skos:definition "A reduction in the rate of reaction of certain reactions of a substrate RX in solution [by a path that involves a pre-equilibrium with formation of $\\ce{R^{+}}$ (or $\\ce{R^{−}}$) ions as reaction intermediates] caused by the addition to the reaction mixture of an electrolyte solute containing the 'common ion' $\\ce{X^{−}}$ (or $\\ce{X+}$). For example, the rate of solvolysis of diphenylmethyl chloride in acetone-water is reduced by the addition of salts of the common ion $\\ce{Cl^{−}}$ which causes a decrease in the quasi-equilibrium concentration of the diphenylmethyl cation in the scheme:   This phenomenon is a direct consequence of the mass-law effect on ionization equilibria in electrolytic solution. More generally, the common-ion effect is the influence of the 'common ion' on the reactivity due to the shift of the dissociation equilibrium. It may also lead to an enhancement of the rate of reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "common-ion effect" .

goldbook:C01192 a skos:Concept ;
    skos:altLabel "consortia",
        "synergistic associations",
        "syntrophic associations" ;
    skos:definition "Naturally occuring groups of different (micro)organisms inhabiting a common environment, interacting with each other, especially through food relationships and relatively independent of other groups. Communities may be of varying sizes, and larger communities may contain smaller ones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "communities" .

goldbook:C01194 a skos:Concept ;
    skos:definition "A known amount of element that is simultaneously irradiated with the test portion in the context of activation analysis. If one comparator is used (single comparator method), it is essentially identical to a flux monitor (except that this term is not necessarily linked to activation analysis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comparator" .

goldbook:C01195 a skos:Concept ;
    skos:definition "For the process: \\[k = A\\ \\rm{e}^{\\frac{-E}{R\\ T}}\\] where \\(k\\) is a rate constant, \\(A\\) the frequency factor and \\(E\\) the activation energy, \\(A\\) and \\(E\\) sometimes exhibit compensation, i.e. they change in the same direction with change in catalyst for a given reaction or with change in reaction for a given catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compensation" .

goldbook:C01196 a skos:Concept ;
    skos:definition "For internal compensation, see compound.See: external compensation" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compensation" .

goldbook:C01197 a skos:Concept ;
    skos:definition "In a considerable number of cases plots of \\(T\\ \\Delta ^{\\ddagger }S\\) vs. \\(\\Delta ^{\\ddagger}H\\), for a series of reactions, e.g. for a reaction in a range of different solvents, are straight lines of approximately unit slope. Therefore, the terms \\(\\Delta ^{\\ddagger}H\\) and \\(T\\ \\Delta ^{\\ddagger }S\\) in the expression partially compensate, and \\[\\Delta ^{\\ddagger}G = \\Delta ^{\\ddagger}H - T\\ \\Delta ^{\\ddagger}S\\] often is a much simpler function of solvent (or other) variation than \\(\\Delta ^{\\ddagger}H\\) or \\(T\\ \\Delta ^{\\ddagger }S\\) separately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compensation effect" .

goldbook:C01199 a skos:Concept ;
    skos:definition "An assay based on the competition between a labelled and an unlabelled ligand in the reaction with a receptor binding agent (e.g. antibody, receptor, transport protein)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competitive binding assay" .

goldbook:C01200 a skos:Concept ;
    skos:definition "The reduction in rate due to reduction or loss of activity of a catalyst caused by adsorption of poison which is not greatly preferred to adsorption of reactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "competitive inhibition" .

goldbook:C01202 a skos:Concept ;
    skos:altLabel "cDNA" ;
    skos:definition "A single-stranded DNA molecule with a nucleotide sequence that is complementary to an RNA molecule; cDNA is formed by the action of the enzyme reverse transcriptase on an RNA template. After conversion to the double-stranded form, cDNA is used for molecular cloning or for hybridization studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complementary DNA" .

goldbook:C01203 a skos:Concept ;
    skos:definition "A molecular entity formed by loose association involving two or more component molecular entities (ionic or uncharged), or the corresponding chemical species. The bonding between the components is normally weaker than in a covalent bond. The term has also been used with a variety of shades of meaning in different contexts: it is therefore best avoided when a more explicit alternative is applicable. In inorganic chemistry the term 'coordination entity' is recommended instead of 'complex'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complex" .

goldbook:C01204 a skos:Concept ;
    skos:definition "Coacervation caused by the interaction of two oppositely charged colloids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complex coacervation" .

goldbook:C01205 a skos:Concept ;
    skos:definition "This term is sometimes applied to an elementary reaction which proceeds via an intermediate species having a lifetime longer than a few rotational periods, in contrast to a direct reaction. However, in view of the danger of confusion with a reaction occurring in more than one step (a composite reaction) this usage is not to be recommended; it is better to use the terms complex-mode mechanism or complex-mode reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complex mechanism" .

goldbook:C01206 a skos:Concept ;
    skos:definition "An elementary reaction which proceeds via an intermediate species having a lifetime longer than a few rotational periods is known as a complex-mode reaction, or as an indirect reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complex-mode reaction" .

goldbook:C01210 a skos:Concept ;
    skos:definition "A reaction that involves more than one elementary reaction is said to occur by a composite mechanism. The terms complex mechanism, indirect mechanism, and step-wise mechanism are also commonly used. There are two main kinds of evidence for a composite mechanism: The kinetic equation for the reaction does not correspond to its stoichiometry.There is experimental evidence, direct or indirect, for intermediates of such a nature that it is necessary to conclude that more than one elementary reaction is involved. There are many types of composite mechanisms, for example: Reactions occurring in parallel, such as:  are called parallel reactions or simultaneous reactions. When there are simultaneous reactions there is sometimes  competition, as in the scheme:  where B and C compete with one another for A.Reactions occurring in forward and reverse directions are called opposing reactions: Reactions occurring in sequence, such as  are known as consecutive reactions.Reactions are said to exhibit feedback if a substance formed in one step affects the rate of a previous step. For example, in the scheme: The intermediate Y may catalyse the reaction  (positive feedback) or it may inhibit it (negative feedback).Chain reactions" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composite mechanism" .

goldbook:C01211 a skos:Concept ;
    skos:definition "A chemical reaction for which the expression for the rate of disappearance of a reactant (or rate of appearance of a product) involves rate constants of more than a single elementary reaction. Examples are 'opposing reactions' (where rate constants of two opposed chemical reactions are involved), 'parallel reactions' (for which the rate of disappearance of any reactant is governed by the rate constants relating to several simultaneous reactions to form different respective products from a single set of reactants), and stepwise reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composite reaction" .

goldbook:C01212 a skos:Concept ;
    skos:definition "Often prepared as a representative mixture of several different (usually bulk) samples, and from which the laboratory sample is taken." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composite sample" .

goldbook:C01214 a skos:Concept ;
    skos:definition "The composition of air is variable with respect to several of its components (e.g. $\\ce{CH4}$, $\\ce{CO2}$, $\\ce{H2O}$) so 'pure' air has no precise meaning; it is commonly considered to be air which is free of dust, aerosols and reactive gaseous contaminants of anthropogenic origin. The composition of the major components in dry air is relatively constant (percent by volume given): nitrogen, 78.084; oxygen, 20.946; argon, 0.934; carbon dioxide, 0.033; neon, 0.0018; helium, 0.000524; methane, 0.00016; krypton, 0.000114; hydrogen 0.00005; nitrous oxide, 0.00003; xenon, 0.0000087. The concentrations of carbon dioxide, methane, nitrous oxide, the chlorofluorocarbons and some other species of anthropogenic origin are increasing measurably with time. Relative clean air which is free of most reactive anthropogenic pollution ($\\ce{NO}$, $\\ce{NO2}$, $\\ce{SO2}$, non-methane hydrocarbons, etc.), often used as a reference sample in the calibration and operation of instruments, is purchased under the designation of zero air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composition of pure air" .

goldbook:C01217 a skos:Concept ;
    skos:definition "The reverse of disproportionation. The term 'symproportionation' is also used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comproportionation" .

goldbook:C01218 a skos:Concept ;
    skos:altLabel "Compton scattering" ;
    skos:definition "The elastic scattering of a photon by an electron which afterwards occurs as a free electron. Part of the energy and momentum of the incident photon is transferred to the electron and the remaining part is carried away by the scattered photon. Synonymous with Compton scattering" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Compton effect" .

goldbook:C01219 a skos:Concept ;
    skos:definition "The energetic electron resulting from the Compton effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Compton electron" .

goldbook:C01224 a skos:Concept ;
    skos:definition "The local variation of the corrosion rate due to the action of a corrosion cell resulting from inhomogeneous composition of the environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration-cell corrosion" .

goldbook:C01227 a skos:Concept ;
    skos:definition "Differential change in concentration of a component in a given direction in a small distance divided by the distance in that direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration gradient" .

goldbook:C01229 a skos:Concept ;
    skos:altLabel "surface concentration" ;
    skos:definition "The amount of the material of interest divided by the total amount of substances in the volume of interest. Concentration may be defined in terms of numbers of atoms (particles) (\\(\\rm{ppma}\\)) or in terms of weight (\\(\\frac{\\unicode[Times]{x3BC}\\rm{g}}{\\rm{g}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration in experimental surface" .

goldbook:C01230 a skos:Concept ;
    skos:definition "The concentration overpotential of an electrode reaction at a given electrode current density (\\(\\rm{c.d.}\\)) is basically the difference in equilibrium potentials across the diffusion layer. More precisely, it is the potential of a reference electrode (of the same electrode reaction as the working electrode) with the interfacial concentrations which establish themselves at \\(\\rm{c.d.}\\), relative to the potential of a similar reference electrode with the concentrations of the bulk solution. From such a measured potential difference, with \\(\\rm{c.d.}\\) flowing, one needs to subtract the ohmic potential drop prevailing between the two electrodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration overpotential" .

goldbook:C01232 a skos:Concept ;
    skos:definition "A device the response of which is proportional to the concentration of a sample component in the eluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration-sensitive detector" .

goldbook:C01234 a skos:Concept ;
    skos:definition "Two or more primitive changes are said to be concerted (or to constitute a concerted process) if they occur within the same elementary reaction. Such changes will normally (though perhaps not inevitably) be 'energetically coupled'. (In the present context the term 'energetically coupled' means that the simultaneous progress of the primitive changes involves a transition state of lower energy than that for their successive occurrence.) In a concerted process the primitive changes may be synchronous or asynchronous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concerted process" .

goldbook:C01235 a skos:Concept ;
    skos:definition "The physical process of converting a material from a gaseous or vapour phase to a liquid or solid phase; this commonly results when the temperature is lowered and/or the vapour pressure of the material is increased. The tendency exists for condensation to occur when the partial pressure of a given component of a gaseous mixture at a given temperature exceeds the vapour pressure of the liquid or solid form of that component at the given temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condensation" .

goldbook:C01236 a skos:Concept ;
    skos:altLabel "CN" ;
    skos:definition "Particles, either liquid or solid, or ions upon which condensation of water vapour (or other substances) begins in the atmosphere. Condensation nuclei are usually very small hygroscopic aerosols (\\(\\pu{0.001 \\upmu m}\\) to \\(\\pu{0.1 \\upmu m}\\) in diameter), but these are not as abundant as the smaller particles. The number of CN which are active (initiate condensation) in a given air mass may be a function of the relative humidity. Usually CN are counted as the active nuclei at about $\\ce{300\\%}$ relative humidity, while cloud condensation nuclei (CCN) are counted as the number of active nuclei at relative humidity less than or equal to $\\ce{102\\%}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condensation nuclei" .

goldbook:C01238 a skos:Concept ;
    skos:definition "A (usually stepwise) reaction in which two or more reactants (or remote reactive sites within the same molecular entity) yield a single main product with accompanying formation of water or of some other small molecule, e.g. ammonia, ethanol, acetic acid, hydrogen sulfide. The mechanism of many condensation reactions has been shown to comprise consecutive addition and elimination reactions, as in the base-catalysed formation of (E)-but-2-enal (crotonaldehyde) from acetaldehyde, via 3-hydroxybutanal (aldol). The overall reaction in this example is known as the aldol condensation. The term is sometimes also applied to cases where the formation of water or another simple molecule does not occur, as in 'benzoin condensation'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "condensation reaction" .

goldbook:C01240 a skos:Concept ;
    skos:altLabel "formal potential" ;
    skos:definition "Conditional (formal) potential, \\(E^{0'}\\), is related to the potential of a cell reaction, \\(E_{\\mathrm{cell}}\\), by an equation analogous to that relating \\(E_{\\mathrm{cell}}\\) to the standard potential \\(E_{0}\\), with the activity, \\(a_{i}\\), replaced by any composition variable, \\(c_{i}\\) (to be indicated by a subscript). For example: \\[E_{\\mathrm{cell}}=E_{\\rm{c}}^{0'}- \\frac{R\\ T}{n\\ F}\\ \\sum _{\\begin{array}{c} i \\end{array}} u _{i}\\ \\ln c_{i}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conditional potential" .

goldbook:C01242 a skos:Concept ;
    skos:definition "Synonymous with pre-equilibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conditioning" .

goldbook:C01244 a skos:Concept ;
    skos:definition "A vacant or only partially occupied set of many closely spaced electronic levels resulting from an array of a large number of atoms forming a system in which the electrons can move freely or nearly so. This term is usually used to describe the properties of metals and semiconductors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conduction band" .

goldbook:C01245 a skos:Concept ;
    skos:altLabel "electric conductivity",
        "electrical conductivity",
        "specific conductance" ;
    skos:definition "Reciprocal of resistivity. This quantity is a tensor in an anisotropic medium. It was formerly called 'specific conductance'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conductivity" .

goldbook:C01246 a skos:Concept ;
    skos:definition "The probability of covering the expected value of an estimated parameter with an interval estimated for the parameter (symbol \\(1 - \\alpha\\)). The confidence level can be expressed as a number between 0 and 1, or in percent. The complementary quantity is known as the significance level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confidence level" .

goldbook:C01247 a skos:Concept ;
    skos:definition "Symmetric confidence limits (\\(\\pm C\\)) about the estimated mean, which cover the population mean with probability \\(1 - \\alpha \\). The quantity \\(C\\) is calculated by the formula: \\[C = \\frac{t_{\\rm{p},v^{S}}}{\\sqrt{n}}\\] Here \\(t_{\\rm{p},v}\\), is the critical value from the \\(t\\)- (or Student) distribution function corresponding to the confidence level \\(1 - \\alpha \\) and degrees of freedom \\(v\\). The symbol \\(p\\) represents the percentile (or percentage point) of the \\(t\\)-distribution. For 1-sided intervals, \\(p=1- \\alpha \\); for 2-sided intervals, \\(p=1- \\frac{\\alpha }{2}\\). In each case, the confidence level is \\(1 - \\alpha \\). The confidence interval is given as \\(\\overline{x}\\ \\pm \\ C\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "confidence limits" .

goldbook:C01248 a skos:Concept ;
    skos:altLabel "electron configuration",
        "electronic configuration" ;
    skos:definition "A distribution of the electrons of an atom or a molecular entity over a set of one-electron wavefunctions called orbitals, according to the Pauli principle. From one configuration several states with different multiplicities may result. For example, the ground electronic configuration of the oxygen molecule ($\\ce{O2}$) is: \\(1\\sigma _{\\rm{g}}^{2}\\), \\(1\\sigma _{\\rm{u}}^{2}\\), \\(2\\sigma _{\\rm{g}}^{2}\\), \\(2\\sigma _{\\rm{u}}^{2}\\), \\(1\\pi _{\\rm{u}}^{4}\\), \\(3\\sigma _{\\rm{g}}^{2}\\), \\(1\\pi _{\\rm{g}}^{2}\\) resulting in the \\(^{3}\\Sigma_{\\rm{g}}\\), \\(^{1}\\Delta_{\\rm{g}}\\) and \\(^{1}\\Sigma_{\\rm{g}}^{+}\\) multiplets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configuration" .

goldbook:C01249 a skos:Concept ;
    skos:altLabel "stereochemical configuration" ;
    skos:definition "In the context of stereochemistry, the term is restricted to the arrangements of atoms of a molecular entity in space that distinguishes stereoisomers, the isomerism between which is not due to conformation differences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configuration" .

goldbook:C01250 a skos:Concept ;
    skos:definition "A constitutional repeating unit in a regular macromolecule, a regular oligomer molecule, regular block or a regular chain, the configuration of which is defined at least at one site of stereoisomerism in the main chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configurational base unit" .

goldbook:C01253 a skos:Concept ;
    skos:definition "The smallest set of successive configurational base units that prescribes configurational repetition at one or more sites of stereoisomerism in the main chain of a regular macromolecule, a regular oligomer molecule, a regular block or a regular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configurational repeating unit" .

goldbook:C01254 a skos:Concept ;
    skos:definition "The whole or part of a chain comprising one or more species of configurational unit(s) in defined sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configurational sequence" .

goldbook:C01255 a skos:Concept ;
    skos:definition "A constitutional unit having at least one site of defined stereoisomerism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configurational unit" .

goldbook:C01256 a skos:Concept ;
    skos:altLabel "CI" ;
    skos:definition "The mixing of many-electron wavefunctions constructed from different electronic configurations to obtain an improved many-electron state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "configuration interaction" .

goldbook:C01258 a skos:Concept ;
    skos:definition "The spatial arrangement of the atoms affording distinction between stereoisomers which can be interconverted by rotations about formally single bonds. Some authorities extend the term to include inversion at trigonal pyramidal centres and other polytopal rearrangements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformation" .

goldbook:C01259 a skos:Concept ;
    skos:definition "The assessment of the relative energies (or thermodynamic stabilities), reactivities, and physical properties of alternative conformations of a molecular entity, usually by the application of qualitative or semi-quantitative rules or by semi-empirical calculations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational analysis" .

goldbook:C01262 a skos:Concept ;
    skos:definition "One of a set of stereoisomers, each of which is characterized by a conformation corresponding to a distinct potential energy minimum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformer" .

goldbook:C01264 a skos:Concept ;
    skos:definition "A transition in which the two-phase equilibrium of melting, vaporization or allotropism of a compound involves phases of the same composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congruent transition" .

goldbook:C01265 a skos:Concept ;
    skos:definition "The reduction in size of a granular or powdered sample by forming a conical heap which is spread out into a circular, flat cake. The cake is divided radially into quarters and two opposite quarters are combined. The other two quarters are discarded. The process is repeated as many times as necessary to obtain the quantity desired for some final use (e.g. as the laboratory sample or as the test sample). If the process is performed only once, coning and quartering is no more efficient than taking alternate portions and discarding the others." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coning and quartering" .

goldbook:C01266 a skos:Concept ;
    skos:definition "The Brønsted acid $\\ce{BH^{+}}$ formed on protonation of a base $\\ce{B}$ is called the conjugate acid of $\\ce{B}$, and $\\ce{B}$ is the conjugate base of $\\ce{BH^{+}}$. (The conjugate acid always carries one unit of positive charge more than the base, but the absolute charges of the species are immaterial to the definition.) For example: the Brønsted acid $\\ce{HCl}$ and its conjugate base $\\ce{Cl^{−}}$ constitute a conjugate acid–base pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugate acid–base pair" .

goldbook:C01267 a skos:Concept ;
    skos:altLabel "conjugation" ;
    skos:definition "In the original meaning a conjugated system is a molecular entity whose structure may be represented as a system of alternating single and multiple bonds: e.g. $\\ce{CH2=CH–CH=CH2}$, $\\ce{CH2=CH–C#N}$. In such systems, conjugation is the interaction of one p-orbital with another across an intervening $\\ce{\\upsigma\\!\\mbox{-}bond}$ in such structures. (In appropriate molecular entities d-orbitals may be involved.) The term is also extended to the analogous interaction involving a p-orbital containing an unshared electron pair, e.g. $\\ce{{:}Cl–CH=CH2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugated system" .

goldbook:C01268 a skos:Concept ;
    skos:definition "Two solutions that co-exist in equilibrium at a given temperature and pressure and, at constant pressure (temperature), change their compositions and relative proportions with a variation of temperature (pressure). The term usually refers to two immiscible liquids, but it is also applicable to two immiscible solid solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugate solutions" .

goldbook:C01270 a skos:Concept ;
    skos:definition "The contact-dependent transfer of a part or all of its genome from one bacterial cell (donor) to another (recipient)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugation" .

goldbook:C01271 a skos:Concept ;
    skos:definition "Labelling of a substance by conjugation with a labelled molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjugation labelling" .

goldbook:C01273 a skos:Concept ;
    skos:definition "A name for assemblies of functionalized acyclic parent hydrides and cyclic systems implying the loss of an appropriate number of hydrogen atoms from each." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conjunctive name" .

goldbook:C01274 a skos:Concept ;
    skos:definition "In a chemical context, the information content of a line formula, but omitting any indication of bond multiplicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "connectivity" .

goldbook:C01276 a skos:Concept ;
    skos:altLabel "consecutive steps" ;
    skos:definition "Reactions occurring in sequence, such as:  The overall process is said to occur by consecutive steps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "consecutive reactions" .

goldbook:C01278 a skos:Concept ;
    skos:definition "A quantity of material transferred on one occasion and covered by a single set of shipping documents. It may consist of one or more lots or portions of lots. The presence of different lots in a consignment is important from the point of view of the sampling plan and the interpretation of the results of analysis. The term 'population' is used as the general term for the quantity of parent material being sampled when it is immaterial if the parent body is a consignment, lot, batch, entity, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "consignment" .

goldbook:C01279 a skos:Concept ;
    skos:definition "A general term to describe the property of a material by which it resists permanent change of shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "consistency" .

goldbook:C01282 a skos:Concept ;
    skos:definition "The description of the identity and connectivity (and corresponding bond multiplicities) of the atoms in a molecular entity (omitting any distinction arising from their spatial arrangement)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitution" .

goldbook:C01285 a skos:Concept ;
    skos:definition "Isomerism between structures differing in constitution and described by different line formulae e.g. $\\ce{CH3OCH3}$ and $\\ce{CH3CH2OH}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitutional isomerism" .

goldbook:C01286 a skos:Concept ;
    skos:altLabel "CRU" ;
    skos:definition "The smallest constitutional unit the repetition of which constitutes a regular macromolecule, a regular oligomer molecule, a regular block or a regular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitutional repeating unit" .

goldbook:C01287 a skos:Concept ;
    skos:definition "The whole or part of a chain comprising one or more species of constitutional unit(s) in defined sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitutional sequence" .

goldbook:C01288 a skos:Concept ;
    skos:definition "An atom or group of atoms (with pendant atoms or groups, if any) comprising a part of the essential structure of a macromolecule, an oligomer molecule, a block or a chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitutional unit" .

goldbook:C01289 a skos:Concept ;
    skos:definition "Enzymes which are produced constitutively by the cell under all physiological conditions. Therefore, they are not controlled by induction or repression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "constitutive enzymes" .

goldbook:C01290 a skos:Concept ;
    skos:definition "When a liquid does not spread on a substrate (usually a solid), a contact angle \\(\\left(\\theta\\right) \\) is formed which is defined as the angle between two of the interfaces at the three-phase line of contact. It must always be stated which interfaces are used to define \\(\\theta\\). It is often necessary to distinguish between the 'advancing contact angle' \\((\\theta _{\\rm{a}}) \\), the 'receding contact angle' \\((\\theta _{\\rm{r}}) \\) and the 'equilibrium contact angle' \\((\\theta _{\\rm{e}}) \\). When \\((\\theta _{\\rm{r}})  eq (\\theta _{\\rm{a}}) \\) the system is said to exhibit contact angle hysteresis" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact angle" .

goldbook:C01291 a skos:Concept ;
    skos:altLabel "galvanic corrosion" ;
    skos:definition "The enhancement of the corrosion rate of the material with the more negative corrosion cell resulting from the contact between different electron-conducting phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact corrosion" .

goldbook:C01293 a skos:Concept ;
    skos:altLabel "Volta potential difference" ;
    skos:definition "The electric potential difference between one point in the vacuum close to the surface of M1 and another point in the vacuum close to the surface of M2, where M1 and M2 are two uncharged metals brought into contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contact potential difference" .

goldbook:C01295 a skos:Concept ;
    skos:definition "Carry-over from a preceding sample probe into a following specimen cup, which will influence not just one result, but all assays on that specimen, or with that reagent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contamination" .

goldbook:C01297 a skos:Concept ;
    skos:definition "A change in the mutual dispersion of two phases in contact." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuity inversion" .

goldbook:C01298 a skos:Concept ;
    skos:definition "An analyser in which subassemblies operate continuously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous analyser" .

goldbook:C01300 a skos:Concept ;
    skos:definition "A cell which allows liquid (or gaseous) samples to pass through the cell continuously while absorption measurements are made." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous-flow cell" .

goldbook:C01301 a skos:Concept ;
    skos:definition "A term used to describe methods wherein a reagent is continuously fed into a flowing analyte stream and the temperature difference is measured before and after a reactor (mixing chamber). Alternatively, the temperature may be measured in a differential manner between a reference and a reactor chamber. The analyte concentration is directly proportional to the measured temperature difference. Synonymous with continuous flow enthalpimetric analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous flow enthalpimetry" .

goldbook:C01302 a skos:Concept ;
    skos:definition "An analysis with a permanent indication related to the sample concentration. To obtain a continuous indication, the sampling and measuring cell need to be continuous. A time lag may exist between sampling and indication of measured concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous indication analyser" .

goldbook:C01304 a skos:Concept ;
    skos:definition "A measuring cell which operates continuously." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous measuring cell" .

goldbook:C01305 a skos:Concept ;
    skos:definition "The operation of an analytical instrument in such a way that no analytical procedure needs to be completed on any sample before the next procedure can be started." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous operation" .

goldbook:C01306 a skos:Concept ;
    skos:definition "A diffusional reaction in a multi-component system in which atoms are transported to the growing nuclei by diffusion over relatively large distances in the parent phase and during which the mean composition of the parent phase changes continuously towards its equilibrium value. Synonymous with nucleation and growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous precipitation" .

goldbook:C01309 a skos:Concept ;
    skos:altLabel "canonical form" ;
    skos:definition "The definition is based on the valence-bond formulation of the quantum mechanical idea of the wavefunction of a molecule as composed of a linear combination of wavefunctions, each representative of a formula containing bonds that are only single, double or triple with a particular pairing of electron spins. Each such formula represents a contributing structure, also called 'resonance structure' to the total wavefunction, and the degree to which each contributes is indicated by the square of its coefficient in the linear combination. The contributing structures, also called 'canonical forms', themselves thus have a purely formal significance: they are the components from which wavefunctions can be built. Structures may be covalent (or non-polar) or ionic (or polar). The representation is frequently kept qualitative so that we speak of important or major contributing structures and minor contributing structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "contributing structure" .

goldbook:C01310 a skos:Concept ;
    skos:definition "A synthetic gaseous sample of pure air which may contain carefully determined amounts of certain contaminants; this may be used as a standard for the calibration of analytical techniques, as a simulated environment for the study of biological responses, or for other purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "controlled atmosphere" .

goldbook:C01311 a skos:Concept ;
    skos:definition "A material to be used for the assessment of the performance of an analytical procedure or part thereof." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "control material" .

goldbook:C01312 a skos:Concept ;
    skos:definition "The test portion or test solution used for assessment of the performance of an analytical procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "control sample" .

goldbook:C01313 a skos:Concept ;
    skos:definition "Vertical motion of the air induced by the expansion of the air heated by the earth's surface and its resulting buoyancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "convection" .

goldbook:C01314 a skos:Concept ;
    skos:definition "A sample chosen on the basis of accessibility, expediency, cost, efficiency or other reason not directly concerned with sampling parameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "convenience sample" .

goldbook:C01316 a skos:Concept ;
    skos:definition "Value attributed to a particular quantity and accepted, sometimes by convention, as having an uncertainty appropriate for a given purpose. Examples are the CODATA recommended values of fundamental physical constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conventional true value" .

goldbook:C01317 a skos:Concept ;
    skos:definition "Electron ejected from the atom in the process of internal conversion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conversion electron" .

goldbook:C01319 a skos:Concept ;
    skos:definition "A plot of a quantity related to the absorption (absorbance, cross section, etc.) multiplied by the quantum yield for the considered process against a suitable measure of photon energy, such as frequency, \\( u \\), wavenumber, \\(\\sigma \\), or wavelength, \\(\\lambda \\), e.g. the conversion cross section, \\(\\sigma \\varphi \\), has the SI unit \\(\\mathrm{m}^{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conversion spectrum" .

goldbook:C01321 a skos:Concept ;
    skos:definition "An oligomer derived from more than one species of monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-oligomer" .

goldbook:C01322 a skos:Concept ;
    skos:definition "Oligomerization in which a co-oligomer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "co-oligomerization" .

goldbook:C01324 a skos:Concept ;
    skos:definition "A transition that involves a simultaneous, collective displacement or change of state of the atoms and/or electrons in the entire system. Examples: An order–disorder transition of atoms or electrons, as in an alloy, a ferromagnet or superconductor; a Jahn–Teller or ferroic transition; a martensitic transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cooperative transition" .

goldbook:C01325 a skos:Concept ;
    skos:definition "Interaction between the substrate binding sites of an allosteric enzymes. Binding of a substrate molecule to one binding site changes the affinity of the binding sites on the other subunits (cf. allosteric enzymes) to the substrate by induction of a conformation change at the other binding sites. Cooperative enzymes typically display a sigmoid (S-shaped) plot of the reaction rate against substrate concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cooperativity" .

goldbook:C01329 a skos:Concept ;
    skos:altLabel "coordinate covalence",
        "coordinate link" ;
    skos:definition "The formation of a covalent bond, the two shared electrons of which have come from only one of the two parts of the molecular entity linked by it, as in the reaction of a Lewis acid and a Lewis base to form a Lewis adduct; alternatively, the bonding formed in this way. In the former sense, it is the reverse of unimolecular heterolysis. 'Coordinate covalence' and 'coordinate link' are synonymous (obsolescent) terms. The synonym 'dative bond' is obsolete. (The origin of the bonding electrons has by itself no bearing on the character of the bond formed. Thus, the formation of methyl chloride from a methyl cation and a chloride ion involves coordination; the resultant bond obviously differs in no way from the $\\ce{C–Cl}$ bond in methyl chloride formed by any other path, e.g. by colligation of a methyl radical and a chlorine atom.) The term is also used to describe the number of ligands around a central atom without necessarily implying two-electron bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination" .

goldbook:C01330 a skos:Concept ;
    skos:definition "An assembly consisting of a central atom (usually metallic) to which is attached a surrounding array of other groups of atoms (ligands)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination entity" .

goldbook:C01331 a skos:Concept ;
    skos:definition "The coordination number of a specified atom in a chemical species is the number of other atoms directly linked to that specified atom. For example, the coordination number of carbon in methane is four, and it is five in protonated methane, $\\ce{CH5^{+}$. (The term is used in a different sense in the crystallographic description of ionic crystals.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination number" .

goldbook:C01332 a skos:Concept ;
    skos:altLabel "polygon" ;
    skos:definition "In a coordination entity, the solid figure defined by the positions of the ligand atoms directly attached to the central atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordination polyhedron" .

goldbook:C01333 a skos:Concept ;
    skos:definition "A transition metal complex that has formally 18 outer shell electrons at the central metal atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordinatively saturated complex" .

goldbook:C01334 a skos:Concept ;
    skos:definition "A transition metal complex that possesses fewer ligands than exist in the coordinatively saturated complex. These complexes usually have fewer than 18 outer shell electrons at the central metal atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coordinatively unsaturated complex" .

goldbook:C01335 a skos:Concept ;
    skos:definition "A polymer derived from more than one species of monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copolymer" .

goldbook:C01336 a skos:Concept ;
    skos:definition "Polymerization in which a copolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copolymerization" .

goldbook:C01338 a skos:Concept ;
    skos:definition "A pulsed source of coherent radiation emitting at \\(578.2\\ \\rm{nm}\\) and \\(510.5\\ \\rm{nm}\\) from excited copper atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copper vapour laser" .

goldbook:C01340 a skos:Concept ;
    skos:definition "The number of copies of a plasmid or a gene within a cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "copy number" .

goldbook:C01341 a skos:Concept ;
    skos:definition "The primary reference atom in a mechanistic change; usually either of the two atoms of a transformed multiple bond or the single atom at which substitution occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "core atom" .

goldbook:C01343 a skos:Concept ;
    skos:definition "Obtained after correcting for instrumental and sample effects and usually represented by a graph of \\(\\mathit{\\Phi} _{\\lambda}\\) against wavelength, where \\(\\mathit{\\Phi} _{\\lambda}\\) is the spectral (radiant) energy flux." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrected emission spectrum" .

goldbook:C01344 a skos:Concept ;
    skos:definition "Obtained if the photon flux incident on the sample is held constant. If the solution is sufficiently dilute that the fraction of the exciting radiation absorbed is proportional to the absorption coefficient of the analyte, and if the quantum yield is independent of the exciting wavelength, the corrected excitation spectrum will be identical in shape to the absorption spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrected excitation spectrum" .

goldbook:C01346 a skos:Concept ;
    skos:altLabel "QSAR" ;
    skos:definition "The use of empirical correlations relating one body of experimental data to another, with the objective of finding quantitative estimates of the factors underlying the phenomena involved. Correlation analysis in organic chemistry often uses linear free-energy relations for rates or equilibria of reactions, but the term also embraces similar analysis of physical (most commonly spectroscopic) properties and of biological activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation analysis" .

goldbook:C01347 a skos:Concept ;
    skos:definition "A measure of the degree of interrelationship which exists between two measured quantities, \\(x\\) and \\(y\\); the correlation coefficient (\\(r\\)) is defined by the following relation: \\[r=\\frac{\\sum _{\\begin{array}{c} i=1 \\end{array}}^{n}(x_{i}- \\overline{x})\\ (y_{i}- \\overline{y})}{\\sqrt{\\sum _{\\begin{array}{c} i=1 \\end{array}}^{n}(x_{i}- \\overline{x})^{2}\\ \\sum _{\\begin{array}{c} i=1 \\end{array}}^{n}(y_{i}- \\overline{y})^{2}}}\\] where \\(x_{i}\\) and \\(y_{i}\\) are the measured values in the \\(i\\)th experiment of \\(n\\) total experiments, \\(\\overline{x}\\) and \\(\\overline{y}\\) are the arithmetic means of \\(x_{i}\\) and \\(y_{i}\\): \\[\\overline{x}=\\frac{\\sum _{\\begin{array}{c} i=1 \\end{array}}^{n}x_{i}}{n}\\] (similar expression for \\(\\overline{y}\\)). The linear correlation coefficient indicates the degree to which two quantities are linearly related. If \\(x=a\\ y\\) is followed then \\(r=1\\), and departures from this relationship decrease \\(r\\); if interpretations of data based on the linear correlation coefficient are to be made, one should consult a book on statistics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation coefficient" .

goldbook:C01348 a skos:Concept ;
    skos:definition "A diagram which shows the relative energies of orbitals, configurations, valence bond structures, or states of reactants and products of a reaction, as a function of the molecular geometry, or another suitable parameter. An example involves the interpolation between the energies obtained for the united atoms and the values for the separated atoms limits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation diagram" .

goldbook:C01349 a skos:Concept ;
    skos:definition "The difference between the Hartree–Fock energy calculated for a system and the exact non-relativistic energy of that system. The correlation energy arises from the approximate representation of the electron-electron repulsions in the Hartree–Fock method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "correlation energy" .

goldbook:C01350 a skos:Concept ;
    skos:definition "Derivatives of the corrin nucleus, which contains four reduced or partly reduced pyrrole rings joined in a macrocycle by three  groups and one direct carbon–carbon bond linking $\\ce{\\upalpha\\!}$ positions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrinoids" .

goldbook:C01351 a skos:Concept ;
    skos:definition "An irreversible interfacial reaction of a material (metal, ceramic, polymer) with its environment which results in consumption of the material or in dissolution into the material of a component of the environment. Often, but not necessarily, corrosion results in effects detrimental to the usage of the material considered. Exclusively physical or mechanical processes such as melting or evaporation, abrasion or mechanical fracture are not included in the term corrosion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrosion" .

goldbook:C01352 a skos:Concept ;
    skos:definition "A galvanic cell resulting from inhomogeneities in the material or in its environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrosion cell" .

goldbook:C01357 a skos:Concept ;
    skos:definition "The electrode potential spontaneously acquired by a corroding material in a particular environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrosion potential" .

goldbook:C01358 a skos:Concept ;
    skos:definition "The amount of substance transferred per unit time at a specified surface. Using Faraday's law, the corrosion rate, \\( u_{\\mathrm{cor}}\\), can be formally expressed as an electric current which at the corrosion potential is called the corrosion current, \\(I_{\\mathrm{cor}}\\), e.g. for the anodic dissolution of one component of a material with \\( u_{\\mathrm{cor}}\\) in \\(\\pu{mol s-1}\\) and \\(I_{\\mathrm{cor}}\\) in \\(\\mathrm{A}\\) one obtains \\(I_{\\mathrm{cor}}=n\\ F\\  u_{\\mathrm{cor}}\\), \\(n\\) being the charge number of the electrode reaction and \\(F\\) the Faraday constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "corrosion rate" .

goldbook:C01364 a skos:Concept ;
    skos:definition "The conditions of pressure, temperature and composition under which two or more solid phases crystallize at the same time from a single liquid over a finite range of decreasing temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cotectic" .

goldbook:C01365 a skos:Concept ;
    skos:definition "SI derived unit of electric charge, \\(\\rm{C} = \\rm{A}\\cdot \\rm{s}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coulomb" .

goldbook:C01367 a skos:Concept ;
    skos:definition "A detection method in which the current is directly proportional to the flow rate of the substance involved in the electrochemical reaction, and the amount of charge which flows is proportional to the amount of substances taking part in the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coulometric detection method" .

goldbook:C01369 a skos:Concept ;
    skos:definition "2H-Chromen-2-one (older name 1,2-benzopyrone), trivially named coumarin, and its derivatives formed by substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coumarins" .

goldbook:C01370 a skos:Concept ;
    skos:definition "1. Information corresponding to a pulse processed for counting.2. Number of pulses recorded during a measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "count" .

goldbook:C01371 a skos:Concept ;
    skos:definition "The mobile exchangeable ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter-ions" .

goldbook:C01373 a skos:Concept ;
    skos:definition "Radiation detector consisting of a gas-filled tube or valve whose gas amplification is much greater than one, and in which the individual ionizing events give rise to discrete electrical pulses. Often an expression is added indicating the geometry (e.g. end window), composition of the gas (e.g. helium) or the physical process for its operation (e.g. proton recoil, fission)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter tube" .

goldbook:C01377 a skos:Concept ;
    skos:altLabel "efficiency" ;
    skos:definition "The ratio between the number of particles or photons counted with a radiation counter and the number of particles or photons of the same type and energy emitted by the radiation source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counting efficiency" .

goldbook:C01378 a skos:Concept ;
    skos:definition "A reduction of the counting rate resulting from phenomena such as the resolving time or the dead time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counting loss" .

goldbook:C01379 a skos:Concept ;
    skos:definition "The number of counts occuring in unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counting rate" .

goldbook:C01380 a skos:Concept ;
    skos:altLabel "indicator reaction" ;
    skos:definition "A reaction which follows the (slower) reaction of kinetic interest, so as to provide means of monitoring the formation of a reaction product. This reaction is sometimes referred to as the indicator reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coupled reaction" .

goldbook:C01383 a skos:Concept ;
    skos:altLabel "spin-spin coupling constant" ;
    skos:definition "A quantitative measure for nuclear spin-spin, nuclear-electron (hyperfine coupling) and electron-electron (fine coupling in EPR) coupling in magnetic resonance spectroscopy. The 'indirect' or scalar NMR coupling constants are in a first approximation independent of the external magnetic field and are expressed in \\(\\mathrm{Hz}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coupling constant" .

goldbook:C01384 a skos:Concept ;
    skos:definition "A region of relatively high electron density between nuclei which arises at least partly from sharing of electrons and gives rise to an attractive force and characteristic internuclear distance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "covalent bond" .

goldbook:C01386 a skos:Concept ;
    skos:definition "A modification of the Bunnett–Olsen equation of the form: \\[\\log_{10}(\\frac{[\\ce{SH^{+}}]}{[\\ce{S}]}) - \\log_{10}[\\ce{H^{+}}] = m^{*}X + \\pu{p}K_{\\ce{SH}^{+}}\\] is the activity function \\[\\log_{10}(\\frac{\\gamma_{\\rm{S}}\\ \\gamma_{\\rm{H}^{+}}}{\\gamma_{\\rm{SH}^{+}}})\\] for an arbitrary reference base. The function \\(X\\) is called the excess acidity because it gives a measure of the difference between the acidity of a solution and that of an ideal solution of the same concentration. In practice \\[X = -(\\rm{H}_{0} + \\log_{10}[\\rm{H}^{+}])\\] and \\[m^{*} = 1 - \\mathit{\\Phi}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Cox–Yates equation" .

goldbook:C01387 a skos:Concept ;
    skos:altLabel "catalytic cracking",
        "hydrocarbon cracking" ;
    skos:definition "The thermal or catalytic decomposition of a compound such as a hydrocarbon into chemical species of smaller molecular weight." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cracking" .

goldbook:C01388 a skos:Concept ;
    skos:definition "A highly concentrated emulsion formed by creaming of a dilute emulsion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cream" .

goldbook:C01389 a skos:Concept ;
    skos:definition "The macroscopic separation of a dilute emulsion into a highly concentrated emulsion, in which interglobular contact is important, and a continuous phase under the action of gravity or a centrifugal field. This separation usually occurs upward, but the term may still be applied if the relative densities of the dispersed and continuous phases are such that the concentrated emulsion settles downward." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "creaming" .

goldbook:C01390 a skos:Concept ;
    skos:definition "The volume of cream formed in an emulsion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cream volume" .

goldbook:C01391 a skos:Concept ;
    skos:definition "The monomethylphenols and their derivatives formed by substitution on the ring with substituents other than $\\ce{–OH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cresols" .

goldbook:C01393 a skos:Concept ;
    skos:altLabel "threshold energy" ;
    skos:definition "A chemical reaction cannot occur, except by quantum-mechanical tunnelling unless the total energy available is greater than a certain energy, which is known as the critical energy, or the threshold energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical energy" .

goldbook:C01394 a skos:Concept ;
    skos:definition "Minimum energy to excite a specific analytical signal. The term is most frequently used in connection with the generation of X-ray spectra, designating the ionization (binding) energy of the orbital on which the transition ends." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical excitation energy" .

goldbook:C01395 a skos:Concept ;
    skos:definition "There is a relatively small range of concentrations separating the limit below which virtually no micelle are detected and the limit above which virtually all additional surfactant molecules form micelles. Many properties of surfactant solutions, if plotted against the concentration, appear to change at a different rate above and below this range. By extrapolating the loci of such a property above and below this range until they intersect, a value may be obtained known as the critical micellization concentration (critical micelle concentration), symbol \\(c_{\\rm{M}}\\), abbreviation cmc (or c.m.c.). As values obtained using different properties are not quite identical, the method by which the cmc is determined should be clearly stated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical micelle concentration" .

goldbook:C01396 a skos:Concept ;
    skos:definition "The temperature and pressure at which the liquid and vapour intensive properties (density, heat capacity, etc.) become equal. It is the highest temperature (critical temperature) and pressure (critical pressure) at which both a gaseous and a liquid phase of a given compound can coexist." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical point" .

goldbook:C01397 a skos:Concept ;
    skos:definition "The minimum pressure which would suffice to liquefy a substance at its critical temperature. Above the critical pressure, increasing the temperature will not cause a fluid to vaporize to give a two-phase system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical pressure" .

goldbook:C01400 a skos:Concept ;
    skos:altLabel "consolute point" ;
    skos:definition "The point, with coordinates critical solution temperatures and critical composition, on a temperature-composition phase diagram at which the distinction between co-existent phases vanishes. In solid-solid, solid-liquid and liquid-liquid systems both upper and lower critical solution temperatures and corresponding 'critical solution compositions' can occur. Synonymous with consolute point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical solution point" .

goldbook:C01402 a skos:Concept ;
    skos:definition "That temperature, characteristic of each gas, above which it is not possible to liquefy a given gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical temperature" .

goldbook:C01403 a skos:Concept ;
    skos:definition "A film often thins gradually to a thickness at which it either ruptures or converts abruptly to an equilibrium film. This thickness is sometimes well enough defined statistically to be considered a critical thickness, \\(t_{\\rm{c}}\\) or \\(h_{\\rm{c}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical thickness of a film" .

goldbook:C01404 a skos:Concept ;
    skos:definition "In a system $\\ce{XC6H4GY}$ this is conjugation involving the substituent $\\ce{X}$, the benzene ring and the side-chain connective-plus-reaction site $\\ce{GY}$, i.e. either $\\ce{X}$ is a $+R$ group and $\\ce{GY}$ is a $-R$ group, or $\\ce{X}$ is a $-R$ group and $\\ce{GY}$ is a $+R$ group. In Hammett correlations this situation can lead to the need to apply exalted substituent constants \\(\\sigma ^{+}\\) or \\(\\sigma ^{-}\\), respectively, as in electrophilic or nucleophilic aromatic substitution, respectively. The term 'through resonance' is synonymous. Cross conjugation has also been used to describe the interactions occurring in 2-phenylallyl and similar systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-conjugation" .

goldbook:C01405 a skos:Concept ;
    skos:definition "Electric and magnetic fields with the electric field direction at right angles to the magnetic field direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crossed electric and magnetic fields" .

goldbook:C01407 a skos:Concept ;
    skos:definition "Method of operating a filtration device where retained fluid is circulated over the membrane (filter) surface thus preventing undue build-up of filtered material on membrane (filter)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross-flow filtration" .

goldbook:C01408 a skos:Concept ;
    skos:definition "The usually reciprocal exchange of genetic material between chromosomes; part of natural genetic recombination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crossing over" .

goldbook:C01409 a skos:Concept ;
    skos:definition "A small region in a macromolecule from which at least four chains emanate, and formed by reactions involving sites or groups on existing macromolecules or by interactions between existing macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crosslink" .

goldbook:C01411 a skos:Concept ;
    skos:definition "The ability of substances other than the analyte to bind to the binding reagent and the ability of substances other than the binding reagent to bind the analyte in competitive binding assays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cross reaction" .

goldbook:C01420 a skos:Concept ;
    skos:definition "The displacement of an impurity from an extract phase by contact with a solution containing the main extractable solute. The main solute need not be present in a pure solution but should have a higher distribution ratio than the impurities present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crowding" .

goldbook:C01421 a skos:Concept ;
    skos:altLabel "coronands",
        "coronates" ;
    skos:definition "A molecular entity comprising a monocyclic ligand assembly that contains three or more binding sites held together by covalent bonds and capable of binding a guest in a central (or nearly central) position. The adducts formed are sometimes known as 'coronates'. The best known members of this group are macrocyclic polyethers, such as '18-crown-6', containing several repeating units $\\ce{–CR2–CR2O–}$ (where $\\ce{R}$ is most commonly $\\ce{H}$), and known as crown ethers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crown" .

goldbook:C01422 a skos:Concept ;
    skos:definition "A conformation of a saturated cyclic molecular entity, containing an even number (≥8) of atoms in the ring, in which these atoms lie alternately in each of two parallel planes and are symmetrically equivalent (\\(D_{4\\rm{d}}\\) for cyclooctane, \\(D_{5\\rm{d}}\\) for cyclodecane etc). It is analogous to the chair conformation of cyclohexane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crown conformation" .

goldbook:C01423 a skos:Concept ;
    skos:definition "A deposit or emulsion at the interface between two partially settled phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crud" .

goldbook:C01424 a skos:Concept ;
    skos:definition "Low temperature processes, apparatus, etc.; usually applied to systems operated at the temperature of liquid nitrogen, helium or other condensed gas which boils at a very low temperature (at atmospheric pressure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryogenic" .

goldbook:C01425 a skos:Concept ;
    skos:definition "The collection of trace compounds from gaseous media by co-condensation with a major constituent (e.g. water vapour, $\\ce{CO2}$, $\\ce{N2}$, $\\ce{Ar}$) of the matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryogenic sampling" .

goldbook:C01426 a skos:Concept ;
    skos:definition "A molecular entity comprising a cyclic or polycyclic assembly of binding sites that contains three or more binding sites held together by covalent bonds, and which defines a molecular cavity in such a way as to bind (and thus 'hide' in the cavity) another molecular entity, the guest (a cation, an anion or a neutral species), more strongly than do the separate parts of the assembly (at the same total concentration of binding sites). The adduct thus formed is called a 'cryptate'. The term is usually restricted to bicyclic or oligocyclic molecular entities. Example:  Corresponding monocyclic ligand assemblies crowns are sometimes included in this group, if they can be considered to define a cavity in which a guest can hide. The terms 'podand' and 'spherand' are used for certain specific ligand assemblies. Coplanar cyclic polydentate ligands, such as porphyrins, are not normally regarded as cryptands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cryptand" .

goldbook:C01428 a skos:Concept ;
    skos:definition "A spectrometer, in which diffraction by a crystal is used to obtain the energy spectra of electromagnetic radiation as well as of slow neutrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal diffraction spectrometer" .

goldbook:C01429 a skos:Concept ;
    skos:definition "The removal of a degeneracy of the energy levels of molecular entities or ions due to the lower site symmetry created by a crystalline environment. This term is sometimes incorrectly used synonymously with the term ligand field splitting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal field splitting" .

goldbook:C01430 a skos:Concept ;
    skos:definition "A solid state laser in which the active medium is composed of ionic species supported in a crystalline host. The first laser used a ruby crystal in which chromium ions as the active medium were supported in an aluminium oxide (sapphire) crystal. One of the most common crystal lasers involves neodymium atoms in a yttrium aluminium garnet host crystal (the YAG:Nd laser)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal laser" .

goldbook:C01431 a skos:Concept ;
    skos:definition "Electrodes which contain mobile ions of one sign and fixed sites of opposite sign. They may be homogeneous or heterogeneous.  Homogeneous membrane electrodes are ion-selective electrodes in which the membrane is a crystalline material prepared from either a single compound or a homogeneous mixture of compounds (i.e. $\\ce{Ag2S}$, $\\ce{AgI}$/$\\ce{Ag2S}$).Heterogeneous membrane electrodes are formed when an active substance, or mixture of active substances, is mixed with an inert matrix, such as silicone rubber or PVC, or placed on hydrophobized graphite or conducting epoxy, to form the heterogeneous sensing membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystalline electrodes" .

goldbook:C01434 a skos:Concept ;
    skos:definition "The formation of a crystalline solid from a solution, melt vapour or a different solid phase, generally by the lowering of the temperature or by evaporation of a solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystallization" .

goldbook:C01435 a skos:Concept ;
    skos:altLabel "CT" ;
    skos:definition "Abbreviation for charge-transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CT" .

goldbook:C01438 a skos:Concept ;
    skos:definition "The fraction of fissions which have resulted in the production of a nuclide either directly or indirectly, up to a specified time. If no time is specified, the yield is considered to be the asymptotic value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative fission yield" .

goldbook:C01439 a skos:Concept ;
    skos:definition "A sample collected over an extended period of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulative sample" .

goldbook:C01440 a skos:Concept ;
    skos:definition "Hydrocarbons (and by extension, derivatives formed by substitution) having three or more cumulative double bonds, e.g. $\\ce{R2C=C=C=CR2}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulenes" .

goldbook:C01441 a skos:Concept ;
    skos:definition "Heavy masses of dense cloud whose cumuliform summits rise in the forms of towers, the upper parts having a fibrous texture and often spreading out into the shape of an anvil; these clouds generally produce showers of rain and sometimes of snow, hail or soft hail, and often develop into thunderstorms; up to \\(12\\ 000\\ \\rm{m}\\); summits may be as cold as \\(\\pu{-50 ^{\\circ}C}\\); strong convective motions with vertical velocities of \\(3\\) to greater than \\(30\\ \\rm{m s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulonimbus cloud" .

goldbook:C01442 a skos:Concept ;
    skos:definition "Detached, dense clouds with a dome-shaped upper surface with sharp-edged, rounded protuberances and a nearly horizontal base; \\(600{-}6000\\ \\rm{m}\\) or more; convective motion with rising, large bubbles of warm air with vertical speeds of \\(1{-}5\\ \\rm{m s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cumulus cloud" .

goldbook:C01443 a skos:Concept ;
    skos:definition "A vertical shaft furnace used for melting metals; the melting of ores is accomplished in a blast furnace." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cupola" .

goldbook:C01444 a skos:Concept ;
    skos:definition "Non-SI unit of radioactivity, \\(\\rm{Ci}\\approx 3.7\\times 10^{10}\\ \\rm{Bq}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "curie" .

goldbook:C01452 a skos:Concept ;
    skos:definition "The current density \\(j_{\\mathbf{B}}\\) of a species B in a given point of the solution is obtained by multiplying the flux density of that species at the given point by the Faraday constant \\(F\\) and by the charge number \\(z_{\\rm{B}}\\) of the species: \\[j_{\\mathbf{B}} = z_{\\rm{B}}\\ F\\ N_{\\mathbf{B}}\\] where \\(j_{\\mathbf{B}}\\) is a vector which indicates the direction in which the charges transported by the species B flow and which gives the number of these charges going through a plane oriented perpendicular to the vector, divided by time and by area, and \\(N_{\\mathbf{B}}\\) is the flux density of a minor constituent of the solution with respect to a fixed frame of reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "current density" .

goldbook:C01456 a skos:Concept ;
    skos:definition "The ratio of current density at a point X on an interface to the average current density (\\(\\frac{j_{\\rm{x}}}{j}\\)) is called the 'relative local current density'. The current distribution is described by the function \\(\\frac{j_{\\rm{x}}}{j} = f(x)\\) (or more generally, \\(\\frac{j_{\\rm{x}}}{j} = f(x,\\,y,\\,z)\\) where \\(x\\) or \\((x,\\,y,\\,z)\\) are the coordinates of the points of the electrode-solution interface. The 'primary current distribution' is that which establishes itself when the influence of overpotential is negligible. The 'secondary current distribution' is that which establishes itself when the influence of the overpotential cannot be neglected but concentration overpotential is negligible. The secondary distribution is often described in terms of dimensionless numbers of the form \\[\\mathrm{Wa}=\\frac{\\kappa }{l}\\ \\frac{\\mathrm{d}\\eta }{\\mathrm{d}j}\\] where \\(\\kappa \\) is the conductivity of the solution, \\(\\frac{\\rm{d}\\eta }{\\rm{d}j}\\) the slope of the overpotential-current curve under the above conditions and \\(l\\) a characteristic length of the system, for instance the radius of a disc electrode. \\(\\mathrm{Wa}\\) is the 'Wagner number'. It is a quantity which determines the throwing power and characterizes the equalizing influence of overpotential on the current distribution. In electroplating the 'throwing power' is qualitatively defined as 'the ability of a solution to deposit metal uniformly upon a cathode of irregular shape'. The 'tertiary current distribution' is that which establishes itself when the influence of the overpotential (including concentration overpotential) cannot be neglected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "current distribution" .

goldbook:C01458 a skos:Concept ;
    skos:definition "If several reactions take place simultaneously at the electrode a partial electrode current density (c.d.) \\(j_{k}\\) can be assigned to each reaction. It is given by the stoichiometry of the reaction and by the amount of substance of B reacting (per unit time and per unit electrode area) in the reaction considered. The current efficiency of reaction \\(k\\), \\(\\varepsilon_{k}\\) is defined as the ratio of \\(j_{k}\\) to the total c.d.: \\[\\varepsilon_{k}=\\frac{j_{k}}{\\sum_{m} j_{m}}\\] Note that \\(\\varepsilon_{k}\\) may be larger than one if cathodic and anodic reactions take place simultaneously at the same electrode. However, \\(\\varepsilon_{k}\\) still gives correctly the product yield, which is the quantity of industrial interest. The product yield is the amount of substance of B produced per unit charge and is equal to \\(\\frac{\\varepsilon_{k}\\  u _{B,k}}{n_{k}\\ F}\\) (in the absence of a chemical reaction which is consecutive to the electrode reaction and which consumes or produces species B). \\(n_{k}\\) is the charge number of electrode reaction \\(k\\). Note that in the case of simultaneous electrode reactions the distribution of the partial c.d. \\(j_{k}\\) may be different from that of the total c.d., i.e. the function \\(\\frac{\\left(j_{k}\\right)_{\\rm{x}}}{j}=f_{k}\\left(x\\right)\\) may be different from \\(\\frac{j_{\\rm{x}}}{j} = f(x)\\). In electroplating the term 'metal distribution' is sometimes used to designate the distribution \\(f_{k}\\left(x\\right)\\) of the partial c.d. for metal deposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "current efficiency" .

goldbook:C01480 a skos:Concept ;
    skos:definition "In a chemical reaction that yields one product (X) from one conformational isomer (A') and a different product (Y) from another conformational isomer (A'') (and provided these two isomers are rapidly interconvertible relative to the rate of product formation, whereas the products do not undergo interconversion) the product composition is not in direct proportion to the relative concentrations of the conformational isomers in the substrate; it is controlled only by the difference in standard free energies (\\(\\unicode[Times]{x3B4} \\Delta ^{\\ddagger }G\\)) of the respective transition states.  It is also true that the product composition is formally related to the relative concentrations of the conformational isomers A' and A'' (i.e. the conformational equilibrium constant) and the respective rate constants of their reactions; these parameters are generally — though not invariably — unknown. The diagram below represents the energetic situation for transformation of interconverting isomers A and A' into products X and Y." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Curtin–Hammett principle" .

goldbook:C01481 a skos:Concept ;
    skos:definition "The size of particles at which the retention efficiency of an instrument device drops below a specified value under defined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cut off" .

goldbook:C01482 a skos:Concept ;
    skos:definition "An optical device which only permits the transmission of radiation of wavelengths that are longer than or shorter than a specified wavelength. Usually, the term refers to devices which transmit radiation of wavelengths longer than the specified wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cut-off filter" .

goldbook:C01484 a skos:Concept ;
    skos:altLabel "CW" ;
    skos:definition "Abbreviation for continuous wave, i.e. non-pulsed source of electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CW" .

goldbook:C01485 a skos:Concept ;
    skos:definition "Salts and esters of cyanic acid, $\\ce{HOC#N}$, e.g. $\\ce{KOCN}$ potassium cyanate, $\\ce{PhOCN}$ phenyl cyanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanates" .

goldbook:C01486 a skos:Concept ;
    skos:definition "Salts and $C$-organyl derivatives of hydrogen cyanide, $\\ce{HC#N}$, e.g. $\\ce{CH3C#N}$ methyl cyanide (acetonitrile), $\\ce{NaCN}$ sodium cyanide, $\\ce{PhC(=O)CN}$ benzoyl cyanide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanides" .

goldbook:C01487 a skos:Concept ;
    skos:definition "Synthetic dyes with the general formula $\\ce{R2N[CH=CH]_{n}CH=N^{+}R2 }$ $\\ce{R2N^{+}=CH[CH=CH]_{n}NR2}$ ($n$ is a small number) in which the nitrogen and part of the conjugated chain usually form part of a heterocyclic system, such as imidazole, pyridine, pyrrole, quinoline and thiazole, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanine dyes" .

goldbook:C01488 a skos:Concept ;
    skos:definition "Compounds able to produce cyanide; examples are the cyanogenic glycosides such as amygdalin in peach and apricot stones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanogenic" .

goldbook:C01489 a skos:Concept ;
    skos:definition "Alcohols substituted by a cyano group, most commonly, but not limited to, examples having a cyano and a hydroxy group attached to the same carbon atom, formally derived from aldehydes or ketones by the addition of hydrogen cyanide. An individual cyanohydrin can systematically be named as a hydroxy nitrile, e.g. $\\ce{(CH3)2C(OH)C#N}$ 'acetone cyanohydrin' (2-hydroxy-2-methylpropanenitrile), $\\ce{HOCH2CH2C#N}$ 'ethylene cyanohydrin' (3-hydroxypropanenitrile)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyanohydrins" .

goldbook:C01490 a skos:Concept ;
    skos:altLabel "cosphere" ;
    skos:definition "That part of a solution in the vicinity of a solute molecule in which the ordering of the solvent molecules is modified by the presence of the solute molecule. The term solvent 'cosphere' of the solute has also been used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cybotactic region" .

goldbook:C01492 a skos:Concept ;
    skos:altLabel "cyclic anhydrides" ;
    skos:definition "Acid anhydrides derived by loss of water between two oxoacid functions $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) (carboxylic, sulfonic, etc.) in the same molecule so as to close a ring. Oxo oxygen replacement analogues are included, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclic acid anhydrides" .

goldbook:C01493 a skos:Concept ;
    skos:definition "Hydroxylated cycloalkanes containing at least three hydroxy groups, each attached to a different ring carbon atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclitols" .

goldbook:C01494 a skos:Concept ;
    skos:definition "Formation of a ring compound from a chain by formation of a new bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclization" .

goldbook:C01495 a skos:Concept ;
    skos:definition "A prefix used in names to designate a ring structure, usually italicized in inorganic, but not in organic nomenclature. Examples:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclo-" .

goldbook:C01496 a skos:Concept ;
    skos:definition "A reaction in which two or more unsaturated molecules (or parts of the same molecule) combine with the formation of a cyclic adduct in which there is a net reduction of the bond multiplicity. The following two systems of notations have been used for the more detailed specification of cycloadditions, of which the second, more recent system [described under (2)] is preferred:   A(i + j + ...) cycloaddition is a reaction in which two or more molecules (or parts of the same molecule), respectively, provide units of i, j, ... linearly connected atoms: these units become joined at their respective termini by new $\\ce{\\upsigma\\!\\mbox{-}bonds}$ so as to form a cycle containing (i + j + ...) atoms. In this notation, (a) a Diels–Alder reaction is a (4+2) cycloaddition, (b) the initial reaction of ozone with an alkene is a (3+2) cycloaddition, and (c) the reaction shown below is a (2+2+2) cycloaddition. (N.B.: parentheses (...) are used in the description based on numbers of atoms.)   The symbolism [i + j + ...] for a cycloaddition identifies the numbers i, j, ... of electrons in the interacting units that participate in the transformation of reactants to products. In this notation the reaction (a) and (b) of the preceding paragraph would both be described as [2+4] cycloadditions, and (c) as a [2+2+2] cycloaddition. The symbol a or s (a = antarafacial, s = suprafacial) is often added (usually as a subscript after the number to designate the stereochemistry of addition to each fragment. A subscript specifying the orbitals, viz. $\\ce{\\upsigma\\!}$, $\\ce{\\uppi\\!}$ (sigma, pi) with their usual significance) or n (for an orbital associated with a single atom only), may be added as a subscript before the number. Thus the normal Diels–Alder reaction is a \\(\\left [4_{\\rm{a}}\\: +\\: 2_{\\rm{s}} \\right ]\\) or \\(\\left [_{\\pi }4_{\\rm{a}}\\: +\\: _{\\pi }2_{\\rm{s}} \\right ]\\) cycloaddition, whilst the reaction:  would be a \\(\\left [14_{\\rm{a}}\\:  +\\: 2_{\\rm{s}} \\right ]\\) or \\(\\left [_{\\pi }14_{\\rm{a}}\\:  +\\: _{\\pi }2_{\\rm{s}} \\right ]\\) cycloaddition. (N.B. Square brackets are used in the descriptions based on numbers of electrons.) Cycloadditions may be pericyclic reactions or (non-concerted stepwise reactions. The term 'dipolar cycloaddition' is used for cycloadditions of 1,3-dipolar compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cycloaddition" .

goldbook:C01497 a skos:Concept ;
    skos:definition "Saturated monocyclic hydrocarbons (with or without side chains), e.g. cyclobutane. Unsaturated monocyclic hydrocarbons having one endocyclic double or one triple bond are called cycloalkenes and cycloalkynes, respectively. Those having more than one such multiple bond are cycloalkadienes, cycloalkatrienes, etc. The inclusive terms for any cyclic hydrocarbons having any number of such multiple bonds are cyclic olefins or cyclic acetylenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cycloalkanes" .

goldbook:C01498 a skos:Concept ;
    skos:definition "Univalent groups derived from cycloalkanes by removal of a hydrogen atom from a ring carbon atom, e.g. 2-methylcyclopropyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cycloalkyl groups" .

goldbook:C01500 a skos:Concept ;
    skos:definition "Cyclic oligoglucosides containing five to ca. ten glucose residues in which an enclosed tubular space allows reception of a guest molecule to form a clathrate. The synonymous term Schardinger dextrins is not recommended. ($\\ce{\\upalpha\\!\\mbox{-}Cyclodextrin}$ has six glucose residues; $\\ce{\\upbeta\\!\\mbox{-}Cyclodextrin}$ has seven.) Semi-systematically $\\ce{\\upalpha\\!\\mbox{-}cyclodextrin}$ is called cyclomaltohexaose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclodextrins" .

goldbook:C01501 a skos:Concept ;
    skos:altLabel "cycloreversion",
        "retro-addition",
        "retroaddition",
        "retrocycloaddition" ;
    skos:definition "The reverse of cycloaddition. The term is preferred to the synonyms 'cycloreversion', 'retro-addition' and 'retrocycloaddition'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cycloelimination" .

goldbook:C01502 a skos:Concept ;
    skos:definition "A subclass of arenium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclohexadienyl cations" .

goldbook:C01503 a skos:Concept ;
    skos:altLabel "cyclone" ;
    skos:definition "A dust, grit or droplet separator utilizing essentially the centrifugal force derived from the motion of the gas. The flow of gases containing suspended particles into the device is transformed into a confined vortex from which centrifugal forces tend to drive the suspended particles to the wall of the cyclone body. The agglomerated particles are subsequently removed from the cyclone by gravitational action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclone collector" .

goldbook:C01504 a skos:Concept ;
    skos:definition "The term originally applied to compounds having two p-phenylene groups held face to face by $\\ce{–[CH2]_{n}\\bond{–}}$ bridges. It now designates compounds having (i) mancude-ring systems, or assemblies of mancude-ring systems, and (ii) atoms and/or saturated or unsaturated chains as alternate components of a large ring. E.g.(1,4)(1,4)cyclophane [or 1(1,4),4(1,4)-dibenzenacyclohexaphane].  Many chemists include in this class any bridged aromatic system, irrespective of the attachment positions of the bridge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclophanes" .

goldbook:C01505 a skos:Concept ;
    skos:definition "A polymerization in which the number of cyclic structures in the constitutional units of the resulting macromolecules is larger than in the monomer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclopolymerization" .

goldbook:C01507 a skos:Concept ;
    skos:definition "Compounds having rings of alternating silicon and nitrogen atoms:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclosilazanes" .

goldbook:C01508 a skos:Concept ;
    skos:definition "Compounds having rings of alternating silicon and oxygen atoms, e.g. 2,2-dimethylcyclotrisiloxane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclosiloxanes" .

goldbook:C01509 a skos:Concept ;
    skos:definition "A particle accelerator in which the particles travel in a succession of semicircular orbits of increasing radii under the influence of a magnetic field and are accelerated at the beginning of each such orbit by traversing an electric field produced by a high-frequency generator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cyclotron" .

goldbook:C01510 a skos:Concept ;
    skos:definition "Conjugated proteins containing haem as the prosthetic group and associated with electron transport and with redox processes. The terminal electron transport chain of oxidative respiration contains at least five different cytochromes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytochromes" .

goldbook:C05438 a skos:Concept ;
    skos:definition "Specifically the substituent constant for meta- and for para-substituents in benzene derivatives as defined by Hammett on the basis of the ionization constant of a substituted benzoic acid in water at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\), i.e. \\(\\log _{10}(\\frac{K_{\\rm{a}}}{K_{\\rm{a}}^{0}})\\), where \\(K_{\\rm{a}}\\) is the ionization constant of a m- or p-substituted benzoic acid and \\(K_{\\rm{a}}^{0}\\) that of benzoic acid itself. The term is also used as a collective description for related electronic substituent constants based on other standard reaction series, of which, \\(\\sigma ^{+}\\), \\(\\sigma ^{-}\\) and \\(\\sigma ^{0}\\) are typical; also constants which represent dissected electronic effects such as \\(\\sigma _{I}\\) and \\(\\sigma _{R}\\). For this purpose it might be better always to spell out the term in full, i.e. as 'Hammett sigma constant', and restrict \\(\\sigma \\)-constants to the scale of substituent constants which is based on benzoic acid. A large positive \\(\\sigma \\)-value implies high electron-withdrawing power by inductive and/or resonance effect, relative to H; a large negative \\(\\sigma \\)-value implies high electron-releasing power relative to H." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "σ-constant" .

goldbook:CT01038 a skos:Concept ;
    skos:definition "An ensemble of chemically identical molecular entities that can explore the same set of molecular energy levels on the time scale of the experiment. The term is applied equally to a set of chemically identical atomic or molecular structural units in a solid array. For example, two conformational isomers may be interconverted sufficiently slowly to be detectable by separate NMR spectra and hence to be considered to be separate chemical species on a time scale governed by the radiofrequency of the spectrometer used. On the other hand, in a slow chemical reaction the same mixture of conformers may behave as a single chemical species, i.e. there is virtually complete equilibrium population of the total set of molecular energy levels belonging to the two conformers. Except where the context requires otherwise, the term is taken to refer to a set of molecular entities containing isotopes in their natural abundance. The wording of the definition given in the first paragraph is intended to embrace both cases such as graphite, sodium chloride or a surface oxide, where the basic structural units may not be capable of isolated existence, as well as those cases where they are. In common chemical usage generic and specific chemical names (such as radical or hydroxide ion) or chemical formulae refer either to a chemical species or to a molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical species" .

goldbook:CT01101 a skos:Concept ;
    skos:altLabel "volume rate" ;
    skos:definition "Product of the concentration of a component in an output system and the volume flow rate of that output system divided by the concentration of this component in the input system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clearance" .

goldbook:CT06757 a skos:Concept ;
    skos:definition "Diffusion under the influence of a gradient in chemical composition. In concentrated solid solutions, e.g. $\\ce{A_{1-x}B_{x}}$, or in diffusion couples, the motion of one constituent causes a counterflow of the other constituent(s) or vacancies. In this case one can define a diffusion coefficient for the intermixing, which is called the chemical diffusion coefficient or interdiffusion coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical diffusion" .

goldbook:CT06762 a skos:Concept ;
    skos:definition "A hemeprotein which catalyses the disproportionation of dihydrogen peroxide to $\\ce{O2}$, and water; it also catalyses the oxidation of other compounds, such as ethanol, by dihydrogen peroxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "catalase" .

goldbook:CT06769 a skos:Concept ;
    skos:definition "A number of metal centres grouped close together which can have direct metal bonding interactions or interactions through a bridging ligand, but are not necessarily held together by these interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster" .

goldbook:CT06770 a skos:Concept ;
    skos:definition "The average static electric field experienced by an ion, molecule or atom in a crystal generated by all the other surrounding atoms, molecules, or ions. The concept introduced by becquerel and developed by Bethe has been extended to refer to the field generated by the ligands (anions or neutral species) surrounding a transition metal ion in a coordination compound. With the understatement that some covalency may exist in the metal-ligand bond, it is often referred to as ligand field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal field" .

goldbook:CT06777 a skos:Concept ;
    skos:altLabel "CD" ;
    skos:definition "A spectroscopic method which measures the difference in absorbance of left- and right-handed circularly polarised light by a material, as a function of the wavelength. Most biological molecules, including proteins and nucleic acids, are chiral and show circular dichroism in their ultraviolet absorption bands, which may be used as an indication of secondary structure. Metal centres that are bound to such molecules, even if they have no inherent chirality, usually exhibit CD in absorption bands associated with ligand-based or ligand-metal charge-transfer transitions. CD is frequently used in combination with absorption and MCD studies to assign electronic transitions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "circular dichroism" .

goldbook:CT06814 a skos:Concept ;
    skos:definition "Protein to which a specific ligand or hapten is conjugated.Unlabeled protein introduced into an assay at relatively high concentrations which distributes in a fractionation process in the same manner as labeled protein analyte, present in very low concentrations.Protein added to prevent non-specific interaction of reagents with surfaces, sample components, and each other.Protein found in cell membranes, which facilitates transport of a ligand across the membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carrier protein" .

goldbook:CT06815 a skos:Concept ;
    skos:definition "Airborne concentration of a potentially toxic substance which should never be exceeded in a worker’s breathing zone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceiling value" .

goldbook:CT06816 a skos:Concept ;
    skos:definition "Defined unique population of cells obtained by culture from a primary source through numerous generations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cell line" .

goldbook:CT06817 a skos:Concept ;
    skos:definition "Adverse effects following chronic exposure.Effects which persist over a long period of time whether or not they occur immediately upon exposure or are delayed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chronic toxicity" .

goldbook:CT06818 a skos:Concept ;
    skos:definition "Mathematical process leading to a model of transport of a substance in terms of compartments and rate constants, usually taking the form \\[C=A\\ \\rm{e}^{-\\alpha\\ t}+B\\ \\rm{e}^{-\\beta \\ t}\\rm{...}\\] where each exponential term represents one experiment. \\(C\\) is the substance concentration; \\(A\\), \\(B\\),… are proportionality constants; \\(\\alpha \\), \\(\\beta \\),… are rate constants; and \\(t\\) is time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compartmental analysis" .

goldbook:CT06819 a skos:Concept ;
    skos:definition "One of two or more substances related to each other by origin, structure, or function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "congener" .

goldbook:CT06820 a skos:Concept ;
    skos:definition "Investigation yielding the no observed adverse effect level that is used by the USEPA as the basis of the reference dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical study" .

goldbook:CT06821 a skos:Concept ;
    skos:definition "Member of a superfamily of heme-containing monooxygenases involved in xenobiotic metabolism, cholesterol biosynthesis, and steroidogenesis, in eukaryotic organisms found mainly in the endoplasmic reticulum and inner mitochondrial membrane of cells. ‘P450’ refers to a feature in the carbon monoxide absorption difference spectrum at \\(450\\ \\rm{nm}\\) caused by the presence of a thiolate in the axial position of the heme opposite to the carbon monoxide ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cytochrome P450" .

goldbook:CT06850 a skos:Concept ;
    skos:definition "Formation of cavities, when a polymer is stressed, which contain load-bearing fibrils spanning the gap between the surfaces of each cavity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crazing" .

goldbook:CT06857 a skos:Concept ;
    skos:definition "The temperature at which the transition between the mesophase with the highest temperature range and the isotropic phase occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clearing point" .

goldbook:CT06859 a skos:Concept ;
    skos:definition "Specific form of an element defined as to isotopic composition, electronic or oxidation state, and/or complex or molecular structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical species" .

goldbook:CT06860 a skos:Concept ;
    skos:definition "Volume of blood or plasma or mass of an organ effectively cleared of a substance by elimination (metabolism and excretion) divided by time of elimination.Note:Total clearance is the sum of the clearances of each eliminating organ or tissue for a given substance.(in pulmonary toxicology) Volume or mass of lung cleared divided by time of elimination; used qualitatively to describe removal of any inhaled substance which deposits on the lining surface of the lung.(in renal toxicology) Quantification of the removal of a substance by the kidneys by the processes of filtration and secretion; clearance is calculated by relating the rate of renal excretion to the plasma concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clearance" .

goldbook:CT06863 a skos:Concept ;
    skos:definition "Membrane having chemically or structurally distinct layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composite membrane" .

goldbook:CT06864 a skos:Concept ;
    skos:definition "Flow through a membrane module in which the fluids on the upstream and downstream sides of the membrane move parallel to the membrane surface but in opposite directions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "counter-current flow" .

goldbook:CT06916 a skos:Concept ;
    skos:definition "A column packing, which is a single entity, rather than being composed of individual particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous bed packing" .

goldbook:CT06917 a skos:Concept ;
    skos:definition "Mass fraction of the packing material which is carbon. Usually taken as a guide to the extent of alkyl substitution on the surface. Usually reported as percentage carbon determined using elemental analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbon loading" .

goldbook:CT06920 a skos:Concept ;
    skos:definition "A stationary phase which incorporates a chiral selector. If not a constituent of the stationary phase as a whole, the chiral selector can be chemically bonded to (chiral bonded stationary phase ) or immobilised onto the surface of a solid support or column wall (chiral coated stationary phase), or simply dissolved in the liquid stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral stationary phase" .

goldbook:CT06930 a skos:Concept ;
    skos:definition "A mobile phase containing a chiral selector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral mobile phase" .

goldbook:CT06931 a skos:Concept ;
    skos:definition "The chiral component of the separation system capable of interacting enantioselectively with the enantiomers to be separated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chiral selector" .

goldbook:CT06937 a skos:Concept ;
    skos:definition "Distribution isotherm, the slope of which is continuously decreasing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "convex isotherm" .

goldbook:CT06938 a skos:Concept ;
    skos:definition "Distribution isotherm, the slope of which is continuously increasing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concave isotherm" .

goldbook:CT06948 a skos:Concept ;
    skos:definition "Chemometrics is the application of statistics to the analysis of chemical data (from organic, analytical or medicinal chemistry) and design of chemical experiments and simulations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemometrics" .

goldbook:CT06949 a skos:Concept ;
    skos:definition "CLOGP values are calculated 1-octanol/water partition coefficients, frequently used in structure-property correlation or quantitative structure-activity relationship (SPC/QSAR) studies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "CLOGP values" .

goldbook:CT06950 a skos:Concept ;
    skos:definition "Cluster analysis is the clustering, or grouping, of large data sets (e.g., chemical and/or pharmacological data sets) on the basis of similarity criteria for appropriately scaled variables that represent the data of interest. Similarity criteria (distance based, associative, correlative, probabilistic) among the several clusters facilitate the recognition of patterns and reveal otherwise hidden structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cluster analysis" .

goldbook:CT06951 a skos:Concept ;
    skos:altLabel "CoMFA" ;
    skos:definition "Comparative Molecular Field Analysis (CoMFA) is a 3D-QSAR method that uses statistical correlation techniques for the analysis of the quantitative relationship between the biological activity of a set of compounds with a special alignment, and their three-dimensional electronic and steric properties. Other properties, such as hydrophobicity and H-bonding, can also be incorporated into the analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "comparative molecular field analysis" .

goldbook:CT06952 a skos:Concept ;
    skos:definition "Computational chemistry is a discipline using mathematical methods for the calculation of molecular properties or for the simulation of molecular behaviour. It also includes, e.g., synthesis planning, database searching, combinatorial library manipulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "computational chemistry" .

goldbook:CT06953 a skos:Concept ;
    skos:altLabel "CADD" ;
    skos:definition "Computer-assisted drug design involves all computer-assisted techniques used to discover, design and optimize biologically active compounds with a putative use as drugs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "computer-assisted drug design" .

goldbook:CT06954 a skos:Concept ;
    skos:altLabel "CAMD" ;
    skos:definition "Computer-assisted molecular design involves all computer-assisted techniques used to discover, design and optimize compounds with desired structure and properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "computer-assisted molecular design" .

goldbook:CT06955 a skos:Concept ;
    skos:altLabel "CAMM" ;
    skos:definition "Computer-assisted molecular modeling is the investigation of molecular structures and properties using computational chemistry and graphical visualization techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "computer-assisted molecular modeling" .

goldbook:CT06956 a skos:Concept ;
    skos:definition "Conformational analysis consists of the exploration of energetically favourable spatial arrangements (shapes) of a molecule (conformations) using molecular mechanics, molecular dynamics, quantum chemical calculations or analysis of experimentally-determined structural data, e.g, NMR or crystal structures.Molecular mechanics and quantum chemical methods are employed to compute conformational energies, whereas systematic and random searches, Monte Carlo, molecular dynamics, and distance geometry are methods (often combined with energy minimization procedures) used to explore the conformational space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conformational analysis" .

goldbook:CT07009 a skos:Concept ;
    skos:definition "When forces acting between two atoms or groups of atoms lead to the formation of a stable independent molecular entity, a chemical bond is considered to exist between these atoms or groups. The principal characteristic of a bond in a molecule is the existence of a region between the nuclei of constant potential contours that allows the potential energy to improve substantially by atomic contraction at the expense of only a small increase in kinetic energy. Not only directed covalent bonds characteristic of organic compounds, but also bonds such as those existing between sodium cations and chloride anions in a crystal of sodium chloride or the bonds binding aluminium to six molecules of water in its environment, and even weak bonds that link two molecules of $\\ce{O2}$ into $\\ce{O4}$, are to be attributed to chemical bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical bond" .

goldbook:CT07010 a skos:Concept ;
    skos:definition "Even-electron atomic or molecular systems whose electron configurations consist of doubly occupied orbitals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "closed shell molecular systems" .

goldbook:CT07011 a skos:Concept ;
    skos:definition "A single-step reaction through which reactants are directly transformed into products, i.e., without involvement of any intermediates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concerted reaction" .

goldbook:CT07012 a skos:Concept ;
    skos:definition "The orbital symmetry control of concerted reactions; this requires transformation of the molecular orbitals of reactants into those of products to proceed continuously by following a reaction path along which the symmetry of these orbitals remains unchanged. Reactions which adhere to this requirement are classified as symmetry-allowed reactions, and those which do not as symmetry-forbidden reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conservation of orbital symmetry" .

goldbook:CT07013 a skos:Concept ;
    skos:definition "The potential energy component corresponding to the electrostatic interaction between each pair of charged particles: \\[V=\\frac{1}{4\\: \\pi\\: \\varepsilon_{0}}\\ \\sum _{i}\\sum _{j \\lt i}e_{i}\\ e_{j}\\ \\Delta r_{ij}\\] where \\(\\varepsilon _{0}\\) is the permittivity of a vacuum, \\(\\Delta r_{ij}\\) is the distance between the two particles, and \\(e_{i}\\) and \\(e_{j}\\) are the charges on particles \\(i\\) and \\(j\\). In molecular orbital theory, the electrostatic repulsion between the two electrons occupying the orbitals \\(\\Psi _{i}\\) and \\(\\Psi _{j}\\). In the Hartree–Fock method, the mean Coulomb repulsion is determined by the value of the coulomb integral \\[J_{ij}=\\int \\int \\Psi _{i\\rm{*}}\\left(\\mathbf{r}_{1}\\right)\\ \\Psi _{i}\\left(\\mathbf{r}_{1}\\right)\\ \\left(\\frac{e^{2}}{r_{12}}\\right)\\ \\Psi _{j\\rm{*}}\\left(\\mathbf{r}_{2}\\right)\\ \\Psi _{j}\\left(\\mathbf{r}_{2}\\right)  \\ \\mathrm{d}\\mathbf{r}_{1} \\ \\mathrm{d}\\mathbf{r}_{2} = \\lt ij|ij \\gt\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Coulomb repulsion" .

goldbook:CT07014 a skos:Concept ;
    skos:altLabel "CC",
        "CC method" ;
    skos:definition "A method employed in ab initio quantum mechanical calculations providing for a higher-level treatment of electron correlation beyond MP4." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "coupled cluster method" .

goldbook:CT07016 a skos:Concept ;
    skos:definition "Model of organic reactivity that generates a reaction profile from curves that describe the energies of reactant, product, and intermediate electronic configurations (or, alternatively, reactant, product and intermediate electronic states) as a function of the reaction coordinate. The crossing reflects the electronic reorganization that accompanies the transformation of reactants and products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "curve-crossing model" .

goldbook:CT07134 a skos:Concept ;
    skos:definition "Process consisting of a chemical reaction that generates a species that catalyzes another reaction and also the succeeding catalyzed reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical amplification" .

goldbook:CT07135 a skos:Concept ;
    skos:definition "Process by which at least one feature of the chemical constitution of a polymer is changed by chemical reaction(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical modification" .

goldbook:CT07136 a skos:Concept ;
    skos:definition "Reaction involving sites or groups on existing macromolecules or an interaction between existing macromolecules that results in the formation of a small region in a macromolecule from which at least four chains emanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crosslinking" .

goldbook:CT07137 a skos:Concept ;
    skos:definition "Chemical process of converting a prepolymer or a polymer into a polymer of higher molar mass and then into a network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "curing" .

goldbook:CT07154 a skos:Concept ;
    skos:definition "Polymer containing ligand groups capable of forming bonds (or other attractive interactions) between two or more separate binding sites within the same ligand group and a single atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chelating polymer" .

goldbook:CT07170 a skos:Concept ;
    skos:definition "Polymeric material that exhibits bulk electric conductivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conducting polymer" .

goldbook:CT07200 a skos:Concept ;
    skos:definition "Polymer composed of positively charged macromolecules and an equivalent amount of counter-anions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cationic polymer" .

goldbook:CT07201 a skos:Concept ;
    skos:definition "Electrically-conducting composite comprising a non-conducting polymer matrix and an electrically-conducting material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conducting polymer composite" .

goldbook:CT07202 a skos:Concept ;
    skos:definition "Concentration of ionic groups in an ionomer matrix above which ionic aggregation occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "critical ion-concentration in an ionomer" .

goldbook:CT07339 a skos:Concept ;
    skos:altLabel "CIDEP" ;
    skos:definition "Non-Boltzmann electron spin-state population produced in thermal or photochemical reactions, either from a combination of radical pairs (called radical-pair mechanism), or directly from the triplet state (called triplet mechanism) and detectable by ESR spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically induced dynamic electron polarization" .

goldbook:CT07340 a skos:Concept ;
    skos:altLabel "CIEEL",
        "catalyzed chemiluminescence" ;
    skos:definition "Type of luminescence resulting from a thermal electron-transfer reaction. Also called catalyzed chemiluminescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically initiated electron exchange luminescence" .

goldbook:CT07341 a skos:Concept ;
    skos:definition "Ability of a colourless or slightly coloured photochromic material to develop colour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colourability" .

goldbook:CT07342 a skos:Concept ;
    skos:definition "Series of ordered numbers that represents observable gradations of a given attribute or gradations of a combination of attributes of color perception." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "color scale" .

goldbook:CT07343 a skos:Concept ;
    skos:altLabel "CASSCF" ;
    skos:definition "Computational scheme employed in multiconfigurational SCF theory especially suitable for studies of reactivity of excited states. The wavefunction is defined by selecting the set of active orbitals involved in the excitation or chemical reaction under investigation and is constructed as a linear expansion in the set of configuration functions that can be generated by occupying the active orbitals in all ways consistent with an overall spin and space symmetry (full configuration interaction, CI)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complete active space self-consistent field" .

goldbook:CT07344 a skos:Concept ;
    skos:altLabel "CASPT2" ;
    skos:definition "Theoretical scheme suitable for computations of accurate excitation energies and reaction barriers. In the first step, electron correlation is taken into account only to a certain extent by using a CASSCF formalism (the so called non-dynamic correlation), whereas the remaining electron correlation (the so called dynamic correlation) is included through the use of second-order perturbation theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "complete active space self-consistent field second-order perturbation theory" .

goldbook:CT07345 a skos:Concept ;
    skos:definition "Aspects of research that address the study of photochemical events by means of computer simulations using specialized software tools and strategies in order to get an understanding of the process at a microscopic level. The aim is to uncover the mechanism of known photochemical processes, design new photochemical systems, and predict molecular properties that are experimentally inaccessible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "computational photochemistry" .

goldbook:CT07346 a skos:Concept ;
    skos:definition "Loss of emission anisotropy due to transfer of electronic excitation from photo-selected molecules to other molecules with different orientations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "concentration depolarization" .

goldbook:CT07347 a skos:Concept ;
    skos:definition "Point of crossing between two electronic states of the same spin multiplicity (most commonly singlets or triplets)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conical intersection" .

goldbook:CT07348 a skos:Concept ;
    skos:altLabel "CW",
        "CW laser" ;
    skos:definition "CW operation of a laser means that the laser is continuously pumped and continuously emits electromagnetic radiation. The emission can occur in a single cavity mode or on multiple modes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "continuous wave laser" .

goldbook:CT07349 a skos:Concept ;
    skos:definition "Product of the quantum yield by the absorption cross-section, \\(\\sigma \\ \\varPhi \\). SI unit is \\(\\pu{m2}\\); commonly expressed in \\(\\pu{cm2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "conversion cross-section" .

goldbook:CT07350 a skos:Concept ;
    skos:definition "Photochemical process in the crystal lattice of a photoactive compound or of a chromophore in the crystal lattice of host molecules. Often asymmetric photochemistry takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crystal photochemistry" .

goldbook:CT07351 a skos:Concept ;
    skos:definition "Optical device that only permits the transmission of radiation of wavelength shorter than a specified wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "cut-on filter" .

goldbook:CT07503 a skos:Concept ;
    skos:definition "Ability of functional groups present within a polymer or polymer network to participate in chemical reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemical functionality" .

goldbook:CT07504 a skos:Concept ;
    skos:definition "Number of covalent bonds emanating from a constitutional unit of an oligomer molecule or a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "connectivity" .

goldbook:CT07518 a skos:Concept ;
    skos:definition "Gel in which the network component comprises particles of colloidal dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal gel" .

goldbook:CT07539 a skos:Concept ;
    skos:definition "Chemically bonded hybrid material which is a crosslinked organic–inorganic polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramer" .

goldbook:CT07540 a skos:Concept ;
    skos:definition "Rigid material that consists of an infinite three-dimensional network of sintered crystalline grains comprising metals bonded to carbon, nitrogen or oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramic" .

goldbook:CT07541 a skos:Concept ;
    skos:altLabel "pre-ceramic",
        "pre-ceramic material" ;
    skos:definition "Material that is converted to a ceramic through pyrolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramic precursor" .

goldbook:CT07542 a skos:Concept ;
    skos:definition "Polymer composite consisting of a polymer continuous phase and disperse phase domains of microscopic ceramic particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramic-reinforced polymer" .

goldbook:CT07543 a skos:Concept ;
    skos:definition "Mass of ceramic expressed as a percentage of the mass of the ceramic precursor used in the ceramization process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramic yield" .

goldbook:CT07545 a skos:Concept ;
    skos:definition "Multicomponent material comprising multiple, different (non-gaseous) phase domains in which at least one type of phase domain is a continuous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "composite" .

goldbook:CT07546 a skos:Concept ;
    skos:definition "Time-dependent change of the dimensions of a material under a constant load." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "creep" .

goldbook:CT07554 a skos:Concept ;
    skos:altLabel "chemically bonded hybrid material" ;
    skos:definition "Hybrid material in which the different components are bonded to each other by covalent or partially covalent bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chemically bonded hybrid" .

goldbook:CT07555 a skos:Concept ;
    skos:altLabel "polymer-clay composite",
        "polymer-clay hybrid" ;
    skos:definition "Organic–inorganic composite material in which one of the components is a clay, the particles of which are dispersed in a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "clay hybrid" .

goldbook:CT07563 a skos:Concept ;
    skos:definition "Network comprising particles of colloidal dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal network" .

goldbook:CT07581 a skos:Concept ;
    skos:definition "Immiscible polymer blend that exhibits macroscopically uniform physical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "compatible polymer blend" .

goldbook:CT07593 a skos:Concept ;
    skos:definition "Interlocking of polymer chains in a polymer material forming a transient or permanent network junction over the time-scale of the measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "chain entanglement" .

goldbook:CT07596 a skos:Concept ;
    skos:definition "Number of crosslinks per unit volume in a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crosslink density" .

goldbook:CT07597 a skos:Concept ;
    skos:definition "Site on a macromolecule or region in a polymer material that takes part in the formation of chemical or physical crosslinks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "crosslinking site" .

goldbook:CT07609 a skos:Concept ;
    skos:definition "Process in which a metal oxide is reduced in the presence of carbon or a carbon-containing compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "carbo-reduction" .

goldbook:CT07610 a skos:Concept ;
    skos:definition "Process in which a ceramic precursor is converted into a ceramic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ceramization" .

goldbook:CT07612 a skos:Concept ;
    skos:definition "Sol-gel processing in which a network of precipitated colloidal particles is treated by a conventional processing technique, such as cold pressing, hot pressing or sintering, in order to produce a ceramic article." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "colloidal processing" .

goldbook:D01511 a skos:Concept ;
    skos:altLabel "delta, lambda" ;
    skos:definition "Designations of stereoisomers of tris(didentate) metal complexes and other octahedral complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Δ, Λ" .

goldbook:D01513 a skos:Concept ;
    skos:altLabel "+",
        "-",
        "minus",
        "plus" ;
    skos:definition "Obsolete (usage strongly discouraged) alternatives for, respectively, the prefixes (+)- and (−)- [used to designate the sign of optical rotation of enantiomers under specified condition (and hence to distinguish the enantiomers)] and (±)- for a racemate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "d, l, dl" .

goldbook:D01514 a skos:Concept ;
    skos:definition "Non-SI unit of mass (symbol \\(\\mathrm{Da}\\)), equal to the unified atomic mass unit (atomic mass constant). It is often used in biochemistry and molecular biology although it was never approved by the Conférence Général des Poids et Mesures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dalton" .

goldbook:D01517 a skos:Concept ;
    skos:altLabel "photochemistry without light" ;
    skos:definition "Chemical reactions involving electronically excited molecular entities which are generated thermally rather than by absorption of electromagnetic radiation. The use of this term is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dark photochemistry" .

goldbook:D01518 a skos:Concept ;
    skos:altLabel "darkness reaction" ;
    skos:definition "A chemical reaction that does not require or depend on the presence of light. Contrasts with a photochemical reaction which is initiated by light absorption by one or more of the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dark reaction" .

goldbook:D01521 a skos:Concept ;
    skos:definition "The process of transforming the initial representation of a spectrometer output into a form which is amenable to interpretation; for example, a bar graph or a table of ion currents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "data reduction" .

goldbook:D01523 a skos:Concept ;
    skos:definition "The coordination bond formed upon interaction between molecular species, one of which serves as a donor and the other as an acceptor of the electron pair to be shared in the complex formed, e.g, the $\\ce{N\\!\\rightarrow\\!B}$ bond in $\\ce{H3N\\!\\rightarrow\\!BH3}$. In spite of the analogy of dative bonds with covalent bonds, in that both types imply sharing a common electron pair between two vicinal atoms, the former are distinguished by their significant polarity, lesser strength, and greater length. The distinctive feature of dative bonds is that their minimum-energy rupture in the gas phase or in inert solvent follows the heterolytic bond cleavage path." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dative bond" .

goldbook:D01524 a skos:Concept ;
    skos:definition "An electrically charged product of reaction of a particular parent ion. In general such ions have a direct relationship to a particular precursor ion and indeed may relate to a unique state of the precursor ion. The reaction need not necessarily involve fragmentation. It could, for example, involve a change in the number of charges carried. Thus, all fragment ions are daughter ions, but not all daughter ions are necessarily fragment ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "daughter ion" .

goldbook:D01525 a skos:Concept ;
    skos:definition "Any nuclide which follows a specified radionuclide in a decay chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "daughter product" .

goldbook:D01526 a skos:Concept ;
    skos:altLabel "factor-group splitting" ;
    skos:definition "The splitting of bands in the electronic or vibrational spectra of crystals due to the presence of more than one (interacting) equivalent molecular entity in the unit cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Davydov splitting" .

goldbook:D01527 a skos:Concept ;
    skos:definition "Non-SI unit of time, \\(\\rm{d}=86\\ 400\\ \\rm{s}\\). The day is not exactly defined in terms of the second since so-called leap seconds are added or subtracted from the day semiannually in order to keep the annual average occurrence of midnight at 24:00 on the clock." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "day" .

goldbook:D01528 a skos:Concept ;
    skos:definition "Any loss of energy by an excited molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deactivation" .

goldbook:D01529 a skos:Concept ;
    skos:definition "Of a radiation counter, the constant and known value imposed on the resolving time, usually in order to make the correction for resolving time losses more accurate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead time" .

goldbook:D01530 a skos:Concept ;
    skos:definition "The time which elapses between the moment at which a sudden change in concentration (or a new sample) is introduced and the moment at which the detector response indication reaches the measurement threshold of the analyser, a value conventionally fixed at 10% of the final change in indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead time" .

goldbook:D01531 a skos:Concept ;
    skos:definition "Correction to be applied to the observed number of pulses in order to take into account the number of pulses lost during the resolving or dead time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead time correction" .

goldbook:D01532 a skos:Concept ;
    skos:definition "This term is used to express the extra-column volume. Strictly speaking, the term 'dead-volume' refers to volumes within the chromatographic system which are not swept by the mobile phase. On the other hand, mobile phase is flowing through most of the extra-column volumes. Due to this ambiguity the use of term 'dead-volume' is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dead-volume" .

goldbook:D01534 a skos:Concept ;
    skos:definition "The chemical potential or activity of ions cannot be determined on a purely thermodynamic basis. This is due to the fact that the effects of an ion cannot be separated from the effects of the accompanying counter-ion, or in other terms, the electrochemical potential of the ion cannot be separated into the chemical and the electrical component. Such a separation must necessarily be based on a non-thermodynamic convention. The present convention is based on the assumption that the molal activity coefficient of the chloride ion in dilute aqueous solutions (\\(\\pu{I \\lt 0.10 mol kg-1}\\)) can be estimated by means of the Debye–Hückel equation: \\[-\\log_{10}\\gamma_{\\rm{B}}=\\frac{z_{\\rm{B}}^{2}\\ A\\ \\sqrt{I}}{1 + \\mathring{a}\\ B\\ \\sqrt{I}}\\] where \\(I\\) is ionic strength, \\(z\\) is the charge number of the ion, \\(\\mathring{a}\\) is ion size parameter and \\(A\\) and \\(B\\) are temperature-dependent constants. According to the Bates–Guggenheim convention \\(\\mathring{a}\\ B\\) is taken to be \\(1.5 \\sqrt{\\pu{mol kg-1}}\\) at all temperatures and for all compositions of the solutions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Debye–Hückel equation" .

goldbook:D01536 a skos:Concept ;
    skos:definition "The negative decadic logarithm of one minus absorptance as measured on a uniform sample: \\[A=- \\log _{10}(1- \\alpha )\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decadic absorbance" .

goldbook:D01537 a skos:Concept ;
    skos:altLabel "radioactive chain",
        "radioactive series" ;
    skos:definition "A series of nuclides in which each member transforms into the next through nuclear decay until a stable nuclide has been formed. Synonymous with radioactive chain and radioactive series." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decay chain" .

goldbook:D01539 a skos:Concept ;
    skos:definition "A graph showing the relative amount of radioactive substance remaining after any time interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decay curve" .

goldbook:D01541 a skos:Concept ;
    skos:definition "The rate at which a pollutant is removed from the atmosphere either by reaction with reactive transient species such as the $\\ce{HO}$ radical, $\\ce{O3}$, etc., by photodecomposition initiated by light absorption by the impurity, or by loss at the surface of aerosols, the earth, etc. The decay rate as applied to radioactive materials is related to the radioactive half-life (\\(t_{1/2}\\)) of the particular isotopic species A and its concentration \\([A]_{t}\\), at the given time (\\(t\\)): \\[\\rm{Rate}=\\frac{[A]_{t}\\ \\ln 2}{t_{1/2}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decay rate" .

goldbook:D01543 a skos:Concept ;
    skos:definition "A graphical representation of the energy levels of the members of a decay chain showing the way along which nuclear decay occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decay scheme" .

goldbook:D01544 a skos:Concept ;
    skos:altLabel "time of deactivation" ;
    skos:definition "The time on stream during which the rate constant for the catalytic reaction, \\(k\\), falls to a specified fraction of its original value, often 0.5." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decay time" .

goldbook:D01547 a skos:Concept ;
    skos:definition "The breakdown of a single phase into two or more phases. The term applies also to other chemical entities such as a normal molecule and a reaction intermediate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decomposition" .

goldbook:D01549 a skos:Concept ;
    skos:definition "The ratio of the proportion of contaminant to product before treatment to the proportion after treatment. It is the reciprocal of the enrichment factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "decontamination factor" .

goldbook:D01553 a skos:Concept ;
    skos:definition "A method of exceptional scientific status which is sufficiently accurate to stand alone in the determination of a given property for the certification of a reference material. Such a method must have a firm theoretical foundation so that systematic error is negligible relative to the intended use. Analyte masses (amounts) or concentrations must be measured directly in terms of the base units of measurements, or indirectly related through sound theoretical equations. Definitive methods, together with certified reference materials, are primary means for transferring accuracy, i.e. establishing traceability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "definitive method" .

goldbook:D01555 a skos:Concept ;
    skos:altLabel "peptization" ;
    skos:definition "The reversal of coagulation or flocculation, i.e. the dispersion of aggregates to form a colloidally stable suspension or emulsion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deflocculation" .

goldbook:D01557 a skos:Concept ;
    skos:definition "Sometimes chain branching is brought about by an intermediate which has a long lifetime compared with an ordinary free radical. If this intermediate can break down in different ways, only one of which leads to branching, there may be a relatively slow increase in the number of radicals, and there is said to be degenerate chain branching." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerate chain branching" .

goldbook:D01559 a skos:Concept ;
    skos:definition "A molecular rearrangement in which the principal product is indistinguishable (in the absence of isotopic labelling) from the principal reactant. The term includes both 'degenerate intramolecular rearrangements' and reactions that involve intermolecular transfer of atoms or groups ('degenerate intermolecular rearrangements'): both are degenerate isomerizations. The occurrence of degenerate rearrangements may be detectable by isotopic labelling or by dynamic NMR techniques. For example: thesigmatropic rearrangement of hexa-1,5-diene (Cope rearrangement):  Synonymous but less preferable terms are 'automerization', 'permutational isomerism', 'isodynamic transformation', 'topomerization'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerate rearrangement" .

goldbook:D01560 a skos:Concept ;
    skos:definition "Non-SI unit of plane angle, \\(1\\ ^{\\unicode{x26ac}} = \\frac{\\pi }{180}\\ \\rm{rad}\\approx 0.017\\ 453\\ 29\\,...\\,\\rm{rad}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree" .

goldbook:D01561 a skos:Concept ;
    skos:definition "SI derived unit of Celsius temperature equal to the kelvin (symbol: \\(\\pu{^{\\circ}C}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree Celsius" .

goldbook:D01564 a skos:Concept ;
    skos:definition "The number of surfactant ions in the micelle. It does not concern the location of the counterions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of association" .

goldbook:D01566 a skos:Concept ;
    skos:definition "Degree of reaction for a dissociation reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of dissociation" .

goldbook:D01569 a skos:Concept ;
    skos:definition "The number of monomeric units in a macromolecule or oligomer molecule, a block or a chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degree of polymerization" .

goldbook:D01572 a skos:Concept ;
    skos:definition "A statistical quantity indicating the number of values which could be arbitrarily assigned within the specification of a system of observations. For simple replication, with \\(n\\) measurements and one estimated parameter (the mean), \\( u =n- 1\\). More generally, for multivariable computations, the number of degrees of freedom equals the number of observations minus the number of fitted parameters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degrees of freedom" .

goldbook:D01574 a skos:Concept ;
    skos:definition "Species, usually transient, derived formally by the abstraction of a hydrogen atom from each of two ring atoms of an arene. The name for specific compounds requires the numerical prefix di-. E.g. 1,8-didehydronaphthalene or naphthalene-1,8-diyl.  1,2-Didehydroarenes are called arynes and are commonly represented with a formal triple bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dehydroarenes" .

goldbook:D01575 a skos:Concept ;
    skos:definition "A subclass of dehydroarenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dehydrobenzenes" .

goldbook:D01576 a skos:Concept ;
    skos:definition "The occurrence of two or more events separated by a short but measurable time interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed coincidence" .

goldbook:D01577 a skos:Concept ;
    skos:definition "A commonly used term for a primary carbonization product (green or raw coke) from high-boiling hydrocarbon fractions (heavy residues of petroleum or coal processing) produced by the delayed coking process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed coke" .

goldbook:D01578 a skos:Concept ;
    skos:definition "A thermal process which increases the molecular aggregation or association in petroleum-based residues or coal tar pitches leading to extended mesophase domains. This is achieved by holding them at an elevated temperature (usually \\(750{-}765\\ \\rm{K}\\)) over a period of time (\\(12\\ \\rm{to}\\ 36\\ \\rm{h}\\)). It is performed in a coking drum and is designed to ultimately produce delayed coke. The feed is rapidly pre-heated in a tubular furnace to about \\(760\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed coking process" .

goldbook:D01579 a skos:Concept ;
    skos:definition "Three types of delayed fluorescence are known:   E-type delayed fluorescence: The process in which the first excited singlet state becomes populated by a thermally activated radiationless transition from the first excited triplet state. Since in this case the populations of the singlet and triplet states are in thermal equilibrium, the lifetimes of delayed fluorescence and the concomitant phosphorescence are equal.   P-type delayed fluorescence: The process in which the first excited singlet state is populated by interaction of two molecules in the triplet state (triplet-triplet annihilation) thus producing one molecule in the excited singlet state. In this biphotonic process the lifetime of delayed fluorescence is half the value of the concomitant phosphorescence.   Recombination fluorescence: The first excited singlet state becomes populated by recombination of radical ions with electrons or by recombination of radical ions of opposite charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed fluorescence" .

goldbook:D01580 a skos:Concept ;
    skos:definition "Luminescence decaying more slowly than that expected from the rate of decay of the emitting state. The following mechanisms of luminescence provide examples:triplet-triplet or singlet-singlet annihilation to form one molecular entity in its excited singlet state and another molecular entity in its electronic ground state (sometime referred to as P type),  thermally activated delayed fluorescence involving reversible intersystem crossing (sometimes referred to as E type), and   combination of oppositely charged ions or of an electron and a cation. For emission to be referred to in this case as delayed luminescence at least one of the two reaction partners must be generated in a photochemical process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed luminescence" .

goldbook:D01581 a skos:Concept ;
    skos:definition "Neutrons emitted by fission products formed by nuclear decay (the observed delay is due to the preceding nuclear decay or decays)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delayed neutrons" .

goldbook:D01582 a skos:Concept ;
    skos:definition "The process that occurs when the vapour pressure of the saturated aqueous solution of a substance is less than the vapour pressure of water in the ambient air. When water vapour is collected by the pure solid compound, a mixture of the solid and liquid or an aqueous solution of the compound forms until the substance is dissolved and is in equilibrium with its environment; at this time the vapour pressure of water over the aqueous solution will equal the partial pressure of water in the atmosphere in contact with it. A crystalline salt aerosol particle will deliquesce in the atmosphere when the relative humidity surpasses a characteristic value, the so-called deliquescence point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deliquescence" .

goldbook:D01583 a skos:Concept ;
    skos:definition "A quantum mechanical concept most usually applied in organic chemistry to describe the $\\ce{\\uppi\\!\\mbox{-}bonding}$ in a conjugated system. This bonding is not localized between two atoms: instead, each link has a 'fractional double bond character' or bond order. There is a corresponding 'delocalization energy', identifiable with the stabilization of the system compared with a hypothetical alternative in which formal (localized) single and double bonds are present. Some degree of delocalization is always present and can be estimated by quantum mechanical calculations. The effects are particularly evident in aromatic systems and in symmetrical molecular entities in which a lone pair of electrons or a vacant p-orbital is conjugated with a double bond (e.g. carboxylate ions, nitro compounds, enamines, the allyl cation). Delocalization in such species may be represented by partial bonds or as resonance (here symbolized by a two-headed arrow) between contributing structures.   These examples also illustrate the concomitant delocalization of charge in ionic conjugated systems. Analogously, delocalization of the spin of an unpaired electron occurs in conjugated radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delocalization" .

goldbook:D01585 a skos:Concept ;
    skos:definition "Apparatus made of wire mesh or glass fibre which is used to help remove acid mist as in the manufacture of sulfuric acid. Demisters are also components of wet arrestment plants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "demister" .

goldbook:D01586 a skos:Concept ;
    skos:definition "The process of partial or total alteration of the native structure of a macromolecule resulting from the loss of tertiary or tertiary and secondary structure that is a consequence of the disruption of stabilizing weak bonds. Denaturation can occur when proteins and nucleic acids are subjected to elevated temperature or to extremes of pH, or to non-physiological concentrations of salt, organic solvents, urea or other chemical agents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "denaturation" .

goldbook:D01587 a skos:Concept ;
    skos:definition "Addition of methanol or acetone to alcohol to make it unfit for drinking." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "denaturation" .

goldbook:D01589 a skos:Concept ;
    skos:definition "The reduction of nitrates to nitrites, dinitrogen oxide (nitrous oxide) or dinitrogen catalysed by microoganisms, e.g. facultative aerobic soil bacteria under anaerobic conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "denitrification" .

goldbook:D01590 a skos:Concept ;
    skos:altLabel "mass density",
        "specific weight" ;
    skos:definition "Mass of a sample or body divided by its volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "density" .

goldbook:D01591 a skos:Concept ;
    skos:definition "The interchange of the denser and less dense phases due to changes in solute concentration. phase inversion is often used in this context but is ambiguous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "density inversion" .

goldbook:D01594 a skos:Concept ;
    skos:definition "In a coordination entity the number of donor groups from a given ligand attached to the same central atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "denticity" .

goldbook:D01595 a skos:Concept ;
    skos:definition "An apparatus used to separate gases and aerosols (over a given diameter) which is based upon the difference in diffusion velocity between gases and aerosol particles. Usually a tube containing a selective internal wall coating which removes the gaseous compounds at the wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "denuder system" .

goldbook:D01596 a skos:Concept ;
    skos:definition "Equipment for the removal of noxious gases and odours, which may consist of combustion, absorption, or adsorption units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deodorizer" .

goldbook:D01597 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "High molecular weight, linear polymers, composed of nucleotides containing deoxyribose and linked by phosphodiester bonds; DNA contain the genetic information of organisms. The double-stranded form consists of a double helix of two complementary chains that run in opposite directions and are held together by hydrogen bonds between pairs of the complementary nucleotides and Hoogsteen (stacking) forces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deoxyribonucleic acids" .

goldbook:D01600 a skos:Concept ;
    skos:definition "The process of converting a polymer into a monomer or a mixture of monomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depolymerization" .

goldbook:D01601 a skos:Concept ;
    skos:definition "Deposition is normally considered to be one of two types: dry deposition is the process by which aerosols and gases in the air are deposited on the surface of the earth (soil, water, rock, plants, etc.); this is termed 'dry' deposition even when the receptor surface is moist. Wet deposition is that process which involves the transport of chemicals to the surface of the earth by water droplets or snow crystals which scavenge pollutants as they form and fall through the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deposition" .

goldbook:D01602 a skos:Concept ;
    skos:definition "The ratio of flux density (often given in units of \\(\\pu{g cm-2 s-1}\\)) of a substance at a sink surface to its concentration in the atmosphere (corresponding units of \\(\\pu{g cm-3}\\)). While the units of this ratio are clearly those of velocity (in this case \\(\\pu{cm s-1}\\)), the ratio is not a flow velocity in the normal sense of the word." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deposition velocity" .

goldbook:D01603 a skos:Concept ;
    skos:definition "Intermolecular esters formed from two or more molecules of the same or different phenolic benzoic acids. Depending on the number of the component units, di-, tri-, etc. depsides may result, e.g. 4-O-galloylgallic acid:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depsides" .

goldbook:D01604 a skos:Concept ;
    skos:definition "Natural or synthetic compounds having sequences of amino and hydroxy carboxylic acid residues (usually $\\ce{\\upalpha\\!\\mbox{-}amino}$ and \\ce{\\upalpha\\!\\mbox{-}hydroxy acids}), commonly but not necessarily regularly alternating. In cyclodepsipeptides, the residues are connected in a ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depsipeptides" .

goldbook:D01605 a skos:Concept ;
    skos:definition "The inverse of the absorption coefficient. If the decadic absorption coefficient, \\(a\\), is used, the depth of penetration (\\(\\frac{1}{a}\\)) is the distance at which the radiant power, \\(P_{\\lambda }\\), decreases to one tenth of its incident value, \\(P_{\\lambda }^{0}\\). If the Naperian absorption coefficient, \\(\\alpha \\), is used, the depth of penetration (\\(\\frac{1}{\\alpha } = \\beta \\) in this case) is the distance at which the radiant power decreases to \\(\\frac{1}{\\rm{e}}\\) of its incident value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth of penetration" .

goldbook:D01606 a skos:Concept ;
    skos:definition "Dependence of concentration on depth perpendicular to the surface in a solid sample. It can be obtained by a simultaneous or sequential process of erosion and surface analysis or by measurement of the energy loss of primary backscattered particles produced by nuclear reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth profile" .

goldbook:D01607 a skos:Concept ;
    skos:definition "The distance between the 84 and 16 per cent levels of the depth profile of an element in a perfect sandwich sample with an infinitesimally small overlap of the components. These limits correspond to the 2\\(\\sigma \\)-value of the Gaussian distribution of the signal at the interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "depth resolution" .

goldbook:D01610 a skos:Concept ;
    skos:definition "The first (second, ...) derivative absorption spectrum of a molecule is defined as the first (second, ...) derivative, \\(\\frac{\\rm{d}A\\left(\\overset{˜}{ u }\\right)}{\\rm{d}\\overset{˜}{ u }}\\)[\\(\\frac{\\rm{d}^{2}A\\left(\\overset{˜}{ u }\\right)}{\\rm{d}\\overset{˜}{ u }^{2}}\\), ... ] of the absorbance \\(A\\) as a function of wavenumber, \\(\\overset{˜}{ u }\\). Wavelengths may be used in place of wavenumbers but the shape of the derivative spectra will be slightly different. When derivative spectra are obtained at low temperature, they are called first (second, ...) derivative low temperature absorption spectra (specifying the solvent, temperature and solute concentration)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derivative spectroscopy" .

goldbook:D01611 a skos:Concept ;
    skos:definition "A unit constructed exclusively from base units, e.g. \\(\\pu{mol kg-1}\\), \\(\\pu{kg m-3}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derived coherent unit" .

goldbook:D01612 a skos:Concept ;
    skos:definition "A kind of quantity characterized by an equation between base kinds of quantities, e.g. \\(\\rm{mass concentration} = \\rm{mass}\\ \\left(\\rm{length}\\right)^{-3}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derived kind of quantity" .

goldbook:D01613 a skos:Concept ;
    skos:definition "A unit constructed from base units and numerical factors, which may be named and symbolized, e.g. \\(\\mathrm{mg}\\), \\(\\pu{mol l-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derived non-coherent unit" .

goldbook:D01614 a skos:Concept ;
    skos:definition "Quantity defined, in a system of quantities, as a function of base quantities of that system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derived quantity" .

goldbook:D01615 a skos:Concept ;
    skos:definition "Unit of measurement of a derived quantity in a given system of quantities. Derived units are expressed algebraically in terms of base units by means of the mathematical symbols of multiplication and division." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "derived unit" .

goldbook:D01616 a skos:Concept ;
    skos:definition "A mode of operation in which the mobile phase is supplied to the upper edge of the paper or plate and the downward movement is governed mainly by gravity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "descending elution/development" .

goldbook:D01618 a skos:Concept ;
    skos:definition "Drying agent.In agriculture, a substance used for drying up plants and facilitating their mechanical harvesting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desiccant" .

goldbook:D01620 a skos:Concept ;
    skos:definition "The converse of adsorption, i.e. the decrease in the amount of adsorbed substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption" .

goldbook:D01621 a skos:Concept ;
    skos:definition "The process in which expulsion of a previously adsorbed component from the interfacial layer is effected by subsequent stronger adsorption of another component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desorption by displacement" .

goldbook:D01622 a skos:Concept ;
    skos:definition "The process by which sulfur is removed from a material such as coal or oil. It may involve one of many techniques including elutriation, froth flotation, laundering, magnetic separation, chemical treatment, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desulfurization" .

goldbook:D01623 a skos:Concept ;
    skos:definition "The modification of an object which results in the loss of one or more symmetry elements, such as those which preclude chirality (mirror plane, centre of inversion, rotation-reflection axis), as in the conversion of a prochiral molecular entity into a chiral one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desymmetrization" .

goldbook:D01624 a skos:Concept ;
    skos:definition "The removal of the smallest possible number of symmetry elements from a molecule with or without the restriction to pointwise substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "desymmetrization step" .

goldbook:D01625 a skos:Concept ;
    skos:definition "The reverse of an attachment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detachment" .

goldbook:D01626 a skos:Concept ;
    skos:altLabel "principle of detailed balancing" ;
    skos:definition "When equilibrium is reached in a reaction system (containing an arbitrary number of components and reaction paths), as many atoms, in their respective molecular entities will pass forward, as well as backwards, along each individual path in a given finite time interval. Accordingly, the reaction path in the reverse direction must in every detail be the reverse of the reaction path in the forward direction (provided always that the system is at equilibrium). The principle of detailed balancing is a consequence for macroscopic systems of the principle of microscopic reversibility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detailed balancing" .

goldbook:D01627 a skos:Concept ;
    skos:definition "The ratio between the number of particles or photons detected and the number of similar particles or photons emitted by the radiation source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detection efficiency" .

goldbook:D01629 a skos:Concept ;
    skos:definition "The minimum single result which, with a stated probability, can be distinguished from a suitable blank value. The limit defines the point at which the analysis becomes possible and this may be different from the lower limit of the determinable analytical range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detection limit" .

goldbook:D01643 a skos:Concept ;
    skos:definition "A surfactant (or a mixture containing one or more surfactants) having cleaning properties in dilute solutions (soaps are surfactants and detergents)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detergent" .

goldbook:D01644 a skos:Concept ;
    skos:definition "Process, or processes, of chemical modification which make a toxic molecule less toxic.Treatment of patients suffering from poisoning in such a way as to promote physiological processes which reduce the probability or severity of harmful effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "detoxification" .

goldbook:D01645 a skos:Concept ;
    skos:definition "A term used to represent replacement of protium by deuterium. The use of the word deuteration is also acceptable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deuteriation" .

goldbook:D01648 a skos:Concept ;
    skos:definition "A specific name for the atom $\\ce{^{2}H}$. The cation $\\ce{2H^{+}}$ is a deuteron the species $\\ce{2H^{−}}$ is a 'deuteride' anion and $\\ce{^{2}H}$ is the 'deuterio' group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deuterium" .

goldbook:D01649 a skos:Concept ;
    skos:definition "Nucleus of the $\\ce{^{2}H}$ (deuterium) atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deuteron" .

goldbook:D01650 a skos:Concept ;
    skos:definition "The difference between an observed value and the arithmetic mean of the set to which it belongs. It can be calculated by the formula: @D01650-1@" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "deviation" .

goldbook:D01652 a skos:Concept ;
    skos:definition "That temperature at which water vapour present in the atmosphere is just sufficient to saturate it. When air is cooled below the dew point, the excess of water vapour appears as tiny droplets or crystals of ice depending on the temperature of the air mass. This term is also applicable to acid gases as in the problem of acid corrosion and acid smut formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dew point" .

goldbook:D01653 a skos:Concept ;
    skos:definition "Instrument in which the sample is passed over a cooled surface. The temperature at which dew forms on the cooled surface is a function of the water content of the gas passing over the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dew point hygrometer" .

goldbook:D01654 a skos:Concept ;
    skos:altLabel "electron exchange excitation transfer" ;
    skos:definition "Excitation transfer occurring as a result of an electron exchange mechanism. It requires an overlap of the wavefunctions of the energy donor and the energy acceptor. It is the dominant mechanism in triplet-triplet energy transfer. The transfer rate constant, \\(k_{\\mathrm{ET}}\\), is given by: \\[k_{\\rm{ET}}\\propto \\frac{h}{2\\ \\pi }\\ P^{2}\\ J\\ \\rm{e}^{\\frac{-2\\ r}{L}}\\] where \\(r\\) is the distance between donor (D) and acceptor (A), \\(L\\) and \\(P\\) are constants not easily related to experimentally determinable quantities, and \\(J\\) is the spectral overlap integral. For this mechanism the spin conservation rules are obeyed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Dexter excitation transfer" .

goldbook:D01655 a skos:Concept ;
    skos:definition "Branched poly-$\\ce{\\upalpha\\!}$-ᴅ-glucosides of microbial origin having glycosidic bonds predominantly $\\ce{C-1\\!\\rightarrow\\!C-6}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dextrans" .

goldbook:D01656 a skos:Concept ;
    skos:definition "Poly-$\\ce{\\upalpha\\!}$-ᴅ-glucosides of intermediate chain length derived from starch components (amylopectins) by the action of amylases (starch hydrolysing enzymes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dextrins" .

goldbook:D01658 a skos:Concept ;
    skos:definition "Energy coupling between two potential-energy surfaces is sometimes known as diabatic coupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diabatic coupling" .

goldbook:D01659 a skos:Concept ;
    skos:altLabel "non-adiabatic electron transfer" ;
    skos:definition "Electron transfer process in which the reacting system has to cross over between different electronic surfaces in passing from reactants to products. For diabatic electron transfer the electronic transmission factor is ≪ 1 (see Marcus equation). The term 'non-adiabatic electron transfer' has also been used and is in fact more widespread, but should be discouraged because it contains a double negation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diabatic electron transfer" .

goldbook:D01660 a skos:Concept ;
    skos:altLabel "nonadiabatic photoreaction" ;
    skos:definition "Within the Born–Oppenheimer approximation, a reaction beginning on one excited state 'potential-energy surface' and ending, as a result of radiationless transition, on another surface, usually that of the ground state. Also called non-adiabatic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diabatic photoreaction" .

goldbook:D01661 a skos:Concept ;
    skos:definition "Compounds having two acyl groups substituted on ammonia or a primary amine acyl-NR-acyl. They are also known as secondary amides and, especially the cyclic examples derived from diacids, as imides, e.g. $\\ce{[RC(=O)]2NR}$, $\\ce{RS(=O)2NHC(=O)R}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diacylamines" .

goldbook:D01663 a skos:Concept ;
    skos:definition "A level described by the removal of one electron from the configuration of the neutral ground state. These levels form a spectrum similar to that of a one-electron or hydrogen-like atom but, being single-valency levels, have the energy scale reversed relative to that of single-electron levels. Diagram levels may be divided into valence levels and core levels according to the nature of the electron vacancy. Diagram levels with orbital angular momentum different from zero occur in pairs and form spin doublets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diagram level" .

goldbook:D01665 a skos:Concept ;
    skos:altLabel "dialysis residue",
        "residue" ;
    skos:definition "After (complete or incomplete) dialysis two solutions are obtained. The one free from colloidal material is called dialysate; the other one, containing the colloidal particles may be called retentate, dialysis residue, or simply residue, but should not be called dialysate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dialysate" .

goldbook:D01666 a skos:Concept ;
    skos:definition "The process of separating a colloidal sol from a colloid-free solution by a membrane permeable to all components of the system except the colloidal ones, and allowing the exchange of the components of small molar mass to proceed for a certain time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dialysis" .

goldbook:D01668 a skos:Concept ;
    skos:definition "Substances having a negative magnetic susceptibility are diamagnetic. They are repelled out of a magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diamagnetic" .

goldbook:D01670 a skos:Concept ;
    skos:definition "Analogues of acyclic carboxylic acid anhydrides in which $\\ce{=O}$ has been replaced by $\\ce{=NR}$ and $\\ce{–O–}$ by $\\ce{–NR–}$: $\\ce{RC(=NR)NRC(=NR)R}$, N-imidoyl amidines. The name 1,3,5-triazapentadienes is sometimes applied as a class name to diamidides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diamidides" .

goldbook:D01671 a skos:Concept ;
    skos:definition "An allotropic form of the element carbon with cubic structure (space group \\(O_{h}^{7}- Fd3m\\)) which is thermodynamically stable at pressures above \\(6\\ \\rm{GPa}\\) at room temperature and metastable at atmospheric pressure. At low pressures diamond converts rapidly to graphite at temperatures above \\(1900\\ \\rm{K}\\) in an inert atmosphere. The chemical bonding between the carbon atoms is covalent with \\(\\mathrm{sp}^{3}\\) hybridization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diamond" .

goldbook:D01672 a skos:Concept ;
    skos:altLabel "CVD",
        "CVD diamond",
        "low-pressure diamond" ;
    skos:definition "Diamond by CVD (chemical vapour deposition) is formed as crystals or as films from various gaseous hydrocarbons or other organic molecules in the presence of activated, atomic hydrogen. It consists of \\(\\rm{sp}^{3}\\)-hybridized carbon atoms with the three-dimensional crystalline structure of the diamond lattice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diamond by CVD" .

goldbook:D01673 a skos:Concept ;
    skos:altLabel "DLC" ;
    skos:definition "Diamond-like carbon (DLC) films are hard, amorphous films with a significant fraction of \\(\\mathrm{sp}^{3}\\)-hybridized carbon atoms and which can contain a significant amount of hydrogen. Depending on the deposition conditions, these films can be fully amorphous or contain diamond crystallites. These materials are not called diamond unless a full three-dimensional crystalline lattice of diamond is proven." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diamond-like carbon films" .

goldbook:D01674 a skos:Concept ;
    skos:definition "Molecular entities bearing two negative charges, which may be located on a single atom or on different atoms or may be delocalized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dianions" .

goldbook:D01675 a skos:Concept ;
    skos:altLabel "diastereoisomeric excess" ;
    skos:definition "This is defined by analogy with enantiomeric excess, as \\(D_{1}- D_{2}\\) [and the percent diastereoisomer excess as \\(100\\ (D_{1}-D_{2})\\)], where the mole fractions of two diastereoisomers in a mixture or the fractional yields of two diastereoisomers formed in a reaction are \\(D_{1}\\) and \\(D_{2}\\) (\\(D_{1}+D_{2}=1\\)). The term is not applicable if more than two diastereoisomers are present. Frequently this term is abbreviated to \\(\\rm{d.e.}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diastereoisomer excess" .

goldbook:D01678 a skos:Concept ;
    skos:definition "The interconversion of diastereoisomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diastereoisomerization" .

goldbook:D01679 a skos:Concept ;
    skos:definition "Stereoisomerism other than enantiomerism. Diastereoisomers (or diastereomers) are stereoisomers not related as mirror images. Diastereoisomers are characterized by differences in physical properties, and by some differences in chemical behaviour towards achiral as well as chiral reagents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diastereoisomerism" .

goldbook:D01681 a skos:Concept ;
    skos:definition "This is defined by analogy with enantiomeric ratio as the ratio of the percentage of one diastereoisomer in a mixture to that of the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diastereomeric ratio" .

goldbook:D01683 a skos:Concept ;
    skos:definition "The relationship between objects (or models) analogous to that between diastereoisomeric molecular entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diastereomorphism" .

goldbook:D01685 a skos:Concept ;
    skos:definition "Constitutionally equivalent atoms or groups of a molecule which are not symmetry related. Replacement of one of two diastereotopic atoms or groups results in the formation of one of a pair of diastereoisomers. In the example below the two hydrogen atoms of the methylene group C-3 are diastereotopic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diastereotopic" .

goldbook:D01688 a skos:Concept ;
    skos:definition "Radicals of structure $\\ce{RN=N^{.}}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diazenyl radicals" .

goldbook:D01689 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RN=N–NR2}$ (not all $\\ce{R = H}$, and one $\\ce{R}$ commonly aryl). In systematic nomenclature, diazoamino prefixed to the name of $\\ce{RH}$ names the compound $\\ce{RN=NNHR'}$ ($\\ce{R = R'}$), e.g. $\\ce{PhN=N–NPhMe}$, N-methyldiazoaminobenzene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diazoamino compounds" .

goldbook:D01690 a skos:Concept ;
    skos:altLabel "diazotates" ;
    skos:definition "Salts $\\ce{RN=NO−M^{+}}$ ($\\ce{R}$ commonly aryl) of the compounds $\\ce{RN=NOH}$ (hydrocarbon)diazohydroxides, e.g. $\\ce{PhN=NO−K^{+}}$ potassium benzenediazoate. In the IUPAC 'Blue Book' these compounds are named as hydrocarbyldiazenolates and hydrocarbyldiazenols, respectively. E.g. $\\ce{PhN=NOH}$ phenyldiazenol. $\\ce{RN=NO−M^{+}}$ are also known by the non-IUPAC name diazotates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diazoates" .

goldbook:D01691 a skos:Concept ;
    skos:definition "Compounds having the divalent diazo group, $\\ce{=N^{+}=N^{−}}$, attached to a carbon atom, e.g. $\\ce{CH2=N2}$ diazomethane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diazo compounds" .

goldbook:D01692 a skos:Concept ;
    skos:definition "Compounds of structure $\\ce{RN2^{+}Y^{−}}$, in which $\\ce{R}$ is generally but not necessarily aryl, and the cations of which are usually formulated as $\\ce{RN^{+}\\!#N}$, E.g. $\\ce{PhN^{+}\\!#N}$ benzenediazonium chloride. They may also be named, from the canonical form $\\ce{RN=N^{+}}$, hydrocarbyldiazenylium salts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diazonium salts" .

goldbook:D01693 a skos:Concept ;
    skos:definition "Diazocyclohexadienones, which may also be considered as dipolar diazonio phenoxides, obtained by diazotizing aromatic primary amines having a hydroxy group in an ortho or para position. Also known as diazophenols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diazooxides" .

goldbook:D01695 a skos:Concept ;
    skos:definition "Species carrying two positive charges, formally located on tervalent carbon atoms, e.g. $\\ce{^{+}CH2–\\!^{+}CH2}$ ethane-1,2-diyl dication, $\\ce{^{+}CH2CH2–\\!^{+}CH2}$ propane-1,3-bis(ylium)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dicarbenium ions" .

goldbook:D01696 a skos:Concept ;
    skos:definition "Device for dividing a polydispersed aerosol particle population into two size fractions during sampling. The fractionation is based on the momentum differences of the particles which allow the larger particles to pass through a zone of stagnant gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dichotomous sampler" .

goldbook:D01699 a skos:Concept ;
    skos:definition "Compounds that contain two fixed double bonds (usually assumed to be between carbon atoms). Dienes in which the two double-bond units are linked by one single bond are termed conjugated, e.g. $\\ce{CH2=CH–CH=CH2}$ buta-1,3-diene. Dienes in which the double bonds are adjacent are called cumulative, e.g. $\\ce{CH3–CH=C=CH2}$ buta-1,2-diene. Those in which one or more of the unsaturated carbon atoms is replaced by a heteroatom may be called heterodienes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dienes" .

goldbook:D01700 a skos:Concept ;
    skos:definition "The olefin component of a Diels–Alder reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dienophile" .

goldbook:D01701 a skos:Concept ;
    skos:definition "A highly concentrated analyte in an analytical sample can be determined with better precision by replacing the blank (reference) cell by one containing a solution of the analyte or other absorber of known concentration; this is known as difference absorption spectroscopy. Difference spectra can also be obtained by computer or other subtraction methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "difference absorption spectroscopy" .

goldbook:D01702 a skos:Concept ;
    skos:definition "Differential capacitance (per unit area of interphase or electrode; SI unit \\(\\pu{F m-2}\\)) is given by \\[C=(\\frac{\\partial Q}{\\partial E})_{T,p,\\mu _{i},...}\\] where \\(E\\) is the potential of the electrode with respect to a reference electrode, \\(\\mu _{i}\\) is a set of chemical potentials which are held constant, \\(T\\) is the thermodynamic temperature, \\(Q\\) is the electric charge (per unit area of interphase or electrode), and \\(p\\) is the pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential capacitance" .

goldbook:D01703 a skos:Concept ;
    skos:definition "A device which measures the instantaneous difference in the composition of the column effluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential detector" .

goldbook:D01704 a skos:Concept ;
    skos:definition "Defined by \\[D_{i} = \\frac{-J_{i}}{ abla c_{i}}\\] where \\(J_{i}\\) is the amount of species \\(i\\) flowing through unit area in unit time and \\( abla c_{i}\\) is the concentration gradient of species \\(i\\). Different diffusion coefficients may be defined depending on the choice of the frame of reference used for \\(J_{i}\\) and \\( abla c_{i}\\). For systems with more than two components, the flow of any component and hence its diffusion coefficient depends on the concentration distribution of all components. The limiting differential diffusion coefficient is the value of \\(D_{i}\\) extrapolated to zero concentration of the diffusing species: \\[[D_{i}]=\\lim _{c_{i}\\rightarrow 0}D_{i}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential diffusion coefficient" .

goldbook:D01705 a skos:Concept ;
    skos:definition "When the addition of a differential amount \\(\\mathrm{d}n_{i}^{\\sigma }\\) or \\(\\mathrm{d}n_{i}^{\\rm{s}}\\) is effected at constant gas volume, the differential molar energy of adsorption of component \\(i\\), \\(\\Delta _{a}U_{i}^{\\sigma }\\) or \\(\\Delta _{a}U_{i}^{\\rm{s}}\\), is defined as: \\[\\Delta _{a}U_{i}^{\\sigma }=U_{i}^{\\sigma }- U_{i}^{\\rm{g}}\\] or \\[\\Delta _{a}U_{i}^{\\rm{s}} = U_{i}^{\\rm{s}}- U_{i}^{\\rm{g}}\\] where the differential molar surface excess energy, \\(U_{i}^{\\sigma }\\), is given by \\[U_{i}^{\\sigma }=(\\frac{\\partial U^{\\sigma }}{\\partial n_{i}^{\\rm{s}}})_{T,m,n_{j}^{\\sigma }}=(\\frac{\\partial U}{\\partial n_{i}^{\\sigma }})_{T,m,V^{\\rm{g}},p_{i},n_{j}^{\\sigma }}\\] and the differential molar interfacial energy, \\(U_{i}^{s}\\), by \\[U_{i}^{\\rm{s}}=(\\frac{\\partial U}{\\partial n_{i}^{\\rm{s}}})_{T,m,V^{\\rm{g}},p_{i},n_{j}^{\\sigma }}=(\\frac{\\partial U}{\\partial n_{i}^{\\rm{s}}})_{T,m,V^{\\rm{g}},V^{\\rm{s}},p_{i},n_{j}^{\\rm{s}}}\\] \\(U_{i}^{\\rm{g}}\\) is the differential molar energy of component \\(i\\) in the gas phase, i.e. \\[(\\frac{\\partial U}{\\partial n_{i}^{\\rm{g}}})_{T,V,n_{i}^{\\rm{g}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential molar energy of adsorption" .

goldbook:D01708 a skos:Concept ;
    skos:altLabel "DSC" ;
    skos:definition "A technique in which the difference in energy inputs into a substance (and/or its reaction product(s)) and a reference material is measured as a function of temperature whilst the substance and reference material are subjected to a controlled temperature programme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential scanning calorimetry" .

goldbook:D01710 a skos:Concept ;
    skos:definition "The derivative \\(\\eta _{\\Delta }\\) of stress with respect to the rate of shear at a given shear rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "differential viscosity" .

goldbook:D01711 a skos:Concept ;
    skos:definition "A modification which light (or electron, neutron beams, etc.) undergoes in passing by the edges of opaque bodies or through narrow slits or in being reflected from ruled surfaces (or crystalline materials). The light waves, owing to their wave-like nature appear to be deflected and produce fringes of parallel light and dark bands corresponding to regions of constructive reinforcement or destructive interference, respectively, of the waves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffraction" .

goldbook:D01712 a skos:Concept ;
    skos:definition "The application of diffraction techniques (X-rays, electrons, neutrons) which are sometimes used to identify the presence of certain solid aerosols and dust particles through the characteristic diffraction patterns which result from each unique crystal structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffraction analysis" .

goldbook:D01713 a skos:Concept ;
    skos:definition "A semiconductor detector in which the p–n or n–p junction is produced by diffusion of donor or acceptor impurities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffused junction semiconductor detector" .

goldbook:D01714 a skos:Concept ;
    skos:altLabel "Gouy layer" ;
    skos:definition "The region in which non-specifically adsorbed ions are accumulated and distributed by the contrasting action of the electric field and thermal motion. Counter and co-ions in immediate contact with the surface are said to be located in the Stern layer. Ions farther away from the surface form the diffuse layer or Gouy layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuse layer" .

goldbook:D01715 a skos:Concept ;
    skos:definition "A porous plate or tube, commonly made of carborundum, alundum or silica sand, through which air is forced and divided into minute bubbles for diffusion in liquids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffuser" .

goldbook:D01716 a skos:Concept ;
    skos:definition "The spreading or scattering of a gaseous or liquid material. eddy diffusion in the atmosphere is the process of transport of gases due to turbulent mixing in the presence of a composition gradient. Molecular diffusion is the net transport of molecules which results from their molecular motions alone in the absence of turbulent mixing; it occurs when the concentration gradient of a particular gas in a mixture differs from its equilibrium value. eddy diffusion is the most important mixing process in the lower atmosphere, while molecular diffusion becomes significant at the lower pressures of the upper atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion" .

goldbook:D01717 a skos:Concept ;
    skos:definition "A transition that requires the rearrangement of atoms, ions or molecules in a manner that cannot be accomplished by a cooperative atomic displacement; it may require the movement of atoms, ions or molecules over distances significantly larger than a unit cell. Example: The transition of graphite (hexagonal sheets of three-coordinated carbon atoms) to diamond (infinite three-dimensional framework of four-coordinated carbon atoms) at high temperature and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusional transition" .

goldbook:D01718 a skos:Concept ;
    skos:definition "An aerosol sizing instrument for particles with diameters below \\(0.2\\ \\unicode[Times]{x3BC}\\rm{m}\\). The fractionation is based on different diffusivities of the small particles and their deposition on the walls of the long parallel or circular channels, formed by equally spaced plates, bundles of small bore parallel tubes or sets of stainless wire screens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion battery" .

goldbook:D01722 a skos:Concept ;
    skos:altLabel "diffusion-controlled current" ;
    skos:definition "A faradaic current whose magnitude is controlled by the rate at which a reactant in an electrochemical process diffuses toward an electrode-solution interface (and, sometimes, by the rate at which a product diffuses away from that interface). For the reaction mechanism  there are two common situations in which a diffusion current can be observed. In one, the rate of formation of B from electroinactive C is small and the current is governed by the rate of diffusion of B toward the electrode surface. In the other, C predominates at equilibrium in the bulk of the solution, but its transformation into B is fast; C diffuses to the vicinity of the electrode surface and is there rapidly converted into B, which is reduced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion current" .

goldbook:D01723 a skos:Concept ;
    skos:definition "The empirical quantity defined by \\[i=\\frac{i_{\\rm{d},l}}{c_{\\rm{B}}\\ m^{\\frac{2}{3}}\\ t_{1}^{\\frac{1}{6}}}\\] the equation where \\(i_{\\rm{d},l}\\) = limiting diffusion current, \\(c_{\\rm{B}}\\) = bulk concentration of the substance B whose reduction or oxidation is responsible for the wave in question, \\(m\\) = average rate of (mass) flow of mercury (or other liquid metal) and \\(t_{1}\\) = drop time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion current constant" .

goldbook:D01725 a skos:Concept ;
    skos:altLabel "concentration boundary layer" ;
    skos:definition "The region in the vicinity of an electrode where the concentrations are different from their value in the bulk solution. The definition of the thickness of the diffusion layer is arbitrary because the concentration approaches asymptotically the value \\(c_{0}\\) in the bulk solution (see diagram)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion layer" .

goldbook:D01726 a skos:Concept ;
    skos:definition "Defined by the equation: \\[\\delta = \\frac{D}{k_{\\rm{d}}}=\\frac{n\\ F\\ D\\ c\\ A}{l_{i}}\\] where \\(D\\) is the diffusion coefficient, \\(k_{\\rm{d}}\\) is the heterogeneous diffusion rate constant, \\(F\\) is the Faraday constant, \\(c\\) is the concentration, \\(A\\) is the geometric area of the electrode, \\(l_{i}\\) is the limiting current and \\(n\\) is the charge number of the cell reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion layer thickness" .

goldbook:D01728 a skos:Concept ;
    skos:definition "A transition that does not involve long-range diffusion of atomic species over distances significantly greater than a typical interatomic distance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusionless transition" .

goldbook:D01729 a skos:Concept ;
    skos:definition "For an ideal dilute solution, \\(\\Delta \\mathit{\\Phi }_{\\rm{d}}\\) is the integral of \\( abla \\mathit{\\Phi }\\) (given by the following equation) across the boundary between two regions of different concentrations. \\[ abla \\mathit{\\Phi }=\\frac{R\\ T\\ \\sum D_{i}\\ z_{i}\\  abla c_{i}}{F\\ \\sum s_{i}^{2}\\ D_{i}\\ c_{i}}\\] where \\(D_{i}\\) is the diffusion coefficient of species \\(i\\), \\(z_{i}\\) is the charge number of species \\(i\\), \\(c_{i}\\) is the concentration of species \\(i\\), \\(R\\) is the gas constant, \\(T\\) is the thermodynamic temperature, and \\(F\\) is the Faraday constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diffusion potential" .

goldbook:D01730 a skos:Concept ;
    skos:definition "The angle between two intersecting planes on a third plane normal to the intersection of the two planes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dihedral angle" .

goldbook:D01732 a skos:Concept ;
    skos:definition "An increase in volume of the system which usually accompanies shear thickening. This term has formerly been used for the phenomenon of shear thickening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilatancy" .

goldbook:D01733 a skos:Concept ;
    skos:altLabel "dilatational transition" ;
    skos:definition "A transition in which the crystal structure is dilated (or compressed) along one (or more) crystallographic direction(s) while the symmetry about that direction is retained. Examples:The transition of a $\\ce{CsCl}$-type structure to a rock salt structure in which dilation occurs along the three-fold axis.The transition at \\(T_{\\rm{D}}\\) in quenched $\\ce{NiS}$ in which volume expansion occurs without change of symmetry on going from a metallic state (\\(T > T_{\\rm{D}}\\)) to a semiconducting state (\\(T < T_{\\rm{D}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilational transition" .

goldbook:D01735 a skos:Concept ;
    skos:altLabel "cosolvent" ;
    skos:definition "The liquid or homogeneous mixture of liquids in which extractant(s) and possible modifier(s) may be dissolved to form the solvent phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diluent" .

goldbook:D01736 a skos:Concept ;
    skos:definition "A gas of known quality introduced for analytical purposes so that it quantitatively lowers the concentration of the components of a gaseous sample; this may also be the complementary gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diluent gas" .

goldbook:D01738 a skos:Concept ;
    skos:definition "A device used to add a measured volume or amount of the sample to a measured volume of a diluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diluter" .

goldbook:D01739 a skos:Concept ;
    skos:definition "Solution in which the sum of amount fractions of all the solutes is small compared to 1." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilute solution" .

goldbook:D01740 a skos:Concept ;
    skos:definition "The ratio of the ingoing volume flow rate (\\(\\frac{\\rm{d}V}{\\rm{d}t}\\)) and the culture volume (\\(V\\)). In continuous fermentation, a measure of a rate at which the existing medium is replaced with fresh medium, \\(D\\) is the reciprocal of the hydraulic retention time (\\(\\mathrm{HRT}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dilution rate" .

goldbook:D01741 a skos:Concept ;
    skos:definition "Product of powers of the base dimensions (the dimensions attributed to the base quantities of a system) which parallels the expression of the quantity in terms of the base quantities. When all the exponents of the base dimensions are zero the quantity has the dimension one and is often called dimensionless." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dimension" .

goldbook:D01742 a skos:Concept ;
    skos:definition "Quantities of dimension one, or numerical quantities, are numbers which may be integers (or exceptionally half-integers) when obtained by counting (e.g. number of molecules, quantum numbers, ...), rational numbers such as ratios, factors and fractions when obtained as ratios of two quantities of the same kind or real numbers when obtained by taking logarithms (e.g. absorbance, power levels, ...)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dimensionless quantities" .

goldbook:D01743 a skos:Concept ;
    skos:definition "An ion formed either when a chemical species exists in the vapour as a dimer and can be detected as such, or when a molecular ion can attach to a neutral molecule within the ion source to form an ion such as $\\ce{[M2]^{+.}}$ where $\\ce{M}$ represents the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dimeric ion" .

goldbook:D01744 a skos:Concept ;
    skos:definition "The transformation of a molecular entity $\\ce{A}$ to give a molecular entity $\\ce{A2}$ . For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dimerization" .

goldbook:D01745 a skos:Concept ;
    skos:definition "Photochemical reaction of a molecular entity comprising two $\\ce{\\uppi\\!\\mbox{-}systems}$, separated by a saturated carbon atom (a 1,4-diene or an allyl-substituted aromatic analogue), to form an ene- (or aryl-) substituted cyclopropane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "di-π-methane rearrangement" .

goldbook:D01746 a skos:Concept ;
    skos:altLabel "ET-value" ;
    skos:definition "A measure of the ionizing power (loosely polarity) of a solvent, based on the maximum wavenumber of the longest wavelength electronic absorption band of:  in a given solvent. \\(E_{\\rm{T}}\\), called \\(E_{\\rm{T}}(30)\\) by its originators, is given by: \\[E_{\\rm{T}} = 2.859\\times 10^{-3}\\  u = 2.859\\times 10^{4}\\ \\lambda ^{-1}\\] where \\(E_{\\rm{T}}\\) is in \\(\\pu{kcal mol-1}\\), \\( u \\) is in \\(\\pu{cm-1}\\) and \\(\\lambda \\) is in \\(\\rm{nm}\\). The so-called normalized \\(E_{\\rm{T}}^{\\rm{N}}\\) scale is defined as: \\[E_{\\rm{T}}^{\\rm{N}}=\\frac{E_{\\rm{T}}\\left(\\rm{solvent}\\right)- E_{\\rm{T}}\\left(\\rm{Si}\\rm{Me}_{4}\\right)}{E_{\\rm{T}}\\left(\\rm{water}\\right)- E_{\\rm{T}}\\left(\\rm{Si}\\rm{Me}_{4}\\right)}=\\frac{E_{\\rm{T}}\\left(\\rm{solvent}\\right)- 30.7}{32.4}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Dimroth–Reichardt <em>E</em><sub>T</sub> parameter" .

goldbook:D01747 a skos:Concept ;
    skos:altLabel "semiconductor laser" ;
    skos:definition "A solid state laser in which the active medium is the p-n junction between p-type and n-type semiconductor host materials. This term is preferred over the sometimes-used term 'semiconductor laser'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diode laser" .

goldbook:D01748 a skos:Concept ;
    skos:definition "Compounds that contain two hydroxy groups, generally assumed to be, but not necessarily, alcoholic. Aliphatic diols are also called glycols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diols" .

goldbook:D01749 a skos:Concept ;
    skos:definition "Cyclic $\\ce{\\upalpha\\!\\mbox{-}diketones}$, which exist predominantly in an enolic form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diosphenols" .

goldbook:D01750 a skos:Concept ;
    skos:definition "Colloquial (short) name of a toxic by-product (and sometimes contaminant) of herbicides; the full name of this species is: 2,3,7,8-tetrachlorodibenzo[b,e][1,4]-dioxin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dioxin" .

goldbook:D01751 a skos:Concept ;
    skos:altLabel "polar aprotic solvent" ;
    skos:definition "A solvent with a comparatively high relative permittivity (or dielectric constant), greater than ca. 15, and a sizable permanent dipole moment, that cannot donate suitably labile hydrogen atoms to form strong hydrogen bonds, e.g. dimethyl sulfoxide. The term (and its alternative 'polar aprotic solvent') is a misnomer and is therefore discouraged. Such solvents are usually not aprotic but protophilic (and at most weakly protogenic). In describing a solvent it is better to be explicit about its essential properties, e.g. dipolar and non-protogenic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipolar aprotic solvent" .

goldbook:D01752 a skos:Concept ;
    skos:definition "A bond formed (actually or conceptually) by coordination of two neutral moieties, the combination of which results in charge-separated structures, e.g.  The term is preferred to the obsolescent synonyms 'coordinate link', 'coordinate covalence', 'dative bond', 'semipolar bond'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipolar bond" .

goldbook:D01753 a skos:Concept ;
    skos:definition "Electrically neutral molecules carrying a positive and a negative charge in one of their major canonical descriptions. In most dipolar compounds the charges are delocalized; however the term is also applied to species where this is not the case. 1,2-Dipolar compounds have the opposite charges on adjacent atoms. The term 1,3-dipolar compounds is used for those in which a significant canonical resonance form can be represented by a separation of charge over three atoms (in connection with 1,3-dipolar cycloadditions). Subclasses of 1,3-dipolar compounds include: Allyl type $\\ce{X=Y^{+}-Z^{−}}$$\\ce{}$$\\ce{X^{−}-Y^{+}=Z}$$\\ce{}$$\\ce{X^{+}-Y-Z^{−}}$$\\ce{}$$\\ce{X^{−}=Y-Z^{+}}$ $(\\ce{X, Z = C, N, or O; Y = N or O})$See: azo imides, azomethine imides, azomethine ylides, azoxy compounds, carbonyl imides, carbonyl oxides, carbonyl ylides, nitro compounds, nitrones Propargyl type $\\ce{X#N^{+}-Z^{−}}$$\\ce{}$$\\ce{X^{−}=N^{+}=Z}$$\\ce{}$$\\ce{X^{−}=N-Z^{+}}$$\\ce{}$$\\ce{X-N=Z}$ $(\\ce{X = C or O, Z = C, N, or O})$See: azides, diazo compounds, nitrile imides, nitrile oxides, nitrile ylides, nitrilium betaines Carbene type $\\ce{X{:}-C=Z}$$\\ce{}$$\\ce{X^{+}=C-Z^{−}}$ $(\\ce{X = C or N; Z = C, N, or O})$See: acyl carbenes, betaines, imidoyl carbenes, vinyl carbenes" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipolar compounds" .

goldbook:D01756 a skos:Concept ;
    skos:definition "Synonymous with Förster excitation transfer" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipolar mechanism" .

goldbook:D01758 a skos:Concept ;
    skos:definition "Intermolecular or intramolecular interaction between molecules or groups having a permanent electric dipole moment. The strength of the interaction depends on the distance and relative orientation of the dipoles. The term applies also to intramolecular interactions between bonds having permanent dipole moments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipole–dipole interaction" .

goldbook:D01763 a skos:Concept ;
    skos:definition "Compounds containing two pyrrole rings linked through a methine, $\\ce{–CH=}$, group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dipyrrins" .

goldbook:D01765 a skos:Concept ;
    skos:definition "Molecular species having two unpaired electrons, in which at least two different electronic states with different multiplicities [electron-paired (singlet state) or electron-unpaired (triplet state)] can be identified, e.g. $\\ce{H2C^{.}–CH2–C^{.}H2}$ propane-1,3-diyl (trimethylene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diradicals" .

goldbook:D01766 a skos:Concept ;
    skos:definition "A type of amplification reaction where the constituent to be determined is amplified directly and it is this constituent which is finally measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct amplification" .

goldbook:D01767 a skos:Concept ;
    skos:definition "This term and its symbol, \\(i_{\\mathrm{dc}}\\) or \\(I_{\\mathrm{dc}}\\), should be used (in preference to 'current' alone) only to denote the steady (time-dependent) component of a current that also has a periodic component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct current" .

goldbook:D01769 a skos:Concept ;
    skos:definition "The fraction of fissions giving rise to a particular nuclide before any nuclear decay has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct fission yield" .

goldbook:D01771 a skos:Concept ;
    skos:altLabel "batch injection calorimetry",
        "concentration thermometric technique",
        "direct thermometric method" ;
    skos:definition "An analytical method in which a reactant is injected into a calorimetric vessel containing another reagent. The enthalpy change of the ensuing reaction is measured and directly related to the amount of the limiting reagent (usually the analyte). If the experiment determines information other than amounts of analytes, an acceptable synonym is 'batch injection calorimetry'. Other terms which have been used in the literature but are not recommended include the 'concentration thermometric technique' and the 'direct thermometric method'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct-injection enthalpimetry" .

goldbook:D01772 a skos:Concept ;
    skos:altLabel "direct radiochemical isotope dilution analysis" ;
    skos:definition "Isotope dilution analysis used for the determination of a non-radioactive element with the aid of one of its radionuclides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct isotope dilution analysis" .

goldbook:D01773 a skos:Concept ;
    skos:definition "A chemical process in which the reactive complex has a lifetime that is shorter than its period of rotation. In a molecular-beam experiment the reaction products of a direct reaction are scattered, with reference to the centre of mass of the system, in preferred directions rather than at random. Some direct reactions are impulsive which means that there is an energy exchange that is very fast compared to the vibrational time scale. A direct reaction is to be contrasted with an indirect reaction, also known as a complex-mode reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct reaction" .

goldbook:D01775 a skos:Concept ;
    skos:definition "A system in which the purge gas transports the analyte directly to the sampling or excitation sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "direct transfer gas flow system" .

goldbook:D01776 a skos:Concept ;
    skos:definition "Compounds in which two monosaccharides are joined by a glycosidic bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disaccharides" .

goldbook:D01777 a skos:Concept ;
    skos:definition "The lowest value (e.g. concentration of an impurity, etc.) at which a sensation of discomfort is perceived; a measure which varies from person to person." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discomfort threshold" .

goldbook:D01778 a skos:Concept ;
    skos:definition "An analyser with at least one discontinuous subassembly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discontinuous analyser" .

goldbook:D01779 a skos:Concept ;
    skos:definition "Indication related to the concentration during intervals of time which are not continuous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discontinuous indication" .

goldbook:D01780 a skos:Concept ;
    skos:definition "A measuring cell which operates intermittently and not necessarily at fixed time intervals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discontinuous measuring cell" .

goldbook:D01782 a skos:Concept ;
    skos:definition "A diffusional reaction in a multi-component system in which structural and compositional changes occur in regions immediately adjacent to the advancing interface. The parent phase remains unchanged until swept over by the interface; the transition is complete in regions over which the interface has passed. Synonymous with nucleation and growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discontinuous precipitation" .

goldbook:D01785 a skos:Concept ;
    skos:definition "A basic function unit comprising an electronic circuit which gives an output pulse for each input pulse whose amplitude lies above a given threshold value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discriminator" .

goldbook:D01790 a skos:Concept ;
    skos:definition "The force \\(\\mathit{\\Pi} _{\\rm{d}}\\) per unit area which can be obtained as the derivative of \\(-g_{\\rm{t}}\\) with respect to the distance, where \\(g_{\\rm{t}}\\) is the total Gibbs energy of interaction per unit area of each of the two flat and parallel plates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disjoining pressure" .

goldbook:D01792 a skos:Concept ;
    skos:definition "A device used to deliver a measured amount of material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispenser" .

goldbook:D01794 a skos:Concept ;
    skos:definition "The dilution of a pollutant by spreading in the atmosphere due to diffusion or turbulent action (eddy diffusion)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dispersion" .

goldbook:D01797 a skos:Concept ;
    skos:definition "A procedure in which the mobile phase contains a compound (the displacer) more strongly retained than the components of the sample under examination. The sample is fed into the system as a finite slug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "displacement chromatography" .

goldbook:D01798 a skos:Concept ;
    skos:definition "A transition in which a displacement of one or more kinds of atoms or ions in a crystal structure changes the lengths and/or directions of bonds, without severing the primary bonds. Examples: The transitions of the low-temperature polymorphs of $\\ce{SiO2}$ (quartz, tridymite and cristobalite) to their respective high-temperature polymorphs, which involve distortions or rotations of the $\\ce{SiO4}$ tetrahedra. Also Jahn–Teller and ferroic transitions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "displacive transition" .

goldbook:D01799 a skos:Concept ;
    skos:altLabel "dismutation" ;
    skos:definition "Any chemical reaction of the type , where A, A' and A'' are different chemical species. For example:  The reverse of disproportionation is called comproportionation. A special case of disproportionation (or 'dismutation') is 'radical disproportionation', exemplified by:  Reactions of the more general type:  are also loosely described as 'radical disproportionations'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disproportionation" .

goldbook:D01801 a skos:Concept ;
    skos:definition "The separation of a molecular entity into two or more molecular entities (or any similar separation within a polyatomic molecular entity). Examples include unimolecular heterolysis and homolysis, and the separation of the constituents of an ion pair into free ions.   The separation of the constituents of any aggregate of molecular entities.   In both senses dissociation is the reverse of association." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissociation" .

goldbook:D01803 a skos:Concept ;
    skos:altLabel "dissociative chemisorption" ;
    skos:definition "Adsorption with dissociation into two or more fragments, both or all of which are bound to the surface of the adsorbent. The process may be homolytic, as in the chemisorption of hydrogen: \\[\\rm{H}_{2}+2\\rm{*}\\rightarrow 2\\rm{H}^{\\rm{*}}\\] where * represents a surface site, or heterolytic, as in: \\[\\rm{H}_{2}+\\rm{M}^{n+}+\\rm{O}^{2-}\\rightarrow \\rm{H}^{-}\\rm{M}^{n+}+\\rm{HO}^{-}\\] where \\(\\rm{M}^{n+}\\) and \\(\\rm{O}^{2- }\\) are surface sites in which the ions are of lower coordination than the ions in the bulk phase. Associative desorption is the reverse of dissociative adsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissociative adsorption" .

goldbook:D01804 a skos:Concept ;
    skos:definition "An ionization process in which a gaseous molecule decomposes to form products, one of which is an ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissociative ionization" .

goldbook:D01805 a skos:Concept ;
    skos:definition "Dissociative surface reaction and its reverse, associative surface reaction, are defined by: \\[2^{\\rm{*}}+\\rm{C}_{2}\\rm{H}_{5}^{\\rm{*}}\\rightleftharpoons \\rm{H}^{\\rm{*}}+\\,^{\\rm{*}}{\\rm{CH}_{2}\\rm{CH}_{2}}^{\\rm{*}}\\] where * represents a surface site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissociative surface reaction" .

goldbook:D01806 a skos:Concept ;
    skos:definition "The mixing of two phases with the formation of one new homogeneous phase (i.e. the solution)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dissolution" .

goldbook:D01809 a skos:Concept ;
    skos:definition "A radical cation in which charge and radical sites are separated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distonic radical cation" .

goldbook:D01811 a skos:Concept ;
    skos:definition "The apportionment of a solute between two phases. The term partition or extraction may also be used in this sense where appropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution" .

goldbook:D01814 a skos:Concept ;
    skos:definition "The concentration of a component in or on the stationary phase divided by the concentration of the component in the mobile phase. Since in chromatography a component may be present in more than one form (e.g. associated and dissociated forms), the analytical condition used here refers to the total amount present without regard to the existence of various forms. These terms are also called the distribution coefficients. However, the present term conforms more closely to the general usage in science." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution constant" .

goldbook:D01817 a skos:Concept ;
    skos:altLabel "distribution coefficient",
        "extraction coefficient",
        "scrubbing coefficient",
        "stripping coefficient" ;
    skos:definition "The ratio of the total analytical concentration of a solute in the extract (regardless of its chemical form) to its total analytical concentration in the other phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution ratio" .

goldbook:D01820 a skos:Concept ;
    skos:definition "Terpenoids having a $\\ce{C20}$ skeleton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diterpenoids" .

goldbook:D01822 a skos:Concept ;
    skos:definition "Indicates variations which follow a distinctive pattern which recurs with a daily cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diurnal variation" .

goldbook:D01823 a skos:Concept ;
    skos:definition "A surface, usually taken to be a hyperplane, constructed at right angles to the minimum-energy path on a potential-energy surface. In conventional transition-state theory it passes through the highest point on the minimum-energy path. In generalized versions of transition-state theory the dividing surface can be at other positions; in variational transition-state theory the position of the dividing surface is varied so as to get a better estimate of the rate constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dividing surface" .

goldbook:D01824 a skos:Concept ;
    skos:definition "Interference in which the analytical signal is influenced by a different mechanism than the analyte e.g. the formation of non-dissociating species in emission spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DM-interference" .

goldbook:D01826 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "A short sequence of DNA labelled isotopically or chemically that is used for the detection of a complementary nucleotide sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DNA probe" .

goldbook:D01827 a skos:Concept ;
    skos:definition "Unit sometimes used in the description of the total ozone in a column of air overhead. It is given as the thickness (in units of \\(10^{-3}\\ \\rm{cm}\\) or \\(10^{-5}\\ \\rm{m}\\)) of that layer which would be formed by the total ozone in a column reduced to the pressure of \\(760\\ \\rm{Torr}\\) and temperature of \\(0\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Dobson unit" .

goldbook:D01828 a skos:Concept ;
    skos:definition "An affix used in names to denote eight atoms bound into a dodecahedron with triangular faces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>dodecahedro</i>-" .

goldbook:D01830 a skos:Concept ;
    skos:altLabel "Donnan potential" ;
    skos:definition "The potential difference \\(E_{\\rm{D}}\\) at zero electric current between two identical salt bridges, usually saturated $\\ce{KCl}$ bridges (conveniently measured by linking them to two identical electrodes) inserted into two solutions in Donnan equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Donnan emf" .

goldbook:D01831 a skos:Concept ;
    skos:definition "The equilibrium characterized by an unequal distribution of diffusible ions between two ionic solutions (one or both of the solutions may be gelled) separated by a membrane which is impermeable to at least one of the ionic species present, e.g. because they are too large to pass through the pores of the membrane. The membrane may be replaced by other kinds of restraint, such as gelation, the field of gravity, etc., which prevent some ionic components from moving from one phase to the other, but allow other components to do so." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Donnan equilibrium" .

goldbook:D01833 a skos:Concept ;
    skos:altLabel "DN" ;
    skos:definition "A quantitative measure of Lewis basicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "donor number" .

goldbook:D01834 a skos:Concept ;
    skos:definition "The action of adding a small amount of foreign atoms to form a solid solution in the lattice of a non-metallic catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "doping" .

goldbook:D01835 a skos:Concept ;
    skos:definition "Broadening due to the random motion of the emitting or absorbing atoms. A Doppler broadened line has a Gaussian shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Doppler broadening" .

goldbook:D01837 a skos:Concept ;
    skos:definition "As applied to an air pollutant in an exposure chamber, dosage is commonly defined as the concentration of the pollutant times the duration of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dosage" .

goldbook:D01839 a skos:Concept ;
    skos:definition "A general term denoting the quantity of radiation or energy absorbed. For special purposes, it must be appropriately qualified e.g. absorbed, maximum permissible, mean lethal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose" .

goldbook:D01841 a skos:Concept ;
    skos:definition "Product of the absorbed dose of ionizing radiation, a quality factor and a modifying factor to take into account the effect of radiation on different biological tissues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose equivalent" .

goldbook:D01843 a skos:Concept ;
    skos:definition "In a gamma-ray spectrum, the peak due to pair production in the detector and escape, from the sensitive part of the detector, of two photons of \\(511\\ \\rm{keV}\\) resulting from annihilation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double escape peak" .

goldbook:D01844 a skos:Concept ;
    skos:definition "An instrument which uses both direction and velocity focusing, and therefore an ion beam initially diverging in direction and containing ions of different kinetic energies is separated into beams according to the quotient mass/charge, these beams being focused on to a photographic plate or film." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-focusing mass spectrograph" .

goldbook:D01845 a skos:Concept ;
    skos:definition "An instrument which uses both direction and velocity focusing, and therefore an ion beam of a given mass/charge is brought to a focus when the ion beam is initially diverging and contains ions of the same mass and charge with different translational energies. The ion beam is measured electrically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-focusing mass spectrometer" .

goldbook:D01847 a skos:Concept ;
    skos:definition "The non-faradaic current associated with the charging of the electrical double layer at an electrode-solution interface, given by: \\[i_{\\mathrm{DL}}=\\frac{\\mathrm{d}(\\sigma \\ A)}{\\mathrm{d}t}\\] where \\(\\sigma \\) = surface charge density of the double layer, \\(A\\) = area of the electrode-solution interface and \\(t\\) = time. Capital letters should be used as subscripts to avoid the possibility of confusing this symbol with that for the limiting diffusion current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-layer current" .

goldbook:D01849 a skos:Concept ;
    skos:definition "A chain that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through three or four atoms, two on one side and either one or two on the other side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-strand chain" .

goldbook:D01850 a skos:Concept ;
    skos:definition "A copolymer the macromolecules of which are double-strand macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-strand copolymer" .

goldbook:D01851 a skos:Concept ;
    skos:definition "A macromolecule that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through three or four atoms, two on one side and either one or two on the other side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-strand macromolecule" .

goldbook:D01852 a skos:Concept ;
    skos:definition "A polymer the macromolecules of which are double-strand macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-strand polymer" .

goldbook:D01853 a skos:Concept ;
    skos:definition "A state having a total electron spin quantum number equal to \\(\\frac{1}{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "doublet state" .

goldbook:D01854 a skos:Concept ;
    skos:definition "The effect of spectral background due to impurities, solvent or radiation scattering may be reduced if the difference in the absorbances of a sample measured at two selected wavelengths is obtained. This is often achieved by repetitively switching from one wavelength to the other. Double-wavelength spectroscopy does this automatically by allowing two beams of radiation of different wavelengths to pass through the cell. One beam is fixed at a longer wavelength and the other measures absorbance while being scanned over a limited wavelength range at shorter wavelengths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "double-wavelength spectroscopy" .

goldbook:D01855 a skos:Concept ;
    skos:definition "The time (\\(\\min \\), \\(\\mathrm{h}\\)) required for a cell population to double either the number of cells or the active cell mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "doubling time" .

goldbook:D01857 a skos:Concept ;
    skos:definition "The loss of time that should be available for analysis. This might be due to breakdown, maintenance or other factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "down-time" .

goldbook:D01858 a skos:Concept ;
    skos:definition "As applied to the action of chimney gases, it is the downward motion of the chimney gases brought on by eddies which form in the lee of a chimney when the wind is blowing. It may result in bringing the flue gases to the ground prematurely." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "downwash" .

goldbook:D01859 a skos:Concept ;
    skos:definition "A slow non-random change in signal with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drift" .

goldbook:D01860 a skos:Concept ;
    skos:altLabel "affinity" ;
    skos:definition "The decrease in Gibbs energy on going from the reactants to the products of a chemical reaction (\\(-\\Delta G\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "driving force" .

goldbook:D01861 a skos:Concept ;
    skos:definition "A small liquid particle. The size of droplets encountered in the atmosphere extends over a wide range; e.g. liquid aerosol solutions which make up the fine particle fraction of continental tropospheric aerosol are usually \\(2\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter. Cloud water droplets usually have diameters in the range of \\(5{-}70\\ \\unicode[Times]{x3BC}\\rm{m}\\), while rain droplets commonly have diameters ranging from \\(0.1{-}3\\ \\rm{mm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "droplet" .

goldbook:D01862 a skos:Concept ;
    skos:definition "The time that elapses between the instants at which two successive drops of liquid metal are detached from the tip of the capillary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drop time" .

goldbook:D01863 a skos:Concept ;
    skos:definition "Any substance which when absorbed into a living organism may modify one or more of its functions. The term is generally accepted for a substance taken for a therapeutic purpose, but is also commonly used for abused substances. Synonymous with medicine, pharmaceutical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug" .

goldbook:D01864 a skos:Concept ;
    skos:definition "In psychrometry, the temperature of the gas measured by a dry bulb thermometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dry bulb temperature" .

goldbook:D01865 a skos:Concept ;
    skos:definition "A substance which removes water (liquid or gaseous)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drying agent" .

goldbook:D01866 a skos:Concept ;
    skos:definition "In a general sense, any equation which expresses substituent effects in terms of two parameters. However, in practice the term is used more specifically for an equation for summarizing the effects of meta- or para- substituents (i = m or p) $\\ce{\\textbf{X}}$ on chemical reactivity, spectroscopic properties, etc. of a probe site $\\ce{\\textbf{Y}}$ in benzene or other aromatic system. \\[P^{\\rm{i}} = \\rho_{I}^{\\rm{i}}\\ \\sigma_{I} + \\rho_{R}^{\\rm{i}} \\sigma_{R}\\] \\(P\\) is the magnitude of the property $\\ce{\\textbf{Y}}$ for substituent $\\ce{\\textbf{X}}$, expressed relative to the property for $\\ce{X} = \\ce{H}$; \\(\\sigma _{I}\\) and \\(\\sigma _{R}\\) are inductive or polar and resonance substituent constants, respectively, there being various scales for \\(\\sigma _{R};\\,\\rho _{I}\\) and \\(\\rho _{R}\\) are the corresponding regression coefficients." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual substituent-parameter equation" .

goldbook:D01867 a skos:Concept ;
    skos:definition "Small, dry, solid particles projected into the air by natural forces, such as wind, volcanic eruption and by mechanical or man-made processes such as crushing, grinding, milling, drilling, demolition, shoveling, conveying, screening, bagging and sweeping. Dust particles are usually in the size range from about \\(1{-}100\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter and they settle slowly under the influence of gravity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dust" .

goldbook:D01868 a skos:Concept ;
    skos:definition "A device for monitoring dust emissions. Also the equipment used to remove and collect dust from process exhaust gases; this may employ simply sedimentation (dustfall jars, coated slides, papers, etc.), inertial separation (cyclones, impactors, impingers, etc.), precipitation (thermal and electrostatic) or filtration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dust collector" .

goldbook:D01869 a skos:Concept ;
    skos:definition "Solid particles in the air which fall to the ground under the influence of gravity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dust fall" .

goldbook:D01870 a skos:Concept ;
    skos:definition "A CW or pulsed source of coherent radiation in which the active medium is usually a solution of a fluorescent organic molecule (the dye) pumped with a suitable pump laser or with a flash lamp. These lasers can be tuned over a large part of the fluorescence band of the dye." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dye laser" .

goldbook:D01871 a skos:Concept ;
    skos:altLabel "dynamic field mass spectrometer",
        "dynamic fields mass spectrometer" ;
    skos:definition "A mass spectrometer in which the separation of a selected ion beam depends essentially on the use of fields, or a field, varying with time. These fields are generally electric." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic fields mass spectrometer" .

goldbook:D01874 a skos:Concept ;
    skos:definition "The ratio between the maximum usable indication and the minimum usable indication (detection limit). A distinction may be made between the linear dynamic range, where the response is directly proportional to concentration, and the dynamic range where the response may be non-linear, especially at higher concentrations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic range" .

goldbook:D01875 a skos:Concept ;
    skos:altLabel "dynamic interfacial tension" ;
    skos:definition "In certain circumstances, one may measure surface tensions that are different from the equilibrium value. Such a surface tension is called the dynamic surface (or interfacial) tension (\\(\\gamma ^{\\rm{dyn}}\\) or \\(\\sigma ^{\\mathrm{dyn}}\\)). The equilibrium value is then called the static surface (or interfacial) tension (\\(\\gamma ^{\\rm{st}}\\) or \\(\\sigma ^{\\mathrm{st}}\\)). The modifying signs may be omitted if there is no danger of ambiguity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic surface tension" .

goldbook:D01879 a skos:Concept ;
    skos:definition "An uncatalysed process in which two $\\ce{\\upsigma\\!\\mbox{-}bonds}$ simultaneously migrate intramolecularly, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dyotropic rearrangement" .

goldbook:D01880 a skos:Concept ;
    skos:definition "1,3-Diphenylbut-2-en-1-one, $\\ce{PhC(=O)CH=C(CH3)Ph}$, and its ring-substituted derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dypnones" .

goldbook:DT06810 a skos:Concept ;
    skos:definition "Total quantity of a substance administered to, taken up, or absorbed by an organism, organ, or tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose" .

goldbook:DT06866 a skos:Concept ;
    skos:definition "A chemical group used to disrupt the linearity of the backbone of molecules MCPLCs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "disruptor" .

goldbook:DT06874 a skos:Concept ;
    skos:definition "Side of a membrane from which permeate emerges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "downstream" .

goldbook:DT06875 a skos:Concept ;
    skos:definition "Process in which an active layer is formed on the membrane surface by the deposition of substances contained in the fluid being treated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic membrane formation" .

goldbook:DT06889 a skos:Concept ;
    skos:definition "Reduction in concentration of mobile ions within an ion exchange membrane due to the presence of fixed ions of the same sign as the mobile ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Donnan exclusion" .

goldbook:DT06906 a skos:Concept ;
    skos:definition "The graph of the relation between dose and the proportion of individuals responding with an all-or-none effect; it is essentially the graph of the probability of an occurrence (or the proportion of a population exhibiting an effect) against dose. Typical examples of such all-or-none effects are mortality or the incidence of cancer. The dose-effect curve is the graph of the relation between dose and the magnitude of the biological change produced measured in appropriate units. It applies to measurable changes giving a graded response to increasing doses of a drug or xenobiotic. It represents the effect on an individual animal or person, when biological variation is taken into account. An example is the increased effect of lead on the haem synthesis, e.g., on activity of the enzyme 6-amino laevulinic acid dehydratase in blood serum or coproporphyrin levels in urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose-response and dose-effect relationships" .

goldbook:DT06932 a skos:Concept ;
    skos:altLabel "extraction isotherm" ;
    skos:definition "The equilibrium relation between the concentration of a sample component in the stationary phase \\(c_{\\rm{S}}\\), and in the mobile phase \\(c_{\\rm{M}}\\), expressed as a function \\(c_{\\rm{S}}=f(c_{\\rm{M}})\\). In some versions of chromatography, a distribution isotherm can be seen as a partition isotherm, an adsorption isotherm, or a combination of these, depending on the mechanism of separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "distribution isotherm" .

goldbook:DT06957 a skos:Concept ;
    skos:definition "Discriminant analysis is a statistical technique to find a set of descriptors which can be used to detect and rationalize separation between activity classes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "discriminant analysis" .

goldbook:DT06958 a skos:Concept ;
    skos:definition "Docking studies are computational techniques for the exploration of the possible binding modes of a substrate to a given receptor, enzyme or other binding site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "docking studies" .

goldbook:DT06959 a skos:Concept ;
    skos:altLabel "3D-QSAR" ;
    skos:definition "Three-dimensional quantitative structure-activity relationships (3D-QSAR) involve the analysis of the quantitative relationship between the biological activity of a set of compounds and their three-dimensional properties using statistical correlation methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "three-dimensional quantitative structure–activity relationships" .

goldbook:DT06960 a skos:Concept ;
    skos:definition "Drug design includes not only ligand design, but also pharmacokinetics and toxicity, which are mostly beyond the possibilities of structure- and/or computer-aided design. Nevertheless, appropriate chemometric tools, including experimental design and multivariate statistics, can be of value in the planning and evaluation of pharmacokinetics and toxicological experiments and results. Drug design is most often used instead of the correct term 'Ligand Design'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drug design" .

goldbook:DT07018 a skos:Concept ;
    skos:definition "Orbitals whose energy levels are equal in the absence of external fields. Any linear combination of the functions corresponding to a given set of degenerate orbitals serves as an equivalent representation of this set of orbitals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "degenerate orbitals" .

goldbook:DT07019 a skos:Concept ;
    skos:definition "Redistribution of the valence-shell electron density throughout a molecular entity as compared with some localized models (individual atoms in their valence states, separated bonds or fragments). Different topological modes of the electron delocalization include: ribbon delocalization of either $\\ce{\\uppi\\!\\mbox{-}}$ or $\\ce{\\upsigma\\!\\mbox{-}electrons}$ (i.e., electrons occupying respectively $\\ce{\\uppi\\!\\mbox{-}}$ and $\\ce{\\upsigma\\!\\mbox{-}orbitals}$)surface delocalization of $\\ce{\\upsigma\\!\\mbox{-}electrons}$ occurring through an overlap of radially oriented $\\ce{\\upsigma\\!\\mbox{-}orbitals}$ of a cyclic molecule, as is the case of cyclopropane; andvolume delocalization of $\\ce{\\upsigma\\!\\mbox{-}electrons}$ through an overlap of $\\ce{\\upsigma\\!\\mbox{-}orbitals}$ directed inside a molecular polyhedron, as is the case in tetrahedrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delocalization" .

goldbook:DT07020 a skos:Concept ;
    skos:altLabel "DE" ;
    skos:definition "The difference between the actual $\\ce{\\uppi\\!\\mbox{-}electron}$ energy of a molecular entity and the $\\ce{\\uppi\\!\\mbox{-}electron}$ energy of a hypothetical species with a localized form of the $\\ce{\\uppi\\!\\mbox{-}electron}$ system. These energies are normally evaluated within Hückel molecular orbital theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "delocalization energy" .

goldbook:DT07021 a skos:Concept ;
    skos:altLabel "DRP" ;
    skos:definition "A classical trajectory method based on molecular orbital calculations which determines atomic accelerations, velocities and positions using the energy gradient, and does not require prior knowledge of the potential energy surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dynamic reaction path" .

goldbook:DT07203 a skos:Concept ;
    skos:definition "Charge-transfer agent used to generate, by oxidation or reduction, positive or negative charges in an intrinsically conducting polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dopant" .

goldbook:DT07204 a skos:Concept ;
    skos:definition "Oxidation or reduction process brought about by a dopant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "doping" .

goldbook:DT07352 a skos:Concept ;
    skos:altLabel "DAS" ;
    skos:definition "Acronym for decay-associated spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "DAS" .

goldbook:DT07353 a skos:Concept ;
    skos:definition "Set of rules proposed in 1975 to classify photochemical reactions based on correlation diagrams and under the assumption that all photochemical processes are controlled by the generation of primary products with characteristics of diradicals, i.e., considering the physical fact that the initial single excitation separates two electrons of a pair into two distinct orbitals. The reactions are classified according to their topicity, i.e., the total number and nature of available radical sites generated in the primary photochemical product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Dauben–Salem–Turro rules" .

goldbook:DT07354 a skos:Concept ;
    skos:definition "Photochemical process leading to the formation of cyclobutanols by cycloaddition of an alkene to a 1,3-dicarbonyl-enol. The enol originates in most cases from the tautomerization of a 1,3-dicarbonyl compound. The products of the de Mayo reaction are susceptible to undergo a retro-aldol ring opening resulting in the formation of 1,5-dicarbonyl compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "de Mayo reaction" .

goldbook:DT07356 a skos:Concept ;
    skos:definition "A mirror used to reflect light selectively according to its wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dichroic mirror" .

goldbook:DT07357 a skos:Concept ;
    skos:definition "Dependence of absorbance of a sample on the type of polarization of the measuring beam. This polarization may be linear, corresponding to linear dichroism (LD) in which the difference in absorption for two perpendicularly linearly polarized beams is measured, \\(\\Delta A_{\\rm{l}} = A_{\\rm{Z}} - A_{\\rm{Y}}\\), or circular dichroism (CD) in which the difference in absorption for left minus right circularly polarized beams is measured, \\(\\Delta A_{\\rm{C}} = A_{\\rm{L}} - A_{\\rm{R}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dichroism" .

goldbook:DT07358 a skos:Concept ;
    skos:altLabel "biradicaloid" ;
    skos:definition "Diradical-like. Often used to refer to a species in which the two radical centres interact significantly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "diradicaloid" .

goldbook:DT07360 a skos:Concept ;
    skos:definition "Silicon version of the di-π-methane rearrangement with a $\\ce{Si}$ atom at position 3 of the basic 1,4-diene chromophore." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "di-π-silane rearrangement" .

goldbook:DT07361 a skos:Concept ;
    skos:definition "Energy or amount of photons absorbed per volume (or per mass) by an irradiated object during a particular exposure time. SI units are \\(\\pu{J m-3}\\) or \\(\\pu{J g-1}\\) and \\(\\pu{mol m-3}\\) or \\(\\pu{mol g-1}\\), respectively. Common units are \\(\\pu{einstein m-3}\\) or \\(\\pu{einstein g-1}\\), respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dose" .

goldbook:DT07362 a skos:Concept ;
    skos:definition "Process by which a photon with frequency \\( u _{1}\\) interacts with a non-linear medium and splits into two simultaneously emitted photons with frequencies \\( u _{2}\\) and \\( u _{3}\\) so that the energy is conserved: \\[ u _{1}= u _{2}+ u _{3}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "downconversion" .

goldbook:DT07363 a skos:Concept ;
    skos:definition "Term widely used to indicate the negative of the standard Gibbs energy change for outer-sphere electron transfer (\\(\\Delta _{\\rm{ET}}G^{\\,\\unicode{x26ac}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "driving force" .

goldbook:DT07364 a skos:Concept ;
    skos:definition "Equation describing the contraction (\\(\\Delta V_{\\rm{el}}\\)) taking place in a dielectric medium of relative static permittivity \\(\\varepsilon_{\\rm{r}}\\) (formerly called dielectric constant) upon introduction of an ion of charge number \\(z\\) and radius \\(r\\): \\[\\Delta V_{\\rm{el}} = -\\frac{\\left ( z\\,e \\right )^{2}}{2\\,r\\,\\varepsilon_{\\rm{r}}}\\frac{\\partial\\left ( \\rm{ln}\\varepsilon_{\\rm{r}}\\right)}{\\partial\\,p}\\] with \\(e\\) the elementary charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Drude–Nernst equation" .

goldbook:DT07365 a skos:Concept ;
    skos:definition "Systems or molecular species showing two fluorescence bands. Several non-trivial molecular properties may be at the basis of a dual fluorescence, such as conformational equilibrium in the ground state and a mixture of excited states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual fluorescence" .

goldbook:DT07366 a skos:Concept ;
    skos:definition "Photochromism occurring in complex systems and triggered alternatively by two different external stimuli, such as light and an electric current. In such a case photochromism and 'electrochromism' are mutually regulated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "dual-mode photochromism" .

goldbook:DT07534 a skos:Concept ;
    skos:altLabel "DCCA" ;
    skos:definition "Co-solvent included to facilitate the rapid drying of gels without cracking." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "drying control chemical additive" .

goldbook:DT07618 a skos:Concept ;
    skos:definition "Removal of impurities and the elimination of pores from a xerogel to give a material of as near bulk density as possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "densification" .

goldbook:E00008 a skos:Concept ;
    skos:definition "A general reaction by which a group attached to the alpha carbon of an excited chromophore is expelled either as an odd electron species or as an anionic species. This reaction should be distinguished from an α-(alpha-)cleavage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-expulsion" .

goldbook:E01882 a skos:Concept ;
    skos:definition "The approved stereodescriptors of stereoisomeric alkenes $\\ce{R1R2C=CR3R4}$ ($\\ce{R1}  eq \\ce{R2} , \\ce{R3}  eq \\ce{R4}$); neither $\\ce{R1}$ nor $\\ce{R2}$ need be different from $\\ce{R3}$ or $\\ce{R4}$), cumulenes $\\ce{R1R2C(=C=C)_{n}=CR3R4}$ and related systems e.g. $\\ce{R1R2C=NOH}$, $\\ce{HON=C\\{[CH2]_{n}\\}2C=NOH}$. The group of highest CIP priority attached to one of the terminal doubly bonded atoms of the alkene, oxime, etc. or cumulene (i.e. $\\ce{R1}$ or $\\ce{R2}$) is compared with the group of highest precedence attached to the other (i.e. $\\ce{R3}$ or $\\ce{R4}$). The stereoisomer is designated as $Z$ (zusammen = together) if the groups lie on the same side of a reference plane passing through the double bond and perpendicular to the plane containing the bonds linking the groups to the double-bonded atoms; the other stereoisomer is designated as $E$ (entgegen = opposite). The descriptors may be applied to structures with a fractional bond order between one and two; and to double bonds involving elements other than carbon. They are not used to describe ring substitution relationships." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>E</i>, <i>Z</i>" .

goldbook:E01884 a skos:Concept ;
    skos:definition "Two atoms or groups attached to adjacent atoms are said to be eclipsed if the torsion angle between the three bonds is zero (or approximately so)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eclipsed" .

goldbook:E01886 a skos:Concept ;
    skos:altLabel "Pitzer strain",
        "bond opposition strain",
        "torsional strain" ;
    skos:definition "Intramolecular strain present due to nonbonded interactions between two eclipsed atoms or groups. It is, for example, one of the interactions responsible for the existence of a rotational barrier and hence restricted rotation about the $\\ce{C–C}$ bond in ethane. It has also been called Pitzer strain, torsional strain and bond opposition strain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eclipsing strain" .

goldbook:E01888 a skos:Concept ;
    skos:definition "In turbulent fluid motion, a blob of the fluid that has some definitive character and moves in some way differently from the main flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eddy" .

goldbook:E01889 a skos:Concept ;
    skos:altLabel "diffusion" ;
    skos:definition "The process by which substances are mixed in the atmosphere or in any fluid system due to eddy motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eddy dispersion" .

goldbook:E01890 a skos:Concept ;
    skos:definition "Term used mainly in the German literature for starting material (reactant). It should be avoided in English, because there it means 'something that comes out' and not 'something that goes in'. The German use of the term is in fact also incorrect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "educt" .

goldbook:E01891 a skos:Concept ;
    skos:definition "In a given experimental configuration, the energy value determined by the condition that the detector response would be unchanged if the cadmium cover surrounding the detector was replaced by a fictitious cover opaque to neutrons with energy below this value and transparent to neutrons with energy above this value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective cadmium cut-off energy" .

goldbook:E01892 a skos:Concept ;
    skos:definition "Change in effective charge is a quantity obtained by comparison of the polar effect of substituents on the free energies of rate or equilibrium processes with that on a standard ionization equilibrium. Provided the effective charges on the states in the standard equilibrium are defined, then it is possible to measure effective charges for states in the reaction or equilibrium under consideration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective charge" .

goldbook:E01893 a skos:Concept ;
    skos:altLabel "stack height" ;
    skos:definition "A height used for the purposes of calculating the dispersion of emitted gases from a chimney, and which differs from the real chimney height by an amount which depends on such factors as the exit velocity, buoyancy effects and wind speed; it may also be affected by the local topography. It denotes the maximum height of the centre of a plume path above the level of the ground. The effective height may be above or below the actual chimney height, although the former case is most common." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective chimney height" .

goldbook:E01894 a skos:Concept ;
    skos:definition "For a radioactive substance, the time required for the amount of that substance in a biological system to be reduced to one half of its value by both radioactive decay and biological processes, when the rate of removal is approximately exponential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective half life" .

goldbook:E01896 a skos:Concept ;
    skos:altLabel "effective concentration" ;
    skos:definition "The ratio of the first-order rate constant of an intramolecular reaction involving two functional groups within the same molecular entity to the second-order rate constant of an analogous intermolecular elementary reaction. This ratio has the dimension of concentration. The term can also apply to an equilibrium constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective molarity" .

goldbook:E01899 a skos:Concept ;
    skos:altLabel "Westcott cross-section" ;
    skos:definition "A fictitious cross-section for a specified reaction, which, when multiplied by the 2200 metre-per-second flux density, gives the correct reaction rate for thermal neutrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effective thermal cross-section" .

goldbook:E01901 a skos:Concept ;
    skos:definition "A small molecule which increases (activator) or decreases (inhibitor) the activity of an (allosteric) protein by binding to the protein at the regulatory site (which is different from the substrate-binding catalytic site)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effector" .

goldbook:E01902 a skos:Concept ;
    skos:definition "The ratio between the useful energy delivered or bound and the energy supplied, i.e. energy output/energy input. It is also used in the sense of a quantitative measure of the relative rate of a given step involving a species with respect to the sum of the rates of all of the parallel steps which depopulate that species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efficiency" .

goldbook:E01907 a skos:Concept ;
    skos:definition "The substance fraction of component entering the flame in the amount of component consumed. The efficiency of nebulization is related to the amount of component and not to the amount of solvent. It cannot be calculated directly from the ratio: volume rate of sample drained from the spray chamber divided by volume rate of fluid consumed. Corrections usually have to be made to take account of differences in component concentrations in the drained and consumed solutions, respectively, because of evaporation of some solvent from mist droplets deposited on the walls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efficiency of nebulization" .

goldbook:E01908 a skos:Concept ;
    skos:definition "A plot of the efficiency of a step (\\(\\eta \\)) against wavelength or photon energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efficiency spectrum" .

goldbook:E01909 a skos:Concept ;
    skos:definition "The reverse of deliquescence: the drying of a salt solution when the vapour pressure of water in the saturated solution of a substance is greater than the partial pressure of water in the ambient air. Also refers to the loss of water of crystallization from a solid salt such as $\\ce{Na2CO3.10H2O}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "efflorescence" .

goldbook:E01910 a skos:Concept ;
    skos:definition "Any spent liquors or other waste materials which are emitted by a source (waste from plating shops, pickling tanks, sewage treatment plants, chemical manufacturing plants, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effluent" .

goldbook:E01911 a skos:Concept ;
    skos:definition "The mobile phase leaving the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "effluent" .

goldbook:E01913 a skos:Concept ;
    skos:definition "An electron-counting rule to which an overwhelming majority of stable diamagnetic transition metal complexes adhere. The number of nonbonded electrons at the metal plus the number of electrons in the metal-ligand bonds should be 18. The 18 electron rule in transition metal chemistry is a full analogue of the 'Lewis octet rule'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eighteen-electron rule" .

goldbook:E01914 a skos:Concept ;
    skos:definition "One mole of photons. Although widely used, it is not an IUPAC sanctioned unit. It is sometimes defined as the energy of one mole of photons. This use is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "einstein" .

goldbook:E01915 a skos:Concept ;
    skos:definition "A particle (atom or molecule) can undergo a change in its state of excitation as a result of collisions with other particles. In an elastic collision an exchange only of kinetic energy takes place between the colliding species; in an inelastic collision there is an interchange between the kinetic energy and the internal energy of the particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastic collision" .

goldbook:E01916 a skos:Concept ;
    skos:definition "When in a molecular collision there is no transfer of energy among different degrees of freedom, there is said to be elastic scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastic scattering" .

goldbook:E01917 a skos:Concept ;
    skos:definition "Radiation may be scattered by its transmission through a medium containing particles. If the scatter results in no significant change in the wavelength relative to the primary radiation it is called elastic scattering. In cases where the scattering centres are small compared to the wavelength of the radiation the elastic scattering is called Rayleigh scattering and Mie scattering if this condition is not fulfilled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastic scattering" .

goldbook:E01921 a skos:Concept ;
    skos:definition "A hygrometer whose sensitive element has electrical properties which vary with the humidity of the gas which traverses the hygrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrical hygrometer" .

goldbook:E01923 a skos:Concept ;
    skos:altLabel "charge" ;
    skos:definition "Integral of the electric current over time. The smallest electric charge found on its own is the elementary charge, \\(e\\), the charge of a proton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric charge" .

goldbook:E01925 a skos:Concept ;
    skos:altLabel "conductance" ;
    skos:definition "Reciprocal of the electric resistance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric conductance" .

goldbook:E01927 a skos:Concept ;
    skos:definition "Base quantity in the system of quantities upon which SI is based." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric current" .

goldbook:E01928 a skos:Concept ;
    skos:definition "A vector quantity the scalar product of which with the cross sectional area vector is equal to the electric current. By magnitude it is the electric current divided by the cross sectional area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric current density" .

goldbook:E01931 a skos:Concept ;
    skos:altLabel "electric field strength" ;
    skos:definition "Force acting on a charge divided by the charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric field" .

goldbook:E01934 a skos:Concept ;
    skos:altLabel "emf" ;
    skos:definition "Difference in the potentials of electrodes on the right and left of a galvanic cell. When \\(\\Delta V\\) is positive, positive charge flows from left to right through the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric potential difference" .

goldbook:E01936 a skos:Concept ;
    skos:definition "To direct current, the potential difference divided by the current when there is no electromotive force in the conductor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric resistance" .

goldbook:E01938 a skos:Concept ;
    skos:definition "An arrangement of two conducting sheets forming a capactor and giving a radial electrostatic field which is used to deflect and focus ion beams of different energies. The capacitor may, for example, be cylindrical, spherical or toroidal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electric sector" .

goldbook:E01939 a skos:Concept ;
    skos:definition "An interphase between phases containing free charged components which are usually accumulated or depleted in the surface region thus giving rise to net charges on the phase. This definition includes the special case when the net charge on each of the phases reduces to zero. Charged components may or may not cross the interface between two phases, so that interphases may be divided into the limiting types unpolarizable and polarizable, respectively. Ideally unpolarizable interphases are those for which the exchange of common charged particles between the phases proceeds unhindered. Ideally polarizable interphases are those for which there are no common components between the phases or the exchange of these is hindered. This condition may arise as a result of the equilibrium conditions or from the kinetics of charge transfer and leads to an interphase which is impermeable to electric charge. Real interphases may approach more or less well one of these idealized cases. Polarisibility or non-polarisibility is not an absolute property of an interphase but depends on a number of conditions, e.g. time scale of the experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrified interphase" .

goldbook:E01940 a skos:Concept ;
    skos:altLabel "depolarizer" ;
    skos:definition "In voltammetry and related techniques, a substance that undergoes a change of oxidation state, or the breaking or formation of chemical bonds, in a charge-transfer step. If an electroactive substance B is formed, in the solution or electrode, by a chemical reaction from another substance C, the substance C should be called the precursor of B. In potentiometry with ion-selective electrodes, a material containing, or in ion-exchange equilibrium with, the sensed ion. The electroactive substance is often incorporated in an inert matrix such as poly(vinyl chloride) or silicone rubber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroactive substance" .

goldbook:E01941 a skos:Concept ;
    skos:definition "The dependence of the interfacial tension on the electrical state of the interphase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrocapillarity" .

goldbook:E01942 a skos:Concept ;
    skos:definition "A form of the Gibbs adsorption equation which includes an expression of the phenomenon of electrocapillarity: \\[s\\ \\mathrm{d}T- \\tau \\ \\mathrm{d}p+\\mathrm{d}\\gamma +\\sigma ^{\\alpha }\\ \\mathrm{d}E+\\sum \\mathit{\\Gamma }_{j}\\ \\mathrm{d}\\mu _{j}=0\\] where \\(s\\) is the surface excess of entropy of unit area of interphase, \\(T\\) is the temperature, \\(\\tau \\) is the thickness or excess volume of unit area of the interphase, \\(p\\) is the external pressure, \\(\\gamma \\) is the interfacial tension, \\(\\sigma ^{\\alpha }\\) is the free surface charge density on phase \\(\\alpha \\) (areal amount of charge on the surface of phase \\(\\alpha \\)), \\(E\\) is the generalized potential, \\(\\mathit{\\Gamma}_{j}\\) is the surface excess, \\(\\mu _{j}\\) is the chemical potential and \\(j\\) is an electrically neutral component of one or other of the phases; the sum is over all the components but one in each phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrocapillary equation" .

goldbook:E01943 a skos:Concept ;
    skos:definition "An electrochemical cell which responds to certain substances in the carrier gas eluting from the column. The electrochemical process may be an oxidation, reduction or a change in conductivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical detector" .

goldbook:E01944 a skos:Concept ;
    skos:definition "A method in which either current or potential is measured during an electrochemical reaction. The gas or liquid containing the trace impurity to be analysed is sent through an electrochemical cell containing a liquid or solid electrolyte and in which an electrochemical reaction specific to the impurity takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrochemical method of detection" .

goldbook:E01948 a skos:Concept ;
    skos:definition "A molecular rearrangement that involves the formation of a $\\ce{\\upsigma\\!\\mbox{-}bond}$ between the termini of a fully conjugated linear $\\ce{\\uppi\\!\\mbox{-}electron}$ system (or a linear fragment of a $\\ce{\\uppi\\!\\mbox{-}electron}$ system) and a decrease by one in the number of , or the reverse of that process. For example:  The stereochemistry of such a process is termed 'conrotatory' or antarafacial if the substituents at the interacting termini of the conjugated system both rotate in the same sense, e.g.  or 'disrotatory' (or suprafacial) if one terminus rotates in a clockwise and the other in a counter-clockwise sense, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrocyclic reaction" .

goldbook:E01950 a skos:Concept ;
    skos:altLabel "electrophoresis convection" ;
    skos:definition "Electrodialysis may lead to local differences in concentration and density. Under the influence of gravity these density differences lead to large scale separation of sols of high and of low (often vanishingly low) concentrations. This process is called electrodecantation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrodecantation" .

goldbook:E01952 a skos:Concept ;
    skos:definition "If the charging current is negligible, in the case of a single electrode reaction, the electrode current density (\\(\\rm{c.d.}\\)) of the electric current flowing through the electrode is related to the flux density of a species B by the equation: \\[j = n\\  u _{\\rm{B}}^{-1}\\ F\\ \\left(N_{\\rm{B}}\\right)_{e}\\] where \\(\\left(N_{\\rm{B}}\\right)_{e}\\) is the normal component of the vector \\(N_{\\rm{B}}\\) at the electrode-solution interface, \\(n\\) is the charge number of the electrode reaction and \\( u _{\\rm{B}}\\) is the stoichiometric number of species B. The ratio \\(\\frac{n}{ u _{\\rm{B}}}\\) is to be taken as positive if the species B is consumed in a cathodic reaction or produced in an anodic reaction. Otherwise it is to be taken as negative. With the convention that the normal distance vector points into the electrolytic solution, a cathodic current is then negative, an anodic current positive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode current density" .

goldbook:E01955 a skos:Concept ;
    skos:definition "The deposition of dissolved or suspended material by an electric field on an electrode. (Includes electro-crystallization)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrodeposition" .

goldbook:E01956 a skos:Concept ;
    skos:definition "Electromotive force of a cell in which the electrode on the left is a standard hydrogen electrode and the electrode on the right is the electrode in question." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode potential" .

goldbook:E01959 a skos:Concept ;
    skos:definition "The totality of changes occurring at or near a single electrode during the passage of current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode process" .

goldbook:E01960 a skos:Concept ;
    skos:definition "For an electrode process at a given potential the current is controlled by the kinetics of a number of steps which include the transport of reactants to and from the interface and the interfacial reaction itself. The latter, which is called the electrode reaction, must always include at least one elementary step in which charge is transferred from one phase to the other, but may also involve purely chemical steps within the interfacial region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode reaction" .

goldbook:E01961 a skos:Concept ;
    skos:definition "The electrode reaction rate constants are related to the partial currents by \\[k_{\\mathrm{ox}}=\\frac{l_{\\rm{a}}}{n\\ F\\ A\\ \\Pi\\: c_{i}^{ u _{i}}}\\] \\[k_{\\mathrm{red}}=\\frac{l_{\\rm{c}}}{n\\ F\\ A\\ \\Pi\\:c_{i}^{ u _{i}}}\\] where \\(k_{\\mathrm{ox}}\\) and \\(k_{\\mathrm{red}}\\) are the rate constants for the oxidizing (anodic) and reducing (cathodic) reactions respectively, \\(n\\) is the charge number of the cell reaction, \\(F\\) is the Faraday constant and \\(A\\) is the geometric area of the electrode, the product \\(\\Pi\\:c_{i}^{ u _{i}}\\) includes all the species \\(i\\) which take part in the partial reaction, \\(c_{i}\\) is the volume concentration of species \\(i\\) and \\( u _{i}\\) is the order of the reaction with respect to species \\(i\\). The conditional rate constant of an electrode reaction is the value of the electrode reaction rate constant at the conditional (formal) potential of the electrode reaction. When \\(\\alpha \\) the transfer coefficient is independent of potential, \\[k_{\\rm{c}} = \\frac{k_{\\rm{ox}}}{\\rm{e}^{\\frac{\\alpha _{\\rm{a}}\\ (E- E_{\\rm{c}}^{0'})\\ n\\ F}{ u \\ R\\ T}}} = \\frac{k_{\\rm{red}}}{\\rm{e}^{\\frac{-\\alpha _{\\rm{c}}\\ (E- E_{\\rm{c}}^{0'})\\ n\\ F}{ u \\ R\\ T}}}\\] where \\(\\alpha _{\\rm{a}}\\) and \\(\\alpha _{\\rm{c}}\\) are the anodic and cathodic transfer coefficients respectively, \\(E\\) is the electric potential difference, \\(E_{\\rm{c}}\\) is the conditional (formal) potential, \\( u \\) is the stoichiometric number, \\(R\\) is the gas constant and \\(T\\) is the thermodynamic temperature. Similar rate constants can be defined using activities in place of concentrations in the first two equations, and the standard electrode potential in place of the conditional potential in the latter two equations. This type of rate constant is called the standard rate constant of the electrode reaction. The observable electrode rate constant is the constant of proportionality expressing the dependence of the rate of the electrode reaction on the interfacial concentration of the chemical species involved in the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrode reaction rate constants" .

goldbook:E01965 a skos:Concept ;
    skos:definition "A leaving group that does not carry away the bonding electron pair. For example, in the nitration of benzene by $\\ce{NO2^{+}}$, $\\ce{H^{+}}$ is the electrofuge. The adjective of electrofuge is electrofugal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrofuge" .

goldbook:E01966 a skos:Concept ;
    skos:altLabel "ECL",
        "electrochemiluminescence",
        "electroluminescence" ;
    skos:definition "Luminescence produced by electrode reactions. Also called electroluminescence or electrochemiluminescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrogenerated chemiluminescence" .

goldbook:E01967 a skos:Concept ;
    skos:definition "A synthetic graphite made by electrical heating of graphitizable carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrographite" .

goldbook:E01968 a skos:Concept ;
    skos:altLabel "ζ-potential" ;
    skos:definition "Potential drop across the mobile part of the double layer, that is responsible for electrokinetic phenomena. \\(\\zeta \\) is positive if the potential increases from the bulk of the liquid phase towards the interface. In calculating the electrokinetic potential from electrokinetic phenomena it is often asumed that the liquid adhering to the solid wall and the mobile liquid are separated by a sharp shear plane. As long as there is no reliable information on the values of the permittivity and the viscosity in the electrical double layer close to the interface, the calculation of the electrokinetic potential from electrokinetic experiments remains open to criticism. It is therefore essential to indicate in all cases which equations have been used in the calculation of \\(\\zeta \\). It can be shown, however, that for the same assumptions about the permittivity and viscosity all electrokinetic phenomena must give the same value for the electrokinetic potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrokinetic potential" .

goldbook:E01972 a skos:Concept ;
    skos:definition "Hygrometer using a hygroscopic substance (for example, diphosphorus pentaoxide, $\\ce{P2O5}$) which is transformed into an electrolyte (phosphoric acid, $\\ce{H3PO4}$) in contact with the moisture in the gas. The electrolyte (phosphoric acid) is electrolysed continuously and the electrolysis current is measured. At a constant flow of the gas to be analysed, the electrolysis current is a linear function of the water concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrolytic hygrometer" .

goldbook:E01973 a skos:Concept ;
    skos:altLabel "tautomeric effect" ;
    skos:definition "A molecular polarizability effect occurring by an intramolecular electron displacement (sometimes called the 'conjugative mechanism' and, previously, the 'tautomeric mechanism') characterized by the substitution of one electron pair for another within the same atomic octet of electrons. It can be indicated by curved arrow symbolizing the displacement of electron pairs, as in:  which represents the hypothetical electron shift  The term has been deemed obsolescent or even obsolete (see mesomeric effect, resonance effect). It has long been custom to use phrases such as 'enhanced substituent resonance effect' which imply the operation of the electromeric effect, without using the term, and various modern theoretical treatments parametrize the response of substituents to 'electronic demand', which amounts to considering the electromeric effect together with the inductomeric effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromeric effect" .

goldbook:E01974 a skos:Concept ;
    skos:definition "Energy supplied by a source divided by the electric charge transported through the source. For a galvanic cell it is equal to the electric potential difference for zero current through the cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromotive force" .

goldbook:E01976 a skos:Concept ;
    skos:definition "A substance to which an electron may be transferred; for example 1,4-dinitrobenzene or the dication 1,1'-dimethyl-4,4'-bipyridyldiium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron acceptor" .

goldbook:E01977 a skos:Concept ;
    skos:definition "Energy required to detach an electron from the singly charged negative ion (energy for the process ). The equivalent more common definition is the energy released (\\(E_{\\rm{initial}} - E_{\\rm{final}}\\)) when an additional electron is attached to a neutral atom or molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron affinity" .

goldbook:E01979 a skos:Concept ;
    skos:definition "The transfer of an electron to a molecular entity, resulting in a molecular entity of (algebraically) increased negative charge. It is not an attachment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron attachment" .

goldbook:E01980 a skos:Concept ;
    skos:definition "A nuclear transformation in which the nucleus captures an orbital electron. Often the shell, from which the electron is captured, is indicated. (K-, L-, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron capture" .

goldbook:E01981 a skos:Concept ;
    skos:definition "A small radioactive source containing $\\ce{^{3}H}$ or $\\ce{^{63}Ni}$ ionizes the molecules of the carrier gas (nitrogen or argon–methane), and a potential difference creates a small current. This current is reduced when an electronegative substance (such as a halocarbon) is introduced. The reduction in current is a measure of the concentration of the electronegative substance. The detection limit (threshold) varies greatly according to the substances to be analysed and can reach a mixing ratio of \\(10^{-12}\\). The linear dynamic range may be \\(10^{4}\\) but the maximum measuring value generally lies below \\(1\\ \\rm{ppmv}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron capture detector" .

goldbook:E01982 a skos:Concept ;
    skos:definition "The negative electric charge which appears on the electron or univalent ions [ \\(1.602\\times 10^{-19}\\) coulombs or \\(4.803\\times 10^{-10}\\) electrostatic units (\\(\\mathrm{esu}\\))]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron charge" .

goldbook:E01984 a skos:Concept ;
    skos:definition "The adjustment of electron motion to the instantaneous (as opposed to time-averaged) positions of all the electrons in a molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron correlation" .

goldbook:E01985 a skos:Concept ;
    skos:definition "A single bond between adjacent atoms that is formed by less than two electrons, as in $\\ce{B2H6}$:  The $\\ce{B–H–B}$ bonds are called 'two-electron three-centre bonds'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-deficient bond" .

goldbook:E01986 a skos:Concept ;
    skos:definition "If \\(P(x,\\,y,\\,z)\\ \\rm{d}x\\ \\rm{d}y\\ \\rm{d}z\\) is the probability of finding an electron in the volume element \\(\\rm{d}x\\ \\rm{d}y\\ \\rm{d}z\\) at the point of a molecular entity with coordinates \\(x,\\,y,\\,z\\), then \\(P(x,\\,y,\\,z)\\) is the electron density at this point. For many purposes (e.g. X-ray scattering, forces on atoms) the system behaves exactly as if the electrons were spread out into a continuously distributed charge. The term has frequently been wrongly applied to negative charge population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron density" .

goldbook:E01987 a skos:Concept ;
    skos:definition "The reverse of an electron attachment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron detachment" .

goldbook:E01988 a skos:Concept ;
    skos:definition "A molecular entity that can transfer an electron to another molecular entity, or to the corresponding chemical species.[obsolete] A Lewis base. This use is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron donor" .

goldbook:E01990 a skos:Concept ;
    skos:definition "Concept introduced by L. Pauling as the power of an atom to attract electrons to itself. There are several definitions of this quantity. According to Mulliken it is the average of the ionization energy and electron affinity of an atom, but more frequently a relative scale due to Pauling is used where dimensionless relative electronegativity differences are defined on the basis of bond dissociation energies, \\(E_{\\rm{d}}\\), expressed in electronvolts: \\[\\chi _{\\rm{r}}\\left(\\rm{A}\\right)- \\chi _{\\rm{r}}\\left(\\rm{B}\\right)=\\left(\\rm{eV}\\right)^{-\\frac{1}{2}}\\ \\sqrt{E_{\\rm{d}}\\left(\\rm{AB}\\right)- \\frac{1}{2}\\ [E_{\\rm{d}}\\left(\\rm{AA}\\right)+E_{\\rm{d}}\\left(\\rm{BB}\\right)]}\\] The scale is chosen so as to make the relative electronegativity of hydrogen \\(\\chi _{\\rm{r}} = 2.1\\). The sign of the square root was chosen intuitively by Pauling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronegativity" .

goldbook:E01991 a skos:Concept ;
    skos:definition "The potential difference through which electrons are accelerated before they are used to bring about electron ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron energy" .

goldbook:E01992 a skos:Concept ;
    skos:definition "The principle expresses the fact that all pure substances carry a net charge of zero." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroneutrality principle" .

goldbook:E01993 a skos:Concept ;
    skos:definition "Synonymous with Dexter excitation transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron exchange excitation transfer" .

goldbook:E01994 a skos:Concept ;
    skos:definition "A state of an atom or molecular entity which has greater electronic energy than the ground state of the same entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronically excited state" .

goldbook:E01996 a skos:Concept ;
    skos:definition "The inductive effect has universally been represented by the symbol \\(\\rm{I}\\). This is now commonly taken to include both through-bonds and through-space transmission, but \\(\\rm{I}\\) is also used specifically for through-bonds transmission; through-space transmission is then symbolized as \\(\\rm{F}\\) (for field effect). The symbols for the influence of substituents exerted through electron delocalization have variously been \\(\\rm{M}\\) (mesomeric), \\(\\rm{E}\\) (electromeric), \\(\\rm{T}\\) (tautomeric), \\(\\rm{C}\\) (conjugative), K (konjugativ) and \\(\\rm{R}\\) (resonance). Since the present fashion is to use the term resonance effect, \\(\\rm{R}\\) is the most commonly used symbol, although \\(\\rm{M}\\) is still seen quite often. Both the possible sign conventions are in use. The Ingold sign convention associates electronegativity (relative to hydrogen atom) with a negative sign, electropositivity with a positive sign. Thus the nitro group is described as electronwithdrawing by virtue of its \\(-\\rm{I}\\) and \\(-\\rm{M}\\) effects; chloro is described as a \\(-\\rm{I}\\), \\(+\\,\\rm{M}\\) substituent, etc. For correlation analysis and linear free-energy relationships this convention has been found inconvenient, for it is in contradiction to the sign convention for polar substituent constants ($\\ce{\\upsigma\\!\\mbox{-}constants}$). Authors concerned with these fields often avoid this contradiction by adopting the opposite sign convention originally associated with Robinson, for electronic effects. This practice is almost always associated with the use of R for the electron delocalization effect: thus the nitro group is a \\(+\\,\\rm{I}\\), \\(+\\,\\rm{R}\\) substituent; chloro a \\(+\\,\\rm{I}\\), \\(-\\rm{R}\\) substituent, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic effect of substituents: symbols and signs" .

goldbook:E01997 a skos:Concept ;
    skos:altLabel "electronic energy hopping",
        "energy migration" ;
    skos:definition "The movement of electronic excitation energy from one molecular entity to another of the same species, or from one part of a molecular entity to another of the same kind (e.g. excitation migration between the chromophores of an aromatic polymer). The migration can happen via radiative or radiationless processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic energy migration" .

goldbook:E01999 a skos:Concept ;
    skos:altLabel "electron impact",
        "electron impact ionization" ;
    skos:definition "This is the term used to describe ionization of any species by electrons. The process may, for example, be written:   for atoms or molecules: \\[\\rm{M} + e \\rightarrow \\rm{M}^{+\\cdot } + 2e\\]   for radicals: \\[\\rm{M}^{\\cdot}  + e \\rightarrow \\rm{M}^{+} + 2e\\]   The term 'electron impact' should not be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron ionization" .

goldbook:E02000 a skos:Concept ;
    skos:definition "The term can be applied to a reaction in which there is an electron transfer with the formation of an ionic intermediate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron jump" .

goldbook:E02001 a skos:Concept ;
    skos:definition "The difference between the energy of the exciting photon and the ionization energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron kinetic energy" .

goldbook:E02003 a skos:Concept ;
    skos:definition "A synonym for Lewis acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-pair acceptor" .

goldbook:E02004 a skos:Concept ;
    skos:definition "A synonym for Lewis base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-pair donor" .

goldbook:E02005 a skos:Concept ;
    skos:altLabel "EPR" ;
    skos:definition "Electron paramagnetic resonance (EPR) and/or electron spin resonance (ESR) is defined as the form of spectroscopy concerned with microwave-induced transitions between magnetic energy levels of electrons having a net spin and orbital angular momentum. The term electron paramagnetic resonance and the symbol EPR are preferred and should be used for primary indexing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron paramagnetic resonance" .

goldbook:E02006 a skos:Concept ;
    skos:altLabel "EPMA" ;
    skos:definition "General term for methods using bombardment of a solid specimen by electrons which generate a variety of signals providing the basis for a number of different analytical techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron probe microanalysis" .

goldbook:E02007 a skos:Concept ;
    skos:altLabel "EPXMA" ;
    skos:definition "Any analytical technique which uses the excitation and evaluation of the characteristic X-ray spectrum of a solid specimen by a focused electron beam (typically of a diameter of less than \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\)). Qualitative and quantitative X-ray analysis is the main feature of EPXMA. For obtaining supplementary information the secondary, back scattered and absorbed electrons are also frequently observed. Qualitative and quantitative X-ray analysis is, however, the main feature of EPXMA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron probe X-ray microanalysis" .

goldbook:E02008 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant used as atomic unit of mass, \\(m_{\\rm{e}} = \\pu{9.1093897(54)E-31 kg}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron rest mass" .

goldbook:E02009 a skos:Concept ;
    skos:altLabel "ESCA" ;
    skos:definition "Type of spectroscopy involving the measurement of the kinetic energy of electrons emitted by chemical substances usually as a result of excitation by monochromatic X-rays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron spectroscopy for chemical analysis" .

goldbook:E02010 a skos:Concept ;
    skos:definition "When a beam of electrons strikes a target or specimen there are three ways in which the electrons may lose energy (low energy collisions, X-ray production, and formation of a spectral continuum). The average energy loss per unit distance travelled along the electron path is called electron stopping power, \\(\\frac{\\rm{d}E}{\\rm{d}x}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron stopping power" .

goldbook:E02011 a skos:Concept ;
    skos:definition "The transfer of an electron from one molecular entity to another, or between two localized sites in the same molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron transfer" .

goldbook:E02012 a skos:Concept ;
    skos:definition "The term indicates a sequence of reactions such as shown in equations (1)–(3), leading from $\\ce{A}$ to $\\ce{B}$:  \\[\\rm{A} + \\rm{e}^{-} \\rightarrow \\rm{A}^{\\cdot- }\\]$\\quad$(1)\\[\\rm{A}^{\\cdot- } \\rightarrow \\rm{B}^{\\cdot- }\\]$\\quad$(2)\\[\\rm{B}^{\\cdot- } + \\rm{A} \\rightarrow \\rm{B} + \\rm{A}^{\\cdot- }\\]$\\quad$(3) An analogous sequence involving radical cations ($\\ce{A^{+.}}$, $\\ce{B^{+.}}$) is also observed. The most notable example of electron-transfer catalysis is the \\(\\rm{S}_{\\rm{RN}}1\\) (or \\(\\rm{T}+\\rm{D}_{\\rm{N}}+\\rm{A}_{\\rm{N}}\\)) reaction of aromatic halides. The term has its origin in a suggested analogy to acid-base catalysis, with the electron instead of the proton. However, there is a difference between the two catalytic mechanisms, since the electron is not a true catalyst, but rather behaves as the initiator of a chain reaction. 'Electron-transfer induced chain reaction' is a more appropriate term for the situation described by equations (1)–(3)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-transfer catalysis" .

goldbook:E02013 a skos:Concept ;
    skos:definition "Photochemical process in which a reaction of a non-absorbing substrate is induced by electron transfer (not energy transfer) with an excited light-absorbing sensitizer. The overall process must be such that the sensitizer is recycled. Depending on the action of the excited sensitizer as electron donor or acceptor the sensitization is called reductive or oxidative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron transfer photosensitization" .

goldbook:E02014 a skos:Concept ;
    skos:definition "Non-SI unit of energy, \\(\\rm{eV}\\approx 1.602\\ 176\\ 487(40)\\times 10^{-19}\\ \\rm{J}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronvolt" .

goldbook:E02015 a skos:Concept ;
    skos:definition "The minimum work needed to extract electrons from the Fermi level of a metal M across a surface carrying no net charge. It is equal to the sum of the potential energy and the kinetic Fermi energy taken with the reverse sign: \\[\\mathit{\\Phi}^{M} = -(V_{\\rm{e}} + \\varepsilon_{\\rm{e}}^{F})\\] where \\(V_{\\rm{e}}\\) is the potential energy for electrons in metals and \\(\\varepsilon_{\\rm{e}}^{\\rm{F}}\\) is the kinetic energy of electrons at the Fermi level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron work function" .

goldbook:E02017 a skos:Concept ;
    skos:definition "The pressure difference \\(\\Delta p\\) across the membrane, plug, etc., needed just to stop electro-osmotic volume flow. \\(\\Delta p\\) is positive if the higher pressure is on the high potential side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-osmotic pressure" .

goldbook:E02019 a skos:Concept ;
    skos:definition "The volume flow per unit time per unit field strength through the whole plug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-osmotic volume flow" .

goldbook:E02020 a skos:Concept ;
    skos:altLabel "electrophilic" ;
    skos:definition "An electrophile (or electrophilic reagent) is a reagent that forms a bond to its reaction partner (the nucleophile) by accepting both bonding electrons from that reaction partner. An 'electrophilic substitution reaction' is a heterolytic reaction in which the reagent supplying the entering group acts as an electrophile. For example:  Electrophilic reagents are Lewis acids. 'Electrophilic catalysis' is catalysis by Lewis acids. The term 'electrophilic' is also used to designate the apparent polar character of certain radicals as inferred from their higher relative reactivities with reaction sites of higher electron density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophile" .

goldbook:E02021 a skos:Concept ;
    skos:definition "The property of being electrophilic (see electrophile).The relative reactivity of an electrophilic reagent. (It is also sometimes referred to as 'electrophilic power'.) Qualitatively, the concept is related to Lewis acidity. However, whereas Lewis acidity is measured by relative equilibrium constants, electrophilicity is measured by relative rate constants for reactions of different electrophilic reagents towards a common substrate (usually involving attack at a carbon atom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophilicity" .

goldbook:E02022 a skos:Concept ;
    skos:definition "The motion of colloidal particles in an electric field. The term 'cataphoresis' should be abandoned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophoresis" .

goldbook:E02024 a skos:Concept ;
    skos:definition "The observed rate of migration of a component (\\(v\\)) divided by electric field strength (\\(E\\)) in a given medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophoretic mobility" .

goldbook:E02025 a skos:Concept ;
    skos:definition "Processes of photoimaging which are based on photo-induced changes of electric fields (photo-conductive or photo-electrostatic effects)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophotography" .

goldbook:E02027 a skos:Concept ;
    skos:definition "Filters for which an electrostatic charge is applied to the filter element. A fibrous filter material is often pleated in between V-shaped supports consisting of electrostatically charged, metal rods which are insulated from the supporting frame." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrostatic filter" .

goldbook:E02028 a skos:Concept ;
    skos:definition "A device which separates particles from a gas stream by passing the carrier gas between pairs of electrodes across which a unidirectional, high-voltage potential is placed. The particles are charged before passing through the field and migrate to an oppositely charged electrode. These devices are very efficient collectors of small particles, and their use in removing particles from power plant plumes and in other industrial applications is widespread." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrostatic precipitator" .

goldbook:E02029 a skos:Concept ;
    skos:definition "A device which is heated to the temperature required for analyte atomization by the passage of electrical current through its body. In open atomizers the sample vapour, together with analyte atoms, leaving the atomizer surface may move freely into the surrounding space. In confined atomizers the sample vapour is restricted by the atomizer wall except for the openings where the optical beam enters and leaves the atomizer and the sample introduction hole." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrothermal atomizer" .

goldbook:E02030 a skos:Concept ;
    skos:definition "For dispersions of charged particles, these are those components of the viscosity connected with the charge of the particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroviscous effects" .

goldbook:E02032 a skos:Concept ;
    skos:definition "The elementary charge, \\(e\\), is one of seven fixed constants defining the International System of Units, the SI, with \\(e = \\pu{1.602176634E-19 C}\\). The elementary charge \\(e\\) corresponds to a coupling strength of the electromagnetic force via the fine-structure constant and is considered as a fundamental constant of nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elementary charge" .

goldbook:E02034 a skos:Concept ;
    skos:definition "A particle in which, at the present, no structure can be observed at moderate energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elementary particle" .

goldbook:E02035 a skos:Concept ;
    skos:definition "A reaction for which no reaction intermediates have been detected or need to be postulated in order to describe the chemical reaction on a molecular scale. An elementary reaction is assumed to occur in a single step and to pass through a single transition state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elementary reaction" .

goldbook:E02036 a skos:Concept ;
    skos:definition "The ratio of the rate constants of two reactions that differ only in the identity of the element of the atom in the leaving group, e.g. \\(\\frac{k_{\\rm{Br}}}{k_{\\rm{Cl}}}\\). As for isotope effects, a ratio of unity is regarded as a 'null effect'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "element effect" .

goldbook:E02038 a skos:Concept ;
    skos:definition "The reverse of an addition reaction or transformation. In an elimination two groups (called eliminands) are lost most often from two different centres (1/2/elimination or 1/3/elimination, etc.) with concomitant formation of an unsaturation in the molecule (double bond, triple bond) or formation of a new ring. If the groups are lost from a single centre ($\\ce{\\upalpha\\!\\mbox{-}elimination}$, 1/1/elimination) the resulting product is a carbene or a 'carbene analogue'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elimination" .

goldbook:E02041 a skos:Concept ;
    skos:definition "To chromatograph by elution chromatography. This term is preferred to the term 'develop', which has been used in paper chromatography and in thin-layer chromatography. The process of elution may continue until the components have left the chromatographic bed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elute" .

goldbook:E02046 a skos:Concept ;
    skos:definition "A procedure for chromatographic separation in which the mobile phase is passed through the chromatographic bed after the application of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elution chromatography" .

goldbook:E02053 a skos:Concept ;
    skos:definition "The process of separating the lighter particles of a powder from the heavier ones by means of an upward directed stream of fluid (gas or liquid)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elutriation" .

goldbook:E02054 a skos:Concept ;
    skos:definition "A thermoanalytical technique in which the release of radioactive emanation from a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature programme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emanation thermal analysis" .

goldbook:E02055 a skos:Concept ;
    skos:definition "An aggregate of a small number of atoms, molecules or ions. An embryo of such a size that the Gibbs energy at constant pressure and temperature is a maximum is called a critical embryo. An embryo larger than a critical embryo is called a homogeneous nucleus. Colloidal sols may be formed by condensation methods. When a condensation method is applied, molecules (or ions) are deposited on nuclei which may be of the same chemical species as the colloid (homogeneous nucleation) or different (heterogeneous nucleation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "embryo" .

goldbook:E02056 a skos:Concept ;
    skos:definition "Radiative deactivation of an excited state; transfer of energy from a molecular entity to an electromagnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission" .

goldbook:E02057 a skos:Concept ;
    skos:definition "The total rate at which a solid, liquid or gaseous pollutant is emitted into the atmosphere from a given source; usually expressed as mass per unit time. Primary emissions are those substances which are emitted directly to the atmosphere (e.g. $\\ce{NO}$, $\\ce{SO2}$, etc.), while secondary emissions are formed from the primary emissions through thermal or photochemical reactions (e.g. ozone, aldehydes, ketones, sulfuric acid, nitric acid, etc.). The point or area from which the discharge takes place is called the source; the area in which the emission or its transformed products (e.g. in the case of aerosols, acidic deposition, etc.) may be deposited is called the receptor area or sink. Emission may be applied to noise, heat, etc., as well as pollutants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission" .

goldbook:E02058 a skos:Concept ;
    skos:definition "Air pollution control equipment which either converts the pollutant chemically to a non-polluting substance or collects the pollutant by some means including gravity settling chambers, inertial separators, cyclonic separators, filters, electrical precipitators, scrubbers, (spray towers, jet scrubbers, Venturi scrubbers, inertial scrubbers, mechanical scrubbers and packed scrubbers). Certain gases and odoriferous compounds are controlled by combustion, absorption (spray chambers, mechanical contactors, bubble cap or sieve plate contactors and packed towers) and adsorption units (packed beds or fluidized beds)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission control equipment" .

goldbook:E02059 a skos:Concept ;
    skos:definition "The emission per unit area of the appropriate surface of an emitting source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission flux" .

goldbook:E02060 a skos:Concept ;
    skos:definition "Plot of the emitted spectral radiant power (spectral radiant exitance) or of the emitted spectral photon irradiance (spectral photon exitance) against a quantity related to photon energy, such as frequency, \\( u \\), wavenumber, \\(\\sigma \\), or wavelength, \\(\\lambda \\). When corrected for wavelength-dependent variations in the equipment response, it is called a corrected emission spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission spectrum" .

goldbook:E02062 a skos:Concept ;
    skos:definition "Ratio of radiant exitance of a thermal radiator to that of a full radiator (black body) at the same temperature. In ISO this quantity is called emissivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emittance" .

goldbook:E02063 a skos:Concept ;
    skos:definition "Formed by juxtaposition of the atomic symbols with their appropriate subscripts to give the simplest possible formula expressing the composition of a compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "empirical formula" .

goldbook:E02064 a skos:Concept ;
    skos:definition "A surfactant which when present in small amounts facilitates the formation of an emulsion, or enhances its colloidal stability by decreasing either or both of the rates of aggregation and coalescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emulsifier" .

goldbook:E02065 a skos:Concept ;
    skos:definition "A fluid colloidal system in which liquid droplets and/or liquid crystals are dispersed in a liquid. The droplets often exceed the usual limits for colloids in size. An emulsion is denoted by the symbol O/W if the continuous phase is an aqueous solution and by W/O if the continuous phase is an organic liquid (an 'oil'). More complicated emulsions such as O/W/O (i.e. oil droplets contained within aqueous droplets dispersed in a continuous oil phase) are also possible. Photographic emulsions, although colloidal systems, are not emulsions in the sense of this nomenclature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emulsion" .

goldbook:E02066 a skos:Concept ;
    skos:definition "Alkenylamines; by usage the term refers specifically to vinylic amines, which have the structure $\\ce{R2NCR=CR2}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enamines" .

goldbook:E02069 a skos:Concept ;
    skos:altLabel "optical isomer" ;
    skos:definition "One of a pair of molecular entities which are mirror images of each other and non-superposable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomer" .

goldbook:E02070 a skos:Concept ;
    skos:altLabel "e.e.",
        "enantiomer excess" ;
    skos:definition "For a mixture of \\(\\left(+\\right)\\)- and \\(\\left(-\\right)\\)-enantiomers, with composition given as the mole or weight fractions \\(F_{\\left(\\!+\\!\\right)}\\) and \\(F_{\\left(\\!-\\!\\right)}\\) (where \\(F_{\\left(\\!+\\!\\right)}\\,+\\,F_{\\left(\\!-\\!\\right)}=1\\)) the enantiomer excess is defined as \\(|F_{\\left(\\!+\\!\\right)} - F_{\\left(\\!-\\!\\right)}|\\) (and the percent enantiomer excess by \\(100\\ |F_{\\left(\\!+\\!\\right)} - F_{\\left(\\!-\\!\\right)}|\\)). Frequently this term is abbreviated e.e." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomeric excess" .

goldbook:E02071 a skos:Concept ;
    skos:altLabel "enantioenriched" ;
    skos:definition "A sample of a chiral substance whose enantiomeric ratio is greater than \\(50\\ \\colon\\ 50\\) but less than \\(100\\ \\colon\\ 0\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomerically enriched" .

goldbook:E02072 a skos:Concept ;
    skos:altLabel "enantiopure",
        "homochiral" ;
    skos:definition "A sample all of whose molecules have (within limits of detection) the same chirality sense. Use of homochiral as a synonym is strongly discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomerically pure" .

goldbook:E02075 a skos:Concept ;
    skos:definition "The ratio of the percentage of one enantiomer in a mixture to that of the other e.g. \\(70\\left(\\!+\\!\\right)\\,\\colon\\,30\\left(\\!-\\!\\right)\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomeric ratio" .

goldbook:E02077 a skos:Concept ;
    skos:definition "The interconversion of enantiomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomerization" .

goldbook:E02078 a skos:Concept ;
    skos:definition "The isomerism of enantiomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomerism" .

goldbook:E02079 a skos:Concept ;
    skos:definition "One of a pair of chiral objects or models that are non-superposable mirror images of each other. The adjective enantiomorphic is also applied to mirror-image related groups within a molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiomorph" .

goldbook:E02083 a skos:Concept ;
    skos:definition "Constitutionally identical atoms or groups in molecules which are related by symmetry elements of the second kind only (mirror plane, inversion centre or rotation–reflection axis). For example the two groups c in a grouping Cabcc are enantiotopic. Replacement of one of a pair of enantiotopic groups forms one of a pair of enantiomers. Analogously, if complexation or addition to one of the two faces defined by a double bond or other molecular plane gives rise to a chiral species, the two faces are called enantiotopic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiotopic" .

goldbook:E02085 a skos:Concept ;
    skos:definition "Enzymes or cells which are of relatively large size may be entrapped in a maze of polymeric molecules (a gel). This procedure is called immobilization by inclusion. When the biocatalyst is enclosed inside a semipermeable membrane, usually approximately spherical, the method is known as encapsulation. In the process of reticulation the primary biocatalyst particles (individual enzyme molecules, cofactors or individual cells) are covalently attached to each other by organic chains, into a three-dimensional network. The term grafting is also used in this context. Attachment to the support by adsorption forces is called immobilization by adsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encapsulation" .

goldbook:E02086 a skos:Concept ;
    skos:definition "A set of collisions between reactant molecules in solids, liquids or dense gases, occurring in rapid succession as a result of the cage effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encounter" .

goldbook:E02087 a skos:Concept ;
    skos:definition "A complex of molecular entities produced at an encounter-controlled rate, and which occurs as an intermediate in a reaction mechanism. When the complex is formed from two molecular entities it is called an 'encounter pair'. A distinction between encounter pairs and (larger) encounter complexes may be relevant in some cases, e.g. for mechanisms involving pre-association." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encounter complex" .

goldbook:E02089 a skos:Concept ;
    skos:altLabel "diffusion-controlled rate" ;
    skos:definition "A rate of reaction corresponding to the rate of encounter of the reacting molecular entities. This is also known as 'diffusion-controlled rate' since rates of encounter are themselves controlled by diffusion rates (which in turn depend on the viscosity of the medium and the dimensions of the reactant molecular entities). For a bimolecular reaction between solutes in water at \\(\\pu{25^{\\circ}C}\\) an encounter-controlled rate is calculated to have a second-order rate constant of about \\(\\pu{E10 dm3 mol-1 s-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "encounter-controlled rate" .

goldbook:E02091 a skos:Concept ;
    skos:altLabel "endoergic reaction" ;
    skos:definition "This is usually taken to be a reaction for which the overall standard Gibbs energy change \\(\\Delta G^{\\,\\unicode{x26ac}}\\) is positive. Some workers use this term with respect to a positive value of \\(\\Delta H^{\\,\\unicode{x26ac}}\\) at the absolute zero of temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endergonic reaction" .

goldbook:E02092 a skos:Concept ;
    skos:definition "A constitutional unit that is an extremity of a macromolecule or oligomer molecule. An end-group is attached to only one constitutional unit of a macromolecule or oligomer molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "end-group" .

goldbook:E02093 a skos:Concept ;
    skos:definition "Enzymes that cut internal bonds of a polymer. Endonucleases are able to cleave phosphodiester bonds within a nucleic acid chain by hydrolysis either randomly or at specific base sequences (cf. restriction enzymes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endoenzymes" .

goldbook:E02094 a skos:Concept ;
    skos:definition "Descriptors of the relative orientation of groups attached to non-bridgehead atoms in a bicyclo[x.y.z]alkane (x ≥ y &gt; z &gt; 0).  If the group is orientated towards the highest numbered bridge (z bridge, e.g. C-7 in example below) it is given the description exo; if it is orientated away from the highest numbered bridge it is given the description endo. If the group is attached to the highest numbered bridge and is orientated towards the lowest numbered bridge (x bridge, e.g. C-2 in example below) it is given the description syn; if the group is orientated away from the lowest numbered bridge it is given the description anti." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>endo</i>, <i>exo</i>, <i>syn</i>, <i>anti</i>" .

goldbook:E02095 a skos:Concept ;
    skos:definition "A reaction for which the overall standard enthalpy change \\(\\Delta H^{\\,\\unicode{x26ac}}\\) is positive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endothermic reaction" .

goldbook:E02099 a skos:Concept ;
    skos:definition "The addition of a compound with a double bond having an allylic hydrogen (the 'ene') to a compound with a multiple bond (the 'enophile') with transfer of the allylic hydrogen and a concomitant reorganization of the bonding, as illustrated below for propene (the 'ene') and ethene (the 'enophile'). The reverse is a 'retro-ene' reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ene reaction" .

goldbook:E02100 a skos:Concept ;
    skos:definition "In an elementary process, a species having sufficient energy to become an activated complex, but which does not have the structure of the activated complex. If it is not inactivated by collisions it can become an activated complex and pass at once into products, after undergoing vibration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energized species" .

goldbook:E02102 a skos:Concept ;
    skos:definition "Energy of the individual particles or photons of which a radiation consists." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy" .

goldbook:E02105 a skos:Concept ;
    skos:definition "A method of X-ray fluorescence analysis where element specificity is obtained by measuring the energy spectrum of the induced X-radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy dispersive X-ray fluorescence analysis" .

goldbook:E02106 a skos:Concept ;
    skos:definition "For mono-directional radiation, the energy traversing in a time interval over a small area perpendicular to the direction of the energy flow, divided by that time interval and by that area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy flux density" .

goldbook:E02109 a skos:Concept ;
    skos:definition "This is defined by the equation: \\[U^{\\ddagger } = -R\\ T\\ (\\frac{\\partial (\\ln I_{0})}{\\partial T^{-1}})_{p,c_{j},...}\\] where \\(I_{0}\\) is the exchange current. At any overpotential \\(\\eta \\) it is defined by the equation: \\[U^{\\ddagger }\\left(\\eta \\right) = -R\\ (\\frac{\\partial (\\ln (|I|))}{\\partial T^{-1}})_{p,\\eta ,c_{j},...}\\] where \\(I\\) is the current passing from the electrode into the electrolyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy of activation" .

goldbook:E02113 a skos:Concept ;
    skos:definition "A measurement, at given energy, of the smallest difference between the energies of two particles or photons capable of being distinguished by a radiation spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy resolution" .

goldbook:E02114 a skos:Concept ;
    skos:definition "The rate of the Gibbs energy storage in an endothermic photochemical reaction divided by the incident irradiance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy storage efficiency" .

goldbook:E02115 a skos:Concept ;
    skos:definition "The limiting kinetic energy of a incident particle or energy of an incident photon below which a specified process cannot take place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy threshold" .

goldbook:E02116 a skos:Concept ;
    skos:definition "From a phenomenological point of view, the term is used to describe the process by which a molecular entity absorbs light and a phenomenon originates from the excited state of another molecular entity. In mechanistic photochemistry the term has been reserved for the photophysical process in which an excited state of one molecular entity (the donor) is deactivated to a lower-lying state by transferring energy to a second molecular entity (the acceptor) which is thereby raised to a higher energy state. The excitation may be electronic, vibrational, rotational or translational. The donor and acceptor may be two parts of the same molecular entity, in which case the process is called intramolecular energy transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy transfer" .

goldbook:E02117 a skos:Concept ;
    skos:altLabel "Hammond–Herkstroeter plot",
        "Herkstroeter plot" ;
    skos:definition "A plot of the quenching rate constant of an excited molecular entity by a series of quenchers versus the excited state energy of the quenchers. Alternatively, a plot of the rate constant for the sensitization of a reaction versus the excited state energy of different sensitizers. This type of plot is used to estimate the energy of the excited molecular entity quenched (in the former case) or produced (in the latter case)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy transfer plot" .

goldbook:E02118 a skos:Concept ;
    skos:definition "The ratio of the energy emitted as luminescence to the energy absorbed by a species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy yield of luminescence" .

goldbook:E02119 a skos:Concept ;
    skos:definition "Variation of reaction parameters in a series of reactions proceeding in non-concerted steps may lead to a situation where the putative intermediate will possess a lifetime shorter than a bond vibration, so that the steps become concerted. The transition state structure will lie on the coordinate of the More O'Ferrall–Jencks diagram leading to that of the putative intermediate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enforced concerted mechanism" .

goldbook:E02120 a skos:Concept ;
    skos:definition "A use of luminescence quenching effects to enhance sensitivity. The strong depopulation of the fluorescing singlet excited state by external heavy atom perturbers can lead to a large population of the phosphorescing triplet excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enhanced phosphorescence analysis" .

goldbook:E02121 a skos:Concept ;
    skos:definition "A reaction which enables a favourable measurement to be made in which the constituent which is finally measured has not been magnified in any way (cf. amplification reaction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enhancement reaction" .

goldbook:E02122 a skos:Concept ;
    skos:definition "A fluorescent compound which accepts energy and thus enhances or promotes the emission from a sample containing a chemically or enzymatically generated excited molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enhancer" .

goldbook:E02123 a skos:Concept ;
    skos:definition "Salts of enols (or of the tautomeric aldehydes or ketones), in which the anionic charge is delocalized over oxygen and carbon, or similar covalent metal derivatives in which the metal is bound to oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enolates" .

goldbook:E02124 a skos:Concept ;
    skos:definition "Alkenols; the term refers specifically to vinylic alcohols, which have the structure $\\ce{HOCR'=CR2}$. Enols are tautomeric with aldehydes ($\\ce{R'} = \\ce{H}$) or ketones ($\\ce{R'\\! eq H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enols" .

goldbook:E02126 a skos:Concept ;
    skos:altLabel "glycals" ;
    skos:definition "Monosaccharides having a carbon–carbon double bond anywhere in the backbone chain. Glycals (term not recommended) designates the enoses that are generated by formal elimination of the hemiacetal hydroxy group and an adjacent hydrogen atom. Thus glycals are cyclic enol ethers. Unsaturated hexoses, for example, are called hexenoses, e.g. the hex-1-enopyranose derived from ᴅ-glucopyranose):" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enoses" .

goldbook:E02127 a skos:Concept ;
    skos:definition "The factor by which the ratio of two substances in the feed must be multiplied to give their ratio after treatment. \\[\\frac{Q_{\\rm{A}}}{Q_{\\rm{B}}} = S_{\\rm{A,B}}\\ \\frac{Q_{\\rm{A}}^{'}}{Q_{\\rm{B}}^{'}}\\] where \\(Q_{\\rm{A}}\\) and \\(Q_{\\rm{A}}^{'}\\) are the final and initial amounts of species A and \\(Q_{\\rm{B}}\\) and \\(Q_{\\rm{B}}^{'}\\) are the final and initial amounts of species B. Hence \\(S_{\\rm{A,B}}=\\frac{E_{\\rm{A}}}{E_{\\rm{B}}}\\) where \\(E\\) is the fraction extracted. In terms of \\(D\\),\\(n\\),\\(r\\) (where \\(n\\) is the number of stages and \\(r\\) the phase ratio), \\[S_{\\rm{A,B}} = \\frac{1- (1\\,+\\,r\\ D_{\\rm{A}})^{-n}}{1- (1\\,+\\,r\\ D_{\\rm{B}})^{-n}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enrichment factor" .

goldbook:E02129 a skos:Concept ;
    skos:definition "A prefix used to indicate the enantiomer for natural products and related molecules where the trivial name only refers to one enantiomer, e.g. ent-kaurene is the enantiomer of kaurene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>ent</i>" .

goldbook:E02130 a skos:Concept ;
    skos:definition "An atom or group that forms a bond to what is considered to be the main part of the substrate during a reaction. For example: the attacking nucleophile in a bimolecular nucleophilic substitution reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entering group" .

goldbook:E02131 a skos:Concept ;
    skos:altLabel "analytical solution calorimetry",
        "enthalpimetry",
        "thermochemical analysis" ;
    skos:definition "The generic designation for a family of analytical methods in which the enthalpy change of a chemical reaction is measured, directly or indirectly, in order to perform a quantitative determination of a reactant or catalyst. In general, at least one reactant is a liquid or solution. It is a subset of calorimetry in which the system is maintained at constant (usually atmospheric pressure), and the emphasis is on a quantitative determination in a reasonable length of time. Analytical solution calorimetry is a synonymous designation that may be used but is not preferred. 'Thermochemical analysis' has been used but is not recommended because of potential confusion and overlap with the methods of thermal analysis. The adjective 'thermometric' is also associated with the names of some of these methods, but is not recommended as a general designation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpimetric analysis" .

goldbook:E02140 a skos:Concept ;
    skos:altLabel "thermogram" ;
    skos:definition "A plot of temperature versus time or heat change versus time which is produced in direct-injection enthalpimetry. Use of the term 'thermogram' is not recommended because it is too general and overlaps with other fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpogram" .

goldbook:E02141 a skos:Concept ;
    skos:definition "Internal energy of a system plus the product of pressure and volume. Its change in a system is equal to the heat brought to the system at constant pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpy" .

goldbook:E02142 a skos:Concept ;
    skos:definition "The standard enthalpy of activation \\(\\Delta ^{\\ddagger}H^{\\,\\unicode{x26ac}}\\) is the enthalpy change that appears in the thermodynamic form of the rate equation obtained from conventional transition state theory. This equation is only correct for a first order reaction, for which the rate constant has the dimension reciprocal time. For a second order reaction, for which the rate constant has the dimension (reciprocal time) × (reciprocal concentration), the left hand side should be read as \\(k\\ c^{\\,\\unicode{x26ac}}\\), where \\(c^{\\,\\unicode{x26ac}}\\) denotes the standard concentration (usually \\(\\pu{1 mol dm-3}\\)). \\[k = \\frac{k_{\\rm{B}}\\ T}{h}\\ \\rm{e}^{\\frac{\\Delta ^{\\ddagger }S^{\\,\\unicode{x26ac}}}{R}}\\ \\mathrm{e}^{\\frac{-\\Delta ^{\\ddagger }H^{\\,\\unicode{x26ac}}}{R\\ T}}\\] The quantity \\(\\Delta ^{\\ddagger}S^{\\,\\unicode{x26ac}}\\) is the standard entropy of activation, and care must be taken with standard states. In this equation \\(k_{\\rm{B}}\\) is the Boltzmann constant, \\(T\\) the absolute temperature, \\(h\\) the Planck constant, and \\(R\\) the gas constant. The enthalpy of activation is approximately equal to the activation energy; the conversion of one into the other depends on the molecularity. The enthalpy of activation is always the standard quantity, although the word standard and the superscript \\(^{\\circ}\\) on the symbol are often omitted. The symbol is frequently (but incorrectly) written \\(\\Delta H^{\\ddagger }\\), where the standard symbol is omitted and the \\(\\ddagger \\) is placed after the \\(H\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpy of activation" .

goldbook:E02143 a skos:Concept ;
    skos:definition "Synonymous with enthalpy of wetting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpy of immersion" .

goldbook:E02144 a skos:Concept ;
    skos:definition "Referred to unit of mass of the solid, the difference (at constant temperature) between the enthalpy of a solid completely immersed in a wetting liquid, and that of the solid and the liquid taken separately. It must be specified whether the solid in the initial state is in contact with vacuum or with the vapour of the liquid at a given partial pressure. Measurements of the enthalpy of wetting of a solid equilibrated with varying relative pressures of the vapour of a pure wetting liquid may be used to derive the differential enthalpy of adsorption of the vapour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enthalpy of wetting" .

goldbook:E02145 a skos:Concept ;
    skos:definition "Modifier used to denote divided by number of entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entitic" .

goldbook:E02146 a skos:Concept ;
    skos:definition "One which refers to a single entity (particle) of a system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entitic quantity" .

goldbook:E02147 a skos:Concept ;
    skos:definition "The act of forming a mist or fog: droplets of a liquid carried off by the vapours of a boiling liquid or from a liquid through which bubbles of gas or vapour are passing rapidly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entrainment" .

goldbook:E02148 a skos:Concept ;
    skos:definition "The region of a potential-energy surface or hypersurface that corresponds to molecular configurations that are closer in geometry to those of the reactants than to those of the products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entrance channel" .

goldbook:E02149 a skos:Concept ;
    skos:definition "Quantity the change in which is equal to the heat brought to the system in a reversible process at constant temperature divided by that temperature. Entropy is zero for an ideally ordered crystal at 0 \\(\\rm{K}\\). In statistical thermodynamics \\[S=k\\ \\ln W\\] where \\(k\\) is the Boltzmann constant and \\(W\\) the number of possible arrangements of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entropy" .

goldbook:E02150 a skos:Concept ;
    skos:definition "The entropy change that appears in the thermodynamic form of the rate equation obtained from conventional transition-state theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entropy of activation" .

goldbook:E02152 a skos:Concept ;
    skos:definition "The conformation (of symmetry group \\(C_{\\rm{s}}\\)) of a five-membered ring in which four atoms are coplanar, and one atom (the flap) projects out of the plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "envelope conformation" .

goldbook:E02158 a skos:Concept ;
    skos:definition "The mode by which the synthesis of an enzyme is prevented by repressor molecules. In many cases, the end product of a synthesis chain (e.g. an amino acid) acts as a feed-back corepressor by combining with an intracellular aporepressor protein, so that this complex is able to block the function of an operator. As a result, the whole operon is prevented from being transcribed into mRNA, and the expression of all enzymes necessary for the synthesis of the end product amino acid is abolished." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme repression" .

goldbook:E02159 a skos:Concept ;
    skos:definition "Macromolecules, mostly of protein nature, that function as (bio)catalysts by increasing the reaction rates. In general, an enzyme catalyses only one reaction type (reaction specificity) and operates on only one type of substrate (substrate specificity). Substrate molecules are attacked at the same site (regiospecificity) and only one or preferentially one of the enantiomers of chiral substrates or of racemic mixtures is attacked (stereospecificity)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzymes" .

goldbook:E02160 a skos:Concept ;
    skos:definition "A sensor in which an ion-selective electrode is covered with a coating containing an enzyme which causes the reaction of an organic or inorganic substance (substrate) to produce a species to which the electrode responds. Alternatively, the sensor could be covered with a layer of substrate which reacts with the enzyme, co-factor or inhibitor to be assayed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme substrate electrode" .

goldbook:E02162 a skos:Concept ;
    skos:definition "Decomposition of organic materials (e.g. starch, sugars, proteins, etc.) can be achieved by enzymic decomposition, in which the enzyme converts a high molecular mass compound into lower molecular mass species. The process can be regarded as an example of enzymic degradation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzymic decomposition" .

goldbook:E02163 a skos:Concept ;
    skos:definition "Neutrons of kinetic energy greater than the effective cadmium cut-off energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epicadmium neutrons" .

goldbook:E02164 a skos:Concept ;
    skos:definition "Descriptive term for processes that change the phenotype without altering the genotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epigenetic" .

goldbook:E02165 a skos:Concept ;
    skos:definition "Compounds having the (halomethyl)oxirane skeleton:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epihalohydrins" .

goldbook:E02166 a skos:Concept ;
    skos:definition "Interconversion of epimers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epimerization" .

goldbook:E02167 a skos:Concept ;
    skos:definition "Diastereoisomers that have the opposite configuration at only one of two or more tetrahedral stereogenic centres present in the respective molecular entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epimers" .

goldbook:E02168 a skos:Concept ;
    skos:definition "The less dense phase in a distribution system. The term is often used when two non-aqueous phases are present or when the solvent is an aqueous solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epi-phase" .

goldbook:E02169 a skos:Concept ;
    skos:definition "Ions derived from thiiranes, in which a trivalent sulfur atom bears a positive charge:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "episulfonium ions" .

goldbook:E02170 a skos:Concept ;
    skos:definition "Neutrons of kinetic energy greater than that of thermal agitation. The term is often restricted to energies just above thermal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epithermal neutrons" .

goldbook:E02171 a skos:Concept ;
    skos:definition "Any part of a molecule that acts as an antigenic determinant. A macromolecule can contain many different epitopes each capable of stimulating production of a different specific antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epitope" .

goldbook:E02173 a skos:Concept ;
    skos:definition "Compounds in which an oxygen atom is directly attached to two adjacent or non-adjacent carbon atoms of a carbon chain or ring system; thus cyclic ethers. The term epoxides represents a subclass of epoxy compounds containing a saturated three-membered cyclic ether; thus oxirane derivatives, e.g. 1,2-epoxypropane, or 2-methyloxirane (an epoxide); 9,10-epoxy-9,10-dihydroanthracene (an epoxy compound)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "epoxy compounds" .

goldbook:E02174 a skos:Concept ;
    skos:definition "For the use of this term in the context of cyclohexane see axial, equatorial. For the use of this term in the context of a bipyramidal structure see apical, basal, equatorial." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equatorial" .

goldbook:E02175 a skos:Concept ;
    skos:definition "The operation by which a system of two or more phases is brought to a condition where further changes with time do not occur. This term is not synonymous with pre-equilibrium and should not be used in that sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibration" .

goldbook:E02179 a skos:Concept ;
    skos:definition "The colloid-free solution obtained at equilibrium in dialysis. Its composition approaches that of the dispersion medium (more precisely, the limit to which the composition of the dispersion medium tends at large distances from the particles). In the dialysis equilibrium an osmotic pressure difference exists between sol and equilibrium dialysate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium dialysate" .

goldbook:E02181 a skos:Concept ;
    skos:definition "A liquid film of thickness, or thicknesses, at which it is stable or metastable with respect to small thickness changes. Unless the area of the film is small, its composition may not be the same over its area and the (metastable) equilibrium thickness may be characteristic of the local condition only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium film" .

goldbook:E02184 a skos:Concept ;
    skos:definition "When the reactants in a chemical reaction are initially in a Boltzmann distribution the reaction is referred to as an equilibrium reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium reaction" .

goldbook:E02191 a skos:Concept ;
    skos:definition "The diameter of a spherical particle which will give identical geometric, optical, electrical or aerodynamic behaviour to that of the particle (non-spherical) being examined; sometimes referred to as the Stokes diameter for particles in non-turbulent flows." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equivalent diameter" .

goldbook:E02193 a skos:Concept ;
    skos:definition "cgs unit of energy, \\(\\rm{erg} = 10^{-7}\\ \\rm{J}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "erg" .

goldbook:E02194 a skos:Concept ;
    skos:definition "Result of a measurement minus the true value of the measurand. Since a true value cannot be determined, in practice the conventional true value is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "error" .

goldbook:E02212 a skos:Concept ;
    skos:definition "Descriptors of the diastereoisomers of an acyclic structure or partial structure having two stereogenic centres. This notation is derived from carbohydrate nomenclature. The extension of this system has given rise to conflicting interpretations of these prefixes. It is recommended that for such cases the l, u or R*, S* system should be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>erythro</i>, <i>threo</i>" .

goldbook:E02214 a skos:Concept ;
    skos:definition "The distance into the sample measured from the physical surface from which all but a fraction \\(\\frac{1}{e}\\) of the particles or radiation detected have originated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "escape depth" .

goldbook:E02218 a skos:Concept ;
    skos:definition "The left-hand side of one of the various cross-differential relationships that can be obtained from the Gibbs adsorption equation when only one chemical potential (\\(\\mu \\)) is considered as variable, viz. \\[(\\frac{\\partial E}{\\partial \\mu })_{T,p,\\sigma }=- (\\frac{\\partial \\mathit{\\Gamma }}{\\partial \\sigma })_{T,p,\\mu }\\] where \\(E\\) is the potential difference, \\(T\\) is the temperature, \\(p\\) is the pressure, \\(\\mathit{\\Gamma}\\) is the surface excess and \\(\\sigma \\) is the charge density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Esin and Markov coefficient" .

goldbook:E02219 a skos:Concept ;
    skos:definition "Compounds formally derived from an oxoacid $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$, ($l  eq 0$) and an alcohol, phenol, heteroarenol, or enol by linking with formal loss of water from an acidic hydroxy group of the former and a hydroxy group of the latter. By extension acyl derivatives of alcohols, etc. Acyl derivatives of chalcogen analogues of alcohols (thiols, selenols, tellurols) etc. are included. E.g. $\\ce{R'C(=O)(OR)}$, $\\ce{R'C(=S)(OR)}$, $\\ce{R'C(=O)(SR)}$, $\\ce{R'S(=O)2(OR)}$, $\\ce{(HO)2P(=O)(OR)}$, $\\ce{(R'S)2C(=O)}$, $\\ce{ROCN}$ (but not $\\ce{R–NCO}$) ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "esters" .

goldbook:E02221 a skos:Concept ;
    skos:definition "Compounds ROR ($\\ce{R}  eq \\ce{H}$). (Compounds $\\ce{R3SiOR}$, silicon analogues of ethers, are trialkylsilyloxy compounds). E.g. $\\ce{CH3CH2OCH2CH3}$ ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ethers" .

goldbook:E02223 a skos:Concept ;
    skos:definition "An isothermal, reversible reaction between two (or more) solid phases during the heating of a system as a result of which a single vapour phase is produced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "euatmotic reaction" .

goldbook:E02225 a skos:Concept ;
    skos:definition "An isothermal, reversible reaction between two (or more) solid phases during the heating of a system, as a result of which a single liquid phase is produced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "eutectic reaction" .

goldbook:E02226 a skos:Concept ;
    skos:definition "The inverse of the calibration function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evaluation function" .

goldbook:E02227 a skos:Concept ;
    skos:definition "The physical process by which a liquid substance is converted to a gas or vapour. This may occur at or below the normal boiling point of the liquid (the temperature at which a liquid boils at 1 atmosphere pressure) and the process is endothermic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "evaporation" .

goldbook:E02228 a skos:Concept ;
    skos:definition "An ion containing no unpaired electrons, for example $\\ce{CH3^{+}}$, in its ground state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "even-electron ion" .

goldbook:E02237 a skos:Concept ;
    skos:definition "For a pure liquid, despite its low compressibility, the variation of density near a solid surface can be detected and measured. The total volume \\(V\\) of a system consisting of solid and pure liquid is different from (usually less than) that calculated assuming a constant liquid density. If the densities of bulk solid (\\(\\rho ^{\\mathrm{sol}}\\)) and liquid (\\(\\rho ^{\\rm{l}}\\)) are known then an excess volume (usually negative) can be defined as: \\[V^{\\sigma }=V- V^{\\mathrm{sol}}- V^{\\,\\unicode{x26ac}}=V- \\frac{m^{\\mathrm{sol}}}{\\rho ^{\\mathrm{sol}}}- \\frac{m^{\\rm{l}}}{\\rho ^{\\rm{l}}}\\] where \\(m^{\\mathrm{sol}}\\) is the mass of solid, \\(V^{\\mathrm{sol}}\\) its volume calculated from the bulk density, \\(V^{\\,\\unicode{x26ac}}\\) is the initial volume of liquid and \\(m^{\\rm{l}}\\) is the mass of liquid. The excess mass is given by: \\[m^{\\sigma }=m^{\\rm{l}}- (V- V^{\\mathrm{sol}})\\ \\rho ^{\\rm{l}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excess volume" .

goldbook:E02238 a skos:Concept ;
    skos:definition "The common value \\(I_{0}\\) of the anodic and cathodic partial currents when the reaction is at equilibrium \\[I_{0}=I_{\\rm{a}}=- I_{\\rm{c}}\\] For an electrode at equilibrium at which only one reaction is significant \\(I=0\\). When more than one reaction is significant at a given electrode, subscripts to \\(I_{0}\\) may be used to distinguish exchange currents. \\(I\\) is not usually zero when only one of these reactions is at equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange current" .

goldbook:E02239 a skos:Concept ;
    skos:definition "An extraction operation or process in which a metal from one phase is exchanged with the equivalent amount of a second metal from the other phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange extraction" .

goldbook:E02240 a skos:Concept ;
    skos:definition "A transition between antiferromagnetic and ferromagnetic coupling between two subarrays of magnetic atoms. Example: Ordered $\\ce{FeRh}$ changes from antiferromagnetic to ferromagnetic coupling with the simple cubic $\\ce{Fe}$ array in a first-order transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange-inversion transition" .

goldbook:E02241 a skos:Concept ;
    skos:definition "Labelling of a substance by isotope exchange." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange labelling" .

goldbook:E02242 a skos:Concept ;
    skos:definition "An electronically excited dimer, 'non-bonding' in the ground state. For example, a complex formed by the interaction of an excited molecular entity with a ground state partner of the same structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excimer" .

goldbook:E02243 a skos:Concept ;
    skos:definition "A source of pulsed coherent radiation obtained from an exciplex. The proper name is exciplex laser. Typical lasing species are noble gas halides ($\\ce{XeCl}$, $\\ce{KrF}$, etc.) emitting in the UV domain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excimer laser" .

goldbook:E02244 a skos:Concept ;
    skos:definition "An effect accompanying concentration quenching in some cases, namely the formation of a new bimolecular species which is capable of emission (excimer- and exciplex-luminescence)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excimer-luminescence" .

goldbook:E02245 a skos:Concept ;
    skos:definition "Any more or less inert substance added to a drug to give suitable consistency or form to the drug." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excipient" .

goldbook:E02246 a skos:Concept ;
    skos:definition "An electronically excited complex of definite stoichiometry, 'non-bonding' in the ground state. For example, a complex formed by the interaction of an excited molecular entity with a ground state counterpart of a different structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciplex" .

goldbook:E02248 a skos:Concept ;
    skos:definition "Process causing the transition of a system from one state to another of higher energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation" .

goldbook:E02249 a skos:Concept ;
    skos:altLabel "EES" ;
    skos:definition "The three-dimensional spectrum generated by scanning the emission spectrum at incremental steps of excitation wavelength (\\(x\\) axis = emission wavelength, \\(y\\) axis = excitation wavelength, \\(z\\) axis = emission flux) is called a (fluorescence, phosphorescence) excitation-emission spectrum (or EES). The spectra are particularly useful for investigating samples containing more than one emitting species. Corrected EES are obtained if (a) the emission is corrected for instrumental response with wavelength, and (b) the exciting radiation flux in photons \\(\\rm{s}^{-1}\\) is held constant for all excitation wavelengths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation-emission spectrum" .

goldbook:E02251 a skos:Concept ;
    skos:altLabel "acceleration energy",
        "initial energy" ;
    skos:definition "Kinetic energy of bombarding particles at the surface of the solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation energy" .

goldbook:E02252 a skos:Concept ;
    skos:definition "X-ray levels have various degrees of ionization -- single, double or higher -- and may in some cases also be electrically neutral. An excitation level (exciton) is an electrically neutral X-ray level with an expelled electron bound in the field of a core electron vacancy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation level" .

goldbook:E02253 a skos:Concept ;
    skos:definition "A plot of the spectral radiant exitance or of the spectral photon exitance against the frequency (or wavenumber, or wavelength) of excitation. When corrected for wavelength dependent variations in the excitation radiant power this is called a corrected excitation spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation spectrum" .

goldbook:E02256 a skos:Concept ;
    skos:definition "Synonymous with energy transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excitation transfer" .

goldbook:E02257 a skos:Concept ;
    skos:definition "State of a system with energy higher than that of the ground state. This term is most commonly used to characterize a molecule in one of its electronically excited states, but can also refer to vibrational and/or rotational excitation in the electronic ground state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excited state" .

goldbook:E02258 a skos:Concept ;
    skos:definition "In some applications it is useful to consider electronic excitation as if a quasi-particle, capable of migrating, were involved. This is termed an exciton. In organic materials two models are used: the band or wave model (low temperature, high crystalline order) and the hopping model (higher temperature, low crystalline order or amorphous state). Energy transfer in the hopping limit is identical with energy migration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exciton" .

goldbook:E02261 a skos:Concept ;
    skos:altLabel "gel-filtration chromatography",
        "gel-permeation chromatography" ;
    skos:definition "Chromatography in which separation is based mainly on exclusion effects, such as differences in molecular size and/or shape or in charge. The term size-exclusion chromatography may also be used when separation is based on molecular size. The terms gel filtration and gel-permeation chromatography (GPC) were used earlier to describe this process when the stationary phase is a swollen gel. The term ion-exclusion chromatography is specifically used for the separation of ions in an aqueous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exclusion chromatography" .

goldbook:E02262 a skos:Concept ;
    skos:altLabel "exoergic reaction" ;
    skos:definition "This expression is often applied to a reaction for which the overall standard Gibbs energy change \\(\\Delta G^{\\,\\unicode{x26ac}}\\) is negative. Some workers use this term with reference to a negative value of \\(\\Delta H^{\\,\\unicode{x26ac}}\\) at the absolute zero of temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exergonic reaction" .

goldbook:E02263 a skos:Concept ;
    skos:definition "The product of very rapid heating (or flash heating) of graphite intercalation compounds, such as graphite hydrogensulfate of relatively large particle diameter (flakes). The vaporizing intercalated substances force the graphite layers apart. The exfoliated graphite assumes an accordion-like shape with an apparent volume often hundreds of times that of the original graphite flakes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exfoliated graphite" .

goldbook:E02265 a skos:Concept ;
    skos:definition "This expression refers to the region of a potential-energy surface or hypersurface that corresponds to molecular configurations that are closer to those of the products than to those of the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exit channel" .

goldbook:E02267 a skos:Concept ;
    skos:definition "Enzymes that cleave monomers (sometimes also di- or oligomers) from one end of a polymer chain. Exonucleases are able to cleave nucleotides, one by one, from either the 5- or the 3- (or both) ends of nucleic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exoenzymes" .

goldbook:E02268 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "A section of DNA which carries the coding sequence for a protein or part of it. Exons are separated by intervening, non-coding sequences (cf. intron). In eukaryotes most genes consist of a number of exons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exon" .

goldbook:E02269 a skos:Concept ;
    skos:definition "A reaction for which the overall standard enthalpy change \\(\\Delta H^{\\,\\unicode{x26ac}}\\) is negative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exothermic reaction" .

goldbook:E02273 a skos:Concept ;
    skos:definition "To assess the uncertainty of derived final results from a least-squares procedure one can investigate the sensitivity of output data for errors in the input data by means of this calculation. One performs the calculations many times with perturbed input data and studies the relation between the changes (perturbations) in the input data and the changes in the output data. The perturbations are preferably generated using random numbers with a distribution function chosen to mimic the distribution of uncertainties in the primary results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "experimental perturbational calculation" .

goldbook:E02274 a skos:Concept ;
    skos:altLabel "explosion limits",
        "flammable limits" ;
    skos:definition "The concentration limits, usually of a substance in air, between which combustion will be self-sustaining." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "explosivity limits" .

goldbook:E02275 a skos:Concept ;
    skos:definition "Variation of a quantity (generally the activity of a quantity of a radionuclide) according to the law \\(A=A_{0}\\ \\rm{e}^{-\\lambda\\ t}\\) where \\(A\\) and \\(A_{0}\\) are the values of the quantity being considered at time \\(t\\) and zero respectively, and \\(\\lambda\\) is an appropriate constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exponential decay" .

goldbook:E02277 a skos:Concept ;
    skos:definition "The cellular production of the protein encoded by a particular gene. The process includes transcription of DNA, processing of the resulting mRNA product and its translation into an active protein.A recombinant gene inserted into a host cell by means of a vector is said to be expressed if the synthesis of the encoded protein can be demonstrated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "expression" .

goldbook:E02279 a skos:Concept ;
    skos:definition "This term applies in a general way to any multiparametric extension of the Hammett equation. It is sometimes used specifically for a form of dual substituent-parameter equation in which the actual value of the correlated property \\(P\\) under the influence of the substituent $\\ce{X}$ is used, rather than the value relative to that for $\\ce{X}$ = $\\ce{H}$. An intercept term \\(h\\) corresponding to the value of \\(P\\) for $\\ce{X}$ = $\\ce{H}$ is introduced, e.g. \\[P=\\alpha \\ \\sigma _{I}+\\beta \\ \\sigma _{R}+h\\] The equation may be applied to systems for which the inclusion of further terms to represent other effects, e.g. steric, is appropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extended Hammett equation" .

goldbook:E02280 a skos:Concept ;
    skos:altLabel "EXAFS" ;
    skos:definition "Structure in X-ray absorption spectra remote from the edge and extending to higher energies, due mainly to the scattering of the expelled electron by neighbouring atoms. Structure closer to the absorption edge is sometimes called near-edge X-ray absorption fine structure (NEXAFS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extended X-ray absorption fine structure" .

goldbook:E02281 a skos:Concept ;
    skos:definition "Physical quantity whose magnitude is additive for subsystems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extensive quantity" .

goldbook:E02282 a skos:Concept ;
    skos:definition "A quantity measured by its area, \\(A\\) (or \\(S\\)). For solids, a real (true, actual) and a geometric surface (interface) area, \\(A_{\\rm{r}}\\) and \\(A_{\\rm{g}}\\), respectively, may be defined if asperities are present whose height is orders of magnitude greater than the atomic or molecular size. The geometric surface is the projection of the real surface on a plane parallel to the macroscopic, visible phase boundary. If asperities are of the order of the atomic size, the surface of the solid may be described as stepped. (High index faces of crystals are stepped surfaces but may be ideally smooth in the sense of the roughness factor.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extent" .

goldbook:E02283 a skos:Concept ;
    skos:altLabel "advancement" ;
    skos:definition "Extensive quantity describing the progress of a chemical reaction equal to the number of chemical transformations, as indicated by the reaction equation on a molecular scale, divided by the Avogadro constant (it is essentially the amount of chemical transformations). The change in the extent of reaction is given by \\(\\mathrm{d}\\xi =\\frac{\\mathrm{d}n_{\\rm{B}}}{ u _{\\rm{B}}}\\), where \\( u _{\\rm{B}}\\) is the stoichiometric number of any reaction entity B (reactant or product) and \\(\\mathrm{d}n_{\\rm{B}}\\) is the corresponding amount." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extent of reaction" .

goldbook:E02290 a skos:Concept ;
    skos:definition "A compound present in a standard sample of known concentration and volume which is analysed separately from the unknown sample under identical conditions. It is used to facilitate the qualitative indentification and/or quantitative determination of the sample components. The volume of the external standard (standard sample) need not to be known if it is identical to that of the unknown sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external standard" .

goldbook:E02291 a skos:Concept ;
    skos:definition "When a porous solid consists of discrete particles it is inconvenient to describe the outer boundary of the particles as the external surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "external surface" .

goldbook:E02292 a skos:Concept ;
    skos:definition "Termolecular analogue of an exciplex. Use of this term is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exterplex" .

goldbook:E02295 a skos:Concept ;
    skos:definition "The volume between the effective injection point and the effective detection point, excluding the part of the column containing the stationary phase. It is composed of the volumes of the injector, connecting lines and detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extra-column volume" .

goldbook:E02296 a skos:Concept ;
    skos:definition "The separated phase (often but not necessarily organic) that contains the material extracted from the other phase. Where appropriate the term 'loaded solvent' may be used, but is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extract" .

goldbook:E02297 a skos:Concept ;
    skos:definition "To transfer a solute from a liquid phase to another immiscible or partially miscible liquid phase in contact with it. The term is also applied to the dissolution of material from a solid phase with a liquid in which it is not wholly soluble (i.e. leaching)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extract" .

goldbook:E02298 a skos:Concept ;
    skos:definition "A property which qualitatively indicates the degree to which a substance is extracted. The term is imprecise and generally used in a qualitative sense. It is not a synonym for fraction extracted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extractability" .

goldbook:E02299 a skos:Concept ;
    skos:altLabel "extracting agent" ;
    skos:definition "The active component(s) primarily responsible for transfer of a solute from one phase to the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extractant" .

goldbook:E02301 a skos:Concept ;
    skos:definition "Distribution and partition are often used as synonyms for the general phenomenon of extraction where appropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction" .

goldbook:E02302 a skos:Concept ;
    skos:definition "In connection with processes, this term often refers to the initial transfer step whereby the main solute, often together with impurities, is transferred from feed to solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction" .

goldbook:E02304 a skos:Concept ;
    skos:altLabel "extraction equilibrium constant" ;
    skos:definition "The extraction constant at zero ionic strength, \\(K_{\\rm{ex}}^{\\rm{0}}\\), is the equilibrium constant of the distribution reaction expressed in terms of the reacting species. Thus, for the gross reaction: \\[\\rm{M}_{\\rm{aq}}^{n+} + n\\rm{HL}_{\\rm{org}} \\rightleftharpoons  \\rm{ML}_{n,\\rm{org}} + n\\rm{H}_{\\rm{aq}}^{+}\\] in which the reagent $\\ce{HL}$ initially dissolved in an organic phase reacts with a metal ion $\\ce{M^{n}}$ in aqueous solution to form a product $\\ce{ML_{n}}$ which is more soluble in the organic phase than in water, \\[K_{\\rm{ex}}^{\\rm{0}} = \\frac{a_{\\rm{ML } n,\\rm{org}}\\hspace{2pt}a_{\\rm{H}^{+},\\rm{aq}}^{n}}{a_{\\rm{M}^{n+},\\rm{aq}}\\hspace{2pt}a_{\\rm{HL},\\rm{org}}^{n}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction constant" .

goldbook:E02305 a skos:Concept ;
    skos:altLabel "concentration factor",
        "mass distribution ratio" ;
    skos:definition "The ratio of the total mass of a solute in the extract to that in the other phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extraction factor" .

goldbook:E02309 a skos:Concept ;
    skos:definition "The distance from a radiation source, calculated by extrapolation to zero of the flux density, of the tangent to the flux density versus distance curve, taken at the point where the flux density has decreased to one half of its initial value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrapolated range" .

goldbook:E02310 a skos:Concept ;
    skos:definition "Organisms which require extreme physico-chemical conditions for their optimum growth and proliferation. Extremophilic microorganisms are e.g. thermophiles or psychrophiles, halophiles, alkalophiles or acidophiles, osmophiles and barophiles, based on their growth at extremes of temperature, salt concentration, pH, osmolarity or pressure, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extremophiles" .

goldbook:E02311 a skos:Concept ;
    skos:definition "A transformation in which an atom or group $\\ce{Y}$ connected to two other atoms or groups $\\ce{X}$ and $\\ce{Z}$ is lost from a molecule, leading to a product in which $\\ce{X}$ is bonded to $\\ce{Z}$, e.g.  or  The reverse of an extrusion is called insertion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extrusion transformation" .

goldbook:E04391 a skos:Concept ;
    skos:definition "A substituent capable of a $\\ce{+R}$ (e.g.$\\ce{NO2}$) or $\\ce{-R}$ (e.g. $\\ce{OCH3}$) effect, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π-electron acceptor/donor group" .

goldbook:ET02156 a skos:Concept ;
    skos:definition "The process whereby an (inducible) enzyme is synthesized in response to a specific molecule (cf. inducer).The inducer molecule (often a substrate that needs the catalytic activity of the inducible enzyme for its metabolism) combines with a repressor and thereby prevents the blocking of an operator by the repressor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme induction" .

goldbook:ET02276 a skos:Concept ;
    skos:definition "For X- or gamma-radiation in air: the sum of the electrical charges of all the ions of one sign produced when all electronss liberated by photonss in a suitably small element of volume of air completely stopped, divided by the mass of the air in the volume element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure" .

goldbook:ET06758 a skos:Concept ;
    skos:definition "The transport of particles under the influence of an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electromigration" .

goldbook:ET06759 a skos:Concept ;
    skos:definition "In its most general form, the Einstein equation relates the atomic mobility \\(b_{i}\\) of a species \\(i\\) to the diffusion coefficient \\(D_{i}\\): i.e., \\(D_{i}=k\\ T\\ b_{i}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Einstein equation" .

goldbook:ET06763 a skos:Concept ;
    skos:definition "A state of an atom or group which, due to its binding in a protein, has its geometric or electronic condition adapted for function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entatic state" .

goldbook:ET06811 a skos:Concept ;
    skos:definition "Concentration, amount or intensity of a particular physical or chemical agent or environmental agent that reaches the target population, organism, organ, tissue, or cell, usually expressed in numerical terms of concentration, duration, and frequency (for chemical agents and micro-organisms) or intensity (for physical agents).Note: This differs from the definition of exposure in radiation chemistry.Process by which a substance becomes available for absorption by the target population, organism, organ, tissue or cell, by any route." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure" .

goldbook:ET06822 a skos:Concept ;
    skos:definition "Uptake of material into a cell by invagination of the plasma membrane and its internalisation in a membrane-bounded vesicle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "endocytosis" .

goldbook:ET06823 a skos:Concept ;
    skos:definition "Process whereby an enzyme is synthesised in response to the presence of a specific substance or to other agents such as heat or a metal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enzyme induction" .

goldbook:ET06851 a skos:Concept ;
    skos:definition "Cracking caused by the combined actions of (i) mechanical stress and (ii) chemical agents or radiation or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental stress cracking" .

goldbook:ET06890 a skos:Concept ;
    skos:definition "Membrane-based separation process in which ions are driven through an ion-selective membrane under the influence of an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-dialysis" .

goldbook:ET06891 a skos:Concept ;
    skos:altLabel "electroosmosis",
        "electrosmosis" ;
    skos:definition "Process in which water is transported across the thickness of an anion- exchange or cation-exchange membrane under an applied electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-osmosis" .

goldbook:ET06895 a skos:Concept ;
    skos:definition "A mesophase that is thermodynamically stable over a definite temperature or pressure range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "enantiotropic mesophase" .

goldbook:ET06907 a skos:Concept ;
    skos:altLabel "ambient monitoring" ;
    skos:definition "Continuous or repeated measurement of agents in the (working) environment to evaluate environmental exposure and possible damage by comparison with appropriate reference values based on knowledge of the probable relationship between ambient exposure and resultant health effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "environmental monitoring" .

goldbook:ET06922 a skos:Concept ;
    skos:definition "Time required for a liquid in a capillary to move due to electro-osmosis through the effective length of the capillary, \\(L_{\\rm{eff}}\\). This time is usually measured as the migration time of a neutral compound, called an electro-osmotic flow marker which is assumed to have an electro-osmotic mobility that is negligible compared to that of the analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-osmotic hold-up time" .

goldbook:ET06923 a skos:Concept ;
    skos:definition "Electro-osmotic velocity divided by electric field (strength) \\[\\mu _{\\rm{eo}}=\\frac{ u _{\\rm{eo}}}{E}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electro-osmotic mobility" .

goldbook:ET06925 a skos:Concept ;
    skos:definition "The velocity of a charged analyte under the influence of an electric field relative to the background electrolyte. Also called rate of migration (in electrophoresis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrophoretic velocity" .

goldbook:ET07022 a skos:Concept ;
    skos:definition "Rules establishing correspondence between the topology of a molecular structure and the number of electrons which may be placed into its bonding molecular orbitals. In the origin of various electron-counting rules lies a general assumption that the completeness of the valence electron shell of a molecular entity belonging to a certain structural type serves as the major criterion of structural stability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-counting rules" .

goldbook:ET07023 a skos:Concept ;
    skos:definition "Molecules or ions that contain too few electrons to allow their bonding to be described exclusively in terms of two-center, two-electron, i.e., covalent, bonds. Such molecules or certain fragments in these are often held together by the multicenter bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron-deficient compounds" .

goldbook:ET07024 a skos:Concept ;
    skos:definition "The electron probability distribution function, \\(\\rho \\), defined as \\[\\rho (\\mathbf{r}) = n\\ \\int \\Psi ^{\\rm{*}}\\left[\\mathbf{r}(1),\\mathbf{r}(2)\\,\\rm{...}\\,\\mathbf{r}(n)\\right]\\ \\Psi \\left[\\mathbf{r}(1),\\mathbf{r}(2)\\,\\rm{...}\\,\\mathbf{r}(n)\\right]\\rm{d}\\mathbf{r}(2)\\,\\rm{...}\\,\\rm{d}\\mathbf{r}(n)\\] where \\(\\Psi \\) is an electronic wave-function and integration is made over the coordinates of all but the first electron of \\(n\\). The physical interpretation of the electron density function is that \\(\\rho \\ \\mathrm{d}\\mathbf{\\mathbf{r}}\\) gives the probability of finding an electron in a volume element \\(\\mathrm{d}\\mathbf{\\mathbf{r}}\\), i.e., electron density in this volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron density function" .

goldbook:ET07025 a skos:Concept ;
    skos:definition "The quantity that measures the escaping tendency of electrons from a species in its ground state. It is the negative of the absolute electronegativity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic chemical potential" .

goldbook:ET07026 a skos:Concept ;
    skos:definition "An arrangement allowed by the laws of quantum mechanics of electrons within an atom, molecule (or system of molecules)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic state" .

goldbook:ET07027 a skos:Concept ;
    skos:definition "Unavailability of another electronic structure (different electronic state) of lower energy with the same number of electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electronic stability" .

goldbook:ET07028 a skos:Concept ;
    skos:definition "First derivatives of the total energy with respect to nuclear coordinates, i.e., negative values of forces on the nuclei. Evaluation of energy gradient plays a central role in searching potential energy surfaces for stationary points. A widespread technique is based on the minimization of the gradient norm (the square of energy gradient)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy gradient" .

goldbook:ET07029 a skos:Concept ;
    skos:altLabel "PES",
        "potential energy surface" ;
    skos:definition "The notion of hypersurface is used to stress the multidimensionality of PESs. In a molecular system consisting of \\(N\\) atomic nuclei, the number of the independent coordinates that fully determine the PES is equal to \\(3\\ N-6\\) (or \\(3\\ N-5\\) if the system is linear)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "energy hypersurface" .

goldbook:ET07030 a skos:Concept ;
    skos:definition "The postulate that in a molecule all the constituent atoms should have the same electronegativity value, which would be the geometric mean of the electronegativities of isolated atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equalization of electronegativity, principle of" .

goldbook:ET07031 a skos:Concept ;
    skos:definition "Molecular geometry that corresponds to the true minimum on the respective potential energy surface. While information relating to the equilibrium geometry is provided by calculations within the adiabatic approximation (minimization of the total energy with respect to any independent geometrical parameter), various experiments yield some effective geometries for the molecule which are averaged over molecular vibrations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "equilibrium geometry" .

goldbook:ET07032 a skos:Concept ;
    skos:altLabel "EHMO",
        "EHMO method" ;
    skos:definition "A semi-empirical all-valence electron quantum mechanical method which uses the same approximations, apart from $\\ce{\\uppi\\!\\mbox{-}approximation}$ and neglect of overlap integrals, as those of the Hückel molecular orbital theory. The method reproduces relatively well the shapes and the order of energy levels of molecular orbitals. The account for overlap makes it possible to describe the net destabilization caused by interaction of two doubly occupied orbitals, which effect is not reproduced by HMO theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extended Hückel MO method" .

goldbook:ET07034 a skos:Concept ;
    skos:definition "The correction to the Coulomb repulsion between two electrons in orbitals \\(\\Psi _{i}\\) and \\(\\Psi _{j}\\) for the case when the electrons possess parallel spins. It is to be subtracted from the Coulomb repulsion to give the total energy of the electron–electron interaction. In the Hartree–Fock theory the magnitude of the exchange repulsion is given by the exchange integral \\[K_{ij}=\\int \\int \\Psi _{i}^{\\rm{*}}\\left(\\mathbf{r}_{1}\\right)\\ \\Psi _{j}^{\\rm{*}}\\left(\\mathbf{r}_{1}\\right)\\ \\left(\\frac{e^{2}}{r_{12}}\\right)\\ \\Psi _{i}\\left(\\mathbf{r}_{2}\\right)\\ \\Psi _{j}\\left(\\mathbf{r}_{2}\\right)  \\ \\mathrm{d}\\mathbf{r}_{1}  \\ \\mathrm{d}\\mathbf{r}_{2}=\\lt ij|ji \\gt\\] For the case of electrons with opposite spins \\(K_{ij}\\) vanishes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exchange repulsion" .

goldbook:ET07171 a skos:Concept ;
    skos:definition "Polymeric material that shows luminescence when an electric current passes through it such that charge carriers can combine at luminescent sites to give rise to electronically excited states of luminescent groups or molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electroluminescent polymer" .

goldbook:ET07205 a skos:Concept ;
    skos:definition "Polymeric material that exhibits bulk electric conductivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrically conducting polymer" .

goldbook:ET07249 a skos:Concept ;
    skos:definition "Process by which the layers of a multi-layered structure separate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exfoliation" .

goldbook:ET07267 a skos:Concept ;
    skos:definition "Substance, especially a diluent or modifier, added to a polymer to increase its volume without substantially altering the desirable properties of the polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "extender" .

goldbook:ET07367 a skos:Concept ;
    skos:definition "Thermal inversion of excited-state electron transfer restoring the donor and acceptor in their original oxidation state. In using this term one should also specify the resulting electronic state of the donor and acceptor. This term is preferred to back electron-transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron back-transfer" .

goldbook:ET07368 a skos:Concept ;
    skos:definition "Contraction of a dielectric in an electric-field gradient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electrostriction" .

goldbook:ET07369 a skos:Concept ;
    skos:definition "The rate of intersystem crossing is relatively large if the radiationless transition involves a change of orbital type." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "El-Sayed rules" .

goldbook:ET07370 a skos:Concept ;
    skos:definition "Used to characterize luminescence (fluorescence, phosphorescence) polarization resulting from photoselection. Defined as: \\[r = \\frac{I_{\\parallel} - I_{\\perp }}{I_{\\parallel} + 2I_{\\perp }}\\] where \\(I_{\\parallel}\\) and \\(I_{\\perp }\\) are the intensities measured with the linear polarizer for emission parallel and perpendicular, respectively, to the electric vector of linearly polarized incident electromagnetic radiation (which is often vertical). The quantity \\(I_{\\parallel} + 2I_{\\perp }\\) is proportional to the total fluorescence intensity \\(I\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "emission anisotropy" .

goldbook:ET07371 a skos:Concept ;
    skos:definition "Term used in photostimulated radical nucleophilic substitution to designate the induction of the reaction of a less reactive (or non-reactive) nucleophile with a substrate by the addition of catalytic amounts of another nucleophile, more reactive at initiation. Often, the non-reactive nucleophile at initiation is, however, quite reactive at propagation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entrainment" .

goldbook:ET07372 a skos:Concept ;
    skos:definition "Non-coherent source of ultraviolet radiation capable of producing quasi-monochromatic radiation from the near UV (\\(\\lambda = 354\\ \\rm{nm}\\)) to the vacuum UV (\\(\\lambda = 126\\ \\rm{nm}\\)). The operation of the excimer lamps relies on the radiative decomposition of excimers or exciplexes created by various types of discharges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "excimer lamp" .

goldbook:ET07373 a skos:Concept ;
    skos:definition "Term generally applied to the time-integrated radiation incident from all upward directions on a small sphere divided by the cross-sectional area of that sphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "exposure" .

goldbook:ET07374 a skos:Concept ;
    skos:definition "General designation of a photoinduced geometrical isomerization of a C–C double bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>E</i>/<i>Z</i> photoisomerization" .

goldbook:ET07547 a skos:Concept ;
    skos:definition "Polymer that displays rubber-like elasticity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastomer" .

goldbook:ET07565 a skos:Concept ;
    skos:definition "Polymer network with junction points or zones formed by physically entangled chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "entanglement network" .

goldbook:ET07598 a skos:Concept ;
    skos:definition "Segment of a chain between two successive crosslinks in a polymer network that is long enough to show entropic elasticity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "elastically active network chain" .

goldbook:ET07615 a skos:Concept ;
    skos:altLabel "EB",
        "EB curing" ;
    skos:definition "Curing induced by electron beam irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "electron beam curing" .

goldbook:F02313 a skos:Concept ;
    skos:definition "An affix used in names to designate three groups occupying the corners of the same face of an octahedral coordination sphere, not now generally recommended for precise nomenclature purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>fac</i>-" .

goldbook:F02314 a skos:Concept ;
    skos:definition "Proportionality constant between two quantities of the same dimension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "factor" .

goldbook:F02316 a skos:Concept ;
    skos:definition "A measurement of air contamination consisting of the mass rate at which solid particles deposit from the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fallout" .

goldbook:F02319 a skos:Concept ;
    skos:definition "In blast furnace operation, the idling period between the blowing periods when the blast pressure is reduced to a minimum. This also applies to plume behaviour under inversion conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fanning" .

goldbook:F02320 a skos:Concept ;
    skos:definition "SI derived unit of electric capacitance, \\(\\pu{F} = \\pu{C V-1} = \\pu{m-2 kg-1 s4 A2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "farad" .

goldbook:F02321 a skos:Concept ;
    skos:definition "A current corresponding to the reduction or oxidation of some chemical substance. The net faradaic current is the algebraic sum of all the faradaic currents flowing through an indicator or working electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "faradaic current" .

goldbook:F02322 a skos:Concept ;
    skos:definition "Measures the rate of the interfacial reaction, the proportionality constant being the charge number of the reaction multiplied by the Faraday constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "faradaic current density" .

goldbook:F02323 a skos:Concept ;
    skos:definition "Component of the current that is due to the demodulation associated with an electrode reaction and that appears if an indicator or working electrode is subjected to the action of two intermodulated applied potentials of different frequency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "faradaic demodulation current" .

goldbook:F02324 a skos:Concept ;
    skos:definition "A component of the current that is due to the rectifying properties of an electrode reaction and that appears if an indicator or working electrode is subjected to any periodically varying applied potential while the mean value of the applied potential is controlled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "faradaic rectification current" .

goldbook:F02325 a skos:Concept ;
    skos:definition "Fundamental physical constant representing molar elementary charge: \\(F = \\pu{9.64853399(24)E4 C mol-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Faraday constant" .

goldbook:F02326 a skos:Concept ;
    skos:altLabel "cylinder collector" ;
    skos:definition "A hollow collector, open at one end and closed at the other, used to collect beams of ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Faraday cup collector" .

goldbook:F02327 a skos:Concept ;
    skos:definition "This term is used to describe ionization of any species by causing interaction of the sample (which may be dissolved in a solvent matrix) and a beam of neutral atoms having high translational energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast atom bombardment ionization" .

goldbook:F02328 a skos:Concept ;
    skos:altLabel "FAB",
        "FAB mass spectrometry" ;
    skos:definition "A method in which ions are produced in a mass spectrometer from non-volatile or thermally fragile organic molecules by bombarding the compound in the condensed phase with energy-rich neutral particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast-atom bombardment mass spectrometry" .

goldbook:F02329 a skos:Concept ;
    skos:definition "Neutrons of kinetic energy greater than some specified value. This value may vary over a wide range and will be dependent upon the application." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fast neutrons" .

goldbook:F02330 a skos:Concept ;
    skos:definition "Aliphatic monocarboxylic acids derived from or contained in esterified form in an animal or vegetable fat, oil or wax. Natural fatty acids commonly have a chain of 4 to 28 carbons (usually unbranched and even-numbered), which may be saturated or unsaturated. By extension, the term is sometimes used to embrace all acyclic aliphatic carboxylic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fatty acids" .

goldbook:F02331 a skos:Concept ;
    skos:definition "The process whereby the output of a device is used to modify the operation of an analytical instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "feedback" .

goldbook:F02333 a skos:Concept ;
    skos:altLabel "end product inhibition" ;
    skos:definition "A metabolic control mechanism in which the end product of a biochemical sequence is able to inhibit the activity of an early enzyme in the sequence, thereby controlling the metabolic flux through this pathway. As an example, isoleucine controls its own synthesis by inhibiting threonine deaminase; adenosine 5-triphosphate (ATP) and citrate control glycolysis by inhibiting phosphofructokinase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "feed-back inhibition" .

goldbook:F02334 a skos:Concept ;
    skos:definition "The amount of reactant fed per unit time to the inlet of the reactor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "feed rate" .

goldbook:F02336 a skos:Concept ;
    skos:definition "Compounds of the general formula shown above. They may be considered to be spiro compounds having bridges of carbon atoms connecting the $\\ce{\\upalpha\\!}$ and $\\ce{\\upalpha\\!'}$ positions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fenestranes" .

goldbook:F02337 a skos:Concept ;
    skos:definition "In metabolism, the dehydrogenating degradation of organic substance by organisms or cells under anaerobic conditions in which electrons are transferred to metabolites which accumulate and are excreted in reduced form. Fermentation is only possible if the organism is able to gain energy by this process.In microbiology, the process in which cells (microorganisms, plant or animal cells) are cultured in a bioreactor in liquid or solid medium to convert organic substances into biomass (growth) or into products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fermentation" .

goldbook:F02338 a skos:Concept ;
    skos:definition "A bioreactor which enables optimal fermentation conditions to be maintained, allowing addition of nutrients, removal of products and insertion of measuring and/or control probes as well as other necessary equipment (e.g. for heating, cooling, aeration, agitation, sterilization, etc.) under sterile conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fermenter" .

goldbook:F02340 a skos:Concept ;
    skos:definition "The total energy of an electron in an uncharged metal at the Fermi level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fermi energy" .

goldbook:F02341 a skos:Concept ;
    skos:definition "The chemical potential of electrons in a solid (metals, semiconductors or insulators) or in an electrolyte solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fermi level" .

goldbook:F02345 a skos:Concept ;
    skos:definition "Compounds in which the two ring components of ferrocene are linked by one or more bridging chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferrocenophanes" .

goldbook:F02346 a skos:Concept ;
    skos:definition "A transition in which a crystal switches from one stable orientation state into another that is equally stable by the application of a mechanical stress along an appropriate direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferroelastic transition" .

goldbook:F02347 a skos:Concept ;
    skos:definition "A transition from a ferroelectric to either another ferroelectric, or a paraelectric, or an antiferroelectric state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferroelectric transition" .

goldbook:F02348 a skos:Concept ;
    skos:definition "A general term for ferroelastic, ferroelectric, antiferroelectric, ferromagnetic, antiferromagnetic and ferrimagnetic transitions in which a suitable driving force switches a ferroic crystal from one orientation state, or domain state, to another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferroic transition" .

goldbook:F02350 a skos:Concept ;
    skos:definition "Of a nuclide, capable of being transformed, directly or indirectly, into a fissile nuclide by neutron captureOf a material: containing one or more fertile nuclides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fertile" .

goldbook:F02351 a skos:Concept ;
    skos:definition "Branch point from which f linear chains emanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>f</i>-functional branch point" .

goldbook:F02353 a skos:Concept ;
    skos:definition "An activated carbon in the form of fibres, filaments, yarns or rovings and fabrics or felts. Such fibres differ from carbon fibres used for reinforcement purposes in composites by their high surface area, high porosity and low mechanical strength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibrous activated carbon" .

goldbook:F02357 a skos:Concept ;
    skos:definition "A term used to describe the formation of ions in the gas phase from a material deposited on a solid surface (known as an 'emitter') in the presence of a high electrical field. 'Field desorption' is an ambiguous term because it implies that the electric field desorbs a material as an ion from some kind of emitter on which the material is deposited. There is growing evidence that some of the ions formed are due to thermal ionization and some to field ionization of vapour evaporated from material on the emitter. Because there is generally little or no ionization unless the emitter is heated by an electric current, 'field desorption' is a misnomer. The term is, however, firmly implanted in the literature and most users undertand what is going on regardless of the implications of the term. In addition, no better simple term has been suggested to take its place and so, reluctantly, it is recommended that it be retained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field desorption" .

goldbook:F02358 a skos:Concept ;
    skos:definition "An experimentally observable effect symbolized by \\(F\\) (on reaction rates, etc.) of intramolecular coulombic interaction between the centre of interest and a remote unipole or dipole, by direct action through space rather than through bonds. The magnitude of the field effect (or 'direct effect') depends on the unipolar charge/dipole moment, orientation of dipole, shortest distance between the centre of interest and the remote unipole or dipole, and on the effective dielectric constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field effect" .

goldbook:F02360 a skos:Concept ;
    skos:definition "The removal of electrons from any species by interaction with a high electrical field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "field ionization" .

goldbook:F02362 a skos:Concept ;
    skos:altLabel "fibrous carbon" ;
    skos:definition "A carbonaceous deposit from gaseous carbon compounds, consisting of filaments grown by the catalytic action of metal particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filamentous carbon" .

goldbook:F02363 a skos:Concept ;
    skos:altLabel "grist" ;
    skos:definition "Filler (also called grist) is a petroleum- or coal-based coke fraction of a green, carbon mix or formulation. Coarse particles, \\(>0.425\\ \\mathrm{mm}\\), are sometimes referred to as tailings; fine particles, \\(" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filler" .

goldbook:F02364 a skos:Concept ;
    skos:definition "The main constituent of a carbon artifact, introduced as solid component (predominantly in the form of particulate carbon) into the 'carbon mix' from which polygranular carbon and graphite materials are obtained by heat treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filler coke" .

goldbook:F02365 a skos:Concept ;
    skos:definition "Solution containing the anion to which the reference electrode of the operational pH cell is reversible, e.g. chloride for silver-silver chloride electrode. In the absence of a bridge solution, a high concentration of filling solution comprising cations and anions of almost equal mobility is employed as a means of maintaining the liquid junction potential small and approximately constant on substitution of test solution for standard solution(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filling solution" .

goldbook:F02366 a skos:Concept ;
    skos:definition "A generic term referring to condensed matter restricted in one dimension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "film" .

goldbook:F02368 a skos:Concept ;
    skos:definition "A package containing one or more small photographic films for approximate measurement of radiation exposure, used for the purpose of monitoring personnel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "film badge" .

goldbook:F02370 a skos:Concept ;
    skos:definition "A small homogeneous part of a film including the two interfaces and any fluid between them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "film element" .

goldbook:F02381 a skos:Concept ;
    skos:definition "The contractile force per unit length, \\(\\unicode[Times]{x3A3}_{\\rm{f}}\\), exerted by an equilibrium film in contact with the bulk phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "film tension" .

goldbook:F02384 a skos:Concept ;
    skos:definition "A porous material on which solid particles present in air or other fluid which flows through it are largely caught and retained. Filters are made with a variety of materials: cellulose and derivatives, glass fibre, ceramic, synthetic plastics and fibres. Filters may be naturally porous or be made so by mechanical or other means. membrane/ceramic filters are prepared with highly controlled pore size in a sheet of suitable material such as polyfluoroethylene, polycarbonate or cellulose esters. Nylon mesh is sometimes used for reinforcement. The pores constitute 80–85% of the filter volume commonly and several pore sizes are available for air sampling (\\(0.45{-}0.8\\ \\unicode[Times]{x3BC}\\rm{m}\\) are commonly employed)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filter" .

goldbook:F02385 a skos:Concept ;
    skos:definition "Material interposed in the path of radiation to modify the spectral distribution of the radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filter" .

goldbook:F02387 a skos:Concept ;
    skos:definition "A spectrometer which has one or more spectral filters for isolating one or more spectral bands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filter spectrometer" .

goldbook:F02388 a skos:Concept ;
    skos:definition "The process of segregation of phases; e.g. the separation of suspended solids from a liquid or gas, usually by forcing a carrier gas or liquid through a porous medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "filtration" .

goldbook:F02389 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant, \\(\\alpha =\\frac{\\mu _{0}\\ e^{2}\\ c_{0}}{2\\ h} = 7.297\\ 353\\ 08\\ \\left(33\\right)\\times 10^{-3}\\), where \\(\\mu _{0}\\) is the permeability of vacuum, \\(e\\) the elementary charge, \\(h\\) the Planck constant, and \\(c_{0}\\) the speed of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fine structure constant" .

goldbook:F02390 a skos:Concept ;
    skos:altLabel "discontinuous phase transition" ;
    skos:definition "A transition in which the molar Gibbs energies or molar Helmholtz energies of the two phases (or chemical potentials of all components in the two phases) are equal at the transition temperature, but their first derivatives with respect to temperature and pressure (for example, specific enthalpy of transition and specific volume) are discontinuous at the transition point, as for two dissimilar phases that coexist and that can be transformed into one another by a change in a field variable such as pressure, temperature, magnetic or electric field. Example: The transition on heating $\\ce{CsCl}$ to \\(752\\ \\rm{K}\\) at which it changes from the low-temperature, $\\ce{CsCl}$-type structure to the high-temperature $\\ce{NaCl}$-type structure. Synonymous with discontinuous phase transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "first-order phase transition" .

goldbook:F02391 a skos:Concept ;
    skos:altLabel "Fischer–Tollens projection" ;
    skos:definition "A projection formula in which vertically drawn bonds are considered to lie below the projection plane and horizontal bonds to lie above that plane. Thus for the molecule Cabcd:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fischer projection" .

goldbook:F02392 a skos:Concept ;
    skos:altLabel "Rosanoff convention" ;
    skos:definition "An arbitrary convention according to which (+)-glyceraldehyde, now known to be (R)-2,3-dihydroxypropanal, was named ᴅ-glyceraldehyde (with the enantiomer ʟ-glyceraldehyde and its racemate ᴅʟ-glyceraldehyde) and taken to have the absolute configuration represented by the Fischer projection formula shown in the diagram.  The atom numbered 1 according to normal nomenclature rules is conventionally placed at the top of the main chain, which is drawn vertically and other groups are drawn on either side of that main chain. The convention is still in use for $\\ce{\\upalpha\\!\\mbox{-}amino acids}$ and for sugars." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fischer–Rosanoff convention" .

goldbook:F02394 a skos:Concept ;
    skos:definition "Of a nuclide: capable of undergoing fission by interaction with (slow) neutrons.Of a material: containing one or more fissile nuclides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fissile" .

goldbook:F02395 a skos:Concept ;
    skos:definition "Synonymous with fissile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fissionable" .

goldbook:F02397 a skos:Concept ;
    skos:definition "Nuclei resulting from fission and possessing kinetic energy acquired from the fission process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fission fragments" .

goldbook:F02398 a skos:Concept ;
    skos:definition "Neutrons originating in the fission process which have retained their original energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fission neutrons" .

goldbook:F02400 a skos:Concept ;
    skos:definition "Nuclides produced by fission and the daughter products of these nuclides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fission products" .

goldbook:F02401 a skos:Concept ;
    skos:definition "The fraction of fissions leading to fission products of a given type." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fission yield" .

goldbook:F02402 a skos:Concept ;
    skos:definition "In an ion exchanger, the non-exchangeable ions which have a charge opposite to that of the counter-ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed ions" .

goldbook:F02403 a skos:Concept ;
    skos:definition "A scan which determines, in a single experiment, all the parent ion mass-to-charge ratios which react to the loss or gain of a selected neutral mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed neutral loss scan" .

goldbook:F02404 a skos:Concept ;
    skos:definition "A spectrum obtained when data are acquired that determine all the parent ion mass-to-charge ratios that react by the loss (gain) of a selected neutral mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed neutral loss spectrum" .

goldbook:F02405 a skos:Concept ;
    skos:definition "A scan which determines, in a single experiment, all the daughter ion mass-to-charge ratios that are produced by the reaction of a selected parent ion mass-to-charge ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed precursor ion scan" .

goldbook:F02406 a skos:Concept ;
    skos:definition "A scan which determines, in a single experiment, all the parent ion mass-to-charge ratios that react to produce a selected daughter ion mass-to-charge ratio (sometimes called a 'parent ion scan')." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed product ion scan" .

goldbook:F02407 a skos:Concept ;
    skos:definition "A spectrum obtained when data are acquired that determine all the parent ion mass-to-charge ratios that react to produce a selected daughter ion mass-to-charge ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fixed product ion spectrum" .

goldbook:F02409 a skos:Concept ;
    skos:definition "An atomizer in which hydrogen, used as carrier gas, is partially combusted in the inlet arm of a T-shaped tube furnace by introducing a limited amount of oxygen or air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame-in-tube atomizer" .

goldbook:F02410 a skos:Concept ;
    skos:definition "The gases emerging from the column are fed into a hydrogen flame across which an electrical potential is placed. Certain molecules ionize easily in the flame and the current produced is proportional to the instantaneous flow rate of the eluted component. The detector is relatively insensitive to inorganic molecules and is most used for organic compounds. Concentrations below \\(1\\ \\rm{ppmv}\\) are easily detected. The linear dynamic range is between \\(10^{3}\\) and \\(10^{5}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame ionization detector" .

goldbook:F02411 a skos:Concept ;
    skos:definition "The eluent from the column is fed into a hydrogen-rich flame and produces light emission. Optical filters are used to select the wavelength range of the emission which is characteristic of specific atoms (usually sulfur or phosphorus). The detector is very specific, depending on the choice of optical filters. It can detect the S- and P-containing compounds down to \\(10^{-3}\\ \\rm{ppmv}\\), but the detector is non-linear." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame photometric detector" .

goldbook:F02412 a skos:Concept ;
    skos:definition "The use of emission spectroscopy in the ultraviolet and visible regions to identify and estimate the amounts of various elements which are excited in a flame, an arc or high voltage spark." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flame photometry" .

goldbook:F02416 a skos:Concept ;
    skos:altLabel "phosphorimetry" ;
    skos:definition "The term used when decay times luminescence are measured using a pulsed source of radiation. It is often necessary to separate the signal due to the light flash from luminescence emission signal by a deconvolution technique in order to obtain the correct decay curve for emission. Decay times corrected for this effect are termed corrected decay times of fluorescence or phosphorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flash fluorimetry" .

goldbook:F02417 a skos:Concept ;
    skos:definition "Lamps which contain an inert gas which can be rapidly pulsed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flash lamps" .

goldbook:F02418 a skos:Concept ;
    skos:definition "A technique of transient spectroscopy and transient kinetic studies in which a light pulse is used to produce transient species. Commonly, an intense pulse of short duration is used to produce a sufficient concentration of a transient species suitable for spectroscopic observation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flash photolysis" .

goldbook:F02419 a skos:Concept ;
    skos:definition "The lowest temperature at which a substance, e.g. fuel oil, will give off a vapour that will flash or burn momentarily when ignited." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flash point" .

goldbook:F02420 a skos:Concept ;
    skos:altLabel "FVP" ;
    skos:definition "Thermal reaction of a molecule by exposing it to a short thermal shock at high temperature, usually in the gas phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flash vacuum pyrolysis" .

goldbook:F02421 a skos:Concept ;
    skos:definition "If effects of surface states are negligible, \\(\\Delta \\varphi ^{\\rm{sc}}\\), the potential drop associated with the space charge in the semiconductor, vanishes as the charge on the semiconductor becomes zero. The potential of the semiconductor corresponding to this condition is the flat band potential, which plays the same role as the potential of zero charge for metals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flat band potential" .

goldbook:F02423 a skos:Concept ;
    skos:definition "Derivatives of the dimethylisoalloxazine (7,8-dimethylbenzo[g]pteridine- 2,4(3H,10H)-dione) skeleton, with a substituent on the 10 position. (Riboflavin, having a 10-ᴅ-ribityl group, is the most prominent member)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flavins" .

goldbook:F02424 a skos:Concept ;
    skos:definition "Flavonoids, isoflavonoids and neoflavonoids are natural products derived from 2-phenylchromen-4-one (flavone), 3-phenylchromen-4-one and 4-phenylcoumarin, respectively. Derivations include reduction of the 2(3) carbon-carbon double bond (flavanones), reduction of the keto group (flavanols), and hydroxylation at various positions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flavonoids" .

goldbook:F02425 a skos:Concept ;
    skos:definition "Flavins tightly bound or covalently attached to a protein chain, commonly through the 8-methyl carbon atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flavoproteins" .

goldbook:F02428 a skos:Concept ;
    skos:definition "When a sol is colloidally unstable the formation of aggregates is called coagulation or flocculation. Some authors distinguish between coagulation and flocculation, the latter implying the formation of a loose or open network which may or may not separate macroscopically. The loose structure formed in this way is called a floc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "floc" .

goldbook:F02430 a skos:Concept ;
    skos:definition "A small loosely aggregated mass of material suspended in or precipitated from a liquid; a cluster of particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "floccule" .

goldbook:F02432 a skos:Concept ;
    skos:definition "The removal of matter by entrainment at an interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flotation" .

goldbook:F02433 a skos:Concept ;
    skos:definition "The generic name for all analytical methods that are based on the introduction and processing of test samples in flowing media." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow analysis" .

goldbook:F02436 a skos:Concept ;
    skos:definition "The introduction of a sample or reagent into a continuous stream by use of a rapid delivery device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow injection" .

goldbook:F02437 a skos:Concept ;
    skos:altLabel "enthalpimetric flow injection analysis",
        "flow enthalpimetry",
        "peak enthalpimetry" ;
    skos:definition "A term used to describe several related methods in which a transient temperature change in a flowing liquid stream, caused by a chemical reaction, is used to quantitatively determine an analyte. The analyte is introduced as a discrete liquid sample (i.e. test portion) into the flowing stream. This definition limits the scope to experiments with primarily an analytical emphasis, performed in a flow injection calorimeter. This maintains a clear distinction from classical flow calorimetric methods where reagents are combined continuously in flowing streams, or where the heat effect is measured via the flowing of a fluid over a reaction vessel. An acceptable synonym is enthalpimetric flow injection analysis. Other non-recommended terms which have been used in the literature include 'peak enthalpimetry' and 'enzyme thermistor'. Flow enthalpimetry has been used to describe the flow injection technique, but its use for this purpose is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow injection enthalpimetry" .

goldbook:F02439 a skos:Concept ;
    skos:definition "The volume of mobile phase passing through the column in unit time. The flow rate is usually measured at column outlet, at ambient pressure (\\(p_{\\rm{a}}\\)) and temperature (\\(T_{\\rm{a}}\\), in \\(\\rm{K}\\)); this value is indicated with the symbol \\(F\\). If a water-containing flowmeter was used for the measurement (e.g. the so-called soap bubble flowmeter) then \\(F\\) must be corrected to dry gas conditions in order to obtain the mobile phase flow rate at ambient temperature (\\(F_{\\rm{a}}\\)): \\[F_{\\rm{a}}=F\\ (1- \\frac{p_{\\rm{w}}}{p_{\\rm{a}}})\\] where \\(p_{\\rm{w}}\\) is the partial pressure of water vapour at ambient temperature. In order to specify chromatographic conditions in column chromatography, the flow-rate (mobile phase flow rate at column temperature, \\(F_{\\rm{c}}\\)) must be expressed at \\(T_{\\rm{c}}\\) (kelvin), the column temperature: \\[F_{\\rm{c}}=F_{\\rm{a}}\\ \\frac{T_{\\rm{c}}}{T_{\\rm{a}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow rate" .

goldbook:F02440 a skos:Concept ;
    skos:definition "The volume rate of one component, $\\ce{\\textbf{X}}$ (e.g. air, $\\ce{O2}$), of the unburnt gas mixture (such as $\\ce{C2H2}$, $\\ce{O2}$, etc.) in the burner tip. Ambient temperature and pressure must be stated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow rate" .

goldbook:F02442 a skos:Concept ;
    skos:definition "The volume rate of the gas mixture of the burner tip. It depends on operating conditions such as gas pressure; the ambient temperature and pressure should also be stated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow rate of unburnt gas mixture" .

goldbook:F02443 a skos:Concept ;
    skos:definition "A reactor through which the reactants pass while catalysis is in progress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow reactor" .

goldbook:F02444 a skos:Concept ;
    skos:definition "A term used to compare packing density and permeability of columns packed with different particles; it is dimensionless. \\[\\mathit{\\Phi} = \\frac{d_{\\rm{p}}^{2}}{B_{0}}\\] where \\(d_{\\rm{p}}\\) is the average particle diameter. In open-tubular columns \\(\\mathit{\\Phi} = 32\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flow resistance parameter" .

goldbook:F02446 a skos:Concept ;
    skos:definition "Waste gas from the combustion process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flue gas" .

goldbook:F02447 a skos:Concept ;
    skos:definition "Equipment for removing fly ash and other objectionable materials from the products of combustion by means of sprays or wet baffles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flue gas scrubber" .

goldbook:F02449 a skos:Concept ;
    skos:definition "The carbonization product of high-boiling hydrocarbon fractions (heavy residues of petroleum or coal processing) produced by the fluid coking process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluid coke" .

goldbook:F02451 a skos:Concept ;
    skos:definition "A catalyst bed in which the flow of gases is sufficient to cause the finely divided particles to behave like a fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluidized bed" .

goldbook:F02453 a skos:Concept ;
    skos:definition "Luminescence which occurs essentially only during the irradiation of a substance by electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence" .

goldbook:F02455 a skos:Concept ;
    skos:definition "Some samples are excited to fluorescence by the incident radiation beam. When added to the transmitted radiation beam this fluorescence results in an erroneous reading called the fluorescence error. It is particularly noticeable if the photodetector is situated close to the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence error" .

goldbook:F02457 a skos:Concept ;
    skos:definition "For a given transition from an excited state of a specified atom, the ratio of the number of excited atoms which emit a photon to the total number of excited atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence yield" .

goldbook:F02458 a skos:Concept ;
    skos:definition "An instrument used to measure the intensity and the wavelength distribution of the light emitted as fluorescence from a molecule excited at a specific wavelength or wavelengths within the absorption band of a particular compound. Characteristic fluorescence bands may be used to identify specific pollutants such as the polynuclear aromatic hydrocarbons. Excitation spectra of impurities can be observed by scanning the wavelength of the excitation light which is incident on the sample over a range of wavelengths and observing the relative intensity of the fluorescence emitted at a given wavelength. These spectra are also characteristic of the impurity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorimeter" .

goldbook:F02459 a skos:Concept ;
    skos:definition "Compounds consisting wholly of fluorine and carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorocarbons" .

goldbook:F02461 a skos:Concept ;
    skos:definition "Flow rate of X through a cross-section perpendicular to the flow divided by the cross-sectional area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flux" .

goldbook:F02462 a skos:Concept ;
    skos:definition "The lowering of the particle (or photon) flux density in the neighbourhood of an object due to absorption of particles (or photons) in the object." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "flux depression" .

goldbook:F02463 a skos:Concept ;
    skos:definition "A chemical species is said to be fluxional if it undergoes rapid degenerate rearrangements (generally detectable by methods which allow the observation of the behaviour of individual nuclei in a rearranged chemical species, e.g. NMR, X-ray). Example: bullvalene (1 209 600 interconvertible arrangements of the ten CH groups).  The term is also used to designate positional change among ligands of complex compounds and organometallics. In these cases, the change is not necessarily degenerate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluxional" .

goldbook:F02465 a skos:Concept ;
    skos:definition "Finely divided particles of ash entrained in flue gases resulting from the combustion of fuel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fly ash" .

goldbook:F02467 a skos:Concept ;
    skos:definition "A dispersion in which a large proportion of gas by volume in the form of gas bubbles, is dispersed in a liquid, solid or gel. The diameter of the bubbles is usually larger than \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\), but the thickness of the lamellae between the bubbles is often in the usual colloidal size range. The term froth has been used interchangeably with foam. In particular cases froth may be distinguished from foam by the fact that the former is stabilized by solid particles (as in froth flotation q.v.) and the latter by soluble substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foam" .

goldbook:F02468 a skos:Concept ;
    skos:definition "A method of separation in which a component of the bulk liquid is preferentially adsorbed at the liquid/vapour (L/V) interface and is removed by foaming." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foam fractionation" .

goldbook:F02469 a skos:Concept ;
    skos:definition "A surfactant which when present in small amounts facilitates the formation of a foam, or enhances its colloidal stability by inhibiting the coalescence of bubbles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "foaming agent" .

goldbook:F02470 a skos:Concept ;
    skos:definition "A general term applied to a suspension of droplets in a gas. In meteorology, it refers to a suspension of water droplets resulting in a visibility of less than \\(1\\ \\rm{km}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fog" .

goldbook:F02471 a skos:Concept ;
    skos:definition "The top of a fog layer which is confined by a low-level temperature inversion and gives the appearance of the horizon (which it actually obscures) when viewed from above, against the sky." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fog horizon" .

goldbook:F02480 a skos:Concept ;
    skos:definition "Derivative of momentum with respect to time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "force" .

goldbook:F02481 a skos:Concept ;
    skos:definition "The coefficients in an expansion of the intramolecular potential function in terms of a definite set of coordinates, the values of which define the deformation of the molecule away from its equilibrium configuration. In order to define force constants, one has to indicate both the definition of each coordinate and the expansion of the potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "force constants" .

goldbook:F02484 a skos:Concept ;
    skos:definition "The compound $\\ce{H2NC(=NH)SSC(=NH)NH2}$ and its derivatives formed by substitution at nitrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "formamidine disulfides" .

goldbook:F02486 a skos:Concept ;
    skos:definition "The parent compound $\\ce{H2NN=CHN=NH}$ and its derivatives formed by substitution at carbon and/or nitrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "formazans" .

goldbook:F02487 a skos:Concept ;
    skos:definition "An indirect method of determination of excited state equilibria, such as \\(\\rm{p}K^{\\rm{*,a}}\\) values, based on ground state thermodynamics and electronic transition energies. This cycle considers only the difference in molar enthalpy change (\\(\\Delta \\Delta H\\)) of reaction of ground and excited states, neglecting the difference in molar entropy change of reaction of those states (\\(\\Delta \\Delta S\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Förster cycle" .

goldbook:F02488 a skos:Concept ;
    skos:altLabel "dipole–dipole excitation transfer" ;
    skos:definition "A mechanism of excitation transfer which can occur between molecular entities separated by distances considerably exceeding the sum of their van der Waals radii. It is described in terms of an interaction between the transition dipole moments (a dipolar mechanism). The transfer rate constant \\(k_{D \\rightarrow  A}\\) is given by: \\[k_{\\ce{D -> A}} = \\frac{K^{2}J \\pu{8.8E-28 mol}}{n^{4} \\tau_{0} r^{6}}\\] where \\(K\\) is an orientation factor, \\(n\\) the refractive index of the medium, \\(\\tau _{0}\\) the radiative lifetime of the donor, \\(r\\) the distance (cm) between donor (D) and acceptor (A), and \\(J\\) the spectral overlap (in coherent units \\(\\pu{cm6 mol-1}\\)) between the absorption spectrum of the acceptor and the fluorescence spectrum of the donor. The critical quenching radius, \\(r_{0}\\), is that distance at which \\(k_{D \\rightarrow  A}\\) is equal to the inverse of the radiative lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Förster excitation transfer" .

goldbook:F02490 a skos:Concept ;
    skos:definition "A fuel such as coal, oil and natural gas which has formed over many years through the decomposition of deposited vegetation which was under extreme pressure of an overburden of earth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fossil fuel" .

goldbook:F02491 a skos:Concept ;
    skos:altLabel "mechanical inhibitor" ;
    skos:definition "Fouling agents (or mechanical inhibitors) are inhibitory substances bound by neither covalent nor other strong bonds to the active centres: the interaction is usually of the van der Waals, H-bond or sometimes ionic, type. They form protective layers or block pores, thus physically impeding access of reactants to the active centres. The fouling agents which cause real problems are those which have a long standing effect and do not disappear spontaneously. Carbon deposits act, partially or totally, this way (see coking). Other examples are vanadium and nickel sulfide deposits in hydrotreating catalysts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fouling agent" .

goldbook:F02492 a skos:Concept ;
    skos:altLabel "FT-ICR mass spectrometer" ;
    skos:definition "A high-frequency mass spectrometer in which the cyclotron motion of ions, having different mass/charge ratios, in a constant magnetic field is excited essentially simultaneously and coherently by a pulse or a radio-frequency electric field applied perpendicular to the magnetic field. The excited cyclotron motion of the ions is subsequently detected on so-called receiver plates as a time domain signal that contains all the cyclotron frequencies that have been excited. Fourier transformation of the time domain signal results in the frequency domain FT-ICR signal which, on the basis of the inverse proportionality between frequency and the mass/charge ratio, can be converted into a mass spectrum. The term is sometimes contracted to Fourier transform mass spectrometer (FT-MS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fourier transform ion cyclotron resonance mass spectrometer" .

goldbook:F02493 a skos:Concept ;
    skos:definition "A scanning interferometer, containing no principal dispersive element, which first splits a beam into two or more components, then recombines these with a phase difference. The spectrum is obtained by a Fourier transformation of the output of the interferometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fourier transform spectrometer" .

goldbook:F02494 a skos:Concept ;
    skos:definition "In general, a ratio of two quantities of the same kind, the numerator quantity applying to one constituent (or part) of the system and the denominator to the sum of quantities for all constituents (parts) of the system. When applied to mixtures fractions represent a group of three quantities: mass fraction, volume fraction, and amount fraction (or amount fraction equal to the number fraction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fraction" .

goldbook:F02495 a skos:Concept ;
    skos:definition "A term which may be expressed infinitesimally at time \\(t\\) by the differential \\(\\frac{\\rm{d}Q(t)}{Q(t)}\\). For a finite time interval the quotient is \\[\\frac{\\Delta Q\\left(t_{1};t_{2}\\right)}{Q\\left(t_{1}\\right)} = \\frac{\\left[Q\\left(t_{2}\\right)\\,-\\,Q\\left(t_{1}\\right)\\right]}{Q\\left(t_{1}\\right)}\\] The quantities \\(Q(t_{1})\\) and \\(Q(t_{2})\\) are of the same kind and have the same type of component. Fractional change has dimension one. Examples are: mass fractional change, \\(\\frac{\\rm{d}m(t)}{m(t)}\\); amount of substance fractional change, \\(\\frac{\\rm{d}n(t)}{n(t)}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractional change of a quantity" .

goldbook:F02496 a skos:Concept ;
    skos:definition "The term selectivity (\\(S\\)) is used to describe the relative rates of two or more competing reactions on a catalyst. Such competition includes cases of different reactants undergoing simultaneous reactions or of a single reactant taking part in two or more reactions. For the latter case, \\(S\\) may be defined in two ways. The first of these defines a fractional selectivity, \\(S_{\\rm{F}}\\), for each product by the equation \\[S_{\\rm{F}}=\\frac{\\xi _{i}}{\\sum \\xi _{i}}\\] The second defines relative selectivities, \\(S_{\\rm{R}}\\), for each pair of products by \\[S_{\\rm{R}}=\\frac{\\xi _{i}}{\\xi _{j}}\\] In each case, \\(\\xi _{i}\\) and \\(\\xi _{j}\\) are the rates of increase of the extent of reactions i and j respectively, i.e. \\[\\xi _{i}=\\frac{\\mathrm{d}\\xi _{i}}{\\mathrm{d}t}\\] and \\[\\xi _{j}=\\frac{\\mathrm{d}\\xi _{j}}{\\mathrm{d}t}\\] where \\(\\xi _{i}\\) and \\(\\xi _{j}\\) are the extents of reactions \\(i\\) and \\(j\\) respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractional selectivity" .

goldbook:F02501 a skos:Concept ;
    skos:definition "A device for recovering fractional volumes of the column effluent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fraction collector" .

goldbook:F02503 a skos:Concept ;
    skos:altLabel "recovery factor" ;
    skos:definition "The fraction of the total quantity of a substance extracted (usually by the solvent) under specified conditions, i.e. \\(E_{\\rm{A}} = \\frac{Q_{\\rm{A}}}{Q_{\\rm{A}}^{'}}\\) where \\(Q_{\\rm{A}}\\) is the mass of A extracted and \\(Q_{\\rm{A}}^{'}\\) is the total mass of A present at the start." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fraction extracted" .

goldbook:F02506 a skos:Concept ;
    skos:definition "The heterolytic cleavage of a molecule according to the general reaction:  where $\\ce{{a}-b}$ is an electrofuge and $\\ce{X}$ is a nucleofuge (which may emerge from the reaction in combined form), and the middle group affords the unsaturated fragment $\\ce{c=d}$. For example, The breakdown of a radical into a diamagnetic molecule or ion and a smaller radical, e.g. The breakdown of a radical ion in a mass spectrometer or in solution, forming an ion of lower molar mass and a radical, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragmentation" .

goldbook:F02507 a skos:Concept ;
    skos:definition "A fragmentation reaction may be written: \\[\\rm{M}_{1}^{+}\\rightarrow \\rm{M}_{2}^{+}+\\rm{M}_{3}\\] The decomposition of a metastable ion of mass-to-charge ratio \\(\\frac{m_{1}}{z_{1}}\\) into an ion of mass-to-charge ratio \\(\\frac{m_{2}}{z_{2}}\\) after electric acceleration of the metastable ion and before magnetic deflection gives rise to a peak in the mass spectrum at an apparent mass, \\(\\frac{m_{2}^{2}\\ z_{1}}{m_{1}\\ z_{2}^{2}}\\). The symbol \\(m^{*}\\) should be used to indicate the apparent mass of the product ions giving rise to this peak. Traditionally, the peak itself has been called a metastable peak and this should preferably be expressed as metastable ion peak. It is nevertheless recommended that the former term should be retained. The word metastable should never be used as a noun. Its use as an adjective should be limited to such terms as metastable ion, where it is used correctly, and to the special case of metastable peak discussed above. It should never be used in such terms as metastable reaction, metastable decomposition, metastable studies, etc. It should be clear that the metastable ion is the ion that undergoes fragmentation; it is not detected. When a reaction is written with an asterisk above the arrow as shown: \\[\\rm{M}_{1}^{+}\\overset{\\rm{*}}{\\rightarrow }\\rm{M}_{2}^{+}+\\rm{M}_{3}\\] this means that the reaction has been confirmed by the observation of a metastable peak. The textual description of such a process may be written as, for example, (\\(m^{*}\\), \\(43\\rightarrow 28\\), calcd. 18.2, obsd. 18.3) meaning 'for the fragmentation \\(\\frac{m}{z}\\ 43\\rightarrow \\frac{m}{z}\\ 28\\) a metastable peak at \\(\\frac{m}{z}\\) 18.3 (calculated 18.2) has been observed'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragmentation reaction" .

goldbook:F02508 a skos:Concept ;
    skos:definition "An electrically charged dissociation product of an ionic fragmentation. Such an ion may dissociate further to form other electrically charged molecular or atomic moieties of successively lower formula weight." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fragment ion" .

goldbook:F02509 a skos:Concept ;
    skos:definition "A point mutation involving either the deletion or insertion of a nucleotide in a gene. By the frame-shift mutation, the normal reading frame used when decoding the nucleotide triplets in the gene is altered to another reading frame." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frame-shift mutation" .

goldbook:F02510 a skos:Concept ;
    skos:definition "Classically, the Franck–Condon principle is the approximation that an electronic transition is most likely to occur without changes in the positions of the nuclei in the molecular entity and its environment. The resulting state is called a Franck–Condon state, and the transition involved, a vertical transition. The quantum mechanical formulation of this principle is that the intensity of a vibronic transition is proportional to the square of the overlap integral between the vibrational wavefunctions of the two states that are involved in the transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Franck–Condon principle" .

goldbook:F02513 a skos:Concept ;
    skos:definition "The physical charge density believed to occur on either side of the electrical double-layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free charge density on the interface" .

goldbook:F02514 a skos:Concept ;
    skos:definition "Source of coherent radiation in which the active medium is an electron beam moving at speeds close to the speed of light in the spatially periodic magnetic field produced by an array of magnets (the wiggler). The emitted wavelength, \\(\\lambda _{\\rm{L}}\\), is approximately given by \\[\\frac{\\lambda _{\\omega }}{4\\ E^{2}}\\] with \\(\\lambda _{\\omega }\\) being the wiggler period and \\(E\\) the electron's energy in \\(\\mathrm{MeV}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free electron laser" .

goldbook:F02520 a skos:Concept ;
    skos:definition "In a stereochemical context the rotation about a bond is called 'free' when the rotational barrier is so low that different conformations are not perceptible as different chemical species on the time scale of the experiment. The inhibition of rotation of groups about a bond due to the presence of a sufficiently large rotational barrier to make the phenomenon observable on the time scale of the experiment is termed hindered rotation or restricted rotation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free rotation" .

goldbook:F02521 a skos:Concept ;
    skos:definition "A term applied to a pulsed laser, meaning that the laser emission lasts as long as the pumping process is sufficient to sustain lasing conditions. Typical pulse durations are in the \\(\\unicode[Times]{x3BC}\\rm{s}\\)-\\(\\rm{ms}\\) range, depending on the pumping source. When the operation mode of a pulsed laser is not specified as mode-locked, Q-switched, or anything else, it must be considered as free-running." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "free-running laser" .

goldbook:F02523 a skos:Concept ;
    skos:definition "The conversion of a liquid to a solid by lowering the temperature and/or the application of pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "freezing" .

goldbook:F02524 a skos:Concept ;
    skos:definition "A term used in combustion for the analysis of incinerator flue gas components (largely the organic fraction) in which a series of traps at progressively lower temperatures is employed. In more general use, the term implies the removal of a condensable gas or liquid by condensation in a trap at low temperatures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "freezing out" .

goldbook:F02526 a skos:Concept ;
    skos:definition "If the range of observed measurement values is subdivided into a regular sequence of smaller intervals, this distribution is a plot of the frequency of occurrence of values falling into each interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frequency distribution" .

goldbook:F02530 a skos:Concept ;
    skos:altLabel "friction coefficient" ;
    skos:definition "Quotient of frictional force and normal force, for a sliding body. Formerly called frictional coefficient or coefficient of friction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "friction factor" .

goldbook:F02532 a skos:Concept ;
    skos:definition "A procedure in which the sample (liquid or gas) is fed continuously into the chromatographic bed. In frontal chromatography no additional mobile phase is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frontal chromatography" .

goldbook:F02533 a skos:Concept ;
    skos:definition "The Highest-energy Occupied Molecular Orbital (HOMO) (filled or partly filled) and Lowest-energy Unoccupied Molecular Orbital (LUMO) (completely or partly vacant) of a molecular entity. Examination of the mixing of frontier molecular orbitals of reacting molecular entities affords an approach to the interpretation of reaction behaviour; this constitutes a simplified perturbation molecular orbital theory of chemical behaviour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frontier orbitals" .

goldbook:F02534 a skos:Concept ;
    skos:definition "Asymmetry of a peak such that, relative to the baseline, the front is less steep than the rear. In paper chromatography and thin-layer chromatography, it refers to the distortion of a spot showing a diffuse region in front of the spot in the direction of flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fronting" .

goldbook:F02535 a skos:Concept ;
    skos:definition "A system where excitation and observation are from the same face of the sample (\\(\\alpha\\ \\angle\\ 90^{\\,\\unicode{x26ac}}\\), \\(\\beta\\ \\angle\\ 180^{\\,\\unicode{x26ac}}\\) where \\(\\alpha \\) = angle of incidence of the exciting beam on the plane surface of the sample, and \\(\\beta \\) = angle between the exciting direction and observation direction.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "front surface geometry" .

goldbook:F02536 a skos:Concept ;
    skos:definition "Instrument in which the sample is passed over a cooled surface. The temperature at which frost forms on it is a function of the water content of the gas passing over the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frost point hygrometer" .

goldbook:F02537 a skos:Concept ;
    skos:definition "The removal of particulate matter by foaming." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "froth flotation" .

goldbook:F02538 a skos:Concept ;
    skos:definition "In an electrode reaction, when reactants or intermediates are adsorbed, the rate of reaction may no longer be related to the concentration by a simple law. The deviation may be due to either entropic or energetic effects or both. The situation best understood is that where a reactant is non-specifically adsorbed in the outer Helmholtz plane (inner boundary of the diffuse layer). The effect of such adsorption on electrode kinetics is usually termed the Frumkin effect. Rate constants, transfer coefficients etc. corrected for this effect are frequently called 'true' rate constants etc. It would be preferable to describe them as 'corrected for the Frumkin effect', but in any case, if such a correction is carried out, the basis on which it is made should be clearly described." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Frumkin effect" .

goldbook:F02540 a skos:Concept ;
    skos:altLabel "nuclear fuel cycle" ;
    skos:definition "The sequence of steps, such as utilization, reprocessing, and refabrication, through which nuclear fuel may pass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fuel cycle" .

goldbook:F02541 a skos:Concept ;
    skos:altLabel "nuclear fuel element" ;
    skos:definition "The smallest structurally discrete part of a reactor which has fuel as its principal constituent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fuel element" .

goldbook:F02542 a skos:Concept ;
    skos:altLabel "nuclear fuel reprocessing" ;
    skos:definition "The processing of nuclear fuel, after its use in a reactor, to remove fission products and recover fissile and fertile material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fuel reprocessing" .

goldbook:F02544 a skos:Concept ;
    skos:definition "Ratio of fugacity to the partial pressure of a gaseous constituent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fugacity coefficient" .

goldbook:F02545 a skos:Concept ;
    skos:definition "Dialkylidenesuccinic anhydrides (generally photochromic)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fulgides" .

goldbook:F02546 a skos:Concept ;
    skos:altLabel "total absorption peak" ;
    skos:definition "Of a spectrum of radiation, the part of the spectral response curve corresponding to the total absorption in a detecting material of the energy of the detected radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "full energy peak" .

goldbook:F02547 a skos:Concept ;
    skos:definition "Compounds composed solely of an even number of carbon atoms, which form a cage-like fused-ring polycyclic system with twelve five-membered rings and the rest six-membered rings. The archetypal example isfullerene, where the atoms and bonds delineate a truncated icosahedron. The term has been broadened to include any closed cage structure consisting entirely of three-coordinate carbon atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fullerenes" .

goldbook:F02548 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RON=C{:}}$. So called because fulminic acid (actually $\\ce{HC#N^{+}–O^{−}}$ formonitrile oxide) was previously considered to be $\\ce{HON=C{:}}$.Salts of fulminic acid, e.g. $\\ce{Na^{+}[–C#N^{+}O^{−}]}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fulminates" .

goldbook:F02549 a skos:Concept ;
    skos:definition "The hydrocarbon fulvalene and its derivatives formed by substitution (and by extension, analogues formed by replacement of one or more carbon atoms of the fulvalene skeleton by a heteroatom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fulvalenes" .

goldbook:F02550 a skos:Concept ;
    skos:definition "The hydrocarbon fulvene and its derivatives formed by substitution (and by extension, analogues formed by replacement of one or more carbon atoms of the fulvene skeleton by a heteroatom)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fulvenes" .

goldbook:F02551 a skos:Concept ;
    skos:definition "Fine solid particles (aerosol), predominantly less than \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter, which result from the condensation of vapour from some types of chemical reaction. Usually this is formed from the gaseous state generally after volatilization from melted substances and often accompanied by chemical reactions such as oxidation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fume" .

goldbook:F02552 a skos:Concept ;
    skos:definition "In popular usage, a term often taken to mean airborne effluents, unpleasant and malodorous, which might arise from chemical processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fumes" .

goldbook:F02553 a skos:Concept ;
    skos:definition "An atmospheric phenomenon in which pollution, retained by an inversion layer near its level of emission, is brought rapidly to ground level as the inversion breaks up. This term also applies to the exposure of material (e.g. grain) to chemicals to kill insects, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fumigation" .

goldbook:F02554 a skos:Concept ;
    skos:definition "A name that expresses the characteristic group as a class term written as a separate word following the name of a parent structure or a name derived from a parent structure. In the latter case, when the derived name is that for a substituent group (formerly called a 'radical'), the method has been called 'radicofunctional nomenclature'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional class name" .

goldbook:F02555 a skos:Concept ;
    skos:definition "Organic compounds are thought of as consisting of a relatively unreactive backbone, for example a chain of \\(\\rm{sp}^{3}\\) hybridized carbon atoms, and one or several functional groups. The functional group is an atom, or a group of atoms that has similar chemical properties whenever it occurs in different compounds. It defines the characteristic physical and chemical properties of families of organic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional group" .

goldbook:F02556 a skos:Concept ;
    skos:definition "A structure the name of which implies the presence of one or more characteristic groups and which has one or more hydrogen atoms attached to at least one of its skeletal atoms or one of its characteristic groups, or in which at least one of its characteristic groups can form at least one kind of functional modification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional parent" .

goldbook:F02558 a skos:Concept ;
    skos:definition "An alternative name for furocoumarins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "furanocoumarins" .

goldbook:F02559 a skos:Concept ;
    skos:definition "Cyclic hemiacetal forms of monosaccharides in which the ring is five-membered (i.e. a tetrahydrofuran skeleton)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "furanoses" .

goldbook:F02561 a skos:Concept ;
    skos:definition "A flowing stream of gas (hydrogen, oxygen, nitrogen, chlorine, etc.) required to produce volatile species of the elements being determined, is passed over the test sample in a heated furnace. The analytes leave the furnace in the gas stream, or are entrained by a carrier gas. The analytes in the gas stream may be collected in an absorbing solution, on a carbon or other filter or by condensation on a cool surface. In the case of mercury this can also be done by amalgamation with a noble metal. The analytes may then be swept and released from the trap, by heating, into a sampling source for analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "furnace pyrolysis" .

goldbook:F02562 a skos:Concept ;
    skos:definition "Derivatives (mostly of natural origin) of the linear furocoumarin skeleton, psoralen, or its angular isomer, angelicin, variously substituted with hydroxy, methoxy, alkyl, or hydroxymethyl groups, among others." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "furocoumarins" .

goldbook:F02563 a skos:Concept ;
    skos:definition "The amalgamation of two distinct cells or macromolecules into a single integrated unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fusion" .

goldbook:F02564 a skos:Concept ;
    skos:definition "A composite name for a polycyclic parent structure having the maximum number of non-cumulative double bonds and at least one ortho fusion. Name formation involves the dissection of the structure into contiguous components having recognized trivial or semisystematic names, one of which is selected as the 'base component'. attachment of the other components is described by prefixes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fusion name" .

goldbook:FT06771 a skos:Concept ;
    skos:definition "A protein containing more than one iron and acid-labile sulfur, that displays electron-transfer activity but not classical enzyme function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferredoxin" .

goldbook:FT06786 a skos:Concept ;
    skos:definition "$\\ce{Fe^{2+} + H2O2 -> Fe^{3+} + OH^{.} + OH^{−}}$ . This is the iron-salt-dependent decomposition of dihydrogen peroxide, generating the highly reactive hydroxyl radical, possibly via an oxoiron(IV) intermediate. Addition of a reducing agent, such as ascorbate, leads to a cycle which increases the damage to biological molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fenton reaction" .

goldbook:FT06824 a skos:Concept ;
    skos:definition "Biotransformation and, in some cases, elimination of a substance in the liver after absorption from the intestine and before it reaches the systemic circulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "first-pass effect" .

goldbook:FT06825 a skos:Concept ;
    skos:definition "Process of classification of an analyte or a group of analytes from a sample according to physical (e.g., size, solubility) or chemical (e.g., bonding, reactivity) properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractionation" .

goldbook:FT06876 a skos:Concept ;
    skos:definition "Process resulting in loss of performance of a membrane due to the deposition of suspended or dissolved substances on its external surfaces, at its pore openings, or within its pores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fouling" .

goldbook:FT07172 a skos:Concept ;
    skos:definition "Polymer in which spontaneous polarization arises when dipoles become arranged parallel to each other by electric fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferroelectric polymer" .

goldbook:FT07173 a skos:Concept ;
    skos:definition "Polymer that exhibits magnetic properties because it has unpaired electron spins aligned parallel to each other or electron spins that can easily be so aligned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ferromagnetic polymer" .

goldbook:FT07174 a skos:Concept ;
    skos:definition "Polymer that bears specified chemical groups.Polymer that has specified physical, chemical, biological, pharmacological, or other uses which depend on specific chemical groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functional polymer" .

goldbook:FT07301 a skos:Concept ;
    skos:definition "Morphology in which phase domains have shapes with one dimension much larger than the other two dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fibrillar morphology" .

goldbook:FT07375 a skos:Concept ;
    skos:definition "Loss of performance over time, due to chemical degradation. The major cause of fatigue is oxidation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fatigue" .

goldbook:FT07376 a skos:Concept ;
    skos:altLabel "radiant energy fluence rate" ;
    skos:definition "Total radiant power, \\(P\\), incident from all directions onto a small sphere divided by the cross-sectional area of that sphere. SI unit is \\(\\rm{W m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluence rate" .

goldbook:FT07377 a skos:Concept ;
    skos:definition "Parameter describing the time evolution of the decay of the fluorescent radiant intensity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence lifetime" .

goldbook:FT07378 a skos:Concept ;
    skos:altLabel "FRET" ;
    skos:definition "Term frequently and inappropriately applied to resonance energy transfer in the sense of Förster-resonance-energy transfer (FRET), which does not involve the emission of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorescence resonance energy transfer" .

goldbook:FT07379 a skos:Concept ;
    skos:definition "Property of a material in which fluorescence is induced or enhanced by the addition of another molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorogenic" .

goldbook:FT07380 a skos:Concept ;
    skos:definition "Molecular entity (often organic) that emits fluorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fluorophore" .

goldbook:FT07381 a skos:Concept ;
    skos:altLabel "FRET" ;
    skos:definition "Non-radiative excitation transfer between two molecular entities separated by distances considerably exceeding the sum of their van der Waals radii. It describes the transfer in terms of the interaction between the transition (dipole) moments of the entities in the very weak dipole-dipole coupling limit. It is a Coulombic interaction frequently called a dipole-dipole coupling. The transfer rate constant from donor to acceptor, \\(k_{\\rm{T}}\\), is given by \\[k_{\\rm{T}} = k_{\\rm{D}}\\left ( \\frac{R_{0}}{r} \\right )^{6}=\\frac{1}{\\tau _{D}^{0}}\\left ( \\frac{R_{0}}{r}\\right )^{6}\\] where \\(k_{\\rm{D}}\\) and \\(\\tau_{\\rm{D}}^{0}\\) are the emission rate constant and the lifetime of the excited donor in the absence of transfer, respectively, \\(r\\) is the distance between the donor and the acceptor and \\(R_{0}\\) is the critical quenching radius or Förster radius, i.e., the distance at which transfer and spontaneous decay of the excited donor are equally probable (\\(k_{\\rm{T}} = k_{\\rm{D}}\\)) (see Note 3). \\(R_{0}\\) is given by \\[R_{0} = Const.\\left ( \\frac{\\kappa^{2}\\mathit{\\Phi}_{D}^{0}J }{n^{4}} \\right )^{1/6}\\] where \\(\\kappa\\) is the orientation factor, \\(\\mathit{\\Phi} _{D}^{0}\\) is the fluorescence quantum yield of the donor in the absence of transfer, \\(n\\) is the average refractive index of the medium in the wavelength range where spectral overlap is significant, \\(J\\) is the spectral overlap integral reflecting the degree of overlap of the donor emission spectrum with the acceptor absorption spectrum and given by \\[J = \\int _{\\lambda }I_{\\lambda}^{D}(\\lambda)\\epsilon _{A}\\left ( \\lambda \\right )\\lambda^{4}\\rm{d}\\lambda\\] where \\(I_{\\lambda}^{D}(\\lambda)\\) is the normalized spectral radiant intensity of the donor so that \\(\\int_{\\lambda}I_{\\lambda}^{D}(\\lambda)\\rm{d}\\lambda = 1\\). \\(\\varepsilon_{\\rm{A}}({\\lambda})\\) is the molar decadic absorption coefficient of the acceptor. See Note 3 for the value of \\(Const.\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Förster-resonance-energy transfer" .

goldbook:FT07382 a skos:Concept ;
    skos:definition "Measurement technique whereby spectra are collected based on measurements of the temporal coherence of a radiative source, using time-domain measurements of the electromagnetic radiation or other type of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Fourier-transform spectroscopy" .

goldbook:FT07383 a skos:Concept ;
    skos:definition "The number of waveperiods per time interval. The linear frequency, \\( u\\), is the number of cycles per time interval. SI unit \\(\\rm{Hz =  s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frequency" .

goldbook:FT07384 a skos:Concept ;
    skos:definition "Technique that permits recovery of the parameters characterizing a fluorescence decay. Instead of using an exciting visible, UV, or infrared radiation pulse (see single-photon timing), the sample is excited by sinusoidally modulated radiation at high frequency. The fluorescence response is sinusoidally modulated at the same frequency as, but delayed in phase and partially demodulated with respect to the excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "frequency-domain fluorometry" .

goldbook:FT07385 a skos:Concept ;
    skos:altLabel "FRET" ;
    skos:definition "Acronym for Förster-resonance-energy transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "FRET" .

goldbook:FT07505 a skos:Concept ;
    skos:definition "Number of covalent bonds that a monomer molecule or monomeric unit in a macromolecule or oligomer molecule can form with other reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "functionality" .

goldbook:FT07549 a skos:Concept ;
    skos:definition "Agglomerate having the same fractal dimension as the constituent particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractal agglomerate" .

goldbook:FT07550 a skos:Concept ;
    skos:altLabel "Hausdorff dimension",
        "mass fractal dimension" ;
    skos:definition "Parameter that provides a mathematical description of the fractal structure of a polymer network, an aggregated particulate sol, or of the particles that comprise them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "fractal dimension" .

goldbook:G02566 a skos:Concept ;
    skos:definition "Two or more different gamma rays emitted successively from one nucleus when it passes through one or more energy levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-cascade" .

goldbook:G02571 a skos:Concept ;
    skos:definition "The number of specified chemical events in an irradiated substance produced per \\(100\\ \\rm{eV}\\) of energy absorbed from ionizing radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>G</em> value" .

goldbook:G02572 a skos:Concept ;
    skos:definition "The gain of a photomultiplier is given by the equation \\(G=k\\ \\sigma ^{n}\\), where \\(k\\) is the efficiency of collection of photoelectrons on the first dynode, \\(\\sigma \\) is the secondary emission ratio, i.e. the number of secondary electrons emitted for each electron incident on the dynode and \\(n\\) is the number of dynodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gain" .

goldbook:G02576 a skos:Concept ;
    skos:definition "An assembly for the purpose of determining one or more components in a gaseous mixture. It generally comprises the following elements: sample probe, region of primary treatment of the gases, region of secondary treatment of gases, points for venting to the atmosphere and for calibration sample injection, transfer line and the analytical unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas analysis installation" .

goldbook:G02577 a skos:Concept ;
    skos:altLabel "carbon black",
        "channel black",
        "furnace black" ;
    skos:definition "Finely divided carbon (graphite) produced by incomplete combustion or thermal decomposition of natural gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas black" .

goldbook:G02578 a skos:Concept ;
    skos:altLabel "GC" ;
    skos:definition "A separation technique in which the mobile phase is a gas. Gas chromatography is always carried out in a column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas chromatography" .

goldbook:G02579 a skos:Concept ;
    skos:definition "Fundamental physical constant, \\(R = \\pu{8.314472(15) J K-1 mol-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas constant" .

goldbook:G02580 a skos:Concept ;
    skos:definition "Instrumentation to separate a gas mixture into its components by means of differences in the diffusion rates of the component molecules. This method has been used in separation of various isotopes of uranium (by means of $\\ce{UF6}$) and hydrogen ($\\ce{H2O}$, $\\ce{HDO}$, $\\ce{D2O}$, $\\ce{HTO}$, etc.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gaseous diffusion separator" .

goldbook:G02581 a skos:Concept ;
    skos:definition "Similar in construction to a vacuum phototube except that it is filled with a noble gas (usually $\\ce{Ar}$) at a pressure of about \\(10\\ \\rm{Pa}\\). Photoelectrons accelerated by the anode electric potential ionize gas atoms. The additional electrons provide a substantial intrinsic gain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas-filled phototube" .

goldbook:G02582 a skos:Concept ;
    skos:definition "A cylindrical cathode with a window, an axial wire anode and an ionizable gas. The gas may be continuously replenished giving a flow-through detector or the detector may be sealed. Following an original ionizing event, electron multiplication occurs through a process of gas amplification in the high electric field surrounding the anode wire. The gain of this process is defined as the number of electrons collected on the anode wire for each primary electron produced. For X-rays having energies higher than the excitation potential of the detector gas, the spectral responsivity function has a second peak in addition to the main peak that is called the escape peak. The escape peak has a mean pulse height proportional to the difference between the photon energy of the incident X-rays and of the spectral characteristic line of the detector gas. A quenching gas, a molecular gas, is added to the detector gas in order to neutralize the detector gas ions and to absorb secondary electrons as well as UV radiation resulting from neutralization of detector gas ions. According to the potential applied to the anode, the detector can work as an ionization chamber, proportional counter, or Geiger counter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas-filled X-ray detector" .

goldbook:G02585 a skos:Concept ;
    skos:definition "A laser in which the active medium is a gas containing a laser active species. It is typically composed of a plasma discharge tube containing a gas that can be excited with an electric discharge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas laser" .

goldbook:G02587 a skos:Concept ;
    skos:definition "The negative of the Gibbs energy (\\(\\Delta G_{\\rm{r}}^{\\,\\unicode{x26ac}}\\)) change for the reaction:  in the gas phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas-phase acidity" .

goldbook:G02588 a skos:Concept ;
    skos:definition "The negative of the Gibbs energy (\\(\\Delta G_{\\rm{r}}^{\\,\\unicode{x26ac}}\\)) change associated with the reaction: in the gas phase.  Also called absolute or intrinsic basicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas-phase basicity" .

goldbook:G02589 a skos:Concept ;
    skos:altLabel "CVD" ;
    skos:definition "Carbon fibres grown in an atmosphere of hydrocarbons with the aid of fine particulate solid catalysts such as iron or other transition metals and consisting of graphitizable carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas-phase-grown carbon fibres" .

goldbook:G02590 a skos:Concept ;
    skos:definition "A sensor composed of an indicator and a reference electrode in contact with a thin film of solution which is separated from the bulk of the sample solution by a gas-permeable membrane or an air gap. This intermediate solution interacts with the gaseous species (penetrated through the membrane or an air gap) in such a way as to produce a change in a measured constituent (e.g. the $\\ce{H^{+}}$ activity) of the intermediate solution. This change is then sensed by the ion-selective electrode and is related to the partial pressure of the gaseous species in the sample. [Note: In electrochemical literature the term gas electrode is used for the classical, redox-equilibrium-based gas electrodes as well, such as the hydrogen or the chlorine gas electrodes ($\\ce{Pt(s)}$|$\\ce{H2(g)}$|$\\ce{H^{+}(aq)}$ or $\\ce{Pt(s)}$|$\\ce{Cl2(g)}$|$\\ce{Cl^{-}(aq)}$]. These electrodes respond both to the partial pressure of the gas ($\\ce{H2}$ or $\\ce{Cl2}$) and to the ionic activities ($\\ce{H^{+}}$ or $\\ce{Cl^{-}}$). The Clark oxygen electrode fits under this classification although, in contrast to other gas sensors, it is an amperometric and not a potentiometric device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gas sensing electrode" .

goldbook:G02593 a skos:Concept ;
    skos:definition "Synonymous with a synclinal alignment of groups attached to adjacent atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gauche" .

goldbook:G02595 a skos:Concept ;
    skos:definition "The stabilization of the gauche (synclinal) conformation in a two carbon unit bonded vicinally to electronegative elements e.g. 1,2-difluoroethane.The destabilization of the gauche (synclinal) conformation in a two carbon unit bonded vicinally to large, soft and polarizable elements such as sulfur and bromine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gauche effect" .

goldbook:G02597 a skos:Concept ;
    skos:definition "A band shape described by the Gaussian function: \\[F\\left( u -  u _{0}\\right) = \\frac{a}{\\sqrt{\\pi }}\\ \\rm{e}^{-a^{2}\\ ( u -  u _{0})^{2}}\\] In this equation, \\(a^{-1}\\) is proportional to the width of the band, and \\( u _{0}\\) is the frequency of the band maximum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gaussian band shape" .

goldbook:G02598 a skos:Concept ;
    skos:definition "A gas-filled X-ray detector in which gas amplification reaches saturation and proportionality no longer exists. The output signal does not depend on the incident energy. The time taken for the counter to recover from the saturation is called dead time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Geiger counter" .

goldbook:G02599 a skos:Concept ;
    skos:definition "A counter tube operated under such conditions that the magnitude of each pulse is independent of the amount of energy deposited in it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Geiger–Muller counter tube" .

goldbook:G02600 a skos:Concept ;
    skos:definition "Non-fluid colloidal network or polymer network that is expanded throughout its whole volume by a fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel" .

goldbook:G02602 a skos:Concept ;
    skos:definition "Pair of molecular entities in close proximity in solution within a solvent cage and resulting from reaction (e.g. bond scission, electron transfer, group transfer) of a precursor that constitutes a single kinetic entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geminate pair" .

goldbook:G02603 a skos:Concept ;
    skos:definition "This expression refers to the reaction, with each other, of two transient species produced from a common precursor in solution. If reaction occurs before any separation by diffusion has occurred, this is termed primary geminate recombination. If the mutually reactive entities have been separated, and come together by diffusion, this is termed secondary geminate recombination. This is illustrated in the reaction diagram below:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geminate recombination" .

goldbook:G02604 a skos:Concept ;
    skos:altLabel "cistron" ;
    skos:definition "Structurally, a basic unit of hereditary material; an ordered sequence of nucleotide bases that encodes one polypeptide chain (via mRNA). The gene includes, however, regions preceding and following the coding region (leader and trailer) as well as (in eukaryotes) intervening sequences (introns) between individual coding segments (exons). Functionally, the gene is defined by the cis-trans test that determines whether independent mutations of the same phenotype occur within a single gene or in several genes involved in the same function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene" .

goldbook:G02605 a skos:Concept ;
    skos:definition "An increase in the number of copies of a specific gene in an organism. This can lead to the production of a corresponding protein at elevated levels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene amplification" .

goldbook:G02606 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "A collection of cloned DNA fragments from a variety of species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene library" .

goldbook:G02607 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "The use of in vitro techniques to produce DNA molecules containing novel combinations of genes or altered sequences, and the insertion of these into vectors that can be used for their incorporation into host organisms or cells in which they are capable of continued propagation of the modified genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gene manipulation" .

goldbook:G02608 a skos:Concept ;
    skos:definition "Catalysis by acids or bases in solution is said to be general when it is possible to detect catalysis brought about by species other than the ions formed from the solvent itself (e.g. when water is the solvent, by species other than $\\ce{H^{+}}$ and $\\ce{OH^{−}}$ ions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "general acid–base catalysis" .

goldbook:G02609 a skos:Concept ;
    skos:definition "The catalysis of a chemical reaction by a series of Brønsted acids (which may include the solvated hydrogen ion) so that the rate of the catalysed part of the reaction is given by \\(\\sum k_{\\rm{HA}}\\ [HA]\\) multiplied by some function of substrate concentrations. (The acids $\\ce{HA}$ are unchanged by the overall reaction.) General catalysis by acids can be experimentally distinguished from specific catalysis by hydrogen cations (hydrons) by observation of the rate of reaction as a function of buffer concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "general acid catalysis" .

goldbook:G02610 a skos:Concept ;
    skos:definition "The catalysis of a chemical reaction by a series of Brønsted bases (which may include the lyate ion) so that the rate of the catalysed part of the reaction is given by \\(\\sum k_{\\rm{B}}\\ [\\rm{B}]\\) multiplied by some function of substrate concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "general base catalysis" .

goldbook:G02611 a skos:Concept ;
    skos:altLabel "GFF" ;
    skos:definition "A force field expressed in terms of \\(3\\ N-6\\) basis coordinates: \\[V=\\frac{1}{2}\\, \\sum f_{ij}\\ S_{i}\\ S_{j}\\] \\[V=\\frac{1}{2}\\, \\sum F_{ij}\\ S_{i}\\ S_{j}\\] where \\(f_{ij}\\) (or \\(F_{ij}\\)) are force constants and the basis coordinates \\(S\\) (or sometimes \\(s\\)) may be internal symmetry coordinates, local symmetry coordinates or any others suitable to the problem, but the number of the coordinates has to be reduced to \\(3\\, N-6\\) (\\(3\\, N-5\\) for linear molecules), \\(N\\) being the number of atoms in the molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "general force field" .

goldbook:G02612 a skos:Concept ;
    skos:altLabel "TST" ;
    skos:definition "Any form of transition-state theory (TST), such as microcanonical variational TST, canonical variational TST, and improved canonical variational TST, in which the transition state is not necessarily located at the saddle point, is referred to as generalized transition-state theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generalized transition-state theory" .

goldbook:G02613 a skos:Concept ;
    skos:definition "A tracer in which the position of the label is not defined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generally labelled tracer" .

goldbook:G02614 a skos:Concept ;
    skos:definition "The average time required by a cell for the completion of one cell cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "generation time" .

goldbook:G02615 a skos:Concept ;
    skos:altLabel "mRNA" ;
    skos:definition "The set of rules which governs the relationship between the linear order of the nucleotides in an mRNA molecule and the sequence of the amino acids in the protein which it encodes. The genetic code is a triplet code, nearly universal. It is not overlapping: a mutation which alters only a single nucleotide in a gene can change only one amino acid in the encoded protein. It is degenerate: it assigns each of the 20 amino acids to one or more of 61 of the 64 possible nucleotide triplets (cf. codon) that can be constructed from four nucleotides. The remaining three triplets are used to signal the termination of a genetic message." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic code" .

goldbook:G02616 a skos:Concept ;
    skos:altLabel "DNA" ;
    skos:definition "The complete set of chromosomal and extrachromosomal genes of an organism, a cell, an organelle or a virus; the complete DNA component of an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genome" .

goldbook:G02617 a skos:Concept ;
    skos:definition "The genetic constitution of an organism as revealed by genetic or molecular analysis, i.e. the complete set of genes, both dominant and recessive, possessed by a particular cell or organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genotype" .

goldbook:G02619 a skos:Concept ;
    skos:definition "The reduction of a radiation quantity due to the effect only of the distance between the point of interest and the source, excluding the effect of any matter present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geometric attenuation" .

goldbook:G02621 a skos:Concept ;
    skos:altLabel "logarithmic mean" ;
    skos:definition "The nth root of the product of the absolute values of the observations, taken with the proper sign. It can be calculated with the formula: \\[\\bar{x}_{\\rm{g}} = (\\Pi |x_{i}|)^{\\frac{1}{n}}\\] The \\(\\mathit{\\Pi}\\) product is taken from i = 1 to n." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geometric mean" .

goldbook:G02623 a skos:Concept ;
    skos:altLabel "counting geometry" ;
    skos:definition "A term used colloquially to signify the arrangement in space of the various components in an experiment, particularly the source and the detector in radiation measurements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geometry" .

goldbook:G02624 a skos:Concept ;
    skos:definition "The average solid angle in steradians at source subtended by the aperture or sensitive volume of the detector, divided by $4\\uppi\\!$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geometry factor" .

goldbook:G02626 a skos:Concept ;
    skos:altLabel "germylenes" ;
    skos:definition "Carbene analogues having the structure $\\ce{R2Ge{:}}$. The older synonym germylenes is no longer recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "germylidenes" .

goldbook:G02627 a skos:Concept ;
    skos:definition "The surface excess amount or Gibbs adsorption of component \\(i\\), \\(n_{i}^{\\sigma }\\), which may be positive or negative, is defined as the excess of the amount of this component actually present in the system over that present in a reference system of the same volume as the real system and in which the bulk concentrations in the two phases remain uniform up to the Gibbs dividing surface. That is \\[n_{i}^{\\sigma }=n_{i}- V^{\\alpha }\\ c_{i}^{\\alpha }- V^{\\beta }\\ c_{i}^{\\beta }\\] where \\(n_{i}\\) is the total amount of the component \\(i\\) in the system, \\(c_{i}^{\\alpha }\\) and \\(c_{i}^{\\beta }\\) are the concentrations in the two bulk phases \\(\\alpha \\) and \\(\\beta \\), and \\(V^{\\alpha }\\) and \\(V^{\\beta }\\) are the volumes of the two phases defined by the Gibbs surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs adsorption" .

goldbook:G02629 a skos:Concept ;
    skos:altLabel "Gibbs energy function",
        "free energy" ;
    skos:definition "Enthalpy minus the product of thermodynamic temperature and entropy. It was formerly called free energy or free enthalpy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs energy" .

goldbook:G02630 a skos:Concept ;
    skos:altLabel "Gibbs energy profile",
        "energy profile",
        "free energy profile" ;
    skos:definition "A diagram showing the relative standard Gibbs energies of reactants, transition state, reaction intermediates and products, in the same sequence as they occur in a chemical reaction. These points are often connected by a smooth curve (a 'Gibbs energy profile', commonly still referred to as a 'free energy profile') but experimental observation can provide information on relative standard Gibbs energies only at the maxima and minima and not at the configurations between them. The abscissa expresses the sequence of reactants, products, reaction intermediates and transition states and is usually undefined or only vaguely defined by the reaction coordinate (extent of bond breaking or bond making). In some adaptations the abscissas are however explicitly defined as bond orders, Brønsted exponents, etc. Contrary to statements in many text books, the highest point on a Gibbs energy diagram does not necessarily correspond to the transition state of the rate-limiting step. For example, in a stepwise reaction consisting of two reaction steps:  one of the transition states of the two reaction steps must (in general) have a higher standard Gibbs energy than the other, whatever the concentration of D in the system. However, the value of that concentration will determine which of the reaction steps is rate-limiting. If the particular concentrations of interest, which may vary, are chosen as the standard state, then the rate-limiting step is the one of highest Gibbs energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs energy diagram" .

goldbook:G02631 a skos:Concept ;
    skos:altLabel "standard free energy of activation" ;
    skos:definition "The standard Gibbs energy difference between the transition state of a reaction (either an elementary reaction or a stepwise reaction) and the ground state of the reactants. It is calculated from the experimental rate constant \\(k\\) via the conventional form of the absolute rate equation: \\[\\Delta ^{\\ddagger}G = R\\ T\\ \\left[\\ln (\\frac{k_{\\rm{B}}}{h}) - \\ln (\\frac{k}{T})\\right]\\] where \\(k_{\\rm{B}}\\) is the Boltzmann constant and \\(h\\) the Planck constant (\\(\\frac{k_{\\rm{B}}}{h} = 2.083\\ 58\\times 10^{10}\\ \\rm{K}^{-1}\\ \\rm{s}^{-1}\\)). The values of the rate constants, and hence Gibbs energies of activation, depend upon the choice of concentration units (or of the thermodynamic standard state)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs energy of activation" .

goldbook:G02632 a skos:Concept ;
    skos:definition "Indicated by \\(G_{\\rm{r}}\\) or \\(G_{\\rm{el}}\\) if the repulsion is due to electric effects (\\(g_{\\rm{r}}\\) or \\(g_{\\rm{el}}\\) is taken for unit area of each of two flat and parallel surfaces). \\(G_{\\rm{r}}\\) (or \\(G_{\\rm{el}}\\)) is defined as \\[G_{\\rm{r}}\\,\\rm{(}\\rm{or}\\,G_{\\rm{el}}\\rm{)} = \\left[\\int _{\\rm{final distance}}^{\\infty }\\rm{Force}  \\;\\rm{d (distance)}\\right]_{T,p}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs energy of repulsion" .

goldbook:G02634 a skos:Concept ;
    skos:definition "Pertains to a film element of a soap film changing in area at constant mass and is the differential change of its surface tension with relative change in area \\(A\\), \\[E=A\\ (\\frac{\\partial \\sigma }{\\partial A})_{T,p,n_{i}}\\] where \\(T\\) is the thermodynamic temperature, \\(p\\) is the pressure, and \\(n_{i}\\) is the amount of substance of the species \\(i\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs film elasticity" .

goldbook:G02635 a skos:Concept ;
    skos:definition "A geometrical surface chosen parallel to the interface and used to define the volumes of the bulk phases in the calculation of the extent of adsorption, and of other surface excess properties. Also referred to as Gibbs dividing surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs surface" .

goldbook:G02637 a skos:Concept ;
    skos:definition "Deviation of a glass electrode from the hydrogen-ion response function. An example often encountered is the error due to sodium ions at alkaline \\(\\rm{pH}\\) values, which by convention is regarded as positive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass electrode error" .

goldbook:G02638 a skos:Concept ;
    skos:definition "A solid state laser in which the active medium is a glass host that supports the active species. The neodymium-doped phosphate glass laser is one example." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass laser" .

goldbook:G02639 a skos:Concept ;
    skos:definition "An agranular non-graphitizable carbon with a very high isotropy of its structural and physical properties and with a very low permeability for liquids and gases. The original surfaces and the fracture surfaces have a pseudo-glassy appearance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass-like carbon" .

goldbook:G02640 a skos:Concept ;
    skos:definition "A second-order transition in which a supercooled melt yields, on cooling, a glassy structure. Below the glass-transition temperature the physical properties vary in a manner similar to those of the crystalline phase. Example: Lithium disilicate crystals melt at \\(1305\\ \\rm{K}\\); the melt can be supercooled to the glass-transition temperature at approximately \\(773\\ \\rm{K}\\) below which the viscous liquid freezes to a rigid amorphous glass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass transition" .

goldbook:G02641 a skos:Concept ;
    skos:definition "The temperature at which the viscosity of the glass is \\(10^{13}\\ \\rm{dPa}\\ \\rm{s}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glass-transition temperature" .

goldbook:G02643 a skos:Concept ;
    skos:definition "An enclosure in which material may be manipulated in isolation from the operator's environment. This manipulation is effected by gauntlet gloves or flexible plastic devices fixed to ports in the walls of the box." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glove box" .

goldbook:G02645 a skos:Concept ;
    skos:definition "Synonymous with polysaccharides. Glycans composed of a single type of monosaccharide residue (homopolysaccharide, synonym homoglycan) are named by replacing the ending '-ose' of the sugar by '-an', e.g. mannans, fructans, xylans, arabinans. dextrans and dextrins belong to the class glucans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycans" .

goldbook:G02647 a skos:Concept ;
    skos:definition "Esters of glycerol (propane-1,2,3-triol) with fatty acids, widely distributed in nature. They are by long-established custom subdivided into triglycerides, 1,2- or 1,3-diglycerides, and 1- or 2-monoglycerides, according to the number and position of acyl groups (not, as one might suppose, the number of glycerol residues). The recommended method for naming individual glycerides is mono-, di- or tri-O-acylglycerol, as appropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycerides" .

goldbook:G02651 a skos:Concept ;
    skos:definition "A type of compound consisting of carbohydrate units covalently linked with other types of chemical constituent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycoconjugate" .

goldbook:G02653 a skos:Concept ;
    skos:definition "Naturally occurring 1,2-di-O-acylglycerols joined at oxygen 3 by a glycosidic linkage to a carbohydrate part (usually a mono-, di- or tri-saccharide). Some substances classified as bacterial glycolipids have the sugar part acylated by one or more fatty acids and the glycerol part may be absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycolipids" .

goldbook:G02654 a skos:Concept ;
    skos:definition "Dihydric alcohols, also known as diols, in which the two hydroxy groups are on different carbon atoms, usually but not necessarily adjacent. E.g. $\\ce{HOCH2CH2OH}$ 'ethylene glycol' (ethane-1,2-diol), $\\ce{HO[CH2]4OH butane-1,4-diol}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycols" .

goldbook:G02656 a skos:Concept ;
    skos:altLabel "glycoproteins" ;
    skos:definition "Compounds in which a carbohydrate component is linked to a peptide/protein component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycopeptides" .

goldbook:G02658 a skos:Concept ;
    skos:definition "A term synonymous with amino sugars; now restricted to some trivial names." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosamines" .

goldbook:G02660 a skos:Concept ;
    skos:definition "A less frequently used term for monosaccharides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycoses" .

goldbook:G02661 a skos:Concept ;
    skos:definition "Originally mixed acetals resulting from the attachment of a glycosyl group to a non-acyl group $\\ce{RO– (which itself may be derived from a saccharide and chalcogen replacements thereof ($\\ce{RS\\bond{–}}$, $\\ce{RSe\\bond{–}}$).  The bond between the glycosyl group and the $\\ce{OR}$ group is called a glycosidic bond. By extension, the terms N-glycosides and C-glycosides are used as class names for glycosylamines and for compounds having a glycosyl group attached to a hydrocarbyl group respectively.   These terms are misnomers and should not be used. The preferred terms are glycosylamines and C-glycosyl compounds, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosides" .

goldbook:G02663 a skos:Concept ;
    skos:definition "Compounds having a glycosyl group attached to an amino group, $\\ce{NR2}$; less elegantly called N-glycosides, e.g. N,N-dimethyl-$\\upbeta\\!$-ᴅ-glucopyranosylamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosylamines" .

goldbook:G02665 a skos:Concept ;
    skos:definition "The structure obtained by removing the hydroxy group from the hemiacetal function of a monosaccharide and, by extension, of a lower oligosaccharide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "glycosyl group" .

goldbook:G02668 a skos:Concept ;
    skos:definition "The taking of a sample (often in an evacuated bulb) in a very short time; preferred terms are instantaneous sampling or instantaneous sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grab sampling" .

goldbook:G02669 a skos:Concept ;
    skos:definition "A differential ratio; the change in a quantity such as the mixing ratio of an impurity in air, the temperature of the air, etc., with height or distance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gradient" .

goldbook:G02670 a skos:Concept ;
    skos:definition "A procedure in which the composition of the mobile phase is changed continuously or stepwise during the elution process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gradient elution" .

goldbook:G02671 a skos:Concept ;
    skos:definition "The chromatographic bed used in thin-layer chromatography in which there is a gradual transition in some property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gradient layer" .

goldbook:G02672 a skos:Concept ;
    skos:definition "Stirred flow or recirculation reactors, characterized ideally by very small concentration and temperature gradients within the catalyst region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gradientless reactor" .

goldbook:G02674 a skos:Concept ;
    skos:definition "These terms relate to the steepness of the energy rise along the reaction path of a potential-energy surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gradual potential-energy surface" .

goldbook:G02675 a skos:Concept ;
    skos:definition "A copolymer that is a graft polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft copolymer" .

goldbook:G02678 a skos:Concept ;
    skos:definition "A macromolecule with one or more species of block connected to the main chain as side chains, these side chains having constitutional or configurational features that differ from those in the main chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft macromolecule" .

goldbook:G02679 a skos:Concept ;
    skos:definition "A polymer composed of graft macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graft polymer" .

goldbook:G02681 a skos:Concept ;
    skos:definition "A set of two stains that are used to stain (crystal violet and iodine) and counterstain (fuchsin) bacteria. gram-negative bacteria are completely decolorized after treating the stained bacteria with ethanol or acetone and can be visualized by the counterstain. They have a complex cell wall in which the peptidoglycan layer is covered by lipopolysaccharides in an outer membrane structure. gram-positive bacteria resist decolorization by ethanol or acetone, they retain the initial gram stain. They have a cell wall consisting predominantly of peptidoglycan not overlayed by an outer membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gram stain" .

goldbook:G02682 a skos:Concept ;
    skos:definition "The term granular carbon is equivalent to coarse particulate carbon. This is a carbon material consisting of separate particles or grains which are monolithic, on the average larger than about \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter, but smaller than about \\(1\\ \\rm{cm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "granular carbon" .

goldbook:G02683 a skos:Concept ;
    skos:definition "A single carbon layer of the graphite structure, describing its nature by analogy to a polycyclic aromatic hydrocarbon of quasi infinite size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphene layer" .

goldbook:G02684 a skos:Concept ;
    skos:definition "An allotropic form of the element carbon consisting of layers of hexagonally arranged carbon atoms in a planar condensed ring system graphene layers The layers are stacked parallel to each other in a three-dimensional crystalline long-range order. There are two allotropic forms with different stacking arrangements, hexagonal and rhombohedral. The chemical bonds within the layers are covalent with \\(\\rm{sp}^{2}\\) hybridization and with a C–C distance of \\(141.7\\ \\rm{pm}\\). The weak bonds between the layers are metallic with a strength comparable to van der Waals bonding only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphite" .

goldbook:G02686 a skos:Concept ;
    skos:definition "Carbon fibres consisting mostly of synthetic graphite for which three-dimensional crystalline order is confirmed by X-ray diffraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphite fibres" .

goldbook:G02687 a skos:Concept ;
    skos:definition "A material consisting essentially of graphitic carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphite material" .

goldbook:G02688 a skos:Concept ;
    skos:altLabel "carbon whiskers" ;
    skos:definition "Thin, approximately cylindrical filaments in which graphene layers are arranged in a scroll-like manner. There is, at least in part, a regular stacking of the layers as in the graphite lattice, giving rise to h,k,l, X-ray reflections. The physical properties of graphite whiskers approach, along the cylinder axis, those of graphite." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphite whiskers" .

goldbook:G02689 a skos:Concept ;
    skos:definition "All varieties of substances consisting of the element carbon in the allotropic form of graphite irrespective of the presence of structural defects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphitic carbon" .

goldbook:G02690 a skos:Concept ;
    skos:definition "A non-graphitic carbon which upon graphitization heat treatment converts into graphitic carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphitizable carbon" .

goldbook:G02691 a skos:Concept ;
    skos:definition "A solid-state transformation of thermodynamically unstable non-graphitic carbon into graphite by means of heat treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphitization" .

goldbook:G02692 a skos:Concept ;
    skos:definition "A process of heat treatment of a non-graphitic carbon industrially performed at temperatures in the range between \\(2500\\) and \\(3300\\ \\rm{K}\\), to achieve transformation into graphitic carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphitization heat treatment" .

goldbook:G02693 a skos:Concept ;
    skos:definition "A graphitic carbon with more or less perfect three-dimensional hexagonal crystalline order prepared from non-graphitic carbon by graphitization heat treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "graphitized carbon" .

goldbook:G02694 a skos:Concept ;
    skos:definition "A determination by weight; e.g. in the older method of $\\ce{Cl^{−}}$ ion determination, a weighed amount of sample is dissolved in water, $\\ce{AgNO3}$ solution added, $\\ce{AgCl}$ is precipitated, dried and weighed. From the known mass fraction of silver in $\\ce{AgCl}$, the weights of the initial sample and that of the $\\ce{AgCl}$ precipitated, the percentage of chlorine in the sample can be calculated readily." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gravimetric method" .

goldbook:G02695 a skos:Concept ;
    skos:definition "Universal fundamental physical constant in Newton's law of gravitation, \\(G = \\pu{6.67259(85)E-11 m3 kg-1 s-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gravitational constant" .

goldbook:G02696 a skos:Concept ;
    skos:definition "SI derived unit of energy imparted to an element of matter by ionizing radiation divided by the mass of that element (absorbed dose of radiation) equal to one joule per kilogram and admitted for reasons of safeguarding human health, \\(\\pu{Gy} = \\pu{J kg-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gray" .

goldbook:G02697 a skos:Concept ;
    skos:definition "Green coke (raw coke) is the primary solid carbonization product from high boiling hydrocarbon fractions obtained at temperatures below \\(900\\ \\rm{K}\\). It contains a fraction of matter that can be released as volatiles during subsequent heat treatment at temperatures up to approximately \\(1600\\ \\rm{K}\\). This mass fraction, the so-called volatile matter, is in the case of green coke between 4 and 15 wt.%, but it depends also on the heating rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "green coke" .

goldbook:G02698 a skos:Concept ;
    skos:definition "Heating effect produced by certain gases (e.g. $\\ce{CO2}$, $\\ce{O3}$, etc.), which by virtue of their characteristic infrared absorption, lower the earth to space transmission of long wavelength radiation but allow transmission of shorter wavelength radiation inward from the sun to the earth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "greenhouse effect" .

goldbook:G02699 a skos:Concept ;
    skos:definition "Organomagnesium halides, $\\ce{RMgX, having a carbon–magnesium bond (or their equilibrium mixtures in solution with $\\ce{R2Mg}$ + $\\ce{MgX}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Grignard reagents" .

goldbook:G02701 a skos:Concept ;
    skos:definition "Airborne solid particles in the atmosphere which are of natural or manmade origin and which remain in suspension for some time; in the United Kingdom the size of the grit particles is defined as greater than \\(75\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter (retained on a 200 mesh British Standard sieve)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grit" .

goldbook:G02702 a skos:Concept ;
    skos:definition "The concentration of a chemical species, normally a pollutant, in air; usually measured at a specific height above the ground." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ground level concentration" .

goldbook:G02703 a skos:Concept ;
    skos:definition "The inversion of the normal temperature gradient in the atmosphere; the temperature of the air increases with increasing height of the air above the ground. This leads to poor mixing of gases released below the inversion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ground level inversion" .

goldbook:G02704 a skos:Concept ;
    skos:definition "The state of lowest Gibbs energy of a system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ground state" .

goldbook:G02705 a skos:Concept ;
    skos:definition "A defined linked collection of atoms or a single atom within a molecular entity. This use of the term in physical organic and general chemistry is less restrictive than the definition adopted for the purpose of nomenclature of organic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "group" .

goldbook:G02706 a skos:Concept ;
    skos:definition "Synonymous with substituent electronegativity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "group electronegativity" .

goldbook:G02707 a skos:Concept ;
    skos:definition "An operation (process) as a result of which several microcomponents are isolated in one step. This may be achieved in one of two ways, by transportation either of the matrix or of the microcomponents into a second phase. The first method is widely used in the analysis of relatively simple substances and materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "group preconcentration" .

goldbook:G02708 a skos:Concept ;
    skos:definition "Curve giving the activity of a radioactive nuclide as a function of time and showing the increase of the activity through the decay of the precursor or as a result of activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth curve" .

goldbook:G02709 a skos:Concept ;
    skos:definition "The measure (\\(\\rm{h}^{-1}\\),\\(\\rm{d}^{-1}\\)) of the rate of growth or multiplication of an organism or a culture, usually expressed as specific growth rate (the increase of mass or cell number per time unit referred to the unit of mass, \\(\\frac{\\rm{d}(\\ln X)}{\\rm{d}t}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "growth rate" .

goldbook:G02710 a skos:Concept ;
    skos:definition "The linear free energy relation: \\[\\log _{10}(\\frac{k_{\\rm{s}}}{k_{0}}) = m\\ Y\\] expressing the dependence of the rate of solvolysis of a substrate on ionizing power of the solvent. The rate constant \\(k_{0}\\) applies to the reference solvent (ethanol–water, 80:20, v/v) and \\(k_{\\rm{s}}\\) to the solvent s, both at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\). The parameter \\(m\\) is characteristic of the substrate and is assigned the value unity for tert-butyl chloride. The value \\(Y\\) is intended to be a quantitative measure of the ionizing power of the solvents. The equation was later extended to the form: \\[\\log _{10}(\\frac{k_{\\rm{s}}}{k_{0}}) = m\\ Y+l\\ N\\] where \\(N\\) is the nucleophilicity of the solvent and \\(l\\) its susceptibility parameter. The equation has also been applied to reactions other than solvolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Grunwald–Winstein equation" .

goldbook:G02711 a skos:Concept ;
    skos:definition "An organic or inorganic ion or molecule that occupies a cavity, cleft or pocket within the molecular structure of a host molecular entity and forms a complex with it or that is trapped in a cavity within the crystal structure of a host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "guest" .

goldbook:G02713 a skos:Concept ;
    skos:definition "Intensity of turbulence; the ratio of the root mean square of wind velocity fluctuations to the mean wind velocity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gustiness" .

goldbook:GT06826 a skos:Concept ;
    skos:definition "Science of using DNA- and RNA-based technologies to demonstrate alterations in gene expression.Method providing information on the consequences for gene expression of interactions of the organism with environmental stress, xenobiotics, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genomics" .

goldbook:GT06961 a skos:Concept ;
    skos:definition "A genetic algorithm is an optimization algorithm based on the mechanisms of Darwinian evolution which uses random mutation, crossover and selection procedures to breed better models or solutions from an originally random starting population or sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "genetic algorithm" .

goldbook:GT07138 a skos:Concept ;
    skos:definition "Reaction in which one or more species of block are connected to the main chain of a macromolecule as side-chains having constitutional or configurational features that differ from those in the main chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "grafting" .

goldbook:GT07386 a skos:Concept ;
    skos:definition "Special form of photochromism in which one or both forms of a photochromic system are transformed reversibly, either chemically or electrochemically, into a non-photochromic form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gated photochromism" .

goldbook:GT07387 a skos:Concept ;
    skos:definition "Ion pair formed from a precursor that constitutes a single kinetic entity, i.e., by electron transfer or ion transfer in an encounter complex (cf. collision complex) or by ionic dissociation of a single molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "geminate ion pair" .

goldbook:GT07388 a skos:Concept ;
    skos:definition "For photoinduced electron transfer between an acceptor (\\(\\rm{A}\\)) and a donor (\\(\\rm{D}\\)) (either one of them may be the electronically excited molecular entity) of any charge type, \\(z(\\rm{A})\\) and \\(z(\\rm{D})\\), the change in standard Gibbs energy can be approximated as (the notation is for the case of neutral species \\(\\rm{D}\\) and \\(\\rm{A}\\)) \\[\\Delta _{\\rm{ET}}G^{\\rm{o}} = N_{\\rm{A}}\\left \\{e\\, [E^{\\rm{o}}(\\rm{D}^{+\\bullet }/\\rm{D})- E^{\\rm{o}}(\\rm{A}/\\rm{A}^{-\\bullet }) ]+w(\\rm{D}^{+\\bullet }\\rm{A}^{-\\bullet })-w(\\rm{DA})\\right \\} - \\Delta E_{0,0}\\] where \\(e = 1.602\\ 176\\ 487 \\times 10^{-19}\\, \\rm{C}\\) is the elementary charge, \\(N_{\\rm{A}} = \\pu{6.02214076E23 mol-1}\\) is the Avogadro constant, \\(E^{\\rm{o}}(\\rm{D}^{+\\bullet}/\\rm{D})/\\rm{V}\\) is the standard electrode potential of the donor cation radical resulting from the electron transfer, \\(E^{\\rm{o}}(\\rm{A}/\\rm{A}^{-\\bullet})/\\rm{V}\\) is the standard electrode potential of the acceptor (both relative to the same reference electrode) and \\(\\Delta E_{0,0}/\\pu{J mol-1}\\) is the vibrational zero electronic energy of the excited partner (provided that a vibrationally equilibrated excited state at energy \\(E_{0,0}\\) takes part in the reaction), all data referring to the same solvent. \\(w(\\rm{D}^{+\\bullet }\\rm{A}^{-\\bullet })\\) and \\(w(\\rm{DA})\\) are the electrostatic work terms that account for the effect of Coulombic attraction in the products and reactants, respectively \\[w(\\rm{D}^{+\\bullet }\\rm{A}^{-\\bullet })/J=\\frac{z(\\rm{D}^{+\\bullet })z(\\rm{A}^{-\\bullet })e^{2}}{4\\pi \\epsilon _{0}\\epsilon _{r}a}\\] \\[w(\\rm{DA})/J =\\frac{z(\\rm{D})z(\\rm{A})e^{2}}{4\\pi \\epsilon _{0}\\epsilon _{r}a}\\] where \\(a\\) is the distance of the charged species after electron transfer, \\(\\varepsilon_{r}\\) is the relative medium static permittivity (formerly called dielectric constant), \\(\\varepsilon_{0} \\approx 8.854 \\times 10^{-12}\\ \\rm{C}^{2}\\ \\rm{J}^{-1}\\ \\rm{m}^{-1}\\) is the electric constant (vacuum permittivity), and \\(z(\\rm{X})\\) the charge of the species \\(X\\).  In SI units the factor \\(\\frac{e^{2}}{4\\pi\\varepsilon _{0}} = 2.307 \\times 10^{-28}\\ \\rm{J m}\\). For the case of neutral species \\(\\rm{A}\\) and \\(\\rm{D}\\), \\(z(\\rm{D})=z(\\rm{A})=0\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Gibbs energy of photoinduced electron transfer" .

goldbook:GT07389 a skos:Concept ;
    skos:definition "Method for kinetic analysis of time-resolved emission or absorption data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "global analysis" .

goldbook:GT07535 a skos:Concept ;
    skos:altLabel "gelation point" ;
    skos:definition "Point of incipient network formation in a process forming a chemical or physical polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel point" .

goldbook:GT07536 a skos:Concept ;
    skos:altLabel "gelation time" ;
    skos:definition "Time interval from the start of a network-forming process to the gel point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel time" .

goldbook:GT07537 a skos:Concept ;
    skos:altLabel "gel temperature" ;
    skos:definition "Temperature threshold for the formation of a thermoreversible gel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gelation temperature" .

goldbook:GT07551 a skos:Concept ;
    skos:definition "Mass fraction of the network material resulting from a network-forming polymerization or crosslinking process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel fraction" .

goldbook:GT07552 a skos:Concept ;
    skos:definition "Object formed from a preceramic material prior to pyrolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "green body" .

goldbook:GT07553 a skos:Concept ;
    skos:definition "Material composed of an intimate mixture of inorganic components, organic components, or both types of component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid material" .

goldbook:GT07620 a skos:Concept ;
    skos:definition "Time-dependent changes in the chemical or the physical structure and the properties of a gel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gel aging" .

goldbook:GT07621 a skos:Concept ;
    skos:definition "Process of passing through the gel point to form a gel or network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "gelation" .

goldbook:H01881 a skos:Concept ;
    skos:altLabel "eta",
        "hapto" ;
    skos:definition "An affix giving a topological indication of the bonding between a $\\ce{\\uppi\\!\\mbox{-}electron}$ ligand and the central atom in a coordination entity. A right superscript numerical index indicates the number of ligating atoms in the $\\ce{\\uppi\\!\\mbox{-}electron}$ system of the ligand which bind to the central atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "η" .

goldbook:H02714 a skos:Concept ;
    skos:definition "An alternative spelling for heme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haem" .

goldbook:H02715 a skos:Concept ;
    skos:definition "The conformation of a six-membered ring structure in which four contiguous atoms are in a plane and the other two atoms lie on opposite sides of the plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-chair" .

goldbook:H02716 a skos:Concept ;
    skos:definition "For a given reaction the half life \\(t_{1/2}\\) of a reactant is the time required for its concentration to reach a value that is the arithmetic mean of its initial and final (equilibrium) values. For a reactant that is entirely consumed it is the time taken for the reactant concentration to fall to one half its initial value: The half life of a reaction has meaning only in special cases:  For a first-order reaction, the half life of the reactant may be called the half life of the reaction.  For a reaction involving more than one reactant, with the concentrations of the reactants in their stoichiometric ratios, the half life of each reactant is the same, and may be called the half life of the reaction.   If the concentrations of reactants are not in their stoichiometric ratios, there are different half lives for different reactants, and one cannot speak of the half life of the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half life" .

goldbook:H02717 a skos:Concept ;
    skos:altLabel "radioactive half life" ;
    skos:definition "For a single radioactive decay process, the time required for the activity to decrease to half its value by that process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half life" .

goldbook:H02720 a skos:Concept ;
    skos:definition "In linear-sweep voltammetry, triangular-wave voltammetry, cyclic triangular-wave voltammetry, and similar techniques, the potential of the indicator electrode at which the difference between the total current and the residual current is equal to one-half of the peak current. This potential is attained in the interval in which the rate of the charge-transfer process, and hence the (absolute value of the) current, increase monotonically with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-peak potential" .

goldbook:H02721 a skos:Concept ;
    skos:definition "The thickness of a specified substance which, when introduced into the path of a given beam of radiation, reduces the value of a specified radiation quantity by one half." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half thickness" .

goldbook:H02722 a skos:Concept ;
    skos:definition "The potential of a polarographic or voltammetric indicator electrode at the point, on the rising part of a polarographic or voltammetric wave, where the difference between the total current and the residual current is equal to one-half of the limiting current. The quarter-wave potential, the three-quarter-wave potential, etc., may be similarly defined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-wave potential" .

goldbook:H02723 a skos:Concept ;
    skos:altLabel "FWHM",
        "full width at half maximum" ;
    skos:definition "The full width of a spectral band at a height equal to half of the height at the band maximum. Also known as full width at half maximum (FWHM). The dimension of band width should be either inverse length (wavenumbers) or inverse time (frequencies) so that the values give an indication of the energies. Note the hyphen in half-width. Half bandwidth has the meaning of half-width at half maximum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-width" .

goldbook:H02724 a skos:Concept ;
    skos:definition "Cyclic cations having the structure:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halirenium ions" .

goldbook:H02725 a skos:Concept ;
    skos:definition "The colour change which occurs on addition of acid (or base, or a salt) to a solution of a compound. A chemical reaction (e.g. ion formation) transforms a colourless compound into a coloured one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halochromism" .

goldbook:H02726 a skos:Concept ;
    skos:definition "Trihalomethanes $\\ce{CHX3}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haloforms" .

goldbook:H02727 a skos:Concept ;
    skos:definition "A traditional term for alcohols substituted by a halogen atom at a saturated carbon atom otherwise bearing only hydrogen or hydrocarbyl groups (usually used to mean $\\ce{\\upbeta\\!\\mbox{-}halo alcohols}$). E.g. $\\ce{BrCH2CH2OH}$ 'ethylene bromohydrin' (2-bromoethanol), $\\ce{ClCH2CH2CH2OH}$ 'trimethylene chlorohydrin' (3-chloro-propan-1-ol), $\\ce{PhCH(OH)CH2Cl}$ 'styrene chlorohydrin' (2-chloro-1-phenylethanol)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halohydrins" .

goldbook:H02728 a skos:Concept ;
    skos:definition "Ions of the form $\\ce{R2X^{+}}$, where $\\ce{X}$ is any halogen ($\\ce{X} = \\ce{Br^{+}}$, bromonium ions; $\\ce{X} = \\ce{Cl^{+}}$, chloronium ions; $\\ce{X} = \\ce{F^{+}}$, fluoronium ions; $\\ce{X} = \\ce{I^{+}}$, iodonium ions). They may be open-chain or cyclic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halonium ions" .

goldbook:H02729 a skos:Concept ;
    skos:definition "Organisms which require a minimum concentration of sodium chloride in their environment (cf. extremophiles)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halophiles" .

goldbook:H02732 a skos:Concept ;
    skos:altLabel "Hammett relation",
        "ρσ-equation" ;
    skos:definition "The equation in the form: \\[\\log _{10}(\\frac{k}{k_{0}}) = \\rho \\ \\sigma \\] or \\[\\log _{10}(\\frac{K}{K_{0}}) = \\rho \\ \\sigma \\] applied to the influence of meta- or para-substituents $\\ce{X}$ on the reactivity of the functional group $\\ce{Y}$ in the benzene derivative m- or $\\ce{p-XC6H4Y}$. \\(k\\) or \\(K\\) is the rate or equilibrium constant, respectively, for the given reaction of m- or $\\ce{p-XC6H4Y}$; \\(k_{0}\\) or \\(K_{0}\\) refers to the reaction of $\\ce{C6H5Y}$, i.e. $\\ce{X} = \\ce{H}$; is the substituent constant characteristic of m- or $\\ce{p-X}$: is the reaction constant characteristic of the given reaction of $\\ce{Y}$. The equation is often encountered in a form with \\(\\log _{10}k_{0}\\) or \\(\\log _{10}K_{0}\\) written as a separate term on the right hand side, e.g. \\[\\log _{10}k = \\rho \\ \\sigma +\\log _{10}k_{0}\\] or \\[\\log _{10}K = \\rho \\ \\sigma +\\log _{10}K_{0}\\] It then signifies the intercept corresponding to $\\ce{X} = \\ce{H}$ in a regression of \\(\\log _{10}k\\) or \\(\\log _{10}K\\) on \\(\\sigma \\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hammett equation" .

goldbook:H02734 a skos:Concept ;
    skos:altLabel "Hammond postulate",
        "Leffler's assumption" ;
    skos:definition "The hypothesis that, when a transition state leading to an unstable reaction intermediate (or product) has nearly the same energy as that intermediate, the two are interconverted with only a small reorganization of molecular structure. Essentially the same idea is sometimes referred to as 'Leffler's assumption', namely, that the transition state bears the greater resemblance to the less stable species (reactant or reaction intermediate/product). Many text books and physical organic chemists, however, express the idea in Leffler's form, but attribute it to Hammond. As a corollary, it follows that a factor stabilizing a reaction intermediate will also stabilize the transition state leading to that intermediate. The acronym 'Bemahapothle' (Bell, Marcus, Hammond, Polanyi, Thornton, Leffler) is sometimes used in recognition of the principal contributors towards expansion of the original idea of the Hammond postulate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hammond principle" .

goldbook:H02735 a skos:Concept ;
    skos:definition "This term has been used in two ways, either chirality or chirality sense" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "handedness" .

goldbook:H02736 a skos:Concept ;
    skos:definition "A measure of the capability of a solute for hydrophobic lipophilic interaction based on the partition coefficient \\(P\\) for distribution of the solute between octan-1-ol and water. The most general way of applying \\(P\\) in correlation analysis, QSAR, etc. is as log \\(P\\), but the behaviour of substituted benzene derivatives may be quantified by a substituent constant scale, \\(\\pi \\), which is defined in a way analogous to the Hammett $\\ce{\\upsigma\\!}$ scale. There are various scales, depending on the substrate series used as reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hansch constant" .

goldbook:H02737 a skos:Concept ;
    skos:definition "A name for a heteromonocyclic parent hydride having no more than ten ring members formed by the citation of 'a' prefixes denoting the heteroatoms followed by an ending (the 'stem') defining the size of the ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hantzsch–Widman name" .

goldbook:H02738 a skos:Concept ;
    skos:definition "A low-molecular weight molecule which contains an antigenic determinant but which is not itself antigenic unless complexed with an antigenic carrier. Examples of haptens are dinitrophenols, phosphorylcholine and dextran." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hapten" .

goldbook:H02740 a skos:Concept ;
    skos:definition "A Lewis acid with an acceptor centre of low polarizability. Other things being approximately equal, complexes of hard acids and bases or soft acids and bases have an added stabilization (sometimes called 'HSAB' rule). For example the hard O- (or N-) bases are preferred to their S- (or P-) analogues by hard acids. Conversely a soft acid possesses an acceptor centre of high polarizability and exhibits the reverse preference for coordination of a soft base. These preferences are not defined in a quantitative sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard acid" .

goldbook:H02741 a skos:Concept ;
    skos:definition "A synonym for diamond-like carbon films" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard amorphous carbon films" .

goldbook:H02742 a skos:Concept ;
    skos:definition "A Lewis base with a donor centre (e.g. an oxygen atom) of low polarizability the converse applies to soft bases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard base" .

goldbook:H02744 a skos:Concept ;
    skos:definition "Production of coherent radiation of frequency \\(k\\  u \\) (\\(k=2,3,...\\)) from coherent radiation of frequency. In general, this effect is obtained through the interaction of laser light with a suitable optical medium with non-linear polarizability. The case \\(k=2\\) is referred to as frequency doubling, \\(k=3\\) is frequency tripling and \\(k=4\\) is frequency quadrupling. Even higher integer values of \\(k\\) are possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harmonic frequency generation" .

goldbook:H02745 a skos:Concept ;
    skos:definition "The number of observations, divided by the sum of reciprocals of the observations. Symbol: \\(\\bar{x}_{\\rm{h}}\\). It can be calculated with the formula: \\[\\bar{x}_{\\rm{h}} = \\frac{n}{\\sum x_{j}^{-1}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harmonic mean" .

goldbook:H02746 a skos:Concept ;
    skos:definition "Reaction sequence (thermal or photoinduced) between neutral molecular or atomic entities in which long-range electron transfer is followed by a considerable reduction of the distance between donor and acceptor sites as a result of the electrostatic attraction in the ion pair created." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harpoon mechanism" .

goldbook:H02748 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant used as atomic unit of energy: \\(E_{\\rm{h}}=\\frac{\\mathrm{\\hslash }^{2}}{m_{\\rm{e}}\\ a_{0}^{2}} = 4.359\\ 7482(26)\\times 10^{-18}\\ \\rm{J}\\), where \\(\\mathrm{\\hslash}\\) is the Planck constant divided by \\(2\\ \\pi \\), \\(m_{\\rm{e}}\\) the electron rest mass and \\(a_{0}\\) the Bohr radius." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hartree energy" .

goldbook:H02750 a skos:Concept ;
    skos:definition "A state of reduced visibility (\\(1{-}2\\ \\rm{km}\\)) resulting from the increased light scatter due to the presence of fine dust or aerosol particles ($\\ce{H2SO4}$, $\\ce{NH4HSO4}$, products of the ozone-terpene reactions, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haze" .

goldbook:H02751 a skos:Concept ;
    skos:definition "The top of a haze layer which is confined by a low-level temperature inversion so that it gives the appearance of the horizon which it may obscure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "haze horizon" .

goldbook:H02753 a skos:Concept ;
    skos:definition "Heat brought to a system to increase its temperature divided by that temperature increase. At constant volume \\(C_{V}=(\\frac{\\partial U}{\\partial T})_{V}\\) at constant pressure \\(C_{p}=(\\frac{\\partial H}{\\partial T})_{p}\\), where \\(U\\) is the internal energy and \\(H\\) the enthalpy of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heat capacity" .

goldbook:H02754 a skos:Concept ;
    skos:definition "A quantity related to the temperature coefficient of \\(\\Delta ^{\\ddagger}H\\) (enthalpy of activation) and \\(\\Delta ^{\\ddagger}S\\) (entropy of activation) according to the equations: \\[\\Delta ^{\\ddagger}C_{p} = (\\frac{\\partial \\Delta ^{\\ddagger }H}{\\partial T})_{p}=T\\ (\\frac{\\partial \\Delta ^{\\ddagger }S}{\\partial T})_{p}\\] If the rate constant is expressible in the form \\[\\ln k = \\frac{a}{T}+b+c\\ \\ln T + \\rm{d}T,\\] then: \\[\\Delta ^{\\ddagger}C_{p} = (c - 1)\\ R+2\\ \\rm{d}(R\\ T)\\] SI unit: \\(\\pu{J mol-1 K-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heat capacity of activation" .

goldbook:H02756 a skos:Concept ;
    skos:altLabel "external heavy atom effect" ;
    skos:definition "The enhancement of the rate of a spin-forbidden process by the presence of an atom of high atomic number, which is either part of, or external to, the excited molecular entity. Mechanistically, it responds to a spin–orbit coupling enhancement produced by a heavy atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heavy atom effect" .

goldbook:H02757 a skos:Concept ;
    skos:definition "An isotope effect due to isotopes other than those of hydrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heavy atom isotope effect" .

goldbook:H02758 a skos:Concept ;
    skos:definition "Water containing a significant fraction (up to 100 per cent) of deuterium in the form of $\\ce{D2O}$ or $\\ce{HDO}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heavy water" .

goldbook:H02762 a skos:Concept ;
    skos:definition "ortho-Fused polycyclic aromatic or heteroaromatic compounds in which all rings (minimum five) are angularly arranged so as to give helically shaped molecules, which are thus chiral, e.g. hexahelicene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helicenes" .

goldbook:H02763 a skos:Concept ;
    skos:definition "The chirality of a helical, propeller or screw-shaped molecular entity. A right-handed helix is described as P (or plus), a left-handed one as M (or minus).    The application of this system to the description of conformations considers the torsion angle between two specified (fiducial) groups that are attached to the atoms linked by that bond. The sign of the smaller torsion angle between the fiducial groups defines the chirality sense of the helix. Rules for the selection of fiducial groups according to priority are given by R.S. Cahn, C.K. Ingold and V. Prelog, Angew. Chem. 78, 413-447 (1966), Angew. Chem. Internat. Ed. Eng. 5, 385-415, 511 (1966)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helicity" .

goldbook:H02765 a skos:Concept ;
    skos:altLabel "cadium–helium laser" ;
    skos:definition "A continuous wave laser emitting mainly at \\(325.0\\) and \\(441.6\\ \\rm{nm}\\) from singly ionized cadmium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helium–cadmium laser" .

goldbook:H02766 a skos:Concept ;
    skos:definition "The position of the Gibbs surface is often defined experimentally as that surface which encloses the volume of space from which the solid excludes helium gas (the so-called helium dead-space), and is associated with the assumptions that the volume of the solid is unaffected by the adsorption of component i, and that helium is not adsorbed by the solid. This requires that the measurement of the helium dead-space be made at a sufficiently high temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helium dead-space" .

goldbook:H02767 a skos:Concept ;
    skos:definition "A weak beta source and a high potential raise the helium atom of the carrier gas to a metastable state. All other substances having an ionization potential lower than \\(18\\ \\rm{eV}\\) are ionized, and the current that results is used to measure the components. The detector is usually employed to measure inorganic compounds at concentrations between \\(0.1\\) and \\(10\\ \\rm{ppmv}\\). It has a linear range of about \\(10^{2}\\) but is somewhat unstable and requires great care to ensure the helium purity and to eliminate all leaks in the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helium ionization detector" .

goldbook:H02768 a skos:Concept ;
    skos:definition "A continuous wave laser emitting mainly at \\(632.8\\ \\rm{nm}\\), \\(1152.3\\ \\rm{nm}\\), and \\(3391.3\\ \\rm{nm}\\) from excited neutral $\\ce{Ne}$ atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "helium–neon laser" .

goldbook:H02773 a skos:Concept ;
    skos:altLabel "heme derivatives" ;
    skos:definition "Complexes consisting of an iron ion coordinated to a porphyrin acting as a tetradentate ligand, and to one or two axial ligands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemes" .

goldbook:H02774 a skos:Concept ;
    skos:definition "Compounds having the general formula $\\ce{R2C(OH)OR'}$ ($\\ce{R'}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemiacetals" .

goldbook:H02775 a skos:Concept ;
    skos:definition "$\\ce{\\upalpha\\!\\mbox{-}Amino}$ alcohols, improperly called carbinolamines (the adducts of ammonia, or of primary or secondary amines to the carbonyl group of aldehydes and ketones) $\\ce{R2C(OH)NR2}$. Compounds of structure $\\ce{R2C(OR')NR2}$ ($\\ce{R}  eq \\ce{H}$) are hemiaminal ethers, or $\\ce{\\upalpha\\!\\mbox{-}amino}$ ethers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemiaminals" .

goldbook:H02776 a skos:Concept ;
    skos:definition "Hemiacetals having the structure $\\ce{R2C(OH)OR}$ ($\\ce{R}  eq \\ce{H}$), derived from ketones by formal addition of an alcohol to the carbonyl group. This term, once abandoned, has been reinstated as a subclass of hemiacetals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemiketals" .

goldbook:H02778 a skos:Concept ;
    skos:definition "Chloro(porphyrinato)iron(III) complexes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemins" .

goldbook:H02779 a skos:Concept ;
    skos:definition "Iron–porphyrin complexes, having one or two basic ligands (e.g. piperidine, amines)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemochromes" .

goldbook:H02780 a skos:Concept ;
    skos:definition "Heme derivatives having a protein chain as axial ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemoglobins" .

goldbook:H02781 a skos:Concept ;
    skos:definition "An equation of the form: \\[\\rm{pH} = \\rm{p}K_{\\rm{a}}- \\log _{10}(\\frac{\\left[\\rm{HA}\\right]}{\\left[\\rm{A}^{-}\\right]})\\] for the calculation of the \\(\\rm{pH}\\) of solutions where the ratio \\(\\frac{\\left[\\rm{HA}\\right]}{\\left[\\rm{A}^{-}\\right]}\\) is known." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henderson–Hasselbalch equation" .

goldbook:H02783 a skos:Concept ;
    skos:definition "The partial pressure (fugacity) of a solute (B) in a solution is directly proportional to the rational chemical activity (\\(a_{x}\\)) of the solute; this relationship is called Henry's law: \\[p_{\\rm{B}}=\\frac{a_{x,\\rm{B}}}{\\alpha _{x,\\rm{B}}^{\\infty }}\\] where \\(\\alpha _{x,\\rm{B}}^{\\infty }\\) is the rational solubility coefficient for infinite dilution, i.e. for pure solvent. For the solvent (A) the relationship is called Raoult's law, and the proportionality factor is the fugacity of the pure solvent, \\(\\overset{˜}{p}_{\\rm{A}}^{\\ast }\\): \\[p_{\\rm{A}}=\\overset{˜}{p}_{\\rm{A}}^{\\ast }\\ a_{\\rm{A}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Henry's law" .

goldbook:H02785 a skos:Concept ;
    skos:altLabel "cycles per second" ;
    skos:definition "SI derived unit of frequency equal to one cycle per second, \\(\\rm{Hz} = \\rm{s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hertz" .

goldbook:H02786 a skos:Concept ;
    skos:definition "1,2$\\uplambda\\!$4,3-Benzodithiazolium chlorides (formed in the reaction of aniline and derivatives thereof with disulfur dichloride)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Herz compounds" .

goldbook:H02787 a skos:Concept ;
    skos:definition "Synonymous with heteroarenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hetarenes" .

goldbook:H02788 a skos:Concept ;
    skos:definition "Synonymous with heteroaryl groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hetaryl groups" .

goldbook:H02789 a skos:Concept ;
    skos:definition "Synonymous with heteroarynes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hetarynes" .

goldbook:H02790 a skos:Concept ;
    skos:definition "Analogues of alkenes in which a doubly bonded carbon atom is replaced by a heteroatom, e.g. $\\ce{H2Si=CH2}$ methylidenesilane (silene less preferred), $\\ce{MeN=CH2}$ N-methylmethanimine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroalkenes" .

goldbook:H02791 a skos:Concept ;
    skos:definition "Heterocyclic compounds formally derived from arenes by replacement of one or more methine ($\\ce{–C=}$) and/or vinylene ($\\ce{–CH=CH\\bond{–}}$) groups by trivalent or divalent heteroatoms, respectively, in such a way as to maintain the continuous $\\ce{\\uppi\\!\\mbox{-}electron}$ system characteristic of aromatic systems and a number of out-of-plane $\\ce{\\uppi\\!\\mbox{-}electrons}$ corresponding to the Hückel rule (\\(4\\ n+2\\)); an alternative term is hetarenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroarenes" .

goldbook:H02792 a skos:Concept ;
    skos:definition "The class of heterocyclyl groups derived from heteroarenes by removal of a hydrogen atom from any ring atom; an alternative term is hetaryl. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroaryl groups" .

goldbook:H02793 a skos:Concept ;
    skos:definition "Compounds derived from heteroarenes by replacement of a formal carbon-carbon double bond by a formal triple bond (with loss of two hydrogen atoms). Also known as hetarynes and as 1,2-didehydroheteroarenes. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroarynes" .

goldbook:H02794 a skos:Concept ;
    skos:definition "A metal complex having two different metal atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterobimetallic complex" .

goldbook:H02796 a skos:Concept ;
    skos:definition "[obsolete] Association between a base and the conjugate acid of a different base through a hydrogen bond ($\\ce{B'\\bond{...}HB^{+}}$ or $\\ce{A'H\\bond{...}A^{-}}$). The term has its origin in the conjugate acid–base pair and is in no way related to conjugated systems of orbitals. Heteroassociation is a more appropriate term. [obsolete] Some authors refer to conjugated systems containing a heteroatom, e.g. pyridine, as 'heteroconjugated systems'. This usage is discouraged since it inappropriately suggests an analogy to homoconjugation, and conflicts with the currently accepted definition of that term." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroconjugation" .

goldbook:H02797 a skos:Concept ;
    skos:definition "Cumulenes in which one or more carbon atoms of the cumulative bond system have been replaced by heteroatoms. E.g. $\\ce{O=C=C=C=O}$, but not $\\ce{CH2=C=O}$, ketene, nor $\\ce{O=C=O}$, carbon dioxide, which are heteroallenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterocumulenes" .

goldbook:H02798 a skos:Concept ;
    skos:definition "Cyclic compounds having as ring members atoms of at least two different elements, e.g. quinoline, 1,2-thiazole, bicyclo[3.3.1]tetrasiloxane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterocyclic compounds" .

goldbook:H02799 a skos:Concept ;
    skos:definition "Univalent groups formed by removing a hydrogen atom from any ring atom of a heterocyclic compound. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterocyclyl groups" .

goldbook:H02801 a skos:Concept ;
    skos:definition "Describes a colloidal system in which all the particles are of different sizes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterodisperse" .

goldbook:H02802 a skos:Concept ;
    skos:definition "Synonymous with exciplex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroexcimer" .

goldbook:H02805 a skos:Concept ;
    skos:definition "Defined by the equation: \\[k_{\\rm{d}}=\\frac{I_{\\rm{l}}}{n\\ F\\ c\\ A}\\] where the limiting current \\(I_{\\rm{l}}\\) is assumed to be due to the diffusion species of concentration \\(c\\) and of diffusion coefficient \\(D\\). \\(n\\) is the charge number of the cell reaction written so that the stoichiometric coefficient of this species is unity. \\(A\\) is usually taken as the geometric area of the electrode, and \\(F\\) is the Faraday constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterogeneous diffusion rate constant" .

goldbook:H02808 a skos:Concept ;
    skos:definition "Transition metal or Main Group compounds having more than one type of ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heteroleptic" .

goldbook:H02809 a skos:Concept ;
    skos:altLabel "heterolytic" ;
    skos:definition "The cleavage of a covalent bond so that both bonding electrons remain with one of the two fragments between which the bond is broken, e.g.  Heterolytic bond fission is a feature of many bimolecular reactions in solution (e.g.electrophilic substitution, nucleophilic substitution)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterolysis" .

goldbook:H02810 a skos:Concept ;
    skos:definition "The energy required to break a given bond of some specific compound by heterolysis. For the dissociation of a neutral molecule $\\ce{AB}$ in the gas phase into $\\ce{A^{+}}$ and $\\ce{B^{−}}$ the heterolytic bond-dissociation energy $D(\\ce{A^{+}B^{−}})$ is the sum of the bond dissociation energy, $D(\\ce{A–B})$, and the adiabatic ionization energy of the radical $\\ce{A^{.}}$; minus the electron affinity of the radical $\\ce{B^{.}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterolytic bond-dissociation energy" .

goldbook:H02811 a skos:Concept ;
    skos:definition "Relates in the usual sense to the formal nature of the cleavage of a single bond. If in the bond of the adsorptive $\\ce{A:B}$, $\\ce{A}$ or $\\ce{B}$ retains the electron pair, the adsorption is heterolytic dissociative adsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterolytic dissociative adsorption" .

goldbook:H02816 a skos:Concept ;
    skos:altLabel "heterotrophic organisms" ;
    skos:definition "Descriptive of organisms which are not able to synthesize cell components from carbon dioxide as sole carbon source. Heterotrophic organisms use preformed oxidizable organic substrates such as glucose as carbon and energy sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heterotrophic" .

goldbook:H02818 a skos:Concept ;
    skos:definition "The thermodynamically stable form of graphite with an ABAB stacking sequence of the graphene layers. The exact crystallographic description of this allotropic form is given by the space group \\(d_{6h}^{4} - P6_{3}/\\rm{mmc}\\) (unit cell constants: \\(a=245.6\\ \\mathrm{pm}\\), \\(c=670.8\\ \\mathrm{pm}\\)). Hexagonal graphite is thermodynamically stable below approximately \\(2600\\ \\rm{K}\\) and \\(6\\ \\rm{GPa}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hexagonal graphite" .

goldbook:H02819 a skos:Concept ;
    skos:definition "An affix used in names to denote eight atoms bound into a hexahedron (e.g. cube)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>hexahedro</i>-" .

goldbook:H02820 a skos:Concept ;
    skos:definition "An affix used in names to denote twelve atoms bound into a hexagonal prism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>hexaprismo</em>-" .

goldbook:H02822 a skos:Concept ;
    skos:altLabel "smooth transition" ;
    skos:definition "A general term used to describe a transition in which the first and second derivatives of the molar Gibbs energy or molar Helmholtz energy (or chemical potential) with respect to temperature and pressure are continuous, but derivatives of some higher order are discontinuous at the transition point. Synonymous with smooth transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "higher-order transition" .

goldbook:H02823 a skos:Concept ;
    skos:altLabel "HOPG" ;
    skos:definition "Highly oriented pyrolytic graphite (HOPG) is a pyrolytic graphite with an angular spread of the c-axes of the crystallites of less than 1 degree." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "highly oriented pyrolytic graphite" .

goldbook:H02824 a skos:Concept ;
    skos:definition "A term which refers to the solid-state transformation of non-graphitic carbon into graphite by heat treatment under elevated pressure (e.g. \\(100\\) to \\(1000\\ \\rm{MPa}\\)) so that a definitely higher degree of graphitization is achieved at lower temperature and/or for a shorter heat treatment time than in heat treatment of the same non-graphitic material at atmospheric pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-pressure graphitization" .

goldbook:H02825 a skos:Concept ;
    skos:altLabel "high-pressure mercury arc",
        "hot quartz lamp" ;
    skos:definition "Radiation source containing mercury at a pressure of ca. \\(8\\ \\rm{MPa}\\) (ca. \\(80\\ \\rm{bar}\\)) or higher which emits lines over a background continuum between about \\(200\\) and \\(1400\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "high-pressure mercury lamp" .

goldbook:H02827 a skos:Concept ;
    skos:definition "A parameter measuring the cohesion of a solvent (energy required to create a cavity in the solvent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hildebrand parameter" .

goldbook:H02829 a skos:Concept ;
    skos:definition "A class of basic proteins associated with DNA in the chromosomes of eukaryotic cells forming the nucleosome as the basic subunit of chromatin. They contain an unusually large proportion of the basic amino acids arginine and lysine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "histones" .

goldbook:H02830 a skos:Concept ;
    skos:definition "'The principal olefin formed in the decomposition of quaternary ammonium hydroxides that contain different primary alkyl groups is always ethylene, if an ethyl group is present.' Originally given in this limited form by A. W. Hofmann, the rule has since been extended and modified as follows: 'When two or more alkenes can be produced in a $\\upbeta\\!$-elimination reaction, the alkene having the smallest number of alkyl groups attached to the double bond carbon atoms will be the predominant product.' This orientation described by the Hofmann rule is observed in elimination reactions of quaternary ammonium salts and tertiary sulfonium salts, and in certain other cases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hofmann rule" .

goldbook:H02831 a skos:Concept ;
    skos:definition "A carrier used to prevent a particular species from following other species in a chemical or physical operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hold-back carrier" .

goldbook:H02833 a skos:Concept ;
    skos:altLabel "hold-up time" ;
    skos:definition "The volume of the mobile phase (or the corresponding time) required to elute a component the concentration of which in the stationary phase is negligible compared to that in the mobile phase. In other words, this component is not retained at all by the stationary phase. Thus, the hold-up volume (time) is equal to the retention volume (time) of an unretained compound. The hold-up volume (time) includes any volumes contributed by the sample injector, the detector, and connectors. \\[t_{\\rm{M}}=\\frac{V_{\\rm{M}}}{F_{\\rm{c}}}\\] In gas chromatography this term is also called the gas hold-up volume (time). The corrected gas hold-up volume (\\(V_{\\rm{M}}^{\\rm{o}}\\)) is the gas hold-up volume multiplied by the compression (compressibility) correction factor (\\(j\\)): \\[V_{\\rm{M}}^{\\rm{o}}=V_{\\rm{M}}\\ j\\] Assuming that the influence of extra column volume on \\(V_{\\rm{M}}\\) is negligible, \\[V_{\\rm{M}}^{\\rm{o}}=V_{\\rm{G}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hold-up volume" .

goldbook:H02834 a skos:Concept ;
    skos:definition "The photo bleaching of a feature, normally a narrow range, within an inhomogeneous broader absorption or emission band. The holes are produced by the disappearance of resonantly excited molecules as a result of photophysical or photochemical processes. The resulting spectroscopic technique is site-selection spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hole burning" .

goldbook:H02835 a skos:Concept ;
    skos:definition "Charge migration process in which the majority carriers are positively charged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hole transfer" .

goldbook:H02836 a skos:Concept ;
    skos:definition "An active enzyme consisting of the apoenzyme and coenzyme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "holoenzyme" .

goldbook:H02838 a skos:Concept ;
    skos:definition "a) An acronym for Highest Occupied Molecular Orbital (HOMO). See: frontier orbitals.b) A prefix (consisting of lower case letters, homo), used to indicate a higher homologue of a compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homo" .

goldbook:H02839 a skos:Concept ;
    skos:definition "Whereas in an aromatic molecule there is continuous overlap of p-orbitals over a cyclic array of atoms, in a homoaromatic molecule there is a formal discontinuity in this overlap resulting from the presence of a single \\(\\rm{sp}^{3}\\) hybridized atom at one or several positions within the ring; p-orbital overlap apparently bridges these \\(\\rm{sp}^{3}\\) centres, and features associated with aromaticity are manifest in the properties of the compound. Pronounced homoaromaticity is not normally associated with neutral molecules, but mainly with species bearing an electrical charge, e.g. the 'homotropylium' cation, ($\\ce{C8H9^{+}}$):  In bis, tris, (etc.) homoaromatic species, two, three, (etc.) single \\(\\rm{sp}^{3}\\) centres separately interrupt the $\\ce{\\uppi\\!\\mbox{-}electron}$ system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homoaromatic" .

goldbook:H02842 a skos:Concept ;
    skos:definition "[obsolete] Association between a base and its conjugate acid through a hydrogen bond ($\\ce{B\\bond{...}HB^{+}}$ or $\\ce{AH\\bond{...}A^{-}}$). Homoassociation is a more appropriate term for this phenomenon.The orbital overlap of two $\\ce{\\uppi\\!\\mbox{-}systems}$ separated by a non-conjugating group, such as $\\ce{CH2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homoconjugation" .

goldbook:H02843 a skos:Concept ;
    skos:definition "Cyclic compounds having as ring members atoms of the same element only, e.g. benzene, pentazole, cyclohexasilane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homocyclic compounds" .

goldbook:H02845 a skos:Concept ;
    skos:altLabel "material heterogeneity",
        "material homogeneity" ;
    skos:definition "The degree to which a property or a constituent is uniformly distributed throughout a quantity of material. A material may be homogeneous with respect to one analyte or property but heterogeneous with respect to another. The degree of heterogeneity (the opposite of homogeneity) is the determining factor of sampling error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneity" .

goldbook:H02850 a skos:Concept ;
    skos:altLabel "hemileptic" ;
    skos:definition "Transition metal or Main Group compounds having only one type of ligand are said to be homoleptic, e.g. $\\ce{TaMe5}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homoleptic" .

goldbook:H02851 a skos:Concept ;
    skos:altLabel "homolytic" ;
    skos:definition "The cleavage of a bond ('homolytic cleavage' or 'homolytic fission') so that each of the molecular fragments between which the bond is broken retains one of the bonding electrons. A unimolecular reaction involving homolysis of a bond (not forming part of a cyclic structure) in a molecular entity containing an even number of (paired) electrons results in the formation of two radicals:  It is the reverse of colligation. Homolysis is also commonly a feature of bimolecular substitution reactions (and of other reactions) involving radicals and molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homolysis" .

goldbook:H02852 a skos:Concept ;
    skos:definition "Relates in the usual sense to the formal nature of the cleavage of a single bond. If the electron pair in the bond of the adsorptive $\\ce{A{:}B}$ is divided in the course of its dissociative adsorption, the adsorption is homolytic dissociative adsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homolytic dissociative adsorption" .

goldbook:H02853 a skos:Concept ;
    skos:definition "Superposable ligands are called homomorphic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homomorphic" .

goldbook:H02854 a skos:Concept ;
    skos:definition "A polymer derived from one species of (real, implicit or hypothetical) monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homopolymer" .

goldbook:H02855 a skos:Concept ;
    skos:definition "Polymerization in which a homopolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homopolymerization" .

goldbook:H02857 a skos:Concept ;
    skos:definition "Atoms or groups of a molecule which are related by an n-fold rotation axis (n = 2, 3, etc.) are called homotopic. For example, chiral tartaric acid (\\(C_{2}\\) axis), chloroform (\\(C_{3}\\) axis) and cyclohexaamylose ($\\ce{\\upalpha\\!\\mbox{-}cyclodextrin}$, \\(C_{6}\\) axis) have respectively two homotopic carboxyl groups, three homotopic chlorine atoms and six homotopic ᴅ-glucose residues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homotopic" .

goldbook:H02858 a skos:Concept ;
    skos:altLabel "horizontal development" ;
    skos:definition "A mode of operation in which the paper or plate is in a horizontal position and the mobile-phase movement along the plane depends on capillary action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "horizontal elution" .

goldbook:H02859 a skos:Concept ;
    skos:definition "A molecular entity that forms complexes with organic or inorganic guests, or a chemical species that can accommodate guests within cavities of its crystal structure. Examples include cryptands and crowns (where there are ion-dipole attractions between heteroatoms and positive ions), hydrogen-bonded molecules that form 'clathrates' (e.g. hydroquinone and water), and host molecules of inclusion compounds (e.g. urea or thiourea). van der Waals forces and hydrophobic interactions bind the guest to the host molecule in clathrates and inclusion compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "host" .

goldbook:H02860 a skos:Concept ;
    skos:definition "A compatible combination of host (e.g. bacteria) and vector (e.g. plasmid) that allows propagation of DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "host-vector system" .

goldbook:H02861 a skos:Concept ;
    skos:definition "An atom in an excited energy state or having kinetic energy above the ambient thermal level, usually as a result of nuclear processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hot atom" .

goldbook:H02862 a skos:Concept ;
    skos:definition "A heavily shielded enclosure for highly radioactive materials. It may be used for their handling or processing by remote means or for their storage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hot cell" .

goldbook:H02863 a skos:Concept ;
    skos:definition "A hot state reaction of the ground electronic state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hot ground state reaction" .

goldbook:H02865 a skos:Concept ;
    skos:definition "A reaction proceeding from an ensemble of molecular entities possessing a higher average vibrational, rotational or translational energy than they would at thermal equilibrium with the surrounding medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hot state reaction" .

goldbook:H02866 a skos:Concept ;
    skos:definition "Non-SI unit of time, \\(\\rm{h} = 3600\\ \\rm{s}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hour" .

goldbook:H02867 a skos:Concept ;
    skos:definition "Monocyclic planar (or almost planar) systems of trigonally (or sometimes digonally) hybridized atoms that contain $\\ce{(4n + 2) \\uppi\\!\\mbox{-}electrons}$ (where $n$ is a non-negative integer) will exhibit aromatic character. The rule is generally limited to $n = 0 – 5$. This rule is derived from the Hückel MO calculation on planar monocyclic conjugated hydrocarbons $\\ce{(CH)_{m}}$ where $m$ is an integer equal to or greater than 3 according to which $\\ce{(4n + 2) \\uppi\\!\\mbox{-}electrons}$ are contained in a closed-shell system. Examples of systems that obey the Hückel rule include:  Systems containing $\\ce{4n\\;\\uppi\\!\\mbox{-}electrons}$ (such as cyclobutadiene and the cyclopentadienyl cation) are 'antiaromatic'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hückel (4<em>n</em> + 2) rule" .

goldbook:H02870 a skos:Concept ;
    skos:definition "A general term referring to the water content of a gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "humidity" .

goldbook:H02871 a skos:Concept ;
    skos:definition "Of the different multiplets resulting from different configurations of electrons in degenerate orbitals of an atom those with greatest multiplicity have the lowest energy (multiplicity rule).Among multiplets having the same multiplicity, the lowest-energy one is that with the largest total orbital angular momentum (angular momentum rule) (valid if the total orbital angular momentum is a constant of motion).In configurations containing shells less than half full of electrons, the term having the lowest total angular momentum \\(J\\) lies lowest in energy, whereas in those with shells more than half filled, the term having the largest value of \\(J\\) lies lowest (fine structure rule). Hund rules apply if the 'Russell–Saunders' coupling scheme is valid. Sometimes the first rule is applied with questionable validity to molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hund rules" .

goldbook:H02874 a skos:Concept ;
    skos:definition "Linear combination of atomic orbitals on an atom. Hybrid orbitals are often used in organic chemistry to describe the bonding molecules containing tetrahedral (\\(\\mathrm{sp}^{3}\\)), trigonal (\\(\\mathrm{sp}^{2}\\)) and digonal (\\(\\mathrm{sp}\\)) atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybridization" .

goldbook:H02875 a skos:Concept ;
    skos:definition "A hybrid cell line resulting from the fusion of a specific antibody-producing spleen cell (lymphocyte) with a myeloma cell, which has the growth characteristics of the myeloma component and the antibody-secreting characteristics of the lymphocyte, and will multiply to become a source of pure monoclonal antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybridoma" .

goldbook:H02876 a skos:Concept ;
    skos:definition "Addition of water or of the elements of water (i.e. H and OH) to a molecular entity. For example, hydration of ethene:  The term is also used in a more restricted sense for the process:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydration" .

goldbook:H02879 a skos:Concept ;
    skos:definition "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing $\\ce{–OH}$ by $\\ce{–NRNR2}$ ($\\ce{R}$ groups are commonly $\\ce{H}$), as in carbohydrazides, $\\ce{RC(=O)NHNH2}$, sulfonohydrazides, $\\ce{RS(=O)2NHNH2}$, and phosphonic dihydrazides, $\\ce{RP(=O)(NHNH2)2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrazides" .

goldbook:H02880 a skos:Concept ;
    skos:definition "Compounds, $\\ce{RC(NHNH2)2=NNH2}$, derived from carboxylic acids by replacing $\\ce{–OH}$ by $\\ce{–NHNH2}$ (or N-substituted analogues) and $\\ce{=O}$ by $\\ce{=NNH2}$ (or substituted analogues). A specific hydrazidine is named as a hydrazide hydrazone, e.g. hexanohydrazide hydrazone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrazidines" .

goldbook:H02881 a skos:Concept ;
    skos:definition "Hydrazine (diazane), $\\ce{H2NNH2}$, and its hydrocarbyl derivatives. When one or more substituents are acyl groups, the compound is a hydrazide. N-Alkylidene derivatives are hydrazones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrazines" .

goldbook:H02883 a skos:Concept ;
    skos:definition "Compounds containing the divalent hydrazo group, $\\ce{–NHNH\\bond{–}}$, such as hydrazoarenes (1,2-diarylhydrazines or 1,2-diaryldiazanes, usually with both aryl groups the same) and their N-substituted derivatives $\\ce{ArNRNRAr}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrazo compounds" .

goldbook:H02884 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C=NNR2}$, formally derived from aldehydes or ketones by replacing $\\ce{=O}$ by $\\ce{=NNH2}$ (or substituted analogues)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrazones" .

goldbook:H02885 a skos:Concept ;
    skos:definition "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing a double-bonded oxygen atom by $\\ce{=NNR2}$, as in carbohydrazonic acids, $\\ce{RC(OH)=NNH2}$ and sulfonohydrazonic acids, $\\ce{RS(=O)(=NNH2)OH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrazonic acids" .

goldbook:H02889 a skos:Concept ;
    skos:definition "Compounds consisting of carbon and hydrogen only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocarbons" .

goldbook:H02890 a skos:Concept ;
    skos:definition "Divalent groups formed by removing two hydrogen atoms from a hydrocarbon, the free valencies of which are not engaged in a double bond, e.g. 1,3-phenylene, $\\ce{–CH2CH2CH2–}$ propane-1,3-diyl, $\\ce{–CH2–}$ methylene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocarbylene groups" .

goldbook:H02891 a skos:Concept ;
    skos:definition "Univalent groups formed by removing a hydrogen atom from a hydrocarbon, e.g. ethyl, phenyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocarbyl groups" .

goldbook:H02892 a skos:Concept ;
    skos:definition "Divalent groups, $\\ce{R2C=}$, formed by removing two hydrogen atoms from the same carbon atom of a hydrocarbon, the free valencies of which are engaged in a double bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocarbylidene groups" .

goldbook:H02893 a skos:Concept ;
    skos:definition "Trivalent groups, $\\ce{RC#}$, formed by removing three hydrogen atoms from the same carbon atom of a hydrocarbon, the free valencies of which are engaged in a triple bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocarbylidyne groups" .

goldbook:H02894 a skos:Concept ;
    skos:altLabel "sulfenyl nitrenes",
        "thiazynes" ;
    skos:definition "Nitrenes substituted with hydrocarbyl sulfanyl groups, . Sulfenyl nitrenes is an older synonymous term. E.g. MeSN methylsulfanylnitrene or methylthionitrene. The synonymous term 'thiazynes' (from the third canonical form; confusable with the hetarynes derivable from 1,2- and 1,4-thiazine) is best avoided." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocarbylsulfanyl nitrenes" .

goldbook:H02895 a skos:Concept ;
    skos:definition "Used in the thermal decomposition of heavy (high molecular weight) hydrocarbons to smaller (low molecular weight) hydrocarbons; high pressures of hydrogen and a special catalyst are employed. Sulfur compounds in the fuel are reduced to $\\ce{H2S}$, and the final hydrocarbon product can be obtained relatively sulfur-free." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrocracking unit" .

goldbook:H02898 a skos:Concept ;
    skos:definition "The general name for the atom $\\ce{H}$, without regard for its nuclear mass, either for hydrogen in its natural abundance or where it is not desired to distinguish between the isotopes. The systematic name for atomic hydrogen is monohydrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogen" .

goldbook:H02899 a skos:Concept ;
    skos:definition "A form of association between an electronegative atom and a hydrogen atom attached to a second, relatively electronegative atom. It is best considered as an electrostatic interaction, heightened by the small size of hydrogen, which permits proximity of the interacting dipoles or charges. Both electronegative atoms are usually (but not necessarily) from the first row of the Periodic Table, i.e. $\\ce{N}$, $\\ce{O}$ or $\\ce{F}$. Hydrogen bonds may be inter-molecular or intramolecular. With a few exceptions, usually involving fluorine, the associated energies are less than \\(\\pu{20\\!-\\! 25 kJ mol-1}\\) (\\(\\pu{5\\!{-}\\! 6 kcal mol-1}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogen bond" .

goldbook:H02900 a skos:Concept ;
    skos:definition "A thin foil of platinum electrolytically coated with a finely divided deposit of platinum or palladium metal, which catalyses the electrode reaction: \\[\\rm{H}^{+}+\\rm{e}\\rightarrow \\frac{1}{2}\\rm{H}_{2}\\] in solutions saturated with hydrogen gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogen gas electrode" .

goldbook:H02901 a skos:Concept ;
    skos:definition "Enzymes that catalyse the cleavage of $\\ce{C–O}$, $\\ce{C–N}$, $\\ce{C–C}$ and other bonds by reactions involving the addition or removal of water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrolases" .

goldbook:H02902 a skos:Concept ;
    skos:definition "Solvolysis by water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrolysis" .

goldbook:H02903 a skos:Concept ;
    skos:definition "Any condensed water particle in the atmosphere of sufficient size to be potentially capable of undergoing precipitation (in fogs, clouds, some hazes, raindrops, snowflakes, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrometeor" .

goldbook:H02904 a skos:Concept ;
    skos:definition "The general name for the cation $\\ce{H^{+}}$; the species $\\ce{H^{−}}$ is the hydride anion and $\\ce{H}$ is the hydro group. These are general names to be used without regard to the nuclear mass of the hydrogen entity, either for hydrogen in its natural abundance or where it is not desired to distinguish between the isotopes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydron" .

goldbook:H02905 a skos:Concept ;
    skos:definition "Monosubstitution products of hydrogen peroxide (dioxidane), $\\ce{HOOH}$, having the skeleton $\\ce{ROOH}$, in which $\\ce{R}$ is any organyl group. Compounds in which $\\ce{R}$ is acyl are known as peroxy acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydroperoxides" .

goldbook:H02906 a skos:Concept ;
    skos:definition "'Water loving'. The capacity of a molecular entity or of a substituent to interact with polar solvents, in particular with water, or with other polar groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophilic" .

goldbook:H02907 a skos:Concept ;
    skos:definition "The tendency of hydrocarbons (or of lipophilic hydrocarbon-like groups in solutes) to form intermolecular aggregates in an aqueous medium, and analogous intramolecular interactions. The name arises from the attribution of the phenomenon to the apparent repulsion between water and hydrocarbons. However, the phenomenon ought to be attributed to the effect of the hydrocarbon-like groups on the water-water interaction. The misleading alternative term 'hydrophobic bond' is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophobic interaction" .

goldbook:H02908 a skos:Concept ;
    skos:definition "Compounds having the structures $\\ce{RS2H}$, $\\ce{RS3H}$ ... $\\ce{RSnH}$, in which $\\ce{Sn}$ is a chain of sulfur atoms, and $\\ce{R}$ is hydrocarbyl. Some people exclude hydrodisulfides from the class hydropolysulfides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydropolysulfides" .

goldbook:H02909 a skos:Concept ;
    skos:definition "The gaseous, liquid and solid water of the earth (oceans, ice caps, lakes, rivers, etc.) as distinguished from the lithosphere and the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrosphere" .

goldbook:H02910 a skos:Concept ;
    skos:definition "Term used in radicofunctional nomenclature of thiols. Hydrosulfides is not commonly used as a class name for thiols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrosulfides" .

goldbook:H02911 a skos:Concept ;
    skos:definition "Compounds, $\\ce{RC(=O)NHOH}$, derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing $\\ce{–OH}$ by $\\ce{–NHOH}$, and hydrocarbyl derivatives thereof. Specific examples are preferably named as N-hydroxy amides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydroxamic acids" .

goldbook:H02912 a skos:Concept ;
    skos:definition "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing $\\ce{=O}$ by $\\ce{=NOH}$ ($\\ce{=NOR}$), as in carbohydroximic acids, $\\ce{RC(OH)=NOH}$, and sulfonohydroximic acids, $\\ce{RS(=O)(=NOH)OH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydroximic acids" .

goldbook:H02913 a skos:Concept ;
    skos:definition "Hydroxylamine, $\\ce{H2N–OH}$, and its hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydroxylamines" .

goldbook:H02914 a skos:Concept ;
    skos:definition "Instrument used to measure the water vapour content of the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hygrometer" .

goldbook:H02922 a skos:Concept ;
    skos:altLabel "moisture analysis" ;
    skos:definition "The measurement or indication of the water content of the ambient air or of a sample of gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hygrometry" .

goldbook:H02923 a skos:Concept ;
    skos:definition "The increase in the intensity of a spectral band due to substituents or interactions with the molecular environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperchromic effect" .

goldbook:H02924 a skos:Concept ;
    skos:definition "In the formalism that separates bonds into $\\ce{\\upsigma\\!}$ and $\\ce{\\uppi\\! types}$, hyperconjugation is the interaction of $\\ce{\\upsigma\\!\\mbox{-}bonds}$ (e.g. $\\ce{C–H}$, $\\ce{C–C}$, etc.) with a $\\ce{\\uppi\\!}$ network. This interaction is customarily illustrated by contributing structure, e.g. for toluene (below), sometimes said to be an example of 'heterovalent' or 'sacrificial hyperconjugation', so named because the contributing structure contains one two-electron bond less than the normal Lewis formula for toluene:  At present, there is no evidence for sacrificial hyperconjugation in neutral hydrocarbons. The concept of hyperconjugation is also applied to carbenium ions and radicals, where the interaction is now between $\\ce{\\upsigma\\!\\mbox{-}bonds}$ and an unfilled or partially filled $\\ce{\\uppi\\!\\mbox{-}}$ or p-orbital. A contributing structure illustrating this for the tert-butyl cation is:  This latter example is sometimes called an example of 'isovalent hyper-conjugation' (the contributing structure containing the same number of two-electron bonds as the normal Lewis formula). Both structures shown on the right hand side are also examples of 'double bond-no-bond resonance'. The interaction between filled $\\ce{\\uppi\\!\\mbox{-}}$ or p-orbitals and adjacent antibonding  $\\ce{\\upsigma\\!^{\\ast}\\mbox{-}orbitals}$ is referred to as 'negative hyperconjugation', as for example in the fluoroethyl anion:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperconjugation" .

goldbook:H02926 a skos:Concept ;
    skos:definition "An affix used in names to designate an open structure, especially a boron skeleton, more closed than a klado structure but more open than an arachno structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>hypho</i>-" .

goldbook:H02927 a skos:Concept ;
    skos:definition "The opposite of hyperchromic effect (i.e. a decrease in intensity)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypochromic effect" .

goldbook:H02928 a skos:Concept ;
    skos:definition "The denser phase in an extraction system. This term is often used when two non-aqueous phases are present or when the solvent is an aqueous phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypo-phase" .

goldbook:H02929 a skos:Concept ;
    skos:definition "Shift of a spectral band to higher frequency or shorter wavelength upon substitution or change in medium. It is informally referred to as blue shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypsochromic shift" .

goldbook:H02930 a skos:Concept ;
    skos:altLabel "electrode memory" ;
    skos:definition "Regarding a material quantity or instrument's reading; the dependence of a value on the direction of change from a previous characteristic value. It may be quantified by the difference between the upscale and downscale variation starting from fixed lower and upper measurement points (inversion)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hysteresis" .

goldbook:HT06787 a skos:Concept ;
    skos:definition "The Haber–Weiss cycle consists of the following two reactions: $\\ce{H2O2 + OH^{.} -> H2O + O2^{−} + H^{+}}$and$\\ce{H2O2 + O2^{-} -> O2 + OH^{-} + OH^{.}}$ The second reaction achieved notoriety as a possible source of hydroxyl radicals. However, it has a negligible rate constant. It is believed that iron(III) complexes can catalyse this reaction: first, Fe(III) is reduced by superoxide, followed by oxidation by dihydrogen peroxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Haber–Weiss reaction" .

goldbook:HT06827 a skos:Concept ;
    skos:definition "Set of inherent properties of a substance, mixture of substances, or a process involving substances that, under production, usage, or disposal conditions, make it capable of causing adverse effects to organisms or the environment, depending on the degree of exposure; in other words, it is a source of danger." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hazard" .

goldbook:HT06886 a skos:Concept ;
    skos:definition "Dialysis process in which undesired metabolites and toxic by-products, such as urea and creatine, are removed from blood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hemodialysis" .

goldbook:HT06908 a skos:Concept ;
    skos:definition "The procedure for effects of work on the health of employees." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "health surveillance" .

goldbook:HT06962 a skos:Concept ;
    skos:definition "Hansch analysis is the investigation of the quantitative relationship between the biological activity of a series of compounds and their physicochemical substituent or global parameters representing hydrophobic, electronic, steric and other effects using multiple regression correlation methodology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hansch analysis" .

goldbook:HT06963 a skos:Concept ;
    skos:definition "Hydrophilicity is the tendency of a molecule to be solvated by water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophilicity" .

goldbook:HT06964 a skos:Concept ;
    skos:definition "Hydrophobicity is the association of non-polar groups or molecules in an aqueous environment which arises from the tendency of water to exclude non-polar molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrophobicity" .

goldbook:HT07035 a skos:Concept ;
    skos:altLabel "HMO",
        "HMO theory" ;
    skos:definition "The simplest molecular orbital theory of $\\ce{\\uppi\\!\\mbox{-}conjugated}$ molecular systems. It uses the following approximations: $\\ce{\\uppi\\!\\mbox{-}electron}$ approximation; LCAO representation of the $\\ce{\\uppi\\!\\mbox{-}molecular orbitals}$; neglect of electron-electron and nuclear-nuclear repulsions (in fact, the assumption that these cancel). The diagonal elements of the effective Hamiltonian, coulombic integrals, and the off-diagonal elements, resonance integrals, (accounted for only directly bonded atoms) are chosen as empirical parameters, all overlap integrals being neglected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Hückel molecular orbital theory" .

goldbook:HT07041 a skos:Concept ;
    skos:definition "The approximation of the full nuclear potential of a molecular system in its equilibrium geometry and in the vicinity of the respective minimum on the potential energy surface by the function \\[V=\\frac{1}{2}\\ \\sum _{\\begin{array}{c} i,j=1 \\end{array}}^{3\\ N}\\frac{\\partial ^{2}V}{\\partial q_{i}\\partial q_{j}}\\] where \\(q_{i}\\) are mass-weighted cartesian displacements of nuclei relative to their equilibrium positions. The approximation allows one to describe vibrational motion in terms of independent vibrational modes (normal modes) each of which is governed by a simple one-dimensional harmonic potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "harmonic approximation" .

goldbook:HT07048 a skos:Concept ;
    skos:definition "A subclass of isodesmic reactions in which reactants and products contain equal numbers of carbon atoms in corresponding states of hybridization; moreover, there is matching of the carbon-hydrogen bonds in terms of the number of hydrogen atoms joined to the individual carbon atoms. To achieve all this matching, one should significantly extend the number and types of reference molecules. In the aliphatic series of hydrocarbons these are propane, isobutane and neopentanes as well as propene and isobutene; for aromatics—buta-1,3-diene, 2-vinylbutadiene (3-methylidenehexa-1,5-diene) and 2,3-divinylbutadiene (3,4-bismethylidenehexa-1,5-diene). Thus to assess strain energy of cyclopropane and aromatic stabilization of benzene the following homodesmotic reactions are to be respectively analysed.$\\ce{c-(CH2)3 + 3CH3–CH3 -> 3CH3CH2CH3}$\\(\\Delta H_{\\exp}^{\\circ} = \\pu{-26.5 kcal/mol}\\) (\\(\\pu{110.9 kJ/mol}\\)).$\\ce{C6H6 + 3CH2=CH2 -> 3CH2=CH–CH=CH2}$(trans)\\(\\Delta H_{\\rm{calc}}^{\\circ} \\rm{(MP2/6{-}31G^{**})} = \\pu{23.9 kcal/mol}\\) (\\(\\pu{100.0 kJ/mol}\\)) Due to closer matching of the hybridization states of the atoms of reactants and products as compared to isodesmic reactions, the homodesmotic reactions give more accurate estimates of the intrinsic strain and the cyclic delocalization. The definition may be extended to molecules with heteroatoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homodesmotic reaction" .

goldbook:HT07049 a skos:Concept ;
    skos:definition "An atomic orbital derived through hybridization of atomic orbitals with different angular momentum quantum numbers located at a given atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid orbital" .

goldbook:HT07050 a skos:Concept ;
    skos:definition "A particular type of multicenter (three center - four electron) $\\ce{X–H...Y}$ in which the central hydrogen atom covalently linked to an electronegative atom $\\ce{X}$ ($\\ce{C}$, $\\ce{N}$, $\\ce{O}$, $\\ce{S}$...) forms an additional weaker bond with atom $\\ce{Y}$ ($\\ce{N}$, $\\ce{O}$, $\\ce{S}$...) in the direction of its lone electron pair orbital. The energy of hydrogen bonds, which is usually in the range of \\(\\pu{3\\!{-}\\! 15 kcal/mol}\\) (\\(\\pu{12\\!{-}\\! 65 kJ/mol}\\)), results from the electrostatic interaction and also from the orbital interaction of the antibonding $\\upsigma^{\\ast}(\\ce{XH})MO$ of the molecule acting as the hydrogen donor and the non-bonding lone electron pair $MO{\\rm{n}}_{\\rm{Y}}$ of the hydrogen acceptor molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogen bond" .

goldbook:HT07051 a skos:Concept ;
    skos:definition "A property of main-group atoms in molecular entities to acquire coordination numbers greater than four (which would comply with the Lewis octet rule). Hypercoordination may be associated with hypervalency, but usually is referred to peculiar atomic centres in the electron-deficient species with multicentre $\\ce{\\upsigma\\!\\mbox{-}bonding}$, in which the bonding power of a pair of electrons is spread over more than two atoms. An example of a hypercoordinated atom is the five-coordinate carbon atom in the methanium cation, where three $\\ce{C–H}$ bonds may be regarded as normal two center - two electron bonds and the bonding in the remaining $\\ce{CH2}$ fragment is governed by the three-centre, two-electron bond. A particular case of a hypercoordinated atom is the hydrogen atom included into a hydrogen bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypercoordination" .

goldbook:HT07052 a skos:Concept ;
    skos:definition "The interaction between the spin magnetic moment of an unpaired electron and the nuclear spin magnetic moments resulting in the splitting of the $\\ce{\\upalpha\\!}$ (spin up) and $\\ce{\\upbeta\\!}$ (spin down) energy levels in an external magnetic field and, thus, in the multiplet pattern of the ESR spectra of radical-like species and transition metal compounds. Two main contributions to the hyperfine coupling are usually considered, Fermi contact and dipolar interactions. The contact interaction is isotropic and related to the unpaired spin density at the nucleus, \\(|\\psi _{\\unicode[Times]{x3C3}}|^{2}\\). The dipolar interaction is anisotropic, and related to \\(r^{-3}\\), where \\(r\\) is the distance between the atom holding the unpaired electron and the nucleus with non-zero spin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperfine coupling" .

goldbook:HT07053 a skos:Concept ;
    skos:definition "The energy of a molecule in an external electrostatic field can be expanded as \\[E=E^{\\rm{o}}- \\unicode[Times]{x3BC}_{i}\\ F_{i}- \\frac{1}{2}\\ \\unicode[Times]{x3B1} _{ij}\\ F_{i}\\ F_{j}- \\frac{1}{6}\\ \\unicode[Times]{x3B2} _{ijk}\\ F_{i}\\ F_{j}\\ F_{k}- \\frac{1}{24}\\ \\unicode[Times]{x3B3} _{ijkl}\\ F_{i}\\ F_{j}\\ F_{k}\\ F_{l}- \\rm{...}\\] where \\(E^{\\rm{o}}\\) is the unperturbed energy, \\(F_{i}\\) is the component of the field in the i direction, \\(\\unicode[Times]{x3BC}_{i}\\) is the permanent dipole moment, \\(\\unicode[Times]{x3B1}_{ij}\\) is the polarizability tensor, and \\(\\unicode[Times]{x3B2}_{ijk}\\) and \\(\\unicode[Times]{x3B3}_{ijkl}\\) are the first and second hyperpolarizability tensors, respectively. \\(\\unicode[Times]{x3B2}\\) is a third order symmetric tensor that measures the second order response of the molecular electric dipole moment to the action of an external electric field and is thus often referred to as dipole hyperpolarizability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperpolarizability" .

goldbook:HT07054 a skos:Concept ;
    skos:definition "The ability of an atom in a molecular entity to expand its valence shell beyond the limits of the Lewis octet rule. Hypervalent compounds are common for the second and subsequent row elements in groups 15–18 of the periodic table. A description of the hypervalent bonding implies a transfer of the electrons from the central (hypervalent) atom to the nonbonding molecular orbitals which it forms with (usually more electronegative) ligands. A typical example of the hypervalent bond is a linear three-centre, four-electron bond, e.g. that of $\\ce{F_{ap}–P–F_{ap}}$ fragment of $\\ce{PF5}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hypervalency" .

goldbook:HT07207 a skos:Concept ;
    skos:definition "Polymer composed of linear macromolecules having ionic or ionizable end-groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "halato-telechelic polymer" .

goldbook:HT07232 a skos:Concept ;
    skos:definition "Mixture of two or more fractions of the same polymer, each of which has a different molar-mass distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homologous polymer blend" .

goldbook:HT07293 a skos:Concept ;
    skos:definition "Phase domain of microscopic or smaller size, usually in a block, graft, or segmented copolymer, comprising essentially those segments of the polymer that are rigid and capable of forming strong intermolecular interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hard-segment phase domain" .

goldbook:HT07390 a skos:Concept ;
    skos:definition "Time necessary for thermal bleaching to half of the absorbance of the coloured form of a photochromic compound at a specific wavelength during one cycle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-life" .

goldbook:HT07391 a skos:Concept ;
    skos:definition "Time needed for a concentration of the entity to decrease to \\(1/2\\) of its original value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "half-life" .

goldbook:HT07392 a skos:Concept ;
    skos:definition "Applied to photochromic compounds possessing a high efficiency for colouring with near-ultraviolet radiation and a low efficiency for bleaching with visible radiation, but a moderate efficiency for thermal fading at ambient temperature. These compounds are activated by unfiltered sunlight and deactivated under diffuse daylight conditions, therefore being suitable for sun-lens applications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "heliochromism" .

goldbook:HT07393 a skos:Concept ;
    skos:altLabel "HT mechanism" ;
    skos:definition "Volume-conserving mechanism of photoisomerization of a double bond in a conjugated system involving simultaneous configurational and conformational isomerization, e.g., the photoinitiated concerted rotation of two adjacent double and single bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hula-twist mechanism" .

goldbook:HT07394 a skos:Concept ;
    skos:altLabel "hyperfine interaction" ;
    skos:definition "Interaction between the electron spin S and the nuclear spin I." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hyperfine" .

goldbook:HT07519 a skos:Concept ;
    skos:definition "Gel in which the swelling agent is water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrogel" .

goldbook:HT07556 a skos:Concept ;
    skos:definition "Polymer or polymer network comprised of inorganic and organic components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hybrid polymer" .

goldbook:HT07582 a skos:Concept ;
    skos:definition "Polymer blend that is a single-phase structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "homogeneous polymer blend" .

goldbook:HT07622 a skos:Concept ;
    skos:altLabel "hot isostatic pressing" ;
    skos:definition "Isostatic pressing process carried out at elevated temperatures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hipping" .

goldbook:HT07623 a skos:Concept ;
    skos:definition "Mole ratio of water to alkoxy groups used in sol-gel processing of metal alkoxides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "hydrolysis ratio" .

goldbook:I02931 a skos:Concept ;
    skos:definition "An affix used in names to denote twelve atoms bound into a triangular icosahedron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>icosahedro</i>-" .

goldbook:I02932 a skos:Concept ;
    skos:altLabel "eicosanoids" ;
    skos:definition "Unsaturated $\\ce{C20}$ fatty acids and skeletally related compounds. The spelling icosanoids is preferred over the spelling eicosanoids for consistency with icosanoic acid. Specialists working in this field commonly use eicosanoids, however." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "icosanoids" .

goldbook:I02933 a skos:Concept ;
    skos:definition "The adsorbed state in a system following Langmuir's isotherm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal adsorbed state" .

goldbook:I02938 a skos:Concept ;
    skos:definition "A mixture of substances B, C, ... is called an ideal mixture when \\(a_{\\rm{B}}=x_{\\rm{B}}\\), \\(a_{\\rm{C}}=x_{\\rm{C}}\\), ... or \\(f_{\\rm{B}}=1\\), \\(f_{\\rm{C}}=1\\) where \\(a_{\\rm{B}}\\) and \\(f_{\\rm{B}}\\) are the relative activity and the activity coefficient, respectively, of a substance B in a liquid or solid mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal mixture" .

goldbook:I02940 a skos:Concept ;
    skos:altLabel "degenerate chemical reaction" ;
    skos:definition "A chemical reaction whose products are chemically identical with the reactants, for example the bimolecular self exchange reaction of $\\ce{CH3I}$ with $\\ce{I^{-}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "identity reaction" .

goldbook:I02941 a skos:Concept ;
    skos:definition "Luminous flux received by a surface divided by the area of that surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "illuminance" .

goldbook:I02942 a skos:Concept ;
    skos:definition "An electron tube that produces on its fluorescent screen an image of the irradiation pattern of its photosensitive input surface. An image converter which produces an image with enhanced radiance is sometimes called an image intensifier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image converter tube" .

goldbook:I02943 a skos:Concept ;
    skos:definition "A two-dimensional radiation detector in which the electron image produced by a photo-emitting surface, usually a photocathode, is focused in the plane of a defining aperture. Magnetic or electric fields scan this image across the defining aperture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "image dissection tube" .

goldbook:I02944 a skos:Concept ;
    skos:altLabel "photoimaging" ;
    skos:definition "The use of a photosensitive system for the capture, recording and retrieval of information associated with an object using electromagnetic energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imaging" .

goldbook:I02945 a skos:Concept ;
    skos:definition "The situation in which reaction parameters that characterize different bond forming or bond breaking processes in the same reaction have developed to different extents as the transition state is approached along some arbitrarily defined reaction coordinate. For example, in the nitroalkane anomaly, the Brønsted \\(\\beta \\) exponent for proton removal is smaller than the Brønsted \\(\\alpha \\) for the nitroalkane, because of imbalance between the amount of bond breaking and resonance delocalization in the transition state. Imbalance is common in reactions such as elimination, addition and other complex reactions that involve proton (hydron) transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imbalance" .

goldbook:I02946 a skos:Concept ;
    skos:definition "The uptake of a liquid by a gel or porous substance. It may or may not be accompanied by swelling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imbibition" .

goldbook:I02948 a skos:Concept ;
    skos:definition "Diacyl derivatives of ammonia or primary amines, especially those cyclic compounds derived from diacids, e.g.  In additive nomenclature, in which imide is analogous to oxide, the term is used to name compounds of the type $\\ce{R3Y^{+}-N^{-}R}$ ($\\ce{Y = N, P}$) and $\\ce{R2Z^{+}-N^{-}R}$ ($\\ce{Z = O, S, Se, Te}$), which are the products of formal attachment of an $\\ce{RN=}$ group to $\\ce{N}$, $\\ce{P}$, $\\ce{O}$, $\\ce{S}$, $\\ce{Se}$, $\\ce{Te}$. E.g. amine imides, azomethine imides.Salts having the anion $\\ce{RN^{2−}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imides" .

goldbook:I02949 a skos:Concept ;
    skos:definition "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing $\\ce{=O}$ by $\\ce{=NR}$; thus tautomers of amides. In organic chemistry an unspecified imidic acid is generally a carboximidic acid, $\\ce{RC(=NR)(OH)}$. E.g. $\\ce{RS(=NH)2(OH)}$ a sulfonodiimidic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imidic acids" .

goldbook:I02950 a skos:Concept ;
    skos:definition "Analogues of cyclic acid anhydrides in which $\\ce{=O}$ has been replaced by $\\ce{=NR}$ and $\\ce{–O\\bond{–}}$ by $\\ce{–NR\\bond{–}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imidines" .

goldbook:I02953 a skos:Concept ;
    skos:definition "Carbenes having the structure $\\ce{RC(=NR)C{:}–R}$. Imidoyl is a shortened but imprecise term for carboximidoyl, $\\ce{RC(=NH)\\bond{–}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imidoyl carbenes" .

goldbook:I02954 a skos:Concept ;
    skos:definition "Nitrenes having the structure ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imidoyl nitrenes" .

goldbook:I02957 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RN=CR2}$ ($\\ce{R} = \\ce{H}$, hydrocarbyl). Thus analogues of aldehydes or ketones, having NR doubly bonded to carbon; aldimines have the structure $\\ce{RCH=NR}$, ketimines have the structure $\\ce{R'2C=NR}$ ($\\ce{R'}  eq \\ce{H}$). Imines include azomethines and Schiff bases. Imine is used as a suffix in systematic nomenclature to denote the $\\ce{C=NH}$ group excluding the carbon atom.An obsolete term for azacycloalkanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imines" .

goldbook:I02958 a skos:Concept ;
    skos:definition "Salts in which the cation has the structure $\\ce{R2C=N^{+}R2}$. Thus N-hydronated imines and their N-substituted derivatives. The synonymous terms imonium compounds and immonium compounds are irregularly formed and should not be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iminium compounds" .

goldbook:I02959 a skos:Concept ;
    skos:definition "An obsolete term, which should not be used, for imidic acids.Any carboxylic acids having an imino substituent, $\\ce{HN=}$, replacing two hydrogens. A shortened form of imino carboxylic acid.Obsolescent term for azaalkanoic acids and azacycloalkane-2-carboxylic acids, e.g. proline:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imino acids" .

goldbook:I02960 a skos:Concept ;
    skos:definition "This term systematically means carbenes bearing an imino or N-substituted imino group, $\\ce{RN=}$, somewhere in the molecule. E.g. $\\ce{R–C:–CH2C(=NR)R}$. It is listed here in order to warn against its misuse for alkylideneamino carbenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imino carbenes" .

goldbook:I02962 a skos:Concept ;
    skos:definition "Synonymous with alkylideneaminoxyl radicals. The term can be regarded as a contraction of iminyloxyl radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iminoxyl radicals" .

goldbook:I02964 a skos:Concept ;
    skos:definition "Cations having the structure $\\ce{R2C=N^{+}}$. A contraction of alkaniminylium ions. Alkylideneaminylium ions is a synonymous term. A subclass of nitrenium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iminylium ions" .

goldbook:I02965 a skos:Concept ;
    skos:definition "Radicals having the structure $\\ce{R2C=N^{.}}$. A contraction of alkaniminyl radicals, e.g. $\\ce{CH3–CH=N^{.}}$, ethaniminyl. A synonymous term is alkylideneaminyl radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iminyl radicals" .

goldbook:I02966 a skos:Concept ;
    skos:definition "A process in which a solid or liquid, $\\ce{\\upbeta\\!}$, is covered with a liquid, $\\ce{\\upalpha\\!}$, both of which were initially in contact with a gas or liquid, $\\ce{\\updelta\\!}$, without changing the area of the $\\ce{\\upalpha\\!\\updelta\\!\\mbox{-}}$interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immersional wetting" .

goldbook:I02967 a skos:Concept ;
    skos:definition "A Germanic term, pronounced in English, 'eye-mission'; the transfer of pollutants from the atmosphere to a 'receptor'; for example, pollutants retained by the lungs. It does not have the same meaning as ground level concentration, but is the opposite in meaning to emission. This term has not been used commonly in the English language." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immission" .

goldbook:I02968 a skos:Concept ;
    skos:definition "The integral of the immission flow into the receptor over the exposure period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immission dose" .

goldbook:I02969 a skos:Concept ;
    skos:definition "The immission rate divided by the unit surface area of the receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immission flux" .

goldbook:I02970 a skos:Concept ;
    skos:definition "The mass (or other physical quantity) of pollutant transferring per unit time into a receptor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immission rate" .

goldbook:I02971 a skos:Concept ;
    skos:definition "A situation in which the freedom of molecules of adsorbate to move about the surface is limited. Adsorption is immobile when \\(k\\ T\\) is small compared to \\(\\Delta E\\), the energy barrier separating adjacent sites. The adsorbate has little chance of migrating to neighbouring sites and such adsorption is necessarily localized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immobile adsorption" .

goldbook:I02972 a skos:Concept ;
    skos:definition "A stationary phase in which is immobilized on the support particles, or on the inner wall of the column tubing e.g. by in situ polymerization (cross-linking) after coating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immobilized phase" .

goldbook:I02973 a skos:Concept ;
    skos:definition "The technique used for the physical or chemical fixation of cells, organelles, enzymes, or other proteins (e.g. monoclonal antibodies) onto a solid support, into a solid matrix or retained by a membrane, in order to increase their stability and make possible their repeated or continued use. The principle is also used for affinity chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immobilization" .

goldbook:I02976 a skos:Concept ;
    skos:definition "A soluble enzyme bound to an insoluble organic or inorganic matrix, or encapsulated within a membrane in order to increase its stability and make possible its repeated or continued use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immobilized enzyme" .

goldbook:I02977 a skos:Concept ;
    skos:definition "Selective reaction of the body to substances that are foreign to it, or that the immune system identifies as foreign, shown by the production of antibodies and antibody-bearing cells or by a cell-mediated hypersensitivity reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immune response" .

goldbook:I02978 a skos:Concept ;
    skos:definition "The administration of an antigen to an animal in order to stimulate the production of antibodies by that organism. Also, the administration of antigens, antibodies or lymphocytes to an animal to generate the corresponding active, passive or adaptive immunity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunization" .

goldbook:I02979 a skos:Concept ;
    skos:definition "A ligand-binding assay that uses a specific antigen or antibody, capable of binding to the analyte, to identify and quantify substances. The antibody can be linked to a radiosotope (radioimmunoassay, RIA), or to an enzyme which catalyses an easily monitored reaction (enzyme-linked immunosorbent assay, ELISA), or to a highly fluorescent compound by which the location of an antigen can be visualized (immunofluorescene)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoassay" .

goldbook:I02980 a skos:Concept ;
    skos:definition "Study of biochemical and molecular aspects of immunology, especially the nature of antibodies, antigens and their interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunochemistry" .

goldbook:I02981 a skos:Concept ;
    skos:definition "A substance that elicits a cellular immune response and/or antibody production (cf. antigen)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunogen" .

goldbook:I02982 a skos:Concept ;
    skos:altLabel "Ig" ;
    skos:definition "A protein of the globulin-type found in serum or other body fluids that possesses antibody activity. An individual Ig molecule is built up from two light (L) and two heavy (H) polypeptide chains linked together by disulfide bonds. Igs are divided into five classes based on antigenic and structural differences in the H chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoglobulin" .

goldbook:I02983 a skos:Concept ;
    skos:definition "An assay based on the reversible and non-covalent binding of an antigen by a specific antibody labelled with a radioactive nuclide as a tracer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunoradiometric assay" .

goldbook:I02984 a skos:Concept ;
    skos:definition "Reduction in the functional capacity of the immune response; may be due to:  Inhibition of the normal response of the immune system to an antigen.   Prevention, by chemical or biological means, of the production of an antibody to an antigen by inhibition of the processes of transcription, translation or formation of tertiary structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immunosuppression" .

goldbook:I02985 a skos:Concept ;
    skos:definition "A forcible contact of particles of matter with a surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impaction" .

goldbook:I02987 a skos:Concept ;
    skos:definition "In simple hard sphere collision theory the distance of closest approach that would result for two particles in a collision if the particle trajectories were undeflected by the collision." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impact parameter" .

goldbook:I02988 a skos:Concept ;
    skos:definition "Complex representation of potential difference divided by the complex representation of the current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impedance" .

goldbook:I02989 a skos:Concept ;
    skos:definition "Equivalent to impaction; often refers to impaction on a liquid surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impingement" .

goldbook:I02990 a skos:Concept ;
    skos:definition "A sampling instrument employing impingement for the collection of particulate matter. Common types are: the midget impinger employing impingement in \\(1{-}10\\ \\rm{cm}^{3}\\) water,  the standard impinger employing impingement in \\(75\\ \\rm{cm}^{3}\\) water and  dry impingers.  Impingers are also suitable for sampling certain gases and vapours." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impinger" .

goldbook:I02991 a skos:Concept ;
    skos:definition "Variation of the result in a set of replicate measurements. This can be expressed, e.g. as the standard deviation or coefficient of variation (relative standard deviation). This term may have a more general meaning, e.g. if the replicates constitute a batch or involve different instruments, laboratories and analyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "imprecision" .

goldbook:I02992 a skos:Concept ;
    skos:definition "The modification of the separation properties of the chromatographic bed used in planar chromatography by appropriate additives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impregnation" .

goldbook:I02993 a skos:Concept ;
    skos:altLabel "ICVTST" ;
    skos:definition "A modification of canonical variational transition-state theory in which, for energies below the threshold energy, the position of the dividing surface is taken to be that of the microcanonical threshold energy. This forces the contributions to rate constant to be zero below the threshold energy. A compromise dividing surface is then chosen so as to minimize the contributions to the rate constant made by reactants having higher energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "improved canonical variational transition-state theory" .

goldbook:I02995 a skos:Concept ;
    skos:definition "A quantitative term to describe the (lack of) accuracy of a chemical measurement process; comprises the imprecision and the bias. Inaccuracy must be viewed as a two-component quantity (vector); imprecision and bias should never be combined to give a scalar measure for chemical measurement process inaccuracy. (One or the other component may, however, be negligible under certain circumstances.) Inaccuracy should not be confused with uncertainty. Inaccuracy (imprecision, bias) is characteristic of the measurement process, whereas error and uncertainty are characteristics of a result. (The latter characteristic, of course, derives from the imprecision and bounds for bias of the chemical measurement process.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inaccuracy" .

goldbook:I02997 a skos:Concept ;
    skos:definition "Equipment in which solid, liquid or gaseous combustible wastes are ignited and burned. Types include flue-fed and multiple-chamber incinerators with several stages of combustion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incinerator" .

goldbook:I02998 a skos:Concept ;
    skos:altLabel "inclusion complex" ;
    skos:definition "A complex in which one component (the host) forms a cavity or, in the case of a crystal, a crystal lattice containing spaces in the shape of long tunnels or channels in which molecular entities of a second chemical species (the guest) are located. There is no covalent bonding between guest and host, the attraction being generally due to van der Waals forces. If the spaces in the host lattice are enclosed on all sides so that the guest species is 'trapped' as in a cage, such compounds are known as clathrates or 'cage compounds'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inclusion compound" .

goldbook:I02999 a skos:Concept ;
    skos:definition "Not having the properties of coherent radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incoherent radiation" .

goldbook:I03003 a skos:Concept ;
    skos:definition "An individual portion of material collected by a single operation of a sampling device. Increments may be reduced individually or tested either (a) individually or (b) combined with other increments with the resulting composite reduced in size and tested as a single unit. Increments are created by the sampling operation and are usually taken from parts of a lot separated in time or space. Increments of a bulk population correspond to units of a packaged population." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "increment" .

goldbook:I03004 a skos:Concept ;
    skos:altLabel "added hydrogen" ;
    skos:definition "Under certain circumstances it is necessary to indicate in the name of a ring, or ring system, containing the maximum number of non-cumulative double bonds, one or more positions where no multiple bond is attached. This is done by specifying the presence of an 'extra' hydrogen atom at such positions by citation of the appropriate numbered locant followed by an italicized capital H.Example:  A second type of indicated hydrogen (sometimes referred to as 'added hydrogen') describes hydrogen atoms added to a specific structure as a consequence of the addition of a suffix or a prefix describing a structural modification. This type of indicated hydrogen is normally cited in parentheses after the locant of the additional feature.Example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indicated hydrogen" .

goldbook:I03008 a skos:Concept ;
    skos:definition "An ion which absorbs through coulomb forces only and which is hence only repelled by surfaces of like sign, attracted by surfaces of opposite sign, and is not absorbed on an uncharged surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indifferent absorbing ion" .

goldbook:I03009 a skos:Concept ;
    skos:definition "Synonymous with supporting electrolyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indifferent electrolyte" .

goldbook:I03010 a skos:Concept ;
    skos:definition "A type of amplification reaction where the constituent required is associated with some other constituent which is then amplified and measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect amplification" .

goldbook:I03011 a skos:Concept ;
    skos:definition "A chemical process in which the reactive complex has a lifetime that is longer than its period of rotation is called an indirect reaction (in contrast to a direct reaction). In a molecular-beam experiment the products of such reactions are scattered at random with reference to the centre of mass of the system. Indirect reactions are also called complex-mode reactions. (They are sometimes called complex reactions, but this usage is not recommended in view of the danger of confusion with composite reactions, which occur in more than one step)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "indirect reaction" .

goldbook:I03014 a skos:Concept ;
    skos:altLabel "IPT" ;
    skos:definition "A term used in odour testing which signifies the lowest concentration of a particular species at which a subject indicates both an initial positive and repeated response." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "individual perception threshold" .

goldbook:I03015 a skos:Concept ;
    skos:definition "Radioactivity induced by irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "induced radioactivity" .

goldbook:I03016 a skos:Concept ;
    skos:definition "A reaction which occurs or is accelerated only if another reaction is simultaneously occurring in the same system. The substance, which causes an induced reaction, is termed inductor. The inductor, unlike the catalyst, is used up irreversibly during the process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "induced reaction" .

goldbook:I03017 a skos:Concept ;
    skos:definition "A small molecule that triggers gene transcription by binding to a regulator protein (cf. enzyme induction). It acts by combining with the corresponding repressor protein to bring about an allosteric change so that the repressor is made incapable of combining with the operator of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inducer" .

goldbook:I03018 a skos:Concept ;
    skos:definition "An increase in the rate of synthesis of an (inducible) enzyme in response to the action of an inducer or environmental conditions. An inducer is often the substrate of the inducible enzyme or a structurally similar substance (gratuitous inducer) that is not metabolized.The experimental elicitation of lytic growth by a prophage from lysogenic bacteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "induction" .

goldbook:I03019 a skos:Concept ;
    skos:definition "The initial slow phase of a chemical reaction which later accelerates. Induction periods are often observed with radical reactions, but they may also occur in other systems (for example before steady-state concentration of the reactants is reached)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "induction period" .

goldbook:I03021 a skos:Concept ;
    skos:definition "In strict definition, an experimentally observable effect (on rates of reaction, etc.) of the transmission of charge through a chain of atoms by electrostatic induction. A theoretical distinction may be made between the field effect, and the inductive effect as models for the coulomb interaction between a given site within a molecular entity and a remote unipole or dipole within the same entity. The experimental distinction between the two effects has proved difficult, except for molecules of peculiar geometry, which may exhibit 'reversed field effects'. Ordinarily the inductive effect and the field effect are influenced in the same direction by structural changes in the molecule and the distinction between them is not clear. This situation has led many authors to include the field effect in the term 'inductive effect'. Thus the separation of values into inductive and resonance components does not imply the exclusive operation of a through-bonds route for the transmission of the non-conjugative part of the substituent effect. To indicate the all-inclusive use of the term inductive, the phrase 'so-called inductive effect' is sometimes used. Certain modern theoretical approaches suggest that the 'so-called inductive effect' reflects a field effect rather than through-bonds transmission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductive effect" .

goldbook:I03022 a skos:Concept ;
    skos:definition "A molecular polarizability effect occurring by the inductive mechanism of electron displacement. The consideration of such an effect and the descriptive term have been regarded as obsolescent or even obsolete, but in recent years theoretical approaches have reintroduced substituent polarizability as a factor governing reactivity, etc. and its parametrization has been proposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inductomeric effect" .

goldbook:I03025 a skos:Concept ;
    skos:definition "If in a molecular collision there is transfer of energy among degrees of freedom, but no chemical reaction occurs, there is said to be inelastic scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inelastic scattering" .

goldbook:I03026 a skos:Concept ;
    skos:definition "Stable and unreactive under specified conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inert" .

goldbook:I03027 a skos:Concept ;
    skos:definition "A non-reactive gas under particular conditions. For example, nitrogen at ordinary temperatures and the noble gases (helium, argon, krypton, xenon and radon) are unreactive toward most species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inert gas" .

goldbook:I03029 a skos:Concept ;
    skos:definition "Any dry type collector which utilizes the relatively greater inertia of particles to effect their removal from a gas stream; e.g. cyclonic and impingement separators, gravity settling chambers and high-velocity gas reversal chambers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inertial separator" .

goldbook:I03030 a skos:Concept ;
    skos:definition "For a specified radiation, the minimum thickness of a flat preparation of a radioactive material where the intensity of the specified radiation at the surface does not increase when the thickness is increased by adding more of similar radioactive material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infinite source thickness" .

goldbook:I03032 a skos:Concept ;
    skos:definition "As applied in reaction dynamics, information theory analyses the deviations of experimentally-determined energy distributions from predictions made on the basis of equal a priori probabilities for all possible outcomes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "information theory" .

goldbook:I03034 a skos:Concept ;
    skos:definition "The decrease in rate of reaction brought about by the addition of a substance inhibitor), by virtue of its effect on the concentration of a reactant, catalyst or reaction intermediate. For example, molecular oxygen and p-benzoquinone can react as 'inhibitors' in many reactions involving radicals as intermediates by virtue of their ability to act as scavengers toward these radicals. If the rate of a reaction in the absence of inhibitor is \\(v_{0}\\) and that in the presence of a certain amount of inhibitor is \\(v\\), the degree of inhibition (\\(i\\)) is given by: \\[i=\\frac{v_{0}- v}{v_{0}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibition" .

goldbook:I03035 a skos:Concept ;
    skos:definition "A substance that diminishes the rate of a chemical reaction; the process is called inhibition. Inhibitors are sometimes called negative catalysts, but since the action of an inhibitor is fundamentally different from that of a catalyst, this terminology is discouraged. In contrast to a catalyst, an inhibitor may be consumed during the course of a reaction. In enzyme-catalysed reactions an inhibitor frequently acts by binding to the enzyme, in which case it may be called an enzyme inhibitor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibitor" .

goldbook:I03036 a skos:Concept ;
    skos:altLabel "IC" ;
    skos:definition "Concentration of a substance that causes a defined inhibition of a given system: \\(\\rm{IC}_{50}\\) is the median concentration that causes 50% inhibition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibitory concentration" .

goldbook:I03037 a skos:Concept ;
    skos:altLabel "ID" ;
    skos:definition "Dose of a substance that causes a defined inhibition of a given system: \\(\\rm{ID}_{50}\\) is the median dose that causes 50% inhibition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhibitory dose" .

goldbook:I03038 a skos:Concept ;
    skos:definition "An error due to inhomogenous distribution of absorbing species in the analytical sample. It may be observed by probing the sample volume with an incident beam of radiation of reduced cross-section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inhomogeneity error" .

goldbook:I03040 a skos:Concept ;
    skos:definition "A mode of measurement in a kinetic method of analysis, in which the initial reaction rate is determined (usually by the slope method) and utilized for the measurement of concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initial rate method" .

goldbook:I03041 a skos:Concept ;
    skos:definition "These are correlations between the states of the products of a reaction and the initial states of the reactants. The correlations may relate to energy levels, quantum numbers, and symmetries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initial state correlations" .

goldbook:I03042 a skos:Concept ;
    skos:definition "A reaction or process generating free radicals (or some other reactive reaction intermediates) which then induce a chain reaction. For example, in the chlorination of alkanes by a radical mechanism the initiation step is the dissociation of molecular chlorine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initiation" .

goldbook:I03043 a skos:Concept ;
    skos:definition "A substance introduced into a reaction system in order to bring about an initiation reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "initiator" .

goldbook:I03045 a skos:Concept ;
    skos:definition "The selection, removal and preparation of the test (or analytical) portions from the laboratory sample. The processing may include a reduction in the size of the unit(s) (division) and particle size (reduction), as well as mixing to achieve homogeneity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-laboratory processing" .

goldbook:I03047 a skos:Concept ;
    skos:definition "In an emission experiment, an apparent decrease in emission quantum yield and/or distortion of bandshape as a result of reabsorption of emitted radiation.During a light irradiation experiment, absorption of incident radiation by a species other than the intended primary absorber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inner filter effect" .

goldbook:I03048 a skos:Concept ;
    skos:altLabel "IHP" ;
    skos:definition "The locus of the electrical centres of specifically adsorbed ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inner Helmholtz plane" .

goldbook:I03049 a skos:Concept ;
    skos:altLabel "compact layer" ;
    skos:definition "The region between the outer Helmholtz plane and the interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inner layer" .

goldbook:I03050 a skos:Concept ;
    skos:definition "X-ray spectral lines generated by the transition of electrons between 'inner orbitals'. The term 'inner orbital' serves to designate the sharp, not degenerate electronic levels of atoms in a solid and therefore is a general term for all orbitals except the valence band." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inner orbital X-ray emission spectra" .

goldbook:I03052 a skos:Concept ;
    skos:definition "Historically an electron transfer between two metal centres sharing a ligand or atom in their respective coordination shells. The definition has more recently been extended to any situation in which the interaction between the donor and acceptor centres in the transition state is significant (\\(\\pu{\\gt 20 kJ mol-1}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inner-sphere electron transfer" .

goldbook:I03053 a skos:Concept ;
    skos:definition "The introduction of a small sample of organisms (microbial, plant or animal cells) into a culture medium to act as a seed for the production of large numbers of the same organism by growth and propagation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inoculation" .

goldbook:I03054 a skos:Concept ;
    skos:definition "Cyclohexane-1,2,3,4,5,6-hexols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inositols" .

goldbook:I03055 a skos:Concept ;
    skos:definition "Isomerism found in bicyclic systems having long enough bridges to allow the bridgehead exocyclic bond or lone pair of electrons to point either inside the structure or outside." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "in-out isomerism" .

goldbook:I03056 a skos:Concept ;
    skos:definition "The number of samples that are processed by the instrument divided by time of operation. It should be stated if the residence time is included or not." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "input rate" .

goldbook:I03057 a skos:Concept ;
    skos:definition "A sequence of foreign DNA introduced into a restriction site (insertion site, cloning site) of a vector DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insert" .

goldbook:I03058 a skos:Concept ;
    skos:definition "A chemical reaction or transformation of the general type: $$\\ce{X-Z + Y -> X-Y-Z}$$ in which the connecting atom or group $\\ce{Y}$ replaces the bond joining the parts $\\ce{X}$ and $\\ce{Z}$ of the reactant $\\ce{XZ}$. An example is the carbene insertion reaction:  The reverse of an insertion is called an extrusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "insertion" .

goldbook:I03059 a skos:Concept ;
    skos:definition "Term used for direct analytical investigation of the microstructural domains of a solid by focused beams of particles and radiation. Analytical characterization includes obtaining information about type, quantity and distribution of the elements, their state of chemical bonding, morphology and crystalline (geometric) and electronic structure of the individual phases. The combination of this information serves as a basis for the property-relevant characterization of solids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>in situ</i> microanalysis" .

goldbook:I03060 a skos:Concept ;
    skos:altLabel "Kossel-technique" ;
    skos:definition "Any technique which utilizes the diffraction of X-rays generated in a microstructural domain of a solid under bombardment with a finely focused electron beam, thus providing an X-ray diffraction pattern of this microstructural domain. The pattern can be recorded with a film either on the reflection or transmission side of the specimen (in the latter case the crystalline sample has to be a thin film or a small particle)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>in situ</i> micro-X-ray diffraction" .

goldbook:I03061 a skos:Concept ;
    skos:definition "A change which takes place in an instrument reading over a stated period of unattended operation for a given value of the air quality characteristic. It can be characterized by the variation with time of its mean, specifying the drift and by the dispersion. Span instability is the change which takes place in instrument span over a stated period of unattended operation. Zero instability is the change in instrument reading in response to a zero sample over a stated period of unattended operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instability" .

goldbook:I03062 a skos:Concept ;
    skos:definition "At a dropping electrode, the total current that flows at the instant when a time \\(t\\) has elapsed since the fall of the preceding drop. At any other electrode, the total current that flows at the instant when a time \\(t\\) has elapsed since the beginning of an electrolysis. The instantaneous current is usually time-dependent and may have the character of an adsorption, catalytic, diffusion, double-layer, or kinetic current, and may include a migration current. A plot of the dependence of instantaneous current on time is commonly called an 'i-t curve'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instantaneous current" .

goldbook:I03063 a skos:Concept ;
    skos:definition "The rate of increase of the mass of a drop at a particular instant \\(t\\) seconds after it has begun to form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instantaneous rate of flow" .

goldbook:I03064 a skos:Concept ;
    skos:altLabel "spot sampling" ;
    skos:definition "Obtaining a sample of the atmosphere in a period which is short compared with the duration of the sampling exercise. Such samples are often called 'grab' samples, a term not recommended. These are useful for the analysis of hydrocarbons and other complicated mixtures of trace gases which are relatively stable in a stainless steel canister or tank and can be transported back to the laboratory for chromatographic or other analysis which cannot be done satisfactorily in the field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instantaneous sampling" .

goldbook:I03065 a skos:Concept ;
    skos:definition "A kind of activation analysis in which element specificity is obtained by using appropriate irradiation conditions, radiation measurement techniques and mathematical techniques for the interpretation of the measurement results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instrumental activation analysis" .

goldbook:I03066 a skos:Concept ;
    skos:definition "This relates to the frequency of failures which interrupt the operation of an instrument. It can be quantified, e.g. by the infrequency of breakdowns or by the availability of the instrument for use when required." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instrumental dependability" .

goldbook:I03068 a skos:Concept ;
    skos:definition "Integral capacitance (per unit area of electrode) is given by \\[K=\\frac{Q}{E- E_{Q=0}}\\] where \\(Q\\) is the electric charge (per unit area of electrode), \\(E\\) is the potential of the electrode with respect to a reference electrode, and \\(E_{Q=0}\\) is the potential at the point of zero charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integral capacitance" .

goldbook:I03069 a skos:Concept ;
    skos:definition "A device which measures the accumulated quantity of sample component(s) reaching the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integral detector" .

goldbook:I03070 a skos:Concept ;
    skos:definition "A hollow sphere having a highly reflecting inside surface used as a device to collect, with very high efficiency, light scattered or emitted from a sample contained in it or located outside and near one of the ports. Small ports allow the entrance of light and access to a detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "integrating sphere" .

goldbook:I03071 a skos:Concept ;
    skos:definition "Synonymous with avoided crossing. The term 'intended' should not be used in this context since it is an anthropomorphic term." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intended crossing" .

goldbook:I03072 a skos:Concept ;
    skos:definition "The traditional term for photon flux, fluence rate, irradiance or radiant power (radiant flux). In terms of an object exposed to radiation, the term should now be used only for qualitative descriptions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intensity" .

goldbook:I03073 a skos:Concept ;
    skos:altLabel "intensity relative to base peak" ;
    skos:definition "The ratio of intensity of a separated ion beam to the intensity of the separated ion beam which has the greatest intensity. This ratio is generally equated to the normalized ratio of the heights of the respective peaks in the mass spectrum, with the height of the base peak being taken as 100." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intensity" .

goldbook:I03075 a skos:Concept ;
    skos:definition "The farthest distance of approach of two particles at which it is discernible that they will not pass at the impact parameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interaction distance" .

goldbook:I03076 a skos:Concept ;
    skos:definition "Compounds resulting from reversible inclusion, without covalent bonding, of one kind of molecule in a solid matrix of another compound, which has a laminar structure. The host compound, a solid, may be macromolecular, crystalline or amorphous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intercalation compounds" .

goldbook:I03077 a skos:Concept ;
    skos:altLabel "insertion reaction" ;
    skos:definition "Reaction, generally reversible, that involves the penetration of a host material by guest species without causing a major structural modification of the host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intercalation reaction" .

goldbook:I03082 a skos:Concept ;
    skos:definition "The plane ideally marking the boundary between two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interface" .

goldbook:I03083 a skos:Concept ;
    skos:definition "The interfacial concentration \\(c_{\\rm{B},\\rm{e}}\\) (or simply \\(c_{\\rm{e}}\\)) of a species B is the concentration of that species at the boundary of the electrical double-layer facing the solution, i.e. just outside the region where the departures from the electroneutrality of the solution are significant. This concept is mainly used in the usual case where the thickness of the electric double layer is very small as compared to that of the diffusion layer. It is often calculated from theory or derived from measurements of the limiting current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfacial concentration" .

goldbook:I03084 a skos:Concept ;
    skos:definition "The Coulombic interaction of interfacial charges (e.g. ions) and the magnetic or electrostatic interaction of interfacial molecules lead to particularly complex interfacial structures. Complex interfacial profiles that can be approximated by two distinct sub-layers with different physical properties (e.g. structure and/or nature and/or composition), are referred to as interfacial double-layers. Examples of such approximated complex profiles are: the electrical double-layer consisting of a surface charge layer (i.e. a two dimensional distribution of one type of ions) and a diffuse charge layer (counter-ions distributed over the space region next to the surface); the approximated profile of the orientation angle of anisotropic liquid molecules within a 'double-layer' consisting of a distribution of so-called anchored molecules which are perturbed (strongly bound and orientated) by the surface, and the adjacent, so-called, transition layer, i.e. the region where the surface perturbation is damped." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfacial double-layer" .

goldbook:I03085 a skos:Concept ;
    skos:altLabel "interfacial region",
        "interphase" ;
    skos:definition "The inhomogeneous space region intermediate between two bulk phases in contact, and where properties are significantly different from, but related to, the properties of the bulk phases. Examples of such properties are: compositions, molecular density, orientation or conformation, charge density, pressure tensor, electron density, etc. The interfacial properties vary in the direction normal to the surface. Complex profiles of interfacial properties occur in the case of multicomponent systems with coexisting bulk phases where attractive/repulsive molecular interactions involve adsorption or depletion of one or several components. This interfacial region may also be regarded as a distinct, though not autonomous, phase and be called the interphase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfacial layer" .

goldbook:I03086 a skos:Concept ;
    skos:definition "The characteristic length defined by the variance of the Gaussian function fitted to the gradient of the electron density profile established by X-ray specular reflectivity studies of the liquid interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfacial layer width" .

goldbook:I03089 a skos:Concept ;
    skos:definition "A systematic error in the measure of a signal caused by the presence of concomitants in a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interference" .

goldbook:I03093 a skos:Concept ;
    skos:definition "Any substance, other than the ion being measured, whose presence in the sample solution affects the measured emf of a cell. Interfering substances fall into two classes: 'electrode/electrochemical' interferences and 'chemical' interferences. Examples of the first class include:Those substances which give a similar response to the ion being measured and whose presence generally results in an apparent increase in the activity (or concentration) of the ion to be determined (e.g. $\\ce{Na^{+}}$ for the $\\ce{Ca^{2+}}$ electrode).Electrolytes present at a high concentration that give rise to appreciable liquid junction potential differences or results in a significant activity coefficient decrease, or incipient Donnan exclusion failure. The second class of substances that should be recognized as chemical interferences includes: Species that interact with the ion being measured so as to decrease its activity or apparent concentration. The electrode continues to report the true activity (e.g. $\\ce{CN^{−}}$ present in the measurement of $\\ce{Ag^{+}}$), but a considerable gap will occur between the activity and concentration of the ions even in very dilute solutions. Under these circumstances the determination of ionic concentration may be problematic. Substances interacting with the membrane itself, blocking the surface or changing its chemical composition [i.e. organic solvents for the liquid or poly(vinyl chloride) (PVC) membrane electrodes] are grouped as interferences or electrode poisons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfering substance" .

goldbook:I03095 a skos:Concept ;
    skos:definition "A class of glycoproteins (with sugar groups attached at specific locations) important in immune function. They are able to inhibit the multiplication of viruses in cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interferons" .

goldbook:I03096 a skos:Concept ;
    skos:altLabel "reaction intermediate" ;
    skos:definition "A molecular entity with a lifetime appreciably longer than a molecular vibration (corresponding to a local potential energy minimum of depth greater than \\(R\\ T\\)) that is formed (directly or indirectly) from the reactants and reacts further to give (either directly or indirectly) the products of a chemical reaction; also the corresponding chemical species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermediate" .

goldbook:I03097 a skos:Concept ;
    skos:definition "Neutrons of kinetic energy between the energies of slow and fast neutrons. In reactor physics, the range might be \\(1\\ \\rm{eV}\\) to \\(0.1\\ \\rm{MeV}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermediate neutrons" .

goldbook:I03098 a skos:Concept ;
    skos:definition "Descriptive of any process that involves a transfer (of atoms, groups, electrons, etc.) or interactions between two or more molecular entities.Relating to a comparison between different molecular entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intermolecular" .

goldbook:I03102 a skos:Concept ;
    skos:definition "A photophysical process. An isoenenergetic radiationless transition between two electronic states of the same multiplicity. When the transition results in a vibrationally excited molecular entity in the lower electronic state, this usually undergoes deactivation to its lowest vibrational level, provided the final state is not unstable to dissociation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal conversion" .

goldbook:I03103 a skos:Concept ;
    skos:altLabel "thermodynamic energy" ;
    skos:definition "Quantity the change in which is equal to the sum of heat, \\(q\\), brought to the system and work, \\(w\\), performed on it, \\(\\Delta U=q+w\\). Also called thermodynamic energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal energy" .

goldbook:I03105 a skos:Concept ;
    skos:definition "Aqueous electrolyte solution, which may be gelled, containing fixed concentration of hydrogen ions, e.g. $\\ce{HCl}$ or a buffer solution, and a fixed concentration of the ion to which the internal reference electrode is reversible, e.g. chloride ion in the case of silver-silver chloride, or calomel electrodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal filling solution" .

goldbook:I03106 a skos:Concept ;
    skos:definition "An 'inner' reference electrode which is contained inside an ion-selective electrode assembly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal reference electrode" .

goldbook:I03108 a skos:Concept ;
    skos:definition "A compound added to a sample in known concentration to facilitate the qualitative indentification and/or quantitative determination of the sample components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal standard" .

goldbook:I03109 a skos:Concept ;
    skos:definition "With respect to porous solids, the surface associated with pores communicating with the outside space. Since the accessibility of pores may depend on the size of the fluid molecules, the extent of the accessible internal surface may depend on the size of the molecules comprising the fluid, and may be different for the various components of a fluid mixture (molecular sieve effect)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal surface" .

goldbook:I03111 a skos:Concept ;
    skos:altLabel "IVFF" ;
    skos:definition "A force field expressed in terms of bond-stretching, angle-bending, torsional and other displacements directly connected to the structural parameters of the molecule: \\[V=\\frac{1}{2}\\ \\sum k_{ij}\\ R_{i}\\ R_{j}\\] or \\[V=\\frac{1}{2}\\ \\sum K_{ij}\\ R_{i}\\ R_{j}\\] where \\(k\\) (or \\(K\\)) are the force constants and \\(R\\) the internal valence coordinates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "internal valence force field" .

goldbook:I03114 a skos:Concept ;
    skos:definition "The unit of enzyme activity proposed by the International Union of Biochemistry in 1964. Specifically, it is the amount of enzyme that catalyses the conversion of one micromole of substrate per minute under the specified conditions of the assay method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "international unit" .

goldbook:I03115 a skos:Concept ;
    skos:definition "The interparticle volume of a packed column per unit column volume: \\[\\varepsilon = \\frac{V_{0}}{V_{\\rm{c}}}\\] It is also called the interstitial fraction of the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interparticle porosity" .

goldbook:I03116 a skos:Concept ;
    skos:definition "The volume occupied by the mobile phase between the particles in the packed section of a column. It is also called the interstitial volume or the void volume of the column. In liquid chromatography, the interparticle volume is equal to the mobile-phase hold-up volume (\\(V_{\\rm{M}}\\)) in the ideal case, neglecting any extra-column volume. In gas chromatography, the symbol \\(V_{\\rm{G}}\\) may be used for the interparticle volume of the column. In the ideal case, neglecting any extra-column volume, \\(V_{\\rm{G}}\\) is equal to the corrected gas hold-up volume (\\(V_{\\rm{M}}^{\\rm{o}}\\)). \\[V_{\\rm{G}}=V_{\\rm{M}}^{\\rm{o}}=V_{\\rm{M}j}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interparticle volume of the column" .

goldbook:I03117 a skos:Concept ;
    skos:altLabel "IPN" ;
    skos:definition "Polymer comprising two or more networks that are at least partially interlaced on a molecular scale but not covalently bonded to each other and cannot be separated unless chemical bonds are broken." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interpenetrating polymer network" .

goldbook:I03119 a skos:Concept ;
    skos:definition "A transition that occurs at boundaries between phases. Example: The precipitation of second phases or the initiation of new phase growth at an interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interphase transition" .

goldbook:I03123 a skos:Concept ;
    skos:altLabel "state crossing" ;
    skos:definition "A photophysical process. An isoenergetic radiationless transition between two electronic states having different multiplicities. It often results in a vibrationally excited molecular entity in the lower electronic state, which then usually deactivates to its lowest vibrational level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intersystem crossing" .

goldbook:I03124 a skos:Concept ;
    skos:definition "A method to estimate uncertainties in the results of a least-squares procedure. The input data are primary values plus limits of intervals expressing their uncertainty. The output consists of derived values plus limits of intervals expressing a pessimistic estimate of maximal uncertainty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interval analysis" .

goldbook:I03125 a skos:Concept ;
    skos:definition "Electron transfer (thermal or photoinduced) between two metal sites differing only in oxidation state. Quite often such electron transfer reverses the oxidation states of the sites. The term is frequently extended to the case of metal-to-metal charge transfer between non-equivalent metal centres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intervalence charge transfer" .

goldbook:I03128 a skos:Concept ;
    skos:definition "The prefix for an elementary reaction or some part thereof indicating that the bond(s) undergoing primitive changes form part of a ring in the transition state of the elementary reaction. This prefix is used for nonpericyclic processes only and is replaced by 'cyclo' for pericyclic processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intra-" .

goldbook:I03130 a skos:Concept ;
    skos:definition "Descriptive of any process that involves a transfer (of atoms, groups, electrons, etc.) or interactions between different parts of the same molecular entity.Relating to a comparison between atoms or groups within the same molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramolecular" .

goldbook:I03131 a skos:Concept ;
    skos:definition "The acceleration of a chemical transformation at one site of a molecular entity through the involvement of another functional ('catalytic') group in the same molecular entity, without that group appearing to have undergone change in the reaction product. The use of the term should be restricted to cases for which analogous intermolecular catalysis by chemical species bearing that catalytic group is observable. intramolecular catalysis can be detected and expressed in quantitative form by a comparison of the reaction rate with that of a comparable model compound in which the catalytic group is absent, or by measurement of the effective molarity of the catalytic group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramolecular catalysis" .

goldbook:I03132 a skos:Concept ;
    skos:definition "A kinetic isotopic effect observed when a single substrate, in which the isotopic atoms occupy equivalent reactive positions, reacts to produce a non-statistical distribution of isotopomeric products. In such a case the isotope effect will favour the pathway with lower force constants for displacement of the isotopic nuclei in the transition state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramolecular isotope effect" .

goldbook:I03133 a skos:Concept ;
    skos:definition "A transition that occurs within a phase. Example: initiation of phase growth at an intragranular feature, such as twin planes and dislocations in steels." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intraphase transition" .

goldbook:I03134 a skos:Concept ;
    skos:definition "If \\(E_{\\rm{a,1}}\\) and \\(E_{\\rm{a,- 1}}\\) are the activation energies for a reaction in forward and reverse directions, the lesser of the two is sometimes called the intrinsic activation energy. It is the activation energy for the reaction in the exothermic direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic activation energy" .

goldbook:I03135 a skos:Concept ;
    skos:definition "The Gibbs energy of activation (\\(\\Delta ^{\\ddagger}G\\)) in the limiting case where \\(\\Delta G^{\\,\\unicode{x26ac}} = 0\\), i.e. when the effect of thermodynamic driving force is eliminated. According to the Marcus equation, the intrinsic barrier is related to the reorganization energy, \\(\\lambda \\), of the reaction by the equation: \\[\\Delta ^{\\ddagger}G = \\frac{\\lambda }{4}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic barrier" .

goldbook:I03136 a skos:Concept ;
    skos:definition "The ratio of the number of particles or photons detected to the number of similar particles or photons which have struck the envelope limiting the sensitive volume of a radiation detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic detector efficiency" .

goldbook:I03138 a skos:Concept ;
    skos:definition "The detector efficiency when considering only events where the total energy of the radiation is absorbed in the sensitive volume of the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic full energy peak efficiency" .

goldbook:I03139 a skos:Concept ;
    skos:definition "The detector efficiency when only counts resulting from the photoelectrical effect are considered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic photopeak efficiency" .

goldbook:I03141 a skos:Concept ;
    skos:definition "An intervening section of DNA occuring almost exclusively within a eukaryotic gene but which is not translated to amino acid sequences in the gene product. The introns are removed from the premature mRNA through a process called splicing to form an active mRNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intron" .

goldbook:I03142 a skos:Concept ;
    skos:definition "A kinetic isotope effect in which \\(\\frac{k^{\\rm{l}}}{k^{\\rm{h}}}1\\). The isotope effect will normally be 'normal' when the frequency differences between the isotopic transition state are smaller than in the reactants. Conversely, an inverse isotope effect can be taken as evidence for an increase in the corresponding force constants on passing from the reactant to the transition state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse isotope effect" .

goldbook:I03145 a skos:Concept ;
    skos:definition "The intensity of radiation from a point source in free space is inversely proportional to the square of the distance from the source. Presence of absorbers necessitates corrections to this law." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverse square law" .

goldbook:I03146 a skos:Concept ;
    skos:definition "A symmetry operation involving a centre of inversion (\\(i\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion" .

goldbook:I03147 a skos:Concept ;
    skos:definition "The height above ground level at which there is change in sign of the normal temperature 'lapse rate', \\(\\frac{\\rm{d}T}{\\rm{d}z}\\) (the rate of change of the temperature with height). Several temperature inversions may be present in the air over a given site at different altitudes as result of various meteorological factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion height" .

goldbook:I03149 a skos:Concept ;
    skos:definition "The temperature (pressure) at which one polymorph of a solid phase changes into another at constant pressure (temperature)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inversion point" .

goldbook:I03151 a skos:Concept ;
    skos:altLabel "inverse micelle",
        "reverse micelle (or reversed micelle)" ;
    skos:definition "The reversible formation of association colloids from surfactants in non-polar solvents leads to aggregates termed inverted (or inverse, reverse or reversed) micelle. Such association is often of the type: \\[\\rm{Monomer}\\rightleftarrows \\rm{Dimer}\\rightleftarrows \\rm{Trimer}\\rightleftarrows \\rm{ ... }n\\rm{-mer}\\] and the phenomenon of critical micelle concentration (or an analogous effect) is consequently not observed. In an inverted micelle the polar groups of the surfactants are concentrated in the interior and the lipophilic groups extend towards and into the non-polar solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverted micelle" .

goldbook:I03152 a skos:Concept ;
    skos:altLabel "Marcus inverted region" ;
    skos:definition "In plots relating rate constants to charges in standard Gibbs energy (\\(\\Delta G^{\\,\\unicode{x26ac}}\\)) for electron transfer a region may occur in which the rate constants decrease as the exergonicity of the reaction increases. This region is often referred to as the inverted region and its presence is predicted by the theory developed for outer sphere electron transfer for the case \\(-\\Delta G^{\\circ} \\gt \\lambda \\) in the Marcus equation, \\(\\lambda\\) being the reorganization energy. Note the similarity to the energy gap law for radiationless conversion of an excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inverted region" .

goldbook:I03153 a skos:Concept ;
    skos:definition "In glass, referring to a study in the laboratory usually involving isolated organ, tissue, cell, or biochemical systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>in vitro</i>" .

goldbook:I03154 a skos:Concept ;
    skos:definition "In the living body, referring to a study performed on a living organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>in vivo</i>" .

goldbook:I03158 a skos:Concept ;
    skos:definition "An atomic or molecular particle having a net electric charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion" .

goldbook:I03161 a skos:Concept ;
    skos:definition "Device for the capture of selected ions such as a Faraday cup collector (with a d.c. amplifier) or an electron multiplier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion collector" .

goldbook:I03162 a skos:Concept ;
    skos:altLabel "ICR",
        "ICR mass spectrometer" ;
    skos:definition "A high-frequency mass spectrometer in which the ions to be detected, with a selected value of the quotient mass/charge, absorb maximum energy through the effect of a high-frequency electric field and a constant magnetic field perpendicular to the electric field. Maximum energy is gained by the ions which satisfy the cyclotron resonance condition and as a result they are separated from ions of different mass/charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion cyclotron resonance mass spectrometer" .

goldbook:I03165 a skos:Concept ;
    skos:definition "Spectra that show the loss of translational energy of ions involved in ion/neutral species reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion energy loss spectra" .

goldbook:I03167 a skos:Concept ;
    skos:definition "In surface chemistry, if the adsorption of one or several ionic species is accompanied by the simultaneous desorption (displacement) of an equivalent amount of one or more other ionic species, this process is called ion exchange." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion exchange" .

goldbook:I03168 a skos:Concept ;
    skos:altLabel "IC" ;
    skos:definition "Chromatography in which separation is based mainly on differences in the ion-exchange affinities of the sample components. Present day ion-exchange chromatography on small particle high efficiency columns, and usually utilizing conductometric or spectroscopic detectors, is often referred to as ion chromatography (IC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-exchange chromatography" .

goldbook:I03169 a skos:Concept ;
    skos:definition "The concentration of a counter-ion in the ion exchanger expressed as a function of its concentration in the external solution under specified conditions and at constant temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-exchange isotherm" .

goldbook:I03171 a skos:Concept ;
    skos:definition "A solid or liquid, inorganic or organic substance containing exchangeable ions with others of the same charge, present in a solution in which the ion exchanger is considered to be insoluble. It is recognized that there are cases where liquid exchangers are employed and where it may be difficult to distinguish between the separation process as belonging to ion exchange or liquid-liquid distribution, but the broad definition given here is regarded as that which is most appropriate. A monofunctional ion exchanger contains only one type of ionogenic group, a bifunctional ion exchanger two types and a polyfunctional ion exchanger more than one type. In a macroporous ion exchanger the pores are large compared to atomic dimensions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion exchanger" .

goldbook:I03173 a skos:Concept ;
    skos:definition "An interphase in which only non-specifically adsorbed ions are present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-free layer" .

goldbook:I03175 a skos:Concept ;
    skos:definition "Defined for ionic species $\\ce{B}$ by \\(\\lambda = |z_{\\rm{B}}|\\ F\\ u_{\\rm{B}}\\) where \\(z_{\\rm{B}}\\) is the charge number of the ionic species $\\ce{B}$, \\(F\\) is the Faraday constant, and \\(u_{\\rm{B}}\\) is the electric mobility of species $\\ce{B}$. In most current practice \\(z_{\\rm{B}}\\) is taken as unity, i.e. ionic conductivity is taken as that of species such as $\\ce{Na^{+}}$, $\\ce{Ca^{2+}}$/2, $\\ce{La^{3+}}$/3 etc. To avoid ambiguity the species considered should be clearly stated, e.g. as \\(\\lambda (\\rm{Ca}^{\\rm{2+}}/2)\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic conductivity" .

goldbook:I03176 a skos:Concept ;
    skos:definition "A copolymerization which is an ionic polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic copolymerization" .

goldbook:I03177 a skos:Concept ;
    skos:definition "The decomposition of an ion into another ion of lower mass and one or more neutral species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic dissociation" .

goldbook:I03178 a skos:Concept ;
    skos:definition "A chain polymerization in which the kinetic-chain carriers are ions or ion pairs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic polymerization" .

goldbook:I03180 a skos:Concept ;
    skos:definition "On a molality basis, \\[I_{m} = \\frac{1}{2}\\ \\sum m_{\\rm{B}}\\ z_{\\rm{B}}^{2}\\] where the sum goes over all the ions B. \\(z_{\\rm{B}}\\) is the charge number of ion B. The ionic strength on a concentration basis is defined analogously \\[I_{c} = \\frac{1}{2}\\ \\sum c_{\\rm{B}}\\ z_{\\rm{B}}^{2}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic strength" .

goldbook:I03181 a skos:Concept ;
    skos:definition "Quotient of the current carried by an ionic component and the total current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic transport number" .

goldbook:I03183 a skos:Concept ;
    skos:definition "The generation of one or more ions. It may occur, e.g. by loss of an electron from a neutral molecular entity, by the unimolecular heterolysis of such an entity into two or more ions, or by a heterolytic substitution reaction involving neutral molecules, such as:    The loss of an electron from a singly, doubly, etc. charged cation is called second, third, etc. ionization. This terminology is used especially in mass spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionization" .

goldbook:I03190 a skos:Concept ;
    skos:definition "A radiation detector which employs an electric field for the collection at the electrodes of charges associated with the ions produced in the sensitive volume by ionizing radiation, without charge multiplication. The solid angle ($\\ce{2\\Uppi\\!}$, $\\ce{4\\uppi\\!}$) subtended when using the detector, is sometimes specified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionization chamber" .

goldbook:I03194 a skos:Concept ;
    skos:definition "A measure of the probability that a given ionization process will occur when an atom or molecule interacts with an electron or a photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionization cross-section" .

goldbook:I03196 a skos:Concept ;
    skos:definition "The ratio of the number of ions formed to the number of electrons or photons used in an ionization process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionization efficiency" .

goldbook:I03197 a skos:Concept ;
    skos:definition "The number of ions produced as a function of the energy of the electrons or photons used to produce ionization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionization efficiency curve" .

goldbook:I03199 a skos:Concept ;
    skos:altLabel "ionization potential" ;
    skos:definition "Minimum energy required to eject an electron out of a neutral atom or molecule in its ground state. The adiabatic ionization energy refers to the formation of the molecular ion in its ground vibrational state and the vertical ionization energy applies to the transition to the molecular ion without change in geometry. This quantity was formerly called 'ionization potential'. The second ionization energy of an atom is the energy required to eject the second electron from the atom (energy for the process $\\ce{X^{+} -> X^{2+} + e^{-}}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionization energy" .

goldbook:I03214 a skos:Concept ;
    skos:definition "An ion/neutral species interaction in which an electron or electrons are stripped from the ion and/or the neutral species in the collision. Generally, this term has come to be used to describe collisions of fast-moving ions with a neutral species in which the neutral species is ionized with no change in the number of charges carried by the ion. Care should be taken when this term is used to emphasize if charge stripping of the ion has taken place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionizing collision" .

goldbook:I03215 a skos:Concept ;
    skos:definition "A term to denote the tendency of a particular solvent to promote ionization of an uncharged or, less often, charged solute. The term has been used both in a kinetic and in a thermodynamic context." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionizing power" .

goldbook:I03216 a skos:Concept ;
    skos:definition "Any radiation consisting of directly or indirectly ionizing particles or a mixture of both, or photons with energy higher than the energy of photons of ultraviolet light or a mixture of both such particles and photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionizing radiation" .

goldbook:I03218 a skos:Concept ;
    skos:definition "A spectrum obtained when a beam of ions is separated according to the translational energy-to-charge ratios of the ionic species contained within it. A radial electric field (E) achieves separation of the various ionic species in this way." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion kinetic energy spectrum" .

goldbook:I03219 a skos:Concept ;
    skos:definition "A gas laser in which the active species is an ion formed in the electric discharge. Most practically important lasers of this type have continuous wave (CW) output. Examples are the argon ion, krypton ion and helium-cadmium (HeCd) lasers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion laser" .

goldbook:I03223 a skos:Concept ;
    skos:definition "An ion/neutral species reaction in which the neutral species is a molecule. The use of ion-molecule reaction is not recommended; the hyphen suggests a reaction of a species that is both an ion and a molecule and is not the intended meaning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion/molecule reaction" .

goldbook:I03225 a skos:Concept ;
    skos:definition "In this reaction an association reaction is accompanied by the subsequent or simultaneous liberation of a different neutral species as product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion/neutral species exchange reaction" .

goldbook:I03226 a skos:Concept ;
    skos:definition "A process wherein a charged species interacts with a neutral reactant to produce either chemically different species or changes in the internal energy of one or both of the reactants. The contrasting expression ion/neutral reaction is not ideal, simply because the word neutral is not a noun. However, any alternatives such as ion/neutral species reaction are so clumsy as to mitigate against their general acceptance" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion/neutral species reaction" .

goldbook:I03228 a skos:Concept ;
    skos:definition "The fixed groupings in an ion exchanger which are either ionized or capable of dissociation into fixed ions and mobile counter-ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionogenic groups" .

goldbook:I03229 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules in which a small but significant proportion of the constitutional units has ionic or ionizable groups, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionomer" .

goldbook:I03230 a skos:Concept ;
    skos:definition "A macromolecule in which a small but significant proportion of the constitutional units have ionizable or ionic groups, or both. Some protein molecules may be classified as ionomer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionomer molecule" .

goldbook:I03231 a skos:Concept ;
    skos:definition "A pair of oppositely charged ions held together by coulomb attraction without formation of a covalent bond. Experimentally, an ion pair behaves as one unit in determining conductivity, kinetic behaviour, osmotic properties, etc. Following Bjerrum, oppositely charged ions with their centres closer together than a distance: \\[q = \\frac{8.36\\times 10^{6}\\ z^{+}\\ z^{-}}{\\varepsilon_{\\rm{r}}\\ T}\\ \\rm{pm}\\] are considered to constitute an ion pair ('Bjerrum ion pair'). [\\(z^{+}\\) and \\(z^{-}\\) are the charge numbers of the ions, and \\(\\varepsilon_{\\rm{r}}\\) is the relative permittivity (or dielectric constant) of the medium.] An ion pair, the constituent ions of which are in direct contact (and not separated by an intervening solvent or other neutral molecule) is designated as a 'tight ion pair' (or 'intimate' or 'contact ion pair'). A tight ion pair of $\\ce{X^{+}}$ and $\\ce{Y^{−}}$ is symbolically represented as $\\ce{X^{+}Y^{−}}$. By contrast, an ion pair whose constituent ions are separated by one or several solvent or other neutral molecules is described as a 'loose ion pair', symbolically represented as $\\ce{X^{+}}\\,\\|\\,\\ce{Y^{−}}$. The members of a loose ion pair can readily interchange with other free or loosely paired ions in the solution. This interchange may be detectable (e.g. by isotopic labelling) and thus afford an experimental distinction between tight and loose ion pairs. A further conceptual distinction has sometimes been made between two types of loose ion pairs. In 'solvent-shared ion pairs' the ionic constituents of the pair are separated by only a single solvent molecule, whereas in 'solvent-separated ion pairs' more than one solvent molecule intervenes. However, the term 'solvent-separated ion pair' must be used and interpreted with care since it has also widely been used as a less specific term for 'loose' ion pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion pair" .

goldbook:I03232 a skos:Concept ;
    skos:definition "Involves an ionization process in which a positive fragment ion and a negative fragment ion are among the products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-pair formation" .

goldbook:I03233 a skos:Concept ;
    skos:definition "The recombination of a pair of ions $\\ce{R^{+}}$ and $\\ce{Z^{−}}$ formed from ionization of $\\ce{RZ}$. If the ions are paired as a tight ion pair and recombine without prior separation into a loose ion pair this is called 'internal ion-pair return':   It is a special case of 'primary geminate recombination'. If the ions are paired as a loose ion pair and form the covalent chemical species via a tight ion pair, this is called 'external ion-pair return':  It is a special case of 'secondary geminate recombination'. When the covalent molecule RZ is reformed without direct evidence of prior partial racemization or without other direct evidence of prior formation of a tight ion pair, (e.g. without partial racemization if the group R is suitably chiral) the internal ion-pair return is sometimes called a 'hidden return'. External (unimolecular) ion-pair return is to be distinguished from 'external (bimolecular) ion return', the (reversible) process whereby dissociated ions are converted into loose ion pairs:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion pair return" .

goldbook:I03238 a skos:Concept ;
    skos:altLabel "IPMA" ;
    skos:definition "Any technique in which the specimen is bombarded by a focused beam of (primary) ions (diameter less than \\(10\\ \\unicode[Times]{x3BC}\\rm{m}\\)) and the (secondary) ions ejected from the specimen are detected after passage through a mass spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion probe microanalysis" .

goldbook:I03243 a skos:Concept ;
    skos:altLabel "ISS" ;
    skos:definition "Any technique using low energy (\\(10\\ \\rm{keV}\\)) ions in which the bombarding particles scattered by the sample are detected and recorded as a function of energy and/or angle. This technique is used mainly for determining the composition and structure of the first few atomic layers of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion scattering spectrometry" .

goldbook:I03244 a skos:Concept ;
    skos:altLabel "ISE" ;
    skos:definition "An electrochemical sensor, based on thin films or selective membranes as recognition elements, and an electrochemical half-cell equivalent to other half-cells of the zeroth (inert metal in a redox electrolyte), 1st, 2nd and 3rd kinds. These devices are distinct from systems that involve redox reactions (electrodes of zeroth, 1st, 2nd and 3rd kinds), although they often contain a 2nd kind electrode as the 'inner' or 'internal' reference electrode. The potential difference response has, as its principal component, the Gibbs energy change associated with permselective mass transfer (by ion-exchange, solvent extraction or some other mechanism) across a phase boundary. The ion-selective electrode must be used in conjunction with a reference electrode (i.e. 'outer' or 'external' reference electrode) to form a complete electrochemical cell. The measured potential differences (ion-selective electrode vs. outer reference electrode potentials) are linearly dependent on the logarithm of the activity of a given ion in solution. Comment: The term 'ion-specific electrode' is not recommended. The term 'specific' implies that the electrode does not respond to additional ions. Since no electrode is truly specific for one ion, the term 'ion-selective' is recommended as more appropriate. 'Selective ion-sensitive electrode' is a little-used term to describe an ion-selective electrode. 'Principal' or 'primary' ions are those which an electrode is designed to measure. It is never certain that the 'principal' ion is most sensitively measured, e.g. nitrate ion-selective electrodes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-selective electrode" .

goldbook:I03245 a skos:Concept ;
    skos:definition "An ion-selective electrode in conjunction with a reference electrode. Generally, the cell contains two reference electrodes, internal and external, and the thin film or membrane recognition-transduction element. However, besides this conventional type of cell (with solution contact on both sides of the membrane) there are cell arrangements with wire contact to one side of the membrane (all solid state and coated wire types)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-selective electrode cell" .

goldbook:I03247 a skos:Concept ;
    skos:definition "Generally an assembly composed of: (i) an ionization chamber in which a stream of electrons flows from a hot filament across a stream of gas to collector (the potential between filament and collector is usually between 50 and 70 \\(\\rm{V}\\)); (ii) a device for the acceleration of these ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion source" .

goldbook:I03249 a skos:Concept ;
    skos:definition "An arrangement in which ions with a desired range of quotients mass/charge are first made to describe stable paths under the effect of a high-frequency electric quadrupole field, and are then separated and presented to a detector by adjusting the field so as to selectivity induce path instability according to their respective mass/charge ratios." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion trap mass spectrometer" .

goldbook:I03251 a skos:Concept ;
    skos:definition "The attachment of an entering group to a position in an aromatic compound already carrying a substituent group (other than hydrogen). The entering group may displace that substituent group but may also itself be expelled or migrate to a different position in a subsequent step. The term 'ipso-substitution' is not used, since it is synonymous with substitution. For example:   where E + is an electrophile and Z is a substituent (other than hydrogen)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>ipso</i>-attack" .

goldbook:I03253 a skos:Concept ;
    skos:definition "Cyclic monoterpenoids having the iridane skeleton (1-isopropyl-2,3-di-methylcyclopentane), the traditional, but not undisputed, numbering of which is shown in the diagram." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iridoids" .

goldbook:I03254 a skos:Concept ;
    skos:definition "Radiant power, \\(P\\), of all wavelengths incident from all upward directions on a small element of surface containing the point under consideration divided by the area of the element. SI unit is \\(\\rm{W m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irradiance" .

goldbook:I03255 a skos:Concept ;
    skos:definition "Exposure to ionizing radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irradiation" .

goldbook:I03256 a skos:Concept ;
    skos:definition "A macromolecule the structure of which essentially comprises the repetition of more than one type of constitutional unit or a macromolecule the structure of which comprises constitutional units not all connected identically with respect to directional sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irregular macromolecule" .

goldbook:I03257 a skos:Concept ;
    skos:definition "A polymer composed of irregular macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irregular polymer" .

goldbook:I03258 a skos:Concept ;
    skos:definition "A transition that changes the state of a system which cannot be readily reversed to restore the system to its original state. Example: The conversion of $\\ce{TiO2}$ (anatase) to $\\ce{TiO2}$ (rutile)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "irreversible transition" .

goldbook:I03260 a skos:Concept ;
    skos:definition "Lines on a plot joining points of equal barometric pressure in the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isobar" .

goldbook:I03262 a skos:Concept ;
    skos:definition "Chromatographic separation carried out using constant inlet and outlet pressure conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isobaric separation" .

goldbook:I03265 a skos:Concept ;
    skos:definition "A wavelength, wavenumber, or frequency at which the first derivative of an absorption spectrum of a sample does not change upon a chemical reaction or physical change of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoclinic point" .

goldbook:I03267 a skos:Concept ;
    skos:definition "Isocoumarin (1H-isochromen-1-one) and its derivatives formed by substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isocoumarins" .

goldbook:I03268 a skos:Concept ;
    skos:definition "A procedure in which the composition of the mobile phase remains constant during the elution process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isocratic analysis" .

goldbook:I03269 a skos:Concept ;
    skos:definition "The isocyanic acid tautomer, $\\ce{HN=C=O}$, of cyanic acid, $\\ce{HOC≡N}$ and its hydrocarbyl derivatives RN=C=O." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isocyanates" .

goldbook:I03270 a skos:Concept ;
    skos:altLabel "isonitriles" ;
    skos:definition "The isomer $\\ce{HN+\\!#C^{-}}$ of hydrocyanic acid, $\\ce{HC#N}$, and its hydrocarbyl derivatives $\\ce{RNC}$ ($\\ce{RN^{+}\\!#C^{-}}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isocyanides" .

goldbook:I03271 a skos:Concept ;
    skos:definition "A less preferred synonym for homocyclic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isocyclic compounds" .

goldbook:I03272 a skos:Concept ;
    skos:definition "A reaction (actual or hypothetical) in which the types of bonds that are made in forming the products are the same as those which are broken in the reactants, e.g.   Such processes have advantages for theoretical treatment. The Hammett equation as applied to equilibria [cf. (a)] essentially deals with isodesmic processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isodesmic reaction" .

goldbook:I03273 a skos:Concept ;
    skos:altLabel "azamines",
        "diazanylidenes",
        "hydrazinylidenes" ;
    skos:definition "Compounds having the structure . These compounds can also be called diazanylidenes or hydrazinylidenes. They have also been called by the trivial name azamines and the incorrectly formed name 1,1-diazenes. They should not be called 'aminonitrenes'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isodiazenes" .

goldbook:I03274 a skos:Concept ;
    skos:definition "A macro-ion of a polyampholyte (in particular a protein) is said to be isoelectric if it exhibits no electrophoresis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoelectric" .

goldbook:I03275 a skos:Concept ;
    skos:definition "The \\(\\rm{pH}\\) value at which the net electric charge of an elementary entity is zero. \\(\\rm{pI}\\) is a commonly used symbol for this kind-of-quantity. It should be replaced by \\(\\rm{pH(I)}\\) because it is a \\(\\rm{pH}\\) determined under that particular condition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoelectric point" .

goldbook:I03276 a skos:Concept ;
    skos:definition "Two or more molecular entities are described as isoelectronic if they have the same number of valence electrons and the same structure, i.e. number and connectivity of atoms, but differ in some of the elements involved. Thus: $\\ce{CO}$, $\\ce{N2}$ and $\\ce{NO^{+}}$ are isoelectronic. $\\ce{CH2=C=O}$ and $\\ce{CH2=N=N}$ are isoelectronic. $\\ce{CH3COCH3}$ and $\\ce{CH3N=NCH3}$ have the same number of electrons, but have different structures, hence they are not described as isoelectronic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoelectronic" .

goldbook:I03277 a skos:Concept ;
    skos:definition "Wavelength, wavenumber or frequency at which the total intensity of emission of light by a sample does not change during a chemical reaction or physical change. The terms isolampsic and isostilbic are sometimes used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoemissive point" .

goldbook:I03278 a skos:Concept ;
    skos:definition "A reaction series is said to be isoentropic if the individual reactions of the series have the same standard entropy of activation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoentropic" .

goldbook:I03279 a skos:Concept ;
    skos:definition "One of a group of related enzymes catalysing the same reaction but having different molecular structures and characterized by varying physical, biochemical and immunological properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoenzyme" .

goldbook:I03280 a skos:Concept ;
    skos:definition "A relationship analogous to the isokinetic relationship but applied to equilibrium data. The equation defining the isoequilibrium temperature \\(\\beta \\) is: \\[\\Delta _{\\rm{r}}H - \\beta\\ \\Delta _{\\rm{r}}S = \\rm{constant}\\] where \\(\\Delta H\\) and \\(\\Delta S\\) are enthalpy and entropy of reaction, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoequilibrium relationship" .

goldbook:I03282 a skos:Concept ;
    skos:definition "A macro-ion of a polyampholyte (in particular a protein) is said to be isoionic if besides the polyampholyte and $\\ce{H^{+}}$ or $\\ce{OH^{−}}$ ions (in general ions of the solvent) no other ions are present in the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoionic" .

goldbook:I03283 a skos:Concept ;
    skos:definition "The \\(\\rm{pH}\\) value at which the net electric charge of an elementary entity in pure water equals zero." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoionic point" .

goldbook:I03284 a skos:Concept ;
    skos:definition "A line in a given surface connecting points with equal wind speed; also called isotach or isovel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isokinetic line" .

goldbook:I03285 a skos:Concept ;
    skos:definition "When a series of structurally related substrates undergo the same general reaction or when the reaction conditions for a single substrate are changed in a systematic way, the enthalpies and entropies of activation sometimes satisfy the relation: \\[\\Delta ^{\\ddagger}H - \\beta \\ \\Delta ^{\\ddagger }S = \\rm{constant}\\] where the parameter \\(\\beta \\) is independent of temperature. This equation (or some equivalent form) is said to represent an 'isokinetic relationship'. The temperature \\(T=\\beta \\) (at which all members of a series obeying the isokinetic relationship react at the same rate) is termed the 'isokinetic temperature'. Supposed isokinetic relationships as established by direct correlation of \\(\\Delta ^{\\ddagger}H\\) with \\(\\Delta ^{\\ddagger}S\\) are often spurious and the calculated value of \\(\\beta \\) is meaningless, because errors in \\(\\Delta ^{\\ddagger}H\\) lead to compensating errors in \\(\\Delta ^{\\ddagger}S\\). Satisfactory methods of establishing such relationships have been devised." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isokinetic relationship" .

goldbook:I03286 a skos:Concept ;
    skos:definition "A technique for collecting airborne particulate in which the sampling device has a collection efficiency of unity for all sizes of particles in sampled air, regardless of wind velocity and direction of the instrument. The air stream entering the collector has a velocity (speed and direction) equal to that of the air in the gas stream just ahead of the sampling port of the collector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isokinetic sampling" .

goldbook:I03288 a skos:Concept ;
    skos:definition "The term is used to compare molecular fragments with each other and with familiar species from organic chemistry. Two fragments are isolobal if the number, symmetry properties, approximate energy and shape of the frontier orbitals and the number of electrons in them are similar." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isolobal" .

goldbook:I03289 a skos:Concept ;
    skos:definition "One of several species (or molecular entities) that have the same atomic composition (molecular formula) but different line formulae or different stereochemical formulae and hence different physical and/or chemical properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomer" .

goldbook:I03290 a skos:Concept ;
    skos:definition "Enzymes that catalyse intramolecular rearrangements. Isomerases are classified into racemases and epimerases, cis-trans isomerases, intramolecular lyases and other isomerases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomerases" .

goldbook:I03291 a skos:Concept ;
    skos:definition "Adjective derived from isomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomeric" .

goldbook:I03292 a skos:Concept ;
    skos:definition "A nuclear state having a mean lifetime long enough to be observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomeric state" .

goldbook:I03293 a skos:Concept ;
    skos:definition "A spontaneous transition between two isomeric states of a nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomeric transition" .

goldbook:I03294 a skos:Concept ;
    skos:definition "The relationship between isomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomerism" .

goldbook:I03295 a skos:Concept ;
    skos:definition "A chemical reaction, the principal product of which is isomeric with the principal reactant. An intramolecular isomerization that involves the breaking or making of bonds is a special case of a molecular rearrangement. Isomerization does not necessarily imply molecular rearrangement (e.g. in the case of the interconversion of conformational isomers)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomerization" .

goldbook:I03296 a skos:Concept ;
    skos:definition "Measure of the energy difference between the source (\\(E_{\\rm{s}}\\)) and the absorber (\\(E_{\\rm{a}}\\)) transition. The measured Doppler velocity shift, \\(\\delta \\), is related to the energy difference by \\[E_{\\rm{a}}- E_{\\rm{s}}=\\frac{\\delta \\ E_{\\gamma }}{c}\\] where \\(E_{\\gamma }\\) is the Mössbauer gamma energy and \\(c\\) is the speed of light in vacuum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomer shift" .

goldbook:I03298 a skos:Concept ;
    skos:definition "Two molecular entities that are superposable or can be made superposable by reflection of one of them in a mirror are isometric; otherwise they are anisometric." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isometric" .

goldbook:I03302 a skos:Concept ;
    skos:definition "Wavelength, wavenumber or frequency at which the total energy emitted by a sample as heat does not change upon a chemical reaction in or a physical change of the sample. Its position depends on the experimental conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isooptoacoustic point" .

goldbook:I03304 a skos:Concept ;
    skos:definition "For an ion-selective electrode cell, there is often a particular activity of the measured ion for which the emf of the cell is independent of temperature. That activity, and the corresponding potential difference, defines the isopotential point. The specification of the ion-selective electrode and outer reference electrode must be described. Comment: When an isothermal cell is used with identical reference electrodes, the isopotential point is the activity of sensed species that gives zero net membrane potential, e.g. sensed activity is the same in the inner and outer (test) solution. Calibration lines for different cell temperatures have different slopes, but intersect at a common activity point. Cells with temperature gradients are not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isopotential point" .

goldbook:I03306 a skos:Concept ;
    skos:definition "Compounds formally derived from isoprene (2-methylbuta-1,3-diene), the skeleton of which can generally be discerned in repeated occurrence in the molecule. The skeleton of isoprenoids may differ from strict additivity of isoprene units by loss or shift of a fragment, commonly a methyl group. The class includes both hydrocarbons and oxygenated derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoprenoids" .

goldbook:I03308 a skos:Concept ;
    skos:altLabel "isoconfertic separation" ;
    skos:definition "Chromatographic separations carried out using constant density conditions. The temperature and pressure may be altered during the run (originally the term 'isoconfertic separation' was used but this term is not recommended)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isopycnic separation" .

goldbook:I03310 a skos:Concept ;
    skos:altLabel "isoabsorption point" ;
    skos:definition "Wavelength, wavenumber or frequency at which the total absorbance of a sample does not change during a chemical reaction or a physical change of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isosbestic point" .

goldbook:I03311 a skos:Concept ;
    skos:definition "A relationship analogous to the isokinetic relationship, but applied to selectivity data of reactions. At the isoselective temperature, the selectivities of the series of reactions following the relationship are identical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoselective relationship" .

goldbook:I03312 a skos:Concept ;
    skos:definition "Selenium analogues of isocyanates $\\ce{RN=C=Se}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoselenocyanates" .

goldbook:I03313 a skos:Concept ;
    skos:definition "When the addition of the differential amount of component \\(i\\) \\(\\mathrm{d}n_{i}^{\\sigma }\\) or \\(\\mathrm{d}n_{i}^{\\rm{s}}\\) is effected at constant pressure \\(p\\), the differential molar enthalpy of adsorption, \\(\\Delta _{a}H_{i}^{\\sigma}\\) or \\(\\Delta _{a}H_{i}^{\\rm{s}}\\) also called the isosteric enthalpy of adsorption (\\(q^{\\rm{st}}\\)) is defined as: \\[\\Delta _{a}H_{i}^{\\sigma} = -q^{\\rm{st},\\sigma} = U_{i}^{\\sigma} - H_{i}^{\\rm{g}}\\] \\[\\Delta _{a}H_{i}^{\\rm{s}} = -q^{\\rm{st},\\sigma} = H_{i}^{\\sigma} - H_{i}^{\\rm{g}}\\] where \\(H_{i}^{\\rm{s}}=(\\frac{\\partial H^{\\rm{s}}}{\\partial n_{i}^{\\rm{s}}})_{T,p,m,n_{j}^{\\rm{s}}}\\) and \\(H_{i}^{\\rm{g}}\\) is the partial molar enthalpy of component \\(i\\) in the gas phase, i.e. \\((\\frac{\\partial H^{\\rm{g}}}{\\partial n_{i}^{\\rm{g}}})_{T,p,n_{i}^{\\rm{g}}}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isosteric enthalpy of adsorption" .

goldbook:I03314 a skos:Concept ;
    skos:definition "Same as isoemissive point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isostilbic point" .

goldbook:I03315 a skos:Concept ;
    skos:definition "A tactic macromolecule, essentially comprising only one species of configurational base unit, which has chiral or prochiral atoms in the main chain in a unique arrangement with respect to its adjacent constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotactic macromolecule" .

goldbook:I03316 a skos:Concept ;
    skos:definition "A polymer composed of isotactic macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotactic polymer" .

goldbook:I03318 a skos:Concept ;
    skos:definition "Lines joining points of equal temperature in the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotherm" .

goldbook:I03319 a skos:Concept ;
    skos:definition "A procedure in which the temperature of the column is kept constant during the separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isothermal chromatography" .

goldbook:I03320 a skos:Concept ;
    skos:definition "Sulfur analogues of isocyanates $\\ce{RN=C=S}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isothiocyanates" .

goldbook:I03321 a skos:Concept ;
    skos:definition "Nuclides having the same neutron number but different atomic numbers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotones" .

goldbook:I03322 a skos:Concept ;
    skos:definition "Mixing of a given nuclide with one or more of its isotopes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope dilution" .

goldbook:I03323 a skos:Concept ;
    skos:definition "A kind of quantitative analysis based on the measurement of the isotopic abundance of a nuclide after isotope dilution with the test portion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope dilution analysis" .

goldbook:I03327 a skos:Concept ;
    skos:definition "The effect on the rate or equilibrium constant of two reactions that differ only in the isotopic composition of one or more of their otherwise chemically identical components is referred to as a kinetic isotope effect or a thermodynamic (or equilibrium) isotope effect, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope effect" .

goldbook:I03328 a skos:Concept ;
    skos:definition "A chemical reaction in which the reactant and product chemical species are chemically identical but have different isotopic composition. In such a reaction the isotope distribution tends towards equilibrium (as expressed by fractionation factors) as a result of transfers of isotopically different atoms or groups. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope exchange" .

goldbook:I03329 a skos:Concept ;
    skos:definition "A kind of quantitative analysis based on the isotope exchange between isotopes of the element to be determined and other isotopes of this element in different valency states or in different molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope exchange analysis" .

goldbook:I03330 a skos:Concept ;
    skos:definition "Set of peaks related to ions with the same chemical formula but containing different isotopes; e.g. the 16 and 17 mass/charge peaks in a $\\ce{CH4}$ sample arising from $\\ce{^{12}CH4^{+}}$ and $\\ce{^{13}CH4^{+}}$ ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotope pattern" .

goldbook:I03331 a skos:Concept ;
    skos:definition "Nuclides having the same atomic number but different mass numbers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopes" .

goldbook:I03332 a skos:Concept ;
    skos:definition "The relative number of atoms of a particular isotopes in a mixture of the isotopes of an element, expressed as a fraction of all the atoms of the element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic abundance" .

goldbook:I03334 a skos:Concept ;
    skos:definition "An isotopically labelled compound may be designated as isotopically deficient when the isotopic content of one or more elements has been depleted, i.e. when one or more nuclide(s) is (are) present in less than a natural ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopically deficient" .

goldbook:I03335 a skos:Concept ;
    skos:definition "When the abundance of a particular nuclide is increased above the level at which it occurs in nature and is incorporated in a molecule, the term 'isotopically enriched ion' is used to describe any ion enriched in the isotope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopically enriched ions" .

goldbook:I03336 a skos:Concept ;
    skos:definition "Describes a mixture of an isotopically unmodified compound with one or more analogous isotopically substituted compound(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopically labelled" .

goldbook:I03337 a skos:Concept ;
    skos:definition "Describes a compound that has a macroscopic composition such that the isotopic ratio of nuclides for at least one element deviates measurably from that occurring in nature. It is either an isotopically substituted compound or an isotopically labelled compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopically modified" .

goldbook:I03338 a skos:Concept ;
    skos:definition "Describes a compound that has a composition such that essentially all the molecules of the compound have only the indicated nuclide at each designated position. For all other positions, the absence of nuclide indication means that the nuclide composition is the natural one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopically substituted" .

goldbook:I03339 a skos:Concept ;
    skos:definition "Describes a compound that has a macroscopic composition such that its constituent nuclides are present in the proportions occurring in nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopically unmodified" .

goldbook:I03340 a skos:Concept ;
    skos:definition "A carrier which differs only in isotopic composition from the trace it has to carry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic carrier" .

goldbook:I03341 a skos:Concept ;
    skos:definition "Any process by which the isotopic abundance of a specified isotopes in a mixture of isotopes of an element is increased." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic enrichment" .

goldbook:I03342 a skos:Concept ;
    skos:definition "For a material enriched in a specified isotope, the ratio between the isotopic abundance and the natural abundance of that isotope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic enrichment factor" .

goldbook:I03343 a skos:Concept ;
    skos:definition "The ratio \\[\\frac{(x_{1}/x_{2})_{\\rm{A}}}{(x_{1}/x_{2})_{\\rm{B}}}\\] where \\(x\\) is the abundance, expressed as the atom fraction of the isotope distinguished by the subscript numeral, when the two isotopes are equilibrated between two different chemical species $\\ce{A}$ and $\\ce{B}$ (or between specific sites A and B in the same or different chemical species). The term is most commonly met in connection with deuterium solvent isotope effects, when the fractionation factor \\(\\mathit{\\Phi}\\) expresses the ratio: \\[\\varPhi = \\frac{(x_{\\rm{D}}/x_{\\rm{H}})_{\\rm{solute}}}{(x_{\\rm{D}}/x_{\\rm{H}})_{\\rm{solvent}}}  \\] for the exchangeable hydrogen atoms in the chemical species (or sites) concerned. The concept is also applicable to transition states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic fractionation factor" .

goldbook:I03344 a skos:Concept ;
    skos:definition "Any ion containing one or more of the less abundant naturally occurring isotopes of the elements that make up its structure, e.g. $\\ce{CH2D^{+}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic ion" .

goldbook:I03345 a skos:Concept ;
    skos:definition "Labelling in which the resulting product is only different from the initial one by its isotopic composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic labelling" .

goldbook:I03346 a skos:Concept ;
    skos:definition "A molecular ion containing one or more of the less abundant naturally occurring isotopes of the atoms that make up the molecular structure. Thus, for ethyl bromide there exist isotopic molecular ions such as: $\\ce{^{13}CCH5Br^{+.}}$, $\\ce{C2H4DBr^{+.}}$, $\\ce{C2H5^{81}Br^{+.}}$, $\\ce{^{13}C2H5^{81}Br^{+.}}$, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic molecular ion" .

goldbook:I03348 a skos:Concept ;
    skos:altLabel "scrambling" ;
    skos:definition "The achievement, or the process of achieving, an equilibrium distribution of isotopes within a specified set of atoms in a chemical species or group of chemical species (for an example, see diagram)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic scrambling" .

goldbook:I03349 a skos:Concept ;
    skos:definition "An operation for the purpose of modifying an isotopic abundance in a mixture of isotopes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic separation" .

goldbook:I03350 a skos:Concept ;
    skos:definition "A tracer which only differs in isotopic composition from the substance to be traced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopic tracer" .

goldbook:I03351 a skos:Concept ;
    skos:definition "A molecular entity that differs only in isotopic composition (number of isotopic substitutions), e.g. $\\ce{CH4}$, $\\ce{CH3D}$, $\\ce{CH2D2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopologue" .

goldbook:I03352 a skos:Concept ;
    skos:definition "Isomers having the same number of each isotopic atom but differing in their positions. The term is a contraction of 'isotopic isomer'. Isotopomers can be either constitutional isomers (e.g. $\\ce{CH2DCH=O}$ and $\\ce{CH3CD=O}$) or isotopic stereoisomers [e.g. $\\ce{(\\textit{R})-}$ and $\\ce{(\\textit{S})-CH3CHDOH}$ or $\\ce{(\\textit{Z})-}$ and $\\ce{(\\textit{E})-CH3CH=CHD}$]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotopomer" .

goldbook:I03353 a skos:Concept ;
    skos:definition "A quantity which is independent of direction. Anisotropic and nonisotropic refer to quantities which are direction dependent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotropic" .

goldbook:I03354 a skos:Concept ;
    skos:definition "A monolithic carbon material without preferred crystallographic orientation of the microstructure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotropic carbon" .

goldbook:I03355 a skos:Concept ;
    skos:definition "Carbon fibres obtained by carbonization of isotropic pitch fibres after these have been stabilized (i.e. made non-fusible)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isotropic pitch-based carbon fibres" .

goldbook:I03356 a skos:Concept ;
    skos:definition "The imidic acid tautomer of urea, $\\ce{H2NC(=NH)OH}$, and its hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoureas" .

goldbook:IT06772 a skos:Concept ;
    skos:definition "A compound which can carry specific ions through membranes of cells or organelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionophore" .

goldbook:IT06773 a skos:Concept ;
    skos:definition "Ion pumps enable ions to flow through membranes in a thermodynamically uphill direction by the use of an energy source such as ATP or light. They consist of sugar-containing hetero-peptide assemblies, which open and close upon the binding and subsequent hydrolysis of ATP, usually transporting more than one ion towards the outside or the inside of the membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion pumps" .

goldbook:IT06779 a skos:Concept ;
    skos:definition "A unit comprising two or more iron atoms and bridging sulfur ligands in an iron-sulfur protein. The recommended designation of a cluster consists of the iron and sulfur content, in square brackets, for example, $\\ce{[2\\! Fe-2\\! S]}$, $\\ce{[3\\! Fe-4\\! S]}$. The possible oxidation levels are indicated by the net charge excluding the ligands, for example $\\ce{[4\\! Fe-4\\! S]^{2+}}$; $\\ce{[4\\! Fe-4\\! S]^{+}}$ or ($\\ce{[4\\! Fe-4\\! S]^{2+;1+}}$) cluster." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iron-sulfur cluster" .

goldbook:IT06780 a skos:Concept ;
    skos:definition "Proteins in which non-haem iron is coordinated with cysteine sulfur and usually also with inorganic sulfur. Divided into three major categories: rubredoxins; 'simple iron-sulfur proteins', containing only iron-sulfur clusters; and 'complex iron-sulfur proteins', containing additional active redox centres such as flavin, molybdenum or haem. In most iron-sulfur proteins, the clusters function as electron-transfer groups, but in others they have other functions, such as catalysis of hydratase/dehydratase reactions, maintenance of protein structure, or regulation of activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "iron-sulfur proteins" .

goldbook:IT06828 a skos:Concept ;
    skos:definition "Number of occurrences of illness commencing, or of persons falling ill, during a given period in a specific population: usually expressed as a rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "incidence" .

goldbook:IT06941 a skos:Concept ;
    skos:definition "Chromatographic process, where no peak-broadening effects (such as diffusion, slow mass transfer, etc.) operate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal chromatography" .

goldbook:IT06944 a skos:Concept ;
    skos:definition "Chromatographic process, where only the curvature of the distribution isotherm determines the shape of the peaks while other peak-broadening processes are neglected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ideal, non-linear chromatography" .

goldbook:IT07055 a skos:Concept ;
    skos:altLabel "IGLO" ;
    skos:definition "A method of calculation of nuclear shieldings, in which localized molecular orbitals associated with inner shell, bonding orbitals, and lone pairs have unique origins for the calculation of diamagnetic and paramagnetic terms. With this method, satisfactory estimates of NMR chemical shifts for elements in the first and second rows can be achieved in ab initio calculations with basis sets of moderate size provided sufficiently accurate molecular geometries are used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "individual gauge for localized orbitals" .

goldbook:IT07056 a skos:Concept ;
    skos:definition "Existence of additional solutions to the equations of the Hartree–Fock method occurring usually in the case when potential energy surfaces of different electronic states are drawn close together. Within the spin-restricted Hartree–Fock method (RHF), singlet and triplet instabilities are distinguished. The former involves the existence of another solution with lower energy and the electron distribution of lower symmetry. It may be regarded as an indication that the initially assumed molecular shape needs correction. The triplet instability involves rejection of the condition of double occupancy of molecular orbitals and thus transition to the spin-unrestricted Hartree–Fock method (UHF). The triplet instability is a necessary, but insufficient, condition for the conclusion as to the biradical character of the ground state of a given system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "instability of Hartree–Fock solution" .

goldbook:IT07057 a skos:Concept ;
    skos:definition "A minimum-energy reaction path on a potential energy surface in mass-weighted coordinates, connecting reactants to products via the transition state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsic reaction coordinate" .

goldbook:IT07058 a skos:Concept ;
    skos:definition "The bond between atoms with sharply different electronegativities. In strict terms, an ionic bond refers to the electrostatic attraction experienced between the electric charges of a cation and an anion, in contrast with a purely covalent bond. In practice, it is preferable to consider the amount of ionic character of a bond rather than referring to purely ionic or purely covalent bonds. The relationship was proposed (L. Pauling) for the estimation of ionic character of a bond between atoms A and B: \\[\\rm{Amount of ionic character} = 1 - e^{-1/4}\\ (\\chi _{\\rm{A}}\\,-\\,\\chi_{\\rm{B}})\\] where \\(\\chi _{\\rm{A}}\\) and \\(\\chi _{\\rm{B}}\\) are the Pauling electronegativities of atoms A and B. This type of bonding is realized mostly in solids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic bond" .

goldbook:IT07059 a skos:Concept ;
    skos:definition "Molecular entities with similar conjugate networks which have the same number of $\\ce{\\uppi\\!\\mbox{-}electrons}$, e.g. cyclopentadienide anion and pyrrole or benzene and pyridine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isoconjugate systems" .

goldbook:IT07060 a skos:Concept ;
    skos:definition "A reaction in which the number of electron pairs is conserved, for example:  $$\\ce{CH4(^{1}\\textit{A}_{1}) + H(^{2}\\textit{S}) -> CH3(^{2}\\textit{A}^{'}_{2}) + H2(^{1}\\Sigma^{+}_{\\rm{g}})}$$" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isogyric reaction" .

goldbook:IT07061 a skos:Concept ;
    skos:definition "A ligand exchange reaction, where the structural type of the metal complex remains the same. $$\\ce{ML_{n} + X -> ML_{n-1}X + L + \\Delta\\textit{E}}$$ Although these types of reactions are not necessarily isodesmic reactions, a substantial degree of error cancellation for the calculated energy, $\\Delta E$, is achieved because the coordination sphere of the metal atom $\\ce{M}$ is conserved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isostructural reaction" .

goldbook:IT07139 a skos:Concept ;
    skos:definition "Reaction that results in an exchange of atoms or groups between a polymer and low-molar-mass molecules, between polymer molecules, or between sites within the same macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interchange reaction" .

goldbook:IT07155 a skos:Concept ;
    skos:definition "Polymer that is able to exchange ions (cations or anions) with ionic components in solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ion-exchange polymer" .

goldbook:IT07175 a skos:Concept ;
    skos:definition "Polymeric material whose impact resistance and toughness have been increased by the incorporation of phase microdomains of a rubbery material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impact-modified polymer" .

goldbook:IT07208 a skos:Concept ;
    skos:definition "Electrically conducting polymer composed of macromolecules having fully conjugated sequences of double bonds along the chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intrinsically conducting polymer" .

goldbook:IT07210 a skos:Concept ;
    skos:definition "Polymer composed of macromolecules in which ionized or ionic groups are parts of main chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionene" .

goldbook:IT07212 a skos:Concept ;
    skos:definition "Domains enriched with ionic groups within an ionomer matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic aggregates in an ionomer" .

goldbook:IT07213 a skos:Concept ;
    skos:altLabel "ion-containing polymer" ;
    skos:definition "Polymer composed of macromolecules containing ionic or ionizable groups, or both, irrespective of their nature, content, and location. Synonym: ion-containing polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionic polymer" .

goldbook:IT07215 a skos:Concept ;
    skos:definition "Ionic aggregate, in a polymer matrix of low polarity, formed through interactions of ionomer multiplets." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionomer cluster" .

goldbook:IT07216 a skos:Concept ;
    skos:definition "Ionic aggregate, in a polymer matrix of low polarity, formed through the association of ion-pairs in an ionomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ionomer multiplet" .

goldbook:IT07233 a skos:Concept ;
    skos:definition "Polymer blend of two or more different semi-crystalline polymers that are miscible in the crystalline state as well as in the molten state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isomorphic polymer blend" .

goldbook:IT07239 a skos:Concept ;
    skos:definition "Inability of a mixture to form a single phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immiscibility" .

goldbook:IT07240 a skos:Concept ;
    skos:altLabel "heterogeneous polymer blend" ;
    skos:definition "Polymer blend that exhibits immiscibility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "immiscible polymer blend" .

goldbook:IT07246 a skos:Concept ;
    skos:definition "Penetration of monomeric, oligomeric, or polymeric liquids into an assembly of fibres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "impregnation" .

goldbook:IT07248 a skos:Concept ;
    skos:definition "Process by which a substance becomes transferred into pre-existing spaces of molecular dimensions in a second substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intercalation" .

goldbook:IT07253 a skos:Concept ;
    skos:definition "Adhesion in which interfaces between phases or components are maintained by intermolecular forces, chain entanglements, or both, across the interfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "interfacial adhesion" .

goldbook:IT07396 a skos:Concept ;
    skos:definition "Frequently used acronym for internal conversion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "IC" .

goldbook:IT07397 a skos:Concept ;
    skos:altLabel "ICT" ;
    skos:definition "Acronym for intramolecular charge transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ICT" .

goldbook:IT07398 a skos:Concept ;
    skos:altLabel "ICT emission" ;
    skos:definition "Electronic emission from an ICT state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramolecular charge transfer emission" .

goldbook:IT07399 a skos:Concept ;
    skos:definition "Region of the electromagnetic spectrum extending from \\(780\\ \\rm{nm}\\) to about \\(20\\,000\\ \\rm{nm}\\).According to the CIE, the range between \\(780\\ \\rm{nm}\\) and \\(1\\ \\rm{mm}\\) is subdivided into:IR-A \\(780\\)–\\(1400\\ \\rm{nm}\\)IR-B \\(1.4\\)–\\(3\\ \\unicode[times]{x3BC}\\rm{m}\\)IR-C \\(3\\ \\unicode[times]{x3BC}\\rm{m}\\)–\\(1\\ \\rm{mm}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "infrared" .

goldbook:IT07400 a skos:Concept ;
    skos:definition "(3N − 8)-dimensional subspace of the (3N − 6)-dimensional nuclear coordinate space consisting of an infinite number of conical intersection points (N is the number of nuclei)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intersection space" .

goldbook:IT07401 a skos:Concept ;
    skos:altLabel "ICT" ;
    skos:definition "Process that changes the overall charge distribution in a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "intramolecular charge transfer" .

goldbook:IT07403 a skos:Concept ;
    skos:altLabel "ISC" ;
    skos:definition "Frequently used acronym for intersystem crossing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ISC" .

goldbook:IT07404 a skos:Concept ;
    skos:definition "Same as isoemissive point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isolampsic point" .

goldbook:IT07514 a skos:Concept ;
    skos:altLabel "IOP" ;
    skos:definition "Polymer or polymer network with a skeletal structure comprising inorganic and organic units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inorganic–organic polymer" .

goldbook:IT07515 a skos:Concept ;
    skos:definition "Polymer or polymer network with a skeletal structure that does not include carbon atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "inorganic polymer" .

goldbook:IT07624 a skos:Concept ;
    skos:definition "Process for preparing a polymer composite by  forming the filler or reinforcement in an existing polymer or  polymerizing monomers in the presence of dispersed filler." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>in situ</i> composite formation" .

goldbook:IT07625 a skos:Concept ;
    skos:definition "Application of a hydrostatic pressure through a liquid to achieve densification prior to the production of a uniform compact monolith through ceramization of the densified liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "isostatic pressing" .

goldbook:J03359 a skos:Concept ;
    skos:definition "An effective first order rate constant for a photochemical reaction (photodecomposition, etc.) of light-absorbing impurities in the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>j</i>-value" .

goldbook:J03360 a skos:Concept ;
    skos:definition "Originally, a diagram showing that the fluorescent state of a molecular entity is the lowest excited state from which the transition to the ground state is allowed, whereas the phosphorescent state is a metastable state below the fluorescent state, which is reached by radiationless transition. In the most typical cases the fluorescent state is the lowest singlet excited state and the phosphorescent state the lowest triplet state, the ground state being a singlet. Presently, modified Jablonski diagrams are frequently used and are actually state diagrams in which molecular electronic states, represented by horizontal lines displaced vertically to indicate relative energies, are grouped according to multiplicity into horizontally displaced columns. Excitation and relaxation processes that interconvert states are indicated in the diagram by arrows. Radiative transitions are generally indicated with straight arrows (→), while radiationless transitions are generally indicated with wavy arrows ⇝." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Jablonski diagram" .

goldbook:J03361 a skos:Concept ;
    skos:definition "Molecular distortions due to an electronically degenerate @G02704-1@ state. For non-linear molecular entities in a geometry described by a point symmetry group possessing degenerate irreducible representations there always exists at least one non-totally symmetric vibration that makes electronically degenerate states unstable at this geometry. The nuclei are displaced to new equilibrium positions of lower symmetry causing a splitting of the originally degenerate states (first-order Jahn–Teller effect)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Jahn–Teller effect" .

goldbook:J03362 a skos:Concept ;
    skos:definition "A displacive crystal distortion to lower symmetry that cooperatively removes a localized-electron orbital degeneracy at an array of like atoms so as to leave the atoms in the centre of symmetry of their distorted sites. Example: The crystallographic distortion in $\\ce{Mn3O4}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Jahn–Teller transition" .

goldbook:J03363 a skos:Concept ;
    skos:definition "SI derived unit of energy, \\(\\pu{J} = \\pu{N m} = \\pu{kg m2 s-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "joule" .

goldbook:J03364 a skos:Concept ;
    skos:definition "Branch point in a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "junction point" .

goldbook:J03365 a skos:Concept ;
    skos:definition "A non-repeating atom or non-repeating group of atoms between blocks in a block macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "junction unit" .

goldbook:JT07602 a skos:Concept ;
    skos:definition "Number of junction points per unit volume in a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "junction-point density" .

goldbook:K03366 a skos:Concept ;
    skos:altLabel "kappa" ;
    skos:definition "An affix in the name of a polydentate chelate complex indicating single ligating atom attachments of a polyatomic ligand to a coordination centre. A right superscript numerical index indicates the number of such attachments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "κ" .

goldbook:K03367 a skos:Concept ;
    skos:definition "Parameters of the Kamlet–Taft solvatochromic relationship which measure separately the hydrogen bond donor ($\\ce{\\upalpha\\!}$), hydrogen bond acceptor ($\\ce{\\upbeta\\!}$), and dipolarity/polarizability ($\\ce{\\uppi\\!^{\\ast}}$) properties of solvents as contributing to overall solvent polarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kamlet–Taft solvent parameters" .

goldbook:K03369 a skos:Concept ;
    skos:definition "Rules used to predict the sign of CIDNP effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kaptein–Closs rules" .

goldbook:K03370 a skos:Concept ;
    skos:definition "Polyatomic molecular entities luminesce with appreciable yield only from the lowest excited state of a given multiplicity. There are exceptions to this rule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kasha rule" .

goldbook:K03371 a skos:Concept ;
    skos:altLabel "Vavilov rule" ;
    skos:definition "The quantum yield of luminescence is independent of the wavelength of exciting radiation. There are exceptions to this rule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kasha–Vavilov rule" .

goldbook:K03372 a skos:Concept ;
    skos:definition "Unit for catalytic activity coherent with the SI, equal to the catalytic activity that catalyses a reaction rate of one mole per second in an assay system. \\(\\pu{1 kat} = \\pu{1 mol s-1}\\). The katal is recommended for use in the specific context of enzymes and clinical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "katal" .

goldbook:K03373 a skos:Concept ;
    skos:definition "A representation of an aromatic molecular entity (such as benzene), with fixed alternating single and double bonds, in which interactions between multiple bonds are assumed to be absent. For benzene:  are the Kekulé structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Kekulé structure" .

goldbook:K03376 a skos:Concept ;
    skos:definition "Acetals derived from ketones by replacement of the oxo group by two hydrocarbyloxy groups $\\ce{R2C(OR)2}$ ($\\ce{R}  eq \\ce{H}$). This term, once abandoned, has been reinstated as a subclass of acetals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketals" .

goldbook:K03377 a skos:Concept ;
    skos:definition "Azines of ketones $\\ce{R2C=NN=CR2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketazines" .

goldbook:K03378 a skos:Concept ;
    skos:definition "Compounds in which a carbonyl group is connected by a double bond to an alkylidene group $\\ce{R2C=C=O}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketenes" .

goldbook:K03379 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C=C=NR}$. Thus imino analogues of ketenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketenimines" .

goldbook:K03381 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C=NR'}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketimines" .

goldbook:K03383 a skos:Concept ;
    skos:definition "Monosaccharides in which a structure containing a keto group and a carboxylic acid group is in equilibrium with a hemiacetal structure. Specific compounds are named using the -ulosonic acid suffix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketoaldonic acids" .

goldbook:K03384 a skos:Concept ;
    skos:definition "Monosaccharides which contain both an aldehydic and a ketonic carbonyl group in equilibrium with intramolecular hemiacetal forms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketoaldoses" .

goldbook:K03385 a skos:Concept ;
    skos:definition "The term has imprecisely been used to designate carboxylic acyl carbenes. keto carbenes are carbenes bearing an oxo function at an unspecified site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "keto carbenes" .

goldbook:K03386 a skos:Concept ;
    skos:definition "Compounds in which a carbonyl group is bonded to two carbon atoms $\\ce{R2C=O}$ (neither $\\ce{R}$ may be $\\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketones" .

goldbook:K03387 a skos:Concept ;
    skos:definition "Ketonic parent sugars (polyhydroxyketones $\\ce{H–[CHOH]_{n}–C(=O)[CHOH]_{m}–H}$ with three or more carbon atoms) and their intramolecular hemiacetals. The oxo group is usually at $\\ce{C-2}$. E.g. ᴅ-fructose:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketoses" .

goldbook:K03388 a skos:Concept ;
    skos:definition "Oximes of ketones, $\\ce{R2C=NOH}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketoximes" .

goldbook:K03389 a skos:Concept ;
    skos:definition "Radical anions (or the corresponding salts) derived from ketones by addition of an electron $\\ce{R2C^{.}–O^{−}  R2C^{−}–O^{.}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ketyls" .

goldbook:K03392 a skos:Concept ;
    skos:definition "An attribute of phenomena, bodies or substances that may be distinguished qualitatively. Examples: Colour (value: green, blue), transparency, length (value: long, short; \\(2\\ \\rm{m}\\), \\(5\\ \\rm{m}\\)), amount-of-substance (value: \\(\\pu{2 mol}\\), \\(\\pu{5 mol}\\)). Kind-of-property includes the concept kind-of-quantity. All kinds-of-property may be related to nominal (e.g. green, blue) and ordinal scales (e.g. small, large), but kinds-of-quantity are generally related to difference [e.g. \\(10\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\) (i.e. \\(10\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\) more than an arbitrary zero)] or ratio scales (length \\(2\\ \\rm{m}\\) or \\(5\\ \\rm{m}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kind-of-property" .

goldbook:K03393 a skos:Concept ;
    skos:definition "Abstract property common to several real quantities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kind-of-quantity" .

goldbook:K03394 a skos:Concept ;
    skos:definition "The study of the properties of motion that are independent of the nature of the forces. In reaction dynamics the term is often applied in particular to effects that occur when atomic masses are changed, the forces remaining the same." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinematics" .

goldbook:K03395 a skos:Concept ;
    skos:definition "Dynamic viscosity divided by the density of the fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinematic viscosity" .

goldbook:K03396 a skos:Concept ;
    skos:definition "A factor involving activity coefficients that appears as a multiplier in the rate equation. For a bimolecular reaction the factor is \\[\\frac{y_{\\rm{A}}\\ y_{\\rm{B}}}{y_{\\ddagger}}\\] where \\(y_{\\rm{A}}\\), \\(y_{\\rm{B}}\\) and \\(y_{\\ddagger }\\) are the activity coefficients for the reactants A and B and the activated complex, respectively. For a unimolecular reaction the factor is \\[\\frac{y_{\\rm{A}}}{y_{\\ddagger}}\\] and for a trimolecular reaction it is \\[\\frac{y_{\\rm{A}}\\ y_{\\rm{B}}\\ y_{\\rm{C}}}{y_{\\ddagger}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic activity factor" .

goldbook:K03398 a skos:Concept ;
    skos:definition "The term characterizes conditions (including reaction times) that lead to reaction products in a proportion governed by the relative rates of the parallel (forward) reactions in which the products are formed, rather than by the respective overall equilibrium constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic control" .

goldbook:K03401 a skos:Concept ;
    skos:altLabel "kinetic ionic-strength effect",
        "kinetic salt effect",
        "salt effect" ;
    skos:definition "The general effect of an added electrolyte (i.e. an effect other than, or in addition to, that due to its possible involvement as a reactant or catalyst) on the observed rate constant of a reaction in solution. At low concentrations (when only long-range coulombic forces need to be considered) the effect on a given reaction is determined only by the ionic strength of the solution and not by the chemical identity of the ions. For practical purposes, this concentration range is roughly the same as the region of validity of the Debye–Hückel limiting law for activity coefficients. At higher concentrations, the effect of an added electrolyte depends also on the chemical identity of the ions. Such specific action can usually be interpreted as the incursion of a reaction path involving an ion of the electrolyte as reactant or catalyst, in which case the action is not properly to be regarded just as a kinetic electrolyte effect. Kinetic electrolyte effects are usually (too restrictively and therefore incorrectly) referred to as 'kinetic salt effects'. A kinetic electrolyte effect ascribable solely to the influence of the ionic strength on activity coefficients of ionic reactants and transition states is called a 'primary kinetic electrolyte effect'. A kinetic electrolyte effect arising from the influence of the ionic strength of the solution upon the pre-equilibrium concentration of an ionic species that is involved in a subsequent rate-limiting step of a reaction is called a 'secondary kinetic electrolyte effect'. A common case encountered in practice is the effect on the concentration of hydrogen ion (acting as catalyst) produced from the ionization of a weak acid in a buffer solution. Synonymous with kinetic equivalence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic electrolyte effect" .

goldbook:K03402 a skos:Concept ;
    skos:definition "Energy of motion: for a body of mass \\(m\\), \\[E_{\\rm{k}}=\\frac{m\\ v^{2}}{2}\\] where \\(v\\) is the speed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic energy" .

goldbook:K03403 a skos:Concept ;
    skos:altLabel "kinetic ambiguity" ;
    skos:definition "Two reaction schemes are kinetically equivalent if they imply the same rate law. For example, consider the two schemes (i) and (ii) for the formation of $\\ce{C}$ from $\\ce{A}$: \\[(\\rm{i}) \\qquad \\ce{A [k_{1},\\ce{OH^{-}}][k_{-1},\\ce{OH^{-}}] B ->[k_{2}] C}\\] Providing that $\\ce{B}$ does not accumulate as a reaction intermediate. \\[\\frac{\\rm{d}[\\ce{C}]}{\\rm{d}t} = \\frac{k_{1} k_{2}[\\ce{A}][\\ce{OH^{-}}]}{k_{2} + k_{-1} [\\ce{OH^{-}}]}\\] \\[(\\rm{ii}) \\qquad \\ce{A [k_{1}][k_{-1}] B ->[k_{2}][\\ce{OH^{-}}] C}\\] Providing that $\\ce{B}$ does not accumulate as a reaction intermediate: \\[\\frac{\\rm{d}[\\ce{C}]}{\\rm{d}t} = \\frac{k_{1} k_{2}[\\ce{A}][\\ce{OH^{-}}]}{k_{-1} + k_{2} [\\ce{OH^{-}}]}\\] Both equations for \\(\\frac{\\rm{d}[\\ce{C}]}{\\rm{d}t}\\) are of the form: \\[\\frac{\\rm{d}[\\ce{C}]}{\\rm{d}t} = \\frac{r [\\ce{A}][\\ce{OH^{-}}]}{1 + s [\\ce{OH^{-}}]}\\] where \\(r\\) and \\(s\\) are constants (sometimes called 'coefficients in the rate equation'). The equations are identical in their dependence on concentrations and do not distinguish whether $\\ce{OH^{−}}$ catalyses the formation of $\\ce{B}$, and necessarily also its reversion to $\\ce{A}$, or is involved in its further transformation to $\\ce{C}$. The two schemes are therefore kinetically equivalent under conditions to which the stated provisos apply." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic equivalence" .

goldbook:K03405 a skos:Concept ;
    skos:definition "The effect of isotopic substitution on a rate constant is referred to as a kinetic isotope effect. For example, in the reaction:  the effect of isotopic substitution in reactant $\\ce{A}$ is expressed as the ratio of rate constants \\(\\frac{k^{\\rm{l}}}{k^{\\rm{h}}}\\), where the superscripts \\(\\rm{l}\\) and \\(\\rm{h}\\) represent reactions in which the molecules $\\ce{A}$ contain the light and heavy isotopes, respectively. Within the framework of transition state theory in which the reaction is rewritten as:  and with neglect of isotopic mass on tunnelling and the transmission coefficient, \\(\\frac{k^{\\rm{l}}}{k^{\\rm{h}}}\\) can be regarded as if it were the equilibrium constant for an isotope exchange reaction between the transition state $\\ce{[TS]^{\\ddagger}}$ and the isotopically substituted reactant $\\ce{A}$, and calculated from their vibrational frequencies as in the case of a thermodynamic isotope effect. Isotope effects like the above, involving a direct or indirect comparison of the rates of reaction of isotopologues, are called 'intermolecular', in contrast to intramolecular isotope effects, in which a single substrate reacts to produce a non-statistical distribution of isotopomeric product molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic isotope effect" .

goldbook:K03406 a skos:Concept ;
    skos:definition "An analytical method in which the rate of a reaction or a related quantity is measured and utilized to determine concentrations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic method" .

goldbook:K03407 a skos:Concept ;
    skos:altLabel "asymmetric destruction" ;
    skos:definition "The achievement of partial or complete resolution by virtue of unequal rates of reaction of the enantiomers in a racemate with a chiral agent (reagent, catalyst, solvent, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "kinetic resolution" .

goldbook:K03410 a skos:Concept ;
    skos:definition "An affix used in names to designate a very open polyboron structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>klado</i>-" .

goldbook:K03411 a skos:Concept ;
    skos:definition "Directly relates experimental ionization potentials with energy levels of molecular orbitals. The theorem states that the ionization potential required to remove an electron from the orbital \\(\\Psi _{\\rm{i}}\\) is given by the negative value of the energy of the orbital, \\(-\\varepsilon_{\\rm{i}}\\), as calculated within the Hartree–Fock approximation. The theorem is not applied to localized molecular orbitals, which are not eigenfunctions of the effective hamiltonian." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Koopmans' theorem" .

goldbook:K03412 a skos:Concept ;
    skos:definition "Parameters to measure separately the ability of a solvent to enter into non-specific solvent–solute interactions (permittivity \\(\\varepsilon\\) and refractive index \\(\\eta _{\\rm{D}}\\)) and specific solvent–solute interaction (solvent basicity or nucleophilicity \\(B\\) and solvent acidity or electrophilicity \\(E\\)) as contributing to overall solvent polarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Koppel–Palm solvent parameters" .

goldbook:K03415 a skos:Concept ;
    skos:definition "The temperature (more precisely, narrow temperature range) above which the solubility of a surfactant rises sharply. At this temperature the solubility of the surfactant becomes equal to the critical micelle concentration. It is best determined by locating the abrupt change in slope of a graph of the logarithm of the solubility against \\(t\\) or \\(\\frac{1}{T}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Krafft point" .

goldbook:K03417 a skos:Concept ;
    skos:definition "A CW or pulsed laser emitting lines from \\(337\\) to \\(859\\ \\rm{nm}\\) from singly ionized krypton. Principal emissions are at \\(530.9\\), \\(568.2\\), \\(647.1\\) and \\(752.5\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "krypton ion laser" .

goldbook:L03418 a skos:Concept ;
    skos:definition "Signifies, with its superscript, the bonding number, i.e. the sum of the number of skeletal bonds to an atom and the number of hydrogen atoms associated with it in a parent hydride, real or hypothetical. Its usage in names of compounds is generally restricted to non-standard valence states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lambda" .

goldbook:L03422 a skos:Concept ;
    skos:definition "An obsolete prefix for (−)-,See: d, l, dlFor like and unlike diastereoisomersSee: l, u" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>l</i>" .

goldbook:L03423 a skos:Concept ;
    skos:definition "Stereodescriptors of diastereoisomers with two chirality elements. When the two chirality elements are both R or both S the molecular entity is described as having an l relationship (l = like), when one chirality element is R and the other S the molecular entity is described as having a u relationship (u = unlike). The notation can be extended to molecules with more than two chirality elements whereby the l, u relationships of the chiral elements are considered in pairs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>l</i>, <i>u</i>" .

goldbook:L03424 a skos:Concept ;
    skos:definition "A marker, tag or indicator distinguishable by the observer but not by the system and used to identify a tracer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "label" .

goldbook:L03425 a skos:Concept ;
    skos:definition "Providing a substance with a label." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "labelling" .

goldbook:L03432 a skos:Concept ;
    skos:definition "The term has loosely been used to describe a relatively unstable and transient chemical species or (less commonly) a relatively stable but reactive species. It must therefore not be used without explanation of the intended meaning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "labile" .

goldbook:L03433 a skos:Concept ;
    skos:definition "The sample or subsample(s) sent to or received by the laboratory. When the laboratory sample is further prepared (reduced) by subdividing, mixing, grinding or by combinations of these operations, the result is the test sample. When no preparation of the laboratory sample is required, the laboratory sample is the test sample. A test portion is removed from the test sample for the performance of the test or for analysis. The laboratory sample is the final sample from the point of view of sample collection but it is the initial sample from the point of view of the laboratory. Several laboratory samples may be prepared and sent to different laboratories or to the same laboratory for different purposes. When sent to the same laboratory, the set is generally considered as a single laboratory sample and is documented as a single sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laboratory sample" .

goldbook:L03434 a skos:Concept ;
    skos:definition "A substance which produces a flow of tears in a person or animal (e.g. acetyl chloride, acrylaldehyde, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lachrymator" .

goldbook:L03435 a skos:Concept ;
    skos:definition "Cyclic amides of amino carboxylic acids, having a 1-azacycloalkan-2-one structure, or analogues having unsaturation or heteroatoms replacing one or more carbon atoms of the ring. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactams" .

goldbook:L03436 a skos:Concept ;
    skos:definition "Cyclic esters derived by multiple esterification between two (usually) or more molecules of lactic acid or other hydroxy carboxylic acids.   They are designated as dilactides, trilactides, etc. according to the number of hydroxy acid residues, e.g. a dilactide (a 1,4-dioxane-2,5-dione):" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactides" .

goldbook:L03437 a skos:Concept ;
    skos:definition "Tautomeric forms of lactams, having an endocyclic carbon-nitrogen double bond. Thus, cyclic carboximidic acids, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactims" .

goldbook:L03438 a skos:Concept ;
    skos:definition "Cyclic hemiacetals formed by intramolecular addition of a hydroxy group to an aldehydic or ketonic carbonyl group. They are thus 1-oxacy-cycloalkan-2-ols or unsaturated analogues, e.g. [obsolete] This term has also been used for hydroxy lactones, but such use is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactols" .

goldbook:L03439 a skos:Concept ;
    skos:definition "Cyclic esters of hydroxy carboxylic acids, containing a 1-oxacycloalkan-2-one structure, or analogues having unsaturation or heteroatoms replacing one or more carbon atoms of the ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lactones" .

goldbook:L03440 a skos:Concept ;
    skos:definition "A double-strand chain, consisting of an uninterrupted sequence of rings, with adjacent rings having two or more atoms in common. Alternatively, a ladder chain is a double-strand chain with adjacent constitutional unit joined to each other through four atoms, two on one side and two on the other side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ladder chain" .

goldbook:L03441 a skos:Concept ;
    skos:definition "A double-strand macromolecule consisting of an uninterrupted sequence of rings, with adjacent rings having two or more atoms in common. Alternatively, a ladder macromolecule is a double-strand macromolecule with constitutional unit joined to each other through four atoms, two on one side and two on the other side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ladder macromolecule" .

goldbook:L03443 a skos:Concept ;
    skos:definition "The growth interval (adaption phase) between inoculation and start of the exponential phase during which there is little or no growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lag phase" .

goldbook:L03445 a skos:Concept ;
    skos:definition "The fraction of light absorbed by a system is independent of the incident radiant power (\\(P_{\\lambda }^{0}\\)). This law holds only if \\(P_{\\lambda }^{0}\\) is small, scattering is negligible, and multiphoton processes, excited state populations, and photochemical reactions are negligible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lambert law" .

goldbook:L03447 a skos:Concept ;
    skos:altLabel "light source" ;
    skos:definition "A source of incoherent radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lamp" .

goldbook:L03448 a skos:Concept ;
    skos:definition "A special type of carbon black produced by incomplete combustion of a fuel rich in aromatics that is burned in flat pans. lamp black is characterized by a relatively broad particle size distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lamp black" .

goldbook:L03450 a skos:Concept ;
    skos:definition "A slow chemical reaction, in which the formation of a product is delayed by a suitable reagent added for the purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Landolt reaction" .

goldbook:L03451 a skos:Concept ;
    skos:definition "A mechanism for surface catalysis in which the reaction occurs between species that are adsorbed on the surface is often known as a Langmuir–Hinshelwood mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Langmuir–Hinshelwood mechanism" .

goldbook:L03453 a skos:Concept ;
    skos:altLabel "Rideal–Eley mechanism" ;
    skos:definition "A mechanism for surface catalysis in which the reaction occurs between a reactant molecule in the gas phase and one that is adsorbed on the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Langmuir–Rideal mechanism" .

goldbook:L03454 a skos:Concept ;
    skos:definition "This rule states that for monophotonic radiative transitions in centrosymmetric systems, the only non-vanishing electric-dipole transition moments are those which connect an even term (g) with an odd term (u)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Laporte rule" .

goldbook:L03455 a skos:Concept ;
    skos:definition "The variation of an atmospheric variable with height; unless otherwise stated the variable is temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lapse rate" .

goldbook:L03458 a skos:Concept ;
    skos:definition "Crown ethers having a side chain that holds one or more additional coordinating sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lariat ethers" .

goldbook:L03459 a skos:Concept ;
    skos:definition "A source of ultraviolet, visible, or infrared radiation which produces light amplification by stimulated emission of radiation from which the acronym is derived. The light emitted is coherent except for superradiance emission. The essential elements of a laser are: 1, an active medium; 2, a pumping process to make a population inversion; and 3, suitable geometry of optical feedback elements. The active medium consists of a host material (gas, liquid or solid) containing an active species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser" .

goldbook:L03469 a skos:Concept ;
    skos:definition "Occurs when a sample is irradiated with a laser beam. In the irradiation of gaseous samples, ionization occurs via a single- or multi-photon process. In the case of solid samples, ionization occurs via a thermal process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser ionization" .

goldbook:L03479 a skos:Concept ;
    skos:definition "The process of light amplification by stimulated emission of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lasing" .

goldbook:L03481 a skos:Concept ;
    skos:definition "The primary result of radiation absorption in a photoimaging system which is susceptible to development." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latent image" .

goldbook:L03483 a skos:Concept ;
    skos:definition "For qualitative analysis, this should be defined as the minimum distance of two points (areas) on the specimen corresponding to signal levels of 16 and 84%. For electron signals originating from top surface layers like secondary or Auger electrons and secondary ions the lateral resolution for qualitative purposes corresponds to the beam diameter. For signals originating in a greater depth of the sample (back scattered electrons, X-rays) the lateral resolution is worse than the corresponding value of the beam diameter due to the diffusion of the primary electrons. The lateral resolution may be determined exactly with a sandwich specimen or a sharp edge specimen, or approximately with a specimen showing a regular microstructure of known dimensions. Recommended abbreviation: Lat. Res. (qualitative); unit: \\(\\rm{m}\\); range: \\(\\rm{nm}\\) or \\(\\unicode[Times]{x3BC} \\rm{m}\\). For quantitative analysis, this should be defined as the minimum distance of two points (areas) on the specimen corresponding to signal ratios of \\(10^{4}\\). This condition assures that the value for the lateral resolution defines the diameter of the analytical area which yields the total analytical signal. Due to the effect of electron diffusion in a solid and 'tail effects' in ion beam analysis the quantitative lateral resolution is significantly larger than the beam diameter. Recommended abbreviation: Lat. Res. (quantitative); unit: \\(\\rm{m}\\); range: \\(\\rm{nm}\\) or \\(\\unicode[Times]{x3BC} \\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lateral resolution" .

goldbook:L03484 a skos:Concept ;
    skos:definition "An emulsion or sol in which each colloidal particle contains a number of macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latex" .

goldbook:L03488 a skos:Concept ;
    skos:definition "Any conceptual region of space restricted in one dimension, within or at the surface of a condensed phase or a film. The usage of the term 'film' for an adsorption layer is confusing and is discouraged. The term double-layer applies to layers approximated by two 'distinct' sublayers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "layer" .

goldbook:L03491 a skos:Concept ;
    skos:definition "A polynucleotide region between promoter and structural gene, necessary for the correct transcription of DNA into mRNA.An N-terminal extension of polypeptides (also known as the signal sequence) which is necessary for the transport of the protein into or through the membrane or for its secretion into the extracellular medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leader sequence" .

goldbook:L03492 a skos:Concept ;
    skos:definition "A procedure for replacing the discrete set of results obtained from an experiment by a continuous function. It is defined by the following. For the set of variables \\(y,x_{0},x_{1},\\,...\\) there are \\(n\\) measured values such as \\(y_{i},x_{0i},x_{1i},\\,...\\) and it is decided to write a relation: \\[y = f\\left(a_{0},a_{1},\\,...,a_{K};x_{0},x_{1},\\,...\\right)\\] where \\(a_{0},a_{1},\\,...,a_{K}\\) are undetermined constants. If it is assumed that each measurement \\(y_{i}\\) of \\(y\\) has associated with it a number \\(w_{i}^{-1}\\) characteristic of the uncertainty, then numerical estimates of the \\(a_{0},a_{1},\\,...,a_{K}\\) are found by constructing a variable \\(S\\), defined by \\[S = \\sum_{i}(w_{i}\\ (y_{i}- f_{i}))^{2}\\] and solving the equations obtained by writing \\[\\frac{\\partial S}{\\partial a_{j}}\\ \\overset{˜}{a}_{j}=0\\] \\(\\overset{˜}{a}_{j}=\\rm{all}\\:\\, a\\) except \\(a_{j}\\). If the relations between the \\(a\\) and \\(y\\) are linear, this is the familiar least-squares technique of fitting an equation to a number of experimental points. If the relations between the \\(a\\) and \\(y\\) are non-linear, there is an increase in the difficulty of finding a solution, but the problem is essentially unchanged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "least-squares technique" .

goldbook:L03493 a skos:Concept ;
    skos:definition "An atom or group (charged or uncharged) that becomes detached from an atom in what is considered to be the residual or main part of the substrate in a specified reaction. For example, in the heterolytic solvolysis of benzyl bromide in acetic acid:  the leaving group is $\\ce{Br^{−}}$; in the reaction:  the leaving group is $\\ce{NMe3}$ in the electrophilic nitration of benzene, it is $\\ce{H^{+}}$. The term has meaning only in relation to a specified reaction. The leaving group is not, in general, the same as the substituent group present in the substrate (e.g. bromo and trimethylammonio in the substrates of the first two examples above). A slightly different usage of the term prevails in the (non-mechanistic) naming of transformations, where the actual substituent group present in the substrate (and also in the product) is referred to as the leaving group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leaving group" .

goldbook:L03494 a skos:Concept ;
    skos:definition "Choline esters of phosphatidic acids. Specific compounds should be named systematically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lecithins" .

goldbook:L03495 a skos:Concept ;
    skos:definition "Glycoproteins isolated from plants but recently found also in animals and microorganisms that react specifically with terminal glycosidic residues of other molecules (e.g. cell wall polysaccharides); some causing cells to agglutinate (cf. agglutination)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lectins" .

goldbook:L03497 a skos:Concept ;
    skos:definition "Arrangement of the structural formulae of the reactants so that the bonds to be made or broken form a linear array in which the electrons move from left to right." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "left-to-right convention" .

goldbook:L03498 a skos:Concept ;
    skos:definition "Base quantity in the system of quantities upon which SI is based. Special symbols are used for different types of lengths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "length" .

goldbook:L03499 a skos:Concept ;
    skos:altLabel "LC" ;
    skos:definition "Concentration of a potentially toxic substance in an environmental medium that causes death following a certain period of exposure (denoted by LC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethal concentration" .

goldbook:L03500 a skos:Concept ;
    skos:altLabel "LD" ;
    skos:definition "Amount of a substance or physical agent (radiation) that causes death when taken into the body by a single absorption (denoted by LD)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethal dose" .

goldbook:L03501 a skos:Concept ;
    skos:altLabel "suicide metabolism" ;
    skos:definition "Metabolic formation of a highly toxic compound from one that is relatively non-toxic (bioactivation), often leading to death of affected cells. Synonymous with suicide metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lethal synthesis" .

goldbook:L03502 a skos:Concept ;
    skos:definition "Colourless compounds formed by reduction of triphenylmethane dyes. Generally, they are amino or hydroxy derivatives of triphenylmethane. Use of this class name, which is more or less parochial to the technology of dyes, is not endorsed. E.g. $\\ce{(p-Me2NC6H4)2CHPh}$, the leuco base of Malachite Green." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leuco bases" .

goldbook:L03503 a skos:Concept ;
    skos:definition "Dihydroxy polycyclic aromatic compounds which on oxidation form polycyclic quinone dyes (intermediates in vat dyeing). Use of this class name, which is more or less parochial to the technology of dyes, is not endorsed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leuco compounds" .

goldbook:L03504 a skos:Concept ;
    skos:definition "Linear $\\ce{C20}$ endogenous metabolites of arachidonic acid (icosa-5,8,11,14-tetraenoic acid) containing a terminal carboxy function and four or more double bonds (three or more of which are conjugated) as well as other functional groups. A subclass of icosanoids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "leukotrienes" .

goldbook:L03506 a skos:Concept ;
    skos:definition "The tendency of a solvent to make all Brønsted acids whose acidity exceeds a certain value appear equally acidic. It is due to the complete transfer to a protophilic solvent of a hydron from a dissolved acid stronger than the conjugate acid of the solvent. The only acid present to any significant extent in all such solutions is the lyonium ion. For example, the solvent water has a levelling effect on the acidities of $\\ce{HClO4}$, $\\ce{HCl}$ and $\\ce{HI}$: aqueous solutions of these acids at the same (moderately low) concentrations have the same acidities. A corresponding levelling effect applies to strong bases protogenic solvents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "levelling effect" .

goldbook:L03508 a skos:Concept ;
    skos:definition "A molecular entity (and the corresponding chemical species) that is an electron-pair acceptor and therefore able to react with a Lewis base to form a Lewis adduct, by sharing the electron pair furnished by the Lewis base. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis acid" .

goldbook:L03509 a skos:Concept ;
    skos:definition "The thermodynamic tendency of a substrate to act as a Lewis acid. Comparative measures of this property are provided by the equilibrium constants for Lewis adduct formation of a series of Lewis acids with a common reference Lewis base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis acidity" .

goldbook:L03510 a skos:Concept ;
    skos:definition "The adduct formed between a Lewis acid and a Lewis base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis adduct" .

goldbook:L03511 a skos:Concept ;
    skos:definition "A molecular entity (and the corresponding chemical species) able to provide a pair of electrons and thus capable of coordination to a Lewis acid, thereby producing a Lewis adduct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis base" .

goldbook:L03512 a skos:Concept ;
    skos:definition "The thermodynamic tendency of a substance to act as a Lewis base. Comparative measures of this property are provided by the equilibrium constants for Lewis adduct formation for a series of Lewis bases with a common reference Lewis acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis basicity" .

goldbook:L03513 a skos:Concept ;
    skos:definition "Molecular structure in which the valency electrons are shown as dots so placed between the bonded atoms that one pair of dots represents two electrons or one covalent (single) bond, e.g.  A double bond is represented by two pairs of dots, etc. Dots representing non-bonded outer-shell electrons are placed adjacent to the atoms with which they are associated, but not between the atoms. Formal charges (e.g. +, −, 2+, etc.) are attached to atoms to indicate the difference between the positive nuclear charge (atomic number) and the total number of electrons (including those in the inner shells), on the formal basis that bonding electrons are shared equally between atoms they join. (Bonding pairs of electrons are usually denoted by lines, representing covalent bonds, as in line formulae.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis formula" .

goldbook:L03514 a skos:Concept ;
    skos:altLabel "LIDAR" ;
    skos:definition "An acronym for Light Detection And Ranging. It is a real time remote sensing technique for the determination of aerosol and trace gas concentrations in air by measurement of scattered laser radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<span class=\"s\">LIDAR</span>" .

goldbook:L03515 a skos:Concept ;
    skos:definition "Lifetime of a molecular entity, which decays by first-order kinetics, is the time needed for a concentration of the entity to decrease to \\(1/\\rm{e}\\) of its original value, i.e., \\(c(t = \\tau) = \\frac{c(t\\,=\\,0)}{e}\\). Statistically, it represents the life expectation of the entity. It is equal to the reciprocal of the sum of the first-order rate constants of all processes causing the decay of the molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lifetime" .

goldbook:L03516 a skos:Concept ;
    skos:definition "The time required for the luminescence intensity to decay from some initial value to \\(\\frac{1}{\\rm{e}}\\) of that value (\\(\\rm{e} = 2.718\\,...\\)). Lifetimes can be measured by 'phase fluorimetry' (phosphorimetry) where the phase shift between the sinusoidally modulated exciting light and the emitted light is measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lifetime" .

goldbook:L03517 a skos:Concept ;
    skos:definition "The removal of a degeneracy of atomic or molecular levels in a molecule or ion with a given symmetry, induced by the attachment or removal of ligands to produce reduced symmetries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand field splitting" .

goldbook:L03518 a skos:Concept ;
    skos:definition "In an inorganic coordination entity, the atoms or groups joined to the central atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligands" .

goldbook:L03519 a skos:Concept ;
    skos:altLabel "LLCT",
        "LLCT transition" ;
    skos:definition "An electronic transition of a metal complex that corresponds to excitation populating an electronic state in which considerable electron transfer between two ligands has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand to ligand charge transfer transition" .

goldbook:L03520 a skos:Concept ;
    skos:altLabel "LMCT",
        "LMCT transition" ;
    skos:definition "An electronic transition in a metal complex that corresponds to excitation populating an electronic state in which considerable electron transfer from a ligand to a metal centre has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand to metal charge transfer transition" .

goldbook:L03521 a skos:Concept ;
    skos:altLabel "synthetases" ;
    skos:definition "Enzymes that catalyse the ligation of two molecules with concomitant hydrolysis of the pyrophosphate bond in adenosine 5'-triphosphate (ATP) or a similar triphosphate, forming $\\ce{C–C}$, $\\ce{C–O}$, $\\ce{C–S}$, $\\ce{P–O}$ or $\\ce{C–N}$ bonds. In recombinant DNA technology, ligases covalently join together two sequences of DNA (e.g. host DNA and foreign DNA) by a phosphodiester bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligases" .

goldbook:L03522 a skos:Concept ;
    skos:definition "To coordinate to a central atom as a ligand." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligate" .

goldbook:L03523 a skos:Concept ;
    skos:definition "A dynamical effect that arises for a process $$\\ce{A + B-C -> A-B + C}$$ when the species $\\ce{A}$ is light (e.g. a hydrogen atom) compared to $\\ce{B}$ and $\\ce{C}$. The vibrational excitation of the product $\\ce{A–B}$ is low, since the light atom $\\ce{A}$ approaches to within the bonding distance of $\\ce{BC}$ before the $\\ce{C}$ atom retreats. The energy of reaction is therefore released as repulsion between $\\ce{A–B}$ and $\\ce{C}$, with the result that there is translational excitation of the products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light-atom anomaly" .

goldbook:L03524 a skos:Concept ;
    skos:definition "A light beam is said to be linearly polarized if the end-point of the electric vector moves in a straight line when viewed along the direction of propagation of the beam. If it moves along a circle the beam is circularly polarized and if it moves along an ellipse the beam is elliptically polarized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light polarization" .

goldbook:L03525 a skos:Concept ;
    skos:definition "The redirection of a light beam due to interactions with molecules (Rayleigh and Raman scattering) and aerosols (Mie scattering). Scattered light received at any point in the atmosphere (sometimes called sky radiation) is a very important component of the total radiation received from the sun; it is dependent on the solar zenith angle, elevation aerosol concentration etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light scattering" .

goldbook:L03527 a skos:Concept ;
    skos:definition "Plant products of low molecular weight formed primarily from oxidative coupling of two p-propylphenol moieties at their $\\ce{\\upbeta\\!\\mbox{-}carbon atoms}$; products with units coupled in other ways are neolignans, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lignans" .

goldbook:L03528 a skos:Concept ;
    skos:definition "Macromolecular constituents of wood related to lignans, composed of phenolic propylbenzene skeletal units, linked at various sites and apparently randomly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lignins" .

goldbook:L03529 a skos:Concept ;
    skos:definition "The potential-independent value that is approached by an adsorption current as the rate of reduction or oxidation of the electroactive substance is increased by varying the applied potential. The terms adsorption current and limiting adsorption current should not be applied to faradaic currents that have been increased or decreased by adding a non-electroactive surfactant to a solution containing an electroactive substance, nor to apparent waves resulting from the effect of adsorption or desorption on double-layer currents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting adsorption current" .

goldbook:L03530 a skos:Concept ;
    skos:definition "The potential-independent value that is approached by a catalytic current as the rate of the charge-transfer process is increased by varying the applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting catalytic current" .

goldbook:L03531 a skos:Concept ;
    skos:definition "Range of physical and operational parameters in which the method meets given values of performance characteristics with 95% probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting condition of operation" .

goldbook:L03532 a skos:Concept ;
    skos:definition "The limiting value of a faradaic current that is approached as the rate of the charge-transfer process is increased by varying the potential. It is independent of the applied potential over a finite range, and is usually evaluated by subtracting the appropriate residual current from the measured total current. A limiting current may have the character of an adsorption, catalytic, diffusion, or kinetic current, and may include a migration current." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting current" .

goldbook:L03534 a skos:Concept ;
    skos:definition "The potential-independent value that is approached by a diffusion current as the rate of the charge-transfer process is increased by varying the applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting diffusion current" .

goldbook:L03535 a skos:Concept ;
    skos:definition "The potential-independent value that is approached by a kinetic current as the rate of the charge-transfer process is increased by varying the applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting kinetic current" .

goldbook:L03537 a skos:Concept ;
    skos:definition "The limiting value of a migration current, which is approached as the rate of the charge-transfer process is increased by varying the applied potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limiting migration current" .

goldbook:L03541 a skos:Concept ;
    skos:definition "Acute toxicity test in which, if no ill-effects occur at a pre-selected maximum dose, no further testing at greater exposure levels is required." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "limit test" .

goldbook:L03546 a skos:Concept ;
    skos:definition "A chain with no branch points intermediate between the boundary units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear chain" .

goldbook:L03547 a skos:Concept ;
    skos:definition "A copolymer composed of linear macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear copolymer" .

goldbook:L03549 a skos:Concept ;
    skos:definition "An evacuated metal tube in which electrons pass through a series of small gaps (usually in the form of cavity resonators in the high frequency range) so arranged and spaced that, at a specific excitation frequency, the stream of electrons on passing through successive gaps gains additional energy from the electric field in each gap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear electron accelerator" .

goldbook:L03550 a skos:Concept ;
    skos:definition "The average energy locally imparted to a medium by a charged particle of specified energy, per unit distance traversed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear energy transfer" .

goldbook:L03551 a skos:Concept ;
    skos:altLabel "linear Gibbs energy relation" ;
    skos:definition "A linear correlation between the logarithm of a rate constant or equilibrium constant for one series of reactions and the logarithm of the rate constant or equilibrium constant for a related series of reactions. Typical examples of such relations (also known as linear Gibbs energy relations) are the Brønsted relation, and the Hammett equation.The name arises because the logarithm of an equilibrium constant (at constant temperature and pressure) is proportional to a standard free energy (Gibbs energy) change, and the logarithm of a rate constant is a linear function of the free energy (Gibbs energy) of activation.It has been suggested that this name should be replaced by linear Gibbs energy relation, but at present there is little sign of acceptance of this change. The area of physical organic chemistry which deals with such relations is commonly referred to as 'Linear Free-Energy Relationships'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear free-energy relation" .

goldbook:L03553 a skos:Concept ;
    skos:definition "The extent to which the output of the detector is directly proportional to the incident radiant power at a given wavelength and at constant irradiation geometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linearity of responsivity" .

goldbook:L03554 a skos:Concept ;
    skos:definition "A macromolecule the structure of which essentially comprises the multiple repetition in linear sequence of units derived, actually or conceptually, from molecules of low relative molecular mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear macromolecule" .

goldbook:L03555 a skos:Concept ;
    skos:definition "An optical device which allows the transmission of radiation of which the electric vector is restricted to one plane resulting in linearly polarized radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear polarizer" .

goldbook:L03556 a skos:Concept ;
    skos:definition "A polymer composed of linear macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear polymer" .

goldbook:L03557 a skos:Concept ;
    skos:definition "A pulse amplifier which, within the limits of its normal operating characteristics, delivers an output pulse of amplitude proportional to that of the input pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear pulse amplifier" .

goldbook:L03558 a skos:Concept ;
    skos:definition "Concentration range over which the intensity of the signal obtained is directly proportional to the concentration of the species producing the signal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear range" .

goldbook:L03559 a skos:Concept ;
    skos:definition "Equations involving the application of solvent parameters in linear or multiple (linear) regression expressing the solvent effect on the rate or equilibrium constant of a reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear solvation energy relationships" .

goldbook:L03561 a skos:Concept ;
    skos:definition "A two-dimensional representation of molecular entities in which atoms are shown joined by lines representing single or multiple bonds, without any indication or implication concerning the spatial direction of bonds. For example, methanol is represented as:  (The term should not be confused with the representation of chemical formulae by the 'Wiswesser line notation', a method of string notation. Formulae in this notation are also known as 'Wiswesser line formulae'.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line formula" .

goldbook:L03562 a skos:Concept ;
    skos:definition "Attribute to a physical quantity obtained by division by length. Lineic mass of a thread is the mass of the thread divided by its length." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lineic" .

goldbook:L03563 a skos:Concept ;
    skos:definition "A form of the collision theory of chemical reactions in which the assumption is made that reaction can only occur if on collision the component of energy along the line of centres of the masses of the colliding species is greater than a particular threshold energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line-of-centres model" .

goldbook:L03565 a skos:Concept ;
    skos:definition "Determination of rate constants for a chemical exchange from the shapes of spectroscopic lines of dynamic processes. The method is most often used in nuclear magnetic resonance spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line-shape analysis" .

goldbook:L03566 a skos:Concept ;
    skos:definition "A plot of the reciprocal of velocity of an enzyme-catalysed reaction (ordinate) versus the reciprocal of substrate concentration (abscissa). The plot is used to graphically define the maximum velocity of an enzyme-catalysed reaction and the Michaelis constant for the enzyme." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lineweaver–Burk plot" .

goldbook:L03568 a skos:Concept ;
    skos:definition "The full width at half maximum peak-height. The natural line width is the theoretical value of the full width at half maximum of the nuclear transition, usually calculated from lifetime data." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "line width" .

goldbook:L03569 a skos:Concept ;
    skos:definition "A scan, in an instrument comprising two or more analysers, in which two or more of the analyser fields are scanned simultaneously so as to preserve a pre-determined relationship between parameters characterizing these fields. Often, these parameters are the field strengths, but they may also be the frequencies in the case of analysers in which alternating fields are employed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linked scan" .

goldbook:L03570 a skos:Concept ;
    skos:definition "Established term for W/O/W films (i.e. oil film in water)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipid film" .

goldbook:L03571 a skos:Concept ;
    skos:definition "A loosely defined term for substances of biological origin that are soluble in nonpolar solvents. They consist of saponifiable lipids, such as glycerides (fats and oils) and phospholipids, as well as nonsaponifiable lipids, principally steroids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipids" .

goldbook:L03572 a skos:Concept ;
    skos:definition "Literally 'fat-loving'. Applied to molecular entities (or parts of molecular entities) having a tendency to dissolve in fat-like (e.g. hydrocarbon) solvents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipophilic" .

goldbook:L03573 a skos:Concept ;
    skos:definition "Literally, 'fat-rejecting'; the converse of lipophilic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipophobic" .

goldbook:L03574 a skos:Concept ;
    skos:definition "Natural compounds consisting of a trisaccharide repeating unit (two heptose units and octulosonic acid) with oligosaccharide side chains and 3-hydroxytetradecanoic acid units (they are a major constituent of the cell walls of gram-negative bacteria)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipopolysaccharides" .

goldbook:L03575 a skos:Concept ;
    skos:definition "Clathrate complexes consisting of a lipid enwrapped in a protein host without covalent binding in such a way that the complex has a hydrophilic outer surface consisting of all the protein and the polar ends of any phospholipids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipoproteins" .

goldbook:L03576 a skos:Concept ;
    skos:definition "Originally a lipid droplet in the endoplasmic reticulum of a fatty liver. Now applied to an artificially formed lipid droplet, small enough to form a relatively stable suspension in aqueous media and with potential use in drug delivery." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liposome" .

goldbook:L03577 a skos:Concept ;
    skos:definition "An equation which gives the electric charge per unit area of an interface (electrode): \\[(\\frac{\\partial \\gamma }{\\partial E_{\\rm{A}}})_{T,p,\\mu _{i} eq \\mu }=- Q_{\\rm{A}}\\] where \\(\\gamma \\) is the interfacial tension, \\(E_{\\rm{A}}\\) is the potential of a cell in which the reference electrode has an interfacial equilibrium with one of the ionic components of A, \\(Q_{\\rm{A}}\\) is the charge on unit area of the interface, \\(\\mu _{i}\\) is the chemical potential of the combination of species \\(i\\) whose net charge is zero, \\(T\\) is the thermodynamic temperature and \\(p\\) is the external pressure. Since more than one type of reference electrode may be chosen, more than one quantity \\(Q\\) may be obtained. Consequently \\(Q\\) cannot be considered as equivalent to the physical charge on a particular region of the interphase. It is in fact an alternative way of expressing a surface excess or combination of surface excess of charged species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lippman's equation" .

goldbook:L03578 a skos:Concept ;
    skos:altLabel "LC" ;
    skos:definition "A separation technique in which the mobile phase is a liquid. Liquid chromatography can be carried out either in a column or on a plane. Present-day liquid chromatography generally utilizing very small particles and a relatively high inlet pressure is often characterized by the term high-performance (or high-pressure) liquid chromatography, and the acronym HPLC." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid chromatography" .

goldbook:L03579 a skos:Concept ;
    skos:definition "A liquid crystal is a molecular crystal with properties that are both solid- and liquid-like. Liquid crystals are composed predominantly of rod-like or disc-like molecules, that can exhibit one or more different, ordered fluid phases as well as the isotropic fluid; the translational order is wholly or partially destroyed but a considerable degree of orientational order is retained on passing from the crystalline to the liquid phase in a mesomorphic transition.Transition to a nematic phase.A mesomorphic transition that occurs when a molecular crystal is heated to form a nematic phase in which the mean direction of the molecules is parallel or antiparallel to an axis known as the director.Transition to a cholesteric phase. A mesomorphic transition that occurs when a molecular crystal is heated to form a cholesteric phase in which there is simply a spiralling of the local orientational order perpendicular to the long axes of the molecules. Transition to a smectic state.A mesomorphic transition that occurs when a molecular crystal is heated to yield a  smectic state in which there is a one-dimensional density wave which produces very soft/disordered layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-crystal transitions" .

goldbook:L03580 a skos:Concept ;
    skos:definition "A liquid laser in which excimer species in liquids are used as the active medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid excimer laser" .

goldbook:L03582 a skos:Concept ;
    skos:altLabel "solvent ion exchange" ;
    skos:definition "A term used to describe a liquid-liquid extraction process that involves a transfer of ionic species from the extractant to the aqueous phase in exchange for ions from the aqueous phase. The term does not imply anything concerning the nature of the bonding in the extracted complex. The term solvent ion exchange is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid ion exchange" .

goldbook:L03583 a skos:Concept ;
    skos:definition "A liquid laser in which rare earth ions in solution are used as the laser active medium. An example is $\\ce{KrF}$ in a liquid $\\ce{Kr}$ laser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid ion laser" .

goldbook:L03584 a skos:Concept ;
    skos:definition "Any junction between two electrolyte solutions of different composition. Across such a junction there arises a potential difference, called the liquid junction potential. In the operational pH cell the junction is between the test, or pH standard, solution and the filling solution or the bridge solution of the reference electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid junction" .

goldbook:L03585 a skos:Concept ;
    skos:definition "A laser in which a liquid solution is the active species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid laser" .

goldbook:L03586 a skos:Concept ;
    skos:definition "The process of transferring a dissolved substance from one liquid phase to another (immiscible or partially miscible) liquid phase in contact with it. Although extraction, partition and distribution are not synonymous, extraction may replace distribution where appropriate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-liquid distribution" .

goldbook:L03588 a skos:Concept ;
    skos:definition "A term used in partition chromatography to express the relative amount of the liquid stationary phase in the column packing. It is equal to the mass fraction (%) of liquid stationary phase in the total packing (liquid stationary phase plus support)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-phase loading" .

goldbook:L03589 a skos:Concept ;
    skos:definition "A scintillation detector in which the test portion is mixed with a liquid scintillator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid scintillation detector" .

goldbook:L03590 a skos:Concept ;
    skos:definition "A line on a binary phase diagram (or surface on a ternary phase diagram) that indicates the temperature at which solidification begins on cooling or at which melting is completed on heating under equilibrium conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquidus" .

goldbook:L03592 a skos:Concept ;
    skos:definition "A particle of dry substance in the atmosphere, as contrasted to a hydrometeor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lithometeor" .

goldbook:L03593 a skos:Concept ;
    skos:definition "The crust of the earth, usually thought of as discrete from and in contact with the hydrosphere and the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lithosphere" .

goldbook:L03595 a skos:Concept ;
    skos:definition "For a measurement, the time during which a radiation measuring assembly is capable of processing events occurring in the radiation detector. It equals the clock time minus the integrated resolving or dead time (to be distinguished from 'life time')." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "live time" .

goldbook:L03596 a skos:Concept ;
    skos:definition "A copolymerization which is a living polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living copolymerization" .

goldbook:L03597 a skos:Concept ;
    skos:definition "A chain polymerization from which chain transfer and chain termination are absent. In many cases, the rate of chain initiation is fast compared with the rate of chain propagation, so that the number of kinetic-chain carriers is essentially constant throughout the polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living polymerization" .

goldbook:L03599 a skos:Concept ;
    skos:altLabel "maximum loading",
        "saturation capacity",
        "saturation loading" ;
    skos:definition "The maximum concentration of solute(s) that a solvent can contain under specified conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loading capacity" .

goldbook:L03602 a skos:Concept ;
    skos:definition "The substance fraction of atomized component in the component consumed. The efficiency of atomization is measured in a given part of the flame, usually the observation space; \\(\\varepsilon_{\\rm{a}} = \\varepsilon_{\\rm{n}}\\ \\chi _{\\rm{s}}\\ \\chi _{\\rm{v}}\\ \\chi _{\\rm{a}}\\). The signal is a function of the product \\(q_{\\rm{v}}\\ \\varepsilon_{\\rm{a}}\\), but \\(\\varepsilon_{\\rm{a}}\\) is also a function of \\(q_{\\rm{v}}\\), usually decreasing at high volume rates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local efficiency of atomization" .

goldbook:L03603 a skos:Concept ;
    skos:definition "The effective thermodynamic temperature in the observation space as measured by a specific sensor for a specified element (in \\(\\rm{K}\\)). The temperature of a flame (or other plasma) is not homogeneous. It is usually lower at the borders of the flame. It is therefore appropriate to speak of an effective temperature which represents an average value of all temperatures throughout the observation space. The flame temperature depends on several factors such as: kind of plasma, kind of gas or gas mixture and concentration gradient of the thermometric species in the observation space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local flame temperature" .

goldbook:L03604 a skos:Concept ;
    skos:definition "The substance fraction of the atomized component in the total volatilized component. This quantity is measured in a defined part of the flame, usually the observation space. The fraction atomized is the result of chemical reactions in the gaseous state. It depends on the bond strength of the compounds that the component may form within the flame and on the composition and temperature of the flame. When analysing elements that tend to become oxidized in the flame, it may be advisable to use as fuel gas mixtures with a reducing component such as $\\ce{C2H2}$ or $\\ce{N2O}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local fraction atomized" .

goldbook:L03605 a skos:Concept ;
    skos:definition "The amount-of-substance fraction of component in a desolvated state in the amount of component entering the flame. This quantity is measured in a defined part of the flame, usually the observation space. Because it varies with height in the flame as a result of progressive evaporation of aerosol droplets, it is appropriate to term the expression local. The fraction desolvated does not account for losses by incomplete volatilization of the dry aerosol (which largely depends upon the nature and concentration of the component). Such losses are described by local fraction volatilized, which usually depends on the solute. Since \\(\\chi _{\\rm{s}}\\) varies markedly with the height in the flame, its observed value represents an average. Local fraction desolvated depends on the solvent, the temperature of the flame and the time the component takes to travel from the tip of the burner to the height in the flame considered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local fraction desolvated" .

goldbook:L03606 a skos:Concept ;
    skos:definition "The substance fraction of the volatilized component in the total desolvated component. The gaseous state includes free atoms, molecules and radicals. This quantity is measured in a defined part of the flame, usually the observation space. The fraction volatilized varies inversely with the size of the desolvated particles. Since \\(\\chi _{\\rm{v}}\\) varies markedly with the height in the flame, its observed value represents an average." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "local fraction volatilized" .

goldbook:L03608 a skos:Concept ;
    skos:definition "A transition of either of two types: (a) a Mott transition (single-valent systems). (b) a small-polaron to itinerant-electron transition (mixed-valent systems)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "localized-itinerant transition" .

goldbook:L03613 a skos:Concept ;
    skos:definition "In competitive binding assays, the logit-log dose relationship, in which the response is defined by: \\(R=\\mathrm{logit}\\left(y\\right)=\\log _{10}(\\frac{y}{1- y})\\) where \\(y=\\frac{b}{b_{0}}\\) with \\(b\\) = fraction of tracer bound and \\(b_{0}\\) = value of \\(b\\) with no unlabelled ligand in the system. Logit transformed assay data frequently yield straight-line dose-response curves, amenable to statistical analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "logit" .

goldbook:L03614 a skos:Concept ;
    skos:definition "A distribution function \\(F(y)\\), in which the logarithm of a quantity is normally distributed, i.e. \\(F(y)=f_{\\rm{gauss}}(\\ln y)\\) where \\(f_{\\rm{gauss}}(x)\\) is a Gaussian distribution. The size distributions of atmospheric aerosols are often described using this distribution function, although the term also applies to gaseous pollutants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "log-normal distribution" .

goldbook:L03615 a skos:Concept ;
    skos:altLabel "LEP",
        "LEP method" ;
    skos:definition "A semiempirical method of calculating a potential-energy surface, based on a simplified quantum-mechanical equation (the London equation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "London–Eyring–Polanyi method" .

goldbook:L03616 a skos:Concept ;
    skos:altLabel "LEPS",
        "LEPS method" ;
    skos:definition "A modification of the London–Eyring–Polanyi proposed in 1955 by S. Sato." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "London–Eyring–Polanyi–Sato method" .

goldbook:L03617 a skos:Concept ;
    skos:altLabel "dispersion forces" ;
    skos:definition "Attractive forces between apolar molecules, due to their mutual polarizability. They are also components of the forces between polar molecules. Also called 'dispersion forces'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "London forces" .

goldbook:L03618 a skos:Concept ;
    skos:altLabel "electron pair" ;
    skos:definition "Two paired electrons localized in the valence shell on a single atom. Lone pairs should be designated with two dots. The term 'nonbonding electron pair' is more appropriate, and is found in many modern text books." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lone pair" .

goldbook:L03619 a skos:Concept ;
    skos:definition "A chain of high relative molecular mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "long chain" .

goldbook:L03622 a skos:Concept ;
    skos:definition "When a potential-energy surface is such that the system performs a number of vibrations and rotations in the region of a col, the corresponding intermediate is known as a long-lived collision complex, and the reaction is said to be indirect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "long-lived collision complex" .

goldbook:L03625 a skos:Concept ;
    skos:definition "Polymer chain within a network which is connected by a junction-point at one end only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "loose end" .

goldbook:L03628 a skos:Concept ;
    skos:definition "This band shape is described by the function: \\[F\\left( u -  u _{0}\\right) = \\frac{1}{\\pi }\\ \\gamma \\ (( u -  u _{0})^{2}+\\gamma ^{2})^{-1}\\] where \\( u_{0}\\) is the mean band position, \\(\\gamma \\) is the half band width at half maximum, and \\(F\\ ( u -  u _{0})\\) is the frequency distribution function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lorentzian band shape" .

goldbook:L03629 a skos:Concept ;
    skos:definition "Theory of light scattering by isotropic, homogeneous spheres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lorenz–Mie theory" .

goldbook:L03630 a skos:Concept ;
    skos:definition "A quantity of material which is assumed to be a single population for sampling purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lot" .

goldbook:L03631 a skos:Concept ;
    skos:altLabel "LEED" ;
    skos:definition "Any technique which measures the angular intensity distribution of electrons reflected from a crystalline surface under bombardment with low energy electrons (\\(E_{0} < 500\\ \\rm{eV}\\)) in larger angles of incidence. The diffraction pattern also provides very surface sensitive information on the atomic arrangement of the top layers of a solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low energy electron diffraction" .

goldbook:L03634 a skos:Concept ;
    skos:altLabel "LOEL" ;
    skos:definition "Lowest concentration or amount of a substance, found by experiment or observation, that causes any alteration in morphology, functional capacity, growth, development, or life span of target organisms distinguishable from normal (control) organisms of the same species and strain under the same defined conditions of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lowest-observed-effect-level" .

goldbook:L03637 a skos:Concept ;
    skos:altLabel "low-pressure mercury arc" ;
    skos:definition "Resonance lamp that contains mercury vapour at pressures of about \\(0.1\\ \\rm{Pa}\\) (\\(0.75\\times 10^{-3}\\ \\rm{Torr}\\); \\(1\\ \\rm{Torr} = 133.33\\ \\rm{Pa}\\)). At \\(\\pu{25^{\\circ}C}\\), such a lamp emits mainly at \\(253.7\\) and \\(184.9\\ \\rm{nm}\\). They are also called germicidal lamps. There are cold- and hot-cathode as well as cooled electrode-less (excited by microwaves) low-pressure mercury lamps. The Wood lamp is a low-pressure mercury arc with an added fluorescent layer that emits in the UV-A spectral region (\\(315\\)-\\(400\\ \\rm{nm}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-pressure mercury lamp" .

goldbook:L03638 a skos:Concept ;
    skos:definition "The measurement of the absorption of UV–VIS radiation by a solute in a highly viscous or solid matrix at low temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low temperature UV–VIS absorption spectroscopy" .

goldbook:L03639 a skos:Concept ;
    skos:definition "SI derived unit of luminous flux, \\(\\rm{lm} = \\rm{cd sr}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lumen" .

goldbook:L03640 a skos:Concept ;
    skos:definition "Photometric counterpart of radiance, producing the visual sensation called brightness. Typical units are: \\(\\pu{candela m-2}\\) (\\(\\mathrm{nit}\\)), \\(\\pu{candela cm-2}\\) (\\(\\mathrm{stilb}\\)), \\(\\mathrm{foot}\\ \\mathrm{lambert}\\) (\\(2.426\\ \\rm{nit}\\)). As with all photometric quantities, luminance does not refer to a specific wavelength, but applies to light emitted by a standard source (formerly a 'standard international candle', now a blackbody radiator emitting at the temperature of solidifying platinum, \\(2042\\ \\rm{K}\\)). Conversion from photometric units to radiometric units (e.g. \\(\\rm{J s}^{-1}\\)) requires convolution over wavelength of the relative spectral response of the human eye (photopic response tables)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminance" .

goldbook:L03641 a skos:Concept ;
    skos:definition "Spontaneous emission of radiation from an electronically or vibrationally excited species not in thermal equilibrium with its environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminescence" .

goldbook:L03644 a skos:Concept ;
    skos:definition "Radiationless redistribution of excitation energy via interaction (electronic energy or charge transfer) between an emitting species and the quencher." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminescence quenching" .

goldbook:L03645 a skos:Concept ;
    skos:definition "The instrument used to measure luminescence emission spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminescence spectrometer" .

goldbook:L03646 a skos:Concept ;
    skos:definition "Of a source of luminous intensity \\(I\\) in an element of solid angle \\(\\rm{d}\\varOmega\\) is given by \\(\\rm{d}\\varPhi = I\\ \\rm{d}\\varOmega\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminous flux" .

goldbook:L03647 a skos:Concept ;
    skos:definition "Base quantity in the system of quantities upon which SI is based." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "luminous intensity" .

goldbook:L03649 a skos:Concept ;
    skos:altLabel "luminophore" ;
    skos:definition "A part of a molecular entity (or atom or group of atoms) in which electronic excitation associated with a given emission band is approximately localized. (Analogous to chromophore for absorption spectra)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lumiphore" .

goldbook:L03651 a skos:Concept ;
    skos:definition "SI derived unit of illuminance, \\(\\rm{lx} = \\rm{lm m}^{-2}=\\rm{cd sr m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lux" .

goldbook:L03652 a skos:Concept ;
    skos:definition "Enzymes cleaving $\\ce{C–C}$, $\\ce{C–O}$, $\\ce{C–N}$ and other bonds by other reactions than by hydrolysis or oxidation. Lyases catalyse the addition of molecules to unsaturated compounds or the elimination of molecules creating an unsaturated residue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lyases" .

goldbook:L03653 a skos:Concept ;
    skos:definition "The anion produced by hydron removal from a solvent molecule. For example, the hydroxide ion is the lyate ion of water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lyate ion" .

goldbook:L03654 a skos:Concept ;
    skos:definition "The cation produced by hydronation of a solvent molecule. For example, ($\\ce{CH3OH2^{+}}$) is the lyonium ion of methanol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lyonium ion" .

goldbook:L03655 a skos:Concept ;
    skos:definition "The terms lyophilic (hydrophilic, lipophilic, oleophilic, etc.) and lyophobic (lipophobic, etc.) may be used to describe the character of interaction of a particular atomic group with the medium. In this usage the terms have the relative qualitative meaning of 'solvent preferring' (water-preferring, fat-preferring, etc.) and 'solvent rejecting' (water-rejecting, fat-rejecting, etc.) respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lyophilic" .

goldbook:L03656 a skos:Concept ;
    skos:definition "These comprise both association colloids in which aggregates of small molecules are formed reversibly and macromolecules in which the molecules themselves are of colloidal size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lyophilic sols" .

goldbook:L03658 a skos:Concept ;
    skos:definition "Laboratory column of selected representative soil or a protected monolith of undisturbed field soil with which it is possible to sample and monitor the movement of water and substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lysimeter" .

goldbook:LT06764 a skos:Concept ;
    skos:definition "Ligand field theory is a modified crystal field theory that assigns certain parameters as variables rather than taking them as equal to the values found for free ions, thereby taking into account the potential covalent character of the metal-ligand bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ligand field" .

goldbook:LT06788 a skos:Concept ;
    skos:definition "In any coordination entity with a particular $\\rm{d^{n}}$ ($1 \\lt \\pu{n} \\lt 9$) configuration and a particular geometry, if the n electrons are distributed so that they occupy the lowest possible energy levels, the entity is a low-spin complex. If some of the higher energy d orbitals are occupied before all the lower energy ones are completely filled, then the entity is a high-spin complex." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-spin" .

goldbook:LT06829 a skos:Concept ;
    skos:altLabel "latency" ;
    skos:definition "Delay between exposure to a harmful substance and the manifestations of a disease or other adverse effects.Period from disease initiation to disease detection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "latent period" .

goldbook:LT06854 a skos:Concept ;
    skos:definition "A mesomorphic state having long-range orientational order and either partial positional order or complete positional disorder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-crystal state" .

goldbook:LT06855 a skos:Concept ;
    skos:definition "A phase occurring over a definite temperature range within the liquid-crystalline state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-crystalline phase" .

goldbook:LT06856 a skos:Concept ;
    skos:definition "A substance in the liquid-crystalline state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid crystal" .

goldbook:LT06865 a skos:Concept ;
    skos:definition "A highly-branched oligomer or polymer of dendritic structure containing mesogenic groups that can display mesophase behaviour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-crystal dendrimer" .

goldbook:LT06867 a skos:Concept ;
    skos:definition "A polymer material that, under suitable conditions of temperature, pressure, and concentration, exists as an LC mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-crystal polymer" .

goldbook:LT06877 a skos:Concept ;
    skos:altLabel "LB",
        "LB membrane" ;
    skos:definition "Synthetic composite membrane formed by sequential depositing of one or more monolayers of surface-active component onto a porous or non-porous support." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Langmuir–Blodgett membrane" .

goldbook:LT06883 a skos:Concept ;
    skos:definition "Liquid phase existing either in supported or unsupported form that serves as a membrane barrier between two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid membrane" .

goldbook:LT06896 a skos:Concept ;
    skos:definition "A mesophase formed by dissolving an amphiphilic mesogen in a suitable solvent, under appropriate conditions of concentration, temperature, and pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lyotropic mesophase" .

goldbook:LT06909 a skos:Concept ;
    skos:altLabel "LOAEL" ;
    skos:definition "Lowest concentration or amount of a substance, found by experiment or observation, which causes an adverse alteration of morphology, functional capacity, growth, development, or life span of a target organism distinguishable from normal (control) organisms of the same species and strain under defined conditions of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lowest observed adverse effect level" .

goldbook:LT06919 a skos:Concept ;
    skos:altLabel "liquid-coated stationary phase material" ;
    skos:definition "A material in which a liquid stationary phase is coated on the surface of the solid support." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-coated stationary phase" .

goldbook:LT06935 a skos:Concept ;
    skos:definition "A @DT06932-1@ which can be approximated as \\(c_{\\rm{s}} = K_{\\rm{C}}.c_{\\rm{M}}\\) where \\(K_{\\rm{C}}\\) is a constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear distribution isotherm" .

goldbook:LT06939 a skos:Concept ;
    skos:definition "Chromatographic process, where the retention is governed by a linear distribution isotherm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear chromatography" .

goldbook:LT06965 a skos:Concept ;
    skos:definition "Lipophilicity represents the affinity of a molecule or a moiety for a lipophilic environment. It is commonly measured by its distribution behaviour in a biphasic system, either liquid-liquid (e.g., partition coefficient in 1-octanol/water) or solid-liquid (retention on reversed-phase high-performance liquid chromatography (RP-HPLC) or thin-layer chromatography (TLC) system)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "lipophilicity" .

goldbook:LT07064 a skos:Concept ;
    skos:altLabel "principle of least motion" ;
    skos:definition "The statement that those elementary reactions are the most favoured which exhibit the fewest possible alterations in the positions of the atomic nuclei and in the electronic configuration. The most frequently used mathematical formulation of the principle rests on a mechanical model of a molecule in which the energy of structural deformation, when reactants (r) turn into products (p), is assumed to be proportional to the sum of the squares of the changes in the positions of the nuclei common to both reactants and products \\[E=\\sum _{\\begin{array}{c} i \\end{array}}f_{i}\\ (q^{\\rm{p}_{i}}- q^{\\rm{r}_{i}})^{2}\\] where \\(f_{i}\\) is the force constant (in many applications set equal to unity). The equation coincides with the relationship for the potential energy of small vibrations, hence it is valid only at a very early stage of a reaction. This is one of the reasons why many reactions violate the principle of least motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "least motion principle" .

goldbook:LT07065 a skos:Concept ;
    skos:definition "A classical rule for describing the electronic configuration of atoms in molecules: the maximum number of electron pairs that can be accommodated in the valence shell of a first-row element is four. For the second and subsequent row elements there are many exceptions to this rule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Lewis octet rule" .

goldbook:LT07066 a skos:Concept ;
    skos:altLabel "LMO" ;
    skos:definition "The molecular orbitals located on certain fragments of a molecular system and spatially separated from each other as much as possible. The LMOs are derived from the electron occupied canonical molecular orbitals by subjecting them to a unitary transformation determined by an appropriate physical criterion, e.g. by maximizing the sum of squares of the centroids of occupied MOs (the Foster–Boys procedure) or by minimizing the sum of the exchange (or Coulomb) repulsion integrals between the occupied MOs (the Edmiston–Ruedenberg procedure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "localized molecular orbitals" .

goldbook:LT07067 a skos:Concept ;
    skos:definition "When the separation between the highest occupied and the lowest unoccupied molecular orbitals is not large, two alternative electronic states may be considered. The state with two electrons paired up in the HOMO is called a low-spin state. The low-spin state is the ground state when the one-electron energy needed to promote an electron to the LUMO is larger than the Coulomb and exchange repulsion energies required to pair up two electrons in the HOMO." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "low-spin state" .

goldbook:LT07156 a skos:Concept ;
    skos:definition "Polymer with stable, polymerization-active sites formed by a chain polymerization in which irreversible chain transfer and chain termination are absent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "living polymer" .

goldbook:LT07176 a skos:Concept ;
    skos:altLabel "liquid crystal polymer" ;
    skos:definition "Polymeric material that, under suitable conditions of temperature, pressure, and concentration, exists as a liquid-crystalline mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "liquid-crystalline polymer" .

goldbook:LT07408 a skos:Concept ;
    skos:altLabel "LADS" ;
    skos:definition "Acronym for lifetime-associated difference spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "LADS" .

goldbook:LT07409 a skos:Concept ;
    skos:definition "Within the Born–Oppenheimer approximation, a semi-classical model for the probability, \\(P\\), of hopping from one electronic state to another of the same or different multiplicity \\[P=\\exp (- \\frac{4\\ \\pi ^{2}\\ \\varepsilon_{12}^{2}}{h\\  u\\ |s_{1}-s_{2}|})\\] where \\(\\varepsilon_{12}\\) is the potential energy gap between the two electronic states at a surface crossing point, \\(|s_{1}- s_{2}|\\) is the difference in slopes between the intersecting potential energy curves at this point and \\( u\\) is the nuclear relative velocity with which the system passes the point of closest approach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Landau–Zener model" .

goldbook:LT07410 a skos:Concept ;
    skos:altLabel "LAS" ;
    skos:definition "Acronym for lifetime-associated spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "LAS" .

goldbook:LT07411 a skos:Concept ;
    skos:definition "Organic dyes typically used dissolved in an organic solvent. The dye solution is circulated continuously through the laser chamber of the dye laser, in which it is excited (pumped) by flash lamps or by another laser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser dye" .

goldbook:LT07412 a skos:Concept ;
    skos:definition "Technique by which high concentrations of excited states are generated in a jet, permitting the readily determination of spectroscopic properties of those states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "laser-jet photochemical technique" .

goldbook:LT07413 a skos:Concept ;
    skos:altLabel "LED" ;
    skos:definition "Acronym for light-emitting diode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "LED" .

goldbook:LT07414 a skos:Concept ;
    skos:altLabel "LED" ;
    skos:definition "Semiconductor (often a combination of gallium, arsenic and phosphorous or gallium and nitrogen) containing an n region (where electrons are more numerous than positive charges) separated from a p region (where positive charges are more numerous than negative charges). Upon application of a voltage, charges move and emission of ultraviolet, visible or infrared radiation is produced each time a charge recombination takes place. Although a LED emits incoherent monochromatic light, normally a very narrow frequency range is obtained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "light-emitting diode" .

goldbook:LT07415 a skos:Concept ;
    skos:altLabel "LD" ;
    skos:definition "For a uniaxial sample with sample axis \\(Z\\) is defined as: \\[\\Delta A_{\\rm{l}} = A_{Z} - A_{Y}\\] where \\(A_{Z}\\) and \\(A_{Y}\\) are the absorption spectra measured with the electric vector of linearly polarized light along and perpendicular to the sample axis, respectively. For an isotropic sample \\(\\Delta A_{\\rm{l}} = 0\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "linear dichroism" .

goldbook:M03659 a skos:Concept ;
    skos:altLabel "mu-" ;
    skos:definition "An affix used in names to signify that a group so designated bridges two or more centres of coordination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "µ-" .

goldbook:M03662 a skos:Concept ;
    skos:definition "A cyclic macromolecule or a macromolecule cyclic portion of a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrocycle" .

goldbook:M03663 a skos:Concept ;
    skos:definition "Macrocyclic lactones with a ring of twelve or more members." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrolides" .

goldbook:M03664 a skos:Concept ;
    skos:definition "Study of the largest-scale aspects of the atmosphere, e.g. general global circulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macrometeorology" .

goldbook:M03667 a skos:Concept ;
    skos:altLabel "macromolecular",
        "polymer molecule",
        "polymeric" ;
    skos:definition "A molecule of high relative molecular mass, the structure of which essentially comprises the multiple repetition of units derived, actually or conceptually, from molecules of low relative molecular mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromolecule" .

goldbook:M03668 a skos:Concept ;
    skos:definition "Polymer or oligomer the molecules of which each have one end-group that acts as a monomer molecule, so that each polymer or oligomer molecule contributes only a single monomer unit to a chain of the product polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromonomer" .

goldbook:M03669 a skos:Concept ;
    skos:altLabel "macromonomer unit" ;
    skos:definition "The largest constitutional unit contributed by a single macromonomer molecule to the structure of a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromonomeric unit" .

goldbook:M03670 a skos:Concept ;
    skos:definition "A macromolecule that has one end-group which enables it to act as a monomer molecule, contributing only a single monomeric unit to a chain of the final macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macromonomer molecule" .

goldbook:M03672 a skos:Concept ;
    skos:definition "Pore with width exceeding about \\(0.05\\ \\unicode[Times]{x3BC}\\rm{m}\\) or \\(50\\ \\rm{nm}\\) (\\(500\\ \\rm{Å}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macropore" .

goldbook:M03673 a skos:Concept ;
    skos:definition "A macromolecule which is also a free radical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroradical" .

goldbook:M03674 a skos:Concept ;
    skos:definition "The cross-section per unit volume of a given material for a specified process. For a pure nuclide, it is the product of the microscopic cross-section and the number of target nuclei per unit volume; for a mixture of nuclides, it is the sum of such products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroscopic cross-section" .

goldbook:M03676 a skos:Concept ;
    skos:definition "A film which has lateral dimensions above \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroscopic film" .

goldbook:M03677 a skos:Concept ;
    skos:definition "A term applied to a kinetic study in which the interest is in the behaviour of bulk systems, e.g. in changes in concentrations of reactants and products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroscopic kinetics" .

goldbook:M03680 a skos:Concept ;
    skos:definition "The deflection of an ion beam as a result of the motion of the ions in a magnetic field (magnetic sector). Generally the direction of motion of the ions is at right angles to the direction of the magnetic field, and the motion is uniform." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic deflection" .

goldbook:M03681 a skos:Concept ;
    skos:definition "Nuclei having the same resonance frequency in nuclear magnetic resonance spectroscopy and also identical spin-spin interactions with the nuclei of a neighbouring group are magnetically equivalent. The spin-spin interaction between magnetically equivalent nuclei does not appear, and thus has no effect on the multiplicity of the respective NMR signals. Magnetically equivalent nuclei are necessarily also chemically equivalent, but the reverse is not necessarily true." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic equivalence" .

goldbook:M03682 a skos:Concept ;
    skos:altLabel "<em>B</em> scan" ;
    skos:definition "The usual method of producing a momentum (mass) spectrum, by varying the strength of the magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic field scan" .

goldbook:M03685 a skos:Concept ;
    skos:definition "Magnetic flux density at the nucleus (from experiment) in those cases in which the magnetic hyperfine interaction can be described by an effective field. In other cases the vector components of the magnetic hyperfine interaction should be reported if possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic flux density" .

goldbook:M03690 a skos:Concept ;
    skos:definition "A transition between disordered and ordered arrays of atomic magnetic moments. Where the ordered phase has a net spontaneous magnetization, \\(M_{\\rm{S}}\\), the magnetic-ordering temperature is called a curie temperature, \\(T_{\\rm{C}}\\); where the net spontaneous magnetization of the ordered phase remains zero, the ordering temperature is called a Néel temperature, \\(T_{\\rm{N}}\\). The temperature at which the two ferromagnetic subarrays of a ferrimagnet just cancel each other is called the compensation point. Materials exhibit ferromagnetic behaviour when unpaired electron spins are aligned in parallel, antiferromagnetic behaviour when the alignment is antiparallel, and ferrimagnetic behaviour if the alignment of the spins is antiparallel with unequal numbers in the two orientations or if the spins are canted. Therefore, ferromagnetic, ferrimagnetic and weak ferromagnetic transitions involve a net magnetic moment change, whereas antiferromagnetic transitions have zero net magnetic moment change." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic transition" .

goldbook:M03692 a skos:Concept ;
    skos:definition "NMR method for determining kinetics of chemical exchange by perturbing the magnetization of nuclei in a particular site or sites and following the rate at which magnetic equilibrium is restored. The most common perturbations are saturation and inversion, and the corresponding techniques are often called 'saturation transfer' and 'selective inversion-recovery'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetization transfer" .

goldbook:M03694 a skos:Concept ;
    skos:altLabel "backbone" ;
    skos:definition "That linear chain to which all other chains, long or short or both, may be regarded as being pendant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main chain" .

goldbook:M03695 a skos:Concept ;
    skos:altLabel "mancunide-ring systems" ;
    skos:definition "Rings having (formally) the maximum number of noncumulative double bonds, e.g. benzene, indene, indole, 4H-1,3-dioxine. Also called mancunide-ring systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mancude-ring systems" .

goldbook:M03697 a skos:Concept ;
    skos:definition "A hand-operated or -controlled device for remotely handling radioactive materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "manipulator" .

goldbook:M03698 a skos:Concept ;
    skos:definition "Refers to physical human intervention in an analytical procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "manual" .

goldbook:M03699 a skos:Concept ;
    skos:definition "The determination of the relative positions of genes within the chromosomes of restriction sites along a DNA molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mapping" .

goldbook:M03700 a skos:Concept ;
    skos:definition "Motions of the surface of a liquid are coupled with those of the subsurface fluid or fluids, so that movements of the liquid normally produce stresses in the surface and vice versa. The movement of the surface and of the entrained fluid(s) caused by surface tension gradients is called the Marangoni effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Marangoni effect" .

goldbook:M03701 a skos:Concept ;
    skos:definition "A path trajectory over a potential-energy surface which corresponds to the outermost vibrational turning points for the molecular species involved. This path was suggested as a device for calculating the probability of quantum-mechanical tunnelling: the trajectory for the system is considered to follow this path." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Marcus–Coltrin path" .

goldbook:M03702 a skos:Concept ;
    skos:definition "Relation between the rate of outer-sphere electron transfer and the thermodynamics of this process. Essentially, the rate constant within the encounter complex (or the rate constant of intramolecular transfer) is given by the Eyring equation: \\[k_{\\mathrm{ET}}=\\frac{\\kappa _{\\mathrm{ET}}\\ k\\ T}{h}\\ \\exp (- \\frac{\\Delta G^{\\ddagger }}{R\\ T})\\] where \\(k\\) is the Boltzmann constant, \\(h\\) the Planck constant, \\(R\\) the gas constant and \\(\\kappa _{\\rm{ET}}\\) the so-called electronic transmission factor (\\(\\kappa _{\\rm{ET}}\\sim 1\\) for adiabatic and \\(" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Marcus equation" .

goldbook:M03703 a skos:Concept ;
    skos:definition "Relationship between the barrier (\\(\\Delta G^{\\ddagger}\\)) to thermal electron transfer, the energy of a corresponding optical charge-transfer transition (\\(\\Delta E_{\\rm{op}}\\)), and the overall change in standard Gibbs energy accompanying thermal electron transfer (\\(\\Delta G^{\\,\\unicode{x26ac}}\\)). Assuming a quadratic relation between the energy of the system and its distortions from equilibrium (harmonic oscillator model) the expression obtained is: \\[\\Delta G^{\\ddagger} = \\frac{\\Delta E_{\\rm{op}}^{2}}{4\\ (\\Delta E_{\\rm{op}}\\,-\\,\\Delta G^{o})}\\] The simplest form of this expression obtains for degenerate electron transfer (\\(\\Delta G^{\\,\\unicode{x26ac}}\\)) in e.g. symmetrical mixed valence systems: \\[\\Delta G^{\\ddagger} = \\frac{\\Delta E_{\\rm{op}}}{4}\\] Note that for this situation the Marcus equation reads: \\[\\Delta G^{\\ddagger} = \\frac{\\lambda }{4}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Marcus–Hush relationship" .

goldbook:M03705 a skos:Concept ;
    skos:definition "(DNA) A fragment of known size used as reference for analytical purposes.(genetic) A gene with known phenotype and mapped position.(chromatography) A reference substance co-chromatographed with the sample to assist in identifying the components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "marker" .

goldbook:M03707 a skos:Concept ;
    skos:altLabel "Markownikov rule" ;
    skos:definition "'In the addition of hydrogen halides to unsymmetrically constituted [unsaturated] hydrocarbons, the halogen atom becomes attached to the carbon bearing the lesser number of hydrogen atoms.' Originally formulated by Markownikoff (Markovnikov) to generalize the orientation in additions of hydrogen halides to simple alkenes, this rule has been extended to polar addition reaction as follows. 'In the heterolytic addition of a polar molecule to an alkene or alkyne, the more electronegative (nucleophilic) atom (or part) of the polar molecule becomes attached to the carbon atom bearing the smaller number of hydrogen atoms.' This is an indirect statement of the common mechanistic observation, that the more electropositive (electrophilic) atom (or part) of the polar molecule becomes attached to the end of the multiple bond that would result in the more stable carbenium ion (whether or not a carbenium ion is actually formed as a reaction intermediate in the addition reaction). Addition in the opposite sense is commonly called 'anti-Markovnikov addition'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Markownikoff rule" .

goldbook:M03708 a skos:Concept ;
    skos:definition "A diffusionless transition (first studied in the steel alloy, Martensite), at constant composition, generated by coordinated atomic, ionic or molecular displacements over distances smaller than interatomic distances in the parent phase. The cooperative rearrangements of the crystal structure generally take place progressively by the movement of a two-dimensional interface through the solid. Examples: The face-centred-cubic to body-centred-tetragonal transition of iron containing some carbon; the transition of tetragonal $\\ce{ZrO2}$ to monoclinic $\\ce{ZrO2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "martensitic transition" .

goldbook:M03709 a skos:Concept ;
    skos:definition "Base quantity in the system of quantities upon which SI is based." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass" .

goldbook:M03710 a skos:Concept ;
    skos:definition "A process by which a mixture of ionic or neutral species is identified according to the mass-to-charge (\\(\\frac{m}{z}\\)) ratios (ions) or their aggregate atomic masses (neutrals). The analysis may be qualitative and/or quantitative." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass analysis" .

goldbook:M03711 a skos:Concept ;
    skos:definition "Mass-average velocity: \\[ u_{b} = \\rho ^{-1}\\ \\sum C_{i}M_{i} u_{i}\\] Cf. molar average velocity: \\[ u_{m} = c_{t}^{-1}\\ \\sum c_{i} u_{i}\\] with \\(c_{t}=\\sum c_{i}\\) where \\(M_{i}\\) = molar mass, \\(c_{t}\\) = total concentration (\\(\\pu{mol m-1}\\)), \\(\\rho \\) = density of the solution (\\(\\pu{kg m-3}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-average velocity" .

goldbook:M03712 a skos:Concept ;
    skos:definition "Summation of the masses of a given element in its various compounds before and after reaction (changes) in the atmosphere; provides a test of the completeness of the accounting of the various reaction paths for this element which can be had through the compounds which have been analysed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass balance" .

goldbook:M03713 a skos:Concept ;
    skos:definition "Mass of a constituent divided by the volume of the mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass concentration" .

goldbook:M03715 a skos:Concept ;
    skos:definition "Change in mass density in a small distance divided by that distance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass density gradient" .

goldbook:M03718 a skos:Concept ;
    skos:definition "The fraction (\\(1 - R\\)) of a component in the stationary phase divided by the fraction (\\(R\\)) in the mobile phase: \\[D_{\\rm{m}}=\\frac{\\rm{amount of substance in the stationary phase}}{\\rm{amount of component in the mobile phase}}\\] This term is recommended in preference to the term capacity factor frequently used in the chromatographic literature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass distribution ratio" .

goldbook:M03720 a skos:Concept ;
    skos:definition "Mass of a material crossing a surface divided by the time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass flow rate" .

goldbook:M03721 a skos:Concept ;
    skos:definition "A device the response of which is proportional to the amount of sample component reaching the detector in unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-flow sensitive detector" .

goldbook:M03722 a skos:Concept ;
    skos:definition "Mass of a constituent divided by the total mass of all constituents in the mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass fraction" .

goldbook:M03723 a skos:Concept ;
    skos:definition "Attribute to a physical quantity obtained by division by mass; synonymous with specific." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "massic" .

goldbook:M03724 a skos:Concept ;
    skos:definition "A transition in which a crystal structure is changed into a new structure during cooling or heating, predominantly by interface-controlled reactions and the usual nucleation and growth characteristics associated with thermal diffusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "massive transition" .

goldbook:M03725 a skos:Concept ;
    skos:definition "At equilibrium, the product of the activities (or concentrations) of the reacting species is constant. Thus for the equilibrium: \\[\\alpha\\,\\rm{A}\\,+\\,\\beta\\,\\rm{B}\\rightleftharpoons \\gamma\\,\\rm{C}\\,+\\,\\delta\\,\\rm{D}\\] \\[K=\\frac{\\left[\\rm{C}\\right]^{\\gamma }\\ \\left[\\rm{D}\\right]^{\\delta }}{\\left[\\rm{A}\\right]^{\\alpha }\\ \\left[\\rm{B}\\right]^{\\beta }}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-law effect" .

goldbook:M03726 a skos:Concept ;
    skos:definition "Total number of heavy particles (protons and neutrons jointly called nucleons) in the atomic nucleus. Also called nucleon number. Symbol \\(m\\) in mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass number" .

goldbook:M03727 a skos:Concept ;
    skos:altLabel "weight of the stationary phase" ;
    skos:definition "The mass (weight) of the liquid stationary phase or the active solid in the column. The mass (weight) of any solid support is not included. In the case of partition chromatography with a liquid stationary phase it is identical to the liquid phase mass (weight)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass of the stationary phase" .

goldbook:M03728 a skos:Concept ;
    skos:definition "A record of the ion current, at a specific mass to charge ratio, received by the collector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass peak" .

goldbook:M03729 a skos:Concept ;
    skos:definition "The range of mass numbers which can be characterized by a mass spectrometer with sufficient resolution to differentiate adjacent peaks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass range" .

goldbook:M03730 a skos:Concept ;
    skos:definition "Commonly and also acceptably defined in terms of the overlap (or 'valley') between two peaks. Thus for two peaks of equal height, masses \\(m_{1}\\) and \\(m_{2}\\), when there is overlap between the two peaks to a stated percentage of either peak height (10% is recommended), then the resolving power is defined as \\(\\frac{m_{1}}{m_{1} - m_{2}}\\). The percentage overlap (or 'valley') concerned must always be stated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass resolving power" .

goldbook:M03731 a skos:Concept ;
    skos:definition "An instrument in which beams of ions are separated (analysed) according to the quotient mass/charge, and in which the deflection and intensity of the beams are recorded directly on photographic plate or film." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrograph" .

goldbook:M03732 a skos:Concept ;
    skos:definition "An instrument in which beams of ions are separated (analysed) according to the quotient mass/charge, and in which the ions are measured electrically. This term should also be used when a scintillation detector is employed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrometer" .

goldbook:M03733 a skos:Concept ;
    skos:definition "A mass spectrometer in which the ions to be separated absorb maximum energy through the effect of alternating electric fields which are parallel to the path of the ions. These ions are then separated from other ions with different mass/charge by an additional electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrometer" .

goldbook:M03736 a skos:Concept ;
    skos:altLabel "mass spectrometer deflection system" ;
    skos:definition "An assembly permitting the separation of ions according to their mass-to-charge ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrometer focusing system" .

goldbook:M03745 a skos:Concept ;
    skos:definition "A mass spectrometer used as a detector to give qualitative and quantitative data on the various eluted substances. The mass spectrum of the eluted compounds provides evidence beyond the elution time as to the chemical nature of the species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrometric detector" .

goldbook:M03746 a skos:Concept ;
    skos:definition "The branch of science dealing with all aspects of mass spectroscopes and the results obtained with these instruments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrometry" .

goldbook:M03748 a skos:Concept ;
    skos:definition "The study of systems by causing the formation of gaseous ions, with or without fragmentation, which are then characterized by their mass-to-charge ratios and relative abundances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectroscopy" .

goldbook:M03749 a skos:Concept ;
    skos:definition "A spectrum which is obtained when a beam of ions is separated according to the mass-to-charge (\\(\\frac{m}{z}\\)) ratios of the ionic species contained within it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass spectrum" .

goldbook:M03751 a skos:Concept ;
    skos:definition "Processes of the charge-stripping type: \\[\\rm{M}^{+}+\\rm{X}\\rightarrow \\rm{M}^{2+}+\\rm{X}+\\rm{e}\\] occuring in a collision cell (containing a gas, X) located in a field-free region preceding a magnetic and electric sector combination placed in either order, may be detected as follows. If the instrument slits are wide and if the electric sector field \\(E\\) is set to half the value required to transmit the main ion-beam, the only ions to be transmitted will be those with a kinetic energy/charge ratio half, or almost exactly half, that of the main ion beam. The product ions of the charge-stripping process fulfil this condition. If the magnetic field \\(B\\) is scanned, a mass spectrum of such doubly-charged product ions, and thus of their singly-charged precursors, is obtained. Such a spectrum is called an \\(\\frac{E}{2}\\) mass spectrum. Interference from product ions from processes of the type: \\[\\rm{M}_{1}^{+}+\\rm{X}\\rightarrow \\rm{M}_{2}^{+}+\\rm{X}+\\rm{M}_{3}\\] where \\(m_{1}\\), \\(m_{2}\\), and (\\(m_{1}- m_{2}\\)) are the masses of \\(\\rm{M}_{1}^{+}\\), \\(\\rm{M}_{2}^{+}\\) and \\(\\rm{M}_{3}\\), respectively, and where \\(m_{2}=0.5\\ m_{1}\\), can arise in \\(\\frac{E}{2}\\) mass spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "E/2 mass spectrum" .

goldbook:M03752 a skos:Concept ;
    skos:definition "The abbreviation \\(\\frac{m}{z}\\) is used to denote the dimensionless quantity formed by dividing the mass number of an ion by its charge number. It has long been called the mass-to-charge ratio although \\(m\\) is not the ionic mass nor is \\(z\\) a multiple or the elementary (electronic) charge, \\(e\\). The abbreviation \\(\\frac{m}{e}\\) is, therefore, not recommended. Thus, for example, for the ion ($\\ce{C7H7^{2+}}$), \\(\\frac{m}{z}\\) equals 45.5." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-to-charge ratio" .

goldbook:M03753 a skos:Concept ;
    skos:definition "Spontaneous (irreversible) process of transfer of mass across non-homogeneous fields. The driving force can be difference in concentration (in liquids) or partial pressure (in gases) of the component. In fluids, mass transfer may be enhanced by turbulent flow. In biological systems, mass transfer through membranes may result from normal diffusion, facilitated diffusion or active transport." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass transfer" .

goldbook:M03754 a skos:Concept ;
    skos:definition "The heterogeneous diffusion rate constant defined for the case of the limiting current. A more general definition in terms of the electrode current densities is: \\[k_{\\rm{d}}=\\frac{j\\  u }{n\\ F\\ (c_{\\rm{e}}- c_{0})}\\] or \\[k_{\\rm{d}} = \\frac{j\\  u \\ (1- t_{\\rm{B}}\\ n\\  u ^{-1}\\ z_{\\rm{B}}^{-1})}{n\\ F\\ (c_{\\rm{e}}- c_{0})}\\] where \\(j\\) is the electrode current density, \\( u \\) is the stoichiometric number, \\(n\\) is the charge number of the electrode reaction, \\(F\\) is the Faraday constant, \\(c_{\\rm{e}}\\) is the interfacial concentration, \\(c_{0}\\) is the bulk concentration, \\(t_{\\rm{B}}\\) is the transport number of species B, and \\(z_{\\rm{B}}\\) is the charge number of species B." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass transfer coefficient" .

goldbook:M03755 a skos:Concept ;
    skos:definition "In controlled-potential coulometry and related techniques, the empirically evaluated constant of proportionality defined by the equation \\[s_{\\rm{B}}=- \\frac{1}{c_{\\rm{B}}}\\ \\frac{\\mathrm{d}c_{\\rm{B}}}{\\mathrm{d}t}\\] where \\(c_{\\rm{B}}\\) is the bulk concentration of the substance B, and \\(\\frac{\\rm{d}c_{\\rm{B}}}{\\rm{d}t}\\) is the rate of change of that concentration, resulting from the consumption of B by reduction or oxidation at the working electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass-transfer-controlled electrolyte rate constant" .

goldbook:M03756 a skos:Concept ;
    skos:definition "A pair of cells with closely similar optical properties are called matched cells. One cell is the sample cell while the other, the reference (or blank) cell contains the solvent or a reference solution. In double beam spectrometers, radiation is passed either simultaneously or alternately through the cells. In single beam instruments the cells are moved sequentially into the radiation beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matched cells" .

goldbook:M03757 a skos:Concept ;
    skos:altLabel "MSDS" ;
    skos:definition "Compilation of information required under the US OSHA Hazard Communication Standard on the identity of hazardous substances, health and physical hazards, exposure limits and precautions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "material safety data sheet" .

goldbook:M03758 a skos:Concept ;
    skos:definition "The components of the sample other than the analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix" .

goldbook:M03759 a skos:Concept ;
    skos:definition "The combined effect of all components of the sample other than the analyte on the measurement of the quantity. If a specific component can be identified as causing an effect then this is referred to as interference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix effect" .

goldbook:M03760 a skos:Concept ;
    skos:definition "A term which refers to the isolation of a reactive or unstable species by dilution in an inert matrix (argon, nitrogen, etc.), usually condensed on a window or in an optical cell at low temperature, to preserve its structure for identification by spectroscopic or other means." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "matrix isolation" .

goldbook:M03761 a skos:Concept ;
    skos:definition "An arrangement for a double-focusing mass spectrograph in which a deflection of \\(\\frac{\\pi}{4\\ \\sqrt{2}}\\) radians in a radial electrostatic field is followed by a magnetic deflection of \\(\\frac{\\pi}{2}\\) radians." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mattauch–Herzog geometry" .

goldbook:M03762 a skos:Concept ;
    skos:definition "The maximum concentration of a pollutant which is considered harmless to healthy adults during their working hours, assuming they breathe uncontaminated air at all other times." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum allowable concentration" .

goldbook:M03763 a skos:Concept ;
    skos:definition "Standards for maximum concentration of air pollutant emission from stationary or mobile sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum emission concentration" .

goldbook:M03765 a skos:Concept ;
    skos:definition "Maximum daily dose of substance whose penetration into a human body during a lifetime will not cause diseases or health hazards that can be detected by current investigation methods and will not adversely affect future generations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum permissible daily dose" .

goldbook:M03766 a skos:Concept ;
    skos:altLabel "MPL" ;
    skos:definition "Level, usually a combination of time and concentration, beyond which any exposure of humans to a chemical or physical agent in their immediate environment is unsafe." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum permissible level" .

goldbook:M03767 a skos:Concept ;
    skos:definition "Period during which there is no change in concentration in excess of the value of the uncertainty of the concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum storage life" .

goldbook:M03768 a skos:Concept ;
    skos:altLabel "MTC" ;
    skos:definition "Highest concentration of a substance in an environmental medium that does not cause death of test organisms or species (denoted by \\(\\rm{LC}_{0}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum tolerable concentration" .

goldbook:M03769 a skos:Concept ;
    skos:altLabel "MTD" ;
    skos:definition "Highest amount of a substance that, when introduced into the body, does not kill test animals (denoted by \\(\\rm{LD}_{0}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum tolerable dose" .

goldbook:M03770 a skos:Concept ;
    skos:altLabel "MTEL" ;
    skos:definition "Maximum amount or concentration of a substance to which an organism can be exposed without leading to an adverse effect after prolonged exposure time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum tolerable exposure level" .

goldbook:M03771 a skos:Concept ;
    skos:altLabel "MTD" ;
    skos:definition "High dose used in chronic toxicity testing that is expected on the basis of an adequate subchronic study to produce limited toxicity when administered for the duration of the test period. It should not induce: (a) overt toxicity, for example appreciable death of cells or organ dysfunction, or (b) toxic manifestations that are predicted materially to reduce the life span of the animals except as the result of neoplastic development or (c) 10% or greater retardation of body weight gain as compared with control animals. In some studies, toxicity that could interfere with a carcinogenic effect is specifically excluded from consideration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum tolerated dose" .

goldbook:M03774 a skos:Concept ;
    skos:definition "Defined by the equation: \\[a_{\\pm }=\\mathrm{e}^{(\\mu _{\\rm{B}}- \\mu _{\\rm{B}}^{\\unicode{x29B5}})\\  u \\ R\\ T}\\] where \\(\\mu _{\\rm{B}}\\) is the chemical potential of the solute $\\ce{B}$ in a solution containing B and other species. The nature of $\\ce{B}$ must be clearly stated: it is taken as a group of ions of two kinds carrying an equal number of positive and negative charges, e.g. $\\ce{Na^{+}} + \\ce{NO3^{−}}$ or $\\ce{Ba^{2+}} + \\ce{2Cl^{−}}$ or $\\ce{2Al^{3+}} + \\ce{3SO4^{2−}}$. \\(v\\) is the total number of ions making up the group i.e. 2, 3 and 5 respectively in the above examples. \\(\\mu _{\\rm{B}}^{\\unicode{x29B5}}\\) is the chemical potential of $\\ce{B}$ in its standard state, usually the hypothetical ideal solution of concentration \\(\\pu{1 mol kg -1}\\) and at the same temperature and pressure as the solution under consideration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean activity of an electrolyte in solution" .

goldbook:M03775 a skos:Concept ;
    skos:definition "The catalytic activity of a specified component in or moved from a system divided by the time during which the component was changed or moved. This kind of quantity should not be confused with rate of reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean catalytic activity rate" .

goldbook:M03776 a skos:Concept ;
    skos:definition "Defined as \\[j=\\frac{I}{A}\\] where \\(I\\) is the electric current and \\(A\\) is usually taken as the geometric area of the electrode. However the nature of the area used in this calculation must be clearly stated. In interpreting the mean current density it is important to know whether the current is uniformly distributed over the electrode interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean current density" .

goldbook:M03777 a skos:Concept ;
    skos:definition "Defined by \\[j_{0}=\\frac{I_{0}}{A}\\] where \\(I_{0}\\) is the exchange current of the electrode reaction and \\(A\\) is usually taken as the geometric area of the electrode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean exchange current density" .

goldbook:M03778 a skos:Concept ;
    skos:definition "The average distance a molecule travels between collisions. For a molecule, \\(\\lambda = (\\sqrt{2}\\ \\pi \\ n\\ d_{\\rm{m}}^{2})^{-1}\\), where \\(n\\) is the number of molecules per unit volume and \\(d_{\\rm{m}}\\) is their mean diameter. For $\\ce{O2}$ at one atmosphere and \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\), this distance is only \\(9.7\\times 10^{-6}\\ \\rm{cm}\\); at \\(10^{-6}\\) atmospheres and \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\) it is \\(9.7\\ \\rm{cm}\\). For an aerosol particle, the mean free path, \\(\\lambda _{\\rm{B}}\\) in the Stokes region (see Stokes law) is given by: \\(\\lambda _{\\rm{B}} = \\sqrt{\\frac{3\\ k\\ T}{m}}\\ m\\ B\\) where \\(m\\) is the mass of the particle, \\(k\\) is the Boltzmann constant (\\(1.381\\times 10^{-23}\\ \\rm{J K}^{-1}\\)), \\(T\\) is the temperature (\\(\\rm{K}\\)) and \\(B\\) is the mobility." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean free path" .

goldbook:M03782 a skos:Concept ;
    skos:definition "In a given material, for specified charged particles of a specified energy, the average displacement of the particles before they stop." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean linear range" .

goldbook:M03783 a skos:Concept ;
    skos:definition "The mean linear range multiplied by the mass density of the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean mass range" .

goldbook:M03784 a skos:Concept ;
    skos:definition "The mass of a specified component changed in or moved to or from a system divided by the time during which the component was changed or moved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean mass rate" .

goldbook:M03785 a skos:Concept ;
    skos:definition "The mean time during which the molecules remain on the surface of the adsorbent, i.e. the mean time interval between impact and desorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean residence time" .

goldbook:M03786 a skos:Concept ;
    skos:definition "The amount of substance of a specified component changed in or moved to or from a system divided by the time during which the component was changed or moved. This kind of quantity usually should be preferred to mean mass rate or mean volume rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean substance rate" .

goldbook:M03787 a skos:Concept ;
    skos:definition "The volume of a specified component changed in or moved to or from a system divided by the time during which the component was changed or moved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mean volume rate" .

goldbook:M03788 a skos:Concept ;
    skos:definition "An attribute of a substance which may be distinguished qualitatively and determined quantitatively. In the context of analytical chemistry, the attribute may refer to a physical quantity such as X- or $\\upgamma\\!\\mbox{-}\\rm{ray\\ energy}$, or it may refer to a measure of amount such as mass or concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurable quantity" .

goldbook:M03789 a skos:Concept ;
    skos:definition "Particular quantity subject to measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurand" .

goldbook:M03790 a skos:Concept ;
    skos:definition "The spectrum observed by measuring the variation of the luminescence flux from an analyte as a function of the excitation wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measured excitation spectrum" .

goldbook:M03792 a skos:Concept ;
    skos:definition "Synonymous with spectrogram." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measured spectrum" .

goldbook:M03793 a skos:Concept ;
    skos:definition "The observed value of weight, volume, meter-reading or other quantity, found in the analysis of a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measured value" .

goldbook:M03794 a skos:Concept ;
    skos:definition "A description of a property of a system by means of a set of specified rules, that maps the property onto a scale of specified values, by direct or 'mathematical' comparison with specified reference(s). The demand for rules makes 'measurement' a scientific concept in contrast to the mere colloquial sense of 'description'. However, in the present definition, 'measurement' has a wider meaning than given in elementary physics. Even a very incomplete description of, for instance, a patient (at a stated time) has to be given by a set of measurements, that are easier to manage and grasp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement" .

goldbook:M03795 a skos:Concept ;
    skos:definition "The minimum value above which the difference of two values of air quality characteristic can be distinguished with 95% probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement resolution" .

goldbook:M03796 a skos:Concept ;
    skos:definition "The outcome of an analytical measurement (application of the chemical measurement process), or value attributed to a measurand. This may be the result of direct observation, but more commonly it is given as a statistical estimate derived from a set of observations. The distribution of such estimates (estimator distribution) characterizes the chemical measurement process, in contrast to a particular estimate, which constitutes an experimental result. Additional characteristics become evident if we represent \\(\\hat{x}\\) as follows: \\[\\begin{array}{c}   &&& e  & \\\\   &&& ⎴ ⎴ ⎴ & \\\\  \\hat{x}=\\tau +e = &\\tau& + &\\Delta& + &\\delta&= \\mu +\\delta \\\\   & ⎵ ⎵ ⎵ &&& \\\\   & \\mu &&&  \\end{array}\\] The true value, \\(\\tau \\), is the value \\(x\\) that would result if the chemical measurement process were error-free. The error, \\(e\\), is the difference between an observed (estimated) value and the true value; i.e. \\(e=\\hat{x}- \\tau \\) (signed quantity). The total error generally has two components, bias (\\(\\mathit{\\Delta}\\)) and random error (\\(\\delta \\)), as indicated above. The limiting mean, \\(\\mu\\), is the asymptotic value or population mean of the distribution that characterizes the measured quantity; the value that is approached as the number of observations approaches infinity. Modern statistical terminology labels this quantity the expectation value or expected value, \\(E(\\hat{x})\\). The bias, \\(\\mathit{\\Delta}\\), is the difference between the limiting mean and the true value; i.e. \\(\\mathit{\\Delta} = \\mu - \\tau \\) (signed quantity). The random error, \\(\\delta \\), is the difference between an observed value and the limiting mean; i.e. \\(\\delta = \\hat{x} - \\mu \\) (signed quantity)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement result" .

goldbook:M03797 a skos:Concept ;
    skos:definition "The solution that is presented to the measuring device. It comprises the test solution, or an aliquot thereof, after it has undergone any treatment required prior to the presentation to the measuring device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement solution" .

goldbook:M03798 a skos:Concept ;
    skos:definition "The minimum concentration of a substance which produces a quantifiable signal with a given uncertainty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "measurement threshold" .

goldbook:M03801 a skos:Concept ;
    skos:definition "An apparatus containing an element (hair, goldbeater's skin, carbon-film) whose dimension or mass varies as a function of its water content." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanical hygrometer" .

goldbook:M03803 a skos:Concept ;
    skos:definition "The use of devices to replace, refine, extend or supplement human effort. The corresponding verb is to mechanize." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanization" .

goldbook:M03804 a skos:Concept ;
    skos:altLabel "reaction mechanism" ;
    skos:definition "A detailed description of the process leading from the reactants to the products of a reaction, including a characterization as complete as possible of the composition, structure, energy and other properties of reaction intermediates, products and transition states. An acceptable mechanism of a specified reaction (and there may be a number of such alternative mechanisms not excluded by the evidence) must be consistent with the reaction stoichiometry, the rate law and with all other available experimental data, such as the stereochemical course of the reaction. Inferences concerning the electronic motions which dynamically interconvert successive species along the reaction path (as represented by curved arrows, for example) are often included in the description of a mechanism. It should be noted that for many reactions all this information is not available and the suggested mechanism is based on incomplete experimental data. It is not appropriate to use the term mechanism to describe a statement of the probable sequence in a set of stepwise reactions. That should be referred to as a reaction sequence, and not a mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanism" .

goldbook:M03805 a skos:Concept ;
    skos:altLabel "suicide inhibition" ;
    skos:definition "Irreversible inhibition of an enzyme due to its catalysis of the reaction of an artificial substrate. Also called 'suicide inhibition'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mechanism-based inhibition" .

goldbook:M03806 a skos:Concept ;
    skos:definition "Depending on whether the number of observations is even or odd, the median can be estimated as follows:   If \\(n=2\\ m+1\\): The middle value of a series of observations, arranged in increasing or decreasing order.   If \\(n=2\\ m\\): The arithmetic mean of the two middle values of a series of observations, arranged in increasing or decreasing order.   Comment: The use of the median when reporting results of chemical analysis is generally not recommended, because its statistical efficiency is less than that of the mean. In certain cases, however, especially when treating small sets of data, the median may offer advantages because it is a so-called 'robust statistic', i.e. it offers considerable resistance to the effects of isolated outliers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median" .

goldbook:M03807 a skos:Concept ;
    skos:definition "Statistically derived concentration of a substance in an environmental medium expected to produce a certain effect in 50% of test organisms in a given population under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median effective concentration" .

goldbook:M03808 a skos:Concept ;
    skos:definition "Statistically derived dose of a chemical or physical agent (radiation) expected to produce a certain effect in 50% of test organisms in a given population or to produce a half-maximal effect in a biological system under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median effective dose" .

goldbook:M03809 a skos:Concept ;
    skos:definition "Statistically derived concentration of a substance in an environmental medium expected to kill 50% of organisms in a given population under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median lethal concentration" .

goldbook:M03810 a skos:Concept ;
    skos:definition "Statistically derived dose of a chemical or physical agent (radiation) expected to kill 50% of organisms in a given population under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median lethal dose" .

goldbook:M03811 a skos:Concept ;
    skos:definition "Statistically derived average time interval during which 50% of a given population may be expected to die following acute administration of a chemical or physical agent (radiation) at a given concentration under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median lethal time" .

goldbook:M03812 a skos:Concept ;
    skos:definition "Statistically derived concentration of a substance in an environmental medium expected to cause narcotic conditions in 50% of a given population under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median narcotic concentration" .

goldbook:M03813 a skos:Concept ;
    skos:definition "Statistically derived dose of a substance expected to cause narcosis in 50% of test animals under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "median narcotic dose" .

goldbook:M03814 a skos:Concept ;
    skos:definition "The phase (and composition of the phase) in which chemical species and their reactions are studied in a particular investigation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medium" .

goldbook:M03815 a skos:Concept ;
    skos:definition "The medium effect on ionic species B due to transfer from solvent \\(\\rm{S}_{1}\\) to solvent \\(\\rm{S}_{2}\\) (number) is defined by \\[R\\ T\\ \\ln \\gamma _{\\rm{S}_{1}}^{\\rm{S}_{2}}\\left(\\rm{B}\\right)=\\mu _{\\rm{B}}^{\\rm{o},\\rm{S}_{2}}- \\mu _{\\rm{B}}^{\\rm{o},\\rm{S}_{1}}\\] where \\(R\\) is the gas constant, \\(T\\) is the thermodynamic temperature and \\(\\mu _{\\rm{B}}^{\\rm{o},\\rm{S}_{i}}\\) is the standard chemical potential of B in solvent \\(\\rm{S}_{i}\\) (where \\(i\\) = 1 or 2), the reference states being the same in both solvents. \\(\\gamma _{\\rm{S}_{1}}^{\\rm{S}_{2}}(\\rm{B})\\) is not an exactly measurable quantity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medium effect" .

goldbook:M03816 a skos:Concept ;
    skos:altLabel "medium-pressure mercury arc" ;
    skos:definition "Non-coherent radiation source containing mercury vapour at pressures ranging from \\(50\\) to several hundred \\(\\mathrm{kPa}\\) (\\(1\\ \\rm{atm} = 101.325\\ \\rm{kPa}\\)). Emits mostly from \\(200\\) to \\(1000\\ \\rm{nm}\\) with the most intense lines approximately at \\(218\\), \\(248\\), \\(254\\), \\(266\\), \\(280\\), \\(289\\), \\(297\\), \\(303\\), \\(313\\), \\(334\\), \\(366\\), \\(406\\), \\(408\\), \\(436\\), \\(546\\) and \\(578\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "medium-pressure mercury lamp" .

goldbook:M03818 a skos:Concept ;
    skos:definition "The reductive cell division which results in daughter cells containing one copy of each of the chromosome of the parent. The entire meiotic process involves two separate divisions (meiosis I and meiosis II). The first division is a true reductive division with the chromosome number being halved, whereas the second division resembles mitosis in many ways. Thus, a diploid parental cell will give rise to haploid daughter cells (cf. ploidy)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "meiosis" .

goldbook:M03819 a skos:Concept ;
    skos:definition "A cyclohexadienyl derivative formed as Lewis adduct from a nucleophile (Lewis base) and an aromatic or heteroaromatic compound, also called Jackson–Meisenheimer adduct. In earlier usage the term 'Meisenheimer complex' was restricted to the typical Meisenheimer alkoxide adduct of nitro-substituted aromatic ethers, e.g.  Analogous cationic adducts, such as:  considered to be reaction intermediates in electrophilic aromatic substitution reactions, are called 'Wheland intermediates', and sometimes, inappropriately, $\\ce{\\upsigma\\!\\mbox{-}complexes}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Meisenheimer adduct" .

goldbook:M03821 a skos:Concept ;
    skos:definition "The conversion of a solid to a liquid by the application of heat and/or pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melting" .

goldbook:M03822 a skos:Concept ;
    skos:definition "The term originally signified that a correction was made (not made) for the emergent stem of the thermometer. In current usage it often means that the accuracy of the thermometer was (was not) verified. This current usage is inappropriate and should be abandoned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "melting point corrected" .

goldbook:M03823 a skos:Concept ;
    skos:definition "A general term which refers to a continuous layer, usually consisting of a semi-permeable material, with controlled permeability covering a structure, such as carbon or an inert metal, or separating two electrolyte solutions. This latter case is the most general form of an ion-selective electrode. The membrane separates the internal components of the ion-selective electrode from the test solution. The membrane of an ion-selective electrode is responsible for the EMF response and selectivity of the entire electrode. Comment: Membranes of sensor electrodes are thought to be practically homogeneous, but an actual membrane may contain inhomogeneous regions, often at surfaces, and connected with materials and preparation methods used. Inhomogeneous regions include low dielectric polymer regions with few charge sites and regions with high local site densities. Surface regions of plasticized liquid membranes often are low in sites and high in plasticizer or exuded impurities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane" .

goldbook:M03824 a skos:Concept ;
    skos:altLabel "emf" ;
    skos:definition "The potential difference \\(E_{\\rm{m}}\\) between two saturated $\\ce{KCl}$ bridges inserted into two solutions separated by a membrane. The solutions need not be in equilibrium with one another and need not contain any colloidal material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane emf" .

goldbook:M03825 a skos:Concept ;
    skos:definition "Synonymous with membrane emf." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane potential" .

goldbook:M03826 a skos:Concept ;
    skos:definition "Membranes frequently contain built-in 'fixed' charged sites (e.g. immobile $\\ce{–(SO3^{−})}$ in polystyrenesulfonate), or intentionally added, hydrophobically trapped, 'mobile' sites [e.g. tetraphenylborate in plasticized poly(vinyl chloride)]. Such membranes with charged sites are named sited membranes. Ions of opposite sign in the membrane are 'counter-ions'. Ions of the same sign as sites are not present in significant quantities, and are co-ions. Sited membranes are 'permselective' to counter-ions i.e. only counter-ions exchange into the membrane and therefore have some mobility in the membrane bulk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane sites" .

goldbook:M03827 a skos:Concept ;
    skos:definition "In instruments used for atmospheric trace component analysis, the dependence of an instrument reading on one or several previous sample(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "memory effect" .

goldbook:M03828 a skos:Concept ;
    skos:definition "An affix used in names to denote meridional; three groups occupying vertices of an octahedral coordination sphere in such a relationship that one is cis to the two others which are themselves trans, not now recommended for precise nomenclature purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>mer</i>-" .

goldbook:M03834 a skos:Concept ;
    skos:definition "For mercury released directly as atomic vapour, different direct transfer systems are used. In an open dynamic system the liberated analyte is transported by a carrier gas through the sampling or excitation source and swept away. In an open static system the equilibrated gaseous phase is forced into the absorption cell by displacement, e.g. by water. During measurement the gaseous phase is thus static. In a closed system the analyte and carrier gas are circulated through the absorption cell and the generator vessel until equilibrium between the liquid and gaseous phases is established." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mercury flow system" .

goldbook:M03835 a skos:Concept ;
    skos:altLabel "mercury–xenon arc" ;
    skos:definition "Non-coherent intense source of ultraviolet, visible, and near-infrared radiation produced by an electrical discharge in a mixture of mercury vapour and xenon under high pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mercury–xenon lamp" .

goldbook:M03836 a skos:Concept ;
    skos:definition "A prefix meaning part, partial or fragment, used in formation of compound words, e.g. merocyanines are compounds related to cyanines but have a nitrogen atom at only one end of the chromogenic system instead of at both ends." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mero" .

goldbook:M03837 a skos:Concept ;
    skos:altLabel "turntable reactor" ;
    skos:definition "An apparatus in which several samples are rotated around a radiation source in order to expose each to equal amounts of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "merry-go-round reactor" .

goldbook:M03838 a skos:Concept ;
    skos:definition "A prefix to indicate the presence of a symmetry element of the second kind (see chirality) in a chemical species which is usually one of a set of diastereoisomers that also includes a chiral member." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>meso</i>" .

goldbook:M03839 a skos:Concept ;
    skos:definition "A term for the achiral member(s) of a set of diastereoisomers which also includes one or more chiral members. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>meso</i>-compound" .

goldbook:M03840 a skos:Concept ;
    skos:definition "A monomer which can impart the properties of liquid crystals to the polymers formed by its polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesogenic monomer" .

goldbook:M03841 a skos:Concept ;
    skos:definition "A pitch with a complex mixture of numerous essentially aromatic hydrocarbons. It does not contain anisotropic particles detectable by optical microscopy. Mesogenic pitch is low in quinoline-insoluble fractions and capable of transforming into mesophase pitch during continuous heat treatment above \\(750\\ \\rm{K}\\) by the formation of optically detectable carbonaceous mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesogenic pitch" .

goldbook:M03842 a skos:Concept ;
    skos:definition "Dipolar five- (possibly six-) membered heterocyclic compounds in which both the negative and the positive charge are delocalized, for which a totally covalent structure cannot be written, and which cannot be represented satisfactorily by any one polar structure. The formal positive charge is associated with the ring atoms, and the formal negative charge is associated with ring atoms or an exocyclic nitrogen or chalcogen atom. Mesoionic compounds are a subclass of betaines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesoionic compounds" .

goldbook:M03843 a skos:Concept ;
    skos:definition "Cleavage of a bond in a radical ion whereby a radical and an ion are formed. The term reflects the mechanistic duality of the process, which can be viewed as homolytic or heterolytic depending on how the electrons are attributed to the fragments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesolytic cleavage" .

goldbook:M03844 a skos:Concept ;
    skos:definition "The effect (on reaction rates, ionization equilibria, etc.) attributed to a substituent due to overlap of its p- or $\\ce{\\uppi\\!\\mbox{-}orbitals}$ with the p- or $\\ce{\\uppi\\!\\mbox{-}orbitals}$ of the rest of the molecular entity. delocalization is thereby introduced or extended, and electronic charge may flow to or from the substituent. The effect is symbolized by M. Strictly understood, the mesomeric effect operates in the ground electronic state of the molecule. When the molecule undergoes electronic excitation or its energy is increased on the way to the transition state of a chemical reaction, the mesomeric effect may be enhanced by the electromeric effect, but this term is not much used, and the mesomeric and electromeric effects tend to be subsumed in the term resonance effect of a substituent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesomeric effect" .

goldbook:M03845 a skos:Concept ;
    skos:definition "Essentially synonymous with resonance. The term is particularly associated with the picture of $\\ce{\\uppi\\!\\mbox{-}electrons}$ as less localized in an actual molecule than in a Lewis formula. The term is intended to imply that the correct representation of a structure is intermediate between two or more Lewis formulae." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesomerism" .

goldbook:M03846 a skos:Concept ;
    skos:definition "Often formed by concentrated systems of surfactants. These are states of matter in which anisometric molecules (or particles) are regularly arranged in one (nematic state) or two (smectic state) directions, but randomly arranged in the remaining direction(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesomorphic phase" .

goldbook:M03847 a skos:Concept ;
    skos:definition "A transition that occurs between a fully-ordered crystalline solid and an isotropic liquid. Mesomorphic transitions can occur (i) from a crystal to a liquid crystal (ii) from a liquid crystal to another liquid crystal and (iii) from a liquid crystal to an isotropic liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesomorphic transition" .

goldbook:M03848 a skos:Concept ;
    skos:definition "That region of the atmosphere between the mesosphere and the thermosphere at which the temperature is a minimum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesopause" .

goldbook:M03849 a skos:Concept ;
    skos:definition "A phase occurring over a definite range of temperature, pressure, or concentration within the mesomorphic state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesophase" .

goldbook:M03850 a skos:Concept ;
    skos:definition "A pitch with a complex mixture of numerous essentially aromatic hydrocarbons containing anisotropic liquid-crystalline particles (carbonaceous mesophase) detectable by optical microscopy and capable of coalescence into the bulk mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesophase pitch" .

goldbook:M03851 a skos:Concept ;
    skos:altLabel "MPP",
        "MPP-based carbon fibres" ;
    skos:definition "Mesophase pitch-based carbon fibres (MPP-based carbon fibres) are carbon fibres obtained from mesogenic pitch after it has been transformed into mesophase pitch (MPP) at least during the process of spinning, and after the spun mesophase pitch fibres have been made non-fusible (stabilized) and carbonized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesophase pitch-based carbon fibres" .

goldbook:M03852 a skos:Concept ;
    skos:definition "Microorganisms which grow at moderate temperatures in the range \\(20{-}45^{\\,\\unicode{x26ac}}\\rm{C}\\), and which have an optimum growth temperature in the range \\(30{-}39^{\\,\\unicode{x26ac}}\\rm{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesophiles" .

goldbook:M03853 a skos:Concept ;
    skos:definition "Pore of intermediate size. [Those with widths exceeding about \\(0.05\\ \\unicode[Times]{x3BC}\\rm{m}\\) or \\(50\\ \\rm{nm}\\) (\\(500\\ \\mathring{\\rm{A}}\\)) are called macropores; those with widths not exceeding about \\(2\\ \\rm{nm}\\) (\\(20\\ \\mathring{\\rm{A}}\\)) are called micropores]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesopore" .

goldbook:M03854 a skos:Concept ;
    skos:definition "In meteorology, the size or scale of phenomena smaller than ordinary cyclones or weather systems but larger than such microscale phenomena as the thickness of the boundary layer, the wakes of objects, etc. Thunderstorms involve mesoscale processes, and other meteorological events the size of cities are usually mesoscale processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesoscale" .

goldbook:M03855 a skos:Concept ;
    skos:definition "That region of the atmosphere which lies above the stratopause (about \\(4752\\ \\rm{km}\\)) and below the mesopause (about \\(8090\\ \\rm{km}\\)) and in which temperature decreases with increasing height; this is the region in which the lowest temperatures of the atmosphere occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesosphere" .

goldbook:M03857 a skos:Concept ;
    skos:altLabel "mRNA" ;
    skos:definition "An RNA molecule that transfers the coding information for protein synthesis from the chromosomes to the ribosomes. mRNA is formed from a DNA template by transcription. It may be a copy of a single gene or of several adjacent genes (polycistronic mRNA). On the ribosome, the sequence is converted into the programmed amino acid sequence through translation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "messenger RNA" .

goldbook:M03858 a skos:Concept ;
    skos:definition "The entire physical and chemical processes involved in the maintenance and reproduction of life in which nutrients are broken down to generate energy and to give simpler molecules (catabolism) which by themselves may be used to form more complex molecules (anabolism). In case of heterotrophic organisms, the energy evolving from catabolic processes is made available for use by the organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolism" .

goldbook:M03859 a skos:Concept ;
    skos:definition "Any intermediate or product resulting from metabolism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolite" .

goldbook:M03860 a skos:Concept ;
    skos:altLabel "carbene metal complexes",
        "carbene–metal complexes" ;
    skos:definition "Metal complexes of the type $\\ce{R2CML_{n}}$ ($\\ce{M}$ = metal, $\\ce{L}$ = ligand) in which formally a carbene is coordinated to a metal, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metal–carbene complexes" .

goldbook:M03861 a skos:Concept ;
    skos:altLabel "carbyne metal complexes",
        "carbyne–metal complexes" ;
    skos:definition "Metal complexes of the type $\\ce{RCML_{n}}$ ($\\ce{M}$ = metal, $\\ce{L}$ = ligand) in which formally a carbyne is coordinated to a metal, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metal–carbyne complexes" .

goldbook:M03863 a skos:Concept ;
    skos:altLabel "metal–nonmetal transition" ;
    skos:definition "A transition characterized by a sudden change in electrical transport properties (conductivity) due to a reversible change from localized to itinerant behaviour of the electrons. Example: The transition at \\(339\\ \\rm{K}\\) in $\\ce{VO2}$ where it changes from a high-temperature metallic behaviour to a low-temperature semiconductor behaviour. Synonymous with metal–nonmetal transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metal–insulator transition" .

goldbook:M03864 a skos:Concept ;
    skos:definition "Monocyclic compounds containing a metal atom and saturated carbon atoms as ring members, e.g.:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallacycloalkanes" .

goldbook:M03865 a skos:Concept ;
    skos:definition "Organometallic coordination compounds in which one atom of a transition metal such as iron, ruthenium or osmium is bonded to and only to the face of two cyclopentadienyl $\\ce{[\\upeta\\!^{5}\\mbox{-}(C5H5)]}$ ligands which lie in parallel planes. The term should not be used for analogues having rings other than cyclopentadienyl as ligands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallocenes" .

goldbook:M03866 a skos:Concept ;
    skos:definition "Metallurgical coke is produced by carbonization of coals or coal blends at temperatures up to \\(1400\\ \\rm{K}\\) to produce a macroporous carbon material of high strength and relatively large lump size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metallurgical coke" .

goldbook:M03868 a skos:Concept ;
    skos:altLabel "MLCT",
        "MLCT transition" ;
    skos:definition "An electronic transition of a metal complex that corresponds to excitation populating an electronic state in which considerable electron transfer from the metal to a ligand has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metal to ligand charge transfer transition" .

goldbook:M03869 a skos:Concept ;
    skos:altLabel "MMCT",
        "MMCT transition" ;
    skos:definition "An electronic transition of a bi- or poly-nuclear metal complex that corresponds to excitation populating an electronic state in which considerable electron transfer between two metal centres has occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metal to metal charge transfer transition" .

goldbook:M03870 a skos:Concept ;
    skos:definition "An antiferromagnetic to ferromagnetic transition for \\(H_{\\rm{applied}}>H_{\\rm{c}}\\) and/or \\(T>T_{\\rm{t}}\\) where \\(H_{\\rm{c}}\\) and \\(T_{\\rm{t}}\\) refer to the critical magnetic field and transition temperature, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metamagnetic transition" .

goldbook:M03871 a skos:Concept ;
    skos:definition "A term that describes the state of a phase in which an energy barrier considerably higher than \\(k\\ T\\) must be surmounted before this phase can transform to a phase of lower molar Gibbs energy and molar Helmholtz energy, where \\(k\\) is the Boltzmann constant and \\(T\\) the thermodynamic temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metastability" .

goldbook:M03874 a skos:Concept ;
    skos:definition "An ion which is formed with sufficient excitation to dissociate spontaneously during its flight from the ion source to the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metastable ion" .

goldbook:M03875 a skos:Concept ;
    skos:definition "An isomeric state in an energy state higher than the ground state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metastable state" .

goldbook:M03876 a skos:Concept ;
    skos:altLabel "metastable" ;
    skos:definition "Any excited state which in principle, by virtue of the selection rules, cannot radiatively combine with any lower state. It usually has a considerably longer lifetime than an ordinary excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metastable state" .

goldbook:M03878 a skos:Concept ;
    skos:definition "A bimolecular process formally involving the exchange of a bond (or bonds) between similar interacting chemical species so that the bonding affiliations in the products are identical (or closely similar) to those in the reactants. For example:  (The term has its origin in inorganic chemistry with a different meaning, but this older usage is not applicable in physical organic chemistry.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metathesis" .

goldbook:M03879 a skos:Concept ;
    skos:definition "Strictly anaerobic archaebacteria, able to use only a very limited substrate spectrum (e.g. molecular hydrogen, formate, methanol, methylamine, carbon monoxide or acetate) as electron donors for the reduction of carbon dioxide to methane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "methanogens" .

goldbook:M03880 a skos:Concept ;
    skos:definition "NMR shift difference measurement of the isotope effect on a fast (degenerate) equilibrium between two species which are equivalent except for isotopic substitution. This can be used to distinguish a rapidly equilibrating mixture with time-averaged symmetry from a single structure with higher symmetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "method of isotopic perturbation" .

goldbook:M03883 a skos:Concept ;
    skos:definition "Organisms that use, as substrates for growth, $\\ce{C}$ compounds containing carbon in a lower oxidation state than in carbon dioxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "methylotrophic microorganisms" .

goldbook:M03885 a skos:Concept ;
    skos:definition "The acceleration of a chemical reaction in solution by the addition of a surfactant at a concentration higher than its critical micelle concentration so that the reaction can proceed in the environment of surfactant aggregates (micelles). (Rate enhancements may be due, for example, to higher concentration of the reactants in that environment, more favourable orientation and solvation of the species, or enhanced rate constants in the micellar pseudophase of the surfactant aggregate.) Micelle formation can also lead to a decreased reaction rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar catalysis" .

goldbook:M03886 a skos:Concept ;
    skos:definition "The term usually refers to a neutral micelle and therefore includes an equivalent amount of counter-ions with the surfactant ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar mass" .

goldbook:M03887 a skos:Concept ;
    skos:altLabel "solubilization" ;
    skos:definition "In a system formed by a solvent, an association colloid and at least one other component (the solubilizate), the incorporation of this other component into or on the micelles is called micellar solubilization, or, briefly, solubilization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micellar solubilization" .

goldbook:M03889 a skos:Concept ;
    skos:definition "Surfactants in solution are often association colloids, that is, they tend to form aggregates of colloidal dimensions, which exist in equilibrium with the molecules or ions from which they are formed. Such aggregates are termed micelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micelle" .

goldbook:M03890 a skos:Concept ;
    skos:definition "Usually understood to include the net charge of the surfactant ions and the counterions bound to the micelle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micelle charge" .

goldbook:M03891 a skos:Concept ;
    skos:definition "Substance concentration of substrate at which the rate of reaction is equal to one half of the limiting rate (maximum rate)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Michaelis constant" .

goldbook:M03892 a skos:Concept ;
    skos:definition "The dependence of an initial rate of reaction upon the concentration of a substrate S that is present in large excess over the concentration of an enzyme or other catalyst (or reagent) E with the appearance of saturation behaviour following the Michaelis-Menten equation: \\[ u=\\frac{V\\ \\left[\\rm{S}\\right]}{K_{\\rm{m}}+\\left[\\rm{S}\\right]}\\] where \\( u\\) is the observed initial rate, \\(V\\) is its limiting value at substrate saturation (i.e. \\(\\left[\\rm{S}\\right]\\gg K_{\\rm{m}}\\)), and \\(K_{\\rm{m}}\\) the substrate concentration when \\( u = \\frac{V}{2}\\). The definition is experimental, i.e. it applies to any reaction that follows an equation of this general form. The symbols \\(V_{\\max }\\) or \\( u_{\\max }\\) are sometimes used for \\(V\\). The parameters \\(V\\) and \\(K_{\\rm{m}}\\) (the 'Michaelis constant') of the equation can be evaluated from the slope and intercept of a linear plot of \\( u^{-1}\\) vs. \\(\\left[\\rm{S}\\right]^{-1}\\) (a 'Lineweaver–Burk plot') or from slope and intercept of a linear plot of \\( u\\) vs. \\(\\frac{ u}{\\left[\\rm{S}\\right]}\\) ('Eadie–Hofstee plot'). A Michaelis–Menten equation is also applicable to the condition where E is present in large excess, in which case the concentration \\(\\left[\\rm{E}\\right]\\) appears in the equation instead of \\(\\left[\\rm{S}\\right]\\). The term has sometimes been used to describe reactions that proceed according to the scheme: \\[\\rm{E}+\\rm{S}\\overset{k_{1}}{\\underset{k_{-1}}\\rightleftarrows }\\rm{ES}\\overset{k_{\\rm{cat}}}{\\rightarrow }\\rm{Products}\\] in which case \\(K_{\\rm{m}} = \\frac{k_{-1}+k_{\\rm{cat}}}{k_{1}}\\) (Briggs–Haldane conditions). It has more usually been applied only to the special case in which \\(k_{-1}\\gg k_{\\rm{cat}}\\) and \\(K_{\\rm{m}} = \\frac{k_{-1}}{k_{1}}=K_{s}\\); in this case \\(K_{\\rm{m}}\\) is a true dissociation constant (Michaelis–Menten conditions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Michaelis–Menten kinetics" .

goldbook:M03893 a skos:Concept ;
    skos:definition "The Michaelis–Menten mechanism is the simplest mechanism that will explain Michaelis–Menten kinetics. According to the mechanism, a substrate A first combines with a molecule of enzyme E, and this process is followed by a step in which the enzyme-substrate complex EA breaks down (sometimes with the participation of the solvent) into enzyme and reaction products: \\[\\rm{E}+\\rm{A}\\overset{k_{1}}{\\underset{k_{-1}}\\rightleftharpoons }\\rm{EA}\\overset{k_{2}}{\\rightarrow }\\rm{E}+\\rm{Products}\\] If, as is usual, the substrate A is present in great excess of the enzyme it can be shown that steady-state conditions apply, and that the rate equation is: \\[v = \\frac{k_{2}\\ \\left[\\rm{E}\\right]_{0}\\ \\left[\\rm{A}\\right]}{\\frac{k_{-1}\\,+\\,k_{2}}{k_{1}}\\,+\\,\\left[\\rm{A}\\right]}\\] where \\(\\left[\\rm{E}\\right]_{0}\\) is the total concentration of enzyme. This equation is of the form of the Michaelis–Menten equation. Other, more complicated, mechanisms lead to the Michaelis–Menten equation, adherence to which therefore does not require that the Michaelis– Menten mechanism applies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Michaelis–Menten mechanism" .

goldbook:M03895 a skos:Concept ;
    skos:definition "A process for the solubilization of metals, mostly from poor ores, by lithotrophic bacteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microbial leaching" .

goldbook:M03896 a skos:Concept ;
    skos:definition "A rate constant calculated by microcanonical variational transition-state theory and therefore a rate constant that relates to a fixed energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcanonical rate constant" .

goldbook:M03897 a skos:Concept ;
    skos:altLabel "µVTST" ;
    skos:definition "A development of transition-state theory in which the dividing surface is varied so as to minimize the rate calculated for a fixed energy. The rate expressions obtained in a microcanonical treatment can be integrated over the energy, taking into account the statistical distribution over energy states, so as to give the canonical, or thermal, rates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcanonical variational transition-state theory" .

goldbook:M03898 a skos:Concept ;
    skos:definition "A small, beaded material, derived from silica, glass, dextran or similar materials, used for the immobilization of biocatalysts or as a support for the culture of anchorage-dependent animal cell lines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microcarrier" .

goldbook:M03899 a skos:Concept ;
    skos:definition "The science that deals with the climate of restricted areas and investigates their phenomena and causes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microclimatology" .

goldbook:M03900 a skos:Concept ;
    skos:definition "The electrophoresis technique involving the movement of a mass of particles on a small scale (e.g. paper electrophoresis)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microelectrophoresis" .

goldbook:M03901 a skos:Concept ;
    skos:altLabel "gel microparticle" ;
    skos:definition "Particle of gel of any shape with an equivalent diameter of approximately \\(0.1\\) to \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microgel" .

goldbook:M03902 a skos:Concept ;
    skos:definition "A particular glycoprotein may occur in forms that differ in the structure of one or more or its carbohydrate units, a phenomenon known as microheterogeneity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microheterogeneity" .

goldbook:M03903 a skos:Concept ;
    skos:definition "The study of the meteorological processes on scales from a millimeter or less up to tens or hundreds of metres; e.g. meteorology of a local site that is usually small and often is confined to a shallow layer of air next to the ground." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micrometeorology" .

goldbook:M03904 a skos:Concept ;
    skos:definition "Polymer network that has dimensions of the order of \\(1\\ \\rm{nm}\\) to \\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micro-network" .

goldbook:M03906 a skos:Concept ;
    skos:definition "Pore with width not exceeding about \\(2.0\\ \\rm{nm}\\) (\\(20\\ \\mathrm{Å}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micropore" .

goldbook:M03907 a skos:Concept ;
    skos:definition "The process in which molecules are adsorbed in the adsorption space within micropores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micropore filling" .

goldbook:M03908 a skos:Concept ;
    skos:definition "Conventionally measured by the volume of the adsorbed material which completely fills the micropores expressed in terms of bulk liquid at atmospheric pressure and at the temperature of measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "micropore volume" .

goldbook:M03909 a skos:Concept ;
    skos:altLabel "BET" ;
    skos:definition "A porous carbon material, usually a char or carbon fibres, which may or may not have been subjected to an activation process to increase its adsorptive properties. A microporous carbon is considered to have a major part of its porosity in pores of less than \\(2\\ \\rm{nm}\\) width and to exhibit apparent surface areas usually higher than \\(200\\ \\) to \\(300\\ \\rm{m}^{2}\\ \\rm{g}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microporous carbon" .

goldbook:M03911 a skos:Concept ;
    skos:definition "A measure of the probability of a specified interaction or reaction between an incident radiation and a target particle or system of particles. It is the reaction rate per target particle for a specified process divided by the flux of the incident radiation. In general, a specification is added of the type of radiation (e.g. neutron, photon), the energy of the incident radiation (e.g. thermal, epithermal, fast) and the type of interaction of reaction (e.g. activation, fission, scattering)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic cross-section" .

goldbook:M03912 a skos:Concept ;
    skos:altLabel "diffusion control",
        "encounter control",
        "transport control" ;
    skos:definition "The observable consequence of the limitation that the rate of a bimolecular chemical reaction in a homogeneous medium cannot exceed the rate of encounter of the reacting molecular entities. If (hypothetically) a bimolecular reaction in a homogeneous medium occurred instantaneously when two reactant molecular entities made an encounter, the rate of reaction would be an encounter-controlled rate, determined solely by rates of diffusion of reactants. Such a hypothetical 'fully diffusion controlled rate' is also said to correspond to 'total microscopic diffusion control', and represents the asymptotic limit of the rate of reaction as the rate constant for the chemical conversion of the encounter pair into product (or products) becomes large relative to the rate constant for separation (or dissociation) of the encounter pair. 'Partial microscopic diffusion control' is said to operate in a homogeneous reaction when the rates of chemical conversion and of separation are comparable. (The degree of microscopic diffusion control cannot usually be determined with any precision.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic diffusion control" .

goldbook:M03913 a skos:Concept ;
    skos:definition "A technique in which the electrophoresis of individual particles is observed with the aid of a microscope or ultra-microscope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic electrophoresis" .

goldbook:M03914 a skos:Concept ;
    skos:definition "A film which has lateral dimensions in the range \\(0.1{-}100\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic film" .

goldbook:M03915 a skos:Concept ;
    skos:definition "This term applies to a kinetic study in which the emphasis is on the interpretation of the behaviour in terms of elementary reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic kinetics" .

goldbook:M03916 a skos:Concept ;
    skos:definition "The principle of microscopic reversibility at equilibrium states that, in a system at equilibrium, any molecular process and the reverse of that process occur, on the average, at the same rate. This definition corresponds to the statement of the principle that was given by R.C. Tolman in 1924. However, many workers have interchanged the meanings of microscopic reversibility and detailed balance, and it seems best now to regard the two, which are closely related, as synonymous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microscopic reversibility at equilibrium" .

goldbook:M03917 a skos:Concept ;
    skos:definition "Artefactual spherical particle, not present in the living cell, derived from pieces of the endoplasmic reticulum present in homogenates of tissues or cells: microsomes sediment from such homogenates when centrifuged at \\(10^{6}\\ \\rm{g}\\) and higher: the microsomal fraction obtained in this way is often used as a source of mono-oxygenase enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microsome" .

goldbook:M03918 a skos:Concept ;
    skos:definition "The combined stratosphere and mesosphere in the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "middle atmosphere" .

goldbook:M03919 a skos:Concept ;
    skos:definition "The scattering of electromagnetic radiation by spherical particles of any size \\(r\\), relative to the wavelength, \\(\\lambda \\). Since the cases \\(r\\ll \\lambda \\) and \\(r\\gg \\lambda \\) are covered by Rayleigh (dipole) scattering and geometric scattering theories, respectively, Mie scattering often refers to the case of \\(r\\approx \\lambda \\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mie scattering" .

goldbook:M03920 a skos:Concept ;
    skos:definition "The (usually intramolecular) transfer of an atom or group during the course of a molecular rearrangement.The movement of a bond to a new position, within the same molecular entity is known as 'bond migration'. Allylic rearrangements, e.g.  exemplify both types of migration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migration" .

goldbook:M03921 a skos:Concept ;
    skos:definition "The difference between the current that is actually obtained, at any particular value of the potential of the indicator or working electrode, for the reduction or oxidation of an ionic electroactive substance and the current that would be obtained, at the same potential, if there were no transport of that substance due to the electric field between the electrodes. The sign convention regarding current is such that the migration current is negative for the reduction of a cation or for the oxidation of an anion, and positive for the oxidation of a cation or the reduction of an anion. Hence the migration current may tend to either increase or decrease the total current observed. In any event the migration current approaches zero as the transport number of the electroactive substance is decreased by increasing the concentration of the supporting electrolyte, and hence the conductivity" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migration current" .

goldbook:M03923 a skos:Concept ;
    skos:definition "The term is applied to characterize the relative tendency of a group to participate in a rearrangement. In nucleophilic rearrangements ( migration to an electron-deficient centre), the migratory aptitude of a group is loosely related to its capacity to stabilize a partial positive charge, but exceptions are known, and the position of hydrogen in the series is often unpredictable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migratory aptitude" .

goldbook:M03924 a skos:Concept ;
    skos:definition "A combination of migration and insertion. The term is mainly used in organometallic chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migratory insertion" .

goldbook:M03927 a skos:Concept ;
    skos:altLabel "millimeter of mercury" ;
    skos:definition "Non-SI unit for pressure; \\(\\rm{mmHg}\\approx 133.322\\ \\rm{Pa}\\). This old unit is not recognized by CIPM or ISO, but it is used for blood pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "millimetre of mercury" .

goldbook:M03928 a skos:Concept ;
    skos:altLabel "grinding" ;
    skos:definition "The mechanical reduction of the particle size of a sample by attribution (friction), impact or cutting. The required particle size of a sample is related to the size of the test portion and the number of particles required to ensure homogeneity among test portions. The reduction in particle size may sometimes result in particles of different hardness and density, which produces inhomogeneity during the preparation of the test sample or during the withdrawal of the test portion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "milling" .

goldbook:M03929 a skos:Concept ;
    skos:definition "The time during which nebulization must be carried out in order to perform one analysis with a given precision. The minimum consumption time is equal to the minimum volume consumed of the prepared sample divided by the rate of fluid consumption in order to obtain a given precision. It can be reduced by means of integrating the signal or measuring the signal increments (kinetic methods)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum consumption time" .

goldbook:M03930 a skos:Concept ;
    skos:definition "This is a criterion used in Rice–Ramsperger–Kassel–Marcus (RRKM) theory for locating the transition state. The reaction coordinate \\(r\\) at the transition state, according to this criterion, is given by \\(\\frac{\\partial (N\\left(\\varepsilon_{\\rm{r}}\\right))}{\\partial r}=0\\), where \\(N\\left(\\varepsilon_{\\rm{r}}\\right)\\) is the density of states at an internal energy \\(\\varepsilon_{\\rm{r}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum density of states criterion" .

goldbook:M03931 a skos:Concept ;
    skos:altLabel "MERP" ;
    skos:definition "Path orthogonal to the equipotential contours of a potential energy surface that connects the energy minima through a saddle point (transition state) from which it slopes downwards along the steepest descending lines in \\(3N-6\\) configurational space (\\(N\\) is the number of nuclei in the reacting system)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum-energy reaction path" .

goldbook:M03932 a skos:Concept ;
    skos:altLabel "lowest lethal concentration found" ;
    skos:definition "Lowest concentration of a toxic substance in an environmental medium that kills individual organisms or test species under a defined set of conditions. Synonymous with lowest lethal concentration found." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum lethal concentration" .

goldbook:M03933 a skos:Concept ;
    skos:definition "Lowest amount of a substance that, when introduced into the body, may cause death to individual species of test animals under a defined set of conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minimum lethal dose" .

goldbook:M03935 a skos:Concept ;
    skos:definition "Non-SI unit of plane angle. \\[1^{\\prime} = (1/60)^{\\,\\unicode{x26ac}} = 2.908\\ 882\\,...\\,\\times 10^{-4}\\rm{rad}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "minute" .

goldbook:M03936 a skos:Concept ;
    skos:definition "A qualitative term applied to a suspension of droplets in a gas. In the atmosphere a mist produces a generally thin, greyish veil over the landscape. It reduces visibility to a lesser extent than fog but somewhat more than haze (visibility of less than \\(2\\ \\rm{km}\\) but greater than \\(1\\ \\rm{km}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mist" .

goldbook:M03937 a skos:Concept ;
    skos:definition "Organelles appearing in all eukaryotic cells which produce ATP as useful energy for the cell by oxidative phosphorylation. The proteins for the adenosine 5'-triphosphate (ATP)-generating electron transport of the respiration chain are located in the inner mitochondrial membrane. Mitochondria contain many enzymes of the citric acid cycle and for fatty acid $\\ce{\\upbeta\\!\\mbox{-}oxidation}$. Many of them are coded for by nuclear DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitochondria" .

goldbook:M03938 a skos:Concept ;
    skos:definition "The process whereby a cell nucleus divides into two daughter nuclei, each having the same genetic complement as the parent cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mitosis" .

goldbook:M03941 a skos:Concept ;
    skos:definition "This is an effect found in a process A + BC when the attacking species A is heavy. Because A is heavy the A–B distance continues to decrease while the repulsive energy of B–C is being released." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed energy release" .

goldbook:M03943 a skos:Concept ;
    skos:definition "A specifically labelled compound is referred to as mixed labelled when the isotopically substituted compound has more than one kind of modified atom e.g. $\\ce{CH3–CH2–[^{18}O][^{2}H]}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed labelled" .

goldbook:M03944 a skos:Concept ;
    skos:definition "The value of the potential of a given electrode with respect to a suitable reference electrode when appreciable contributions to the total anodic and/or cathodic partial currents are made by species belonging to two or more different couples, but the total current is zero, i.e. \\[I=\\sum _{\\begin{array}{c} i \\end{array}}I_{i}=0\\qquad (I_{i} eq 0)\\] where \\(I_{i}\\) is the partial current of reaction \\(i\\) \\[I_{i}=I_{i,a}+I_{i,c}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed potential" .

goldbook:M03945 a skos:Concept ;
    skos:definition "The combining of components, particles or layers into a more homogeneous state. The mixing may be achieved manually or mechanically by shifting the material with stirrers or pumps or by revolving or shaking the container. The process must not permit segregation of particles of different size or properties. homogeneity may be considered to have been achieved in a practical sense when the sampling error of the processed portion is negligible compared to the total error of the measurement system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixing" .

goldbook:M03946 a skos:Concept ;
    skos:altLabel "macroscopic diffusion control" ;
    skos:definition "The experimental limitation of the rate of reaction in solution by the rate of mixing of solutions of the two reactants. It can occur even when the reaction rate constant is several powers of 10 less than that for an encounter-controlled rate. Analogous (and even more important) effects of the limitation of reaction rates by the speed of mixing are encountered in heterogeneous (solid/liquid, solid/gas, liquid/gas) systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixing control" .

goldbook:M03947 a skos:Concept ;
    skos:definition "The height to which significant mixing of added pollutants occurs within the atmosphere. In reference to stack gases, it is considered the height at which stack effluent begins mixing with the atmosphere as it leaves the stack." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixing height" .

goldbook:M03948 a skos:Concept ;
    skos:definition "In meteorology, the dimensionless ratio of the mass of a substance (such as water vapour) in an air parcel to the mass of the remaining substances in the air parcel. For trace substances, this is approximated by the ratio of the mass of the substance to the mass of air. However, in the case of water vapour the mass of dry air is used. In atmospheric chemistry, mixing ratios (molecular, molar, by volume, as well as by weight) are used to describe relative concentrations of atmospheric trace gases and impurities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixing ratio" .

goldbook:M03950 a skos:Concept ;
    skos:altLabel "MLCT" ;
    skos:definition "Abbreviation for Metal to Ligand Charge Transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "MLCT" .

goldbook:M03951 a skos:Concept ;
    skos:definition "A situation in which molecules of adsorbate are free to move about the surface. Mobility of the adsorbate will increase with temperature and mobile adsorption may be either localized or non-localized. In localized mobile adsorption the adsorbate spends most of the time on the adsorption sites but can migrate or be desorbed and readsorbed elsewhere. In non-localized adsorption the mobility is so great that a small fraction of the adsorbed species is on the desorption sites and a large fraction at other positions on the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobile adsorption" .

goldbook:M03952 a skos:Concept ;
    skos:definition "A fluid which percolates through or along the stationary bed, in a definite direction. It may be a liquid (liquid chromatography) or a gas (gas chromatography) or a supercritical fluid (supercritical-fluid chromatography). In gas chromatography the expression carrier gas may be used for the mobile phase. In elution chromatography the expression 'eluent' is also used for the mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobile phase" .

goldbook:M03954 a skos:Concept ;
    skos:definition "The linear velocity of the mobile phase across the average cross-section of the chromatographic bed or column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobile-phase velocity" .

goldbook:M03956 a skos:Concept ;
    skos:definition "The velocity of a particle per unit applied force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobility" .

goldbook:M03957 a skos:Concept ;
    skos:definition "A monocyclic array of orbitals in which there is a single out-of-phase overlap (or, more generally, an odd number of out-of-phase overlaps) reveals the opposite pattern of aromatic character to Hückel systems; with \\(4\\, n\\) electrons it is stabilized (aromatic), whereas with \\(4\\, n+2\\) it is destabilized (antiaromatic). In the excited state \\(4\\, n+2\\) Möbius $\\ce{\\uppi\\!\\mbox{-}electron}$ systems are stabilized, and \\(4\\, n\\) systems are destabilized. No examples of ground-state Möbius $\\ce{\\uppi\\!\\mbox{-}electron}$ systems are known, but the concept has been applied to transition states of pericyclic reactions. The name is derived from the topological analogy of such an arrangement of orbitals to a Möbius strip." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Möbius aromaticity" .

goldbook:M03958 a skos:Concept ;
    skos:definition "The value of the variable occurring with the greatest frequency in the series of observations. A bimodal distribution is one which contains two maxima. The use of mode when reporting results of chemical analysis is generally not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mode" .

goldbook:M03959 a skos:Concept ;
    skos:definition "A laser in which many resonant modes are coupled in phase, to yield a train of very short pulses (e.g. ps pulses). The coupling of the modes is obtained by modulation of the gain in the resonator, and can be active (electro-optic modulation of the losses or of the pump intensity), or passive (with a saturable absorber)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mode-locked laser" .

goldbook:M03960 a skos:Concept ;
    skos:definition "Reduction of the neutron energy by scattering without appreciable capture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moderation" .

goldbook:M03961 a skos:Concept ;
    skos:definition "A material used to reduce the neutron energy by scattering without appreciable capture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moderator" .

goldbook:M03962 a skos:Concept ;
    skos:definition "An active solid the sorptive properties of which have been changed by some treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modified active solid" .

goldbook:M03963 a skos:Concept ;
    skos:definition "This is an extension of the simple Arrhenius equation in which the pre-exponential factor is proportional to \\(T^{n}\\) where \\(T\\) is the temperature and \\(n\\) a constant: \\[k = B\\ T^{n}\\ \\exp(-E_{\\rm{a}}/RT)\\] \\(B\\) is a temperature-independent constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modified Arrhenius equation" .

goldbook:M03964 a skos:Concept ;
    skos:definition "A sample or a known fraction of the parent population in which the analyte has been isolated or (usually) concentrated before being submitted to the laboratory. If the isolation or concentration occurs in the laboratory, the procedure is usually considered part of the preparation of the test sample from the laboratory sample (in-laboratory processing)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modified sample" .

goldbook:M03965 a skos:Concept ;
    skos:definition "A substance added to a solvent to improve its properties e.g. by increasing the solubility of an extractant, changing interfacial parameters or reducing adsorption losses. Additives used to enhance extraction rates should be called accelerators or catalysts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "modifier" .

goldbook:M03967 a skos:Concept ;
    skos:definition "The process in which iodide is oxidized to iodate to achieve a more favourable measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mohr amplification process" .

goldbook:M03968 a skos:Concept ;
    skos:definition "In physical organic chemistry moiety is generally used to signify part of a molecule, e.g. in an ester $\\ce{R1COOR2}$ the alcohol moiety is $\\ce{R2O}$. The term should not be used for a small fragment of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moiety" .

goldbook:M03970 a skos:Concept ;
    skos:definition "Amount of entities of a solute divided by the mass of the solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molality" .

goldbook:M03971 a skos:Concept ;
    skos:definition "Adjective before the name of an extensive quantity generally meaning division by amount of substance to make it intensive. Molar volume is volume divided by amount of substance. In a few special cases molar is used to denote division by amount concentration (e.g. molar absorption coefficient)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar" .

goldbook:M03972 a skos:Concept ;
    skos:altLabel "molar decadic absorption coefficient" ;
    skos:definition "Absorbance divided by the absorption pathlength, \\(l\\), and the amount concentration, \\(c\\): \\[\\varepsilon(\\lambda) = \\frac{1}{c\\, l}\\, \\rm{lg}\\! \\left ( \\frac{P_{\\lambda}^{0}}{P_{\\lambda}}\\right ) = \\frac{A(\\lambda)}{c\\, l}\\] where \\(P_{\\lambda}^{0}\\) and \\(P_{\\lambda}\\) are, respectively, the incident and transmitted spectral radiant power." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar absorption coefficient" .

goldbook:M03974 a skos:Concept ;
    skos:definition "For a specified isotope, the activity of the compound divided by the amount of the material in moles: \\(A_{\\rm{m}}=\\frac{A}{n}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molar activity" .

goldbook:M03982 a skos:Concept ;
    skos:definition "A molecular beam is produced by allowing a gas at higher pressure to expand through a small orifice into a container at lower pressure. The result is a beam of particles (atoms, free radicals, molecules or ions) moving at approximately equal velocities, with few collisions occurring between them. In a crossed molecular-beam experiment a reaction is studied using collimated beams of reactant molecules. For a bimolecular reaction, beams of the two reactants are caused to impinge on one another, often at an angle of 90°. In a beam-gas scattering experiment a collimated beam is introduced into a gas, and the scattering patterns are observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular beams" .

goldbook:M03985 a skos:Concept ;
    skos:definition "Synonymous with reaction dynamics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular dynamics" .

goldbook:M03986 a skos:Concept ;
    skos:definition "Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity. Molecular entity is used in this Compendium as a general term for singular entities, irrespective of their nature, while chemical species stands for sets or ensembles of molecular entities. Note that the name of a compound may refer to the respective molecular entity or to the chemical species, e.g. methane, may mean a single molecule of $\\ce{CH4}$ (molecular entity) or a molar amount, specified or not (chemical species), participating in a reaction. The degree of precision necessary to describe a molecular entity depends on the context. For example 'hydrogen molecule' is an adequate definition of a certain molecular entity for some purposes, whereas for others it is necessary to distinguish the electronic state and/or vibrational state and/or nuclear spin, etc. of the hydrogen molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular entity" .

goldbook:M03987 a skos:Concept ;
    skos:definition "For compounds consisting of discrete molecules, a formula according with the relative molecular mass (or the structure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular formula" .

goldbook:M03988 a skos:Concept ;
    skos:altLabel "molecular anion",
        "molecular cation" ;
    skos:definition "An ion formed by the removal from (positive ions) or addition to (negative ions) a molecule of one or more electrons without fragmentation of the molecular structure. The mass of this ion corresponds to the sum of the masses of the most abundant naturally occurring isotopes of the various atoms that make up the molecule (with a correction for the masses of the electron(s) lost or gained). For example, the mass of the molecular ion of ethyl bromide $\\ce{C2H5^{79}Br}$ will be \\(2\\times 12\\) plus \\(5\\times 1.0078246\\) plus 78.91839 minus the mass of the electron (\\(m_{\\rm{e}}\\)). This is equal to \\(107.95751\\ \\rm{u}-m_{\\rm{e}}\\), \\(u\\) being the unified atomic mass unit based on the standard that the mass of the isotope $\\ce{^{12}C}$ = \\(12\\ \\rm{u}\\) exactly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular ion" .

goldbook:M03989 a skos:Concept ;
    skos:definition "The number of reactant molecular entities that are involved in the 'microscopic chemical event' constituting an elementary reaction. (For reactions in solution this number is always taken to exclude molecular entities that form part of the medium and which are involved solely by virtue of their solvation of solutes.) A reaction with a molecularity of one is called 'unimolecular', one with a molecularity of two 'bimolecular' and of three 'termolecular'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecularity" .

goldbook:M03990 a skos:Concept ;
    skos:definition "This term is applied to a kinetic study in which there is emphasis on the behaviour of the system at the molecular level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular kinetics" .

goldbook:M03991 a skos:Concept ;
    skos:definition "A gas laser which makes use of electronic, vibrational or rotational energy levels in molecules. The molecules can be excited by an electric discharge, as in the case of the $\\ce{N2}$ or $\\ce{CO2}$ laser, by chemical reactions, as in the $\\ce{HF}$ or $\\ce{DF}$ lasers, or by another laser, as in the $\\ce{CH3F}$ far IR laser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular laser" .

goldbook:M03993 a skos:Concept ;
    skos:altLabel "force-field calculation" ;
    skos:definition "An empirical calculational method intended to give estimates of structures and energies for conformations of molecules. The method is based on the assumption of 'natural' bond lengths and angles, deviation from which leads to strain, and the existence of torsional interactions and attractive and/or repulsive van der Waals and dipolar forces between non-bonded atoms. The method is also called '(empirical) force-field calculations'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular mechanics calculation" .

goldbook:M03994 a skos:Concept ;
    skos:definition "A non-metallic material whose properties resemble those of metals, usually following oxidative doping; e.g. polyacetylene following oxidative doping with iodine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular metal" .

goldbook:M03996 a skos:Concept ;
    skos:definition "A one-electron wavefunction describing an electron moving in the effective field provided by the nuclei and all other electrons of a molecular entity of more than one atom. Such molecular orbitals can be transformed in prescribed ways into component functions to give 'localized molecular orbitals'. Molecular orbitals can also be described, in terms of the number of nuclei (or 'centres') encompassed, as two-centre, multi-centre, etc. molecular orbitals, and are often expressed as a linear combination of atomic orbitals. An orbital is usually depicted by sketching contours on which the wavefunction has a constant value (contour map) or by indicating schematically the envelope of the region of space in which there is an arbitrarily fixed high (say 96%) probability of finding the electron occupying the orbital, giving also the algebraic sign (+ or −) of the wavefunction in each part of that region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular orbital" .

goldbook:M03997 a skos:Concept ;
    skos:altLabel "rearrangement" ;
    skos:definition "The term is traditionally applied to any reaction that involves a change of connectivity (sometimes including hydrogen), and violates the so-called 'principle of minimum structural change'. According to this oversimplified principle, chemical species do not isomerize in the course of a transformation, e.g. substitution, or the change of a functional group of a chemical species into a different functional group is not expected to involve the making or breaking of more than the minimum number of bonds required to effect that transformation. For example, any new substituents are expected to enter the precise positions previously occupied by displaced groups. The simplest type of rearrangement is an intramolecular reaction in which the product is isomeric with the reactant (one type of 'intramolecular isomerization'). An example is the first step of the Claisen rearrangement:  The definition of molecular rearrangement includes changes in which there is a migration of an atom or bond (unexpected on the basis of the principle of minimum structural change), as in the reaction:  where the rearrangement stage can formally be represented as the '1,2-shift' of hydride between adjacent carbon atoms in the carbocation:  Such migrations occur also in radicals, e.g.:  The definition also includes reactions in which an entering group takes up a different position from the leaving group, with accompanying migration. An example of the latter type is the 'allylic rearrangement':  A distinction is made between 'intramolecular rearrangements' (or 'true molecular rearrangements') and 'intermolecular rearrangements' (or 'apparent rearrangements'). In the former case the atoms and groups that are common to a reactant and a product never separate into independent fragments during the rearrangement stage (i.e. the change is intramolecular), whereas in an 'intermolecular rearrangement' a migrating group is completely free from the parent molecule and is re-attached to a different position in a subsequent step, as in the Orton reaction:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular rearrangement" .

goldbook:M03998 a skos:Concept ;
    skos:definition "With respect to porous solids, the surface associated with pores communicating with the outside space may be called the internal surface. Because the accessibility of ores may depend on the size of the fluid molecules, the extent of the internal surface may depend on the size of the molecules comprising the fluid, and may be different for the various components of a fluid mixture. This effect is known as the molecular sieve effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular sieve effect" .

goldbook:M03999 a skos:Concept ;
    skos:definition "Spectra formed by bands consisting of rotational lines originating from rotational, vibrational and electronic transitions of molecules. These may be emission or absorption spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular spectra" .

goldbook:M04002 a skos:Concept ;
    skos:definition "An electrically neutral entity consisting of more than one atom (\\(n>1\\)). Rigorously, a molecule, in which \\(n>1\\) must correspond to a depression on the potential energy surface that is deep enough to confine at least one vibrational state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecule" .

goldbook:M04004 a skos:Concept ;
    skos:definition "1,2,3-Trioxolanes, the primary products of the reaction of ozone at a carbon–carbon double bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molozonides" .

goldbook:M04006 a skos:Concept ;
    skos:definition "Of a body about an axis is the sum of the products of its mass elements and the squares of their distances to the axis. principal moments of inertia of a molecule are chosen so that \\(I_{A}\\leq I_{B}\\leq I_{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "moment of inertia" .

goldbook:M04008 a skos:Concept ;
    skos:definition "A spectrum which is obtained when a beam of ions is separated according to the momentum-to-charge ratios of the ionic species contained within it. A sector magnetic field achieves separation of the various ionic species in this way. If the ion beam is homogeneous in translational energy, as is the case with sector instruments, separation according to the \\(\\frac{m}{z}\\) ratios is also achieved and a mass spectrum is obtained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "momentum spectrum" .

goldbook:M04009 a skos:Concept ;
    skos:definition "Optical device that transmits a mechanically selectable narrow band of wavelengths of electromagnetic radiation chosen from a wider range of wavelengths available at the input." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monochromator" .

goldbook:M04010 a skos:Concept ;
    skos:altLabel "mAbs" ;
    skos:definition "A single species of immunoglobulin molecules produced by culturing a single clone of a hybridoma cell. MAbs recognize only one chemical structure, i.e. they are directed against a single epitope of the antigenic substance used to raise the antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monoclonal antibodies" .

goldbook:M04011 a skos:Concept ;
    skos:definition "A colloidal system in which all particles are of (nearly) the same size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monodisperse medium" .

goldbook:M04013 a skos:Concept ;
    skos:definition "Radiation consisting of particles of a single kinetic energy or photons of a single energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mono-energetic radiation" .

goldbook:M04014 a skos:Concept ;
    skos:definition "A spectrum containing only ions made up of the principal isotopes of atoms making up the original molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monoisotopic mass spectrum" .

goldbook:M04015 a skos:Concept ;
    skos:altLabel "Langmuir monolayer" ;
    skos:definition "A single, closely packed layer of atoms or molecules. The term floating monolayer is used for certain spread monolayers or films which are in the condensed — often solid — state. The term 'Langmuir monolayer' has recently been coined for spread monolayers. This usage is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monolayer" .

goldbook:M04016 a skos:Concept ;
    skos:definition "For chemisorption the amount of adsorbate which is needed to occupy all adsorption sites as determined by the structure of the adsorbent and by the chemical nature of the absorptive. For physisorption, the amount needed to cover the surface with a complete monolayer of atoms or molecules in close-packed array, the kind of close packing having to be stated explicitly when necessary." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monolayer capacity" .

goldbook:M04017 a skos:Concept ;
    skos:definition "A substance composed of monomer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomer" .

goldbook:M04018 a skos:Concept ;
    skos:altLabel "mer",
        "monomer unit" ;
    skos:definition "The largest constitutional unit contributed by a single monomer molecule to the structure of a macromolecule or oligomer molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomeric unit" .

goldbook:M04019 a skos:Concept ;
    skos:definition "A molecule which can undergo polymerization thereby contributing constitutional units to the essential structure of a macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monomer molecule" .

goldbook:M04021 a skos:Concept ;
    skos:definition "A term which includes aldoses, ketoses and a wide variety of derivatives. Derivation includes oxidation, deoxygenation, introduction of other substituents, alkylation and acylation of hydroxy groups, and chain branching. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monosaccharides" .

goldbook:M04022 a skos:Concept ;
    skos:definition "The reversible transition, on cooling, of a liquid to a mixture of a second liquid and a solid: \\[\\rm{liquid}_{1}\\rightleftarrows \\rm{liquid}_{2}+\\rm{solid}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monotectic reaction" .

goldbook:M04023 a skos:Concept ;
    skos:definition "A reaction in a system containing two solid solution phases, \\(\\alpha\\mathit{'}\\) and \\(\\alpha\\mathit{''}\\) in which \\(\\alpha\\mathit{'}\\) decomposes into \\(\\alpha\\mathit{''}\\) and a new phase \\(\\beta \\): \\[\\alpha\\mathit{'}\\rightleftharpoons \\alpha\\mathit{''}+\\beta \\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monotectoid reaction" .

goldbook:M04024 a skos:Concept ;
    skos:definition "The maximum temperature at which a monotectoid reaction can occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monotectoid temperature" .

goldbook:M04026 a skos:Concept ;
    skos:definition "Terpenoids having a $\\ce{C10}$ skeleton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monoterpenoids" .

goldbook:M04028 a skos:Concept ;
    skos:definition "The irreversible transition from a metastable polymorphic form to the stable polymorph. Example: The transition of metastable $\\ce{CaCO3}$ (aragonite-type) to the stable $\\ce{CaCO3}$ (calcite-type)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monotropic transition" .

goldbook:M04029 a skos:Concept ;
    skos:definition "Substance that fixes a dyestuff in or on a material by combining with the dye to form an insoluble compound, used to fix or intensify stains in a tissue or cell preparation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mordant" .

goldbook:M04030 a skos:Concept ;
    skos:definition "Visualization of the potential energy surfaces for a reacting system, as a function of two chosen coordinates. It is particularly useful to discuss structural effects on the transition state geometry for processes occurring either by stepwise or concerted routes. The use of such diagrams, first suggested for elimination reactions, was later extended to acid–base catalysis and to certain other reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "More O'Ferrall–Jencks diagram" .

goldbook:M04031 a skos:Concept ;
    skos:altLabel "spin-flop transition" ;
    skos:definition "A transition specific to $\\ce{\\upalpha-Fe2O3}$ in which there is a change in the direction of the atomic magnetic moments in the antiferromagnetic state from parallel to perpendicular to the c-axis. Synonymous with spin-flop transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Morin transition" .

goldbook:M04032 a skos:Concept ;
    skos:definition "An abrupt change in the structure of a solid solution with variation in composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphotropic transition" .

goldbook:M04033 a skos:Concept ;
    skos:definition "Resonance absorption of γ-radiation by nuclei arranged in a crystal lattice in such a way that the recoil momentum is shared by many atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mössbauer effect" .

goldbook:M04034 a skos:Concept ;
    skos:definition "The effective thickness of a source (\\(t_{s}\\)) or absorber (\\(t_{a}\\)) in the optical path." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mössbauer thickness" .

goldbook:M04037 a skos:Concept ;
    skos:altLabel "Mott–Hubbard transition" ;
    skos:definition "A transition occurring only in 'single-valent' systems from strongly correlated (\\(U > W\\)) to weakly correlated (\\(U < W\\)) electrons as a result of a change of bandwidth \\(W\\). \\(W\\) reflects the strength of the interatomic interactions in a periodic array of like atoms and \\(U\\) is a measure of the intra-atomic interactions, i.e. the electrostatic energy involved in the creation of polar states by transferring an electron from one atom to the next, as shown schematically by the disproportionation reaction: \\[\\rm{M}^{n+}+\\rm{M}^{n+}\\rightarrow \\rm{M}^{(n+1)+}+\\rm{M}^{(n- 1)+}\\] A \\(U > W\\) produces a magnetic semiconductor; a \\(U < W\\) gives rise to a metal (normally nonmagnetic). Note also that \\(U\\) and \\(W\\) can be altered by changes in interatomic distances, brought about through temperature or pressure variations or by introducing an alloying element. Synonymous with Mott–Hubbard transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mott transition" .

goldbook:M04041 a skos:Concept ;
    skos:definition "Polysaccharides composed of alternating units from uronic acids and glycosamines, and commonly partially esterified with sulfuric acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mucopolysaccharides" .

goldbook:M04042 a skos:Concept ;
    skos:definition "Representation of some molecular entities solely by localized two-electron two-centre bonds appears to be unsatisfactory. Instead, multi-centre bonds have to be considered in which electron pairs occupy orbitals encompassing three or more atomic centres. Examples include the three-centre bonds in diborane, the delocalized $\\ce{\\uppi\\!\\mbox{-}bonding}$ of benzene and bridged carbocations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-centre bond" .

goldbook:M04043 a skos:Concept ;
    skos:definition "A synonym for pericyclic reaction. The number of 'centres' is the number of atoms not bonded initially, between which single bonds are breaking or new bonds are formed in the transition state. This number does not necessarily correspond to the ring size of the transition state for the pericyclic reaction. Thus, a Diels–Alder reaction is a 'four-centre reaction'. This terminology has largely been superseded by the more detailed one developed for the various pericyclic reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-centre reaction" .

goldbook:M04044 a skos:Concept ;
    skos:definition "A pulse amplitude analyser which includes a storage function to record the number of pulses received per channel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-channel pulse height analyser" .

goldbook:M04049 a skos:Concept ;
    skos:definition "A system of adjacent layers or monolayers. The term bilayer applies to the particular case of a multilayer two monolayers thick. Monolayers and multilayers may be alternatively named 'films' provided boundaries can be defined for them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multilayer" .

goldbook:M04050 a skos:Concept ;
    skos:definition "Adsorption such that the adsorption space accommodates more than one layer of molecules, and not all adsorbed molecules are in contact with the surface layer of the adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multilayer adsorption" .

goldbook:M04053 a skos:Concept ;
    skos:definition "Occurs when an atom or molecule and their concomitant ions have energy states whereby the energy in two or more photons is absorbed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiphoton ionization" .

goldbook:M04054 a skos:Concept ;
    skos:definition "A process involving interaction of two or more photons with a molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiphoton process" .

goldbook:M04056 a skos:Concept ;
    skos:definition "Permits multiple passage of radiation to increase the absorption pathlength. It is constructed in such a way that mirrors either form part of the cell or are mounted in the sample cell holder." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple-pass cell" .

goldbook:M04057 a skos:Concept ;
    skos:definition "An alternative to multiple ion detection which emphasizes that monitoring of peaks rather than detection of ions is the important feature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple peak scanning" .

goldbook:M04058 a skos:Concept ;
    skos:definition "Successive rescattering of radiation within the scattering medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple scattering" .

goldbook:M04059 a skos:Concept ;
    skos:altLabel "FTS" ;
    skos:definition "A spectrometer in which a single photodetector simultaneously receives signals from different spectral bands which are specifically encoded. In the case of frequency multiplexing, each spectral band is modulated at a specific frequency. Decoding is achieved by filtering out, by electronic means, the corresponding signals. Frequency multiplexing may be realized by changing the path difference between the two interfering beams at a uniform rate. Fourier transform of the interferogram so obtained yields the spectrum. This method is called Fourier transform spectrometry (FTS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplex spectrometer" .

goldbook:M04061 a skos:Concept ;
    skos:definition "A name that expresses the multiple occurrence of identical parent structures, two or more of which are connected by a symmetrical structure expressible by means of a multivalent simple or composite prefix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplicative name" .

goldbook:M04062 a skos:Concept ;
    skos:altLabel "spin multiplicity" ;
    skos:definition "The number of possible orientations, calculated as \\(2\\ S+1\\), of the spin angular momentum corresponding to a given total spin quantum number (\\(S\\)), for the same spatial electronic wavefunction. A state of singlet multiplicity has \\(S=0\\) and \\(2\\ S+1=1\\). A doublet state has \\(S=\\frac{1}{2}\\), \\(2\\ S+1=2\\), etc. Note that when \\(S>L\\) (the total orbital angular momentum possible) there are only \\(2\\ L+1\\) orientations of total angular momentum possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiplicity" .

goldbook:M04063 a skos:Concept ;
    skos:definition "A selectively labelled compound may be multiply labelled when in the unmodified compound there is more than one atom of the same element at the position where the isotopic modification occurs, e.g. $\\ce{H}$ in $\\ce{CH4}$, or there are several atoms of the same element at different positions where the isotopic modification occurs, e.g. $\\ce{C}$ in $\\ce{C4H8O}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiply labelled" .

goldbook:M04065 a skos:Concept ;
    skos:definition "Samples taken in a series of steps with the sampling portions constituting the sample (units or increments) at each step being selected from the larger or greater number of portions of the previous step, or from a primary or composite sample. The first set of portions (units or increments) taken from the population available for sampling is the primary sample. The subsequent samples (secondary, tertiary, etc.) are the sets of subsamples, units, items, individuals or increments taken from the preceding step. The units may be different steps of multistage sampling (e.g. pallets, cases, packages)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multistage sampling" .

goldbook:M04066 a skos:Concept ;
    skos:definition "A chain that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through more than four atoms, more than two on at least one side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-strand chain" .

goldbook:M04067 a skos:Concept ;
    skos:definition "A macromolecule that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through more than four atoms, more than two on at least one side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multi-strand macromolecule" .

goldbook:M04068 a skos:Concept ;
    skos:definition "Mesoionic compounds having a 1,3-oxazole skeleton bearing an oxygen atom attached to the 5-position with the following delocalized structure:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "munchnones" .

goldbook:M04071 a skos:Concept ;
    skos:definition "Compounds having two $\\ce{\\upbeta\\!\\mbox{-}haloalkyl groups}$ bound to a sulfur atom, as in $\\ce{(XC2H2C2H2)2S}$, and their analogues, the nitrogen (and phosphorus) mustards, $\\ce{(XC2H2C2H2)2NR}$. Compounds having one $\\ce{\\upbeta\\!\\mbox{-}haloalkyl group}$ and one $\\ce{\\upbeta\\!\\mbox{-}hydroxyalkyl group}$ on $\\ce{S}$ are termed hemi- or semi-mustards by some chemists." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mustards" .

goldbook:M04072 a skos:Concept ;
    skos:definition "The introduction of permanant heritable changes i.e. mutations into the DNA of an organism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutagenesis" .

goldbook:M04073 a skos:Concept ;
    skos:definition "The change in optical rotation accompanying epimerization. In sugar chemistry this term usually refers to epimerization at the hemiacetal carbon atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutarotation" .

goldbook:M04074 a skos:Concept ;
    skos:definition "A heritable change in the nucleotide sequence of genomic DNA (or RNA in RNA viruses), or in the number of genes or chromosomes in a cell, which may occur spontaneously or be brought about by chemical mutagens or by radiation (induced mutation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutation" .

goldbook:M04075 a skos:Concept ;
    skos:definition "The frequency (\\(\\rm{h}^{-1}\\)) with which a mutation occurs within a organism or gene. In general, rates of spontaneous mutation vary between one in \\(10^{4}\\) and one in \\(10^{8}\\) per gene per generation, and can be considerably increased by mutagens." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutation rate" .

goldbook:M04077 a skos:Concept ;
    skos:definition "Birefringent cylinders which form spontaneously from lipid-containing material in contact with water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Myelin cylinders" .

goldbook:MT06760 a skos:Concept ;
    skos:definition "Mass transport is described by a mobility \\(b\\), defined by: \\[b_{i} = \\frac{ u _{i}}{\\boldsymbol{F}_{i}}\\] where \\( u _{i}\\) is the average drift velocity and \\(\\boldsymbol{F}_{i}\\) is the force on particle \\(i\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mobility" .

goldbook:MT06765 a skos:Concept ;
    skos:definition "An enzyme that, in the active state, contains one or more metal ions which are essential for its biological function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metalloenzyme" .

goldbook:MT06778 a skos:Concept ;
    skos:altLabel "MCD" ;
    skos:definition "Magnetic circular dichroism is observed when a sample differentially absorbs left- and right- circularly polarized light in a magnetic field parallel to the light beam." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic circular dichroism" .

goldbook:MT06781 a skos:Concept ;
    skos:definition "For paramagnetic materials, the magnetic susceptibility may be measured experimentally and used to give information on the molecular magnetic dipole moment, and hence on the electronic structure of the molecules in the material. The paramagnetic contribution to the molar magnetic susceptibility of a material, \\(\\chi \\), is related to the molecular magnetic dipole moment \\(m\\) by the curie relation: \\(\\chi = \\frac{\\rm{constant x}\\ m^{2}}{T}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic susceptibility" .

goldbook:MT06795 a skos:Concept ;
    skos:altLabel "MRI" ;
    skos:definition "The visualisation of the distribution of nuclear spins (usually water) in a body by using a magnetic field gradient (NMR imaging). A similar technique, but less widely used, is to visualise the distribution of paramagnetic centres (EPR imaging)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magnetic resonance imaging" .

goldbook:MT06830 a skos:Concept ;
    skos:altLabel "metabolic half-time" ;
    skos:definition "Time required for one-half of the quantity of a substance in the body to be metabolised." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "metabolic half-life" .

goldbook:MT06831 a skos:Concept ;
    skos:definition "Continuous or repeated observation, measurement, and evaluation of health and/or environmental or technical data for defined purposes, according to prearranged schedules in space and time, using comparable methods for sensing and data collection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monitoring" .

goldbook:MT06832 a skos:Concept ;
    skos:definition "Simulation and analysis of a sequence of events using random numbers to generate possible outcomes in an iterative process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Monte Carlo study" .

goldbook:MT06833 a skos:Concept ;
    skos:definition "Agent that can induce heritable changes (mutations) of the genotype in a cell as a consequence of alterations or loss of genetic material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mutagen" .

goldbook:MT06853 a skos:Concept ;
    skos:definition "A state of matter in which the degree of molecular order is intermediate between the perfect three-dimensional, long-range positional and orientational order found in solid crystals and the absence of long-range order found in isotropic liquids, gases, and amorphous solids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesomorphic state" .

goldbook:MT06858 a skos:Concept ;
    skos:definition "A part of a molecule or macromolecule endowed with sufficient anisotropy in both attractive and repulsive forces to contribute strongly to mesophase or, in particular, liquid-crystal mesophase formation in low-molar-mass and polymeric substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesogenic group" .

goldbook:MT06869 a skos:Concept ;
    skos:definition "A polymer, whose molecules have mesogenic units only in their main chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main-chain polymer liquid crystal" .

goldbook:MT06870 a skos:Concept ;
    skos:definition "A compound that under suitable conditions of temperature, pressure, and concentration can exist as a mesophase or, in particular, as a liquid-crystal (LC) phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mesogen" .

goldbook:MT06878 a skos:Concept ;
    skos:definition "Structure, having lateral dimensions much greater than its thickness, through which transfer may occur under a variety of driving forces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "membrane" .

goldbook:MT06887 a skos:Concept ;
    skos:definition "Pressure-driven membrane-based separation process in which particles and dissolved macromolecules larger than \\(0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\) are rejected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microfiltration" .

goldbook:MT06910 a skos:Concept ;
    skos:definition "The length of time after which no causal relationship can reasonably be established. This length of time is the period from the last exposure to the point of time at which an exposed person has demonstrated the initial signs or symptoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum latent period" .

goldbook:MT06924 a skos:Concept ;
    skos:definition "The time required for the analyte to move through the effective length of the capillary, \\(L_{\\rm{eff}}\\), that is, from the sample introduction point to the detection point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migration time" .

goldbook:MT06927 a skos:Concept ;
    skos:definition "Experimentally determined as the migration time of a compound that is completely retained in the micellar phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "migration time of micelles" .

goldbook:MT06928 a skos:Concept ;
    skos:definition "Defined as: \\[k_{\\rm{MEKC}} = \\frac{n_{\\rm{mc}}}{n_{\\rm{aq}}} = K\\cdot \\frac{V_{\\rm{mc}}}{V_{\\rm{aq}}}\\] where \\(n_{\\rm{mc}}\\) and \\(n_{\\rm{aq}}\\) are the chemical amounts of the analyte in the micellar and aqueous phases, respectively, \\(K\\) is the distribution constant and \\(V_{\\rm{mc}}\\) and \\(V_{\\rm{aq}}\\) are the corresponding volumes of the phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass distribution ratio" .

goldbook:MT06929 a skos:Concept ;
    skos:definition "Defined analogously to mass distribution ratio (in micellar electrokinetic chromatography), \\(k_{\\rm{MEEKC}}\\) by replacing terms for micelles with corresponding terms for micro-emulsion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mass distribution ratio" .

goldbook:MT06966 a skos:Concept ;
    skos:definition "The MOL file format is used to encode chemical structures, substructures and conformations as text-based connection tables. It is used by MDL Information Systems Inc. (e.g., in their MACCS or ISIS programs)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "MOL file format" .

goldbook:MT06967 a skos:Concept ;
    skos:definition "A molecular connectivity index is a numeric descriptor derived from molecular topology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular connectivity index" .

goldbook:MT06968 a skos:Concept ;
    skos:definition "Molecular design is the application of all techniques leading to the discovery of new chemical entities with specific properties required for the intended application." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular design" .

goldbook:MT06969 a skos:Concept ;
    skos:definition "Molecular dynamics is a simulation procedure consisting of the computation of the motion of atoms in a molecule or of individual atoms or molecules in solids, liquids and gases, according to Newton's laws of motion. The forces acting on the atoms, required to simulate their motions, are generally calculated using molecular mechanics force fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular dynamics" .

goldbook:MT06970 a skos:Concept ;
    skos:definition "Molecular graphics is a technique for the visualization and manipulation of molecules on a graphical display device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular graphics" .

goldbook:MT06971 a skos:Concept ;
    skos:definition "Molecular modeling is the investigation of molecular structures and properties using computational chemistry and graphical visualization techniques in order to provide a plausible three-dimensional representation under a given set of circumstances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular modeling" .

goldbook:MT06972 a skos:Concept ;
    skos:definition "The molecular shape is an attribute of a molecule dealing with spatial extension, form, framework, or geometry. It is often described by, e.g., principal axes, ovality, or connectivity indices." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular shape" .

goldbook:MT06973 a skos:Concept ;
    skos:definition "A molfile is a table containing atom type, connectivity and a more or less arbitrary 2D or 3D information about a molecule. Well-known file formats include the MOLfile used by MDL Information Systems Inc. (e.g., in the database MACCS), the MOL2 file used by Tripos Associates (e.g., in the modeling package SYBYL), or the CSSR format." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molfile" .

goldbook:MT06974 a skos:Concept ;
    skos:definition "Multivariate statistics is a set of statistical tools to analyze data (e.g., chemical and biological) matrices using regression and/or pattern recognition techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multivariate statistics" .

goldbook:MT07068 a skos:Concept ;
    skos:altLabel "principle of maximum hardness" ;
    skos:definition "A chemical system at a given temperature will evolve to a configuration of maximum absolute hardness, $\\upeta\\!$, provided that the potential due to the nuclei, plus any external potential and the electronic chemical potential, remain constant. In terms of molecular orbital theory, the highest value of $\\upeta\\!$ reflects the highest possible energy gap between the lowest unoccupied and highest occupied molecular orbitals; this value correlates with the stability of a system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "maximum hardness principle" .

goldbook:MT07069 a skos:Concept ;
    skos:definition "The graph with differently labelled (coloured) vertices (chromatic graph) which represent different kinds of atoms and differently labelled (coloured) edges related to different types of bonds. Within the topological electron distribution theory, a complete network of the bond paths for a given nuclear configuration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular graph" .

goldbook:MT07070 a skos:Concept ;
    skos:definition "The theory which deals with analyses of all consequences of connectivities inherent in molecular structure and chemical transformations. The theory does not produce numerical data but uses available data and searches for regularities that can be attributed to combinatorial and topological origins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular graph theory" .

goldbook:MT07071 a skos:Concept ;
    skos:definition "An excited electronic state which is composed primarily of atomic orbitals with principal quantum numbers greater than that of the ground state and the valence excited states. Such electronic states typically have a large polarizability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular Rydberg state" .

goldbook:MT07072 a skos:Concept ;
    skos:altLabel "MC",
        "method of Monte Carlo" ;
    skos:definition "In mathematics, a method originally used for calculating multiple integrals by means of a random sample. The method is used for numerical modelling of many-particle chemical systems, in particular liquids; it is based on the equilibrium statistical mechanics theory. Observables A are calculated as mean values over a great number (\\(\\cong\\rm{10}^{\\rm{5}}-\\rm{10}^{\\rm{6}}\\)) of instant configurations as determined by coordinates of the particles. \\[< A >\\ = \\frac{1}{N}\\sum _{i=1}^{N}A\\{r_{i}\\}\\] where \\(N\\) is the number of configurations. At the first stage, various configurations are randomly generated and then those energetically unrealizable eliminated. An efficient search for the most probable configurations to be entered into the above expression is provided by the Metropolis algorithm based on the principle of Markov's chain theory. While being elaborated for the study of equilibrium chemical systems, MC method is also applied to studies of the dynamics of chemical reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Monte Carlo method" .

goldbook:MT07073 a skos:Concept ;
    skos:definition "The empirical function relating the potential energy of a molecule to the inter-atomic distance r accounting for the anharmonicity of bond stretching: \\[E\\left(r\\right) = D_{\\rm{e}}\\ (1- \\rm{e}^{-a\\ (r- r_{\\rm{e}})})^{2}\\] where \\(D_{\\rm{e}}\\) is the bond-dissociation energy, \\(r_{\\rm{e}}\\) is the equilibrium bond length, and \\(a\\) is a parameter characteristic of a given molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Morse potential" .

goldbook:MT07074 a skos:Concept ;
    skos:altLabel "MPA" ;
    skos:definition "A partitioning scheme based on the use of density and overlap matrixes of allocating the electrons of a molecular entity in some fractional manner among its various parts (atoms, bonds, orbitals). As with other schemes of partitioning the electron density in molecules, MPA is arbitrary and strongly dependent on the particular basis set employed. However, comparison of population analyses for a series of molecules is useful for a quantitative description of intra-molecular interactions, chemical reactivity and structural regularities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mulliken population analysis" .

goldbook:MT07075 a skos:Concept ;
    skos:definition "Configuration-interaction method in which simultaneous optimization of both the shapes of molecular orbitals and contributions from different electronic configurations is carried out by using the variational method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiconfiguration SCF method" .

goldbook:MT07140 a skos:Concept ;
    skos:definition "Chemical reaction that results in the breaking of main-chain bonds of a polymer molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "main-chain scission" .

goldbook:MT07141 a skos:Concept ;
    skos:definition "Chemical reaction that is induced by the direct absorption of mechanical energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Mechano-chemical reaction" .

goldbook:MT07177 a skos:Concept ;
    skos:definition "Glass or rubbery polymer that includes a large number of macropores (\\(50\\ \\rm{nm}\\)–\\(1\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter) that persist when the polymer is immersed in solvents or in the dry state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "macroporous polymer" .

goldbook:MT07230 a skos:Concept ;
    skos:definition "Capability of a mixture to form a single phase over certain ranges of temperature, pressure, and composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miscibility" .

goldbook:MT07270 a skos:Concept ;
    skos:definition "Area within the coexistence curve of an isobaric phase diagram (temperature vs composition) or an isothermal phase diagram (pressure vs composition)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "miscibility gap" .

goldbook:MT07284 a skos:Concept ;
    skos:definition "Process by which phase domains increase in size during the aging of a multiphase material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphology coarsening" .

goldbook:MT07285 a skos:Concept ;
    skos:definition "Shape, optical appearance, or form of phase domains in substances, such as high polymers, polymer blends, composites, and crystals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "morphology" .

goldbook:MT07287 a skos:Concept ;
    skos:definition "Copolymer comprising phase-separated microdomains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiphase copolymer" .

goldbook:MT07303 a skos:Concept ;
    skos:definition "Morphology consisting of phase microdomains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microdomain morphology" .

goldbook:MT07307 a skos:Concept ;
    skos:definition "Morphology observed in a blend of a block copolymer with the homopolymer of one of the blocks and characterized by alternating concentric shells of the copolymer and the homopolymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multicoat morphology" .

goldbook:MT07309 a skos:Concept ;
    skos:altLabel "salami-like morphology" ;
    skos:definition "Multiphase morphology in which dispersed phase domains of one polymer contain and completely encapsulate many phase domains of a second polymer that may have the same composition as the continuous phase domain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multiple inclusion morphology" .

goldbook:MT07419 a skos:Concept ;
    skos:altLabel "NMR" ;
    skos:definition "Upon excitation of an 'isotropic' sample (assuming an ultra short excitation pulse) the relationship between the fluorescence intensity detected at a time \\(t\\) and through a polarization analyser oriented at an angle \\(\\beta\\) with respect to the electric polarization of the exciting beam is given by \\[I(t,\\beta ) \\propto  N(t)\\left [ 1 + (3\\, \\rm{cos}^{2}\\, \\beta - 1)R(t) \\right ]\\] where \\(R(t)\\) is the degree of alignment of the emitting transition dipole in the laboratory frame and \\(N(t)\\) is the excited-state population, both at time \\(t\\). For \\(\\beta = 54.7^{\\,\\unicode{x26ac}}\\) (the magic angle), the dipole-alignment contribution vanishes and \\(I(t,\\,\\beta = 54.7^{\\,\\unicode{x26ac}} ) \\propto N(t)\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "magic angle" .

goldbook:MT07422 a skos:Concept ;
    skos:definition "Absorption probability (referred to electric dipolar absorption) for a molecular transition with its electric transition moment at an angle \\(\\theta\\) with the electric vector of the light is proportional to \\(\\cos^{2}\\theta\\). For the whole sample it is proportional to the orientation factor \\(K_{\\theta} = \\:< \\cos^{2}\\theta >\\), averaged over all sample molecules. This average is \\(1\\) for a sample with all transition moments perfectly aligned along the electric vector of the light, \\(1/3\\) for an isotropic sample and \\(0\\) for a sample where all transition moments are perpendicular to the electric vector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "molecular orientation" .

goldbook:MT07424 a skos:Concept ;
    skos:altLabel "MRCI" ;
    skos:definition "Configuration-interaction method in which the configurations are built by excitation out of a wavefunction obtained by using, e.g., the multiconfiguration SCF method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "multireference configuration interaction" .

goldbook:MT07533 a skos:Concept ;
    skos:definition "Ceramic material consisting of co-continuous interpenetrating networks of two or more metal carbides, nitrides or oxides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "mixed ceramic" .

goldbook:MT07559 a skos:Concept ;
    skos:definition "Shaped, fabricated, intractable article with a homogeneous microstructure which does not exhibit any structural components distinguishable by optical microscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "monolith" .

goldbook:MT07568 a skos:Concept ;
    skos:definition "Polymer network synthesized using a reactant or reactants of known molar mass or masses and chemical structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "model network" .

goldbook:MT07637 a skos:Concept ;
    skos:definition "Syneresis in which the exudation of the liquid is from microscopic regions within a network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "microsyneresis" .

goldbook:N00350 a skos:Concept ;
    skos:definition "Non-SI unit of length, \\(\\rm{Å} = 10^{-10}\\ \\rm{m}\\), widely used in molecular physics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ångström" .

goldbook:N04078 a skos:Concept ;
    skos:definition "An excited state related to the ground state by a n → π* transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "n → π* state" .

goldbook:N04079 a skos:Concept ;
    skos:definition "An electronic transition described approximately as promotion of an electron from a 'non-bonding' (lone-pair) n orbital to an 'antibonding' $\\ce{\\uppi\\! orbital}$ designated as $\\ce{\\uppi\\!^{\\ast}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "n → π* transition" .

goldbook:N04080 a skos:Concept ;
    skos:altLabel "n-σ* no bond resonance" ;
    skos:definition "Delocalization of a free electron pair (n) into an antibonding $\\ce{\\upsigma\\!\\mbox{-}orbital}$ ($\\ce{\\upsigma\\!^{\\ast}}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "n-σ* delocalization" .

goldbook:N04081 a skos:Concept ;
    skos:definition "An electronic transition described approximately as promotion of an electron from a 'non-bonding' (lone-pair) n orbital to an 'antibonding' $\\ce{\\upsigma\\!\\mbox{-}orbital}$ designated as $\\ce{\\upsigma\\!^{\\ast}}$. Such transitions generally involve high transition energies and appear close to or mixed with Rydberg transitions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "n → σ* transition" .

goldbook:N04083 a skos:Concept ;
    skos:definition "A film which has lateral dimensions in the range of \\(0.1{-}100\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanoscopic film" .

goldbook:N04084 a skos:Concept ;
    skos:definition "Cycloalkanes especially cyclopentane, cyclohexane and their alkyl derivatives. The term seems to be obsolescent, except in the petrochemical industry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "naphthenes" .

goldbook:N04085 a skos:Concept ;
    skos:definition "Acids chiefly monocarboxylic, derived from naphthene. The term seems to be obsolescent, except in the petrochemical industry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "naphthenic acids" .

goldbook:N04086 a skos:Concept ;
    skos:definition "A chemical reaction that can be described as the conversion of a reactant into its mirror image, without rotation or translation of the product, so that the product enantiomer actually coincides with the mirror image of the reactant molecule. Examples of such reactions are cited under the entries fluxional and degenerate rearrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "narcissistic reaction" .

goldbook:N04087 a skos:Concept ;
    skos:definition "Broadening which has its origin in the finite optical lifetime of one or both levels involved in the transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural broadening" .

goldbook:N04088 a skos:Concept ;
    skos:definition "A mineral found in nature. It consists of graphitic carbon regardless of its crystalline perfection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural graphite" .

goldbook:N04089 a skos:Concept ;
    skos:definition "Of a specified isotope of an element, the isotopic abundance in the element as found in nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural isotopic abundance" .

goldbook:N04091 a skos:Concept ;
    skos:definition "Radiation originating from natural radioactivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural radiation" .

goldbook:N04092 a skos:Concept ;
    skos:definition "Radioactivity of naturally occurring nuclide in materials where the isotopic abundance of that nuclide is natural." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural radioactivity" .

goldbook:N04095 a skos:Concept ;
    skos:definition "The commonly used term for a special type of coke with extremely high graphitizability resulting from a strong preferred parallel orientation of its turbostratic layer structure and a particular physical shape of the grains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "needle coke" .

goldbook:N04096 a skos:Concept ;
    skos:definition "The depletion of one or more components in an interfacial layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative adsorption" .

goldbook:N04098 a skos:Concept ;
    skos:definition "An atom, radical, molecule or molecular moiety in the vapour phase which has gained one or more electrons thereby acquiring an electrically negative charge. The use of the term anion as an alternative is not recommended because of its connotations in solution chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative ion" .

goldbook:N04100 a skos:Concept ;
    skos:definition "The direct interaction of the reaction centre (usually, but not necessarily, an incipient carbenium centre) with a lone pair of electrons of an atom or with the electrons of a $\\ce{\\upsigma\\!\\mbox{-}}$ or $\\ce{\\uppi\\!\\mbox{-}bond}$ contained within the parent molecule but not conjugated with the reaction centre. A distinction is sometimes made between n-, $\\ce{\\upsigma\\!\\mbox{-}}$ and $\\ce{\\uppi\\!\\mbox{-}participation}$. A rate increase due to neighbouring group participation is known as 'anchimeric assistance'. 'Synartetic acceleration' is the special case of anchimeric assistance ascribed to participation by electrons binding a substituent to a carbon atom in a $\\ce{\\upbeta\\!\\mbox{-}position}$ relative to the leaving group attached to the $\\ce{\\upalpha\\!\\mbox{-}carbon}$ atom. According to the underlying model, these electrons then provide a three-centre bond (or 'bridge') 'fastening together' (as the word 'synartetic' is intended to suggest) the $\\ce{\\upalpha\\!\\mbox{-}}$ and $\\ce{\\upbeta\\!\\mbox{-}carbon}$ atoms between which the charge is divided in the intermediate bridged ion formed (and in the transition state preceding its formation). The term synartetic acceleration is not widely used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neighbouring group participation" .

goldbook:N04103 a skos:Concept ;
    skos:altLabel "YAG" ;
    skos:definition "A CW pulsed laser emitting radiation from excited The $\\ce{Nd^{3+}}$ principally occurring around \\(1.06\\ \\unicode[Times]{x3BC}\\rm{m}\\) (the precise position depends on the matrix). The $\\ce{Nd^{3+}}$ is present as a dopant in suitable crystals (e.g. yttrium–aluminium garnet, YAG) or in suitable glasses (phosphate, silicate, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neodymium laser" .

goldbook:N04107 a skos:Concept ;
    skos:definition "Analytical methods which depend on the measurement of the intensity of scattered light emanating from an illuminated volume of an aerosol. The ratio of scattered intensity to illuminating intensity is compared with a standard of known properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nephelometry" .

goldbook:N04108 a skos:Concept ;
    skos:definition "A fictitious layer corresponding to the dotted straight lines of the diagram which shows the concentration profile along the direction perpendicular to an electrode surface. The thickness \\(\\delta \\) of this layer is called the effective (or equivalent) thickness of the diffusion layer. Its definition is apparent from the figure. It is the thickness which the diffusion layer would have if the concentration profile were a straight line coinciding with the tangent to the true concentration profile at the interface, and that straight line were extended up to the point where the bulk concentration is reached. \\(\\delta \\) has a formal significance only. It is simply another way of writing the mass transfer coefficient \\(k_{\\rm{d}}\\) defined in terms of a resistivity instead of a conductivity. N04108.png" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nernst's diffusion layer" .

goldbook:N04109 a skos:Concept ;
    skos:definition "A two-dimensional lattice (in a particular range of surface coverage and temperature) into which the adsorbate is ordered, especially in some cases of localized adsorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net" .

goldbook:N04110 a skos:Concept ;
    skos:definition "The sum of cathodic and anodic partial currents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net current" .

goldbook:N04111 a skos:Concept ;
    skos:definition "The algebraic sum of the charges present at the surface of the particle divided by the elementary charge of the proton. The symbol \\(z\\) is also used for charge number of an ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net electric charge" .

goldbook:N04112 a skos:Concept ;
    skos:definition "A highly ramified macromolecule in which essentially each constitutional unit is connected to each other constitutional unit and to the macroscopic phase boundary by many permanent paths through the macromolecule, the number of such paths increasing with the average number of intervening bonds; the paths must on the average be co-extensive with the macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "network" .

goldbook:N04113 a skos:Concept ;
    skos:altLabel "polymer network" ;
    skos:definition "A polymer composed of one or more networks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "network polymer" .

goldbook:N04117 a skos:Concept ;
    skos:definition "The number of free neutrons divided by the containing volume. Partial densities may be defined for neutrons characterized by such parameters as energy and directions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron density" .

goldbook:N04118 a skos:Concept ;
    skos:definition "The process in which a neutron produces on the average more than one neutron in a medium containing fissile material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron multiplication" .

goldbook:N04120 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant \\(m_{\\rm{n}} = \\pu{1.6749286(10)E-27 kg}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron rest mass" .

goldbook:N04132 a skos:Concept ;
    skos:definition "The temperature assigned to a population of neutrons when this population is approximated by a Maxwellian distribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutron temperature" .

goldbook:N04133 a skos:Concept ;
    skos:definition "Organisms preferring a neutral medium for growth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutrophilic organisms" .

goldbook:N04134 a skos:Concept ;
    skos:definition "A projection formula representing the spatial arrangement of bonds on two adjacent atoms in a molecular entity. The structure appears as viewed along the bond between these two atoms, and the bonds from them to other groups are drawn as projections in the plane of the paper. The bonds from the atom nearer to the observer are drawn so as to meet at the centre of a circle representing that atom. Those from the further atom are drawn as if projecting from behind the circle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Newman projection" .

goldbook:N04135 a skos:Concept ;
    skos:definition "SI derived unit of force, \\(\\pu{N} = \\pu{kg m s-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "newton" .

goldbook:N04136 a skos:Concept ;
    skos:definition "In soap films, two types of equilibrium film are often observed, sometimes successively in the same system: one characterized by thicknesses of the order of \\(7\\ \\rm{nm}\\) or more which varies significantly with minor changes in composition such as ionic strength, and the other having a lesser thickness relatively independent of such changes. When a distinction is needed, the former are designated as common black films, and the latter as Newton black films. The current use of first or secondary for the common black film and of second, primary or Perrin's for the Newton black film is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Newton black film" .

goldbook:N04137 a skos:Concept ;
    skos:definition "A vector diagram used to show the relationship between initial and final velocities or momenta in a two-particle scattering process. It is commonly used to relate laboratory and centre-of-mass coordinates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Newton diagram" .

goldbook:N04138 a skos:Concept ;
    skos:definition "A fluid in which the components of the stress tensor are linear functions of the first spatial derivatives of the velocity components. These functions involve two material parameters (taken as constants throughout the fluid, although depending on ambient temperature and pressure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Newtonian fluid" .

goldbook:N04140 a skos:Concept ;
    skos:definition "An affix used in names to denote a nest-like structure, especially a boron skeleton that is almost closed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>nido</i>-" .

goldbook:N04141 a skos:Concept ;
    skos:definition "An arrangement for a double-focusing mass spectrometer in which a deflection of \\(\\frac{\\pi}{2}\\) radians in a radial electrostatic field analyser is followed by a magnetic deflection of \\(\\frac{\\pi}{3}\\) radians. The electrostatic analyser uses a symmetrical object-image arrangement and the magnetic analyser is used asymmetrically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Nier–Johnson geometry" .

goldbook:N04142 a skos:Concept ;
    skos:definition "The intramolecular hydrogen migration which can be observed in enzymatic and chemical hydroxylations of aromatic rings. It is evidenced by appropriate deuterium labelling, i.e.  In enzymatic reactions the NIH shift is generally thought to derive from the rearrangement of arene oxide intermediates, but other pathways have been suggested. (NIH stands for U.S. National Institutes of Health where the shift was discovered.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "NIH shift" .

goldbook:N04143 a skos:Concept ;
    skos:definition "An amorphous, dark grey, rainy cloud layer reaching almost to the ground; \\(300{-}600\\ \\rm{m}\\) vertical velocities of \\(0.05{-}0.2\\ \\rm{m s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nimbostratus cloud" .

goldbook:N04144 a skos:Concept ;
    skos:definition "Amines substituted at N with a nitro group (a contracted form of N-nitroamines); they are thus amides of nitric acid, and the class is composed of nitramide, $\\ce{O2NNH2}$, and its derivatives formed by substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitramines" .

goldbook:N04145 a skos:Concept ;
    skos:altLabel "aminylenes",
        "azenes",
        "imidogens" ;
    skos:definition "The neutral compound $\\ce{HN{:}}$ having univalent nitrogen, and its derivatives $\\ce{RN}$. Aminylenes is a recognized but less widely used synonym. Other names that have been used include aminediyls, imidogens, azenes. They may exist in either a singlet or a triplet electronic state (four spin-paired electrons, or two spin-paired and two with parallel spins, respectively), e.g. $\\ce{CH3N{:}}$ methylnitrene.Until the 1960s, nitrenes had a totally different meaning: analogues of nitrones in which the double-bonded oxygen is replaced by double-bonded carbon, thus azomethine ylides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrenes" .

goldbook:N04146 a skos:Concept ;
    skos:altLabel "aminylium ions",
        "imidonium ions",
        "imin",
        "imine radical" ;
    skos:definition "The cation ($\\ce{H2N{:}^{+}}$) and its N-hydrocarbyl derivatives ($\\ce{R2N{:}^{+}}$), in which the nitrogen has a positive charge, and two unshared electrons. A synonymous but less widely used term is aminylium ions. The alkylidene derivatives of ($\\ce{H2N{:}^{+}}$), ($\\ce{R2C=N{:}^{+}}$), still belong to the class nitrenium ions, but are more precisely designated by the term iminylium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrenium ions" .

goldbook:N04147 a skos:Concept ;
    skos:definition "Sequential oxidation of ammonium salts to nitrite and nitrate by microorganisms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrification" .

goldbook:N04148 a skos:Concept ;
    skos:altLabel "nitrile imines",
        "nitrilimines" ;
    skos:definition "Ylides having the structure . Also known as 'nitrile imines' or 'nitrilimines', especially in the German literature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrile imides" .

goldbook:N04150 a skos:Concept ;
    skos:definition "Ylides having the structure ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrile oxides" .

goldbook:N04151 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC#N}$; thus C-substituted derivatives of hydrocyanic acid, $\\ce{HC#N}$. In systematic nomenclature, the suffix nitrile denotes the triply bound $\\ce{#N}$ atom, not the carbon atom attached to it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitriles" .

goldbook:N04152 a skos:Concept ;
    skos:definition "Sulfur analogues of nitrile oxides ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrile sulfides" .

goldbook:N04153 a skos:Concept ;
    skos:definition "1,3-dipolar compounds having the structure:  The uncharged canonical form  is called an alkylidene- (or hydrocarbylidene-) amino carbene; the name iminyl carbene is incorrect because iminyl is not a recognized prefix for $\\ce{–N=CR2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrile ylides" .

goldbook:N04155 a skos:Concept ;
    skos:definition "Derivatives of nitriles having the general structure $\\ce{R–C#N^{+}–Y^{−}}$. A subclass of 1,3-dipolar compounds including nitrile imides, nitrile oxides, nitrile sulfides and nitrile ylides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrilium betaines" .

goldbook:N04156 a skos:Concept ;
    skos:definition "Cations derived formally by attachment of one hydron to the nitrogen atom of a nitrile and hydrocarbyl derivatives thereof. E.g.  benzonitrilium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrilium ions" .

goldbook:N04157 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{O2NN=CR2}$ (also called N-nitroimines)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrimines" .

goldbook:N04158 a skos:Concept ;
    skos:definition "Compounds having the nitro group, $\\ce{NO2}$ (free valence on nitrogen), which may be attached to carbon, nitrogen (as in nitramines), or oxygen (as in nitrates), among other elements (in the absence of specification, C-nitro compounds are usually implied)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitro compounds" .

goldbook:N04159 a skos:Concept ;
    skos:definition "The assimilation of atmospheric nitrogen by microbial reduction to ammonia and conversion into organonitrogen compounds such as amino acids. Only a limited number of microorganisms are able to fix nitrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrogen fixation" .

goldbook:N04160 a skos:Concept ;
    skos:definition "A source of pulsed semi-coherent superradiance mainly around \\(337\\ \\rm{nm}\\). The lasing species is molecular nitrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrogen laser" .

goldbook:N04163 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC(=NOH)NO2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrolic acids" .

goldbook:N04164 a skos:Concept ;
    skos:altLabel "azomethine oxides" ;
    skos:definition "The N-oxides of imines, that have the structure $\\ce{R2C=N+(O−)R'}$ ($\\ce{R'}  eq \\ce{H}$). Synonymous with azomethine oxides. N-Oxides $\\ce{R2C=N+(O−)H}$ may be included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrones" .

goldbook:N04166 a skos:Concept ;
    skos:definition "Although this term has, regrettably, been used to mean the N-nitroso derivatives of amides, logically it refers to amides of nitrous acid; the unstable parent compound $\\ce{H2NNO}$ is, in fact, named nitrosamide, but its derivatives formed by substitution with hydrocarbyl groups are by long custom called nitrosamines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrosamides" .

goldbook:N04167 a skos:Concept ;
    skos:definition "N-Nitroso amines, compounds of the structure $\\ce{R2NNO}$. Compounds $\\ce{RNHNO}$ are not ordinarily isolable, but they, too, are nitrosamines. The name is a contraction of N-nitrosoamine and, as such, does not require the N locant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrosamines" .

goldbook:N04168 a skos:Concept ;
    skos:definition "N-Nitroso imines $\\ce{O=NN=CR2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrosimines" .

goldbook:N04169 a skos:Concept ;
    skos:definition "Compounds having the nitroso group, $\\ce{–NO}$. attached to carbon, or to another element, most commonly nitrogen or oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitroso compounds" .

goldbook:N04170 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC(=NOH)NO}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nitrosolic acids" .

goldbook:N04174 a skos:Concept ;
    skos:definition "A preparation of a radioactive isotope which is essentially free from stable isotopes of the element in question." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no carrier added" .

goldbook:N04175 a skos:Concept ;
    skos:definition "The random fluctuations occurring in a signal that are inherent in the combination of instrument and method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "noise" .

goldbook:N04178 a skos:Concept ;
    skos:definition "A tracer in which the label is present mainly in a specified position." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nominally labelled tracer" .

goldbook:N04180 a skos:Concept ;
    skos:definition "This is momentum coupling between two adiabatic potential-energy surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonadiabatic coupling" .

goldbook:N04183 a skos:Concept ;
    skos:definition "Intramolecular attractions or repulsions between atoms that are not directly linked to each other, affecting the thermodynamic stability of the chemical species concerned." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonbonded interactions" .

goldbook:N04184 a skos:Concept ;
    skos:definition "These include (\\(p\\),\\(V\\), \\(T\\)) measurements, saturated density measurements, and any other measurements which give information on the (\\(p\\),\\(V\\), \\(T\\)) surface of a fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-calorimetric thermophysical measurements" .

goldbook:N04185 a skos:Concept ;
    skos:definition "A carbocation the ground state of which has delocalized (bridged) bonding $\\ce{\\uppi\\!\\mbox{-}}$ or $\\ce{\\upsigma\\!\\mbox{-}electrons}$. (N.B. Allylic and benzylic carbocations are not considered nonclassical.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonclassical carbocation" .

goldbook:N04187 a skos:Concept ;
    skos:definition "Electrodes in which a support matrix, containing an ion exchanger (either cationic or anionic), a plasticizer solvent, and possibly an uncharged, selectivity-enhancing species, forms the ion-selective membrane which is usually interposed between two aqueous solutions. The support used can be either macroporous [e.g. poly(propylene carbonate) filter, glass frit, etc.] or microporous (e.g. 'thirsty' glass or inert polymeric material such as PVC) yielding with the ion-exchanger and the solvent a 'solidified' homogeneous mixture. These electrodes exhibit a response due to the presence of the ion-exchange material in the membrane. The solvent-polymeric-membrane is an example." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-crystalline electrodes" .

goldbook:N04188 a skos:Concept ;
    skos:definition "An activation analysis procedure in which, after the irradiation, no chemical and physical operations are applied which cause a change of any properties of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-destructive activation analysis" .

goldbook:N04192 a skos:Concept ;
    skos:definition "If the reactants in a chemical reaction are not initially present in a Boltzmann distribution the reaction is referred to as a non-equilibrium reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-equilibrium reaction" .

goldbook:N04193 a skos:Concept ;
    skos:definition "All varieties of solids consisting mainly of the element carbon with two-dimensional long-range order of the carbon atoms in planar hexagonal networks, but without any measurable crystallographic order in the third direction (c-direction) apart from more or less parallel stacking." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-graphitic carbon" .

goldbook:N04194 a skos:Concept ;
    skos:definition "A non-graphitic carbon which cannot be transformed into graphitic carbon solely by high-temperature treatment up to \\(3300\\ \\rm{K}\\) under atmospheric pressure or lower pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-graphitizable carbon" .

goldbook:N04195 a skos:Concept ;
    skos:definition "Labelling in which the resulting product has a different chemical composition from the initial one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-isotopic labelling" .

goldbook:N04196 a skos:Concept ;
    skos:definition "An error caused by any deviation from linearity of the response of the detector to the measured radiant power." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linearity error" .

goldbook:N04197 a skos:Concept ;
    skos:definition "An effect brought about by electromagnetic radiation the magnitude of which is not proportional to the irradiance. Non-linear optical effects of importance to photochemistry are harmonic frequency generation, lasers, Raman shifting, upconversion, and others." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linear optical effect" .

goldbook:N04199 a skos:Concept ;
    skos:definition "Interphases for which the exchange of common charged components between the phases proceeds unhindered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-polarized interphases" .

goldbook:N04200 a skos:Concept ;
    skos:definition "The disappearance of an excited species due to a radiationless transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-radiative decay" .

goldbook:N04202 a skos:Concept ;
    skos:definition "An isotopically labelled compound is designated as nonselectively labelled when the position(s) and the number of the labelling nuclide(s) are both undefined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonselectively labelled" .

goldbook:N04204 a skos:Concept ;
    skos:definition "Ions approach an interface differently depending on the forces in play. Ions are non-specifically adsorbed (positively or negatively) when they are subjected in the interphase only to long-range coulombic interactions (attraction or repulsion). They are believed to retain their solvation shell, and in the position of closest approach to the interface they are separated from it by one or more molecular layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-specific adsorption" .

goldbook:N04205 a skos:Concept ;
    skos:definition "Corrosion is non-uniform if the time average of the corrosion current through a unit area depends on its position on the surface. Non-uniform corrosion can be due to inhomogeneities of structure or of composition of the corroding material, or to inhomogeneities of the environment. Special cases of non-uniform corrosion such as pitting or intergranular corrosion are sometimes called localized corrosion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-uniform corrosion" .

goldbook:N04206 a skos:Concept ;
    skos:altLabel "polydisperse polymer" ;
    skos:definition "A polymer comprising molecules non-uniform with respect to relative molecular mass or constitution or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-uniform polymer" .

goldbook:N04207 a skos:Concept ;
    skos:definition "Energy transfer process with a low Franck–Condon factor because the nuclear geometries of the minima on the ground- and excited-state potential energy surfaces of the donor or of the acceptor are strongly displaced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-vertical energy transfer" .

goldbook:N04209 a skos:Concept ;
    skos:altLabel "NOEL" ;
    skos:definition "Greatest concentration or amount of a substance, found by experiment or observation, that causes no alterations of morphology, functional capacity, growth, development, or life span of target organisms distinguishable from those observed in normal (control) organisms of the same species and strain under the same defined conditions of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no-observed-effect-level" .

goldbook:N04211 a skos:Concept ;
    skos:definition "The term 'normal' in e.g. 'normal boiling temperature' means the value at a pressure of \\(101325\\ \\rm{Pa}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal" .

goldbook:N04214 a skos:Concept ;
    skos:definition "An elution procedure in which the stationary phase is more polar then the mobile phase. This term is used in liquid chromatography to emphasize the contrast to reversed-phase chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal-phase chromatography" .

goldbook:N04215 a skos:Concept ;
    skos:definition "Region for which the rate constants increase with increasing exergonicity of the reaction in plots relating rate constants for electron transfer, or quantities related to it, with the standard Gibbs energy for the reaction (\\(\\Delta _{\\rm{ET}}G^{\\rm{o}}\\)). This region is predicted by the Marcus theory for outer-sphere electron transfer for the case of \\(-\\Delta_{\\rm{ET}} G^{\\circ} \\leq \\lambda \\) in the Marcus equation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal region" .

goldbook:N04217 a skos:Concept ;
    skos:definition "Synonymous with diagram level." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normal X-ray level" .

goldbook:N04218 a skos:Concept ;
    skos:definition "Intramolecular abstraction of a $\\ce{\\upgamma\\!\\mbox{-}hydrogen}$ by an excited carbonyl compound to produce a 1,4-diradical as a primary photoproduct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Norrish Type II photoreaction" .

goldbook:N04219 a skos:Concept ;
    skos:definition "$\\ce{\\upalpha\\!\\mbox{-}Cleavage}$ of an excited carbonyl compound leading to an acyl-alkyl radical pair (from an acyclic carbonyl compound) or an acyl-alkyl diradical (from a cyclic carbonyl compound) as a primary photoproduct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Norrish Type I photoreaction" .

goldbook:N04224 a skos:Concept ;
    skos:definition "A transition in which the molar Gibbs energy (or chemical potential) and its \\((n - 1)\\)th-order derivatives are continuous, whereas the \\(n\\)th-order derivatives with respect to temperature and pressure are discontinuous at the transition point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>n</i>th order phase transition" .

goldbook:N04226 a skos:Concept ;
    skos:definition "The part of chemistry which deals with the study of nuclei and nuclear reactions using chemical methods." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear chemistry" .

goldbook:N04227 a skos:Concept ;
    skos:definition "A spontaneous nuclear transformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear decay" .

goldbook:N04228 a skos:Concept ;
    skos:definition "Nuclear decay involving a splitting into more nuclei or the emission of particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear disintegration" .

goldbook:N04229 a skos:Concept ;
    skos:definition "The division of a nucleus into two or more parts with masses of equal order of magnitude, usually accompanied by the emission of neutrons, gamma radiation and, rarely, small charged nuclear fragments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear fission" .

goldbook:N04230 a skos:Concept ;
    skos:definition "Material containing fissile nuclides, which when placed in a reactor, enables a chain reaction to be achieved." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear fuel" .

goldbook:N04232 a skos:Concept ;
    skos:altLabel "nuclear fusion" ;
    skos:definition "A reaction between two light nuclei resulting in the production of a nuclear species heavier than either initial nucleus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear fusion reaction" .

goldbook:N04233 a skos:Concept ;
    skos:definition "A polygranular graphite material for use in nuclear reactor cores consisting of graphitic carbon of very high chemical purity. High purity is needed to avoid absorption of low-energy neutrons and the production of undesirable radioactive species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear graphite" .

goldbook:N04234 a skos:Concept ;
    skos:definition "Nuclides having the same mass number and atomic number, occupying different nuclear energy states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear isomers" .

goldbook:N04235 a skos:Concept ;
    skos:definition "One of the energy values at which a nucleus can exist for an appreciable time (\\(> 10^{-22}\\ \\rm{s}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear level" .

goldbook:N04236 a skos:Concept ;
    skos:definition "Electromagnetic fundamental physical constant \\(\\mu _{\\rm{N}}=\\frac{m_{\\rm{e}}}{m_{\\rm{p}}}\\ \\mu _{\\rm{B}}=5.050\\ 7866(17)\\times 10^{-27}\\ \\rm{J T}^{-1}\\), where \\(m_{\\rm{e}}\\) is the electron rest mass, \\(m_{\\rm{p}}\\) the proton rest mass and \\(\\mu _{\\rm{B}}\\) the Bohr magneton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear magneton" .

goldbook:N04237 a skos:Concept ;
    skos:definition "A nucleus or any of its constituents in any of their energy states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear particle" .

goldbook:N04238 a skos:Concept ;
    skos:definition "A parameter which describes the effective shape of the equivalent ellipsoid of the nuclear charge distribution, \\(Q>0\\) for prolate (e.g. $\\ce{^{57}Fe}$, $\\ce{^{19}7Au}$); \\(Q" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear quadrupole moment" .

goldbook:N04239 a skos:Concept ;
    skos:definition "A device in which a self-sustaining nuclear fission chain reaction can be maintained and controlled. The term is sometimes applied to a device in which a nuclear fusion reaction can be produced and controlled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear reactor" .

goldbook:N04240 a skos:Concept ;
    skos:definition "The change of one nuclide into another with a different proton number or nucleon number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear transformation" .

goldbook:N04241 a skos:Concept ;
    skos:definition "For a nucleus a change from one quantized energy state into another or a nuclear transformation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclear transition" .

goldbook:N04242 a skos:Concept ;
    skos:definition "A material either added to or present in a system, which induces either homogeneous or heterogeneous nucleation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleating agent" .

goldbook:N04244 a skos:Concept ;
    skos:definition "A process in a phase transition in which nuclei of a new phase are first formed, followed by the propagation of the new phase at a faster rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleation and growth" .

goldbook:N04245 a skos:Concept ;
    skos:definition "Macromolecules, the major organic matter of the nuclei of biological cells, made up of nucleotide units, and hydrolysable into certain pyrimidine or purine bases (usually adenine, cytosine, guanine, thymine, uracil), ᴅ-ribose or 2-deoxy-ᴅ-ribose and phosphoric acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleic acids" .

goldbook:N04246 a skos:Concept ;
    skos:definition "A leaving group that carries away the bonding electron pair. For example, in the hydrolysis of an alkyl chloride, $\\ce{Cl^{-}}$ is the nucleofuge. The tendency of atoms or groups to depart with the bonding electron pair is called nucleofugality. The adjective is nucleofugal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleofuge" .

goldbook:N04249 a skos:Concept ;
    skos:altLabel "nucleophilic" ;
    skos:definition "A nucleophile (or nucleophilic reagent) is a reagent that forms a bond to its reaction partner (the electrophile) by donating both bonding electrons. A 'nucleophilic substitution reaction' is a heterolytic reaction in which the reagent supplying the entering group acts as a nucleophile. For example:  The term 'nucleophilic' is also used to designate the apparent polar character of certain radicals, as inferred from their higher relative reactivity with reaction sites of lower electron density. Nucleophilic reagents are Lewis bases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleophile" .

goldbook:N04250 a skos:Concept ;
    skos:definition "Catalysis by a Lewis base, involving formation of a Lewis adduct as a reaction intermediate. For example, the hydrolysis of acetic anhydride in aqueous solution catalysed by pyridine:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleophilic catalysis" .

goldbook:N04251 a skos:Concept ;
    skos:definition "The property of being nucleophilic.The relative reactivity of a nucleophilic reagent. (It is also sometimes referred to as 'nucleophilic power'.) Qualitatively, the concept is related to Lewis basicity. However, whereas Lewis basicity is measured by relative equilibrium constants:  nucleophilicity of a Lewis base is measured by relative rate constants of different nucleophilic reagents towards a common substrate, most commonly involving formation of a bond to carbon:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleophilicity" .

goldbook:N04252 a skos:Concept ;
    skos:definition "Proteins having nucleic acids as prosthetic groups, and thus yielding nucleic acids (or their cleavage products) as well as amino acids on hydrolytic cleavage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleoproteins" .

goldbook:N04253 a skos:Concept ;
    skos:definition "Ribosyl or deoxyribosyl derivatives (rarely, other glycosyl derivatives) of certain pyrimidine or purine bases. They are thus glycosylamines or N-glycosides related to nucleotides by the lack of phosphorylation. It has also become customary to include among nucleosides analogous substances in which the glycosyl group is attached to carbon rather than nitrogen ('C-nucleosides')." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleosides" .

goldbook:N04254 a skos:Concept ;
    skos:definition "The heterocyclic pyrimidine and purine compounds which are constituents of all nucleic acids. Adenine (A), guanine (G) and cytosine (C) are found in both DNA and RNA, thymine (T) is found (primarily) in DNA and uracil (U) only in RNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleotide bases" .

goldbook:N04255 a skos:Concept ;
    skos:definition "Compounds formally obtained by esterification of the 3 or 5 hydroxy group of nucleosides with phosphoric acid. They are the monomers of nucleic acids and are formed from them by hydrolytic cleavage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleotides" .

goldbook:N04256 a skos:Concept ;
    skos:definition "The positively charged central portion of an atom, excluding the orbital electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleus" .

goldbook:N04257 a skos:Concept ;
    skos:definition "A species of atom, characterized by its mass number, atomic number and nuclear energy state, provided that the mean lifetime in that state is long enough to be observable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclide" .

goldbook:N04258 a skos:Concept ;
    skos:definition "The rest mass of a nuclide expressed in atomic mass units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclidic mass" .

goldbook:N04259 a skos:Concept ;
    skos:definition "That concentration of an air pollutant that is considered objectionable. In the case of a substance with an objectionable odour, it is the smallest concentration of the substance which can be detected by a human being (nose)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuisance threshold" .

goldbook:N04260 a skos:Concept ;
    skos:definition "Number of entities of a constituent in a mixture divided by the volume of the mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number concentration" .

goldbook:N04261 a skos:Concept ;
    skos:definition "Number of defined particles, or elementary entities, of a component in a system divided by the mass of that system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number content" .

goldbook:N04262 a skos:Concept ;
    skos:definition "Number of particles divided by the volume they occupy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number density" .

goldbook:N04264 a skos:Concept ;
    skos:definition "Number of defined particles, or elementary entities of a defined component, crossing a cross-section divided by the time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number flow rate" .

goldbook:N04266 a skos:Concept ;
    skos:definition "Integer number obtained by counting of entities, which are usually molecules, atoms or ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "number of entities" .

goldbook:N04269 a skos:Concept ;
    skos:definition "Quotient of the value of a quantity and the unit used in its expression." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "numerical value" .

goldbook:NT06774 a skos:Concept ;
    skos:definition "The number of central atoms joined in a single coordination entity by bridging ligands or metal-metal bonds is indicated by dinuclear, trinuclear, tetranuclear, polynuclear, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nuclearity" .

goldbook:NT06834 a skos:Concept ;
    skos:definition "Sum of morphological changes resulting from cell death by lysis and/or enzymatic degradation, usually affecting groups of cells in a tissue." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "necrosis" .

goldbook:NT06888 a skos:Concept ;
    skos:definition "Pressure-driven membrane-based separation process in which particles and dissolved macromolecules smaller than \\(2\\ \\rm{nm}\\) are rejected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanofiltration" .

goldbook:NT06911 a skos:Concept ;
    skos:altLabel "NOAEL" ;
    skos:definition "Greatest concentration or amount found by experiment or observation, which causes no detectable adverse alteration of morphology, functional capacity, growth, development, or life span of the target organism under defined conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "no observed adverse effect level" .

goldbook:NT06936 a skos:Concept ;
    skos:definition "A distribution isotherm which is not linear." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linear distribution isotherm" .

goldbook:NT06940 a skos:Concept ;
    skos:definition "Chromatographic process, where the retention is governed by a non-linear distribution isotherm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linear chromatography" .

goldbook:NT06942 a skos:Concept ;
    skos:definition "Chromatographic process with normal peak-broadening effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-ideal chromatography" .

goldbook:NT06943 a skos:Concept ;
    skos:definition "Chromatographic process, where the retention is governed by a linear distribution isotherm and normal peak-broadening takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-ideal, linear chromatography" .

goldbook:NT06945 a skos:Concept ;
    skos:definition "Chromatographic process, where both isotherm curvature and other peak-broadening processes (such as diffusion) contribute to the peak shape." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-ideal, non-linear chromatography" .

goldbook:NT07076 a skos:Concept ;
    skos:altLabel "NAO" ;
    skos:definition "A valence-shell atomic orbital whose derivation involves diagonalising the localized block of the full density matrix of a given molecule associated with basis functions \\(\\chi _{i}\\left(\\rm{A}\\right)\\) on that atom. A distinguishing feature of NAOs is that they meet the simultaneous requirement of orthonormality and maximum occupancy. For isolated atoms, NAOs coincide with natural orbitals. In a polyatomic molecule the NAOs (in contrast to natural orbitals that become delocalised over all nuclear centres) mostly retain one-centre character, and thus are optimal for describing the molecular electron density around each atomic centre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural atomic orbital" .

goldbook:NT07077 a skos:Concept ;
    skos:altLabel "NBO" ;
    skos:definition "The orbital which is formed from natural hybrid orbitals. For a localized $\\ce{\\upsigma\\!\\mbox{-}bond}$ between atoms $\\ce{A}$ and $\\ce{B}$, the NBO is: \\[\\sigma _{\\rm{AB}}=c_{\\rm{A}}\\ \\rm{h}_{\\rm{A}}+c_{\\rm{B}}\\ \\mathrm{h}_{\\rm{B}}\\] where \\(\\rm{h}_{\\rm{A}}\\) and \\(\\rm{h}_{\\rm{B}}\\) are the natural hybrids centered on atoms $\\ce{A}$ and $\\ce{B}$. NBOs closely correspond to the picture of localized bonds and lone pairs as basic units of molecular structure, so that is possible to conveniently interpret ab initio wave-functions in terms of the classical Lewis structure concepts by transforming these functions to NBO form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural bond orbital" .

goldbook:NT07078 a skos:Concept ;
    skos:altLabel "NHO" ;
    skos:definition "Symmetrically orthogonalised directed hybrid orbital derived through unitary transformation of natural atomic orbitals centred on a particular atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural hybrid orbital" .

goldbook:NT07079 a skos:Concept ;
    skos:altLabel "NO" ;
    skos:definition "The orbitals defined (P. Lowdin) as the eigenfunctions of the spinless one-particle electron density matrix. For a configuration interaction (CI) wave-function constructed from orbitals \\(\\varPhi \\), the electron density function, \\(\\unicode[Times]{x3C1}\\), is of the form: \\[\\unicode[Times]{x3C1} = \\sum_{i}\\sum _{j}a_{ij}\\,\\varPhi_{i}^{*}\\,\\varPhi_{j}\\] where the coefficients \\(a_{ij}\\) are a set of numbers which form the density matrix. The NOs reduce the density matrix \\(\\unicode[Times]{x3C1}\\) to a diagonal form: \\[\\unicode[Times]{x3C1} = \\sum _{k}b_{k}\\mathit{\\Phi}_{k}^{*}\\mathit{\\Phi}_{k}\\] where the coefficients \\(b_{k}\\) are occupation numbers of each orbital. The importance of natural orbitals is in the fact that CI expansions based on these orbitals have generally the fastest convergence. If a CI calculation was carried out in terms of an arbitrary basis set and the subsequent diagonalisation of the density matrix \\(\\rm{a}_{ij}\\) gave the natural orbitals, the same calculation repeated in terms of the natural orbitals thus obtained would lead to the wave-function for which only those configurations built up from natural orbitals with large occupation numbers were important." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural orbital" .

goldbook:NT07080 a skos:Concept ;
    skos:altLabel "NPA" ;
    skos:definition "The analysis of the electron density distribution in a molecular system based on the orthonormal natural atomic orbitals. Natural populations, \\(n_{i}\\left(\\rm{A}\\right)\\) are the occupancies of the natural atomic orbitals. These rigorously satisfy the Pauli exclusion principle: \\(0 < n_{i}\\left(\\rm{A}\\right) < 2\\). The population of an atom \\(n\\left(\\rm{A}\\right)\\) is the sum of natural populations \\(n\\left(\\rm{A}\\right)=\\sum _{\\begin{array}{c} \\rm{A} \\end{array}}n_{i}\\left(\\rm{A}\\right)\\). A distinguished feature of the NPA method is that it largely resolves the basis set dependence problem encountered in the Mulliken population analysis method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "natural population analysis" .

goldbook:NT07081 a skos:Concept ;
    skos:definition "The effect of donation of electron density from filled $\\ce{\\uppi\\!}$ or $\\ce{n_{\\uppi\\!}\\mbox{-}orbitals}$ to the symmetry adapted $\\ce{\\upsigma\\!^{\\ast}\\mbox{-}orbital(s)}$ of $\\ce{\\upsigma\\!^{\\ast}\\mbox{-}bond(s)}$ of a molecular entity resulting in building $\\ce{\\uppi\\!\\mbox{-}character}$ into bonds that nominally possess only $\\ce{\\upsigma\\!\\mbox{-}character}$. The consequences of the effect are, for example, in elongation of the $\\ce{C–F}$ bond in the $\\ce{\\upbeta\\!\\mbox{-}fluoroethyl}$ anion and stabilization of the anti-periplanar conformation of fluoromethylamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "negative hyper-conjugation" .

goldbook:NT07082 a skos:Concept ;
    skos:definition "A plane of a system in which the value of the orbital wave-function equals zero. This plane defines a region of zero electron density for the orbital." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nodal plane" .

goldbook:NT07083 a skos:Concept ;
    skos:altLabel "MO" ;
    skos:definition "A molecular orbital whose occupation by electrons does not contribute (or contributes insignificantly) to the binding energy of the molecule. Generally, a nonbonding MO represents the highest occupied molecular orbital of a molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonbonding molecular orbital" .

goldbook:NT07084 a skos:Concept ;
    skos:definition "The structure of molecules or molecular ions that escapes description in terms of conventional rules of valency and stereochemistry. Nonclassical structures are characteristic of carbonium ions with hypercoordinated (see hypercoordination) carbon atoms, e.g., methanium ion 1, pyramidal dication $\\ce{C6H6^{2+}}$ 2 (isomeric to benzene dication), and the molecular species whose structure cannot be adequately represented by the equilibrium (2-norbornyl cation, 3) or resonance of two or more classical structures. From the stereochemical point of view, those structures are assigned to the nonclassical type for which all tetracoordinate carbon bonds extend into a single hemisphere, i.e., the valence angle of a carbon atom is greater than $\\pu{180\\!^{\\circ}}$. A hypothetical example is pyramidane, 4, the structure of which corresponds to a local minimum on the $\\ce{C5H4}$ potential energy surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nonclassical structure" .

goldbook:NT07085 a skos:Concept ;
    skos:definition "Molecules that are fully conjugated, but each of whose Kekulé structures contains at least two atoms that are not $\\ce{\\uppi\\!\\mbox{-}bonded}$. Examples of non-Kekule hydrocarbons are trimethylenemethane (2-methylidenepropane-1,3-diyl) 1, m-benzodiquinomethane (benzene-1,2-diyldimethyl) 2, and 1,2,4,5 - tetramethylenebenzene (benzene-1,2,4,5-tetrayltetramethyl) 3." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-Kekulé molecules" .

goldbook:NT07086 a skos:Concept ;
    skos:definition "A mathematical procedure which ensures that the integral of the square of modulus of a wave-function over all space equals 1. The constant required to ensure that a wave-function is normalized is termed the normalization constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "normalization" .

goldbook:NT07178 a skos:Concept ;
    skos:definition "Polymer that exhibits an optical effect brought about by electromagnetic radiation such that the magnitude of the effect is not proportional to the irradiance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linear optical polymer" .

goldbook:NT07243 a skos:Concept ;
    skos:definition "Composite in which at least one of the phase domains has at least one dimension of the order of nanometres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanocomposite" .

goldbook:NT07272 a skos:Concept ;
    skos:definition "Initiation of phase domain formation through the presence of heterogeneities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleation of phase separation" .

goldbook:NT07304 a skos:Concept ;
    skos:definition "Morphology consisting of phase nanodomains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanodomain morphology" .

goldbook:NT07425 a skos:Concept ;
    skos:definition "Electronic states of the same symmetry cannot cross along a reaction coordinate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-crossing rule" .

goldbook:NT07426 a skos:Concept ;
    skos:altLabel "CARS" ;
    skos:definition "Collective name applied to techniques related to non-linear optical effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "non-linear optical techniques" .

goldbook:NT07427 a skos:Concept ;
    skos:definition "Photochemical process leading to the formation of cyclobutanols from excited carbonyl compounds by intramolecular $\\ce{\\upgamma\\!\\mbox{-}hydrogen}$ abstraction (Norrish Type II photoreaction) and subsequent 1,4-diradical combination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Norrish–Yang reaction" .

goldbook:NT07428 a skos:Concept ;
    skos:definition "Photosubstitution in aromatic compounds with the participation of nucleophiles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nucleophilic aromatic photosubstitution" .

goldbook:NT07521 a skos:Concept ;
    skos:altLabel "gel nanoparticle" ;
    skos:definition "Particle of gel of any shape with an equivalent diameter of approximately \\(1\\) to \\(100\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "nanogel" .

goldbook:NT07522 a skos:Concept ;
    skos:definition "Gel containing acidic or basic groups that have been neutralized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "neutralized gel" .

goldbook:NT07562 a skos:Concept ;
    skos:definition "Highly ramified structure in which essentially each constitutional unit is connected to each other constitutional unit and to the macroscopic phase boundary by many paths through the structure, the number of such paths increasing with the average number of intervening constitutional units; the paths must on average be co-extensive with the structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "network" .

goldbook:NT07603 a skos:Concept ;
    skos:altLabel "inter-junction molar mass" ;
    skos:definition "Number-average molar mass of polymer chains between two adjacent crosslinks or junction points in a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "network-chain molar mass" .

goldbook:NT07604 a skos:Concept ;
    skos:definition "Elastically ineffective chains in a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "network defect" .

goldbook:NT07626 a skos:Concept ;
    skos:definition "Production of an object in, or as close as possible to, its final shape prior to ceramization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "net shaping" .

goldbook:O04270 a skos:Concept ;
    skos:definition "The difference in height between the axis of the observed space (optical axis) and the burner tip (in \\(\\mathrm{mm}\\)). The optical axis of the instrument should be the same as the optical axis of the observation space. Other definitions which express the observation height as a fraction of the whole flame height are not recommended because the height to the tip of the flame is not well defined. The observation height should be stated in the method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "observation height" .

goldbook:O04271 a skos:Concept ;
    skos:definition "The intersection of the optical axis and the observation space (in \\(\\mathrm{mm}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "observation pathlength" .

goldbook:O04272 a skos:Concept ;
    skos:definition "The intersection of the optical beam and that part of the flame where the net signal is at least half of the maximum net signal. The characteristics of the observation space depend on the temperature of the flame, the stoichiometry of the gases and the properties of the processed fluid (presence of proteins for instance). The observation space in atomic absorption is analogous to the observation space of a cuvette in molecular absorption spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "observation space" .

goldbook:O04273 a skos:Concept ;
    skos:definition "The volume of that part of the flame that is observed through the optical device (in \\(\\unicode[Times]{x3BC}\\rm{l}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "observation volume" .

goldbook:O04276 a skos:Concept ;
    skos:definition "An affix used in names to denote six atoms bound into an octahedron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>octahedro</i>-" .

goldbook:O04277 a skos:Concept ;
    skos:definition "Synonymous with radical ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "odd-electron ion" .

goldbook:O04278 a skos:Concept ;
    skos:altLabel "ODMR" ;
    skos:definition "A double resonance technique in which transitions between spin sublevels are detected by optical means. Usually these are sublevels of a triplet and the transitions are induced by microwaves. For different types of optical detection the following expressions are used: ADMR (absorption), DEDMR (delayed emission, non-specified), DFDMR (delayed fluorescence), FDMR (fluorescence), PDMR (phosphorescence). If a reaction yield is followed the expression RYDMR (reaction yield detected magnetic resonance) is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optically detected magnetic resonance" .

goldbook:O04279 a skos:Concept ;
    skos:definition "The concentration of a compound which produces an odour which is detectable by a human being (nose). For certain compounds this threshold is very low (e.g. 1 part in \\(10^{9}\\) for certain sulfides)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "odour threshold" .

goldbook:O04280 a skos:Concept ;
    skos:definition "SI derived unit of electrical resistance, \\(\\Omega = \\pu{V A-1} = \\pu{m2 kg s-3 A-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ohm" .

goldbook:O04281 a skos:Concept ;
    skos:definition "Acyclic and cyclic hydrocarbons having one or more carbon–carbon double bonds, apart from the formal ones in aromatic compounds. The class olefins subsumes alkenes and cycloalkenes and the corresponding polyenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "olefins" .

goldbook:O04282 a skos:Concept ;
    skos:definition "A prefix meaning 'a few', and used for compounds with a number of repeating units intermediate between those in monomers and those in high polymers. The limits are not precisely defined, and in practice vary with the type of structure being considered, but are generally from 3 to 10, e.g. oligopeptides, oligosaccharides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligo" .

goldbook:O04283 a skos:Concept ;
    skos:definition "A substance composed of oligomer molecules. An oligomer obtained by telomerization is often termed a telomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligomer" .

goldbook:O04285 a skos:Concept ;
    skos:definition "The process of converting a monomer or a mixture of monomers into an oligomer. An oligomerization by chain reaction carried out in the presence of a large amount of chain transfer agent, so that the end-groups are essentially fragments of the chain transfer agent, is termed telomerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligomerization" .

goldbook:O04286 a skos:Concept ;
    skos:altLabel "oligomeric" ;
    skos:definition "A molecule of intermediate relative molecular mass, the structure of which essentially comprises a small plurality of units derived, actually or conceptually, from molecules of lower relative molecular mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oligomer molecule" .

goldbook:O04291 a skos:Concept ;
    skos:definition "Cations (with their counter-ions) derived by addition of a hydron to a mononuclear parent hydride of the nitrogen, chalcogen and halogen families.$\\ce{H4N^{+}}$ ammonium$\\ce{H3O^{+}}$ oxonium$\\ce{H2F^{+}}$ fluoronium$\\ce{H4P^{+}}$ phosphonium$\\ce{H3S^{+}}$ sulfonium$\\ce{H2Cl^{+}}$ chloronium$\\ce{H4As^{+}}$ arsonium$\\ce{H3Se^{+}}$ selenonium$\\ce{H2Br^{+}}$ bromonium$\\ce{H4Sb^{+}}$ stibonium$\\ce{H3Te^{+}}$ telluronium$\\ce{H2I^{+}}$ iodonium$\\ce{H4Bi^{+}}$ bismuthoniumDerivatives formed by substitution of the above parent ions by univalent groups. The number of substituted hydrogen atoms is, especially in the case of hydrocarbyl substituents, indicated by the adjectives primary, secondary, tertiary or quaternary. E.g. ($\\ce{Cl2F^{+}}$) dichlorofluoronium, $\\ce{(CH3)2S^{+}H}$ dimethylsulfonium (a secondary sulfonium ion), $\\ce{Cl(CH3)3P^{+}}$ chlorotrimethylphosphonium, $\\ce{(CH3CH2)4N^{+}}$ tetraethylammonium (a quaternary ammonium ion).See also: arsonium compounds, halonium ions, oxonium ions, phosphonium compounds, quaternary ammonium compounds, stibonium compounds, sulfonium compoundsDerivatives formed by substitution of the above parent ions by groups having two or three free valencies on the same atom. Such derivatives are, where possible, designated by a specific class name. E.g. $\\ce{RC#O^{+}}$ hydrocarbylidyne oxonium ions, $\\ce{R2C=N^{+}H2X^{−}}$ iminium compounds, $\\ce{RC#NH^{+}}$ nitrilium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "onium compounds" .

goldbook:O04294 a skos:Concept ;
    skos:definition "A film in which mass transfer can occur between the film and the coexisting bulk phases, for all the components. The term partly open film applies to a film in which mass transfer can occur only for certain components. The term closed film applies to those films with fixed mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open film" .

goldbook:O04295 a skos:Concept ;
    skos:definition "Reverberatory furnace, containing a basin-shaped hearth, for melting and refining suitable types of pig iron, iron ore, and scrap for steel production. A large amount of dust from ore and other materials and splashings from slag are carried away by the waste gases; a supplementary chamber is commonly used for collecting slag and dust." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open hearth furnace" .

goldbook:O04297 a skos:Concept ;
    skos:definition "A column, usually having a small diameter, in which either the inner tube wall, or a liquid or active solid held stationary on the tube wall acts as the stationary phase and there is an open, unrestricted path for the mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open-tubular column" .

goldbook:O04298 a skos:Concept ;
    skos:definition "An electrochemical cell which is the basis of practical pH measurement consisting of a hydrogen ion-responsive electrode (hydrogen gas, or glass) and a reference electrode immersed in the test solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "operational pH cell" .

goldbook:O04301 a skos:Concept ;
    skos:definition "A functional unit consisting of a promoter, an operator and a number of structural genes, found mainly in prokaryotes. The structural genes commonly code for several functionally related enzymes, and although they are transcribed as one (polycistronic) mRNA each is independently translated. In the typical operon, the operator region acts as a controlling element in switching on or off the synthesis of mRNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "operon" .

goldbook:O04302 a skos:Concept ;
    skos:definition "Composite reactions, occurring in forward and reverse directions:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "opposing reactions" .

goldbook:O04303 a skos:Concept ;
    skos:altLabel "optically active" ;
    skos:definition "A sample of material able to rotate the plane of polarization of a beam of transmitted plane-polarized light is said to possess optical activity (or to be optically active). This 'optical rotation' is the classical distinguishing characteristic (sufficient but not necessary) of systems containing unequal amounts of corresponding enantiomers. An enantiomer causing rotation in a clockwise direction (when viewed in the direction facing the oncoming light beam) under specified conditions is called 'dextrorotatory' and its chemical name or formula is designated by the prefix (+)-; one causing rotation in the opposite sense is 'laevorotatory' and designated by the prefix (−)-. Materials with optical activity also exhibit other chiroptic phenomena." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical activity" .

goldbook:O04305 a skos:Concept ;
    skos:definition "For wavelength-scanning spectrometers, an error may be introduced if the image position on the photodetector changes. Reflection of the incident radiation, e.g. between the cell walls, is another source of error and results in a measured absorbance slightly higher than the true absorbance. These errors are collectively termed optical-beam errors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical-beam error" .

goldbook:O04307 a skos:Concept ;
    skos:definition "A device which reduces the spectral range (bandpass, cut-off, and interference filter) or radiant power of incident radiation (neutral density or attenuance filter) upon transmission of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical filter" .

goldbook:O04309 a skos:Concept ;
    skos:definition "A term describing a system in which stereoisomerization results in a change of optical rotation with time. (Usage strongly discouraged)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optically labile" .

goldbook:O04310 a skos:Concept ;
    skos:definition "The ratio of the observed optical rotation of a sample consisting of a mixture of enantiomers to the optical rotation of one pure enantiomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical purity" .

goldbook:O04314 a skos:Concept ;
    skos:definition "The study of systems by the electromagnetic radiation with which they interact or that they produce. By convention, spectroscopic properties are expressed in terms of wavelength in vacuo, not the wavelength within the medium being studied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical spectroscopy" .

goldbook:O04315 a skos:Concept ;
    skos:definition "In a chemical reaction involving chiral reactants and products, the ratio of the optical purity of the product to that of the precursor, reactant or catalyst. This should not be confused with enantiomeric excess. The optical yield is in no way related to the chemical yield of the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical yield" .

goldbook:O04316 a skos:Concept ;
    skos:definition "Same as photoacoustic spectroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optoacoustic spectroscopy" .

goldbook:O04317 a skos:Concept ;
    skos:altLabel "atomic orbital",
        "molecular orbital" ;
    skos:definition "Wavefunction depending explicitly on the spatial coordinates of only one electron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orbital" .

goldbook:O04319 a skos:Concept ;
    skos:definition "A concept expressing that the stereochemistry of approach of two reacting species is governed by the most favourable overlap of their appropriate orbitals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orbital steering" .

goldbook:O04320 a skos:Concept ;
    skos:definition "The behaviour of an atomic or localized molecular orbital under molecular symmetry operations characterizes its orbital symmetry. For example, under a reflection in an appropriate symmetry plane, the phase of the orbital may be unchanged (symmetric), or it may change sign (antisymmetric), i.e. the positive and negative lobes are interchanged. A principal context for the use of orbital symmetry is the discussion of chemical changes that involve 'conservation of orbital symmetry'. If a certain symmetry element (e.g. the reflection plane) is retained along a reaction pathway, that pathway is 'allowed' by orbital symmetry conservation if each of the occupied orbitals of the reactant(s) is of the same symmetry type as a similarly (e.g. singly or doubly) occupied orbital of the product(s). This principle permits the qualitative construction of correlation diagrams to show how molecular orbitals transform (and how their energies change) during idealized chemical changes (e.g. cycloadditions). An idealized single bond is a $\\ce{\\upsigma\\!\\mbox{-}bond}$, i.e. it has cylindrical symmetry, whereas a p-orbital or $\\ce{\\uppi\\!\\mbox{-}}$bond orbital has $\\ce{\\uppi\\!\\mbox{-}symmetry}$, i.e. it is antisymmetric with respect to reflection in a plane passing through the atomic centres with which it is associated. In ethene, the $\\ce{\\uppi\\!\\mbox{-}bonding orbital}$ is symmetric with respect to reflection in a plane perpendicular to and bisecting the $\\ce{C–C}$ bond, whereas the $\\ce{\\uppi\\!^{\\ast}\\mbox{-}antibonding orbital}$ is antisymmetric with respect to this operation. Considerations of orbital symmetry are frequently grossly simplified in that, for example, the p-orbitals of a carbonyl group would be treated as having the same symmetry as those of ethene, and the fact that the carbonyl group in, for example, camphor, unlike that in formaldehyde, has no mirror planes would be ignored. These simplified considerations nevertheless afford the basis of one approach to the understanding of the rules which indicate whether pericyclic reactions are likely to occur under thermal or photochemical conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orbital symmetry" .

goldbook:O04321 a skos:Concept ;
    skos:definition "A transition in which the degree of order of the system changes. Three principal types of disordering transitions may be distinguished: (i) positional disordering in a solid, (ii) orientational disordering which may be static or dynamic and (iii) disordering associated with electronic and nuclear spin states. Examples:The transition of $\\ce{LiFeO2}$, with a tetragonal unit cell, in which the $\\ce{Li+}$ and $\\ce{Fe3+}$ cations are perfectly ordered on crystallographically non-equivalent octahedral sites to cubic $\\ce{LiFeO2}$ in which the $\\ce{Li+}$ and $\\ce{Fe3+}$ cations are distributed randomly over all the octahedral sites. The transition of orthorhombic $\\ce{KCN}$ to cubic $\\ce{KCN}$ in which the $\\ce{CN−}$ ions become oriented in any of the eight $[111]$ directions.A superconducting transition" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "order–disorder transition" .

goldbook:O04322 a skos:Concept ;
    skos:definition "If the macroscopic (observed, empirical or phenomenological) rate of reaction (v) for any reaction can be expressed by an empirical differential rate equation (or rate law) which contains a factor of the form \\(k\\ \\left[\\rm{A}\\right]^{\\alpha }\\ \\left[\\rm{B}\\right]^{\\beta }\\) ... (expressing in full the dependence of the rate of reaction on the concentrations \\(\\left[\\rm{A}\\right]\\), \\(\\left[\\rm{B}\\right]\\) ...) where \\(\\alpha \\), \\(\\beta \\) are constant exponents (independent of concentration and time) and \\(k\\) is independent of \\(\\left[\\rm{A}\\right]\\) and \\(\\left[\\rm{B}\\right]\\) etc. (rate constant, rate coefficient), then the reaction is said to be of order \\(\\alpha \\) with respect to A, of order \\(\\beta \\) with respect to B, ... , and of (total or overall) order \\(n=\\alpha +\\beta\\: +\\,...\\) The exponents \\(\\alpha \\), \\(\\beta \\), ... can be positive or negative integral or rational nonintegral numbers. They are the reaction orders with respect to A, B, ... and are sometimes called 'partial orders of reaction'. Orders of reaction deduced from the dependence of initial rates of reaction on concentration are called 'orders of reaction with respect to concentration'; orders of reaction deduced from the dependence of the rate of reaction on time of reaction are called 'orders of reaction with respect to time'. The concept of order of reaction is also applicable to chemical rate processes occurring in systems for which concentration changes (and hence the rate of reaction) are not themselves measurable, provided it is possible to measure a chemical flux. For example, if there is a dynamic equilibrium according to the equation: \\[a\\rm{A}\\rightleftharpoons p\\rm{P}\\] and if a chemical flux is experimentally found, (e.g. by NMR line-shape analysis) to be related to concentrations by the equation: \\[\\frac{\\varphi _{-\\rm{A}}}{\\alpha } = k\\ \\left[\\rm{A}\\right]^{\\alpha }\\ \\left[\\rm{L}\\right]^{\\lambda }\\] then the corresponding reaction is of order \\(\\alpha \\) with respect to A ... and of total (or overall) order \\(n(=\\alpha +\\lambda\\: +\\,...)\\). The proportionality factor \\(k\\) above is called the (\\(n\\)th order) 'rate coefficient'. Rate coefficients referring to (or believed to refer to) elementary reactions are called 'rate constants' or, more appropriately 'microscopic' (hypothetical, mechanistic) rate constants. The (overall) order of a reaction cannot be deduced from measurements of a 'rate of appearance' or 'rate of disappearance' at a single value of the concentration of a species whose concentration is constant (or effectively constant) during the course of the reaction. If the overall rate of reaction is, for example, given by: \\[v=k\\ \\left[\\rm{A}\\right]^{\\alpha }\\ \\left[\\rm{B}\\right]^{\\beta }\\] but [B] stays constant, then the order of the reaction (with respect to time), as observed from the concentration change of A with time, will be \\(\\alpha \\), and the rate of disappearance of A can be expressed in the form: \\[v_{\\rm{A}}=k_{\\rm{obs}}\\ \\left[\\rm{A}\\right]^{\\alpha }\\] The proportionality factor \\(k_{\\rm{obs}}\\) deduced from such an experiment is called the 'observed rate coefficient' and it is related to the \\((\\alpha + \\beta)\\)th order rate coefficient \\(k\\) by the equation: \\[k_{\\rm{obs}}=k\\ \\left[\\rm{B}\\right]^{\\beta }\\] For the common case when \\(\\alpha = 1\\), \\(k_{\\rm{obs}}\\) is often referred to as a 'pseudo-first order rate coefficient' (\\(k_{\\psi }\\)). For a simple (elementary) reactions a partial order of reaction is the same as the stoichiometric number of the reactant concerned and must therefore be a positive integer (see rate of reaction). The overall order is then the same as the molecularity. For stepwise reaction there is no general connection between stoichiometric numbers and partial orders. Such reactions may have more complex rate laws, so that an apparent order of reaction may vary with the concentrations of the chemical species involved and with the progress of the reaction: in such cases it is not useful to speak of orders of reaction, although apparent orders of reaction may be deducible from initial rates. In a stepwise reaction, orders of reaction may in principle always be assigned to the elementary steps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "order of reaction" .

goldbook:O04323 a skos:Concept ;
    skos:definition "A normalized parameter that indicates the degree of order of a system. An order parameter of 0 indicates disorder; the absolute value in the ordered state is 1." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "order parameter" .

goldbook:O04324 a skos:Concept ;
    skos:definition "Separated compartments within a cell with specialized functions, e.g. nuclei (containing most of the genetic material), mitochondria (respiratory energy supply for the cell), chloroplasts (location of photosynthesis) etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organelles" .

goldbook:O04325 a skos:Concept ;
    skos:definition "A liquid laser in which the active medium is an organic dye in a solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organic dye laser" .

goldbook:O04327 a skos:Concept ;
    skos:altLabel "organoelement groups" ;
    skos:definition "Univalent groups containing carbon, which are thus organic, but which have their free valence at an atom other than carbon. This collective term is seldom used; specific subclasses are more frequently encountered (organothio or organylthio, organogermanium or organylgermanium groups). The synonymous term organoelement groups is occasionally encountered. E.g. phenoxy, acetamido, pyridinio ($\\ce{C5H5N^{+}}$), thiocyanato ($\\ce{N#C–S−}$), trimethylsilyl; but not hydroxyphenyl, aminoacetyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organoheteryl groups" .

goldbook:O04328 a skos:Concept ;
    skos:definition "Classically compounds having bonds between one or more metal atoms and one or more carbon atoms of an organyl group. Organometallic compounds are classified by prefixing the metal with organo-, e.g. organopalladium compounds. In addition to the traditional metals and semimetals, elements such as boron, silicon, arsenic and selenium are considered to form organometallic compounds, e.g. organomagnesium compounds $\\ce{MeMgI}$ iodo(methyl)magnesium, $\\ce{Et2Mg}$ diethylmagnesium; an organolithium compound $\\ce{BuLi}$ butyllithium; an organozinc compound $\\ce{ClZnCH2C(=O)OEt}$ chloro(ethoxycarbonylmethyl)zinc; an organocuprate $\\ce{Li^{+}[CuMe2]^{−}}$ lithium dimethylcuprate; an organoborane $\\ce{Et3B}$ triethylborane. The status of compounds in which the canonical anion has a delocalized structure in which the negative charge is shared with an atom more electronegative than carbon, as in enolates, may vary with the nature of the anionic moiety, the metal ion, and possibly the medium; in the absence of direct structural evidence for a carbon–metal bond, such compounds are not considered to be organometallic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organometallic compounds" .

goldbook:O04329 a skos:Concept ;
    skos:definition "Any organic substituent group, regardless of functional type, having one free valence at a carbon atom, e.g. $\\ce{CH3CH2–}$, $\\ce{ClCH2–}$, $\\ce{CH3C(=O)–}$, 4-pyridylmethyl. Organyl is also used in conjunction with other terms, as in organylthio- (e.g. $\\ce{MeS-}$) and organyloxy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organyl groups" .

goldbook:O04330 a skos:Concept ;
    skos:altLabel "ori" ;
    skos:definition "A sequence of DNA at which replication is initiated on a chromosome, plasmid or virus." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "origin of replication" .

goldbook:O04331 a skos:Concept ;
    skos:definition "Hypothetical compounds having the structure $\\ce{RC(OH)3}$. Thus, hydrated forms of carboxylic acids. Orthocarbonic acid, $\\ce{C(OH)4}$, is generically included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ortho acids" .

goldbook:O04332 a skos:Concept ;
    skos:definition "Hypothetical compounds having the structure $\\ce{RC(NH2)3}$, and N-substituted derivatives thereof. $\\ce{(R2N)4C}$ are generically included, but such use is obsolescent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ortho amides" .

goldbook:O04334 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RC(OR')3}$ ($\\ce{R'}  eq \\ce{H}$), or the structure $\\ce{C(OR')4}$ ($\\ce{R'}  eq \\ce{H}$), e.g. $\\ce{HC(OCH3)3}$ trimethyl orthoformate, $\\ce{C(OCH3)4}$ tetramethyl orthocarbonate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ortho esters" .

goldbook:O04336 a skos:Concept ;
    skos:definition "The rate of aggregation is in general determined by the frequency of collisions and the probability of cohesion during collision. If the collisions are caused by hydrodynamic motions (e.g convection or sedimentation) this is then referred to as orthokinetic aggregation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "orthokinetic aggregation" .

goldbook:O04337 a skos:Concept ;
    skos:definition "1,2-Bis(arylhydrazones) of ketoaldoses (aldoketoses) formed from aldoses and 2-ketoses by reaction with excess arylhydrazine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osazones" .

goldbook:O04338 a skos:Concept ;
    skos:definition "A reaction is said to be oscillating if the concentration of one or more intermediates does not vary monotonically, but passes through maximum and minimum values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oscillating reaction" .

goldbook:O04340 a skos:Concept ;
    skos:definition "Quotient of the negative natural logarithm of the rational activity of water and the molar mass of water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmolality" .

goldbook:O04342 a skos:Concept ;
    skos:definition "Quantity characterizing the deviation of the solvent from ideal behaviour referenced to Raoult's law. The osmotic coefficient on a molality basis is defined by: \\[\\phi =\\frac{\\mu _{\\rm{A}}^{*}- \\mu _{\\rm{A}}}{R\\ T\\ M_{\\rm{A}}\\ \\sum _{\\begin{array}{c} i \\end{array}}m_{i}}\\] and on an amount fraction basis by: \\[\\phi =\\frac{\\mu _{\\rm{A}}^{*}- \\mu _{\\rm{A}}}{R\\ T\\ \\ln x_{\\rm{A}}}\\] where \\(\\mu _{\\rm{A}}^{*}\\) and \\(\\mu _{\\rm{A}}\\) are the chemical potentials of the solvent as a pure substance and in solution, respectively, \\(M_{\\rm{A}}\\) is its molar mass, \\(x_{\\rm{A}}\\) its amount fraction, \\(R\\) the gas constant and \\(T\\) the temperaure. The latter osmotic coefficient is sometimes called the rational osmotic coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmotic coefficient" .

goldbook:O04343 a skos:Concept ;
    skos:altLabel "osmolarity" ;
    skos:definition "Product of the osmolality and the mass density of water. Formerly called osmolarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmotic concentration" .

goldbook:O04344 a skos:Concept ;
    skos:definition "Excess pressure required to maintain osmotic equilibrium between a solution and the pure solvent separated by a membrane permeable only to the solvent: \\[\\mathit{\\Pi} = -\\frac{R\\ T}{V_{\\rm{A}}}\\ \\ln a_{\\rm{A}}\\] where \\(V_{\\mathrm{A}}\\), \\(a_{\\mathrm{A}}\\) are the partial molar volume and activity of solvent \\(\\rm{A}\\) for an incompressible fluid. For ideal dilute solutions, \\(\\mathit{\\Pi} = c_{\\rm{B}}\\ R\\ T=\\rho _{\\rm{B}}\\ \\frac{R\\ T}{M_{\\rm{B}}}\\), where entities \\(\\rm{B}\\) are individually moving solute molecules, ions, etc., regardless of their nature, \\(c_{\\rm{B}}\\), \\(\\rho _{\\mathrm{B}}\\) are the amount and mass concentration of the solutes, and \\(M_{\\mathrm{B}}\\) is the mass average molar mass of the solutes. The amount is sometimes expressed in osmol (meaning a mole of osmotically active entities), but this usage and the corresponding term osmolarity are discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osmotic pressure" .

goldbook:O04346 a skos:Concept ;
    skos:definition "An obsolescent and non-recommended term for 1,2-ketoaldoses, usually derived by hydrolysis of osazones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osones" .

goldbook:O04347 a skos:Concept ;
    skos:definition "The 1,2,3-triazoles formed on oxidizing osazones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "osotriazoles" .

goldbook:O04348 a skos:Concept ;
    skos:definition "Dissolution of small crystals or sol particles and the redeposition of the dissolved species on the surfaces of larger crystals or sol particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ostwald ripening" .

goldbook:O04350 a skos:Concept ;
    skos:altLabel "OHP" ;
    skos:definition "At an electrified interface, the locus of the electrical centres of non-specifically adsorbed ions in their position of closest approach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "outer Helmholtz plane" .

goldbook:O04351 a skos:Concept ;
    skos:definition "An outer-sphere electron transfer is a reaction in which the electron transfer takes place with no or very weak (\\(\\pu{4\\!{-}\\! 16 kJ mol-1}\\)) electronic interaction between the reactants in the transition state. If instead the donor and the acceptor exhibit a strong electronic coupling, the reaction is described as inner-sphere electron transfer. The two terms derive from studies concerning metal complexes and it has been suggested that for organic reactions the terms 'nonbonded' and 'bonded' electron transfer should be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "outer-sphere electron transfer" .

goldbook:O04352 a skos:Concept ;
    skos:definition "A form of pretreatment in which a catalyst is heated in vacuo to remove adsorbed or dissolved gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "outgassing" .

goldbook:O04354 a skos:Concept ;
    skos:definition "Given by \\[\\Delta \\theta _{i- jkl}=\\frac{\\Delta z_{j}}{r_{eij}}\\ \\sin   \\mathit{\\Phi }_{kil}\\] where the numbering of the atoms is given in the diagram. \\(\\mathit{\\Phi} _{kil}\\) denotes  the angle between the bonds \\(ik\\) and \\(il\\), \\(\\Delta z_{j}\\) the perpendicular distance of the atom \\(j\\) from the instantaneous plane \\(ikl\\) and \\(r_{eij}\\) the equilibrium length of the bond \\(ij\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "out-of-plane bending coordinate" .

goldbook:O04355 a skos:Concept ;
    skos:definition "The number of results that is produced by an instrument divided by time of operation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "output rate" .

goldbook:O04359 a skos:Concept ;
    skos:definition "A photochemical reaction of a $\\ce{\\upbeta\\!,\\upgamma\\!\\mbox{-}unsaturated ketone}$ to form a saturated $\\ce{\\upalpha\\!\\mbox{-}cyclopropyl ketone}$. The rearrangement formally amounts to a 1,2-acyl shift and 'bond formation' between the former $\\ce{\\upalpha\\!}$ and $\\ce{\\upgamma\\!\\mbox{-}carbon atoms}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxa-di-π-methane rearrangement" .

goldbook:O04361 a skos:Concept ;
    skos:definition "A very qualitative term which includes any and all trace gases which have a greater oxidation potential than oxygen (for example, ozone, peroxyacetyl nitrate, hydrogen peroxide, organic peroxides, $\\ce{NO3}$, etc.). It is recommended that alternative, more definitive terms be used which define the specific oxidant of interest whenever possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidant" .

goldbook:O04362 a skos:Concept ;
    skos:definition "The complete, net removal of one or more electrons from a molecular entity (also called 'de-electronation').An increase in the oxidation number of any atom within any substrate.Gain of oxygen and/or loss of hydrogen of an organic substrate.All oxidations meet criteria 1 and 2, and many meet criterion 3, but this is not always easy to demonstrate. Alternatively, an oxidation can be described as a transformation of an organic substrate that can be rationally dissected into steps or primitive changes. The latter consist in removal of one or several electrons from the substrate followed or preceded by gain or loss of water and/or hydrons or hydroxide ions, or by nucleophilic substitution by water or its reverse and/or by an intramolecular molecular rearrangement. This formal definition allows the original idea of oxidation (combination with oxygen), together with its extension to removal of hydrogen, as well as processes closely akin to this type of transformation transformation (and generally regarded in current usage of the term in organic chemistry to be oxidations and to be effected by 'oxidizing agents') to be descriptively related to definition 1. For example the oxidation of methane to chloromethane may be considered as follows:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidation" .

goldbook:O04363 a skos:Concept ;
    skos:altLabel "Stock number" ;
    skos:definition "In English is largely synonymous with oxidation state, and may be preferred when the value represents a mere parameter or number rather than being related to chemical systematics or a state of the atom in a compound. Etymologically, it stems from the no-longer-used term 'Stock number' (oxidation number of a central atom; the charge it would bear if all the ligands were removed along with the electron pairs that were shared with the central atom) and the likewise obsolete term Ewens–Bassett number (ion charge)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidation number" .

goldbook:O04365 a skos:Concept ;
    skos:definition "Gives the degree of oxidation of an atom in terms of counting electrons. The higher the oxidation state (OS) of a given atom, the greater is its degree of oxidation. Definition: OS of an atom is the charge of this atom after ionic approximation of its heteronuclear bonds. The underlying principle is that the ionic sign in an AB molecule is deduced from the electron allegiance in a LCAO-MO model: The bond&#x2019;s electrons are assigned to its main atomic contributor. Homonuclear AA bonds are divided equally. In practical use, the ionic-approximation sign follows Allen electronegativities (see Source). There are two general algorithms to calculate OS:   Algorithm of assigning bonds, which works on a Lewis formula showing all valence electrons in a molecule: OS equals the charge of an atom after its heteronuclear bonds have been assigned to the more electronegative partner (except when that partner is a reversibly bonded Lewis-acid ligand) and homonuclear bonds have been divided equally:    Algorithm of summing bond orders: Heteronuclear-bond orders are summed at the atom as positive if that atom is the electropositive partner in a particular bond and as negative if not, and the atom&#x2019;s formal charge (if any) is added to that sum, yielding the OS. This algorithm works on Lewis formulas and on bond graphs of atom connectivities for an extended solid:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidation state" .

goldbook:O04367 a skos:Concept ;
    skos:definition "The insertion of a metal complex into a covalent bond involving formally an overall two-electron loss on one metal or a one-electron loss on each of two metals, i.e. \\[\\rm{L}_{n}\\rm{M}^{m}+\\rm{XY}\\rightarrow \\rm{L}_{n}\\rm{M}^{m+2}\\left(\\rm{X}\\right)\\left(\\rm{Y}\\right)\\] or \\[2\\rm{L}_{n}\\rm{M}^{m}+\\rm{XY}\\rightarrow \\rm{L}_{n}\\rm{M}^{m+1}\\left(\\rm{X}\\right)+\\rm{L}_{n}\\rm{M}^{m+1}\\left(\\rm{Y}\\right)\\] In radical chemistry, the term is used to indicate a radical addition to a carbon–carbon double bond, under oxidative conditions. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidative addition" .

goldbook:O04368 a skos:Concept ;
    skos:definition "The coupling of two molecular entities through an oxidative process, usually catalysed by a transition metal compound and involving dioxygen as the oxidant; e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidative coupling" .

goldbook:O04369 a skos:Concept ;
    skos:definition "A term used to characterize the degree of oxidation (or reduction) in atoms, molecules and ions. It can be applied to an atom in a molecule or an ion which has a high oxidation state. An element or atom in a compound can be oxidized by reaction with oxygen, while it can be reduced by reaction with hydrogen. An oxidized species may be formed also through the loss of electrons (either to the positive electrode in a cell, or through transfer to another atom or group of atoms). For example, the sulfur in $\\ce{H2S}$ is reduced sulfur relative to elementary sulfur, while $\\ce{SO2}$ and $\\ce{SO3}$ are oxidized. Metallic iron ($\\ce{Fe}$) is a reduced state of iron, while the $\\ce{Fe2+}$ ion (ferrous ion) and $\\ce{Fe^{3+}}$ ion (ferric ion) are oxidized states of iron. $\\ce{Fe^{3+}}$ is in a higher oxidation state than $\\ce{Fe^{2+}}$ which is in a higher oxidation state than $\\ce{Fe}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidized species" .

goldbook:O04370 a skos:Concept ;
    skos:definition "Enzymes that catalyse electron transfer in oxidation-reduction reactions. Oxidoreductases are classified into several groups according to their respective donors or acceptors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxidoreductases" .

goldbook:O04371 a skos:Concept ;
    skos:definition "O-Hydrocarbyl oximes $\\ce{R2C=NOR'}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxime <i>O</i>-ethers" .

goldbook:O04372 a skos:Concept ;
    skos:altLabel "isonitroso compounds" ;
    skos:definition "Compounds of structure $\\ce{R2C=NOH}$ derived from condensation of aldehydes or ketones with hydroxylamine. Oximes from aldehydes may be called aldoximes; those from ketones may be called ketoximes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oximes" .

goldbook:O04374 a skos:Concept ;
    skos:altLabel "oxyacid (oxy-acid)" ;
    skos:definition "Oxoacids (and its variants oxyacids, oxo acids, oxy-acids, oxiacids, oxacids) is a traditional name for any acid having oxygen in the acidic group. The term stands in contradistinction to `hydracids' (e.g. $\\ce{HCl}$) lacking oxygen. The term oxoacid now refers to a compound which contains oxygen, at least one other element, and at least one hydrogen bound to oxygen, and which produces a conjugate base by loss of positive hydrogen ion(s) (hydrons). E.g. $\\ce{P(OH)3}$, $\\ce{RC(=O)OH}$, $\\ce{HOSOH}$, $\\ce{HOCl}$, $\\ce{HON=O}$, $\\ce{(HO)2SO2}$, $\\ce{RP(=O)(OH)2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxoacids" .

goldbook:O04375 a skos:Concept ;
    skos:definition "Compounds consisting wholly of carbon and oxygen, e.g. $\\ce{CO}$, $\\ce{O=C=O}$, $\\ce{O=C=C=C=O}$," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxocarbons" .

goldbook:O04376 a skos:Concept ;
    skos:altLabel "oxo acids" ;
    skos:definition "Compounds having a carboxy group as well as an aldehydic or ketonic group in the same molecule, e.g. $\\ce{HC(=O)CH2CH2CH2C(=O)OH}$ 5-oxopentanoic acid. In an organic context the term is generally shortened to oxo acids. The full name should be used if confusion with oxoacids seems possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxo carboxylic acids" .

goldbook:O04377 a skos:Concept ;
    skos:definition "Compounds containing an oxygen atom, $\\ce{=O}$, doubly bonded to carbon or another element. The term thus embraces aldehydes, carboxylic acids, ketones, sulfonic acids, amides and esters. Oxo used as an adjective (and thus separated by a space) modifying another class of compound, as in oxo carboxylic acids, indicates the presence of an oxo substituent at any position. To indicate a double-bonded oxygen that is part of a ketonic structure, the term keto is sometimes used as a prefix, but such use has been abandoned by IUPAC for naming specific compounds. A traditional use of keto is for indicating oxidation of $\\ce{CHOH}$ to $\\ce{C=O}$ in a parent compound that contains $\\ce{OH}$ groups, such as carbohydrates, e.g. 3-ketoglucose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxo compounds" .

goldbook:O04378 a skos:Concept ;
    skos:definition "The parent ion $\\ce{H3O^{+}}$ and substitution derivatives thereof." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxonium ions" .

goldbook:O04379 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2O^{+}-C^{-}R2}$.See: ylidesA class of 1,3-dipolar compounds of general structure $\\ce{R2C=O^{+}-Y^{-}}$, comprising carbonyl imides, carbonyl oxides and carbonyl ylides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxonium ylides" .

goldbook:O04381 a skos:Concept ;
    skos:definition "In order to determine elements which are easily volatilized, or are present as volatile species, organic material may be ashed in oxygen in a closed oxygen combustion system. One such method is oxygen-flask combustion by which the test sample is burned in a closed flask containing oxygen and an absorbing solution in which the analytes are subsequently determined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxygen-flask combustion" .

goldbook:O04382 a skos:Concept ;
    skos:definition "Species of the form $\\ce{RO^{+}}$, e.g. $\\ce{CH3O^{+}}$ methoxylium, $\\ce{HO^{+}}$ hydroxylium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxylium ions" .

goldbook:O04383 a skos:Concept ;
    skos:definition "A region of the stratosphere over Antarctica in which a marked decrease in the concentration of ozone has been observed in the Antarctic spring in recent years. The origin of this phenomenon is not yet established, but several theories based on both physical (transport related) and chemical processes (involvement of the halocarbons and their products of oxidation) have been suggested. The latter explanation appears to be in better accord with recent findings." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ozone hole" .

goldbook:O04384 a skos:Concept ;
    skos:definition "The 1,2,4-trioxolanes formed by the reaction of ozone at a carbon–carbon double bond, or the analogous compounds derived from acetylenic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ozonides" .

goldbook:OT07087 a skos:Concept ;
    skos:definition "Atomic or molecular systems in which the electrons are not completely assigned to orbitals in pairs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "open-shell systems" .

goldbook:OT07179 a skos:Concept ;
    skos:definition "Polymer capable of rotating the polarization plane of a transmitted beam of linear-polarized light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optically active polymer" .

goldbook:OT07305 a skos:Concept ;
    skos:definition "Multiphase morphology of roughly spherical shape that comprises alternating layers of different polymers arranged concentrically, all layers being of similar thickness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "onion morphology" .

goldbook:OT07306 a skos:Concept ;
    skos:definition "Co-continuous morphology in which a set of two gyroid-based phase domains exhibits a highly regular, three-dimensional lattice-like morphology with Ia3d space group symmetry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ordered co-continuous double gyroid morphology" .

goldbook:OT07430 a skos:Concept ;
    skos:altLabel "OLED" ;
    skos:definition "Acronym for organic light-emitting device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "OLED" .

goldbook:OT07432 a skos:Concept ;
    skos:altLabel "OBF" ;
    skos:definition "Photoisomerization of one double bond in a conjugated double bond system. It is a regular E/Z photoisomerization.  Compare with bicycle-pedal mechanism, hula-twist mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "one-bond-flip" .

goldbook:OT07433 a skos:Concept ;
    skos:definition "Photochromic process involving a one-photon mechanism. In this case, the photoproduct B is formed from the singlet or from the triplet state of the thermodynamically-stable molecular entity A." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "one-photon photochromism" .

goldbook:OT07436 a skos:Concept ;
    skos:altLabel "OMA" ;
    skos:definition "Detection system for fast acquisition of spectra. It consists of a 'polychromator' fitted with a detector that enables spatial resolution, e.g., a 'vidicon tube', a 'charge-coupled device' or a 'silicon photodiode array'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical multi-channel analyser" .

goldbook:OT07437 a skos:Concept ;
    skos:altLabel "OPA" ;
    skos:definition "Process of signal amplification by a parametric process and a pump wave." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical parametric amplification" .

goldbook:OT07438 a skos:Concept ;
    skos:altLabel "OPO" ;
    skos:definition "Light source similar to a laser, but based on 'non-linear optical gain' from parametric amplification rather than on stimulated emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "optical parametric oscillator" .

goldbook:OT07569 a skos:Concept ;
    skos:definition "Network comprising only metal–oxygen linkages." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "oxide network" .

goldbook:OT07577 a skos:Concept ;
    skos:altLabel "OIP" ;
    skos:definition "Polymer or polymer network with a skeletal structure comprised only of carbon but which has side-groups that include inorganic components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organic–inorganic polymer" .

goldbook:OT07578 a skos:Concept ;
    skos:altLabel "organomodified ceramic" ;
    skos:definition "Chemically bonded hybrid material which is a crosslinked inorganic–organic polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organically-modified ceramic" .

goldbook:OT07579 a skos:Concept ;
    skos:altLabel "organically modified silicate" ;
    skos:definition "Silica modified by organic groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "organically modified silica" .

goldbook:P04385 a skos:Concept ;
    skos:definition "An excited state related to the ground state by a π → π* transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π – π* state" .

goldbook:P04386 a skos:Concept ;
    skos:definition "An electronic transition described approximately as a promotion of an electron from a 'bonding' $\\ce{\\uppi\\! orbital}$ to an 'antibonding' $\\ce{\\uppi\\! orbital}$ designated as $\\ce{\\uppi\\!^{\\ast}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π → π* transition" .

goldbook:P04393 a skos:Concept ;
    skos:definition "A tube containing a solid packing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "packed column" .

goldbook:P04394 a skos:Concept ;
    skos:definition "The active solid, stationary liquid plus solid support, or swollen gel put in the column. The term packing refers to the conditions existing before the chromatographic run is started (i.e. to the material introduced into the column), whereas the stationary phase refers to the conditions during the run." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "packing" .

goldbook:P04395 a skos:Concept ;
    skos:definition "Tricyclic saturated hydrocarbons having two bridgehead carbon atoms joined through four bridges, systematically named tricyclo [\\(m.n.o.p^{\\rm{1,}(m+2)}\\)] alkanes, have been referred to as [\\(m.n.o.p\\)] paddlanes (when \\(p=0\\), the compounds are propellanes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paddlanes" .

goldbook:P04396 a skos:Concept ;
    skos:definition "The attenuation coefficient when only the pair production process is taken into account." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pair attenuation coefficient" .

goldbook:P04397 a skos:Concept ;
    skos:definition "A quantity which approximates to the characteristic length associated with certain number density profiles of diffuse layers. \\(\\xi \\) is defined as the separation between two interacting entities (molecules, macromolecular segments, ions, spins), either in bulk or interfacial regions, beyond which an appropriate function, referred to as pair correlation function, either decays (e.g. to \\(\\frac{1}{e}\\) of an 'initial' value) or vanishes. A characteristic length must be confused neither with the effective thickness of the interfacial layer, nor with the range (effective distance) of the intermolecular (pair) potential. This range is defined by the distance over which this potential and the corresponding correlation function both vanish." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pair correlation length" .

goldbook:P04398 a skos:Concept ;
    skos:definition "The simultaneous formation of an electron and a positron as a result of the interaction of a photon of sufficient energy (&gt; \\(1.02\\ \\rm{MeV}\\)) with the field of a particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pair production" .

goldbook:P04399 a skos:Concept ;
    skos:definition "Synonymous with suspension effect  in an ion-selective electrode" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pallmann effect" .

goldbook:P04400 a skos:Concept ;
    skos:altLabel "PAN" ;
    skos:definition "Carbon fibres obtained from polyacrylonitrile (PAN) precursor fibres by stabilization treatment, carbonization and final heat treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "PAN-based carbon fibres" .

goldbook:P04401 a skos:Concept ;
    skos:definition "Obsolescent term for saturated hydrocarbons, commonly but not necessarily acyclic. Still widely used in the petrochemical industry, where the term designates acyclic saturated hydrocarbons, and stands in contradistinction to naphthenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paraffin" .

goldbook:P04404 a skos:Concept ;
    skos:definition "Substances having a magnetic susceptibility greater than 0 are paramagnetic. They are drawn into a magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paramagnetic" .

goldbook:P04405 a skos:Concept ;
    skos:definition "An unbranched acyclic or cyclic structure or an acyclic/cyclic structure having a semisystematic or trivial name to which only hydrogen atoms are attached." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parent hydride" .

goldbook:P04406 a skos:Concept ;
    skos:definition "An electrically charged molecular moiety which may dissociate to form fragments, one or more of which may be electrically charged, and one or more neutral species. A parent ion may be a molecular ion or an electrically charged fragment of a molecular ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parent ion" .

goldbook:P04407 a skos:Concept ;
    skos:definition "When a single electrochemical reaction occurs at an electrode (i.e. all other electrochemical reactions may be neglected): \\[I=I_{\\rm{a}}+I_{\\rm{c}}\\] where \\(I\\) is the total current, \\(I_{\\rm{a}}\\) is the positive partial anodic current and \\(I_{\\rm{c}}\\) is the negative partial cathodic current. When more than one reaction is significant the reactions may be numbered and the numbers used as subscripts: \\(I_{\\rm{1,a}}\\), \\(I_{\\rm{1,c}}\\), \\(I_{\\rm{2,a}}\\), etc. Then: \\[I=\\sum I_{i,\\rm{a}}+\\sum I_{i,\\rm{c}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial anodic current" .

goldbook:P04408 a skos:Concept ;
    skos:definition "Synonymous with partial charge transfer reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial charge exchange reaction" .

goldbook:P04409 a skos:Concept ;
    skos:definition "An ion/neutral species reaction wherein the charge on a multiply-charged reactant ion is reduced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial charge transfer reaction" .

goldbook:P04410 a skos:Concept ;
    skos:definition "For a radionuclide: the probability in unit time for the decay of one of its nuclei by one of several modes of decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial decay constant" .

goldbook:P04411 a skos:Concept ;
    skos:definition "In partial digestion and/or selective digestion procedures only part or some of the analytes present are brought into solution. This may be preferred to total decomposition if relative concentrations of the analyte in the test samples provide sufficient information (e.g. materials for geochemical exploration)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial digestion" .

goldbook:P04412 a skos:Concept ;
    skos:altLabel "individual isotherm" ;
    skos:definition "The function relating, at constant temperature and pressure, the amount of a particular component in the interfacial layer per unit area (or per unit mass of adsorbent) with its mole fraction (or concentration) in the liquid phase. This function can be evaluated only when the location and the thickness of the interfacial layer have been defined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial isotherm" .

goldbook:P04413 a skos:Concept ;
    skos:definition "The current which would flow if mass transport were infinitely fast." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial kinetic current" .

goldbook:P04415 a skos:Concept ;
    skos:definition "Change in mass due to addition of a small amount of component to a system divided by the change in volume of the system. The systematic name is partial volumic mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial mass density" .

goldbook:P04421 a skos:Concept ;
    skos:definition "The rate of substitution at one specific site in an aromatic compound relative to the rate of substitution at one position in benzene. For example, the partial rate factor \\(f_{p}^{\\rm{Z}}\\) for para-substitution in a monosubstituted benzene $\\ce{C6H5Z}$ is related to the rate constants \\(k\\left(\\rm{C}_{6}\\rm{H}_{5}\\rm{Z}\\right)\\) and \\(k\\left(\\rm{C}_{6}\\rm{H}_{6}\\right)\\) for the total reaction (i.e. at all positions) of $\\ce{C6H5Z}$ and benzene, respectively, and % para (the percentage para-substitution in the total product formed from $\\ce{C6H5Z}$) by the relation: \\[f_{p}^{\\rm{Z}} = \\frac{6\\ k\\left(\\rm{C}_{6}\\rm{H}_{5}\\rm{Z}\\right)}{k\\left(\\rm{C}_{6}\\rm{H}_{6}\\right)}\\ \\frac{\\%\\ \\rm{para}}{100}\\] Similarly for meta-substitution: \\[f_{m}^{\\rm{Z}} = \\frac{6\\ k\\left(\\rm{C}_{6}\\rm{H}_{5}\\rm{Z}\\right)}{2\\ k\\left(\\rm{C}_{6}\\rm{H}_{6}\\right)}\\ \\frac{\\%\\ \\rm{meta}}{100}\\] (The symbols \\(p_{f}^{\\rm{Z}}\\), \\(m_{f}^{\\rm{Z}}\\), \\(o_{f}^{\\rm{Z}}\\) are also in use.) The term applies equally to the ipso position, and it can be extended to other substituted substrates undergoing parallel reactions at different sites with the same reagent according to the same rate law." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial rate factor" .

goldbook:P04422 a skos:Concept ;
    skos:definition "Change in volume of a system when a small amount of component is added divided by the mass of the added component. The systematic name is partial massic volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial specific volume" .

goldbook:P04423 a skos:Concept ;
    skos:definition "Commonly expressed in several ways: mass concentration (usually as \\(\\unicode[times]{x3BC}\\rm{g}\\ \\rm{m}^{-3}\\)) or number concentration (number of particles \\(\\pu{cm-3}\\)); modern instrumentation allows measurement of the number of particles as a function of size as well as the total number present in a given air volume. For atmospheric aerosols, this is a complex distribution for which diameters range from below \\(0.01\\) to above \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\); the particles making the highest contribution to the total number density are in the size range below \\(0.1\\ \\unicode[times]{x3BC}\\rm{m}\\), those contributing most to the total surface area are in the \\(0.1\\) to \\(1.0\\ \\unicode[times]{x3BC}\\rm{m}\\) range, while those with the highest contribution to the volume or mass of the aerosol come from both the \\(0.1\\) to \\(1.0\\ \\unicode[times]{x3BC}\\rm{m}\\) and \\(1.0\\) to \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\) ranges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle concentration" .

goldbook:P04424 a skos:Concept ;
    skos:definition "The number of particles (nuclear or elementary) divided by the containing volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle density" .

goldbook:P04426 a skos:Concept ;
    skos:definition "A kind of analysis based on the measurement of the energies and intensities of characteristic X-radiation emitted by a test portion during irradiation with charged particles other than electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle induced X-ray emission analysis" .

goldbook:P04430 a skos:Concept ;
    skos:definition "To describe the size of liquid or solid particles (aerosol) the average or equivalent diameter is used. For non-spherical particles collected in an impactor, for example, the aerodynamic diameter of a particle of arbitrary shape and density refers to the size of a spherical particle of unit density that would deposit on a given impactor surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle size" .

goldbook:P04431 a skos:Concept ;
    skos:definition "The size of the liquid or solid particles in the atmosphere usually extends from \\(>0.01\\) to \\(< 100\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter. In the earth's atmosphere the distribution function which describes the number of particles as a function of diameter, mass or surface area of the aerosol can be determined reasonably well with modern instrumentation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particle size distribution" .

goldbook:P04432 a skos:Concept ;
    skos:definition "A property of a given object (phenomenon, body or substance). 'Particular property' includes the concept of particular quantity. The adjective 'particular' may be omitted, if no ambiguity is caused." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particular property" .

goldbook:P04433 a skos:Concept ;
    skos:definition "A carbon material consisting of separated monolithic particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particulate carbon" .

goldbook:P04434 a skos:Concept ;
    skos:definition "A general term used to describe airborne solid or liquid particles of all sizes. The term aerosol is recommended for general use in describing airborne particulate matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particulate matter" .

goldbook:P04435 a skos:Concept ;
    skos:definition "This term is often used as a synonym for distribution and extraction. However, an essential difference exists by definition between distribution constant or partition ratio and partition constant. The term partition should be, but is not invariably, applied to the distribution of a single definite chemical species between the two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partition" .

goldbook:P04436 a skos:Concept ;
    skos:definition "Chromatography in which separation is based mainly on differences between the solubility of the sample components in the stationary phase ( gas chromatography), or on differences between the solubilities of the components in the mobile and stationary phases (liquid chromatography)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partition chromatography" .

goldbook:P04437 a skos:Concept ;
    skos:definition "This term is not recommended and should not be used as a synonym for partition constant, partition ratio or distribution ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partition coefficient" .

goldbook:P04438 a skos:Concept ;
    skos:definition "The ratio of activity of a given species A in the extract to its activity in the other phase with which it is in equilibrium, thus: \\[\\left(K_{\\rm{D}}^{\\rm{o}}\\right)_{\\rm{A}} = \\frac{a_{\\rm{A,org}}}{a_{\\rm{A,aq}}}\\] Its value should not vary with composition but depends on the choice of standard states and on the temperature (and eventually the pressure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partition constant" .

goldbook:P04440 a skos:Concept ;
    skos:altLabel "distribution constant" ;
    skos:definition "The ratio of the concentration of a substance in a single definite form, A, in the extract to its concentration in the same form in the other phase at equilibrium, e.g. for an aqueous/organic system: \\[\\left (K_{\\rm{D}} \\right )_{A} = \\frac{\\left [ A \\right ]_{\\rm{org}}}{\\left [ A \\right ]_{\\rm{aq}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partition ratio" .

goldbook:P04442 a skos:Concept ;
    skos:definition "SI derived unit of pressure, \\(\\pu{Pa} = \\pu{N m-2} = \\pu{kg m-1 s-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pascal" .

goldbook:P04443 a skos:Concept ;
    skos:definition "The process of transition from the active to the passive state by formation of the passivating film. Passivation is achieved by an anodic current which at the respective electrode potential must be larger than the maximum current, or by the presence of an oxidized substance in the neighbouring solution which passivates by being reduced (passivator)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passivation" .

goldbook:P04444 a skos:Concept ;
    skos:definition "The most negative electrode potential at which the passivating film is formed. The passivation potential is equal to or more positive than the equilibrium potential of formation of the phase constituting the film. Usually, the corrosion current goes through a maximum at the passivation potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passivation potential" .

goldbook:P04445 a skos:Concept ;
    skos:definition "A metal corroding in the passive state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive metal" .

goldbook:P04446 a skos:Concept ;
    skos:definition "A device for preconcentration of trace substances from gaseous media based on molecular diffusion without controlled conveyance of the gas to be investigated (e.g. work place air)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive sampler" .

goldbook:P04447 a skos:Concept ;
    skos:definition "The passive state is characterized by a contiguous 'passivating film' of solid corrosion products separating the metallic phase from the adjacent electrolyte. Corrosion in the passive state involves growth of the passivating film and/or transfer of metal ions through the film into the electrolyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "passive state" .

goldbook:P04448 a skos:Concept ;
    skos:definition "The photocycloaddition of an electronically excited carbonyl group to a ground state olefin yielding an oxetane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Paterno–Büchi reaction" .

goldbook:P04449 a skos:Concept ;
    skos:definition "A colloidal system in which only a few particle-sizes occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "paucidisperse system" .

goldbook:P04451 a skos:Concept ;
    skos:definition "The portion of a differential chromatogram recording the detector response when a single component is eluted from the column. If separation is incomplete, two or more components may be eluted as one 'unresolved peak'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak" .

goldbook:P04452 a skos:Concept ;
    skos:definition "The extraction of relevant peak parameters (i.e. position, area) from a measured spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak analysis" .

goldbook:P04454 a skos:Concept ;
    skos:definition "A kind of peak analysis in which a peak area is calculated by subtracting an estimate of the underlying continuum in a relevant part of a measured spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak area method" .

goldbook:P04456 a skos:Concept ;
    skos:definition "The highest concentration of a given trace component which was measured with a continuous analyser during a specified sampling period." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak concentration" .

goldbook:P04457 a skos:Concept ;
    skos:definition "In linear-sweep voltammetry, triangular-wave voltammetry, cyclic triangular-wave voltammetry, and similar techniques, the maximum value of the faradaic current due to the reduction or oxidation of a substance B during a single sweep. This maximum value is attained after an interval during which the concentration of B at the electrode-solution interface decreases monotonically, while the faradaic current due to the reduction or oxidation of B increases monotonically, with time. It is attained before an interval during which this current decreases monotonically with time because the rate of transport of B toward the electrode-solution interface is smaller than the rate at which it is removed from the interface by electrolysis. The term has also been used to denote the maximum value of the faradaic current attributable to the reduction or oxidation of an electroactive substance in techniques such as ac polarography, differential pulse polarography, and derivative polarography. However, these techniques give curves that arise in ways different from that cited above, and the terms summit, summit current, and summit potential are therefore recommended for use in connection with such techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak current" .

goldbook:P04458 a skos:Concept ;
    skos:definition "The volume of mobile phase entering the column between the start of the elution and the emergence of the peak maximum, or the corresponding time. In most of the cases, this is equal to the total retention volume (time). There are, however, cases when the elution process does not start immediately at sample introduction. For example, in liquid chromatography, sometimes the column is washed with a liquid after the application of the sample to displace certain components which are of no interest and during this treatment the sample does not move along the column. In gas chromatography, there are also cases when a liquid sample is applied to the top of the column but its elution starts only after a given period. This term is useful in such cases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak elution volume" .

goldbook:P04460 a skos:Concept ;
    skos:definition "A kind of peak analysis in which a relevant part of a spectrum is fitted with a theoretical response function." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak fitting" .

goldbook:P04464 a skos:Concept ;
    skos:definition "In linear-sweep voltammetry, triangular-wave voltammetry, cyclic triangular-wave voltammetry, and similar techniques, the potential of the indicator electrode at which the peak current is attained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak potential" .

goldbook:P04465 a skos:Concept ;
    skos:definition "The separation of two peaks in terms of their average peak width at base (\\(t_{\\rm{R2}}>t_{\\rm{R1}}\\)): \\[R_{\\rm{s}}=\\frac{t_{\\rm{R2}}\\,-\\,t_{\\rm{R1}}}{\\frac{w_{\\rm{b1}}\\,+\\,w_{\\rm{b2}}}{2}}=\\frac{2\\ (t_{\\rm{R2}}- t_{\\rm{R1}})}{w_{\\rm{b1}}\\,+\\,w_{\\rm{b2}}}\\] In the case of two adjacent peaks it may be assumed that \\(w_{\\rm{b1}}\\approx w_{\\rm{b2}}\\), and thus, the width of the second peak may be substituted for the average value: \\[R_{\\rm{s}}\\approx \\frac{t_{\\rm{R2}}\\,-\\,t_{\\rm{R1}}}{w_{\\rm{b2}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak resolution" .

goldbook:P04466 a skos:Concept ;
    skos:definition "Peak widths represent retention dimensions (time or volume) parallel to the baseline. If the baseline is not parallel to the axis representing time or volume, then the peak widths are to be drawn parallel to this axis. Three peak-width values are commonly used in chromatography. Peak width at base (\\(w_{\\rm{b}}\\)) is the segment of the peak base intercepted by the tangents drawn to the inflection points on either side of the peak. Peak width at half height (\\(w_{\\rm{h}}\\)) is the length of the line parallel to the peak base at 50% of the peak height that terminates at the intersection with the two limbs of the peak. Peak width at inflection points (\\(w_{\\rm{i}}\\)) is the length of the line drawn between the inflection points parallel to the peak base. The peak width at base may be called the 'base width'. However, the peak width at half height must never be called the 'half width' because that has a completely different meaning. Also, the symbol \\(w_{1/2}\\) should never be used instead of \\(w_{\\rm{h}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peak widths" .

goldbook:P04467 a skos:Concept ;
    skos:definition "Polyuronic acids mostly derived from ᴅ-galacturonic acid (abundant in some fruits)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pectins" .

goldbook:P04468 a skos:Concept ;
    skos:definition "A metal-insulator transition in quasi one-dimensional solids that occurs as a result of a band gap opening up at the Fermi energy due to a displacive distortion of the regular array increasing the unit cell length, usually a dimerization; the decrease in electronic energy outweighs the increase in lattice energy. Example: The transition in methylethylmorpholinium tetracyanoquinodimethanide at \\(335\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Peierls transition" .

goldbook:P04469 a skos:Concept ;
    skos:definition "In this case the stationary phase forms a porous outer shell on an impermeable particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pellicular packing" .

goldbook:P04470 a skos:Concept ;
    skos:definition "Natural and synthetic antibiotics containing the 4-thia-1-azabicyclo[3.2.0]heptan-7-one structure, generally assumed to have the 5R configuration unless otherwise specified. The numbering of the penam skeleton differs from that of the von Baeyer named bicyclic system. Where they differ the von Baeyer numbering is shown in parentheses in the example." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "penams" .

goldbook:P04472 a skos:Concept ;
    skos:altLabel "side group" ;
    skos:definition "An offshoot, neither oligomeric nor polymeric from a chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pendant group" .

goldbook:P04473 a skos:Concept ;
    skos:definition "2,3-Didehydropenams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "penems" .

goldbook:P04475 a skos:Concept ;
    skos:definition "Substituted penams having the basic structure shown, including the natural penicillins and synthetic analogues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "penicillins" .

goldbook:P04478 a skos:Concept ;
    skos:definition "An affix used in names to denote ten atoms bound into a pentagonal prism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>pentaprismo</i>-" .

goldbook:P04479 a skos:Concept ;
    skos:definition "Amides derived from two or more amino carboxylic acid molecules (the same or different) by formation of a covalent bond from the carbonyl carbon of one to the nitrogen atom of another with formal loss of water. The term is usually applied to structures formed from $\\ce{\\upalpha\\!\\mbox{-}amino acids}$, but it includes those derived from any amino carboxylic acid.  (R may be any organyl group, commonly but not necessarily one found in natural amino acids)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptides" .

goldbook:P04480 a skos:Concept ;
    skos:definition "A glycosaminoglycan formed by alternating residues of ᴅ-glucosamine and either muramic acid {2-amino-3-O-[(S)-1-carboxyethyl]-2-deoxy-ᴅ-glucose} or ʟ-talosaminuronic acid (2-amino-2-deoxy-ʟ-taluronic acid), which are usually N-acetylated or N-glycoloylated. The carboxyl group of the muramic acid is commonly substituted by a peptide containing residues of both ʟ- and ᴅ-amino acids, whereas that of ʟ-talosaminuronic acid is substituted by a peptide consisting of ʟ-amino acids only." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptidoglycan" .

goldbook:P04485 a skos:Concept ;
    skos:definition "The accessibility of the atoms of metal in metallic catalysts, supported or unsupported, depends upon the percentage of the total atoms of metal which are surface atoms. It is recommended that the term percentage exposed be employed for this quantity rather than the term dispersion which has been frequently employed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percentage exposed" .

goldbook:P04486 a skos:Concept ;
    skos:altLabel "percentage error" ;
    skos:definition "The relative error expressed in percent. It can be calculated from the relative error by multiplying by 100. Comment: The term 'percentage relative error' should always be quoted in full, rather than 'error' or 'percentage error' to avoid confusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percentage relative error" .

goldbook:P04487 a skos:Concept ;
    skos:definition "The value of the relative standard deviation, expressed in percent. It can be calculated from the relative standard deviation by multiplying by 100. Comment: It is recommended that the 'relative standard deviation' be reported, rather than the 'percentage standard deviation', in order to avoid confusion where results themselves are expressed as percentages. The term 'coefficient of variation' in place of 'relative standard deviation' is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "percentage standard deviation" .

goldbook:P04490 a skos:Concept ;
    skos:definition "Differences from the behaviour of interphases containing only neutral species arise when the interphase may be described as perfectly polarized. This term is used when no charged component is common to both phases adjoining the interphase. This may arise as a result of the equilibrium conditions or from the kinetics of charge transfer and leads to an interphase impermeable to electric charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perfectly polarized interphase" .

goldbook:P04491 a skos:Concept ;
    skos:definition "A chemical reaction in which concerted reorganization of bonding takes place throughout a cyclic array of continuously bonded atoms. It may be viewed as a reaction proceeding through a fully conjugated cyclic transition state. The number of atoms in the cyclic array is usually six, but other numbers are also possible. The term embraces a variety of processes, including cycloadditions, cheletropic reactions, electrocyclic reactions, sigmatropic rearrangements, etc. (provided they are concerted)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pericyclic reaction" .

goldbook:P04492 a skos:Concept ;
    skos:definition "The rate of aggregation is in general determined by the frequency of collisions and the probability of cohesion during collision. If the collisions are caused by Brownian motion, the process is called perikinetic aggregation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perikinetic aggregation" .

goldbook:P04493 a skos:Concept ;
    skos:definition "Time for one cycle of a periodic phenomenon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "period" .

goldbook:P04494 a skos:Concept ;
    skos:definition "A copolymer consisting of macromolecules comprising more than two species of monomeric units in regular sequence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periodic copolymer" .

goldbook:P04495 a skos:Concept ;
    skos:definition "A copolymerization in which a periodic copolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periodic copolymerization" .

goldbook:P04496 a skos:Concept ;
    skos:definition "This general term is applicable to square, triangular, and other wave forms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periodic voltage" .

goldbook:P04497 a skos:Concept ;
    skos:definition "A secondary reference (non-core) atom which at some point in the mechanistic sequence is situated in the molecule containing the core atom(s)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peripheral atom" .

goldbook:P04499 a skos:Concept ;
    skos:definition "The differentiation between two symmetry-allowed processes, for example the [2+4] vs. [4+6] cycloaddition of cyclopentadiene to tropone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "periselectivity" .

goldbook:P04500 a skos:Concept ;
    skos:altLabel "incongruent reaction" ;
    skos:definition "An isothermal, reversible reaction between two phases, a liquid and a solid, that results, on cooling of a binary, ternary, ... , \\(n\\) system in one, two, ... (\\(n- 1\\)) new solid phases. Synonymous with incongruent reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritectic reaction" .

goldbook:P04501 a skos:Concept ;
    skos:altLabel "metatectoid reaction" ;
    skos:definition "An isothermal, reversible reaction in the solid state, that, on cooling of a binary, ternary, ... , \\(n\\) system, results in one, two, ... (\\(n-1\\)) new solid phases. For example, in a binary system containing two solids \\(\\alpha'\\) and \\(\\alpha''\\) \\[\\alpha' + \\alpha'' \\rightarrow \\beta\\] Synonymous with metatectoid reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritectoid reaction" .

goldbook:P04502 a skos:Concept ;
    skos:definition "The maximum temperature at which a peritectoid reaction can occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peritectoid temperature" .

goldbook:P04506 a skos:Concept ;
    skos:definition "A device used for dynamic preparation of test gas mixtures by means of controlled permeation of a gaseous analyte out of a container through polymer material into a carrier gas stream. These devices containing certain condensable gases (e.g. $\\ce{NO2}$, $\\ce{SO2}$, etc.) when operated at closely controlled temperatures can be used as primary standards calibrated in terms of the weight loss per unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permeation tube" .

goldbook:P04508 a skos:Concept ;
    skos:definition "Fundamental physical constant \\(\\varepsilon_{0}=\\frac{1}{\\mu _{0}\\ c_{0}^{2}}\\) exactly, where \\(\\mu_{0}\\) is the permeability of vacuum and \\(c_{0}\\) the speed of light in vacuum. It is equal to \\(8.854\\ 187\\ 817\\,...\\times\\ 10^{-12}\\ \\rm{F m}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permittivity of vacuum" .

goldbook:P04509 a skos:Concept ;
    skos:definition "A term used to define the preferential permeation of certain ionic species through ion-exchange membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permselectivity" .

goldbook:P04510 a skos:Concept ;
    skos:definition "Compounds of structure $\\ce{ROOR}$ in which $\\ce{R}$ may be any organyl group (The term is also used in an inorganic sense to denote salts of the anion $\\ce{O2^{2−}}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peroxides" .

goldbook:P04511 a skos:Concept ;
    skos:definition "Organelle, similar to a lysosome, characterized by its content of catalase (EC 1.11.1.6), peroxidase (EC 1.11.1.7) and other oxidative enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peroxisome" .

goldbook:P04513 a skos:Concept ;
    skos:altLabel "per acids",
        "peracids" ;
    skos:definition "Acids in which an acidic $\\ce{–OH}$ group has been replaced by an $\\ce{–OOH}$ group, e.g. $\\ce{CH3C(=O)OOH}$ peroxyacetic acid, $\\ce{PhS(=O)2OOH}$ benzeneperoxysulfonic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peroxy acids" .

goldbook:P04516 a skos:Concept ;
    skos:definition "A term used to characterize radicals which have lifetimes of several minutes or greater in dilute solution in inert solvents. Persistence is a kinetic or reactivity property. In contrast, radical stability, which is a thermodynamic property, is expressed in terms of the $\\ce{C–H}$ bond strength of the appropriate hydrocarbon. The lifetime of a radical is profoundly influenced by steric shielding of the radical centre by bulky substituents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "persistent" .

goldbook:P04517 a skos:Concept ;
    skos:definition "A geometric representation of stereochemical features of a molecule or model which appears as a view from an appropriate direction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perspective formula" .

goldbook:P04519 a skos:Concept ;
    skos:definition "Strictly, a substance intended to kill pests: in common usage, any substance used for controlling, preventing, or destroying animal, microbiological or plant pests." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pesticide" .

goldbook:P04520 a skos:Concept ;
    skos:definition "Any substance or mixture of substances in food for man or animals resulting from the use of a pesticide including any specified derivatives, such as degradation and conversion products, metabolites, reaction products and impurities considered to be of toxicological significance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pesticide residue" .

goldbook:P04522 a skos:Concept ;
    skos:definition "A carbonization product of high-boiling hydrocarbon fractions obtained in petroleum processing (heavy residues). It is the general term for all special petroleum coke products such as green, calcined and needle petroleum coke." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "petroleum coke" .

goldbook:P04523 a skos:Concept ;
    skos:definition "A residue from heat treatment and distillation of petroleum fractions. It is solid at room temperature, consists of a complex mixture of numerous predominantly aromatic and alkyl-substituted aromatic hydrocarbons, and exhibits a broad softening range instead of a defined melting temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "petroleum pitch" .

goldbook:P04524 a skos:Concept ;
    skos:definition "The quantity pH is defined in terms of the activity of hydrogen(1+) ions (hydrogen ions) in solution: \\[\\rm{pH} = -\\rm{lg}[a(\\rm{H}^{+})] = -\\rm{lg}[\\rm{m}(\\rm{H}^{+})\\gamma_{\\rm{m}}(\\rm{H}^{+})/m^{\\unicode{x29B5} }]\\] where \\(a(\\rm{H}^{+})\\) is the activity of hydrogen ion (hydrogen 1+) in aqueous solution, \\(\\rm{H}^{+}\\rm{(aq)}\\), \\(\\gamma_{\\rm{m}}(\\rm{H}^{+})\\) is the activity coefficient of \\(\\rm{H}^{+}\\rm{(aq)}\\) (molality basis) at molality \\(m(\\rm{H}^{+})\\), and \\(m^{⦵} = \\pu{1 mol kg-1}\\) is the standard molality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH" .

goldbook:P04525 a skos:Concept ;
    skos:definition "That value of pH in an aqueous phase at which the distribution ratio is unity at equilibrium. 50% of the solute is extracted (\\(E = 0.5\\)) only when the phase ratio is unity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH<sub>0.5</sub> or pH<sub>1/2</sub>" .

goldbook:P04526 a skos:Concept ;
    skos:definition "Study of pharmacological actions on living systems, including the reactions with and binding to cell constituents, and the biochemical and physiological consequences of these actions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacodynamics" .

goldbook:P04528 a skos:Concept ;
    skos:definition "An entity of a material system which is uniform in chemical composition and physical state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase" .

goldbook:P04530 a skos:Concept ;
    skos:definition "A term used in two senses which should be specified: density inversion or continuity inversion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase inversion" .

goldbook:P04531 a skos:Concept ;
    skos:definition "The ratio of the volume of the mobile phase to that of the stationary phase in a column: \\[\\beta = \\frac{V_{0}}{V_{\\rm{s}}}\\] In the case of open-tubular columns the geometric internal volume of the tube (\\(V_{\\rm{c}}\\)) is to be substituted for \\(V_{0}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase ratio" .

goldbook:P04532 a skos:Concept ;
    skos:definition "The ratio of the quantity of the solvent to that of the other phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase ratio" .

goldbook:P04533 a skos:Concept ;
    skos:definition "The number of degrees of freedom, \\(F\\), that a system containing \\(C\\) components can have when \\(P\\) phases are in equilibrium, is given as: \\[F=C- P+2\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase rule" .

goldbook:P04534 a skos:Concept ;
    skos:definition "The process by which a single solid (liquid) phase separates into two or more new phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase separation" .

goldbook:P04535 a skos:Concept ;
    skos:definition "This is a theory applied to unimolecular or bimolecular reactions proceeding through long-lived complexes. The probability of reaction is assumed to be proportional to the number of states available to a particular product channel divided by the number of states corresponding to all product channels. The theory is used to predict rates, product energy distributions, product velocity distributions, and product angular momentum distributions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase-space theory" .

goldbook:P04536 a skos:Concept ;
    skos:definition "The phenomenon of rate enhancement of a reaction between chemical species located in different phases (immiscible liquids or solid and liquid) by addition of a small quantity of an agent (called the 'phase-transfer catalyst') that extracts one of the reactants, most commonly an anion, across the interface into the other phase so that reaction can proceed. These catalysts are salts of 'onium ions' (e.g. tetraalkylammonium salts) or agents that complex inorganic cations (e.g. crown ethers). The catalyst cation is not consumed in the reaction although an anion exchange does occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase-transfer catalysis" .

goldbook:P04537 a skos:Concept ;
    skos:definition "A change in the nature of a phase or in the number of phases as a result of some variation in externally imposed conditions, such as temperature, pressure, activity of a component or a magnetic, electric or stress field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase transition" .

goldbook:P04538 a skos:Concept ;
    skos:definition "Synonymous with phenoxides. The term phenolate should not be used for solvates derived from a phenol, for the ending -ate often occurs in names for anions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenolates" .

goldbook:P04539 a skos:Concept ;
    skos:definition "Compounds having one or more hydroxy groups attached to a benzene or other arene ring, e.g. 2-naphthol:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenols" .

goldbook:P04540 a skos:Concept ;
    skos:definition "In the following only media which are isotropic with respect to mass transport (i.e. the transport coefficients are independent of direction) are being considered. In the linear range (not too far from equilibrium), for uniform temperature and neglecting external fields such as the earth's gravitational field, the flux density of species B is related to the gradients of the electrochemical potentials of all species by the phenomenological equation: \\[N_{\\rm{B}}- c_{\\rm{B}}\\ v_{\\rm{A}}=- \\sum _{\\begin{array}{c} i\\\\ i eq A \\end{array}}L_{\\rm{B}i}^{\\rm{A}}\\  abla \\mu _{i}\\] with \\[i=\\rm{B},\\rm{C},...\\] where \\( abla \\mu _{i}\\) is the gradient of the electrochemical potential of species i. The proportionality factors \\(L_{\\rm{B}i}^{\\rm{A}}\\) are called phenomenological coefficients. Their values depend on the frame of reference. The latter is taken here to move with the velocity \\(v_{\\rm{A}}\\) of species A, and hence: \\[L_{\\rm{A}i}^{\\rm{A}}=0\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenomenological equation" .

goldbook:P04541 a skos:Concept ;
    skos:definition "The traditional generic name for those cyclohexadienyl cations that are spiro-annulated with a cyclopropane unit. Phenonium ions constitute a subclass of arenium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenonium ions" .

goldbook:P04542 a skos:Concept ;
    skos:definition "The observable structural and functional characteristics of an organism determined by its genotype and modulated by its environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenotype" .

goldbook:P04543 a skos:Concept ;
    skos:definition "Salts or analogous metal derivatives of phenols; synonymous with phenolates. A preferable general term, however, is aryloxides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phenoxides" .

goldbook:P04544 a skos:Concept ;
    skos:altLabel "ectohormone",
        "feromone" ;
    skos:definition "Substance used in olfactory communication between organisms of the same species eliciting a change in sexual or social behaviour. Synonymous with ectohormone, feromone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pheromone" .

goldbook:P04545 a skos:Concept ;
    skos:definition "A hydrogen-ion responsive electrode usually consisting of a bulb, or other suitable form, of special glass attached to a stem of high resistance glass complete with internal reference electrode and internal filling solution system. Other geometrical forms may be appropriate for special applications, e.g. capillary electrode for measurement of blood pH." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH glass electrode" .

goldbook:P04546 a skos:Concept ;
    skos:definition "The differential change of pH with distance (\\(\\frac{\\rm{dpH}}{\\rm{d}I}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH gradient" .

goldbook:P04547 a skos:Concept ;
    skos:definition "Elementary excitation in the quantum mechanical treatment of vibrations in a crystal lattice. An energy bundle that behaves as a particle of energy \\(h\\  u \\), with \\( u \\) the vibration frequency and \\(h\\) the Planck constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phonon" .

goldbook:P04548 a skos:Concept ;
    skos:definition "The saturated hydrides of tervalent phosphorus having the general formula $\\ce{P_{n}H_{n+2}}$. Individual members having an unbranched phosphorus chain are named phosphane, diphosphane, triphosphane, etc. The name of a saturated hydride of phosphorus wherein one or more phosphorus atoms have a bonding number of 5 is formed by prefixing locants and \\(\\lambda ^{5}\\) symbols to the name of the corresponding phosphane. Hydrocarbyl derivatives of $\\ce{PH3}$ belong to the class phosphines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphanes" .

goldbook:P04549 a skos:Concept ;
    skos:altLabel "phosphinediyls",
        "phosphinidenes" ;
    skos:definition "Recommended name for carbene analogues having the structure $\\ce{RP{:}}$ (former IUPAC name is phosphinediyls). A common non-IUPAC synonym is phosphinidenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphanylidenes" .

goldbook:P04550 a skos:Concept ;
    skos:definition "Derivatives of glycerol in which one hydroxy group, commonly but not necessarily primary, is esterified with phosphoric acid and the other two are esterified with fatty acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphatidic acids" .

goldbook:P04551 a skos:Concept ;
    skos:definition "Compounds containing a phosphorus–nitrogen double bond, i.e. derivatives of $\\ce{H3P=NH}$ and $\\ce{HP=NH}$. A multiplicity of such bonds is present in various well-established chain, ring and cage compounds. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphazenes" .

goldbook:P04552 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R3P=O  R3P^{+}–O^{−}}$ (analogously, phosphine imides and phosphine sulfides)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphine oxides" .

goldbook:P04553 a skos:Concept ;
    skos:definition "$\\ce{PH3}$ and compounds derived from it by substituting one, two or three hydrogen atoms by hydrocarbyl groups $\\ce{R3P}$. $\\ce{RPH2}$, $\\ce{R2PH}$ and $\\ce{R3P}$ ($\\ce{R}  eq \\ce{H}$) are called primary, secondary and tertiary phosphines, respectively. A specific phosphine is preferably named as a substituted phosphane, e.g. $\\ce{CH3PH2}$ methylphosphane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphines" .

goldbook:P04554 a skos:Concept ;
    skos:definition "$\\ce{H2P(=O)OH}$ (phosphinic acid) and its P-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphinic acids" .

goldbook:P04556 a skos:Concept ;
    skos:definition "$\\ce{H2POH}$ (phosphinous acid) and its P-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphinous acids" .

goldbook:P04557 a skos:Concept ;
    skos:definition "A prefix used in biochemical nomenclature in place of phosphono to denote the $\\ce{-P(=O)(OH)2}$ group linked to a heteroatom, e.g. $\\ce{Me3N^{+}-CH2CH2–OP(=O)(OH)O^{-}}$ phosphocholine.An infix used in biochemical nomenclature to name phosphoric diesters, e.g. glycerophosphocholine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phospho" .

goldbook:P04558 a skos:Concept ;
    skos:definition "Phosphoric diesters, esters of phosphatidic acids, generally having a polar head group ($\\ce{OH}$ or $\\ce{N2}$) on the esterified alcohol which typically is 2-aminoethanol, choline, glycerol, inositol, serine. The term includes lecithins, cephalins. E.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphoglycerides" .

goldbook:P04559 a skos:Concept ;
    skos:definition "Lipids containing phosphoric acid as mono- or di-esters, including phosphatidic acids and phosphoglycerides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phospholipids" .

goldbook:P04560 a skos:Concept ;
    skos:definition "$\\ce{HP(=O)(OH)2}$ (phosphonic acid) and its P-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphonic acids" .

goldbook:P04561 a skos:Concept ;
    skos:definition "Compounds of stoichiometric composition $\\ce{[X2PN]_{n}}$, in which $\\ce{X}$ is alkoxy, halogen, or other electronegative group, and \\(n\\) is a variable integer, the value of which may not be known." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphonitriles" .

goldbook:P04562 a skos:Concept ;
    skos:definition "Salts (and hydroxides) $\\ce{[R4P^{+}]X^{−}}$ containing tetracoordinate phosphonium ion and the associated anion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphonium compounds" .

goldbook:P04563 a skos:Concept ;
    skos:altLabel "Wittig reagents",
        "phosphorus ylides" ;
    skos:definition "Compounds having the structure $\\ce{R3P^{+}–C^{−}R2  R3P=CR2}$. Also known as Wittig reagents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphonium ylides" .

goldbook:P04564 a skos:Concept ;
    skos:definition "A prefix indicating the presence of the group $\\ce{–P(=O)(OH)2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphono" .

goldbook:P04565 a skos:Concept ;
    skos:definition "$\\ce{HP(OH)2}$ (phosphonous acid) and its P-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphonous acids" .

goldbook:P04566 a skos:Concept ;
    skos:definition "Compounds in which one or more of the OH groups of phosphoric acid have been replaced with an amino or substituted amino group; commonly confined to the phosphoric triamides, $\\ce{P(=O)(NR2)3, since replacement of one or two $\\ce{OH}$ groups produces phosphoramidic acids $\\ce{P(=O)(OH)(NR2)2}$, $\\ce{P(=O)(OH)2(NR2)}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphoramides" .

goldbook:P04567 a skos:Concept ;
    skos:definition "The mononuclear hydride $\\ce{PH5}$, systematically named \\(\\lambda ^{5}\\)-phosphane, and its hydrocarbyl derivatives. By extension, the literature also applies the term to phosphonium ylides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphoranes" .

goldbook:P04568 a skos:Concept ;
    skos:definition "A tetracoordinate phosphorus species which has nine valence-shell electrons $\\ce{R4P^{.}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphoranyl radicals" .

goldbook:P04569 a skos:Concept ;
    skos:definition "From a phenomenological point of view, the term has been used to describe long-lived luminescence. In mechanistic photochemistry, the term designates luminescence involving change in spin multiplicity, typically from triplet to singlet or vice versa. The luminescence from a quartet state to a doublet state is also phosphorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphorescence" .

goldbook:P04571 a skos:Concept ;
    skos:definition "A mechanical device used to separate phosphorescence from fluorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphoroscope" .

goldbook:P04574 a skos:Concept ;
    skos:definition "A pressure-sensitive detector used to detect intermittent radiation absorbed in a black body or in the sample concerned. The resulting rapid temperature change produces a transient pressure oscillation that is observed with the help of a microphone, or a piezoelectric device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoacoustic detector" .

goldbook:P04575 a skos:Concept ;
    skos:definition "Generation of heat after absorption of radiation, due to radiationless deactivation or chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoacoustic effect" .

goldbook:P04576 a skos:Concept ;
    skos:definition "A spectroscopic technique based on the photoacoustic effect. A photoacoustic spectrum consists of a plot of the intensity of the acoustic signal detected by a microphone or a 'piezoelectric' detector, against the excitation wavelength or another quantity related to the photon energy of the modulated excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoacoustic spectroscopy" .

goldbook:P04577 a skos:Concept ;
    skos:definition "Irradiation by light (usually visible or ultraviolet) may affect adsorption. In a system containing adsorptive and adsorbent exposure to light may lead to increased adsorption (photoadsorption) or it may lead to desorption of an adsorbate (photodesorption)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoadsorption" .

goldbook:P04578 a skos:Concept ;
    skos:altLabel "PAL" ;
    skos:definition "Technique by which a photochemically reactive molecular entity, specifically associated with a biomolecule, is photo-excited in order to covalently attach a label to the biomolecule, usually via intermediates. Identification of the resulting photo-crosslinked product provides structural information on the protein′s binding site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoaffinity labelling" .

goldbook:P04579 a skos:Concept ;
    skos:definition "Catalytic reaction involving production of a catalyst by absorption of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoassisted catalysis" .

goldbook:P04580 a skos:Concept ;
    skos:definition "Change in the rate of a chemical reaction or its initiation under the action of ultraviolet, visible or infrared radiation in the presence of a substance—the photocatalyst—that absorbs light and is involved in the chemical transformation of the reaction partners." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalysis" .

goldbook:P04583 a skos:Concept ;
    skos:definition "According to the principle of photochemical equivalence, there is a one-to-one relationship between the number of photons absorbed by a system and the number of excited species produced. The principle often fails for light of high intensity (e.g. laser beams), when molecules may absorb more than one photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical equivalence" .

goldbook:P04585 a skos:Concept ;
    skos:altLabel "photoreaction" ;
    skos:definition "Generally used to describe a chemical reaction caused by absorption of ultraviolet, visible or infrared radiation. There are many ground-state reactions, which have photochemical counterparts. Among these are photochemical nitrogen extrusions, photocycloadditions, photodecarbonylations, photodecarboxylations, photoenolizations, photo-Fries rearrangement, photoisomerizations, photooxidations, photorearrangements, photoreductions, photosubstitutions, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical reaction" .

goldbook:P04586 a skos:Concept ;
    skos:definition "Product of photochemical reactions caused by solar radiation and occurring in polluted air as well as in air contaminated by compounds emitted by natural sources, such as those emitted by vegetation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical smog" .

goldbook:P04588 a skos:Concept ;
    skos:definition "The branch of chemistry concerned with the chemical effects of light (far UV to IR)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemistry" .

goldbook:P04589 a skos:Concept ;
    skos:definition "Reversible transformation of a molecular entity between two forms, A and B, having different absorption spectra, induced in one or both directions by absorption of electromagnetic radiation. The spectral change produced is typically, but not necessarily, of visible colour and is accompanied by differences in other physical properties. The thermodynamically stable form A is transformed by irradiation into form B. The back reaction can occur thermally (photochromism of type T) or photochemically (photochromism of type P).  The terms 'switch-on' and 'switch-of' are sometimes used to denote the two directions of the photochromic reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochromism" .

goldbook:P04590 a skos:Concept ;
    skos:definition "In a photoconductive detector an electric potential is applied across the absorbing region and causes a current to flow in proportion to the irradiance if the photon energy exceeds the energy gap between the valence and the conduction band. Depending on their spectral responsivity function, photoconductive detectors are divided into photoconductive detectors for the visible wavelength range e.g. cadmium sulfide or $\\ce{CdS}$ photoconductive detectors, photoconductive detectors for the near infrared wavelength range e.g. lead sulfide or $\\ce{PbS}$ photoconductive detectors, photoconductive detectors for the infrared wavelength range e.g. silicon doped with arsenide or $\\ce{Si:As}$ photoconductive detectors, and the mercury-cadmium-telluride or $\\ce{HgCdTe}$ photoconductive detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoconductive detector" .

goldbook:P04591 a skos:Concept ;
    skos:definition "Electrical conductivity resulting from photoproduction of charge carriers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoconductivity" .

goldbook:P04592 a skos:Concept ;
    skos:definition "The formation of a covalent linkage between two macromolecules or between two different parts of one macromolecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocrosslinking" .

goldbook:P04593 a skos:Concept ;
    skos:altLabel "photo-curing" ;
    skos:definition "Curing induced by photo-irradiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical curing" .

goldbook:P04594 a skos:Concept ;
    skos:altLabel "current yield" ;
    skos:definition "The quantum efficiency of electron transport between the two electrodes of a photovoltaic cell or photoelectrochemical cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocurrent yield" .

goldbook:P04595 a skos:Concept ;
    skos:definition "The photochemical transformation of a molecule into lower molecular weight fragments, usually in an oxidation process. This term is widely used in the destruction (oxidation) of pollutants by UV-based processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodegradation" .

goldbook:P04597 a skos:Concept ;
    skos:definition "Ejection of an electron from a negative ion upon photoexcitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodetachment" .

goldbook:P04598 a skos:Concept ;
    skos:definition "A two-electrode, radiation-sensitive junction formed in a semiconductive material. A junction is formed by two successive regions of a semiconductive material having, respectively, an excess of electrons (n-type) or holes (p-type). A bias potential applied to the detector creates a region at the interface that is depleted of majority carriers. Each incident photon produces electron-hole pairs in the depletion region resulting in a measurable signal current. The photodiode can be operated either with zero bias in the photovoltaic mode where the photodiode is actually generating the electric potential supplied to the load. In a biased mode, the photoconductive mode, the reverse current is proportional to the irradiation. A Schottky-barrier photodiode is constructed by deposition of a metal film on a semiconductor surface in such a way that no interface layer is present. The barrier thickness depends on the impurity dopant concentration in the semiconductor layer. The incident radiation generates electon-hole pairs within the depletion region of the barrier where they are collected efficiently and rapidly by the built-in field. A PIN (p-intrinsic-n) diode is a planar diffused diode consisting of a single crystal having an intrinsic (undoped or compensated) region sandwiched between p- and n-type regions. A bias potential applied across the detector depletes the intrinsic region of charge carriers, constituting the radiation-sensitive detector volume. The number of electron-hole pairs produced is dependent on the energy of the incident photons. An avalanche photodiode is a photodiode in which the photogenerated electron-hole pairs are accelerated by a bias potential near to breakdown potential so that further electron-hole pairs are formed leading to saturation of the photocurrent. This operational mode for photon counting is the so-called Geiger mode, similar to that of the gas filled Geiger counter. Avalanche photodiodes can also be operated in the proportional mode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodiode" .

goldbook:P04599 a skos:Concept ;
    skos:definition "An arrangement of a number of photodiodes on a single chip." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodiode array" .

goldbook:P04600 a skos:Concept ;
    skos:definition "A term used in photobiology to refer to photoinduced damage requiring the simultaneous presence of light, photosensitizer and molecular oxygen. A sensitized photooxidation which involves molecular oxygen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodynamic effect" .

goldbook:P04601 a skos:Concept ;
    skos:definition "The ejection of an electron from a solid or a liquid by a photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrical effect" .

goldbook:P04602 a skos:Concept ;
    skos:definition "The attenuation coefficient when only the photoelectric process is taken into account." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectric attenuation coefficient" .

goldbook:P04604 a skos:Concept ;
    skos:altLabel "photopeak" ;
    skos:definition "Of a spectrum of γ-radiation, the part of the spectral response curve corresponding to the absorption in the radiation detector by the photoelectrical effect of the detected $\\upgamma\\!\\mbox{-}\\rm{energy}$. In most cases the peak also contains events caused by multiple processes and use of the expression full energy peak or full energy peak is to be preferred. Synonymous with photopeak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectric peak" .

goldbook:P04605 a skos:Concept ;
    skos:definition "An electrochemical cell in which current and a voltage are simultaneously produced upon absorption of light by one or more of the electrodes. Usually at least one of the electrodes is a semiconductor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrochemical cell" .

goldbook:P04606 a skos:Concept ;
    skos:definition "The dissolution of a semiconductor in an electrolytic solution upon exposure to light. Used in the photopatterning of semiconductor surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrochemical etching" .

goldbook:P04607 a skos:Concept ;
    skos:definition "A term applied to a hybrid field of chemistry employing techniques which combine photochemical and electrochemical methods for the study of the oxidation-reduction chemistry of the ground or excited states of molecules or ions. In general, it is the chemistry resulting from the interaction of light with electrochemical systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrochemistry" .

goldbook:P04608 a skos:Concept ;
    skos:definition "A cell in which radiant energy causes a net chemical conversion in the cell, e.g. so as to produce hydrogen as a useful fuel. These cells can be classified as photosynthetic or photocatalytic. In the former case, radiant energy provides a Gibbs energy to drive a reaction such as \\(\\rm{H}_{2}\\rm{O}\\rightarrow \\rm{H}_{2}+\\frac{1}{2}\\rm{O}_{2}\\) , and electrical or thermal energy may be later recovered by allowing the reverse, spontaneous reaction to proceed. In a photocatalytic cell the photon absorption promotes a reaction with \\(\\Delta G < 0\\) so there is no net storage of chemical energy, but the radiant energy speeds up a slow reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectrolytic cell" .

goldbook:P04609 a skos:Concept ;
    skos:altLabel "PES" ;
    skos:definition "A spectroscopic technique which measures the kinetic energy of electrons emitted upon the ionization of a substance by high energy monochromatic photons. A photoelectron spectrum is a plot of the number of electrons emitted versus their kinetic energy. The spectrum consists of bands due to transitions from the ground state of an atom or molecular entity to the ground and excited states of the corresponding radical cation. Approximate interpretations are usually based on 'Koopmans theorem' and yield orbital energies. PES and UPS (UV photoelectron spectroscopy) refer to the spectroscopy using vacuum ultraviolet sources, while ESCA (electron spectroscopy for chemical analysis) and XPS use X-ray sources." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectron spectroscopy" .

goldbook:P04611 a skos:Concept ;
    skos:definition "The number of photoelectrons emitted by the sample per incident photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoelectron yield" .

goldbook:P04612 a skos:Concept ;
    skos:definition "A detector in which a photon interacts with a solid surface, which is called the photocathode, or a gas, releasing a photoelectron. This process is called the external photoelectric effect. The photoelectrons are collected by an electrode at positive electric potential, i.e. the anode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoemissive detector" .

goldbook:P04613 a skos:Concept ;
    skos:definition "The production of an excited state by the absorption of ultraviolet, visible, or infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoexcitation" .

goldbook:P04614 a skos:Concept ;
    skos:definition "A photorearrangement of aryl or acyl esters to give the-rearranged product (as well as the-rearranged product):" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo-Fries rearrangement" .

goldbook:P04615 a skos:Concept ;
    skos:definition "An electrochemical cell in which current or voltage changes result from photochemically generated changes in the relative concentrations of reactants in a solution phase oxidation-reduction couple." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photogalvanic cell" .

goldbook:P04617 a skos:Concept ;
    skos:definition "An electron transfer resulting from an electronic state produced by the resonant interaction of electromagnetic radiation with matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoinduced electron transfer" .

goldbook:P04618 a skos:Concept ;
    skos:definition "The polymerization of a monomer by a free radical or ionic chain reaction initiated by photoexcitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoinduced polymerization" .

goldbook:P04619 a skos:Concept ;
    skos:definition "The photoproduction of a free radical or ion capable of initiating a chain reaction such as a polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoinitiation" .

goldbook:P04620 a skos:Concept ;
    skos:definition "The term generally used to describe ionization of any species by photons. The process may, for example, be written  Electrons and photons do not 'impact' molecules or atoms; they interact with them in ways that result in various electronic excitations including ionization. For this reason it is recommended that in mass spectrometry the terms 'electron impact' and 'photon impact' not be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoionization" .

goldbook:P04621 a skos:Concept ;
    skos:definition "Radiation from an ultraviolet lamp ionizes certain species in the carrier gas. A potential difference is applied and the resulting ionization current is detected. The detector is only useful for substances with ionization potentials below about \\(11\\ \\rm{eV}\\). This makes it quite useful for detecting one component of a combined eluent when the other component, for instance nitrogen, has a high ionization potential. The detector has a small linear dynamic range and is capable of detecting substances below \\(1\\ \\rm{ppmv}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoionization detector" .

goldbook:P04622 a skos:Concept ;
    skos:definition "Photochemical process leading to an isomerization of the substrate, either by bond rotation, skeletal rearrangement or atom- or group- transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoisomerization" .

goldbook:P04623 a skos:Concept ;
    skos:definition "Luminescence from direct photoexcitation of the emitting species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoluminescence" .

goldbook:P04624 a skos:Concept ;
    skos:definition "The cleavage of one or more covalent bonds in a molecular entity resulting from absorption of light, or a photochemical process in which such cleavage is an essential part. For example:  The term is used incorrectly to describe irradiation of a sample, although in the combination flash photolysis this usage is accepted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photolysis" .

goldbook:P04625 a skos:Concept ;
    skos:definition "The measurement of light over wavelengths which produce visual sensation (approximately \\(380{-}780\\ \\rm{nm}\\)). Thus photometric quantities do not refer to a specific wavelength but to the light emitted by a standard source (formerly a 'standard international candle', now a blackbody radiator emitting at the temperature of solidifying platinum, \\(2042\\ \\rm{K}\\)). luminance and illuminance are the photometric analogues of the radiometric quantities radiance and irradiance, respectively, but conversion from photometric units (e.g. \\(\\rm{lm cm}^{-2}\\)) to radiometric units (e.g. \\(\\pu{J s-1 cm-2}\\)) requires convolution over wavelength of the spectral radiation with the relative spectral response of the human eye. The standard response is called the 'spectral luminous efficiency of radiation', and is tabulated for daylight adapted vision in photopic response tables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photometry" .

goldbook:P04626 a skos:Concept ;
    skos:altLabel "PMT" ;
    skos:definition "A vacuum phototube with additional amplification by electron multiplication. It consists of a photocathode, a series of dynodes, called a dynode chain on which a secondary-electron multiplication process occurs, and an anode. According to the desired response time, transit time, time spread, gain, or low dark current, different types of dynode structures have been developed, e.g. circular cage structure, linear focused structure, venetian blind structure, box and grid structure. Some special dynode structures permit combination with additional electric or magnetic fields. A strip dynode photomultiplier tube consists of a photocathode followed by thin dynode material on an insulating substrate. In a continuous-strip photomultiplier, two strip dynodes are arranged in parallel. A potential applied to the ends of the two strips produces an electric field across the continuous strip dynodes, giving rise to electron multiplication along the dynodes. In a resistance-strip magnetic photomultiplier, a uniform magnetic field is applied to the planes of the strips, so that the electrons travel in the crossed electric and magnetic fields. A channel photomultiplier tube photocathode consists of a channel electron multiplier (CEM) system for the photoelectrons, and an anode to collect the final electron current. The basic part of the CEM is a tube with a semiconducting inner surface. In general it is curved in order to inhibit the acceleration of positive ions towards the photocathode. A number of small channels called microchannels can be constructed in arrays for imaging applications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photomultiplier tube" .

goldbook:P04627 a skos:Concept ;
    skos:definition "Particle of zero charge, zero rest mass, spin quantum number 1, energy \\(h\\  u \\) and momentum \\(\\frac{h\\  u }{c}\\)(\\(h\\) is the Planck constant, \\( u \\) the frequency of radiation and \\(c\\) the speed of light), carrier of electromagnetic force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon" .

goldbook:P04629 a skos:Concept ;
    skos:altLabel "single-photon counting" ;
    skos:definition "Recording of sequential single photons counted by way of recording and counting sequential electron pulses at the anode of the photomultiplier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon counting" .

goldbook:P04631 a skos:Concept ;
    skos:altLabel "photon emittance",
        "specific photon emission" ;
    skos:definition "Photon flux, number basis, \\(q_{\\rm{p}}\\), emitted by an element of the surface containing the source point under consideration divided by the area \\(S\\) of that element. SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon exitance" .

goldbook:P04632 a skos:Concept ;
    skos:definition "Photon irradiance, \\(E_{\\rm{p}}\\), integrated over the time of irradiation for a beam incident from all upward directions. SI unit is \\(\\rm{m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon exposure" .

goldbook:P04633 a skos:Concept ;
    skos:definition "The number of photons (quanta, \\(N\\)) per unit time. (\\(\\frac{\\rm{d}N}{\\rm{d}t}\\), simplified expression: \\(\\mathit{\\Phi} _{\\rm{p}} = \\frac{N}{t}\\) when the number of photons is constant over the time considered). The SI unit is \\(\\rm{s}^{-1}\\). Alternatively, the term can be used with the amount of photons (mol or its equivalent einstein), the SI unit then being \\(\\pu{mol s-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon flow" .

goldbook:P04634 a skos:Concept ;
    skos:definition "Amount of photons (quanta of radiation) incident on a small sphere from all directions, divided by the cross-sectional area of that sphere and integrated over time. Photons per surface area (\\(\\rm{quanta m}^{-2}\\)). SI unit is \\(\\rm{m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon fluence" .

goldbook:P04635 a skos:Concept ;
    skos:definition "Rate of photon fluence. Total number of photons (\\(N_{\\rm{p}}\\)) incident from all directions on a small sphere divided by the cross-sectional area of the sphere and per time interval. SI unit is \\(\\rm{m}^{-2}\\ \\rm{s}^{-1}\\). Same as photon fluence rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon fluence rate" .

goldbook:P04636 a skos:Concept ;
    skos:altLabel "CEI" ;
    skos:definition "Number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval. SI unit is \\(\\rm{s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon flux" .

goldbook:P04637 a skos:Concept ;
    skos:altLabel "SI" ;
    skos:definition "Number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval (photon flux), \\(q_{\\rm{p}}\\), incident from all upward directions on a small element of surface containing the point under consideration divided by the area of the element. SI unit is \\(\\rm{m}^{-2}\\ \\rm{s}^{-1}\\). Equivalent definition: Integral, taken over the hemisphere visible from the given point, of the expression \\(L_{\\rm{p}}\\, \\rm{cos}\\:\\theta\\, \\rm{d}\\varOmega\\) the photon radiance at the given point in the various directions of the incident beam of solid angle \\(\\varOmega\\) and \\(\\theta\\) the angle between any of these beams and the normal to the surface at the given point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon irradiance" .

goldbook:P04639 a skos:Concept ;
    skos:definition "Number of photons (quanta of radiation, \\(N_{\\rm{p}}\\)) per time interval (photon flux), \\(q_{\\rm{p}}\\), leaving or passing through a small transparent element of surface in a given direction from the source about the solid angle \\(\\varOmega\\), divided by the solid angle and by the orthogonally projected area of the element in a plane normal to the given beam direction, \\(\\rm{d}S_{\\perp } = \\rm{d}S\\, cos\\,\\theta\\), with \\(\\theta\\) the angle between the normal to the surface and the direction of the beam. Equivalent definition: Integral taken over the hemisphere visible from the given point, of the expression \\(L_{\\rm{p}}\\, cos\\,\\theta\\,\\rm{d}\\varOmega\\), with \\(L_{\\rm{p}}\\) the photon radiance at the given point in the various directions of the incident beam of solid angle \\(\\varOmega\\) and \\(\\theta\\) the angle between any of these beams and the normal to the surface at the given point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon radiance" .

goldbook:P04640 a skos:Concept ;
    skos:definition "Oxidation reactions induced by light. Common processes are: 1, the loss of one or more electrons from a chemical species as a result of photoexcitation of that species; 2, the reaction of a substance with oxygen under the influence of light. When oxygen remains in the product this latter process is also called photooxygenation. Reactions in which neither the substrate nor the oxygen are electronically excited are sometimes called photoinitiated oxidations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photooxidation" .

goldbook:P04641 a skos:Concept ;
    skos:definition "The incorporation of molecular oxygen into a molecular entity. There are three common mechanisms: Type I: the reaction of triplet molecular oxygen with radicals formed photochemically. Type II: the reaction of photochemically produced singlet molecular oxygen with molecular entities to give rise to oxygen containing molecular entities. The third mechanism proceeds by electron transfer producing superoxide anion as the reactive species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photooxygenation" .

goldbook:P04645 a skos:Concept ;
    skos:definition "In aerosol physics, the motion of particles due to the influence of light. In many cases, this amounts to a special form of thermophoresis due to the heating of the particles by the light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photophoresis" .

goldbook:P04646 a skos:Concept ;
    skos:definition "The transformation of light (solar) energy for the reduction of $\\ce{CO2}$ and the generation of adenosine 5'-triphosphate, ATP." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photophosphorylation" .

goldbook:P04647 a skos:Concept ;
    skos:altLabel "primary photoprocess" ;
    skos:definition "Photoexcitation and subsequent events which lead from one to another state of a molecular entity through radiation and radiationless transitions. No chemical change results." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photophysical processes" .

goldbook:P04648 a skos:Concept ;
    skos:definition "Polymerization processes requiring a photon for the propagation step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photopolymerization" .

goldbook:P04650 a skos:Concept ;
    skos:definition "Reduction reactions induced by light. Common processes are: 1, addition of one or more electrons to a photoexcited species; 2, the photochemical hydrogenation of a substance. Reactions in which the substrate is not electronically excited are sometimes called photoinitiated reductions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoreduction" .

goldbook:P04651 a skos:Concept ;
    skos:definition "A photoimaging material, generally applied as a thin film, whose local solubility properties can be altered photochemically. A subsequent development step produces an image which is useful for the fabrication of microelectronic devices (e.g. integrated circuits)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoresist" .

goldbook:P04652 a skos:Concept ;
    skos:altLabel "sensitization" ;
    skos:definition "The process by which a photochemical or photophysical alteration occurs in one molecular entity as a result of initial absorption of radiation by another molecular entity called a 'photosensitizer'. In mechanistic photochemistry the term is limited to cases in which the photosensitizer is not consumed in the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosensitization" .

goldbook:P04654 a skos:Concept ;
    skos:definition "A steady state reached by a reacting chemical system when light has been absorbed by at least one of the components. At this state the rates of formation and disappearance are equal for each of the transient molecular entities formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photostationary state" .

goldbook:P04655 a skos:Concept ;
    skos:definition "A metabolic process involving plants and some types of bacteria (e.g. Chromatiaceae, Rhodospirillaceae, Chlorobiaceae) in which light energy absorbed by chlorophyll and other photosynthetic pigments results in the reduction of $\\ce{CO2}$ followed by the formation of organic compounds. In plants the overall process involves the conversion of $\\ce{CO2}$ and $\\ce{H2O}$ to carbohydrates (and other plant material) and the release of $\\ce{O2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosynthesis" .

goldbook:P04656 a skos:Concept ;
    skos:definition "An effect produced by photoexcitation resulting partially or totally in the production of heat." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photothermal effect" .

goldbook:P04657 a skos:Concept ;
    skos:definition "A process utilizing both light and heat, simultaneously or sequentially, for image recording." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photothermography" .

goldbook:P04658 a skos:Concept ;
    skos:altLabel "FET" ;
    skos:definition "A bipolar transistor with its base-collector junction acting as a photodiode, which, if irradiated, controls the response of the device. Due to the inherent current gain (of the transistor) the responsivity of the phototransistor is greater than that of photodiodes. A Darlington phototransistor consists of two separate transistors coupled in the high-impedance Darlington configuration with a phototransistor as the input transistor. A field effect phototransistor or photo-FET is a field effect transistor (FET) that employs photogeneration of carriers in the channel region (the neutral region sandwiched between the insulator and the depletion region under the gate of the FET). It is characterized by high responsivity due to the high current gain of the FET." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phototransistor" .

goldbook:P04659 a skos:Concept ;
    skos:definition "A solid state device, usually a semiconductor such as silicon, which absorbs photons with energies higher than or equal to the bandgap energy and simultaneously produces electric power." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photovoltaic cell" .

goldbook:P04660 a skos:Concept ;
    skos:definition "A plot of observed rate coefficient, or more usually its decadic logarithm, against pH of solution, other variables being kept constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pH-rate profile" .

goldbook:P04662 a skos:Concept ;
    skos:definition "3,3-Bis(hydroxyaryl)-2-benzofuran-1(3H)-ones generally derived from the condensation of phthalic anhydride with phenols. E.g. phenolphthalein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phthaleins" .

goldbook:P04663 a skos:Concept ;
    skos:definition "3,3-Di(hydrocarbyl) or 3-hydrocarbylidene-2-benzofuran-1(3H)-ones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phthalides" .

goldbook:P04665 a skos:Concept ;
    skos:definition "Polymer network with junction points or zones formed by physically interacting chains which need not be permanent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "physical network" .

goldbook:P04667 a skos:Concept ;
    skos:altLabel "physical adsorption",
        "van der Waals adsorption" ;
    skos:definition "Adsorption in which the forces involved are intermolecular forces (van der Waals forces) of the same kind as those responsible for the imperfection of real gases and the condensation vapours, and which do not involve a significant change in the electronic orbital patterns of the species involved. The term 'van der Waals adsorption' is synonymous with physical adsorption, but its use is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "physisorption" .

goldbook:P04668 a skos:Concept ;
    skos:definition "An agent which produces a toxic effect in vegetation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phytotoxicant" .

goldbook:P04670 a skos:Concept ;
    skos:definition "SI prefix for \\(10^{-12}\\) (symbol: \\(\\mathrm{p}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pico" .

goldbook:P04671 a skos:Concept ;
    skos:definition "Salts or charge-transfer complexes of picric acid (2,4,6-trinitrophenol)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "picrates" .

goldbook:P04672 a skos:Concept ;
    skos:definition "Luminescence observed when certain solids are subjected to a change in pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "piezoluminescence" .

goldbook:P04673 a skos:Concept ;
    skos:definition "The processing by a radiation spectrometer of pulses resulting from the simultaneous adsorption of independent particles or photons in a radiation detector. As a result they are counted as one single particle or photon with energy between the individual energies and the sum of these energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pile-up" .

goldbook:P04674 a skos:Concept ;
    skos:definition "Tetra(hydrocarbyl)ethane-1,2-diols, $\\ce{R2C(OH)–(OH)R2}$, of which the tetramethyl example is the simplest one and is itself commonly known as pinacol (benzpinacol is the tetraphenyl analogue)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pinacols" .

goldbook:P04676 a skos:Concept ;
    skos:altLabel "PIN" ;
    skos:definition "A semiconductor detector consisting of a compensated region between a p and a n region. The compensated region is often referred to as intrinsic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "PIN semiconductor detector" .

goldbook:P04677 a skos:Concept ;
    skos:definition "A residue from pyrolysis of organic material or tar distillation which is solid at room temperature, consisting of a complex mixture of numerous, essentially aromatic hydrocarbons and heterocyclic compounds. It exhibits a broad softening range instead of a defined melting temperature. When cooled from the melt, pitches solidify without crystallization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pitch" .

goldbook:P04678 a skos:Concept ;
    skos:definition "Carbon fibres obtained from pitch precursor fibres after stabilization treatment, carbonization and final heat treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pitch-based carbon fibres" .

goldbook:P04679 a skos:Concept ;
    skos:definition "A special type of non-uniform corrosion of passive metals, resulting in the formation of pits, which usually occurs in the presence of certain anions at electrode potentials positive to a critical pitting potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pitting corrosion" .

goldbook:P04681 a skos:Concept ;
    skos:altLabel "planar stereoisomerism" ;
    skos:definition "Term used by some authorities to refer to stereoisomerism resulting from the arrangement of out-of-plane groups with respect to a plane (chirality plane). It is exemplified by the atropisomerism of (E)-cyclooctene (chiral plane = double bond and attached atoms) or monosubstituted paracyclophane (chiral plane = substituted ring). The configuration of molecular entities possessing planar chirality is specified by the stereodescriptors \\(R_{\\rm{p}}\\) and \\(S_{\\rm{p}}\\) (or \\(P\\) and \\(M\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planar chirality" .

goldbook:P04682 a skos:Concept ;
    skos:altLabel "PC" ;
    skos:definition "A separation technique in which the stationary phase is present as or on a plane. The plane can be a paper, serving as such or impregnated by a substrate as the stationary bed (paper chromatography, PC) or a layer of solid particles spread on a support e.g. a glass plate (thin layer chromatography, TLC). Sometimes planar chromatography is also termed open-bed chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planar chromatography" .

goldbook:P04683 a skos:Concept ;
    skos:definition "A film whose boundaries are represented by ideal parallel planes. The planar film thickness is defined as the distance between these planes. The terms nanometre thick film, micrometre thick film and millimetre thick film refer specifically to film thickness in the ranges \\(0.1{-}100\\ \\rm{nm}\\), \\(0.1{-}100\\ \\unicode[Times]{x3BC}\\rm{m}\\) and \\(0.1{-}100\\ \\rm{mm}\\), respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planar film" .

goldbook:P04685 a skos:Concept ;
    skos:definition "The Planck constant, \\(h\\), is one of seven fixed constants defining the International System of Units, the SI, with \\(h = \\pu{6.62607015E-34 J s}\\). The Planck constant is considered as a fundamental constant of nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Planck constant" .

goldbook:P04688 a skos:Concept ;
    skos:altLabel "fission fragment ionization" ;
    skos:definition "The ionization of any species by interaction with heavy particles (which may be ions or neutral atoms) formed as a result of the fission of a suitable nuclide adjacent to a target supporting the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma desorption ionization" .

goldbook:P04689 a skos:Concept ;
    skos:definition "An extrachromosomal genetic element consisting generally of a circular duplex of DNA which can replicate independently of chromosomal DNA. R-plasmids are responsible for the mutual transfer of antibiotic resistance among microbes. Plasmids are used as vectors for cloning DNA in bacteria or yeast host cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasmid" .

goldbook:P04690 a skos:Concept ;
    skos:definition "Steady flow occurring only above a certain finite stress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plastic flow" .

goldbook:P04691 a skos:Concept ;
    skos:definition "A first-order transition that occurs when a low-temperature phase transforms to an orientationally-disordered high-temperature phase with a strong variation of enthalpy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plastic transition" .

goldbook:P04692 a skos:Concept ;
    skos:definition "Except for free-floating bubbles, films have to be supported by frames, bulk surfaces or other films. The transition zone separating these from the film proper, always containing some bulk liquid, is called a plateau border." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plateau border" .

goldbook:P04693 a skos:Concept ;
    skos:altLabel "HETP",
        "height equivalent to one theoretical plate" ;
    skos:definition "The column length (\\(L\\)) divided by the plate number: \\[H=\\frac{L}{N}\\] It is also called the height equivalent to one theoretical plate (HETP)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate height" .

goldbook:P04694 a skos:Concept ;
    skos:definition "A number indicative of column performance, calculated from the following equations which depend on the selection of the peak width expression: \\[N=(\\frac{V_{\\rm{R}}}{\\sigma })^{2}=(\\frac{t_{\\rm{R}}}{\\sigma })^{2}\\] \\[N=16\\ (\\frac{V_{\\rm{R}}}{w_{\\rm{b}}})^{2}=16\\ (\\frac{t_{\\rm{R}}}{w_{\\rm{b}}})^{2}\\] \\[N=5.545\\ (\\frac{V_{\\rm{R}}}{w_{\\rm{h}}})^{2}=5.545\\ (\\frac{t_{\\rm{R}}}{w_{\\rm{h}}})^{2}\\] The value of 5.545 stands for \\(8\\ \\ln 2\\). These expressions assume a Gaussian (symmetrical) peak. In these expressions the units for the quantities inside the brackets must be consistent so that their ratio is dimensionless: i.e. if the numerator is a volume, then peak width must also be expressed in terms of volume. In former nomenclature the expressions 'number of theoretical plates' or 'theoretical plate number' were used for the same term. For simplification, the present name is suggested." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plate number" .

goldbook:P04695 a skos:Concept ;
    skos:definition "A gene affecting more than one (apparently unrelated) characteristic of the phenotype." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pleiotropic gene" .

goldbook:P04696 a skos:Concept ;
    skos:definition "A term indicating the number of sets of chromosomes present in an organism, e.g. haploid (one) or diploid (two)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ploidy" .

goldbook:P04697 a skos:Concept ;
    skos:definition "A packed bed flow reactor is commonly called a fixed bed reactor and the term plug-flow is also used to indicate that no attempt is made to back-mix the reaction mixture as it passes through the catalyst bed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plug-flow" .

goldbook:P04699 a skos:Concept ;
    skos:altLabel "plumbylenes" ;
    skos:definition "Carbene analogues having the structure $\\ce{R2Pb{:}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plumbylidenes" .

goldbook:P04700 a skos:Concept ;
    skos:definition "The gaseous and aerosol effluents which are emitted from a chimney and the volume of space which they occupy (often visible). The shape of the plume and the concentrations of pollutants in it at various points along the path of the plume are sensitive functions of the meteorology, local topography and the chemistry which occurs in the plume. Urban plumes are observed over many urban areas and downwind of these areas in which a combination of man sources of pollution are concentrated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plume" .

goldbook:P04702 a skos:Concept ;
    skos:definition "A pressure-sensitive detector based on the pressure increase of a gas. A special type is the Golay cell where the pressure change is detected by observing the deflection off one of the chamber walls." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pneumatic detector" .

goldbook:P04703 a skos:Concept ;
    skos:definition "The classification of the symmetry elements of an object. It is denoted in the Schoenflies notation by an italic symbol, such as \\(C_{3}\\), \\(D_{2}\\), \\(T_{\\rm{d}}\\), etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "point group" .

goldbook:P04704 a skos:Concept ;
    skos:altLabel "PZC" ;
    skos:definition "A surface charge is at its point of zero charge when the surface charge density is zero. It is a value of the negative logarithm of the activity in the bulk of the charge-determining ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "point of zero charge" .

goldbook:P04705 a skos:Concept ;
    skos:definition "cgs unit of dynamic viscosity, \\(\\rm{P} = 0.1\\ \\rm{Pa s}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poise" .

goldbook:P04706 a skos:Concept ;
    skos:definition "An inhibitory substance characterized by its propensity to attach very strongly, by a true chemical bond (e.g. covalent) to the surface atoms or ions constituting the catalytically active sites. Poisons act in minute quantities. Typical poisons are $\\ce{S}$, $\\ce{As}$, etc. In most cases, activity and/or selectivity cannot be recovered without a drastic change in operating conditions (most often a regeneration). recovery, if at all, takes place very slowly and/or only partially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "poison" .

goldbook:P04709 a skos:Concept ;
    skos:definition "For a reactant molecule RY, the polar effect of the group R comprises all the processes whereby a substituent may modify the electrostatic forces operating at the reaction centre Y, relative to the standard \\(\\rm{R}^{\\rm{o}}\\rm{Y}\\). These forces may be governed by charge separations arising from differences in the electronegativity of atoms (leading to the presence of dipoles), the presence of unipoles, or electron delocalization. It is synonymous with electronic effect or 'electrical effect' of a substituent as distinguished from other substituent effects, e.g. steric effects. Sometimes, however, the term 'polar effect' is taken to refer to the influence, other than steric, that non-conjugated substituents exert on reaction rates, i.e. effects connected with electron delocalization between a substituent and the molecular framework to which it is attached are excluded. Polar effect is then not synonymous with electronic effect" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polar effect" .

goldbook:P04710 a skos:Concept ;
    skos:altLabel "polar solvent" ;
    skos:definition "When applied to solvents, this rather ill-defined term covers their overall solvation capability (solvation power) for solutes (i.e. in chemical equilibria: reactants and products; in reaction rates: reactants and activated complex; in light absorptions: ions or molecules in the ground and excited state), which in turn depends on the action of all possible, nonspecific and specific, intermolecular interactions between solute ions or molecules and solvent molecules, excluding such interactions leading to definite chemical alterations of the ions or molecules of the solute. Occasionally, the term solvent polarity is restricted to nonspecific solute/solvent interactions only (i.e. to van der Waals forces)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarity" .

goldbook:P04711 a skos:Concept ;
    skos:definition "The ease of distortion of the electron cloud of a molecular entity by an electric field (such as that due to the proximity of a charged reagent). It is experimentally measured as the ratio of induced dipole moment (\\(\\mu _{\\mathrm{ind}}\\)) to the field \\(E\\) which induces it: \\[\\alpha =\\frac{\\mu _{\\rm{ind}}}{E}\\] The units of \\(\\alpha \\) are \\(\\rm{C}^{2}\\ \\rm{m}^{2}\\ \\rm{V}^{-1}\\). In ordinary usage the term refers to the 'mean polarizability', i.e., the average over three rectilinear axes of the molecule. Polarizabilities in different directions (e.g. along the bond in $\\ce{Cl2}$, called 'longitudinal polarizability', and in the direction perpendicular to the bond, called 'transverse polarizability') can be distinguished, at least in principle. Polarizability along the bond joining a substituent to the rest of the molecule is seen in certain modern theoretical approaches as a factor influencing chemical reactivity, etc., and parametrization thereof has been proposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarizability" .

goldbook:P04712 a skos:Concept ;
    skos:definition "The relevant material property that couples with the radiation field. May be called optical or dielectric polarization. Optical spectroscopies may be classified according to the dielectric polarization power-law dependence on the external electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarization" .

goldbook:P04713 a skos:Concept ;
    skos:definition "The difference of the electrode potential from the corrosion potential. The symbol should not be used for polarization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarization" .

goldbook:P04714 a skos:Concept ;
    skos:definition "An error which arises from the fact that the absorbance of a sample (especially a solid) could depend on the polarization of the incident radiation and from the polarization dependent response of the photodetector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarization error" .

goldbook:P04715 a skos:Concept ;
    skos:definition "Ideally, interphases for which there are no common components between the phases or the exchange of these is hindered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polarized interphases" .

goldbook:P04720 a skos:Concept ;
    skos:definition "A polymerization in which the growth of polymer chains proceeds by addition reactions between molecules of all degrees of polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyaddition" .

goldbook:P04722 a skos:Concept ;
    skos:definition "A polymerization in which the growth of polymer chains proceeds by condensation reactions between molecules of all degrees of polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycondensation" .

goldbook:P04723 a skos:Concept ;
    skos:altLabel "HOPG" ;
    skos:definition "A graphite material with coherent crystallographic domains of limited size regardless of the perfection and preferred orientation (texture) of their crystalline structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polycrystalline graphite" .

goldbook:P04726 a skos:Concept ;
    skos:definition "A colloidal system in which many particle sizes occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polydisperse medium" .

goldbook:P04728 a skos:Concept ;
    skos:altLabel "polymer electrolyte",
        "polymeric electrolyte" ;
    skos:definition "Polymer composed of macromolecules in which a substantial portion of the constitutional units contains ionic or ionizable groups, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyelectrolyte" .

goldbook:P04730 a skos:Concept ;
    skos:definition "A carbon material composed of grains, which can be clearly distinguished by means of optical microscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polygranular carbon" .

goldbook:P04731 a skos:Concept ;
    skos:definition "A graphite material composed of grains which can be clearly distinguished by means of optical microscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polygranular graphite" .

goldbook:P04732 a skos:Concept ;
    skos:definition "Polycyclic hydrocarbons of the $\\ce{(CH)_{n}}$ series having skeletons corresponding to the regular and semiregular geometrical solids, e.g. cubane," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyhedranes" .

goldbook:P04733 a skos:Concept ;
    skos:definition "Polycations or polyanions — multiply charged ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyions" .

goldbook:P04734 a skos:Concept ;
    skos:altLabel "acetogenins",
        "ketides" ;
    skos:definition "Natural compounds containing alternating carbonyl and methylene groups ('$\\ce{\\upbeta\\!\\mbox{-}polyketones}$'), biogenetically derived from repeated condensation of acetyl coenzyme A (via malonyl coenzyme A), and usually the compounds derived from them by further condensations. Considered by many to be synonymous with the less frequently used terms acetogenins and ketides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyketides" .

goldbook:P04735 a skos:Concept ;
    skos:definition "A substance composed of macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer" .

goldbook:P04736 a skos:Concept ;
    skos:definition "Macroscopically homogeneous mixture of two or more different species of polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer blend" .

goldbook:P04740 a skos:Concept ;
    skos:definition "The process of converting a monomer mixture of monomers into a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymerization" .

goldbook:P04743 a skos:Concept ;
    skos:definition "Complex, at least two components of which are different polymers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer–polymer complex" .

goldbook:P04748 a skos:Concept ;
    skos:altLabel "enantiotropic transition" ;
    skos:definition "A reversible transition of a solid crystalline phase at a certain temperature and pressure (the inversion point) to another phase of the same chemical composition with a different crystal structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymorphic transition" .

goldbook:P04749 a skos:Concept ;
    skos:definition "Peptides containing ten or more amino acid residues." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polypeptides" .

goldbook:P04750 a skos:Concept ;
    skos:definition "A subgroup of prenols in which \\(n\\) in the general formula $\\ce{H–[CH2–C(CH3)=CH–CH2]_{n}–OH}$ is greater than four." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyprenols" .

goldbook:P04751 a skos:Concept ;
    skos:definition "Saturated or unsaturated, respectively, polycyclic hydrocarbons consisting of fused five-membered rings, commonly but not necessarily incorporating the skeleton of quinacene (tricyclo[5.2.1.04,10]deca-2,5,8-triene): E.g.  bicyclo[3.3.0]octane, dodecahedrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyquinanes" .

goldbook:P04752 a skos:Concept ;
    skos:definition "Compounds consisting of a large number of monosaccharides linked glycosidically. This term is commonly used only for those containing more than ten monosaccharide residues. Also called glycans." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysaccharides" .

goldbook:P04753 a skos:Concept ;
    skos:definition "Compounds having an unbranched chain of sulfur atoms ($\\ce{s2}$ or higher) terminating in H: $\\ce{HS_{n}H}$. Some chemists exclude disulfane, $\\ce{HS2H}$, from the class polysulfanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysulfanes" .

goldbook:P04754 a skos:Concept ;
    skos:definition "Compounds $\\ce{R–[S]_{n}–R}$, with a chain of sulfur atoms (\\(n\\geq 2\\)) and $\\ce{R}  eq \\ce{H}$. Some chemists exclude disulfides, $\\ce{RS2R}$, from the class polysulfides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polysulfides" .

goldbook:P04755 a skos:Concept ;
    skos:definition "Stereoisomerization interconverting different or equivalent spatial arrangements of ligands about a central atom or of a cage of atoms, where the ligand or cage defines the vertices of a polyhedron. For example pyramidal inversion of amines, Berry pseudorotation of $\\ce{PF5}$, rearrangements of polyhedral boranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polytopal rearrangement" .

goldbook:P04756 a skos:Concept ;
    skos:definition "A transition of a crystalline structure into one or more forms which differ in the way identical layers of atoms are stacked. Example: $\\ce{ZnS}$ consists of two identical close packings, one of $\\ce{Zn}$ atoms, the other $\\ce{S}$ atoms, with the one displaced to the other along the c-axis through one-quarter of the layer spacing. In sphalerite-type $\\ce{ZnS}$ the layers have the face-centred-cubic (ABC ABC) sequence, in wurtzite-type $\\ce{ZnS}$ they have the hexagonal-close-packed (AB AB) sequence. The transition of sphalerite-type $\\ce{ZnS}$ to wurtzite-type $\\ce{ZnS}$ occurs at \\(1297\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polytypic transition" .

goldbook:P04758 a skos:Concept ;
    skos:definition "A problem often arises when the combination of several series of measurements performed under similar conditions is desired to achieve an improved estimate of the imprecision of the process. If it can be assumed that all the series are of the same precision although their means may differ, the pooled standard deviations \\(s_{\\rm{p}}\\) from \\(k\\) series of measurements can be calculated as \\[s_{\\rm{p}}=\\sqrt{\\frac{(n_{1}- 1)\\ s_{1}^{2}+(n_{2}- 1)\\ s_{2}^{2}+...+(n_{k}- 1)\\ s_{k}^{2}}{n_{1}+n_{2}+...+n_{k}- k}}\\] The suffices \\(1,2,...,k\\) refer to the different series of measurements. In this case it is assumed that there exists a single underlying standard deviation \\(\\sigma \\) of which the pooled standard deviation \\(s_{\\rm{p}}\\) is a better estimate than the individual calculated standard deviations \\(s_{1},s_{2},...,s_{k}\\), For the special case where \\(k\\) sets of duplicate measurements are available, the above equation reduces to \\[s_{\\rm{p}}=\\sqrt{\\frac{\\sum (x_{i1}- x_{i2})^{2}}{2\\ k}}\\] Results from various series of measurements can be combined in the following way to give a pooled relative standard deviation \\(s_{\\rm{r,p}}\\): \\[s_{\\rm{r,p}} = \\sqrt{\\frac{\\sum (n_{i}-1)\\ s_{\\rm{r,}i}^{2}}{\\sum n_{i}- 1}} = \\sqrt{\\frac{\\sum (n_{i}-1)\\ s_{i}^{2}\\ x_{i}^{-2}}{\\sum n_{i}-1}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pooled standard deviation" .

goldbook:P04759 a skos:Concept ;
    skos:definition "A situation in which a higher energy state is more populated than a lower energy state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "population inversion" .

goldbook:P04760 a skos:Concept ;
    skos:definition "The distribution of pore volume with respect to pore size; alternatively, it may be defined by the related distribution of pore area with respect to pore size." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pore size distribution" .

goldbook:P04762 a skos:Concept ;
    skos:definition "A concept related to texture, referring to the pore space in a material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porosity" .

goldbook:P04763 a skos:Concept ;
    skos:altLabel "PLOT",
        "PLOT column" ;
    skos:definition "A column in which there is a porous layer on the inner wall. porosity can be achieved by either chemical means (e.g. etching) or by the deposition of porous particles on the wall from a suspension. The porous layer may serve as a support for a liquid stationary phase or as the stationary phase itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porous-layer open-tabular column" .

goldbook:P04764 a skos:Concept ;
    skos:definition "Hexahydroporphyrins in which the nitrogen atoms and four meso positions are saturated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porphyrinogens" .

goldbook:P04765 a skos:Concept ;
    skos:definition "Natural pigments containing a fundamental skeleton of four pyrrole nuclei united through the $\\ce{\\upalpha\\!\\mbox{-}positions}$ by four methine groups to form a macrocyclic structure (porphyrin is designated porphine in Chemical Abstracts indexes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "porphyrins" .

goldbook:P04766 a skos:Concept ;
    skos:definition "In position-sensitive photomultiplier tubes spatial resolution is obtained with the help of a partitioned photocathode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "position-sensitive photomultiplier tube" .

goldbook:P04768 a skos:Concept ;
    skos:definition "This is an atom, radical, molecule or molecular moiety which has lost one of more electrons thereby attaining an electrically positive charge. The use of the term cation as an alternative is not recommended. The use of mass ion is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positive ion" .

goldbook:P04769 a skos:Concept ;
    skos:definition "A positively charged electron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "positron" .

goldbook:P04771 a skos:Concept ;
    skos:definition "A version of reaction chromatography in which the separated components eluting from the column are derivatized prior to entering the detector. The derivatization process is generally carried out 'on-the-fly', i.e. during transfer of the sample components from the column to the detector. Derivatization may also be carried out before the sample enters the column or the planar medium; this is pre-column (preliminary) derivatization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-column derivatization" .

goldbook:P04772 a skos:Concept ;
    skos:definition "This effect arises when the exciting beam does not fill the cell completely and luminescence is absorbed by the analyte and interfering impurities in the non-illuminated region facing the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "post-filter effect" .

goldbook:P04775 a skos:Concept ;
    skos:altLabel "PZC" ;
    skos:definition "The value of the electric potential of an electrode at which one of the charges defined is zero. The reference electrode against which this is measured should always be clearly stated. The potential difference with respect to the potential of zero charge is defined by \\[E_{\\rm{pzc}}=E- E_{\\sigma =0}\\] where the potential at the point of zero charge is that for the given electrode in the absence of specific adsorption (other than that of the solvent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential at the point of zero charge" .

goldbook:P04776 a skos:Concept ;
    skos:altLabel "p.d.",
        "p.d. ions" ;
    skos:definition "Those species which by virtue of their electron distribution between the solid and liquid phase (or by their equilibrium with electrons in the solid) determine the difference in Galvani potential between these phases. This definition requires that adsorbed p.d. ions are part of the adsorbent and belong to the category of surface ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential-determining ions" .

goldbook:P04779 a skos:Concept ;
    skos:definition "A curve describing the variation of the potential energy of the system of atoms that make up the reactants and products of a reaction as a function of one geometric coordinate, and corresponding to the 'energetically easiest passage' from reactants to products (i.e. along the line produced by joining the paths of steepest descent from the transition state to the reactants and to the products). For an elementary reaction the relevant geometric coordinate is the reaction coordinate ; for a stepwise reaction it is the succession of reaction coordinates for the successive individual reaction steps. (The reaction coordinate is sometimes approximated by a quasi-chemical index of reaction progress, such as 'degree of atom transfer' or bond order of some specified bond.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential-energy profile" .

goldbook:P04780 a skos:Concept ;
    skos:altLabel "potential-energy reaction surface" ;
    skos:definition "A geometric hypersurface on which the potential energy of a set of reactants is plotted as a function of the coordinates representing the molecular geometries of the system. For simple systems two such coordinates (characterizing two variables that change during the progress from reactants to products) can be selected, and the potential energy plotted as a contour map. For simple elementary reactions, e.g. \\(\\rm{A}\\!-\\!\\rm{B}\\,+\\,\\rm{C}\\rightarrow \\rm{A}\\,+\\,\\rm{B}\\!-\\!\\rm{C}\\) , the surface can show the potential energy for all values of the A, B, C geometry, providing that the ABC angle is fixed. For more complicated reactions a different choice of two coordinates is sometimes preferred, e.g. the bond orders of two different bonds. Such a diagram is often arranged so that reactants are located at the bottom left corner and products at the top right. If the trace of the representative point characterizing the route from reactants to products follows two adjacent edges of the diagram, the changes represented by the two coordinates take place in distinct succession; if the trace leaves the edges and crosses the interior of the diagram, the two changes are concerted. In many qualitative applications it is convenient (although not strictly equivalent) for the third coordinate to represent the standard Gibbs energy rather than potential energy. Using bond orders is, however, an oversimplification, since these are not well-defined, even for the transition state. (Some reservations concerning the diagrammatic use of Gibbs energies are noted under Gibbs energy diagram). The energetically easiest route from reactants to products on the potential-energy contour map defines the potential-energy profile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential-energy surface" .

goldbook:P04787 a skos:Concept ;
    skos:definition "The temperature that a dry air parcel would have if lowered or raised adiabatically to a level of 1000 \\(\\rm{mbar}\\) pressure (or other arbitrary standard pressure)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potential temperature" .

goldbook:P04788 a skos:Concept ;
    skos:definition "Dependent action in which a substance or physical agent at a concentration or dose that does not itself have an adverse effect enhances the harm done by another substance or physical agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiation" .

goldbook:P04789 a skos:Concept ;
    skos:definition "In electronics, a sensitive voltage measuring device based on a null technique which provides infinite impedance at null.In chemistry, potentiometric methods involve the measurement with a potentiometer of voltage generated in a cell. A high impedance digital voltmeter is often used today as a convenient alternative to a potentiometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometer" .

goldbook:P04790 a skos:Concept ;
    skos:definition "A detection method in which the potential of a cell is related to the concentration (activity) of a reactant which is a component of the cell fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometric detection method" .

goldbook:P04791 a skos:Concept ;
    skos:definition "A coefficient which defines the ability of an ion-selective electrode to distinguish a particular ion from others. The selectivity coefficient, \\(K_{\\rm{A,B}}^{\\rm{pot}}\\), is evaluated by means of the emf response of the ion-selective electrode in mixed solutions of the primary ion, A, and interfering ion, B (fixed interference method) or less desirable, in separate solutions of A and B (separate solution method). The activities of the primary ion, A, and the interfering ion, B, at which \\(K_{\\rm{A,B}}^{\\rm{pot}}\\) is determined should always be specified, as the value of \\(K_{\\rm{A,B}}^{\\rm{pot}}\\) is defined by the modified Nikolsky–Eisenman equation. The smaller the value of \\(K_{\\rm{A,B}}^{\\rm{pot}}\\) the greater the electrode's preference for the principal ion, A. Comment: The terms selectivity constant and selectivity factor are frequently used instead of selectivity coefficient. However, in order to standardize the terminology associated with ion-selective electrodes, use of the term selectivity coefficient is recommended, as is the fixed interference method for its evaluation. This selectivity coefficient is not identical to the similar term used in separation science." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "potentiometric selectivity coefficient" .

goldbook:P04792 a skos:Concept ;
    skos:definition "Rate of energy transfer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "power" .

goldbook:P04794 a skos:Concept ;
    skos:definition "A step on the reaction path of some stepwise reactions in which the molecular entity C is already present in an encounter pair or encounter complex with A during the formation of B from A, e.g.  In this mechanism the chemical species C may but does not necessarily assist the formation of B from A, which may itself be a bimolecular reaction with some other reagent. Pre-association is important when B is too short-lived to permit B and C to come together by diffusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-association" .

goldbook:P04795 a skos:Concept ;
    skos:definition "The sedimentation of a solid material (a precipitate) from a liquid solution in which the material is present in amounts greater than its solubility in the liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitation" .

goldbook:P04799 a skos:Concept ;
    skos:definition "The closeness of agreement between independent test results obtained by applying the experimental procedure under stipulated conditions. The smaller the random part of the experimental errors which affect the results, the more precise the procedure. A measure of precision (or imprecision) is the standard deviation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precision" .

goldbook:P04803 a skos:Concept ;
    skos:definition "An operation (process) as a result of which the ratio of the concentration or the amount of microcomponents (trace constituents) and macrocomponents (matrix) increases. The term enrichment is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preconcentration" .

goldbook:P04804 a skos:Concept ;
    skos:definition "This is defined as \\[K = \\frac{Q_{\\rm{T}}/Q_{\\rm{M}}}{Q_{\\rm{T}}^{\\rm{o}}/Q_{\\rm{M}}^{\\rm{o}}}\\] where \\(Q_{\\rm{T}}\\) and \\(Q_{\\rm{T}}^{\\rm{o}}\\) are the quantities of the microcomponent in the concentrate and in the sample, respectively (mass units or concentration units), and \\(Q_{\\rm{M}}^{\\rm{o}}\\) and \\(Q_{\\rm{M}}\\) and are the quantities of the matrix before and after preconcentration, respectively. If the recovery is 100%, \\(K=\\frac{Q_{\\rm{M}}^{\\rm{o}}}{Q_{\\rm{M}}}\\). The terms enrichment coefficient and enrichment factor are not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "preconcentration coefficient" .

goldbook:P04805 a skos:Concept ;
    skos:definition "Of a nuclide, any radioactive nuclide which precedes that nuclide in a decay chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precursor" .

goldbook:P04806 a skos:Concept ;
    skos:definition "May either indicate an encounter complex or a collision complex, but furthermore implies that this complex undergoes a reaction (e.g. electron transfer)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precursor complex" .

goldbook:P04807 a skos:Concept ;
    skos:definition "Synonymous with parent ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precursor ion" .

goldbook:P04808 a skos:Concept ;
    skos:definition "Dissociation occurring by tunnelling from a 'bound' to an 'unbound' vibronic state. In an absorption spectrum of a molecular entity, the appearance of a diffuse band region within a series of sharp bands is called predissociation, since irradiation with frequencies within the diffuse region leads to effective dissociation. The energy of the band is smaller than that of the dissociation continuum of the bound state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "predissociation" .

goldbook:P04809 a skos:Concept ;
    skos:definition "Preliminary treatment of a solvent in order to convert the extractants into a suitable chemical form.Notes:The use of equilibration in this sense is confusing and should be avoided.The term conditioning may be used as a synonym for pre-equilibration.Preliminary treatment of either phase with a suitable solution of the other phase (in the absence of main extractable solute(s)) so that when the subsequent equilibration is carried out changes in the (volume) phase ratio or in the concentrations of other components are minimized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-equilibrium" .

goldbook:P04810 a skos:Concept ;
    skos:altLabel "prior equilibrium" ;
    skos:definition "A rapidly reversible step preceding the rate-limiting step in a stepwise reaction. For example:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-equilibrium" .

goldbook:P04811 a skos:Concept ;
    skos:altLabel "<i>A</i>-factor",
        "Arrhenius A factor" ;
    skos:definition "Coefficient in front of the exponential factor expressing the empirical temperature dependence of the rate coefficient, \\(k\\), on temperature, \\(T\\), \\(k=A\\ \\exp (- E_{\\rm{a}}/R\\ T)\\), where \\(E_{\\rm{a}}\\) is the activation energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-exponential factor" .

goldbook:P04813 a skos:Concept ;
    skos:definition "This effect arises when the luminescence detector does not see a portion of the luminescent volume where the excitation beam enters the sample. Thus the exciting beam flux is reduced by absorption by the analyte and interfering impurities before it enters the volume observed by the detection system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-filter effect" .

goldbook:P04814 a skos:Concept ;
    skos:definition "An extremely well graphitizing carbon with a high degree of optical anisotropy (isochromatic areas of optical texture above about \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\)) and which is characterized by a combination of the following properties which differ significantly from those of regular coke: high real density, low reversible thermal expansion and low ash content combined, in most cases, with low sulfur content." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "premium coke" .

goldbook:P04816 a skos:Concept ;
    skos:definition "Alcohols possessing the general formula $\\ce{H–[CH2C(Me)=CHCH2]_{n}OH}$ in which the carbon skeleton is composed of one or more isoprene units (biogenetic precursors of the isoprenoids)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prenols" .

goldbook:P04817 a skos:Concept ;
    skos:definition "A polymer or oligomer composed of pre-polymer molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-polymer" .

goldbook:P04818 a skos:Concept ;
    skos:definition "A macromolecule or oligomer molecule capable of entering, through reactive groups, into further polymerization, thereby contributing more than one monomeric unit to at least one chain of the final macromolecule. A pre-polymer molecule capable of entering into further polymerization through reactive end-groups, often deliberately introduced, is known as a telechelic molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-polymer molecule" .

goldbook:P04819 a skos:Concept ;
    skos:definition "Normal force acting on a surface divided by the area of that surface. For a mixture of gases the contribution by each constituent is called the 'partial pressure' \\(p_{i} = x_{i} p\\), where \\(x_{i}\\) is the amount fraction of the \\(i\\)th constituent and \\(p\\) is the total pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pressure" .

goldbook:P04822 a skos:Concept ;
    skos:definition "A transition induced by a change of pressure. Example: The room-temperature transition of $\\ce{CdS}$ with a wurtzite-type structure, at \\(1.74\\ \\rm{GPa}\\), to $\\ce{CdS}$ with a $\\ce{NaCl}$-type structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pressure-induced transition" .

goldbook:P04824 a skos:Concept ;
    skos:definition "A detector which employs the pressure change which results from the absorption of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pressure-sensitive detector" .

goldbook:P04826 a skos:Concept ;
    skos:definition "Following the preparation of a catalyst or following its insertion into a catalytic reactor, it is often subjected to various treatments before the start of a catalytic run. The term pretreatment may, in general, be applied to this set of treatments. In some cases the word activation is used. It implies that the material is converted into a catalyst or into a very much more effective one by the pretreatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pretreatment" .

goldbook:P04829 a skos:Concept ;
    skos:altLabel "pe" ;
    skos:definition "Electrons generated by a thermal or field emission source used to bombard the specimen for generation of the analytical signals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary electrons" .

goldbook:P04831 a skos:Concept ;
    skos:definition "A kinetic isotope effect attributable to isotopic substitution of an atom to which a bond is made or broken in the rate-controlling step or in a pre-equilibrium step of a specified reaction. The corresponding isotope effect on the equilibrium constant of a reaction in which one or more bonds to isotopic atoms are broken, is called a 'primary equilibrium isotope effect'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary isotope effect" .

goldbook:P04834 a skos:Concept ;
    skos:definition "A mixture obtained directly from two or more components intended for the preparation of more dilute calibration mixtures (called secondary or tertiary mixtures)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary mixture" .

goldbook:P04836 a skos:Concept ;
    skos:altLabel "primary photoreaction" ;
    skos:definition "Any elementary chemical process undergone by an electronically excited molecular entity and yielding a primary photoproduct." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary photochemical process" .

goldbook:P04838 a skos:Concept ;
    skos:definition "A pollutant emitted directly into the air from identifiable sources (e.g. $\\ce{SO2}$, $\\ce{NO}$, hydrocarbons, etc.). Secondary pollutants, such as ozone, are generated within the atmosphere through chemical changes which occur in primary pollutants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary pollutant" .

goldbook:P04840 a skos:Concept ;
    skos:definition "The first observable chemical entity which is produced in the primary photochemical process and which is chemically different from the reactant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary photoproduct" .

goldbook:P04841 a skos:Concept ;
    skos:definition "The collection of one or more increments or units initially taken from a population. The portions may be either combined (composited or bulked sample) or kept separate (gross sample). If combined and mixed to homogeneity, it is a blended bulk sample. The term 'bulk sample' is commonly used in the sampling literature as the sample formed by combining increments. The term is ambiguous since it could also mean a sample from a bulk lot and it does not indicate whether the increments or units are kept separate or combined. Such use should be discouraged because less ambiguous alternative terms (composite sample, aggregate sample) are available. 'Lot sample' and 'batch sample' have also been used for this concept, but they are self limiting terms. The use of 'primary' in this sense is not meant to imply the necessity for multistage sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary sample" .

goldbook:P04843 a skos:Concept ;
    skos:definition "In the context of macromolecules such as proteins, constitutional formula, usually abbreviated to a statement of the sequence and if appropriate cross-linking of chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primary structure" .

goldbook:P04845 a skos:Concept ;
    skos:definition "One of the conceptually simpler molecular changes into which an elementary reaction can be notionally dissected. Such changes include bond rupture, bond formation, internal rotation, change of bond length or bond angle, bond migration, redistribution of charge, etc. The concept of primitive changes is helpful in the detailed verbal description of elementary reactions, but a primitive change does not represent a process that is by itself necessarily observable as a component of an elementary reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "primitive change" .

goldbook:P04846 a skos:Concept ;
    skos:definition "The characteristic group chosen for citation at the end of a name by a suffix or a class name." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal group" .

goldbook:P04847 a skos:Concept ;
    skos:definition "A molecular or fragment ion which is made up of the most abundant isotopes of each of its atomic constituents. In the case of compounds that have been artifically isotopically enriched in one or more positions such as $\\ce{CH3^{13}CH3}$ or $\\ce{CH2D2}$ the principal ion may be defined by treating the heavy isotopes as new atomic species. Thus, in the above two examples, the principal ions would be of masses 31 and 18, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principal ion" .

goldbook:P04849 a skos:Concept ;
    skos:definition "The hypothesis that, for given reactants, the reactions involving the smallest change in nuclear positions will have the lowest energy of activation. (It is also often simply referred to as principle of least motion.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principle of least nuclear motion" .

goldbook:P04850 a skos:Concept ;
    skos:definition "In a reversible reaction, the mechanism in one direction is exactly the reverse of the mechanism in the other direction. This does not apply to reactions that begin with a photochemical excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "principle of microscopic reversibility" .

goldbook:P04852 a skos:Concept ;
    skos:definition "A product state distribution calculated on the basis of some physical model for the reaction. The distribution usually referred to is that of the products at the instant of their formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prior distribution" .

goldbook:P04857 a skos:Concept ;
    skos:definition "A specific DNA or RNA sequence which has been labelled by radioactivity, fluorescence labels or chemiluminescence labels and which is used to detect complementary sequences by hybridization techniques such as blotting or colony hybridization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "probe" .

goldbook:P04858 a skos:Concept ;
    skos:definition "A phenomenon by which change takes place in a system. In physiological systems, a process may be chemical, physical or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "process" .

goldbook:P04859 a skos:Concept ;
    skos:definition "This term is used in different, sometimes contradictory ways; four are listed below.The geometric property of an achiral object (or spatial arrangement of points or atoms) which is capable of becoming chiral in a single desymmetrization step. An achiral molecular entity, or a part of it considered on its own, is thus called prochiral if it can be made chiral by the replacement of an existing atom (or achiral group) by a different one. An achiral object which is capable of becoming chiral in two desymmetrization steps is sometimes described as proprochiral. For example the proprochiral $\\ce{CH3CO2H}$ becomes prochiral as $\\ce{CH2DCO2H}$ and chiral as $\\ce{CHDTCO2H}$.The term prochirality also applies to an achiral molecule or entity which contains a trigonal system and which can be made chiral by the addition to the trigonal system of a new atom or achiral group. For example addition of hydrogen to one of the enantiotopic faces of the prochiral ketone $\\ce{CH3CH2COCH3}$ gives one of the enantiomers of the chiral alcohol $\\ce{CH3CH2CHOHCH3}$; the addition of $\\ce{CN^{−}}$ to one of the diastereotopic faces of the chiral aldehyde shown below converts it into one of the diastereoisomers of the cyanohydrin. The two faces of the trigonal system may be described as Re and Si. The term prochiral also applies to a tetrahedral atom of an achiral or chiral molecule which is bonded to two stereoheterotopic groups. For example, the prochiral molecule $\\ce{CH3CH2OH}$ can be converted into the chiral molecule $\\ce{CH3CHDOH}$ by the isotopic replacement of one of the two enantiotopic hydrogen atoms of the methylene group. The carbon atom of the methylene group is called prochiral. The prochiral molecule $\\ce{HO2CCH2CHOHCH2CO2H}$ can be converted into a chiral product by esterification of one of the two enantiotopic $\\ce{–CH2CO2H}$ groups. The carbon atom of the $\\ce{CHOH}$ group is called prochiral. The chiral molecule $\\ce{CH3CHOHCH2CH3}$ can be converted into one of the diastereoisomers of $\\ce{CH3CHOHCHDCH3}$ by the isotopic replacement of one of the two diastereotopic hydrogen atoms of the methylene group. The carbon atom of the methylene group is called prochiral. The stereoheterotopic groups in these cases may be described as pro-R or pro-S. Reference to the two stereoheterotopic groups themselves as prochiral, although common, is strongly discouraged.See: chirality centreThe term prochirality is also applied to the enantiotopic faces of a trigonal system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prochirality" .

goldbook:P04860 a skos:Concept ;
    skos:definition "An atom of a molecule which becomes a chirality centre by replacing one of the two stereoheterotopic ligands attached to it by a different ligand, e.g. C-1 of ethanol; C-3 of butan-2-ol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prochirality centre" .

goldbook:P04861 a skos:Concept ;
    skos:definition "A substance that is formed during a chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product" .

goldbook:P04862 a skos:Concept ;
    skos:definition "The step of a stepwise reaction in which the product distribution is determined. The product-determining step may be identical to, or occur later than, the rate-controlling step on the reaction coordinate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product-determining step" .

goldbook:P04863 a skos:Concept ;
    skos:definition "The term is used for reactions under kinetic control where the selectivity parallels the relative (thermodynamic) stabilities of the products. Product development control is usually associated with a transition state occurring late on the reaction coordinate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product development control" .

goldbook:P04864 a skos:Concept ;
    skos:definition "Synonymous with daughter ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product ion" .

goldbook:P04865 a skos:Concept ;
    skos:definition "An economical figure denoting the mass of a product formed per unit reactor volume and unit time. Productivity is often referred to per unit of enzyme or biomass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "productivity" .

goldbook:P04866 a skos:Concept ;
    skos:definition "The distribution of available energy among the vibrational, rotational and translation degrees of freedom in the product molecules. The distribution usually referred to is that of the products at the instant of their formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "product state distribution" .

goldbook:P04867 a skos:Concept ;
    skos:definition "One of a pair of identical groups $\\ce{c}$ attached to a double bond (as in $\\ce{abC=Cc2}$) is described as pro-E if, when it is arbitrarily assigned CIP priority over the other group c, the stereodescriptor of the molecule becomes E. The other group $\\ce{c}$ is then described as pro-Z." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>pro-E, pro-Z</i>" .

goldbook:P04869 a skos:Concept ;
    skos:definition "Noun: A set of instructions enabling a device to perform an action. Verb: To provide a set of instructions enabling a device to perform an action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "program" .

goldbook:P04870 a skos:Concept ;
    skos:altLabel "flow programming" ;
    skos:definition "A procedure in which the rate of flow of the mobile phase is changed systematically during a part or whole of the separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "programmed-flow chromatography" .

goldbook:P04871 a skos:Concept ;
    skos:altLabel "pressure programming" ;
    skos:definition "A procedure in which the inlet pressure of the mobile phase is changed systematically during a part or whole of the separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "programmed-pressure chromatography" .

goldbook:P04872 a skos:Concept ;
    skos:altLabel "temperature programming" ;
    skos:definition "A procedure in which the temperature of the column is changed systematically during a part or the whole of the separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "programmed-temperature chromatography" .

goldbook:P04873 a skos:Concept ;
    skos:definition "A formal two-dimensional representation of a three-dimensional molecular structure obtained by projection of bonds (symbolized as lines) onto a plane with or without the designation of the positions of relevant atoms by their chemical symbols. A projection formula which indicates the spatial arrangement of bonds is called a stereochemical formula or stereoformula. Examples of stereoformulae are Fischer projection, Newman projection, sawhorse projection, wedge projection and zig-zag projection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "projection formula" .

goldbook:P04874 a skos:Concept ;
    skos:definition "A mass spectrometer in which ions of different mass/charge are separated by means of crossed electric and magnetic fields in such a way that the selected ions follow a prolate trochoidal path. The usual term 'cycloidal' used sometimes is incorrect because the path used is not cycloidal. A cycloid is a special case of a trochoid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prolate trochoidal mass spectrometer" .

goldbook:P04875 a skos:Concept ;
    skos:altLabel "promoter gene" ;
    skos:definition "The DNA region, usually upsteam to the coding sequence of a gene or operon, which binds and directs RNA polymerase to the correct transcriptional start site and thus permits the initation of transcription." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "promoter" .

goldbook:P04876 a skos:Concept ;
    skos:definition "A relatively small quantity of one or more substances, which when added to a catalyst improves the activity, the selectivity, or the useful lifetime of the catalyst. In general, a promoter may either augment a desired reaction or suppress an undesired one." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "promoter" .

goldbook:P04878 a skos:Concept ;
    skos:definition "The occurrence of two or more events separated by a time interval which is less than a specified small value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prompt coincidence" .

goldbook:P04879 a skos:Concept ;
    skos:definition "Neutrons accompanying the fission process without measurable delay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prompt neutrons" .

goldbook:P04882 a skos:Concept ;
    skos:definition "Tricyclic saturated hydrocarbons, systematically named tricyclo[a.b.c.01,(a+2)]alkanes; have been referred to as [a.b.c]propellanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "propellanes" .

goldbook:P04883 a skos:Concept ;
    skos:definition "A set of data elements (system, component, kind-of-property) common to a set of particular properties, e.g. substance concentration of glucose in blood plasma. Information about identification, time and result is not considered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "property" .

goldbook:P04884 a skos:Concept ;
    skos:definition "The latent state of a phage genome in a lysogenic bacterium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prophage" .

goldbook:P04885 a skos:Concept ;
    skos:definition "A gas-filled X-ray detector in which the electric potential is high enough for the gain to reach a value in the range from \\(10^{2}\\) to \\(10^{5}\\). Each electron produced by the initial photo-ionization causes one avalanche. Since the number of avalanche events is proportional to the energy of the incident photons, the charge collected by the anode is proportional to the X-ray photon energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proportional counter" .

goldbook:P04886 a skos:Concept ;
    skos:definition "A counter tube operated under such conditions that the magnitude of each pulse is proportional to the amount of energy deposited in it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proportional counter tube" .

goldbook:P04887 a skos:Concept ;
    skos:definition "A proportional counter coupled to an ultraviolet sensitive photomultiplier tube. Initial electrons produced by the interaction of the high-energy photon with the counter fill-gas are accelerated by a high electric field where they acquire sufficient energy to excite the noble gas atoms. The resulting UV radiation is observed by a photomultiplier tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proportional gas-scintillation counter" .

goldbook:P04889 a skos:Concept ;
    skos:definition "A stereoheterotopic group $\\ce{c}$ (as in tetrahedral $\\ce{Xabc2}$) is described as pro-R if, when it is arbitrarily assigned CIP priority over the other stereoheterotopic group $\\ce{c}$, the configuration of the thus generated chiral centre is assigned the stereodescriptor R. The other group $\\ce{c}$ is then described as pro-S. This method for distinguishing between stereoheterotopic groups can be applied to other kinds of prochiral molecular entities or prochiral parts of molecular entities considered on their own." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>pro-R, pro-S</i>" .

goldbook:P04891 a skos:Concept ;
    skos:definition "Naturally occurring compounds derived from the parent $\\ce{C20}$ acid, prostanoic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prostaglandins" .

goldbook:P04892 a skos:Concept ;
    skos:definition "The family of natural prostaglandins and prostaglandin-like compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prostanoids" .

goldbook:P04893 a skos:Concept ;
    skos:definition "The non-amino acid portion of a conjugated protein. Examples include cofactors such as flavines or cytochromes as well as lipids and polysaccharides, which are the prosthetic groups of lipoproteins and glycoproteins, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prosthetic group" .

goldbook:P04894 a skos:Concept ;
    skos:definition "Enzymes that catalyse the hydrolysis of proteins. Usually several proteolytic enzymes are necessary for the complete breakdown of polypeptides to their amino acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteases" .

goldbook:P04895 a skos:Concept ;
    skos:definition "A colloidally stable mixture of a lyophobic and a lyophilic colloid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protected lyophobic colloid" .

goldbook:P04896 a skos:Concept ;
    skos:definition "Addition of small amounts of hydrophilic colloid to a hydrophobic sol may make the latter more sensitive to flocculation by electrolyte. Higher concentrations of the same hydrophilic colloid usually protect the hydrophobic sol from flocculation. This phenomenon is called protective action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protective action" .

goldbook:P04897 a skos:Concept ;
    skos:definition "A technique used to produce proteins with altered or novel amino acid sequences. The methods used are: Transcription and translation systems from synthesized lengths of DNA or RNA with novel sequences.  Chemical modification of 'normal' proteins.   Solid-state polypeptide synthesis to form proteins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protein engineering" .

goldbook:P04898 a skos:Concept ;
    skos:definition "Naturally occurring and synthetic polypeptides having molecular weights greater than about 10000 (the limit is not precise)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteins" .

goldbook:P04899 a skos:Concept ;
    skos:definition "A subclass of protein in which the carbohydrate units are polysaccharides that contain amino sugars. The protein is glycosylated by one or more (up to about 100) glycosaminoglycans [linear polymers of up to about 200 repeating disaccharide units that consist of a hexosamine (ᴅ-glucosamine or ᴅ-galactosamine) alternating with a uronic acid (ᴅ-glucuronic or ʟ-iduronic) or a neutral sugar (ᴅ-galactose)]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteoglycan" .

goldbook:P04903 a skos:Concept ;
    skos:definition "A specific name for the atom $\\ce{^{1}H}$. The cation $\\ce{^{1}H^{+}}$ is a proton, the species $\\ce{1H}$ is a protide anion, and $\\ce{1H}$ is the protio group. The word proton should not be used for $\\ce{H^{+}}$ in its natural abundance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protium" .

goldbook:P04904 a skos:Concept ;
    skos:altLabel "protic",
        "protogenic solvent" ;
    skos:definition "Capable of acting as a proton donor (strongly or weakly acidic as a Brønsted acid). The term is preferred to the synonym 'protic' or the more ambiguous expression acidic by itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protogenic" .

goldbook:P04905 a skos:Concept ;
    skos:definition "This term has been used synonymously with proton (hydron)-transfer reaction. Because of its misleading similarity to hydrolysis, photolysis, etc., its use is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protolysis" .

goldbook:P04907 a skos:Concept ;
    skos:altLabel "PA" ;
    skos:definition "The negative of the enthalpy change in the gas phase reaction (real or hypothetical) between a proton (more appropriately hydron) and the chemical species concerned, usually an electrically neutral species to give the conjugate acid of that species. Proton affinity is often, but unofficially, abbreviated as PA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton affinity" .

goldbook:P04908 a skos:Concept ;
    skos:definition "An ion formed by interaction of a molecule with a proton abstracted from an ion, as often occurs in chemical ionization according to the reaction: \\(\\rm{M}+\\rm{XH}^{+}\\rightarrow \\rm{MH}^{+}+\\rm{X}\\). The symbolism $\\ce{[M + H]^{+}}$ may also be used to represent the protonated molecule. The widely used term 'protonated molecular ion' to describe the $\\ce{MH^{+}}$ ion is not recommended, since it suggests an associated product of a proton with a molecular ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protonated molecule" .

goldbook:P04911 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant \\(\\mu _{\\rm{p}} = 1.410\\ 607\\ 61(47)\\times 10^{-26}\\ \\rm{J T}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton magnetic moment" .

goldbook:P04912 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant \\(\\gamma _{\\rm{p}} = 2.675\\ 221\\ 28(81)\\times 10^{8}\\ \\rm{s}^{-1}\\ \\rm{T}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton magnetogyric ratio" .

goldbook:P04914 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant \\(m_{\\rm{p}} = \\pu{1.6726231(10)E-27 kg}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton rest mass" .

goldbook:P04915 a skos:Concept ;
    skos:definition "A chemical reaction, the main feature of which is the intermolecular or intramolecular transfer of a proton (hydron) from one binding site to another. For example:  In the detailed description of proton transfer reactions, especially of rapid proton transfers between electronegative atoms, it should always be specified whether the term is used to refer to the overall process (including the more-or-less encounter-controlled formation of a hydrogen bonded complex and the separation of the products; see microscopic diffusion control) or just to the proton transfer event (including solvent rearrangement) by itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proton transfer reaction" .

goldbook:P04916 a skos:Concept ;
    skos:altLabel "hydrogen bond acceptor",
        "protophilic solvent" ;
    skos:definition "Capable of acting as proton acceptor, strongly or weakly basic (as a Brønsted base). Also called HBA (hydrogen bond acceptor) solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protophilic" .

goldbook:P04917 a skos:Concept ;
    skos:definition "A spherical, osmotically-sensitive cell without its cell wall but retaining an intact cell membrane. Protoplasts are used to create hybrid cells via protoplast fusion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protoplast" .

goldbook:P04918 a skos:Concept ;
    skos:definition "Microoganisms capable of growing at or below a temperature optimum of \\(15\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prototrophs" .

goldbook:P04920 a skos:Concept ;
    skos:definition "Potentially acidic compounds that require some structural reorganization, such as keto–enol tautomerization, having a non-negligible activation energy, in order to show normal acidic properties, e.g. nitroalkanes:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo acids" .

goldbook:P04921 a skos:Concept ;
    skos:definition "The traditional name for a tetrahedrally coordinated carbon atom bonded to four different entities, two and only two of which have the same constitution but opposite chirality sense. The r/s descriptors of pseudo-asymmetric carbon atoms are invariant on reflection in a mirror (i.e. r remains r, and s remains s), but are reversed by the exchange of any two entities (i.e. r becomes s, and s becomes r). An example is C-3 of ribaric (C-3 is r) or xylaric acid (C-3 is s) or hyoscyamine (C-3 is r). The hyphen in pseudo-asymmetric may be omitted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-asymmetric carbon atom" .

goldbook:P04923 a skos:Concept ;
    skos:definition "Hydroxy compounds that give salts with acids by formation of water accompanied by a change of constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo bases" .

goldbook:P04924 a skos:Concept ;
    skos:definition "If an acid or base is present in nearly constant concentration throughout a reaction in solution (owing to buffering or the use of a large excess), it may be found to increase the rate of that reaction and also to be consumed during the process. The acid or base is then not a catalyst and the phenomenon cannot be called catalysis according to the well-established meaning of these terms in chemical kinetics, although the mechanism of such a process is often intimately related to that of a catalysed reaction. It is recommended that the term pseudo-catalysis be used in these and analogous cases (not necessarily involving acids or bases). For example, if a Brønsted acid accelerates the hydrolysis of an ester to a carboxylic acid and an alcohol, this is properly called acid catalysis, whereas the acceleration, by the same acid, of hydrolysis of an amide should be described as pseudo-catalysis by the acid: the 'acid pseudo-catalyst' is consumed during the reaction through formation of an ammonium ion. The terms 'general acid pseudo-catalysis' and 'general base pseudo-catalysis' may be used as the analogues of general acid catalysis and general base catalysis. The term 'base-promoted', 'base-accelerated' or 'base-induced' is sometimes used for reactions that are pseudo-catalysed by bases. However, the term 'promotion' also has a different meaning in other chemical contexts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-catalysis" .

goldbook:P04925 a skos:Concept ;
    skos:definition "An irregular oligomer, the molecules of which are derived from only one species of monomer but which display a variety of structural features more appropriate for description in co-oligomer terms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-co-oligomer" .

goldbook:P04926 a skos:Concept ;
    skos:definition "An irregular polymer, the molecules of which are derived from only one species of monomer but which display a variety of structural features more appropriate for description in copolymer terms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo-copolymer" .

goldbook:P04930 a skos:Concept ;
    skos:definition "Compounds that resemble the halogen elements, $\\ce{X2}$, in their chemistry, e.g. $\\ce{(CN)2}$ cyanogen, $\\ce{(SCN)2}$ thiocyanogen, $\\ce{ICN}$ iodine cyanide. Certain ions that have sufficient resemblance to halide ions are sometimes referred to as pseudohalide ions, e.g. $\\ce{N3^{−}}$, $\\ce{SCN^{−}}$, $\\ce{CN^{−}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudohalogens" .

goldbook:P04932 a skos:Concept ;
    skos:definition "A concerted transformation is pseudopericyclic if the primary changes in bonding occur within a cyclic array of atoms at one (or more) of which nonbonding and bonding atomic orbitals interchange roles. A formal example is the enol \\(\\rightarrow \\) enol prototropy of pentane-2,4-dione (acetylacetone).  Because the \\(\\pi \\)- and \\(\\sigma \\)-atomic orbitals that interchange roles are orthogonal, such a reaction does not proceed through a fully conjugated transition state and is thus not a pericyclic reaction and therefore not governed by the rules that express orbital symmetry restrictions applicable to pericyclic reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudopericyclic" .

goldbook:P04933 a skos:Concept ;
    skos:definition "A term sometimes used for a rate coefficient. For example, if the rate equation is: \\[v=k\\ \\rm{[A]}\\ \\rm{[B]}\\] the function \\(k\\ \\rm{[A]}\\) is the pseudo first-order rate constant (or first-order rate coefficient) with respect to B. Similarly, \\(k\\ \\rm{[B]}\\) is the pseudo first-order rate constant (or first-order rate coefficient) with respect to A. The term pseudo rate constant is particularly useful when the concentration of one reactant is much greater than that of another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudo rate constant" .

goldbook:P04934 a skos:Concept ;
    skos:definition "Stereoisomerization resulting in a structure that appears to have been produced by rotation of the entire initial molecule and is superposable on the initial one, unless different positions are distinguished by substitution, including isotopic substitution. One example of pseudorotation is a facile interconversion between the many envelope and twist conformers of a cyclopentane due to the out of plane motion of carbon atoms. Another example of pseudorotation (Berry pseudorotation) is a polytopal rearrangement that provides an intramolecular mechanism for the isomerization of trigonal bipyramidal compounds (e.g. \\(\\lambda ^{5}\\)-phosphanes), the five bonds to the central atom E being represented as \\(\\rm{e}^{1}\\), \\(\\rm{e}^{2}\\), \\(\\rm{e}^{3}\\), \\(\\rm{a}^{1}\\) and \\(\\rm{a}^{2}\\). Two equatorial bonds move apart and become apical bonds at the same time as the apical bonds move together to become equatorial.  A related conformational change of a trigonal bipyramidal structure is described as turnstile rotation. The process may be visualized as follows.  An apical and an equatorial bond rotate as a pair ca. 120° relative to the other three bonds. (Doubts have been expressed about the distinct physical reality of this mechanism.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pseudorotation" .

goldbook:P04939 a skos:Concept ;
    skos:definition "Instrument by which the relative humidity of the atmosphere may be determined. It is generally composed of two temperature sensors, one of which measures the temperature of the air; the other sensor is moistened with water and senses the cooling due to evaporation of water. The temperature difference between the two sensors is a function of relative humidity; sometimes referred to as a 'wet-and-dry bulb' thermometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychrometric hygrometer" .

goldbook:P04940 a skos:Concept ;
    skos:definition "The use of a wet-and-dry bulb thermometer for measurement of atmospheric humidity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "psychrometry" .

goldbook:P04941 a skos:Concept ;
    skos:definition "An irreversible expansion of some carbon artifacts during graphitization heat treatment between \\(1650\\) and \\(2700\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "puffing" .

goldbook:P04942 a skos:Concept ;
    skos:definition "Metals or metal compounds with a high chemical affinity for the heteroatoms in the carbons. They are distributed as fine particles within the carbon materials to be graphitized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "puffing inhibitor" .

goldbook:P04945 a skos:Concept ;
    skos:altLabel "pulse height analyser" ;
    skos:definition "A sub-assembly for determining the distribution function of a set of pulses in terms of their amplitude. Synonymous with pulse height analyser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse amplitude analyser" .

goldbook:P04946 a skos:Concept ;
    skos:altLabel "single channel pulse height analyser" ;
    skos:definition "A circuit which gives an output pulse for each input pulse whose amplitude lies within a chosen interval. Synonymous with single channel pulse height analyser." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse amplitude selector" .

goldbook:P04947 a skos:Concept ;
    skos:definition "In pulse polarography, differential pulse polarography, Kalousek polarography, and related techniques, the duration of an interval during which the excitation signal deviates from the base line. This interval includes the sampling interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse duration" .

goldbook:P04951 a skos:Concept ;
    skos:definition "In a pulse reactor, a carrier gas, which may be inert or possibly one of the reactants, flows over the catalyst and small amounts of the other reactant or reactants are injected into the carrier gas at intervals. A pulse reactor is useful for exploratory work but kinetic results apply to a transient rather than to the steady state conditions of the catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pulse reactor" .

goldbook:P04952 a skos:Concept ;
    skos:definition "Transient absorption spectroscopy using two pulses (strong pump and weak probe) and capable of achieving a high temporal resolution. A pump pulse excites the sample and triggers the process under investigation. A second delayed pulse, the probe, monitors an optical property. By varying the time delay between the pump and probe pulses, it is possible to assemble measurements as a function of time. The probe pulse is typically a UV, visible or infrared pulse in which case a snap-shot spectrum is taken as a function of the delay time. Often the probe pulse is generated from a portion of the excitation beam, but it can also be an independently generated electromagnetic pulse." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pump-probe technique" .

goldbook:P04953 a skos:Concept ;
    skos:definition "Purine and its substitution derivatives, especially naturally occurring examples. The customary numbering shown below is not systematic.purine" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "purine bases" .

goldbook:P04956 a skos:Concept ;
    skos:definition "A polytopal rearrangement in which the change in bond directions to a three-coordinate central atom having a pyramidal arrangement of bonds (tripodal arrangement) causes the central atom (apex of the pyramid) to appear to move to an equivalent position on the other side of the base of the pyramid. If the three ligands to the central atom are different pyramidal inversion interconverts enantiomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyramidal inversion" .

goldbook:P04957 a skos:Concept ;
    skos:definition "Cyclic hemiacetal forms of monosaccharides in which the ring is six-membered (a tetrahydropyran)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyranoses" .

goldbook:P04958 a skos:Concept ;
    skos:definition "Pyrimidine and its substitution derivatives, especially naturally occurring examples." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrimidine bases" .

goldbook:P04959 a skos:Concept ;
    skos:definition "A prefix designating compounds formed by heating a compound, usually with the elimination of water, carbon dioxide, or other simple molecule, e.g. pyroglutamic acid from glutamic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyro" .

goldbook:P04961 a skos:Concept ;
    skos:definition "Thermolysis, usually associated with exposure to a high temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrolysis" .

goldbook:P04962 a skos:Concept ;
    skos:definition "A version of reaction chromatography in which a sample is thermally decomposed to simpler fragments before entering the column." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrolysis-gas chromatography" .

goldbook:P04963 a skos:Concept ;
    skos:definition "A carbon material deposited from gaseous hydrocarbon compounds on suitable underlying substrates (carbon materials, metals, ceramics) at temperatures ranging from \\(1000\\) to \\(2500\\ \\rm{K}\\) (chemical vapour deposition)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrolytic carbon" .

goldbook:P04964 a skos:Concept ;
    skos:altLabel "HOPG" ;
    skos:definition "A graphite material with a high degree of preferred crystallographic orientation of the c-axes perpendicular to the surface of the substrate, obtained by graphitization heat treatment of pyrolytic carbon or by chemical vapour deposition at temperatures above \\(2500\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrolytic graphite" .

goldbook:P04965 a skos:Concept ;
    skos:definition "A less preferred term for dipyrrins. (The term 'pyrromethane' has been used for the system with a $\\ce{–CH2\\bond{–}}$ linkage)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pyrromethenes" .

goldbook:PT06782 a skos:Concept ;
    skos:definition "A membrane-bound complex in plants and photosynthetic bacteria, responsible for light-harvesting and primary electron transfer. Comprises light-harvesting pigments such as chlorophyll; a primary electron-transfer centre, and secondary electron carriers. In green plant photosynthesis, Photosystem I transfers electrons from plastocyanin to a [2Fe-2S] ferredoxin, and contains iron-sulfur proteins. Photosystem II transfers electrons from the oxygen-evolving complex to plastoquinone, and contains an iron centre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosystem" .

goldbook:PT06790 a skos:Concept ;
    skos:definition "A process (catalysed by enzymes) involving the transfer of a phosphate group from a donor to a suitable acceptor; in general, an ester linkage is formed, for example: $\\ce{ATP + alcohol -> ADP + phosphate ester}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphorylation" .

goldbook:PT06791 a skos:Concept ;
    skos:altLabel "PCR" ;
    skos:definition "A laboratory technique to rapidly amplify pre-determined regions of double-stranded DNA. Generally involves the use of a heat-stable DNA polymerase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymerase chain reaction" .

goldbook:PT06792 a skos:Concept ;
    skos:definition "The polyhedral symbol indicates the geometrical arrangements of the coordinating atoms about the central atom. It consists of one or more capital italic letters derived from common geometric terms (tetrahedron, square plane, octahedron, etc.) which denote the idealised geometry of the ligands around the coordination centre, and an arabic numeral that is the coordination number of the central atom. The polyhedral symbol is used as an affix, enclosed in parentheses, and separated from the name by a hyphen. Examples are T-4, SP-4, TBPY-5, SPY-5, OC-6, and CU-8." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyhedral symbol" .

goldbook:PT06835 a skos:Concept ;
    skos:definition "Process of the uptake of drugs by the body, the biotransformation they undergo, the distribution of the drugs and their metabolites in the tissues, and the elimination of the drugs and their metabolites from the body over a period of time.Study of such processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pharmacokinetics" .

goldbook:PT06836 a skos:Concept ;
    skos:definition "Enzymic modification of a substance by oxidation, reduction, hydrolysis, hydration, dehydrochlorination, or other reactions catalyzed by enzymes of the cytosol, of the endoplasmic reticulum (microsomal enzymes) or of other cell organelles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase I reaction" .

goldbook:PT06837 a skos:Concept ;
    skos:definition "Binding of a substance, or its metabolites from a phase I reaction, with endogenous molecules (conjugation), making more water-soluble derivatives that may be excreted in the urine or bile." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase II reaction" .

goldbook:PT06838 a skos:Concept ;
    skos:definition "Type of endocytosis in which soluble materials are taken up by the cell and incorporated into vesicles for digestion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pinocytosis" .

goldbook:PT06839 a skos:Concept ;
    skos:definition "Fluid component of blood in which the blood cells and platelets are suspended. Synonym: blood plasma.Fluid component of semen produced by the accessory glands, the seminal vesicles, the prostate, and the bulbo-urethral glands.Cell substance outside the nucleus, i.e., the cytoplasm." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "plasma" .

goldbook:PT06840 a skos:Concept ;
    skos:definition "Complete set of proteins encoded by the genome." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "proteome" .

goldbook:PT06879 a skos:Concept ;
    skos:altLabel "permeant" ;
    skos:definition "Entity from a phase in contact with one of the membrane surfaces that passes though the membrane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "penetrant" .

goldbook:PT06880 a skos:Concept ;
    skos:definition "Stream containing penetrants that leaves a membrane module." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permeate" .

goldbook:PT06881 a skos:Concept ;
    skos:definition "Separation process in which membrane permeation and extraction phenomena occur by contacting the downstream with an extracting solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perstraction" .

goldbook:PT06892 a skos:Concept ;
    skos:definition "Membrane-based process in which the feed and retentate streams are both liquid phases while permeant emerges at the downstream face of the membrane as a vapour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pervaporation" .

goldbook:PT06918 a skos:Concept ;
    skos:altLabel "polymeric stationary phase material" ;
    skos:definition "Stationary phase (material) based on particles of a cross-linked organic polymeric material. Typical materials are polystyrene divinylbenzene copolymers (PS-DVB) and modified PS-DVB materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymeric stationary phase" .

goldbook:PT06921 a skos:Concept ;
    skos:altLabel "perfusion stationary phase material" ;
    skos:definition "Stationary phase in which the mobile phase primarily travels through the pores of the stationary phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perfusion stationary phase" .

goldbook:PT06933 a skos:Concept ;
    skos:definition "Isotherm describing partition of the sample component between the bulk of a liquid stationary phase and a liquid, gaseous or supercritical mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partition isotherm" .

goldbook:PT06975 a skos:Concept ;
    skos:altLabel "PLS" ;
    skos:definition "Partial least squares projection to latent structures (PLS) is a robust multivariate generalized regression method using projections to summarize multitudes of potentially collinear variables." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "partial least squares" .

goldbook:PT06976 a skos:Concept ;
    skos:definition "Pattern recognition is the identification of patterns in large data sets, using appropriate mathematical methodology. Examples are principal component analysis (PCA), SIMCA, partial least squares (PLS) and artificial neural networks (ANN)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pattern recognition" .

goldbook:PT07088 a skos:Concept ;
    skos:altLabel "PPP",
        "PPP method" ;
    skos:definition "A semi-empirical quantum mechanical method of calculation of the properties of conjugated molecules and ions from self-consistent-field theory and the $\\ce{\\uppi\\!\\mbox{-}electron}$ approximation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pariser–Parr–Pople method" .

goldbook:PT07089 a skos:Concept ;
    skos:definition "A rule, complementary to the aufbau principle, of building up the electronic configuration of atoms and molecules: a maximum of two electrons can occupy an orbital and then only providing that the spins of the electrons are paired, i.e. opposed. The principle demands that the wavefunction for a many-electron system must be asymmetric with respect to the permutation of the space-spin coordinates for every pair of electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Pauli exclusion principle" .

goldbook:PT07090 a skos:Concept ;
    skos:definition "Along with variational method, the second major quantum-mechanical approximation method. The methods of perturbation theory are based on representation of the Hamiltonian of a system under study, \\(H\\), through the Hamiltonian, \\(H^{0}\\), of a system, whose Schroedinger equation is solvable, and its relatively small perturbation \\(H^{\\rm{'}}\\): \\(H=H^{0}+H^{\\rm{'}}\\). Numerous techniques are derived allowing one to relate the unknown eigenvalues and eigenfunctions of the perturbed system to the known eigenvalues and eigenfunctions of the unperturbed system. As distinct from the variational method, the methods of perturbation theory are applicable to all the electronic states of an atom or molecule. When \\(H^{\\rm{'}}\\) is time-dependent, the perturbed system does not have stationary states. In this case time-dependent perturbation theory, which is the method of approximate calculation of the expansion of wave-functions of the perturbed system over wave-functions of stationary states of the unperturbed system, must be employed. The applications of this method are associated mostly with studies of light emission and absorption by atoms and molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perturbation theory" .

goldbook:PT07091 a skos:Concept ;
    skos:definition "Weakly bound complexes with a potential minimum that precedes the activation barrier along the reaction path. In contrast with the van der Waals complexes, which fall apart reversibly into their constituents, the pre-reactive complexes may undergo a vigorous reaction to form different products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-reactive complexes" .

goldbook:PT07142 a skos:Concept ;
    skos:altLabel "polymer complex formation" ;
    skos:definition "Process that results in the formation of a polymer–polymer complex or a complex composed of a polymer and a low-molar-mass substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer complexation" .

goldbook:PT07143 a skos:Concept ;
    skos:definition "Chemical reaction that leads to the formation of ring structures in or from polymer chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer cyclization" .

goldbook:PT07144 a skos:Concept ;
    skos:definition "Chemical changes in a polymeric material that usually result in undesirable changes in the in-use properties of the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer degradation" .

goldbook:PT07145 a skos:Concept ;
    skos:definition "Introduction of desired chemical groups into polymer molecules to create specific chemical, physical, biological, pharmacological, or other properties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer functionalization" .

goldbook:PT07146 a skos:Concept ;
    skos:definition "Chemical reaction in which at least one of the reactants is a high-molar-mass substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer reaction" .

goldbook:PT07147 a skos:Concept ;
    skos:definition "Chemical reaction in which at least one reactant or a catalyst is bound through chemical bonds or weaker interactions, such as hydrogen bonds or donor–acceptor interactions, to a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer-supported reaction" .

goldbook:PT07148 a skos:Concept ;
    skos:definition "Temporary chemical transformation of a reactive group into a group that does not react under conditions where the non-protected group reacts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "protection of a reactive group" .

goldbook:PT07158 a skos:Concept ;
    skos:definition "Polymer that exhibits catalytic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer catalyst" .

goldbook:PT07159 a skos:Concept ;
    skos:definition "Complex comprising a metal and one or more polymeric ligands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer-metal complex" .

goldbook:PT07160 a skos:Concept ;
    skos:definition "Polymer that acts as a phase-transfer catalyst and thereby causes a significant enhancement of the rate of a reaction between two reactants located in neighboring phases owing to its catalysis of the extraction of one of the reactants across the interface to the other phase where the reaction takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer phase-transfer catalyst" .

goldbook:PT07161 a skos:Concept ;
    skos:definition "Catalyst system comprising a polymer support in which catalytically active species are immobilized through chemical bonds or weaker interactions such as hydrogen bonds or donor–acceptor interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer-supported catalyst" .

goldbook:PT07162 a skos:Concept ;
    skos:altLabel "polymer reagent",
        "polymer-supported reagent" ;
    skos:definition "Reactant (reagent) that is or is attached to a high-molar-mass linear polymer or a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer reactant" .

goldbook:PT07163 a skos:Concept ;
    skos:definition "Polymer or oligomer the molecules of which are capable of entering, through reactive groups, into further polymerization and thereby contributing more than one structural unit to at least one type of chain of the final polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prepolymer" .

goldbook:PT07180 a skos:Concept ;
    skos:definition "Polymer that, under stress, exhibits birefringence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo-elastic polymer" .

goldbook:PT07181 a skos:Concept ;
    skos:definition "Polymer that exhibits luminescence (i.e., fluorescence or phosphorescence arising from photo-excitation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoluminescent polymer" .

goldbook:PT07182 a skos:Concept ;
    skos:definition "Polymer that responds to ultraviolet or visible light by exhibiting a change in its physical properties or its chemical constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photosensitive polymer" .

goldbook:PT07183 a skos:Concept ;
    skos:definition "Polymer that exhibits a change in dielectric properties on application of pressure.Polymer that shows a change in its dimensions when subjected to an electric field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "piezoelectric polymer" .

goldbook:PT07185 a skos:Concept ;
    skos:definition "Polymeric additive that, when added to a blend of immiscible polymers, modifies their interfaces and stabilizes the blend." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer compatibilizer" .

goldbook:PT07186 a skos:Concept ;
    skos:definition "Polymer that contains either chemically-bound drug molecules or pharmacologically active moieties." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer drug" .

goldbook:PT07187 a skos:Concept ;
    skos:definition "Gel in which the network component is a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer gel" .

goldbook:PT07188 a skos:Concept ;
    skos:definition "Thin layer of polymeric material that acts as a barrier permitting mass transport of selected species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer membrane" .

goldbook:PT07189 a skos:Concept ;
    skos:definition "Polymer that acts like a solvent for compounds of low molar mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer solvent" .

goldbook:PT07190 a skos:Concept ;
    skos:definition "Polymer that adsorbs or absorbs a certain substance or certain substances from a liquid or a gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer sorbent" .

goldbook:PT07191 a skos:Concept ;
    skos:definition "Polymer to or in which a reagent or catalyst is chemically bound, immobilized, dispersed, or associated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer support" .

goldbook:PT07192 a skos:Concept ;
    skos:definition "Polymer that lowers the surface tension of the medium in which it is dissolved, or the interfacial tension with another phase, or both." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer surfactant" .

goldbook:PT07217 a skos:Concept ;
    skos:definition "In polymer terminology, polyelectrolyte composed of macromolecules containing acid groups on a substantial fraction of the constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyacid" .

goldbook:PT07219 a skos:Concept ;
    skos:definition "In polymer terminology, polyelectrolyte composed of macromolecules containing basic groups on a substantial fraction of the constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polybase" .

goldbook:PT07220 a skos:Concept ;
    skos:definition "Ampholytic polymer in which pendant groups have a betaine-type structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polybetaine" .

goldbook:PT07222 a skos:Concept ;
    skos:definition "Neutral polymer-polymer complex composed of macromolecules carrying charges of opposite sign causing the macromolecules to be bound together by electrostatic interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyelectrolyte complex" .

goldbook:PT07223 a skos:Concept ;
    skos:definition "Polymer network containing ionic or ionizable groups in a substantial fraction of its constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyelectrolyte network" .

goldbook:PT07242 a skos:Concept ;
    skos:definition "Composite in which at least one component is a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer composite" .

goldbook:PT07247 a skos:Concept ;
    skos:definition "Sheets of a substrate that have been impregnated with a curable polymer, curable polymers, or liquid reactants, or a thermoplastic, and are ready for fabrication of laminates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "prepreg" .

goldbook:PT07264 a skos:Concept ;
    skos:definition "Polymeric material, exhibiting macroscopically uniform physical properties throughout its whole volume, that comprises a compatible polymer blend, a miscible polymer blend or a multiphase copolymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer alloy" .

goldbook:PT07286 a skos:Concept ;
    skos:definition "Region of a material that is uniform in chemical composition and physical state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase domain" .

goldbook:PT07291 a skos:Concept ;
    skos:definition "Molecular interaction between the components present in the interphases of a multiphase mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phase interaction" .

goldbook:PT07416 a skos:Concept ;
    skos:definition "Lattice distortion or polarization caused by photoexcitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polaron" .

goldbook:PT07418 a skos:Concept ;
    skos:altLabel "PICT" ;
    skos:definition "In a PICT state formed by intramolecular charge transfer in an electron donor ($\\ce{D}$)/acceptor ($\\ce{A}$) molecule, the $\\ce{D}$ and $\\ce{A}$ subgroups have an overall planar configuration, with substantial electronic coupling of $\\ce{D}$ and $\\ce{A}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "planar intramolecular charge transfer" .

goldbook:PT07440 a skos:Concept ;
    skos:definition "Amplification of a signal based on parametric processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parametric amplification" .

goldbook:PT07441 a skos:Concept ;
    skos:altLabel "optical parametric processes" ;
    skos:definition "Interaction of photons in a non-linear medium satisfying the energy and momentum conservation laws. During the interaction the photon frequencies are mixed and photon(s) with different frequencies are created." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "parametric processes" .

goldbook:PT07442 a skos:Concept ;
    skos:definition "Distortion of a regular one-dimensional structure with a partially occupied band to give bond alternation, eventually leading to dimerization or oligomerization. The degree of oligomerization, \\(\\lambda \\) depends on the electronic population of the conduction band indicated by the wave vector of the Fermi level \\(k_{\\mathrm{F}}\\) \\[\\lambda = 2\\ \\pi /k_{\\mathrm{F}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Peierls distortion" .

goldbook:PT07443 a skos:Concept ;
    skos:definition "Parameter describing the time evolution of the decay of the phosphorescence radiant intensity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phosphorescence lifetime" .

goldbook:PT07444 a skos:Concept ;
    skos:definition "Intramolecular photoinduced cyclization of enediynes leading to aromatic compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo-Bergman cyclization" .

goldbook:PT07445 a skos:Concept ;
    skos:definition "Branch of biology concerned with the biological and bioenvironmental effects of ultraviolet, visible or infrared radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photobiology" .

goldbook:PT07446 a skos:Concept ;
    skos:definition "Catalyst able to produce, upon absorption of light, chemical transformations of the reaction partners. The excited state of the photocatalyst repeatedly interacts with the reaction partners forming reaction intermediates and regenerates itself after each cycle of such interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocatalyst" .

goldbook:PT07447 a skos:Concept ;
    skos:definition "Molecular structure where the excited-state reactant or intermediate is delivered to the ground state to initiate product formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical funnel" .

goldbook:PT07448 a skos:Concept ;
    skos:altLabel "MERP" ;
    skos:definition "Sequence of geometries adopted by a molecule after initial electronic excitation, combined with a specification of the electronic state at each geometry, from radiation absorption to product formation. Theoretically, this usually involves the computation of the MERP connecting the Franck–Condon point, located on the potential-energy surface of the spectroscopic state, to the final photoproducts located on the ground-state potential-energy surface. Experimentally, a photochemical reaction path can be probed by detecting transient species or reaction intermediates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical reaction path" .

goldbook:PT07449 a skos:Concept ;
    skos:definition "Rearrangement closely related to the photo-Fries rearrangement; it is experienced by aryl ethers (instead of aryl esters) and follows an analogous mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photo-Claisen rearrangement" .

goldbook:PT07450 a skos:Concept ;
    skos:definition "Intramolecular photochemical process leading to carbo- or hetero- cyclic ring systems by formation of one new single bond, either by a concerted process (e.g., electrocyclization) or by multi-step processes such as Norrish–Yang reaction, photoinduced electron transfer processes, Yang photocyclization and others." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocyclization" .

goldbook:PT07451 a skos:Concept ;
    skos:definition "Intermolecular photochemical process leading to carbo- or hetero- cyclic ring systems by formation of two new single bonds, either by a concerted process (e.g., a concerted addition) or by multi-step processes (e.g., the Paternò–Büchi reaction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photocycloaddition" .

goldbook:PT07452 a skos:Concept ;
    skos:definition "Photoinduced dinitrogen ($\\ce{N2}$) elimination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photochemical nitrogen extrusion" .

goldbook:PT07453 a skos:Concept ;
    skos:definition "Photoinduced extrusion of carbon monoxide ($\\ce{CO}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodecarbonylation" .

goldbook:PT07454 a skos:Concept ;
    skos:definition "Photoinduced extrusion of carbon dioxide ($\\ce{CO2}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodecarboxylation" .

goldbook:PT07455 a skos:Concept ;
    skos:definition "Photoinduced reaction of conjugated compounds (e.g., enones and carboxylic acid derivatives) leading to loss of conjugation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photodeconjugation" .

goldbook:PT07456 a skos:Concept ;
    skos:definition "Photochemical process leading to the addition of water across a $\\ce{C–C}$ double (or triple) bond or to a carbonyl (or carbonyl analogue) group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photohydration" .

goldbook:PT07458 a skos:Concept ;
    skos:definition "Time-resolved optical spectroscopy in which the inhomogeneous broadening of absorbers is eliminated by the proper choice of geometry in a four-wave mixing experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon echo" .

goldbook:PT07459 a skos:Concept ;
    skos:definition "Total number of photons calculated as \\(N_{\\rm{p}} = n_{\\rm{p}}\\, N_{\\rm{A}}\\) with \\(N_{\\rm{p}}\\) the amount of photons in einsteins and \\(N_{\\rm{A}}\\) the Avogadro constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photon number" .

goldbook:PT07460 a skos:Concept ;
    skos:definition "Photoisomerization involving changes in the arrangement of the atoms within the molecular species. It may lead to unstable isomers that react further by, e.g., dehydrogenation, deprotonation, or other reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photorearrangement" .

goldbook:PT07461 a skos:Concept ;
    skos:definition "Selection of an aligned subset of sample molecules by an exciting light beam. The selected subset will have an orientation distribution that is determined by the electric vector of the beam. If the beam is linearly polarized a uniaxial sample with a known orientation distribution will be produced. Also, the set of remaining molecules will be aligned with a known orientation distribution (residual anisotropy)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "photoselection" .

goldbook:PT07463 a skos:Concept ;
    skos:altLabel "PLED" ;
    skos:definition "Acronym for polymer light-emitting diode." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "PLED" .

goldbook:PT07465 a skos:Concept ;
    skos:definition "Transient absorption spectroscopy using three pulses (a strong pump, a dump pulse that can alter the course of the reaction photoinduced by the first pulse, and a weak probe). In general, femtosecond laser pulses are used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pump-dump-probe technique" .

goldbook:PT07506 a skos:Concept ;
    skos:definition "Stage of a network-forming polymerization or crosslinking process extending up to, but not beyond, the gel point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-gel regime" .

goldbook:PT07507 a skos:Concept ;
    skos:definition "State of a network-forming polymerization or crosslinking process in the pre-gel regime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "pre-gel state" .

goldbook:PT07510 a skos:Concept ;
    skos:definition "Sol in which the dispersed phase consists of solid particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particulate sol" .

goldbook:PT07511 a skos:Concept ;
    skos:definition "Sol in which the dispersed phase consists of particles having a polymeric structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymeric sol" .

goldbook:PT07523 a skos:Concept ;
    skos:definition "Gel in which the network component comprises solid particles." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "particulate gel" .

goldbook:PT07524 a skos:Concept ;
    skos:definition "Polymer gel in which the polymer network contains ionic or ionizable groups in a significant fraction of its constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polyelectrolyte gel" .

goldbook:PT07570 a skos:Concept ;
    skos:definition "Polymer network composed of chains all of which are connected at both of their ends to different junction points." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "perfect network" .

goldbook:PT07583 a skos:Concept ;
    skos:altLabel "PDC" ;
    skos:definition "Ceramic derived from a polymeric ceramic precursor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "polymer-derived ceramic" .

goldbook:PT07594 a skos:Concept ;
    skos:definition "Crosslink formed by covalent bonds, intermolecular or intramolecular interactions that are stable under the conditions of use of the material formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "permanent crosslink" .

goldbook:PT07605 a skos:Concept ;
    skos:definition "Hypothetical behaviour in which chains can move freely through one another when a network is deformed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "phantom chain behaviour" .

goldbook:PT07627 a skos:Concept ;
    skos:definition "Sedimentation of a solid material (a precipitate) from a liquid solution in which the material is present in amounts greater than its solubility in the liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "precipitation" .

goldbook:PT07642 a skos:Concept ;
    skos:altLabel "deflocculation" ;
    skos:definition "Reversal of coagulation or flocculation, i.e., the dispersion of agglomerates to form a colloidally stable suspension or emulsion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "peptization" .

goldbook:Q02567 a skos:Concept ;
    skos:definition "A photon of γ-radiation" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-quantum" .

goldbook:Q04967 a skos:Concept ;
    skos:definition "A laser in which the state of the device introducing important losses in the resonant cavity and preventing lasing operation is suddenly switched to a state where the device introduces very low losses. This increases rapidly the Quality factor of the cavity, allowing the build-up of a short and very intense laser pulse. Typical pulse durations are in the ns range. The Q-switching may be active (a rotating mirror or electro-optic device) or passive (a saturable absorber)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Q-switched laser" .

goldbook:Q04968 a skos:Concept ;
    skos:definition "The square root of the expression in which the sum of squared observations is divided by the number \\(n\\). It can be calculated by the formula: \\[\\overline{x}_{\\rm{q}}=\\sqrt{\\frac{\\sum x_{i}^{2}}{n}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadratic mean" .

goldbook:Q04969 a skos:Concept ;
    skos:definition "An affix used in names to denote four atoms bound into a quadrangle (e.g. square)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>quadro</i>-" .

goldbook:Q04970 a skos:Concept ;
    skos:altLabel "Quistor" ;
    skos:definition "An arrangement in which ions with a desired range of quotients mass/charge are trapped by making them describe stable paths under the effect of a static and a high-frequency electric quadrupole field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupole ion storage trap" .

goldbook:Q04971 a skos:Concept ;
    skos:definition "An arrangement in which ions with a desired quotient mass/charge are made to describe a stable path under the effect of a static and a high-frequency electric quadrupole field, and are then detected. Ions with a different mass/charge are separated from the detected ions because of their unstable paths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupole mass analyser" .

goldbook:Q04972 a skos:Concept ;
    skos:definition "The measured Doppler velocity difference between the two peaks seen in quadrupole split spectra from nuclides such as $\\ce{^{57}Fe}$ and $\\ce{^{119}Sn}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quadrupole splitting" .

goldbook:Q04973 a skos:Concept ;
    skos:definition "Analysis in which substances are identified or classified on the basis of their chemical or physical properties, such as chemical reactivity, solubility, molecular weight, melting point, radiative properties (emission, absorption), mass spectra, nuclear half-life, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "qualitative analysis" .

goldbook:Q04974 a skos:Concept ;
    skos:definition "Ability of a method to detect one element in the presence of another element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "qualitative elemental specificity" .

goldbook:Q04975 a skos:Concept ;
    skos:definition "The guarantee that the quality of a product (analytical data set, etc.) is actually what is claimed on the basis of the quality control applied in creating that product. Quality assurance is not synonymous with quality control. Quality assurance is meant to protect against failures of quality control." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality assurance" .

goldbook:Q04976 a skos:Concept ;
    skos:definition "The maintenance and statement of the quality of a product (data set, etc.) specifically that it meets or exceeds some minimum standard based on known, testable criteria." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality control" .

goldbook:Q04977 a skos:Concept ;
    skos:definition "The linear-energy-transfer dependent factor by which absorbed dose is multiplied to obtain dose equivalent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quality factor" .

goldbook:Q04979 a skos:Concept ;
    skos:definition "The quantized internal energy of a molecule in its electronic ground or excited state can be approximated with sufficient accuracy for analytical purposes by: \\[E_{\\rm{int}}=E_{\\rm{el}}+E_{\\rm{vib}}+E_{\\rm{rot}}\\] where \\(E_{\\mathrm{el}}\\) is the electronic, \\(E_{\\mathrm{vib}}\\) the vibrational and \\(E_{\\mathrm{rot}}\\) the rotational energy, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantized internal energy" .

goldbook:Q04980 a skos:Concept ;
    skos:definition "Analyses in which the amount or concentration of an analyte may be determined (estimated) and expressed as a numerical value in appropriate units. qualitative analysis may take place without quantitative analysis, but quantitative analysis requires the identification (qualification) of the analytes for which numerical estimates are given." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitative analysis" .

goldbook:Q04981 a skos:Concept ;
    skos:altLabel "QSAR" ;
    skos:definition "The building of structure–biological activity models by using regression analysis with physicochemical constants, indicator variables or theoretical calculations. The term has been extended by some authors to include chemical reactivity, i.e. activity is regarded as synonymous with reactivity. This extension is, however, discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitative structure–activity relationships" .

goldbook:Q04982 a skos:Concept ;
    skos:definition "Attribute of a phenomenon, body or substance that may be distinguished qualitatively and determined quantitatively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantity" .

goldbook:Q04984 a skos:Concept ;
    skos:altLabel "dimensionless quantity" ;
    skos:definition "Quantity in the dimensional expression of which all the exponents of the dimensions of the base quantities are zero." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantity of dimension one" .

goldbook:Q04986 a skos:Concept ;
    skos:definition "An elementary particle of electromagnetic energy in the sense of the wave-particle duality." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum" .

goldbook:Q04987 a skos:Concept ;
    skos:definition "A medium emitting with a quantum yield independent of the excitation energy over a defined spectral range (e.g, concentrated rhodamine 6G solutions between \\(300\\) and \\(600\\ \\rm{nm}\\)). Also used for devices producing an electrical signal proportional to the photon flux absorbed in a medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum counter" .

goldbook:Q04988 a skos:Concept ;
    skos:definition "For a primary photochemical process, quantum efficiency is identical to quantum yield." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum efficiency" .

goldbook:Q04991 a skos:Concept ;
    skos:definition "The integral quantum yield is \\[\\mathit{\\Phi}(\\lambda) = \\frac{\\rm{number\\ of\\ events}}{\\rm{number\\ of\\ photons\\ absorbed}}\\] For a photochemical reaction, \\[\\mathit{\\Phi}(\\lambda) = \\frac{\\rm{amount\\ of\\ reactant\\ consumed\\ or\\ product\\ formed}}{\\rm{number\\ of\\ photons\\ absorbed}}\\] The differential quantum yield is \\[\\mathit{\\Phi}(\\lambda) = \\frac{{\\rm{d}}x/{\\rm{d}}t}{q_{n,{\\rm{p}}}^{0}[ 1 - 10^{-A(\\lambda)} ]}\\] where \\({\\rm{d}}x/{\\rm{d}}t\\) is the rate of change of a measurable quantity (spectral or any other property), and \\(q_{n\\rm{,p}}^{0}\\) the amount of photons (\\(\\pu{mol}\\) or its equivalent \\(\\rm{einstein}\\)) incident (prior to absorption) per time interval (photon flux, amount basis). \\(A(\\lambda)\\) is the absorbance at the excitation wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum yield" .

goldbook:Q04992 a skos:Concept ;
    skos:definition "In chronopotentiometry (at constant current density), the potential of the indicator electrode at the instant when the time that has elapsed since the application of current is equal to one-fourth of the transition time. Appropriate correction for double-layer charging is needed in practice." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quarter-transition-time potential" .

goldbook:Q04993 a skos:Concept ;
    skos:definition "A state having a total electron spin quantum number equal to \\(\\frac{3}{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quartet state" .

goldbook:Q04994 a skos:Concept ;
    skos:definition "Wolfram (tungsten) filament high-intensity incandescent lamp containing iodine in a quartz envelope. Used primarily as a source of visible radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quartz–iodine lamp" .

goldbook:Q04996 a skos:Concept ;
    skos:altLabel "QCT",
        "QCT method" ;
    skos:definition "A procedure for calculating trajectories in which the quantization of the reactants is taken into account, but in which the course of the reaction is treated classically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-classical trajectory method" .

goldbook:Q04997 a skos:Concept ;
    skos:definition "Constitutionally different yet closely related chemical species MX and MY having the opposite chirality sense of the large common chiral moiety M. For example (R)-2-bromobutane is a quasi-enantiomer of (S)-2-chlorobutane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-enantiomers" .

goldbook:Q04999 a skos:Concept ;
    skos:definition "In conventional transition-state theory it is assumed that activated complex are formed in a state of equilibrium with the reactants. They are not in classical equilibrium with the reactants; if they were, addition of more activated complexes to the system would cause the equilibrium to shift in favour of the reactants. This would not occur for an activated complex, and the term quasi-equilibrium is used to denote this special type of equilibrium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-equilibrium" .

goldbook:Q05000 a skos:Concept ;
    skos:definition "A protonated molecule or an ion formed from a molecular ion by loss of a hydrogen atom. The use of the term 'pseudo-molecular ion' is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-molecular ion" .

goldbook:Q05001 a skos:Concept ;
    skos:definition "The crystalline product of a 1:1 association between quasi-enantiomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quasi-racemic compound" .

goldbook:Q05003 a skos:Concept ;
    skos:definition "Derivatives of ammonium compounds, $\\ce{(NH4^{+})Y^{−}}$, in which all four of the hydrogens bonded to nitrogen have been replaced with hydrocarbyl groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quaternary ammonium compounds" .

goldbook:Q05004 a skos:Concept ;
    skos:definition "The defined organization of two or more macromolecules with tertiary structure such as a protein that are held together by hydrogen bonds and van der Waals and coulombic forces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quaternary structure" .

goldbook:Q05006 a skos:Concept ;
    skos:definition "A molecular entity that deactivates (quenches) an excited state of another molecular entity, either by energy transfer, electron transfer, or by a chemical mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quencher" .

goldbook:Q05007 a skos:Concept ;
    skos:definition "Deactivation of an excited molecular entity intermolecularly by an external environmental influence (such as a quencher) or intramolecularly by a substituent through a non-radiative process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quenching" .

goldbook:Q05009 a skos:Concept ;
    skos:definition "Correction for errors due to different quenching for standards and test portions. When using liquid scintillation detectors these corrections can be based e.g. on the standard addition or sample channels ratio method or the use of automated external standardization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quenching correction" .

goldbook:Q05010 a skos:Concept ;
    skos:definition "Mancude assemblies of three carbocyclic rings, a six-membered quinonoid ring bonded at the 1,4-positions to odd-membered rings which differ in ring size by two, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinarenes" .

goldbook:Q05011 a skos:Concept ;
    skos:definition "Molecular complexes of one equivalent amount of a quinone with one equivalent amount of the corresponding hydroquinone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinhydrones" .

goldbook:Q05012 a skos:Concept ;
    skos:definition "Methylidenecyclohexadienones and dimethylidenecyclohexadienes, formally derived from quinones by replacement of one or both of the quinone oxygens by methylidene groups. (The diradical, triplet state of quinodimethanes can also be called o- or p-xylylenes)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinomethanes" .

goldbook:Q05014 a skos:Concept ;
    skos:definition "A potentially confusing term for diazooxides; the presence of an azido group, $\\ce{–N3}$, is falsely suggested." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinone diazides" .

goldbook:Q05015 a skos:Concept ;
    skos:definition "Compounds having a fully conjugated cyclic dione structure, such as that of benzoquinones, derived from aromatic compounds by conversion of an even number of number of $\\ce{–CH=}$ groups into $\\ce{–C(=O)–}$ groups with any necessary rearrangement of double bonds (polycyclic and heterocyclic analogues are included)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinones" .

goldbook:Q05016 a skos:Concept ;
    skos:altLabel "quinone imines" ;
    skos:definition "Imines derived from quinones by replacement of one or both oxygens by $\\ce{=NR}$. The term may include both types unless the infix mono or di is included, e.g. o-benzoquinone diimine:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinonimines" .

goldbook:Q05017 a skos:Concept ;
    skos:definition "Mono- or di-oximes of quinones; quinone monooximes are tautomeric with nitrosophenols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quinonoximes" .

goldbook:QT06977 a skos:Concept ;
    skos:altLabel "QSAR" ;
    skos:definition "Quantitative structure–activity relationships (QSAR) are mathematical relationships linking chemical structure and pharmacological activity in a quantitative manner for a series of compounds. Methods which can be used in QSAR include various regression and pattern recognition techniques.QSAR is often taken to be equivalent to chemometrics or multivariate statistical data analysis. It is sometimes used in a more limited sense as equivalent to Hansch analysis. QSAR is a subset of the more general term SPC." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantitative structure–activity relationship" .

goldbook:QT07469 a skos:Concept ;
    skos:altLabel "QC/MM" ;
    skos:definition "Hybrid procedure for the treatment of large molecular systems. A crucial part of the system (e.g., the chromophore and its surroundings) is treated explicitly by quantum mechanical (QM) techniques, whereas the rest of the system is approximated by a classical or molecular mechanics (MM) force field treatment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "quantum mechanics/molecular mechanics" .

goldbook:R00002 a skos:Concept ;
    skos:definition "A measuring assembly incorporating a radiation detector and a pulse amplitude, used for determining the energy spectrum of $\\ce{\\upalpha\\!}$ ($\\ce{\\upbeta\\!}$, $\\ce{\\upgamma\\!}$) radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "α-ray spectrometer" .

goldbook:R02568 a skos:Concept ;
    skos:definition "Electromagnetic radiation emitted in the process of nuclear transformation or particle annihilation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-radiation" .

goldbook:R02570 a skos:Concept ;
    skos:definition "A measuring assembly for determining the energy spectrum of $\\upgamma\\!\\mbox{-}\\rm{rays}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "γ-ray spectrometer" .

goldbook:R05022 a skos:Concept ;
    skos:definition "A logarithmic function of the \\(R_{\\rm{F}}\\) value (retardation factor): \\[R_{\\rm{M}}=\\log _{10}(\\frac{1\\,-\\,R_{\\rm{F}}}{R_{\\rm{F}}})=\\log _{10}(\\frac{1}{R_{\\rm{F}}}\\,-\\,1)\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "RM value" .

goldbook:R05023 a skos:Concept ;
    skos:definition "A small container propelled pneumatically or hydraulically through a tube leading from the laboratory to a location in a nuclear reactor or other device where irradiation of a sample can take place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rabbit" .

goldbook:R05025 a skos:Concept ;
    skos:definition "An equimolar mixture of a pair of enantiomers. It does not exhibit optical activity. The chemical name or formula of a racemate is distinguished from those of the enantiomers by the prefix (±)- or rac- (or racem-) or by the symbols RS and SR." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemate" .

goldbook:R05026 a skos:Concept ;
    skos:definition "Pertaining to a racemate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemic" .

goldbook:R05027 a skos:Concept ;
    skos:definition "A crystalline racemate in which the two enantiomers are present in equal amounts in a well defined arrangement within the lattice of a homogeneous crystalline addition compound." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemic compound" .

goldbook:R05028 a skos:Concept ;
    skos:altLabel "conglomerate" ;
    skos:definition "An equimolar mechanical mixture of crystals each one of which contains only one of the two enantiomers present in a racemate. The process of its formation on crystallization of a racemate is called spontaneous resolution, since pure or nearly pure enantiomers can often be obtained from the conglomerate by sorting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemic conglomerate" .

goldbook:R05029 a skos:Concept ;
    skos:definition "The term is confusing since it has been used as a synonym for both racemate and racemic conglomerate. Usage strongly discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemic mixture" .

goldbook:R05030 a skos:Concept ;
    skos:definition "The production of a racemate from a chiral starting material in which one enantiomer is present in excess." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "racemization" .

goldbook:R05032 a skos:Concept ;
    skos:definition "Non-SI unit of absorbed dose of radiation, \\(\\rm{rad} = 0.01\\ \\rm{Gy}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rad" .

goldbook:R05035 a skos:Concept ;
    skos:altLabel "circular development",
        "circular elution",
        "radial development" ;
    skos:definition "A mode of operation in which the sample is spotted at a point source at or near the middle of the plane and is carried outward in a circle by the mobile phase, also applied at that place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radial elution" .

goldbook:R05036 a skos:Concept ;
    skos:definition "SI derived unit of plane angle, \\(\\rm{rad} = 1\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radian" .

goldbook:R05037 a skos:Concept ;
    skos:definition "Radiant power, \\(P\\), leaving or passing through a small transparent element of surface in a given direction from the source about the solid angle \\(\\varOmega\\), divided by the solid angle and by the orthogonally projected area of the element in a plane normal to the given beam direction, \\(\\rm{d}S_{\\perp } = \\rm{d}S\\, \\rm{cos}\\,\\theta\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiance" .

goldbook:R05039 a skos:Concept ;
    skos:definition "The total energy emitted, transferred or received as radiation in a defined period of time (\\(Q=\\int Q_{\\lambda }  \\ \\mathrm{d}\\lambda \\)). It is the product of radiant power, \\(P\\), and time, \\(t\\): \\(Q=P\\ t\\) when the radiant power is constant over the time considered." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiant energy" .

goldbook:R05041 a skos:Concept ;
    skos:altLabel "exitance",
        "radiant emittance",
        "spherical radiant exitance" ;
    skos:definition "Radiant power, \\(P\\), emitted at all wavelengths by an element of surface containing the source point under consideration divided by the area of the source. SI unit is \\(\\rm{W m}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiant exitance" .

goldbook:R05042 a skos:Concept ;
    skos:definition "Radiant energy, \\(Q\\), incident from all upward directions on a small sphere divided by the cross-sectional area of that sphere. SI unit is \\(\\pu{J m-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiant exposure" .

goldbook:R05045 a skos:Concept ;
    skos:definition "Radiant power, \\(P\\), at all wavelengths per solid angle, \\(\\varOmega\\). The @R05046-2@ emitted in a given direction by a source or an element of the source in a small cone containing the given direction divided by the solid angle of the cone. SI unit is \\(\\rm{W sr}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiant intensity" .

goldbook:R05046 a skos:Concept ;
    skos:definition "Power emitted, transferred or received as radiation. SI unit is \\(\\pu{J s-1} = \\pu{W}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiant power" .

goldbook:R05048 a skos:Concept ;
    skos:definition "A term embracing electromagnetic waves as well as fast moving particles. In radioanalytical chemistry the term usually refers to radiation emitted during a nuclear process (radioactive decay, nuclear reaction, nuclear fission, accelerators)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation" .

goldbook:R05050 a skos:Concept ;
    skos:definition "The part of chemistry which deals with the chemical effects of ionizing radiation, as distinguished from photochemistry associated with visible and ultraviolet electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation chemistry" .

goldbook:R05051 a skos:Concept ;
    skos:definition "Fundamental physical constants characterizing black body radiation. The first radiation constant is \\(c_{1} = 2\\ \\pi \\ h\\ c_{0}^{2}=3.741\\,7749(22)\\times 10^{-16}\\ \\rm{W m}^{2}\\), the second is \\(c_{2} = \\frac{h\\ c_{0}}{k}=1.438\\,769(12)\\times 10^{-2}\\ \\rm{m K}\\), where \\(h\\) is the Planck constant \\(c_{0}\\) the speed of light and \\(k\\) the Boltzmann constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation constants" .

goldbook:R05052 a skos:Concept ;
    skos:definition "Continuous (in the wavelength, not time sense) radiation arising for example from non-quantized free-free transitions of electrons in the fields of the ions, free-bound transitions or radiative recombinations of electrons and ions, incandescent radiation emitted by hot solids (when the radiation distribution conforms to that described by Planck's law, it is considered black-body radiation) and unresolvable band spectra, i.e. where the spectral lines are wider than the spacings between them." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation continuum" .

goldbook:R05053 a skos:Concept ;
    skos:definition "Radiation measuring assembly comprising a radiation detector in which individual ionizing events cause electrical pulses and the associated equipment for processing and counting the pulses. Often an expression is added indicating the type of radiation detector (e.g. scintillation, semiconductor)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation counter" .

goldbook:R05054 a skos:Concept ;
    skos:definition "A device in which incident radiation produces a measurable effect. If this effect is a rise in temperature it is called a thermal detector. If it is a rise in pressure it is called a photoacoustic detector. In the case where an electrical signal is produced it is called a photoelectric detector. Photoelectric detectors can be classified as photo-emissive detectors and semiconductor detectors. Where the radiation produces a chemical reaction, it is termed a photochemical detector. A detector yielding an output signal that is independent of the wavelength of the radiation over a specific region is called a nonselective detector. Where it is wavelength specific it is a selective detector. A detector having a quantum efficiency independent of the wavelength is a nonselective quantum counter. Certain detectors are able to distinguish between different quantum energies. This property is described by the energy resolution \\(\\Delta E\\) and the energy resolving power \\(\\frac{E}{\\Delta E}\\). These detectors are called energy dispersive detectors. In X-ray spectroscopy, the reciprocal \\(\\frac{\\Delta E}{E}\\) is often used but this is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation detector" .

goldbook:R05055 a skos:Concept ;
    skos:definition "Hazard that exists in a region where there is a radiation field, other than what is considered to be normal background radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation hazard" .

goldbook:R05056 a skos:Concept ;
    skos:altLabel "radiationless decay" ;
    skos:definition "Loss of electronic excitation energy without photon emission or chemical change. Often, ultrafast radiationless decays are mediated by conical intersections." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiationless deactivation" .

goldbook:R05057 a skos:Concept ;
    skos:definition "A transition between two states of a system without photon emission or absorption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiationless transition" .

goldbook:R05059 a skos:Concept ;
    skos:definition "The components of radiation arranged in order of their wavelengths, frequencies or quantum energies. For particle radiation they are arranged in order of their kinetic energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation spectrum" .

goldbook:R05060 a skos:Concept ;
    skos:definition "A process by which a particle in the ground state or an excited state may undergo transition to a higher energy level by absorption of a photon. For a given particle in the lower state of probability per second of such a transition in a field with a continuous spectrum is proportional to the spectral radiant energy density of the absorption line. The proportionality constant is termed the transition probability for absorption. The transition probability for stimulated emission is defined in a similar way for the reverse radiative de-excitation process that is induced by the same radiation field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative absorption" .

goldbook:R05061 a skos:Concept ;
    skos:definition "Capture of a particle by a nucleus followed by immediate emission of gamma radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative capture" .

goldbook:R05062 a skos:Concept ;
    skos:definition "The change in the internal energy of a particle may be due to radiative processes, i.e. the emission or absorption of a photon. A particle in an excited state may undergo a transition to a lower energy level by emission of a photon. This is known as radiative de-excitation. If such a transition occurs spontaneously its probability per second for a given excited particle is termed the transition probability for spontaneous emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative de-excitation" .

goldbook:R05063 a skos:Concept ;
    skos:altLabel "trivial energy transfer" ;
    skos:definition "Transfer of excitation energy by radiative deactivation of a donor molecular entity and reabsorption of the emitted radiation by an acceptor molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative energy transfer" .

goldbook:R05064 a skos:Concept ;
    skos:definition "Lifetime of an excited molecular entity in the absence of radiationless transitions. The reciprocal of the first-order rate constant for the radiative step, or the reciprocal of the sum of these rate constants if there is more than one such step. The equivalent term, natural lifetime, is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative lifetime" .

goldbook:R05065 a skos:Concept ;
    skos:definition "A transition between two states of a molecular entity, the energy difference being emitted or absorbed as photons. In principle, radiative and radiationless transitions can be distinguished in molecules. The first occur by absorption or emission of light quanta, and the latter is the result of the transformation of electronic excitation energy into vibrational/rotational energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiative transition" .

goldbook:R05066 a skos:Concept ;
    skos:altLabel "free radical" ;
    skos:definition "A molecular entity such as $\\ce{^{.}CH3}$, $\\ce{^{.}SnH3}$, $\\ce{Cl^{.}}$ possessing an unpaired electron. (In these formulae the dot, symbolizing the unpaired electron, should be placed so as to indicate the atom of highest spin density, if this is possible.) Paramagnetic metal ions are not normally regarded as radicals. However, in the 'isolobal analogy' the similarity between certain paramagnetic metal ions and radicals becomes apparent. At least in the context of physical organic chemistry, it seems desirable to cease using the adjective 'free' in the general name of this type of chemical species and molecular entity, so that the term 'free radical' may in future be restricted to those radicals which do not form parts of radical pairs. Depending upon the core atom that possesses the unpaired electron, the radicals can be described as carbon-, oxygen-, nitrogen-, metal-centered radicals. If the unpaired electron occupies an orbital having considerable s or more or less pure p character, the respective radicals are termed $\\ce{\\upsigma\\!\\mbox{-}}$ or $\\ce{\\uppi\\!\\mbox{-}radicals}$. In the past, the term 'radical' was used to designate a substituent group bound to a molecular entity, as opposed to 'free radical', which nowadays is simply called radical. The bound entities may be called groups or substituents, but should no longer be called radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical" .

goldbook:R05069 a skos:Concept ;
    skos:altLabel "radical center",
        "radical centers",
        "radical centres" ;
    skos:definition "The atom (or group of atoms) in a polyatomic radical on which an unpaired electron is largely localized. attachment of a monovalent atom to a radical centre gives a molecule for which it is possible to write a Lewis formula in which the normal stable valencies are assigned to all atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical centre" .

goldbook:R05071 a skos:Concept ;
    skos:definition "A copolymerization which is a radical polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical copolymerization" .

goldbook:R05073 a skos:Concept ;
    skos:definition "A radical that carries an electric charge. A positively charged radical is called a 'radical cation' (e.g. the benzene radical cation $\\ce{C6H6^{.+}}$); a negatively charged radical is called a 'radical anion' (e.g. the benzene radical anion $\\ce{C6H^{.−}}$ or the benzophenone radical anion $\\ce{Ph2C–O^{.−}}$). Commonly, but not necessarily, the odd electron and the charge are associated with the same atom. Unless the positions of unpaired spin and charge can be associated with specific atoms, superscript dot and charge designations should be placed in the order $\\ce{^{.+}}$ or $\\ce{^{.-}}$ suggested by the name 'radical ion'. (e.g. $\\ce{C3H6^{.+}}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical ion" .

goldbook:R05074 a skos:Concept ;
    skos:altLabel "CIDNP",
        "geminate pair" ;
    skos:definition "The term is used to identify two radicals in close proximity in solution, within a solvent cage. They may be formed simultaneously by some unimolecular process, e.g. peroxide decomposition, or they may have come together by diffusion. While the radicals are together, correlation of the unpaired electron spins of the two species cannot be ignored: this correlation is responsible for the CIDNP phenomenon. A radical pair is called geminate provided that each radical partner is a descendant of the same parental pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical pair" .

goldbook:R05075 a skos:Concept ;
    skos:definition "A chain polymerization in which the kinetic-chain carriers are radicals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical polymerization" .

goldbook:R05077 a skos:Concept ;
    skos:definition "The property of a nuclide of undergoing spontaneous nuclear transformations with the emission of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive" .

goldbook:R05078 a skos:Concept ;
    skos:definition "The time, estimated from measurement of the isotopic composition, during which the content of a radioactive species within an object has remained unchanged except for nuclear decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive age" .

goldbook:R05080 a skos:Concept ;
    skos:definition "A radioactive substance in a material or place where it is undesirable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive contamination" .

goldbook:R05081 a skos:Concept ;
    skos:definition "Of a strongly radioactive material, the decrease of its activity by nuclear decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive cooling" .

goldbook:R05082 a skos:Concept ;
    skos:definition "The determination of the radioactive age of an object from its content of radioactive substances and of their daughter products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive dating" .

goldbook:R05083 a skos:Concept ;
    skos:definition "Nuclear decay in which particles or electromagnetic radiation are emitted or the nucleus undergoes spontaneous fission or electron capture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive decay" .

goldbook:R05084 a skos:Concept ;
    skos:definition "Among the members of a decay chain, the state which prevails when the ratios between the activities of successive members remain constant. (This is not an equilibrium in the strict sense since radioactive decay is an irreversible process)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive equilibrium" .

goldbook:R05085 a skos:Concept ;
    skos:definition "The deposition on the ground of radioactive substances from nuclear explosions and other injections of radioactive material into the atmosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive fallout" .

goldbook:R05088 a skos:Concept ;
    skos:definition "Any quantity of radioactive material which is intended for use as a source of ionizing radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive source" .

goldbook:R05089 a skos:Concept ;
    skos:definition "A tracer containing a radioactive label." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive tracer" .

goldbook:R05090 a skos:Concept ;
    skos:definition "A technique for investigating recovery and loss of a microcomponent, in which a radioactively-labelled element or compound chemically identical with the microcomponent is added to the sample before preconcentration and its behaviour is followed by sensitive, rapid and selective radioactivity measurements." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive tracer technique" .

goldbook:R05091 a skos:Concept ;
    skos:definition "Unwanted radioactive materials obtained in the processing or handling of radioactive materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactive waste" .

goldbook:R05092 a skos:Concept ;
    skos:definition "The property of certain nuclides showing radioactive decay." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioactivity" .

goldbook:R05094 a skos:Concept ;
    skos:definition "A kind of activation analysis in which, after the irradiation, chemical or physical separation is applied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochemical activation analysis" .

goldbook:R05095 a skos:Concept ;
    skos:definition "Chemical separation applied to a radioactive preparation in order to improve the radiochemical purity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochemical purification" .

goldbook:R05096 a skos:Concept ;
    skos:definition "For a material, the fraction of the stated isotope present in the stated chemical form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochemical purity" .

goldbook:R05097 a skos:Concept ;
    skos:definition "Separation by a chemical means of the radioactive isotopes of a specific element from a mixture of radionuclides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochemical separation" .

goldbook:R05098 a skos:Concept ;
    skos:definition "The yield of a radiochemical separation expressed as a fraction of the activity originally present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochemical yield" .

goldbook:R05099 a skos:Concept ;
    skos:definition "That part of chemistry which deals with radioactive materials. It includes the production of radionuclides and their compounds by processing irradiated materials or naturally occurring radioactive materials, the application of chemical techniques to nuclear studies, and the application of radioactivity to the investigation of chemical, biochemical or biomedical problems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochemistry" .

goldbook:R05100 a skos:Concept ;
    skos:definition "A measuring assembly designed to measure the spatial or time distribution of the activity of a mixture of radioactive components after separation by a chromatographic method." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiochromatograph" .

goldbook:R05101 a skos:Concept ;
    skos:definition "A colloid in which some atoms are radioactive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiocolloid" .

goldbook:R05102 a skos:Concept ;
    skos:definition "An assay of the catalytic activity of an enzyme based on the use of a radioactive substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioenzymatic assay" .

goldbook:R05103 a skos:Concept ;
    skos:definition "A visual representation of an object produced by placing the object between a source of ionizing radiation and a photographic plate or film." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiograph" .

goldbook:R05104 a skos:Concept ;
    skos:definition "A kind of quantitative analysis in which the activity of a precipitate is used as a measure of its mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiogravimetric analysis" .

goldbook:R05105 a skos:Concept ;
    skos:definition "An assay based on the reversible and non-covalent binding of an antigen (hapten) by a specific antibody employing radioactivity labelled antigen (hapten) to measure the fraction of the antigen (hapten) bound to a substoichiometric amount of antibody." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioimmunoassay" .

goldbook:R05107 a skos:Concept ;
    skos:definition "The process of incorporating the radionuclides of iodine (usually $\\ce{^{125}I}$, $\\ce{^{131}I}$ or $\\ce{^{123}I}$) into, or of covalently linking a radioiodinated substance to, a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioiodination" .

goldbook:R05108 a skos:Concept ;
    skos:definition "A radioactive isotope of a specified element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioisotope" .

goldbook:R05109 a skos:Concept ;
    skos:definition "A kind of isotope dilution analysis making use of a radionuclide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioisotope dilution analysis" .

goldbook:R05110 a skos:Concept ;
    skos:definition "A kind of analysis based on the measurement of the energies and intensities of characteristic X-radiation emitted by a test portion during irradiation with a radioactive source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioisotope induced X-ray emission analysis" .

goldbook:R05111 a skos:Concept ;
    skos:definition "Luminescence arising from excitation by high-energy particles or radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioluminescence" .

goldbook:R05112 a skos:Concept ;
    skos:definition "The cleavage of one or several bonds resulting from exposure to high-energy radiation. The term is also often used loosely to specify the method of irradiation ('pulse radiolysis') used in any radiochemical reaction, not necessarily one involving bond cleavage." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiolysis" .

goldbook:R05113 a skos:Concept ;
    skos:definition "A kind of quantitative analysis in which measurement of the activity is an essential step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiometric analysis" .

goldbook:R05114 a skos:Concept ;
    skos:definition "A titration in which a radioactive indicator is used to monitor the end-point of the titration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiometric titration" .

goldbook:R05115 a skos:Concept ;
    skos:definition "The measurement of quantities associated with radiant energy. The quantities may also describe the variation of the energy with respect to other variables such as wavelength, time, position, direction (solid angle), area normal to the light or projected area of emitting or receiving surfaces. If the light is monochromatic, it is sometimes convenient to replace the radiant energy by the corresponding number of photons (or quanta) which is obtained by dividing the energy by \\(\\frac{h\\ c}{\\lambda }\\) where \\(h\\) is the Planck constant, \\(c\\) the velocity of light and \\(\\lambda \\) the wavelength of the light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiometry" .

goldbook:R05116 a skos:Concept ;
    skos:definition "A nuclide that is radioactive." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radionuclide" .

goldbook:R05117 a skos:Concept ;
    skos:definition "For a material, that fraction of the total activity which is present in the form of the stated radionuclide, including daughter products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radionuclidic purity" .

goldbook:R05118 a skos:Concept ;
    skos:definition "An assay employing a radioactively labelled receptor protein as a tracer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radioreceptor assay" .

goldbook:R05119 a skos:Concept ;
    skos:definition "A kind of quantitative analysis based on the release of radioactivity from the reagent by reaction with the analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiorelease analysis" .

goldbook:R05120 a skos:Concept ;
    skos:definition "A miniature radio transmitter with instruments in a package that is carried aloft (e.g. by an unmanned balloon) for broadcasting every few seconds by means of precise tone signals or other suitable method, the humidity, temperature, pressure or other parameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiosonde" .

goldbook:R05122 a skos:Concept ;
    skos:definition "The phase remaining after extraction of some specified solute(s). When necessary it should be further specified, e.g. scrub raffinate. The original meaning of raffinate as a 'refined product' has become extended and changed by common usage. The term should normally be applied only to waste streams but the latter may form the feed to a further extraction process for another solute." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "raffinate" .

goldbook:R05123 a skos:Concept ;
    skos:definition "The mechanism by which small particles in the clouds are removed by the formation of raindrops; this is a different mechanism from wash out which is a process which occurs below cloud level. Both the terms rain out and wash out have not always been used in accordance with these definitions. For clarity they should be replaced by the terms, in-cloud scavenging and below-cloud scavenging, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rain out" .

goldbook:R05125 a skos:Concept ;
    skos:definition "A coincidence of events occurring in not physically connected nuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random coincidence" .

goldbook:R05126 a skos:Concept ;
    skos:definition "A copolymer consisting of macromolecules in which the probability of finding a given monomeric unit at any given site in the chain is independent of the nature of the adjacent units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random copolymer" .

goldbook:R05127 a skos:Concept ;
    skos:definition "A copolymerization in which a random copolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random copolymerization" .

goldbook:R05129 a skos:Concept ;
    skos:definition "The sample so selected that any portion of the population has an equal (or known) chance of being chosen. Haphazard or arbitrary choice of units is generally insufficient to guarantee randomness." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "random sample" .

goldbook:R05134 a skos:Concept ;
    skos:definition "The range of concentration between the measurement threshold and the maximum usable indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "range of measurement" .

goldbook:R05136 a skos:Concept ;
    skos:definition "Derived quantity in which time is a denominator quantity. Rate of \\(x\\) is \\(\\frac{\\rm{d}x}{\\rm{d}t}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate" .

goldbook:R05139 a skos:Concept ;
    skos:definition "A rate-controlling (rate-determining or rate-limiting) step in a reaction occurring by a composite reaction sequence is an elementary reaction the rate constant for which exerts a strong effect — stronger than that of any other rate constant — on the overall rate. It is recommended that the expressions rate-controlling, rate-determining and rate-limiting be regarded as synonymous, but some special meanings sometimes given to the last two expressions are considered under a separate heading. A rate-controlling step can be formally defined on the basis of a control function (or control factor) CF, identified for an elementary reaction having a rate constant \\(k_{i}\\) by: \\[\\rm{CF}=\\frac{\\partial (\\ln  u)}{\\partial \\ln k_{i}}\\] where \\( u\\) is the overall rate of reaction. In performing the partial differentiation all equilibrium constants \\(K_{j}\\) and all rate constants except \\(k_{i}\\) are held constant. The elementary reaction having the largest control factor exerts the strongest influence on the rate \\( u\\), and a step having a CF much larger than any other step may be said to be rate-controlling. A rate-controlling step defined in the way recommended here has the advantage that it is directly related to the interpretation of kinetic isotope effects. As formulated this implies that all rate constants are of the same dimensionality. Consider however the reaction of A and B to give an intermediate C, which then reacts further with D to give products:      (1)      (2)   Assuming that C reaches a steady state, then the observed rate is given by: \\[ u = \\frac{k_{1}\\,k_{2}\\,\\left[\\rm{A}\\right]\\left[\\rm{B}\\right]\\left[\\rm{D}\\right]}{k_{-1}+k_{2}\\left[\\rm{D}\\right]}\\] Considering \\(k_{2}\\left[\\rm{D}\\right]\\) a pseudo-first order rate constant, then \\(k_{2}\\left[\\rm{D}\\right]\\gg k_{-1}\\), and the observed rate \\( u = k_{1}\\ \\left[\\rm{A}\\right]\\left[\\rm{B}\\right]\\) and \\(k_{\\rm{obs}}=k_{1}\\). Step (1) is said to be the rate-controlling step. If \\(k_{2}\\left[\\rm{D}\\right]\\ll k_{-1}\\), then the observed rate: \\[ u = \\frac{k_{1}\\ k_{2}}{k_{-1}}\\left[\\rm{A}\\right]\\left[\\rm{B}\\right]\\left[\\rm{D}\\right]=K\\ k_{2}\\left[\\rm{A}\\right]\\left[\\rm{B}\\right]\\left[\\rm{D}\\right]\\] where \\(K\\) is the equilibrium constant for the pre-equilibrium (1) and is equal to \\(\\frac{k_{1}}{k_{-1}}\\), and \\(k_{\\rm{obs}}=K\\ k_{2}\\). Step (2) is said to be the rate-controlling step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate-controlling step" .

goldbook:R05140 a skos:Concept ;
    skos:altLabel "rate-limiting step" ;
    skos:definition "These terms are best regarded as synonymous with rate-controlling step. However, other meanings that have been given to them should be mentioned, as it is necessary to be aware of them in order to avoid confusion. Sometimes the term rate-determining is used as a special case of rate-controlling, being assigned only to an initial slow step which is followed by rapid steps. Such a step imposes an upper limit on the rate, and has also been called rate-limiting. In view of the considerable danger of confusion when special meanings are applied to rate-determining and rate-limiting, it is recommended that they be regarded as synonymous, with the meaning explained under the entry rate-controlling step." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate-determining step" .

goldbook:R05141 a skos:Concept ;
    skos:altLabel "empirical differential rate equation" ;
    skos:definition "An expression for the rate of reaction of a particular reaction in terms of concentrations of chemical species and constant parameters (normally rate coefficients and partial orders of reaction) only. For examples of rate laws see equations (1)-(3) under kinetic equivalence, and (1) under steady state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate law" .

goldbook:R05142 a skos:Concept ;
    skos:definition "An electronic sub-assembly which gives a continuous indication proportional to the average counting rate over a predetermined time interval (time constant)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ratemeter" .

goldbook:R05144 a skos:Concept ;
    skos:definition "The time derivative \\(\\frac{\\rm{d}Q}{\\rm{d}t}\\) of the value of the quantity. The differential quotient may also be called derivative (or instantaneous) rate of change. Examples are: rate of change of mass, \\(\\frac{\\rm{d}m}{\\rm{d}t}\\); rate of change of amount of substance, \\(\\frac{\\rm{d}n}{\\rm{d}t}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of change of a quantity" .

goldbook:R05145 a skos:Concept ;
    skos:definition "The quotient of two rates where the quantities are of the same kind in the same system for different components: \\[\\frac{\\rm{d}Q_{1}/\\rm{d}t}{\\rm{d}Q_{2}/\\rm{d}t}\\] For finite time intervals, mean rate of change ratio is: \\[\\frac{\\Delta Q_{1}/\\Delta t}{\\Delta Q_{2}/\\Delta t}=\\frac{\\Delta Q_{1}}{\\Delta Q_{2}}\\ \\Delta t\\] Rate of change ratio has the dimension one. The denominator is often called the reference quantity. Examples are: mass rate ratio, \\(\\frac{\\rm{d}m_{1}/\\rm{d}t}{\\rm{d}m_{2}/\\rm{d}t}\\); amount of substance rate ratio, \\(\\frac{\\rm{d}n_{1}/\\rm{d}t}{\\rm{d}n_{2}/\\rm{d}t}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of change ratio" .

goldbook:R05146 a skos:Concept ;
    skos:definition "The rate of consumption of a specified reactant may be defined in two ways:As the negative of the time derivative of the amount of reactant; thus for a reactant B, present at any time in amount \\(n_{\\rm{B}}\\), the rate of its consumption may be defined as: \\[ u (n_{\\rm{B}}) = -\\frac{\\rm{d}n_{\\rm{B}}}{\\rm{d}t}\\] This definition is particularly appropriate for open systems. Here and elsewhere, when a rate is defined in terms of a time derivative, it must be understood that the definition relates to the process occurring in isolation. In a flow system there may be no actual changes with time, and the time derivative must be inferred. Such an inference is also required for a reaction occurring by a composite mechanism.For kinetics in closed systems it is more usual to define a rate of consumption per unit volume; thus for a reactant B the rate of consumption, \\( u (c_{\\rm{B}}) \\) is given by: \\[ u (c_{\\rm{B}}) = -\\frac{1}{V}\\frac{\\rm{d}n_{\\rm{B}}}{\\rm{d}t}\\] When the volume \\(V\\) is constant this reduces to: \\[ u (c_{\\rm{B}}) = -\\frac{\\rm{d[B]}}{\\rm{d}t}\\] When the volume is not constant the relationship \\(n_{\\rm{B}} = [\\rm{B}]V\\) may be differentiated to give: \\[{\\rm{d}}c_{\\rm{B}} = V\\rm{d[B]} + \\rm{[B]d}V\\] and therefore: \\[ u (c_{\\rm{B}}) = -\\frac{\\rm{d[B]}}{\\rm{d}t} - \\frac{\\rm{[B]}}{V}\\frac{\\rm{d}V}{\\rm{d}t}\\] In contrast to the rate of conversion and the rate of reaction, the rate of consumption of a reactant may be specified even for a reaction of time-dependent stoichiometry or of unknown stoichiometry. The rate of consumption of a reactant is often called its rate of disappearance. However, the former expression is to be preferred since the word disappearance is not appropriately translatable into certain languages. When English is used the word disappearance might be reserved for cases where the reactant is almost completely removed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of consumption" .

goldbook:R05147 a skos:Concept ;
    skos:definition "The rate of conversion for a reaction occurring in a closed system is defined as the time derivative of the extent of reaction: \\[\\overset{\\rm{.}}{\\xi }=\\frac{\\mathrm{d}\\xi }{\\mathrm{d}t}\\] In view of the definition of extent of reaction it follows that with reference to any species in a reaction showing time-independent stoichiometry \\[\\overset{\\rm{.}}{\\xi }=\\frac{\\mathrm{d}\\xi }{\\mathrm{d}t}=\\frac{1}{ u _{i}}\\ \\frac{\\mathrm{d}n_{i}}{\\mathrm{d}t}\\] where \\(n_{i}\\) is the amount of the species at any time and \\( u _{i}\\) is its stoichiometric coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of conversion" .

goldbook:R05151 a skos:Concept ;
    skos:definition "The volume of fluid consumed by the nebulizer divided by time (in \\(\\unicode[Times]{x3BC}\\rm{L}\\ \\rm{s}^{-1}\\)). Volume rate has also been called volume flow, flux, aspiration rate, aspiration flow or aspiration flux. The fluid consumed is either aspirated or injected. The volume rate of fluid consumption by nebulizers is usually between \\(10\\) and \\(100\\ \\unicode[Times]{x3BC}\\rm{L}\\ \\rm{s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of fluid consumption" .

goldbook:R05152 a skos:Concept ;
    skos:definition "Like the rate of consumption, the rate of formation of a specified product may be defined in two ways:As the time derivative of the amount of a product. Thus for a product $\\ce{Y}$, present at any time in amount \\(n_{\\rm{Y}}\\). the rate of its formation may be given by: \\[ u (n_{\\rm{Y}}) = \\frac{\\rm{d}n_{\\rm{Y}}}{\\rm{d}t}\\] This definition is particularly appropriate for open systems.For kinetics in closed systems it is more usual to define a rate of formation per unit volume, denoted \\( u (c_{\\rm{Y}}) \\): \\[ u (c_{\\rm{Y}}) = \\frac{1}{V}\\frac{\\rm{d}n_{\\rm{Y}}}{\\rm{d}t}\\] When the volume is constant this reduces to: \\[ u (c_{\\rm{Y}}) = \\frac{1}{V}\\frac{\\rm{d}n_{\\rm{Y}}}{\\rm{d}t} = \\frac{\\rm{d[Y]}}{\\rm{d}t}\\] When the volume is not constant the relationship \\(n_{\\rm{Y}} = [\\rm{Y}]V\\) may be differentiated to give: \\[{\\rm{d}}n_{\\rm{Y}} = V\\rm{d[Y]} + \\rm{[Y]d}V\\] and the rate of formation becomes: \\[ u (c_{\\rm{Y}}) = \\frac{\\rm{d[Y]}}{\\rm{d}t} + \\frac{\\rm{[Y]}}{V}\\frac{\\rm{d}V}{\\rm{d}t}\\] A rate of formation may be specified even for a reaction of time dependent stoichiometry or of unknown stoichiometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of formation" .

goldbook:R05154 a skos:Concept ;
    skos:definition "The distance of migration divided by time, sometimes called velocity of migration. The symbol \\(v\\) is also used for velocity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of migration" .

goldbook:R05156 a skos:Concept ;
    skos:definition "For the general chemical reaction: \\[\\ce{aA + bB -> pP + qQ + \\dots}\\] occurring under constant-volume conditions, without an appreciable build-up of reaction intermediates, the rate of reaction \\( u\\) is defined as: \\[ u = -\\frac{1}{a}\\frac{{\\rm{d}}[\\ce{A}]}{{\\rm{d}}t} = -\\frac{1}{b}\\frac{{\\rm{d}}[\\ce{B]}}{{\\rm{d}}t} = \\frac{1}{p}\\frac{{\\rm{d}}[\\ce{P]}}{{\\rm{d}}t} = \\frac{1}{q}\\frac{{\\rm{d}}[\\ce{Q]}}{{\\rm{d}}t}\\] where symbols placed inside square brackets denote amount (or amount of substance) concentrations (conventionally expressed in units of \\(\\pu{mol dm-3}\\)). The symbols \\(R\\) and \\(r\\) are also commonly used in place of \\( u\\). It is recommended that the unit of time should always be the second. In such a case the rate of reaction differs from the rate of increase of concentration of a product P by a constant factor (the reciprocal of its coefficient in the stoichiometric equation, \\(p\\)) and from the rate of decrease of concentration of the reactant A by \\(\\alpha^{-1}\\). The quantity: \\[\\dot{\\xi} = \\frac{{\\rm{d}}\\xi}{{\\rm{d}}t}\\] defined by the equation: \\[\\dot{\\xi} = -\\frac{1}{a} \\frac{{\\rm{d}}n_{\\ce{A}}}{{\\rm{d}}t}  = -\\frac{1}{b} \\frac{{\\rm{d}}n_{\\ce{B}}}{{\\rm{d}}t} = \\frac{1}{p} \\frac{{\\rm{d}}n_{\\ce{P}}}{{\\rm{d}}t} = \\frac{1}{q} \\frac{{\\rm{d}}n_{\\ce{Q}}}{{\\rm{d}}t}\\] (where \\(n_{\\ce{A}}\\) designates the amount of substance A, conventionally expressed in units of mole) may be called the 'rate of conversion' and is appropriate when the use of concentrations is inconvenient, e.g. under conditions of varying volume. In a system of constant volume, the rate of reaction is equal to the rate of conversion per unit volume throughout the reaction. For a stepwise reaction this definition of 'rate of reaction' (and 'extent of reaction', \\(\\xi \\)) will apply only if there is no accumulation of intermediate or formation of side products. It is therefore recommended that the term 'rate of reaction' be used only in cases where it is experimentally established that these conditions apply. More generally, it is recommended that, instead, the terms 'rate of disappearance' or 'rate of consumption' of A (i.e. \\(-\\frac{{\\rm{d}}[\\ce{A}]}{{\\rm{d}}t}\\), the rate of decrease of concentration of A) or 'rate of appearance' of P (i.e. \\(\\frac{{\\rm{d}}[\\ce{P}]}{{\\rm{d}}t}\\), the rate of increase of concentration of product P) be used, depending on the concentration change of the particular chemical species that is actually observed. In some cases reference to the chemical flux observed may be more appropriate. The symbol \\( u\\) (without lettered subscript) should be used only for rate of reaction; \\( u\\) with a lettered subscript (e.g. \\( u_{\\ce{A}}\\)) refers to a rate of appearance or rate of disappearance (e.g. of the chemical species A)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rate of reaction" .

goldbook:R05157 a skos:Concept ;
    skos:definition "Quotient of quantities of the same kind for different components within the same system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ratio" .

goldbook:R05158 a skos:Concept ;
    skos:definition "The term raw coke is equivalent to green coke although it is now used less frequently." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "raw coke" .

goldbook:R05160 a skos:Concept ;
    skos:definition "The scattering of light by particles and molecules which are much smaller than the wavelength of the light. In the ideal case, the process is one of pure dipole and induced dipole interactions with the electric field of the light wave. The scattering cross section for light of wavelength \\(\\lambda \\) is proportional to \\(\\lambda ^{-4}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rayleigh scattering" .

goldbook:R05161 a skos:Concept ;
    skos:definition "Carbon fibres made from rayon (cellulose) precursor fibres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rayon-based carbon fibres" .

goldbook:R05163 a skos:Concept ;
    skos:altLabel "reagent" ;
    skos:definition "A substance that is consumed in the course of a chemical reaction. It is sometimes known, especially in the older literature, as a 'reagent', but this term is better used in a more specialized sense as a test substance that is added to a system in order to bring about a reaction or to see whether a reaction occurs (e.g. an analytical reagent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactant" .

goldbook:R05164 a skos:Concept ;
    skos:definition "For an internal motion of a molecular entity corresponding to progress over a transition state (energy maximum), any change that makes the motion more difficult will lead to a new molecular geometry at the energy maximum, in which the motion has proceeded further. Changes that make the motion less difficult will have the opposite effect. (This rule corresponds to the Hammond principle).For an internal motion of a molecular entity that corresponds to a vibration, any change that tends to modify the equilibrium point of the vibration in a particular direction will actually shift the equilibrium in that direction.Effects on reacting bonds (bonds made or broken in the reaction) are the most significant. The bonds nearest the site of structural change are those most strongly affected." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reacting bond rules" .

goldbook:R05166 a skos:Concept ;
    skos:definition "The energy barrier to chemical reaction. In vibrationally adiabatic transition-state theory its height is the zero-point energy of the activated complex minus that of the reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction barrier" .

goldbook:R05167 a skos:Concept ;
    skos:definition "A technique in which the identities of the sample components are intentionally changed between sample introduction and detection. The reaction can take place upstream of the column when the chemical identity of the individual components passing through the column differs from that of the original sample, or between the column and the detector when the original sample components are separated in the column but their identity is changed prior to entering the detection device." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction chromatography" .

goldbook:R05168 a skos:Concept ;
    skos:definition "A geometric parameter that changes during the conversion of one (or more) reactant molecular entities into one (or more) product molecular entities and whose value can be taken for a measure of the progress of an elementary reaction (for example, a bond length or bond angle or a combination of bond lengths and/or bond angles; it is sometimes approximated by a non-geometric parameter, such as the bond order of some specified bond). In the formalism of 'transition-state theory', the reaction coordinate is that coordinate in a set of curvilinear coordinates obtained from the conventional ones for the reactants which, for each reaction step, leads smoothly from the configuration of the reactants through that of the transition state to the configuration of the products. The reaction coordinate is typically chosen to follow the path along the gradient (path of shallowest ascent/deepest descent) of potential energy from reactants to products. The term has also been used interchangeably with the term transition coordinate, applicable to the coordinate in the immediate vicinity of the potential energy maximum. Being more specific, the name transition coordinate is to be preferred in that context." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction coordinate" .

goldbook:R05169 a skos:Concept ;
    skos:definition "A quantity used in collision theories of reactions in order to interpret calculated or experimental rates. In some collision theories the reaction cross-section is considered to be related to \\(b_{\\max }\\), the maximum value of the impact parameter that allows reaction to occur, by: \\[\\sigma _{\\rm{r}}=P_{\\rm{r}}\\ \\pi \\ b_{\\max }^{2}\\] where \\(P_{\\rm{r}}\\) is the reaction probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction cross-section" .

goldbook:R05170 a skos:Concept ;
    skos:definition "A branch of chemical kinetics that is concerned with the intermolecular and intramolecular motions that occur in the elementary act of chemical change, and with the details of the relationships between the quantum states of the reactant molecules and those of the product molecules. It is also known as molecular dynamics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction dynamics" .

goldbook:R05174 a skos:Concept ;
    skos:definition "A synonym for mechanism.A trajectory on the potential-energy surface.A sequence of synthetic steps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction path" .

goldbook:R05175 a skos:Concept ;
    skos:altLabel "statistical factor" ;
    skos:definition "A factor that is introduced into rate theory to take account of the fact that the process may be able to occur in different but equivalent ways. Thus the process:  has a reaction path degeneracy of 2 since the chlorine atom can abstract either of the two hydrogen atoms in the hydrogen molecule. The reaction path degeneracy has also been referred to as the statistical factor for the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction path degeneracy" .

goldbook:R05176 a skos:Concept ;
    skos:definition "The probability that a reaction occurs when two particles undergo a collision. If \\(N_{\\rm{c}}\\) is the number of collisions occurring in unit time, and \\(N_{\\rm{r}}\\) the number of reactions occurring in unit time: \\(P_{\\rm{r}}=\\frac{N_{\\rm{r}}}{N_{\\rm{c}}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction probability" .

goldbook:R05177 a skos:Concept ;
    skos:definition "A set of one or more (possibly experimentally inseparable) reaction steps leading to and/or from a detectable or presumed reaction intermediate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction stage" .

goldbook:R05178 a skos:Concept ;
    skos:definition "An elementary reaction, constituting one of the stages of a stepwise reaction in which a reaction intermediate (or, for the first step, the reactants) is converted into the next reaction intermediate (or, for the last step, the products) in the sequence of intermediates between reactants and products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction step" .

goldbook:R05179 a skos:Concept ;
    skos:definition "The period of time that elapses between the start of the reaction and the attainment of a given extent of a reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction time" .

goldbook:R05180 a skos:Concept ;
    skos:definition "As applied to a chemical species, the term expresses a kinetic property. A species is said to be more reactive or to have a higher reactivity in some given context than some other (reference) species if it has a larger rate constant for a specified elementary reaction. The term has meaning only by reference to some explicitly stated or implicitly assumed set of conditions. It is not to be used for reactions or reaction patterns of compounds in general. The term is also more loosely used as a phenomenological description not restricted to elementary reactions. When applied in this sense the property under consideration may reflect not only rate, but also equilibrium, constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive" .

goldbook:R05181 a skos:Concept ;
    skos:definition "Reactive adsorption (and its reverse, reactive desorption) resembles dissociative adsorption (and its reverse, dissociative adsorption) but one fragment adds to an adsorbate rather than to a surface site." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive adsorption" .

goldbook:R05182 a skos:Concept ;
    skos:definition "A species of very short life that occurs as an intermediate in a chemical reaction. An activated complex (or transition state) is a special case." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive complex" .

goldbook:R05184 a skos:Concept ;
    skos:definition "If in a molecular-beam experiment a chemical reaction occurs there is said to be reactive scattering." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive scattering" .

goldbook:R05185 a skos:Concept ;
    skos:definition "Any numerical index derived from quantum mechanical model calculations that permits the prediction of relative reactivities of different molecular sites. Many indices are in use, based on a variety of theories and relating to various types of reaction. The more successful applications have been to the substitution reactions of conjugated systems where relative reactivities are determined largely by changes of $\\ce{\\uppi\\!\\mbox{-}electron}$ energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactivity index" .

goldbook:R05186 a skos:Concept ;
    skos:altLabel "RSP" ;
    skos:definition "This idea may be expressed loosely as: the more reactive a reagent is, the less selective it is. Consider two substrates \\(\\rm{S}^{1}\\) and \\(\\rm{S}^{2}\\) undergoing the same type of reaction with two reagents \\(\\rm{R}^{1}\\) and \\(\\rm{R}^{2}\\), \\(\\rm{S}^{2}\\) being more reactive than \\(\\rm{S}^{1}\\), and \\(\\rm{R}^{2}\\) more reactive than \\(\\rm{R}^{1}\\) in the given type of reaction. The relative reactivities (in log units) for the four possible reactions may notionally be represented as shown in the diagram.  With the positions of (\\(\\rm{S}^{1}+\\rm{R}^{1}\\)), (\\(\\rm{S}^{2}+\\rm{R}^{1}\\)) and (\\(\\rm{S}^{1}+\\rm{R}^{2}\\)) fixed, there are three types of positions for (\\(\\rm{S}^{2}+\\rm{R}^{2}\\)). In position (i) the selectivity of \\(\\rm{R}^{2}\\) for the two substrates, measured by \\(a\\), is the same as the selectivity of \\(\\rm{R}^{1}\\) for the two substrates, also \\(a\\). In position (ii) the selectivity of \\(\\rm{R}^{2}\\) for the two substrates, measured by \\(b\\), is less than the selectivity of \\(\\rm{R}^{1}\\) for the two substrates, i.e. \\(b < a\\). It is this situation which is in accord with the RSP. In position (iii) the selectivity of \\(\\rm{R}^{2}\\) for the two substrates, measured by \\(c\\), is greater than the selectivity of \\(\\rm{R}^{1}\\) for the two substrates, i.e. \\(c > a\\). This situation may be described as anti-RSP. There are many examples in which the RSP is followed, but there are also many examples corresponding to situations (i) and (iii). The RSP is in accord with intuitive feeling and certainly holds in the limiting case when reactivity is controlled by diffusion. However, the validity of the RSP is a matter of great controversy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactivity–selectivity principle" .

goldbook:R05189 a skos:Concept ;
    skos:definition "Datum provided by an instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reading" .

goldbook:R05192 a skos:Concept ;
    skos:definition "Defined for species $\\ce{B}$ in phase $\\upbeta\\!$ as \\[\\alpha _{\\rm{B}}^{\\beta } = \\mu _{\\rm{B}}^{\\beta }\\,-\\,z_{\\rm{B}}\\ F\\ \\psi ^{\\beta }\\] where \\(\\mu _{\\rm{B}}^{\\beta }\\) is the electrochemical potential of species $\\ce{B}$ in phase $\\upbeta\\!$, \\(z_{\\rm{B}}\\) is the charge number of species $\\ce{B}$, \\(F\\) is the Faraday constant, and \\(\\psi ^{\\beta }\\) is the outer electric potential of phase $\\upbeta\\!$. Since \\(\\psi ^{\\beta }\\) is zero when the charge on the phase $\\upbeta\\!$ is zero, the real potential may be regarded as the value of the electrochemical potential of the uncharged phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "real potential of a species in a phase" .

goldbook:R05195 a skos:Concept ;
    skos:definition "An electrically charged species, involving a molecular or parent ion, in which atoms or groups of atoms have transferred from one portion of a molecule or molecular moiety to another during the ionization fragmentation processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rearrangement ion" .

goldbook:R05196 a skos:Concept ;
    skos:definition "The elementary reaction or reaction stage (of a molecular rearrangement) in which there is both making and breaking of bonds between atoms common to a reactant and a reaction product or a reaction intermediate. If the rearrangement stage consists of a single elementary reaction, this is a 'rearrangement step'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rearrangement stage" .

goldbook:R05197 a skos:Concept ;
    skos:definition "If in a chemical process, occurring in a molecular beam, the reaction products are scattered backwards with respect to the moving centre of mass of the system, the reaction is called a rebound reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rebound reaction" .

goldbook:R05199 a skos:Concept ;
    skos:definition "A nucleotide sequence to which a protein binds specifically.An amino acid sequence in an antibody molecule to which the specific antigen binds specifically." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recognition site" .

goldbook:R05200 a skos:Concept ;
    skos:definition "The motion acquired by a particle through a collision with, or the emission of, another particle or electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recoil" .

goldbook:R05201 a skos:Concept ;
    skos:definition "The fraction of all Mössbauer gamma rays of the transition which are emitted or absorbed without significant recoil energy loss." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recoil-free fraction" .

goldbook:R05202 a skos:Concept ;
    skos:definition "Labelling by a chemical reaction initiated by recoil." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recoil labelling" .

goldbook:R05205 a skos:Concept ;
    skos:definition "A transition which involves a major reorganization of the crystal structure and a change of local topology, during which primary bonds are broken and reformed so that there is no immediate relationship between the crystal structures of the parent and product phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reconstructive transition" .

goldbook:R05206 a skos:Concept ;
    skos:definition "In toxicology, the process leading to partial or complete restoration of a cell, tissue, organ or organism following its damage from exposure to a harmful substance or agent.Term used in analytical and preparative chemistry to denote the fraction of the total quantity of a substance recoverable following a chemical procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recovery" .

goldbook:R05208 a skos:Concept ;
    skos:definition "(chemical): The repeated dissolution and precipitation of a solid from a liquid solvent.(metallurgical): The process in which a crystalline solid with a high degree of disorder develops a new microstructure by the nucleation of relatively imperfection-free regions, and their propagation throughout the complete solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "recrystallization" .

goldbook:R05209 a skos:Concept ;
    skos:definition "Conventional ion exchangers in which reversible redox couples have been introduced as counter-ions either by sorption or complex formation. They closely resemble redox polymers in their behaviour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redox ion exchangers" .

goldbook:R05210 a skos:Concept ;
    skos:altLabel "electron-exchange polymer",
        "oxidation-reduction polymer" ;
    skos:definition "Polymer containing groups that can be reversibly reduced or oxidized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redox polymer" .

goldbook:R05211 a skos:Concept ;
    skos:definition "Informal term for bathochromic shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "red shift" .

goldbook:R05212 a skos:Concept ;
    skos:definition "Of component \\(i\\), defined by the equation \\[\\mathit{\\Gamma}_{i}^{(n)} = \\mathit{\\Gamma}_{i}^{\\unicode[Times]{x3C3} }- \\mathit{\\Gamma}_{i}\\ \\frac{c_{i}^{\\unicode[Times]{x3B1} } - c_{i}^{\\unicode[Times]{x3B2} }}{c^{\\unicode[Times]{x3B1} }- c^{\\unicode[Times]{x3B2} }}\\] where \\(\\mathit{\\Gamma }^{\\unicode[Times]{x3C3} }\\), \\(c^{\\unicode[Times]{x3B1} }\\) and \\(c^{\\unicode[Times]{x3B2}}\\) are, respectively, the total Gibbs surface concentration and the total concentrations in the bulk phases $\\ce{\\upalpha\\!}$ and $\\ce{\\upbeta\\!}$: \\[\\mathit{\\Gamma}^{\\unicode[Times]{x3C3} }=\\sum _{\\begin{array}{c}  i  \\end{array}}\\mathit{\\Gamma }_{i}^{\\unicode[Times]{x3C3} }\\] \\[c^{\\unicode[Times]{x3B1} }=\\sum _{\\begin{array}{c}  i  \\end{array}}c_{i}^{\\unicode[Times]{x3B1} }\\] \\[c^{\\unicode[Times]{x3B2} }=\\sum _{\\begin{array}{c}  i  \\end{array}}c_{i}^{\\unicode[Times]{x3B2}}\\] The reduced adsorption is invariant to the location of the Gibbs surface. Alternatively, the reduced adsorption may be regarded as the Gibbs surface concentration of \\(i\\) when the Gibbs surface is chosen so that \\(\\mathit{\\Gamma }^{\\unicode[Times]{x3C3} }\\) is zero, i.e. the Gibbs surface is chosen so that the reference system has not only the same volume, but also contains the same total amount of substance(\\(n\\)) as the real system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced adsorption" .

goldbook:R05215 a skos:Concept ;
    skos:definition "A term used mainly in liquid chromatography. It compares the mobile phase velocity with the velocity of diffusion into the pores of the particles (the so-called diffusion velocity, \\(u_{\\rm{D}}\\)): \\[ u=\\frac{\\overline{u}}{u_{\\rm{D}}}=\\frac{\\overline{u}\\ d_{\\rm{p}}}{D_{\\rm{M}}}\\] In open-tubular chromatography: \\[ u=\\frac{\\overline{u}\\ d_{\\rm{c}}}{D_{\\rm{M}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced mobile phase velocity" .

goldbook:R05216 a skos:Concept ;
    skos:definition "The osmotic pressure divided by mass concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced osmotic pressure" .

goldbook:R05217 a skos:Concept ;
    skos:definition "A representative part of the primary (composited or gross) sample obtained by a division and reduction process. Typically the mass approximates that of the final laboratory sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced sample" .

goldbook:R05219 a skos:Concept ;
    skos:definition "A term used to characterize the degree of reduction (or oxidation) in atoms, molecules and ions. An atom in a molecule or an ion which has a low oxidation state. An element or atom in a compound can be reduced by the reaction of an element or compound with hydrogen, while it can be oxidized by reaction with oxygen. A reduced species can be formed also through the gain of electrons (either at the negative electrode in a cell or through transfer from another atom, ion or group of atoms in a chemical reaction). For example, the carbon atom in $\\ce{CH4}$ and other hydrocarbons is in a reduced state, while the carbon in $\\ce{CO2}$ is in an oxidized state. Similarly the sulfur atom in $\\ce{H2S}$ is in a reduced state while that in sulfuric acid ($\\ce{H2SO4}$) is in an oxidized state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduced species" .

goldbook:R05221 a skos:Concept ;
    skos:definition "Decreasing the size of the laboratory sample or individual particles, or both. Division of the size of the laboratory sample may be accomplished manually by coning and quartering or by riffling or mechanically by rotary dividers. Reduction of particle size may be accomplished by milling or grinding. Simultaneous division and reduction may also be achieved with mills having stream diverters." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reducing" .

goldbook:R05222 a skos:Concept ;
    skos:altLabel "electronation" ;
    skos:definition "The complete transfer of one or more electrons to a molecular entity (also called 'electronation'), and, more generally, the reverse of the processes described under oxidation (2) and (3)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reduction" .

goldbook:R05223 a skos:Concept ;
    skos:definition "The reverse of oxidative addition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reductive elimination" .

goldbook:R05224 a skos:Concept ;
    skos:definition "Compounds containing an enediol structure stabilized by conjugation and hydrogen bonding with an adjacent carbonyl group, $\\ce{RC(OH)=C(OH)C(=O)R}$. They are strong reducing agents, fairly strong acids and commonly derived from saccharides by oxidation at the carbon atom alpha to the carbonyl function, e.g. ascorbic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reductones" .

goldbook:R05225 a skos:Concept ;
    skos:definition "Since the prefix 're' can signify 'back' as well as 'again' this term is ambiguous and should be avoided, except where the process of extraction (e.g. from aqueous solution to an organic phase) in a single direction is repeated (following stripping). It should not be used as a synonym for stripping or back-extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "re-extraction" .

goldbook:R05227 a skos:Concept ;
    skos:definition "The atom to which a primitive change is nucleophilic, electrophilic, nucleofugal or homolytic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference atom" .

goldbook:R05230 a skos:Concept ;
    skos:definition "A substance or mixture of substances, the composition of which is known within specified limits, and one or more of the properties of which is sufficiently well established to be used for the calibration of an apparatus, the assessment of a measuring method or for assigning values to materials. Reference materials are available from national laboratories in many countries [e.g. National Institute for Standards and Technology (NIST), USA.; Community Bureau of Reference, UK]." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference material" .

goldbook:R05231 a skos:Concept ;
    skos:definition "A method having small, estimated inaccuracies relative to the end use requirement. The accuracy of a reference method must be demonstrated through direct comparison with a definitive method or with a primary reference material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference method" .

goldbook:R05232 a skos:Concept ;
    skos:definition "Agreed method for determining one or more air quality characteristics where it is not practical to produce a reference material; the result obtained is defined as the measure of the air quality characteristic. For example, a gas such as $\\ce{NO2}$ may be somewhat unstable when stored in a tank at low mixing ratios, so that the use of a more stable $\\ce{NO}$ standard mixture in $\\ce{N2}$ may be oxidized to $\\ce{NO2}$ by $\\ce{O3}$ in a specified manner referred to as the $\\ce{NO2}$ reference procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference procedure" .

goldbook:R05233 a skos:Concept ;
    skos:definition "The state in which the element is stable at a chosen standard-state pressure and for a given temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference state" .

goldbook:R05234 a skos:Concept ;
    skos:definition "An aqueous solution of \\(\\pu{0.05 mol}\\) potassium hydrogen phthalate per kg water which is the reference value for the definition of pH(RVS) values in the temperature range \\(\\pu{0\\!{-}\\! 95 ^{\\circ}C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference value pH standard" .

goldbook:R05235 a skos:Concept ;
    skos:altLabel "reflectance factor",
        "reflectivity" ;
    skos:definition "Fraction of incident radiation reflected by a surface or discontinuity, \\(\\rho(\\lambda) = \\frac{P_{\\lambda} ^{\\rm{refl}}}{P_{\\lambda} ^{\\rm{0}}}\\), where \\(P_{\\lambda}^{\\rm{0}}\\) and \\(P_{\\lambda}^{\\rm{refl}}\\) are, respectively, the incident and reflected spectral radiant power." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflectance" .

goldbook:R05236 a skos:Concept ;
    skos:altLabel "high resolution energy loss spectroscopy" ;
    skos:definition "Any technique in which a specimen is bombarded with a focused low energy (\\(E_{0} < 10\\ \\rm{eV}\\)) electron beam and the energy distribution of the reflected electrons is measured. This energy distribution contains features corresponding to discrete losses of energy of the reflected electrons due to excitation of vibrational and plasmon states and provides information on the type and geometric structure of compounds at the surface of the specimen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflection electron energy loss spectroscopy" .

goldbook:R05238 a skos:Concept ;
    skos:altLabel "RHEED" ;
    skos:definition "Any technique which measures the angular intensity distribution of electrons 'reflected' from a crystalline surface under bombardment with high energy electrons near grazing incidence. The diffraction pattern provides very surface sensitive information (information depth \\(1\\ \\rm{nm}\\)) on the atomic arrangement of the top layers of a solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reflection high energy electron diffraction" .

goldbook:R05239 a skos:Concept ;
    skos:definition "The luminescence flux emitted from the interior of a rectangular sample reaching a photodetector place at some distance from the sample is decreased by a factor of approximately \\(n^{2}\\) (where \\(n\\) is the refractive index of the medium) compared with a medium whose refractive index is 1.0. Such effects are termed refraction effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "refraction effects" .

goldbook:R05240 a skos:Concept ;
    skos:definition "The ratio of the speed of light in vacuum to that in a given medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "refractive index" .

goldbook:R05242 a skos:Concept ;
    skos:definition "Reversal of catalytic deactivation with restoration of the original catalytic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regeneration" .

goldbook:R05243 a skos:Concept ;
    skos:definition "A regioselective reaction is one in which one direction of bond making or breaking occurs preferentially over all other possible directions. Reactions are termed completely (100%) regioselective if the discrimination is complete, or partially (x%), if the product of reaction at one site predominates over the product of reaction at other sites. The discrimination may also semi-quantitatively be referred to as high or low regioselectivity. (Originally the term was restricted to addition reactions of unsymmetrical reagents to unsymmetrical alkenes.) In the past, the term 'regiospecificity' was proposed for 100% regioselectivity. This terminology is not recommended owing to inconsistency with the terms stereoselectivity and stereospecificity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regioselectivity" .

goldbook:R05245 a skos:Concept ;
    skos:definition "A petroleum coke with good graphitizability, characterized by a combination of properties which differ significantly from those of metallurgical coke but do not reach the quality level of premium coke. These properties are: optical anisotropy, medium reversible thermal expansion and low ash content. Regular coke is mainly used for the production of synthetic carbon and graphite materials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular coke" .

goldbook:R05247 a skos:Concept ;
    skos:definition "A macromolecule the structure of which essentially comprises the repetition of a single constitutional unit with all units connected identically with respect to directional sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular macromolecule" .

goldbook:R05248 a skos:Concept ;
    skos:definition "An oligomer molecule the structure of which essentially comprises the repetition of a single constitutional unit with all units connected identically with respect to directional sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular oligomer molecule" .

goldbook:R05249 a skos:Concept ;
    skos:definition "A polymer composed of regular macromolecules, regular star macromolecules or regular comb macromolecules. A polymer consisting of star macromolecules with arms identical with respect to constitution and degree of polymerization is considered to be regular. Analogously, a polymer consisting of comb macromolecules with the sub-chains between the branch points of the main chain and the terminal sub-chains of the main chain identical with respect to constitution and degree of polymerization and the side-chains identical with respect to constitution and degree of polymerization is considered to be regular." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regular polymer" .

goldbook:R05252 a skos:Concept ;
    skos:definition "A gene which codes for a protein (an activator of repressor) having the ability to induce or repress the transcription of other genes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regulator gene" .

goldbook:R05253 a skos:Concept ;
    skos:definition "Compounds formed by formal addition of an acyl group and a cyano group to a nitrogen atom and carbon atom, respectively, of a nitrogen–carbon bond in quinolines, isoquinolines, and related nitrogen heterocycles, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Reissert compounds" .

goldbook:R05255 a skos:Concept ;
    skos:definition "Quotient of quantities having the same kind-of-quantity in different systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative" .

goldbook:R05257 a skos:Concept ;
    skos:definition "If \\(\\mathit{\\Gamma}_{i}^{\\sigma}\\) and \\(\\mathit{\\Gamma}_{1}^{\\sigma}\\) are the Gibbs surface concentrations of components i and 1, respectively, with reference to the same, but arbitrarily chosen, Gibbs surface, then the relative adsorption of component i with respect to component 1, is defined as \\[\\mathit{\\Gamma}_{i}^{\\left(1\\right)} = \\mathit{\\Gamma}_{i}^{\\sigma}- \\mathit{\\Gamma}_{1}^{\\sigma}\\ \\frac{c_{i}^{\\alpha}- c_{i}^{\\beta}}{c_{1}^{\\alpha}- c_{1}^{\\beta}}\\] and is invariant to the location of the Gibbs surface. Alternatively, \\(\\mathit{\\Gamma}_{i}^{\\left(1\\right)}\\) may be regarded as the Gibbs surface concentration of \\(i\\) when the Gibbs surface is chosen so that \\(\\mathit{\\Gamma}_{i}^{\\sigma}\\) is zero, i.e. the Gibbs surface is chosen so that the reference system contains the same amount of component 1 as the real system. Hence \\(\\mathit{\\Gamma}_{1}^{\\left(1\\right)}\\equiv 0\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative adsorption" .

goldbook:R05258 a skos:Concept ;
    skos:altLabel "atomic weight" ;
    skos:definition "The ratio of the average mass of the atom to the unified atomic mass unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative atomic mass" .

goldbook:R05259 a skos:Concept ;
    skos:definition "The ratio of the appropriate value of the biological effectiveness of the radiation in question to that of X-radiation with an average specific ionization of 100 ion pairs per micron of water, for the particular biological effect under consideration and for the condition under which the radiation is received." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative biological effectiveness" .

goldbook:R05260 a skos:Concept ;
    skos:definition "The configuration of any stereogenic (asymmetric) centre with respect to any other stereogenic centre contained within the same molecular entity. Unlike absolute configuration, relative configuration is reflection-invariant. Relative configuration, distinguishing diastereoisomers, may be denoted by the configurational descriptors \\(R^{\\rm{*}}\\), \\(R^{\\rm{*}}\\) (or l) and \\(R^{\\rm{*}}\\), \\(S^{\\rm{*}}\\) (or u) meaning, respectively, that the two centres have identical or opposite configurations. For molecules with more than two asymmetric centres the prefix rel- may be used in front of the name of one enantiomer where R and S have been used. If any centres have known absolute configuration then only \\(R^{\\rm{*}}\\) and \\(S^{\\rm{*}}\\) can be used for the relative configuration.See also: α (alpha), β (beta) (Defs. 1 and 3)Two different molecules Xabcd and Xabce, may be said to have the same relative configurations if e takes the position of d in the tetrahedral arrangement of ligands around X (i.e. the pyramidal fragments Xabc are superposable). By the same token the enantiomer of Xabce may be said to have the opposite relative configuration to Xabcd. The terms may be applied to chiral molecular entities with central atoms other than carbon but are limited to cases where the two related molecules differ in a single ligand.Both definitions can be generalized to include stereogenic units other than asymmetric centres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative configuration" .

goldbook:R05261 a skos:Concept ;
    skos:definition "A measurement in which the activity of a test portion is derived from the ratio between the count rates observed for the test portion and for a radioactive source of known activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative counting" .

goldbook:R05262 a skos:Concept ;
    skos:altLabel "specific gravity" ;
    skos:definition "Ratio of density to a reference density, usually the density of water at \\(\\pu{4^{\\circ}C}\\); in the older literature this is called specific gravity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative density" .

goldbook:R05263 a skos:Concept ;
    skos:altLabel "detection limit" ;
    skos:definition "(Often incorrectly referred to as sensitivity). Smallest amount of material detectable ($3\\upsigma\\!$-criterion) in a matrix relative to the amount of material analysed — given in atomic, mole or weight fractions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative detection limit" .

goldbook:R05264 a skos:Concept ;
    skos:definition "The electrode potential of a single electrode is not amenable to direct experimental determination and can only be measured against a reference system. The measured quantity, \\(E\\), is the relative electrode potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative electrode potential" .

goldbook:R05267 a skos:Concept ;
    skos:definition "The ratio, often expressed as a percentage, of the partial pressure of water in the atmosphere at some observed temperature, to the saturation vapour pressure of pure water at this temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative humidity" .

goldbook:R05269 a skos:Concept ;
    skos:altLabel "micellar weight" ;
    skos:definition "The relative molecular mass (\\(M_{\\rm{r}}\\)) of a micelle is called the relative micellar mass or micellar weight and is defined as the mass of a mole of micelles divided by the mass of \\(\\frac{1}{12}\\) mole of $\\ce{^{12}C}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative micellar mass" .

goldbook:R05271 a skos:Concept ;
    skos:altLabel "molecular weight",
        "relative molar mass" ;
    skos:definition "Ratio of the mass of a molecule to the unified atomic mass unit. Sometimes called the 'molecular weight' or relative molar mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative molecular mass" .

goldbook:R05274 a skos:Concept ;
    skos:definition "An operation (process) as a result of which the ratio of concentration or amounts of microcomponents and main macrocomponents increases. This is a particular example of a separation, but at greatly differing concentrations of components. The ratio of the masses of the initial and final samples is not of great importance. Frequently, the main purpose of relative preconcentration is the replacement of a matrix unsuitable for analysis by a suitable medium. In some cases, it is difficult to trace a boundary between the absolute and the relative preconcentrations as, for example, in preconcentration by zone melting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative preconcentration" .

goldbook:R05276 a skos:Concept ;
    skos:definition "A term which is equivalent to relative retention used in column chromatography: the ratio of the \\(R_{\\rm{F}}\\) value of a component to the \\(R_{\\rm{F}}\\) value of a standard (reference) substance. Since the mobile phase front is common for the two components, the \\(R_{\\rm{F}}\\) value can be expressed directly as the ratio of the distances travelled by the spot of the compound of interest (\\(b_{i}\\)) and the reference substance (\\(b_{\\rm{st}}\\)) respectively: \\[R_{\\rm{rel}}=\\frac{R_{\\rm{F}\\left(i\\right)}}{R_{\\rm{F}\\left(\\rm{st}\\right)}}=\\frac{b_{i}}{b_{\\rm{st}}}\\] In former nomenclatures the symbol \\(R_{\\rm{s}}\\) was used to express relative retardation in planar chromatography. Because of its identity with the symbol for peak resolution the symbol \\(R_{\\rm{rel}}\\) is suggested for relative retardation in planar chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative retardation" .

goldbook:R05277 a skos:Concept ;
    skos:definition "The ratio of the adjusted or net retention volume (time) or retention factor of a component relative to that of a standard, obtained under identical conditions: \\[r=\\frac{V_{\\rm{R}i}^{'}}{V_{\\rm{R}\\left(\\rm{st}\\right)}^{'}}=\\frac{V_{\\rm{N}i}}{V_{\\rm{N}\\left(\\rm{st}\\right)}}=\\frac{t_{\\rm{R}i}^{'}}{t_{\\rm{R}\\left(\\rm{st}\\right)}^{'}}=\\frac{k_{i}}{k_{\\rm{st}}}\\] Depending on the relative position of the peak corresponding to the standard compound in the chromatogram, the value of \\(r\\) may be smaller, larger or identical to unity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative retention" .

goldbook:R05280 a skos:Concept ;
    skos:definition "The standard deviation divided by the mean of the series. It can be calculated with the formula: \\[s_{\\rm{r}}=\\frac{s}{\\overline{x}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative standard deviation" .

goldbook:R05284 a skos:Concept ;
    skos:definition "Synonymous with relative density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative volumic mass" .

goldbook:R05285 a skos:Concept ;
    skos:definition "If a system is disturbed from its state of equilibrium it relaxes to that state, and the process is referred to as relaxation. The branch of kinetics concerned with such processes is known as 'relaxation kinetics'. Relaxation techniques include temperature jump and 'pressure jump'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relaxation" .

goldbook:R05289 a skos:Concept ;
    skos:definition "Non-SI unit of dose equivalent (\\(\\rm{rem} = 0.01\\ \\rm{Sv}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rem" .

goldbook:R05290 a skos:Concept ;
    skos:definition "Molecular distortion in linear molecular species with degenerate electronic states (e.g. belonging to the \\(C_{\\infty\\rm{v}}\\) group). The Renner–Teller effect is a particular case of the Jahn–Teller effect. From the point of view of the potential energy surfaces the Renner–Teller effect generates a surface touching (see scheme below)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Renner–Teller effect" .

goldbook:R05292 a skos:Concept ;
    skos:definition "Gibbs energy dissipated when a system that has undergone 'vertical' electron transfer (i.e., electron transfer obeying the Franck–Condon principle) relaxes to the equilibrium state for its new charge distribution. Commonly the total reorganization energy (\\(\\lambda\\)) is written as the sum of an inner contribution (\\(\\lambda_{\\rm{in}}\\)) and an outer contribution (\\(\\lambda_{\\rm{out}}\\)) attributed to nuclear reorganizations of the redox partners and their environment (solvent), respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reorganization energy" .

goldbook:R05293 a skos:Concept ;
    skos:definition "The closeness of agreement between independent results obtained with the same method on identical test material, under the same conditions (same operator, same apparatus, same laboratory and after short intervals of time). The measure of repeatability is the standard deviation qualified with the term: `repeatability' as repeatability standard deviation. In some contexts repeatability may be defined as the value below which the absolute difference between two single test results obtained under the above conditions, may be expected to lie with a specified probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repeatability" .

goldbook:R05297 a skos:Concept ;
    skos:definition "A name in which the replacement of an atom or a group of a parent structure by another atom or group is indicated by affixes attached to or inserted into the name of the parent structure. There are two main types of replacement names.   Skeletal replacement name. A name in which the replacement of skeletal atoms and their associated hydrogen atoms is indicated by non-detachable prefixes. When carbon atoms are replaced by heteroatoms this method has been called 'a' nomenclature since the prefixes end in 'a'. Certain names in which the prefix 'thio-', 'seleno-' or 'telluro-' indicates replacement of a skeletal oxygen atom by a sulfur, selenium or tellurium atom, respectively, are also skeletal replacement names.   Functional replacement name. A name containing prefixes or infixes which indicate the replacement of an oxygen atom or hydroxy group of a characteristic group, functional parent or class name by other atoms or groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "replacement name" .

goldbook:R05298 a skos:Concept ;
    skos:definition "The exchange of one group of atoms or a single non-hydrogen atom for another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "replacement operation" .

goldbook:R05299 a skos:Concept ;
    skos:altLabel "duplicate sample" ;
    skos:definition "Multiple (or two) samples taken under comparable conditions. This selection may be accomplished by taking units adjacent in time or space. Although the replicate samples are expected to be identical, often the only thing replicated is the act of taking the physical sample. A duplicate sample is a replicate sample consisting of two portions. The umpire sample is usually used to settle a dispute; the replicate sample is usually used to estimate sample variability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "replicate sample" .

goldbook:R05300 a skos:Concept ;
    skos:definition "The duplication of DNA as part of the reproductive cycle of a cell or virus. During replication the two DNA strands in the double helix separate, and each strand then acts as a template specifying the base sequence of newly synthesized complementary strands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "replication" .

goldbook:R05301 a skos:Concept ;
    skos:definition "A combination of specimen information and results. The report should contain information about unequivocal identification of the source and type of material analysed and the requesting agency. It may contain such other information that is pertinent to the correct interpretation of a result (e.g. confidence interval, reference data and interpretative information)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "report" .

goldbook:R05303 a skos:Concept ;
    skos:definition "A sample resulting from a sampling plan that can be expected to adequately reflect the properties of interest of the parent population. A representative sample may be a random sample or, for example, a stratified sample, depending upon the objective of sampling and the characteristics of the population. The degree of representativeness of the sample may be limited by cost or convenience." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "representative sample" .

goldbook:R05304 a skos:Concept ;
    skos:definition "Binding of a protein (repressor) to the operator sequence in an operon thus preventing the transcription of the following structural gene(s) into mRNA and consequently synthesis of protein (cf. enzyme repression)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repression" .

goldbook:R05305 a skos:Concept ;
    skos:definition "The closeness of agreement between independent results obtained with the same method on identical test material but under different conditions (different operators, different apparatus, different laboratories and/or after different intervals of time). The measure of reproducibility is the standard deviation qualified with the term 'reproducibility' as reproducibility standard deviation. In some contexts reproducibility may be defined as the value below which the absolute difference between two single test results on identical material obtained under the above conditions, may be expected to lie with a specified probability. Note that a complete statement of reproducibility requires specification of the experimental conditions which differ." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reproducibility" .

goldbook:R05306 a skos:Concept ;
    skos:altLabel "late-downhill surface" ;
    skos:definition "A surface for an exergonic reaction $\\ce{A + BC}$ in which the col corresponds to considerable separation between the products $\\ce{A–B + C}$. The energy barrier in the potential-energy profile is in the later stages of the reaction path. On such a surface most of the energy is released after $\\ce{A–B}$ is formed. Repulsive surfaces are also called late-downhill surfaces, and the barrier in such a surface is called a Type-II barrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "repulsive potential-energy surface" .

goldbook:R05308 a skos:Concept ;
    skos:altLabel "CIP" ;
    skos:definition "A stereoheterotopic face of a trigonal atom is designated Re if the ligands of the trigonal atom appear in a clockwise sense in order of CIP priority when viewed from that side of the face. The opposite arrangement is termed Si." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>Re</i>, <i>Si</i>" .

goldbook:R05309 a skos:Concept ;
    skos:definition "(instrumentation): The time required for air or reagent parcel to pass from the entrance to the exit of an instrument. Often this is approximated as the ratio of the interior volume of the device to the flow rate.(atmospheric): The average time a molecule or aerosol spends in the atmosphere after it is released or generated there. For compounds with well defined sources and emission rates, this is estimated by the ratio of the average global concentration of a substance to its production rate on a global scale. It is a function of not only the emission rates but the loss rates by chemical and physical removal processes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residence time" .

goldbook:R05310 a skos:Concept ;
    skos:altLabel "hydraulic retention time" ;
    skos:definition "The average time a particle or volume element of the culture resides in a bioreactor (or other device) through which a liquid medium continously flows. residence time of the liquid is the reciprocal of dilution rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residence time" .

goldbook:R05311 a skos:Concept ;
    skos:definition "The current that flows, at any particular value of the applied potential, in the absence of the substance whose behaviour is being investigated (i.e. in a blank solution)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual current" .

goldbook:R05312 a skos:Concept ;
    skos:definition "The liquid or semi-liquid, high-boiling fraction of residue from the distillation of petroleum which is used as a fuel. After removal of the lower boiling fraction of crude oil, sold as petroleum gas, the somewhat higher boiling fraction becomes gasoline and diesel oil. A portion of the higher boiling fraction is 'cracked' to yield additional gasoline. Still heavier oils become lubricants. paraffin, asphalt, etc., are also extracted from the crude oil. It is the remaining residual oil, not economically usable for other industrial purposes, which is then sold as a relatively low cost fuel for burning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual fuel/oil" .

goldbook:R05313 a skos:Concept ;
    skos:altLabel "residual liquid junction potential error" ;
    skos:definition "Error arising from breakdown in the assumption that the liquid junction potential remains constant when solution X is substituted for solution S in the operational cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual liquid junction error" .

goldbook:R05314 a skos:Concept ;
    skos:definition "Set of peaks recorded in the absence of a sample and due either to small air leaks or to the presence of molecules desorbed from the walls of the introduction device or the source, or from the pump fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual spectrum/background spectrum" .

goldbook:R05315 a skos:Concept ;
    skos:definition "Electric potential difference divided by the electric current when there is no electromotive force in a conductor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resistance" .

goldbook:R05316 a skos:Concept ;
    skos:altLabel "electric resistivity" ;
    skos:definition "Electric field strength divided by the current density. This quantity is a tensor in an anisotropic medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resistivity" .

goldbook:R05317 a skos:Concept ;
    skos:definition "A characteristic of the separation of two adjacent peaks. It may be expressed according to the equation: \\[R_{\\rm{AB}} = 2\\ \\frac{|d_{\\rm{R}}\\left(\\rm{B}\\right)\\,-\\,d_{\\rm{R}}\\left(\\rm{A}\\right)|}{|w\\left(\\rm{B}\\right)\\,+\\,w\\left(\\rm{A}\\right)|}\\] where \\(R_{\\rm{AB}}\\) is the resolution, \\(d_{\\rm{R}}(\\rm{A})\\) and \\(d_{\\rm{R}}(\\rm{B})\\) are the retention distances (time or volume) of each eluted component A and B, and \\(w(\\rm{A})\\) and \\(w(\\rm{B})\\) are the respective widths of each peak at its base." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution" .

goldbook:R05318 a skos:Concept ;
    skos:definition "(energy): By analogy with the peak width definition for mass resolution, a peak showing the number of ions as a function of their translational energy should be used to give a value for the energy resolution.($\\pu{10\\%}$ valley definition): Let two peaks of equal height in a mass spectrum at masses \\(m\\) and \\(m- \\Delta m\\) be separated by a valley which at its lowest point is just $\\pu{10\\%}$ of the height of either peak. For similar peaks at a mass exceeding \\(m\\), let the height of the valley at its lowest point be more (by any amount) than ten per cent of either peak height. Then the resolution ($\\pu{10\\%}$ valley definition) is \\(\\frac{m}{\\Delta m}\\). It is usually a function of \\(m\\). The ratio \\(\\frac{m}{\\Delta m}\\) should be given for a number of values of \\(m\\).(peak width definition): For a single peak made up of singly charged ions at mass \\(m\\) in a mass spectrum, the resolution may be expressed as \\(\\frac{m}{\\Delta m}\\) where \\(\\Delta m\\) is the width of the peak at a height which is a specified fraction of the maximum peak height. It is recommended that one of three values $\\pu{50\\%}$, $\\pu{5\\%}$ or $\\pu{0.5\\%}$ should always be used. For an isolated symmetrical peak recorded with a system which is linear in the range between $\\pu{5\\%}$ and $\\pu{10\\%}$ levels of the peak, the $\\pu{5\\%}$ peak width definition is technically equivalent to the $\\pu{10\\%}$ valley definition. A common standard is the definition of resolution based upon \\(\\Delta m\\) being Full Width of the peak at Half its Maximum height, sometimes abbreviated 'FWHM'. This acronym should preferably be defined the first time it is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution" .

goldbook:R05320 a skos:Concept ;
    skos:altLabel "optical resolution" ;
    skos:definition "The separation of a racemate into the component enantiomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolution" .

goldbook:R05321 a skos:Concept ;
    skos:definition "The ability to distinguish between ions differing in the quotient mass/charge by a small increment. It may be characterized by giving the peak width, measured in mass units, expressed as a function of mass, for at least two points on the peak, specifically at fifty percent and at five percent of the maximum peak height." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolving power" .

goldbook:R05323 a skos:Concept ;
    skos:definition "The smallest time interval which must elapse between the occurrence of two consecutive ionizing events or signal pulses, in order that the measuring device be capable of fulfilling its function of each of them separately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolving time" .

goldbook:R05325 a skos:Concept ;
    skos:definition "Correction to be applied to the observed number of pulses in order to take into account the number of pulses lost during the resolving time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resolving time correction" .

goldbook:R05326 a skos:Concept ;
    skos:definition "In the context of chemistry, the term refers to the representation of the electronic structure of a molecular entity in terms of contributing structures. Resonance among contributing structures means that the wavefunction is represented by 'mixing' the wavefunctions of the contributing structures. The concept is the basis of the quantum mechanical valence bond methods. The resulting stabilization is linked to the quantum mechanical concept of 'resonance energy'. The term resonance is also used to refer to the delocalization phenomenon itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance" .

goldbook:R05327 a skos:Concept ;
    skos:definition "The monitoring of atoms or radicals generated in the gas phase by observing the attenuation of the radiation from a lamp emitting the characteristic resonance radiation of the observed species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance absorption technique" .

goldbook:R05329 a skos:Concept ;
    skos:definition "The cross-section for resonant absorption of the Mössbauer transition $\\upgamma\\!\\mbox{-}\\rm{ray}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance cross-section" .

goldbook:R05331 a skos:Concept ;
    skos:definition "Ratio of the difference in the transmitted or scattered intensity at resonance maximum and off-resonance, relative to the intensity off-resonance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance effect magnitude" .

goldbook:R05333 a skos:Concept ;
    skos:definition "The difference in potential energy between the actual molecular entity and the contributing structure of lowest potential energy. The resonance energy cannot be measured, but only estimated, since contributing structures are not observable molecular entities." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance energy" .

goldbook:R05334 a skos:Concept ;
    skos:definition "The energy of a particle entering a nuclear reaction, this energy being just sufficiently high to lead to the formation of reaction products in one of their excited states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance energy" .

goldbook:R05335 a skos:Concept ;
    skos:definition "Fluorescence from the primary excited atomic or molecular species at the wavelength of the exciting radiation (no relaxation within the excited manifold). This term is also used to designate the radiation emitted by an atom of the same wavelength as the longest one capable of exciting its fluorescence, e.g. \\(122.6\\ \\rm{nm}\\) in the case of the hydrogen atom, and \\(253.7\\ \\rm{nm}\\) in the case of the mercury atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance fluorescence" .

goldbook:R05336 a skos:Concept ;
    skos:definition "The monitoring of atoms or radicals generated in the gas phase by observing the intensity of fluorescence (exitance) emitted by the species after excitation with radiation of the same wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance fluorescence technique" .

goldbook:R05338 a skos:Concept ;
    skos:definition "The integral, over all or some specified portion of the resonance energy range, of the cross-section divided by the energy of a radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance integral" .

goldbook:R05339 a skos:Concept ;
    skos:definition "Lamp emitting resonance radiation of atoms and their ions. Depending on the requirements, the lamp is filled either with pure vapour of the element or with a mixture of it and other gases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance lamp" .

goldbook:R05340 a skos:Concept ;
    skos:definition "The longest wavelength capable of exciting fluorescence in an atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance line" .

goldbook:R05341 a skos:Concept ;
    skos:definition "The radiative decay of an excitation level may proceed to the neutral ground state and would thus occur at the same energy as the corresponding line in the absorption spectrum. Such a line is called a resonance line and the process is called resonance emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance line" .

goldbook:R05342 a skos:Concept ;
    skos:definition "Neutrons whose energy corresponds to the resonance energy of a specified nuclide or element. If the nuclide is not specified, the term refers to resonance neutrons of $\\ce{^{239}U}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance neutrons" .

goldbook:R05343 a skos:Concept ;
    skos:definition "Synonymous with resonance fluorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance radiation" .

goldbook:R05344 a skos:Concept ;
    skos:definition "A quantity whose expression includes a current, whose value is characteristic of a charge-transfer process and the experimental conditions under which it is investigated, and whose nature depends on the technique that is employed. Some typical response constants are the diffusion current constant in polarography, the voltammetric constant in linear-sweep voltammetry, and the chronopotentiometric constant in chronopotentiometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "response constant" .

goldbook:R05345 a skos:Concept ;
    skos:altLabel "rise time" ;
    skos:definition "The time required for the detector output to go from the initial value to a percentage (e.g. 99%) of the final value. In the case of an exponential behaviour of the detector \\(\\tau _{\\rm{R}}\\) can be related to the time constant \\(\\tau _{\\rm{c}}\\). The rise time \\(\\tau _{\\rm{r}}\\) is the time required for the detector output to vary between given percentages (e.g. from 10% to 90%) of the final value. Similarly, the fall time \\(\\tau _{\\rm{f}}\\) is the time required for the detector output to vary between given percentages (e.g. from 90% to 10%) of the initial value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "response time" .

goldbook:R05346 a skos:Concept ;
    skos:definition "Time which elapses, when there is a stepwise change in the quantity to be measured, between the moment when this change is produced and the moment when the indication reaches a value conventionally fixed at 90% of the final change in indication." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "response time" .

goldbook:R05347 a skos:Concept ;
    skos:definition "Detector input can be e.g. radiant power, irradiation, radiant energy. It produces a measurable detector output which may be e.g. an electrical charge, an electrical current or potential or a change in pressure. The ratio of the detector output and the detector input is defined as the responsivity. It is given in e.g. ampere/watt, volt/watt. The responsivity is a special case of the general term sensitivity. Dark current is the term for the electrical output of a detector in the absence of input. This is a special case of the general term dark output. For photoconductive detectors the term dark resistance is used. If the responsivity is normalized with regard to that obtained from a reference radiation the resulting ratio is called relative responsivity. For measurements with monochromatic radiation at a given wavelength the term spectral responsivity \\(R(\\lambda)\\) is used. In some cases the 'relative spectral responsivity', where the spectral responsivity is normalized with respect to the responsivity at some given wavelength, is used. The dependence of the spectral responsivity on the wavelength is described by the spectral responsivity function. The useful spectral range of the detector should be given as the wavelength range where the relative responsivity does not fall below a specified value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "responsivity" .

goldbook:R05350 a skos:Concept ;
    skos:definition "Endonucleases which recognize specific base sequences within a DNA helix, creating a double-strand break of DNA. Type I restriction enzymes bind to these recognition sites but subsequently cut the DNA at different sites. Type II restriction enzymes both bind and cut within their recognition or target sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "restriction enzymes" .

goldbook:R05351 a skos:Concept ;
    skos:definition "The final value reported for a measured or computed quantity, after performing a measuring procedure including all subprocedures and evaluations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "result" .

goldbook:R05352 a skos:Concept ;
    skos:definition "The fraction of the sample component in the mobile phase at equilibrium; it is related to the retention factor and other fundamental chromatography terms: \\[R = \\frac{1}{k\\,+\\,1}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retardation factor" .

goldbook:R05353 a skos:Concept ;
    skos:altLabel "RF value" ;
    skos:definition "Ratio of the distance travelled by the centre of the spot to the distance simultaneously travelled by the mobile phase: \\[R_{\\rm{F}}=\\frac{b}{a}\\] By definition the \\(R_{\\rm{F}}\\) values are always less than unity. They are usually given to two decimal places. In order to simplify this presentation the \\(hR_{\\rm{F}}\\) values may be used: they correspond to the \\(R_{\\rm{F}}\\) values multiplied by 100. Ideally, \\(R_{\\rm{F}}\\) values are identical to the \\(R\\) values used in column chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retardation factor" .

goldbook:R05355 a skos:Concept ;
    skos:definition "This term, used mainly in polymerization kinetics, refers to a substance that reduces the rate of reaction. Synonymous with inhibitor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retarder" .

goldbook:R05357 a skos:Concept ;
    skos:definition "Of atoms undergoing a nuclear transformation, that fraction which remains in or reverts to its initial chemical form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention" .

goldbook:R05358 a skos:Concept ;
    skos:definition "The ratio of the quantity of particles retained by a separator to the quantity entering it (generally expressed as a percentage)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention efficiency" .

goldbook:R05359 a skos:Concept ;
    skos:definition "A measure of the time the sample component resides in the stationary phase relative to the time it resides in the mobile phase; it expresses how much longer a sample component is retarded by the stationary phase than it would take to travel through the column with the velocity of the mobile phase. Mathematically, it is the ratio of the adjusted retention volume (time) and the hold-up volume (time): \\[k=\\frac{V_{\\rm{R}}^{'}}{V_{\\rm{M}}}=\\frac{t_{\\rm{R}}^{'}}{t_{\\rm{M}}}\\] If the distribution constant is independent of sample component concentration, then the retention factor is also equal to the ratio of the amounts of a sample component in the stationary and mobile phases respectively, at equilibrium: \\[k=\\frac{\\rm{amount of component in stationary phase}}{\\rm{amount of component in mobile phase}}\\] If the fraction of the sample component in the mobile phase is \\(R\\), then the fraction in the stationary phase is \\(1 - R\\); thus \\[k=\\frac{1- R}{R}\\] In former nomenclatures and in the literature one may find the expressions partition ratio, capacity ratio, capacity factor or mass distribution ratio to describe this term. In the literature the symbol \\(k^{'}\\) is often used for the retention factor, particularly in liquid chromatography. The original reason for this was to clearly distinguish it from the partition coefficient (distribution constant) for which the symbol K had been utilized. Since, however, the distribution constants are all identified with a subscript, there is no reason to add the prime sign to this symbol. It should be emphasized that all the recognized nomenclatures (IUPAC, BS, ASTM) have always clearly identified the capacity factor with the symbol \\(k\\) and not \\(k^{'}\\). The logarithm of the retention factor is equivalent to the \\(R_{\\rm{M}}\\) value used in planar chromatography. The symbol \\(\\kappa \\) is suggested to express \\[\\kappa =\\log _{10}k=\\log _{10}\\left[\\frac{1- R}{R}\\right]\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention factor" .

goldbook:R05360 a skos:Concept ;
    skos:definition "The retention index of a sample component is a number, obtained by interpolation (usually logarithmic), relating the adjusted retention volume (time) or the retention factor of the sample component to the adjusted retention volumes (times) of two standards eluted before and after the peak of the sample component. In the Kováts index or Kováts retention index used in gas chromatography, n-alkanes serve as the standards and logarithmic interpolation is utilized: \\[I = 100\\left[\\frac{\\log _{10}X_{i}- \\log _{10}X_{z}}{\\log _{10}X_{z+1}- \\log _{10}X_{z}}+z\\right]\\] where \\(X\\) refers to the adjusted retention volumes or times, \\(z\\) is the number of carbon atoms of the n-alkane eluting before and \\(\\left(z+1\\right)\\) is the number of carbon atoms of the n-alkane eluting after the peak of interest: \\[V_{\\rm{R}z}^{'} < V_{\\rm{R}i}^{'} < V_{\\rm{R}(z+1)}\\] The Kováts (retention) index expresses the number of carbon atoms (multiplied by 100) of a hypothetical normal alkane which would have an adjusted retention volume (time) identical to that of the peak of interest when analysed under identical conditions. The Kováts retention index is always measured under isothermal conditions. In the case of temperature-programmed gas chromatography a similar value can be calculated utilizing direct numbers instead of their logarithm. Since both the numerator and denominator contain the difference of two values, here we can use the total retention volumes (times). Sometimes this value is called the linear retention index. \\[I^{\\rm{T}} = 100\\left[\\frac{t_{\\rm{R}i}^{\\rm{T}}- t_{\\rm{R}z}^{\\rm{T}}}{t_{\\rm{R}(z+1)}^{\\rm{T}}- t_{\\rm{R}z}^{\\rm{T}}}+z\\right]\\] where \\(t_{\\rm{R}}^{\\rm{T}}\\) refers to the total retention times (chart distances) measured under the conditions of temperature programming. The value of \\(I^{\\rm{T}}\\) will usually differ from the value of \\(I\\) measured for the same compound under isothermal conditions, using the same two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retention index" .

goldbook:R05369 a skos:Concept ;
    skos:definition "Oxygenated derivatives of 3,7-dimethyl-1-(2,6,6-trimethylcyclohex-1-enyl)nona-1,3,5,7-tetraene as shown and derivatives thereof." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retinoids" .

goldbook:R05370 a skos:Concept ;
    skos:definition "A prefix which indicates a shift by one position of all single and double bonds in a conjugated polyene system. It has been applied only to carotenoids and retinoids, e.g. retro-carotenoids, retro-retinoids. A prefix which indicates the reverse sequence of a peptide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "retro" .

goldbook:R05375 a skos:Concept ;
    skos:altLabel "reversed radiochemical isotope dilution analysis" ;
    skos:definition "Isotope dilution analysis used for the determination of the isotopic carrier in a solution of a radionuclide with the aid of one of its stable isotopes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversed isotope dilution analysis" .

goldbook:R05376 a skos:Concept ;
    skos:definition "An elution procedure used in liquid chromatography in which the mobile phase is significantly more polar then the stationary phase, e.g. a microporous silica-based material with chemically bonded alkyl chains. The term 'reverse phase' is an incorrect expression to be avoided." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversed-phase chromatography" .

goldbook:R05378 a skos:Concept ;
    skos:definition "Enzymes found in retroviruses that can synthesize complementary single-strands of DNA from an mRNA sequence as template. They are used in genetic engineering to produce specific cDNA molecules from purified preparations of mRNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse transcriptases" .

goldbook:R05379 a skos:Concept ;
    skos:definition "A transition that returns a system directly to its original state by reversing the process that changed it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible transition" .

goldbook:R05380 a skos:Concept ;
    skos:altLabel "RPM" ;
    skos:definition "Non-SI unit for rotational frequency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "revolutions per minute" .

goldbook:R05381 a skos:Concept ;
    skos:definition "The study of the flow and deformation of matter under the influence of a mechanical force. It is concerned particularly with material behaviour which cannot be described by the simple linear models of hydrodynamics and elasticity. Some of these departures are due to the presence of colloidal particles or to the influence of surfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rheology" .

goldbook:R05382 a skos:Concept ;
    skos:definition "A phenomenon in which the time of solidification, after discontinuation of a relatively high shear rate, is shortened by applying a small shear rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rheopexy" .

goldbook:R05384 a skos:Concept ;
    skos:definition "Dyes derived from condensation of phthalic anhydride with m-dialkylaminophenols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhodamine dyes" .

goldbook:R05385 a skos:Concept ;
    skos:definition "A thermodynamically unstable allotropic form of graphite with an ABCABC stacking sequence of the layers. The exact crystallographic description of this allotropic form is given by the space group \\(D_{3\\rm{d}}^{5}- R\\overline{3}m\\), (unit cell constants: \\(a=256.6\\ \\mathrm{pm}\\), \\(c=1006.2\\ \\mathrm{pm}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rhombohedral graphite" .

goldbook:R05386 a skos:Concept ;
    skos:altLabel "RNA" ;
    skos:definition "Naturally occurring polyribonucleotides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ribonucleic acids" .

goldbook:R05387 a skos:Concept ;
    skos:definition "Nucleotides in which the glycosyl group is a ribosyl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ribonucleotides" .

goldbook:R05388 a skos:Concept ;
    skos:altLabel "rRNA" ;
    skos:definition "RNA molecules which are essential structural and functional components of ribosomes, the subcellular units responsible for protein synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ribosomal RNA" .

goldbook:R05389 a skos:Concept ;
    skos:definition "Subcellular units composed of specific RNA molecules and a large number of proteins that are responsible for protein synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ribosomes" .

goldbook:R05390 a skos:Concept ;
    skos:altLabel "RRK",
        "RRK theory" ;
    skos:definition "A theory of unimolecular gas reactions in which the rate with which the energized reactant molecule breaks down is treated as a function of the energy \\(\\varepsilon\\) that it contains. The theory assumes that the rate is proportional to the number of ways of distributing \\(\\varepsilon\\) among the internal degrees of freedom of the reactant molecule, in such a manner that the critical energy \\(\\varepsilon_{\\rm{c}}\\) is localized in one particular degree of freedom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rice–Ramsperger–Kassel theory" .

goldbook:R05391 a skos:Concept ;
    skos:altLabel "RRKM",
        "RRKM theory" ;
    skos:definition "An improved form of Rice–Ramsperger–Kassel (RRK) theory in which account is taken of the way in which the various normal-mode vibrations and rotations contribute to reaction, and allowance is made for the zero-point energies. In this theory the energy \\(\\varepsilon^{\\rm{*}}\\) in an energized molecule is classified as either active, \\(\\varepsilon^{\\rm{*active}}\\), or inactive, \\(\\varepsilon^{\\rm{*inactive}}\\). The rate depends upon \\(\\frac{P(\\varepsilon^{\\rm{*active}})}{N(\\varepsilon^{\\rm{*}})}\\), where \\(N(\\varepsilon^{\\rm{*}})\\) is the density of states having energy between \\(\\varepsilon^{\\rm{*}}\\) and \\(\\varepsilon^{\\rm{*}}+\\rm{d}\\varepsilon^{\\rm{*}}\\), and \\(P(\\varepsilon^{\\rm{*active}})\\) is the sum of the active quantum states of the activated complex. This extension of RRK theory brings it in line with transition-state theory." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rice–Ramsperger–Kassel–Marcus theory" .

goldbook:R05392 a skos:Concept ;
    skos:definition "The separation of a free-flowing sample into (usually) equal parts by means of a mechanical device composed of diverter chutes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "riffling" .

goldbook:R05394 a skos:Concept ;
    skos:definition "A chart which has been used in air pollution evaluation for assigning the degree of blackness of smoke emanating from a source. The observer compares the shades of grey (white to black) with a series of shade diagrams formed by horizontal and vertical black grid lines on a white background. A corresponding number, the Ringelmann number, is then assigned to the describe the best match; numbers range from 0 (white) to 5 (black). This method of pollution evaluation, although relevant to the enforcement of legislation still in force in many countries, is not recommended for use today since more quantitative indicators of the efficiency of the combustion are now available." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ringelmann chart" .

goldbook:R05395 a skos:Concept ;
    skos:definition "A copolymerization which is a ring-opening polymerization with respect to at least one monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring-opening copolymerization" .

goldbook:R05396 a skos:Concept ;
    skos:definition "A polymerization in which a cyclic monomer yields a monomeric unit which is acyclic or contains fewer cycles than the monomer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring-opening polymerization" .

goldbook:R05397 a skos:Concept ;
    skos:altLabel "chair–chair interconversion",
        "ring inversion" ;
    skos:definition "The interconversion by rotation about single bonds (coupled with angle deformation in the transition state) of cyclic conformers having equivalent ring shapes (e.g. chair → chair) though not necessarily equivalent spatial positions of substituents (e.g. equatorial → axial)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ring reversal" .

goldbook:R05400 a skos:Concept ;
    skos:definition "The difference between the response time and the dead time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rise time" .

goldbook:R05401 a skos:Concept ;
    skos:altLabel "vertical rise velocity" ;
    skos:definition "The vertical component of the velocity of the volatilized component in the observation space (in \\(\\rm{mm s}^{-1}\\)). It depends on the flame temperature, the solute nebulized, the observation height and the gas flow rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rise velocity" .

goldbook:R05402 a skos:Concept ;
    skos:definition "The linear free-energy relation \\[\\log _{10}k_{\\rm{N}} = \\log _{10}k_{0}+N_{\\rm{+}}\\] applied to the reactions between nucleophiles and certain large and relatively stable organic cations, e.g. arenediazonium, triarylmethyl and aryltropylium cations in various solvents. \\(k_{\\rm{N}}\\) is the rate constant for reaction of a given cation with a given nucleophilic system (i.e. given nucleophile in a given solvent). \\(k_{0}\\) is the rate constant for the same cation with water in water, and \\(N_{\\rm{+}}\\) is a parameter which is characteristic of the nucleophilic system and independent of the cation. A surprising feature of the equation is the absence of a coefficient of \\(N_{\\rm{+}}\\), characteristic of the substrate (cf. the \\(s\\) in the Swain–Scott equation), even though values of \\(N_{\\rm{+}}\\) vary over 13 log units. The equation thus involves a gigantic breakdown of the reactivity–selectivity principle. The equation has been extended both in form and in range of application." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Ritchie equation" .

goldbook:R05404 a skos:Concept ;
    skos:definition "Non-SI unit of exposure to X- or $\\upgamma\\!\\mbox{-}\\rm{radiation}$: \\(\\rm{R} = \\pu{2.58E-4 C kg}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "röntgen" .

goldbook:R05407 a skos:Concept ;
    skos:definition "One of a set of conformers arising from restricted rotation about one single bond." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotamer" .

goldbook:R05408 a skos:Concept ;
    skos:definition "In a rotation of groups about a bond, the potential energy barrier between two adjacent minima of the molecular entity as a function of the torsion angle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational barrier" .

goldbook:R05411 a skos:Concept ;
    skos:definition "Defined by the equation: \\[D_{\\theta }=\\frac{t_{\\theta }}{\\frac{\\partial (f(\\theta ,\\mathit{\\Phi }))}{\\partial \\theta }\\ \\sin\\,\\theta }\\] where \\(f\\left(\\theta ,\\mathit{\\Phi }\\right)\\:\\sin \\,\\theta \\ \\rm{d}\\theta \\ \\rm{d}\\mathit{\\Phi }\\) is the fraction of particles whose axes make an angle between \\(\\theta \\) and \\(\\theta +\\mathrm{d}\\theta \\) with the direction \\(\\theta =0\\), and have an azimuth between \\(\\mathit{\\Phi}\\) and \\(\\mathit{\\Phi} + \\rm{d}\\mathit{\\Phi}\\); \\(t_{\\theta }\\ \\mathrm{d}\\mathit{\\Phi }\\) is the fraction of particles having an azimuth between \\(\\mathit{\\Phi}\\) and \\(\\mathit{\\Phi} + \\rm{d}\\mathit{\\Phi}\\) whose axis passes from values \\(\\theta \\) in unit time. The axis whose rotational diffusion is considered has to be clearly indicated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational diffusion coefficient" .

goldbook:R05412 a skos:Concept ;
    skos:definition "The number of rotations divided by time: \\[f_{\\rm{rot}}=\\frac{\\rm{d}N}{\\rm{d}t}\\] The synonyms rate of rotation, rate of revolution, centrifugal speed, centrifugation speed, and the traditional units of rotational frequency such as revolutions per minute, r.p.m., ppm, \\(\\rm{rev min}^{-1}\\), \\(\\rm{r min}^{-1}\\), are not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational frequency" .

goldbook:R05414 a skos:Concept ;
    skos:definition "A transition from a fully-ordered crystal of globular or quasi-spherical molecules to a crystal that retains translational order but exhibits dynamic orientational disorder and is usually mechanically soft (plastic phase). Example: The transition of $\\ce{CBr4}$ to a plastic phase which exists from \\(319\\) to \\(365\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotator phase transition" .

goldbook:R05415 a skos:Concept ;
    skos:definition "The quantitative measure of optical activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotatory power" .

goldbook:R05416 a skos:Concept ;
    skos:definition "Molecules in which a ring encloses another, rod-like molecule having end groups too large to pass through the ring opening, and thus holds the rod-like molecule in position without covalent bonding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotaxanes" .

goldbook:R05417 a skos:Concept ;
    skos:definition "Naturally occurring substances containing a cis-fused tetrahydrochromeno[3,4-b]chromene nucleus. Many rotenoids contain an additional ring, e.g rotenone:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotenoids" .

goldbook:R05418 a skos:Concept ;
    skos:definition "A device, based on Stokes law, for measuring rate of fluid flow. It is a tapered vertical tube having a circular cross-section in which a float moves in a vertical path to a height dependent upon the rate of fluid flow upward through the tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotometer" .

goldbook:R05419 a skos:Concept ;
    skos:altLabel "rugosity" ;
    skos:definition "The ratio: \\[f_{\\rm{r}}=\\frac{A_{\\rm{r}}}{A_{\\rm{g}}}\\] where \\(A_{\\rm{r}}\\) is the real (true, actual) surface (interface) area and \\(A_{\\rm{g}}\\) is the geometric surface (interface) area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "roughness factor" .

goldbook:R05420 a skos:Concept ;
    skos:definition "A state corresponding to a particular rotational sublevel of a particular vibrational level of a particular electronic state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rovibronic state" .

goldbook:R05423 a skos:Concept ;
    skos:definition "The approved designations (devised by Cahn, Ingold and Prelog) of absolute configuration at four-coordinate (quadriligant) and six-coordinate (sexiligant) stereogenic centres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>R</i>, <i>S</i>" .

goldbook:R05424 a skos:Concept ;
    skos:definition "Stereodescriptor s of pseudo-asymmetric atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>r</i>, <i>s</i>" .

goldbook:R05427 a skos:Concept ;
    skos:definition "A pulsed source of coherent radiation emitting mainly at \\(\\pu{694.3 nm}\\) from chromium ions ($\\ce{Cr^{3+}}$) in aluminium oxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ruby laser" .

goldbook:R05428 a skos:Concept ;
    skos:definition "The formation of a hole which permits coalescence or direct contact of the two phases which it separates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rupture" .

goldbook:R05429 a skos:Concept ;
    skos:altLabel "RBS",
        "backscattering spectrometry (BSS)",
        "backscattering spectroscopy" ;
    skos:definition "Any technique using high energy particles directed toward a sample, in which the bombarding particles are detected and recorded as function of energy and/or angle. The technique is mostly used for determining depth distributions of elements based on the energy of the backscattered particle. In general, $\\ce{He^{+}}$ or $\\ce{H^{+}}$ particles are used at energies in the order of \\(100\\ \\rm{keV}\\) to some \\(\\mathrm{MeV}\\). Also referred to as backscattering spectrometry (BSS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rutherford backscattering" .

goldbook:R05430 a skos:Concept ;
    skos:definition "Atomic fundamental physical constant \\(R_{\\infty} = \\frac{E_{h}}{2\\ h\\ c_{0}} = 1.097\\ 373\\ 1534\\ (13)\\times 10^{7}\\ \\rm{m}^{-1}\\), where \\(E_{h}\\) is the Hartree energy, \\(h\\) the Planck constant, and \\(c_{0}\\) the speed of light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rydberg constant" .

goldbook:R05431 a skos:Concept ;
    skos:definition "For an atom, an orbital with principal quantum number greater than that of any occupied orbital of the ground state. For a molecular entity, a molecular orbital which correlates with a Rydberg atomic orbital in an atomic fragment produced by dissociation. Typically, the extension of the Rydberg orbital is large compared to the size of the atom or molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rydberg orbital" .

goldbook:R05432 a skos:Concept ;
    skos:definition "An electronic transition described approximately as promotion of an electron from a 'bonding' orbital to a Rydberg orbital. Spectral bands corresponding to Rydberg transitions approximately fit the Rydberg formula: \\[\\sigma = I - \\frac{R}{(n\\,-\\,\\mathit{\\Delta })^{2}}\\] where \\(\\sigma \\) is the wavenumber, \\(I\\) the ionization potential of the atom or molecular entity, \\(n\\) a principal quantum number, \\(R\\) the Rydberg constant, and \\(\\mathit{\\Delta}\\) the quantum defect which differentiates between s, p, d, etc., orbitals. The notation used is, e.g. \\(\\pi \\rightarrow \\mathrm{ns}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rydberg transition" .

goldbook:RT06783 a skos:Concept ;
    skos:definition "Any oxidation-reduction (redox) reaction can be divided into two half-reactions: one in which a chemical species undergoes oxidation and one in which another chemical species undergoes reduction. If a half-reaction is written as a reduction, the driving force is the reduction potential. If the half-reaction is written as oxidation, the driving force is the oxidation potential related to the reduction potential by a sign change. So the redox potential is the reduction/oxidation potential of a compound measured under standards conditions against a standard reference half-cell. In biological systems the standard redox potential is defined at pH – 7.0 versus the hydrogen electrode and partial pressure of hydrogen = 1 bar." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "redox potential" .

goldbook:RT06793 a skos:Concept ;
    skos:definition "An iron-sulfur protein without acid-labile sulfur, in which an iron centre is coordinated by four sulfur-containing ligands, usually cysteine. The function, where known, is an electron carrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rubredoxin" .

goldbook:RT06807 a skos:Concept ;
    skos:definition "Probability of adverse effects caused under specified circumstances by an agent in an organism, a population, or an ecological system.Expected frequency of occurrence of a harmful event arising from such an exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk" .

goldbook:RT06808 a skos:Concept ;
    skos:definition "Identification and quantification of the risk resulting from a specific use or occurrence of an agent, taking into account possible harmful effects on individuals exposed to the agent in the amount and manner proposed and all the possible routes of exposure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk assessment" .

goldbook:RT06841 a skos:Concept ;
    skos:definition "Molecular structure in or on a cell that specifically recognizes and binds to a compound and acts as a physiological signal transducer, or mediator of, an effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "receptor" .

goldbook:RT06871 a skos:Concept ;
    skos:definition "The rod-like chain of an MCPLC (main-chain polymer liquid crystal) with direct links between the mesogenic groups for which the persistence length is at least comparable with the contour length and much greater than the diameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rigid chain" .

goldbook:RT06893 a skos:Concept ;
    skos:definition "Liquid-phase pressure-driven separation process in which applied transmembrane pressure causes selective movement of solvent against its osmotic pressure difference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reverse osmosis" .

goldbook:RT06912 a skos:Concept ;
    skos:altLabel "RfD" ;
    skos:definition "An estimate (with uncertainty spanning perhaps an order of magnitude) of daily exposure to the human population (including sensitive subgroups) that is likely to be without appreciable risk of deleterious effects during a lifetime." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reference dose" .

goldbook:RT06913 a skos:Concept ;
    skos:definition "Assessment with or without mathematical modeling, of the probability and nature of effects of exposure to a substance based on quantification of dose-effect and dose-response relationships for that substance and the population(s) and environmental components likely to be exposed and on assessment of the levels of potential exposure of people, organisms, and environment at risk." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "risk estimation" .

goldbook:RT06978 a skos:Concept ;
    skos:definition "A receptor is a protein or a protein complex in or on a cell that specifically recognizes and binds to a compound acting as a molecular messenger (neurotransmitter, hormone, lymphokine, lectin, drug, etc). In a broader sense, the term receptor is often used as a synonym for any specific (as opposed to non-specific such as binding to plasma proteins) drug binding site, also including nucleic acids such as DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "receptor" .

goldbook:RT06979 a skos:Concept ;
    skos:definition "Regression analysis is the use of statistical methods for modeling a set of dependent variables, Y, in terms of combinations of predictions, X. It includes methods such as multiple linear regression (MLR) and partial least squares (PLS)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "regression analysis" .

goldbook:RT07092 a skos:Concept ;
    skos:definition "The difference between the values of the absolute hardnesses (\\(\\eta \\)) of a given molecule and the corresponding reference structure (\\(\\eta _{\\rm{a}}\\)): \\(\\eta _{\\rm{r}} = \\eta - \\eta _{\\rm{a}}\\). The values of relative hardnesses correlate well with the resonance energies of cyclic compounds and may be used as an index of aromaticity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relative hardness" .

goldbook:RT07093 a skos:Concept ;
    skos:definition "Corrections to exact non-relativistic energy from the fact that inner shell electrons in heavy atoms move with velocities comparable in order of magnitude to the velocity of light. The most important relativistic effect is spin–orbit coupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "relativistic effects" .

goldbook:RT07094 a skos:Concept ;
    skos:definition "A localized valence bond representation of a molecule. This describes pictorially an electronic wavefunction that makes some contribution to the state wavefunction of the system. resonance hybrids are needed to describe the state of a system when that system is not adequately described by a single Lewis structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resonance hybrid" .

goldbook:RT07095 a skos:Concept ;
    skos:definition "Electron delocalization realized in both acyclic and cyclic $\\ce{\\uppi\\!\\mbox{-}conjugated}$, 1, and $\\ce{\\upsigma\\!\\mbox{-}bonded}$, 2, ribbon-like systems.  For cyclic systems, a variety of linkage fashions between several ribbons (pericyclic, spirocyclic, longicyclic and laticyclic) is possible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ribbon delocalisation" .

goldbook:RT07096 a skos:Concept ;
    skos:definition "An electronic state that arises by the excitation of a valence electron to a diffuse atomic-like orbital. For instance, the lowest lying Rydberg state (n, 3S) of $\\ce{NH3}$ can be described as resulting from the excitation of a non-bonding orbital to a 3S Rydberg orbital." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rydberg state" .

goldbook:RT07149 a skos:Concept ;
    skos:definition "Chemical reaction that is induced by ionizing radiation with $\\upgamma\\!\\mbox{-}\\rm{ray}$, X-ray, electron, or other high-energy beams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation reaction" .

goldbook:RT07150 a skos:Concept ;
    skos:altLabel "RIM" ;
    skos:definition "Mixing process that is accompanied by the chemical reaction(s) of components of a polymer mixture." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive blending" .

goldbook:RT07164 a skos:Concept ;
    skos:definition "Polymer having reactive functional groups that can undergo chemical transformation under the conditions required for a given reaction or application." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive polymer" .

goldbook:RT07166 a skos:Concept ;
    skos:definition "Soft solid or highly viscous substance, usually containing prepolymers with reactive groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resin" .

goldbook:RT07193 a skos:Concept ;
    skos:definition "Polymeric material that, when irradiated, undergoes a marked change in solubility in a given solvent or is ablated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "resist polymer" .

goldbook:RT07308 a skos:Concept ;
    skos:definition "Morphology characterized by cylindrical phase domains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rod-like morphology" .

goldbook:RT07470 a skos:Concept ;
    skos:definition "Process by which the resonance radiation emitted in a lamp is absorbed and re-emitted many times in the plasma prior to striking the phosphor. This process is called radiation trapping or imprisonment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radiation trapping" .

goldbook:RT07471 a skos:Concept ;
    skos:altLabel "free-radical photosubstitution" ;
    skos:definition "Photo-induced substitution resulting from the reaction of radicals produced by photolysis of an appropriate reagent, such as, e.g., halogenated compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "radical photosubstitution" .

goldbook:RT07472 a skos:Concept ;
    skos:definition "Empirical correlation found between the observed second-order rate constant, \\(k_{\\rm{q}}\\), for an intermolecular electron-transfer reaction and the Gibbs energy of the photoinduced electron transfer process within the encounter complex (\\(\\Delta _{\\rm{ET}}G^{\\,\\unicode{x26ac}}\\)): \\[k_{\\rm{q}} = \\frac{k_{\\rm{d}}}{1+ \\frac {k_{\\rm{d}}}{K_{\\rm{d}}\\, \\rm{Z}}\\left [ \\rm{exp}\\left ( \\frac{\\Delta G^{\\ddagger }}{RT} \\right ) + \\rm{exp}\\left ( \\frac{\\Delta_{\\rm{ET}} G^{o }}{RT} \\right ) \\right ]}\\] with \\(k_{\\rm{d}}\\) and \\(k_{\\rm{-d}}\\) the rate constant for the formation and separation, respectively, of the encounter (precursor) complex, \\(K_{\\rm{d}} = \\: ^{k_{\\rm{d}}}\\! /_{k_{\\rm{-d}}}\\), \\(Z\\) the universal collision frequency factor, \\(R\\) the gas constant, \\(T\\) the absolute temperature and \\(\\Delta G^{\\ddagger}\\) the activation Gibbs energy of the forward electron transfer reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Rehm–Weller equation" .

goldbook:RT07473 a skos:Concept ;
    skos:definition "Photoselected molecules hindered in their rotation (e.g., in lipid bilayers or liquid crystals) do not become randomly oriented even after long time periods. Thus, the emission anisotropy does not decay to zero but to a steady value, \\(r_{\\mathrm{\\infty }}\\), called residual emission anisotropy. In the case of a single rotational correlation time, \\(\\tau _{\\mathrm{c}}\\) or \\(\\theta \\), the decay of emission anisotropy following $\\ce{\\updelta\\!\\mbox{-}pulse}$ excitation is given by: \\[r\\left(t\\right)=(r_{0}- r_{\\mathrm{\\infty }})\\ \\exp (- \\frac{t}{\\tau _{\\mathrm{c}}})+r_{\\mathrm{\\infty }}\\] where \\(r_{0}\\) is the fundamental emission anisotropy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "residual emission anisotropy" .

goldbook:RT07474 a skos:Concept ;
    skos:definition "Parameter describing the time dependence of the tumbling of a molecular entity in a medium of viscosity \\(\\eta\\). The rotational correlation time can be obtained from the decay of the fluorescence or phosphorescence anisotropy and is related to the average molecular rotational diffusion coefficient, \\(D_{\\rm{r}}\\), in turn related to the hydrodynamic molecular volume of the fluorophore, \\(V\\), and to \\(\\eta\\) (see Note 3)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational correlation time" .

goldbook:RT07475 a skos:Concept ;
    skos:definition "Parameter describing the time-dependence of the tumbling of a molecular entity in a medium of viscosity \\(\\eta\\) as originally defined by Debye, and used by Perrin in the original development of the theories of rotational motion of fluorophores." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rotational relaxation time" .

goldbook:RT07526 a skos:Concept ;
    skos:definition "Gel that responds to external electrical, mechanical, thermal, light-induced or chemical stimulation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "responsive gel" .

goldbook:RT07527 a skos:Concept ;
    skos:altLabel "rheotropic gel" ;
    skos:definition "Gel for which the time of solidification after discontinuation of a relatively high shear rate, is reduced by applying a small shear rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "rheopexic gel" .

goldbook:RT07529 a skos:Concept ;
    skos:altLabel "humming gel" ;
    skos:definition "Gel with energy dissipation in the acoustic frequency range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ringing gel" .

goldbook:RT07572 a skos:Concept ;
    skos:definition "Polymer network that forms or breaks up as the temperature is changed or under the action of a force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reversible network" .

goldbook:RT07628 a skos:Concept ;
    skos:altLabel "RIM" ;
    skos:definition "Reactive polymer processing that produces polymer monoliths by low-pressure injection and mixing of low-viscosity precursors into moulds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reaction injection moulding" .

goldbook:RT07629 a skos:Concept ;
    skos:altLabel "RRIM" ;
    skos:definition "Reaction injection moulding within which glass fibres are included to increase the strength of the moulding." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reinforced reaction injection moulding" .

goldbook:RT07630 a skos:Concept ;
    skos:definition "Process whereby a polymeric monolith is produced through an in-situpolymerization or polymer modification reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "reactive polymer processing" .

goldbook:S04387 a skos:Concept ;
    skos:definition "An electronic transition described approximately as a promotion of an electron from a 'bonding' orbital $\\ce{\\uppi\\!}$ to an 'antibonding' orbital $\\ce{\\upsigma\\!}$ designated as $\\ce{\\upsigma\\!^{\\ast}}$. Such transitions generally involve high transition energies and appear close to or mixed with Rydberg transitions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "π → σ* transition" .

goldbook:S05434 a skos:Concept ;
    skos:altLabel "sigma, pi" ;
    skos:definition "The terms are symmetry designations, $\\ce{\\uppi\\! molecular orbitals}$ being antisymmetric with respect to a defining plane containing at least one atom (e.g. the molecular plane of ethene) and $\\ce{\\upsigma\\! molecular orbitals}$ symmetric with respect to the same plane. In practice the terms are used both in this rigorous sense (for orbitals encompassing the entire molecule) and also for localized two-centre orbitals or bonds, and it is necessary to make a clear distinction between the two usages. In the case of two-centre bonds, a $\\ce{\\uppi\\!\\mbox{-}bond}$ has a nodal plane that includes the internuclear bond axis, whereas a $\\ce{\\upsigma\\!\\mbox{-}bond}$ has no such nodal plane. (A $\\ce{\\updelta\\!\\mbox{-}bond}$ in organometallic or inorganic molecular species has two nodes.) Radicals are classified by analogy into $\\ce{\\upsigma\\!\\mbox{-}}$ and $\\ce{\\uppi\\!\\mbox{-}radicals}$. Such two-centre orbitals may take part in molecular orbitals of $\\ce{\\upsigma\\!\\mbox{-}}$ or $\\ce{\\uppi\\!\\mbox{-}symmetry}$. For example, the methyl group in propene contains three $\\ce{C–H}$ bonds, each of which is of local $\\ce{\\upsigma\\!\\mbox{-}symmetry}$ (i.e. without a nodal plane including the internuclear axis), but these three '$\\ce{\\upsigma\\!\\mbox{-}bonds}$' can in turn be combined to form a set of group orbitals one of which has $\\ce{\\uppi\\!\\mbox{-}symmetry}$ with respect to the principal molecular plane and can accordingly interact with the two-centre orbital of $\\ce{\\uppi\\!\\mbox{-}symmetry}$ ($\\ce{\\uppi\\!\\mbox{-}bond}$) of the double-bonded carbon atoms, to form a molecular orbital of $\\ce{\\uppi\\!\\mbox{-}symmetry}$. Such an interaction between the $\\ce{CH3}$ group and the double bond is an example of what is called hyperconjugation. This cannot rigorously be described as '$\\ce{\\upsigma\\!\\mbox{-}\\uppi\\!}$ conjugation' since $\\ce{\\upsigma\\!}$ and $\\ce{\\uppi\\!}$ here refer to different defining planes, and interaction between orbitals of different symmetries (with respect to the same defining plane) is forbidden." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "σ, π" .

goldbook:S05435 a skos:Concept ;
    skos:definition "An electronic transition described approximately as promotion of an electron from a 'bonding' $\\ce{\\upsigma\\!\\mbox{-}orbital}$ to an 'antibonding' $\\ce{\\upsigma\\!\\mbox{-}orbital}$ designated as \\(\\sigma ^{\\rm{*}}\\). Such transitions generally involve high transition energies, and appear close to or mixed with Rydberg transitions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "σ → σ* transition" .

goldbook:S05441 a skos:Concept ;
    skos:definition "The monosaccharides (1) and di- (2), oligo- (3 - 10) and polysaccharides (many), which are made up of $n$ monosaccharide units linked to each other by a glycosidic bond. Considered by some to be synonymous with carbohydrates." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saccharides" .

goldbook:S05442 a skos:Concept ;
    skos:definition "Fundamental physical constant representing the translational contribution to molar entropy; \\(\\frac{S_{0}}{R} = -1.151\\ 693(21)\\) at \\(1\\ \\rm{K}\\) and standard pressure of \\(100\\ \\rm{kPa}\\), where \\(R\\) is the gas constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Sackur–Tetrode constant" .

goldbook:S05443 a skos:Concept ;
    skos:definition "Molecular entity that acts as the electron acceptor in a photoinduced electron transfer process and is not restored in a subsequent oxidation process but is destroyed by irreversible chemical conversion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sacrificial acceptor" .

goldbook:S05444 a skos:Concept ;
    skos:definition "Molecular entity that acts as the electron donor in a photoinduced electron transfer process and is not restored in a subsequent reduction process but is destroyed by irreversible chemical conversion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sacrificial donor" .

goldbook:S05447 a skos:Concept ;
    skos:definition "A chemical compound consisting of an assembly of cations and anions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salt" .

goldbook:S05449 a skos:Concept ;
    skos:definition "The ionic form of an ion exchanger in which the counter-ions are neither hydrogen nor hydroxide ions. When only one valence is possible for the counter-ion, or its exact form or charge is not known, the symbol or the name of the counter-ion without charge is used, e.g. sodium-form or $\\ce{Na}$-form, tetramethylammonium-form, orthophosphate-form. When one of two or more possible forms is exclusively present, the oxidation state may be indicated by a Roman numeral, e.g. $\\ce{Fe^{II}}$ form, $\\ce{Fe^{III}}$ form." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salt form of an ion exchanger" .

goldbook:S05450 a skos:Concept ;
    skos:definition "The addition of particular electrolytes to an aqueous phase in order to increase the distribution ratio of a particular solute." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "salting out" .

goldbook:S05451 a skos:Concept ;
    skos:altLabel "analytical sample" ;
    skos:definition "A portion of material selected from a larger quantity of material. The term needs to be qualified, e.g. bulk sample, representative sample, primary sample, bulked sample, test sample. The term 'sample' implies the existence of a sampling error, i.e. the results obtained on the portions taken are only estimates of the concentration of a constituent or the quantity of a property present in the parent material. If there is no or negligible sampling error, the portion removed is a test portion, aliquot or specimen. The term 'specimen' is used to denote a portion taken under conditions such that the sampling variability cannot be assessed (usually because the population is changing), and is assumed, for convenience, to be zero. The manner of selection of the sample should be prescribed in a sampling plan." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample" .

goldbook:S05456 a skos:Concept ;
    skos:definition "An error which arises when the absorbance of some samples changes with time, e.g. as a result of photochemical reaction, formation of aggregates or adsorption on the cell wall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample error" .

goldbook:S05457 a skos:Concept ;
    skos:definition "Any action applied to the sample before the analytical procedure. Such actions include the addition of preservatives, separation procedures, storage at low temperature, protection against light and irradiation, loading, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample handling" .

goldbook:S05459 a skos:Concept ;
    skos:definition "A device used to withdraw and deliver a volume or an amount of a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampler" .

goldbook:S05461 a skos:Concept ;
    skos:definition "The discrete identifiable portion suitable for taking as a sample or as a portion of a sample. These units may be different at different stages of sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sample unit" .

goldbook:S05463 a skos:Concept ;
    skos:definition "That part of the total error (the estimate from a sample minus the population value) associated with using only a fraction of the population and extrapolating to the whole, as distinct from analytical or test error. It arises from a lack of homogeneity in the parent population. In chemical analysis, the final test result reflects the value only as it exists in the test portion. It is usually assumed that no sampling error is introduced in preparing the test sample from the laboratory sample. Therefore, the sampling error is usually associated exclusively with the variability of the laboratory sample. Sampling error is determined by replication of the laboratory samples and their multiple analyses. Since sampling error is always associated with analytical error, it must be isolated by the statistical procedure of analysis of variance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling error" .

goldbook:S05465 a skos:Concept ;
    skos:definition "In Tast polarography, square-wave polarography, and similar techniques, the interval during which the current is measured or recorded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling interval" .

goldbook:S05466 a skos:Concept ;
    skos:definition "A predetermined procedure for the selection, withdrawal, preservation, transportation and preparation of the portions to be removed from a population as samples. Summarizing the test values or observations from the selected portions yields an estimate for the concentration of an analyte or a value for a property determined with a calculable degree of uncertainty at a specified confidence level. A sampling plan includes the designation of the number, location and size of the portions, and instructions for the extent of compositing and for the reduction (in amount and fineness) of the portions to a laboratory sample and to test portions. It may also contain acceptance criteria. Some sampling plans do not include more than instructions for the statistical selection of portions to be removed. Such plans should properly be designated as 'statistical sampling plans'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling plan" .

goldbook:S05467 a skos:Concept ;
    skos:definition "In Tast polarography, square-wave polarography, and similar techniques, the duration of the sampling interval." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sampling time" .

goldbook:S05468 a skos:Concept ;
    skos:definition "Compounds in which a metal atom is located between the faces of two parallel and planar (or nearly so) ring structures, e.g. bis(\\(\\eta ^{5}\\)-cyclopentadienyl)iron (ferrocene), dibenzenechromium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sandwich compounds" .

goldbook:S05469 a skos:Concept ;
    skos:definition "An engineered burial of refuse. The refuse is dumped into trenches and compacted by bulldozer, where, it is hoped, aerobic metabolism by microorganisms decomposes the organic matter to stable compounds ($\\ce{H2O}$, $\\ce{CO2}$, etc.). Moisture is essential for the biological degradation and groundwater assists the process except when it fills air voids and prevents the transport of oxygen to the refuse. Land fills of unsatisfactory design can be major sources of air, water and soil pollution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sanitary land fill" .

goldbook:S05470 a skos:Concept ;
    skos:definition "A microorganism that feeds on dead and decaying organic matter. Saprophytes excrete enzymes that digest organic residues externally, the low molecular weight compounds formed then being absorbed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saprophyte" .

goldbook:S05473 a skos:Concept ;
    skos:definition "Of an irradiated element for a specified isotope, the steady state reached when the disintegration rate of the nuclide formed is equal to its production rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation" .

goldbook:S05474 a skos:Concept ;
    skos:definition "For a specified isotope, the value of the activity of an irradiated element, whence state of saturation is reached." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation activity" .

goldbook:S05476 a skos:Concept ;
    skos:definition "Amount-of-substance of a component (solute) in a solution divided by the amount-of-substance of the component when it is saturating the system at constant temperature and pressure. Also referred to simply as saturation, for example oxygen saturation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation fraction" .

goldbook:S05478 a skos:Concept ;
    skos:definition "A term used in nuclear magnetic resonance. When a nucleus is strongly irradiated, its spin population may partly be transferred to another nucleus by an exchange process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation transfer" .

goldbook:S05479 a skos:Concept ;
    skos:definition "The pressure exerted by a pure substance (at a given temperature) in a system containing only the vapour and condensed phase (liquid or solid) of the substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "saturation vapour pressure" .

goldbook:S05480 a skos:Concept ;
    skos:definition "A perspective formula indicating the spatial arrangement of bonds on two adjacent carbon atoms. The bond between the two atoms is represented by a diagonal line, the left-hand bottom end of which locates the atom nearer the observer and the right-hand top end the atom that is further away. In general a Newman or zig-zag projection is preferred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sawhorse projection" .

goldbook:S05481 a skos:Concept ;
    skos:altLabel "Zaitsev rule" ;
    skos:definition "Dehydrohalogenation of secondary- and tertiary-alkyl halides proceeds by the preferential removal of the $\\ce{\\upbeta\\!\\mbox{-}hydrogen}$ from the carbon that has the smallest number of hydrogens. Originally formulated by A. Saytzeff (Zaitsev) to generalize the orientation in $\\ce{\\upbeta\\!\\mbox{-}}$elimination reactions of alkyl halides, this rule has been extended and modified, as follows: When two or more olefins can be produced in an elimination reaction, the thermodynamically most stable alkene will predominate. Exceptions to the Saytzeff rule are exemplified by the Hofmann rule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Saytzeff rule" .

goldbook:S05482 a skos:Concept ;
    skos:definition "A sub-assembly for counting electrical pulses and containing one or more scaling circuits." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaler" .

goldbook:S05483 a skos:Concept ;
    skos:definition "An electronic circuit which produces an output pulse for each time a specified number of pulses has been received at its input." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaling circuit" .

goldbook:S05484 a skos:Concept ;
    skos:altLabel "SEM" ;
    skos:definition "Any analytical technique which involves the generation and evaluation of secondary electrons (and to a lesser extent back scattered electrons) by a finely focused electron beam (typically \\(10\\ \\rm{nm}\\) or less) for high resolution and high depth of field imaging." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning electron microscopy" .

goldbook:S05485 a skos:Concept ;
    skos:definition "This term refers to the sequence of control over operating parameters of a mass spectrometer that results in a spectrum of masses, velocities, momenta or energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning method" .

goldbook:S05486 a skos:Concept ;
    skos:altLabel "STEM" ;
    skos:definition "A special TEM-technique in which an electron transparent sample is bombarded with a finely focused electron beam (typically of a diameter of less than $\\pu{10 nm}$) which can be scanned across the specimen or rocked across the optical axis and transmitted, secondary, back scattered and diffracted electrons as well as the characteristic X-ray spectrum can be observed. STEM essentially provides high resolution imaging of the inner microstructure and the surface of a thin sample (or small particles), as well as the possibility of chemical and structural characterization of micrometer and sub-micrometer domains through evaluation of the X-ray spectra and the electron diffraction pattern." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scanning transmission electron microscopy" .

goldbook:S05487 a skos:Concept ;
    skos:definition "A process in which a change in direction or energy of an incident radiation is caused by interaction with a particle, a system of particles, or a photon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering" .

goldbook:S05488 a skos:Concept ;
    skos:altLabel "angle of observation" ;
    skos:definition "The angle between the forward direction of the incident beam and a straight line connecting the scattering point and the detector. Synonymous with angle of observation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering angle" .

goldbook:S05490 a skos:Concept ;
    skos:definition "The scattering coefficient per particle (\\(\\frac{\\rm{cm}^{2}}{\\rm{particle}}\\)); \\[b_{\\rm{scat}}=n\\ \\sigma _{\\rm{scat}}\\] where \\(n\\) is the number concentration of particles (\\(\\rm{particles cm}^{-3}\\)) and \\(\\sigma _{\\rm{scat}}\\) is the scattering cross-section. \\(b_{\\rm{scat}}\\), the scattering component of extinction due to gas and particles, is measured in the atmosphere using a nephelometer. For a homogeneous atmosphere it is related in theory to the meteorological range (\\(L_{\\rm{V}}\\)): \\(L_{\\rm{V}}=\\frac{3.9}{b_{\\rm{scat}}}\\); \\(b_{\\rm{scat}}\\) and \\(b_{\\rm{abs}}\\) represent the scattering and absorption coefficients per unit length for a light beam (of path length \\(L\\)) which has a spectral radiance (intensity) \\(I_{0}\\) incident on a sample of air and \\(I\\) is the transmitted spectral radiance (intensity), \\(\\ln (\\frac{I_{0}}{I}) = L\\ (b_{\\rm{scat}}+b_{\\rm{abs}})\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering cross-section" .

goldbook:S05491 a skos:Concept ;
    skos:definition "The presence of particulate matter, emulsions, micelles, etc. may cause radiation scattering which will result in further attenuation of the transmitted beam and the measured absorbance will be too high. This error is called the scattering error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering error" .

goldbook:S05492 a skos:Concept ;
    skos:definition "The Stokes parameters of scattered light are given by the matrix equation \\[(s_{0},s_{1},s_{2},s_{3}) = F\\ (s_{0}^{0},s_{1}^{0},s_{2}^{0},s_{3}^{0})\\] where the 4, 4 scattering matrix \\(F\\) is comprised of 16 scattering matrix elements. These matrix elements, which may originate in theory or experiment, provide a complete description of the scattered radiation in terms of the incident radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering matrix" .

goldbook:S05493 a skos:Concept ;
    skos:definition "The plane containing the incident light beam and the line from the centre of the scattering system to the observer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scattering plane" .

goldbook:S05495 a skos:Concept ;
    skos:definition "A substance that reacts with (or otherwise removes) a trace component (as in the scavenging of trace metal ions) or traps a reactive reaction intermediate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scavenger" .

goldbook:S05496 a skos:Concept ;
    skos:definition "Binding radicals or free electrons with a receptive (or reactive) material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scavenging" .

goldbook:S05497 a skos:Concept ;
    skos:definition "Chemical transformation of one molecular entity caused by photoexcitation of a sensitizer, which undergoes temporary covalent bond formation with the molecular entity (M)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schenck-sensitization mechanism" .

goldbook:S05498 a skos:Concept ;
    skos:altLabel "Schiff's bases" ;
    skos:definition "Imines bearing a hydrocarbyl group on the nitrogen atom $\\ce{R2C=NR'}$ ($\\ce{R'}  eq \\ce{H}$). Considered by many to be synonymous with azomethines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schiff bases" .

goldbook:S05499 a skos:Concept ;
    skos:altLabel "iridescent layers" ;
    skos:definition "In some systems, sedimenting particles form layers separated by approximately equal distances of the order of the wavelength of light. This gives rise to strong colours when observed in reflected light and the system is said to form iridescent layers or Schiller layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schiller layers" .

goldbook:S05501 a skos:Concept ;
    skos:definition "The generalization that the critical coagulation concentration for a typical lyophobic sol is extremely sensitive to the valence of the counter-ions (high valence gives a low critical coagulation concentration)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schulze–Hardy rule" .

goldbook:S05503 a skos:Concept ;
    skos:definition "Burst of luminescence of short duration caused by an individual energetic particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scintillation" .

goldbook:S05504 a skos:Concept ;
    skos:definition "A scintillator coupled to a photomultiplier tube. Incident X-ray photons are converted in the scintillator into bursts of visible light photons, some of which fall on the photocathode and can be measured. For incident photons having energies higher than the absorption edge of the elements contained in the scintillator, an escape peak can be observed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scintillation counter" .

goldbook:S05505 a skos:Concept ;
    skos:definition "A radiation detector using a medium in which a burst of luminescence radiation, produced along the path of an ionizing particle, is quantified." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scintillation detector" .

goldbook:S05506 a skos:Concept ;
    skos:definition "A measuring assembly incorporating a scintillation detector and a pulse amplitude analyser used for determining the energy spectrum of certain types of radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scintillation spectrometer" .

goldbook:S05507 a skos:Concept ;
    skos:definition "Materials used for the measurement of radioactivity, by recording the radioluminescence. They contain compounds (chromophores) which combine a high fluorescence quantum efficiency, a short fluorescence lifetime, and a high solubility. These compounds are employed as solutes in aromatic liquids and polymers to form organic liquid and plastic scintillators, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scintillators" .

goldbook:S05508 a skos:Concept ;
    skos:definition "The spatial arrangement of two conjugated double bonds about the intervening single bond is described as s-cis if synperiplanar and s-trans if antiperiplanar. This term should not be applied to other systems such as N-alkyl amides (use E/Z or sp/ap)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "s-<i>cis</i>, s-<i>trans</i>" .

goldbook:S05510 a skos:Concept ;
    skos:definition "An apparatus used in sampling and in flue gas cleaning. The gas is passed through a space containing wetted 'packing' or spray. In general, particles are collected in scrubbers by one or a combination of the following: impingement of particles on a liquid medium; diffusion of the particles onto a liquid medium; condensation of liquid medium vapours on the particles; partitioning of the gas into extremely small elements to allow collection of the particles by Brownian diffusion and gravitation settling on the gas-liquid interface. The devices include spray towers, jet scrubbers, Venturi scrubbers, cyclonic scrubbers, inertial scrubbers, mechanical scrubbers and packed scrubbers. Normally the gas flow in the scrubber is counter to the liquid flow. Efficient scrubbers will collect particles as small as \\(1\\) to \\(2\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scrubber" .

goldbook:S05511 a skos:Concept ;
    skos:definition "The process of selectively removing contaminating solutes (impurities) from an extract that contains these as well as the main extractable solute by treatment with a new immiscible liquid phase. The term stripping has a different meaning and should not be used in this sense although this usage has been customary in certain industries." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scrubbing" .

goldbook:S05512 a skos:Concept ;
    skos:definition "Cleavage of a ring with addition of one or more hydrogen atoms at each terminal group thus created is indicated by the prefix 'seco'. Examples:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seco-" .

goldbook:S05514 a skos:Concept ;
    skos:definition "Non-SI unit of plane angle: \\(1^{\\prime\\prime} = \\frac{1}{3600}\\ ^{\\unicode{x26ac}} = 4.848\\ 137\\,...\\,\\times\\ 10^{-6}\\ \\rm{rad}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "second" .

goldbook:S05517 a skos:Concept ;
    skos:definition "A device to multiply current in an electron beam (or in a photon or particle beam by first conversion to electrons) by incidence of accelerated electrons upon the surface of an electrode which yields a number of secondary electrons greater than the number of incident electrons. These electrons are then accelerated to another electrode (or another part of the same electrode), which in turn emits further secondary electrons so that the process can be repeated. It is recommended that one should refer to the abundance of an ion, to the intensity of an ion beam, and to the height or area of a peak." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary electron multiplier" .

goldbook:S05518 a skos:Concept ;
    skos:altLabel "se" ;
    skos:definition "All electrons emitted from the surface of a solid except back scattered primary electrons. In practice, electrons emitted from the surface of a solid under particle bombardment which have a kinetic energy of less than \\(50\\ \\rm{eV}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary electrons" .

goldbook:S05519 a skos:Concept ;
    skos:altLabel "secondary electron yield" ;
    skos:definition "The number of secondary electrons generated per primary electron for a given specimen and experimental conditions. It depends on the (mean) atomic number of the excited area of the sample, the angle between electron beam and sample surface, the primary electron energy, thickness of the sample and sample potentials." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary-electron yield" .

goldbook:S05521 a skos:Concept ;
    skos:definition "Ionization of the analyte element in a sample by characteristic radiation from other elements in the sample resulting in an enhancement of the signal measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary fluorescence" .

goldbook:S05522 a skos:Concept ;
    skos:definition "The process in which ions are ejected from a sample surface (which may be a solid or substrate dissolved in a solvent matrix) as a result of bombardment by a primary beam of atoms or ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary ionization" .

goldbook:S05523 a skos:Concept ;
    skos:definition "A kinetic isotope effect that is attributable to isotopic substitution of an atom to which bonds are neither made nor broken in the rate-controlling step or in a pre-equilibrium step of a specified reaction, and is therefore not a primary isotope effect. One speaks of $\\ce{\\upalpha\\!}$, $\\ce{\\upbeta\\!}$, (etc.) secondary isotope effects, where $\\ce{\\upalpha\\!}$, $\\ce{\\upbeta\\!}$, (etc.) denote the position of isotopic substitution relative to the reaction centre. The corresponding isotope effect on the equilibrium constant of such a reaction is called a 'secondary equilibrium isotope effect'. Secondary isotope effects have been discussed in terms of the conventional electronic effects of physical organic chemistry, e.g. induction, hyperconjugation, hybridization, etc., since these properties are determined by the electron distribution, that depends on vibrationally averaged bond lengths and angles which vary slightly with isotopic substitution. While this usage is legitimate, the term 'electronic isotope effect' should be avoided, because of the misleading implication that such an effect is electronic rather than vibrational in origin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary isotope effect" .

goldbook:S05526 a skos:Concept ;
    skos:definition "Metabolites which are produced by routes other than the normal metabolic pathways, mostly after the phase of active growth and under conditions of deficiency. The biological significance of many secondary metabolites is not exactly known." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary metabolites" .

goldbook:S05527 a skos:Concept ;
    skos:altLabel "secondary emissions" ;
    skos:definition "The products of the primary pollutants which form through photochemical and thermal reactions in the atmosphere ($\\ce{O3}$, peroxyacetyl nitrate, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary pollution" .

goldbook:S05528 a skos:Concept ;
    skos:definition "Radiation emitted by any matter irradiated with electromagnetic or ionizing radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary radiation" .

goldbook:S05530 a skos:Concept ;
    skos:definition "The conformational arrangement ($\\ce{\\upalpha\\!}$-helix, $\\ce{\\upbeta\\!\\mbox{-}pleated}$ sheet, etc.) of the backbone segments of a macromolecule such as a polypeptide chain of a protein without regard to the conformation of the side chains or the relationship to other segments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secondary structure" .

goldbook:S05531 a skos:Concept ;
    skos:altLabel "continuous transition" ;
    skos:definition "A transition in which a crystal structure undergoes a continuous change and in which the first derivatives of the Gibbs energies (or chemical potentials) are continuous but the second derivatives with respect to temperature and pressure (i.e. heat capacity, thermal expansion, compressibility) are discontinuous. Example: The order–disorder transition in metal alloys, for example, $\\ce{CuZn}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "second-order transition" .

goldbook:S05532 a skos:Concept ;
    skos:definition "Radioactive equilibrium where the half life of the precursor isotope is so long that the change of its activity can be ignored during the period of interest and all activities remain constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secular equilibrium" .

goldbook:S05533 a skos:Concept ;
    skos:definition "The highly concentrated suspension which may be formed by the sedimentation of a dilute suspension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sediment" .

goldbook:S05534 a skos:Concept ;
    skos:definition "In the atmospheric sciences, the process of removal of an air borne particle from the atmosphere due to the effect of gravity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation" .

goldbook:S05535 a skos:Concept ;
    skos:definition "Velocity of sedimentation divided by the acceleration of the force field (gravitation or centrifugation)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation coefficient" .

goldbook:S05537 a skos:Concept ;
    skos:definition "The potential difference \\(E_{\\mathrm{sed}}\\) per unit length in a sedimentation or centrifugation cell. As the contributions of the interfacial potential differences at the electrodes are not included in \\(E_{\\mathrm{sed}}\\) this quantity, although theoretically important, is not accessible to measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation field strength" .

goldbook:S05538 a skos:Concept ;
    skos:altLabel "Dorn effect",
        "sedimentation potential" ;
    skos:definition "The potential difference \\(E_{\\mathrm{sed}}\\) or \\(E\\) at zero current caused by the sedimentation of particles in the field of gravity or in a centrifuge, between two identical electrodes at different levels (or at different distances from the centre of rotation). \\(E\\) is positive if the lower (peripheral) electrode is negative. This is also called the Dorn effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation potential difference" .

goldbook:S05539 a skos:Concept ;
    skos:definition "Velocity of a component in a fluid relative to the fluid in the direction of gravitational or centrifugal acceleration. Also called sedimentation rate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation velocity" .

goldbook:S05541 a skos:Concept ;
    skos:definition "The volume \\(V_{\\mathrm{sed}}\\) of sediment formed in a suspension. If the sediment is formed in a centrifugal field, the strength of this field should be explicitly indicated, otherwise normal gravity is understood." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation volume" .

goldbook:S05542 a skos:Concept ;
    skos:definition "(for bulk materials): Each of the single, large portions of material pre-existing either in space (e.g. bags, bales, drums) or accumulated during a fixed time (e.g. discharge from a conveyor belt) or formable as increments by a sampling device. Segments may be actual or conceptual." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "segment" .

goldbook:S05544 a skos:Concept ;
    skos:definition "The process that differentiates the composition at an interface or surface from the average or bulk composition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "segregation" .

goldbook:S05547 a skos:Concept ;
    skos:definition "This term is used to describe the operation of the mass spectrometer in which the intensities of several specific ion beams are recorded rather than the entire mass spectrum. An alternative recommended term is multiple ion (peak) monitoring. The use of the terms multiple ion detection and mass fragmentography are not recommended, because in the case of the former, it is the monitoring of several peaks which should be emphasized rather than the detection of different ions, and in the case of the latter it is often not fragments that are being monitored but peaks from molecular ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selected ion monitoring" .

goldbook:S05548 a skos:Concept ;
    skos:definition "A laboratory method applying a mixture of microorganisms to particular growth conditions under which only the cells with particular characteristics can survive and may be isolated." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selection" .

goldbook:S05549 a skos:Concept ;
    skos:definition "A rule that states whether a given transition is allowed or forbidden, on the basis of the symmetry or spin of the wavefunctions of the initial and final states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selection rule" .

goldbook:S05550 a skos:Concept ;
    skos:definition "A term which expresses qualitatively the extent to which other substances interfere with the determination of a substance according to a given procedure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective" .

goldbook:S05551 a skos:Concept ;
    skos:definition "Corrosion of a single phase having more than one component, when the ratio of the corrosion rates of the components differs from the ratio of bulk mole fractions. Selective corrosion changes the composition of the material in the interfacial region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective corrosion" .

goldbook:S05556 a skos:Concept ;
    skos:definition "An isotopically labelled compound is designated as selectively labelled when a mixture of isotopically substituted compounds is formally added to the analogous isotopically unmodified compound in such a way that the position(s) but not necessarily the number of each labelling nuclide is defined. A selectively labelled compound may be considered as a mixture of specifically labelled compounds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectively labelled" .

goldbook:S05557 a skos:Concept ;
    skos:definition "A sample which results where a small portion has been separated from the lot or laboratory sample by selective means such as magnetic-, density-, or manual separation, by micro-drilling, or by centrifugation, e.g. the separation of magnetic materials from a geological material, or the separation of metal particles from a lubricating oil. If individual particles are analysed the term individual particle analysis is applied." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective micro-sample" .

goldbook:S05558 a skos:Concept ;
    skos:altLabel "selective inhibition" ;
    skos:definition "In selective poisoning or selective inhibition, a poison retards the rate of one catalysed reaction more than that of another or it may retard only one of the reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective poisoning" .

goldbook:S05559 a skos:Concept ;
    skos:definition "An operation (process) as a result of which microcomponents are selectively isolated from a sample. It is used when the simultaneous presence of several components in the concentrate may distort the results of analysis. Selective preconcentration usually is achieved by isolation of the microcomponent to be determined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective preconcentration" .

goldbook:S05560 a skos:Concept ;
    skos:definition "A sample that is deliberately chosen by using a sampling plan that screens out materials with certain characteristics and/or selects only material with other relevant characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selective sample" .

goldbook:S05563 a skos:Concept ;
    skos:definition "It sometimes refers to the discrimination shown by a given reactant A when it reacts with two alternative reactants B and C, or in two different ways (e.g. at two different sites) with a reactant B." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectivity" .

goldbook:S05564 a skos:Concept ;
    skos:definition "(qualitative): The extent to which other substances interfere with the determination of a substance according to a given procedure.(quantitative): A term used in conjunction with another substantive (e.g. constant, coefficient, index, factor, number) for the quantitative characterization of interferences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectivity" .

goldbook:S05566 a skos:Concept ;
    skos:altLabel "selectivity factor" ;
    skos:definition "The equilibrium coefficient obtained by application of the law of mass action to ion exchange and characterizing quantitatively the ability of an ion exchanger to select one of two ions present in the same solution. The ions involved in the exchange should be specified as subscripts.Examples:Exchange: $\\ce{Mg^{2+}}$ – $\\ce{Ca^{2+}}$ \\[k_{\\rm{Mg}/\\rm{Ca}}=\\frac{\\rm{[Mg]}_{\\rm{S}}/\\rm{[Ca]}_{\\rm{S}}}{\\rm{[Mg]}_{\\rm{M}}/\\rm{[Ca]}_{\\rm{M}}}\\] Exchange: $\\ce{SO4^{2−}}$ – $\\ce{Cl^{−}}$ \\[k_{\\rm{SO}_{4}/\\rm{Cl}} = \\frac{\\rm{[}\\rm{SO}_{4}\\rm{]}_{\\rm{S}}/\\rm{[Cl]}_{\\rm{S}}^{2}}{\\rm{[}\\rm{SO}_{4}\\rm{]}_{\\rm{M}}/\\rm{[Cl]}_{\\rm{M}}^{2}}\\] In the above equations subscript S refers to the ion exchanger ('stationary phase') and M to the external solution ('mobile phase'). For exchanges involving counter-ions differing in their charges, the numerical value of \\(k_{\\rm{A}/\\rm{B}}\\) depends on the choice of the concentration scales in the ion exchanger and the external solution (molal scale, molar scale, mole fraction scale, etc.). Concentration units must be clearly stated for an exchange of ions of differing charges. The corrected selectivity coefficient (\\(k_{\\rm{A}/\\rm{B}}^{a}\\)) is calculated in a way identical to the selectivity coefficient except that the concentrations in the external solutions are replaced by activities. This term should not be used as a synonym for separation factor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectivity coefficient" .

goldbook:S05567 a skos:Concept ;
    skos:definition "A quantitative representation of selectivity in aromatic substitution reactions (usually electrophilic, for monosubstituted benzene derivatives). If the partial rate factor, \\(f\\), expresses the reactivity of a specified position in the aromatic compound $\\ce{PhX}$ relative to that of a single position in benzene, then the selectivity factor \\(S_{f}\\) (expressing discrimination between p- and m-positions in $\\ce{PhX}$) is defined as: \\[S_{f}=\\log _{10}(\\frac{f_{p}^{\\rm{X}}}{f_{m}^{\\rm{X}}})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectivity factor" .

goldbook:S05569 a skos:Concept ;
    skos:definition "Synonymous with selectivity coefficient." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selectivity ratio" .

goldbook:S05570 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSeOH}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{ArSeOH}$, areneselenenic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenenic acids" .

goldbook:S05571 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSeR}$ ($\\ce{R}  eq \\ce{H}$). They are thus selenium analogues of ethers.Metal salts of selane, $\\ce{H2Se}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenides" .

goldbook:S05572 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSe(=O)OH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seleninic acids" .

goldbook:S05573 a skos:Concept ;
    skos:definition "Salts and esters of selenocyanic acid, $\\ce{HSeCN}$, e.g. $\\ce{CH3CH2SeCN}$ ethyl selenocyanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenocyanates" .

goldbook:S05574 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSeH}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenols" .

goldbook:S05575 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2Se(=O)2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenones" .

goldbook:S05576 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSe(=O)2OH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenonic acids" .

goldbook:S05577 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2Se=O}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selenoxides" .

goldbook:S05578 a skos:Concept ;
    skos:definition "Occurs in emission sources of finite thickness when radiant energy quanta emitted by atoms (or molecules) are absorbed by atoms of the same kind present in the same source. The absorbed energy is usually dissipated by collisional transfer of energy, or through emission of radiant energy of the same or other frequencies. In consequence, the observed radiant intensity of a spectral line (or band component) emitted by a source may be less than the radiant intensity would be from an optically thin source having the same number of emitting atoms. Self-absorption may occur in all emitting sources to some degree, whether they are homogeneous or not." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-absorption" .

goldbook:S05580 a skos:Concept ;
    skos:definition "The reabsorption of luminescence by the analyte and interfering impurities within the excitation volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-absorption effect" .

goldbook:S05581 a skos:Concept ;
    skos:altLabel "source efficiency" ;
    skos:definition "The ratio between the quantity of the radiation emitted by the source and the quantity of the radiation as produced by the radioactive nuclei present in the source. Synonymous with source efficiency." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-absorption factor" .

goldbook:S05582 a skos:Concept ;
    skos:definition "The diffusion coefficient \\(D_{i}^{*}\\) of species \\(i\\) in the absence of a chemical potential gradient. It is related to the diffusion coefficient \\(D_{i}\\) by \\[D_{i}^{*}=D_{i}\\ \\frac{\\partial (\\ln c_{i})}{\\partial \\ln a_{i}}\\] where \\(a_{i}\\) is the activity of \\(i\\) in the solution, and \\(c_{i}\\) is the concentration of \\(i\\). If an isotopically labelled species (\\(i^{*}\\)) is used to study diffusion, the tracer diffusion coefficient, \\(D_{i}^{*}\\), is practically identical to the self-diffusion coefficient provided that the isotope effect is sufficiently small." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-diffusion coefficient" .

goldbook:S05584 a skos:Concept ;
    skos:altLabel "autopoisoning" ;
    skos:definition "A product of a reaction may cause poisoning or inhibition. The phenomenon is called self-poisoning or autopoisoning." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-poisoning" .

goldbook:S05585 a skos:Concept ;
    skos:definition "Quenching of an excited atom or molecular entity by interaction with another atom or molecular entity of the same species in the ground state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-quenching" .

goldbook:S05587 a skos:Concept ;
    skos:definition "The lowering of the flux density in the inner part of an object due to absorption in its outer layers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-shielding" .

goldbook:S05588 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C=Se}$ ($\\ce{R}  eq \\ce{H}$). They are thus selenium analogues of ketones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "selones" .

goldbook:S05589 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C=NNHC(=O)NH2}$, formally derived by condensation of aldehydes or ketones with semicarbazide $\\ce{[NH2NHC(=O)NH2]}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semicarbazones" .

goldbook:S05590 a skos:Concept ;
    skos:definition "A carbonaceous material intermediate between a fusible mesophase pitch and a non-deformable green coke produced by incomplete carbonization at temperatures between the onset of fusion (of coal, ca. \\(620\\ \\rm{K}\\)), and complete devolatilization. Semicoke still contains volatile matter, therefore." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semicoke" .

goldbook:S05591 a skos:Concept ;
    skos:definition "Material whose conductivity, due to charges of both signs, is normally in the range between that of metals and insulators and in which the electric charge carrier density can be changed by external means." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semiconductor" .

goldbook:S05592 a skos:Concept ;
    skos:definition "A radiation detector using a semiconductor, in which free electric charges are produced along the path of an ionizing particle, in combination with a high voltage and electrodes to collect the induced electric charges." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semiconductor detector" .

goldbook:S05597 a skos:Concept ;
    skos:definition "Any transition from a semiconductor to a metallic state under the influence of a temperature or pressure change or both. Examples:$\\ce{Ti2O3}$: band-edge crossing in a semiconductor to semimetal transition.SmS: localized level crossing a band edge. In SmS hydrostatic pressure above the critical pressure \\(P_{\\rm{c}}\\approx 0.65\\ \\mathrm{GPa}\\) broadens the Sm-5d band to make the band edge cross the Sm-\\(4\\rm{f}^{6}\\) level.A localized-itinerant transition.A switching transition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semiconductor-metal transition" .

goldbook:S05598 a skos:Concept ;
    skos:altLabel "SIPN" ;
    skos:definition "Polymer comprising one or more polymer networks and one or more linear or branched polymers characterized by the penetration on a molecular scale of at least one of the networks by at least some of the linear or branched macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-interpenetrating polymer network" .

goldbook:S05599 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2C=NNHC(=O)C(=O)NH2}$, formally derived from the condensation of aldehydes or ketones with semioxamazide (the hydrazide of oxamic acid), $\\ce{H2NNHC(=O)C(=O)NH2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semioxamazones" .

goldbook:S05600 a skos:Concept ;
    skos:definition "Radical anions having the structure $\\ce{O^{−}–Z–O^{.}}$ where $\\ce{Z}$ is an ortho- or para-arylene group or analogous heteroarylene group; they are formally generated by the addition of an electron to a quinone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semiquinones" .

goldbook:S05601 a skos:Concept ;
    skos:altLabel "semitrivial name" ;
    skos:definition "A name in which at least one part is used in a systematic sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semisystematic name" .

goldbook:S05602 a skos:Concept ;
    skos:definition "Terms used in reference to priority in a prescribed hierarchical order, a senior feature being preferred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "seniority" .

goldbook:S05603 a skos:Concept ;
    skos:definition "That area of the detector where an incident radiant power results in a measurable output." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitive area" .

goldbook:S05604 a skos:Concept ;
    skos:definition "That volume of the detector where an incident radiant power produces a measurable output." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitive volume" .

goldbook:S05605 a skos:Concept ;
    skos:definition "Two different measures of sensitivity are recommended. The first, which is suitable for relatively involatile materials as well as gases, depends upon the observed change in ion current for a particular amount or change of flow rate of sample though the ion source. A second method of stating sensitivity, that is most suitable for gases, depends upon the change of ion current related to the change of partial pressure of the sample in the ion source. It is important that the relevant experimental conditions corresponding to sensitivity measurement should always be stated. These include in a typical case details of the instrument type, bombarding electron current, slit dimensions, angular collimation, gain of the multiplier detector, scan speed and whether the measured signal corresponds to a single mass peak or to the ion beam integrated over all masses. Some indication of the time involved in the determination should be given, e.g. counting time or band width. The sensitivity should be differentiated from the detection limit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitivity" .

goldbook:S05606 a skos:Concept ;
    skos:definition "The slope of the calibration curve. If the curve is in fact a 'curve', rather than a straight line, then of course sensitivity will be a function of analyte concentration or amount. If sensitivity is to be a unique performance characteristic, it must depend only on the chemical measurement process, not upon scale factors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitivity" .

goldbook:S05608 a skos:Concept ;
    skos:definition "Addition of small amounts of a hydrophilic colloid to a hydrophobic sol to possibly make the latter more sensitive to flocculation by electrolyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitization" .

goldbook:S05609 a skos:Concept ;
    skos:definition "The deactivation of the primarily excited emitter which can lead to the activation of the quencher followed by radiative deactivation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sensitized luminescence" .

goldbook:S05611 a skos:Concept ;
    skos:definition "This expression refers to the assumption, essential to conventional transition-state theory, that the energy of the system may be expressed as the sum of components associated with different degrees of freedom. In transition-state theory it is assumed that the energy of the motion of the system through the dividing surface of the potential-energy surface is separable into various components. In many practical calculations it is assumed that the energy of the system is separable into electronic, vibrational, rotational and translational energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "separability assumption" .

goldbook:S05614 a skos:Concept ;
    skos:altLabel "separation coefficient" ;
    skos:definition "The relative retention value calculated for two adjacent peaks (\\(V_{\\rm{R}2}^{'}>V_{\\rm{R}1}^{'}\\)): \\[\\alpha =\\frac{V_{\\rm{R}2}^{'}}{V_{\\rm{R}1}^{'}}=\\frac{V_{\\rm{N}2}}{V_{\\rm{N}1}}=\\frac{t_{\\rm{R}2}^{'}}{t_{\\rm{R}1}^{'}}=\\frac{k_{2}}{k_{1}}\\] By definition, the value of the separation factor is always greater than unity. The separation factor is also identical to the ratio of the corresponding distribution constants. The separation factor is sometimes also called the 'selectivity'. The use of this expression is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "separation factor" .

goldbook:S05615 a skos:Concept ;
    skos:definition "The ratio of the respective distribution ratios of two extractable solutes measured under the same conditions. \\[\\alpha_{\\rm{A,B}} = \\frac{D_{\\rm{A}}}{D_{\\rm{B}}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "separation factor" .

goldbook:S05616 a skos:Concept ;
    skos:definition "This expresses the number of peaks which can be resolved in a given part of the chromatogram between the peaks of two consecutive n-alkanes with \\(z\\) and (\\(z+1\\)) carbon atoms in their molecules: \\[\\rm{SN} = \\frac{t_{\\rm{R}\\left(z\\,+\\,1\\right)}- t_{\\rm{R}z}}{w_{\\rm{h}z}\\,+\\,w_{\\rm{h}\\left(z+1\\right)}} - 1\\] In the German literature the symbol \\(\\rm{TZ}\\) (trennzahl) is commonly used to express the separation number. As the separation number depends on the n-alkanes used for the calculation, they always must be specified with any given \\(\\rm{SN}\\) value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "separation number" .

goldbook:S05618 a skos:Concept ;
    skos:definition "The temperature of the chromatographic bed under isothermal operation. In column chromatography it is called the column temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "separation temperature" .

goldbook:S05620 a skos:Concept ;
    skos:definition "Analytical procedures for the determination of the order of amino acids in a polypeptide chain or of nucleotides in a DNA or RNA molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequencing" .

goldbook:S05621 a skos:Concept ;
    skos:definition "A discontinuous analyser in which at least one sub-assembly operates sequentially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential analyser" .

goldbook:S05622 a skos:Concept ;
    skos:definition "An indication obtained following sequential sampling or received from a sequential cell or from data processing comprising a succession of predetermined repetitive operations (or a combination of the three)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential indication" .

goldbook:S05623 a skos:Concept ;
    skos:definition "A measuring cell which operates according to a succession of operations on the sample or on the sensitive elements (or on both), these operations being carried out according to one or more repetitive programs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential measuring cell" .

goldbook:S05624 a skos:Concept ;
    skos:definition "Units, increments or samples taken one at a time or in successive predetermined groups, until the cumulative result of their measurements (typically applied to attributes), as assessed against predetermined limits, permits a decision to accept or reject the population or to continue sampling. The number of observations required is not determined in advance, but the decision to terminate the operation depends, at each stage, on the results of the previous observations. The plan may have a practical, automatic termination after a certain number of units have been examined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential sample" .

goldbook:S05625 a skos:Concept ;
    skos:definition "A spectrometer which enables the intensity of several spectral bands of radiation to be measured one after the other in time, i.e. sequentially." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential spectrometer" .

goldbook:S05626 a skos:Concept ;
    skos:definition "A number of measured values (\\(x_{1},\\,x_{2},\\,...\\ x_{i},\\,...\\ x_{n}\\)) equivalent to each other with respect to statistical considerations, e.g. the results of repeated analyses using only one analytical method on a substance that is presumed to be homogeneous." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "series" .

goldbook:S05627 a skos:Concept ;
    skos:definition "Terpenoids having a $\\ce{C15}$ skeleton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sesquiterpenoids" .

goldbook:S05628 a skos:Concept ;
    skos:definition "Terpenoids having a $\\ce{C25}$ skeleton. Sometimes erroneously referred to as sesterpenoids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sesterterpenoids" .

goldbook:S05629 a skos:Concept ;
    skos:definition "Chamber designed to reduce the velocity of gases in order to permit the settling out of fly ash. It may be either part of, adjacent to, or external to an incinerator." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "settling chamber" .

goldbook:S05630 a skos:Concept ;
    skos:definition "An error caused by allowing insufficient time for the reading to settle or if an absorption peak is scanned too rapidly." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "settling error" .

goldbook:S05631 a skos:Concept ;
    skos:definition "The terminal rate of fall of a particle through a fluid as induced by gravity or other external force." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "settling velocity" .

goldbook:S05632 a skos:Concept ;
    skos:definition "Possibly observed in catalysts with very small pores. The selectivity is largely determined by the bulk or size of one or more reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shape selectivity" .

goldbook:S05634 a skos:Concept ;
    skos:definition "For systems showing non-Newtonian behaviour when measured in steady simple shear, a coefficient \\(\\eta \\) equal to \\(\\frac{\\sigma}{D}\\) at a given value of the shear rate \\(D\\), where \\(\\sigma \\) is the stress; \\(\\eta _{0}\\) is the limiting viscosity at zero shear rate, and \\(\\eta _{\\infty }\\) the limiting viscosity at infinite shear rate; \\(\\rm{[}\\eta _{0}\\rm{]}\\) is the limit of intrinsic viscosity at zero shear." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shear dependent viscosity" .

goldbook:S05636 a skos:Concept ;
    skos:definition "The velocity gradient in a flowing fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shear rate" .

goldbook:S05640 a skos:Concept ;
    skos:definition "If viscosity is a univalued function of the rate of shear, a decrease of the viscosity with increasing rate of shear is called shear thinning, and an increase of the viscosity shear thickening." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shear thinning" .

goldbook:S05641 a skos:Concept ;
    skos:definition "A diffusionless transition that involves a change of the shape of the unit cell by a process that can be described as shear." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shear transition" .

goldbook:S05642 a skos:Concept ;
    skos:definition "For a Newtonian fluid, the shear viscosity is often termed simply viscosity since in most situations it is the only one considered. It relates the shear components of stress and those of rate of strain at a point in the fluid by: \\[\\sigma _{xy}=\\sigma _{yx}=\\eta \\ (\\frac{\\partial  u_{x}}{\\partial y}+\\frac{\\partial  u_{y}}{\\partial x})=2\\ \\eta \\ \\overset{\\rm{.}}{\\gamma }_{yx}\\] where \\(\\overset{\\rm{.}}{\\gamma }_{yx}\\), the shear component of rate of strain is defined as follows: \\[\\overset{\\rm{.}}{\\gamma }_{yx}=\\frac{1}{2}\\ (\\frac{\\partial  u_{x}}{\\partial y}+\\frac{\\partial  u_{y}}{\\partial x})\\] Corresponding relations hold for \\(\\sigma _{xz}\\) and \\(\\sigma _{yz}\\); \\(\\sigma _{xy}\\) is the component of stress acting in the \\(y\\)-direction on a plate normal to the \\(x\\)-axis; \\( u_{x}\\), \\( u_{y}\\), \\( u_{z}\\) are the components of velocity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shear viscosity" .

goldbook:S05644 a skos:Concept ;
    skos:definition "In the context of NMR spectroscopy shielding is the effect of the electron shells of the observed and the neighbouring nuclei on the external magnetic field. The external field induces circulations in the electron cloud. The resulting magnetic moment is oriented in the opposite direction to the external field, so that the local field at the central nucleus is weakened, although it may be strengthened at other nuclei (deshielding). The phenomenon is the origin of the structural dependence of the resonance frequencies of the nuclei." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shielding" .

goldbook:S05647 a skos:Concept ;
    skos:definition "A chain of low relative molecular mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "short chain" .

goldbook:S05650 a skos:Concept ;
    skos:definition "The condition of an instrument when it is switched off to conserve energy or reagents or to protect working parts. This term is of particular importance in clinical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shut-down state" .

goldbook:S05651 a skos:Concept ;
    skos:definition "The time interval between production of the last result of an instrument and shut-down state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shut-down time" .

goldbook:S05652 a skos:Concept ;
    skos:definition "A DNA molecule (e.g. plasmid) that is able to replicate in two different host organisms and can therefore be used to 'shuttle' or convey genes from one to the other." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shuttle vector" .

goldbook:S05657 a skos:Concept ;
    skos:definition "SI derived unit of electric conductance, \\(\\pu{S} = \\pu{\\Omega^{-1}} = \\pu{m-2 kg-1 s3 A2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "siemens" .

goldbook:S05658 a skos:Concept ;
    skos:definition "SI derived unit of dose equivalent (the mean specific energy imparted to an element of matter corrected by a quality factor and a modifying factor to take into account the properties of irradiated matter) equal to one joule per kilogram and admitted for reasons of safeguarding human health." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sievert" .

goldbook:S05660 a skos:Concept ;
    skos:definition "A molecular rearrangement that involves both the creation of a new $\\ce{\\upsigma\\!\\mbox{-}bond}$ between atoms previously not directly linked and the breaking of an existing $\\ce{\\upsigma\\!\\mbox{-}bond}$. There is normally a concurrent relocation of $\\ce{\\uppi\\!\\mbox{-}bonds}$ in the molecule concerned, but the total number of $\\ce{\\uppi\\!\\mbox{-}}$ and $\\ce{\\upsigma\\!\\mbox{-}bonds}$ does not change. The term was originally restricted to intramolecular pericyclic reactions, and many authors use it with this connotation. It is, however, also applied in a more general, purely structural, sense. If such reactions are intramolecular, their transition state may be visualized as an association of two fragments connected at their termini by two partial $\\ce{\\upsigma\\!\\mbox{-}bonds}$, one being broken and the other being formed as, for example, the two allyl fragments in ($\\ce{a'}$). Considering only atoms within the (real or hypothetical) cyclic array undergoing reorganization, if the numbers of these in the two fragments are designated \\(i\\) and \\(j\\), then the rearrangement is said to be a sigmatropic change of order [\\(i\\), \\(j\\)] (conventionally \\(\\rm{[}i\\rm{]}\\leq \\rm{[}j\\rm{]}\\)). Thus the rearrangement (a) is of order, whilst reaction (b) is asigmatropic shift of hydrogen. (N.B. By convention square brackets here refer to numbers of atoms, in contrast with current usage in the context of cycloaddition.)   The descriptors a and s (antarafacial and antarafacial) may also be annexed to the numbers \\(i\\) and \\(j\\); (b) is then described as a [1s,5s] sigmatropic rearrangement, since it is suprafacial with respect both to the hydrogen atom and to the pentadienyl system:  The prefix 'homo' (meaning one extra atom, interrupting conjugation — cf. 'homoaromaticity') has frequently been applied to sigmatropic rearrangements, but is misleading." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sigmatropic rearrangement" .

goldbook:S05661 a skos:Concept ;
    skos:definition "A representation of a quantity within an analytical instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "signal" .

goldbook:S05663 a skos:Concept ;
    skos:definition "Saturated silicon hydrides, analogues of the alkanes; i.e. compounds of the general formula $\\ce{SinH2_{n+2}}$. Silanes may be subdivided into silane, oligosilanes and polysilanes. Note hydrocarbyl derivatives and other derivatives are often referred to loosely as silanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silanes" .

goldbook:S05664 a skos:Concept ;
    skos:definition "In a strict sense, hydroxy derivatives of silanes $\\ce{Si_{n}H_{2n+1}OH}$.A name commonly applied to Si-hydrocarbyl derivatives, $\\ce{R3SiOH}$, of silanol, $\\ce{H3SiOH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silanols" .

goldbook:S05665 a skos:Concept ;
    skos:definition "Compounds in which every silicon atom is linked to three nitrogen atoms and every nitrogen atom is linked to two silicon atoms, thus consisting of $\\ce{SiH}$ and $\\ce{NH}$ units, and having the general formula $\\ce{(SiH)_{2n}(NH)_{3n}}$. By extension hydrocarbyl derivatives are commonly included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silasesquiazanes" .

goldbook:S05666 a skos:Concept ;
    skos:definition "Compounds in which every silicon atom is linked to three oxygen atoms and every oxygen atom is linked to two silicon atoms, and having the general formula $\\ce{(SiH)_{2n}O_{3n}}$. By extension hydrocarbyl derivatives are commonly included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silasesquioxanes" .

goldbook:S05667 a skos:Concept ;
    skos:definition "Compounds in which every silicon atom is linked to three sulfur atoms and every sulfur atom is linked to two silicon atoms, and having the general formula $\\ce{(SiH)_{2n}S_{3n}}$. By extension hydrocarbyl derivatives are commonly included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silasesquithianes" .

goldbook:S05668 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{H3Si[SSiH2]_{n}SSiH3}$ and branched-chain analogues. They are analogous in structure to siloxanes with $\\ce{–S\\bond{–}}$ replacing $\\ce{–O\\bond{–}}$. By extension hydrocarbyl derivatives are commonly included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silathianes" .

goldbook:S05669 a skos:Concept ;
    skos:definition "Saturated silicon-nitrogen hydrides, having straight or branched chains. They are analogous in structure to siloxanes with $\\ce{–NH\\bond{–}}$ replacing $\\ce{–O\\bond{–}}$, e.g. $\\ce{H3SiNHSiH2NHSiH3}$ trisilazane. By extension hydrocarbyl derivatives are commonly included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silazanes" .

goldbook:S05670 a skos:Concept ;
    skos:definition "Polymeric or oligomeric siloxanes, usually considered unbranched, of general formula $\\ce{[–OSiR2–]_{n}}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silicones" .

goldbook:S05671 a skos:Concept ;
    skos:definition "Saturated silicon-oxygen hydrides with unbranched or branched chains of alternating silicon and oxygen atoms (each silicon atom is separated from its nearest silicon neighbours by single oxygen atoms). The general structure of unbranched siloxanes is $\\ce{H3Si[OSiH2]_{n}OSiH3}$. $\\ce{H3Si[OSiH2]_{n}OSiH[OSiH2OSiH3]2}$ is an example of a branched siloxane. By extension hydrocarbyl derivatives are commonly included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "siloxanes" .

goldbook:S05672 a skos:Concept ;
    skos:definition "When viewed in reflected white light against a black background, transparent films show the classical interference colours of thin plates which permit an estimate of their thickness to be made. When of the order of \\(100\\ \\rm{nm}\\) (\\(1000\\ \\unicode{x212B}\\)) in thickness they appear white (silver film) and when thinner they appear gradually less intensely white, then grey and finally black." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silver film" .

goldbook:S05673 a skos:Concept ;
    skos:definition "Generic name for $\\ce{H2Si{:}}$ and substitution derivatives thereof, containing an electrically neutral bivalent silicon atom with two non-bonding electrons. (The definition is analogous to that given for carbene.)The silanediyl group ($\\ce{H2Si}$), analogous to the methylene group ($\\ce{H2C}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silylene" .

goldbook:S05674 a skos:Concept ;
    skos:definition "In a strict sense, the silyl group is $\\ce{H3Si\\bond{–}}$.A name commonly applied to hydrocarbyl derivatives of the silyl group $\\ce{R3Si\\bond{–}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silyl groups" .

goldbook:S05675 a skos:Concept ;
    skos:definition "In a strict sense, the silyl radical is $\\ce{H3Si^{.}}$.A name commonly applied to the silicon-centered radicals $\\ce{R3Si^{.}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "silyl radicals" .

goldbook:S05676 a skos:Concept ;
    skos:definition "An idealized treatment of a fluid between two large parallel plates (to permit ignoring edge effects) of area \\(A\\), separated by a distance \\(h\\). If one plate moves relative to the other with a constant velocity \\(V\\), requiring a force \\(F\\) acting in the direction of movement, and the density, pressure, and viscosity throughout the fluid are constant, the Newtonian equation can be coupled with the equations of motion and of continuity to show that the velocity gradient in the fluid is constant (= \\(\\frac{V}{h}\\)), and that \\(\\frac{F}{A} = \\frac{\\eta \\ V}{h}\\). This idealized case (simple shear) is sometimes used to define shear viscosity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simple shear" .

goldbook:S05679 a skos:Concept ;
    skos:definition "Simultaneous electronic transitions in two coupled absorbers or emitters. Because of the coupling, transitions which are spin-forbidden in one of the centres might become spin-allowed (spin flip)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous pair transitions" .

goldbook:S05680 a skos:Concept ;
    skos:definition "Composite reactions, in which processes like \\[\\rm{A}\\ \\overset{1}{\\rightarrow }\\ \\rm{Y}\\] and \\[\\rm{B}\\ \\overset{2}{\\rightarrow }\\ \\rm{Z}\\] occur in parallel, can be called simultaneous or parallel reactions. Sometimes there is competition involved, like in the scheme: \\[\\rm{A}\\,+\\,\\rm{B}\\ \\overset{1}{\\rightarrow }\\ \\rm{Y}\\] and \\[\\rm{A}\\,+\\,\\rm{C}\\ \\overset{2}{\\rightarrow }\\ \\rm{Z}\\] where B and C compete with one another for A." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous reactions" .

goldbook:S05681 a skos:Concept ;
    skos:definition "A spectrometer which has more than one detector and enables the intensities of several spectral bands to be measured at the same time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous spectrometer" .

goldbook:S05682 a skos:Concept ;
    skos:altLabel "single-beam luminescence spectrometer" ;
    skos:definition "A luminescence spectrometer in which a single beam of radiation is used for excitation and a single beam of luminescence radiation is taken from the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-beam spectrometer" .

goldbook:S05683 a skos:Concept ;
    skos:altLabel "SCP" ;
    skos:definition "Microbial biomass or proteins extracted therefrom obtained from processes in which bacteria, yeasts, other fungi or algae are cultivated in large quantities as human or animal protein supplement in animal feed or in human nutrition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single cell protein" .

goldbook:S05685 a skos:Concept ;
    skos:altLabel "SET" ;
    skos:definition "A reaction mechanism characterized by the transfer of a single electron between the species occurring on the reaction coordinate of one of the elementary steps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-electron transfer mechanism" .

goldbook:S05686 a skos:Concept ;
    skos:definition "In a $\\upgamma\\!\\mbox{-}\\rm{ray\\ spectrum}$, the peak due to pair production in the detector and escape, from the sensitive part of the detector, of one of the photons of \\(511\\ \\rm{keV}\\) resulting from annihilation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single escape peak" .

goldbook:S05687 a skos:Concept ;
    skos:definition "An instrument in which an ion beam with a given value of mass/charge is brought to a focus although the initial directions of the ions diverge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-focusing mass spectrometer" .

goldbook:S05689 a skos:Concept ;
    skos:definition "Technique that permits recovery of the parameters characterizing a fluorescence decay after pulse excitation (in particular excited-states lifetimes). It is based on the creation of a time histogram of many stochastic events involving the time delay between the electronic excitation of a molecule or material and its emission of a photon from an excited state. A key to the technique is that no more than one photon strike the detector per pulsed excitation. Excitation is commonly achieved with a flash from a repetitive nanosecond lamp or diode laser or a CW operated laser (mode-locked laser). The essential components of the hardware are a device to measure the excitation-emission delay time and another to determine the relative frequency of photons reaching the detector at each delay time. Delay times are usually measured with a time-to-amplitude-converter (TAC), using voltage to measure the delay between a start and a stop signal. The frequency of events with each delay is stored in a multi-channel analyser. This term is preferred to time-correlated single-photon counting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-photon timing" .

goldbook:S05690 a skos:Concept ;
    skos:definition "Radiation scattering in which there is only one scattering encounter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single scattering" .

goldbook:S05691 a skos:Concept ;
    skos:definition "A reaction that proceeds through a single transition state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-step reaction" .

goldbook:S05692 a skos:Concept ;
    skos:definition "A chain that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through two atoms, one on each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-strand chain" .

goldbook:S05693 a skos:Concept ;
    skos:definition "A macromolecule that comprises constitutional unit connected in such a way that adjacent constitutional units are joined to each other through two atoms, one on each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-strand macromolecule" .

goldbook:S05694 a skos:Concept ;
    skos:definition "A polymer the macromolecules of which are single-strand macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "single-strand polymer" .

goldbook:S05695 a skos:Concept ;
    skos:altLabel "singlet molecular dioxygen" ;
    skos:definition "Oxygen molecule (dioxygen), $\\ce{O2}$, in an excited singlet state. The ground state of $\\ce{O2}$ is a triplet (\\(^{3}\\Sigma_{\\rm{g}}^{-}\\)). The two metastable singlet states derived from the ground-state configuration are \\(^{1}\\Delta_{\\rm{g}}\\) and \\(^{1}\\Sigma_{\\rm{g}}^{+}\\) (the latter with the higher energy)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet molecular oxygen" .

goldbook:S05696 a skos:Concept ;
    skos:definition "Absorption which results in the transition from the singlet ground state of the molecule into singlet excited states (\\(\\rm{S}_{0}\\) → \\(\\rm{S}_{\\rm{n}}\\)) and leads to the UV/visible absorption spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet-singlet absorption" .

goldbook:S05698 a skos:Concept ;
    skos:definition "Transfer of excitation from an electronically excited donor in a singlet state to produce an electronically excited acceptor in a singlet state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet-singlet energy transfer" .

goldbook:S05699 a skos:Concept ;
    skos:definition "A state having a total electron spin quantum number equal to 0." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet state" .

goldbook:S05700 a skos:Concept ;
    skos:definition "Absorption which takes place with the transition from the singlet ground state of the molecule to triplet states (\\(\\rm{S}_{0}\\) → \\(\\rm{T}_{\\rm{n}}\\)) and results in the singlet-triplet absorption spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet-triplet absorption" .

goldbook:S05701 a skos:Concept ;
    skos:definition "Transfer of excitation from an electronically excited donor in a singlet state to produce an electronically excited acceptor in a triplet state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet-triplet energy transfer" .

goldbook:S05702 a skos:Concept ;
    skos:definition "A specifically labelled compound in which the isotopically substituted molecule has only one isotopically modified atom e.g. $\\ce{CH3–CH[^{2}H]–OH}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singly labelled" .

goldbook:S05703 a skos:Concept ;
    skos:definition "The receptor for material which is removed from the atmosphere. Because of long range transport of many pollutants such as $\\ce{SO2}$, sulfuric acid and its salts, the sink region can be many hundreds of kilometres from the source region of the pollutants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sink" .

goldbook:S05704 a skos:Concept ;
    skos:definition "Temperature-induced coalescence and densification of porous solid particles below the melting points of their major components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sintering" .

goldbook:S05706 a skos:Concept ;
    skos:definition "An atom of a skeletal structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skeletal atom" .

goldbook:S05707 a skos:Concept ;
    skos:definition "A bond connecting two skeletal atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skeletal bond" .

goldbook:S05708 a skos:Concept ;
    skos:definition "The sequence of atoms in the constitutional unit(s) of a macromolecule, an oligomer molecule, a block or a chain which defines the essential topological representation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "skeletal structure" .

goldbook:S05710 a skos:Concept ;
    skos:definition "An approximate atomic orbital attempts to allow for electron-electron repulsion by scaling the nuclear charge for each orbital." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Slater-type orbital" .

goldbook:S05712 a skos:Concept ;
    skos:definition "Neutrons of kinetic energy less than some specified value. This value may vary over a wide range and depends on the application. In reactor physics, the value is frequently chosen to be \\(1\\ \\rm{eV}\\); in dosimetry, the effective cadmium cut-off is used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slow neutrons" .

goldbook:S05715 a skos:Concept ;
    skos:definition "Interference by a substance that produces a signal by a similar mechanism to the analyte, which in the given procedure (including the apparatus used) can not be distinguished from the signal given by the analyte. For example, in a colour reaction with an organic ligand by also reacting with the ligand and producing a coloured compound absorbing at the same wavelength as the compound produced by the analyte or in an atomic spectrochemical analysis by absorbing or emitting at the same wavelength as the analyte." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "SM-interference" .

goldbook:S05716 a skos:Concept ;
    skos:definition "The term originated in Great Britain as a popular derivation of 'smoke-fog' and appears to have been in common use before World War 1. It originally referred to the heavy pollution derived largely from coal burning (largely smoke filled air, rich in sulfur dioxide), and it probably was largely a reducing atmosphere. More common today in cities is an oxidizing atmosphere which contains ozone and other oxidants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smog" .

goldbook:S05717 a skos:Concept ;
    skos:definition "A large confined volume in which sunlight or simulated sunlight is allowed to irradiate air mixtures of atmospheric trace gases (hydrocarbons, nitrogen oxides, sulfur dioxide, etc.) which undergo oxidation. In theory these chambers allow the controlled study of complex reactions which occur in the atmosphere. However, ill-defined wall reactions which generate some molecular and radical species (e.g. $\\ce{HONO}$, $\\ce{CH2O}$, $\\ce{HO}$-radicals, etc.) and remove certain products ($\\ce{H2O2}$, $\\ce{HNO3}$, etc.), the use of reactant concentrations well above those in the atmosphere, ill-defined light intensities and wavelength distribution within the chamber, and other factors peculiar to chamber experiments require that caution be exercised in the extrapolation of results obtained from them to atmospheric systems." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smog chamber" .

goldbook:S05718 a skos:Concept ;
    skos:definition "A mathematical correlation between smog and meteorological and/or pollutant concentrations associated with it. These are qualitative indices which are sometimes used in some urban communities to predict the degree of the air pollution which is expected for the coming day." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smog index" .

goldbook:S05719 a skos:Concept ;
    skos:definition "An aerosol originating from combustion, thermal decomposition or thermal evaporation. Its particles may be solid (magnesium oxide smoke) or liquid (tobacco smoke)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "smoke" .

goldbook:S05721 a skos:Concept ;
    skos:definition "A salt of a fatty acid, saturated or unsaturated, containing at least eight carbon atoms or a mixture of such salts. A neat soap is a lamellar structure containing much (e.g. $\\pu{75\\%}$) soap and little (e.g. $\\pu{25\\%}$) water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soap" .

goldbook:S05722 a skos:Concept ;
    skos:definition "A gel-like mixture of fibrous soap-crystals ('curd-fibres') and their saturated solution (not a mesomorphic phase)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soap curd" .

goldbook:S05723 a skos:Concept ;
    skos:definition "A term established by usage for A/W/A films stabilized by surfactants although it is not a film of soap, nor is the stabilizing surfactant necessarily a soap. (A/W/A means water film in air)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soap film" .

goldbook:S05726 a skos:Concept ;
    skos:definition "Visible damage to materials by deposition of air pollutants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soiling" .

goldbook:S05727 a skos:Concept ;
    skos:definition "A fluid colloidal system of two or more components, e.g. a protein sol, a gold sol, an emulsion, a surfactant solution above the critical micelle concentration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol" .

goldbook:S05728 a skos:Concept ;
    skos:definition "The ratio of the Gibbs energy gain per unit time per \\(\\mathrm{m}^{2}\\) of surface exposed to the sun and the solar irradiance, \\(E\\), integrated between \\(\\lambda = 0\\) and \\(\\lambda = \\infty \\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solar conversion efficiency" .

goldbook:S05729 a skos:Concept ;
    skos:definition "A bright eruption of energy from the sun's chromosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solar flare" .

goldbook:S05730 a skos:Concept ;
    skos:definition "The electromagnetic radiation emitted by the sun. The total range of wavelengths of light emitted by the sun (99.9% in the range from \\(150\\ \\rm{to}\\ 4000\\ \\rm{nm}\\)) is filtered on entering the earth's atmosphere, largely through the absorption by oxygen, ozone, water vapour and carbon dioxide. Near sea level only light of wavelengths longer than about \\(290\\ \\rm{nm}\\) is present. The light from \\(290{-}400\\ \\rm{nm}\\) is effective in inducing important photochemical processes since absorption by the important trace gases, ozone, nitrogen dioxide, aldehydes, ketones, etc., is significant in this region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solar radiation" .

goldbook:S05731 a skos:Concept ;
    skos:definition "Transition of a sol to a gel at the gel point." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel transition" .

goldbook:S05732 a skos:Concept ;
    skos:definition "Of a cone, the ratio of the area cut out on a spherical surface (with its centre at the apex of that cone) to the square of the radius of the sphere. It is a quantity of dimension one (dimensionless quantity) with unit steradian (\\(\\mathrm{sr}=1\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid angle" .

goldbook:S05733 a skos:Concept ;
    skos:definition "The transition of a liquid or gas into a solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solidification" .

goldbook:S05734 a skos:Concept ;
    skos:definition "A kind of radioimmunoassay employing an antibody bound to a solid phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid phase antibody radioimmunoassay" .

goldbook:S05736 a skos:Concept ;
    skos:definition "CW or pulsed lasers in which the active medium is a solid matrix (crystal or glass) doped with an ion (e.g. $\\ce{Nd^{3+}}$, $\\ce{Cr^{3+}}$, $\\ce{Eu^{3+}}$). The emitted wavelength depends on the active ion, the selected optical transition, and the matrix. Some of these lasers are tunable within a very broad range (e.g. from \\(700\\) to \\(1000\\ \\rm{nm}\\) for $\\ce{Ti^{3+}}$ doped sapphire). Pulsed lasers may be free-running, Q-switched, or mode-locked. Some CW lasers may be mode-locked." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid state lasers" .

goldbook:S05737 a skos:Concept ;
    skos:definition "Normally an inert porous solid, which sorbs the liquid phase. The particle-size range of the support affects column efficiency and the pressure differential necessary to achieve a given flow rate. Modifications have been introduced for the achievement of special separations, in which the solid support is not inert but is an active solid. In capillary columns the inner wall of the column serves as the solid support and obviates the use of additional porous solids for this purpose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid support" .

goldbook:S05738 a skos:Concept ;
    skos:definition "A line on a binary phase diagram (or a surface on a ternary phase diagram) that indicates the temperature at which a system becomes completely solid on cooling or at which melting begins on heating under equilibrium conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solidus" .

goldbook:S05746 a skos:Concept ;
    skos:definition "A liquid or solid phase containing more than one substance, when for convenience one (or more) substance, which is called the solvent, is treated differently from the other substances, which are called solutes. When, as is often but not necessarily the case, the sum of the mole fractions of solutes is small compared with unity, the solution is called a dilute solution. A superscript attached to the \\(\\infty \\) symbol for a property of a solution denotes the property in the limit of infinite dilution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solution" .

goldbook:S05747 a skos:Concept ;
    skos:definition "Any stabilizing interaction of a solute (or solute moiety) and the solvent or a similar interaction of solvent with groups of an insoluble material (i.e. the ionic groups of an ion-exchange resin). Such interactions generally involve electrostatic forces and van der Waals forces, as well as chemically more specific effects such as hydrogen bond formation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvation" .

goldbook:S05748 a skos:Concept ;
    skos:definition "A linear free-energy relationship based on solvatochromism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvatochromic relationship" .

goldbook:S05749 a skos:Concept ;
    skos:definition "The (pronounced) change in position and sometimes intensity of an electronic absorption or emission band, accompanying a change in the polarity of the medium. Negative (positive) solvatochromism corresponds to a hypsochromic (bathochromic) shift with increasing solvent polarity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvatochromism" .

goldbook:S05751 a skos:Concept ;
    skos:definition "The term applied to the whole initial liquid phase containing the extractant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent" .

goldbook:S05752 a skos:Concept ;
    skos:definition "The process of transferring a substance from any matrix to an appropriate liquid phase. If the substance is initially present as a solute in an immiscible liquid phase the process is synonymous with liquid-liquid extraction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent extraction" .

goldbook:S05755 a skos:Concept ;
    skos:definition "A kinetic or equilibrium isotope effect resulting from change in the isotopic composition of the solvent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent isotope effect" .

goldbook:S05757 a skos:Concept ;
    skos:definition "Quantitative measures of the capability of solvents for interaction with solutes. Such parameters have been based on numerous different physicochemical quantities, e.g. rate constants, solvatochromic shifts in ultraviolet/visible spectra, solvent-induced shifts in infrared frequencies, etc. Some solvent parameters are purely empirical in nature, i.e. they are based directly on some experimental measurement. It may be possible to interpret such a parameter as measuring some particular aspect of solvent–solute interaction or it may be regarded simply as a measure of solvent polarity. Other solvent parameters are based on analysing experimental results. Such a parameter is considered to quantify some particular aspect of solvent capability for interaction with solutes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent parameter" .

goldbook:S05758 a skos:Concept ;
    skos:definition "Treatment of the solvent for re-cycling, e.g. by removal of degradation products or non-strippable solutes. The term solvent purification is synonymous, but the terms scrubbing, stripping and washing should not be used in this context." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent regeneration" .

goldbook:S05761 a skos:Concept ;
    skos:definition "A shift in the frequency of a spectral band of a chemical species arising from interaction with its solvent environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent shift" .

goldbook:S05762 a skos:Concept ;
    skos:definition "Generally, reaction with a solvent, or with a lyonium ion or lyate ion involving the rupture of one or more bonds in the reacting solute. More specifically the term is used for substitution elimination and fragmentation reactions in which a solvent species is the nucleophile ('alcoholysis' if the solvent is an alcohol, etc.)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvolysis" .

goldbook:S05763 a skos:Concept ;
    skos:definition "A solvent parameter defined by: \\[Sp = 1 - \\frac{M}{M\\left(\\rm{hexadecane}\\right)}\\] derived from the Gibbs energy of transfer (\\(\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}}\\)) of a series of solutes from water to numerous aqueous-organic mixtures and to pure solvents: \\[\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}}\\left(\\rm{to solvent}\\right) = M\\ R_{\\rm{T}}+D\\] where \\(R_{\\rm{T}}\\) is a solute parameter, and \\(M\\) and \\(D\\) characterize the solvent. The \\(M\\) values are used to define a solvent solvophobic effect so that \\(Sp\\) values are scaled from unity (water) to zero (hexadecane)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvophobicity parameter" .

goldbook:S05764 a skos:Concept ;
    skos:definition "A line on a binary phase diagram (or a surface on a ternary phase diagram) that defines the limit of solid solubility under equilibrium conditions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvus" .

goldbook:S05765 a skos:Concept ;
    skos:altLabel "SOMO" ;
    skos:definition "A Singly Occupied Molecular Orbital (such as the half-filled HOMO of a radical)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "SOMO" .

goldbook:S05766 a skos:Concept ;
    skos:definition "Irradiation with (often ultra)sound waves, e.g. to increase the rate of a reaction or to prepare vesicles in mixtures of surfactants and water." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonication" .

goldbook:S05767 a skos:Concept ;
    skos:definition "Luminescence induced by sound waves." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonoluminescence" .

goldbook:S05768 a skos:Concept ;
    skos:definition "A randomly formed particulate carbon material and may be coarse, fine and/or colloidal in proportions depending on its origin. Soot consists of variable quantities of carbonaceous and inorganic solids together with absorbed and occluded tars and resins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soot" .

goldbook:S05769 a skos:Concept ;
    skos:definition "The process by which a substance (sorbate) is sorbed (adsorbed or absorbed) on or in another substance (sorbent)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorption" .

goldbook:S05770 a skos:Concept ;
    skos:definition "The concentration of a sorbed species in the ion exchanger, expressed as a function of its concentration in the external solution under specified conditions and at constant temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorption isotherm" .

goldbook:S05771 a skos:Concept ;
    skos:definition "Techniques based on the distribution of components being separated between two phases, one of which is stationary and the other mobile. The advantage of some chromatographic methods is the possibility of combining the preconcentration and determination steps, as well as improving the speed of determination, and the possibility of separation of components with similar properties, and of achieving high values of the preconcentration coefficient. The methods enable analyses of microamounts of substances. ion-exchange chromatography is not widely used owing to the great volumes of solutions being treated and, consequently, to a great degree to the variation in the blank, and to some diffusional limitations. Static ion-exchange, which is much simpler and more readily carried out, is practised quite widely." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorption techniques" .

goldbook:S05772 a skos:Concept ;
    skos:definition "This is analogous to the process of ligand insertion in coordination chemistry. $$\\ce{H^{\\ast} + C2H4(g) -> ^{\\ast}C2H5}$$ This reaction might also be imagined to proceed by adsorption of $\\ce{C2H4}$ followed by ligand migration (an associative surface reaction)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sorptive insertion" .

goldbook:S05776 a skos:Concept ;
    skos:definition "At the surface region of a semiconductor the surface excess or deficiency of electrons constitutes a space charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "space charge" .

goldbook:S05777 a skos:Concept ;
    skos:definition "Synonymous with stereochemical formula." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "space formula" .

goldbook:S05778 a skos:Concept ;
    skos:definition "The reciprocal of space velocity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "space time" .

goldbook:S05779 a skos:Concept ;
    skos:definition "Defined as \\(v_{m}\\), \\(v_{v}\\), and \\(v_{a}\\) where the \\(v_{i}\\)s represent the rate of feed of the given reactant fed per unit mass, volume or surface area of the catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "space velocity" .

goldbook:S05780 a skos:Concept ;
    skos:altLabel "spark source ionization" ;
    skos:definition "Occurs when a solid sample is vaporized and partially ionized by an intermittent discharge. It is recommended that the word 'source' be dropped from this term." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spark ionization" .

goldbook:S05782 a skos:Concept ;
    skos:definition "A detector for the measurement of the spatial distribution of the radiation. Spatially resolving detectors can be divided into two groups:   the photosensitive area consists of a matrix of discrete photosensitive elements, the pixels (picture elements) forming an array with the facility to separately read out the information, simultaneously or sequentially.   the photosensitive area consists of a single photosensitive element that must be scanned (e.g. image dissection tube.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spatially resolving detector" .

goldbook:S05783 a skos:Concept ;
    skos:definition "The initial steep rate increase observed in the kinetic electrolyte effect on certain solvolysis reactions, upon addition of some non-common ion salts, especially $\\ce{LiClO4}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "special salt effect" .

goldbook:S05786 a skos:Concept ;
    skos:definition "A taxonomic subdivision of a genus; a group of closely related, morphologically and physiologically similar individuals." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "species" .

goldbook:S05788 a skos:Concept ;
    skos:definition "A term which expresses qualitatively the extent to which other substances interfere with the determination of a substance according to a given procedure. Specific is considered to be the ultimate of selective, meaning that no interferences are supposed to occur." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific" .

goldbook:S05789 a skos:Concept ;
    skos:definition "Catalysis by acids or bases in solution is said to be specific when the only observable catalytic effects are those due to the ions formed from the solvent itself (e.g. if when water is the solvent the only observable catalysis is that due to the $\\ce{H^{+}}$ and $\\ce{OH^{−}}$ ions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific acid–base catalysis" .

goldbook:S05790 a skos:Concept ;
    skos:definition "For a specified isotopes, or mixture of isotopes, the activity of a material divided by the mass of the material." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific activity" .

goldbook:S05791 a skos:Concept ;
    skos:definition "Ions become specifically adsorbed when short-range interactions between them and the interphase become important. They are believed then to penetrate into the inner layer and may (but not necessarily) come into contact with the surface. They are usually assumed to form a partial or complete monolayer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific adsorption" .

goldbook:S05792 a skos:Concept ;
    skos:definition "Ions which possess a chemical affinity for the surface in addition to the Coulomb interaction, where chemical is a collective adjective, embracing all interactions other than purely Coulombic. Examples are van der Waals or hydrophobic bonding, pi-electron exchange and complex formation. Specifically adsorbing ions can adsorb on an initially uncharged surface and hence provide it with a charge. The term specifically adsorbed applies to the sorption of all other ions having an affinity to the surface in addition to the purely Coulombic contribution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specifically absorbing ion" .

goldbook:S05793 a skos:Concept ;
    skos:definition "An isotopically labelled compound is designated as specifically labelled when a unique isotopically substituted compound is formally added to the analogous isotopically unmodified compound. In such a case, both position(s) and number of each labelling nuclide are defined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specifically labelled" .

goldbook:S05794 a skos:Concept ;
    skos:definition "A tracer in which the label is present in a specified position." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specifically labelled tracer" .

goldbook:S05795 a skos:Concept ;
    skos:definition "The total energy released through induced nuclear transformations divided by the mass of a nuclear fuel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific burn-up" .

goldbook:S05796 a skos:Concept ;
    skos:definition "The acceleration of a reaction by a unique catalyst, rather than by a family of related substances. The term is most commonly used in connection with specific hydrogen-ion or hydroxide-ion (lyonium ion or lyate ion) catalysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific catalysis" .

goldbook:S05798 a skos:Concept ;
    skos:definition "A detector which responds to a single sample component or to a limited number of components having similar chemical characteristics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific detector" .

goldbook:S05800 a skos:Concept ;
    skos:definition "Heat capacity divided by mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific heat capacity" .

goldbook:S05801 a skos:Concept ;
    skos:definition "The number of ion pairs formed per unit distance along the track of an ionizing particle passing through matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific ionization" .

goldbook:S05802 a skos:Concept ;
    skos:definition "A term expressing the resistance of an empty tube or packed column to the flow of a fluid (the mobile phase)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific permeability" .

goldbook:S05804 a skos:Concept ;
    skos:definition "The total internal void volume per unit mass of adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific pore volume" .

goldbook:S05806 a skos:Concept ;
    skos:definition "When the area of the interface between two phases is proportional to the mass of one of the phases (e.g. for a solid adsorbent, for an emulsion or for an aerosol), the specific surface area (\\(a\\),\\(s\\) or preferably \\(a_{s}\\)) is defined as the surface area divided by the mass of the relevant phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific surface area" .

goldbook:S05807 a skos:Concept ;
    skos:definition "Volume of a substance divided by its mass. It is the reciprocal of mass density." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specific volume" .

goldbook:S05809 a skos:Concept ;
    skos:definition "A specifically selected portion of a material taken from a dynamic system and assumed to be representative of the parent material at the time it is taken. Although the specimen may not be reproducible in time, e.g. it may be taken from a flowing stream or a portion of blood, no separable sampling error exists since this error is unavoidably included with the corresponding error of the estimate of the property, function or analyte being studied. A specimen may be considered as a special type of sample, taken primarily in time rather than in space. The term 'specimen' has been used both as a representative unit and as a nonrepresentative (often better than most) unit of a population, usually in clinical, biological and mineralogical collections. 'Collections' in this case is used as either a noun or verb. This usage is almost always self-evident, and thus would not be confused with a time-type sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specimen" .

goldbook:S05810 a skos:Concept ;
    skos:definition "A pre-association mechanism in which one of the molecular entities, C, is already present in an encounter pair with A during formation of B from A, but does not assist the formation of B, e.g.  The formation of B from A may itself be a bimolecular reaction with some other reagent. Since C does not assist the formation of A, it is described as being present as a spectator, and hence such a mechanism is sometimes referred to as a spectator mechanism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectator mechanism" .

goldbook:S05811 a skos:Concept ;
    skos:definition "An extreme type of stripping reaction in which one reaction product has almost the same direction and momentum as one of the reactant molecules had before the reactive collision occurred." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectator-stripping reaction" .

goldbook:S05812 a skos:Concept ;
    skos:definition "To measure the true shape, particularly the true maximum of an absorption band, the spectral bandwidth \\(\\Delta \\lambda \\) of the instrument must be much less than the width of the absorption band. A spectral bandwidth error results from using too large a bandwidth relative to the absorption band being measured." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral bandwidth error" .

goldbook:S05813 a skos:Concept ;
    skos:definition "The variation of the spectral radiance with wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral distribution" .

goldbook:S05814 a skos:Concept ;
    skos:altLabel "effectiveness",
        "spectral photon effectiveness" ;
    skos:definition "The reciprocal of the photon fluence rate, \\(E_{\\rm{p}}^{0}\\), at wavelength \\(\\lambda \\), causing identical photoresponse, \\(\\Delta \\rm{y}\\), per unit time (\\(\\frac{\\Delta \\rm{y}}{\\Delta t}\\)). The effectiveness spectrum is directly proportional to the conversion spectrum of the sensory pigment, if spectral attenuance is negligible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral effectiveness" .

goldbook:S05817 a skos:Concept ;
    skos:definition "Irradiance, \\(E\\), at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-3}\\), but a commonly used unit is \\(\\rm{W m}^{-2}\\ \\rm{nm}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral irradiance" .

goldbook:S05818 a skos:Concept ;
    skos:definition "In the context of radiative energy transfer, the integral, \\(J = \\int_{0}^{\\infty} f_{\\rm{D}}^{\\prime}(\\sigma)\\ \\varepsilon_{\\rm{A}}(\\sigma) {\\rm{d}}\\sigma \\), which measures the overlap of the emission spectrum of the excited donor, D, and the absorption spectrum of the ground state acceptor, A; \\(f_{\\rm{D}}^{'}\\) is the measured normalized emission of D, \\(f_{\\rm{D}}^{'}=\\frac{f_{\\rm{D}}\\left(\\sigma \\right)}{\\int _{0}^{\\infty }f_{\\rm{D}}\\left(\\sigma \\right)  \\ \\mathrm{d}\\sigma }\\), \\(f_{\\rm{D}}(\\sigma)\\) is the photon exitance of the donor at wavenumber \\(\\sigma \\), and \\(\\varepsilon_{\\rm{A}}(\\sigma)\\) is the decadic molar absorption coefficient of A at wavenumber \\(\\sigma \\). In the context of Förster excitation transfer, \\(J\\) is given by: \\[J = \\int_{0}^{\\infty} \\frac{f_{\\rm{D}}^{^\\prime}(\\sigma)\\ \\varepsilon_{\\rm{A}}(\\sigma)}{\\sigma^{4}} {\\rm{d}}\\sigma \\] In the context of Dexter excitation transfer, \\(J\\) is given by: \\[J = \\int_{0}^{\\infty} f_{\\rm{D}}(\\sigma)\\ \\varepsilon_{\\rm{A}}(\\sigma) {\\rm{d}}\\sigma \\] In this case \\(f_{\\rm{D}}\\) and \\(\\varepsilon_{\\rm{A}}\\), the emission spectrum of donor and absorption spectrum of acceptor, respectively, are both normalized to unity, so that the rate constant for energy transfer, \\(k_{\\rm{ET}}\\), is independent of the oscillator strength of both transitions (contrast to Förster mechanism)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral overlap" .

goldbook:S05819 a skos:Concept ;
    skos:definition "The photon exitance, \\(M_{\\rm{p}}\\), at wavelength per unit wavelength interval. The SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-3}\\), but a commonly used unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-2}\\ \\rm{nm}^{-1}\\). Alternatively, the term can be used with the amount of photons (mol or its equivalent einstein) the SI unit then being \\(\\pu{mol s-1 m-3}\\) and the common unit \\(\\pu{mol s-1 m-2 nm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral photon exitance" .

goldbook:S05820 a skos:Concept ;
    skos:definition "The photon flow, \\(\\varPhi_{\\rm{p}}\\), at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-1}\\), but a commonly used unit is \\(\\rm{s}^{-1}\\ \\rm{nm}^{-1}\\). Alternatively, the term can be used with the amount of photons (mol or its equivalent einstein), the SI unit then being \\(\\pu{mol s-1 m-1}\\) and the common unit \\(\\pu{mol s-1 nm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral photon flow" .

goldbook:S05821 a skos:Concept ;
    skos:altLabel "photon irradiance" ;
    skos:definition "The photon irradiance \\(E_{\\rm{p}}\\), at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-3}\\), but a commonly used unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-2}\\ \\rm{nm}^{-1}\\). Alternatively, the term can be used with the amount of photons (mol or its equivalent einstein), the SI unit then being \\(\\pu{mol s-1 m-3}\\) and the common unit \\(\\pu{mol s-1 m-2 nm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral photon flux" .

goldbook:S05822 a skos:Concept ;
    skos:definition "The photon radiance, \\(L_{\\rm{p}}\\), at wavelength per unit wavelength interval. The SI unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-3}\\ \\rm{sr}^{-1}\\), but a commonly used unit is \\(\\rm{s}^{-1}\\ \\rm{m}^{-2}\\ \\rm{sr}^{-1}\\ \\rm{nm}^{-1}\\). Alternatively, the term can be used with the amount of photons (mol or its equivalent einstein) the SI unit then being \\(\\pu{mol s-1 m-3 sr-1}\\) and the common unit \\(\\pu{mol s-1 m-2 sr-1 nm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral photon radiance" .

goldbook:S05824 a skos:Concept ;
    skos:definition "The radiance, \\(L\\), at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-3}\\ \\rm{sr}^{-1}\\), but a commonly used unit is \\(\\rm{W m}^{-2}\\ \\rm{sr}^{-1}\\ \\rm{nm}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiance" .

goldbook:S05825 a skos:Concept ;
    skos:definition "The radiant exitance, \\(M\\), at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-3}\\), but a commonly used unit is \\(\\rm{W m}^{-2}\\ \\rm{nm}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiant exitance" .

goldbook:S05826 a skos:Concept ;
    skos:definition "Synonymous with spectral radiant power." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiant flux" .

goldbook:S05827 a skos:Concept ;
    skos:definition "The radiation intensity, \\(I\\) at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-1}\\ \\rm{sr}^{-1}\\), but a commonly used unit is \\(\\rm{W nm}^{-1}\\ \\rm{sr}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiant intensity" .

goldbook:S05828 a skos:Concept ;
    skos:altLabel "total radiant power" ;
    skos:definition "The radiant power at wavelength \\(\\lambda \\) per unit wavelength interval. The SI unit is \\(\\rm{W m}^{-1}\\), but a commonly used unit is \\(\\rm{W nm}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiant power" .

goldbook:S05829 a skos:Concept ;
    skos:definition "The spectral output quantity of a system such as a photomultiplier, diode array, photoimaging device, or biological unit divided by the spectral irradiance \\(s(\\lambda) = \\frac{\\rm{d}y\\left(\\lambda \\right)}{\\rm{d}E\\left(\\lambda \\right)}\\), simplified expression: \\(s(\\lambda) = \\frac{Y_{\\lambda }}{E_{\\lambda }}\\), where \\(Y_{\\lambda }\\) is the magnitude of the output signal for irradiation at wavelength \\(\\lambda \\) and \\(E_{\\lambda }\\) is the spectral irradiance of the parallel and perpendicular incident beam at the same wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral responsivity" .

goldbook:S05831 a skos:Concept ;
    skos:definition "The process of increasing the spectral responsivity of a (photoimaging) system in a given wavelength region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral sensitization" .

goldbook:S05832 a skos:Concept ;
    skos:definition "Alternative term suggested for actinic flux." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral spheradiance" .

goldbook:S05835 a skos:Concept ;
    skos:definition "A spectrum as recorded by a spectrometer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrogram" .

goldbook:S05836 a skos:Concept ;
    skos:definition "A combination of a spectral apparatus and a camera, which enables an image of a spectrum to be recorded. Spectra are recorded by a photographic emulsion or other means, e.g. two-dimensional electronic image sensors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrograph" .

goldbook:S05837 a skos:Concept ;
    skos:definition "A general term for describing a combination of spectral apparatus with one or more detectors to measure the intensity of one or more spectral bands." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrometer" .

goldbook:S05847 a skos:Concept ;
    skos:definition "A device which enables visual observation and evaluation of optical spectra (usually confined to the visible spectral region)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectroscope" .

goldbook:S05848 a skos:Concept ;
    skos:definition "The study of physical systems by the electromagnetic radiation with which they interact or that they produce. Spectrometry is the measurement of such radiations as a means of obtaining information about the systems and their components. In certain types of optical spectroscopy, the radiation originates from an external source and is modified by the system, whereas in other types, the radiation originates within the system itself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectroscopy" .

goldbook:S05849 a skos:Concept ;
    skos:definition "The interpretation of the information present in an energy spectrum in terms of radiation energy and intensity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectrum analysis" .

goldbook:S05851 a skos:Concept ;
    skos:altLabel "reflection factor" ;
    skos:definition "Radiant power specularly reflected from the surface of a system, \\(P_{\\mathrm{refl}}\\), divided by the incident power, \\(P_{0}\\): \\[\\rho =\\frac{P_{\\mathrm{refl}}}{P_{0}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "specular reflectance" .

goldbook:S05852 a skos:Concept ;
    skos:definition "Scalar quantity equal to the absolute value of the velocity vector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "speed" .

goldbook:S05856 a skos:Concept ;
    skos:definition "A term which describes the morphology of carbonaceous mesophase which is formed in the isotropic pitch matrix. The spherical carbonaceous mesophase usually has a lamellar structure consisting of flat aromatic molecules arranged in parallel layers which are perpendicular to the sphere/isotropic phase interface. On coalescence, this spherical mesophase loses its characteristic morphology and is converted to the bulk mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spherical carbonaceous mesophase" .

goldbook:S05857 a skos:Concept ;
    skos:definition "Same as radiant exitance, \\(M\\). It is the integration of the radiant power, \\(P\\), leaving a source over the solid angle and over the whole wavelength range." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spherical radiance" .

goldbook:S05858 a skos:Concept ;
    skos:definition "Synonymous with fluence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spherical radiant exposure" .

goldbook:S05861 a skos:Concept ;
    skos:definition "An electronic transition which does not involve a change in the spin part of the wavefunction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-allowed electronic transition" .

goldbook:S05862 a skos:Concept ;
    skos:altLabel "Wigner rule" ;
    skos:definition "For both radiative and radiationless transitions, the principle that transitions between terms of the same multiplicity are spin-allowed, while transitions between terms of different multiplicity are spin-forbidden." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin conservation rule" .

goldbook:S05864 a skos:Concept ;
    skos:definition "The unpaired electron density at a position of interest, usually at carbon, in a radical. It is often measured experimentally by electron paramagnetic resonance [EPR, ESR (electron spin resonance)] spectroscopy through hyperfine coupling constants of the atom or an attached hydrogen." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin density" .

goldbook:S05865 a skos:Concept ;
    skos:definition "A rotation of electron spins, above a critical magnetic field, \\(H_{\\rm{c}}\\), in an antiferromagnet from parallel to largely perpendicular alignment, relative to an applied magnetic field, \\(H_{\\rm{a}}\\), for \\(H_{\\rm{a}}>H_{\\rm{c}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-flip transition" .

goldbook:S05867 a skos:Concept ;
    skos:definition "A second-order transition from a paramagnetic or ferromagnetic state to a spin-glass state in which spins from moment-bearing solute atoms become ordered randomly in a non-magnetic host such that the net magnetization of any region is zero. Examples: $\\ce{Au–Fe}$, $\\ce{Cu–Mn}$ and $\\ce{Mo–Fe}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-glass transition" .

goldbook:S05868 a skos:Concept ;
    skos:definition "A stable paramagnetic group (typically a nitryl radical) that is attached to a part of a molecular entity whose microscopic environment is of interest and may be revealed by the electron spin resonance (ESR) spectrum of the spin label. When a simple paramagnetic molecular entity is used in this way without covalent attachment to the molecular entity of interest it is frequently referred to as a 'spin probe'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin label" .

goldbook:S05869 a skos:Concept ;
    skos:definition "A clustering reaction in a homogeneous, supersaturated solution (solid or liquid) which is unstable against infinitesimal fluctuations in density or composition. The solution therefore separates spontaneously into two phases, starting with small fluctuations and proceeding with a decrease in the Gibbs energy without a nucleation barrier." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spinodal decomposition" .

goldbook:S05870 a skos:Concept ;
    skos:definition "The interaction of the electron spin magnetic moment with the magnetic moment due to the orbital motion of the electron. One consequence of spin-orbit coupling is the mixing of zero-order states of different multiplicity. This effect may result in fine structure called spin-orbit splitting." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin–orbit coupling" .

goldbook:S05872 a skos:Concept ;
    skos:definition "Removal of state degeneracy by spin–orbit coupling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-orbit splitting" .

goldbook:S05873 a skos:Concept ;
    skos:definition "A magneto-elastic transition that occurs in quasi one-dimensional antiferromagnetic materials when the magnetic free energy decrease due to the formation of singlet spin pairs outweighs the increase in lattice free energy occurring as a result of the dimerization of the regular array. Example: The transition in tetrathiafulvalenium bis(dithiolene)cuprate at \\(12\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-Peierls transition" .

goldbook:S05875 a skos:Concept ;
    skos:definition "The interaction between the spin magnetic moments of different electrons and/or nuclei. It causes, e.g. the multiplet pattern in nuclear magnetic resonance spectra." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin–spin coupling" .

goldbook:S05877 a skos:Concept ;
    skos:definition "An electronic transition from a high-spin state to a low-spin state, or vice versa. Example: With an increase in temperature $\\ce{Co^{3+}}$ ions in $\\ce{LaCoO3}$ transform from a low-spin state (\\(\\rm{t}_{\\rm{2g}}^{6}\\rm{e}_{\\rm{g}}^{0}\\)) to the high-spin state (\\(\\rm{t}_{\\rm{2g}}^{4}\\rm{e}_{\\rm{g}}^{2}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-state transition" .

goldbook:S05878 a skos:Concept ;
    skos:definition "In certain reactions in solution a transient radical will interact with a diamagnetic reagent to form a more persistent radical. The product radical accumulates to a concentration where detection and, frequently, identification are possible by EPR/ESR spectroscopy. The key reaction is usually one of attachment; the diamagnetic reagent is said to be a 'spin trap' and the persistent product radical is then the 'spin adduct'. The procedure is referred to as spin trapping, and is used for monitoring reactions involving the intermediacy of reactive radicals at concentrations too low for direct observation. Typical spin traps are C-nitroso compounds and nitrones, to which reactive radicals will rapidly add to form nitryl radicals. A quantitative development, in which essentially all reactive radicals generated in a particular system are intercepted, has been referred to as 'spin counting'. Spin trapping has also been adapted to the interception of radicals generated in both gaseous and solid phases. In these cases the spin adduct is in practice transferred to a liquid solution for observation in order to facilitate interpretation of the EPR/ESR spectra of the radicals obtained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin trapping" .

goldbook:S05880 a skos:Concept ;
    skos:definition "A double-strand chain consisting of an uninterrupted sequence of rings, with adjacent rings having only one atom in common. Alternatively, a spiro chain is a double-strand chain with adjacent constitutional unit joined to each other through three atoms, two on one side and one on the other side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spiro chain" .

goldbook:S05881 a skos:Concept ;
    skos:definition "Compounds having one atom (usually a quaternary carbon) as the only common member of two rings, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spiro compounds" .

goldbook:S05882 a skos:Concept ;
    skos:definition "A double-strand macromolecule consisting of an uninterrupted sequence of rings, with adjacent rings having only one atom in common. Alternatively, a spiro macromolecule is a double-strand macromolecule with adjacent constitutional unit joined to each other through three atoms, two on one side and one on the other side of each constitutional unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spiro macromolecule" .

goldbook:S05885 a skos:Concept ;
    skos:definition "of RNA: The procedure by which introns are removed from eukaryotic precursor mRNA molecules and adjacent exon sequences are joined together (spliced).of DNA: Manipulation for joining together double-stranded DNA fragments with protruding single-stranded 'sticky ends' by means of ligases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "splicing" .

goldbook:S05886 a skos:Concept ;
    skos:definition "That mode of emission which occurs even in the absence of a perturbing external electromagnetic field. The transition between states, \\(n\\) and \\(m\\), is governed by the einstein coefficient of spontaneous emission, \\(A_{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spontaneous emission" .

goldbook:S05887 a skos:Concept ;
    skos:definition "Nuclear fission which occurs without the addition of particles or energy to the nucleus" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spontaneous fission" .

goldbook:S05889 a skos:Concept ;
    skos:definition "A zone in paper and thin-layer chromatography of approximately circular appearance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spot" .

goldbook:S05893 a skos:Concept ;
    skos:definition "A process in which a drop of liquid spreads over a solid or liquid substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spreading wetting" .

goldbook:S05894 a skos:Concept ;
    skos:definition "It may happen that a component is virtually insoluble in both of two adjoining phases, but is present as a monolayer between them. Such a layer can be produced by spreading." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spread monolayer" .

goldbook:S05895 a skos:Concept ;
    skos:definition "Removal of surface material (atoms, clusters and molecules) by particle bombardment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sputtering" .

goldbook:S05896 a skos:Concept ;
    skos:definition "The number of particles sputtered from the surface of a target per primary ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sputter yield" .

goldbook:S05897 a skos:Concept ;
    skos:definition "In square-wave polarography, the component of the current that is associated with the presence of a substance B. This component may be either faradaic (if B is electroactive) or non-faradaic (if B is surface-active)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "square-wave current" .

goldbook:S05900 a skos:Concept ;
    skos:definition "As applied to chemical species, the term expresses a thermodynamic property, which is quantitatively measured by relative molar standard Gibbs energies. A chemical species A is more stable than its isomer B if \\(\\Delta _{\\rm{r}}G^{\\,\\unicode{x26ac}} > 0\\) for the (real or hypothetical) reaction \\[\\rm{A}\\quad \\rightarrow \\quad \\rm{B}\\] under standard conditions. If for the two reactions: \\[\\rm{P}\\rightarrow \\rm{X}+\\rm{Y}\\qquad (\\Delta _{\\rm{r}}G_{1}^{\\rm{o}})\\] \\[\\rm{Q}\\rightarrow \\rm{X}+\\rm{Z}\\qquad (\\Delta _{\\rm{r}}G_{2}^{\\rm{o}})\\] \\(\\Delta _{\\rm{r}}G_{1}^{\\,\\unicode{x26ac}} > \\Delta _{\\rm{r}}G_{2}^{\\,\\unicode{x26ac}}\\), P is more stable relative to the product Y than is Q relative to Z. Both in qualitative and quantitative usage the term stable is therefore always used in reference to some explicitly stated or implicitly assumed standard. The term should not be used as a synonym for unreactive or 'less reactive' since this confuses thermodynamics and kinetics. A relatively more stable chemical species may be more reactive than some reference species towards a given reaction partner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable" .

goldbook:S05901 a skos:Concept ;
    skos:definition "A film often thins gradually to a thickness at which it either ruptures or converts abruptly to an equilibrium film. Rupture under these conditions characterizes unstable films, whereas transition to an equilibrium film characterizes (meta)stable films." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable film, metastable film" .

goldbook:S05902 a skos:Concept ;
    skos:definition "An ion which is not sufficiently excited to dissociate spontaneously into a daughter ion and associated neutral fragment(s) or to react further in any other way within the time scale of the experiment, e.g. until hitting the detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stable ion" .

goldbook:S05903 a skos:Concept ;
    skos:definition "The conformation of groups attached to two adjacent atoms if the torsion angles are such that the groups are as far away as possible from an eclipsed arrangement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "staggered conformation" .

goldbook:S05905 a skos:Concept ;
    skos:definition "Acceleration defined as \\(g_{\\rm{n}} = 9.806\\ 65\\ \\rm{m s}^{-2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard acceleration of free fall" .

goldbook:S05906 a skos:Concept ;
    skos:definition "Pressure defined as \\(101\\ 325\\ \\rm{Pa}\\) and used as unit of pressure with the symbol \\(\\rm{atm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard atmosphere" .

goldbook:S05910 a skos:Concept ;
    skos:definition "Temperature, \\(273.15\\ \\rm{K}\\) (\\(0\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)) and pressure of \\(10^{5}\\) pascals. IUPAC recommends that the former use of the pressure of 1 atm as standard pressure (equivalent to \\(1.01325\\times 10^{5}\\ \\rm{Pa}\\)) should be discontinued." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard conditions for gases" .

goldbook:S05917 a skos:Concept ;
    skos:definition "For solutions in protic solvents, the universal reference electrode for which, under standard conditions, the standard electrode potential ($\\ce{H^{+}}$/$\\ce{H2}$) is zero at all temperatures. The absolute electrode potential of the hydrogen electrode under standard conditions can be expressed in terms of thermodynamic quantities by applying a suitable Born–Haber cycle, thus: \\[E^{\\,\\unicode{x26ac}}\\left(\\rm{H}^{+}/\\rm{H}_{2}\\right)\\left(\\rm{abs}\\right)=\\Delta _{\\rm{at}}G^{\\,\\unicode{x26ac}}+\\Delta _{\\rm{ion}}G^{\\,\\unicode{x26ac}}+\\frac{\\alpha _{\\rm{H}^{+}}^{\\rm{o,S}}}{F}\\] where \\(\\Delta _{\\rm{at}}G^{\\,\\unicode{x26ac}}\\) and \\(\\Delta _{\\rm{ion}}G^{\\,\\unicode{x26ac}}\\) are the atomization and ionization Gibbs energies of $\\ce{H2}$, \\(\\alpha _{\\rm{H}^{+}}^{\\rm{o,S}}\\) is the real potential of $\\ce{H2}$ in solvent $\\ce{S}$ and \\(F\\) is the Faraday constant. The recommended absolute electrode potential of the hydrogen electrode is: \\[E^{\\,\\unicode{x26ac}}\\left(\\rm{H}^{+}/\\rm{H}_{2}\\right)^{\\rm{H}_{2}\\rm{O}}\\left(\\rm{abs}\\right)=(4.44\\pm 0.02)\\ \\rm{V}\\quad \\rm{at}\\quad 298.15\\ \\rm{K}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard hydrogen electrode" .

goldbook:S05921 a skos:Concept ;
    skos:definition "Chosen value of pressure denoted by \\(p^{\\unicode{x29B5}}\\) or \\(p^{\\,\\unicode{x26ac}}\\). In 1982 IUPAC recommended the value \\(10^{5}\\ \\rm{Pa}\\), but prior to 1982 the value \\(101\\ 325\\ \\rm{Pa}\\) (= \\(1\\ \\rm{atm}\\)) was usually used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "standard pressure" .

goldbook:S05929 a skos:Concept ;
    skos:definition "The condition of an instrument where the analytical procedure can begin immediately." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stand-by state" .

goldbook:S05930 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{H3S_{n}[OSnH2]_{n}OSnH3}$. Thus, tin analogues of siloxanes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stannoxanes" .

goldbook:S05932 a skos:Concept ;
    skos:altLabel "stannylenes" ;
    skos:definition "Carbene analogues having the structure $\\ce{R2Sn{:}}$. The older synonymous term  stannylenes is no longer recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stannylidenes" .

goldbook:S05933 a skos:Concept ;
    skos:definition "A copolymer where chains having different constitutional or configurational features are linked through a central moiety." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "star copolymer" .

goldbook:S05934 a skos:Concept ;
    skos:altLabel "electrochromic effect" ;
    skos:definition "The splitting or shift of spectral lines in an electric field. Also called electrochromic effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stark effect" .

goldbook:S05935 a skos:Concept ;
    skos:definition "A macromolecule containing a single branch point from which linear chains (arms) emanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "star macromolecule" .

goldbook:S05936 a skos:Concept ;
    skos:definition "A polymer composed of star macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "star polymer" .

goldbook:S05939 a skos:Concept ;
    skos:definition "The time interval between turn-on of the instrument and its stand-by state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "start-up time" .

goldbook:S05943 a skos:Concept ;
    skos:definition "A branch of chemical kinetics concerned with the dynamics of reactions in which the reactant species are in known quantum states, and in which the quantum states of the products are determined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "state-to-state kinetics" .

goldbook:S05944 a skos:Concept ;
    skos:definition "An instrument which can separate selected ion beams with fields which do not vary with time. The fields are generally both electric and magnetic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static fields mass spectrometer" .

goldbook:S05945 a skos:Concept ;
    skos:definition "The pressure of a fluid at rest or in motion exerted perpendicularly to the direction of flow." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static pressure" .

goldbook:S05947 a skos:Concept ;
    skos:definition "In meteorology, the stability of the atmosphere in the vertical direction to vertical displacements. If \\(\\mathit{\\Gamma}\\) is the dry adiabatic lapse rate, dry air is stable if the lapse rate \\(-\\frac{{\\rm{d}}T}{{\\rm{d}}z} \\lt \\Gamma\\), unstable if \\(-\\frac{{\\rm{d}}T}{{\\rm{d}}z} \\gt \\Gamma\\) and neutral \\(-\\frac{{\\rm{d}}T}{{\\rm{d}}z} = \\Gamma\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "static stability" .

goldbook:S05948 a skos:Concept ;
    skos:definition "The phase of a culture of microorganisms or animal and plant cells cultured in vitro that follows the exponential growth phase and in which there is little or no growth. In some cases it is a phase of product formation, e.g. formation of secondary metabolites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stationary phase" .

goldbook:S05949 a skos:Concept ;
    skos:definition "One of the two phases forming a chromatographic system. It may be a solid, a gel or a liquid. If a liquid, it may be distributed on a solid. This solid may or may not contribute to the separation process. The liquid may also be chemically bonded to the solid (bonded phase) or immobilized onto it (immobilized phase). The expression chromatographic bed or sorbent may be used as a general term to denote any of the different forms in which the stationary phase is used. Particularly in gas chromatography where the stationary phase is most often a liquid, the term liquid phase is used for it as compared to the gas phase, i.e. the mobile phase. However, particularly in the early development of liquid chromatography, the term 'liquid phase' had also been used to characterize the mobile phase as compared to the 'solid phase' i.e. the stationary phase. Due to this ambiguity, the use of the term 'liquid phase' is discouraged. If the physical state of the stationary phase is to be expressed, the use of the adjective forms such as liquid stationary phase and solid stationary phase, bonded phase or immobilized phase is proposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stationary phase" .

goldbook:S05952 a skos:Concept ;
    skos:definition "The volume of the liquid stationary phase or the active solid in the column. The volume of any solid support is not included. In the case of partition chromatography with a liquid stationary phase, it is identical to the liquid phase volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stationary phase volume" .

goldbook:S05953 a skos:Concept ;
    skos:definition "(in quantum mechanics) A state that does not evolve with time.(in kinetics) See: steady state" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stationary state" .

goldbook:S05955 a skos:Concept ;
    skos:definition "A copolymer consisting of macromolecules in which the sequential distribution of the monomeric units obeys known statistical laws." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "statistical copolymer" .

goldbook:S05956 a skos:Concept ;
    skos:definition "A copolymerization in which a statistical copolymer is formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "statistical copolymerization" .

goldbook:S05961 a skos:Concept ;
    skos:definition "The state of a continuous process when it is operating in such a way that the concentration of solutes in exit streams remains constant with respect to time for constant feed concentrations, even though the two phases are not necessarily in thermodynamic equilibrium in any part of the process. The term equilibrium should not be used to describe this situation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steady state" .

goldbook:S05962 a skos:Concept ;
    skos:altLabel "Bodenstein approximation",
        "stationary state",
        "steady state approximation",
        "steady state treatment" ;
    skos:definition "In a kinetic analysis of a complex reaction involving unstable intermediates in lconcentration, the rate of change of each such intermediate is set equal to zero, so that the rate equation can be expressed as a function of the concentrations of chemical species present in macroscopic amounts. For example, assume that $\\ce{\\textbf{X}}$ is an unstable intermediate in the reaction sequence:   Conservation of mass requires that: \\[[\\ce{A}] + [\\ce{X}] + [\\ce{D}] = [\\ce{A}]_{0}\\] which, since \\([\\ce{A}]_{0}\\) is constant, implies: \\[-\\frac{{\\rm{d}}[\\ce{X}]}{{\\rm{d}}t} = \\frac{{\\rm{d}}[\\ce{A}]}{{\\rm{d}}t} + \\frac{{\\rm{d}}[\\ce{D}]}{{\\rm{d}}t}.\\] Since \\([\\ce{X}]\\) is negligibly small, the rate of formation of $\\ce{\\textbf{D}}$ is essentially equal to the rate of disappearance of $\\ce{\\textbf{A}}$, and the rate of change of \\([\\ce{X}]\\) can be set equal to zero. Applying the steady state approximation (\\({\\rm{d}}[\\ce{X}]/{\\rm{d}}t = 0\\)) allows the elimination of \\([\\ce{X}]\\) from the kinetic equations, whereupon the rate of reaction is expressed: \\[\\frac{{\\rm{d}}[\\ce{D}]}{{\\rm{d}}t} = -\\frac{{\\rm{d}}[\\ce{A}]}{{\\rm{d}}t} = \\frac{k_{1}k_{2}[\\ce{A}][\\ce{C}]}{k_{-1} + k_{2}[\\ce{C}]}\\]Note: The steady-state approximation does not imply that \\([\\ce{X}]\\) is even approximately constant, only that its absolute rate of change is very much smaller than that of \\([\\ce{A}]\\) and \\([\\ce{D}]\\). Since according to the reaction scheme \\({\\rm{d}}[\\ce{X}]/{\\rm{d}}t = k_{2}[\\ce{X}][\\ce{C}]\\), the assumption that \\([\\ce{X}]\\) is constant would lead, for the case in which $\\ce{\\textbf{C}}$ is in large excess, to the absurd conclusion that formation of the product $\\ce{\\textbf{D}}$ will continue at a constant rate even after the reactant $\\ce{\\textbf{A}}$ has been consumed.In a stirred flow reactor a steady state implies a regime so that all concentrations are independent of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steady state" .

goldbook:S05964 a skos:Concept ;
    skos:definition "Fundamental physical constant \\(\\sigma = \\frac{2\\ \\pi ^{5}\\ k^{4}}{15\\ h^{3}\\ c_{0}^{2}} = 5.670\\ 51(19)\\times 10^{-8}\\ \\rm{W}\\ \\rm{m}^{-2}\\ \\rm{K}^{-4}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stefan–Boltzmann constant" .

goldbook:S05969 a skos:Concept ;
    skos:definition "An elution process in which the composition of the mobile phase is changed in steps during a single chromatographic run." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stepwise elution" .

goldbook:S05970 a skos:Concept ;
    skos:definition "A chemical reaction with at least one reaction intermediate and involving at least two consecutive elementary reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stepwise reaction" .

goldbook:S05972 a skos:Concept ;
    skos:definition "A block macromolecule composed of stereoregular, and possibly nonstereoregular, blocks." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoblock macromolecule" .

goldbook:S05973 a skos:Concept ;
    skos:definition "A polymer composed of stereoblock macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoblock polymer" .

goldbook:S05974 a skos:Concept ;
    skos:altLabel "stereoformula" ;
    skos:definition "A three-dimensional view of a molecule either as such or in a projection." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereochemical formula" .

goldbook:S05975 a skos:Concept ;
    skos:definition "The predominant formation of the same stereoisomers or stereoisomer mixture of a reaction product when two different stereoisomers of the reactant are used in the same reaction. When that product involved in the reaction is one enantiomer the result has been called enantioconvergence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoconvergence" .

goldbook:S05976 a skos:Concept ;
    skos:definition "A prefix to specify configuration (absolute or relative) or conformation. For example R, S; r, s; P, M; Re, Si; E, Z; ap, sp; etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereodescriptor" .

goldbook:S05977 a skos:Concept ;
    skos:definition "Pertaining to the dependence of the properties (especially the energy) of a molecular entity in a particular electronic state (or of a transition state) on relative nuclear geometry. The electronic ground state is usually considered, but the term can apply to excited states as well. Stereoelectronic effects arise from the different alignment of electronic orbitals in different arrangements of nuclear geometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoelectronic" .

goldbook:S05978 a skos:Concept ;
    skos:definition "Control of the nature of the products of a chemical reaction (or of its rate) by stereoelectronic factors. The term is usually applied in the framework of an orbital approximation. The variations of molecular orbital energies with relative nuclear geometry (along a reaction coordinate) are then seen as consequences of variations in basis-orbital overlaps." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoelectronic control" .

goldbook:S05980 a skos:Concept ;
    skos:altLabel "stereoelement",
        "stereogen" ;
    skos:definition "A grouping within a molecular entity that may be considered a focus of stereoisomerism. At least one of these must be present in every enantiomer (though the presence of stereogenic units does not conversely require the corresponding chemical species to be chiral). Three basic types are recognized for molecular entities involving atoms having not more than four substituents:  A grouping of atoms consisting of a central atom and distinguishable ligands, such that the interchange of any two of the substituents leads to a stereoisomer. An asymmetric atom (chirality centre) is the traditional example of this stereogenic unit.   A chain of four non-coplanar atoms (or rigid groups) in a stable conformation, such that an imaginary or real (restricted) rotation (with a change of sign of the torsion angle) about the central bond leads to a stereoisomer.   A grouping of atoms consisting of a double bond with substituents which give rise to cis-trans isomerism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereogenic unit" .

goldbook:S05981 a skos:Concept ;
    skos:definition "Either enantiotopic or diastereotopic. (In contrast the term constitutionally heterotopic has been used to describe identical groups located in constitutionally non-equivalent positions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoheterotopic" .

goldbook:S05983 a skos:Concept ;
    skos:definition "Isomerism due to differences in the spatial arrangement of atoms without any differences in connectivity or bond multiplicity between the isomers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoisomerism" .

goldbook:S05984 a skos:Concept ;
    skos:definition "Isomers that possess identical constitution, but which differ in the arrangement of their atoms in space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoisomers" .

goldbook:S05985 a skos:Concept ;
    skos:definition "A change of configuration at a stereogenic unit brought about by physical or chemical means." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereomutation" .

goldbook:S05986 a skos:Concept ;
    skos:definition "A regular macromolecule essentially comprising only one species of stereorepeating unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoregular macromolecule" .

goldbook:S05987 a skos:Concept ;
    skos:definition "A polymer composed of stereoregular macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoregular polymer" .

goldbook:S05988 a skos:Concept ;
    skos:definition "A configurational repeating unit having defined configuration at all sites of stereoisomerism in the main chain of a regular macromolecule, a regular oligomer molecule, a regular block or a regular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereorepeating unit" .

goldbook:S05990 a skos:Concept ;
    skos:definition "A chemical reaction (or reaction sequence) in which one or more new elements of chirality are formed in a substrate molecule and which produces the stereoisomeric (enantiomeric or diastereoisomeric) products in unequal amounts. Traditionally called asymmetric synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoselective synthesis" .

goldbook:S05991 a skos:Concept ;
    skos:definition "The preferential formation in a chemical reaction of one stereoisomer over another. When the stereoisomers are enantiomers, the phenomenon is called 'enantioselectivity' and is quantitatively expressed by the enantiomeric excess; when they are diastereoisomers, it is called 'diastereoselectivity' and is quantitatively expressed by the diastereoisomer excess." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereoselectivity" .

goldbook:S05993 a skos:Concept ;
    skos:definition "A tracer in which the label is present in a stereospecific position." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereospecifically labelled tracer" .

goldbook:S05994 a skos:Concept ;
    skos:definition "A reaction is termed stereospecific if starting materials differing only in their configuration are converted into stereoisomeric products. According to this definition, a stereospecific process is necessarily stereoselectivity but not all stereoselective processes are stereospecific. Stereospecificity may be total (100%) or partial. The term is also applied to situations where reaction can be performed with only one stereoisomer. For example, the exclusive formation of trans-1,2-dibromocyclohexane upon bromination of cyclohexene is a stereospecific process, although the analogous reaction with (E)-cyclohexene has not been performed.The term has also been applied to describe a reaction of very high stereoselectivity, but this usage is unnecessary and is discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereospecificity" .

goldbook:S05996 a skos:Concept ;
    skos:definition "Control of stereoselectivity of a reaction by steric hindrance towards attack of the reagent, which is directed to the less hindered face of the molecule. Partial bond making is strong enough at the transition state for steric control to take place. This suggests that the transition state should not be close to products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric-approach control" .

goldbook:S05997 a skos:Concept ;
    skos:definition "The effect on a chemical or physical property (structure, rate or equilibrium constant) upon introduction of substituents having different steric requirements. The steric effect in a reaction is ascribed to the difference in steric energy between, on the one hand, reactants and, on the other hand, a transition state (or products). A steric effect on a rate process may result in a rate increase ('steric acceleration') or a decrease ('steric retardation'). (The adjective 'steric' is not to be confused with stereochemical.) Steric effects arise from contributions ascribed to strain as the sum of (1) non-bonded repulsions, (2) bond angle strain and (3) bond stretches or compressions. For the purpose of correlation analysis or linear free-energy relations various scales of steric parameters have been proposed, notably A values, Taft's \\(E_{\\rm{s}}\\) and Charton's \\( u \\) scales. In a reactant molecule $\\ce{RY}$ and an appropriate reference molecule $\\ce{R^{\\circ}Y}$, the 'primary steric effect' of $\\ce{R}$ is the direct result of differences in compressions which occur because $\\ce{R}$ differs from $\\ce{R^{\\circ}}$ in the vicinity of the reaction centre $\\ce{Y}$. A 'secondary steric effect' involves the differential moderation of electron delocalization by non-bonded compressions. Some authors make a distinction between 'steric' effects attributed to van der Waals repulsions alone, and 'strain' effects, attributed to deviations of bond angles from 'ideal' values." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric effect" .

goldbook:S05998 a skos:Concept ;
    skos:definition "A factor introduced into simple versions of the collision theory of reactions to take care of the fact that the reaction probability depends on the certain mutual orientations of the reactant molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric factor" .

goldbook:S06000 a skos:Concept ;
    skos:definition "The original term for a steric effect arising from crowding of substituents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric hindrance" .

goldbook:S06001 a skos:Concept ;
    skos:definition "A secondary isotope effect attributed to the different vibrational amplitudes of isotopologues. For example, both the mean and mean-square amplitudes of vibrations associated with $\\ce{C–H}$ bonds are greater than those of $\\ce{C–D}$ bonds. The greater effective bulk of molecules containing the former may be manifested by a steric effect on a rate or equilibrium constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steric isotope effect" .

goldbook:S06003 a skos:Concept ;
    skos:definition "Counter and co-ions in immediate contact with a surface are said to be located in the Stern layer, and form with the fixed charge a molecular capacitor." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stern layer" .

goldbook:S06004 a skos:Concept ;
    skos:definition "This term applies broadly to variations of quantum yield of photophysical processes (e.g. fluorescence or phosphorescence) or photochemical reaction (usually reaction quantum yield) with the concentration of a given reagent which may be a substrate or a quencher. In the simplest case, a plot of \\(\\frac{\\mathit{\\Phi}^{0}}{\\mathit{\\Phi}}\\) (or \\(\\frac{M^{0}}{M}\\) for emission) vs. concentration of quencher, \\(\\ce{[Q]}\\), is linear obeying the equation: \\[\\frac{\\mathit{\\Phi}^{0}}{\\mathit{\\Phi}} \\quad {\\rm{or}} \\quad \\frac{M^{0}}{M} = 1 + K_{\\rm{sv}} [\\rm{Q}]\\] In equation (1) \\(K_{\\rm{sv}}\\) is referred to as the Stern–Volmer constant. Equation (1) applies when a quencher inhibits either a photochemical reaction or a photophysical process by a single reaction. \\(\\mathit{\\Phi}^{0}\\) and \\(M^{0}\\) are the quantum yield and emission intensity radiant exitance, respectively, in the absence of the quencher Q, while \\(\\mathit{\\Phi}\\) and \\(M\\) are the same quantities in the presence of the different concentrations of Q. In the case of dynamic quenching the constant \\(K_{\\rm{sv}}\\) is the product of the true quenching constant \\(k_{\\rm{q}}\\) and the excited state lifetime, \\(\\tau^{0}\\), in the absence of quencher. \\(k_{\\rm{q}}\\) is the bimolecular reaction rate constant for the elementary reaction of the excited state with the particular quencher Q. Equation (1) can therefore be replaced by the expression (2): \\[\\frac{\\mathit{\\Phi}^{0}}{\\mathit{\\Phi}} \\quad {\\rm{or}} \\quad \\frac{M^{0}}{M} = 1 + k_{\\rm{q}} \\tau^{0} [{\\rm{Q}}]\\] When an excited state undergoes a bimolecular reaction with rate constant \\(k_{\\rm{r}}\\) to form a product, a double-reciprocal relationship is observed according to the equation: \\[\\frac{1}{\\mathit{\\Phi}_{\\rm{p}}} = \\left(1 + \\frac{1}{k_{\\rm{r}} \\tau^{0} [{\\ce{S}}]}\\right) \\frac{1}{A \\cdot B}\\] where \\(\\mathit{\\Phi}_{\\rm{p}}\\) is the quantum efficiency of product formation, \\(A\\) the efficiency of forming the reactive excited state, \\(B\\) the fraction of reactions of the excited state with substrate S which leads to product, and \\(\\ce{[S]}\\) is the concentration of reactive ground-state substrate. The intercept/slope ratio gives \\(k_{\\rm{r}} \\tau ^{0}\\). If \\(\\ce{[S]} = \\ce{[Q]}\\), and if a photophysical process is monitored, plots of equations (2) and (3) should provide independent determinations of the product-forming rate constant \\(k_{\\rm{r}}\\). When the lifetime of an excited state is observed as a function of the concentration of S or Q, a linear relationship should be observed according to the equation: \\[\\frac{\\tau^{0}}{\\tau} = 1 + k_{\\rm{q}} \\tau^{0} [\\ce{Q}]\\] where \\(\\tau^{0}\\) is the lifetime of the excited state in the absence of the quencher Q." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stern–Volmer kinetic relationships" .

goldbook:S06005 a skos:Concept ;
    skos:definition "Naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at C-10 and C-13, and often an alkyl group at C-17. By extension, one or more bond scissions, ring expansions and/or ring contractions of the skeleton may have occurred. Natural steroids are derived biogenetically from triterpenoids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "steroids" .

goldbook:S06006 a skos:Concept ;
    skos:definition "Natural products derived from the steroid skeleton and containing a hydroxy group in the 3 position, closely related to cholestan-3-ol." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sterols" .

goldbook:S06007 a skos:Concept ;
    skos:definition "The saturated hydrides of tervalent antimony, having the general formula $\\ce{Sb_{n}H_{n+2}}$. Hydrocarbyl derivatives of $\\ce{SbH3}$ belong to the class stibines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stibanes" .

goldbook:S06008 a skos:Concept ;
    skos:altLabel "stibinidenes" ;
    skos:definition "Recommended name for carbene analogues having the structure $\\ce{RSb{:}}$ (former IUPAC name is stibinediyls). A common non-IUPAC synonym is stibinidenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stibanylidenes" .

goldbook:S06009 a skos:Concept ;
    skos:definition "$\\ce{SbH3}$ and compounds derived from it by substituting one, two or three hydrogen atoms by hydrocarbyl groups $\\ce{R3Sb}$. $\\ce{RSbH2}$, $\\ce{R2SbH}$ and $\\ce{R3Sb}$ ($\\ce{R}  eq \\ce{H}$) are called primary, secondary and tertiary stibines, respectively. A specific stibine is preferably named as a substituted stibane. E.g. $\\ce{(CH2=CH)3Sb}$ trivinylstibane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stibines" .

goldbook:S06011 a skos:Concept ;
    skos:definition "Salts (including hydroxides) containing an atom of tetracoordinate antimony, of the form $\\ce{[R4Sb]^{+}X^{−}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stibonium compounds" .

goldbook:S06012 a skos:Concept ;
    skos:definition "The ratio of the rate of adsorption to the rate at which the adsorptive strikes the total surface, i.e. covered and uncovered. It is usually a function of surface coverage, of temperature and of the details of the surface structure of the adsorbent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sticking coefficient" .

goldbook:S06013 a skos:Concept ;
    skos:definition "Often used with the same meaning as sticking coefficient, but in principle it is a microscopic quantity concerned with the individual collision process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sticking probability" .

goldbook:S06014 a skos:Concept ;
    skos:definition "The staggered ends of complementary sequences of DNA which result from cleavage by restriction enzymes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sticky ends" .

goldbook:S06015 a skos:Concept ;
    skos:definition "That part of the emission which is induced by a resonant perturbing electromagnetic field. The transition between states, n and m, is governed by the einstein coefficient of stimulated emission, \\(B_{nm}\\). CIDNP emission and lasing action are examples of processes which require stimulated emission." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stimulated emission" .

goldbook:S06016 a skos:Concept ;
    skos:definition "A reactor within which effective mixing is achieved, often by placing the catalyst in a rapidly-rotating basket." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stirred flow reactor" .

goldbook:S06017 a skos:Concept ;
    skos:definition "Synonymous with random sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stochastic sampling" .

goldbook:S06018 a skos:Concept ;
    skos:definition "Theories that treat reaction rates in terms of the probabilities of transitions between the various energy levels in the reactant molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stochastic theories" .

goldbook:S06021 a skos:Concept ;
    skos:definition "Involving chemical combination in simple integral ratios. Characterized by having no excess of reactants or products over that required to satisfy the balanced chemical equation representing the given chemical reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stoichiometric" .

goldbook:S06023 a skos:Concept ;
    skos:definition "The stoichiometric concentration, \\(c_{\\rm{B}}\\), of a component B in a system is given by the expression: \\[c_{\\rm{B}}=\\frac{n_{\\rm{B}}}{V}\\] where \\(n_{\\rm{B}}\\) is the stoichiometric amount of substance of component B in the system and \\(V\\) is the volume of the system. The component added to the system may dissociate or react with other components to form a series of derived components and only a fraction of the original component may actually exist in a free form in the system. It is therefore essential to distinguish between the stoichiometric concentration and the amount-of-substance concentration of the free form of the component in the system. Sometimes stoichiometric quantities are indicated by a subscript (\\(_{\\circ}\\)), e.g. \\(n_{\\rm{o,B}}\\), \\(c_{\\rm{o,B}}\\). In clinical chemistry, the term stoichiometric concentration is rarely employed. Instead, the name of the component is modified to indicate inclusion of the various derived forms, e.g. mixtures of a defined chemical component and its derivatives may be denoted by the plural form of the name of the pure unchanged substance, or to indicate the sum of components specified in individual quantities the specification 'total' may be employed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stoichiometric concentration" .

goldbook:S06024 a skos:Concept ;
    skos:altLabel "practical activity coefficient" ;
    skos:definition "The practical activity coefficient of electrolyte B is given by \\[\\gamma _{\\pm }=\\frac{a_{\\pm }}{\\sqrt{ u _{\\rm{+}}^{ u _{\\rm{+}}}\\  u _{\\rm{-}}^{ u _{\\rm{-}}}}\\ \\frac{m_{\\rm{B}}}{m^{\\rm{+}}}}\\] where \\(a_{\\pm }\\) is the mean activity of B in solution, \\(m_{\\rm{B}}\\) is the molality of B, \\(m^{+} = \\pu{1 mol kg-1}\\), \\( u _{\\rm{+}}\\) is the number of cations and \\( u _{\\unicode{x2013}}\\) the number of anions in the chosen group B which is taken as the electrolyte. \\[ u =  u _{\\rm{+}}+ u _{\\rm{-}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stoichiometric mean molal" .

goldbook:S06025 a skos:Concept ;
    skos:definition "A chemical reaction of known stoichiometry can be written in general as: \\[a\\rm{A}\\,+\\,b\\rm{B}\\,+\\,...\\rightarrow\\,...\\,+y\\rm{Y}\\,+\\,z\\rm{Z}\\] For the reaction products Y and Z the numbers \\(y\\) and \\(z\\) are known as the stoichiometric numbers, \\( u _{\\rm{Y}}\\) and \\( u _{\\rm{Z}}\\), for Y and Z respectively. For the reactants the stoichiometric numbers are the negatives of the numbers appearing in the equation; for example the stoichiometric number \\( u _{\\rm{A}}\\) for the reactant A is \\(-a\\). In other words, the stoichiometric numbers are positive for products and negative for reactants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stoichiometric number" .

goldbook:S06026 a skos:Concept ;
    skos:definition "The term refers to the relationship between the amounts of substances that react together in a particular chemical reaction, and the amounts of products that are formed. The general stoichiometric equation: \\[a\\rm{A}\\,+\\,b\\rm{B}\\,+\\,...\\,\\rightarrow\\,...\\,+\\,y\\rm{Y}\\,+\\,z\\rm{Z}\\] provides the information that a moles of A reacts with b moles of B to produce y moles of Y and z moles of Z. The stoichiometry of a reaction may be unknown, or may be very complex. For example, the thermal decomposition of acetaldehyde yields mainly methane and carbon monoxide, but also a variety of minor products such as ethane, acetone and diacetyl. The stoichiometric equation:  is therefore only an approximate one. Even when the overall stoichiometry of a reaction is well defined, it may be time-dependent in that it varies during the course of a reaction. Thus if a reaction occurs by the mechanism \\(\\rm{A}\\rightarrow \\rm{X}\\rightarrow \\rm{Y}\\), and X is formed in substantial amounts during the course of the process, the relationship between the amounts of A, X and Y will vary with time, and no one stoichiometric equation can represent the reaction at all times." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stoichiometry" .

goldbook:S06027 a skos:Concept ;
    skos:definition "cgs unit of kinematic viscosity, \\(\\rm{St} = 10^{-4}\\ \\rm{m}^{2}\\ \\rm{s}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stokes" .

goldbook:S06028 a skos:Concept ;
    skos:definition "\\(F=6\\ \\pi \\ \\eta \\ r\\  u\\), where \\(F\\) is the force exerted on a sphere of radius \\(r\\) which is moving through a fluid of viscosity \\(\\eta \\) with a relative velocity \\( u\\); this equation holds at low velocities which are free from turbulence (called the stokes region)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes law" .

goldbook:S06029 a skos:Concept ;
    skos:definition "Sometimes referred to as the inertial parameter; it is an index of the impactability of an aerosol particle. It is defined by the equation: \\(St = 2\\ \\tau \\ (V_{\\rm{t}}-  u_{\\rm{t}})\\ D_{\\rm{p}}\\) where \\(D_{\\rm{p}}\\) is the diameter of a small drop, \\(V_{\\rm{t}}-  u_{\\rm{t}}\\) is the difference in fall velocities of the drop and aerosol particles and \\(\\tau \\) is the characteristic relaxation time of a particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes number" .

goldbook:S06030 a skos:Concept ;
    skos:definition "Of elliptically polarized incident radiation, these are given by \\[s_{0}^{0}=E_{1}^{0}+E_{2}^{0}\\] \\[s_{1}^{0}=E_{1}^{0}- E_{2}^{0}\\] \\[s_{2}^{0}=2\\ \\sqrt{E_{1}^{0}\\ E_{2}^{0}}\\ \\cos   \\delta ^{0}\\] \\[s_{3}^{0}=2\\ \\sqrt{E_{1}^{0}\\ E_{2}^{0}}\\ \\sin   \\delta ^{0}\\] where \\(E_{1}^{0}\\) and \\(E_{2}^{0}\\) specify the irradiances of the incident light polarized with their electric vectors vibrating perpendicular and parallel to the scattering, respectively and \\(\\delta ^{0}\\) is the phase difference between these electric vectors." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes parameters" .

goldbook:S06031 a skos:Concept ;
    skos:definition "The difference (usually in frequency units) between the spectral positions of the band maxima (or the band origin) of the absorption and luminescence arising from the same electronic transition. Generally, the luminescence occurring at a longer wavelength than the absorption is stronger than the opposite. The latter may be called an anti-Stokes shift." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes shift" .

goldbook:S06032 a skos:Concept ;
    skos:definition "Fluorescence radiation occurring at wavelengths longer than absorption, i.e. the normal case, is said to be of the Stokes type." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Stokes type radiation" .

goldbook:S06033 a skos:Concept ;
    skos:definition "A technique for following the kinetics of reactions in solution (usually in the millisecond time range) in which two reactant solutions are rapidly mixed by being forced through a mixing chamber. The flow of the mixed solution along a uniform tube is then suddenly arrested. At a fixed position along the tube the solution is monitored (as a function of time following the stoppage of the flow) by some method with a rapid response (e.g. photometry)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stopped flow" .

goldbook:S06034 a skos:Concept ;
    skos:definition "A small-volume absorption cell connected to a rapid mixing chamber." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stopped-flow cell" .

goldbook:S06035 a skos:Concept ;
    skos:definition "Of a substance, for charged particles of specified energy, the average energy loss in passing through a thin layer of that substance, divided by the thickness of that layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stopping power" .

goldbook:S06036 a skos:Concept ;
    skos:altLabel "STP" ;
    skos:definition "Abbreviation for standard temperature (\\(273.15\\ \\rm{K}\\) or \\(0\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)) and pressure (\\(10^{5}\\ \\rm{Pa}\\)); usually employed in reporting gas volumes. Note that flow meters calibrated in standard gas volumes per unit time often refer to volumes at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\), not \\(0\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "STP" .

goldbook:S06037 a skos:Concept ;
    skos:altLabel "steric strain" ;
    skos:definition "Strain is present in a molecular entity or transition structure if the energy is enhanced because of unfavourable bond lengths, bond angles or dihedral angles ('torsional strain') relative to a standard. It is quantitatively defined as the standard enthalpy of a structure relative to a strainless structure (real or hypothetical) made up from the same atoms with the same types of bonding. (The enthalpy of formation of cyclopropane is \\(\\pu{53.6 kJ mol-1}\\), whereas the enthalpy of formation based on three 'normal' methylene groups, from acyclic models, is \\(\\pu{-62 kJ mol-1}\\). On this basis cyclopropane is destabilized by ca. \\(\\pu{115 kJ mol-1}\\) of strain energy.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "strain" .

goldbook:S06038 a skos:Concept ;
    skos:definition "A transition in a solid that is initiated by plastic strain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "strain-induced transition" .

goldbook:S06039 a skos:Concept ;
    skos:definition "A film in which more than two thicknesses coexist in a fixed configuration over significant periods of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratified film" .

goldbook:S06040 a skos:Concept ;
    skos:definition "A sample consisting of portions obtained from identified subparts (strata) of the parent population. Within each stratum, the samples are taken randomly. The objective of taking stratified samples is to obtain a more representative sample than that which might otherwise be obtained by random sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratified sample" .

goldbook:S06041 a skos:Concept ;
    skos:definition "A layer of patches composed of laminae or globular masses arranged in groups, lines or waves and having a soft, grey appearance; very often the rolls are so close together that their edges join and give the undersurface a wavy character; the process of formation (cumulogenesis) involves the spreading out of the tops of cumulus clouds, the latter having disappeared; \\(" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratocumulus cloud" .

goldbook:S06042 a skos:Concept ;
    skos:definition "That region of the atmosphere which lies between the stratosphere and the mesosphere and in which a maximum in the temperature occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratopause" .

goldbook:S06043 a skos:Concept ;
    skos:definition "The atmospheric shell lying just above the troposphere which is characterized by an increasing temperature with altitude. The stratosphere begins at the tropopause (about \\(10{-}15\\ \\rm{km}\\) height) and extends to a height of about \\(50\\ \\rm{km}\\), where the lapse rate changes sign at the stratopause and the beginning of the mesosphere." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratosphere" .

goldbook:S06044 a skos:Concept ;
    skos:definition "A uniform, featureless layer of cloud resembling fog but not resting on the ground; when this very low layer is broken up into irregular shreds, it is designated as fractostratus; \\(300{-}600\\ \\rm{m}\\); widespread irregular stirring and lifting of the shallow layer of cool, damp air near the ground." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stratus cloud" .

goldbook:S06045 a skos:Concept ;
    skos:definition "A spectrometer set to pass radiation of a particular wavelength band always has a small amount of stray radiation of other wavelengths. Since the sample may absorb more (or less) of this stray radiation than of the radiation at the selected wavelength an error can occur. This error is called a stray radiation error." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stray radiation error" .

goldbook:S06047 a skos:Concept ;
    skos:definition "An image converter adapted to provide scanning or time-resolved images. If the image is recorded the whole device is an example of a streak camera." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "streak tube" .

goldbook:S06049 a skos:Concept ;
    skos:definition "The electric current \\(I\\) flowing in a streaming cell if the electrodes, which are supposed to be ideally depolarized, are short-circuited. \\(I\\) is positive if the current in the membrane, plug, etc., is from high to low pressure side (and in the outside lead from low to high pressure side)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "streaming current" .

goldbook:S06050 a skos:Concept ;
    skos:altLabel "streaming potential" ;
    skos:definition "The potential difference \\(E_{\\mathrm{st}}\\) or \\(E\\) at zero current caused by the flow of liquid under a pressure gradient through a membrane, plug or capillary. Identical electrodes must be used on both sides of the membrane, plug, etc. \\(E\\) is positive if the higher potential is on the high pressure side." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "streaming potential difference" .

goldbook:S06051 a skos:Concept ;
    skos:definition "A transition that takes place when an applied stress assists the transition to the new phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress-assisted transition" .

goldbook:S06052 a skos:Concept ;
    skos:definition "The solid-state transformation of non-graphitic carbon into graphite by heat treatment combined with application of mechanical stress, resulting in a defined degree of graphitization being obtained at a lower temperature and/or after a shorter time of heat treatment than in the absence of applied stress." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stress graphitization" .

goldbook:S06054 a skos:Concept ;
    skos:altLabel "back extraction" ;
    skos:definition "The process of removing solute(s) from a loaded solvent or extract. Generally this refers to the main solute(s) present." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stripping" .

goldbook:S06057 a skos:Concept ;
    skos:definition "A chemical process, studied in a molecular beam, in which the reaction products are scattered forward with respect to the moving centre of mass of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stripping reaction" .

goldbook:S06059 a skos:Concept ;
    skos:definition "A collision between two molecules in which the amount of energy transferred from one to the other is large compared with \\(k_{\\rm{B}}\\ T\\), where \\(k_{\\rm{B}}\\) is the Boltzmann constant and \\(T\\) the absolute temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "strong collision" .

goldbook:S06061 a skos:Concept ;
    skos:definition "A formula which gives information about the way the atoms in a molecule are connected and arranged in space." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural formula" .

goldbook:S06062 a skos:Concept ;
    skos:definition "A reversible or irreversible transition that involves a change of the crystal structure. Example: The transition of $\\ce{NH4Cl}$ at $\\pu{469 K}$ from a $\\ce{CsCl}$-type structure to a $\\ce{NaCl}$-type structure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural transition" .

goldbook:S06063 a skos:Concept ;
    skos:definition "The distribution in space of the atoms or ions in the material part of the catalyst and, in particular, the distribution at the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure" .

goldbook:S06064 a skos:Concept ;
    skos:definition "Salts or charge-transfer complexes of styphnic acid (2,4,6-trinitrobenzene-1,3-diol)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "styphnates" .

goldbook:S06065 a skos:Concept ;
    skos:definition "An arbitrarily chosen contiguous sequence of constitutional units in a chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subchain" .

goldbook:S06066 a skos:Concept ;
    skos:altLabel "symmetry-breaking transition" ;
    skos:definition "A transition in which the space-group symmetry of the lower symmetry phase is a subgroup of that of the higher symmetry phase. Example: The transition of the low-temperature polymorph of quartz characterized by space-group symmetry \\(P3_{1}2\\) (trigonal), to the high temperature polymorph of quartz with space-group symmetry, \\(P6_{2}22\\) (hexagonal). Synonymous with 'symmetry-breaking transition' (note: this term, strictly speaking, is no longer in use)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subgroup-supergroup transition" .

goldbook:S06067 a skos:Concept ;
    skos:definition "The Next-to-Highest Occupied Molecular Orbital ('NHOMO', also called 'HOMO') and the Second Lowest Unoccupied Molecular Orbital (SLUMO). Subjacent orbitals are sometimes found to play an important role in the interpretation of molecular interactions according to the frontier orbital approach." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subjacent orbital" .

goldbook:S06068 a skos:Concept ;
    skos:definition "A flotation process in which the material of interest, adsorbed on the surface of gas bubbles in a liquid, is collected on an upper layer of immiscible liquid. There is no liquid-phase mixing in the bulk of the system; as a result recoveries can approach 100%." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sublation" .

goldbook:S06069 a skos:Concept ;
    skos:definition "The direct transition of a solid to a vapour without passing through a liquid phase. Example: The transition of solid $\\ce{CO2}$ to $\\ce{CO2}$ vapour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sublimation" .

goldbook:S06071 a skos:Concept ;
    skos:definition "A subsample may be: (a) a portion of the sample obtained by selection or division; (b) an individual unit of the lot taken as part of the sample; (c) the final unit of multistage sampling. The term 'subsample' is used either in the sense of a 'sample of a sample' or as a synonym for 'unit'. In practice, the meaning is usually apparent from the context or is defined." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subsample" .

goldbook:S06073 a skos:Concept ;
    skos:altLabel "ISO",
        "content" ;
    skos:definition "Amount-of-substance of a component divided by the mass of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substance content" .

goldbook:S06074 a skos:Concept ;
    skos:definition "Amount-of-substance of a component crossing a surface divided by the time. For clinical chemistry the term component is recommended. ISO uses 'substance'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substance flow rate" .

goldbook:S06075 a skos:Concept ;
    skos:altLabel "ISO" ;
    skos:definition "Ratio of the amount-of-substance of the component to the total amount-of-substance in the system containing the component." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substance fraction" .

goldbook:S06076 a skos:Concept ;
    skos:definition "An atom (group) that replaces one or more hydrogen atoms attached to a parent structure or characteristic group except for hydrogen atoms attached to a chalcogen atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substituent atom" .

goldbook:S06078 a skos:Concept ;
    skos:definition "A reaction, elementary or stepwise, in which one atom or group in a molecular entity is replaced by another atom or group. For example," ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substitution reaction" .

goldbook:S06079 a skos:Concept ;
    skos:definition "A name which indicates the exchange of one or more hydrogen atoms attached to a skeletal atom of a parent structure or to an atom of a characteristic group for another atom or group, which may be expressed by a suffix or by prefixes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substitutive name" .

goldbook:S06080 a skos:Concept ;
    skos:definition "Solvent extraction in which the amount of reagent used is lower than that dictated by stoichiometry. If the constants of formation and extraction of the complexes are high, the amount of extracted metal is dictated by the amount of extractant introduced." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substoichiometric extraction" .

goldbook:S06081 a skos:Concept ;
    skos:definition "A kind of isotope dilution analysis in which the final isotopic abundance is estimated from the amount of the nuclide present in a known quantity of the relevant element separated from the test portion, where this quantity is smaller than the total amount of that element present in the test portion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substoichiometric isotope dilution analysis" .

goldbook:S06082 a skos:Concept ;
    skos:definition "A chemical species, the reaction of which with some other chemical reagent is under observation (e.g. a compound that is transformed under the influence of a catalyst). The term should be used with care. Either the context or a specific statement should always make it clear which chemical species in a reaction is regarded as the substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substrate" .

goldbook:S06083 a skos:Concept ;
    skos:definition "The chemical entity whose conversion to a product or products is catalysed by one or several enzymes.A solution or dry mixture containing all ingredients which are necessary for the growth of a microbial culture or for product formation.Component in the nutrient medium, supplying the organisms with carbon (C-substrate), nitrogen (N-substrate), etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substrate" .

goldbook:S06084 a skos:Concept ;
    skos:definition "The terms substrate and subphase refer to a condensed phase that physically supports a film or layer. The term substrate should be used with care in the light of the existing double meaning of the term substrate in film science and technology, on the one hand, and in biochemistry, on the other. The term subphase applies, mainly, to a liquid phase underlying an adsorption layer or a floating spread monolayer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "substrate" .

goldbook:S06085 a skos:Concept ;
    skos:definition "A name for a modified parent structure in which prefixes and/or suffixes indicate the removal of atoms or groups and, where required, replacement by an appropriate number of hydrogen atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "subtractive name" .

goldbook:S06086 a skos:Concept ;
    skos:definition "The radical ion pair which forms by the transfer of an electron from the donor D to the acceptor A after these species have diffused together to form the precursor or encounter complex: \\[\\rm{A}+\\rm{D}\\rightarrow (\\rm{A D})\\rightarrow (\\rm{A}^{\\cdot - }\\rm{D}^{\\cdot +})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "successor complex" .

goldbook:S06088 a skos:Concept ;
    skos:definition "A loose term applied to monosaccharides and lower oligosaccharides." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sugars" .

goldbook:S06091 a skos:Concept ;
    skos:definition "$\\ce{H2NS(=O)2OH}$ (sulfamic acid) and its N-hydrocarbyl derivatives. Sulfamic acid is called sulfamidic acid in inorganic chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfamic acids" .

goldbook:S06092 a skos:Concept ;
    skos:definition "A term including hydropolysulfides, polysulfanes, polysulfides. Use is discouraged because of confusion with the newer systematic name sulfane, $\\ce{H2S}$, and the numerous names derived therefrom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfanes" .

goldbook:S06093 a skos:Concept ;
    skos:definition "Hydrogen sulfate esters of glycosphingolipids. Specific compounds should be named as glycerosphingolipid derivatives, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfatides" .

goldbook:S06094 a skos:Concept ;
    skos:altLabel "alkylsulfanylamines" ;
    skos:definition "Compounds derived from sulfenic acids, $\\ce{RSOH}$ ($\\ce{R}  eq \\ce{H}$), by replacement of $\\ce{–OH}$ by $\\ce{–NR2}$. May alternatively be considered as alkylsulfanylamines, e.g. $\\ce{C2H5SNH2}$ ethanesulfenamide or ethylsulfanylamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenamides" .

goldbook:S06095 a skos:Concept ;
    skos:definition "S,S-Dioxides of thioaldehydes and thioketones, $\\ce{R2C=SO2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenes" .

goldbook:S06096 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSOH}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{PhSOH}$ benzenesulfenic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenic acids" .

goldbook:S06097 a skos:Concept ;
    skos:definition "A term sometimes erroneously used for sulfenylium ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenium ions" .

goldbook:S06098 a skos:Concept ;
    skos:altLabel "sulfanyl groups" ;
    skos:definition "Groups having the structure $\\ce{RS–}$ ($\\ce{R}  eq \\ce{H}$). This term is derived from sulfenic acids. The synonymous term sulfanyl groups is derived from sulfane, $\\ce{H2S}$. E.g. $\\ce{CH3–S–}$ methanesulfenyl, methylthio or methylsulfanyl." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenyl groups" .

goldbook:S06099 a skos:Concept ;
    skos:altLabel "sulfanylium ions" ;
    skos:definition "Cations having the structure $\\ce{RS^{+}}$ ($\\ce{R}  eq \\ce{H}$). This term is derived from sulfenic acids. The synonymous term sulfanylium ions is derived from sulfane, $\\ce{H2S}$. E.g. $\\ce{CH3S^{+}}$ methylsulfanylium or methanesulfenylium ion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenylium ions" .

goldbook:S06101 a skos:Concept ;
    skos:altLabel "alkylthio radical",
        "sulfanyl radicals",
        "thiyl radicals" ;
    skos:definition "Sulfur-centered radicals having the structure $\\ce{RS^{.}}$ ($\\ce{R}  eq \\ce{H}$). This term is derived from sulfenic acids. The synonymous term sulfanyl radicals is derived from sulfane, $\\ce{H2S}$. E.g. $\\ce{CH3S^{.}}$ methylsulfanyl or methanesulfenyl radical. An older synonymous term is alkylthio radical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfenyl radicals" .

goldbook:S06102 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RSR}$ ($\\ce{R  eq H}$). Such compounds were once called thioethers.See also: thioacetalsIn an inorganic sense, salts or other derivatives of hydrogen sulfide.A term used in additive nomenclature, see imides (2)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfides" .

goldbook:S06104 a skos:Concept ;
    skos:altLabel "sulfilimines",
        "sulfimines",
        "sulfinimines" ;
    skos:definition "$\\ce{H2S=NH}$, sulfimide, and its hydrocarbyl derivatives. They are thus related to sulfoxides in the same way that imines are related to aldehydes or ketones, e.g. $\\ce{(C2H5)2S=NPh}$ S,S-diethyl-N-phenylsulfimide.A term used in Chemical Abstracts Service Index Nomenclature for sulfonylamines, $\\ce{RN=S(=O)2}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfimides" .

goldbook:S06106 a skos:Concept ;
    skos:definition "Amides of sulfinic acids, $\\ce{RS(=O)OH}$; thus $\\ce{RS(=O)NR2}$, e.g. $\\ce{PhS(=O)NHCH3}$ N-methylbenzenesulfinamide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfinamides" .

goldbook:S06107 a skos:Concept ;
    skos:definition "Amidines of sulfinic acids, $\\ce{RS(=O)OH}$; thus $\\ce{RS(=NR)NR}$, e.g. $\\ce{PhS(=NH)NH2}$ benzenesulfinamidine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfinamidines" .

goldbook:S06109 a skos:Concept ;
    skos:definition "$\\ce{HS(=O)OH}$, sulfinic acid, and its S-hydrocarbyl derivatives, e.g. $\\ce{(CH3)2CHS(=O)OH}$ propane-2-sulfinic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfinic acids" .

goldbook:S06110 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RS(=O)OS(=O)R}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfinic anhydrides" .

goldbook:S06112 a skos:Concept ;
    skos:altLabel "thionylamines" ;
    skos:definition "Compounds having the structure $\\ce{RN=S=O}$. Formerly called thionylamines." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfinylamines" .

goldbook:S06113 a skos:Concept ;
    skos:definition "Sulfate esters of glycolipids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfolipids" .

goldbook:S06114 a skos:Concept ;
    skos:definition "Amides of sulfonic acids $\\ce{RS(=O)2NR'2}$, e.g. $\\ce{PhS(=O)2NHCH3}$ N-methylbenzenesulfonamide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonamides" .

goldbook:S06115 a skos:Concept ;
    skos:definition "A term abandoned because of its ambiguous use to mean either $\\ce{RS(=O)=NH2}$ (sulfonimidamide) or $\\ce{RS(=NH)2=NH2}$ (sulfonodiimidamide)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonamidines" .

goldbook:S06116 a skos:Concept ;
    skos:definition "Compounds having the structure, $\\ce{RS(=NR)2R}$, formally derived from sulfones by replacing $\\ce{(=O)2}$ by $\\ce{(=NR)2}$, e.g. $\\ce{Ph2S(=NH)2}$ diphenyl sulfonediimine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonediimines" .

goldbook:S06117 a skos:Concept ;
    skos:definition "Compounds having the structure, $\\ce{RS(=O)2R}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{C2H5S(=O)2CH3}$ ethyl methyl sulfone." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfones" .

goldbook:S06118 a skos:Concept ;
    skos:definition "$\\ce{HS(=O)2OH}$, sulfonic acid, and its S-hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonic acids" .

goldbook:S06119 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RS(=O)2OS(=O)2R'}$, e.g. $\\ce{PhS(=O)2OS(=O)2Ph}$ benzenesulfonic anhydride." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonic anhydrides" .

goldbook:S06121 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R3S+}$ and associated anion (generally, but not necessarily, all three $\\ce{R}$ groups are hydrocarbyl). E.g. $\\ce{[(CH3)3S]^{+}Cl^{−}}$, trimethylsulfonium chloride, or" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonium compounds" .

goldbook:S06122 a skos:Concept ;
    skos:definition "3,3-Bis(hydroxyaryl)-3H-2,1-benzoxathiole S,S-dioxides, formed by condensation of o-sulfobenzoic acid with phenols or related compounds, e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonphthaleins" .

goldbook:S06123 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RN=S(=O)2}$. (Indexed by Chemical Abstracts Service at the heading sulfimide). E.g. $\\ce{CH3N=S(=O)2}$ N-sulfonylmethylamine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfonylamines" .

goldbook:S06124 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2S=O}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{Ph2S=O}$ diphenyl sulfoxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfoxides" .

goldbook:S06125 a skos:Concept ;
    skos:altLabel "sulfonimides",
        "sulfoximines" ;
    skos:definition "Compounds having the structure $\\ce{R2S(=O)=NR}$. (Indexed by Chemical Abstracts Service at the heading sulfoximines). E.g. $\\ce{(CH3)2S(=O)=NPh}$ S,S-dimethyl-N-phenylsulfoximide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfoximides" .

goldbook:S06127 a skos:Concept ;
    skos:definition "The parent compound $\\ce{HN=S=NH}$ and hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sulfur diimides" .

goldbook:S06128 a skos:Concept ;
    skos:definition "Sulfonamides in which the S-N bond is part of a ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sultams" .

goldbook:S06129 a skos:Concept ;
    skos:definition "Tautomeric forms of sultams, having a sulfur–nitrogen double bond as part of a ring." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sultims" .

goldbook:S06130 a skos:Concept ;
    skos:definition "Intramolecular cyclic esters of hydroxy sulfinic acids. (Named by supposed analogy with lactones and sultones; but the -ine ending is unfortunate)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sultines" .

goldbook:S06131 a skos:Concept ;
    skos:definition "Intramolecular cyclic esters of hydroxy sulfonic acids, analogous to lactones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sultones" .

goldbook:S06132 a skos:Concept ;
    skos:definition "In ac polarography, differential pulse polarography, derivative polarography, square-wave polarography, and similar techniques, the maximum value of the component of the current that is associated with the presence of a substance B. Normally this component of the current is faradaic, and the maximum arises because the rate of variation (with applied potential) of the rate of the charge-transfer process passes through a maximum. Similar maxima arise when this component is non-faradaic (and when B is surface-active rather than electroactive). In a case known to be of the latter type, the term apex current is recommended as being more specific." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "summit current" .

goldbook:S06133 a skos:Concept ;
    skos:definition "In ac polarography, differential pulse polarography, derivative polarography, and similar techniques, the potential of the indicator electrode at which the summit current is attained." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "summit potential" .

goldbook:S06134 a skos:Concept ;
    skos:definition "The total number of states for a system corresponding to an energy \\(\\varepsilon\\) less than or equal to a specified value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sum of states" .

goldbook:S06135 a skos:Concept ;
    skos:definition "A medium having a high acidity, generally greater than that of 100 wt.% sulfuric acid. The common superacids are made by dissolving a powerful Lewis acid (e.g. $\\ce{SbF5}$) in a suitable Brønsted acid such as $\\ce{HF}$ or $\\ce{HSO3F}$. (An equimolar mixture of $\\ce{HSO3F}$ and $\\ce{SbF5}$ is known by the trade name 'magic acid'.) In a biochemical context 'superacid catalysis' is sometimes used to denote catalysis by metal ions analogous to catalysis by hydrogen ions. By analogy, a compound having a very high basicity, such as lithium diisopropylamide, is called a 'superbase'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superacid" .

goldbook:S06137 a skos:Concept ;
    skos:definition "A transition at the critical temperature, \\(T_{\\rm{c}}\\), below which the resistance of electrical conductors becomes zero and magnetic flux is excluded." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superconducting transition" .

goldbook:S06138 a skos:Concept ;
    skos:definition "The defined state of a compound, mixture or element above its critical pressure (\\(p_{\\rm{c}}\\)) and critical temperature (\\(T_{\\rm{c}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercritical fluid" .

goldbook:S06139 a skos:Concept ;
    skos:altLabel "SFC" ;
    skos:definition "A separation technique in which the mobile phase is a fluid above and relatively close to its critical temperature and pressure. In general the terms and definitions used in gas or liquid chromatography are equally applicable to supercritical fluid chromatography." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercritical fluid chromatography" .

goldbook:S06140 a skos:Concept ;
    skos:definition "This occurs when the specifically adsorbed amount of charge in the inner Helmholtz plane is higher than the charge on the metal phase, taken with the reverse sign." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superequivalent adsorption" .

goldbook:S06141 a skos:Concept ;
    skos:definition "Electronic interaction between two molecular entities mediated by one or more different molecules or ions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superexchange interaction" .

goldbook:S06142 a skos:Concept ;
    skos:definition "The reversible work of formation of unit area of new surface by cleavage. It has previously been called specific surface work, surface energy, surface tension or surface free energy. The symbol recommended is \\(\\gamma _{\\pi }\\) in preference to \\(\\sigma \\) because of the confusion with surface charge density. The superficial work \\(\\gamma _{\\pi }\\) is a scalar quantity and consequently is isotropic." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superficial work" .

goldbook:S06143 a skos:Concept ;
    skos:definition "A periodic multilayer which is synthetic and where a unit cell, consisting of successive layers that are chemically different from their adjacent neighbours, is repeated. The term quantum well multilayer applies to the superlattices with artificially created electronic band structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superlattice" .

goldbook:S06144 a skos:Concept ;
    skos:definition "The ability to bring two particular stereochemical formulae (or models) into coincidence (or to be exactly superposable in space, and for the corresponding molecular entities or objects to become exact replicas of each other) by no more than translation and rigid rotation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superposability" .

goldbook:S06145 a skos:Concept ;
    skos:definition "Spontaneous emission amplified by a single pass through a population inverted medium. It is distinguished from true laser action by its lack of coherence. The term superradiance is frequently used in laser technology." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superradiance" .

goldbook:S06146 a skos:Concept ;
    skos:definition "In chemistry, an unstable system which has a greater concentration of a material in solution than would exist at equilibrium is said to be supersaturated.In meteorology, supersaturation of an air mass with respect to $\\ce{H2O}$ vapour is of special interest. It is the saturation ratio minus one, or the percent supersaturation is the percent relative humidity minus 100." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supersaturation" .

goldbook:S06147 a skos:Concept ;
    skos:definition "In multiphase catalysts, the active catalytic material is often present as the minor component dispersed upon a support sometimes called a carrier. The support may be catalytically inert but it may contribute to the overall catalytic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "support" .

goldbook:S06148 a skos:Concept ;
    skos:altLabel "SCOT",
        "SCOT column" ;
    skos:definition "A version of a porous-layer open-tabular (PLOT) column in which the porous layer consists of support particles and was deposited from a suspension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "support-coated open-tubular column" .

goldbook:S06149 a skos:Concept ;
    skos:definition "An electrolyte solution, whose constituents are not electroactive in the range of applied potentials being studied, and whose ionic strength (and, therefore, contribution to the conductivity) is usually much larger than the concentration of an electroactive substance to be dissolved in it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supporting electrolyte" .

goldbook:S06153 a skos:Concept ;
    skos:definition "A system of two or more molecular entities held together and organized by means of intermolecular (noncovalent) binding interactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supramolecule" .

goldbook:S06154 a skos:Concept ;
    skos:definition "The boundary between two phases. It is recommended that for the purpose of surface analysis a distinction be made between 'surface' in general, 'physical surface' and 'experimental surface': Surface — The 'outer portion' of a sample of undefined depth; to be used in general discussions of the outside regions of the sample. Physical Surface — That atomic layer of a sample which, if the sample were placed in a vacuum, is the layer 'in contact with' the vacuum; the outermost atomic layer of a sample. Experimental Surface — That portion of the sample with which there is significant interaction with the particles or radiation used for excitation. It is the volume of sample required for analysis or the volume corresponding to the escape for the emitted radiation or particle, whichever is larger." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface" .

goldbook:S06157 a skos:Concept ;
    skos:definition "A semiconductor detector utilizing a junction due to a surface inversion layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface barrier semiconductor detector" .

goldbook:S06161 a skos:Concept ;
    skos:definition "Defined by: \\[\\mu _{i}^{\\sigma }=(\\frac{\\partial A^{\\sigma }}{\\partial n_{i}^{\\sigma }})_{T,A_{\\rm{S}},n_{j}^{\\sigma }}=(\\frac{\\partial G^{\\sigma }}{\\partial n_{i}^{\\sigma }})_{T,p,\\gamma ,n_{j}^{\\sigma }}\\] \\[\\mu _{i}^{\\rm{S}}=(\\frac{\\partial A^{\\rm{S}}}{\\partial n_{i}^{\\rm{S}}})_{T,V^{\\rm{S}},A_{\\rm{S}},n_{j}^{\\rm{S}}}=(\\frac{\\partial G^{\\rm{S}}}{\\partial n_{i}^{\\rm{S}}})_{T,p,\\gamma ,n_{j}^{\\rm{S}}}\\] where \\(A^{\\sigma }\\) is the surface excess Helmholtz energy, \\(G^{\\sigma }\\) is the surface excess Gibbs energy, \\(A^{\\rm{S}}\\) is the interfacial Helmholtz energy, \\(G^{\\rm{S}}\\) is the interfacial Gibbs energy, and \\(A_{\\rm{S}}\\) is the surface area. The quantities thus defined can be shown to be identical, and the conditions of equilibrium of component \\(i\\) in the system to be \\[\\mu _{i}^{\\alpha }=\\mu _{i}^{\\sigma }=\\mu _{i}^{\\rm{S}}=\\mu _{i}^{\\beta }\\] where \\(\\mu _{i}^{\\alpha }\\) and \\(\\mu _{i}^{\\beta }\\) are the chemical potentials of \\(i\\) in the bulk phases $\\ce{\\upalpha\\!}$ and $\\ce{\\upbeta\\!}$. (\\(\\mu _{i}^{\\alpha }\\) or \\(\\mu _{i}^{\\beta }\\) have to be omitted from this equlibrium condition if component \\(i\\) is not present in the respective bulk phase.) The surface chemical potentials are related to the Gibbs energy functions by the equations \\[G^{\\sigma }=\\sum _{\\begin{array}{c} i \\end{array}}n_{i}^{\\sigma }\\ \\mu _{i}^{\\sigma }\\] \\[G^{\\rm{S}}=\\sum _{\\begin{array}{c} i \\end{array}}n_{i}^{\\rm{S}}\\ \\mu _{i}^{\\rm{S}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface chemical potential" .

goldbook:S06163 a skos:Concept ;
    skos:definition "The excess conductivity in a surface per unit length and width, symbol \\(\\kappa ^{\\sigma }\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess conductivity" .

goldbook:S06164 a skos:Concept ;
    skos:definition "Material in the experimental surface which is either not characteristic of the sample or which would not be present if the sample had been prepared in an absolute vacuum by methods not contacting other substances to the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface contamination" .

goldbook:S06165 a skos:Concept ;
    skos:definition "Number of adsorbed molecules on a surface divided by the number of molecules in a filled monolayer on that surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface coverage" .

goldbook:S06166 a skos:Concept ;
    skos:definition "In a diagram of electronic energy versus molecular geometry, the electronic energies of two states of different symmetry may be equal at certain geometrical parameters. At this point (unidimensional representation), line or surface (more than one dimension), the two potential-energy surfaces are said to cross one another." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface crossing" .

goldbook:S06167 a skos:Concept ;
    skos:definition "Mass divided by area." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface density" .

goldbook:S06169 a skos:Concept ;
    skos:definition "Particles in the surface region of a phase are subjected to orienting forces as a result of the anisotropic force field. Polar molecules (e.g. permanent dipoles) may thus be preferentially oriented in the surface region, while polarizable molecules may be polarized (induced dipoles). The array of oriented polar and/or polarized molecules is called the surface dipole layer with which an electric potential drop is associated, called the surface potential of the phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface dipole layer" .

goldbook:S06170 a skos:Concept ;
    skos:definition "Given by \\[\\chi ^{\\beta} = \\mathit{\\Phi }^{\\beta} - \\psi ^{\\beta}\\] where \\(\\psi ^{\\beta }\\) and \\(\\mathit{\\Phi} ^{\\beta}\\) are the outer and inner electric potentials of phase $\\ce{\\upbeta\\!}$, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface electric potential" .

goldbook:S06171 a skos:Concept ;
    skos:definition "For an interface, the adsorption or surface excess of a given component is defined as the difference between the amount of component actually present in the system, and that which would be present (in a reference system) if the bulk concentration in the adjoining phases were maintained up to a chosen geometrical dividing surface (Gibbs dividing surface). For a solid/liquid interface in which no component of the liquid phase penetrates into the solid, the surface excess (or adsorption) of component i is defined as: \\[n_{i}^{\\sigma }=n_{i}- V^{\\rm{l}}\\ c_{i}^{\\rm{l}}\\] where \\(n_{i}\\) is the total amount of i in the system, \\(V^{\\rm{l}}\\) is the volume of an arbitrarily chosen amount of bulk liquid (in the framework of the so-called algebraic method) and \\(c_{i}^{\\rm{l}}\\) is its bulk concentration in the liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess" .

goldbook:S06172 a skos:Concept ;
    skos:definition "A quantity defined by \\[\\mathit{\\Gamma}_{i} = \\frac{n_{i}^{\\sigma }}{A_{\\rm{s}}}\\] where \\(n_{i}^{\\sigma}\\) is the surface excess (or adsorption) of component \\(i\\) and \\(A_{\\rm{s}}\\) is the area of the dividing surface or interface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess concentration" .

goldbook:S06173 a skos:Concept ;
    skos:definition "Defined by: \\[U^{\\unicode[Times]{x3C3} } = U - U^{\\unicode[Times]{x3B1} }- U^{\\unicode[Times]{x3B2} }= U - V^{\\unicode[Times]{x3B1} }\\ \\frac{U_{\\rm{m}}^{\\unicode[Times]{x3B1} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B1} }} - V^{\\unicode[Times]{x3B2} }\\ \\frac{U_{\\rm{m}}^{\\unicode[Times]{x3B2} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B2} }}\\] where \\(V^{\\unicode[Times]{x3B1} }\\) and \\(V^{\\unicode[Times]{x3B2} }\\) satisfy the condition \\(V^{\\unicode[Times]{x3B1} } + V^{\\unicode[Times]{x3B2} } = V\\), the total volume of the system. (\\(\\frac{U_{\\rm{m}}^{\\unicode[Times]{x3B1} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B1} }}\\)) and (\\(\\frac{U_{\\rm{m}}^{\\unicode[Times]{x3B2} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B2} }}\\)) are the energy densities in the two bulk phases where \\(U_{\\rm{m}}^{\\unicode[Times]{x3B1} }\\) and \\(U_{\\rm{m}}^{\\unicode[Times]{x3B2} }\\) are the mean molar energies and \\(V_{\\rm{m}}^{\\unicode[Times]{x3B1} }\\) and \\(V_{\\rm{m}}^{\\unicode[Times]{x3B2} }\\) are the mean molar volumes of the two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess energy" .

goldbook:S06174 a skos:Concept ;
    skos:definition "Defined by: \\[H^{\\sigma }=U^{\\sigma }- \\gamma \\ A_{\\rm{s}}\\] where \\(U^{\\sigma }\\) is the surface excess energy, \\(\\gamma \\) is the surface tension, and \\(A_{\\rm{s}}\\) is the area relative to a Gibbs surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess enthalpy" .

goldbook:S06175 a skos:Concept ;
    skos:definition "Defined by: \\[S^{\\unicode[Times]{x3C3}} = S - S^{\\unicode[Times]{x3B1} }- S^{\\unicode[Times]{x3B2} }=S- V^{\\unicode[Times]{x3B1} }\\ \\frac{S_{\\rm{m}}^{\\unicode[Times]{x3B1} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B1} }}- V^{\\unicode[Times]{x3B2} }\\ \\frac{S_{\\rm{m}}^{\\unicode[Times]{x3B2} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B2} }}\\] (\\(\\frac{S_{\\rm{m}}^{\\unicode[Times]{x3B1} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B1} }}\\)) and (\\(\\frac{S_{\\rm{m}}^{\\unicode[Times]{x3B2} }}{V_{\\rm{m}}^{\\unicode[Times]{x3B2} }}\\)) are the entropy densities in the two bulk phases, where \\(S_{\\rm{m}}^{\\unicode[Times]{x3B1} }\\) and \\(S_{\\rm{m}}^{\\unicode[Times]{x3B2} }\\) are the mean molar entropies and \\(V_{\\rm{m}}^{\\unicode[Times]{x3B1} }\\) and \\(V_{\\rm{m}}^{\\unicode[Times]{x3B2} }\\) are the mean molar volumes of the two phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess entropy" .

goldbook:S06176 a skos:Concept ;
    skos:definition "Defined by \\[G^{\\sigma }=H^{\\sigma }- T\\ S^{\\sigma }=A^{\\sigma }- \\gamma \\ A_{\\rm{s}}\\] where \\(H^{\\sigma }\\) is the surface excess enthalpy, \\(T\\) is the thermodynamic temperature, \\(S^{\\sigma }\\) is the surface excess entropy, \\(A^{\\sigma }\\) is the surface excess Helmholtz energy, \\(\\gamma \\) is the surface tension, and \\(A_{\\rm{s}}\\) is the area relative to a Gibbs surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess Gibbs energy" .

goldbook:S06177 a skos:Concept ;
    skos:definition "Defined by: \\[A^{\\sigma }=U^{\\sigma }- T\\ S^{\\sigma }\\] where \\(U^{\\sigma }\\) is the surface excess energy, \\(T\\) is the thermodynamic temperature, and \\(S^{\\sigma }\\) is the surface excess entropy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess Helmholtz energy" .

goldbook:S06178 a skos:Concept ;
    skos:definition "The function relating, at constant temperature and pressure, \\(\\mathit{\\Gamma}_{i}^{\\left(\\rm{n}\\right)}\\), \\(\\mathit{\\Gamma}_{i}^{\\left(\\rm{l}\\right)}\\) or \\(\\mathit{\\Gamma}_{i}^{\\left(\\rm{v}\\right)}\\), or the respective specific quantities \\(\\frac{n^{\\rm{l}}\\ \\Delta x_{i}^{\\rm{l}}}{m}\\), \\(\\frac{A_{\\rm{s}}\\ \\mathit{\\Gamma }_{i}^{\\left(\\rm{l}\\right)}}{m}\\) or \\(\\frac{V^{\\rm{l}}\\ \\Delta c_{i}^{\\rm{l}}}{m}\\) to the mole fraction (or concentration) of component \\(i\\) in the equilibrium liquid phase. With solutions of more than two components such isotherms are unequivocal functions only when the ratios of the mole fractions (or concentrations) of all other components except \\(i\\) are kept constant. (\\(A_{\\rm{s}}\\) is the area of interface, \\(\\mathit{\\Gamma}_{i}^{\\left(\\rm{n}\\right)}\\), \\(\\mathit{\\Gamma}_{i}^{\\left(\\rm{l}\\right)}\\), \\(\\mathit{\\Gamma}_{i}^{\\left(\\rm{v}\\right)}\\) are relative adsorptions, \\(\\Delta x_{i}^{\\rm{l}}\\) is the change in mole fraction of \\(i\\) resulting from bringing a specified mass \\(m\\) of solid into contact with a specified amount of solution \\(n^{\\rm{l}}\\), \\(\\Delta c_{i}^{\\rm{l}}\\) is the change in concentration resulting from bringing a specified mass of solid into contact with a specified amount of solution of volume \\(V^{\\rm{l}}\\).)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface excess isotherm" .

goldbook:S06179 a skos:Concept ;
    skos:definition "Takes place when an atom or molecule is ionized when it interacts with a solid surface. ionization occurs only when the work function of the surface, the temperature of the surface, and the ionization energy of the atom or molecule have an appropriate relationship." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface ionization" .

goldbook:S06180 a skos:Concept ;
    skos:definition "Ions that are constituents of the surface or which have a particularly high affinity for the surface or surface sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface ions" .

goldbook:S06181 a skos:Concept ;
    skos:altLabel "interfacial layer" ;
    skos:definition "The region of space comprising and adjoining the phase boundary within which the properties of matter are significantly different from the values in the adjoining bulk phases." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface layer" .

goldbook:S06182 a skos:Concept ;
    skos:altLabel "free surface" ;
    skos:definition "The plane ideally marking the boundary between a phase and its environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface of a phase" .

goldbook:S06183 a skos:Concept ;
    skos:definition "The mechanical properties of an interfacial layer between two fluid phases may be expressed in terms of those of a geometrical surface of uniform tension called the surface of tension, whose location is dependent on the distribution of the stress tensor within the interfacial layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface of tension" .

goldbook:S06185 a skos:Concept ;
    skos:definition "The change of interfacial tension caused by addition of a given species to a base solution. When an area of liquid covered with a spread substance is separated from a clean area of surface by a mechanical barrier, the force acting on unit length of the barrier is called the surface pressure, \\(\\pi \\) or \\(\\pi _{\\rm{s}}\\), and is equal to \\(\\gamma ^{0} - \\gamma \\) where \\(\\gamma ^{0}\\) is the surface tension of the clean surface and \\(\\gamma \\) that of the covered surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface pressure" .

goldbook:S06187 a skos:Concept ;
    skos:definition "The tridimensional region, extending from the free surface of a condensed phase towards the interior, where the properties differ from the bulk. The term surface may also be used in this sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface region" .

goldbook:S06189 a skos:Concept ;
    skos:definition "For steady state deformations a surface shear viscosity \\(\\eta ^{\\rm{s}}\\), and an area viscosity or surface dilatational viscosity \\(\\zeta ^{\\rm{s}}\\) can be defined. In a Cartesian system with the x-axis normal to the surface, they are defined by the equations: \\[\\eta ^{\\rm{s}} = \\frac{\\sigma _{xy}}{\\frac{\\partial  u_{y}}{\\partial  u_{x}}}\\] \\[\\zeta ^{\\rm{s}}=\\frac{\\Delta \\gamma }{\\frac{\\mathrm{d}(\\ln A)}{\\mathrm{d}t}}\\] where \\(\\sigma _{xy}\\) is the shear component of the surface stress tensor, \\( u_{x}\\) and \\( u_{y}\\) are the \\(x\\) and \\(y\\) components of the surface velocity vector, respectively, \\(A\\) is the surface area, \\(t\\) is the time, and \\(\\Delta \\gamma \\) is the difference between the (steady state) dynamic surface tension and the equilibrium surface tension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface shear viscosity" .

goldbook:S06190 a skos:Concept ;
    skos:definition "Energy levels localized in the surface region of semiconductors, which do not bear any direct relation to the bulk energy distribution, but which can exchange electrons with the bulk. In such a case a space charge may arise even when \\(\\sigma \\) (the free charge density) is zero, i.e. \\(\\sigma =\\sigma _{\\mathrm{sc}}+\\sigma _{\\mathrm{ss}}\\), where \\(\\sigma _{\\mathrm{sc}}\\) is the space charge density and \\(\\sigma _{\\mathrm{ss}}\\) is the charge density associated with the surface states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface states" .

goldbook:S06191 a skos:Concept ;
    skos:definition "The work required to form unit area of new surface by stretching under equilibrium conditions. It is numerically equal to the force acting in the jth direction per unit length of exposed edge, the edge being normal to the ith direction, that must be applied to a terminating surface to keep it in equilibrium, the ith and jth directions lying in the plane of the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface stress" .

goldbook:S06192 a skos:Concept ;
    skos:definition "Work required to increase a surface area divided by that area. When two phases are studied it is often called interfacial tension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface tension" .

goldbook:S06193 a skos:Concept ;
    skos:definition "Surface tension is the intensive factor in the differential expression for the work required to increase the area of the surface of tension. Measured under reversible conditions at constant temperature (and normally constant pressure) and referred to unit area, this work, the so-called (differential) surface work, is equal to the static surface tension." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface work" .

goldbook:S06194 a skos:Concept ;
    skos:altLabel "surface active agent" ;
    skos:definition "A substance which lowers the surface tension of the medium in which it is dissolved, and/or the interfacial tension with other phases, and, accordingly, is positively adsorbed at the liquid/vapour and/or at other interfaces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surfactant" .

goldbook:S06195 a skos:Concept ;
    skos:definition "A function relating the prior distribution \\(P_{0}\\) of product states to an observed or calculated product distribution P. It is defined by: \\[s=- \\ln (\\frac{P}{P_{0}})\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surprisal" .

goldbook:S06196 a skos:Concept ;
    skos:definition "The study of product state distributions in terms of surprisal has been referred to as surprisal analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surprisal analysis" .

goldbook:S06197 a skos:Concept ;
    skos:definition "All particulate material which persists in the atmosphere or in a flue gas stream for lengthy periods because the particles are too small in size to have an appreciable falling velocity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspended matter" .

goldbook:S06198 a skos:Concept ;
    skos:definition "A liquid in which solid particles are dispersed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension" .

goldbook:S06199 a skos:Concept ;
    skos:definition "An effect which occurs when ion-selective electrodes are used in concentrated, space-filled suspensions while the external reference electrode remains in the supernatant (suspension-free) solution. The suspensions are specifically solvent-swollen ion exchangers or other materials, like soils and clays, that concentrate ions by adsorption and absorption. Space-filled, gravity-packed suspensions act like a second phase and form apparently an interfacial potential difference (PD) with respect to the supernatant. The measured ion activity in the suspension differs from the value in the supernatant by the interfacial PD, and corresponds to a higher value approximating the activity inside the ion exchanger gel. The effect nearly disappears when the outer reference electrode is placed in the same region of the suspension as the sensor electrode. There are some changes in the junction potential differences of the reference electrode, between suspension and supernatant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "suspension effect" .

goldbook:S06200 a skos:Concept ;
    skos:definition "A dual parameter approach to the correlation analysis of substituent effects, which involves a field constant (\\(F\\)) and a resonance constant (\\(R\\)). The original treatment was modified later. The procedure has been considerably applied, but also much criticized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Swain–Lupton equation" .

goldbook:S06201 a skos:Concept ;
    skos:definition "The linear free-energy relation of the form: \\[\\log _{10}(\\frac{k}{k_{0}})=s\\ n\\] applied to the variation of reactivity of a given electrophilic substrate towards a series of nucleophilic reagents. \\(n\\) is characteristic of the reagent (i.e. a measure of its nucleophilicity) and \\(s\\) is characteristic of the substrate (i.e. a measure of its sensitivity to the nucleophilicity of the reagent). A scale of \\(n\\) values is based on the rate coefficients \\(k\\) for the reaction of methyl bromide with nucleophiles in water at \\(25\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\), \\(s\\) being defined as 1.00 for these reactions and \\(n\\) being defined as 0.00 for the hydrolysis of methyl bromide. (Other scales have been devised.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Swain–Scott equation" .

goldbook:S06202 a skos:Concept ;
    skos:definition "The increase in volume of a gel or solid associated with the uptake of a liquid or gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "swelling" .

goldbook:S06203 a skos:Concept ;
    skos:definition "That pressure difference \\(\\mathit{\\Pi} _{\\rm{sw}}\\) or \\(\\mathit{\\Pi}\\) which has to be established between a gel and its equilibrium liquid, to prevent further swelling of the gel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "swelling pressure" .

goldbook:S06205 a skos:Concept ;
    skos:definition "A transition in semiconductive glasses in which, beyond a critical applied voltage, there is an avalanche breakdown of conducting electrons that causes local melting and hence local crystallization that gives metallic conductivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "switching transition" .

goldbook:S06206 a skos:Concept ;
    skos:definition "Imines of sydnones (i.e. having an imino group in place of the exocyclic oxygen atom).  (These structures represent only two canonical forms.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sydnone imines" .

goldbook:S06207 a skos:Concept ;
    skos:definition "Mesoionic compounds having the 1,2,3-oxadiazole skeleton bearing an oxygen atom attached to the 5 position.  (These structures represent only two canonical forms)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sydnones" .

goldbook:S06208 a skos:Concept ;
    skos:definition "An affix used in names to denote symmetrical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>sym</i>-" .

goldbook:S06209 a skos:Concept ;
    skos:definition "The term was originally applied to describe the maximum flocking of either hard or soft ligands in the same complexes. For hydrocarbon molecules, symbiosis implies that those containing a maximum number of $\\ce{C–H}$ bonds (e.g. $\\ce{CH4}$) or $\\ce{C–C}$ bonds (e.g. $\\ce{Me4C}$) are the most stable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symbiosis" .

goldbook:S06210 a skos:Concept ;
    skos:definition "Conventional sign designating a quantity or a unit of measurement." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symbol" .

goldbook:S06211 a skos:Concept ;
    skos:definition "The properties of fluid films depend on the nature of the film phase and that of each of the two neighbouring bulk phases. These films should be described, where appropriate, by three capital letters such as A for air, W for water, O for oil, and S for solid, separated by solidi, the middle letter indicating the film phase. For symmetrical films the first and last symbols are the same, e.g. A/W/A: water film in air, or W/O/W: oil film in water, whereas for unsymmetrical films these are different, e.g. W/O/A: oil film between water and air." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetrical films" .

goldbook:S06213 a skos:Concept ;
    skos:definition "A transition in which the cell dimensions and/or angles of the one phase differ from those in the other phase, but where the space-group symmetry is conserved. Example: The transition of face-centred cubic $\\ce{Ce}$, upon cooling, to a face-centred cubic phase that is $\\pu{10\\%}$ denser. Upon cooling, enough contraction takes place to allow an overlap of the \\(\\rm{fsp}^{2}\\) configuration and the change from an isolated non-bonding magnetic f electron to a bonding non-magnetic electron pair." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetry-conserving transition" .

goldbook:S06214 a skos:Concept ;
    skos:definition "The symmetry number of a molecule is obtained by imagining all identical atoms to be labelled, and then counting the number of different but equivalent arrangements that can be obtained by rotating (but not reflecting) the molecule. In the statistical-mechanical treatment of chemical equilibrium, the partition function for each molecular species must be divided by its symmetry number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "symmetry number" .

goldbook:S06216 a skos:Concept ;
    skos:definition "See: torsion angleSee: endo, exo, syn, antiSee: antiFormerly used to describe the stereochemistry of oximes and related systems.See: E, Z" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>syn</i>" .

goldbook:S06218 a skos:Concept ;
    skos:definition "This principle applies to reactions in which there is a lack of synchronization between bond formation or bond rupture and other primitive changes that affect the stability of products and reactants, such as resonance, solvation, electrostatic, hydrogen bonding and polarizability effects. The principle states that a product-stabilizing factor whose development lags behind bond changes at the transition state, or a reactant-stabilizing factor whose loss is ahead of bond changes at the transition state, increases the intrinsic barrier and decreases the 'intrinsic rate constant' of a reaction. For a product-stabilizing factor whose development is ahead of bond changes, or reactant factors whose loss lags behind bond changes, the opposite relations hold. The reverse effects are observable for factors that destabilize a reactant or product." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synchronization" .

goldbook:S06219 a skos:Concept ;
    skos:definition "A concerted process in which the primitive change concerned (generally bond rupture and bond formation) have progressed to the same extent at the transition state is said to be synchronous. The term figuratively implies a more or less synchronized progress of the changes. However, the progress of the bonding change (or other primitive change) has not been defined quantitatively in terms of a single parameter applicable to different bonds or different bonding changes. The concept is therefore in general only qualitatively descriptive and does not admit an exact definition except in the case of concerted processes involving changes in two identical bonds." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synchronous" .

goldbook:S06220 a skos:Concept ;
    skos:definition "A two-dimensional spectrum obtained by varying both the excitation and emission wavelengths simultaneously and which corresponds to the curve where a plane, parallel to the z-axis, intersects the excitation-emission spectrum (EES)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synchronously excited spectrum" .

goldbook:S06221 a skos:Concept ;
    skos:definition "X-Radiation which results from the acceleration of charged particles in circular orbits by strong electric and magnetic fields." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synchrotron radiation" .

goldbook:S06223 a skos:Concept ;
    skos:definition "A synthetic detergent; a detergent other than soap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syndet" .

goldbook:S06224 a skos:Concept ;
    skos:definition "A tactic macromolecule, essentially comprising alternating enantiomeric configurational base units, which have chiral or prochiral atoms in the main chain in a unique arrangement with respect to their adjacent constitutional units." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syndiotactic macromolecule" .

goldbook:S06225 a skos:Concept ;
    skos:definition "A polymer composed of syndiotactic macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syndiotactic polymer" .

goldbook:S06227 a skos:Concept ;
    skos:definition "Spontaneous shrinking of a gel with exudation of liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syneresis" .

goldbook:S06228 a skos:Concept ;
    skos:definition "A term describing the co-operative effect of two (or more) extractants where the distribution ratio for the combination is greater than the largest individual distribution ratio (measured under comparable conditions)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synergism" .

goldbook:S06229 a skos:Concept ;
    skos:definition "Pharmacological or toxicological interaction in which the combined biological effect of two or more substances is greater than expected on the basis of the simple summation of the toxicity of each of the individual substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synergism" .

goldbook:S06230 a skos:Concept ;
    skos:definition "In meteorology, the size or scale of ordinary weather systems or cyclones; typically \\(1000\\ \\rm{km}\\) horizontally." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synoptic scale" .

goldbook:S06232 a skos:Concept ;
    skos:definition "A reversible reaction that involves the conversion of two liquid phases, \\(\\rm{l}^{'}\\) and \\(\\rm{l}^{''}\\), into a solid phase $\\ce{\\upalpha\\!}$ on cooling: \\[\\rm{l}^{'}+\\rm{l}^{''}\\rightleftharpoons \\unicode[Times]{x3B1} \\] The maximum temperature at which this reaction can occur is the congruent melting point of the solid phase. Example: The conversion of co-existing $\\ce{K}$-rich and $\\ce{Zn}$-rich phases in the $\\ce{K-Zn}$ system to form an intermediate solid phase $\\ce{KZn13}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "syntectic reaction" .

goldbook:S06233 a skos:Concept ;
    skos:altLabel "CVD",
        "artificial graphite" ;
    skos:definition "A material consisting of graphitic carbon which has been obtained by graphitizing of non-graphitic carbon by chemical vapour deposition (CVD) from hydrobcarbons at temperatures above \\(2500\\ \\rm{K}\\), by decomposition of thermally unstable carbides or by crystallizing from metal melts supersaturated with carbon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "synthetic graphite" .

goldbook:S06234 a skos:Concept ;
    skos:definition "Arbitrarily defined part of the universe, regardless of form or size, e.g. for clinical chemistry, patient, patient plasma, patient urine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "system" .

goldbook:S06237 a skos:Concept ;
    skos:definition "Set of base units, together with derived units, defined in accordance with given rules, for a given system of quantities, e.g. Système International d'Unités (SI)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "system of units" .

goldbook:S06239 a skos:Concept ;
    skos:definition "The rupture of the chemical bond between an atom and the molecule of which the atom is part, as a result of a nuclear reaction of that atom." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Szilard–Chalmers effect" .

goldbook:ST06754 a skos:Concept ;
    skos:definition "A generic name for compounds or solid solutions in the system $\\ce{M–Si–Al–O–N}$ where $\\ce{M}$ is a metal. (The use of capitals as in SiAlON is discouraged since they suggest a chemical composition.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sialon" .

goldbook:ST06775 a skos:Concept ;
    skos:definition "The order of neighbouring amino acids in a protein or of the purine or pyrimidine bases in RNA or DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequence" .

goldbook:ST06784 a skos:Concept ;
    skos:definition "A very strong absorption band in the blue region of the optical absorption spectrum of a haem protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Soret band" .

goldbook:ST06785 a skos:Concept ;
    skos:definition "An equilibrium constant that expresses the propensity of a substance to form from its component parts. The larger the stability constant, the more stable is the species. The stability constant (formation constant) is the reciprocal of the instability constant (dissociation constant)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stability constant" .

goldbook:ST06802 a skos:Concept ;
    skos:definition "Consequence that is either of a generalized nature or that occurs at a site distant from the point of entry of a substance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "systemic effect" .

goldbook:ST06842 a skos:Concept ;
    skos:definition "Intracellular effector substance increasing or decreasing as a response to the stimulation of a receptor by an agonist, considered as the 'first messenger'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "second messenger" .

goldbook:ST06843 a skos:Concept ;
    skos:definition "Watery proteinaceous portion of the blood that remains after clotting. Synonym: blood serumClear watery fluid especially that moistening the surface of serous membranes or that exuded through inflammation of any of these membranes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "serum" .

goldbook:ST06844 a skos:Concept ;
    skos:definition "Multipotent cell with mitotic potential that may serve as a precursor for many kinds of differentiated cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stem cell" .

goldbook:ST06845 a skos:Concept ;
    skos:altLabel "SAR" ;
    skos:definition "Association between specific aspects of molecular structure and defined biological action." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure–activity relationship" .

goldbook:ST06848 a skos:Concept ;
    skos:definition "Analytical activities of identifying and/or measuring the quantities of one or more individual chemical species in a sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "speciation analysis" .

goldbook:ST06861 a skos:Concept ;
    skos:definition "Distribution of an element amongst defined chemical species in a system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "speciation" .

goldbook:ST06868 a skos:Concept ;
    skos:definition "A polymer, the molecules of which have mesogenic units only in side-group's side-chains." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "side group or side-chain polymer liquid crystal" .

goldbook:ST06872 a skos:Concept ;
    skos:definition "A chain for which the contour length is greater than the persistence length but for which their ratio is still below the Gaussian limit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-rigid chain" .

goldbook:ST06873 a skos:Concept ;
    skos:definition "A flexible segment used to link successive mesogenic units in the molecules of MCPLCs (main-chain polymer liquid crystals) or to attach mesogenic units as side-groups onto the polymer backbone of SGPLCs (side-group polymer liquid crystals)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spacer" .

goldbook:ST06914 a skos:Concept ;
    skos:definition "Consequence for which the probability of occurrence depends on the absorbed dose; hereditary effects and cancer induced by radiation are considered to be stochastic effects. The term 'stochastic' indicates that the occurrence of effects so named would be random. This means that, even for an individual, there is no threshold of dose below which there is absolutely no probability of an effect occurring, and the chance of experiencing the effect increases with increasing dose." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stochastic effect" .

goldbook:ST06980 a skos:Concept ;
    skos:altLabel "SMILES" ;
    skos:definition "SMILES (Simplified Molecular Input Line Entry System) is a string notation used to describe the nature and topology of molecular structures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simplified molecular input line entry system" .

goldbook:ST06981 a skos:Concept ;
    skos:altLabel "NMR" ;
    skos:definition "Structure-based design is a design strategy for new chemical entities based on the three-dimensional (3D) structure of the target obtained by X-ray or nuclear magnetic resonance (NMR) studies, or from protein homology models." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure-based design" .

goldbook:ST06982 a skos:Concept ;
    skos:altLabel "SPC" ;
    skos:definition "Structure-property correlations (SPC) refer to all statistical mathematical methods used to correlate any molecular property (intrinsic, chemical or biological) to any other property, using statistical regression or pattern recognition techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structure-property correlations" .

goldbook:ST07097 a skos:Concept ;
    skos:definition "A variational parameter used as a multiplier of each nuclear Cartesian and electronic coordinate chosen to minimize the variational integral and to make a trial variation function to satisfy the virial theorem. In practical calculations, the numeral factor to scale computed values, e.g. vibrational frequencies, to those found in experiments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "scaling factor" .

goldbook:ST07098 a skos:Concept ;
    skos:definition "In molecular orbital theory, the determinant of matrix elements whose solution leads to the set of energy levels of molecular orbitals for a given system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "secular equation" .

goldbook:ST07099 a skos:Concept ;
    skos:definition "Methods which use parameters derived from experimental data to simplify computations. The simplification may occur at various levels: simplification of the Hamiltonian (e.g., as in the Extended Hückel method), approximate evaluation of certain molecular integrals (see, for example, zero differential overlap approximation), simplification of the wavefunction (for example, use of a Pi ($\\ce{\\uppi\\!}$) electron approximation as in Pariser–Parr–Pople method), etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "semi-empirical quantum mechanical methods" .

goldbook:ST07100 a skos:Concept ;
    skos:definition "The determinantal representation of many-electron wavefunction \\(\\Psi \\) which conforms to the requirement of the antisymmetry principle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Slater determinant" .

goldbook:ST07101 a skos:Concept ;
    skos:definition "Localized excitations propagating in a system with constant velocity and colliding with each other without change in their shapes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soliton" .

goldbook:ST07102 a skos:Concept ;
    skos:definition "The change in Gibbs energy when an ion or molecule is transferred from a vacuum (or the gas phase) to a solvent. The main contributions to the solvation energy come from:  the cavitation energy of formation of the hole which preserves the dissolved species in the solvent;  the orientation energy of partial orientation of the dipoles; the isotropic interaction energy of electrostatic and dispersion origin; and  the anisotropic energy of specific interactions, e.g. hydrogen bonds, donor-acceptor interactions etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvation energy" .

goldbook:ST07103 a skos:Concept ;
    skos:definition "In unrestricted Hartree–Fock method, the wavefunctions obtained are eigenfunctions of the Hamiltonian and the spin projection \\(S_{\\rm{z}}\\) operators, but not eigenfunctions of the \\(S^{2}\\) operator. As a result, the wavefunctions of the doublet systems are spin-contaminated to some extent by admixtures of quartet, sextet, and higher spin states. The eigenvalues of the \\(S^{2}\\) operator are given as a measure of the spin contamination." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin contamination" .

goldbook:ST07104 a skos:Concept ;
    skos:definition "A type of molecular magnetism that is the result of electronic instability (see electronic stability) caused by external constraints (temperature, pressure, or electromagnetic radiation), which induce structural changes at molecular and lattice levels. The phenomenon is most characteristic of first-row transition metal complexes, e.g. those of $\\ce{Fe^{2+}}$. An example of spin-crossover complexes (the term of spin-state isomers is also used) is $\\ce{[Fe(2-pic)3]Cl2.EtOH}$ (2-pic = 2-picolylamine). At the $\\ce{Fe–N}$ distance of \\(203.2\\ \\rm{pm}\\) (\\(115\\ \\rm{K}\\)), the complex has an electronic low-spin state ($^{1}{\\rm{A}}_{1}$), whereas stretching the bond up to \\(219.9\\ \\rm{pm}\\) at \\(227\\ \\rm{K}\\) induces the transition to a high-spin state ($^{5}{\\rm{T}}_{2}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin crossover" .

goldbook:ST07105 a skos:Concept ;
    skos:definition "Static and dynamic spin polarization effects are distinguished. The static polarization of an electron spin occurs in the $\\ce{C-H}$ bonds of aromatic radicals where the $\\ce{\\upsigma\\!\\mbox{-}electron}$ closest to an unpaired $\\ce{\\uppi\\!\\mbox{-}electron}$ tends to have its spin parallel to that of the $\\ce{\\uppi\\!\\mbox{-}electron}$. Likewise, static spin polarization arises in the $\\ce{\\upsigma\\!\\mbox{-}system}$ of conjugated radicals: the electron of the doubly occupied molecular orbital prefers to take a closer spatial position to the odd one, which spin is parallel to the latter. The effect reflects the energy unfavourable situation if an electron of opposite spin were to come nearby." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin polarization" .

goldbook:ST07106 a skos:Concept ;
    skos:definition "A component, \\(M_{S}\\), of the angular spin moment \\(S\\) along an arbitrary axis (usually chosen as the z-direction). \\(M_{S}\\) can take the values between \\(-S\\) and \\(S\\): \\(-S\\), \\(-S + 1\\),..., \\(S- 1\\), \\(S\\). The term is also used to denote an operation (spin-symmetry projection) allowing one to eliminate spin contamination in the cases where wavefunctions are not eigenfunctions of the operator \\(S^{2}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin projection" .

goldbook:ST07107 a skos:Concept ;
    skos:definition "The capability of a molecule to undergo fast and reversible intramolecular isomerization, the energy barrier to which is lower than that allowing for the preparative isolation of the individual isomers at room temperature. It is conventional to assign to the sterochemically non-rigid systems those compounds whose molecules rearrange rapidly enough to influence NMR line shapes at temperatures within the practical range (from \\(\\pu{-100^{\\circ}C}\\) to \\(\\pu{200^{\\circ}C}\\)) of experimentation. The energy barriers to thus defined rearrangements fall into the range of \\(5\\)–\\(\\pu{20 kcal/mol}\\) (\\(21\\)–\\(\\pu{85 kJ/mol}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "stereochemical non-rigidity" .

goldbook:ST07108 a skos:Concept ;
    skos:definition "The excess energy due to steric strain of a molecular entity or transition state structure, i.e. distortions relative to a reference (real or hypothetical) 'strainless' structure with the standard bond lengths, bond angles and dihedral angles. The strain energy components involve the following destabilizing terms: non-bonded repulsions, bond-angle distortions, bond stretch or compression, rotation around or twisting of double bonds, and electrostatic strain. In general, the contributions of these components are inseparable and interdependent. A quantitative assessment of strain and strain energies can be made by taking the difference between the heat of formation of the substance under consideration and that of a hypothetical strain-free model. Several approaches to the assessment of strain energies have been developed based on the use of energies of isodesmic and homodesmotic reactions and on the so-called 'strainless increments', i.e. heats of formation of certain groups ($\\ce{CH3}$, $\\ce{CH2}$, $\\ce{CH}$, $\\ce{C}$ etc)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "strain energy" .

goldbook:ST07109 a skos:Concept ;
    skos:definition "Within the Born–Oppenheimer (adiabatic) approximation, this is associated with an energy minimum on a potential energy surface. Structural stability implies that any change in the coordinates of the nuclei can only increase the total energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "structural stability" .

goldbook:ST07110 a skos:Concept ;
    skos:definition "The occurrence of a large intramolecular charge separation in the singlet excited state of polyenes and their derivatives twisted about a double bond. Non-symmetrical substitution or geometrical distortion is effective in polarizing the system. An example is the stabilization of the zwitterionic structure of 90° twisted ethene with one methylene group pyramidalized:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sudden polarization" .

goldbook:ST07111 a skos:Concept ;
    skos:definition "A field of chemistry related to species of greater complexity than molecules, that are held together and organized by means of intermolecular interactions. The objects of supramolecular chemistry are supermolecules and other polymolecular entities that result from the spontaneous association of a large number of components into a specific phase (membranes, vesicles, micelles, solid state structures etc.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supramolecular chemistry" .

goldbook:ST07151 a skos:Concept ;
    skos:definition "Process through which a network is formed from solution by a progressive change of liquid precursor(s) into a sol, to a gel, and in most cases finally to a dry network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel process" .

goldbook:ST07152 a skos:Concept ;
    skos:definition "Process in which a polymer surface is chemically modified by grafting or by the generation of active sites that can lead to the initiation of a graft polymerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "surface grafting" .

goldbook:ST07194 a skos:Concept ;
    skos:definition "Polymer that, after heating and being subjected to a plastic deformation, resumes its original shape when heated above its glass-transition or melting temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shape-memory polymer" .

goldbook:ST07195 a skos:Concept ;
    skos:definition "Polymer that can absorb and retain extremely large amounts of a liquid relative to its own mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "superabsorbent polymer" .

goldbook:ST07227 a skos:Concept ;
    skos:definition "Electrically conducting solution of a salt in a polymer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solid polymer electrolyte" .

goldbook:ST07274 a skos:Concept ;
    skos:definition "Curve defining the region of composition and temperature for a binary mixture across which a transition occurs from conditions where single-phase mixtures are metastable to conditions where single-phase mixtures are unstable and undergo phase separation by spinodal decomposition." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spinodal" .

goldbook:ST07294 a skos:Concept ;
    skos:definition "Phase domain of microscopic or smaller size, usually in a block, graft, or segmented copolymer, comprising essentially those segments of the polymer that have glass transition temperatures lower than the temperature of use." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "soft-segment phase domain" .

goldbook:ST07295 a skos:Concept ;
    skos:definition "Copolymer containing phase domains of microscopic or smaller size, with the domains constituted principally of single types of structural unit." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "segmented copolymer" .

goldbook:ST07395 a skos:Concept ;
    skos:definition "Referred to actinometer based on spectrophotometric measurements, \\(S_{\\rm{ac}}\\left(\\lambda \\right)=\\varPhi \\left(\\lambda \\right)\\ \\varepsilon\\left(\\lambda _{\\rm{obs}}\\right)=\\rm{sensitivity or actinometric factor}\\). \\(\\varPhi \\left(\\lambda \\right)\\) is the quantum yield of the actinometer at the excitation wavelength and \\(\\lambda _{\\rm{obs}}\\) is the observation wavelength, which may be the same as or differ from the former." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral sensitivity" .

goldbook:ST07417 a skos:Concept ;
    skos:definition "Physical and chemical properties of conjugated organic polymers with $\\ce{\\uppi\\!\\mbox{-}electrons}$ have been interpreted in terms of self-localized excitations, which are quasi-particles with structural changes over several repeating units. These excitations can be classified into solitons, polarons, bipolarons and excitons according to their charge and spin." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "self-localized excitations" .

goldbook:ST07466 a skos:Concept ;
    skos:definition "Parameter used in predicting the solubility of non-electrolytes (including polymers) in a given solvent.For a substance \\(\\rm{B}\\), \\[\\delta _{\\rm{B}} = \\left ( \\frac{\\Delta _{\\rm{vap}}E_{\\rm{m,B}}}{V_{\\rm{m,B}}} \\right )^{1/2}\\] where \\(\\Delta _{\\rm{vap}}E_{\\rm{m,B}}\\) is the molar energy of vaporization at zero pressure and \\(V_{\\rm{m,B}}\\) is the molar volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solubility parameter" .

goldbook:ST07476 a skos:Concept ;
    skos:definition "The diastereoselective ene reaction of singlet molecular dioxygen with alkenes. An example is:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Schenck reaction" .

goldbook:ST07477 a skos:Concept ;
    skos:definition "Point of intersection between the potential energy surfaces of states of different multiplicity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "singlet–triplet crossing" .

goldbook:ST07478 a skos:Concept ;
    skos:definition "Breaking of symmetry of a molecular species by interactions with the solvent that can modify the molecular charge distribution, to favour asymmetrical configurations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "solvent-induced symmetry breaking" .

goldbook:ST07479 a skos:Concept ;
    skos:definition "Derivative of fluence rate, \\(E_{\\rm{o}}\\), with respect to wavelength, \\(\\lambda\\). SI unit is \\(\\rm{W m}^{-3}\\); common unit is \\(\\rm{W m}^{-2}\\ \\rm{nm}^{-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral fluence rate" .

goldbook:ST07480 a skos:Concept ;
    skos:definition "Derivative of radiant energy, \\(Q\\), with respect to wavelength \\(\\lambda \\). SI unit is \\(\\pu{J m-1}\\); common unit is \\(\\pu{J nm-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spectral radiant energy" .

goldbook:ST07481 a skos:Concept ;
    skos:altLabel "SF method" ;
    skos:definition "Quantum mechanical method for the calculation of open-shell excited states. The method accurately describes low-lying multi-configurational electronic states of diradicals and triradicals in an efficient and robust single-reference scheme. The target low-spin states (e.g., S = 0 or S = 1/2) are described as spin-flipping excitations (S = −1) from a well-behaved high-spin reference state (e.g., S = 1 or S = 3/4). By employing theoretical models of increasing complexity for the reference (e.g., SCF, MP2, CCSD), the accuracy in the target states’ description can be systematically improved. The SF methods result in multistate single-step computational schemes, e.g., several low-lying states can be computed in a single calculation that includes both dynamical and non-dynamical correlation effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-flip method" .

goldbook:ST07482 a skos:Concept ;
    skos:definition "From the possible encounter pairs between states of different spin multiplicity, only those conserving multiplicity in going to products are expected to react." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "spin-statistical factor" .

goldbook:ST07508 a skos:Concept ;
    skos:definition "Ceramic precursor dispersed in a liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slip" .

goldbook:ST07512 a skos:Concept ;
    skos:definition "Sol produced by the action of ultrasonically induced cavitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonosol" .

goldbook:ST07513 a skos:Concept ;
    skos:definition "Mass fraction of the dissolved or dispersed material, resulting from a network-forming polymerization or crosslinking process, that is constituted of molecules of finite (statistically definable) relative molecular masses." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol fraction" .

goldbook:ST07530 a skos:Concept ;
    skos:definition "Colloidal gel produced by the action of ultrasonically induced cavitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sonogel" .

goldbook:ST07538 a skos:Concept ;
    skos:definition "Fluid used to swell a gel, network or solid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "swelling agent" .

goldbook:ST07566 a skos:Concept ;
    skos:definition "Interpenetrating polymer network prepared by a process in which the second component network is formed following the formation of the first component network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential interpenetrating polymer network" .

goldbook:ST07567 a skos:Concept ;
    skos:definition "Interpenetrating polymer network prepared by a process in which the component networks are formed concurrently." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous interpenetrating polymer network" .

goldbook:ST07574 a skos:Concept ;
    skos:definition "Semi-interpenetrating polymer network prepared by a process in which the linear or branched components are formed following the completion of the reactions that lead to the formation of the network(s) or vice versa." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sequential semi-interpenetrating polymer network" .

goldbook:ST07575 a skos:Concept ;
    skos:definition "Semi-interpenetrating polymer network prepared by a process in which the networks and the linear or branched components are formed concurrently." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "simultaneous semi-interpenetrating polymer network" .

goldbook:ST07586 a skos:Concept ;
    skos:definition "Material formed through a sol-gel process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel material" .

goldbook:ST07587 a skos:Concept ;
    skos:definition "Coating formed through a sol-gel process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel coating" .

goldbook:ST07588 a skos:Concept ;
    skos:definition "Metal oxide formed through a sol-gel process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel metal oxide" .

goldbook:ST07589 a skos:Concept ;
    skos:definition "Silica formed through a sol-gel process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel silica" .

goldbook:ST07631 a skos:Concept ;
    skos:definition "Separation of a dispersed system under the action of a gravitational or centrifugal field according to the different densities of the components." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sedimentation" .

goldbook:ST07632 a skos:Concept ;
    skos:definition "Decrease in volume of a network, gel or solid associated with the exudation of a fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "shrinkage" .

goldbook:ST07633 a skos:Concept ;
    skos:definition "Procedure in ceramic processing whereby slip is contained in a porous plaster mould prior to pyrolysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "slip casting" .

goldbook:ST07634 a skos:Concept ;
    skos:altLabel "critical concentration" ;
    skos:definition "Concentration of an added electrolyte above which a particulate sol undergoes coagulation instead of gelation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "sol-gel critical concentration" .

goldbook:ST07636 a skos:Concept ;
    skos:definition "Drying of a gel using a supercritical fluid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "supercritical drying of a gel" .

goldbook:T03420 a skos:Concept ;
    skos:altLabel "lambda-transition" ;
    skos:definition "A second-order or higher-order transition, in which the heat capacity shows either a discontinuity (second-order) or a vertex (higher-order) at the transition temperature. Example: The transition at \\(846\\ \\rm{K}\\), accompanied by a finite change in specific heat capacity at constant pressure \\(C_{p}\\), of the low-temperature polymorph of quartz to the high-temperature polymorph." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "λ-transition" .

goldbook:T06244 a skos:Concept ;
    skos:definition "The orderliness of the succession of configurational repeating units in the main chain of a regular macromolecule, a regular oligomer molecule, a regular block or a regular chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tacticity" .

goldbook:T06245 a skos:Concept ;
    skos:definition "A regular macromolecule in which essentially all the configurational repeating unit are identical." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tactic macromolecule" .

goldbook:T06246 a skos:Concept ;
    skos:definition "A polymer composed of tactic macromolecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tactic polymer" .

goldbook:T06247 a skos:Concept ;
    skos:definition "Various equations are associated with R.W. Taft, but the term is most often used to designate the family of equations that emerged from Taft's analysis of the reactivities of aliphatic esters, and which involved the polar substituent constant \\(\\sigma \\rm{*}\\) and the steric substituent constant \\(E_{\\rm{s}}\\): \\[\\log _{10}k = \\log _{10}k_{0}+\\rho \\rm{*}\\ \\sigma \\rm{*}+\\delta \\ E_{\\rm{s}}\\] or the one-parameter forms applicable when the role of either the polar term or the steric term may be neglected. Nowadays \\(\\sigma \\rm{*}\\) is usually replaced by the related constant \\(\\sigma _{I}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Taft equation" .

goldbook:T06248 a skos:Concept ;
    skos:definition "Made identifiable by a label." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tagged" .

goldbook:T06249 a skos:Concept ;
    skos:definition "Asymmetry of a peak such that, relative to the baseline, the front is steeper than the rear. In paper chromatography and in thin-layer chromatography, the distortion of a zone showing a diffuse region behind the zone in the direction of travel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tailing" .

goldbook:T06250 a skos:Concept ;
    skos:definition "An arrangement in which ions are subjected to two or more sequential stages of analysis (which may be separated spatially or temporally) according to the quotient mass/charge. A hybrid mass spectometer is an instrument which combines analysers of different types, e.g. magnetic plus electric sector combined with quadrupole. The study of ions involving two stages of mass analysis has been termed mass spectrometry/mass spectrometry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tandem mass spectrometer" .

goldbook:T06252 a skos:Concept ;
    skos:altLabel "cationotropic rearrangement",
        "cationotropy",
        "prototropic rearrangement",
        "prototropy" ;
    skos:definition "Isomerism of the general form:  where the isomers (called tautomers) are readily interconvertible; the atoms connecting the groups $\\ce{X}$, $\\ce{Y}$, $\\ce{Z}$ are typically any of $\\ce{C}$, $\\ce{H}$, $\\ce{O}$ or $\\ce{S}$, and $\\ce{G}$ is a group which becomes an electrofuge or nucleofuge during isomerization. The commonest case, when the electrofuge is H+, is also known as 'prototropy'. Examples, written so as to illustrate the general pattern given above, include: keto-enol tautomerism, such as:   The grouping Y may itself be a three-atom (or five-atom) chain extending the conjugation, as in:  The double bond between $\\ce{Y}$ and $\\ce{Z}$ may be replaced by a ring, when the phenomenon is called ring-chain tautomerism, as in:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tautomerism" .

goldbook:T06253 a skos:Concept ;
    skos:definition "The isomerization by which tautomers are interconverted. It is a heterolytic molecular rearrangement and is frequently very rapid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tautomerization" .

goldbook:T06256 a skos:Concept ;
    skos:definition "A substitution reaction in which the entering group takes up a position more than one atom away from the atom to which the leaving group was attached:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tele-substitution" .

goldbook:T06257 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{RTeR}$ ($\\ce{R}  eq \\ce{H}$). Thus tellurium analogues of ethers.Metal salts of tellurane, $\\ce{H2Te}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tellurides" .

goldbook:T06258 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{R2Te(=O)2}$. Thus tellurium analogues of sulfones." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tellurones" .

goldbook:T06260 a skos:Concept ;
    skos:definition "The formation of an addition oligomer, having uniform end groups $\\ce{X'\\ldots X^{''}}$, by a chain reaction in which a chain transfer limits the length of the polymer ('telomer') produced. An example is the polymerization of styrene in bromotrichloromethane solution ($\\ce{X'} = \\ce{CCl3}$, $\\ce{X^{''}} = \\ce{Br}$), where $\\ce{Cl3C^{.}}$ radicals are formed in the initiation step to produce $\\ce{Cl3C[CH2CHPh]_{n}Br}$, with \\(n\\) greater than 1 and often less than ca. 10:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "telomerization" .

goldbook:T06262 a skos:Concept ;
    skos:definition "The dependence of a detector on temperature can be described by the temperature coefficient of responsivity and is expressed as percentage change in output per \\(\\mathrm{K}\\). In the case of a nonlinear dependence the temperature and the temperature range should also be stated for which the stated temperature coefficient of responsivity is applicable." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature coefficient" .

goldbook:T06263 a skos:Concept ;
    skos:definition "A term used for changes in the luminescence parameters caused by changes in temperature, since the type of solvent and its temperature can effect the luminescence yield from an analyte as a result of quenching, exciplex formation, aggregation, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature effect" .

goldbook:T06264 a skos:Concept ;
    skos:definition "A departure from the normal decrease of temperature with increasing altitude. A temperature inversion may be produced, for example, by the movement of a warm air mass over a cool one. Intense surface inversions may form over the land during nights with clear skies and low winds due to the radiative loss of heat from the surface of the earth. The temperature increases as a function of height in this case. Poor mixing of the pollutants generally occurs below the inversion, since the normal convective process which drives the warmer and lighter air at ground level to higher altitudes is interrupted as the rising air parcels encounter the warmer air above. Temperature inversions near the surface are particularly effective in trapping ground level emissions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature inversion" .

goldbook:T06265 a skos:Concept ;
    skos:altLabel "T-jump" ;
    skos:definition "A relaxation technique in which the temperature of a chemical system is suddenly raised. The system then relaxes to a new state of equilibrium, and analysis of the relaxation processes provides rate constants." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature jump" .

goldbook:T06266 a skos:Concept ;
    skos:definition "The rate of change of temperature with altitude (\\(\\frac{\\rm{d}T}{\\rm{d}z}\\)). The rate of temperature decrease with increase in altitude which is expected to occur in an unperturbed dry air mass is \\(9.8\\times 10^{3}\\ ^{\\unicode{x26ac}}\\rm{C min}^{-1}\\). This is called the dry adiabatic lapse rate. The lapse rate is taken as positive when temperature decreases with increasing height. For air saturated with $\\ce{H2O}$, the lapse rate is less because of the release of the latent heat of water as it condenses. The average tropospheric lapse rate is about \\(6.5\\times 10^{3}\\ ^{\\unicode{x26ac}}\\rm{C}\\ \\min ^{-1}\\). The lapse rate has a negative value within an inversion layer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temperature lapse rate" .

goldbook:T06269 a skos:Concept ;
    skos:definition "The nucleic acid single strand that is copied during replication or transcription." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "template" .

goldbook:T06270 a skos:Concept ;
    skos:definition "Weak and reversible adsorption of a poison, such that removal of the poison from the fluid phase results in restoration of the original catalytic activity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "temporary poisoning" .

goldbook:T06273 a skos:Concept ;
    skos:definition "A set of levels which have the same electron configuration and the same value of the quantum numbers for total spin \\(S\\) and total orbital angular momentum \\(L\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "term" .

goldbook:T06274 a skos:Concept ;
    skos:altLabel "chain-ending step",
        "chain-termination reaction" ;
    skos:definition "The steps in a chain reaction in which reactive intermediates are destroyed or rendered inactive, thus ending the chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "termination" .

goldbook:T06275 a skos:Concept ;
    skos:definition "A sequence of DNA lying beyond the 3' end of the coding segment of a gene which is recognized by RNA polymerase as a signal to stop synthesizing mRNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "terminator" .

goldbook:T06278 a skos:Concept ;
    skos:definition "Hydrocarbons of biological origin having carbon skeletons formally derived from isoprene $\\ce{[CH2=C(CH3)CH=CH2]}$. This class is subdivided into the $\\ce{C5}$ hemiterpenes, $\\ce{C10}$ monoterpenes, $\\ce{C15}$ sesquiterpenes, $\\ce{C20}$ diterpenes, $\\ce{C25}$ sesterterpenes, $\\ce{C30}$ triterpenes, $\\ce{C40}$ tetraterpenes (carotenoids) and $\\ce{C5_{n}}$ polyterpenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "terpenes" .

goldbook:T06279 a skos:Concept ;
    skos:definition "Natural products and related compounds formally derived from isoprene units (see isoprenoids). They contain oxygen in various functional groups. This class is subdivided according to the number of carbon atoms in the same manner as are terpenes. The skeleton of terpenoids may differ from strict additivity of isoprene units by the loss or shift of a fragment, generally a methyl group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "terpenoids" .

goldbook:T06282 a skos:Concept ;
    skos:definition "The spatial organization (including conformation) of an entire protein molecule or other macromolecule consisting of a single chain." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tertiary structure" .

goldbook:T06284 a skos:Concept ;
    skos:altLabel "analytical portion" ;
    skos:definition "The amount or volume of the test sample taken for analysis, usually of known weight or volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "test portion" .

goldbook:T06285 a skos:Concept ;
    skos:definition "The sample, prepared from the laboratory sample, from which test portions are removed for testing or for analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "test sample" .

goldbook:T06286 a skos:Concept ;
    skos:altLabel "analytical solution" ;
    skos:definition "The solution prepared from the test portion for the analytical procedure. The proportions of test portion and solvent are normally known." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "test solution" .

goldbook:T06287 a skos:Concept ;
    skos:definition "A subclass of polyketides having an octahydrotetracene-2-carboxamide skeleton, substituted with many hydroxy and other groups, e.g. chlortetracycline:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetracyclines" .

goldbook:T06289 a skos:Concept ;
    skos:definition "A reaction intermediate in which the bond arrangement around an initially double-bonded carbon atom (typically a carbonyl carbon atom) has been transformed from trigonal to tetrahedral. For example, aldol in the condensation reaction of acetaldehyde (but most tetrahedral intermediates have a more fleeting existence)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetrahedral intermediate" .

goldbook:T06290 a skos:Concept ;
    skos:definition "An affix used in names to denote four atoms bound into a tetrahedron." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>tetrahedro</i>-" .

goldbook:T06291 a skos:Concept ;
    skos:definition "Natural pigments containing four pyrrole rings joined by one-carbon units linking position 2 of one pyrrole ring to position 5 of the next. porphyrins are macrocyclic tetrapyrroles. E.g. bilin (a linear tetrapyrrole)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetrapyrroles" .

goldbook:T06292 a skos:Concept ;
    skos:definition "Terpenoids having a $\\ce{C40}$ skeleton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tetraterpenoids" .

goldbook:T06293 a skos:Concept ;
    skos:definition "The detailed geometry of the void space in the particles of a catalyst." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "texture" .

goldbook:T06295 a skos:Concept ;
    skos:definition "A group of techniques in which a physical property of a substance and/or its reaction product is measured as a function of temperature while the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal analysis" .

goldbook:T06296 a skos:Concept ;
    skos:definition "A special type of carbon black produced by pyrolysis of gaseous hydrocarbons in a preheated chamber in the absence of air. Thermal black consists of relatively large individual spheres (\\(100{-}500\\ \\rm{nm}\\) diameter) and aggregates of a small number of pseudospherical particles. The preferred alignment of the layer planes is parallel to the surface of the spheres." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal black" .

goldbook:T06297 a skos:Concept ;
    skos:definition "A large body of moderator, adjacent to or inside a reactor to provide thermal neutrons for experiments." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal column" .

goldbook:T06300 a skos:Concept ;
    skos:definition "In general, two cells arranged in a bridge configuration detect the change in thermal conductivity of the gas at the output of the column. This detector is sensitive to any substance with thermal conductivity different from that of the carrier gas. The lowest detectable limit is between \\(0.5\\) and \\(100\\ \\rm{ppmv}\\). The linear dynamic range is of the order of \\(10^{3}\\). This type of detector is often used for measuring components at relatively high concentrations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal conductivity detector" .

goldbook:T06302 a skos:Concept ;
    skos:definition "Fission caused by thermal neutrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal fission" .

goldbook:T06303 a skos:Concept ;
    skos:definition "Takes place when an atom or molecule interacts with a heated surface or is in a gaseous environment at high temperature. Examples of the latter may be a capillary arc plasma, a microwave plasma or an inductively coupled plasma." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal ionization" .

goldbook:T06304 a skos:Concept ;
    skos:definition "A technique that determines the alteration in the refractive index of a medium as a result of the temperature rise in the path of a laser beam absorbed by the medium. The lens produced (usually divergent) causes a change (usually a decrease) in the irradiance measured along the laser beam axis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal lensing" .

goldbook:T06306 a skos:Concept ;
    skos:definition "A transition that is induced by a change in temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermally-induced transition" .

goldbook:T06307 a skos:Concept ;
    skos:definition "Neutrons in thermal equilibrium with the medium in which they exist, in general at room temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal neutrons" .

goldbook:T06309 a skos:Concept ;
    skos:definition "A technique in which the characteristics of imposed acoustic waves are measured as a function of temperature after passing through a substance (and/or its reaction product(s)) whilst the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoacoustimetry" .

goldbook:T06312 a skos:Concept ;
    skos:definition "A thermally induced transformation of a molecular structure or of a system (e.g. of a solution), thermally reversible, that produces a spectral change, typically, but not necessarily, of visible colour." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermochromism" .

goldbook:T06313 a skos:Concept ;
    skos:definition "A device based on the thermoelectric effect, by which two junctions between dissimilar conductors (metallic or heavily doped semiconductors) kept at different temperatures generate an electric potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermocouple" .

goldbook:T06316 a skos:Concept ;
    skos:altLabel "equilibrium control" ;
    skos:definition "The term characterizes conditions that lead to reaction products in a proportion governed by the equilibrium constant for their interconversion and/or for the interconversion of reaction intermediates formed in or after the rate-limiting step. (Some workers prefer to describe this phenomenon as 'equilibrium control'.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermodynamic control" .

goldbook:T06319 a skos:Concept ;
    skos:altLabel "equilibrium isotope effect" ;
    skos:definition "The effect of isotopic substitution on an equilibrium constant is referred to as a thermodynamic (or equilibrium) isotope effect. For example, the effect of isotopic substitution in reactant A that participates in the equilibrium: \\[\\rm{A}+\\rm{B}\\rightleftharpoons \\rm{C}\\] is the ratio \\(\\frac{K^{\\rm{l}}}{K^{\\rm{h}}}\\) of the equilibrium constant for the reaction in which A contains the light isotope to that in which it contains the heavy isotope. The ratio can be expressed as the equilibrium constant for the isotopic exchange reaction: \\[\\rm{A}^{\\rm{l}}+\\rm{C}^{\\rm{h}}\\rightleftharpoons \\rm{A}^{\\rm{h}}+\\rm{C}^{\\rm{l}}\\] in which reactants such as B that are not isotopically substituted do not appear. The potential energy surfaces of isotopic molecules are identical to a high degree of approximation, so thermodynamic isotope effects can only arise from the effect of isotopic mass on the nuclear motions of the reactants and products, and can be expressed quantitatively in terms of partition function ratios for nuclear motion: \\[\\frac{K^{\\rm{l}}}{K^{\\rm{h}}} = \\frac{(Q_{\\rm{nuc}}^{\\rm{l}}/Q_{\\rm{nuc}}^{\\rm{h}})_{\\rm{C}}}  {(Q_{\\rm{nuc}}^{\\rm{l}}/Q_{\\rm{nuc}}^{\\rm{h}})_{\\rm{A}}}\\] Although the nuclear partition function is a product of the translational, rotational and vibrational partition functions, the isotope effect is determined almost entirely by the last named, specifically by vibrational modes involving motion of isotopically different atoms. In the case of light atoms (i.e. protium vs. deuterium or tritium) at moderate temperatures, the isotope effect is dominated by zero-point energy differences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermodynamic isotope effect" .

goldbook:T06321 a skos:Concept ;
    skos:definition "Base quantity in the system of quantities upon which SI is based." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermodynamic temperature" .

goldbook:T06322 a skos:Concept ;
    skos:definition "A technique in which an electrical characteristic of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program. The most common measurements are of resistance, conductance or capacitance." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoelectrometry" .

goldbook:T06324 a skos:Concept ;
    skos:altLabel "TG" ;
    skos:definition "A technique in which the mass of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermogravimetry" .

goldbook:T06325 a skos:Concept ;
    skos:definition "Luminescence arising from a reaction between species trapped in a rigid matrix and released as a result of an increase in temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoluminescence" .

goldbook:T06326 a skos:Concept ;
    skos:definition "The uncatalysed cleavage of one or more covalent bonds resulting from exposure of a compound to a raised temperature, or a process in which such cleavage is an essential part." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermolysis" .

goldbook:T06327 a skos:Concept ;
    skos:definition "A technique in which a magnetic characteristic of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomagnetometry" .

goldbook:T06328 a skos:Concept ;
    skos:definition "A technique in which the deformation of a substance (and/or its reaction product(s)) under non-oscillatory load is measured as a function of temperature whilst the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermomechanical measurement" .

goldbook:T06331 a skos:Concept ;
    skos:altLabel "enthalpimetric titration",
        "thermometric enthalpy titration" ;
    skos:definition "An analytical method in which one reactant (the titrant) is added continuously or stepwise to an adiabatic or isoperibol vessel containing another reactant. The enthalpy change(s) of the ensuing reaction(s) causes a temperature change which, when plotted versus volume of titrant, may be used to find the titration endpoint(s). This is the preferred term for experiments producing plots of temperature versus volume of titrant in which the main goal is a quantitative determination. Nonetheless, when a calorimetric vessel is used, such that the heat capacity is known, thermodynamic parameters may also be estimated from such experiments. An acceptable synonym in that case is enthalpimetric titration. The use of the adjective thermometric is justified because of widespread historical and current usage, and because a titration of necessity implies a chemical reaction. The term  'thermometric enthalpy titration' has been used, but is not recommended. A method in which the titrant is a catalyst for an indicator reaction that occurs after the endpoint for the analyte reaction should be called a thermometric titration with catalytic endpoint detection, not a 'catalytic thermometric titration'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermometric titration" .

goldbook:T06332 a skos:Concept ;
    skos:definition "A thermoanalytical technique in which the release of particulate matter from a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoparticulate analysis" .

goldbook:T06333 a skos:Concept ;
    skos:definition "An organism that can tolerate high temperatures and that grows optimally at temperatures above \\(45\\ ^{\\,\\unicode{x26ac}}\\rm{C}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermophile" .

goldbook:T06335 a skos:Concept ;
    skos:definition "Several thermocouples connected in series to increase the magnitude of the electric potential." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermopile" .

goldbook:T06336 a skos:Concept ;
    skos:definition "A technique in which an optical characteristic of a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program. Measurements of total light, light of specific wavelength(s), refractive index and luminescence lead to thermophotometry, thermospectrometry, thermorefractometry and thermoluminescence, respectively; observation under the microscope leads to thermomicroscopy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoptometry" .

goldbook:T06337 a skos:Concept ;
    skos:definition "A technique in which the sound emitted by a substance (and/or its reaction product(s)) is measured as a function of temperature whilst the substance is subjected to a controlled temperature program." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermosonimetry" .

goldbook:T06338 a skos:Concept ;
    skos:definition "Atmospheric shell extending from the top of the mesosphere to outer space. It is a region of more or less steadily increasing temperature with height, starting at \\(70\\) or \\(80\\ \\rm{km}\\). It includes the exosphere and most or all of the ionosphere (not the D region)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermosphere" .

goldbook:T06342 a skos:Concept ;
    skos:definition "The distance from the electrode where the ratio \\[\\frac{c\\,-\\,c_{\\rm{e}}}{c_{0}\\,-\\,c_{\\rm{e}}}\\] reaches a given value. (\\(c_{\\rm{e}}\\) is the interfacial concentration, \\(c\\) is the concentration, \\(c_{0}\\) is the value in the bulk solution.) If this ratio is selected as, say, 0.99 the corresponding thickness of the diffusion layer is denoted by \\(\\delta_{0.99}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thickness of diffusion layer" .

goldbook:T06343 a skos:Concept ;
    skos:definition "The length characterizing the decrease with distance of the potential in the double layer = characteristic Debye length in the corresponding electrolyte solution = \\(\\kappa^{-1}\\):\\[\\frac{1}{\\kappa } = \\sqrt{\\frac{\\varepsilon_{\\rm{r}}\\varepsilon_{0}RT}{F^{2}\\sum _{i}c_{i}z_{i}^{2} }}\\]&nbsp;&nbsp;\\[\\frac{1}{\\kappa } = \\sqrt{\\frac{\\varepsilon_{\\rm{r}}RT}{4\\pi F^{2}\\sum _{i}c_{i}z_{i}^{2} }}\\](rationalized four-quantity system)&nbsp;&nbsp;(three-quantity electrostatic system) where \\(\\varepsilon\\) = static permittivity = \\(\\varepsilon_{\\rm{r}}\\varepsilon_{0}\\), \\(\\varepsilon_{\\rm{r}}\\) = relative static permittivity of solution; \\(\\varepsilon_{0}\\) = permittivity of vacuum, \\(R\\) = gas constant, \\(T\\) = thermodynamic temperature, \\(F\\) = Faraday constant, \\(z_{\\rm{i}}\\) = concentration of species \\(i\\), \\(z_{\\rm{i}}\\) = ionic charge on species \\(i\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thickness of electrical double layer" .

goldbook:T06344 a skos:Concept ;
    skos:definition "When a kinetic current flows, the concentrations of the electroactive substance B and its precursor C at very small distances from the electrode surface are influenced both by mass transfer and by the finite rate of establishment of the chemical equilibrium. As the distance from the electrode surface increases, the chemical equilibrium is more and more nearly attained. The thickness of the reaction layer is the distance from the electrode surface beyond which deviations from the chemical equilibrium between C and B are taken to be negligibly small." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thickness of reaction layer" .

goldbook:T06345 a skos:Concept ;
    skos:definition "A film whose thickness is of the order of a characteristic scale or smaller. Since a film may 'look' operationally thin or thick, according to the procedure applied, it is also recommended that the measurement procedure employed be specified (e.g. ellipsometrically thin film, optically thin film, etc.). It is recommended that the physical specification of the film thickness be used, whenever possible (e.g. thick compared to the electron mean free path, thin compared to the optical wavelength, etc.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thin film" .

goldbook:T06347 a skos:Concept ;
    skos:definition "This prefix properly denotes replacement of an oxygen by a sulfur, e.g. $\\ce{PhC(=S)NH2}$, thiobenzamide. See also entries prefixed thio-." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thio" .

goldbook:T06348 a skos:Concept ;
    skos:definition "A term including monothioacetals having the structure $\\ce{R2C(OR')(SR')}$ (subclass monothioketals, $\\ce{R}  eq \\ce{H}$); and dithioacetals having the structure $\\ce{R2C(SR')2}$ (subclass dithioketals, $\\ce{R}  eq \\ce{H}, \\ce{R'}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioacetals" .

goldbook:T06349 a skos:Concept ;
    skos:definition "Compounds in which the oxygen of an aldehyde has been replaced by divalent sulfur, $\\ce{RC(=S)H}$, e.g. $\\ce{CH3CH2C(=S)H propanethial}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioaldehydes" .

goldbook:T06350 a skos:Concept ;
    skos:altLabel "sulfines" ;
    skos:definition "Compounds having the structure $\\ce{RC(=S=O)H}$. (Also known by the disapproved term 'sulfines' which includes thioaldehyde S-oxides and thioketone S-oxides)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioaldehyde <i>S</i>-oxides" .

goldbook:T06351 a skos:Concept ;
    skos:altLabel "acid thioanhydrides",
        "diacylsulfanes" ;
    skos:definition "Compounds having the structure acyl-S-acyl. Also called diacylsulfanes, e.g. $\\ce{CH3C(=O)SC(=S)CH2CH3}$ acetic thiopropanoic thioanhydride." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioanhydrides" .

goldbook:T06352 a skos:Concept ;
    skos:definition "Compounds in which one or both oxygens of a carboxy group have been replaced by divalent sulfur $\\ce{RC(=O)SH}$ or $\\ce{RC(=S)OH}$ monothiocarboxylic acids, $\\ce{RC(=S)SH}$ dithiocarboxylic acids." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thiocarboxylic acids" .

goldbook:T06353 a skos:Concept ;
    skos:definition "Salts and esters of thiocyanic acid $\\ce{HSC#N}$, e.g. $\\ce{CH3SC#N}$ methyl thiocyanate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thiocyanates" .

goldbook:T06354 a skos:Concept ;
    skos:definition "Former name for sulfides $\\ce{RSR}$ ($\\ce{R}  eq \\ce{H}$)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioethers" .

goldbook:T06355 a skos:Concept ;
    skos:definition "Compounds of structure $\\ce{R2C(SR')OH}$ or $\\ce{R2C(OR')SH}$ (monothiohemiacetals), or $\\ce{R2C(SR')SH}$ (dithiohemiacetals), $\\ce{R'}  eq \\ce{H}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thiohemiacetals" .

goldbook:T06356 a skos:Concept ;
    skos:definition "Compounds in which the oxygen of a ketone has been replaced by divalent sulfur $\\ce{R2C=S}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{CH3C(=S)CH2CH3}$ butane-2-thione." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioketones" .

goldbook:T06357 a skos:Concept ;
    skos:altLabel "sulfines" ;
    skos:definition "Compounds having the structure $\\ce{R2C=S=O}$ ($\\ce{R}  eq \\ce{H}$). (Also known by the disapproved term 'sulfines' which comprises thioaldehyde S-oxides and thioketone S-oxides.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thioketone <i>S</i>-oxides" .

goldbook:T06358 a skos:Concept ;
    skos:definition "Derivatives of thiols, in which a metal (or other cation) replaces the hydrogen attached to sulfur, e.g. $\\ce{CH3S^{-}Na^{+}}$ sodium methanethiolate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thiolates" .

goldbook:T06359 a skos:Concept ;
    skos:altLabel "mercaptans" ;
    skos:definition "Compounds having the structure $\\ce{RSH}$ ($\\ce{R}  eq \\ce{H}$), e.g. $\\ce{MeCH2SH}$ ethanethiol. Also known by the term 'mercaptans' (abandoned by IUPAC)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thiols" .

goldbook:T06361 a skos:Concept ;
    skos:definition "A species, other than the reactant itself, which brings about the energization of a molecule that can undergo a unimolecular process, or brings about a combination reaction between atoms or radicals. In the latter case a third body is also called a chaperon." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "third body" .

goldbook:T06366 a skos:Concept ;
    skos:definition "Potential energy gap between reactants and the transition state, sometimes involving the zero point energies, but usually not." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold energy" .

goldbook:T06367 a skos:Concept ;
    skos:definition "Intramolecular electron transfer for which the relevant electronic interaction between the donor and acceptor sites is mediated by through-bond interaction, i.e. via the covalent bonds interconnecting these sites, as opposed to through-space interaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "through-bond electron transfer" .

goldbook:T06369 a skos:Concept ;
    skos:definition "Electron transfer for which the relevant electronic interaction between the donor and acceptor sites is mediated either by direct orbital overlap or by superexchange interaction via intervening molecular entities not covalently bound to the donor or acceptor sites." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "through-space electron transfer" .

goldbook:T06371 a skos:Concept ;
    skos:altLabel "TICT" ;
    skos:definition "Electronic emission emanating from a TICT state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "TICT emission" .

goldbook:T06372 a skos:Concept ;
    skos:altLabel "TICT" ;
    skos:definition "The acronym derives from Twisted Internal Charge Transfer state, proposed to be responsible for strongly Stokes-shifted fluorescence from certain aromatics, particularly in a polar medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "TICT state" .

goldbook:T06375 a skos:Concept ;
    skos:definition "Base quantity in the system of quantities upon which SI is based." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time" .

goldbook:T06376 a skos:Concept ;
    skos:definition "If the output of a detector changes exponentially with time, the time required for it to change from its initial value by the fraction \\(1 - \\exp(-t/\\tau _{\\rm{c}})\\) (for \\(t=\\tau _{\\rm{c}}\\)) of the final value, is called the time constant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time constant" .

goldbook:T06377 a skos:Concept ;
    skos:altLabel "single photon timing" ;
    skos:definition "A technique for the measurement of the time histogram of a sequence of photons with respect to a periodic event, e.g. a flash from a repetitive nanosecond lamp or a CW operated laser (mode locked laser). The essential part is a time-to-amplitude-converter (TAC) which transforms the arrival time between a start and a stop pulse into a voltage. Sometimes called single photon timing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-correlated single photon counting" .

goldbook:T06378 a skos:Concept ;
    skos:definition "A state in which if intermediates are formed in significant amounts during the course of a reaction, the overall stoichiometric equation does not apply throughout." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-dependent stoichiometry" .

goldbook:T06379 a skos:Concept ;
    skos:definition "A state in which the stoichiometric equation applies throughout the course of the reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-independent stoichiometry" .

goldbook:T06380 a skos:Concept ;
    skos:definition "The time difference from switching on until switching off. The time for deceleration is not included." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time of centrifugation" .

goldbook:T06382 a skos:Concept ;
    skos:definition "An arrangement using the fact that ions of different mass/charge need different times to travel through a certain distance in a field-free region after they have all been initially given the same translational energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-of-flight mass spectrometer" .

goldbook:T06383 a skos:Concept ;
    skos:definition "The time in which a certain viscosity or yield stress is reached after discontinuation of a shear. These times depend on the values of viscosity or yield stress chosen by the experimenter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time" .

goldbook:T06384 a skos:Concept ;
    skos:altLabel "TRMC" ;
    skos:definition "Technique allowing the quantitative and qualitative detection of radiation-induced changes in the real, \\(\\Delta \\rm{Re}\\sigma\\), and imaginary, \\(\\Delta \\rm{Im}\\sigma\\), components of the conductivity of a medium by time-resolved measurement of changes in the microwave absorption resulting from the formation of mobile charges or from changes in the dipole moment or polarizability of molecules on excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-resolved microwave conductivity" .

goldbook:T06385 a skos:Concept ;
    skos:definition "The recording of spectra at a series of time intervals after the excitation of the system with a light pulse (or other perturbation) of appropriately short duration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-resolved spectroscopy" .

goldbook:T06395 a skos:Concept ;
    skos:altLabel "insertion reaction",
        "topotactic reaction" ;
    skos:definition "A reversible or irreversible reaction that involves the introduction of a guest species into a host structure and that results in significant structural modifications to the host, for example, the breakage of bonds. Example: The insertion of lithium at \\(50\\,^{\\unicode{x26ac}}\\rm{C}\\) into the spinel $\\ce{Li[Mn2]O4}$ with symmetry \\(F\\,\\rm{d3m}\\) to yield a layered structure with symmetry \\(P\\bar{3}\\,\\rm{m1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topochemical reaction" .

goldbook:T06396 a skos:Concept ;
    skos:definition "The identity reaction leading to exchange of the positions of identical ligands. The indistinguishable molecular entities involved are called topomers. For example in the reaction below the two identical ligating atoms $\\ce{N_{\\rm{a}}}$ and $\\ce{N_{\\rm{b}}}$ are interchanged by rotation about the $\\ce{C-aryl}$ bond but may be identified by NMR spectroscopy. This is a degenerate isomerization." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topomerization" .

goldbook:T06399 a skos:Concept ;
    skos:definition "A transition in which the crystal lattice of the product phase shows one or more crystallographically equivalent, orientational relationships to the crystal lattice of the parent phase. Example: Transitions in which the anionic array is unchanged during the transition but cation reorganization occurs, as in:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topotactic transition" .

goldbook:T06401 a skos:Concept ;
    skos:definition "The preference for 'inward' or 'outward' rotation of substituents in conrotatory or disrotatory electrocyclic ring opening reactions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torquoselectivity" .

goldbook:T06402 a skos:Concept ;
    skos:definition "Non-SI unit of pressure, \\(\\rm{torr}\\approx 133.322\\ \\rm{Pa}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torr" .

goldbook:T06404 a skos:Concept ;
    skos:definition "Stereoisomers that can be interconverted (actually or conceptually) by torsion about a bond axis. This includes E,Z-isomers of alkenes, atropisomers and rotamers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torsional stereoisomers" .

goldbook:T06406 a skos:Concept ;
    skos:definition "In a chain of atoms A-B-C-D, the dihedral angle between the plane containing the atoms A,B,C and that containing B,C,D. In a Newman projection the torsion angle is the angle (having an absolute value between 0° and 180°) between bonds to two specified (fiducial) groups, one from the atom nearer (proximal) to the observer and the other from the further (distal) atom. The torsion angle between groups A and D is then considered to be positive if the bond A-B is rotated in a clockwise direction through less than 180° in order that it may eclipse the bond C-D: a negative torsion angle requires rotation in the opposite sense. Stereochemical arrangements corresponding to torsion angles between 0° and ±90° are called syn (s), those corresponding to torsion angles between ±90° and 180° anti (a). Similarly, arrangements corresponding to torsion angles between 30° and 150° or between -30° and -150° are called clinal (c) and those between 0° and 30° or 150° and 180° are called periplanar (p). The two types of terms can be combined so as to define four ranges of torsion angle; 0° to 30° synperiplanar (sp); 30° to 90° and -30° to -90° synclinal (sc); 90° to 150°, and -90° to -150° anticlinal (ac); ±150° to 180° antiperiplanar (ap).  The synperiplanar conformation is also known as the syn- or cis-conformation; antiperiplanar as anti or trans and synclinal as gauche or skew. For macromolecular usage the symbols \\(\\rm{T}\\), \\(\\rm{C}\\), \\(\\rm{G}^{+}\\), \\(\\rm{G}^{-}\\), \\(\\rm{A}^{+}\\) and \\(\\rm{A}^{-}\\) are recommended (ap, sp, +sc, -sc, +ac and -ac respectively)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "torsion angle" .

goldbook:T06409 a skos:Concept ;
    skos:definition "The time necessary to consume the prepared sample completely (in \\(\\mathrm{s}\\)). It is equal to the volume of the prepared sample divided by the rate of fluid consumption." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total consumption time" .

goldbook:T06410 a skos:Concept ;
    skos:definition "(after mass analysis): The sum of the separate ion currents carried by the different ions contributing to the spectrum (this is sometimes called the reconstructed ion current).(before mass analysis): The sum of all the separate ion currents for ions of the same sign before mass analysis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total ion current" .

goldbook:T06411 a skos:Concept ;
    skos:definition "Packing in which the stationary phase permeates each porous particle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "totally porous packing" .

goldbook:T06413 a skos:Concept ;
    skos:altLabel "retention time",
        "time" ;
    skos:definition "The volume of mobile phase entering the column between sample injection and the emergence of the peak maximum of the sample component of interest, or the corresponding time. It includes the hold-up volume (time): \\[t_{\\rm{R}}=\\frac{V_{\\rm{R}}}{F_{\\rm{c}}}\\] where \\(F_{c}\\) is the mobile phase flow rate at column temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total retention volume" .

goldbook:T06414 a skos:Concept ;
    skos:definition "Capacity to cause injury to a living organism defined with reference to the quantity of substance administered or absorbed, the way in which the substance is administered (inhalation, ingestion, topical application, injection) and distributed in time (single or repeated doses), the type and severity of injury, the time needed to produce the injury, the nature of the organism(s) affected and other relevant conditions.Adverse effects of a substance on a living organism defined with reference to the quantity of substance administered or absorbed, the way in which the substance is administered (inhalation, ingestion, topical application, injection) and distributed in time (single or repeated doses), the type and severity of injury, the time needed to produce the injury, the nature of the organism(s) affected, and other relevant conditions.Measure of incompatibility of a substance with life: this quantity may be expressed as the reciprocal of the absolute value of median lethal dose (\\(\\frac{1}{\\rm{LD}_{50}}\\)) or concentration (\\(\\frac{1}{\\rm{LC}_{50}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicity" .

goldbook:T06415 a skos:Concept ;
    skos:definition "Study of toxic actions on living systems, including the reactions with and binding to cell constituents, and the biochemical and physiological consequences of these actions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicodynamics" .

goldbook:T06416 a skos:Concept ;
    skos:definition "Process of the uptake of potentially toxic substances by the body, the biotransformation they undergo, the distribution of the substances and their metabolites in the tissues, and the elimination of the substances and their metabolites from the body. Both the amounts and the concentrations of the substances and their metabolites are studied. The term has essentially the same meaning as pharmacokinetics, but the latter term should be restricted to the study of pharmaceutical substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicokinetics" .

goldbook:T06417 a skos:Concept ;
    skos:definition "Scientific discipline involving the study of the actual or potential danger presented by the harmful effects of substances (poisons) on living organisms and ecosystems, of the relationship of such harmful effects to exposure, and of the mechanisms of action, diagnosis, prevention and treatment of intoxications." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxicology" .

goldbook:T06418 a skos:Concept ;
    skos:definition "Poisonous substance produced by a biological organism such as a microbe, animal or plant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxin" .

goldbook:T06419 a skos:Concept ;
    skos:definition "Scientific discipline involving the study of the chemistry, biochemistry, pharmacology and toxicology of toxins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "toxinology" .

goldbook:T06420 a skos:Concept ;
    skos:definition "The property of a result or measurement whereby it can be related to appropriate standards, generally international or national standards, through an unbroken chain of comparisons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "traceability" .

goldbook:T06421 a skos:Concept ;
    skos:definition "Any element having an average concentration of less than about 100 parts per million atoms (\\(\\rm{ppma}\\)) or less than \\(100\\ \\frac{\\unicode[Times]{x3BC}\\rm{g}}{\\rm{g}}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trace element" .

goldbook:T06422 a skos:Concept ;
    skos:definition "A foreign substance mixed with or attached to a given substance to enable the distribution or location of the latter to be determined subsequently. There are several types of tracers which are used: (i) A physical tracer is one that is attached by physical means to the object being traced; (ii) A chemical tracer is a chemical with properties similar to those of the substance being traced with which it is mixed homogeneously; (iii) An isotopic tracer is a unique isotope, either radioactive or an enriched, uncommon stable isotope, of the element to be traced; (iv) A radioactive tracer is a physical or chemical tracer having radioactivity as its distinctive property which allows detection at small concentrations and hence after large transport distances. The composition of aerosols in the troposphere has been used as a qualitative tracer of air masses. The elemental analyses (determined by neutron activation, X-ray fluorescence, etc.) of the aerosols transported from various sources or source regions sometimes have characteristic patterns which are used to define qualitatively the origin of tropospheric aerosols collected in other geographical regions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tracer" .

goldbook:T06429 a skos:Concept ;
    skos:definition "The path of an ionizing particle as revealed by a track detector." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "track" .

goldbook:T06430 a skos:Concept ;
    skos:definition "A detector which makes the paths of ionizing particles visible, either directly (e.g. cloud chamber) or after suitable treatment (photographic emulsion, polymers)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "track detector" .

goldbook:T06431 a skos:Concept ;
    skos:definition "A path taken by a reaction system over potential-energy surface or a diagram or mathematical description that represents that path. A trajectory can also be called a reaction path." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trajectory" .

goldbook:T06433 a skos:Concept ;
    skos:definition "A prefix designating two groups directly across a central atom from each other, i.e. in the polar positions on a sphere, not now generally recommended for precise nomenclature purposes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>trans-</i>" .

goldbook:T06434 a skos:Concept ;
    skos:definition "In medium-sized ring compounds, the strain due to repulsive nonbonded interactions between substituents or hydrogen atoms attached to non-adjacent ring atoms." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transannular strain" .

goldbook:T06436 a skos:Concept ;
    skos:definition "The process by which the genetic information encoded in a linear sequence of nucleotides in one strand of DNA is copied into an exactly complementary sequence of RNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transcription" .

goldbook:T06437 a skos:Concept ;
    skos:definition "An analytical instrument which provides an output quantity having a given relationship to the input quantity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transducer" .

goldbook:T06438 a skos:Concept ;
    skos:definition "The transfer of genetic information from one bacterium to another by means of a transducing bacteriophage. When the phage is grown on the first host, a fragment of the host DNA can be incorporated into the phage particles. This foreign DNA can be transferred to the second host upon infection with progeny phage from the first experiment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transduction" .

goldbook:T06439 a skos:Concept ;
    skos:definition "Movement of a component within a system or across its boundary. It may be expressed using different kinds of quantities, e.g rates of change \\(\\frac{\\rm{d}Q}{\\rm{d}t}\\) or \\(\\frac{\\Delta Q}{\\Delta t}\\). Examples are: mass rate, \\(\\frac{\\rm{d}m_{\\rm{B}}}{\\rm{d}t}\\) or \\(\\frac{\\Delta m_{\\rm{B}}}{\\Delta t}\\); substance rate, \\(\\frac{\\rm{d}n_{\\rm{B}}}{\\rm{d}t}\\) or \\(\\frac{\\Delta n_{\\rm{B}}}{\\Delta t}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer" .

goldbook:T06440 a skos:Concept ;
    skos:definition "The action of moving material between containers, or containers between transport devices. This term is of particular importance in clinical chemistry." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer" .

goldbook:T06441 a skos:Concept ;
    skos:definition "Transferability assumes invariance of properties, associated conceptually with an atom or a fragment present in a variety of molecules. The property, such as electronegativity, nucleophilicity, NMR chemical shift, etc. is held as retaining a similar value in all these occurrences." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transferability" .

goldbook:T06442 a skos:Concept ;
    skos:definition "A term used to quantify the difference in the free energy of a solute ion in two different standard states often in two different liquid phases. The relationship is \\(\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}} =  u \\ R\\ T\\ \\ln \\mathit{\\gamma}_{\\rm{t}}\\) where \\(\\Delta _{\\rm{t}}G^{\\,\\unicode{x26ac}}\\) is the transfer Gibbs energy and \\( u \\) is the number of ions in the solute." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer activity coefficient" .

goldbook:T06443 a skos:Concept ;
    skos:definition "Enzymes that catalyse reactions in which a group is transferred from one compound to another. Groups that are transferred are $\\ce{C}$, aldehydic or ketonic residues, acyl, glycosyl, alkyl, nitrogenous, phosphorus and sulfur containing groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transferases" .

goldbook:T06444 a skos:Concept ;
    skos:definition "Line provided to carry the sample to be analysed from the sample point to the analytical unit without altering the composition of the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer line" .

goldbook:T06445 a skos:Concept ;
    skos:altLabel "tRNA" ;
    skos:definition "A single-stranded RNA molecule containing about 70-90 nucleotides, folded by intrastrand base pairing into a characteristic secondary ('cloverleaf') structure that carries a specific amino acid and matches it to its corresponding codon on an mRNA during protein synthesis." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transfer RNA" .

goldbook:T06446 a skos:Concept ;
    skos:definition "The conversion of a substrate into a particular product, irrespective of reagents or mechanisms involved. For example, the transformation of aniline ($\\ce{C6H5NH2}$) into N-phenylacetamide ($\\ce{C6H5NHCOCH3}$) may be effected by use of acetyl chloride or acetic anhydride or ketene. A transformation is distinct from a reaction, the full description of which would state or imply all the reactants and all the products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transformation" .

goldbook:T06447 a skos:Concept ;
    skos:definition "A process for genetic alteration of a cell following incorporation of foreign DNA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transformation" .

goldbook:T06450 a skos:Concept ;
    skos:altLabel "induction period" ;
    skos:definition "This expression relates to the period of time that elapses prior to the establishment of a steady state. Initially the concentration of a reactive intermediate is zero, and it rises to the steady-state concentration during the transient phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient phase" .

goldbook:T06451 a skos:Concept ;
    skos:altLabel "transient chemical species" ;
    skos:definition "Relating to a short-lived reaction intermediate. It can be defined only in relation to a time scale fixed by the experimental conditions and the limitations of the technique employed in the detection of the intermediate. The term is a relative one. Transient species are sometimes also said to be 'metastable'. However, this latter term should be avoided, because it relates a thermodynamic term to a kinetic property, although most transients are also thermodynamically unstable with respect to reactants and products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient species" .

goldbook:T06453 a skos:Concept ;
    skos:definition "A technique for the spectroscopic observation of transient species (excited-state molecular entities or reactive intermediates) generated by a pulse of short duration." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient spectroscopy" .

goldbook:T06455 a skos:Concept ;
    skos:definition "The reaction coordinate at the transition state corresponding to a vibration with an imaginary frequency. Motion along it in the two opposite senses leads towards the reactants or towards the products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition coordinate" .

goldbook:T06456 a skos:Concept ;
    skos:definition "An element whose atom has an incomplete d sub-shell, or which can give rise to cations with an incomplete d sub-shell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition element" .

goldbook:T06460 a skos:Concept ;
    skos:altLabel "electronic transition moment",
        "transition dipole moment" ;
    skos:definition "An electromagnetic wave may induce an oscillating electric moment in a molecule (possibly leading to absorption if the oscillation frequency is equal to the light frequency). The amplitude of this moment is the transition moment between the initial (i) and final (f) states (here assumed to be non-degenerate): \\[M_{\\rm{if}} = \\, < \\rm{f} \\mid M_{\\rm{op}}\\mid \\rm{i} >\\] where \\(M_{\\rm{op}}\\) is the electric dipole moment operator, a vector operator that is the sum of the position vectors of all charged particles weighted with their charge. The transition moment \\(M_{\\rm{if}} \\) is a vector in the molecular framework, characterized both by its direction and its probability." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition moment" .

goldbook:T06462 a skos:Concept ;
    skos:definition "The direction of the transition moment in the molecular framework." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition polarization" .

goldbook:T06467 a skos:Concept ;
    skos:definition "Any intermediate species in an elementary reaction. An activated complex is an example of a transition species, but the latter term also includes other intermediate species. Transition species have also been called transition states, but there is then danger of confusion with a true activated complex, which is also commonly known as a transition state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition species" .

goldbook:T06468 a skos:Concept ;
    skos:definition "In theories describing elementary reaction it is usually assumed that there is a transition state of more positive molar Gibbs energy between the reactants and the products through which an assembly of atoms (initially composing the molecular entities of the reactants) must pass on going from reactants to products in either direction. In the formalism of 'transition state theory' the transition state of an elementary reaction is that set of states (each characterized by its own geometry and energy) in which an assembly of atoms, when randomly placed there, would have an equal probability of forming the reactants or of forming the products of that elementary reaction. The transition state is characterized by one and only one imaginary frequency. The assembly of atoms at the transition state has been called an activated complex. (It is not a complex according to the definition in this Compendium.) It may be noted that the calculations of reaction rates by the transition state method and based on calculated potential-energy surfaces refer to the potential energy maximum at the saddle point, as this is the only point for which the requisite separability of transition state coordinates may be assumed. The ratio of the number of assemblies of atoms that pass through to the products to the number of those that reach the saddle point from the reactants can be less than unity, and this fraction is the 'transmission coefficient' \\(\\kappa \\). (There are also reactions, such as the gas-phase colligation of simple radicals, that do not require 'activation' and which therefore do not involve a transition state.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition state" .

goldbook:T06469 a skos:Concept ;
    skos:definition "A substrate designed to mimic the properties or the geometry of the transition state of reaction." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition state analogue" .

goldbook:T06470 a skos:Concept ;
    skos:altLabel "conventional transition-state theory" ;
    skos:definition "A theory of the rates of elementary reactions which assumes a special type of equilibrium, having an equilibrium constant \\(K^{\\ddagger }\\), to exist between reactants and activated complexes. According to this theory the rate constant is given by: \\[k=\\frac{k_{\\rm{B}}\\ T}{h}\\ K^{\\ddagger }\\] where \\(k_{B}\\) is the Boltzmann constant and \\(h\\) is the Planck constant. The rate constant can also be expressed as: \\[k=\\frac{k_{\\rm{B}}\\ T}{h}\\ \\exp (\\frac{\\Delta ^{\\ddagger }S^{\\,\\unicode{x26ac}}}{R})\\ \\exp (- \\frac{\\Delta ^{\\ddagger }H^{\\,\\unicode{x26ac}}}{R\\ T})\\] where \\(\\Delta ^{\\ddagger}S^{\\,\\unicode{x26ac}}\\), the entropy of activation, is the standard molar change of entropy when the activated complex is formed from reactants and \\(\\Delta ^{\\ddagger}H^{\\,\\unicode{x26ac}}\\), the enthalpy of activation, is the corresponding standard molar change of enthalpy. The quantities \\(E_{a}\\) (the energy of activation) and \\(\\Delta ^{\\ddagger}H^{\\,\\unicode{x26ac}}\\) are not quite the same, the relationship between them depending on the type of reaction. Also: \\[k=\\frac{k_{\\rm{B}}\\ T}{h}\\ \\exp (- \\frac{\\Delta ^{\\ddagger }G^{\\,\\unicode{x26ac}}}{R\\ T})\\] where \\(\\Delta ^{\\ddagger}G^{\\,\\unicode{x26ac}}\\), known as the Gibbs energy of activation, is the standard molar Gibbs energy change for the conversion of reactants into activated complex. A plot of standard molar Gibbs energy against a reaction coordinate is known as a Gibbs-energy profile; such plots, unlike potential-energy profiles, are temperature-dependent. In principle the equations above must be multiplied by a transmission coefficient, \\(\\kappa \\), which is the probability that an activated complex forms a particular set of products rather than reverting to reactants or forming alternative products. It is to be emphasized that \\(\\Delta ^{\\ddagger}S^{\\,\\unicode{x26ac}}\\), \\(\\Delta ^{\\ddagger}H^{\\,\\unicode{x26ac}}\\) and \\(\\Delta ^{\\ddagger}G^{\\,\\unicode{x26ac}}\\) occurring in the former three equations are not ordinary thermodynamic quantities, since one degree of freedom in the activated complex is ignored. Transition-state theory has also been known as absolute rate theory, and as activated-complex theory, but these terms are no longer recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition state theory" .

goldbook:T06471 a skos:Concept ;
    skos:definition "A saddle point on a potential-energy surface. It has one negative force constant in the harmonic force constant matrix." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition structure" .

goldbook:T06472 a skos:Concept ;
    skos:definition "In chronopotentiometry and related techniques, the time that elapses between the instant at which current is applied and the instant at which the concentration of an electroactive substance B at the electrode-solution interface becomes indistinguishable from zero. In experimental practice the latter time is often taken to be the instant at which the rate of variation of the potential of the indicator electrode attains a maximum value." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition time" .

goldbook:T06474 a skos:Concept ;
    skos:definition "The time needed for the component to pass through the observation space (in \\(\\mathrm{s}\\)). It depends on the geometry of the observation space, the flame temperature and the solute nebulized." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transit time" .

goldbook:T06475 a skos:Concept ;
    skos:definition "The unidirectional process that takes place on the ribosomes whereby the genetic information present in an mRNA is converted into a corresponding sequence of amino acids in a protein." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "translation" .

goldbook:T06476 a skos:Concept ;
    skos:definition "A technique to investigate the distribution of the velocity of product ions from reactions of ions and neutral species." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "translational spectroscopy" .

goldbook:T06478 a skos:Concept ;
    skos:definition "The ratio of the number of ions leaving a region of a mass spectrometer to the number entering that region." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission" .

goldbook:T06480 a skos:Concept ;
    skos:altLabel "TEELS" ;
    skos:definition "Any technique in which an electron transparent specimen is bombarded with a finely focused electron beam and the energy distribution of the transmitted electrons is measured. This energy spectrum contains features corresponding to discrete losses of energy of the transmitted electrons due to excitation of electronic or plasmon states and provides information on the identity (and in some cases) chemical bonding of the elements in the sample." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission electron energy loss spectroscopy" .

goldbook:T06481 a skos:Concept ;
    skos:altLabel "TEM",
        "electron microscopy" ;
    skos:definition "Any technique in which an electron transparent sample is bombarded with an electron beam and the intensity of the transmitted electrons which is determined by scattering phenomena (electron absorption phenomena) in the interior of the sample is recorded. TEM essentially provides a high resolution image of the microstructure of a thin sample. This technique is often just called 'electron microscopy'. The term transmission electron microscopy is however recommended for the sake of a clear distinction from other electron microscopic techniques." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmission electron microscopy" .

goldbook:T06484 a skos:Concept ;
    skos:altLabel "transmission factor" ;
    skos:definition "The ratio of the transmitted radiant power (\\(P_{\\lambda }\\)) to that incident on the sample (\\(P_{\\lambda }^{0}\\)): \\[T=\\frac{P_{\\lambda }}{P_{\\lambda }^{0}}\\] Internal transmittance refers to energy loss by absorption, whereas the total transmittance is that due to absorption, reflection, scatter, etc." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transmittance" .

goldbook:T06486 a skos:Concept ;
    skos:definition "The action of moving materials within the analytical instrument. Transport can involve any of several means including pressure flow, where the materials are moved by fluid pressure, either continuously or discontinuously; centrifugal flow, where the materials are moved by centrifugal force; spontaneous motion, where the materials are moved due to their intrinsic properties, e.g. diffusion, capillarity; and discrete transport, where materials are enclosed within a moving container." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transport" .

goldbook:T06490 a skos:Concept ;
    skos:definition "A movable DNA element that can be inserted at new sites into plasmids or chromosomes independently of the host cell recombination system. Prokaryotic transposons can carry genes that confer new phenotypic properties, such as resistance to antibiotics on the host." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transposon" .

goldbook:T06492 a skos:Concept ;
    skos:definition "The interception of a reactive molecule or reaction intermediate so that it is removed from the system or converted into a more stable form for study or identification." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trapping" .

goldbook:T06493 a skos:Concept ;
    skos:definition "The time needed for the component to be carried from the burner tip to the observation space (in \\(\\mathrm{s}\\)). Travel time depends on the observation height and the flame rise velocity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "travel time" .

goldbook:T06494 a skos:Concept ;
    skos:definition "The test solution that has been subjected to reaction or separation procedures prior to measurement of some property." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "treated solution" .

goldbook:T06496 a skos:Concept ;
    skos:definition "An affix used in names to denote three atoms bound into a triangle." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>triangulo</i>-" .

goldbook:T06497 a skos:Concept ;
    skos:definition "Triazane, $\\ce{NH2NHNH2}$, and its hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triazanes" .

goldbook:T06498 a skos:Concept ;
    skos:definition "Triazene, $\\ce{NH2N=NH}$, and its hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triazenes" .

goldbook:T06499 a skos:Concept ;
    skos:definition "Luminescence resulting from the rubbing together of the surface of certain solids. It can be produced, for example, when solids are crushed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triboluminescence" .

goldbook:T06500 a skos:Concept ;
    skos:definition "The diradical $\\ce{CH2=C(C^{.}H2)2}$, 2-methylenepropane-1,3-diyl, for which no Kekulé structure can be written, and its hydrocarbyl derivatives." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trimethylenemethanes" .

goldbook:T06501 a skos:Concept ;
    skos:definition "Organic derivatives of trioxidane, $\\ce{HOOOH}$, e.g. $\\ce{ROOOR'}$. When $\\ce{R'} = \\ce{H}$, the compound is a hydrotrioxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trioxides" .

goldbook:T06502 a skos:Concept ;
    skos:definition "The point in a one-component system at which the temperature and pressure of three phases are in equilibrium. If there are \\(p\\) possible phases, there are \\(\\frac{p!}{(p\\,-\\,3)!\\ 3!}\\) triple points. Example: In the sulfur system four possible triple points (one metastable) exist for the four phases comprising rhombic $\\ce{S}$ (solid), monoclinic $\\ce{S}$ (solid), $\\ce{S}$ (liquid) and $\\ce{S}$ (vapour)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triple point" .

goldbook:T06503 a skos:Concept ;
    skos:definition "A state having a total electron spin quantum number of 1." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triplet state" .

goldbook:T06504 a skos:Concept ;
    skos:definition "Absorption which takes place with the transition from the lowest triplet state of the molecule to higher triplet states (T → \\(T_{n}\\)) thus leading to the triplet-triplet absorption spectrum." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triplet-triplet absorption" .

goldbook:T06505 a skos:Concept ;
    skos:definition "Two atoms or molecular entities both in a triplet state often interact (usually upon collision) to produce one atom or molecular entity in an excited singlet state and another in its ground singlet state. This is often, but not always, followed by delayed fluorescence." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triplet-triplet annihilation" .

goldbook:T06506 a skos:Concept ;
    skos:altLabel "TTET" ;
    skos:definition "Energy transfer from an electronically excited triplet donor to produce an electronically excited acceptor in its triplet state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triplet-triplet energy transfer" .

goldbook:T06507 a skos:Concept ;
    skos:definition "Electronic transitions in which both the initial and final states are triplet states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triplet-triplet transitions" .

goldbook:T06508 a skos:Concept ;
    skos:definition "An affix used in names to denote six atoms bound into a triangular prism." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>triprismo</i>-" .

goldbook:T06510 a skos:Concept ;
    skos:definition "Terpenoids having a $\\ce{C30}$ skeleton." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "triterpenoids" .

goldbook:T06513 a skos:Concept ;
    skos:definition "A specific name for the atom $\\ce{^{3}H}$. The cation $\\ce{^{3}H^{+}}$ is a triton, the species $\\ce{^{3}H^{−}}$ is a tritide anion and $\\ce{^{3}H}$ is the tritio group." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tritium" .

goldbook:T06516 a skos:Concept ;
    skos:definition "A name having no part used in a systematic sense." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "trivial name" .

goldbook:T06517 a skos:Concept ;
    skos:definition "A semiempirical description of the rate coefficient for a specific three body reaction [e.g. ] which represents well its pressure and temperature dependence in the region of transition between second and third order kinetics." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Troe expression" .

goldbook:T06518 a skos:Concept ;
    skos:definition "This term has inconsistently been used to mean cyclohepta-1,3,5-trienes or to mean cyclohepta-1,3,5-trienes in dynamic equilibrium with bicyclo-[4.1.0]hepta-2,4-dienes, so that the structure of the bulk substance is indeterminate in the time scale of the method of observation. Use of this term is therefore discouraged." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tropilidenes" .

goldbook:T06519 a skos:Concept ;
    skos:definition "2-Hydroxycyclohepta-2,4,6-trienones and derivatives formed by substitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tropolones" .

goldbook:T06520 a skos:Concept ;
    skos:definition "Compounds that contain the cyclohepta-2,4,6-trienone ring system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tropones" .

goldbook:T06521 a skos:Concept ;
    skos:definition "The region of the atmosphere which joins the troposphere and stratosphere, and where the decreasing temperature with altitude, characteristic of the troposphere ceases, and the temperature increase with height which is characteristic of the stratosphere begins." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tropopause" .

goldbook:T06522 a skos:Concept ;
    skos:definition "The lowest layer of the atmosphere, ranging from the ground to the base of the stratosphere (tropopause) at \\(10{-}15\\ \\rm{km}\\) of altitude depending on the latitude and meteorological conditions. About 70% of the mass of the atmosphere is in the troposphere. This is where most of the weather features occur and where the chemistry of the reactive anthropogenic species released into the atmosphere takes place." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "troposphere" .

goldbook:T06523 a skos:Concept ;
    skos:definition "The delocalized carbenium ion, cycloheptatrienylium, $\\ce{C7H7^{+}}$, derived formally by detachment of one hydride ion from the $\\ce{CH2}$ group of cyclohepta-1,3,5-triene and substitution derivatives thereof." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tropylium ions" .

goldbook:T06524 a skos:Concept ;
    skos:definition "The delocalized radicals derived formally by abstraction of one hydrogen from the $\\ce{CH2}$ group of cyclohepta-1,3,5-triene and substitution derivatives thereof." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tropyl radicals" .

goldbook:T06527 a skos:Concept ;
    skos:definition "The value that characterizes a quantity perfectly in the conditions that exist when that quantity is considered. It is an ideal value which could be arrived at only if all causes of measurement error were eliminated, and the entire population was sampled." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "true value" .

goldbook:T06528 a skos:Concept ;
    skos:definition "A conformation (of symmetry group \\(D_{\\rm{2d}}\\)) of an eight-membered ring in which the four atoms forming one pair of diametrically opposite bonds in the ring lie in one plane and all other ring atoms lie to one side of that plane. It is analogous to the boat conformation of cyclohexane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tub conformation" .

goldbook:T06529 a skos:Concept ;
    skos:definition "A high intensity source with narrow spectral bandwidth, with and without frequency doubling and/or Raman shifting. Its use may enable the spectral apparatus to be omitted. Tunable lasers may be either continuous (CW) or pulsed in nature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tunable laser" .

goldbook:T06531 a skos:Concept ;
    skos:altLabel "quantum-mechanical tunnelling" ;
    skos:definition "The process by which a particle or a set of particles crosses a barrier on its potential-energy surface without having the energy required to surmount this barrier. Since the rate of tunnelling decreases with increasing reduced mass, it is significant in the context of isotope effects of hydrogen isotopes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tunnelling" .

goldbook:T06534 a skos:Concept ;
    skos:definition "Commonly called the turnover number, \\(N\\), and defined, as in enzyme catalysis, as molecules reacting per active site in unit time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "turnover frequency" .

goldbook:T06537 a skos:Concept ;
    skos:altLabel "TICT" ;
    skos:definition "In a TICT state formed by intramolecular charge transfer in an electron donor ($\\ce{D}$)/acceptor ($\\ce{A}$) molecule, the $\\ce{D}$ and $\\ce{A}$ subgroups have a mutually perpendicular configuration that leads to electronic decoupling of $\\ce{D}$ and $\\ce{A}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "twisted intramolecular charge transfer" .

goldbook:T06540 a skos:Concept ;
    skos:definition "A procedure in which parts or all of the separated sample components are subjected to additional separation steps. This can be done e.g. by conducting a particular fraction eluting from the column into another column (system) having different separation characteristics. When combined with additional steps, this may be described as multi-dimensional chromatography. In planar chromatography two-dimensional chromatography refers to the chromatographic process in which the components are caused to migrate first in one direction and subsequently in a direction at right angles to the first one; the two elutions are carried out with different eluents." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-dimensional chromatography" .

goldbook:T06541 a skos:Concept ;
    skos:definition "Excitation resulting from successive or simultaneous absorption of two photons by an atom or molecular entity. This term is used for successive absorption only if some of the excitation energy of the first photon remains in the atom or molecular entity before absorption of the second photon. The simultaneous two-photon absorption can also be called biphotonic excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-photon excitation" .

goldbook:T06542 a skos:Concept ;
    skos:definition "A photophysical or photochemical event triggered by a two-photon excitation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-photon process" .

goldbook:T06543 a skos:Concept ;
    skos:definition "Immunoradiometric assay involving two sets of antibodies, one of which is labelled, that combine with different immunoreactive sites of an antigen molecule." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-site immunoradiometric assay" .

goldbook:TT06812 a skos:Concept ;
    skos:definition "Any organism, organ, tissue, cell, or cell constituent that is subject to the action of an agent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "target" .

goldbook:TT06846 a skos:Concept ;
    skos:definition "Consequence of application of a substance to the surface of the body which occurs at the point of application." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "topical effect" .

goldbook:TT06897 a skos:Concept ;
    skos:definition "A mesophase formed by heating a solid or cooling an isotropic liquid, or by heating or cooling a thermodynamically stable mesophase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermotropic mesophase" .

goldbook:TT06898 a skos:Concept ;
    skos:definition "The temperature at which the transition from mesophase X to mesophase Y occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transition temperature" .

goldbook:TT06915 a skos:Concept ;
    skos:altLabel "TLV" ;
    skos:definition "The concentration in air to which it is believed that most workers can be exposed daily without an adverse effect (i.e., effectively, the threshold between safe and dangerous concentrations). The values were established (and are revised annually) by the ACGIH and are time-weighted concentrations (TWA) for a 7- or 8-h workday and 40-h workweek, and thus are related to chronic effects. A short-term exposure limit (STEL) is defined as a 15-min TWA exposure, which should not be exceeded at any time during a workday even if the 8-h TWA is within the TLV-TWA." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "threshold limit value" .

goldbook:TT06926 a skos:Concept ;
    skos:definition "The sum of electrophoretic velocity, \\( u_{\\rm{ep}}\\), of an ion and the electroosmotic velocity, \\( u _{\\rm{eo}}\\). \\[ u_{\\rm{tot}} =  u_{\\rm{ep}}\\,+\\, u_{\\rm{eo}}\\] This quantity can be measured experimentally as the effective length of the capillary divided by the migration time (\\(L_{\\rm{eff}}/t_{\\rm{m}}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "total velocity of the analyte" .

goldbook:TT07167 a skos:Concept ;
    skos:definition "Prepolymer capable of entering into further polymerization or other reactions through its reactive end-groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "telechelic polymer" .

goldbook:TT07168 a skos:Concept ;
    skos:definition "Prepolymer in a soft solid or viscous state that changes irreversibly into an infusible, insoluble polymer network by curing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermosetting polymer" .

goldbook:TT07268 a skos:Concept ;
    skos:definition "Elastomer comprising a thermoreversible network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoplastic elastomer" .

goldbook:TT07484 a skos:Concept ;
    skos:altLabel "TD-DFT" ;
    skos:definition "Methods for computing accurate excitation energies at a low computational cost in large molecular species within the time-dependent scheme and the density functional theory. It is the only available DFT-based method for computing electronic excitation energies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "time-dependent density functional theory" .

goldbook:TT07487 a skos:Concept ;
    skos:altLabel "TSEP" ;
    skos:definition "Transient-spectroscopy technique in which the excited state dynamics is probed via stimulating the molecular species from the photo-excited state (produced by a short pump pulse) back to the ground state by means of a short dump pulse at various pump–dump time delays." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient-stimulated emission pumping" .

goldbook:TT07490 a skos:Concept ;
    skos:definition "Tungsten lamp." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "tungsten-halogen lamp" .

goldbook:TT07491 a skos:Concept ;
    skos:definition "Photochromic process involving a two-photon process. The process might involve the simultaneous or the sequential absorption of two photons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "two-photon photochromism" .

goldbook:TT07531 a skos:Concept ;
    skos:definition "Swollen network in which the junction points are thermally reversible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoreversible gel" .

goldbook:TT07532 a skos:Concept ;
    skos:definition "Gel which has a reduced viscosity on the application of a finite shear but which recovers its original viscosity when the shear is discontinued." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thixotropic gel" .

goldbook:TT07544 a skos:Concept ;
    skos:definition "Ceramic yield based on the stoichiometry of the ceramization process." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "theoretical ceramic yield" .

goldbook:TT07573 a skos:Concept ;
    skos:definition "Reversible network that forms or breaks up as the temperature is changed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoreversible network" .

goldbook:TT07576 a skos:Concept ;
    skos:definition "Network that exists only transiently." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient network" .

goldbook:TT07595 a skos:Concept ;
    skos:definition "Crosslink formed by intermolecular or intramolecular interactions that are unstable under the conditions of use of the material formed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient crosslink" .

goldbook:TT07600 a skos:Concept ;
    skos:definition "Junction point in a polymer network that can be destroyed and formed reversibly by a change of temperature." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermoreversible junction point" .

goldbook:TT07601 a skos:Concept ;
    skos:definition "Junction point in a polymer network that exists only for a finite period of time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "transient junction point" .

goldbook:TT07616 a skos:Concept ;
    skos:definition "Curing induced by heating." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "thermal curing" .

goldbook:U06546 a skos:Concept ;
    skos:altLabel "stoichiometric capacity" ;
    skos:definition "The theoretical maximum capacity of a solvent containing a given concentration of extractant for a solute under any conditions. Where appropriate the term stoichiometric capacity can be used." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultimate capacity" .

goldbook:U06547 a skos:Concept ;
    skos:definition "The solution obtained by ultrafiltration, in general not of the same composition as the equilibrium solution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrafiltrate" .

goldbook:U06548 a skos:Concept ;
    skos:definition "A separation process whereby a solution containing a solute of molecular size significantly greater than that of the solvent molecule is removed from the solvent by the application of a hydraulic pressure which forces only the solvent to flow through a suitable membrane, usually having a pore size in the range \\(0.001{-}0.1\\ \\unicode[Times]{x3BC}\\rm{m}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrafiltration" .

goldbook:U06549 a skos:Concept ;
    skos:definition "Sound is generated in a reference cell and a measuring cell. An eluted component passing through the measuring cell changes the velocity of sound in the cell. This change is detected by a phase shift of acoustic signals between the two cells. This detector is usually employed for inorganic gases in the region where thermal conductivity detectors are not sufficiently sensitive. The detection threshold is of the order of \\(0.1\\ \\rm{ppmv}\\). The linear dynamic range is of the order of \\(10^{3}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultrasonic detector" .

goldbook:U06550 a skos:Concept ;
    skos:altLabel "reserve sample" ;
    skos:definition "A sample taken, prepared and stored in an agreed upon manner for the purpose of settling a dispute. The agreement usually extends beyond the sample to the basis for reaching a decision (e.g. quantity of material from which taken, use of a third party and criteria serving as the basis for acceptance, rejection or economic adjustment). The term 'reference sample' has been used in this context but this term more properly should be used in conjunction with a 'reference material' or 'reference standard' which has a true or assigned value for a constituent or property. One of the characteristics of a reference material or reference standard is that it must have a negligible sampling error between test portions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umpire sample" .

goldbook:U06551 a skos:Concept ;
    skos:definition "Any process by which the normal alternating donor and acceptor reactivity pattern of a chain, which is due to the presence of $\\ce{O}$ or $\\ce{N}$ heteroatoms, is interchanged. Reactivity umpolung is most often achieved by temporary exchange of heteroatoms ($\\ce{N}$, $\\ce{O}$) by others, such as $\\ce{P}$, $\\ce{S}$ and $\\ce{Se}$. The original meaning of the term has been extended to the reversal of any commonly accepted reactivity pattern. For example, reaction of $\\ce{R–C#CX}$ ($\\ce{X}$ = halide) as a synthon for $\\ce{'R–C#C^{+}}$ (i.e. electrophilic acetylene) is an umpolung of the normal more common acetylide, $\\ce{R–C#C^{−}}$ (i.e. nucleophilic) reactivity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "umpolung" .

goldbook:U06552 a skos:Concept ;
    skos:definition "If the temperature coefficient of the rate of adsorption is very small, the adsorption process is said to be unactivated (i.e. to have a negligible activation energy). In this case the sticking coefficient at low coverages may be near unity particularly for smaller molecules." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unactivated adsorption process" .

goldbook:U06554 a skos:Concept ;
    skos:altLabel "atomic mass unit" ;
    skos:definition "Non-SI unit of mass (equal to the atomic mass constant), defined as one twelfth of the mass of a carbon-12 atom in its ground state and used to express masses of atomic particles, \\(\\rm{u} \\approx \\pu{1.6605402(10)E-27 kg}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unified atomic mass unit" .

goldbook:U06555 a skos:Concept ;
    skos:definition "Corrosion is uniform if the time average of the corrosion current through a unit area of any macroscopic dimension is independent of the position on the surface." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniform corrosion" .

goldbook:U06556 a skos:Concept ;
    skos:definition "A selectively labelled compound where all atoms of a particular element are labelled in the same isotopic ratio." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniformly labelled" .

goldbook:U06557 a skos:Concept ;
    skos:definition "A tracer in which the label is uniformly distributed over its possible positions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniformly labelled tracer" .

goldbook:U06558 a skos:Concept ;
    skos:altLabel "monodisperse polymer" ;
    skos:definition "A polymer composed of molecules uniform with respect to relative molecular mass and constitution." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniform polymer" .

goldbook:U06560 a skos:Concept ;
    skos:altLabel "individual",
        "item",
        "portion" ;
    skos:definition "Each of the discrete, identifiable portions of material suitable for removal from a population as a sample or as a portion of a sample, and which can be individually considered, examined or tested, or combined. In the case of sampling bulk materials (or large packages), the units are increments, created by a sampling device. In the case of packaged materials, the unit may vary with the level of commercial distribution. For example, an individual piece of candy is the sampling unit at the consumer level; a package of individual pieces is the sampling unit at the retail level; a carton of packages is the sampling unit at the wholesale level; a pallet of cartons is the shipping unit at the distribution centre level; and a truckload of pallets is the consignment unit at the manufacture level. Before packaging, the bin containing the individual pieces would be the bulk lot (or batch) for sampling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unit" .

goldbook:U06561 a skos:Concept ;
    skos:definition "Particular quantity, defined and adopted by convention, with which other quanitities of the same kind are compared in order to express their magnitudes relative to that quantity. Units have conventionally assigned names and symbols." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unit" .

goldbook:U06565 a skos:Concept ;
    skos:definition "A detector which responds to every component in the column effluent except the mobile phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "universal detector" .

goldbook:U06567 a skos:Concept ;
    skos:definition "Failing to react with a specified chemical species under specified conditions. The term should not be used in place of stable, since a relatively more stable species may nevertheless be more reactive than some reference species towards a given reaction partner." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unreactive" .

goldbook:U06569 a skos:Concept ;
    skos:definition "The opposite of stable, i.e. the chemical species concerned has a higher molar Gibbs energy than some assumed standard. The term should not be used in place of reactive or transient, although more reactive or transient species are frequently also more unstable. (Very unstable chemical species tend to undergo exothermic unimolecular decompositions. Variations in the structure of the related chemical species of this kind generally affect the energy of the transition states for these decompositions less than they affect the stability of the decomposing chemical species. Low stability may therefore parallel a relatively high rate of unimolecular decomposition.)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unstable" .

goldbook:U06571 a skos:Concept ;
    skos:definition "An ion which is sufficiently excited to dissociate within the ion source." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "unstable ion" .

goldbook:U06574 a skos:Concept ;
    skos:definition "The process by which two photons with frequencies \\( u _{2}\\) and \\( u _{3}\\) combine in a non-linear medium to produce a higher energy photon with frequency \\( u _{1}\\) such that \\( u _{1}= u _{2}+ u _{3}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upconversion" .

goldbook:U06576 a skos:Concept ;
    skos:definition "Highest value of the air quality characteristic which can be measured by an instrument; its variations, caused for example by instability, are expected to lie within specified limits. The difference between the lower detection limit and the upper limit of measurement constitutes the dynamic range of the instrument." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upper limit of measurement" .

goldbook:U06577 a skos:Concept ;
    skos:definition "N-Acyl or N,N'-diacyl ureas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ureides" .

goldbook:U06578 a skos:Concept ;
    skos:altLabel "urethans" ;
    skos:definition "An alternative term for the compounds $\\ce{R2NC(=O)OR'}$ ($\\ce{R}  eq \\ce{H}$), esters of carbamic acids, $\\ce{R2NC(=O)OH}$, in strict use limited to the ethyl esters, but widely used in the general sense, e.g. 'polyurethane resins'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "urethanes" .

goldbook:U06579 a skos:Concept ;
    skos:altLabel "glycuronic acids" ;
    skos:definition "Monocarboxylic acids formally derived by oxidation to a carboxy group of the terminal $\\ce{–CH2OH}$ group of aldoses, e.g. ᴅ-glucuronic acid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uronic acids" .

goldbook:U06580 a skos:Concept ;
    skos:definition "Salts of O-hydronated urea, having the structure $\\ce{[HOC(=NH2)NH2]^{+}X^{−}}$ (and O- and N- hydrocarbyl derivatives)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uronium salts" .

goldbook:U06582 a skos:Concept ;
    skos:altLabel "UV dose" ;
    skos:definition "A dose of ultraviolet (UV) radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultraviolet dose" .

goldbook:U06584 a skos:Concept ;
    skos:altLabel "UV stabilizer" ;
    skos:definition "A substance added to a sample to prevent photodeterioration by ultraviolet (UV) light." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultraviolet stabilizer" .

goldbook:UT06806 a skos:Concept ;
    skos:definition "Entry of a substance into the body, into an organ, into a tissue, into a cell, or into the body fluids by passage through a membrane or by other means." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uptake" .

goldbook:UT06882 a skos:Concept ;
    skos:definition "Side of a membrane into which penetrants enter from the feed stream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upstream" .

goldbook:UT06884 a skos:Concept ;
    skos:definition "Process in which diffusion of a component occurs from a less concentrated stream to a more concentrated permeable stream." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uphill transport" .

goldbook:UT07280 a skos:Concept ;
    skos:altLabel "UCST" ;
    skos:definition "Critical temperature above which a mixture is miscible." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "upper critical solution temperature" .

goldbook:UT07492 a skos:Concept ;
    skos:altLabel "UV" ;
    skos:definition "Region of the electromagnetic spectrum extending from about \\(100\\ \\rm{nm}\\) to \\(400\\ \\rm{nm}\\). This region is divided into four sub-bands as follows: Vacuum UV (VUV)&nbsp;\\(100{-}200\\ \\rm{nm}\\)UV-C \\(200{-}280\\ \\rm{nm}\\)UV-B\\(280{-}315\\ \\rm{nm}\\)UV-A\\(315{-}400\\ \\rm{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ultraviolet" .

goldbook:UT07493 a skos:Concept ;
    skos:definition "Sample characterized by a (unique) sample axis Z with all directions perpendicular to Z being equivalent. In other words, the sample properties are invariant to rotation around Z. Uniaxiality exists in many anisotropic samples and simplifies the interpretation of their spectra considerably." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniaxial sample" .

goldbook:UT07638 a skos:Concept ;
    skos:definition "Application of pressure in one direction during ceramization to achieve a uniform densification and the production of a compact monolith." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "uniaxial pressing" .

goldbook:V05019 a skos:Concept ;
    skos:altLabel "rho-value" ;
    skos:definition "A measure of the susceptibility to the influence of substituent groups on the rate constant or equilibrium constant of a particular organic reaction involving a family of related substrates. Defined by Hammett for the effect of ring substituents in meta- and para-positions of aromatic side-chain reactions by the empirical '\\(\\rho \\sigma \\)-equation' of the general form: \\[\\log _{10}(\\frac{k_{\\rm{X}}}{k_{\\rm{H}}}) = \\rho \\ \\sigma _{\\rm{X}}\\] in which \\(\\sigma _{\\rm{X}}\\) is a constant characteristic of the substituent X and of its position in the reactant molecule. More generally (and not only for aromatic series), \\(\\rho \\)-values (modified with appropriate subscripts and superscripts) are used to designate the susceptibility of reaction series for families of various organic compounds to any substituent effects, as given by the modified set of \\(\\sigma \\)-constants in an empirical \\(\\rho \\sigma \\)-correlation. Reactions with a positive \\(\\rho \\)-value are accelerated (or the equilibrium constants of analogous equilibria are increased) by substituents with positive \\(\\sigma \\)-constants. Since the sign of \\(\\sigma \\) was defined so that substituents with a positive \\(\\sigma \\) increase the acidity of benzoic acid, such substituents are generally described as attracting electrons away from the aromatic ring. It follows that reactions with a positive \\(\\rho \\)-value are considered to involve a transition state (or reaction product) so that the difference in energy between this state and the reactants is decreased by a reduction in electron density at the reactive site of the substrate." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<i>ρ</i>-value" .

goldbook:V06585 a skos:Concept ;
    skos:definition "An agent containing antigens produced from killed, attenuated or live pathogenic microorganisms, synthetic peptides or by recombinant organisms, used for stimulating the immune system of the recipient to produce specific antibodies providing active immunity and/or passive immunity in the progeny." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vaccine" .

goldbook:V06586 a skos:Concept ;
    skos:definition "A photo-emissive detector inside an evacuated envelope with a transparent window, the photocathode, and the anode. The photocathode can be opaque or semitransparent." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vacuum phototube" .

goldbook:V06587 a skos:Concept ;
    skos:definition "Those components used to lower the pressure within a mass spectrometer are all parts of the vacuum system. This includes not only the various pumping components but also valves, gauges and associated electronic or other control devices, the chamber in which ions are formed and detected, and the vacuum envelope." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vacuum system" .

goldbook:V06588 a skos:Concept ;
    skos:definition "The maximum number of univalent atoms (originally hydrogen or chlorine atoms) that may combine with an atom of the element under consideration, or with a fragment, or for which an atom of this element can be substituted." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence" .

goldbook:V06589 a skos:Concept ;
    skos:definition "Highest energy continuum of energy levels in a solid that is fully occupied by electrons at \\(0\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence band" .

goldbook:V06590 a skos:Concept ;
    skos:definition "A constitutional isomer interrelated with another by pericyclic reactions. For example, Dewar benzene, prismane and benzvalene are valence isomers of benzene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence isomer" .

goldbook:V06591 a skos:Concept ;
    skos:definition "The term describes simple reversible and generally rapid isomerizations or degenerate rearrangements involving the formation and rupture of single and/or double bonds, without migration of atoms or groups; e.g." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence tautomerization" .

goldbook:V06592 a skos:Concept ;
    skos:definition "A transition observed in certain rare-earth and actinide materials in which the electronic occupation of the 4f or 5f orbital changes with external conditions for example, temperature and pressure. Example: The transition at approximately \\(0.65\\ \\rm{GPa}\\) where black, semiconducting $\\ce{Sm^{2+}S^{2−}}$ changes to golden metallic $\\ce{(Sm^{3+} + e^{−})S^{2-}}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "valence transition" .

goldbook:V06593 a skos:Concept ;
    skos:definition "Magnitude of a particular quantity generally expressed as a unit of measurement multiplied by a number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "value" .

goldbook:V06597 a skos:Concept ;
    skos:definition "The attractive or repulsive forces between molecular entities (or between groups within the same molecular entity) other than those due to bond formation or to the electrostatic interaction of ions or of ionic groups with one another or with neutral molecules. The term includes: dipole–dipole, dipole-induced dipole and London (instantaneous induced dipole-induced dipole) forces. The term is sometimes used loosely for the totality of nonspecific attractive or repulsive intermolecular forces." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "van der Waals forces" .

goldbook:V06598 a skos:Concept ;
    skos:definition "The temperature of the atomization surface at which analyte loss becomes statistically significant." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vaporization temperature" .

goldbook:V06600 a skos:Concept ;
    skos:definition "The quantity or characteristic measured or computed. The corresponding numerical value may be taken for statistical handling; it may, for example, be a measured value or result." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variable" .

goldbook:V06601 a skos:Concept ;
    skos:definition "A cell whose pathlength can be varied either continuously or in steps by means of spacers." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variable pathlength cell" .

goldbook:V06602 a skos:Concept ;
    skos:definition "The sum of the squares of the standard deviations, expressing the contributions to the overall precision from various sources of uncertainty." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variance" .

goldbook:V06603 a skos:Concept ;
    skos:definition "This expression is applied to modifications of conventional transition state theory in which the position of the dividing surface in the potential-energy surface is varied. The rate is calculated with the surface at various positions, and the lowest rate calculated is taken to be closest to the truth." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "variational transition state theory" .

goldbook:V06606 a skos:Concept ;
    skos:definition "A DNA molecule (plasmid, virus, bacteriophage, artificial or cut DNA molecule) capable of being replicated and bearing cloning sites for the introduction of foreign DNA, used to introduce this DNA into host cells.Any organism that transmits a disease between two hosts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vector" .

goldbook:V06607 a skos:Concept ;
    skos:definition "Vector quantity equal to the derivative of the position vector with respect to time (symbols \\(u\\), \\(v\\), \\(w\\) for components of \\(c\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "velocity" .

goldbook:V06608 a skos:Concept ;
    skos:definition "The flux density \\(N_{\\rm{B}}\\) is related to the velocity by the equation \\[N_{\\rm{B}}=c_{\\rm{B}}\\ v_{\\rm{B}}\\] The vector \\(v_{\\rm{B}}\\) is the macroscopic average velocity at which the species B moves (which is to be distinguished from the random molecular velocity); \\(c_{\\rm{B}}\\) is the concentration of species B (\\(\\pu{mol m-3}\\)). Note that the velocity is defined with respect to a frame of reference." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "velocity" .

goldbook:V06609 a skos:Concept ;
    skos:definition "Relatively stable delocalized radicals, derived from hydrazyl, $\\ce{H2NN^{.}H}$, of the types shown, in particular the six-membered ring:" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "verdazyl radicals" .

goldbook:V06610 a skos:Concept ;
    skos:definition "A process whereby an electron is removed from a molecule in its ground or an excited state so rapidly that a positive ion is produced without change in the positions or momenta of the atoms. The resultant ion is often in an excited state." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vertical ionization" .

goldbook:V06612 a skos:Concept ;
    skos:definition "An electron-ordering transition occurring in a mixed-valent system that results in an ordering of formal valence states in the low-temperature phase. Example: The prototype system, first identified by Verwey, is the ferrospinel magnetite, $\\ce{Fe^{3+}[Fe^{3+}Fe^{2+}]O4}$ in which an ordering of $\\ce{Fe^{3+}}$ and $\\ce{Fe^{2+}}$ ions within octahedral sites is thought to occur below \\(T_{\\rm{v}}\\approx 120\\ \\rm{K}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Verwey transition" .

goldbook:V06614 a skos:Concept ;
    skos:definition "Intramolecular redistribution of energy among the vibrational modes usually giving a statistical distribution of their populations, characterized by the 'vibrational temperature'. For large molecules, this process does not require collisions." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational redistribution" .

goldbook:V06615 a skos:Concept ;
    skos:definition "The loss of vibrational excitation energy by a molecular entity through energy transfer to the environment caused by collisions. The molecular entity relaxes into vibrational equilibrium with its environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibrational relaxation" .

goldbook:V06617 a skos:Concept ;
    skos:definition "Interaction between electronic and vibrational motions in a molecular entity." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibronic coupling" .

goldbook:V06618 a skos:Concept ;
    skos:definition "A transition which involves a change in both the electronic and vibrational quantum numbers of a molecular entity, as opposed to purely electronic or purely vibrational transitions. The transition occurs between two states, just as in a purely electronic transition, but involves a change in both electronic and vibrational energy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vibronic transition" .

goldbook:V06619 a skos:Concept ;
    skos:definition "A vacuum tube containing a photosensitive area, or target, and an electron gun to read the signal from the target. The silicon target consists of a two-dimensional array of Si-photodiodes having a common cathode and isolated anodes. irradiation of the target causes the production of electron-hole pairs which, by recombination, leads to a depletion of the surface charge." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vidicon" .

goldbook:V06620 a skos:Concept ;
    skos:definition "Carbenes having a vinylic group on a carbenic carbon atom $\\ce{R2C=CRC{:}R  R2C^{+}–CR=C^{−}R}$. E.g. $\\ce{H2C=CHC{:}H}$, prop-2-en-1-ylidene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vinyl carbenes" .

goldbook:V06621 a skos:Concept ;
    skos:definition "Carbocations having the structure $\\ce{R2C=C^{+}–R}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vinylic cations" .

goldbook:V06622 a skos:Concept ;
    skos:definition "The vinyl group ($\\ce{CH2=CH\\bond{–}}$) and derivatives formed by substitution. Informally, a group, such as $\\ce{–OH}$, attached to the free valence of a (substituted) vinyl group is sometimes referred to as 'vinylic'." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vinylic groups" .

goldbook:V06623 a skos:Concept ;
    skos:definition "Carbenes in which the carbenic carbon atom has a double bond to another carbon atom $\\ce{R2C=C{:}}$, e.g. $\\ce{H2C=C{:}}$ ethenylidene." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vinylidenes" .

goldbook:V06624 a skos:Concept ;
    skos:definition "1,1-Di(hydrocarbyl)-4,4'-bipyridinium salts." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viologens" .

goldbook:V06626 a skos:Concept ;
    skos:definition "A non-observable liquid-crystal transition that occurs below the crystallization temperature and is determined by extrapolation in binary phase diagrams." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "virtual transition" .

goldbook:V06631 a skos:Concept ;
    skos:definition "Defined as the greatest distance at which a black object of suitable dimensions can be seen and recognized against the horizon sky, or, in the case of night observations, could be seen and recognized if the general illumination were raised to the normal daylight level. The criterion of recognizing the object, not just seeing the object without recognition, is used. Transmissometers, telephotometers and sun photometers are devices used to measure the degree of transmission of light. Nephelometers (integrating) are used to measure visibility by way of the light scattering from aerosols in the air mass." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "visibility" .

goldbook:V06632 a skos:Concept ;
    skos:definition "The conversion of a solid or liquid to a gas or vapour by application of heat, by reducing pressure, by chemical reaction or by a combination of these processes.Example: \\(\\rm{W(s)}+\\frac{3}{2}\\rm{O}_{2}\\:\\rm{(g)}\\:\\rightarrow \\:\\rm{WO}_{3}\\:\\rm{(g)}\\)" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volatilization" .

goldbook:V06634 a skos:Concept ;
    skos:definition "SI derived unit of electric potential, \\(\\pu{V} = \\pu{J C-1} = \\pu{m2 kg s-3 A-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volt" .

goldbook:V06635 a skos:Concept ;
    skos:definition "The use of this term is discouraged, and the term applied potential should be used instead, for non-periodic signals. However, it is retained here for sinusoidal and other periodic signals because no suitable substitute for it has been proposed." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "voltage" .

goldbook:V06639 a skos:Concept ;
    skos:definition "In linear-sweep voltammetry and related techniques, the empirical quantity defined by the equation \\[\\frac{i_{p}}{A\\ \\sqrt{ u}\\ c_{\\rm{B}}}\\quad \\left(=\\frac{j_{p}}{\\sqrt{ u}\\ c_{\\rm{B}}}\\right)\\] where \\(i_{p}\\) is the peak current, A is the area of the electrode-solution interface, \\( u\\) is the rate of change of applied potential, and \\(c_{\\rm{B}}\\) is the bulk concentration of the substance B whose reduction or oxidation is responsible for the peak in question." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "voltammetric constant" .

goldbook:V06641 a skos:Concept ;
    skos:definition "The volume of an (isolated) specified component (C) divided by the mass of the system (S), e.g. patient–blood volume content. Volume content should not be confused with specific volume (or massic volume), which is the volume of the system divided by the mass of the system." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume content" .

goldbook:V06642 a skos:Concept ;
    skos:definition "Volume of a component crossing a surface divided by the time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume flow rate" .

goldbook:V06643 a skos:Concept ;
    skos:definition "Volume of a constituent of a mixture divided by the sum of volumes of all constituents prior to mixing." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume fraction" .

goldbook:V06644 a skos:Concept ;
    skos:definition "A quantity derived from the pressure dependence of the rate constant of a reaction (mainly used for reactions in solution), defined by the equation: \\[\\Delta ^{\\ddagger }V=- R\\ T\\ (\\frac{\\partial (\\ln k)}{\\partial p})_{T}\\] providing that the rate constants of all reactions (except first-order reactions) are expressed in pressure-independent concentration units, such as \\(\\pu{mol dm-3}\\) at a fixed temperature and pressure. The volume of activation is interpreted, according to transition state theory, as the difference between the partial molar volumes of the transition state (\\(V\\)) and the sums of the partial volumes of the reactants at the same temperature and pressure, i.e. \\[\\Delta ^{\\ddagger}V = ^{\\ddagger}V- \\sum \\left(r\\ V_{\\rm{R}}\\right)\\] where \\(r\\) is the order in the reactant R and \\(V_{\\rm{R}}\\) its partial molar volume." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume of activation" .

goldbook:V06650 a skos:Concept ;
    skos:altLabel "dilatational viscosity" ;
    skos:definition "A quantity $\\upzeta\\!$ which enters into equations at any point where the flow involves a change in volume, i.e. is dilatational. If the deformation is purely dilatational, the average of three normal stress components is: \\[\\sigma =\\frac{1}{3}\\ (\\sigma _{xx}+\\sigma _{yy}+\\sigma _{zz})=- p+\\zeta \\ (\\frac{\\partial v_{x}}{\\partial x}+\\frac{\\partial v_{y}}{\\partial y}+\\frac{\\partial v_{z}}{\\partial z})\\] where \\(p\\) is the hydrostatic pressure at the point considered in the absence of motion." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volume viscosity" .

goldbook:V06651 a skos:Concept ;
    skos:definition "Attribute to a physical quantity obtained by division by volume. charge density may thus be called volumic charge which is the electric charge in a section of space divided by the volume of that section." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "volumic" .

goldbook:VT07153 a skos:Concept ;
    skos:definition "Chemical crosslinking of high-molar-mass linear or branched polymers to give a polymer network." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "vulcanization" .

goldbook:VT07496 a skos:Concept ;
    skos:definition "Region of the electromagnetic spectrum extending from about \\(400\\ \\rm{nm}\\) to \\(760\\ \\rm{nm}\\). This is the wavelength region to which the human eye is sensitive. There are no precise limits for the spectral range of visible radiation since they depend upon the amount of radiant power reaching the retina and on the responsivity of the observer." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "visible" .

goldbook:VT07497 a skos:Concept ;
    skos:altLabel "VUV" ;
    skos:definition "Acronym for vacuum ultraviolet." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "VUV" .

goldbook:VT07640 a skos:Concept ;
    skos:altLabel "viscous flow sintering" ;
    skos:definition "Sintering process by which it is possible to densify gels to glasses and ceramics at elevated temperatures." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "viscous sintering" .

goldbook:W06653 a skos:Concept ;
    skos:definition "Retention of configuration is the preservation of integrity of the spatial arrangement of bonds to a chiral centre during a chemical reaction or transformation. It is also the configurational correlation when a chemical species Xabcd is converted into the chemical species Xabce having the same relative configuration. The configurational change when a chemical species Xabcd (where X is typically carbon), having a tetrahedral arrangement of bonds to X, is converted into the chemical species Xabce having the opposite relative configuration (or when it undergoes an identity reaction in which Xabcd of opposite configuration is produced) is called a Walden inversion or inversion of configuration. The occurrence of a Walden inversion during a chemical transformation is sometimes indicated in the chemical equation by the symbol shown below in place of a simple arrow pointing from reactants to products." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Walden inversion" .

goldbook:W06654 a skos:Concept ;
    skos:altLabel "WCOT",
        "WCOT column" ;
    skos:definition "A column in which the liquid stationary phase is coated on the essentially unmodified smooth inner wall of the tube." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wall-coated open-tubular column" .

goldbook:W06655 a skos:Concept ;
    skos:definition "The removal from the atmosphere of gases and sometimes particles by their solution in or attachment to raindrops as they fall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wash out" .

goldbook:W06656 a skos:Concept ;
    skos:definition "SI derived unit of power, \\(\\pu{W} = \\pu{J s-1} = \\pu{m2 kg s-3}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "watt" .

goldbook:W06658 a skos:Concept ;
    skos:definition "The limiting current of an individual wave, frequently expressed in arbitrary units for convenience." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wave height" .

goldbook:W06659 a skos:Concept ;
    skos:definition "Distance in the direction of propagation of a periodic wave between two successive points where at a given time the phase is the same." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength" .

goldbook:W06660 a skos:Concept ;
    skos:definition "A wavelength converter converts radiation at one wavelength to radiation at another detectable wavelength or at a wavelength of improved responsivity of the detector. The classical wavelength converter consists of a screen of luminescent material that absorbs radiation and radiates at a longer wavelength. Such materials are often used to convert ultraviolet to visible radiation for detection by conventional phototubes. In X-ray spectroscopy a converter that emits optical radiation is called a scintillator. In most cases wavelength conversion is from short to long wavelength, but in the case of conversion of long to short wavelength the process is sometimes called upconversion. Wavelengths of coherent sources can be converted using nonlinear optical techniques. A typical example is frequency doubling." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength converter" .

goldbook:W06661 a skos:Concept ;
    skos:definition "Spatial separation of characteristic X-rays according to their wavelengths." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength dispersion" .

goldbook:W06662 a skos:Concept ;
    skos:definition "A kind of X-ray fluorescence analysis involving the measurement of the wavelength spectrum of the emitted radiation e.g. by using a diffraction grating or crystal." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength-dispersive X-ray fluorescence analysis" .

goldbook:W06663 a skos:Concept ;
    skos:definition "The error in absorbance which may occur if there is a difference between the (mean) wavelength of the radiation entering the sample cell and the indicated wavelength on the spectrometer scale." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavelength error" .

goldbook:W06664 a skos:Concept ;
    skos:altLabel "repetency" ;
    skos:definition "The reciprocal of the wavelength, \\(\\lambda \\), or the number of waves per unit length along the direction of propagation. The SI unit is \\(\\rm{m}^{-1}\\), but a commonly used unit is \\(\\pu{cm-1}\\). Symbols \\(\\overset{˜}{ u }\\) in a vacuum, \\(\\sigma \\) in a medium." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wavenumber" .

goldbook:W06665 a skos:Concept ;
    skos:definition "A collision between two molecules in which the amount of energy transferred from one to the other is not large compared to \\(k_{\\rm{B}}\\ T\\) (\\(k_{\\rm{B}}\\) is the Boltzmann constant and \\(T\\) the absolute temperature)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weak collision" .

goldbook:W06666 a skos:Concept ;
    skos:definition "SI derived unit of magnetic flux, \\(\\pu{Wb} = \\pu{V s} = \\pu{m2 kg s-2 A-1}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weber" .

goldbook:W06667 a skos:Concept ;
    skos:definition "A stereochemical projection, roughly in the mean plane of the molecule, in which bonds are represented by open wedges, tapering off from the nearer atom to the farther atom. It is mainly used to illustrate the conformation of larger cycloalkanes e.g. cyclotetradecane:   equivalent to" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wedge projection" .

goldbook:W06668 a skos:Concept ;
    skos:definition "Force of gravity acting on a body, \\(G=m\\ g\\), where \\(m\\) is its mass and \\(g\\) the acceleration of free fall." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weight" .

goldbook:W06670 a skos:Concept ;
    skos:definition "If in a series of observations a statistical weight (\\(w_{i}\\)) is assigned to each value, a weighted mean \\(\\overline{x}_{w}\\) can be calculated by the formula: \\[\\overline{x}_{w}=\\frac{\\sum w_{i}\\ x_{i}}{\\sum w_{i}}\\]" ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weighted mean" .

goldbook:W06671 a skos:Concept ;
    skos:definition "Empirical correlation for the energy of full charge-transfer exciplex relative to the ground state in n-hexane as a function of the electrochemical one electron standard reduction potential of the cation radical produced upon electron donation and standard reduction potential of the acceptor measured in a polar solvent for the donor (D) and the acceptor (A) involved \\[\\Delta H(\\rm{D}^{+}\\rm{A}^{-},\\rm{hexane}) = e\\left [ E^{0}(\\rm{D}^{+\\bullet }/\\rm{D}) - E^{0}(\\rm{A}/\\rm{A}^{-\\bullet }) \\right ]+e\\Delta E\\] with \\(E^{0}(D^{+\\bullet }/D)\\) and \\(E^{0}(A/D^{-\\bullet })\\) the standard electrode potentials of the donor and acceptor, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Weller correlation" .

goldbook:W06673 a skos:Concept ;
    skos:definition "In psychrometry, the temperature of the sensor or the bulb of a thermometer in which a constantly renewed film of water is evaporating. The temperature of the water used to renew the film must be at the temperature of the gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wet bulb temperature" .

goldbook:W06674 a skos:Concept ;
    skos:altLabel "work of immersional wetting per unit area" ;
    skos:definition "The work done on a system when the process of immersional wetting involving unit area of phase $\\ce{\\upbeta\\!}$ is carried out reversibly: \\[w_{\\rm{W}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }=\\gamma ^{\\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }- \\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} }\\] where \\(\\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} }\\) and \\(\\gamma ^{\\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) are the surface tensions between two bulk phases $\\ce{\\upalpha\\!}$, $\\ce{\\upbeta\\!}$ and $\\ce{\\upbeta\\!}$, $\\ce{\\updelta\\!}$, respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wetting tension" .

goldbook:W06676 a skos:Concept ;
    skos:definition "Synonymous with suspension effect (in an ion-selective electrode)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wiegner effect" .

goldbook:W06678 a skos:Concept ;
    skos:definition "Labelling of a substance by exposing it to tritium gas." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wilzbach labelling" .

goldbook:W06679 a skos:Concept ;
    skos:altLabel "pollution rose" ;
    skos:definition "A diagram designed to show the distribution of wind direction experienced at a given location over a considerable period of time. Usually shown in polar coordinates (distance from the origin being proportional to the probability of the wind direction being at the given angle usually measured from the north). Similar diagrams are sometimes used to summarize the average concentrations of a given pollutant seen over a considerable period of time as a function of direction from a given site (sometimes called a pollution rose)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wind rose" .

goldbook:W06681 a skos:Concept ;
    skos:definition "A mechanical device that acts by absorption as a perfect photon trap." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wood horn" .

goldbook:W06682 a skos:Concept ;
    skos:definition "Term used to describe a low-pressure mercury arc possessing a fluorescing layer, which emits in the UV-A region (from \\(315\\) to \\(400\\ \\rm{nm}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Wood lamp" .

goldbook:W06684 a skos:Concept ;
    skos:definition "Scalar product of force, \\(\\boldsymbol{F}\\), and position change, \\(\\rm{d}\\boldsymbol{r}\\), \\(w = \\int \\boldsymbol{F}\\cdot \\rm{d}\\mathbf{r}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "work" .

goldbook:W06685 a skos:Concept ;
    skos:definition "Opposite of work softening, in which shear results in a permanent increase of viscosity or consistency with time." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "work hardening" .

goldbook:W06687 a skos:Concept ;
    skos:altLabel "work of separation" ;
    skos:definition "The work of adhesion per unit area, \\(w_{\\rm{A}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\), is the work done on the system when two condensed phases $\\ce{\\upalpha\\!}$ and $\\ce{\\upbeta\\!}$, forming an interface of unit area are separated reversibly to form unit areas of each of the $\\ce{\\upalpha\\!\\updelta\\!\\mbox{-}}$ and $\\ce{\\upbeta\\!\\updelta\\!\\mbox{-}}$ interfaces. \\[w_{\\rm{A}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }=\\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B4} }+\\gamma ^{\\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }- \\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} }\\] where \\(\\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} }\\), \\(\\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B4} }\\) and \\(\\gamma ^{\\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) are the surface tensions between two bulk phases $\\ce{\\upalpha\\!}$, $\\ce{\\upbeta\\!}$; $\\ce{\\upalpha\\!}$, $\\ce{\\updelta\\!}$ and $\\ce{\\upbeta\\!}$, $\\ce{\\updelta\\!}$ respectively. The work of adhesion as defined above, and traditionally used, may be called the work of separation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "work of adhesion" .

goldbook:W06688 a skos:Concept ;
    skos:definition "Of a single pure liquid or solid phase $\\ce{\\upalpha\\!}$, \\(w_{\\rm{C}}^{\\unicode[Times]{x3B1} }\\) is the work done on the system when a column $\\ce{\\upalpha\\!}$ of unit area is split, reversibly, normal to the axis of the column to form two new surfaces each of unit area in contact with the equilibrium gas phase. \\[w_{\\rm{C}}^{\\unicode[Times]{x3B1} }=2\\ \\gamma ^{\\unicode[Times]{x3B1} }\\] where \\(\\gamma ^{\\unicode[Times]{x3B1} }\\) is the surface tension between phase and its equilibrium vapour or a dilute gas phase." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "work of cohesion per unit area" .

goldbook:W06691 a skos:Concept ;
    skos:altLabel "shear breakdown" ;
    skos:definition "The application of a finite shear to a system after a long rest may result in a decrease of the viscosity or the consistency. If the decrease persists when the shear is discontinued, this behaviour is called work softening (or shear breakdown), whereas if the original viscosity or consistency is recovered this behaviour is called thixotropy." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "work softening" .

goldbook:WT06852 a skos:Concept ;
    skos:definition "Exposure of a polymeric material to a natural or simulated environment." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "weathering" .

goldbook:WT07250 a skos:Concept ;
    skos:definition "Process by which an interface between a solid and a gas is replaced by an interface between the same solid and a liquid." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wetting" .

goldbook:WT07499 a skos:Concept ;
    skos:definition "Incandescent lamp that generates light by passing an electric current through a thin filament wire (usually of wolfram) until it is extremely hot. The lamps are often filled by a halogen gas such as iodine and bromine that allow filaments to work at higher temperatures and higher efficiencies." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "wolfram lamp" .

goldbook:X06693 a skos:Concept ;
    skos:altLabel "xi-" ;
    skos:definition "A symbol used to denote unknown configuration at a chiral centre." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ξ-" .

goldbook:X06695 a skos:Concept ;
    skos:altLabel "fluoresceins" ;
    skos:definition "Dyes derived by condensation of phthalic anhydride with resorcinol (and derivatives) or m-aminophenol (and derivatives), of which fluorescein is the prototype (all such dyes have the xanthene nucleus)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xanthene dyes" .

goldbook:X06696 a skos:Concept ;
    skos:definition "Compounds having the structure $\\ce{ROC(=S)SH}$. Thus O-esters of dithiocarbonic acid. Salts and esters of xanthic acid are 'xanthates'. Use of this term is not recommended." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xanthic acids" .

goldbook:X06697 a skos:Concept ;
    skos:definition "A subclass of carotenoids consisting of the oxygenated carotenes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xanthophylls" .

goldbook:X06699 a skos:Concept ;
    skos:definition "An intense source of ultraviolet, visible and near-infrared light produced by electrical discharge in xenon under high pressure." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xenon lamp" .

goldbook:X06700 a skos:Concept ;
    skos:definition "Open network formed by the removal of all swelling agents from a gel." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xerogel" .

goldbook:X06703 a skos:Concept ;
    skos:definition "Radiation resulting from the interaction of high energy particles or photons with matter." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-radiation" .

goldbook:X06709 a skos:Concept ;
    skos:definition "In a gamma or X-ray spectrum, the peak due to the photoelectric effect in the detector and escape, from the sensitive part of the detector, of the X-ray photon emitted as a result of the photoelectric effect." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray escape peak" .

goldbook:X06710 a skos:Concept ;
    skos:definition "The emission of characteristic X-radiation by an atom as a result of the interaction of electromagnetic radiation with its orbital electrons." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray fluorescence" .

goldbook:X06711 a skos:Concept ;
    skos:definition "A kind of analysis based on the measurement of the energies and intensities of characteristic X-radiation emitted by a test portion during irradiation with electromagnetic radiation." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray fluorescence analysis" .

goldbook:X06714 a skos:Concept ;
    skos:definition "Essentially all X-ray measurements are made by photon counting techniques but the results are seldom converted to radiant flux or irradiance or radiant exposure. The term photon flux would be appropriate if the measurements were corrected for detector efficiency but this is seldom done for X-ray chemical analysis. Therefore the term X-ray intensity, \\(I\\), is commonly used and expressed as photons/unit time detected. Likewise the term relative X-ray intensity, \\(I_{\\rm{r}}\\), is used to mean the intensity for the analyte in an unknown specimen divided by the intensity for a known concentration of the analyte element." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray intensity" .

goldbook:X06715 a skos:Concept ;
    skos:definition "An electronic state occuring as the initial or final state of a process involving the absorption or emission of X-ray radiation. It represents a many-electron state which, in the purely atomic case, has total angular momentum (\\(J = L + S\\)) as a well defined quantum number." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray level" .

goldbook:X06717 a skos:Concept ;
    skos:definition "A weak line in the same energy region as a normal X-ray line. Another name used for weak features is non-diagram line. Recommendations as to the use of these two terms have conflicted. Using the term diagram line as defined here, non-diagram line may well be used for all lines with a different origin. The majority of these lines originate form the dipole-allowed de-excitation of multiply ionized or excited states, and are called multiple-ionization satellites. A line where the initial state has two vacencies in the same shell, notably the K-shell, is called a hypersatellite. Other mechanisms leading to weak spectral features in X-ray emission are, e.g. resonance emission, the radiative Auger effect, magnetic dipole and electric quadrupole transitions and, in metals, plasmon excitation. Atoms with open electron shells, i.e. transition metals, lanthanides and actinides, show a splitting of certain X-ray lines due to the electron interaction involving this open shell. Structures originating in all these ways as well as structures in the valence band of molecules and solid chemical compounds have in the past been given satellite designations." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray satellite" .

goldbook:X06718 a skos:Concept ;
    skos:definition "X-ray spectroscopy consists of three steps: (a) excitation to produce emission lines characteristic of the elements in the material, (b) measurement of their intensity, and (c) conversion of X-ray intensity to concentration by a calibration procedure which may include correction for matrix effects." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "X-ray spectroscopy" .

goldbook:XT06755 a skos:Concept ;
    skos:definition "A xenobiotic (Greek, xenos 'foreign'; bios 'life') is a compound that is foreign to a living organism. Principal xenobiotics include: drugs; carcinogens; and various compounds that have been introduced into the environment by artificial means." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "xenobiotic" .

goldbook:Y06724 a skos:Concept ;
    skos:definition "Ratio expressing the efficiency of a mass conversion process. The yield coefficient is defined as the amount of cell mass (\\(\\pu{kg}\\)) or product formed (\\(\\pu{kg}\\),\\(\\pu{mol}\\)) related to the consumed substrate (carbon or nitrogen source or oxygen in \\(\\pu{kg}\\) or \\(\\pu{moles}\\)) or to the intracellular ATP production (\\(\\pu{moles}\\))." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "yield" .

goldbook:Y06727 a skos:Concept ;
    skos:definition "The shear stress \\(\\sigma _{0}\\) or \\(\\tau _{0}\\) at which yielding starts abruptly. Its value depends on the criterion used to determine when yielding occurs." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "yield stress" .

goldbook:Y06728 a skos:Concept ;
    skos:definition "Compounds in which an anionic site $\\ce{Y^{−}}$ (originally on carbon, but now including other atoms) is attached directly to a heteroatom $\\ce{X^{+}}$ (usually nitrogen, phosphorus or sulfur) carrying a formal positive charge. They are thus 1,2-dipolar species of the type $\\ce{R_{m}X^{+}–Y^{−}R^{n}}$. If $\\ce{X}$ is a saturated atom of an element from the first row of the periodic system, the ylide is commonly represented by a charge-separated form; if $\\ce{X}$ is a second, third, etc. row element uncharged canonical forms are available $\\ce{R_{m}X=YR_{n}}$. If $\\ce{X}$ is an unsaturated atom, doubly bonded to another first row element $\\ce{Z}$, the negative charge on $\\ce{Y}$ may be stabilized by $\\ce{\\uppi\\!\\mbox{-}}$conjugation, $\\ce{Z=X^{+}–Y^{−}Rn  Z^{−}–X^{+}=YR_{n}}$. Such ylides belong to the class 1,3 dipolar compounds. However, 1,3-dipolar compounds with only sextet-containing canonical forms (e.g. vinylcarbenes) are not ylides. E.g. $\\ce{Ph3P^{+}–C^{−}H2  Ph3P^{+}=CH2}$ (often called a Wittig reagent), $\\ce{(CH3)3N^{+}–C^{−}H2}$, $\\ce{RC#N^{+}N^{−}–R}$, $\\ce{(CH3)2S=CHPh  (CH3)2S^{+}–C^{−}HPh}$. Note that ylide is a complete word, not to be confused with the suffix -ylide, used for some radical anions. Subclasses of ylides: Ylides $\\ce{R_{m}X^{+}–C^{−}R2}$ having the negative charge on carbon are classified by citing the name of the element $\\ce{X}$ before the word ylide. E.g. nitrogen ylide, phosphorus ylide, oxygen ylide, sulfur ylide. A further specification may be achieved by citing the class name of $\\ce{R_{m}X}$ before the word ylide. Thus nitrogen ylides include amine ylides, $\\ce{R3N^{+}–C^{−}R2}$, azomethine ylides $\\ce{R2C=N^{+}R–C^{−}R2}$, nitrile ylides, $\\ce{RC#N^{+}–C^{−}R2}$. Some authors, who wish to express the positive charge on $\\ce{X}$, prefer e.g. ammonium ylides over amine ylides; such usage varies according to the heteroatom $\\ce{X}$ and to national custom. The ylides $\\ce{R_{m}X^{+}–Y^{−}  R_{m}X=Y}$ ($\\ce{Y} = \\ce{O}, \\ce{S}, \\ce{Se}, \\ce{Te}, \\ce{NR}$) are usually named by citing the name of $\\ce{R_{m}X}$ followed by the additive nomenclature term for $\\ce{Y}$ (oxide, sulfide, selenide, telluride, imide, respectively). E.g. amine imides; use of the less systematic synonyms amine imines and aminimines is discouraged. Some classes of ylides are known by trivial names e.g. nitrones, Wittig reagents (synonymous with phosphonium ylides)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ylides" .

goldbook:Y06729 a skos:Concept ;
    skos:definition "N,N-Disubstituted alk-1-yn-1-amines, $\\ce{RC#CNR2}$. By usage, restricted to this type of acetylenic amine." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ynamines" .

goldbook:Y06730 a skos:Concept ;
    skos:definition "Alk-1-yn-1-ols, $\\ce{RC≡COH}$; tautomeric with ketenes $\\ce{RCH=C=O}$." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "ynols" .

goldbook:Y06734 a skos:Concept ;
    skos:definition "A multiparameter extension of the Hammett equation to quantify the role of enhanced resonance effect on the reactivity of meta- and para-substituted benzene derivatives, e.g. \\[\\log _{10}k = \\log _{10}k_{0}+\\rho \\ [\\sigma +r\\ (\\sigma^{+}-\\sigma)]\\] The parameter \\(r\\) gives the enhanced resonance effect on the scale (\\(\\sigma ^{+}\\,-\\sigma\\)) or (\\(\\sigma\\,-\\sigma \\)), respectively." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Yukawa–Tsuno equation" .

goldbook:YT07500 a skos:Concept ;
    skos:definition "Intramolecular coupling of diradicals of different sizes (1,4-, 1,5-, 1,6-, 1,7-, 1,8-diradicals, as well as very remote diradicals) formed through intramolecular hydrogen abstraction by an excited ketone, yielding cyclic alcohols of different sizes." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Yang photocyclization" .

goldbook:Z06737 a skos:Concept ;
    skos:altLabel "Kosower $Z$-value" ;
    skos:definition "An index of the ionizing power of a solvent based on the frequency of the longest wavelength electronic absorption maximum of 1-ethyl-4-methoxycarbonylpyridinium iodide in the solvent. The Z-value is defined by: \\[Z = \\frac{\\pu{2.859E4}}{\\lambda}\\] where \\(Z\\) is in \\(\\pu{kcal mol-1}\\) and \\(\\lambda \\) is in \\(\\pu{nm}\\)." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "<em>Z</em>-value" .

goldbook:Z06739 a skos:Concept ;
    skos:definition "The splitting or shift of spectral lines due to the presence of an external magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Zeeman effect" .

goldbook:Z06741 a skos:Concept ;
    skos:definition "The separation of multiplet sublevels in the absence of an external magnetic field." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero field splitting" .

goldbook:Z06742 a skos:Concept ;
    skos:definition "Value of the pH of a solution, which in combination with a stated outer reference electrode, gives zero emf from the operational cell." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero point" .

goldbook:Z06744 a skos:Concept ;
    skos:altLabel "0–0 absorption",
        "0–0 emission",
        "zero-zero absorption",
        "zero-zero emission" ;
    skos:definition "A purely electronic transition occurring between the lowest vibrational levels of two electronic states." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero–zero absorption or emission" .

goldbook:Z06747 a skos:Concept ;
    skos:definition "A stereochemical projection for an acyclic molecule (or portion of a molecule) where the main chain is represented by a zig-zag line in the plane and the substituents are shown above or below the plane." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zig-zag projection" .

goldbook:Z06749 a skos:Concept ;
    skos:definition "A region in the chromatographic bed where one or more components of the sample are located. The term band may also be used for it." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zone" .

goldbook:Z06750 a skos:Concept ;
    skos:definition "A technique based on the different solubility of microcomponents in the liquid and solid matrix. It has a limited field of application for the analysis of fusible (and stable) substances." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zone melting method of preconcentration" .

goldbook:Z06751 a skos:Concept ;
    skos:definition "This hypothesis states that, if in an acid catalysed reaction, \\(\\log _{10}k_{1}\\) (first-order rate constant of the reaction) is linear in \\(H_{0}\\) (Hammett acidity function), water is not involved in the transition state of the rate-controlling step. However, if \\(\\log _{10}k_{1}\\) is linear in \\(\\log _{10}\\left[\\rm{H}^{+}\\right]\\) then water is involved. This has been shown to be incorrect by Hammett himself." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "Zucker–Hammett hypothesis" .

goldbook:Z06752 a skos:Concept ;
    skos:altLabel "ampholytes",
        "inner salts",
        "zwitterionic compounds" ;
    skos:definition "Neutral compounds having formal unit electrical charges of opposite sign. Some chemists restrict the term to compounds with the charges on non-adjacent atoms. Sometimes referred to as inner salts, dipolar ions (a misnomer). E.g. $\\ce{H3N^{+}CH2C(=O)O^{−}}$ ammonioacetate (glycine), $\\ce{(CH3)3N^{+}–O^{−}}$ trimethylamine oxide." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zwitterions" .

goldbook:Z06753 a skos:Concept ;
    skos:definition "The cell obtained as a result of complete or partial fusion of meiotically (cf. meiosis) produced cells." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zygote" .

goldbook:ZT07132 a skos:Concept ;
    skos:altLabel "ZDO",
        "ZDO approximation" ;
    skos:definition "An approach to the systematic neglect of the small-in-value electron repulsion integrals which is used in a number of approximate self-consistent field molecular orbital schemes. It means that all the products of atomic orbitals \\(\\upchi_{\\upmu} \\upchi_{\\upnu}\\) are set to zero and the overlap integral \\(\\rm{S}_{\\upmu\\upnu} = \\updelta_{\\upmu\\upnu}\\) (where \\(\\updelta_{\\upmu\\upnu}\\) is the Kronecker delta). The ZDO approximation greatly simplifies the computation of wavefunctions by eliminating many of two-electron integrals. At the ZDO approximation all three- and four-centered integrals vanish." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zero differential overlap approximation" .

goldbook:ZT07228 a skos:Concept ;
    skos:altLabel "polymeric inner salt" ;
    skos:definition "Ampholytic polymer containing ionic groups of opposite sign, commonly on the same pendant groups." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "zwitterionic polymer" .

goldbook:ZT07501 a skos:Concept ;
    skos:definition "Number of cycles required to reduce by 50% the initial absorbance of the coloured form of a photochromic compound at a specific wavelength." ;
    skos:inScheme <https://w3id.org/biopragmatics/resources/goldbook/goldbook.ttl> ;
    skos:prefLabel "$\\pu{\\rm{Z}_{50}}$" .

