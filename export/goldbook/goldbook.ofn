AnnotationAssertion(obo:goldbook#hasStatus goldbook:P04386 "current"^^xsd:string)
Declaration(Class(goldbook:P04393))
AnnotationAssertion(rdfs:label goldbook:P04393 "packed column")
AnnotationAssertion(dcterms:description goldbook:P04393 "A tube containing a solid packing.")
