AnnotationAssertion(dcterms:description goldbook:TT07576 "Network that exists only transiently.")
AnnotationAssertion(rdfs:comment goldbook:TT07576 "The network structure of a transient polymer network is based on transient junction points or crosslinks arising from interactions between polymer chains."^^xsd:string)
