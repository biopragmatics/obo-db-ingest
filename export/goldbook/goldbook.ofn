AnnotationAssertion(dcterms:description goldbook:11320 "Presence of three haploid sets of chromosomes in the cell.")
AnnotationAssertion(rdfs:comment goldbook:11320 "The condition is fatal in fetal or early neonatal life."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11320 goldbook:10608)
AnnotationAssertion(rdfs:seeAlso goldbook:11320 goldbook:10687)
AnnotationAssertion(rdfs:seeAlso goldbook:11320 goldbook:10718)
