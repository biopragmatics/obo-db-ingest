Declaration(Class(goldbook:H02879))
AnnotationAssertion(rdfs:label goldbook:H02879 "hydrazides")
AnnotationAssertion(dcterms:description goldbook:H02879 "Compounds derived from oxoacids $\\ce{R_{k}E(=O)_{l}(OH)_{m}}$ ($l  eq 0$) by replacing $\\ce{–OH}$ by $\\ce{–NRNR2}$ ($\\ce{R}$ groups are commonly $\\ce{H}$), as in carbohydrazides, $\\ce{RC(=O)NHNH2}$, sulfonohydrazides, $\\ce{RS(=O)2NHNH2}$, and phosphonic dihydrazides, $\\ce{RP(=O)(NHNH2)2}$.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02879 goldbook:O04374)
AnnotationAssertion(mito:isMentionedBy goldbook:H02879 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:H02879 "current"^^xsd:string)
Declaration(Class(goldbook:H02880))
AnnotationAssertion(rdfs:label goldbook:H02880 "hydrazidines")
AnnotationAssertion(dcterms:description goldbook:H02880 "Compounds, $\\ce{RC(NHNH2)2=NNH2}$, derived from carboxylic acids by replacing $\\ce{–OH}$ by $\\ce{–NHNH2}$ (or N-substituted analogues) and $\\ce{=O}$ by $\\ce{=NNH2}$ (or substituted analogues). A specific hydrazidine is named as a hydrazide hydrazone, e.g. hexanohydrazide hydrazone.")
AnnotationAssertion(rdfs:seeAlso goldbook:H02880 goldbook:C00852)
AnnotationAssertion(mito:isMentionedBy goldbook:H02880 doi:10.1351/pac199567081307)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:H02880 "current"^^xsd:string)
