Declaration(Class(goldbook:13557))
AnnotationAssertion(rdfs:label goldbook:13557 "pernicious anemia")
AnnotationAssertion(dcterms:description goldbook:13557 "Disease in which the erythrocytes are abnormally formed, due to an inability to absorb vitamin \\({\\rm{B}}_{12}\\). True pernicious anemia refers specifically to a disorder of atrophied parietal cells leading to absent intrinsic factor, resulting in an inability to absorb \\({\\rm{B}}_{12}\\).")
AnnotationAssertion(rdfs:comment goldbook:13557 "This is the end stage of \\(\\pu{10}\\) to \\(\\pu{15\\%}\\) of autoimmune gastritis."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:13557 "This disease is associated with a variety of autoimmune endocrine diseases (e.g., Hashimoto thyroiditis, Addison disease, and autoimmune myasthenic syndromes)."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:13557 goldbook:12845)
AnnotationAssertion(rdfs:seeAlso goldbook:13557 goldbook:13195)
AnnotationAssertion(rdfs:seeAlso goldbook:13557 goldbook:12918)
AnnotationAssertion(rdfs:seeAlso goldbook:13557 goldbook:13127)
AnnotationAssertion(mito:isMentionedBy goldbook:13557 doi:10.1351/PAC-REC-11-06-03)
