Declaration(Class(goldbook:G02668))
AnnotationAssertion(rdfs:label goldbook:G02668 "grab sampling")
AnnotationAssertion(dcterms:description goldbook:G02668 "The taking of a sample (often in an evacuated bulb) in a very short time; preferred terms are instantaneous sampling or instantaneous sampling.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02668 goldbook:I03064)
AnnotationAssertion(mito:isMentionedBy goldbook:G02668 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02668 "current"^^xsd:string)
Declaration(Class(goldbook:G02669))
AnnotationAssertion(rdfs:label goldbook:G02669 "gradient")
AnnotationAssertion(dcterms:description goldbook:G02669 "A differential ratio; the change in a quantity such as the mixing ratio of an impurity in air, the temperature of the air, etc., with height or distance.")
AnnotationAssertion(mito:isMentionedBy goldbook:G02669 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02669 "current"^^xsd:string)
Declaration(Class(goldbook:G02670))
AnnotationAssertion(rdfs:label goldbook:G02670 "gradient elution")
AnnotationAssertion(dcterms:description goldbook:G02670 "A procedure in which the composition of the mobile phase is changed continuously or stepwise during the elution process.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02670 goldbook:E02042)
AnnotationAssertion(rdfs:seeAlso goldbook:G02670 goldbook:M03952)
AnnotationAssertion(mito:isMentionedBy goldbook:G02670 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02670 "current"^^xsd:string)
Declaration(Class(goldbook:G02671))
AnnotationAssertion(rdfs:label goldbook:G02671 "gradient layer")
AnnotationAssertion(dcterms:description goldbook:G02671 "The chromatographic bed used in thin-layer chromatography in which there is a gradual transition in some property.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02671 goldbook:T06346)
AnnotationAssertion(mito:isMentionedBy goldbook:G02671 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02671 "current"^^xsd:string)
Declaration(Class(goldbook:G02672))
AnnotationAssertion(rdfs:label goldbook:G02672 "gradientless reactor")
AnnotationAssertion(dcterms:description goldbook:G02672 "Stirred flow or recirculation reactors, characterized ideally by very small concentration and temperature gradients within the catalyst region.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02672 goldbook:C00876)
AnnotationAssertion(mito:isMentionedBy goldbook:G02672 doi:10.1351/pac197646010071)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02672 "current"^^xsd:string)
Declaration(Class(goldbook:G02674))
AnnotationAssertion(rdfs:label goldbook:G02674 "gradual potential-energy surface")
AnnotationAssertion(dcterms:description goldbook:G02674 "These terms relate to the steepness of the energy rise along the reaction path of a potential-energy surface.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02674 goldbook:P04780)
AnnotationAssertion(rdfs:seeAlso goldbook:G02674 goldbook:R05174)
AnnotationAssertion(mito:isMentionedBy goldbook:G02674 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02674 "current"^^xsd:string)
Declaration(Class(goldbook:G02675))
AnnotationAssertion(rdfs:label goldbook:G02675 "graft copolymer")
AnnotationAssertion(dcterms:description goldbook:G02675 "A copolymer that is a graft polymer.")
AnnotationAssertion(rdfs:comment goldbook:G02675 "In the constituent macromolecules of a graft copolymer, adjacent blocks in the main chain or side-chains, or both, are constitutionally different, i.e. adjacent blocks comprise constitutional units derived from different species of monomer or from the same species of monomer but with a different composition or sequence distribution of constitutional units."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02675 goldbook:C01281)
AnnotationAssertion(rdfs:seeAlso goldbook:G02675 goldbook:C01288)
AnnotationAssertion(rdfs:seeAlso goldbook:G02675 goldbook:C01335)
AnnotationAssertion(rdfs:seeAlso goldbook:G02675 goldbook:G02679)
AnnotationAssertion(rdfs:seeAlso goldbook:G02675 goldbook:M04017)
AnnotationAssertion(rdfs:seeAlso goldbook:G02675 goldbook:ST06775)
AnnotationAssertion(mito:isMentionedBy goldbook:G02675 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02675 "current"^^xsd:string)
Declaration(Class(goldbook:G02678))
AnnotationAssertion(rdfs:label goldbook:G02678 "graft macromolecule")
AnnotationAssertion(dcterms:description goldbook:G02678 "A macromolecule with one or more species of block connected to the main chain as side chains, these side chains having constitutional or configurational features that differ from those in the main chain.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02678 goldbook:B00682)
AnnotationAssertion(rdfs:seeAlso goldbook:G02678 goldbook:M03667)
AnnotationAssertion(rdfs:seeAlso goldbook:G02678 goldbook:M03694)
AnnotationAssertion(rdfs:seeAlso goldbook:G02678 goldbook:B00720)
AnnotationAssertion(mito:isMentionedBy goldbook:G02678 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02678 "current"^^xsd:string)
Declaration(Class(goldbook:G02679))
AnnotationAssertion(rdfs:label goldbook:G02679 "graft polymer")
AnnotationAssertion(dcterms:description goldbook:G02679 "A polymer composed of graft macromolecules.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02679 goldbook:G02678)
AnnotationAssertion(mito:isMentionedBy goldbook:G02679 doi:10.1351/pac199668122287)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02679 "current"^^xsd:string)
Declaration(Class(goldbook:G02681))
AnnotationAssertion(rdfs:label goldbook:G02681 "Gram stain")
AnnotationAssertion(dcterms:description goldbook:G02681 "A set of two stains that are used to stain (crystal violet and iodine) and counterstain (fuchsin) bacteria. gram-negative bacteria are completely decolorized after treating the stained bacteria with ethanol or acetone and can be visualized by the counterstain. They have a complex cell wall in which the peptidoglycan layer is covered by lipopolysaccharides in an outer membrane structure. gram-positive bacteria resist decolorization by ethanol or acetone, they retain the initial gram stain. They have a cell wall consisting predominantly of peptidoglycan not overlayed by an outer membrane.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02681 goldbook:G02680)
AnnotationAssertion(rdfs:seeAlso goldbook:G02681 goldbook:L03574)
AnnotationAssertion(rdfs:seeAlso goldbook:G02681 goldbook:MT06878)
AnnotationAssertion(rdfs:seeAlso goldbook:G02681 goldbook:P04480)
AnnotationAssertion(mito:isMentionedBy goldbook:G02681 doi:10.1351/pac199264010143)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02681 "current"^^xsd:string)
Declaration(Class(goldbook:G02682))
AnnotationAssertion(rdfs:label goldbook:G02682 "granular carbon")
AnnotationAssertion(dcterms:description goldbook:G02682 "The term granular carbon is equivalent to coarse particulate carbon. This is a carbon material consisting of separate particles or grains which are monolithic, on the average larger than about \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\) in diameter, but smaller than about \\(1\\ \\rm{cm}\\).")
AnnotationAssertion(rdfs:comment goldbook:G02682 "Although limits of size cannot be exactly defined, coke grains obtained by grinding belong to coarse particulate carbon for grain sizes above ca. \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\), or to fine particulate carbon for grain sizes below ca. \\(100\\ \\unicode[Times]{x3BC}\\rm{m}\\). colloidal graphite obtained by grinding of natural graphite is a typical extra fine particulate carbon. Industrial carbon materials (such as electrodes) are made with fillers composed of coarse particulate carbon (coke grains) and fine particulate carbon (flour), and sometimes even colloidal carbon, carbon blacks or soot). They are therefore polygranular materials."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:C00824)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:C00841)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:C01142)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:C01172)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:C01173)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:F02363)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:N04088)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:P04433)
AnnotationAssertion(rdfs:seeAlso goldbook:G02682 goldbook:S05768)
AnnotationAssertion(mito:isMentionedBy goldbook:G02682 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02682 "current"^^xsd:string)
Declaration(Class(goldbook:G02683))
AnnotationAssertion(rdfs:label goldbook:G02683 "graphene layer")
AnnotationAssertion(dcterms:description goldbook:G02683 "A single carbon layer of the graphite structure, describing its nature by analogy to a polycyclic aromatic hydrocarbon of quasi infinite size.")
AnnotationAssertion(rdfs:comment goldbook:G02683 "Previously, descriptions such as graphite layers, carbon layers or carbon sheets have been used for the term graphene. Because graphite designates that modification of the chemical element carbon, in which planar sheets of carbon atoms, each atom bound to three neighbours in a honeycomb-like structure, are stacked in a three-dimensional regular order, it is not correct to use for a single layer a term which includes the term graphite, which would imply a three-dimensional structure. The term graphene should be used only when the reactions, structural relations or other properties of individual layers are discussed."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02683 goldbook:C01022)
AnnotationAssertion(rdfs:seeAlso goldbook:G02683 goldbook:G02684)
AnnotationAssertion(mito:isMentionedBy goldbook:G02683 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02683 "current"^^xsd:string)
Declaration(Class(goldbook:G02684))
AnnotationAssertion(rdfs:label goldbook:G02684 "graphite")
AnnotationAssertion(dcterms:description goldbook:G02684 "An allotropic form of the element carbon consisting of layers of hexagonally arranged carbon atoms in a planar condensed ring system graphene layers The layers are stacked parallel to each other in a three-dimensional crystalline long-range order. There are two allotropic forms with different stacking arrangements, hexagonal and rhombohedral. The chemical bonds within the layers are covalent with \\(\\rm{sp}^{2}\\) hybridization and with a C–C distance of \\(141.7\\ \\rm{pm}\\). The weak bonds between the layers are metallic with a strength comparable to van der Waals bonding only.")
AnnotationAssertion(rdfs:comment goldbook:G02684 "The term graphite is also used often but incorrectly to describe graphite materials, i.e. materials consisting of graphitic carbon made from carbon materials by processing to temperatures greater than \\(2500\\ \\rm{K}\\), even though no perfect graphite structure is present."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02684 goldbook:G02683)
AnnotationAssertion(rdfs:seeAlso goldbook:G02684 goldbook:G02687)
AnnotationAssertion(rdfs:seeAlso goldbook:G02684 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:G02684 goldbook:H02874)
AnnotationAssertion(mito:isMentionedBy goldbook:G02684 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02684 "current"^^xsd:string)
Declaration(Class(goldbook:G02686))
AnnotationAssertion(rdfs:label goldbook:G02686 "graphite fibres")
AnnotationAssertion(dcterms:description goldbook:G02686 "Carbon fibres consisting mostly of synthetic graphite for which three-dimensional crystalline order is confirmed by X-ray diffraction.")
AnnotationAssertion(rdfs:comment goldbook:G02686 "Graphite fibres can be obtained by graphitization heat treatment of carbon fibres if these consist mostly of graphitizable carbon. If the h,k,l diffraction lines are difficult to recognize because they are of minor intensity, the mean interlayer spacing \\(\\rm{c}/2\\) can be used as indication for the presence of a graphitic structure. The \\(\\rm{c}/2\\) value of \\(0.34\\ \\rm{nm}\\) is generally considered as an upper limit for synthetic graphite."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02686 goldbook:C00831)
AnnotationAssertion(rdfs:seeAlso goldbook:G02686 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:G02686 goldbook:D01711)
AnnotationAssertion(rdfs:seeAlso goldbook:G02686 goldbook:G02690)
AnnotationAssertion(rdfs:seeAlso goldbook:G02686 goldbook:G02692)
AnnotationAssertion(rdfs:seeAlso goldbook:G02686 goldbook:S06233)
AnnotationAssertion(mito:isMentionedBy goldbook:G02686 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02686 "current"^^xsd:string)
Declaration(Class(goldbook:G02687))
AnnotationAssertion(rdfs:label goldbook:G02687 "graphite material")
AnnotationAssertion(dcterms:description goldbook:G02687 "A material consisting essentially of graphitic carbon.")
AnnotationAssertion(rdfs:comment goldbook:G02687 "The use of the term graphite as a short term for material consisting of graphitic carbon is incorrect. The term graphite can only be used in combination with other nouns or clarifying adjectives for special types of graphite materials (graphite electrodes, natural graphite and others). The use of the term graphite without a noun or clarifying adjective should be restricted to the allotropic form of the element carbon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02687 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:G02687 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:G02687 goldbook:N04088)
AnnotationAssertion(mito:isMentionedBy goldbook:G02687 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02687 "current"^^xsd:string)
Declaration(Class(goldbook:G02688))
AnnotationAssertion(rdfs:label goldbook:G02688 "graphite whiskers")
AnnotationAssertion(dcterms:description goldbook:G02688 "Thin, approximately cylindrical filaments in which graphene layers are arranged in a scroll-like manner. There is, at least in part, a regular stacking of the layers as in the graphite lattice, giving rise to h,k,l, X-ray reflections. The physical properties of graphite whiskers approach, along the cylinder axis, those of graphite.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:G02688 "carbon whiskers")
AnnotationAssertion(rdfs:comment goldbook:G02688 "If there is, due to misalignment of the layers caused by their bending, no three-dimensional stacking order as in graphite, the term carbon whiskers should be used. @G02684-1@ whiskers and carbon whiskers should be distinguished from more disordered filamentous carbon."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02688 goldbook:F02362)
AnnotationAssertion(rdfs:seeAlso goldbook:G02688 goldbook:G02683)
AnnotationAssertion(rdfs:seeAlso goldbook:G02688 goldbook:G02684)
AnnotationAssertion(mito:isMentionedBy goldbook:G02688 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02688 "current"^^xsd:string)
Declaration(Class(goldbook:G02689))
AnnotationAssertion(rdfs:label goldbook:G02689 "graphitic carbon")
AnnotationAssertion(dcterms:description goldbook:G02689 "All varieties of substances consisting of the element carbon in the allotropic form of graphite irrespective of the presence of structural defects.")
AnnotationAssertion(rdfs:comment goldbook:G02689 "The use of the term graphitic carbon is justified if three-dimensional hexagonal crystalline long-range order can be detected in the material by diffraction methods, independent of the volume fraction and the homogeneity of distribution of such crystalline domains. Otherwise, the term non-graphitic carbon should be used."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02689 goldbook:D01711)
AnnotationAssertion(rdfs:seeAlso goldbook:G02689 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:G02689 goldbook:N04193)
AnnotationAssertion(rdfs:seeAlso goldbook:G02689 goldbook:V06643)
AnnotationAssertion(mito:isMentionedBy goldbook:G02689 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02689 "current"^^xsd:string)
Declaration(Class(goldbook:G02690))
AnnotationAssertion(rdfs:label goldbook:G02690 "graphitizable carbon")
AnnotationAssertion(dcterms:description goldbook:G02690 "A non-graphitic carbon which upon graphitization heat treatment converts into graphitic carbon.")
AnnotationAssertion(rdfs:comment goldbook:G02690 "If it is preferred to define the characterizable state of material instead of its behaviour during subsequent treatment, the term 'pregraphitic carbon' could be considered."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02690 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:G02690 goldbook:G02692)
AnnotationAssertion(rdfs:seeAlso goldbook:G02690 goldbook:N04193)
AnnotationAssertion(mito:isMentionedBy goldbook:G02690 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02690 "current"^^xsd:string)
Declaration(Class(goldbook:G02691))
AnnotationAssertion(rdfs:label goldbook:G02691 "graphitization")
AnnotationAssertion(dcterms:description goldbook:G02691 "A solid-state transformation of thermodynamically unstable non-graphitic carbon into graphite by means of heat treatment.")
AnnotationAssertion(rdfs:comment goldbook:G02691 "Graphitization is also used for the transformation of metastable diamond into graphite by heat treatment, as well as in metallurgy for the formation of graphite from thermodynamically unstable carbides by thermal decomposition at high temperatures. Such uses of the term graphitization are in line with the above definition. The use of the term graphitization to indicate a process of thermal treatment of carbon materials at \\(T > 2500\\ \\rm{K}\\) regardless of any resultant crystallinity is incorrect."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:C00841)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:C01433)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:D01547)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:D01671)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:G02684)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:M03872)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:N04193)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:T06446)
AnnotationAssertion(rdfs:seeAlso goldbook:G02691 goldbook:U06569)
AnnotationAssertion(mito:isMentionedBy goldbook:G02691 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02691 "current"^^xsd:string)
Declaration(Class(goldbook:G02692))
AnnotationAssertion(rdfs:label goldbook:G02692 "graphitization heat treatment")
AnnotationAssertion(dcterms:description goldbook:G02692 "A process of heat treatment of a non-graphitic carbon industrially performed at temperatures in the range between \\(2500\\) and \\(3300\\ \\rm{K}\\), to achieve transformation into graphitic carbon.")
AnnotationAssertion(rdfs:comment goldbook:G02692 "The term graphitization heat treatment does not include information as to the crystallinity achieved by the heat treatment, that is the extent of transformation into graphitic carbon or the degree of graphitization. Only for such a transformation into graphitic carbon should the term graphitization be used. Consequently: the common use of the term graphitization for the heat treatment process only, regardless of the resultant crystallinity, is incorrect and should be avoided."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02692 goldbook:C01433)
AnnotationAssertion(rdfs:seeAlso goldbook:G02692 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:G02692 goldbook:G02691)
AnnotationAssertion(rdfs:seeAlso goldbook:G02692 goldbook:N04193)
AnnotationAssertion(rdfs:seeAlso goldbook:G02692 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:G02692 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02692 "current"^^xsd:string)
Declaration(Class(goldbook:G02693))
AnnotationAssertion(rdfs:label goldbook:G02693 "graphitized carbon")
AnnotationAssertion(dcterms:description goldbook:G02693 "A graphitic carbon with more or less perfect three-dimensional hexagonal crystalline order prepared from non-graphitic carbon by graphitization heat treatment.")
AnnotationAssertion(rdfs:comment goldbook:G02693 "Non-graphitizable carbons do not transform into graphitic carbon on heat treatment at temperatures above \\(2500\\ \\rm{K}\\) and therefore are not graphitized carbons."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:G02693 goldbook:N04194)
AnnotationAssertion(rdfs:seeAlso goldbook:G02693 goldbook:G02689)
AnnotationAssertion(rdfs:seeAlso goldbook:G02693 goldbook:G02692)
AnnotationAssertion(rdfs:seeAlso goldbook:G02693 goldbook:N04193)
AnnotationAssertion(mito:isMentionedBy goldbook:G02693 doi:10.1351/pac199567030473)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02693 "current"^^xsd:string)
Declaration(Class(goldbook:G02694))
AnnotationAssertion(rdfs:label goldbook:G02694 "gravimetric method")
AnnotationAssertion(dcterms:description goldbook:G02694 "A determination by weight; e.g. in the older method of $\\ce{Cl^{−}}$ ion determination, a weighed amount of sample is dissolved in water, $\\ce{AgNO3}$ solution added, $\\ce{AgCl}$ is precipitated, dried and weighed. From the known mass fraction of silver in $\\ce{AgCl}$, the weights of the initial sample and that of the $\\ce{AgCl}$ precipitated, the percentage of chlorine in the sample can be calculated readily.")
AnnotationAssertion(rdfs:seeAlso goldbook:G02694 goldbook:M03722)
AnnotationAssertion(rdfs:seeAlso goldbook:G02694 goldbook:W06668)
AnnotationAssertion(mito:isMentionedBy goldbook:G02694 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02694 "current"^^xsd:string)
Declaration(Class(goldbook:G02695))
AnnotationAssertion(rdfs:label goldbook:G02695 "gravitational constant")
AnnotationAssertion(dcterms:description goldbook:G02695 "Universal fundamental physical constant in Newton's law of gravitation, \\(G = \\pu{6.67259(85)E-11 m3 kg-1 s-2}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:G02695 goldbook:N04135)
AnnotationAssertion(mito:isMentionedBy goldbook:G02695 doi:10.6028/jres.092.010)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:G02695 "current"^^xsd:string)
Declaration(Class(goldbook:G02696))
AnnotationAssertion(rdfs:label goldbook:G02696 "gray")
AnnotationAssertion(dcterms:description goldbook:G02696 "SI derived unit of energy imparted to an element of matter by ionizing radiation divided by the mass of that element (absorbed dose of radiation) equal to one joule per kilogram and admitted for reasons of safeguarding human health, \\(\\pu{Gy} = \\pu{J kg-1}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:G02696 goldbook:DT07361)
AnnotationAssertion(rdfs:seeAlso goldbook:G02696 goldbook:I03216)
AnnotationAssertion(rdfs:seeAlso goldbook:G02696 goldbook:J03363)
AnnotationAssertion(rdfs:seeAlso goldbook:G02696 goldbook:K03391)
