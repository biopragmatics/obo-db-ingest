AnnotationAssertion(obo:goldbook#hasStatus goldbook:10028 "current"^^xsd:string)
Declaration(Class(goldbook:10029))
AnnotationAssertion(rdfs:label goldbook:10029 "working examination standard")
AnnotationAssertion(dcterms:description goldbook:10029 "Examination standard that is used routinely to calibrate or verify examining systems.")
AnnotationAssertion(rdfs:comment goldbook:10029 "A working examination standard is usually calibrated with respect to a reference examination standard."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:10029 goldbook:10019)
AnnotationAssertion(rdfs:seeAlso goldbook:10029 goldbook:09986)
AnnotationAssertion(rdfs:seeAlso goldbook:10029 goldbook:10028)
