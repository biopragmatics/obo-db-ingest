Declaration(Class(goldbook:OT07306))
AnnotationAssertion(rdfs:label goldbook:OT07306 "ordered co-continuous double gyroid morphology")
AnnotationAssertion(dcterms:description goldbook:OT07306 "Co-continuous morphology in which a set of two gyroid-based phase domains exhibits a highly regular, three-dimensional lattice-like morphology with Ia3d space group symmetry.")
AnnotationAssertion(rdfs:comment goldbook:OT07306 "The domains are composed of tripoidal units as the fundamental building structures."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:OT07306 "The two domains are interlaced."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:OT07306 goldbook:MT07285)
AnnotationAssertion(mito:isMentionedBy goldbook:OT07306 doi:10.1351/pac200476111985)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:OT07306 "current"^^xsd:string)
