AnnotationAssertion(obo:goldbook#hasStatus goldbook:15638 "current"^^xsd:string)
Declaration(Class(goldbook:15639))
AnnotationAssertion(rdfs:label goldbook:15639 "detriment")
AnnotationAssertion(dcterms:description goldbook:15639 "Estimated measure of the expected harm or loss associated with an adverse event, usually in a manner chosen to facilitate meaningful addition over different events. It is generally the integrated product of arbitrary values of risk and hazard and is often expressed in terms such as costs in U.S. dollars, loss in expected years of life or loss in productivity, and is needed for numerical exercises such as cost-benefit analysis.")
AnnotationAssertion(rdfs:seeAlso goldbook:15639 goldbook:15448)
AnnotationAssertion(mito:isMentionedBy goldbook:15639 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15639 "current"^^xsd:string)
Declaration(Class(goldbook:15640))
AnnotationAssertion(rdfs:label goldbook:15640 "developmental toxicity")
AnnotationAssertion(dcterms:description goldbook:15640 "Adverse effects on the developing organism (including structural abnormality, altered growth, or functional deficiency or death) resulting from exposure through conception, gestation (including organogenesis), and postnatally up to the time of sexual maturation.")
AnnotationAssertion(mito:isMentionedBy goldbook:15640 doi:10.1351/pac200779071153)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:15640 "current"^^xsd:string)
Declaration(Class(goldbook:15641))
AnnotationAssertion(rdfs:label goldbook:15641 "diaphoresis")
AnnotationAssertion(dcterms:description goldbook:15641 "Profuse perspiration.")
