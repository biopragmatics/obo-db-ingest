AnnotationAssertion(rdfs:label goldbook:11925 "neurobehavior core test battery")
AnnotationAssertion(dcterms:description goldbook:11925 "A set of seven tests, recommended by the World Health Organization (WHO) in 1983, to detect neurotoxicity in human populations")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:11925 "NCTB")
AnnotationAssertion(rdfs:comment goldbook:11925 "The battery consists of digit symbol, digit span, pursuit aiming, Benton visual memory, simple reaction time, Santa Ana dexterity, and profile of mood states tests."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:11925 goldbook:11636)
AnnotationAssertion(rdfs:seeAlso goldbook:11925 goldbook:12061)
AnnotationAssertion(rdfs:seeAlso goldbook:11925 goldbook:11717)
AnnotationAssertion(rdfs:seeAlso goldbook:11925 goldbook:11718)
