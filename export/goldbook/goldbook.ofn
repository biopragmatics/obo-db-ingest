AnnotationAssertion(rdfs:label goldbook:VT07497 "VUV")
AnnotationAssertion(dcterms:description goldbook:VT07497 "Acronym for vacuum ultraviolet.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003000) oboInOwl:hasRelatedSynonym goldbook:VT07497 "VUV")
AnnotationAssertion(mito:isMentionedBy goldbook:VT07497 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:VT07497 "current"^^xsd:string)
Declaration(Class(goldbook:VT07640))
AnnotationAssertion(rdfs:label goldbook:VT07640 "viscous sintering")
AnnotationAssertion(dcterms:description goldbook:VT07640 "Sintering process by which it is possible to densify gels to glasses and ceramics at elevated temperatures.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:VT07640 "viscous flow sintering")
AnnotationAssertion(rdfs:seeAlso goldbook:VT07640 goldbook:S05704)
AnnotationAssertion(mito:isMentionedBy goldbook:VT07640 doi:10.1351/pac200779101801)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:VT07640 "current"^^xsd:string)
Declaration(Class(goldbook:W06653))
AnnotationAssertion(rdfs:label goldbook:W06653 "Walden inversion")
AnnotationAssertion(dcterms:description goldbook:W06653 "Retention of configuration is the preservation of integrity of the spatial arrangement of bonds to a chiral centre during a chemical reaction or transformation. It is also the configurational correlation when a chemical species Xabcd is converted into the chemical species Xabce having the same relative configuration. The configurational change when a chemical species Xabcd (where X is typically carbon), having a tetrahedral arrangement of bonds to X, is converted into the chemical species Xabce having the opposite relative configuration (or when it undergoes an identity reaction in which Xabcd of opposite configuration is produced) is called a Walden inversion or inversion of configuration. The occurrence of a Walden inversion during a chemical transformation is sometimes indicated in the chemical equation by the symbol shown below in place of a simple arrow pointing from reactants to products.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06653 goldbook:C01057)
AnnotationAssertion(rdfs:seeAlso goldbook:W06653 goldbook:I02940)
AnnotationAssertion(rdfs:seeAlso goldbook:W06653 goldbook:I03146)
AnnotationAssertion(rdfs:seeAlso goldbook:W06653 goldbook:R05260)
AnnotationAssertion(rdfs:seeAlso goldbook:W06653 goldbook:T06446)
AnnotationAssertion(mito:isMentionedBy goldbook:W06653 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06653 "current"^^xsd:string)
Declaration(Class(goldbook:W06654))
AnnotationAssertion(rdfs:label goldbook:W06654 "wall-coated open-tubular column")
AnnotationAssertion(dcterms:description goldbook:W06654 "A column in which the liquid stationary phase is coated on the essentially unmodified smooth inner wall of the tube.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType OMO:0003012) oboInOwl:hasRelatedSynonym goldbook:W06654 "WCOT")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:W06654 "WCOT column")
AnnotationAssertion(mito:isMentionedBy goldbook:W06654 doi:10.1351/pac199365040819)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06654 "current"^^xsd:string)
Declaration(Class(goldbook:W06655))
AnnotationAssertion(rdfs:label goldbook:W06655 "wash out")
AnnotationAssertion(dcterms:description goldbook:W06655 "The removal from the atmosphere of gases and sometimes particles by their solution in or attachment to raindrops as they fall.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06655 goldbook:A00491)
AnnotationAssertion(rdfs:seeAlso goldbook:W06655 goldbook:A00512)
AnnotationAssertion(rdfs:seeAlso goldbook:W06655 goldbook:R05123)
AnnotationAssertion(mito:isMentionedBy goldbook:W06655 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06655 "current"^^xsd:string)
Declaration(Class(goldbook:W06656))
AnnotationAssertion(rdfs:label goldbook:W06656 "watt")
AnnotationAssertion(dcterms:description goldbook:W06656 "SI derived unit of power, \\(\\pu{W} = \\pu{J s-1} = \\pu{m2 kg s-3}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:W06656 goldbook:P04792)
AnnotationAssertion(mito:isMentionedBy goldbook:W06656 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06656 "current"^^xsd:string)
Declaration(Class(goldbook:W06658))
AnnotationAssertion(rdfs:label goldbook:W06658 "wave height")
AnnotationAssertion(dcterms:description goldbook:W06658 "The limiting current of an individual wave, frequently expressed in arbitrary units for convenience.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06658 goldbook:L03532)
AnnotationAssertion(mito:isMentionedBy goldbook:W06658 doi:10.1351/pac198557101491)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06658 "current"^^xsd:string)
Declaration(Class(goldbook:W06659))
AnnotationAssertion(rdfs:label goldbook:W06659 "wavelength")
AnnotationAssertion(dcterms:description goldbook:W06659 "Distance in the direction of propagation of a periodic wave between two successive points where at a given time the phase is the same.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06659 goldbook:P04881)
AnnotationAssertion(mito:isMentionedBy goldbook:W06659 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06659 "current"^^xsd:string)
Declaration(Class(goldbook:W06660))
AnnotationAssertion(rdfs:label goldbook:W06660 "wavelength converter")
AnnotationAssertion(dcterms:description goldbook:W06660 "A wavelength converter converts radiation at one wavelength to radiation at another detectable wavelength or at a wavelength of improved responsivity of the detector. The classical wavelength converter consists of a screen of luminescent material that absorbs radiation and radiates at a longer wavelength. Such materials are often used to convert ultraviolet to visible radiation for detection by conventional phototubes. In X-ray spectroscopy a converter that emits optical radiation is called a scintillator. In most cases wavelength conversion is from short to long wavelength, but in the case of conversion of long to short wavelength the process is sometimes called upconversion. Wavelengths of coherent sources can be converted using nonlinear optical techniques. A typical example is frequency doubling.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:X06718)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:F02527)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:R05048)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:R05347)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:S05507)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:UT07492)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:U06574)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:VT07496)
AnnotationAssertion(rdfs:seeAlso goldbook:W06660 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:W06660 doi:10.1351/pac199567101745)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06660 "current"^^xsd:string)
Declaration(Class(goldbook:W06661))
AnnotationAssertion(rdfs:label goldbook:W06661 "wavelength dispersion")
AnnotationAssertion(dcterms:description goldbook:W06661 "Spatial separation of characteristic X-rays according to their wavelengths.")
AnnotationAssertion(mito:isMentionedBy goldbook:W06661 doi:10.1351/pac198052112541)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06661 "current"^^xsd:string)
Declaration(Class(goldbook:W06662))
AnnotationAssertion(rdfs:label goldbook:W06662 "wavelength-dispersive X-ray fluorescence analysis")
AnnotationAssertion(dcterms:description goldbook:W06662 "A kind of X-ray fluorescence analysis involving the measurement of the wavelength spectrum of the emitted radiation e.g. by using a diffraction grating or crystal.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06662 goldbook:X06711)
AnnotationAssertion(rdfs:seeAlso goldbook:W06662 goldbook:D01711)
AnnotationAssertion(rdfs:seeAlso goldbook:W06662 goldbook:R05048)
AnnotationAssertion(rdfs:seeAlso goldbook:W06662 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:W06662 doi:10.1351/pac199466122513)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06662 "current"^^xsd:string)
Declaration(Class(goldbook:W06663))
AnnotationAssertion(rdfs:label goldbook:W06663 "wavelength error")
AnnotationAssertion(dcterms:description goldbook:W06663 "The error in absorbance which may occur if there is a difference between the (mean) wavelength of the radiation entering the sample cell and the indicated wavelength on the spectrometer scale.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06663 goldbook:A00028)
AnnotationAssertion(rdfs:seeAlso goldbook:W06663 goldbook:S05837)
AnnotationAssertion(rdfs:seeAlso goldbook:W06663 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:W06663 doi:10.1351/pac198860091449)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06663 "current"^^xsd:string)
Declaration(Class(goldbook:W06664))
AnnotationAssertion(rdfs:label goldbook:W06664 "wavenumber")
AnnotationAssertion(dcterms:description goldbook:W06664 "The reciprocal of the wavelength, \\(\\lambda \\), or the number of waves per unit length along the direction of propagation. The SI unit is \\(\\rm{m}^{-1}\\), but a commonly used unit is \\(\\pu{cm-1}\\). Symbols \\(\\overset{˜}{ u }\\) in a vacuum, \\(\\sigma \\) in a medium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:W06664 "repetency")
AnnotationAssertion(rdfs:seeAlso goldbook:W06664 goldbook:P04881)
AnnotationAssertion(rdfs:seeAlso goldbook:W06664 goldbook:W06659)
AnnotationAssertion(mito:isMentionedBy goldbook:W06664 doi:10.1351/pac198557010105)
AnnotationAssertion(mito:isMentionedBy goldbook:W06664 doi:10.1351/pac199668122223)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06664 "current"^^xsd:string)
Declaration(Class(goldbook:W06665))
AnnotationAssertion(rdfs:label goldbook:W06665 "weak collision")
AnnotationAssertion(dcterms:description goldbook:W06665 "A collision between two molecules in which the amount of energy transferred from one to the other is not large compared to \\(k_{\\rm{B}}\\ T\\) (\\(k_{\\rm{B}}\\) is the Boltzmann constant and \\(T\\) the absolute temperature).")
AnnotationAssertion(rdfs:seeAlso goldbook:W06665 goldbook:B00695)
AnnotationAssertion(rdfs:seeAlso goldbook:W06665 goldbook:S06059)
AnnotationAssertion(mito:isMentionedBy goldbook:W06665 doi:10.1351/pac199668010149)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06665 "current"^^xsd:string)
Declaration(Class(goldbook:W06666))
AnnotationAssertion(rdfs:label goldbook:W06666 "weber")
AnnotationAssertion(dcterms:description goldbook:W06666 "SI derived unit of magnetic flux, \\(\\pu{Wb} = \\pu{V s} = \\pu{m2 kg s-2 A-1}\\).")
AnnotationAssertion(rdfs:seeAlso goldbook:W06666 goldbook:M03684)
AnnotationAssertion(mito:isMentionedBy goldbook:W06666 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06666 "current"^^xsd:string)
Declaration(Class(goldbook:W06667))
AnnotationAssertion(rdfs:label goldbook:W06667 "wedge projection")
AnnotationAssertion(dcterms:description goldbook:W06667 "A stereochemical projection, roughly in the mean plane of the molecule, in which bonds are represented by open wedges, tapering off from the nearer atom to the farther atom. It is mainly used to illustrate the conformation of larger cycloalkanes e.g. cyclotetradecane:   equivalent to")
AnnotationAssertion(rdfs:seeAlso goldbook:W06667 goldbook:C01258)
AnnotationAssertion(rdfs:seeAlso goldbook:W06667 goldbook:C01497)
AnnotationAssertion(mito:isMentionedBy goldbook:W06667 doi:10.1351/pac199668122193)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06667 "current"^^xsd:string)
Declaration(Class(goldbook:W06668))
AnnotationAssertion(rdfs:label goldbook:W06668 "weight")
AnnotationAssertion(dcterms:description goldbook:W06668 "Force of gravity acting on a body, \\(G=m\\ g\\), where \\(m\\) is its mass and \\(g\\) the acceleration of free fall.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06668 goldbook:A00053)
AnnotationAssertion(mito:isMentionedBy goldbook:W06668 doi:10.1351/pac199668040957)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06668 "current"^^xsd:string)
Declaration(Class(goldbook:W06670))
AnnotationAssertion(rdfs:label goldbook:W06670 "weighted mean")
AnnotationAssertion(dcterms:description goldbook:W06670 "If in a series of observations a statistical weight (\\(w_{i}\\)) is assigned to each value, a weighted mean \\(\\overline{x}_{w}\\) can be calculated by the formula: \\[\\overline{x}_{w}=\\frac{\\sum w_{i}\\ x_{i}}{\\sum w_{i}}\\]")
AnnotationAssertion(rdfs:seeAlso goldbook:W06670 goldbook:D01556)
AnnotationAssertion(mito:isMentionedBy goldbook:W06670 doi:10.1351/pac199466030595)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06670 "current"^^xsd:string)
Declaration(Class(goldbook:W06671))
AnnotationAssertion(rdfs:label goldbook:W06671 "Weller correlation")
AnnotationAssertion(dcterms:description goldbook:W06671 "Empirical correlation for the energy of full charge-transfer exciplex relative to the ground state in n-hexane as a function of the electrochemical one electron standard reduction potential of the cation radical produced upon electron donation and standard reduction potential of the acceptor measured in a polar solvent for the donor (D) and the acceptor (A) involved \\[\\Delta H(\\rm{D}^{+}\\rm{A}^{-},\\rm{hexane}) = e\\left [ E^{0}(\\rm{D}^{+\\bullet }/\\rm{D}) - E^{0}(\\rm{A}/\\rm{A}^{-\\bullet }) \\right ]+e\\Delta E\\] with \\(E^{0}(D^{+\\bullet }/D)\\) and \\(E^{0}(A/D^{-\\bullet })\\) the standard electrode potentials of the donor and acceptor, respectively.")
AnnotationAssertion(rdfs:comment goldbook:W06671 "In the case diethylaniline as donor and aromatic hydrocarbons as acceptors, the last term on the right, i.e., \\(e\\Delta E = (0.15 \\pm 0.10)\\ \\rm{eV}\\). This equation assumes a constant Coulomb term and a constant entropy change within a particular series of partners. \\(e\\) is the elementary charge."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:W06671 "The IUPAC recommendations for the sign and symbols of standard potentials are used in the equation as written above."^^xsd:string)
AnnotationAssertion(rdfs:comment goldbook:W06671 "Although not complying with the IUPAC recommended nomenclature for the standard electrode potentials, traditionally the equation has been written as: \\[\\Delta H(\\rm{D}^{+}\\rm{A}^{-},\\rm{hexane}) = e\\left [ E_{\\rm{ox}}^{0} - E_{\\rm{red}}^{0} \\right ]+(0.15 \\pm 0.10)\\ \\rm{eV}\\] with \\(E_{\\rm{ox}}^{0}\\) the standard electrode potential at which the oxidation occurs, and \\(E_{\\rm{red}}^{0}\\) the standard electrode potential at which the reduction occurs. This writing of the first term within the square brackets is misleading and not recommended."^^xsd:string)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:C01365)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:R05073)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:E02032)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:E02149)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:E02246)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:G02704)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:H02889)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:O04362)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:P04717)
AnnotationAssertion(rdfs:seeAlso goldbook:W06671 goldbook:S05912)
AnnotationAssertion(mito:isMentionedBy goldbook:W06671 doi:10.1351/pac200779030293)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06671 "current"^^xsd:string)
Declaration(Class(goldbook:W06673))
AnnotationAssertion(rdfs:label goldbook:W06673 "wet bulb temperature")
AnnotationAssertion(dcterms:description goldbook:W06673 "In psychrometry, the temperature of the sensor or the bulb of a thermometer in which a constantly renewed film of water is evaporating. The temperature of the water used to renew the film must be at the temperature of the gas.")
AnnotationAssertion(rdfs:seeAlso goldbook:W06673 goldbook:F02366)
AnnotationAssertion(rdfs:seeAlso goldbook:W06673 goldbook:P04940)
AnnotationAssertion(mito:isMentionedBy goldbook:W06673 doi:10.1351/pac199062112167)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06673 "current"^^xsd:string)
Declaration(Class(goldbook:W06674))
AnnotationAssertion(rdfs:label goldbook:W06674 "wetting tension")
AnnotationAssertion(dcterms:description goldbook:W06674 "The work done on a system when the process of immersional wetting involving unit area of phase $\\ce{\\upbeta\\!}$ is carried out reversibly: \\[w_{\\rm{W}}^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }=\\gamma ^{\\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }- \\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} }\\] where \\(\\gamma ^{\\unicode[Times]{x3B1} \\unicode[Times]{x3B2} }\\) and \\(\\gamma ^{\\unicode[Times]{x3B2} \\unicode[Times]{x3B4} }\\) are the surface tensions between two bulk phases $\\ce{\\upalpha\\!}$, $\\ce{\\upbeta\\!}$ and $\\ce{\\upbeta\\!}$, $\\ce{\\updelta\\!}$, respectively.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:W06674 "work of immersional wetting per unit area")
AnnotationAssertion(rdfs:seeAlso goldbook:W06674 goldbook:I02966)
AnnotationAssertion(rdfs:seeAlso goldbook:W06674 goldbook:S06192)
AnnotationAssertion(mito:isMentionedBy goldbook:W06674 doi:10.1351/pac197231040577)
AnnotationAssertion(obo:goldbook#hasStatus goldbook:W06674 "current"^^xsd:string)
