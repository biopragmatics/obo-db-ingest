Declaration(Class(goldbook:11243))
AnnotationAssertion(rdfs:label goldbook:11243 "spermatozoon")
AnnotationAssertion(dcterms:description goldbook:11243 "Mature male gamete.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11243 "sperm")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11243 "sperm cell")
Declaration(Class(goldbook:11244))
AnnotationAssertion(rdfs:label goldbook:11244 "spermiation")
AnnotationAssertion(dcterms:description goldbook:11244 "Release of mature spermatozoa from the Sertoli cells.")
Declaration(Class(goldbook:11245))
AnnotationAssertion(rdfs:label goldbook:11245 "spermiogenesis")
AnnotationAssertion(dcterms:description goldbook:11245 "Maturation of an immature spermatid into a spermatozoon.")
Declaration(Class(goldbook:11246))
AnnotationAssertion(rdfs:label goldbook:11246 "sphenoid bone")
AnnotationAssertion(dcterms:description goldbook:11246 "Irregular wing-shaped bone at the anterior base of the skull, forming part of the orbit, serving as an attachment site for muscles of mastication, and containing foramina for nerves and vessels of the head and neck.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11246 "sphenoid")
Declaration(Class(goldbook:11247))
AnnotationAssertion(rdfs:label goldbook:11247 "sphincter")
AnnotationAssertion(dcterms:description goldbook:11247 "Ringlike muscle that maintains closure of a body passage or orifice by contracting, and opens it by relaxing.")
Declaration(Class(goldbook:11248))
AnnotationAssertion(rdfs:label goldbook:11248 "spina bifida")
AnnotationAssertion(dcterms:description goldbook:11248 "Failure of the neural tube to close, resulting in the absence of part of the vertebral arch at the midline of the spinal column and exposure of the spinal cord and its covering membranes.")
Declaration(Class(goldbook:11249))
AnnotationAssertion(rdfs:label goldbook:11249 "spinal column")
AnnotationAssertion(dcterms:description goldbook:11249 "Backbone.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11249 "spine")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11249 "vertebral column")
Declaration(Class(goldbook:11250))
AnnotationAssertion(rdfs:label goldbook:11250 "spinal cord")
AnnotationAssertion(dcterms:description goldbook:11250 "Portion of the central nervous system outside the brain and inside the vertebral column.")
Declaration(Class(goldbook:11251))
AnnotationAssertion(rdfs:label goldbook:11251 "spiral arteriole")
AnnotationAssertion(dcterms:description goldbook:11251 "One of the corkscrew-like arterioles in premenstrual or progestational endometrium.")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11251 "coiled artery of the uterus")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11251 "corkscrew-like artery")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11251 "spiral artery")
AnnotationAssertion(oboInOwl:hasRelatedSynonym goldbook:11251 "spiral endometrial artery")
Declaration(Class(goldbook:11252))
AnnotationAssertion(rdfs:label goldbook:11252 "splanchnic")
AnnotationAssertion(dcterms:description goldbook:11252 "Relating to the visceral organs, especially those of the abdomen.")
Declaration(Class(goldbook:11253))
AnnotationAssertion(rdfs:label goldbook:11253 "spongioblast")
