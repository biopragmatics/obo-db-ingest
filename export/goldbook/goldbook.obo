property_value: hasStatus "current" xsd:string
consider: goldbook:12684

[Term]
id: goldbook:12641
name: designed multiple ligands
def: "Compounds conceived and synthesised to act on two or more molecular targets."
property_value: mito:isMentionedBy doi:10.1351/PAC-REC-12-11-23
property_value: hasStatus "current" xsd:string
